target/
node_modules/
.DS_Store
*.swp
# Built web artifacts: the wasm and its copies, never committed.
host/web/dist/
# Its swap's siblings: the lock, a stage, the kept builds by generation, their leases and the reaped list
# (serve.mjs replaceBuild, host/web/generations.mjs).
host/web/dist.*
# The Apple package's SwiftPM build products.
host/apple/.build/
# The harness's subagent worktrees: never committed.
.claude/worktrees/
# llp-ship run state, an output root of the captured-source diagnostics.
.llp/ship-runs/
# Generated game shells; game/app/shells.mjs writes their own .gitignore.
game/.shells/

# Declarations the dev producer writes beside each app.ts for an editor.
apps/*/app.contract.d.ts
# The design server's lock and journal (contract tamber serve, LLP 1121 D13).
apps/*/.exact/
scripts/fixtures/*/.exact/
# The Windows package host/windows/build.mjs writes (game/ ignores its own).
apps/*/dist-windows/

# What the Messages app's bake wrote before its rewrite (87997f0d), and the
# removed Snapback-backed Messages Legacy app's generated files: a checkout
# that built either still has these, which nothing makes now and nothing may
# commit.
apps/messages-legacy/
apps/messages/snapback/
apps/messages/assets/snapback4-device.wasm
apps/messages/assets/snapback4-LICENSE.txt
apps/messages/.snapback/

# The game add-on: Godot import caches, per-twin node_modules.
game/twins/godot/**/.godot/
*.gd.uid
*.tscn.uid

# Raw per-frame traces from the feel probe: kept locally, summarized in feel-*.jsonl
game/bench/results/*.json.gz

# Cited sittings are reproducible evidence; uncited captures remain local.
!game/bench/results/feel-2026-09-18T11-56-12-978Z-*.json.gz
!game/bench/results/feel-2026-09-18T12-27-35-105Z-*.json.gz
!game/bench/results/feel-2026-09-18T20-36-09-882Z-*.json.gz

# Expose: the OpenRouter key a developer bakes into their own build (build.rs writes it).
apps/expose/local.ts
# SwiftPM's scratch directory, which a `swift build` with an empty
# `--scratch-path` writes into the repository root (c2457b87d removed one).
/out/
/.buildSystem_debug
/.lock
/CACHEDIR.TAG
/debug
/manifest.pif
/workspace-state.json

# Lead agent notes dropped into worktrees; never commit them
/LEAD-URGENT.md

/game/games/*/.exact/
