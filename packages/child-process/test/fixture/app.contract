// The stage drives' fixture (LLP 1133.007 §10): a child its data module
// spawns, writes to on `drain`, restarts and reads to its close; a mutation
// that writes to, ends and signals it through the kept handle; `next` lets
// it go for a new one; a one-shot `execFile`; and an install's file work
// under `home:/` (D6a). Its tools are a tool's call into the same actions,
// which start, write to, end and signal no child (D13).
shape Line
  text: string

component Fixture
  state generation = 0
  resource server = server(generation) as shape Line
  resource version = version() as shape Line
  resource install = install() as shape Line
  resource status = status() as shape Line
  mutation poked as shape Line
  mutation locked as shape Line
  tool sayToChild writes additive closed "Write a line to the fixture's child." = say
  tool killChild writes idempotent closed "Signal the fixture's child." = kill
  action write
    send poked = poke("write")
  action say
    send poked = poke("say")
  action quit
    send poked = poke("quit")
  action end
    send poked = poke("end")
  action closein
    send poked = poke("close")
  action kill
    send poked = poke("kill")
  action relock
    send locked = relock()
  action next
    generation = generation + 1
  view
    column gap=8 padding=16
      text server.text testId="server"
      text version.text testId="version"
      text install.text testId="install"
      text status.text testId="status"
      match poked
        case some(p)
          text p.text testId="poked"
        case none
          text "" testId="poked"
      button press=write testId="write"
        text "Write"
      button press=say testId="say"
        text "Say"
      button press=quit testId="quit"
        text "Quit"
      button press=closein testId="closein"
        text "Close stdin"
      button press=end testId="end"
        text "End"
      button press=kill testId="kill"
        text "Kill"
      match locked
        case some(l)
          text l.text testId="locked"
        case none
          text "" testId="locked"
      button press=relock testId="relock"
        text "Relock"
      button press=next testId="next"
        text "Next"
