{
  "kind": "implementation",
  "implements": "@exact/health@^1.0",
  "platform": "android",
  "targets": [
    "android"
  ],
  "shapes": {
    "AndroidHealthStatus": {
      "sdkStatus": "enum<available|unavailable|providerUpdateRequired>"
    },
    "AndroidHealthTypeStatus": {
      "shouldShowRationale": "bool",
      "permanentlyDenied": "bool"
    },
    "AndroidHealthWorkout": {
      "exerciseType": "number"
    }
  },
  "options": {
    "healthStatistics": {
      "recordType": "string",
      "metric": "string",
      "dataOrigins": "string[]"
    },
    "healthWorkouts": {
      "dataOrigins": "string[]"
    },
    "requestHealthAuthorization": {
      "readHealthDataHistory": "bool"
    },
    "healthStatus": {
      "readHealthDataHistory": "bool"
    }
  },
  "names": [],
  "views": [],
  "hatches": [
    "healthConnectClient"
  ],
  "sources": {
    "kotlin": [
      "."
    ]
  },
  "maven": [
    "androidx.health.connect:connect-client:1.1.0"
  ],
  "manifest": {
    "queries": [
      {
        "package": "com.google.android.apps.healthdata"
      }
    ],
    "activities": [
      {
        "name": "exact.health.PrivacyPolicyActivity",
        "actions": [
          "androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"
        ]
      }
    ],
    "aliases": [
      {
        "name": "exact.health.ViewPermissionUsageActivity",
        "targetActivity": "exact.health.PrivacyPolicyActivity",
        "action": "android.intent.action.VIEW_PERMISSION_USAGE",
        "category": "android.intent.category.HEALTH_PERMISSIONS"
      }
    ]
  },
  "artifacts": [],
  "class": "exact.health.HealthModule"
}
