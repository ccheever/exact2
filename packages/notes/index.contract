// @exact/notes — the second fixture package for LLP 1121 stage 11's gate:
// a note whose gap and padding are space.md and whose corner is radius.lg,
// through its own tokens (notes.tamber), and a rule colour the app sets by
// its full name.

component Note
  props
    body: string
  view
    column testId="notes-note" padding="notes.gap" gap="notes.gap" border-radius="notes.corner" background-color="notes.fill"
      view testId="notes-inner" width=40 height=16 background-color="notes.rule"
      text body color="notes.rule"
