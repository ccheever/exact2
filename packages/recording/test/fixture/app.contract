// The conformance fixture (LLP 1133.001 D7, LLP 1133.009 §11): every name of
// @exact/media-capture's audio half and of @exact/recording, read and sent as
// an app would, each answer shown by testId for the suites.
use getUserMedia, stopTrack, setTrackEnabled, mediaStreamTrack, enumerateDevices, microphoneStatus, MediaStream, MediaStreamTrack, MediaDeviceList, MicrophoneStatus from "@exact/media-capture"
use startMediaRecorder, stopMediaRecorder, pauseMediaRecorder, resumeMediaRecorder, mediaRecorderState, isTypeSupported, audioLevel, MediaRecorderInfo, RecordedMedia, AudioLevel, TypeSupport from "@exact/recording"

component Fixture
  state trackId = ""
  state streamId = ""
  state recorderId = ""
  state takes = 0
  state mime = ""
  state metering = false
  resource mic = microphoneStatus() as shape MicrophoneStatus else empty()
  resource devices = enumerateDevices() as shape MediaDeviceList else empty()
  resource track = mediaStreamTrack(track=trackId) as shape MediaStreamTrack else empty()
  resource level = audioLevel(track=(metering ? trackId : ""), interval=100, history=50) as shape AudioLevel else empty()
  resource rec = mediaRecorderState(recorder=recorderId) as shape MediaRecorderInfo else empty()
  resource webm = isTypeSupported(type="audio/webm") as shape TypeSupport else empty()
  resource mp4 = isTypeSupported(type="audio/mp4") as shape TypeSupport else empty()
  mutation opened as shape MediaStream then arm
  mutation started as shape MediaRecorderInfo then begun
  mutation saved as shape RecordedMedia
  mutation info as shape MediaRecorderInfo
  mutation trk as shape MediaStreamTrack
  action open
    send opened = getUserMedia(audio=true)
  action openNothing
    send opened = getUserMedia(audio=false)
  action arm
    match opened
      case some(s)
        streamId = s.id
        trackId = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
      case none
        trackId = ""
  action record
    takes = takes + 1
    send started = startMediaRecorder(stream=streamId, path=`app:/data/takes/take-${takes + 1}`)
  action recordAs(type: string)
    takes = takes + 1
    mime = type
    send started = startMediaRecorder(stream=streamId, mimeType=type, path=`app:/data/takes/take-${takes + 1}`)
  action recordOutside
    send started = startMediaRecorder(stream=streamId, path="app:/data/elsewhere/take")
  action begun
    match started
      case some(r)
        recorderId = r.id
      case none
        recorderId = recorderId
  action stop
    send saved = stopMediaRecorder(recorder=recorderId)
  action pause
    send info = pauseMediaRecorder(recorder=recorderId)
  action resume
    send info = resumeMediaRecorder(recorder=recorderId)
  action endTrack
    send trk = stopTrack(track=trackId)
  action disable
    send trk = setTrackEnabled(track=trackId, enabled=false)
  action enable
    send trk = setTrackEnabled(track=trackId, enabled=true)
  action meter
    metering = ! metering
  action bogus
    send trk = stopTrack(track="no-such-track")
  view
    column gap=8 padding=16
      text `${mic.available} ${mic.state}` testId="status"
      text `${devices.devices.length}` testId="devices"
      text `${track.readyState} ${track.muted} ${match track.muteReason { case some(r) => r, case none => "-" }} ${track.enabled}` testId="track"
      text `${level.levels.length} ${sum(level.levels) > 0} ${round(level.totalSamplesDuration * 10) / 10}` testId="level"
      text `${rec.state} ${rec.duration} ${match rec.reason { case some(r) => r, case none => "-" }}` testId="rec"
      text `${webm.supported} ${mp4.supported}` testId="types"
      match opened
        case some(s)
          text `${s.id} ${s.tracks.length}` testId="opened"
        case none
          text "none" testId="opened"
      match failure(opened)
        case some(f)
          text f.code testId="opened-error"
        case none
          text "" testId="opened-error"
      match started
        case some(r)
          text `${r.state} ${r.mimeType} ${r.path}` testId="started"
        case none
          text "none" testId="started"
      match failure(started)
        case some(f)
          text f.code testId="started-error"
        case none
          text "" testId="started-error"
      match saved
        case some(m)
          text `${m.path} ${m.mimeType} ${m.size > 0}` testId="saved"
          audio src=m.path preload="metadata" controls=true testId="playback"
        case none
          text "none" testId="saved"
      match failure(info)
        case some(f)
          text f.code testId="info-error"
        case none
          text "" testId="info-error"
      match failure(trk)
        case some(f)
          text f.code testId="trk-error"
        case none
          text "" testId="trk-error"
      button press=open testId="open"
        text "Open"
      button press=openNothing testId="open-nothing"
        text "Open nothing"
      button press=record testId="record"
        text "Record"
      button press=recordAs("audio/mp4") testId="record-mp4"
        text "Record MP4"
      button press=recordOutside testId="record-outside"
        text "Record outside"
      button press=stop testId="stop"
        text "Stop"
      button press=pause testId="pause"
        text "Pause"
      button press=resume testId="resume"
        text "Resume"
      button press=endTrack testId="end-track"
        text "End track"
      button press=disable testId="disable"
        text "Disable"
      button press=enable testId="enable"
        text "Enable"
      button press=meter testId="meter"
        text (metering ? "Unmeter" : "Meter")
      button press=bogus testId="bogus"
        text "Bogus"
