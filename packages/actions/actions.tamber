// The design of @exact/actions (LLP 1139 D1): the tokens its components'
// params default to. Spacing and corners are base names; colours are the
// package's own, which an app sets by full name (the clone sets them to its
// palette's roles).
tamber actions

theme
  actions.post-fill = light-dark(#006aff, #0f73ff)
  actions.post-pressed = light-dark(#0059d6, #4d97ff)
  actions.post-dim = light-dark(#75afff, #1258bd)
  actions.post-ink = #ffffff  scheme=fixed
  actions.post-height: length = 32px
  actions.post-pad: length = space.md
  actions.post-corner: length = radius.full
  // The action row (ActionRow): its icons' tint, a count's colour, and each
  // toggle's colour when on; its spacing on the base scale.
  actions.row-tint = light-dark(#667b99, #6f839f)
  actions.row-count = light-dark(#667b99, #6f839f)
  actions.row-reposted = light-dark(#09b35e, #0ac266)
  actions.row-liked = #ec4899  scheme=fixed
  actions.row-saved = light-dark(#006aff, #0f73ff)
  actions.row-hover = light-dark(#f9fafb, #1c2736)
  actions.row-gap: length = space.md
  actions.row-hit: length = space.xs
  actions.row-corner: length = radius.full
  actions.row-icon-gap: length = space.xs
  actions.row-top: length = space.xs
  actions.row-trail: length = space.xs
  actions.row-trail-big: length = space.sm
  // The first button's lead past the row's edge, so its icon sits on the
  // text's line (no base name is negative).
  actions.row-lead: length = -6px
  actions.row-lead-big: length = -2px
