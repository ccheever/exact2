// The design of @exact/actions (LLP 1139 D1): the tokens its components'
// params default to. Spacing and corners are base names. A neutral colour
// (an icon's tint, a count, a hover's ground) is the platform's role, so the
// row looks native where no app sets it; the brand's are the package's own.
// An app sets any of them by full name (the clone sets them all to its
// palette's colours).
tamber actions

theme
  actions.post-fill = light-dark(#006aff, #0f73ff)
  actions.post-pressed = light-dark(#0059d6, #4d97ff)
  actions.post-dim = light-dark(#75afff, #1258bd)
  actions.post-ink = #ffffff  scheme=fixed
  actions.post-height: length = 32px
  actions.post-pad: length = space.md
  actions.post-corner: length = radius.full
  // The action row (ActionRow): its icons' tint, a count's colour, and each
  // toggle's colour when on; its spacing on the base scale.
  actions.row-tint = -exact-secondary-label
  actions.row-count = -exact-secondary-label
  actions.row-reposted = light-dark(#09b35e, #0ac266)
  actions.row-liked = #ec4899  scheme=fixed
  actions.row-saved = light-dark(#006aff, #0f73ff)
  actions.row-hover = -exact-secondary-background
  actions.row-gap: length = space.md
  actions.row-hit: length = space.xs
  actions.row-corner: length = radius.full
  actions.row-icon-gap: length = space.xs
  actions.row-top: length = space.xs
  actions.row-trail: length = space.xs
  actions.row-trail-big: length = space.sm
  // The first button's lead past the row's edge, so its icon sits on the
  // text's line (no base name is negative).
  actions.row-lead: length = -6px
  actions.row-lead-big: length = -2px
  // Its icons' size and its counts' type, beside a big (a thread's anchor
  // post's) row's.
  // The three counted buttons' widest, and a disabled button's opacity.
  actions.row-max: length = 320px
  actions.row-dim: number = 0.6
  actions.icon: length = 18px
  actions.icon-big: length = 22px
  actions.count-size: length = 0.81875rem
  actions.count-size-big: length = 0.9375rem
  actions.count-line: length = 1.0625rem
  // The composer's frame (ComposeFrame): its bar's and toolbar's text and
  // icons in the accent, the languages too; what's left in the label
  // colour, the system red once over; the ring's arc on a separator track.
  actions.compose-tint = AccentColor
  actions.compose-label = actions.compose-tint
  actions.compose-surface = -exact-background
  actions.compose-divider = -exact-separator
  actions.compose-count = -exact-label
  actions.compose-over = -exact-system-red
  actions.compose-track = -exact-separator
  actions.compose-arc = actions.compose-tint
  // Its bar: the edges, the height, Cancel's and Drafts' text buttons.
  actions.compose-bar-lead: length = space.sm
  actions.compose-bar-trail: length = 12px
  actions.compose-bar-height: length = 54px
  actions.compose-text-pad: length = 10px
  actions.compose-text-height: length = 36px
  actions.compose-text-size: length = 0.9375rem
  actions.compose-drafts-pad: length = 12px
  actions.compose-drafts-gap: length = space.xs
  // Its toolbar: the edges, the buttons' hit padding and gaps, the icons,
  // the languages' label, and the counter's width, gap and ring.
  actions.compose-hairline: length = -exact-hairline
  actions.compose-toolbar-lead: length = 7px
  actions.compose-toolbar-trail: length = space.md
  actions.compose-toolbar-pad: length = space.xs
  actions.compose-tool-gap: length = space.xs
  actions.compose-tool-pad: length = space.sm
  actions.compose-tool-corner: length = radius.full
  actions.compose-icon: length = 24px
  actions.compose-dim: number = 0.5
  actions.compose-trail-gap: length = 12px
  actions.compose-add-pad: length = 6px
  actions.compose-add-icon: length = 22px
  actions.compose-lang-pad: length = space.xs
  actions.compose-lang-max: length = 100px
  actions.compose-small-size: length = 0.81875rem
  actions.compose-count-line: length = 1.1875rem
  actions.compose-counter-width: length = 65px
  actions.compose-counter-gap: length = space.sm
  actions.compose-ring: length = 30px
  // An app's own bar's items (BarItem): the icon in the label colour, a
  // count's pill and dot in the accent with white text; the item's column
  // over and under its icon, held at 0.8; the pill's and the dot's size,
  // type and offsets.
  actions.bar-tint = -exact-label
  actions.bar-badge = AccentColor
  actions.bar-badge-ink = #ffffff  scheme=fixed
  actions.bar-item-top: length = 13px
  actions.bar-item-bottom: length = space.xs
  actions.bar-item-press: number = 0.8
  actions.bar-badge-top: length = space.sm
  actions.bar-badge-pad: length = 5px
  actions.bar-badge-pad-top: length = 1px
  actions.bar-badge-pad-bottom: length = 2px
  // Bluesky's pill is a rounded rectangle at 6, not a full pill: it stays
  // 6 as the type grows.
  actions.bar-badge-corner: length = 6px
  actions.bar-badge-size: length = 0.75rem
  actions.bar-badge-line: length = 0.9375rem
  actions.bar-dot-top: length = 10px
  actions.bar-dot-gap: length = space.xs
  actions.bar-dot: length = space.sm
  actions.bar-dot-corner: length = radius.full
  // An app's own header's buttons (HeaderButton): a round slot, its icon in
  // the label colour (a small one's smaller, in the secondary label), and
  // the back button's pull to the edge (no base name is negative).
  actions.header-tint = -exact-label
  actions.header-tint-small = -exact-secondary-label
  actions.header-slot: length = 33px
  actions.header-corner: length = radius.full
  actions.header-icon: length = 24px
  actions.header-icon-small: length = 20px
  actions.header-lead: length = -3px
  // A person's Follow button (FollowButton, Bluesky's FollowButtonInner):
  // each tone's fill and text, not following and following, from Bluesky's
  // Button.tsx over ALF's palette (dark is ALF's dim, as the package's other
  // colours are). primary: primary_500 and white; following, secondary's
  // contrast_50 and contrast_700 (inverted's following too). inverted:
  // secondary_inverted's contrast_900 and text_inverted (contrast_0).
  // subtle: primary_subtle's primary_50 and primary_600; following, the
  // notification author's ghost secondary, the page (contrast_0) and
  // contrast_600. overlay: secondary_inverted in the video feed's own dark
  // theme (ALF's dark, black), contrast_900 and contrast_0, in both schemes
  // and both states.
  actions.follow-fill = light-dark(#006aff, #0f73ff)
  actions.follow-ink = #ffffff  scheme=fixed
  actions.follow-following-fill = light-dark(#eff2f6, #222e3f)
  actions.follow-following-ink = light-dark(#405168, #abb8c9)
  actions.follow-inverted-fill = light-dark(#232e3e, #e2e7ee)
  actions.follow-inverted-ink = light-dark(#ffffff, #151d28)
  actions.follow-subtle-fill = light-dark(#e5f0ff, #122949)
  actions.follow-subtle-ink = light-dark(#0059d6, #4d97ff)
  actions.follow-subtle-following-fill = light-dark(#ffffff, #151d28)
  actions.follow-subtle-following-ink = light-dark(#526580, #8d9db4)
  actions.follow-overlay-fill = #dce2ea  scheme=fixed
  actions.follow-overlay-ink = #000000  scheme=fixed
  // Bluesky's Button sizes: small (8 by 14, gap 5, text_sm medium on a 17
  // line, leading_snug, a 16 icon in a 17 box pulled 2 each side; round 33)
  // and tiny (5 by 10, gap 3, text_xs semi-bold on a 15 line, a 12 icon in a
  // 15 box pulled 1; round 25), both
  // rounded_full; held smaller while pressed, a round one more.
  actions.follow-corner: length = radius.full
  actions.follow-pad-block: length = 8px
  actions.follow-pad-inline: length = 14px
  actions.follow-gap: length = 5px
  actions.follow-size: length = 0.81875rem
  actions.follow-line: length = 1.0625rem
  actions.follow-icon: length = 16px
  actions.follow-icon-box: length = 17px
  actions.follow-icon-pull: length = -2px
  actions.follow-round: length = 33px
  actions.follow-tiny-pad-block: length = 5px
  actions.follow-tiny-pad-inline: length = 10px
  actions.follow-tiny-gap: length = 3px
  actions.follow-tiny-size: length = 0.70625rem
  actions.follow-tiny-line: length = 0.9375rem
  actions.follow-tiny-icon: length = 12px
  actions.follow-tiny-icon-box: length = 15px
  actions.follow-tiny-icon-pull: length = -1px
  actions.follow-tiny-round: length = 25px
  actions.follow-press: number = 0.97
  actions.follow-press-tiny: number = 0.97
  actions.follow-press-round: number = 0.95

// The action row's icons, as templates every host draws from the same path
// (theme2's path-icons ruling): no `sf`, so Apple draws the path, not an SF
// Symbol. Each SVG's `d` is the path function's it replaced, byte for byte.
// The composer's three were drawn even-odd, but their holes wind against
// their outlines, so they are written nonzero and fill the same.
// BarItem's and HeaderButton's icons are their caller's `d`, not the
// package's, so they stay paths (theme2's Q4). FollowButton's two are the
// exception: Bluesky's PlusLarge and Check paths, with an `sf` name, so
// Apple draws SF Symbols' plus and checkmark (LLP 1121 stage 15 B batch 2).
icons
  actions.reply = icon(svg "reply.svg")
  actions.repost = icon(svg "repost.svg")
  actions.heart = icon(svg "heart.svg")
  actions.heart-filled = icon(svg "heart-filled.svg")
  actions.bookmark = icon(svg "bookmark.svg")
  actions.bookmark-filled = icon(svg "bookmark-filled.svg")
  actions.share = icon(svg "share.svg")
  actions.dots = icon(svg "dots.svg")
  // ComposeFrame's toolbar.
  actions.gallery = icon(svg "gallery.svg")
  actions.camera = icon(svg "camera.svg")
  actions.gif = icon(svg "gif.svg")
  // FollowButton's: follow (plus) and following (check).
  actions.follow-add = icon(sf "plus", svg "follow-add.svg")
  actions.follow-check = icon(sf "checkmark", svg "follow-check.svg")
