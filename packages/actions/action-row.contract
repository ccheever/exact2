
style ActionCount
  font-size="actions.count-size" line-height="actions.count-line" font-variant-numeric="tabular-nums"

style ActionButton
  :hover
    background-color="actions.row-hover"
  :focus-visible
    background-color="actions.row-hover"
  :disabled
    opacity="actions.row-dim"

// A post's action row (the clone's Controls): reply, repost, like, then
// save, share and more. The app passes the counts as it words them (`""`
// for none), the numbers its labels read, each toggle's state, and the
// actions with their arguments bound.
component ActionRow
  params
    gap: length = "actions.row-gap" control = "token" group = "Layout" priority = 1 label = "Spacing"
    tint: color = "actions.row-tint" control = "token" group = "Color" priority = 1 label = "Icon tint"
    hit: length = "actions.row-hit" control = "token" group = "Layout" priority = 2 label = "Button padding"
    radius: length = "actions.row-corner" control = "token" group = "Shape" priority = 3 label = "Press shape radius"
  props
    id: string
    big: bool
    haptics: bool
    replies: string
    replyN: number
    replyDisabled: bool
    reposts: string
    repostN: number
    reposted: bool
    likes: string
    likeN: number
    liked: bool
    saved: bool
    reply: action
    repost: action
    like: action
    save: action
    share: action
    shareNow: action
    more: action
  parts
    row: space
    reply: paint shape space
    repost: paint shape space
    like: paint shape space
    save: paint shape space
    share: paint shape space
    more: paint shape space
  view
    row part="row" testId=`actions-${id}`
      justify-content="space-between"
      align-items="center"
      padding-top=(big ? "0px" : "actions.row-top")
      gap="param.gap"
      row flex=1 max-width="actions.row-max" align-items="center"
        // A threadgate that keeps you out: the reply button does nothing,
        // and dims (its `:disabled`).
        column flex=1
          align-items="flex-start"
          margin-left=(big ? "actions.row-lead-big" : "actions.row-lead")
          button part="reply" class=ActionButton
            testId=`reply-${id}`
            aria-label=`Reply (${replyN})`
            press=reply
            disabled=replyDisabled
            display="flex"
            flex-direction="row"
            align-items="center"
            gap="actions.row-icon-gap"
            padding="param.hit"
            border-radius="param.radius"
            -exact-press-haptic=(haptics ? "impact-light" : "none")
            image "symbol:actions.reply"
              width=(big ? "actions.icon-big" : "actions.icon")
              height=(big ? "actions.icon-big" : "actions.icon")
              flex-shrink=0
              aria-hidden=true
              color="param.tint"
            if replies != ""
              text replies class=ActionCount
                font-size=(big ? "actions.count-size-big" : "actions.count-size")
                color="actions.row-count"
        column flex=1 align-items="flex-start"
          button part="repost" class=ActionButton
            testId=`repost-${id}`
            aria-label=(reposted ? `Undo repost (${repostN})` : `Repost (${repostN})`)
            press=repost
            display="flex"
            flex-direction="row"
            align-items="center"
            gap="actions.row-icon-gap"
            padding="param.hit"
            border-radius="param.radius"
            -exact-press-haptic=(haptics ? "impact-light" : "none")
            image "symbol:actions.repost"
              width=(big ? "actions.icon-big" : "actions.icon")
              height=(big ? "actions.icon-big" : "actions.icon")
              flex-shrink=0
              aria-hidden=true
              color=(reposted ? "actions.row-reposted" : "param.tint")
            if reposts != ""
              text reposts class=ActionCount
                font-size=(big ? "actions.count-size-big" : "actions.count-size")
                font-weight=(reposted ? 600 : 400)
                color=(reposted ? "actions.row-reposted" : "actions.row-count")
        column flex=1 align-items="flex-start"
          button part="like" class=ActionButton
            testId=`like-${id}`
            aria-label=(liked ? `Unlike (${likeN})` : `Like (${likeN})`)
            aria-pressed=liked
            press=like
            display="flex"
            flex-direction="row"
            align-items="center"
            gap="actions.row-icon-gap"
            padding="param.hit"
            border-radius="param.radius"
            -exact-press-haptic=(haptics ? "impact-light" : "none")
            image (liked ? "symbol:actions.heart-filled" : "symbol:actions.heart")
              width=(big ? "actions.icon-big" : "actions.icon")
              height=(big ? "actions.icon-big" : "actions.icon")
              flex-shrink=0
              aria-hidden=true
              color=(liked ? "actions.row-liked" : "param.tint")
            if likes != ""
              text likes class=ActionCount
                font-size=(big ? "actions.count-size-big" : "actions.count-size")
                font-weight=(liked ? 600 : 400)
                color=(liked ? "actions.row-liked" : "actions.row-count")
      row gap=(big ? "actions.row-trail-big" : "actions.row-trail") align-items="center"
        button part="save" class=ActionButton
          testId=`bookmark-${id}`
          aria-label=(saved ? "Remove from saved posts" : "Save")
          aria-pressed=saved
          press=save
          padding="param.hit"
          border-radius="param.radius"
          -exact-press-haptic=(haptics ? "impact-light" : "none")
          image (saved ? "symbol:actions.bookmark-filled" : "symbol:actions.bookmark")
            width=(big ? "actions.icon-big" : "actions.icon")
            height=(big ? "actions.icon-big" : "actions.icon")
            flex-shrink=0
            aria-hidden=true
            color=(saved ? "actions.row-saved" : "param.tint")
        // The share menu; a long press shares at once.
        button part="share" class=ActionButton
          testId=`share-${id}`
          aria-label="Open share menu"
          press=share
          contextmenu=shareNow
          padding="param.hit"
          border-radius="param.radius"
          -exact-press-haptic=(haptics ? "impact-light" : "none")
          image "symbol:actions.share"
            width=(big ? "actions.icon-big" : "actions.icon")
            height=(big ? "actions.icon-big" : "actions.icon")
            flex-shrink=0
            aria-hidden=true
            color="param.tint"
        button part="more" class=ActionButton
          testId=`more-${id}`
          aria-label="Open post options menu"
          press=more
          padding="param.hit"
          border-radius="param.radius"
          -exact-press-haptic=(haptics ? "impact-light" : "none")
          image "symbol:actions.dots"
            width=(big ? "actions.icon-big" : "actions.icon")
            height=(big ? "actions.icon-big" : "actions.icon")
            flex-shrink=0
            aria-hidden=true
            color="param.tint"
