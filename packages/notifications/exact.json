{
  "kind": "interface",
  "name": "@exact/notifications",
  "version": "1.0.0",
  "grants": [
    "device.notifications"
  ],
  "permission": {
    "name": "notifications",
    "status": "notificationStatus",
    "field": "state",
    "denied": "NotAllowedError"
  },
  "shapes": {
    "NotificationStatus": {
      "available": "bool",
      "state": "enum<granted|prompt|denied|unknown>",
      "badge": "bool",
      "apple": "option<AppleNotificationSettings>"
    },
    "NotificationEvent": {
      "tag": "string",
      "data": "option<string>",
      "title": "string",
      "body": "option<string>"
    }
  },
  "names": [
    {
      "send": "showNotification",
      "permission": "asks",
      "options": {
        "title": "string",
        "body": "option<string>",
        "tag": "option<string>",
        "silent": "option<bool>",
        "data": "option<string>",
        "showTrigger": "option<number>",
        "navigate": "option<string>"
      },
      "answers": null,
      "substitute": {
        "list": {
          "state": "notifications",
          "key": "tag",
          "at": "showTrigger",
          "launch": "notification",
          "tap": {
            "event": "notificationclick",
            "args": ["tag", { "tag": "tag", "data": "data", "title": "title", "body": "body" }],
            "navigate": "navigate"
          }
        }
      }
    },
    {
      "send": "closeNotification",
      "permission": "none",
      "options": {
        "tag": "string"
      },
      "answers": null,
      "substitute": {
        "unlist": "tag"
      }
    },
    {
      "send": "setAppBadge",
      "permission": "none",
      "enforceRange": ["contents"],
      "options": {
        "contents": "option<number>"
      },
      "answers": null,
      "substitute": {
        "set": { "state": "badge", "scope": "app", "from": "contents", "absent": "flag", "zero": null }
      }
    },
    {
      "send": "clearAppBadge",
      "permission": "none",
      "answers": null,
      "substitute": {
        "set": { "state": "badge", "scope": "app", "value": null }
      }
    },
    {
      "source": "notificationStatus",
      "live": true,
      "answers": "NotificationStatus",
      "substitute": {
        "default": { "available": true, "state": "prompt", "badge": true }
      }
    },
    {
      "send": "requestNotificationPermission",
      "permission": "request",
      "answers": "NotificationStatus",
      "substitute": {
        "answers": "notificationStatus"
      }
    },
    {
      "event": "notificationclick",
      "on": "root",
      "raised": "activation",
      "args": ["string", "NotificationEvent"],
      "hold": 16
    }
  ]
}
