use Name, Avatar, VerifiedBadge from "./common.contract"

// A post card's shell (the clone's FeedPost): the thread's lines above and
// below, the avatar, who and when, an optional context line (its icon by
// `context`, its words the app's: "Pinned", who reposted it) and reply line,
// and the post's content in its slot. The app words the time (`time`) and
// passes the avatar as it should load.
component PostCard
  params
    surface: color = "cards.surface" control = "token" group = "Color" priority = 1 label = "Surface"
    divider: color = "cards.divider" control = "token" group = "Color" priority = 2 label = "Divider"
    meta: color = "cards.meta" control = "token" group = "Color" priority = 2 label = "Meta text"
  props
    id: string
    press: action
    inThread: bool
    lineAbove: bool
    lineBelow: bool
    context: enum<"none", "pinned", "reposted">
    contextText: string
    replyTo: string
    profileHref: string
    avatar: string
    name: string
    handle: string
    time: string
    badge: enum<"none", "verified", "verifier">
  slot
  parts
    surface: paint space
    avatar: space
    meta: text space
    content: space
  view
    column part="surface" press=press
      testId=`post-${id}`
      padding-left=(inThread ? "cards.pad-start-thread" : "cards.pad-start")
      padding-right=(inThread ? "cards.pad-end-thread" : "cards.pad-end")
      border-top-width=(lineAbove ? "0px" : "cards.hairline")
      border-top-style="solid"
      border-top-color="param.divider"
      padding-bottom=(lineBelow ? "0px" : "cards.pad-bottom")
      background-color="param.surface"
      row gap="cards.column-gap" padding-left="cards.lead"
        column width="cards.avatar" align-items="center"
          if lineAbove
            box width="cards.line-width"
              flex-grow=1
              margin-bottom="cards.line-gap"
              background-color=(inThread ? "cards.line-thread" : "cards.line")
        column padding-top=(inThread ? "cards.top-thread" : "cards.top") flex-shrink=1 min-width=0
          if context != "none"
            row align-items="center"
              margin-left="cards.context-hang"
              margin-bottom="cards.context-under"
              gap="cards.context-gap"
              image (context == "pinned" ? "symbol:cards.pin" : "symbol:cards.repost")
                width="cards.context-icon"
                height="cards.context-icon"
                flex-shrink=0
                aria-hidden=true
                color="param.meta"
              text contextText font-size="cards.small-size"
                font-weight=500
                line-height="cards.small-line"
                white-space="nowrap"
                text-overflow="ellipsis"
                overflow="hidden"
                color="param.meta"
      row margin-top="cards.nudge"
        column part="avatar" testId=`postcard-avatar-${id}`
          padding-left="cards.avatar-start"
          padding-right=(inThread ? "cards.avatar-end-thread" : "cards.avatar-end")
          align-items="center"
          link href=profileHref testId=`avatar-${id}` aria-label=name display="flex"
            Avatar(src=avatar, size="cards.avatar")
          if lineBelow
            box width="cards.line-width"
              flex-grow=1
              margin-top="cards.line-gap"
              background-color=(inThread ? "cards.line-thread" : "cards.line")
        column part="content" testId=`postcard-content-${id}` flex=1 min-width=0
          row part="meta" testId=`postcard-meta-${id}`
            gap="cards.meta-gap"
            padding-bottom="cards.meta-under"
            align-items="baseline"
            // The name keeps its width up to 70%; the handle gives way first.
            text name testId=`name-${id}`
              font-size="cards.text-size"
              font-weight=600
              line-height="cards.text-line"
              class=Name
              max-width="70%"
              white-space="nowrap"
              text-overflow="ellipsis"
              overflow="hidden"
              flex-shrink=0
            if badge != "none"
              column align-self="center" margin-left="cards.badge-hang" flex-shrink=0
                VerifiedBadge(badge=badge, size="cards.badge-size", ink="cards.badge", mark="cards.badge-mark")
            text `@${handle}` font-size="cards.text-size"
              line-height="cards.text-line"
              white-space="nowrap"
              text-overflow="ellipsis"
              overflow="hidden"
              flex-shrink=10
              min-width=0
              color="param.meta"
            text `· ${time}` font-size="cards.text-size"
              line-height="cards.text-line"
              white-space="nowrap"
              flex-shrink=0
              color="param.meta"
          if replyTo != ""
            row gap="cards.meta-gap" padding-bottom="cards.meta-under" align-items="center"
              column position="relative" top="cards.reply-rise"
                image "symbol:cards.corner-down-right"
                  width="cards.reply-icon"
                  height="cards.reply-icon"
                  flex-shrink=0
                  aria-hidden=true
                  color="param.meta"
              text replyTo font-size="cards.small-size"
                line-height="cards.small-line"
                white-space="nowrap"
                text-overflow="ellipsis"
                overflow="hidden"
                color="param.meta"
          children
