// An icon: one path on a 24 box, in a colour.
component Glyph
  props
    d: string
    size: string
    color: string
  view
    svg viewBox="0 0 24 24" width=size height=size flex-shrink=0 aria-hidden=true
      path fill=color d=d

style Name
  color="cards.name"

// A person's picture in a circle, or the default figure, under a hairline.
component Avatar
  props
    src: string
    size: string
  view
    column position="relative"
      width=size
      height=size
      border-radius="cards.avatar-corner"
      overflow="hidden"
      flex-shrink=0
      background-color="cards.avatar-ground"
      if src != ""
        image src width=size height=size object-fit="cover" alt=""
      else
        svg viewBox="0 0 24 24" width=size height=size aria-hidden=true
          circle cx=12 cy=12 r=12 fill="cards.avatar-default"
          circle cx=12 cy=9.5 r=3.5 fill="cards.badge-mark"
          path fill="cards.badge-mark"
            d="M 12.058 22.784 C 9.422 22.784 7.007 21.836 5.137 20.262 C 5.667 17.988 8.534 16.25 11.99 16.25 C 15.494 16.25 18.391 18.036 18.864 20.357 C 17.01 21.874 14.64 22.784 12.058 22.784 Z"
      box position="absolute"
        inset=0
        border-radius="cards.avatar-corner"
        border-width="cards.hairline"
        border-style="solid"
        border-color="cards.avatar-ring"
        aria-hidden=true

// A verification badge: "verified", "verifier", or "" for none.
component VerifiedBadge
  props
    badge: string
    size: string
  view
    if badge == "verified"
      svg testId="verified-badge"
        role="img"
        aria-label="Verified"
        viewBox="0 0 24 24"
        width=size
        height=size
        flex-shrink=0
        circle cx=12 cy=12 r=11.5 fill="cards.badge"
        path fill="cards.badge-mark"
          fill-rule="evenodd"
          d="M17.659 8.175a1.36 1.36 0 0 1 0 1.925l-6.224 6.223a1.36 1.36 0 0 1-1.925 0L6.4 13.212a1.361 1.361 0 0 1 1.925-1.925l2.149 2.148 5.26-5.26a1.36 1.36 0 0 1 1.925 0Z"
    else if badge == "verifier"
      svg testId="verifier-badge"
        role="img"
        aria-label="Trusted verifier"
        viewBox="0 0 24 24"
        width=size
        height=size
        flex-shrink=0
        path fill="cards.badge"
          fill-rule="evenodd"
          d="M8.792 1.615a4.154 4.154 0 0 1 6.416 0 4.15 4.15 0 0 0 3.146 1.515 4.154 4.154 0 0 1 4 5.017 4.15 4.15 0 0 0 .777 3.404 4.154 4.154 0 0 1-1.427 6.255 4.15 4.15 0 0 0-2.177 2.73 4.154 4.154 0 0 1-5.781 2.784 4.15 4.15 0 0 0-3.492 0 4.154 4.154 0 0 1-5.78-2.784 4.15 4.15 0 0 0-2.178-2.73A4.154 4.154 0 0 1 .87 11.551a4.15 4.15 0 0 0 .776-3.404 4.154 4.154 0 0 1 4-5.017 4.15 4.15 0 0 0 3.146-1.515Z"
        path fill="cards.badge-mark"
          fill-rule="evenodd"
          d="M17.861 8.26a1.44 1.44 0 0 1 0 2.033l-6.571 6.571a1.437 1.437 0 0 1-2.033 0L5.97 13.58a1.438 1.438 0 0 1 2.033-2.033l2.27 2.269 5.554-5.555a1.437 1.437 0 0 1 2.033 0Z"
