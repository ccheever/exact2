// @exact/scale-fixture-notes — the second fixture package for LLP 1121 stage 11's gate:
// a note whose gap and padding are space.md and whose corner is radius.lg,
// through its own tokens (scale-fixture-notes.tamber), and a rule colour the app sets by
// its full name.

component Note
  props
    body: string
  view
    column testId="notes-note" padding="scale-fixture-notes.gap" gap="scale-fixture-notes.gap" border-radius="scale-fixture-notes.corner" background-color="scale-fixture-notes.fill"
      view testId="notes-inner" width=40 height=16 background-color="scale-fixture-notes.rule"
      text body color="scale-fixture-notes.rule" testId="notes-body"
