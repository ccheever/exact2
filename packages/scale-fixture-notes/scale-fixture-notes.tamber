// The design of @exact/scale-fixture-notes (LLP 1121 D11): its gap the base space.md, its
// corner radius.lg, and a rule colour an app may set by its full name.
tamber scale-fixture-notes

theme
  scale-fixture-notes.gap = space.md
  scale-fixture-notes.corner = radius.lg
  scale-fixture-notes.fill = #ff0000  scheme=fixed
  scale-fixture-notes.rule = #ffff00  scheme=fixed
