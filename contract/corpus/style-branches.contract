// Accept fixture: a style attribute's branches may mix a length and a
// keyword. A style row is one CSS value space, so `-14.5` beside `"auto"`
// (or `100` beside `"50%"`) is one value, not two types.
component StyleBranches
  state open = false
  state fixed = none
  action set(to: bool) writes open, fixed
    open = to
    if to
      fixed = some(200)
    else
      fixed = none
  view
    column testId="sheet" margin-top=(open ? -14.5 : "auto") width=(open ? 100 : "50%") height=(match fixed { case some(h) => h, case none => "auto" })
      text "sheet"
