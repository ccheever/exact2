// Accept fixture: documents in Contract (`@ref LLP 1048.003` part A). The
// innermost active `head` wins field by field (D1): the route's title and
// description over the site's, the site's image where the route sets none,
// and nothing from a route the navigation root has not selected. The
// not-found view declares its HTTP status. A route's content scrolls as the
// page (`scroll document`, D4). Routes declare their policies (D5).
routes nav
  tab home "/" render=build
    post "/post/:post" render=request activate=idle
  notfound render=build

shape Post
  title: string
  summary: string

component Site
  resource post = loadPost(params(nav, "post")) as shape Post
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" testId="navigation"
      head title="Site" description="Every post" image="/assets/site.png" robots="index"
      each e in stack(nav) key = e.id
        column navigationKey=`${e.id}` testId=`route-${e.name}`
          when e.name == "home"
            head title="Home" canonical="/"
            text "Home"
          when e.name == "post"
            head title=post.title description=post.summary canonical=`/post/${e.params.post}`
            text post.title
          when e.name == "notfound"
            head title="Not found" robots="noindex" status=404
            text "Nothing here"
          scroll document flex=1 min-height=0 testId="page"
            text "Content"
            scroll height=100 testId="inner"
              text "An inner scroller"
