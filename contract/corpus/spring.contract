// Accept fixture: a `spring()` transition. CSS cannot play it, so on the web
// the host lowers it to frames (LLP 1002 D2); the easing beside it stays CSS.
component Pop
  state big = false
  action toggle
    big = not big
  view
    column testId="root"
      button press=toggle aria-label="Toggle" testId="toggle"
        text "Toggle"
      text "Hello" testId="hello" scale=(big ? 1.5 : 1) opacity=(big ? 0.5 : 1) transition="scale spring(180, 12, 1), opacity 200ms linear"
