// Accept fixture: a vector `path` drawn along its pen path (LLP 1065). A
// signature of three strokes — a loop, a flourish, an underline — draws one
// subpath after another when `drawn` turns on; a second copy plays the same
// draw from `keyframes` as soon as it exists.
keyframes draw
  from
    stroke-end=0
  to
    stroke-end=1

style Ink
  stroke="light-dark(#1d1d1f, #0a84ff)"
  stroke-width=9
  stroke-linecap="round"
  stroke-linejoin="round"
  fill="none"

component Signature
  state drawn = false
  action sign writes drawn
    drawn = not drawn
  view
    column testId="root" gap=16 padding=24
      button press=sign aria-label="Sign" testId="sign"
        text "Sign"
      path testId="mark" class=Ink width=300 height=150 viewBox="0 0 200 100" d="M12 70c10-40 30-55 42-40s-6 45-20 35 14-40 38-38c14 2 6 30 18 28s10-24 22-20 M110 40q20-30 40 0t40 0 M20 88h160" stroke-end=(drawn ? 1 : 0) transition="stroke-end 1600ms cubic-bezier(.45,0,.55,1)"
      path testId="stamp" class=Ink width=150 height=75 viewBox="0 0 200 100" aria-label="Signed" d="M12 70c10-40 30-55 42-40s-6 45-20 35 14-40 38-38c14 2 6 30 18 28s10-24 22-20 M110 40q20-30 40 0t40 0 M20 88h160" animation="draw 1600ms ease-in-out both"
