// Accept fixture: motion under the agent's clock (LLP 1012 §2). Three boxes
// scale 1 → 2: one on a press with a linear transition, one on a press with
// a spring, one when a timer fires at t = 1000 ms — so a seek that crosses
// the timer must attribute the transition to the timer's time. A fourth box
// moves 100 points right at the same timer, under a layout transition, so a
// seek must lay it out at the timer's time too. A launch flag clears once,
// 60 ms after boot, and its timer is then spent.
component Motion
  state moved = false
  state auto = false
  state launching = true
  action toggle
    moved = ! moved
  action bump
    auto = true
  action arrived
    launching = false
  task ticker mount
    every(1000, bump)
  task launch mount
    after(60, arrived)
  view
    column testId="root" padding=20 gap=40
      text (launching ? "Launching" : "Ready") testId="launch"
      button press=toggle aria-label="Toggle" testId="toggle"
        text "Toggle"
      view width=50 height=50 background-color="#c0392b" testId="linear" scale=(moved ? 2 : 1) transition="scale 250ms linear"
      view width=50 height=50 background-color="#27ae60" testId="spring" scale=(moved ? 2 : 1) transition="scale -exact-spring(180, 12, 1)"
      view width=50 height=50 background-color="#2980b9" testId="timed" scale=(auto ? 2 : 1) transition="scale 500ms linear"
      view width=50 height=50 background-color="#8e44ad" testId="slid" margin-left=(auto ? 100 : 0) -exact-layout-transition="500ms linear"
