// Accept fixture: motion under the agent's clock (LLP 1012 §2). Three boxes
// scale 1 → 2: one on a press with a linear transition, one on a press with
// a spring, one when a timer fires at t = 1000 ms — so a seek that crosses
// the timer must attribute the transition to the timer's time.
component Motion
  state moved = false
  state auto = false
  action toggle writes moved
    moved = not moved
  action bump writes auto
    auto = true
  task ticker mount
    every(1000, bump)
  view
    column testId="root" padding=20 gap=40
      button press=toggle aria-label="Toggle" testId="toggle"
        text "Toggle"
      view width=50 height=50 background-color="#c0392b" testId="linear" scale=(moved ? 2 : 1) transition="scale 250ms linear"
      view width=50 height=50 background-color="#27ae60" testId="spring" scale=(moved ? 2 : 1) transition="scale spring(180, 12, 1)"
      view width=50 height=50 background-color="#2980b9" testId="timed" scale=(auto ? 2 : 1) transition="scale 500ms linear"
