// Accept fixture: a scroll container that overflows, on a page that also
// overflows. A wheel over the container scrolls it; at its edge the wheel
// chains to the page (LLP 1008 §5) — the web's `overscroll-behavior: auto`.
// A press on "Above" writes the container's `scrollTop`; `scroll-behavior:
// smooth` animates that write (and only that: a wheel is the reader's own).
component Rows
  state top = 0
  action jump writes top
    top = 600
  view
    column testId="root" gap=8 padding=12
      button testId="above" press=jump
        text "Above"
      scroll height=200 width="100%" testId="rows" background-color="#f0f0f0" scroll-behavior="smooth" scrollTop=top
        column gap=4 padding=8
          text "Row 0" font-size=14 testId="row-0"
          text "Row 1" font-size=14 testId="row-1"
          text "Row 2" font-size=14 testId="row-2"
          text "Row 3" font-size=14 testId="row-3"
          text "Row 4" font-size=14 testId="row-4"
          text "Row 5" font-size=14 testId="row-5"
          text "Row 6" font-size=14 testId="row-6"
          text "Row 7" font-size=14 testId="row-7"
          text "Row 8" font-size=14 testId="row-8"
          text "Row 9" font-size=14 testId="row-9"
          text "Row 10" font-size=14 testId="row-10"
          text "Row 11" font-size=14 testId="row-11"
          text "Row 12" font-size=14 testId="row-12"
          text "Row 13" font-size=14 testId="row-13"
          text "Row 14" font-size=14 testId="row-14"
          text "Row 15" font-size=14 testId="row-15"
          text "Row 16" font-size=14 testId="row-16"
          text "Row 17" font-size=14 testId="row-17"
          text "Row 18" font-size=14 testId="row-18"
          text "Row 19" font-size=14 testId="row-19"
          text "Row 20" font-size=14 testId="row-20"
          text "Row 21" font-size=14 testId="row-21"
          text "Row 22" font-size=14 testId="row-22"
          text "Row 23" font-size=14 testId="row-23"
          text "Row 24" font-size=14 testId="row-24"
          text "Row 25" font-size=14 testId="row-25"
          text "Row 26" font-size=14 testId="row-26"
          text "Row 27" font-size=14 testId="row-27"
          text "Row 28" font-size=14 testId="row-28"
          text "Row 29" font-size=14 testId="row-29"
          text "Row 30" font-size=14 testId="row-30"
          text "Row 31" font-size=14 testId="row-31"
          text "Row 32" font-size=14 testId="row-32"
          text "Row 33" font-size=14 testId="row-33"
          text "Row 34" font-size=14 testId="row-34"
          text "Row 35" font-size=14 testId="row-35"
          text "Row 36" font-size=14 testId="row-36"
          text "Row 37" font-size=14 testId="row-37"
          text "Row 38" font-size=14 testId="row-38"
          text "Row 39" font-size=14 testId="row-39"
      text "Below 0" testId="below-0"
      text "Below 1" testId="below-1"
      text "Below 2" testId="below-2"
      text "Below 3" testId="below-3"
      text "Below 4" testId="below-4"
      text "Below 5" testId="below-5"
      text "Below 6" testId="below-6"
      text "Below 7" testId="below-7"
