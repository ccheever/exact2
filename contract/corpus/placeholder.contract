// @ref LLP 1048.003 D6 — what shows while a source hasn't answered: a
// declared placeholder, a source call over values, or a list's empty value.
routes nav
  tab home "/"
  post "/post/:post"

shape Post
  id: string
  title: string

component Blog
  resource post = post(params(nav, "post")) as shape Post else emptyPost()
  resource comments = comments(params(nav, "post")) as shape list<string>
  view
    column testId="blog"
      text post.title testId="title"
      text (failed(post) ? "failed" : pending(post) ? "loading" : "ready") testId="state"
      text `${length(comments)} comments` testId="comments"
