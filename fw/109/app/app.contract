// X14: a resource whose source awaits native.later while the topic it watches changes.
shape Snap
  text: string
  n: number

component X14NativeReplyReask
  resource snap = snapshot() as shape Snap
  view
    main testId="root" width="100%" height="100%" box-sizing="border-box" padding=24
      text snap.text font-size=28 testId="snap"
      text (pending(snap) ? "pending" : "idle") testId="pending"
