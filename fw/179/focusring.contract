// Focusring: two custom pressable boxes and a plain box (exact2 #179).
component Focusring
  state presses = 0
  state wide = false
  action bump
    presses = presses + 1
  action widen
    presses = presses + 1
    wide = !wide
  view
    main testId="root"
      width="100%"
      height="100%"
      box-sizing="border-box"
      padding=24
      gap=16
      display="flex"
      flex-direction="column"
      align-items="flex-start"
      background-color="#ffffff"
      button press=bump testId="save" padding="10px 18px" border-radius=8 background-color="#e8eefc" color="#1b3a8a"
        text "Save (button)"
      box press=widen testId="row" padding=(wide ? "10px 60px" : "10px 18px") border-radius=8 background-color="#e9f6ec" color="#14532d"
        text "Open (box press=)"
      box testId="plain" padding="10px 18px" border-radius=8 background-color="#f1f1f1" color="#444444"
        text "Plain box (no handler)"
      text `presses: ${presses}` testId="count" color="#111111"
