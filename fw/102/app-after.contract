// X03: the app sets the root font size that `rem` resolves against (#102).
component X03RootFontSize
  state size = 16
  action pick(v: number)
    size = v
    setRootFontSize(v)
  view
    main testId="root" font-size=size padding=16
      input type="range" min=12 max=20 step=1 value=size input=pick aria-label="Interface font size" testId="size"
      row gap=8 margin-bottom=8
        button press=pick(12) testId="s12"
          text "12"
        button press=pick(16) testId="s16"
          text "16"
        button press=pick(20) testId="s20"
          text "20"
      view testId="box" width="10rem" height="2rem" background-color="#ddd"
        text "rem text" testId="label" font-size="1.5rem"
      text "em text" testId="em" font-size="1.5em"
      text "px text" testId="px" font-size="24px"
