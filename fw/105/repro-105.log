=== modules/apple/QuitProbe.swift
import AppKit

// Appends one line per lifecycle event to $QUIT_LOG.
func note(_ s: String) {
    let path = ProcessInfo.processInfo.environment["QUIT_LOG"] ?? "/tmp/quit-probe.log"
    let line = "\(Date().timeIntervalSince1970) pid=\(getpid()) \(s)\n"
    if let h = FileHandle(forWritingAtPath: path) { h.seekToEndOfFile(); h.write(line.data(using: .utf8)!); h.closeFile() }
    else { FileManager.default.createFile(atPath: path, contents: line.data(using: .utf8)) }
}

final class QuitProbe: ExactModule {
    override class var views: [String: ExactNativeFactory] {
        ["quit-probe": ExactNativeFactory { _, events in Box(events: events) }]
    }
    required init(context: ExactModuleContext) {
        super.init(context: context)
        note("module init")
        NotificationCenter.default.addObserver(forName: NSApplication.willTerminateNotification, object: nil, queue: nil) { _ in
            note("willTerminate observed")
        }
    }
    override func destroy() { note("module destroy") }
}

final class Box: ExactNativeInstance {
    private let v = NSView(frame: .zero)
    override var view: ExactNativeView { v }
}

let exactModule: ExactModule.Type = QuitProbe.self
