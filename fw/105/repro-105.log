#!/bin/zsh
# usage: quit-run.sh <label> <mode: aequit|cmdq|cmdw|sigterm>
label=$1; mode=$2
here=${0:A:h}
app=$(ls -d /Users/daehyeonmun/orca/workspaces/exact2/fix-105-mac-destroy-at-last-window/target/repro/x06-quit-hook/target/clients/*/com.example.x06-quit-hook/macos/X06\ Quit\ Hook.app | head -1)
log="$here/$label-$mode.log"; rm -f "$log"
QUIT_LOG="$log" "$app/Contents/MacOS/ExactMac" > "$here/$label-$mode.out" 2>&1 &
pid=$!
sleep 5
echo "launched pid=$pid"
[[ -n $SHOT ]] && screencapture -x -o -l$("$here/winid" $pid) "$here/$label-$mode-window.png"
t0=$(python3 -c 'import time;print(time.time())')
case $mode in
  aequit) osascript -e 'tell application id "com.example.x06-quit-hook" to quit' ;;
  sigterm) kill -TERM $pid ;;
  cmdq) orca computer hotkey --app pid:$pid --key "Cmd+Q" --no-screenshot --json | grep -m1 ok ;;
  cmdw) orca computer hotkey --app pid:$pid --key "Cmd+W" --no-screenshot --json | grep -m1 ok ;;
esac
for i in {1..100}; do kill -0 $pid 2>/dev/null || break; sleep 0.1; done
t1=$(python3 -c 'import time;print(time.time())')
kill -0 $pid 2>/dev/null && { echo "STILL ALIVE after 10s; killing"; kill -KILL $pid; }
echo "process gone $(python3 -c "print(round($t1-$t0,2))") s after the quit request"
echo "--- QUIT_LOG ($label, $mode):"; cat "$log"
