          column padding=16 gap=12
            row gap=12
              PickerChoice(kind="event", title="Event", tone=(theme == 0 ? "#df666c" : themeAccent), surface=(theme == 0 ? "#fafafa" : themeBase), ink=themeInk, pick=chooseType)
              PickerChoice(kind="plan", title="Plan", tone=(theme == 0 ? "#747AFF" : themeAccent), surface=(theme == 0 ? "#fafafa" : themeBase), ink=themeInk, pick=chooseType)
            row gap=12
              PickerChoice(kind="todo", title="Todo", tone=(theme == 0 ? "#70B8A2" : themeAccent), surface=(theme == 0 ? "#fafafa" : themeBase), ink=themeInk, pick=chooseType)
              PickerChoice(kind="sticker", title="Sticker", tone=(theme == 0 ? "#F39B65" : themeAccent), surface=(theme == 0 ? "#fafafa" : themeBase), ink=themeInk, pick=chooseType)
      button id="add-schedule" testId=(pickerOpen ? "cancel-type-picker" : "add-schedule") press=openPicker("global") aria-label=(pickerOpen ? "Close item picker" : "Add item") disabled=(not libraryReady or busy or dragging or pickerClosing or pickerMorphing and pickerOpen or modalOpen and not pickerOpen) position="absolute" right=20 bottom="calc(env(safe-area-inset-bottom) + 24px)" width=56 height=56 padding=0 border-width=0 border-radius=28 background-color="#ffffff00" display="flex" align-items="center" justify-content="center" z-index=12 opacity=(dragging or modalOpen and not pickerOpen or pickerMorphing and pickerOpen ? 0 : 1) pointer-events=(dragging or modalOpen and not pickerOpen or pickerMorphing and pickerOpen ? "none" : "auto") transition="opacity 100ms ease-out"
        svg id="picker-toggle-icon" testId="picker-toggle-icon" width=32 height=32 viewBox="0 0 32 32" rotate=(pickerExpanded ? 45 : 0) pointer-events="none" transition=(viewport.prefersReducedMotion ? "none" : "rotate 240ms ease-in-out")
          path d="M 16 3 L 16 29 M 3 16 L 29 16" fill="none" stroke=(pickerExpanded ? themeInk : "#ffffff") stroke-width=2.5 stroke-linecap="round"
      when stickerOpen and (not dragging or returning)
        box testId="sticker-backdrop" press=closeSticker position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.16)" z-index=10 opacity=(stickerClosing ? 0 : returnOpacity) transition=(returning ? returnTransition : (viewport.prefersReducedMotion ? "none" : `opacity ${stickerClosing ? 180 : 200}ms ${stickerClosing ? "ease-in" : "ease-out"}`))
      when stickerOpen
