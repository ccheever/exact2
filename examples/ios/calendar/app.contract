                when dragKind == "plan"
                  box position="absolute" left=0 right=0 top=7 height=2 background-color=dragColor
                  box position="absolute" left=0 top=5 width=6 height=6 border-radius=3 background-color=dragColor
                  svg position="absolute" right=0 top=5 width=8 height=6 viewBox="0 0 8 6"
                    path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=dragColor stroke-width=2
                text dragTitle position=(dragKind == "plan" ? "absolute" : "relative") left=(dragKind == "plan" ? 0 : "auto") right=(dragKind == "plan" ? 0 : "auto") top=(dragKind == "plan" ? 14 : "auto") text-align=(dragKind == "plan" ? "center" : "left") font-size=14 font-weight=500 color=(dragKind == "plan" ? dragColor : "#292934") background-color="#ffffff00" padding-left=(dragKind == "plan" ? 3 : 0) padding-right=(dragKind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
              box id="calendar-drag-landing-face" testId="calendar-drag-landing-face" position="absolute" left=0 top=0 width=landingWidth height=20 box-sizing="border-box" padding-left=6 padding-right=6 display="flex" align-items="center" justify-content=(dragKind == "plan" ? "center" : "flex-start") opacity=(landed ? 1 : 0) transition=ghostTransition
                when dragKind == "plan"
                  box position="absolute" left=0 right=0 top=2 height=2 background-color=dragColor
                  when not landingBefore
                    box position="absolute" left=0 top=0 width=6 height=6 border-radius=3 background-color=dragColor
                  when not landingAfter
                    svg position="absolute" right=0 top=0 width=8 height=6 viewBox="0 0 8 6"
                      path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=dragColor stroke-width=2
                text dragTitle position=(dragKind == "plan" ? "absolute" : "relative") left=(dragKind == "plan" ? 0 : "auto") right=(dragKind == "plan" ? 0 : "auto") top=(dragKind == "plan" ? 7 : "auto") text-align=(dragKind == "plan" ? "center" : "left") line-height="12px" font-size=11 font-weight=500 color=(dragKind == "plan" ? dragColor : "#292934") background-color="#ffffff00" padding-left=(dragKind == "plan" ? 3 : 0) padding-right=(dragKind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
      when pickerOpen and not pickerMorphing
        box testId="picker-backdrop" press=closePicker position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.16)" z-index=10 opacity=(pickerClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : `opacity ${pickerClosing ? 180 : 200}ms ${pickerClosing ? "ease-in" : "ease-out"}`)
      box position="absolute" right=0 bottom=0 width=0 height=0 overflow="visible" z-index=11 pointer-events="none"
        box id="add-surface" testId=(pickerOpen ? "type-picker" : "add-surface") position="absolute" right=(pickerOpen and pickerMorphing ? 0 : 20) bottom=(pickerOpen and pickerMorphing ? 0 : "calc(env(safe-area-inset-bottom) + 24px)") width=(pickerOpen and not pickerClosing ? (pickerMorphing ? viewport.width : min(360, viewport.width - 40)) : 56) height=(pickerOpen and not pickerClosing ? (pickerMorphing ? (stickerOpen ? stickerMorphHeight : morphHeight) : pickerHeight) : 56) min-height=0 box-sizing="border-box" border-radius=(pickerOpen and not pickerClosing ? 20 : 28) background-color=(pickerOpen and not pickerClosing ? "#ffffff" : themeAccent) box-shadow="0 8px 28px rgba(72, 58, 66, 0.18)" overflow="hidden" opacity=(dragging or modalOpen and not pickerOpen ? 0 : 1) pointer-events=(dragging or modalOpen and not pickerOpen ? "none" : "auto") layout-transition="240ms ease-in-out" transition=(viewport.prefersReducedMotion ? "none" : "background-color 240ms ease-in-out, opacity 160ms ease-out")
      when pickerOpen
