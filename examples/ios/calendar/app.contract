                column flex=1 min-width=0 gap=4 align-items="flex-start"
                  text dragTitle font-size=16 font-weight=500 color=(dragSource == "todos" ? (dragRangeLabel == "Completed" ? "#929299" : "#242428") : themeInk) text-decoration-line=(dragSource == "todos" and dragRangeLabel == "Completed" ? "line-through" : "none") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
                  text dragRangeLabel font-size=13 color="#85858d" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
                when dragSource != "todos"
