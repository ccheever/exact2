use Weekday from "./parts.contract"
use ColorChoice from "./parts.contract"
use AgendaRow from "./parts.contract"
use AgendaMark from "./parts.contract"
use TodoRow from "./parts.contract"
use PickerChoice from "./parts.contract"
use StickerChoice from "./parts.contract"
use ThemeChoice from "./parts.contract"
use StickerAgendaRow from "./parts.contract"

// The calendar view and editor are authored in Contract; dates and durable
// schedules live in the app data module.
shape Time
  epochAtZero: number
  utcOffset: number
  seed: number
shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
shape Clock
  today: number
  month: number
  date: string
  ready: bool
shape Library
  ready: bool
  revision: number
  message: string
shape Month
  id: string
  month: number
  label: string
  weeks: list<Week>
shape Week
  id: string
  cells: list<Cell>
  bars: list<Bar>
  lanes: number
  footer: number
shape Cell
  id: string
  day: number
  date: string
  number: number
  inMonth: bool
  stickerId: string
shape Bar
  id: string
  eventId: string
  title: string
  color: string
  startCol: number
  span: number
  lane: number
  continuesBefore: bool
  continuesAfter: bool
  allDay: bool
  timeLabel: string
  kind: string
shape Schedule
  id: string
  title: string
  notes: string
  color: string
  allDay: bool
  startDay: number
  endDay: number
  startDate: string
  endDate: string
  startTime: string
  endTime: string
  rangeLabel: string
  kind: string
shape Agenda
  day: number
  date: string
  label: string
  items: list<Schedule>
  stickerId: string
shape Todo
  id: string
  title: string
  color: string
  completed: bool
  createdAt: number
  completedAt: number
shape ParsedDate
  valid: bool
  day: number
  message: string
shape Event
  found: bool
  item: Schedule
  message: string
shape DragInput
  valid: bool
  phase: string
  eventId: string
  serial: number
  sequence: number
  x: number
  y: number
  reason: string
  sourceX: number
  sourceY: number
  sourceWidth: number
  sourceHeight: number
shape DragTarget
  day: number
  cellX: number
  cellY: number
  cellWidth: number
  cellHeight: number
  maxScroll: number
shape StickerDrag
  valid: bool
  stickerId: string
  sourceDay: number
shape Landing
  valid: bool
  id: string
  kind: string
  x: number
  y: number
  width: number
  height: number
  continuesBefore: bool
  continuesAfter: bool
  contentHeight: number
shape Result
  revision: number
  success: bool
  message: string
  id: string
  day: number

fn monthName(month: number): string = (month - floor(month / 12) * 12 == 0 ? "Jan" : (month - floor(month / 12) * 12 == 1 ? "Feb" : (month - floor(month / 12) * 12 == 2 ? "Mar" : (month - floor(month / 12) * 12 == 3 ? "Apr" : (month - floor(month / 12) * 12 == 4 ? "May" : (month - floor(month / 12) * 12 == 5 ? "Jun" : (month - floor(month / 12) * 12 == 6 ? "Jul" : (month - floor(month / 12) * 12 == 7 ? "Aug" : (month - floor(month / 12) * 12 == 8 ? "Sep" : (month - floor(month / 12) * 12 == 9 ? "Oct" : (month - floor(month / 12) * 12 == 10 ? "Nov" : "Dec")))))))))))
fn paletteColor(theme: number, color: string): string = (theme == 1 ? (color == "#FA7070" ? "#EBA6AA" : (color == "#747AFF" ? "#B7ADDC" : (color == "#70B8A2" ? "#A6C6B5" : (color == "#F39B65" ? "#E6B799" : (color == "#D4BEF1" ? "#D7B8DE" : (color == "#EE8192" ? "#DF9DB7" : color)))))) : (theme == 2 ? (color == "#FA7070" ? "#DDA8A5" : (color == "#747AFF" ? "#96B4D2" : (color == "#70B8A2" ? "#8FBEB8" : (color == "#F39B65" ? "#DCC29F" : (color == "#D4BEF1" ? "#BDB9DB" : (color == "#EE8192" ? "#CCA9C0" : color)))))) : (theme == 3 ? (color == "#FA7070" ? "#D7AA95" : (color == "#747AFF" ? "#A8B8C6" : (color == "#70B8A2" ? "#A6BE8F" : (color == "#F39B65" ? "#DDC28E" : (color == "#D4BEF1" ? "#C7BCD2" : (color == "#EE8192" ? "#D4B0AB" : color)))))) : (theme == 4 ? (color == "#FA7070" ? "#D2A5BC" : (color == "#747AFF" ? "#AAA6DB" : (color == "#70B8A2" ? "#A3BDCB" : (color == "#F39B65" ? "#D8B8A7" : (color == "#D4BEF1" ? "#C3AFE1" : (color == "#EE8192" ? "#CEA1C9" : color)))))) : (theme == 5 ? (color == "#FA7070" ? "#CEA48E" : (color == "#747AFF" ? "#A5B0BB" : (color == "#70B8A2" ? "#A8B39A" : (color == "#F39B65" ? "#D2B48A" : (color == "#D4BEF1" ? "#BDB0C6" : (color == "#EE8192" ? "#C5A2A5" : color)))))) : color)))))
fn unit(value: number): number = max(0, min(1, value))
fn edgeSpeed(y: number, height: number): number = y < 72 ? -840 * unit((72 - y) / 72) * unit((72 - y) / 72) : (y > height - 72 ? 840 * unit((y - height + 72) / 72) * unit((y - height + 72) / 72) : 0)
fn weekday(day: number): number = day + 4 - floor((day + 4) / 7) * 7
fn inRange(day: number, first: number, span: number): bool = first != -1000000 and day >= first and day <= first + span
fn scrollSlot(month: number): number = month - floor(month / 7) * 7
fn savedScroll(month: number, m0: number, y0: number, m1: number, y1: number, m2: number, y2: number, m3: number, y3: number, m4: number, y4: number, m5: number, y5: number, m6: number, y6: number): number = (month == m0 ? y0 : (month == m1 ? y1 : (month == m2 ? y2 : (month == m3 ? y3 : (month == m4 ? y4 : (month == m5 ? y5 : (month == m6 ? y6 : 0)))))))
fn magnitude(value: number): number = max(value, 0 - value)
fn springDecay(t: number): number = 1 / (1 + t + 0.48 * t * t + 0.235 * t * t * t)
fn pagePosition(x: number, v: number, target: number, dt: number): number = target + (x - target + (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn pageVelocity(x: number, v: number, target: number, dt: number): number = (v - 24 * (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn boundedMonth(value: number): number = max(22800, min(25211, value))
fn chosenMonth(x: number, v: number, origin: number): number = boundedMonth(x - origin + v * 0.16 > 0.22 ? origin + 1 : (x - origin + v * 0.16 < -0.22 ? origin - 1 : origin))
fn sheetSize(snap: number, compact: number, half: number, full: number): number = snap < 1 ? compact : (snap < 2 ? half : full)
fn sheetHeight(snap: number, kind: string, dragging: string, offset: number, compact: number, half: number, full: number): number = max(compact, min(full, sheetSize(snap, compact, half, full) - (kind == dragging ? offset : 0)))
fn sheetStop(height: number, velocity: number, compact: number, half: number, full: number): number = height < compact or height - velocity * 0.16 < (compact + half) / 2 ? 0 : (height - velocity * 0.16 < (half + full) / 2 ? 1 : 2)

style QuietButton
  display="flex" align-items="center" justify-content="center" width=40 height=40 border-width=0 border-radius=20 background-color="#f5f5f6" press-scale=0.95
style Field
  box-sizing="border-box" width="100%" min-width=0 height=48 padding-left=14 padding-right=14 border-width=0 border-radius=12 background-color="#f5f5f7" color="#242428" font-size=16
style FieldLabel
  font-size=13 font-weight=500 color="#74747c"
style DateField
  box-sizing="border-box" min-width=0 height=40 padding=0 border-width=0 border-radius=8 background-color="#ffffff00" color="#242428" font-size=16

keyframes popupIn
  from opacity=0 translate="0px 24px"
  to opacity=1 translate="0px 0px"
keyframes sheetIn
  from opacity=0 translate="0px 48px"
  to opacity=1 translate="0px 0px"

component Calendar
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  state minute = 0
  resource clock = calendarClock(time.epochAtZero + minute, time.utcOffset) as shape Clock
  derive clockReady = clock.ready
  state libraryReady = false
  state libraryRevision = 0
  state libraryMessage = ""
  state libraryStarted = false
  mutation loadedLibrary as shape Library then didLoadLibrary
  state dataRevision = 0
  derive revision = max(libraryRevision, dataRevision)
  state monthAnchor = none
  derive month = match monthAnchor { case some(value) => value, case none => clock.month }
  derive headerLabel = floor(month / 12) == floor(clock.month / 12) ? monthName(month) : `${monthName(month)}, ${floor(month / 12)}`
  resource pages = calendarMonths(month, revision, (dragging and dragSource == "sticker-cell" ? dragSourceMonth : -1)) as shape list<Month>
  resource todos = calendarTodos(revision) as shape list<Todo>
  resource theme = calendarTheme(revision) as shape number
  derive themeInk = theme == 1 ? "#49333b" : (theme == 2 ? "#294653" : (theme == 3 ? "#394c36" : (theme == 4 ? "#393551" : (theme == 5 ? "#4d3d31" : "#242428"))))
  derive themeAccent = theme == 1 ? "#d87f9a" : (theme == 2 ? "#6696ad" : (theme == 3 ? "#829c61" : (theme == 4 ? "#8e79bf" : (theme == 5 ? "#aa816a" : "#FA7070"))))
  derive themeBase = theme == 1 ? "#fae5ec" : (theme == 2 ? "#dceef3" : (theme == 3 ? "#f7f4e4" : (theme == 4 ? "#eae7ff" : (theme == 5 ? "#f4eadb" : "#ffffff"))))
  derive themeWallpaper = theme == 1 ? "assets/themes/blush.png" : (theme == 2 ? "assets/themes/paris.png" : (theme == 3 ? "assets/themes/meadow.png" : (theme == 4 ? "assets/themes/lavender.png" : "assets/themes/linen.png")))
  derive pageWidth = max(1, viewport.width)
  state stageHeight = 0
  state stageViewportHeight = 0
  derive pageHeight = stageHeight > 0 ? max(1, stageHeight + viewport.height - stageViewportHeight) : max(240, viewport.height - 152)
  state pagerPositionValue = none
  derive pagerPosition = match pagerPositionValue { case some(value) => value, case none => clock.month }
  state pagerVelocity = 0
  state pagerOrigin = 0
  state pagerPanning = false
  state pagerFrameTime = 0
  state popupOpen = false
  state popupSnap = 1
  state todoSnap = 1
  state stickerSnap = 1
  state editorSnap = 1
  state themeSnap = 1
  state sheetDragging = ""
  state sheetOffset = 0
  derive sheetCompactHeight = max(176, min(260, viewport.height * 0.28))
  derive sheetHalfHeight = max(sheetCompactHeight, viewport.height * 0.5)
  derive sheetFullHeight = max(sheetHalfHeight, viewport.height * 0.92)
  derive activeSheet = editorOpen ? "editor" : (stickerOpen ? "sticker" : (pickerOpen ? "" : (themeOpen ? "theme" : (todoSheetOpen ? "todo" : "date"))))
  derive activeSheetSnap = activeSheet == "editor" ? editorSnap : (activeSheet == "sticker" ? stickerSnap : (activeSheet == "theme" ? themeSnap : (activeSheet == "todo" ? todoSnap : popupSnap)))
  derive sheetBaseHeight = sheetSize(activeSheetSnap, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive sheetOverdrag = max(0, sheetOffset - (sheetBaseHeight - sheetCompactHeight))
  derive popupPanning = sheetDragging == "date"
  derive todoPanning = sheetDragging == "todo"
  derive stickerPanning = sheetDragging == "sticker"
  derive popupTranslation = popupPanning ? sheetOverdrag : 0
  derive todoTranslation = todoPanning ? sheetOverdrag : 0
  derive stickerTranslation = stickerPanning ? sheetOverdrag : 0
  state popupClosing = false
  state popupUntil = 0
  state selectedDay = none
  derive day = match selectedDay { case some(value) => value, case none => clock.today }
  resource agenda = calendarDay(day, revision, clock.today) as shape Agenda
  derive popupHeight = sheetHeight(popupSnap, "date", sheetDragging, sheetOffset, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive popupCap = sheetFullHeight
  state todoSheetOpen = false
  state todoClosing = false
  state todoUntil = 0
  state pickerOpen = false
  state pickerReadyAt = 0
  state pickerClosing = false
  state pickerUntil = 0
  state pickerNext = ""
  state themeOpen = false
  state themeClosing = false
  state themeUntil = 0
  state editorOrigin = "global"
  state creationDate = ""
  state editorOpen = false
  state editorClosing = false
  state editorUntil = 0
  state editorMorphReady = false
  state formFromPicker = false
  state formContentReady = false
  state editorMorphAt = 0
  state editorKind = "event"
  state editId = ""
  derive editorLabel = `${editId == "" ? "New" : "Edit"} ${editorKind == "todo" ? "todo" : (editorKind == "plan" ? "plan" : "event")}`
  derive editorHeight = sheetHeight(editorSnap, "editor", sheetDragging, sheetOffset, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive stickerHeight = sheetHeight(stickerSnap, "sticker", sheetDragging, sheetOffset, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive pickerHeight = 252
  derive pickerExpanded = pickerOpen and not pickerClosing and not pickerMorphing
  derive pickerContentVisible = pickerExpanded and (viewport.prefersReducedMotion or now() >= pickerReadyAt)
  derive themeHeight = sheetHeight(themeSnap, "theme", sheetDragging, sheetOffset, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive pickerMorphing = formFromPicker and (editorOpen or stickerOpen)
  derive todoHeight = sheetHeight(todoSnap, "todo", sheetDragging, sheetOffset, sheetCompactHeight, sheetHalfHeight, sheetFullHeight)
  derive sharedEditor = editorOpen and (formFromPicker and not editorClosing or editorOrigin == "date" and popupOpen or editorOrigin == "todos" and todoSheetOpen)
  derive sharedSticker = stickerOpen and (formFromPicker and not stickerClosing or editorOrigin == "date" and popupOpen)
  derive editorStartHeight = formFromPicker and not editorClosing and not stickerClosing ? pickerHeight : (editorOrigin == "date" ? min(popupCap, popupHeight) : min(popupCap, todoHeight))
  derive morphHeight = sharedEditor ? (editorClosing or not editorMorphReady ? editorStartHeight : editorHeight) : editorHeight
  derive stickerMorphHeight = sharedSticker ? (stickerClosing or not editorMorphReady ? editorStartHeight : stickerHeight) : stickerHeight
  state eventRetry = 0
  resource opened = calendarEvent(editorKind == "todo" ? "" : editId, revision, eventRetry) as shape Event
  state titleDraft = none
  state notesDraft = none
  state colorDraft = none
  state allDayDraft = none
  state startDateDraft = none
  state endDateDraft = none
  state startTimeDraft = none
  state endTimeDraft = none
  derive title = match titleDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.title }
  derive notes = match notesDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.notes }
  derive color = match colorDraft { case some(value) => value, case none => editId == "" ? "#FA7070" : opened.item.color }
  derive allDay = match allDayDraft { case some(value) => value, case none => editId == "" or opened.item.allDay }
  derive startDate = match startDateDraft { case some(value) => value, case none => editId == "" ? creationDate : opened.item.startDate }
  derive endDate = match endDateDraft { case some(value) => value, case none => editId == "" ? creationDate : opened.item.endDate }
  derive startTime = match startTimeDraft { case some(value) => value, case none => editId == "" ? "09:00" : opened.item.startTime }
  derive endTime = match endTimeDraft { case some(value) => value, case none => editId == "" ? "10:00" : opened.item.endTime }
  derive editorReady = editorKind == "todo" or editId == "" or (opened.found and opened.item.id == editId and opened.message == "" and not pending(opened))
  state stickerOpen = false
  state stickerClosing = false
  state stickerUntil = 0
  state stickerDateText = ""
  state stickerChoice = ""
  resource stickerDate = calendarDate(stickerDateText) as shape ParsedDate
  resource stickerAgenda = calendarDay(stickerDate.day, revision, clock.today) as shape Agenda
  derive stickerSelection = stickerChoice != "" ? stickerChoice : stickerAgenda.stickerId
  state confirmDelete = false
  state operationSequence = 0
  state operation = ""
  state retryToken = ""
  state retryOperation = ""
  state retryEpoch = 0
  derive freshToken = `${time.epochAtZero}-${time.seed}-${revision}-${operationSequence + 1}`
  derive saveToken = retryOperation == "save" and retryToken != "" ? retryToken : freshToken
  derive deleteToken = retryOperation == "delete" and retryToken != "" ? retryToken : freshToken
  derive saveEpoch = retryOperation == "save" and retryToken != "" ? retryEpoch : time.epochAtZero + now()
  derive stickerSaveToken = retryOperation == "sticker-save" and retryToken != "" ? retryToken : freshToken
  derive stickerRemoveToken = retryOperation == "sticker-remove" and retryToken != "" ? retryToken : freshToken
  state error = ""
  mutation changed as shape Result then didChange
  derive busy = pending(changed)
  state dragId = ""
  state dragTitle = ""
  state dragRangeLabel = ""
  state dragKind = "event"
  state dragColor = "#FA7070"
  state dragSpan = 0
  state dragSerial = 0
  state contactAck = 0
  state dragPhase = "idle"
  state dragX = 0
  state dragOriginX = 0
  state dragOriginY = 0
  state dragMoved = false
  state dragCommitted = false
  state dragY = 0
  state ghostX = 0
  state ghostY = 0
  state sourceX = 0
  state sourceY = 0
  state sourceWidth = 1
  state sourceHeight = 1
  state liftPrepared = false
  state liftReadyAt = 0
  state returnPrepared = false
  state returnReadyAt = 0
  state landingWidth = 1
  state landingHeight = 20
  state landingBefore = false
  state landingAfter = false
  state dragStartDay = 0
  state dragSource = "date"
  state dragSourceDay = 0
  state dragSourceMonth = 0
  state dragTodoId = ""
  state dragStickerId = ""
  state pendingMoveRevision = 0
  state pendingMoveDay = 0
  state pendingMove = false
  state dragUntil = 0
  state dragFrameTime = 0
  state portX = 0
  state portY = 0
  state portWidth = 0
  state portHeight = 0
  state calendarScrollTop = 0
  state calendarScrollRequest = 0
  state calendarScrollMonth = -1
  state scrollMonth0 = -1
  state scrollY0 = 0
  state scrollMonth1 = -1
  state scrollY1 = 0
  state scrollMonth2 = -1
  state scrollY2 = 0
  state scrollMonth3 = -1
  state scrollY3 = 0
  state scrollMonth4 = -1
  state scrollY4 = 0
  state scrollMonth5 = -1
  state scrollY5 = 0
  state scrollMonth6 = -1
  state scrollY6 = 0
  state edgeDirection = 0
  state edgeSince = 0
  state edgeReadyAt = 0
  mutation contact as shape DragInput then didContact
  derive contactId = match contact { case some(value) => value.eventId, case none => "" }
  derive contactSchedule = first(filter(agenda.items, (item) => item.id == contactId))
  derive contactTodo = first(filter(todos, (item) => `todo:${item.id}` == contactId))
  resource contactSticker = calendarStickerDrag(contactId, revision) as shape StickerDrag
  derive contactIsSticker = contactSticker.valid and not pending(contactSticker)
  derive contactIsTodo = match contactTodo { case some(item) => true, case none => false }
  derive contactAvailable = contactIsSticker ? (contactSticker.sourceDay == -1000000 ? stickerOpen : (not modalOpen or popupOpen)) : (contactIsTodo ? todoSheetOpen : (popupOpen and match contactSchedule { case some(item) => true, case none => false }))
  derive contactX = match contact { case some(value) => value.x, case none => 0 }
  derive contactY = match contact { case some(value) => value.y, case none => 0 }
  derive contactMonth = held ? boundedMonth(floor(pagerPosition + (contactX - portX) / pageWidth)) : month
  derive hoverMonth = held ? boundedMonth(floor(pagerPosition + (dragX - portX) / pageWidth)) : month
  derive contactPageX = held ? portX + (contactMonth - pagerPosition) * pageWidth : portX
  derive hoverPageX = held ? portX + (hoverMonth - pagerPosition) * pageWidth : portX
  derive contactCancel = held and contactX >= 0 and contactX <= viewport.width and contactY >= viewport.height - 112 and contactY <= viewport.height
  derive hoverCancel = held and dragX >= 0 and dragX <= viewport.width and dragY >= viewport.height - 112 and dragY <= viewport.height
  derive contactInside = held and not contactCancel and contactX >= portX and contactX < portX + portWidth and contactMonth == floor(pagerPosition + (contactX - portX) / pageWidth)
  derive hoverInside = held and not hoverCancel and dragX >= portX and dragX < portX + portWidth and hoverMonth == floor(pagerPosition + (dragX - portX) / pageWidth)
  derive contactWeeks = match first(filter(pages, (page) => page.month == contactMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive hoverWeeks = match first(filter(pages, (page) => page.month == hoverMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive contactScroll = held ? savedScroll(contactMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  derive hoverScroll = held ? savedScroll(hoverMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  // Held-only bottom padding lets the final week scroll above Cancel without
  // changing week heights. Hit testing uses that same unobscured viewport.
  derive dragPortHeight = max(1, min(portHeight, viewport.height - 112 - portY))
  derive dragPadding = max(0, portHeight - dragPortHeight)
  resource contactTarget = calendarDragTarget(contactMonth, revision, contactX, contactY, contactPageX, portY, (contactInside ? pageWidth : 0), (held ? dragPortHeight : portHeight), contactScroll, max(76, pageHeight / max(1, contactWeeks)), dragSpan) as shape DragTarget
  resource hoverTarget = calendarDragTarget(hoverMonth, revision, dragX, dragY, hoverPageX, portY, (hoverInside ? pageWidth : 0), (held ? dragPortHeight : portHeight), hoverScroll, max(76, pageHeight / max(1, hoverWeeks)), dragSpan) as shape DragTarget
  resource contactLanding = calendarLanding(dragId, (held ? contactTarget.day : -1000000), contactMonth, revision, pageWidth, max(76, pageHeight / max(1, contactWeeks))) as shape Landing
  // Both pre-save and prospective content must admit the released scroll offset.
  derive landingScroll = min(contactScroll, min(max(0, contactLanding.contentHeight - portHeight), max(0, contactTarget.maxScroll - dragPadding)))
  derive dragging = dragId != ""
  derive held = dragPhase == "held"
  derive returning = dragPhase == "returning"
  derive returnOpacity = returning and not returnPrepared ? 0 : 1
  derive returnTransition = viewport.prefersReducedMotion or not returnPrepared ? "none" : "opacity 300ms ease-in-out"
  derive modalOpen = popupOpen or todoSheetOpen or pickerOpen or editorOpen or stickerOpen or themeOpen
  derive landed = dragCommitted and not held and dragPhase != "returning"
  derive lifted = held and liftPrepared
  derive ghostWidth = landed ? landingWidth : (lifted ? (dragKind == "sticker" ? 48 : 220) : sourceWidth)
  derive ghostHeight = landed ? landingHeight : (lifted ? (dragKind == "sticker" ? 48 : 36) : sourceHeight)
  derive ghostTransition = viewport.prefersReducedMotion ? "none" : (landed or returning ? "opacity 300ms ease-in-out, scale 300ms ease-in-out" : "opacity 300ms cubic-bezier(0.22, 1, 0.36, 1), scale 300ms cubic-bezier(0.22, 1, 0.36, 1)")
  derive edgeWanted = held and dragMoved and not hoverCancel and dragY >= portY and dragY <= portY + portHeight and dragX >= portX and dragX <= portX + portWidth ? (dragX < portX + 36 and month > 22800 ? -1 : (dragX > portX + portWidth - 36 and month < 25211 ? 1 : 0)) : 0
  derive popupLowered = (dragging and (held or dragCommitted)) or pickerOpen or (stickerOpen and not sharedSticker) or (editorOpen and editorOrigin != "date")
  derive todoLowered = (dragging and (held or dragCommitted)) or pickerOpen or stickerOpen or (editorOpen and editorOrigin != "todos")
  derive hoverDay = held ? hoverTarget.day : -1000000

  action tick writes minute
    minute = floor(now() / 60000) * 60000
  task clockTick mount
    every(60000, tick)

  task dragFrames mount
    every(frame, animateDrag)

  action dragInput(raw: string) writes contact
    send contact = calendarDragInput(raw)
  action didContact writes contactAck, dragSerial, dragId, dragTitle, dragRangeLabel, dragKind, dragColor, dragSpan, dragStartDay, dragSource, dragSourceDay, dragSourceMonth, dragTodoId, dragStickerId, pendingMove, dragX, dragY, dragOriginX, dragOriginY, dragMoved, dragCommitted, ghostX, ghostY, sourceX, sourceY, sourceWidth, sourceHeight, liftPrepared, liftReadyAt, returnPrepared, returnReadyAt, landingWidth, landingHeight, landingBefore, landingAfter, dragPhase, dragUntil, dragFrameTime, portX, portY, portWidth, portHeight, calendarScrollRequest, calendarScrollMonth, edgeDirection, edgeSince, edgeReadyAt, changed, operation, operationSequence, error
    match contact
      case some(packet)
        if packet.valid and packet.sequence > contactAck
          contactAck = packet.sequence
