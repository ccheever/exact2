        popupOffset = 0
  action openPicker(origin: string) writes pickerOpen, pickerClosing, pickerNext, editorOrigin, creationDate, error
    if not busy and not dragging
      pickerOpen = true
      pickerClosing = false
      pickerNext = ""
      editorOrigin = origin
      creationDate = origin == "date" ? agenda.date : clock.date
      error = ""
