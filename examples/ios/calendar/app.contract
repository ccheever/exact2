                text "Change or remove sticker" flex=1 text-align="left" font-size=14 color="#74747c"
                image "symbol:forward-chevron" font-size=11 tint-color="#c9c9cf"
              image `assets/stickers/${agenda.stickerId}.png` position="absolute" left=20 top=12 width=36 height=36 object-fit="contain" pointer-events="none" opacity=(dragId == `sticker-day:${agenda.day}:${agenda.stickerId}` ? 0 : 1) aria-hidden=true
              calendar-drag-handle id=`sticker-agenda-${agenda.date}` testId=`sticker-agenda-${agenda.date}` event-id=`sticker-day:${agenda.day}:${agenda.stickerId}` enabled=(not busy and not editorOpen and not pickerOpen and not stickerOpen and not popupClosing and (not dragging or (held and dragId == `sticker-day:${agenda.day}:${agenda.stickerId}`)) ? "true" : "false") press=editSticker aria-label="Move sticker" position="absolute" left=20 top=12 width=36 height=36
          when error != "" or busy
            text (busy ? "Saving…" : error) testId="popup-status" aria-live="polite" padding-left=20 padding-right=20 padding-top=4 padding-bottom=12 font-size=13 color=(error != "" ? "#b74238" : "#85858d") flex-shrink=0 opacity=(popupLowered ? 0 : 1)
      when todoSheetOpen and not dragging and not editorOpen and not pickerOpen and not stickerOpen
        box testId="todo-backdrop" press=closeTodos position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.16)" z-index=4 opacity=(todoClosing ? 0 : 1) transition="opacity 240ms ease-out"
      when todoSheetOpen
        column id="todo-sheet" testId="todo-sheet" role="dialog" aria-label="Todos" position="absolute" bottom=0 left=0 right=0 height=`calc(${112 + max(77, min(5, length(todos)) * 64)}px + env(safe-area-inset-bottom))` max-height=popupCap min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" border-top-left-radius=24 border-top-right-radius=24 background-color="#ffffff" box-shadow="0 -6px 32px rgba(28, 31, 44, 0.12)" overflow="hidden" z-index=5 translate=`0px ${popupLowered or todoClosing ? popupCap + 40 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate 300ms cubic-bezier(0.22, 1, 0.36, 1)") animation=(viewport.prefersReducedMotion or todoClosing ? "none" : "popupIn 180ms ease-out")
          box width=32 height=4 margin-top=10 margin-bottom=14 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=64 flex-shrink=0 padding-left=20 padding-right=16 gap=8 align-items="center"
            column flex=1 min-width=0 gap=4
              text "Todos" font-size=18 font-weight=600
              text "Hold an item to add it to a date" font-size=13 color="#85858d"
            button press=editTodo("") testId="todo-add" aria-label="New todo" class=QuietButton width=36 height=36 disabled=(busy or popupLowered or todoClosing)
              image "symbol:add" font-size=18 tint-color="#d85358"
            button press=closeTodos testId="close-todos" aria-label="Close todos" class=QuietButton width=36 height=36 disabled=(dragging or popupLowered or todoClosing)
              image "symbol:close" font-size=14 tint-color="#77777e"
          scroll testId="todo-list" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
            column padding-bottom=12
              when length(todos) == 0
                text "A place for things you want to do." padding=20 font-size=15 color="#85858d"
              each item in todos key=item.id
                TodoRow(id=item.id, title=item.title, color=item.color, completed=item.completed, hidden=(dragId == `todo:${item.id}`), disabled=(busy or editorOpen or pickerOpen or stickerOpen or todoClosing or (dragging and (not held or dragId != `todo:${item.id}`))), edit=editTodo, toggle=toggleTodo)
          when error != "" and not popupLowered
            text error testId="todo-error" padding=16 font-size=13 color="#b74238"
      when held
        box id="cancel-zone" testId="cancel-zone" aria-label="Drop to cancel" position="absolute" left=0 right=0 bottom=0 height=112 background-image="linear-gradient(to bottom, rgba(255, 255, 255, 0), rgba(255, 255, 255, 0.96) 70%, #ffffff)" pointer-events="none" z-index=20
          row position="absolute" left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 18px)" height=20 gap=6 align-items="center" justify-content="center"
            image "symbol:close" font-size=12 tint-color=(hoverCancel ? "#b95b60" : "#929299")
            text (hoverCancel ? "Release to cancel" : "Drop to cancel") font-size=13 font-weight=500 color=(hoverCancel ? "#b95b60" : "#929299")
      when dragging
        box id="calendar-drag-image" testId="calendar-drag-image" position="absolute" left=0 top=0 width=sourceWidth height=sourceHeight translate=`${ghostX}px ${ghostY}px` overflow="visible" pointer-events="none" z-index=21 opacity=(dragPhase == "fading" ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : (held ? "opacity 90ms linear" : "translate 300ms cubic-bezier(0.22, 1, 0.36, 1), opacity 90ms linear"))
          box position="absolute" left=0 top=0 width=sourceWidth height=sourceHeight overflow="visible" translate=`${lifted ? dragOriginX - sourceX - (dragKind == "sticker" ? 24 : 30) : 0}px ${lifted ? dragOriginY - sourceY - 24 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate 300ms cubic-bezier(0.22, 1, 0.36, 1)")
            when viewport.prefersReducedMotion
              box id="calendar-drag-background" testId="calendar-drag-background" position="absolute" left=0 top=0 width=ghostWidth height=ghostHeight background-color=(dragKind == "sticker" ? "#ffffff00" : (landed or lifted ? (dragKind == "plan" ? "#ffffff00" : dragColor) : "#ffffff")) border-top-left-radius=(landed ? (landingBefore ? 0 : 4) : (lifted ? 6 : 0)) border-bottom-left-radius=(landed ? (landingBefore ? 0 : 4) : (lifted ? 6 : 0)) border-top-right-radius=(landed ? (landingAfter ? 0 : 4) : (lifted ? 6 : 0)) border-bottom-right-radius=(landed ? (landingAfter ? 0 : 4) : (lifted ? 6 : 0))
            else
              box id="calendar-drag-background" testId="calendar-drag-background" position="absolute" left=0 top=0 width=ghostWidth height=ghostHeight background-color=(dragKind == "sticker" ? "#ffffff00" : (landed or lifted ? (dragKind == "plan" ? "#ffffff00" : dragColor) : "#ffffff")) border-top-left-radius=(landed ? (landingBefore ? 0 : 4) : (lifted ? 6 : 0)) border-bottom-left-radius=(landed ? (landingBefore ? 0 : 4) : (lifted ? 6 : 0)) border-top-right-radius=(landed ? (landingAfter ? 0 : 4) : (lifted ? 6 : 0)) border-bottom-right-radius=(landed ? (landingAfter ? 0 : 4) : (lifted ? 6 : 0)) transition="background-color 300ms cubic-bezier(0.22, 1, 0.36, 1)" layout-transition="300ms cubic-bezier(0.22, 1, 0.36, 1)"
            when dragKind == "sticker"
              image `assets/stickers/${dragStickerId}.png` id="calendar-drag-sticker" testId="calendar-drag-sticker" position="absolute" left=0 top=0 width=sourceWidth height=sourceHeight object-fit="contain" scale=(ghostWidth / sourceWidth) transform-origin="0px 0px" transition=(viewport.prefersReducedMotion ? "none" : "scale 300ms cubic-bezier(0.22, 1, 0.36, 1)") aria-hidden=true
            else
              row id="calendar-drag-source-face" testId="calendar-drag-source-face" position="absolute" left=0 top=0 width=sourceWidth height=sourceHeight box-sizing="border-box" padding-left=(dragSource == "todos" ? 0 : 20) padding-right=(dragSource == "todos" ? 0 : 20) align-items="center" gap=12 opacity=(landed or lifted ? 0 : 1) scale=(landed ? landingWidth / sourceWidth : (lifted ? 220 / sourceWidth : 1)) transform-origin="0px 0px" transition=ghostTransition
                when dragSource != "todos"
                  box width=12 height=(dragKind == "plan" ? 3 : 12) flex-shrink=0 border-radius=6 background-color=dragColor
                column flex=1 min-width=0 gap=4 align-items="flex-start"
                  text dragTitle font-size=16 font-weight=500 color=(dragSource == "todos" and dragRangeLabel == "Completed" ? "#929299" : "#242428") text-decoration-line=(dragSource == "todos" and dragRangeLabel == "Completed" ? "line-through" : "none") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
                  text dragRangeLabel font-size=13 color="#85858d" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
                when dragSource != "todos"
                  image "symbol:forward-chevron" font-size=11 tint-color="#c9c9cf"
              box id="calendar-drag-chip-face" testId="calendar-drag-chip-face" position="absolute" left=0 top=0 width=220 height=36 box-sizing="border-box" padding-left=10 padding-right=10 display="flex" align-items="center" justify-content=(dragKind == "plan" ? "center" : "flex-start") opacity=(lifted ? 1 : 0) scale=1 transform-origin="0px 0px" transition=ghostTransition
                when dragKind == "plan"
                  box position="absolute" left=0 right=0 top=17 height=2 background-color=dragColor
                  box position="absolute" left=0 top=16 width=4 height=4 border-radius=2 background-color=dragColor
                  svg position="absolute" right=0 top=13 width=8 height=10 viewBox="0 0 8 10"
                    path d="M 1 1 L 7 5 L 1 9" fill="none" stroke=dragColor stroke-width=1.5
                text dragTitle font-size=14 font-weight=500 color=(dragKind == "plan" ? dragColor : "#292934") background-color=(dragKind == "plan" ? "#ffffff" : "#ffffff00") padding-left=(dragKind == "plan" ? 3 : 0) padding-right=(dragKind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
              box id="calendar-drag-landing-face" testId="calendar-drag-landing-face" position="absolute" left=0 top=0 width=landingWidth height=20 box-sizing="border-box" padding-left=6 padding-right=6 display="flex" align-items="center" justify-content=(dragKind == "plan" ? "center" : "flex-start") opacity=(landed ? 1 : 0) transition=ghostTransition
                when dragKind == "plan"
                  box position="absolute" left=0 right=0 top=9 height=2 background-color=dragColor
                  when not landingBefore
                    box position="absolute" left=0 top=8 width=4 height=4 border-radius=2 background-color=dragColor
                  when not landingAfter
                    svg position="absolute" right=0 top=5 width=8 height=10 viewBox="0 0 8 10"
                      path d="M 1 1 L 7 5 L 1 9" fill="none" stroke=dragColor stroke-width=1.5
                text dragTitle font-size=11 font-weight=500 color=(dragKind == "plan" ? dragColor : "#292934") background-color=(dragKind == "plan" ? "#ffffff" : "#ffffff00") padding-left=(dragKind == "plan" ? 3 : 0) padding-right=(dragKind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
      when pickerOpen
        box testId="picker-backdrop" press=closePicker position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.16)" z-index=10 opacity=(pickerClosing ? 0 : 1) transition="opacity 240ms ease-out"
        column id="type-picker" testId="type-picker" role="dialog" aria-label="Add to your calendar" position="absolute" left=0 right=0 bottom=0 height=min(380, viewport.height * 0.9) box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" border-top-left-radius=24 border-top-right-radius=24 background-color="#ffffff" z-index=11 translate=`0px ${pickerClosing ? 420 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate 240ms cubic-bezier(0.22, 1, 0.36, 1)") animation=(viewport.prefersReducedMotion or pickerClosing ? "none" : "sheetIn 240ms cubic-bezier(0.22, 1, 0.36, 1)")
          box width=32 height=4 margin-top=10 margin-bottom=2 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=60 padding-left=20 padding-right=20 align-items="center" flex-shrink=0
            text "Add to your calendar" flex=1 font-size=18 font-weight=600
            button press=closePicker testId="cancel-type-picker" aria-label="Close item picker" class=QuietButton width=36 height=36
              image "symbol:close" font-size=14 tint-color="#77777e"
          scroll flex=1 min-height=0
            column padding=20 padding-top=4 gap=12
              row gap=12
                PickerChoice(kind="event", title="Event", detail="A moment or a trip", symbol="symbol:calendar", tone="#df666c", pick=chooseType)
                PickerChoice(kind="plan", title="Plan", detail="Goals and steps", symbol="symbol:forward", tone="#747AFF", pick=chooseType)
              row gap=12
                PickerChoice(kind="todo", title="Todo", detail="A task for later", symbol="symbol:checkmark", tone="#70B8A2", pick=chooseType)
                PickerChoice(kind="sticker", title="Sticker", detail="Mark your day", symbol="symbol:photo", tone="#F39B65", pick=chooseType)
      when stickerOpen and not dragging
        box testId="sticker-backdrop" press=closeSticker position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.16)" z-index=10 opacity=(stickerClosing ? 0 : 1) transition="opacity 240ms ease-out"
      when stickerOpen
        column id="sticker-editor" testId="sticker-editor" role="dialog" aria-label="Choose a sticker" position="absolute" left=0 right=0 bottom=0 height=min(660, viewport.height * 0.9) min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" border-top-left-radius=24 border-top-right-radius=24 background-color="#ffffff" z-index=11 translate=`0px ${stickerClosing or (dragging and (held or dragCommitted)) ? 700 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate 300ms cubic-bezier(0.22, 1, 0.36, 1)") animation=(viewport.prefersReducedMotion or stickerClosing ? "none" : "sheetIn 240ms cubic-bezier(0.22, 1, 0.36, 1)")
          box width=32 height=4 margin-top=10 margin-bottom=2 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=60 padding-left=20 padding-right=20 gap=4 align-items="center" flex-shrink=0
            button press=closeSticker testId="cancel-sticker" disabled=(busy or dragging) width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-start"
              text "Cancel" font-size=16 color="#74747c"
            text "Sticker" flex=1 text-align="center" font-size=18 font-weight=600
            button press=saveSticker testId="save-sticker" disabled=(busy or dragging or stickerClosing or not stickerDate.valid or pending(stickerDate) or pending(stickerAgenda) or stickerSelection == "") width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-end"
              text "Save" font-size=16 font-weight=600 color=(stickerDate.valid and stickerSelection != "" ? "#d85358" : "#d9b9bb")
          scroll id="sticker-list" testId="sticker-list" flex=1 min-height=0
            column padding=20 padding-top=4 gap=16
              row gap=12 align-items="center" height=44
                text "Date" flex=1 font-size=16
                input type="date" id="sticker-date" testId="sticker-date" aria-label="Sticker date" value=stickerDateText input=writeStickerDate disabled=(busy or dragging) class=DateField width=180 min="1900-01-01" max="2100-12-31"
              column gap=10
                row gap=10
                  StickerChoice(value="sunshine", title="Sunshine", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="coffee", title="Coffee", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="cake", title="Cake", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="heart", title="Heart", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="sparkle", title="Sparkle", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="flower", title="Flower", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="book", title="Book", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="workout", title="Workout", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="travel", title="Travel", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="rest", title="Rest", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
              when stickerDate.valid and stickerAgenda.stickerId != ""
                button press=clearSticker testId="remove-sticker" disabled=(busy or dragging) height=48 border-width=0 border-radius=12 background-color="#fff1ef" display="flex" align-items="center" justify-content="center"
                  text "Remove sticker" font-size=16 font-weight=500 color="#c85353"
              when error != "" or not stickerDate.valid
                text (error != "" ? error : stickerDate.message) testId="sticker-error" color="#b74238" font-size=13
      when editorOpen
        box press=closeEditor testId="editor-backdrop" position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.18)" z-index=10 opacity=(editorClosing ? 0 : 1) transition="opacity 240ms ease-out"
        column id="schedule-editor" testId=(editorKind == "todo" ? "todo-editor" : "schedule-editor") role="dialog" aria-label=editorLabel position="absolute" left=0 right=0 bottom=0 height=editorHeight min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" background-color="#ffffff" border-top-left-radius=24 border-top-right-radius=24 box-shadow="0 -8px 44px rgba(28, 31, 44, 0.08)" z-index=11 translate=`0px ${editorClosing ? editorHeight + 40 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate 240ms cubic-bezier(0.22, 1, 0.36, 1)") animation=(viewport.prefersReducedMotion or editorClosing ? "none" : "sheetIn 240ms cubic-bezier(0.22, 1, 0.36, 1)")
          box width=32 height=4 margin-top=10 margin-bottom=2 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=60 padding-left=20 padding-right=20 gap=4 align-items="center" flex-shrink=0
            button press=closeEditor testId="cancel-editor" aria-label="Cancel editing" width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" disabled=busy
              text "Cancel" font-size=16 color="#74747c"
            text editorLabel flex=1 min-width=0 text-align="center" font-size=18 font-weight=600 letter-spacing=-0.3
            button press=save testId="save-schedule" aria-label="Save item" disabled=(busy or not libraryReady or not editorReady or title == "") width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-end"
              text (busy ? "Saving…" : "Save") font-size=16 font-weight=600 color=(busy or title == "" ? "#d9b9bb" : "#d85358")
          scroll testId="editor-fields" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
            column padding-left=20 padding-right=20 padding-top=12 padding-bottom=24 gap=18
              when not editorReady
                text (pending(opened) ? "Opening schedule…" : opened.message) color="#b74238" font-size=13 testId="event-error"
                when opened.message != "" and not pending(opened)
                  button press=retryEvent disabled=busy testId="retry-event" padding=10 border-width=0 border-radius=10 background-color="#f5f5f7"
                    text "Try again" font-size=13 color="#79797f"
              column gap=8
                text "Title" class=FieldLabel
                input id="schedule-title" testId="schedule-title" aria-label="Schedule title" placeholder="What are you planning?" value=title input=writeTitle disabled=(busy or not editorReady) class=Field font-size=17
              column gap=10
                text "Color" class=FieldLabel
                row gap=14 align-items="center"
                  ColorChoice(value="#FA7070", label="Coral", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#747AFF", label="Blue", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#70B8A2", label="Mint", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#F39B65", label="Honey", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#D4BEF1", label="Lilac", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#EE8192", label="Rose", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              when editorKind != "todo"
                row align-items="center" gap=12 height=40
                  text "All day" flex=1 font-size=16
                  input type="checkbox" switch checked=allDay change=toggleAllDay disabled=(busy or not editorReady) testId="all-day" aria-label="All day" accent-color="#FA7070"
                column gap=4
                  row gap=12 align-items="center" height=44
                    text "Starts" flex=1 font-size=16
                    input type="date" id="start-date" testId="start-date" aria-label="Start date" value=startDate input=writeStartDate disabled=(busy or not editorReady) class=DateField width=180 min="1900-01-01" max="2100-12-31"
                  when not allDay
                    row gap=12 align-items="center" height=40
                      text "Start time" flex=1 font-size=13 color="#85858d"
                      input type="time" id="start-time" testId="start-time" aria-label="Start time" value=startTime input=writeStartTime disabled=(busy or not editorReady) class=DateField width=124
                  box height=1 margin-top=4 margin-bottom=4 background-color="#f0f0f3"
                  row gap=12 align-items="center" height=44
                    text "Ends" flex=1 font-size=16
                    input type="date" id="end-date" testId="end-date" aria-label="End date, included" value=endDate input=writeEndDate disabled=(busy or not editorReady) class=DateField width=180 min="1900-01-01" max="2100-12-31"
                  when not allDay
                    row gap=12 align-items="center" height=40
                      text "End time" flex=1 font-size=13 color="#85858d"
                      input type="time" id="end-time" testId="end-time" aria-label="End time" value=endTime input=writeEndTime disabled=(busy or not editorReady) class=DateField width=124
                  text "The end date is included." margin-top=6 font-size=13 color="#85858d"
                column gap=9
                  text "Notes" class=FieldLabel
                  textarea id="schedule-notes" testId="schedule-notes" aria-label="Schedule notes" placeholder="Anything to remember…" value=notes input=writeNotes disabled=(busy or not editorReady) width="100%" height=88 min-height=88 box-sizing="border-box" padding=14 font-size=16 font-family="system-ui" border-width=0 border-radius=12 background-color="#f5f5f7" color="#242428"
              when error != ""
                text error testId="editor-error" aria-live="assertive" font-size=13 color="#b74238" padding=12 border-radius=10 background-color="#fff1ef"
              when editId != ""
                when confirmDelete
                  column gap=12 padding=16 background-color="#fff1ef" border-radius=14
                    text (editorKind == "todo" ? "Delete this todo?" : "Delete this item?") font-size=16 font-weight=600 color="#b74238"
                    text (editorKind == "todo" ? "This removes it from your todos." : "This removes it from every date.") font-size=13 color="#b74238"
                    row gap=12
                      button press=keepEvent disabled=busy testId="keep-schedule" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#ffffff" display="flex" align-items="center" justify-content="center"
                        text "Keep" font-size=16 color="#74747c"
                      button press=remove disabled=busy testId="confirm-delete" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#df666c" display="flex" align-items="center" justify-content="center"
                        text "Delete" font-size=16 font-weight=600 color="#ffffff"
                else
                  button press=askDelete disabled=(busy or not editorReady) testId="delete-schedule" width="100%" height=48 border-width=0 border-radius=12 background-color="#fff1ef" display="flex" align-items="center" justify-content="center"
                    text (editorKind == "todo" ? "Delete todo" : "Delete item") font-size=16 font-weight=500 color="#c85353"

component MonthPage
  props
    page: Month
    left: number
    width: number
    height: number
    today: number
    selected: number
    hasSelection: bool
    blocked: bool
    dragId: string
    activeDragId: string
    held: bool
    busy: bool
    scrollPadding: number
    hoverDay: number
    dragSpan: number
    scrollTop: number
    scrolled: action
    choose: action
    pan: action
    release: action
  derive minimumWeek = max(76, height / max(1, length(page.weeks)))
  view
    column id=`month-${page.month}` testId=`month-${page.id}` width=width height="100%" flex-shrink=0 min-height=0 position="absolute" left=left top=0 touch-action="pan-y" pan=pan panrelease=release overflow="hidden"
      scroll id=`month-scroll-${page.month}` scrollTop=scrollTop scroll=scrolled(page.month) testId=`month-scroll-${page.id}` width="100%" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain" scrollbar-width="none"
        column width="100%" box-sizing="border-box" padding-bottom=scrollPadding
          each week in page.weeks key=week.id
            box testId=`week-${page.id}-${week.id}` width="100%" height=max(minimumWeek, 34 + week.lanes * 24 + week.footer) position="relative" flex-shrink=0
              row position="absolute" left=0 top=0 right=0 bottom=0
                each cell in week.cells key=cell.id
                  DateCell(cell=cell, month=page.id, today=today, selected=selected, hasSelection=hasSelection, blocked=blocked, activeDragId=activeDragId, held=held, busy=busy, hoverDay=hoverDay, dragSpan=dragSpan, choose=choose, pan=pan, release=release)
              each bar in week.bars key=bar.id
                box testId=`bar-${page.id}-${bar.id}` aria-hidden=true pointer-events="none" position="absolute" left=`calc(${bar.startCol * 100 / 7}% + 2px)` top=(34 + bar.lane * 24) width=`calc(${bar.span * 100 / 7}% - 4px)` height=20 box-sizing="border-box" padding-left=6 padding-right=6 background-color=(bar.kind == "plan" ? "#ffffff00" : bar.color) border-top-left-radius=(bar.continuesBefore ? 0 : 4) border-bottom-left-radius=(bar.continuesBefore ? 0 : 4) border-top-right-radius=(bar.continuesAfter ? 0 : 4) border-bottom-right-radius=(bar.continuesAfter ? 0 : 4) display="flex" align-items="center" justify-content=(bar.kind == "plan" ? "center" : "flex-start") opacity=(dragId == bar.eventId ? 0.3 : 1)
                  when bar.kind == "plan"
                    box position="absolute" left=0 right=0 top=9 height=2 background-color=bar.color
                    when not bar.continuesBefore
                      box position="absolute" left=0 top=8 width=4 height=4 border-radius=2 background-color=bar.color
                    when not bar.continuesAfter
                      svg position="absolute" right=0 top=5 width=8 height=10 viewBox="0 0 8 10"
                        path d="M 1 1 L 7 5 L 1 9" fill="none" stroke=bar.color stroke-width=1.5
                  text bar.title font-size=11 font-weight=500 color=(bar.kind == "plan" ? bar.color : "#292934") background-color=(bar.kind == "plan" ? "#ffffff" : "#ffffff00") padding-left=(bar.kind == "plan" ? 3 : 0) padding-right=(bar.kind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"

component DateCell
  props
    cell: Cell
    month: string
    today: number
    selected: number
    hasSelection: bool
    blocked: bool
    activeDragId: string
    held: bool
    busy: bool
    hoverDay: number
    dragSpan: number
    choose: action
    pan: action
    release: action
  derive highlighted = inRange(cell.day, hoverDay, dragSpan)
  derive isSelected = hasSelection and selected == cell.day
  view
    button id=`date-${month}-${cell.date}` testId=`date-${month}-${cell.date}` press=choose(cell.day) disabled=blocked touch-action="pan-y" pan=pan panrelease=release aria-label=cell.date aria-selected=isSelected position="relative" width="14.285714%" height="100%" box-sizing="border-box" margin=0 padding=0 padding-top=4 border-style="solid" border-top-width=1 border-top-color="#f1f1f3" border-bottom-width=0 border-left-width=0 border-right-width=0 background-color=(highlighted ? "#EEF1FF" : "#ffffff") display="flex" flex-direction="column" align-items="center" justify-content="flex-start"
      when highlighted
        svg position="absolute" left=0 top=0 width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" pointer-events="none" aria-hidden=true
          path d="M 0 0.5 L 100 0.5 M 0 99.5 L 100 99.5" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay or weekday(cell.day) == 0
            path d="M 0.5 0 L 0.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay + dragSpan or weekday(cell.day) == 6
            path d="M 99.5 0 L 99.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
      box width=24 height=24 border-radius=12 background-color=(cell.day == today ? "#FA7070" : (isSelected ? "#fff0f0" : "#ffffff00")) display="flex" align-items="center" justify-content="center"
        text `${cell.number}` font-size=13 font-weight=(cell.day == today or isSelected ? 600 : 400) color=(cell.day == today ? "#ffffff" : (isSelected ? "#df666c" : (cell.inMonth ? "#494950" : "#bfc0c6")))
      when cell.stickerId != ""
        image `assets/stickers/${cell.stickerId}.png` testId=`sticker-${month}-${cell.date}` position="absolute" right=4 bottom=4 width=32 height=32 object-fit="contain" pointer-events="none" aria-hidden=true opacity=(activeDragId == `sticker-day:${cell.day}:${cell.stickerId}` ? 0 : 1)
        calendar-drag-handle id=`sticker-cell-${month}-${cell.date}` testId=`sticker-cell-${month}-${cell.date}` event-id=`sticker-day:${cell.day}:${cell.stickerId}` enabled=(not blocked and not busy and (activeDragId == "" or (held and activeDragId == `sticker-day:${cell.day}:${cell.stickerId}`)) ? "true" : "false") press=choose(cell.day) aria-label="Move sticker" position="absolute" right=4 bottom=4 width=32 height=32
