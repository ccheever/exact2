          box id="sticker-sheet-handle" testId="sticker-sheet-handle" aria-label="Drag to resize stickers" pan=sheetPan("sticker") panrelease=sheetRelease("sticker") touch-action="none" width="100%" height=28 flex-shrink=0 display="flex" align-items="flex-start" justify-content="center"
            box width=32 height=4 margin-top=10 background-color="#dcdce1" border-radius=2
          row height=60 padding-left=20 padding-right=20 gap=4 align-items="center" flex-shrink=0
            button press=closeSticker testId="cancel-sticker" disabled=(busy or dragging) width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-start"
              text "Cancel" font-size=16 color="#74747c"
            text "Sticker" flex=1 text-align="center" font-size=18 font-weight=600
            button press=saveSticker testId="save-sticker" disabled=(busy or dragging or stickerClosing or not stickerDate.valid or pending(stickerDate) or pending(stickerAgenda) or stickerSelection == "") width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-end"
              text "Save" font-size=16 font-weight=600 color=(stickerDate.valid and stickerSelection != "" ? "#d85358" : "#d9b9bb")
          scroll id="sticker-list" testId="sticker-list" flex=1 min-height=0
            column padding=20 padding-top=4 gap=16
              row gap=12 align-items="center" height=44
                text "Date" flex=1 font-size=16
                input type="date" id="sticker-date" testId="sticker-date" aria-label="Sticker date" value=stickerDateText input=writeStickerDate disabled=(busy or dragging) class=DateField width=180 min="1900-01-01" max="2100-12-31"
              column gap=10
                row gap=10
                  StickerChoice(value="sunshine", title="Sunshine", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="coffee", title="Coffee", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="cake", title="Cake", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="heart", title="Heart", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="sparkle", title="Sparkle", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="flower", title="Flower", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="book", title="Book", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="workout", title="Workout", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
