      confirmDelete = false
      error = ""
      retryToken = ""
      retryOperation = ""
  action editEvent(id: string, kind: string) writes editId, editorOpen, editorClosing, editorKind, editorOrigin, titleDraft, notesDraft, colorDraft, allDayDraft, startDateDraft, endDateDraft, startTimeDraft, endTimeDraft, confirmDelete, error, retryToken, retryOperation
    if not busy and not dragging
      retryToken = ""
      retryOperation = ""
      editId = id
      editorKind = kind
      editorOrigin = "date"
