// The calendar view and editor are authored in Contract; dates and durable
// schedules live in the app data module.
shape Time
  epochAtZero: number
  utcOffset: number
  seed: number
shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
shape Clock
  today: number
  month: number
  date: string
  ready: bool
shape Library
  ready: bool
  revision: number
  message: string
shape Month
  id: string
  month: number
  label: string
  weeks: list<Week>
shape Week
  id: string
  cells: list<Cell>
  bars: list<Bar>
  lanes: number
shape Cell
  id: string
  day: number
  date: string
  number: number
  inMonth: bool
shape Bar
  id: string
  eventId: string
  title: string
  color: string
  startCol: number
  span: number
  lane: number
  continuesBefore: bool
  continuesAfter: bool
  allDay: bool
  timeLabel: string
shape Schedule
  id: string
  title: string
  notes: string
  color: string
  allDay: bool
  startDay: number
  endDay: number
  startDate: string
  endDate: string
  startTime: string
  endTime: string
  rangeLabel: string
shape Agenda
  day: number
  date: string
  label: string
  items: list<Schedule>
shape Event
  found: bool
  item: Schedule
  message: string
shape DragInput
  valid: bool
  phase: string
  eventId: string
  serial: number
  sequence: number
  x: number
  y: number
  reason: string
  sourceX: number
  sourceY: number
  sourceWidth: number
  sourceHeight: number
shape DragTarget
  day: number
  cellX: number
  cellY: number
  cellWidth: number
  cellHeight: number
  maxScroll: number
shape Result
  revision: number
  success: bool
  message: string
  id: string
  day: number

fn monthName(month: number): string = (month - floor(month / 12) * 12 == 0 ? "January" : (month - floor(month / 12) * 12 == 1 ? "February" : (month - floor(month / 12) * 12 == 2 ? "March" : (month - floor(month / 12) * 12 == 3 ? "April" : (month - floor(month / 12) * 12 == 4 ? "May" : (month - floor(month / 12) * 12 == 5 ? "June" : (month - floor(month / 12) * 12 == 6 ? "July" : (month - floor(month / 12) * 12 == 7 ? "August" : (month - floor(month / 12) * 12 == 8 ? "September" : (month - floor(month / 12) * 12 == 9 ? "October" : (month - floor(month / 12) * 12 == 10 ? "November" : "December")))))))))))
fn unit(value: number): number = max(0, min(1, value))
fn edgeSpeed(y: number, height: number): number = y < 72 ? -840 * unit((72 - y) / 72) * unit((72 - y) / 72) : (y > height - 72 ? 840 * unit((y - height + 72) / 72) * unit((y - height + 72) / 72) : 0)
fn weekday(day: number): number = day + 4 - floor((day + 4) / 7) * 7
fn inRange(day: number, first: number, span: number): bool = first != -1000000 and day >= first and day <= first + span
fn scrollSlot(month: number): number = month - floor(month / 7) * 7
fn savedScroll(month: number, m0: number, y0: number, m1: number, y1: number, m2: number, y2: number, m3: number, y3: number, m4: number, y4: number, m5: number, y5: number, m6: number, y6: number): number = (month == m0 ? y0 : (month == m1 ? y1 : (month == m2 ? y2 : (month == m3 ? y3 : (month == m4 ? y4 : (month == m5 ? y5 : (month == m6 ? y6 : 0)))))))
fn magnitude(value: number): number = max(value, 0 - value)
fn springDecay(t: number): number = 1 / (1 + t + 0.48 * t * t + 0.235 * t * t * t)
fn pagePosition(x: number, v: number, target: number, dt: number): number = target + (x - target + (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn pageVelocity(x: number, v: number, target: number, dt: number): number = (v - 24 * (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn boundedMonth(value: number): number = max(22800, min(25211, value))
fn chosenMonth(x: number, v: number, origin: number): number = boundedMonth(x - origin + v * 0.16 > 0.22 ? origin + 1 : (x - origin + v * 0.16 < -0.22 ? origin - 1 : origin))

style QuietButton
  display="flex" align-items="center" justify-content="center" width=40 height=40 border-width=0 border-radius=20 background-color="#f5f5f6" press-scale=0.95
style Field
  box-sizing="border-box" width="100%" min-width=0 height=48 padding-left=14 padding-right=14 border-width=0 border-radius=12 background-color="#f5f5f7" color="#242428" font-size=16
style FieldLabel
  font-size=13 font-weight=500 color="#74747c"
style DateField
  box-sizing="border-box" min-width=0 height=40 padding=0 border-width=0 border-radius=8 background-color="#ffffff00" color="#242428" font-size=16

keyframes ghostLift
  from scale=1
  to scale=1.06
keyframes popupIn
  from opacity=0 translate="0px 24px"
  to opacity=1 translate="0px 0px"
keyframes sheetIn
  from opacity=0 translate="0px 48px"
  to opacity=1 translate="0px 0px"

component Calendar
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  state minute = 0
  resource clock = calendarClock(time.epochAtZero + minute, time.utcOffset) as shape Clock
  derive clockReady = clock.ready
  state libraryReady = false
  state libraryRevision = 0
  state libraryMessage = ""
  state libraryStarted = false
  mutation loadedLibrary as shape Library then didLoadLibrary
  state dataRevision = 0
  derive revision = max(libraryRevision, dataRevision)
  state monthAnchor = none
  derive month = match monthAnchor { case some(value) => value, case none => clock.month }
  resource visiblePage = calendarMonth(month, revision) as shape Month
  resource pages = calendarMonths(month, revision) as shape list<Month>
  derive pageWidth = max(1, viewport.width)
  state stageHeight = 0
  state stageViewportHeight = 0
  derive pageHeight = stageHeight > 0 ? max(1, stageHeight + viewport.height - stageViewportHeight) : max(240, viewport.height - 152)
  state pagerPositionValue = none
  derive pagerPosition = match pagerPositionValue { case some(value) => value, case none => clock.month }
  state pagerVelocity = 0
  state pagerOrigin = 0
  state pagerPanning = false
  state pagerFrameTime = 0
  state popupOpen = false
  state selectedDay = none
  derive day = match selectedDay { case some(value) => value, case none => clock.today }
  resource agenda = calendarDay(day, revision) as shape Agenda
  derive popupHeight = min(max(160, viewport.height * 0.6), 92 + max(84, min(5, length(agenda.items)) * 65) + (error != "" or notice != "" or busy ? 32 : 0))
  state editorOpen = false
  state editId = ""
  state eventRetry = 0
  resource opened = calendarEvent(editId, revision, eventRetry) as shape Event
  state titleDraft = none
  state notesDraft = none
  state colorDraft = none
  state allDayDraft = none
  state startDateDraft = none
  state endDateDraft = none
  state startTimeDraft = none
  state endTimeDraft = none
  derive title = match titleDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.title }
  derive notes = match notesDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.notes }
  derive color = match colorDraft { case some(value) => value, case none => editId == "" ? "#FA7070" : opened.item.color }
  derive allDay = match allDayDraft { case some(value) => value, case none => editId == "" or opened.item.allDay }
  derive startDate = match startDateDraft { case some(value) => value, case none => editId == "" ? agenda.date : opened.item.startDate }
  derive endDate = match endDateDraft { case some(value) => value, case none => editId == "" ? agenda.date : opened.item.endDate }
  derive startTime = match startTimeDraft { case some(value) => value, case none => editId == "" ? "09:00" : opened.item.startTime }
  derive endTime = match endTimeDraft { case some(value) => value, case none => editId == "" ? "10:00" : opened.item.endTime }
  derive editorReady = editId == "" or (opened.found and opened.item.id == editId and opened.message == "" and not pending(opened))
  state confirmDelete = false
  state operationSequence = 0
  state operation = ""
  state retryToken = ""
  state retryOperation = ""
  derive freshToken = `${time.epochAtZero}-${time.seed}-${revision}-${operationSequence + 1}`
  derive saveToken = retryOperation == "save" and retryToken != "" ? retryToken : freshToken
  derive deleteToken = retryOperation == "delete" and retryToken != "" ? retryToken : freshToken
  state notice = ""
  state error = ""
  mutation changed as shape Result then didChange
  derive busy = pending(changed)
  state dragId = ""
  state dragTitle = ""
  state dragColor = "#FA7070"
  state dragSpan = 0
  state dragSerial = 0
  state contactAck = 0
  state dragPhase = "idle"
  state dragX = 0
  state dragOriginX = 0
  state dragOriginY = 0
  state dragMoved = false
  state dragCommitted = false
  state dragY = 0
  state ghostX = 0
  state ghostY = 0
  state sourceX = 0
  state sourceY = 0
  state dragStartDay = 0
  state dragUntil = 0
  state dragFrameTime = 0
  state portX = 0
  state portY = 0
  state portWidth = 0
  state portHeight = 0
  state calendarScrollTop = 0
  state calendarScrollRequest = 0
  state calendarScrollMonth = -1
  state scrollMonth0 = -1
  state scrollY0 = 0
  state scrollMonth1 = -1
  state scrollY1 = 0
  state scrollMonth2 = -1
  state scrollY2 = 0
  state scrollMonth3 = -1
  state scrollY3 = 0
  state scrollMonth4 = -1
  state scrollY4 = 0
  state scrollMonth5 = -1
  state scrollY5 = 0
  state scrollMonth6 = -1
  state scrollY6 = 0
  state edgeDirection = 0
  state edgeSince = 0
  state edgeReadyAt = 0
  mutation contact as shape DragInput then didContact
  derive contactX = match contact { case some(value) => value.x, case none => 0 }
  derive contactY = match contact { case some(value) => value.y, case none => 0 }
  derive contactMonth = held ? boundedMonth(floor(pagerPosition + (contactX - portX) / pageWidth)) : month
  derive hoverMonth = held ? boundedMonth(floor(pagerPosition + (dragX - portX) / pageWidth)) : month
  derive contactPageX = held ? portX + (contactMonth - pagerPosition) * pageWidth : portX
  derive hoverPageX = held ? portX + (hoverMonth - pagerPosition) * pageWidth : portX
  derive contactInside = held and contactX >= portX and contactX < portX + portWidth and contactMonth == floor(pagerPosition + (contactX - portX) / pageWidth)
  derive hoverInside = held and dragX >= portX and dragX < portX + portWidth and hoverMonth == floor(pagerPosition + (dragX - portX) / pageWidth)
  derive contactWeeks = match first(filter(pages, (page) => page.month == contactMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive hoverWeeks = match first(filter(pages, (page) => page.month == hoverMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive contactScroll = held ? savedScroll(contactMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  derive hoverScroll = held ? savedScroll(hoverMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  resource contactTarget = calendarDragTarget(contactMonth, revision, contactX, contactY, contactPageX, portY, (contactInside ? pageWidth : 0), portHeight, contactScroll, max(76, pageHeight / max(1, contactWeeks)), dragSpan) as shape DragTarget
  resource hoverTarget = calendarDragTarget(hoverMonth, revision, dragX, dragY, hoverPageX, portY, (hoverInside ? pageWidth : 0), portHeight, hoverScroll, max(76, pageHeight / max(1, hoverWeeks)), dragSpan) as shape DragTarget
  derive dragging = dragId != ""
  derive held = dragPhase == "held"
  derive edgeWanted = held and dragMoved and dragY >= portY and dragY <= portY + portHeight and dragX >= portX and dragX <= portX + portWidth ? (dragX < portX + 36 and month > 22800 ? -1 : (dragX > portX + portWidth - 36 and month < 25211 ? 1 : 0)) : 0
  derive popupLowered = held or dragPhase == "landing" or (dragPhase == "fading" and dragCommitted)
  derive hoverDay = held ? hoverTarget.day : -1000000

  action tick writes minute
    minute = floor(now() / 60000) * 60000
  task clockTick mount
    every(60000, tick)

  task dragFrames mount
    every(frame, animateDrag)

  action dragInput(raw: string) writes contact
    send contact = calendarDragInput(raw)
  action didContact writes contactAck, dragSerial, dragId, dragTitle, dragColor, dragSpan, dragStartDay, dragX, dragY, dragOriginX, dragOriginY, dragMoved, dragCommitted, ghostX, ghostY, sourceX, sourceY, dragPhase, dragUntil, dragFrameTime, portX, portY, portWidth, portHeight, calendarScrollRequest, calendarScrollMonth, edgeDirection, edgeSince, edgeReadyAt, changed, operation, operationSequence, error, notice
    match contact
      case some(packet)
        if packet.valid and packet.sequence > contactAck
          contactAck = packet.sequence
          if packet.phase == "begin" and packet.serial > dragSerial and not dragging and not busy and not editorOpen
            match first(filter(agenda.items, (item) => item.id == packet.eventId))
              case some(item)
                dragSerial = packet.serial
                dragId = item.id
                dragTitle = item.title
                dragColor = item.color
                dragSpan = item.endDay - item.startDay
                dragStartDay = item.startDay
                dragOriginX = packet.x
                dragOriginY = packet.y
                dragMoved = false
                dragCommitted = false
                dragX = packet.x
                dragY = packet.y
                ghostX = packet.x - 30
                ghostY = packet.y - 24
                sourceX = packet.sourceX + 40
                sourceY = packet.sourceY + 15
                dragPhase = "held"
                dragFrameTime = now()
                calendarScrollRequest = savedScroll(month, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6)
                calendarScrollMonth = month
                edgeDirection = 0
                edgeSince = now()
                edgeReadyAt = now()
                portX = frame("calendar-stage").x - frame("calendar").x
                portY = frame("calendar-stage").y - frame("calendar").y
                portWidth = frame("calendar-stage").width
                portHeight = frame("calendar-stage").height
                notice = ""
                error = ""
              case none
                notice = "This schedule is no longer available."
          if held and packet.serial == dragSerial and packet.eventId == dragId
            if packet.phase == "move"
              if (packet.x - dragOriginX) * (packet.x - dragOriginX) + (packet.y - dragOriginY) * (packet.y - dragOriginY) > 16
                dragMoved = true
              dragX = packet.x
              dragY = packet.y
              ghostX = packet.x - 30
              ghostY = packet.y - 24
            if packet.phase == "end"
              dragX = packet.x
              dragY = packet.y
              if (dragMoved or (packet.x - dragOriginX) * (packet.x - dragOriginX) + (packet.y - dragOriginY) * (packet.y - dragOriginY) > 16) and contactTarget.day != -1000000 and contactTarget.day != dragStartDay and not pending(contactTarget)
                operationSequence = operationSequence + 1
                operation = "move"
                error = ""
                dragPhase = "landing"
                dragCommitted = true
                dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 220)
                ghostX = contactTarget.cellX + 3
                ghostY = contactTarget.cellY + 34
                send changed = moveSchedule(dragId, contactTarget.day, `${time.epochAtZero}-${time.seed}-${revision}-${operationSequence + 1}`)
              else
                dragPhase = "returning"
                dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
                ghostX = sourceX
                ghostY = sourceY
                notice = contactTarget.day == dragStartDay ? "Schedule stays on this date" : "Move cancelled"
            if packet.phase == "cancel"
              dragPhase = "returning"
              dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
              ghostX = sourceX
              ghostY = sourceY
              notice = "Move cancelled"
      case none
        notice = ""
  action animateDrag writes calendarScrollRequest, dragFrameTime, dragPhase, dragUntil, dragId, libraryStarted, libraryMessage, loadedLibrary, stageHeight, stageViewportHeight, pagerPositionValue, pagerVelocity, pagerFrameTime, monthAnchor, portX, portY, portWidth, portHeight, calendarScrollMonth, edgeDirection, edgeSince, edgeReadyAt
    if not frame("calendar-stage").unavailable
      portX = frame("calendar-stage").x - frame("calendar").x
      portY = frame("calendar-stage").y - frame("calendar").y
      portWidth = frame("calendar-stage").width
      portHeight = frame("calendar-stage").height
      if frame("calendar-stage").height > 0 and (frame("calendar-stage").height != stageHeight or viewport.height != stageViewportHeight)
        stageHeight = frame("calendar-stage").height
        stageViewportHeight = viewport.height
    if not pagerPanning and (not dragging or held) and (magnitude(pagerPosition - month) > 0.0001 or magnitude(pagerVelocity) > 0.001)
      pagerPositionValue = some(pagePosition(pagerPosition, pagerVelocity, month, min(1 / 30, max(0, now() - pagerFrameTime) / 1000)))
      pagerVelocity = pageVelocity(pagerPosition, pagerVelocity, month, min(1 / 30, max(0, now() - pagerFrameTime) / 1000))
      pagerFrameTime = now()
      if viewport.prefersReducedMotion or (magnitude(pagerPosition - month) < 0.0002 and magnitude(pagerVelocity) < 0.002)
        pagerPositionValue = some(month)
        pagerVelocity = 0
    if clockReady and not libraryStarted
      libraryStarted = true
      libraryMessage = "Loading schedules…"
      send loadedLibrary = loadCalendar(clock.today, clockReady)
    if held
      if dragMoved and edgeWanted == 0 and magnitude(pagerPosition - month) < 0.015 and hoverInside and portHeight > 0 and edgeSpeed(dragY - portY, portHeight) != 0
        calendarScrollMonth = hoverMonth
        calendarScrollRequest = max(0, min(hoverTarget.maxScroll, hoverScroll + edgeSpeed(dragY - portY, portHeight) * min(34, max(0, now() - dragFrameTime)) / 1000))
      if edgeWanted != edgeDirection
        edgeDirection = edgeWanted
        edgeSince = now()
      if edgeWanted != 0 and edgeWanted == edgeDirection and now() - edgeSince >= 420 and now() >= edgeReadyAt and magnitude(pagerPosition - month) < 0.015
        monthAnchor = some(boundedMonth(month + edgeWanted))
        pagerVelocity = 0
        pagerFrameTime = now()
        edgeSince = now()
        edgeReadyAt = now() + 650
      dragFrameTime = now()
    if dragPhase == "landing" or dragPhase == "returning"
      if now() >= dragUntil
        dragPhase = "fading"
        dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 90)
    if dragPhase == "fading" and now() >= dragUntil
      dragPhase = "idle"
      dragId = ""
  action calendarScrolled(page: number, left: number, top: number) writes calendarScrollTop, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6
    if page == month
      calendarScrollTop = top
    if scrollSlot(page) == 0
      scrollMonth0 = page
      scrollY0 = top
    if scrollSlot(page) == 1
      scrollMonth1 = page
      scrollY1 = top
    if scrollSlot(page) == 2
      scrollMonth2 = page
      scrollY2 = top
    if scrollSlot(page) == 3
      scrollMonth3 = page
      scrollY3 = top
    if scrollSlot(page) == 4
      scrollMonth4 = page
      scrollY4 = top
    if scrollSlot(page) == 5
      scrollMonth5 = page
      scrollY5 = top
    if scrollSlot(page) == 6
      scrollMonth6 = page
      scrollY6 = top
  action retryEvent writes eventRetry
    eventRetry = eventRetry + 1
  action didLoadLibrary writes libraryReady, libraryRevision, libraryMessage
    match loadedLibrary
      case some(value)
        libraryReady = value.ready
        libraryRevision = value.revision
        libraryMessage = value.message
      case none
        libraryReady = false
        libraryMessage = "Schedules could not be loaded. Please try again."
  action retryStorage writes libraryStarted
    if not pending(loadedLibrary)
      libraryStarted = false
  // Position is authored each frame, so a new gesture catches the visible spring.
  // The fixed origin bounds a whole gesture to its immediately adjacent months.
  action pagePan(dx: number, dy: number) writes pagerPanning, pagerOrigin, monthAnchor, pagerPositionValue, pagerVelocity, pagerFrameTime, popupOpen
    if not dragging and not editorOpen and (pagerPanning or magnitude(dx) > magnitude(dy))
      if not pagerPanning
        pagerOrigin = floor(pagerPosition + 0.5)
        monthAnchor = some(boundedMonth(floor(pagerPosition + 0.5)))
      pagerPanning = true
      pagerPositionValue = some(boundedMonth(max((pagerPanning ? pagerOrigin : floor(pagerPosition + 0.5)) - 1, min((pagerPanning ? pagerOrigin : floor(pagerPosition + 0.5)) + 1, pagerPosition - dx / pageWidth))))
      pagerVelocity = 0
      pagerFrameTime = now()
      popupOpen = false
  action pageRelease(vx: number, vy: number) writes pagerPanning, monthAnchor, pagerVelocity, pagerFrameTime, pagerPositionValue
    if pagerPanning
      pagerPanning = false
      monthAnchor = some(chosenMonth(pagerPosition, max(-3, min(3, 0 - vx / pageWidth)), pagerOrigin))
      pagerVelocity = max(-3, min(3, 0 - vx / pageWidth))
      pagerFrameTime = now()
      if viewport.prefersReducedMotion
        pagerPositionValue = some(chosenMonth(pagerPosition, max(-3, min(3, 0 - vx / pageWidth)), pagerOrigin))
        pagerVelocity = 0
  action goToday writes monthAnchor, popupOpen, pagerPositionValue, pagerVelocity, pagerPanning
    monthAnchor = some(clock.month)
    pagerPositionValue = some(clock.month)
    pagerVelocity = 0
    pagerPanning = false
    popupOpen = false
  action goMonth(offset: number) writes monthAnchor, popupOpen, pagerVelocity, pagerFrameTime
    monthAnchor = some(boundedMonth(floor(pagerPosition + 0.5) + offset))
    pagerVelocity = 0
    pagerFrameTime = now()
    popupOpen = false
  action chooseDate(value: number) writes selectedDay, popupOpen, error, notice
    if not dragging and not busy
      selectedDay = some(value)
      popupOpen = true
      error = ""
      notice = ""
  action closePopup writes popupOpen
    if not dragging
      popupOpen = false
  action editEvent(id: string) writes editId, editorOpen, titleDraft, notesDraft, colorDraft, allDayDraft, startDateDraft, endDateDraft, startTimeDraft, endTimeDraft, confirmDelete, error, notice, retryToken, retryOperation
    if not busy and not dragging
      retryToken = ""
      retryOperation = ""
      editId = id
      editorOpen = true
      titleDraft = none
      notesDraft = none
      colorDraft = none
      allDayDraft = none
      startDateDraft = none
      endDateDraft = none
      startTimeDraft = none
      endTimeDraft = none
      confirmDelete = false
      error = ""
      notice = ""
  action closeEditor writes editorOpen, confirmDelete, error, retryToken, retryOperation
    if not busy
      retryToken = ""
      retryOperation = ""
      blur()
      editorOpen = false
      confirmDelete = false
      error = ""
  action writeTitle(value: string) writes titleDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    titleDraft = some(value)
  action writeNotes(value: string) writes notesDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    notesDraft = some(value)
  action pickColor(value: string) writes colorDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    colorDraft = some(value)
  action toggleAllDay(value: bool) writes allDayDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    allDayDraft = some(value)
  action writeStartDate(value: string) writes startDateDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    startDateDraft = some(value)
  action writeEndDate(value: string) writes endDateDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    endDateDraft = some(value)
  action writeStartTime(value: string) writes startTimeDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    startTimeDraft = some(value)
  action writeEndTime(value: string) writes endTimeDraft, retryToken, retryOperation
    retryToken = ""
    retryOperation = ""
    endTimeDraft = some(value)
  action save writes changed, operationSequence, operation, error, retryToken, retryOperation
    if not busy and editorReady
      operationSequence = operationSequence + 1
      operation = "save"
      retryToken = saveToken
      retryOperation = "save"
      error = ""
      send changed = saveSchedule(editId, title, notes, color, allDay, startDate, endDate, startTime, endTime, saveToken)
  action askDelete writes confirmDelete
    confirmDelete = true
  action keepEvent writes confirmDelete
    confirmDelete = false
  action remove writes changed, operationSequence, operation, error, retryToken, retryOperation
    if not busy and editId != ""
      operationSequence = operationSequence + 1
      operation = "delete"
      retryToken = deleteToken
      retryOperation = "delete"
      error = ""
      send changed = deleteSchedule(editId, deleteToken)
  action didChange writes dataRevision, editorOpen, confirmDelete, selectedDay, popupOpen, notice, error, dragPhase, dragUntil, dragCommitted, ghostX, ghostY, retryToken, retryOperation
    match changed
      case some(result)
        dataRevision = max(dataRevision, result.revision)
        if result.success
          retryToken = ""
          retryOperation = ""
          editorOpen = false
          confirmDelete = false
          notice = operation == "delete" ? "Schedule deleted" : (operation == "move" ? "Schedule moved" : "Schedule saved")
          error = ""
          if operation != "delete"
            selectedDay = some(result.day)
            popupOpen = true
        else
          error = result.message
          notice = ""
          if operation == "move" and dragging
            dragPhase = "returning"
            dragCommitted = false
            dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
            ghostX = sourceX
            ghostY = sourceY
      case none
        error = "Your change could not be saved. Please try again."

  view
    main id="calendar" testId="calendar" viewport-fit="cover" interactive-widget="resizes-content" position="relative" display="flex" flex-direction="column" width="100%" height="100%" min-height=0 box-sizing="border-box" overflow="hidden" padding-top="env(safe-area-inset-top)" background-color="#ffffff" color="#242428" font-family="system-ui"
      calendar-input-root id="calendar-input" testId="calendar-input" ack=`${contactAck}` message=dragInput position="absolute" left=0 top=0 right=0 bottom=0 pointer-events="none" aria-hidden=true
      row height=72 flex-shrink=0 box-sizing="border-box" padding-left=20 padding-right=12 align-items="center" gap=4
        column flex=1 min-width=0 gap=2 aria-label=visiblePage.label
          text (clockReady ? monthName(month) : "Calendar") testId="month-label" font-size=(viewport.width < 360 ? 24 : 28) font-weight=600 letter-spacing=-0.6 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          text (clockReady ? `${floor(month / 12)}` : "Plan your day") testId="month-year" font-size=13 font-weight=400 color="#85858d"
        button press=goToday testId="today" aria-label="Go to today" disabled=dragging height=36 padding-left=14 padding-right=14 border-width=0 border-radius=18 background-color="#fff0f0" display="flex" align-items="center" justify-content="center" press-scale=0.96
          text "Today" font-size=14 font-weight=600 color="#d85358"
        button press=goMonth(-1) class=QuietButton testId="previous-month" aria-label="Previous month" disabled=(dragging or month == 22800) width=36 height=36 background-color="#ffffff"
          image "symbol:back" font-size=16 tint-color="#727278"
        button press=goMonth(1) class=QuietButton testId="next-month" aria-label="Next month" disabled=(dragging or month == 25211) width=36 height=36 background-color="#ffffff"
          image "symbol:forward-chevron" font-size=16 tint-color="#727278"
      row height=30 flex-shrink=0 align-items="center" aria-hidden=true
        Weekday(label="S", tone="#d97777")
        Weekday(label="M", tone="#929299")
        Weekday(label="T", tone="#929299")
        Weekday(label="W", tone="#929299")
        Weekday(label="T", tone="#929299")
        Weekday(label="F", tone="#929299")
        Weekday(label="S", tone="#7796c1")
      when not libraryReady and not pending(loadedLibrary) and libraryMessage != ""
        row padding=12 gap=8 align-items="center" background-color=(libraryMessage == "Loading schedules…" ? "#f5f5f7" : "#fff1ef") flex-shrink=0
          text libraryMessage testId="storage-status" aria-live="polite" color=(libraryMessage == "Loading schedules…" ? "#929299" : "#b74238") font-size=13 flex=1
          when libraryMessage != "Loading schedules…"
            button press=retryStorage testId="retry-storage" border-width=0 padding=8 background-color="#ffffff" border-radius=8
              text "Retry" font-size=13 color="#b74238"
      box id="calendar-stage" testId="calendar-stage" position="relative" flex=1 min-height=0 width="100%" overflow="hidden"
        when clockReady
          box id="calendar-pages" testId="calendar-pages" position="relative" width="100%" height="100%" translate=`${(month - pagerPosition) * pageWidth}px 0px`
            each page in pages key=page.id
              MonthPage(page=page, left=(page.month - month) * pageWidth, width=pageWidth, height=pageHeight, today=clock.today, selected=day, hasSelection=popupOpen, dragId=dragId, hoverDay=hoverDay, dragSpan=dragSpan, scrollTop=(held and page.month == calendarScrollMonth ? calendarScrollRequest : savedScroll(page.month, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6)), scrolled=calendarScrolled, choose=chooseDate, pan=pagePan, release=pageRelease)
      when (notice != "" or error != "") and not editorOpen and not popupOpen
        box position="absolute" bottom="calc(env(safe-area-inset-bottom) + 102px)" left=18 right=18 pointer-events="none" display="flex" justify-content="center"
          text (error != "" ? error : notice) testId="calendar-notice" aria-live="polite" padding=12 border-radius=14 background-color=(error != "" ? "#fff1ef" : "#f5f5f7") color=(error != "" ? "#b74238" : "#727278") font-size=13
      button id="add-schedule" testId="add-schedule" press=editEvent("") aria-label="Add schedule" disabled=(not libraryReady or busy or dragging or popupOpen) position="absolute" bottom="calc(env(safe-area-inset-bottom) + 24px)" right=20 width=56 height=56 border-width=0 border-radius=28 background-color="#FA7070" box-shadow="0 6px 20px rgba(238, 99, 107, 0.24)" display="flex" align-items="center" justify-content="center" press-scale=0.94 opacity=(dragging or popupOpen ? 0 : 1) transition="opacity 160ms ease-out"
        image "symbol:add" font-size=26 font-weight=400 tint-color="#ffffff"
      when popupOpen
        column id="date-popup" testId="date-popup" role="dialog" aria-label=agenda.label position="absolute" bottom=0 left=0 right=0 height=`calc(${popupHeight}px + env(safe-area-inset-bottom))` min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" border-top-left-radius=24 border-top-right-radius=24 background-color="#ffffff" box-shadow="0 -6px 32px rgba(28, 31, 44, 0.12)" overflow="hidden" z-index=5 translate=`0px ${popupLowered ? popupHeight - 80 : 0}px` transition=(viewport.prefersReducedMotion ? "none" : "translate spring(320, 30, 1)") animation=(viewport.prefersReducedMotion ? "none" : "popupIn 180ms ease-out")
          box width=32 height=4 margin-top=10 margin-bottom=2 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=64 flex-shrink=0 padding-left=20 padding-right=16 box-sizing="border-box" gap=8 align-items="center"
            column flex=1 min-width=0 gap=4
              text (dragging ? "Move schedule" : agenda.label) testId="popup-date" font-size=18 font-weight=600 letter-spacing=-0.3 line-height="21px" line-clamp=2 overflow="hidden"
              text (dragging ? "Hold near an edge to move further" : `${length(agenda.items)} ${length(agenda.items) == 1 ? "schedule" : "schedules"}`) font-size=13 color="#85858d"
            button press=editEvent("") testId="popup-add" aria-label="Add schedule on this date" class=QuietButton width=36 height=36 disabled=(busy or dragging)
              image "symbol:add" font-size=18 tint-color="#d85358"
            button press=closePopup testId="close-popup" aria-label="Close schedules" class=QuietButton width=36 height=36 disabled=dragging
              image "symbol:close" font-size=14 tint-color="#77777e"
          scroll id="agenda-list" testId="agenda-list" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain" scrollbar-width="none"
            column padding-bottom=12
              when length(agenda.items) == 0
                column padding=20 padding-top=14 gap=6 align-items="flex-start"
                  text "No schedules yet" font-size=16 font-weight=500 color="#494950"
                  text "Tap + to add something to your day." font-size=13 color="#85858d"
              each item in agenda.items key=item.id
                AgendaRow(item=item, hidden=(popupLowered or dragId == item.id), disabled=(busy or editorOpen or (dragging and (not held or dragId != item.id))), edit=editEvent)
          when error != "" or notice != "" or busy
            text (busy ? "Saving…" : (error != "" ? error : notice)) testId="popup-status" aria-live="polite" padding-left=20 padding-right=20 padding-top=4 padding-bottom=12 font-size=13 color=(error != "" ? "#b74238" : "#85858d") flex-shrink=0 opacity=(popupLowered ? 0 : 1)
      when dragging
        box id="calendar-drag-image" testId="calendar-drag-image" position="absolute" left=0 top=0 translate=`${ghostX}px ${ghostY}px` width=220 height=36 box-sizing="border-box" padding-left=10 padding-right=10 display="flex" align-items="center" background-color=dragColor border-radius=6 box-shadow="0 12px 18px rgba(0, 0, 0, 0.22)" pointer-events="none" z-index=8 scale=(held ? 1.06 : 1) opacity=(dragPhase == "fading" ? 0 : 1) transition=(viewport.prefersReducedMotion or held ? "none" : (dragPhase == "returning" ? "translate spring(320, 28, 0.6), scale 180ms ease-out, opacity 90ms linear" : "translate 220ms cubic-bezier(0.22, 1, 0.36, 1), scale 180ms ease-out, opacity 90ms linear")) animation=(held and not viewport.prefersReducedMotion ? "ghostLift 140ms ease-out" : "none")
          text dragTitle font-size=14 font-weight=500 white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
      when editorOpen
        box press=closeEditor testId="editor-backdrop" position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.18)" z-index=10
        column id="schedule-editor" testId="schedule-editor" role="dialog" aria-label=(editId == "" ? "New schedule" : "Edit schedule") position="absolute" left=0 right=0 bottom=0 height=min(690, viewport.height * 0.91) min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" background-color="#ffffff" border-top-left-radius=24 border-top-right-radius=24 box-shadow="0 -8px 44px rgba(28, 31, 44, 0.08)" z-index=11 animation=(viewport.prefersReducedMotion ? "none" : "sheetIn 240ms cubic-bezier(0.22, 1, 0.36, 1)")
          box width=32 height=4 margin-top=10 margin-bottom=2 align-self="center" background-color="#dcdce1" border-radius=2 flex-shrink=0
          row height=60 padding-left=20 padding-right=20 gap=4 align-items="center" flex-shrink=0
            button press=closeEditor testId="cancel-editor" aria-label="Cancel editing" width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" disabled=busy
              text "Cancel" font-size=16 color="#74747c"
            text (editId == "" ? "New schedule" : "Edit schedule") flex=1 min-width=0 text-align="center" font-size=18 font-weight=600 letter-spacing=-0.3
            button press=save testId="save-schedule" aria-label="Save schedule" disabled=(busy or not libraryReady or not editorReady or title == "") width=68 height=44 padding=0 border-width=0 background-color="#ffffff" display="flex" flex-direction="row" align-items="center" justify-content="flex-end"
              text (busy ? "Saving…" : "Save") font-size=16 font-weight=600 color=(busy or title == "" ? "#d9b9bb" : "#d85358")
          scroll testId="editor-fields" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
            column padding-left=20 padding-right=20 padding-top=12 padding-bottom=24 gap=18
              when not editorReady
                text (pending(opened) ? "Opening schedule…" : opened.message) color="#b74238" font-size=13 testId="event-error"
                when opened.message != "" and not pending(opened)
                  button press=retryEvent disabled=busy testId="retry-event" padding=10 border-width=0 border-radius=10 background-color="#f5f5f7"
                    text "Try again" font-size=13 color="#79797f"
              column gap=8
                text "Title" class=FieldLabel
                input id="schedule-title" testId="schedule-title" aria-label="Schedule title" placeholder="What are you planning?" value=title input=writeTitle disabled=(busy or not editorReady) class=Field font-size=17
              column gap=10
                text "Color" class=FieldLabel
                row gap=14 align-items="center"
                  ColorChoice(value="#FA7070", label="Coral", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#747AFF", label="Blue", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#70B8A2", label="Mint", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#F39B65", label="Honey", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#D4BEF1", label="Lilac", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#EE8192", label="Rose", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              row align-items="center" gap=12 height=40
                text "All day" flex=1 font-size=16
                input type="checkbox" switch checked=allDay change=toggleAllDay disabled=(busy or not editorReady) testId="all-day" aria-label="All day" accent-color="#FA7070"
              column gap=4
                row gap=12 align-items="center" height=44
                  text "Starts" flex=1 font-size=16
                  input type="date" id="start-date" testId="start-date" aria-label="Start date" value=startDate input=writeStartDate disabled=(busy or not editorReady) class=DateField width=180 min="1900-01-01" max="2100-12-31"
                when not allDay
                  row gap=12 align-items="center" height=40
                    text "Start time" flex=1 font-size=13 color="#85858d"
                    input type="time" id="start-time" testId="start-time" aria-label="Start time" value=startTime input=writeStartTime disabled=(busy or not editorReady) class=DateField width=124
                box height=1 margin-top=4 margin-bottom=4 background-color="#f0f0f3"
                row gap=12 align-items="center" height=44
                  text "Ends" flex=1 font-size=16
                  input type="date" id="end-date" testId="end-date" aria-label="End date, included" value=endDate input=writeEndDate disabled=(busy or not editorReady) class=DateField width=180 min="1900-01-01" max="2100-12-31"
                when not allDay
                  row gap=12 align-items="center" height=40
                    text "End time" flex=1 font-size=13 color="#85858d"
                    input type="time" id="end-time" testId="end-time" aria-label="End time" value=endTime input=writeEndTime disabled=(busy or not editorReady) class=DateField width=124
                text "The end date is included." margin-top=6 font-size=13 color="#85858d"
              column gap=9
                text "Notes" class=FieldLabel
                textarea id="schedule-notes" testId="schedule-notes" aria-label="Schedule notes" placeholder="Anything to remember…" value=notes input=writeNotes disabled=(busy or not editorReady) width="100%" height=88 min-height=88 box-sizing="border-box" padding=14 font-size=16 font-family="system-ui" border-width=0 border-radius=12 background-color="#f5f5f7" color="#242428"
              when error != ""
                text error testId="editor-error" aria-live="assertive" font-size=13 color="#b74238" padding=12 border-radius=10 background-color="#fff1ef"
              when editId != ""
                when confirmDelete
                  column gap=12 padding=16 background-color="#fff1ef" border-radius=14
                    text "Delete this schedule?" font-size=16 font-weight=600 color="#b74238"
                    text "This removes it from every date." font-size=13 color="#b74238"
                    row gap=12
                      button press=keepEvent disabled=busy testId="keep-schedule" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#ffffff" display="flex" align-items="center" justify-content="center"
                        text "Keep" font-size=16 color="#74747c"
                      button press=remove disabled=busy testId="confirm-delete" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#df666c" display="flex" align-items="center" justify-content="center"
                        text "Delete" font-size=16 font-weight=600 color="#ffffff"
                else
                  button press=askDelete disabled=(busy or not editorReady) testId="delete-schedule" width="100%" height=48 border-width=0 border-radius=12 background-color="#fff1ef" display="flex" align-items="center" justify-content="center"
                    text "Delete schedule" font-size=16 font-weight=500 color="#c85353"

component Weekday
  props
    label: string
    tone: string
  view
    text label width="14.285714%" font-size=12 font-weight=500 text-align="center" color=tone

component MonthPage
  props
    page: Month
    left: number
    width: number
    height: number
    today: number
    selected: number
    hasSelection: bool
    dragId: string
    hoverDay: number
    dragSpan: number
    scrollTop: number
    scrolled: action
    choose: action
    pan: action
    release: action
  derive minimumWeek = max(76, height / max(1, length(page.weeks)))
  view
    column id=`month-${page.month}` testId=`month-${page.id}` width=width height="100%" flex-shrink=0 min-height=0 position="absolute" left=left top=0 touch-action="pan-y" pan=pan panrelease=release overflow="hidden"
      scroll id=`month-scroll-${page.month}` scrollTop=scrollTop scroll=scrolled(page.month) testId=`month-scroll-${page.id}` width="100%" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain" scrollbar-width="none"
        column width="100%" box-sizing="border-box"
          each week in page.weeks key=week.id
            box testId=`week-${page.id}-${week.id}` width="100%" height=max(minimumWeek, 34 + week.lanes * 24 + 14) position="relative" flex-shrink=0
              row position="absolute" left=0 top=0 right=0 bottom=0
                each cell in week.cells key=cell.id
                  DateCell(cell=cell, month=page.id, today=today, selected=selected, hasSelection=hasSelection, hoverDay=hoverDay, dragSpan=dragSpan, choose=choose, pan=pan, release=release)
              each bar in week.bars key=bar.id
                box testId=`bar-${page.id}-${bar.id}` aria-hidden=true pointer-events="none" position="absolute" left=`calc(${bar.startCol * 100 / 7}% + 2px)` top=(34 + bar.lane * 24) width=`calc(${bar.span * 100 / 7}% - 4px)` height=20 box-sizing="border-box" padding-left=6 padding-right=6 background-color=bar.color border-top-left-radius=(bar.continuesBefore ? 0 : 4) border-bottom-left-radius=(bar.continuesBefore ? 0 : 4) border-top-right-radius=(bar.continuesAfter ? 0 : 4) border-bottom-right-radius=(bar.continuesAfter ? 0 : 4) display="flex" align-items="center" opacity=(dragId == bar.eventId ? 0.3 : 1)
                  text bar.title font-size=11 font-weight=500 color="#292934" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"

component DateCell
  props
    cell: Cell
    month: string
    today: number
    selected: number
    hasSelection: bool
    hoverDay: number
    dragSpan: number
    choose: action
    pan: action
    release: action
  derive highlighted = inRange(cell.day, hoverDay, dragSpan)
  derive isSelected = hasSelection and selected == cell.day
  view
    button id=`date-${month}-${cell.date}` testId=`date-${month}-${cell.date}` press=choose(cell.day) touch-action="pan-y" pan=pan panrelease=release aria-label=cell.date aria-selected=isSelected position="relative" width="14.285714%" height="100%" box-sizing="border-box" margin=0 padding=0 padding-top=4 border-style="solid" border-top-width=1 border-top-color="#f1f1f3" border-bottom-width=0 border-left-width=0 border-right-width=0 background-color=(highlighted ? "#EEF1FF" : "#ffffff") display="flex" flex-direction="column" align-items="center" justify-content="flex-start"
      when highlighted
        svg position="absolute" left=0 top=0 width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" pointer-events="none" aria-hidden=true
          path d="M 0 0.5 L 100 0.5 M 0 99.5 L 100 99.5" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay or weekday(cell.day) == 0
            path d="M 0.5 0 L 0.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay + dragSpan or weekday(cell.day) == 6
            path d="M 99.5 0 L 99.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
      box width=24 height=24 border-radius=12 background-color=(cell.day == today ? "#FA7070" : (isSelected ? "#fff0f0" : "#ffffff00")) display="flex" align-items="center" justify-content="center"
        text `${cell.number}` font-size=13 font-weight=(cell.day == today or isSelected ? 600 : 400) color=(cell.day == today ? "#ffffff" : (isSelected ? "#df666c" : (cell.inMonth ? "#494950" : "#bfc0c6")))

component AgendaRow
  props
    item: Schedule
    hidden: bool
    disabled: bool
    edit: action
  view
    column width="100%" box-sizing="border-box"
      box position="relative" width="100%" height=64
        row aria-hidden=true width="100%" height=64 box-sizing="border-box" padding-left=20 padding-right=20 background-color="#ffffff" opacity=(hidden ? 0 : 1) align-items="center" gap=12
          box width=12 height=12 flex-shrink=0 border-radius=6 background-color=item.color
          column flex=1 min-width=0 gap=4 align-items="flex-start"
            text item.title font-size=16 font-weight=500 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
            text item.rangeLabel font-size=13 color="#85858d" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
          image "symbol:forward-chevron" font-size=11 tint-color="#c9c9cf"
        calendar-drag-handle id=`agenda-item-${item.id}` testId=`agenda-item-${item.id}` event-id=item.id enabled=(disabled ? "false" : "true") press=edit(item.id) aria-label=`${item.title}, ${item.rangeLabel}. Hold to move.` position="absolute" left=0 top=0 right=0 bottom=0
      box margin-left=44 margin-right=20 height=1 background-color="#f0f0f3" opacity=(hidden ? 0 : 1)

component ColorChoice
  props
    value: string
    label: string
    selected: string
    disabled: bool
    pick: action
  view
    button press=pick(value) disabled=disabled testId=`color-${label}` aria-label=label aria-selected=(selected == value) width=32 height=32 flex-shrink=0 padding=0 border-width=(selected == value ? 2 : 0) border-style="solid" border-color="#ffffff" box-shadow=(selected == value ? `0 0 0 2px ${value}` : "none") border-radius=16 background-color=value display="flex" align-items="center" justify-content="center" press-scale=0.94
      when selected == value
        text "✓" font-size=17 font-weight=600 color="#ffffff"
