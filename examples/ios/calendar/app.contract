use Weekday from "./parts.contract"
use ColorChoice from "./parts.contract"
use AgendaRow from "./parts.contract"
use TodoRow from "./parts.contract"
use PickerChoice from "./parts.contract"
use StickerChoice from "./parts.contract"

// The calendar view and editor are authored in Contract; dates and durable
// schedules live in the app data module.
shape Time
  epochAtZero: number
  utcOffset: number
  seed: number
shape Viewport
  width: number
  height: number
  prefersReducedMotion: bool
shape Clock
  today: number
  month: number
  date: string
  ready: bool
shape Library
  ready: bool
  revision: number
  message: string
shape Month
  id: string
  month: number
  label: string
  weeks: list<Week>
shape Week
  id: string
  cells: list<Cell>
  bars: list<Bar>
  lanes: number
  footer: number
shape Cell
  id: string
  day: number
  date: string
  number: number
  inMonth: bool
  stickerId: string
shape Bar
  id: string
  eventId: string
  title: string
  color: string
  startCol: number
  span: number
  lane: number
  continuesBefore: bool
  continuesAfter: bool
  allDay: bool
  timeLabel: string
  kind: string
shape Schedule
  id: string
  title: string
  notes: string
  color: string
  allDay: bool
  startDay: number
  endDay: number
  startDate: string
  endDate: string
  startTime: string
  endTime: string
  rangeLabel: string
  kind: string
shape Agenda
  day: number
  date: string
  label: string
  items: list<Schedule>
  stickerId: string
shape Todo
  id: string
  title: string
  color: string
  completed: bool
  createdAt: number
  completedAt: number
shape ParsedDate
  valid: bool
  day: number
  message: string
shape Event
  found: bool
  item: Schedule
  message: string
shape DragInput
  valid: bool
  phase: string
  eventId: string
  serial: number
  sequence: number
  x: number
  y: number
  reason: string
  sourceX: number
  sourceY: number
  sourceWidth: number
  sourceHeight: number
shape DragTarget
  day: number
  cellX: number
  cellY: number
  cellWidth: number
  cellHeight: number
  maxScroll: number
shape StickerDrag
  valid: bool
  stickerId: string
  sourceDay: number
shape Landing
  valid: bool
  id: string
  kind: string
  x: number
  y: number
  width: number
  height: number
  continuesBefore: bool
  continuesAfter: bool
  contentHeight: number
shape Result
  revision: number
  success: bool
  message: string
  id: string
  day: number

fn monthName(month: number): string = (month - floor(month / 12) * 12 == 0 ? "Jan" : (month - floor(month / 12) * 12 == 1 ? "Feb" : (month - floor(month / 12) * 12 == 2 ? "Mar" : (month - floor(month / 12) * 12 == 3 ? "Apr" : (month - floor(month / 12) * 12 == 4 ? "May" : (month - floor(month / 12) * 12 == 5 ? "Jun" : (month - floor(month / 12) * 12 == 6 ? "Jul" : (month - floor(month / 12) * 12 == 7 ? "Aug" : (month - floor(month / 12) * 12 == 8 ? "Sep" : (month - floor(month / 12) * 12 == 9 ? "Oct" : (month - floor(month / 12) * 12 == 10 ? "Nov" : "Dec")))))))))))
fn unit(value: number): number = max(0, min(1, value))
fn edgeSpeed(y: number, height: number): number = y < 72 ? -840 * unit((72 - y) / 72) * unit((72 - y) / 72) : (y > height - 72 ? 840 * unit((y - height + 72) / 72) * unit((y - height + 72) / 72) : 0)
fn weekday(day: number): number = day + 4 - floor((day + 4) / 7) * 7
fn inRange(day: number, first: number, span: number): bool = first != -1000000 and day >= first and day <= first + span
fn scrollSlot(month: number): number = month - floor(month / 7) * 7
fn savedScroll(month: number, m0: number, y0: number, m1: number, y1: number, m2: number, y2: number, m3: number, y3: number, m4: number, y4: number, m5: number, y5: number, m6: number, y6: number): number = (month == m0 ? y0 : (month == m1 ? y1 : (month == m2 ? y2 : (month == m3 ? y3 : (month == m4 ? y4 : (month == m5 ? y5 : (month == m6 ? y6 : 0)))))))
fn magnitude(value: number): number = max(value, 0 - value)
fn springDecay(t: number): number = 1 / (1 + t + 0.48 * t * t + 0.235 * t * t * t)
fn pagePosition(x: number, v: number, target: number, dt: number): number = target + (x - target + (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn pageVelocity(x: number, v: number, target: number, dt: number): number = (v - 24 * (v + 24 * (x - target)) * dt) * springDecay(24 * dt)
fn boundedMonth(value: number): number = max(22800, min(25211, value))
fn chosenMonth(x: number, v: number, origin: number): number = boundedMonth(x - origin + v * 0.16 > 0.22 ? origin + 1 : (x - origin + v * 0.16 < -0.22 ? origin - 1 : origin))

style QuietButton
  display="flex" align-items="center" justify-content="center" width=40 height=40 border-width=0 border-radius=20 background-color="#f5f5f6" press-scale=0.95
style Field
  box-sizing="border-box" width="100%" min-width=0 height=48 padding-left=14 padding-right=14 border-width=0 border-radius=12 background-color="#f5f5f7" color="#242428" font-size=16
style FieldLabel
  font-size=13 font-weight=500 color="#74747c"
style DateField
  box-sizing="border-box" min-width=0 height=40 padding=0 border-width=0 border-radius=8 background-color="#ffffff00" color="#242428" font-size=16

keyframes popupIn
  from opacity=0 translate="0px 24px"
  to opacity=1 translate="0px 0px"
keyframes sheetIn
  from opacity=0 translate="0px 48px"
  to opacity=1 translate="0px 0px"

component Calendar
  resource time = exactTime() as shape Time
  resource viewport = exactViewport() as shape Viewport
  state minute = 0
  resource clock = calendarClock(time.epochAtZero + minute, time.utcOffset) as shape Clock
  derive clockReady = clock.ready
  state libraryReady = false
  state libraryRevision = 0
  state libraryMessage = ""
  state libraryStarted = false
  mutation loadedLibrary as shape Library then didLoadLibrary
  state dataRevision = 0
  derive revision = max(libraryRevision, dataRevision)
  state monthAnchor = none
  derive month = match monthAnchor { case some(value) => value, case none => clock.month }
  derive headerLabel = floor(month / 12) == floor(clock.month / 12) ? monthName(month) : `${monthName(month)}, ${floor(month / 12)}`
  resource pages = calendarMonths(month, revision, (dragging and dragSource == "sticker-cell" ? dragSourceMonth : -1)) as shape list<Month>
  resource todos = calendarTodos(revision) as shape list<Todo>
  derive pageWidth = max(1, viewport.width)
  state stageHeight = 0
  state stageViewportHeight = 0
  derive pageHeight = stageHeight > 0 ? max(1, stageHeight + viewport.height - stageViewportHeight) : max(240, viewport.height - 152)
  state pagerPositionValue = none
  derive pagerPosition = match pagerPositionValue { case some(value) => value, case none => clock.month }
  state pagerVelocity = 0
  state pagerOrigin = 0
  state pagerPanning = false
  state pagerFrameTime = 0
  state popupOpen = false
  state popupOffset = 0
  state popupPanning = false
  state popupClosing = false
  state popupUntil = 0
  state selectedDay = none
  derive day = match selectedDay { case some(value) => value, case none => clock.today }
  resource agenda = calendarDay(day, revision, clock.today) as shape Agenda
  derive popupHeight = 112 + max(77, min(5, length(agenda.items)) * 65) + (agenda.stickerId != "" ? 60 : 0) + (error != "" or busy ? 32 : 0)
  derive popupCap = min(360, max(176, viewport.height * 0.42))
  state todoSheetOpen = false
  state todoClosing = false
  state todoUntil = 0
  state pickerOpen = false
  state pickerClosing = false
  state pickerUntil = 0
  state pickerNext = ""
  state editorOrigin = "global"
  state creationDate = ""
  state editorOpen = false
  state editorClosing = false
  state editorUntil = 0
  state editorKind = "event"
  state editId = ""
  derive editorLabel = `${editId == "" ? "New" : "Edit"} ${editorKind == "todo" ? "todo" : (editorKind == "plan" ? "plan" : "event")}`
  derive editorHeight = min(editorKind == "todo" ? 420 : 690, viewport.height * (editorKind == "todo" ? 0.8 : 0.91))
  state eventRetry = 0
  resource opened = calendarEvent(editorKind == "todo" ? "" : editId, revision, eventRetry) as shape Event
  state titleDraft = none
  state notesDraft = none
  state colorDraft = none
  state allDayDraft = none
  state startDateDraft = none
  state endDateDraft = none
  state startTimeDraft = none
  state endTimeDraft = none
  derive title = match titleDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.title }
  derive notes = match notesDraft { case some(value) => value, case none => editId == "" ? "" : opened.item.notes }
  derive color = match colorDraft { case some(value) => value, case none => editId == "" ? "#FA7070" : opened.item.color }
  derive allDay = match allDayDraft { case some(value) => value, case none => editId == "" or opened.item.allDay }
  derive startDate = match startDateDraft { case some(value) => value, case none => editId == "" ? creationDate : opened.item.startDate }
  derive endDate = match endDateDraft { case some(value) => value, case none => editId == "" ? creationDate : opened.item.endDate }
  derive startTime = match startTimeDraft { case some(value) => value, case none => editId == "" ? "09:00" : opened.item.startTime }
  derive endTime = match endTimeDraft { case some(value) => value, case none => editId == "" ? "10:00" : opened.item.endTime }
  derive editorReady = editorKind == "todo" or editId == "" or (opened.found and opened.item.id == editId and opened.message == "" and not pending(opened))
  state stickerOpen = false
  state stickerClosing = false
  state stickerUntil = 0
  state stickerDateText = ""
  state stickerChoice = ""
  resource stickerDate = calendarDate(stickerDateText) as shape ParsedDate
  resource stickerAgenda = calendarDay(stickerDate.day, revision, clock.today) as shape Agenda
  derive stickerSelection = stickerChoice != "" ? stickerChoice : stickerAgenda.stickerId
  state confirmDelete = false
  state operationSequence = 0
  state operation = ""
  state retryToken = ""
  state retryOperation = ""
  state retryEpoch = 0
  derive freshToken = `${time.epochAtZero}-${time.seed}-${revision}-${operationSequence + 1}`
  derive saveToken = retryOperation == "save" and retryToken != "" ? retryToken : freshToken
  derive deleteToken = retryOperation == "delete" and retryToken != "" ? retryToken : freshToken
  derive saveEpoch = retryOperation == "save" and retryToken != "" ? retryEpoch : time.epochAtZero + now()
  derive stickerSaveToken = retryOperation == "sticker-save" and retryToken != "" ? retryToken : freshToken
  derive stickerRemoveToken = retryOperation == "sticker-remove" and retryToken != "" ? retryToken : freshToken
  state error = ""
  mutation changed as shape Result then didChange
  derive busy = pending(changed)
  state dragId = ""
  state dragTitle = ""
  state dragRangeLabel = ""
  state dragKind = "event"
  state dragColor = "#FA7070"
  state dragSpan = 0
  state dragSerial = 0
  state contactAck = 0
  state dragPhase = "idle"
  state dragX = 0
  state dragOriginX = 0
  state dragOriginY = 0
  state dragMoved = false
  state dragCommitted = false
  state dragY = 0
  state ghostX = 0
  state ghostY = 0
  state sourceX = 0
  state sourceY = 0
  state sourceWidth = 1
  state sourceHeight = 1
  state liftPrepared = false
  state liftReadyAt = 0
  state landingWidth = 1
  state landingHeight = 20
  state landingBefore = false
  state landingAfter = false
  state dragStartDay = 0
  state dragSource = "date"
  state dragSourceDay = 0
  state dragSourceMonth = 0
  state dragTodoId = ""
  state dragStickerId = ""
  state pendingMoveRevision = 0
  state pendingMoveDay = 0
  state pendingMove = false
  state dragUntil = 0
  state dragFrameTime = 0
  state portX = 0
  state portY = 0
  state portWidth = 0
  state portHeight = 0
  state calendarScrollTop = 0
  state calendarScrollRequest = 0
  state calendarScrollMonth = -1
  state scrollMonth0 = -1
  state scrollY0 = 0
  state scrollMonth1 = -1
  state scrollY1 = 0
  state scrollMonth2 = -1
  state scrollY2 = 0
  state scrollMonth3 = -1
  state scrollY3 = 0
  state scrollMonth4 = -1
  state scrollY4 = 0
  state scrollMonth5 = -1
  state scrollY5 = 0
  state scrollMonth6 = -1
  state scrollY6 = 0
  state edgeDirection = 0
  state edgeSince = 0
  state edgeReadyAt = 0
  mutation contact as shape DragInput then didContact
  derive contactId = match contact { case some(value) => value.eventId, case none => "" }
  derive contactSchedule = first(filter(agenda.items, (item) => item.id == contactId))
  derive contactTodo = first(filter(todos, (item) => `todo:${item.id}` == contactId))
  resource contactSticker = calendarStickerDrag(contactId, revision) as shape StickerDrag
  derive contactIsSticker = contactSticker.valid and not pending(contactSticker)
  derive contactIsTodo = match contactTodo { case some(item) => true, case none => false }
  derive contactAvailable = contactIsSticker ? (contactSticker.sourceDay == -1000000 ? stickerOpen : (not modalOpen or popupOpen)) : (contactIsTodo ? todoSheetOpen : (popupOpen and match contactSchedule { case some(item) => true, case none => false }))
  derive contactX = match contact { case some(value) => value.x, case none => 0 }
  derive contactY = match contact { case some(value) => value.y, case none => 0 }
  derive contactMonth = held ? boundedMonth(floor(pagerPosition + (contactX - portX) / pageWidth)) : month
  derive hoverMonth = held ? boundedMonth(floor(pagerPosition + (dragX - portX) / pageWidth)) : month
  derive contactPageX = held ? portX + (contactMonth - pagerPosition) * pageWidth : portX
  derive hoverPageX = held ? portX + (hoverMonth - pagerPosition) * pageWidth : portX
  derive contactCancel = held and contactX >= 0 and contactX <= viewport.width and contactY >= viewport.height - 112 and contactY <= viewport.height
  derive hoverCancel = held and dragX >= 0 and dragX <= viewport.width and dragY >= viewport.height - 112 and dragY <= viewport.height
  derive contactInside = held and not contactCancel and contactX >= portX and contactX < portX + portWidth and contactMonth == floor(pagerPosition + (contactX - portX) / pageWidth)
  derive hoverInside = held and not hoverCancel and dragX >= portX and dragX < portX + portWidth and hoverMonth == floor(pagerPosition + (dragX - portX) / pageWidth)
  derive contactWeeks = match first(filter(pages, (page) => page.month == contactMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive hoverWeeks = match first(filter(pages, (page) => page.month == hoverMonth)) { case some(page) => length(page.weeks), case none => 6 }
  derive contactScroll = held ? savedScroll(contactMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  derive hoverScroll = held ? savedScroll(hoverMonth, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6) : 0
  // Held-only bottom padding lets the final week scroll above Cancel without
  // changing week heights. Hit testing uses that same unobscured viewport.
  derive dragPortHeight = max(1, min(portHeight, viewport.height - 112 - portY))
  derive dragPadding = max(0, portHeight - dragPortHeight)
  resource contactTarget = calendarDragTarget(contactMonth, revision, contactX, contactY, contactPageX, portY, (contactInside ? pageWidth : 0), (held ? dragPortHeight : portHeight), contactScroll, max(76, pageHeight / max(1, contactWeeks)), dragSpan) as shape DragTarget
  resource hoverTarget = calendarDragTarget(hoverMonth, revision, dragX, dragY, hoverPageX, portY, (hoverInside ? pageWidth : 0), (held ? dragPortHeight : portHeight), hoverScroll, max(76, pageHeight / max(1, hoverWeeks)), dragSpan) as shape DragTarget
  resource contactLanding = calendarLanding(dragId, (held ? contactTarget.day : -1000000), contactMonth, revision, pageWidth, max(76, pageHeight / max(1, contactWeeks))) as shape Landing
  // Both pre-save and prospective content must admit the released scroll offset.
  derive landingScroll = min(contactScroll, min(max(0, contactLanding.contentHeight - portHeight), max(0, contactTarget.maxScroll - dragPadding)))
  derive dragging = dragId != ""
  derive held = dragPhase == "held"
  derive modalOpen = popupOpen or todoSheetOpen or pickerOpen or editorOpen or stickerOpen
  derive landed = dragCommitted and not held and dragPhase != "returning"
  derive lifted = held and liftPrepared
  derive ghostWidth = landed ? landingWidth : (lifted ? (dragKind == "sticker" ? 48 : 220) : sourceWidth)
  derive ghostHeight = landed ? landingHeight : (lifted ? (dragKind == "sticker" ? 48 : 36) : sourceHeight)
  derive ghostTransition = viewport.prefersReducedMotion ? "none" : "opacity 300ms cubic-bezier(0.22, 1, 0.36, 1), scale 300ms cubic-bezier(0.22, 1, 0.36, 1)"
  derive edgeWanted = held and dragMoved and not hoverCancel and dragY >= portY and dragY <= portY + portHeight and dragX >= portX and dragX <= portX + portWidth ? (dragX < portX + 36 and month > 22800 ? -1 : (dragX > portX + portWidth - 36 and month < 25211 ? 1 : 0)) : 0
  derive popupLowered = (dragging and (held or dragCommitted)) or pickerOpen or editorOpen or stickerOpen
  derive hoverDay = held ? hoverTarget.day : -1000000

  action tick writes minute
    minute = floor(now() / 60000) * 60000
  task clockTick mount
    every(60000, tick)

  task dragFrames mount
    every(frame, animateDrag)

  action dragInput(raw: string) writes contact
    send contact = calendarDragInput(raw)
  action didContact writes contactAck, dragSerial, dragId, dragTitle, dragRangeLabel, dragKind, dragColor, dragSpan, dragStartDay, dragSource, dragSourceDay, dragSourceMonth, dragTodoId, dragStickerId, pendingMove, dragX, dragY, dragOriginX, dragOriginY, dragMoved, dragCommitted, ghostX, ghostY, sourceX, sourceY, sourceWidth, sourceHeight, liftPrepared, liftReadyAt, landingWidth, landingHeight, landingBefore, landingAfter, dragPhase, dragUntil, dragFrameTime, portX, portY, portWidth, portHeight, calendarScrollRequest, calendarScrollMonth, edgeDirection, edgeSince, edgeReadyAt, changed, operation, operationSequence, error
    match contact
      case some(packet)
        if packet.valid and packet.sequence > contactAck
          contactAck = packet.sequence
          if packet.phase == "begin" and packet.serial > dragSerial and not dragging and not busy and not editorOpen and not pickerOpen and (not stickerOpen or (contactIsSticker and contactSticker.sourceDay == -1000000)) and not stickerClosing and not popupClosing and not popupPanning and not todoClosing
            if contactAvailable
              dragSerial = packet.serial
              dragId = packet.eventId
              dragTitle = match contactTodo { case some(item) => item.title, case none => match contactSchedule { case some(item) => item.title, case none => "" } }
              dragRangeLabel = match contactTodo { case some(item) => item.completed ? "Completed" : "Hold to add to your calendar", case none => match contactSchedule { case some(item) => item.rangeLabel, case none => "" } }
              dragKind = contactIsSticker ? "sticker" : match contactSchedule { case some(item) => item.kind, case none => "event" }
              dragColor = match contactTodo { case some(item) => item.color, case none => match contactSchedule { case some(item) => item.color, case none => "#FA7070" } }
              dragSpan = match contactSchedule { case some(item) => item.endDay - item.startDay, case none => 0 }
              dragStartDay = contactIsSticker ? contactSticker.sourceDay : match contactSchedule { case some(item) => item.startDay, case none => -1000000 }
              dragSource = contactIsSticker ? (contactSticker.sourceDay == -1000000 ? "sticker-picker" : (popupOpen ? "sticker-date" : "sticker-cell")) : (contactIsTodo ? "todos" : "date")
              dragSourceDay = contactIsSticker ? contactSticker.sourceDay : day
              dragSourceMonth = boundedMonth(floor(pagerPosition + (packet.x - portX) / pageWidth))
              dragStickerId = contactIsSticker ? contactSticker.stickerId : ""
              dragTodoId = match contactTodo { case some(item) => item.id, case none => "" }
              pendingMove = false
              dragOriginX = packet.x
              dragOriginY = packet.y
              dragMoved = false
              dragCommitted = false
              dragX = packet.x
              dragY = packet.y
              ghostX = packet.sourceX
              ghostY = packet.sourceY
              sourceX = packet.sourceX
              sourceY = packet.sourceY
              sourceWidth = max(1, packet.sourceWidth)
              sourceHeight = max(1, packet.sourceHeight)
              liftPrepared = false
              liftReadyAt = now() + 48
              dragPhase = "held"
              dragFrameTime = now()
              calendarScrollRequest = savedScroll(month, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6)
              calendarScrollMonth = month
              edgeDirection = 0
              edgeSince = now()
              edgeReadyAt = now()
              match some(frame("calendar-stage"))
                case some(stage)
                  match some(frame("calendar"))
                    case some(root)
                      portX = stage.x - root.x
                      portY = stage.y - root.y
                      portWidth = stage.width
                      portHeight = stage.height
                    case none
                      portWidth = 0
                case none
                  portWidth = 0
              error = ""
            else
              error = "This item is no longer available."
          if held and packet.serial == dragSerial and packet.eventId == dragId
            if packet.phase == "move"
              if (packet.x - dragOriginX) * (packet.x - dragOriginX) + (packet.y - dragOriginY) * (packet.y - dragOriginY) > 16
                dragMoved = true
              dragX = packet.x
              dragY = packet.y
              ghostX = sourceX + packet.x - dragOriginX
              ghostY = sourceY + packet.y - dragOriginY
            if packet.phase == "end"
              dragX = packet.x
              dragY = packet.y
              if not contactCancel and (dragMoved or (packet.x - dragOriginX) * (packet.x - dragOriginX) + (packet.y - dragOriginY) * (packet.y - dragOriginY) > 16) and contactTarget.day != -1000000 and contactTarget.day != dragStartDay and not pending(contactTarget) and contactLanding.valid and not pending(contactLanding)
                operationSequence = operationSequence + 1
                operation = "move"
                error = ""
                dragPhase = "landing"
                dragCommitted = true
                dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 300)
                ghostX = contactPageX + contactLanding.x
                ghostY = portY + contactLanding.y - landingScroll
                calendarScrollMonth = contactMonth
                calendarScrollRequest = landingScroll
                landingWidth = contactLanding.width
                landingHeight = contactLanding.height
                landingBefore = contactLanding.continuesBefore
                landingAfter = contactLanding.continuesAfter
                if dragKind == "sticker"
                  if dragSource == "sticker-picker"
                    send changed = setSticker(contactTarget.day, dragStickerId, freshToken)
                  else
                    send changed = moveSticker(dragSourceDay, contactTarget.day, dragStickerId, freshToken)
                else
                  if dragSource == "todos"
                    send changed = scheduleTodo(dragTodoId, contactTarget.day, freshToken)
                  else
                    send changed = moveSchedule(dragId, contactTarget.day, freshToken)
              else
                dragPhase = "returning"
                dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
                ghostX = sourceX
                ghostY = sourceY
            if packet.phase == "cancel"
              dragPhase = "returning"
              dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
              ghostX = sourceX
              ghostY = sourceY
      case none
        error = "The drag contact could not be read."
  action animateDrag writes calendarScrollRequest, dragFrameTime, dragPhase, dragUntil, dragId, liftPrepared, libraryStarted, libraryMessage, loadedLibrary, stageHeight, stageViewportHeight, pagerPositionValue, pagerVelocity, pagerFrameTime, monthAnchor, portX, portY, portWidth, portHeight, calendarScrollMonth, edgeDirection, edgeSince, edgeReadyAt, popupOpen, popupClosing, popupOffset, dataRevision, pendingMove, todoSheetOpen, todoClosing, pickerOpen, pickerClosing, pickerNext, editorOpen, editorClosing, stickerOpen, stickerClosing
    // Reuse this frame's geometry without caching it across frames or resizes.
    match some(frame("calendar-stage"))
      case some(stage)
        if not stage.unavailable
          match some(frame("calendar"))
            case some(root)
              portX = stage.x - root.x
              portY = stage.y - root.y
              portWidth = stage.width
              portHeight = stage.height
              if stage.height > 0 and (stage.height != stageHeight or viewport.height != stageViewportHeight)
                stageHeight = stage.height
                stageViewportHeight = viewport.height
            case none
              portWidth = 0
      case none
        portWidth = 0
    if not pagerPanning and (not dragging or held) and (magnitude(pagerPosition - month) > 0.0001 or magnitude(pagerVelocity) > 0.001)
      pagerPositionValue = some(pagePosition(pagerPosition, pagerVelocity, month, min(1 / 30, max(0, now() - pagerFrameTime) / 1000)))
      pagerVelocity = pageVelocity(pagerPosition, pagerVelocity, month, min(1 / 30, max(0, now() - pagerFrameTime) / 1000))
      pagerFrameTime = now()
      if viewport.prefersReducedMotion or (magnitude(pagerPosition - month) < 0.0002 and magnitude(pagerVelocity) < 0.002)
        pagerPositionValue = some(month)
        pagerVelocity = 0
    if clockReady and not libraryStarted
      libraryStarted = true
      libraryMessage = "Loading schedules…"
      send loadedLibrary = loadCalendar(clock.today, clockReady)
    if held
      if not liftPrepared and now() >= liftReadyAt
        liftPrepared = true
      if dragMoved and edgeWanted == 0 and magnitude(pagerPosition - month) < 0.015 and hoverInside and portHeight > 0 and edgeSpeed(dragY - portY, dragPortHeight) != 0
        calendarScrollMonth = hoverMonth
        calendarScrollRequest = max(0, min(hoverTarget.maxScroll, hoverScroll + edgeSpeed(dragY - portY, dragPortHeight) * min(34, max(0, now() - dragFrameTime)) / 1000))
      if edgeWanted != edgeDirection
        edgeDirection = edgeWanted
        edgeSince = now()
      if edgeWanted != 0 and edgeWanted == edgeDirection and now() - edgeSince >= 420 and now() >= edgeReadyAt and magnitude(pagerPosition - month) < 0.015
        monthAnchor = some(boundedMonth(month + edgeWanted))
        pagerVelocity = 0
        pagerFrameTime = now()
        edgeSince = now()
        edgeReadyAt = now() + 650
      dragFrameTime = now()
    if dragPhase == "landing" and now() >= dragUntil and pendingMove
      dataRevision = max(dataRevision, pendingMoveRevision)
      pendingMove = false
      popupOpen = false
      todoSheetOpen = false
      stickerOpen = false
      dragPhase = "settling"
    if dragPhase == "settling" and not pending(pages) and not pending(todos) and not pending(agenda)
      dragPhase = "fading"
      dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 90)
    if dragPhase == "returning" and now() >= dragUntil
      dragPhase = "fading"
      dragUntil = now() + (viewport.prefersReducedMotion ? 0 : 90)
    if dragPhase == "fading" and now() >= dragUntil and not busy
      dragPhase = "idle"
      dragId = ""
    if popupClosing and now() >= popupUntil
      popupOpen = false
      popupClosing = false
      popupOffset = 0
    if todoClosing and now() >= todoUntil
      todoSheetOpen = false
      todoClosing = false
    if pickerClosing and now() >= pickerUntil
      pickerOpen = false
      pickerClosing = false
      if pickerNext == "sticker"
        stickerOpen = true
      else
        if pickerNext != ""
          editorOpen = true
      pickerNext = ""
    if editorClosing and now() >= editorUntil
      editorOpen = false
      editorClosing = false
    if stickerClosing and now() >= stickerUntil
      stickerOpen = false
      stickerClosing = false
  action calendarScrolled(page: number, left: number, top: number) writes calendarScrollTop, scrollMonth0, scrollY0, scrollMonth1, scrollY1, scrollMonth2, scrollY2, scrollMonth3, scrollY3, scrollMonth4, scrollY4, scrollMonth5, scrollY5, scrollMonth6, scrollY6
    if page == month
      calendarScrollTop = top
    if scrollSlot(page) == 0
      scrollMonth0 = page
      scrollY0 = top
    if scrollSlot(page) == 1
      scrollMonth1 = page
      scrollY1 = top
    if scrollSlot(page) == 2
      scrollMonth2 = page
      scrollY2 = top
    if scrollSlot(page) == 3
      scrollMonth3 = page
      scrollY3 = top
    if scrollSlot(page) == 4
      scrollMonth4 = page
      scrollY4 = top
    if scrollSlot(page) == 5
      scrollMonth5 = page
      scrollY5 = top
    if scrollSlot(page) == 6
      scrollMonth6 = page
      scrollY6 = top
  action retryEvent writes eventRetry
    eventRetry = eventRetry + 1
  action didLoadLibrary writes libraryReady, libraryRevision, libraryMessage
    match loadedLibrary
      case some(value)
        libraryReady = value.ready
        libraryRevision = value.revision
        libraryMessage = value.message
      case none
        libraryReady = false
        libraryMessage = "Schedules could not be loaded. Please try again."
  action retryStorage writes libraryStarted
    if not pending(loadedLibrary)
      libraryStarted = false
  // Position is authored each frame, so a new gesture catches the visible spring.
  // The fixed origin bounds a whole gesture to its immediately adjacent months.
  action pagePan(dx: number, dy: number) writes pagerPanning, pagerOrigin, monthAnchor, pagerPositionValue, pagerVelocity, pagerFrameTime
    if not dragging and not modalOpen and (pagerPanning or magnitude(dx) > magnitude(dy))
      if not pagerPanning
        pagerOrigin = floor(pagerPosition + 0.5)
        monthAnchor = some(boundedMonth(floor(pagerPosition + 0.5)))
      pagerPanning = true
      pagerPositionValue = some(boundedMonth(max((pagerPanning ? pagerOrigin : floor(pagerPosition + 0.5)) - 1, min((pagerPanning ? pagerOrigin : floor(pagerPosition + 0.5)) + 1, pagerPosition - dx / pageWidth))))
      pagerVelocity = 0
      pagerFrameTime = now()
  action pageRelease(vx: number, vy: number) writes pagerPanning, monthAnchor, pagerVelocity, pagerFrameTime, pagerPositionValue
    if pagerPanning
      pagerPanning = false
      monthAnchor = some(chosenMonth(pagerPosition, max(-3, min(3, 0 - vx / pageWidth)), pagerOrigin))
      pagerVelocity = max(-3, min(3, 0 - vx / pageWidth))
      pagerFrameTime = now()
      if viewport.prefersReducedMotion
        pagerPositionValue = some(chosenMonth(pagerPosition, max(-3, min(3, 0 - vx / pageWidth)), pagerOrigin))
        pagerVelocity = 0
  action goToday writes monthAnchor, pagerPositionValue, pagerVelocity, pagerPanning
    if not dragging and not modalOpen
      monthAnchor = some(clock.month)
      pagerPositionValue = some(clock.month)
      pagerVelocity = 0
      pagerPanning = false
  action goMonth(offset: number) writes monthAnchor, pagerVelocity, pagerFrameTime
    if not dragging and not modalOpen
      monthAnchor = some(boundedMonth(floor(pagerPosition + 0.5) + offset))
      pagerVelocity = 0
      pagerFrameTime = now()
  action chooseDate(value: number) writes selectedDay, popupOpen, error, popupOffset, popupPanning, popupClosing
    if not dragging and not busy and not modalOpen
      selectedDay = some(value)
      popupOpen = true
      popupOffset = 0
      popupPanning = false
      popupClosing = false
      error = ""
  action closePopup writes popupPanning, popupClosing, popupUntil
    if not dragging and not popupClosing
      popupPanning = false
      popupClosing = true
      popupUntil = now() + (viewport.prefersReducedMotion ? 0 : 240)
  action popupPan(dx: number, dy: number) writes popupOffset, popupPanning
    if popupOpen and not dragging and not busy and not editorOpen and not pickerOpen and not stickerOpen and not popupClosing and (popupPanning or (dy > 0 and dy > magnitude(dx)))
      popupPanning = true
      popupOffset = min(popupCap + 40, max(0, popupOffset + dy))
  action popupRelease(vx: number, vy: number) writes popupPanning, popupClosing, popupUntil, popupOffset
    if popupPanning
      popupPanning = false
      if popupOffset >= max(48, popupCap * 0.18) or (popupOffset > 12 and vy > 700 and vy > magnitude(vx))
