                  StickerChoice(value="rest", title="Rest", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="bunny", title="Bunny", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="paris", title="Paris", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="daisy", title="Daisy", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  StickerChoice(value="moon", title="Moon", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                row gap=10
                  StickerChoice(value="picnic", title="Picnic", selected=stickerSelection, disabled=(busy or stickerClosing or dragging), dragId=dragId, held=held, pick=pickSticker)
                  box flex=1 min-width=0 height=88
              when stickerDate.valid and stickerAgenda.stickerId != ""
                button press=clearSticker testId="remove-sticker" disabled=(busy or dragging) height=48 border-width=0 border-radius=12 background-color="#fff1ef" display="flex" align-items="center" justify-content="center"
                  text "Remove sticker" font-size=16 font-weight=500 color="#c85353"
              when error != "" or not stickerDate.valid
                text (error != "" ? error : stickerDate.message) testId="sticker-error" color="#b74238" font-size=13
      when editorOpen
        box press=closeEditor testId="editor-backdrop" position="absolute" left=0 right=0 top=0 bottom=0 background-color="rgba(28, 31, 44, 0.18)" z-index=10 opacity=(editorClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : `opacity ${editorClosing ? 180 : 200}ms ${editorClosing ? "ease-in" : "ease-out"}`)
        column id="schedule-editor" testId=(editorKind == "todo" ? "todo-editor" : "schedule-editor") role="dialog" aria-label=editorLabel position="absolute" left=0 right=0 bottom=0 height=morphHeight min-height=0 box-sizing="border-box" padding-bottom="env(safe-area-inset-bottom)" background-color="#ffffff" border-top-left-radius=24 border-top-right-radius=24 box-shadow=(sharedEditor ? "none" : "0 -8px 44px rgba(28, 31, 44, 0.08)") overflow="hidden" interpolate-size="allow-keywords" z-index=12 translate=`0px ${editorClosing and not sharedEditor ? viewport.height + 40 : (sheetDragging == "editor" ? sheetOverdrag : 0)}px` opacity=(sharedEditor and (editorClosing or not formContentReady) ? 0 : 1) transition=(viewport.prefersReducedMotion or sheetDragging != "" ? "none" : `height ${editorClosing ? 180 : 200}ms ${editorClosing ? "ease-in" : "ease-out"}, opacity ${editorClosing ? 180 : 120}ms ${editorClosing ? "ease-in" : "ease-out"}, translate ${editorClosing ? 180 : 200}ms ${editorClosing ? "ease-in" : "ease-out"}`) animation=(viewport.prefersReducedMotion or editorClosing or sharedEditor ? "none" : "sheetIn 200ms ease-out")
          box id="editor-sheet-handle" testId="editor-sheet-handle" aria-label="Drag to resize editor" pan=sheetPan("editor") panrelease=sheetRelease("editor") touch-action="none" width="100%" height=28 flex-shrink=0 display="flex" align-items="flex-start" justify-content="center"
            box width=32 height=4 margin-top=10 background-color="#dcdce1" border-radius=2
          row height=48 padding-left=24 padding-right=16 gap=4 align-items="center" flex-shrink=0
            text editorLabel flex=1 min-width=0 font-size=14 font-weight=500 color="#85858d"
            button press=closeEditor testId="cancel-editor" aria-label="Cancel editing" width=40 height=40 padding=0 border-width=0 background-color="#ffffff00" display="flex" align-items="center" justify-content="center" disabled=busy
              image "symbol:close" font-size=16 tint-color="#929299"
          scroll testId="editor-fields" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
            column padding-left=24 padding-right=24 padding-top=2 padding-bottom=24 gap=20
              when not editorReady
                text (pending(opened) ? "Opening schedule…" : opened.message) color="#b74238" font-size=13 testId="event-error"
                when opened.message != "" and not pending(opened)
                  button press=retryEvent disabled=busy testId="retry-event" padding=10 border-width=0 border-radius=10 background-color="#f5f5f7"
                    text "Try again" font-size=13 color="#79797f"
              input id="schedule-title" testId="schedule-title" aria-label="Schedule title" placeholder=(editorKind == "todo" ? "What needs doing?" : "What are you planning?") value=title input=writeTitle disabled=(busy or not editorReady) width="100%" height=52 box-sizing="border-box" padding=0 border-width=0 background-color="#ffffff00" font-size=24 font-weight=600 letter-spacing=-0.4 color="#242428"
              when editorKind != "todo"
                textarea id="schedule-notes" testId="schedule-notes" aria-label="Schedule notes" placeholder="Add a description…" value=notes input=writeNotes disabled=(busy or not editorReady) width="100%" height=48 min-height=48 box-sizing="border-box" padding=0 font-size=15 font-family="system-ui" line-height="21px" border-width=0 background-color="#ffffff00" color="#494950"
                column gap=12
                  row align-items="center" gap=12 height=32
                    text "All day" flex=1 font-size=15 color="#494950"
                    input type="checkbox" switch checked=allDay change=toggleAllDay disabled=(busy or not editorReady) testId="all-day" aria-label="All day" accent-color="#FA7070"
                  row gap=12
                    column flex=1 min-width=0 gap=8
                      text "Starts" class=FieldLabel
                      input type="date" id="start-date" testId="start-date" aria-label="Start date" value=startDate input=writeStartDate disabled=(busy or not editorReady) class=DateField width="100%" padding-left=(viewport.width < 360 ? 6 : 10) padding-right=(viewport.width < 360 ? 6 : 10) background-color="#f5f5f7" font-size=(viewport.width < 360 ? 13 : 14) min="1900-01-01" max="2100-12-31"
                      when not allDay
                        input type="time" id="start-time" testId="start-time" aria-label="Start time" value=startTime input=writeStartTime disabled=(busy or not editorReady) class=DateField width="100%" padding-left=10 padding-right=10 background-color="#f5f5f7" font-size=14
                    column flex=1 min-width=0 gap=8
                      text "Ends" class=FieldLabel
                      input type="date" id="end-date" testId="end-date" aria-label="End date, included" value=endDate input=writeEndDate disabled=(busy or not editorReady) class=DateField width="100%" padding-left=(viewport.width < 360 ? 6 : 10) padding-right=(viewport.width < 360 ? 6 : 10) background-color="#f5f5f7" font-size=(viewport.width < 360 ? 13 : 14) min="1900-01-01" max="2100-12-31"
                      when not allDay
                        input type="time" id="end-time" testId="end-time" aria-label="End time" value=endTime input=writeEndTime disabled=(busy or not editorReady) class=DateField width="100%" padding-left=10 padding-right=10 background-color="#f5f5f7" font-size=14
                  text "The end date is included." font-size=12 color="#929299"
              column gap=10
                text "Color" class=FieldLabel
                row gap=12 align-items="center"
                  ColorChoice(value="#FA7070", label="Coral", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#747AFF", label="Blue", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#70B8A2", label="Mint", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#F39B65", label="Honey", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#D4BEF1", label="Lilac", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                  ColorChoice(value="#EE8192", label="Rose", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              when error != ""
                text error testId="editor-error" aria-live="assertive" font-size=13 color="#b74238" padding=12 border-radius=10 background-color="#fff1ef"
              when editId != ""
                when confirmDelete
                  column gap=12 padding=16 background-color="#fff1ef" border-radius=14
                    text (editorKind == "todo" ? "Delete this todo?" : "Delete this item?") font-size=16 font-weight=600 color="#b74238"
                    text (editorKind == "todo" ? "This removes it from your todos." : "This removes it from every date.") font-size=13 color="#b74238"
                    row gap=12
                      button press=keepEvent disabled=busy testId="keep-schedule" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#ffffff" display="flex" align-items="center" justify-content="center"
                        text "Keep" font-size=16 color="#74747c"
                      button press=remove disabled=busy testId="confirm-delete" flex=1 height=44 padding=0 border-width=0 border-radius=10 background-color="#df666c" display="flex" align-items="center" justify-content="center"
                        text "Delete" font-size=16 font-weight=600 color="#ffffff"
                else
                  button press=askDelete disabled=(busy or not editorReady) testId="delete-schedule" width="100%" height=48 border-width=0 border-radius=12 background-color="#fff1ef" display="flex" align-items="center" justify-content="center"
                    text (editorKind == "todo" ? "Delete todo" : "Delete item") font-size=16 font-weight=500 color="#c85353"
          row height=72 flex-shrink=0 padding-left=24 padding-right=24 gap=12 border-top-width=1 border-top-style="solid" border-top-color="#ededf0" align-items="center"
            image (editorKind == "plan" ? "symbol:forward" : (editorKind == "todo" ? "symbol:checkmark" : "symbol:calendar")) font-size=18 tint-color=color
            text (editorKind == "plan" ? "Plan" : (editorKind == "todo" ? "Todo" : "Event")) flex=1 font-size=14 font-weight=500 color="#85858d"
            button press=save testId="save-schedule" aria-label="Save item" disabled=(busy or not libraryReady or not editorReady or title == "") height=44 padding-left=18 padding-right=18 border-width=0 border-radius=10 background-color=(busy or title == "" ? "#f1e4e5" : "#d96069") display="flex" align-items="center" justify-content="center"
              text (busy ? "Saving…" : (editId != "" ? "Save changes" : (editorKind == "plan" ? "Add plan" : (editorKind == "todo" ? "Add todo" : "Add event")))) font-size=15 font-weight=600 color=(busy or title == "" ? "#bb969a" : "#ffffff")

component MonthPage
  props
    page: Month
    left: number
    width: number
    height: number
    today: number
    selected: number
    hasSelection: bool
    blocked: bool
    dragId: string
    activeDragId: string
    held: bool
    busy: bool
    theme: number
    themeInk: string
    themeAccent: string
    scrollPadding: number
    hoverDay: number
    dragSpan: number
    scrollTop: number
    scrolled: action
    choose: action
    pan: action
    release: action
  derive minimumWeek = max(76, height / max(1, length(page.weeks)))
  view
    column id=`month-${page.month}` testId=`month-${page.id}` width=width height="100%" flex-shrink=0 min-height=0 position="absolute" left=left top=0 touch-action="pan-y" pan=pan panrelease=release overflow="hidden"
      scroll id=`month-scroll-${page.month}` scrollTop=scrollTop scroll=scrolled(page.month) testId=`month-scroll-${page.id}` width="100%" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain" scrollbar-width="none"
        column width="100%" box-sizing="border-box" padding-bottom=scrollPadding
          each week in page.weeks key=week.id
            box testId=`week-${page.id}-${week.id}` width="100%" height=max(minimumWeek, 34 + week.lanes * 24 + week.footer) position="relative" flex-shrink=0
              row position="absolute" left=0 top=0 right=0 bottom=0
                each cell in week.cells key=cell.id
                  DateCell(cell=cell, month=page.id, today=today, selected=selected, hasSelection=hasSelection, blocked=blocked, activeDragId=activeDragId, held=held, busy=busy, theme=theme, themeInk=themeInk, themeAccent=themeAccent, hoverDay=hoverDay, dragSpan=dragSpan, choose=choose, pan=pan, release=release)
              each bar in week.bars key=bar.id
                box testId=`bar-${page.id}-${bar.id}` aria-hidden=true pointer-events="none" position="absolute" left=`calc(${bar.startCol * 100 / 7}% + 2px)` top=(34 + bar.lane * 24) width=`calc(${bar.span * 100 / 7}% - 4px)` height=20 box-sizing="border-box" padding-left=6 padding-right=6 background-color=(bar.kind == "plan" ? "#ffffff00" : paletteColor(theme, bar.color)) border-top-left-radius=(bar.continuesBefore ? 0 : 4) border-bottom-left-radius=(bar.continuesBefore ? 0 : 4) border-top-right-radius=(bar.continuesAfter ? 0 : 4) border-bottom-right-radius=(bar.continuesAfter ? 0 : 4) display="flex" align-items="center" justify-content=(bar.kind == "plan" ? "center" : "flex-start") opacity=(dragId == bar.eventId ? 0.3 : 1)
                  when bar.kind == "plan"
                    box position="absolute" left=0 right=0 top=2 height=2 background-color=bar.color
                    when not bar.continuesBefore
                      box position="absolute" left=0 top=0 width=6 height=6 border-radius=3 background-color=bar.color
                    when not bar.continuesAfter
                      svg position="absolute" right=0 top=0 width=8 height=6 viewBox="0 0 8 6"
                        path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=bar.color stroke-width=2
                  text bar.title position=(bar.kind == "plan" ? "absolute" : "relative") left=(bar.kind == "plan" ? 0 : "auto") right=(bar.kind == "plan" ? 0 : "auto") top=(bar.kind == "plan" ? 7 : "auto") text-align=(bar.kind == "plan" ? "center" : "left") line-height="12px" font-size=11 font-weight=500 color=(bar.kind == "plan" ? bar.color : (theme == 0 ? "#292934" : themeInk)) background-color="#ffffff00" padding-left=(bar.kind == "plan" ? 3 : 0) padding-right=(bar.kind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
              each cell in week.cells key=`hit-${cell.id}`
                button testId=`date-hit-${page.id}-${cell.date}` aria-hidden=true press=choose(cell.day) disabled=blocked touch-action="pan-y" pan=pan panrelease=release position="absolute" left=`${weekday(cell.day) * 100 / 7}%` top=0 width="14.285714%" height="100%" padding=0 border-width=0 background-color="#ffffff00"

component DateCell
  props
    cell: Cell
    month: string
    today: number
    selected: number
    hasSelection: bool
    blocked: bool
    activeDragId: string
    held: bool
    busy: bool
    theme: number
    themeInk: string
    themeAccent: string
    hoverDay: number
    dragSpan: number
    choose: action
    pan: action
    release: action
  derive highlighted = inRange(cell.day, hoverDay, dragSpan)
  derive isSelected = hasSelection and selected == cell.day
  view
    button id=`date-${month}-${cell.date}` testId=`date-${month}-${cell.date}` press=choose(cell.day) disabled=blocked touch-action="pan-y" pan=pan panrelease=release aria-label=cell.date aria-selected=isSelected position="relative" width="14.285714%" height="100%" box-sizing="border-box" margin=0 padding=0 padding-top=4 border-style="solid" border-top-width=1 border-top-color=(theme == 0 ? "#f1f1f3" : "rgba(74,65,78,0.12)") border-bottom-width=0 border-left-width=0 border-right-width=0 background-color=(highlighted ? "rgba(174,192,255,0.30)" : (theme == 0 ? "#ffffff" : "#ffffff00")) display="flex" flex-direction="column" align-items="center" justify-content="flex-start"
      when highlighted
        svg position="absolute" left=0 top=0 width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" pointer-events="none" aria-hidden=true
          path d="M 0 0.5 L 100 0.5 M 0 99.5 L 100 99.5" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay or weekday(cell.day) == 0
            path d="M 0.5 0 L 0.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay + dragSpan or weekday(cell.day) == 6
            path d="M 99.5 0 L 99.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
      box width=24 height=24 border-radius=12 background-color=(cell.day == today ? themeAccent : (isSelected ? "rgba(255,255,255,0.68)" : "#ffffff00")) display="flex" align-items="center" justify-content="center"
        text `${cell.number}` font-size=13 font-weight=(cell.day == today or isSelected ? 600 : 400) color=(cell.day == today ? "#ffffff" : (isSelected ? themeAccent : (cell.inMonth ? themeInk : "#b1adb3")))
      when cell.stickerId != ""
        image `assets/stickers/${cell.stickerId}.png` testId=`sticker-${month}-${cell.date}` position="absolute" right=4 bottom=4 width=32 height=32 object-fit="contain" pointer-events="none" aria-hidden=true opacity=(activeDragId == `sticker-day:${cell.day}:${cell.stickerId}` ? 0 : 1)
