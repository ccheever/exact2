// The empty main view (lane "pages"), measured against the served reference
// at 1280×840: DraftHeroHeadline's sentence and its project menu, and the
// index landings (NoProjectsHero, DraftStartError and the hosted
// HostedStaticOnboardingState), from T3 Code (MIT, see LICENSE-T3).
use Snapshot from "./shapes.contract"
use ProjectMark from "./icons.contract"
use Icon from "./icons.contract"
use PgIcon from "./pages-icons.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"

shape HeroProject
  id: string
  name: string
  mark: string
  ink: string
  surface: string
  selected: bool
shape HeroName
  id: string
shape PagesHome
  landing: string
  headline: string
  projectName: string
  // r6-polish: the name keyed by its text, so a new name mounts a fresh text (a reused one-line text keeps drawing the old string).
  projectNames: list<HeroName>
  projects: list<HeroProject>
  noProjectItem: bool
  scratchLine: bool
  scratchDraft: bool
  noProjectsDescription: string
  scratchStart: bool
  savedEnvironments: number
  firstRunPending: bool
  pullRequests: bool
  // HostedStaticOnboardingState's second paragraph: the Local environment switched off, or the pairing hint.
  noEnvironmentDescription: string

// useNavigateBack's history over the utility pages (app.contract pageTrail, usage-and-pr-pages PG-7): the pages a
// page's Back goes back through after `current` opens `name`. A page opened from another keeps the one it left; one
// opened from a thread, or a thread, starts over.
fn pageTrailNext(trail: list<string>, current: string, name: string): list<string> = current == "" or name == "" ? [] : (name == current ? trail : concat(trail, [current]))

// The draft hero. The heading sits 16pt above the composer stack (pb-4,
// upstream 44b4965017), so the column ends 4pt above the composer column's
// 12pt top padding; with a shoulder tab (the stash badge) on the stack it
// sits on the tab (pb-0), 12pt into that padding.
component EmptyThread
  props
    data: Snapshot
    home: PagesHome
    scheme: string
    shoulder: bool
    busy: bool
    command: action
    addProject: action
  view
    column flex=1 min-height=0 width="100%" justify-content="flex-end" align-items="center" padding-left="1.25rem" padding-right="1.25rem" box-sizing="border-box" testId="empty-thread"
      when data.connected and data.threadId == "" and home.landing == ""
        column width="100%" max-width="64rem" padding-bottom=(shoulder ? "0px" : "0.25rem") margin-bottom=(shoulder ? "-0.75rem" : "0px") box-sizing="border-box" align-items="center" flex-shrink=0
          row width="100%" max-width="46rem" justify-content="center" flex-wrap="wrap" align-items="baseline" role="heading" aria-level=1 aria-label=(home.headline == "work" ? "What should we work on?" : home.headline == "build" ? `What should we build in ${home.projectName}?` : home.headline == "start" ? `${home.projectName} to start` : "Add a project to start") testId="draft-hero-heading"
            when home.headline == "work"
              text "What should we work on?" font-size="1.875rem" line-height="2.25rem" letter-spacing=-0.75 color="light-dark(#27272a, #f5f5f5)"
            when home.headline == "build"
              text "What should we build in " font-size="1.875rem" line-height="2.25rem" letter-spacing=-0.75 white-space="pre" color="light-dark(#27272a, #f5f5f5)"
              HeroPicker(home=home, scheme=scheme, small=false, command=command, addProject=addProject)
              text "?" font-size="1.875rem" line-height="2.25rem" letter-spacing=-0.75 color="light-dark(#27272a, #f5f5f5)"
            when home.headline == "start"
              HeroPicker(home=home, scheme=scheme, small=false, command=command, addProject=addProject)
              text " to start" font-size="1.875rem" line-height="2.25rem" letter-spacing=-0.75 white-space="pre" color="light-dark(#27272a, #f5f5f5)"
            when home.headline == "add"
              text "Add a project to start" font-size="1.875rem" line-height="2.25rem" letter-spacing=-0.75 color="light-dark(#27272a, #f5f5f5)"
          when home.noProjectItem
            row height="1.5rem" margin-top="0.5rem" align-items="center" justify-content="center"
              when home.scratchDraft
                HeroPicker(home=home, scheme=scheme, small=true, command=command, addProject=addProject)
              when home.scratchLine
                ScratchLink(busy=busy, command=command)

// "or start without a project": an InlineButton (tone muted, text-sm medium).
component ScratchLink
  props
    busy: bool
    command: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=command("pages:hero-scratch", "", "", 0) hover=hover disabled=busy testId="hero-start-without-project" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" position="relative"
      text "or start without a project" font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
      when over
        box position="absolute" left=0 right=0 top="1.0625rem" height=1 background-color="light-dark(#27272a, #f5f5f5)"

// InlineButton tone="picker": the project title with a dotted underline
// (decoration-foreground/30, 4pt offset) that turns solid on hover, and the
// menu centred under it, 4pt below (MenuPopup align="center").
component HeroPicker
  props
    home: PagesHome
    scheme: string
    small: bool
    command: action
    addProject: action
  state over = false
  action hover(value: bool)
    over = value
  // fix-keyboard-focus: Enter or Space opens the menu from the keyboard (menu-keys.contract).
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    column position="relative" flex-shrink=1 min-width=0 max-width="16rem"
      button popovertarget="hero-project-menu" key=triggerKey focus=keyArm(true) blur=keyArm(false) hover=hover testId="empty-choose-project" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="column" align-items="flex-start" max-width="16rem" position="relative"
        each name in home.projectNames key=name.id
          text name.id font-size=(small ? "0.875rem" : "1.875rem") line-height=(small ? "1.25rem" : "2.25rem") letter-spacing=(small ? "0px" : "-0.75px") font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 max-width="16rem"
        box position="absolute" left=0 right=0 top=(small ? "1.125rem" : "2.0625rem") height=(small ? "1px" : "2px") overflow="hidden"
          svg width="125rem" height=(small ? "1px" : "2px") viewBox=(small ? "0 0 2000 1" : "0 0 2000 2") aria-hidden=true
            path d=(small ? "M0 .5H2000" : "M0 1H2000") stroke=(scheme == "dark" ? (over ? "#f5f5f5" : "#f5f5f54d") : (over ? "#27272a" : "#27272a4d")) stroke-width=(small ? 1 : 2) stroke-dasharray=(over ? "none" : (small ? "1 1" : "2 2"))
      KeyMenuOpen(menuId="hero-project-menu", armed=keyArmed, opened=keyOpened)
      column id="hero-project-menu" popover="auto" position="absolute" left=0 right=0 top=0 padding-top="0.25rem" align-items="center" testId="hero-project-menu-layer"
        HeroMenu(home=home, scheme=scheme, keyed=keyed, command=command, addProject=addProject)

// MenuPopup (dropdown-glass, rounded-lg, max-h-80) with MenuRadioItem rows,
// a separator and the Add project MenuItem.
component HeroMenu
  props
    home: PagesHome
    scheme: string
    keyed: number
    command: action
    addProject: action
  state lit = ""
  // FX-2 (menu-keys.contract): the pointer entering a row focuses it; leaving the row that holds the focus hands it to the popup.
  action hover(id: string, rowId: string, over: bool)
    if over
      focus(`${rowId}-km`)
    else if lit == id
      focus("hero-project-keys")
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    column min-width="10rem" max-height="20rem" flex-shrink=0 box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" aria-label="Choose project" testId="hero-project-menu"
      KeyMenu(menuId="hero-project-keys", items=concat(concat((home.noProjectItem ? [KmItem(id="hero-project-none", label="No project")] : []), map(home.projects, (project) => KmItem(id=`hero-project-${project.id}`, label=project.name))), [KmItem(id="hero-add-project", label="Add project")]), keyed=keyed, gap="0px", modal=true)
        scroll width="100%" max-height="19.875rem" padding="0.25rem" box-sizing="border-box"
          column width="100%" role="group"
            when home.noProjectItem
              button id="hero-project-none" press=command("pages:hero-scratch", "", "", 0) popovertarget="hero-project-menu" popovertargetaction="hide" hover=hover("no-project", "hero-project-none") focus=focused("no-project", true) blur=focused("no-project", false) role="menuitemradio" aria-checked=home.scratchDraft testId="hero-project-none" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit == "no-project" ? "light-dark(#f4f4f5, #ffffff0a)" : home.scratchDraft ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
                PgIcon(name="message-square-dashed", size=16, color="light-dark(#4b5563, #9ca3af)")
                text "No project" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
            each project in home.projects key=project.id
              button id=`hero-project-${project.id}` press=command("pages:hero-project", project.id, "", 0) popovertarget="hero-project-menu" popovertargetaction="hide" hover=hover(project.id, `hero-project-${project.id}`) focus=focused(project.id, true) blur=focused(project.id, false) role="menuitemradio" aria-checked=project.selected aria-label=project.name testId=`hero-project-${project.id}` width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit == project.id ? "light-dark(#f4f4f5, #ffffff0a)" : project.selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
                ProjectMark(label=project.mark, muted=false, ink=project.ink, surface=project.surface, size=16)
                text project.name font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 white-space="nowrap" min-width=0 text-align="left"
          box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff0f)" role="separator"
          button id="hero-add-project" press=addProject popovertarget="hero-project-menu" popovertargetaction="hide" hover=hover("add-project", "hero-add-project") focus=focused("add-project", true) blur=focused("add-project", false) role="menuitem" testId="hero-add-project" width="100%" min-height="1.75rem" padding-left="0.375rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.375rem" border-radius="0.375rem" border-width=0 background-color=(lit == "add-project" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
            box opacity=0.8 display="flex"
              PgIcon(name="folder-plus", size=16, color="light-dark(#71717b, #818181)")
            text "Add project" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"

// The main column's empty routes, drawn over the conversation column: the
// desktop shell keeps a 52pt titlebar strip (WorkspacePageHeader) above an
// Empty state centred in the rest.
component PagesLanding
  inject
    rem: number
  props
    // desktop-shell-details: --workspace-controls-left (90 beside the traffic lights; 0.75rem in full screen).
    controlsLeft: number
    home: PagesHome
    scheme: string
    sidebarOpen: bool
    keySidebar: string
    busy: bool
    toggleSidebar: action
    command: action
    addProject: action
    openConnections: action
  view
    column position="absolute" left=0 top=0 right=0 bottom=0 background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`landing-${home.landing}`
      row height=52 flex-shrink=0 width="100%" padding-left=(sidebarOpen ? 1.25 * rem : controlsLeft + 2.5 * rem) padding-right="0.8125rem" box-sizing="border-box" align-items="center" gap="0.5rem" position="relative" border-bottom-width=(home.landing == "no-environment" or home.landing == "no-thread" ? 1 : 0) border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)"
        when not sidebarOpen
          button press=toggleSidebar position="absolute" left=(controlsLeft + 1) top="0.75rem" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Toggle sidebar" aria-keyshortcuts=keySidebar testId="toggle-sidebar"
            Icon(name="panel-left", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
        when home.landing == "no-environment"
          text "T3 Code" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b99, #81818199)"
        // composer-fidelity G15: NoActiveThreadState's desktop header.
        when home.landing == "no-thread"
          text "No active thread" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b80, #81818180)" testId="no-active-thread-header"
      column flex=1 min-height=0 width="100%" padding="3rem" box-sizing="border-box" align-items="center" justify-content="center"
        when home.landing == "no-projects"
          column width="100%" max-width="32rem" padding-left="2rem" padding-right="2rem" padding-top="3rem" padding-bottom="3rem" box-sizing="border-box" align-items="center"
            text "What should we work on?" font-size="1.875rem" line-height="2.25rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1
            text home.noProjectsDescription margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)"
            row margin-top="1.5rem" justify-content="center" gap="0.5rem"
              LandingButton(scheme=scheme, label="Add project", icon="plus", primary=true, busy=false, press=addProject, testId="landing-add-project")
              when home.scratchStart
                LandingButton(scheme=scheme, label="Start without a project", icon="message-square-dashed", primary=false, busy=busy, press=command("pages:hero-scratch", "", "", 0), testId="landing-start-without-project")
        when home.landing == "no-thread"
          column width="100%" max-width="32rem" padding-left="2rem" padding-right="2rem" padding-top="3rem" padding-bottom="3rem" box-sizing="border-box" align-items="center" testId="no-active-thread"
            text "Pick a thread to continue" font-size="1.25rem" line-height="1.75rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1
            text "Select an existing thread or create a new one to get started." margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)"
        when home.landing == "start-error"
          column width="100%" max-width="28rem" align-items="center"
            text "Couldn’t start a new thread" font-size="1.25rem" line-height="1.75rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1
            text "The project is still available. Try opening the draft again." margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)"
            row margin-top="1.25rem" justify-content="center"
              LandingButton(scheme=scheme, label="Try again", icon="refresh-cw", primary=true, busy=busy, press=command("pages:hero-retry", "", "", 0), testId="landing-try-again")
        when home.landing == "no-environment"
          column width="100%" max-width="36rem" padding-left="2rem" padding-right="2rem" padding-top="3rem" padding-bottom="3rem" box-sizing="border-box" border-radius="1.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e78c, #ffffff08)" background-color="light-dark(#ffffff33, #11111133)" box-shadow="0 1px 3px #0000000d, 0 1px 2px -1px #0000000d" align-items="center" testId="no-environment-card"
            box width="2.75rem" height="2.75rem" margin-bottom="1.25rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#fcfcfcb3, #0a0a0ab3)" display="flex" align-items="center" justify-content="center"
              PgIcon(name="link", size=20, color="light-dark(#71717b, #818181)")
            text "Connect to a computer running T3 Code" font-size="1.25rem" line-height="1.75rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1
            text "This app connects to T3 Code running on your computer or a server. Start the T3 Code desktop app or command-line server on that machine and keep it running." margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)"
            text home.noEnvironmentDescription margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)" testId="no-environment-description"
            row margin-top="1.5rem" justify-content="center"
              LandingButton(scheme=scheme, label="Open Connections", icon="plus", primary=true, busy=false, press=openConnections, testId="landing-open-connections")

// Button size="sm": 28pt, px 9, rounded-lg, a 16pt glyph 6pt from the label.
component LandingButton
  props
    scheme: string
    label: string
    icon: string
    primary: bool
    busy: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=busy testId=testId height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") background-color=(primary ? (over ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") : (over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff06)")) box-shadow=(primary ? (scheme == "dark" ? "inset 0 1px 0 #ffffff29, 0 1px 2px #346bf13d" : "inset 0 1px 0 #ffffff29, 0 1px 2px #1b4ed83d") : "0 1px 2px #0000000d") opacity=(busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
      PgIcon(name=icon, size=16, color=(primary ? "#ffffff" : "light-dark(#71717b, #818181)"))
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(primary ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")
