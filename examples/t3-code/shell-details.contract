// ThreadDetailsPanel / ThreadDetailsCard (MIT reference, see LICENSE-T3:
// chat/ThreadDetailsCard.tsx, threadDetailsCardLayout.ts, ThreadDetailsSection.tsx,
// threadDetailsPanelStyles.ts, BranchToolbar panel rows, OpenInPicker,
// ProjectScriptsControl, GitActionsControl, ThreadRelationshipsControl;
// upstream 429c625a85, 1b1e5b9674, bb7997709d, d3071275d5). One card, two
// placements: docked inline at the canvas's top right (280pt, 12pt in, open by
// default per thread) where a 640pt chat lane still fits beside it, else the
// header's popover (264pt inside its 8pt viewport, 60pt down, 13pt in). The
// dropdown-glass card has a 22pt radius and no shadow; rows are 32pt, 10pt
// radius, 13pt medium foreground/80 with a 16pt muted glyph; only Lineage keeps
// its 11pt heading.
use ShellDetails from "./shell-shapes.contract"
use ShellLineage from "./shell-shapes.contract"
use ShellEditor from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use ShellEditorIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use CnMachineIcon from "./settings-b-kit.contract"
use ProviderMark from "./icons.contract"
use R4GitRows from "./r4-git.contract"
use R4EnvRow from "./r4-git.contract"
use R6ScriptRow from "./r6-polish.contract"
use R6ScriptMenu from "./r6-polish.contract"
use ThreadAutomationsSection from "./thread-automations.contract"

// The popover presentation, with its click-away backdrop.
component ThreadDetailsPanel
  props
    details: ShellDetails
    right: number
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 z-index=50 testId="thread-details-layer"
      button press=act("toggle", "", "") aria-label="Close thread details" aria-keyshortcuts="Escape" testId="thread-details-backdrop" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000"
      column position="absolute" top=60 right=right width=264 max-height=maxHeight box-sizing="border-box" border-radius=22 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" overflow="hidden" role="dialog" aria-label="Thread details" testId="thread-details"
        DetailsBody(details=details, maxHeight=maxHeight, editorsOpen=editorsOpen, act=act, local=local, still=still)

// The inline presentation: an aside pinned 12pt from the canvas's top right, as tall as its content.
component ThreadDetailsInline
  props
    details: ShellDetails
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  view
    column position="absolute" top=64 right=12 width=280 max-height=maxHeight z-index=20 box-sizing="border-box" border-radius=22 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" overflow="hidden" role="complementary" aria-label="Thread details" testId="thread-details-inline"
      DetailsBody(details=details, maxHeight=maxHeight, editorsOpen=editorsOpen, act=act, local=local, still=still)

component DetailsBody
  props
    details: ShellDetails
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  state scriptsOpen = false
  action toggleScripts
    scriptsOpen = not scriptsOpen
  view
    scroll width="100%" min-height=0 max-height=(maxHeight - 2)
      // The content's full height, scrolled or not: the canvas keeps a floating player below it (chat-canvas-view.ts).
      column width="100%" position="relative" hook="t3-frame" data-frame="details-content"
        DetailsSection(title="Workspace", separated=false, heading=false)
          when details.envShow
            // BranchToolbarEnvironmentSelector: a Select for a draft with somewhere else to run, else its static label (lane r4-git).
            R4EnvRow(details=details, act=act)
          when details.envModeSelect
            // BranchToolbarEnvModeSelector as a select row (THREAD_DETAILS_PANEL_SELECT_ROW_CLASS): its value, the kind, a hairline and the chevron.
            box position="relative" width="100%"
              button popovertarget="details-workspace-menu" hover=hover("workspace") aria-label="Workspace" testId="details-workspace" width="100%" height=32 padding-left=11 padding-right=0 box-sizing="border-box" gap=10 border-width=0 border-radius=10 background-color=(hovered == "workspace" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
                ShellIcon(name=details.envIcon, size=16, color="light-dark(#71717b, #818181)")
                row flex=1 min-width=0 gap=6 align-items="center"
                  when details.folderName != ""
                    text details.folderName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=13 font-weight=500 line-height="19.5px" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-folder-name"
                  when details.folderLabel != ""
                    text details.folderLabel flex-shrink=0 font-size=10 line-height="14px" color="light-dark(#71717bb3, #818181b3)" testId="details-folder-kind"
                box width=32 height=32 position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
                  box position="absolute" left=-1 top=8 width=1 height=16 background-color="light-dark(#e4e4e7a6, #ffffff10)"
                  ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
              WorkspaceMenu(details=details, act=act)
          else
            row width="100%" height=32 padding-left=11 padding-right=11 box-sizing="border-box" gap=10 align-items="center" border-radius=10 testId="details-folder"
              box display="flex" flex-shrink=0
                ShellIcon(name=details.envIcon, size=16, color="light-dark(#71717b, #818181)")
              // Mounted with its name: a text first drawn empty here was never repainted once the panel loaded.
              row flex=1 min-width=0
                when details.folderName != ""
                  text details.folderName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size=13 font-weight=500 line-height="19.5px" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-folder-name"
              when details.folderLabel != ""
                text details.folderLabel flex-shrink=0 font-size=10 line-height="14px" color="light-dark(#71717bb3, #818181b3)" testId="details-folder-kind"
          when details.editorId != ""
            row height=32 align-items="center" border-radius=10 background-color=(hovered == "editor" or hovered == "editor-menu" or editorsOpen ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
              button press=act("shell:open-editor", details.cwd, details.editorId) hover=hover("editor") testId="details-open-editor" flex=1 min-width=0 height=32 padding-left=11 padding-right=10 box-sizing="border-box" gap=10 border-width=0 border-radius=10 background-color="#00000000" display="flex" flex-direction="row" align-items="center" disabled=(details.cwd == "")
                ShellEditorIcon(editor=details.editorId, size=16)
                text details.editorLabel flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=13 font-weight=500 line-height="19.5px" color="light-dark(#27272acc, #f5f5f5cc)"
              box width=1 height=16 flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
              button press=act("editors", "", "") hover=hover("editor-menu") aria-label="Choose editor" aria-expanded=editorsOpen testId="details-choose-editor" width=32 height=32 padding=0 border-width=0 border-radius=10 background-color=(editorsOpen or hovered == "editor-menu" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
          // r6-polish: a project with scripts shows its primary script as a split row (r6-polish.contract).
          when details.scriptName != ""
            R6ScriptRow(details=details, open=scriptsOpen, toggle=toggleScripts)
          else
            button press=act("ui:project-settings", "", "") hover=hover("script") testId="details-add-script" width="100%" height=32 padding-left=11 padding-right=11 box-sizing="border-box" gap=10 border-width=0 border-radius=10 background-color=(hovered == "script" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              box width=16 height=16 display="flex" align-items="center" justify-content="center" flex-shrink=0
                ShellIcon(name="plus", size=14, color="light-dark(#27272acc, #f5f5f5cc)")
              text "Add project script" flex=1 min-width=0 text-align="left" font-size=13 font-weight=500 line-height="19.5px" color="light-dark(#27272acc, #f5f5f5cc)"
        when details.cwd != ""
          DetailsSection(title="Version Control", separated=true, heading=false)
            // lane r4-git: the branch select, the split Git action (or Initialize Git) and Changes.
            R4GitRows(details=details, act=act, local=local)
            when details.error != ""
              text details.error padding-left=11 padding-right=11 font-size=11 line-height="16px" color="light-dark(#71717b, #818181)" testId="details-vcs-error"
        when details.automations.show
          ThreadAutomationsSection(automations=details.automations, still=still, act=act)
        when details.showLineage
          DetailsSection(title=details.lineageTitle, separated=true, heading=true)
            LineageGroups(details=details, act=act)
        // OpenInPicker's menu, 4pt under its row and as wide: drawn over the card (it paints last) with a
        // click-away layer under it, since a popover would anchor at the chevron rather than the row.
        when scriptsOpen and details.scriptName != ""
          R6ScriptMenu(details=details, top=(76 + (details.envShow ? 32 : 0) + (details.editorId != "" ? 32 : 0)), act=act, close=toggleScripts)
        when editorsOpen
          button press=act("editors", "", "") aria-label="Close editor menu" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="details-editors-backdrop"
          column position="absolute" left=8 right=8 top=(details.envShow ? 108 : 76) padding=4 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Open in" testId="details-editors"
            each editor in details.editors key=editor.id
              EditorOption(editor=editor, cwd=details.cwd, shortcut=details.editorShortcut, act=act)

// ThreadDetailsSection: px-2 pt-2 pb-2.5, a hairline above all but the first; the
// heading row is hidden for Workspace and Version Control (upstream 429c625a85).
component DetailsSection
  props
    title: string
    separated: bool
    heading: bool
  slot
  view
    column width="100%" padding-left=8 padding-right=8 padding-top=8 padding-bottom=10 box-sizing="border-box" border-top-style="solid" border-top-width=(separated ? 1 : 0) border-color="light-dark(#e4e4e7a6, #ffffff10)" role="region" aria-label=title
      when heading
        row min-height=32 margin-bottom=4 padding-left=6 padding-right=6 box-sizing="border-box" align-items="center"
          text title font-size=11 font-weight=500 line-height="16px" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)" role="heading" aria-level=3 testId="details-lineage-title"
      children

// ThreadLineageGroup ×3: related threads and active agents expanded, "Previous
// agents" folded behind a CollapsibleSectionHeader; each list shows 6 rows,
// then "Show N more" adds 12 at a time.
component LineageGroups
  props
    details: ShellDetails
    act: action
  state hovered = ""
  state relatedShown = 6
  state activeShown = 6
  state previousShown = 6
  state previousOpen = false
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action more(group: string)
    relatedShown = group == "related" ? relatedShown + 12 : relatedShown
    activeShown = group == "active" ? activeShown + 12 : activeShown
    previousShown = group == "previous" ? previousShown + 12 : previousShown
  action togglePrevious
    previousOpen = not previousOpen
  derive relatedCount = length(filter(details.lineage, (r) => r.group == "related"))
  derive activeCount = length(filter(details.lineage, (r) => r.group == "active"))
  view
    column width="100%" role="list" aria-label="Related threads"
      each row in details.lineage key=row.id
        when row.group == "related" and row.index < relatedShown
          LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
    when relatedCount > relatedShown
      ShowMore(count=min(relatedCount - relatedShown, 12), hovered=(hovered == "more-related"), hover=hover("more-related"), press=more("related"))
    when activeCount > 0
      column width="100%" role="list" aria-label="Related threads"
        each row in details.lineage key=row.id
          when row.group == "active" and row.index < activeShown
            LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
      when activeCount > activeShown
        ShowMore(count=min(activeCount - activeShown, 12), hovered=(hovered == "more-active"), hover=hover("more-active"), press=more("active"))
    when details.previousCount > 0
      button press=togglePrevious aria-expanded=previousOpen testId="details-previous-agents" width="100%" height=32 padding-left=8 padding-right=8 box-sizing="border-box" gap=8 border-width=0 border-radius=6 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        text (previousOpen ? "Previous agents" : `Previous agents (${details.previousCount})`) flex-shrink=0 font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b99, #81818199)"
        box height=1 min-width=8 flex=1 background-color="light-dark(#e4e4e799, #ffffff0a)"
        when details.previousFailed > 0
          text `${details.previousFailed} failed` flex-shrink=0 font-size=10 line-height="10px" color="light-dark(#c10007, #ff6467)"
        box display="flex" flex-shrink=0 rotate=(previousOpen ? 180 : 0)
          ShellIcon(name="chevron-down", size=12, color="light-dark(#71717b99, #81818199)")
      when previousOpen
        column width="100%" role="list" aria-label="Related threads"
          each row in details.lineage key=row.id
            when row.group == "previous" and row.index < previousShown
              LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
        when details.previousCount > previousShown
          ShowMore(count=min(details.previousCount - previousShown, 12), hovered=(hovered == "more-previous"), hover=hover("more-previous"), press=more("previous"))

component ShowMore
  props
    count: number
    hovered: bool
    hover: action
    press: action
  view
    button press=press hover=hover width="100%" height=32 padding-left=10 padding-right=10 box-sizing="border-box" gap=10 border-width=0 border-radius=10 background-color=(hovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      ShellIcon(name="plus", size=16, color=(hovered ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717bb3, #818181b3)"))
      text `Show ${count} more` font-size=14 font-weight=500 line-height="20px" color=(hovered ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717bb3, #818181b3)")

// One related thread: the relationship glyph (a subagent's provider mark) with
// its status badge, the title, then the agent's elapsed time or the hover
// arrow, then the status. The merge-back target is a split row whose second
// half merges this fork's latest finished run back into it.
component LineageRow
  props
    row: ShellLineage
    details: ShellDetails
    hovered: string
    hover: action
    act: action
  view
    row height=32 align-items="center" border-radius=10 role="listitem" background-color=(hovered == row.id or hovered == `merge-${row.id}` ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
      button press=act("select-thread", row.id, "") hover=hover(row.id) disabled=row.missing aria-label=`${row.title} ${row.status}` testId=`details-lineage-${row.id}` flex=1 min-width=0 height=32 padding-left=11 padding-right=(row.mergeTarget ? 10 : 11) box-sizing="border-box" gap=10 border-width=0 border-radius=10 border-top-right-radius=(row.mergeTarget ? 0 : 10) border-bottom-right-radius=(row.mergeTarget ? 0 : 10) background-color=(row.mergeTarget and hovered == row.id ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        box width=16 height=16 position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
          when row.driver != ""
            ProviderMark(driver=row.driver, size=16, color="light-dark(#71717b, #818181)")
          else
            ShellIcon(name=row.icon, size=16, color="light-dark(#71717b, #818181)")
          box position="absolute" right=-4 bottom=-4 width=8 height=8 box-sizing="border-box" border-radius=4 border-style="solid" border-width=2 border-color="light-dark(#ffffff, #111111)" background-color=row.dot
        text row.title flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=14 font-weight=500 line-height="16px" color="light-dark(#27272ad9, #f5f5f5d9)"
        when row.agent
          when row.elapsed != ""
            text row.elapsed flex-shrink=0 font-size=11 line-height="16px" color="light-dark(#71717b, #818181)"
        else
          box opacity=(hovered == row.id ? 1 : 0) display="flex" flex-shrink=0
            ShellIcon(name="arrow-right", size=12, color="light-dark(#71717b, #818181)")
        when not row.mergeTarget
          text row.status flex-shrink=0 font-size=11 line-height="16px" color="light-dark(#71717b, #818181)"
      when row.mergeTarget
        box width=1 height=16 flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
        box position="relative" flex-shrink=0 hover=hover(`merge-${row.id}`)
          button press=act("shell:merge-back", details.mergeSourceId, `${details.mergeTargetId}|${details.mergeRunId}`) disabled=(details.mergeRunId == "") aria-label=details.mergeLabel testId=`details-merge-${row.id}` width=32 height=32 padding=0 border-width=0 border-radius=10 border-top-left-radius=0 border-bottom-left-radius=0 opacity=(details.mergeRunId == "" ? 0.64 : 1) background-color=(hovered == `merge-${row.id}` and details.mergeRunId != "" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
            ShellIcon(name="git-merge", size=12, color="light-dark(#27272acc, #f5f5f5cc)")
          TipBubble(label=details.mergeHint, side="top", align="end", offset=36, inset=0, shown=(hovered == `merge-${row.id}`))
        text row.status flex-shrink=0 padding-left=4 padding-right=11 font-size=11 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"

// The workspace select's popup (SelectPopup alignItemWithTrigger=false, the trigger's width): a
// "Workspace" group label, then Current checkout (the folder's name), New worktree and the
// previous worktree; the current value is highlighted.
component WorkspaceMenu
  props
    details: ShellDetails
    act: action
  view
    // Popovers anchor at the invoker's bottom edge and ignore margins: the 4pt side offset is padding.
    column id="details-workspace-menu" popover="auto" position="absolute" padding-top=4 width=264 testId="details-workspace-menu"
      column width="100%" padding=4 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="listbox" aria-label="Workspace"
        text "Workspace" padding-left=8 padding-right=8 padding-top=6 padding-bottom=6 font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"
        WorkspaceOption(label="Current checkout", icon="folder", selected=(details.envMode == "local"), op="cclocal:env-mode", value="local", act=act)
        WorkspaceOption(label="New worktree", icon="folder-git-2", selected=(details.envMode == "worktree"), op="cclocal:env-mode", value="worktree", act=act)
        when details.previousLabel != ""
          WorkspaceOption(label=details.previousLabel, icon="folder-git", selected=false, op="cclocal:previous-worktree", value="", act=act)

component WorkspaceOption
  props
    label: string
    icon: string
    selected: bool
    op: string
    value: string
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=act(op, "", value) popovertarget="details-workspace-menu" popovertargetaction="hide" hover=hover role="option" aria-selected=selected testId=`details-workspace-${value == "" ? "previous" : value}` width="100%" min-height=29 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 box-sizing="border-box" gap=6 border-width=0 border-radius=6 background-color=(over or selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      ShellIcon(name=icon, size=12, color="light-dark(#71717b, #818181)")
      text label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=14 line-height="21px" color="light-dark(#18181b, #fafafa)"

// GitQuickActionIcon: a lucide glyph, or GitHub's mark for a pull request on GitHub.
component ActionIcon
  props
    name: string
  view
    when name == "github"
      svg width=16 height=16 viewBox="0 0 16 16" color="light-dark(#71717b, #818181)" fill="currentColor" flex-shrink=0 aria-hidden=true
        path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
    else
      ShellIcon(name=name, size=16, color="light-dark(#71717b, #818181)")

component EditorOption
  props
    editor: ShellEditor
    cwd: string
    shortcut: string
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=act("ui:editor", cwd, editor.id) hover=hover role="menuitem" testId=`details-editor-${editor.id}` width="100%" height=28 padding-left=8 padding-right=8 box-sizing="border-box" gap=8 border-width=0 border-radius=6 background-color=(over ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box margin-left=-2 margin-right=-2 display="flex" flex-shrink=0
        ShellEditorIcon(editor=editor.id, size=16)
      text editor.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
      when editor.selected and shortcut != ""
        text shortcut flex-shrink=0 font-size=12 font-weight=500 line-height="16px" letter-spacing="0.05em" color="light-dark(#71717b, #818181)"
