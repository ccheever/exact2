// ThreadDetailsPanel / ThreadDetailsCard (MIT reference, see LICENSE-T3:
// chat/ThreadDetailsCard.tsx, threadDetailsCardLayout.ts, ThreadDetailsSection.tsx,
// threadDetailsPanelStyles.ts, BranchToolbar panel rows, OpenInPicker,
// ProjectScriptsControl, GitActionsControl, ThreadRelationshipsControl;
// upstream 429c625a85, 1b1e5b9674, bb7997709d, d3071275d5). One card, two
// placements: docked inline at the canvas's top right (280pt, 12pt in, open by
// default per thread) where a 640pt chat lane still fits beside it, else the
// header's popover (264pt inside its 8pt viewport, 60pt down, 13pt in). The
// dropdown-glass card has a 22pt radius and no shadow; rows are 32pt, 10pt
// radius, 13pt medium foreground/80 with a 16pt muted glyph; only Lineage keeps
// its 11pt heading.
//
// Window z scale (1e2ecbd975, e19a48d220: popover variant="panel" sits at --z-sheet,
// below the floating preview player and every dialog). The reference: docked sheets
// 46, floating player 47-49, dialogs and other popovers 50 and up. Here: the inline
// card 20; right-panel sheets 10/11; menus with click-away backdrops 29-31; this
// popover 35; the floating device player 40; dialogs 40 and up (snooze, confirm,
// revert, plan save 40; device setup and media previews 45; palette and title menu
// 60; Git, pull request and checkout dialogs 72-82); toasts 100; table menu 130;
// tooltips 140. exact2: menus stay under the popover (they close on any outside
// press, so the two do not show together); the reference puts them over it.
use ShellDetails from "./shell-shapes.contract"
use ShellLineage from "./shell-shapes.contract"
use ShellEditor from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use ShellEditorIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use CnMachineIcon from "./settings-b-kit.contract"
use ProviderMark from "./icons.contract"
use R4GitRows from "./r4-git.contract"
use R4EnvRow from "./r4-git.contract"
use R6ScriptRow from "./r6-polish.contract"
use R6ScriptMenu from "./r6-polish.contract"
use ThreadAutomationsSection from "./thread-automations.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"

// The popover presentation, with its click-away backdrop.
component ThreadDetailsPanel
  props
    details: ShellDetails
    right: number
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 z-index=35 testId="thread-details-layer"
      button press=act("toggle", "", "") aria-label="Close thread details" aria-keyshortcuts="Escape" testId="thread-details-backdrop" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000"
      column position="absolute" top="3.75rem" right=right width="16.5rem" max-height=maxHeight box-sizing="border-box" border-radius="1.375rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" overflow="hidden" role="dialog" aria-label="Thread details" testId="thread-details"
        DetailsBody(details=details, maxHeight=maxHeight, editorsOpen=editorsOpen, act=act, local=local, still=still)

// The inline presentation: an aside pinned 12pt from the canvas's top right, as tall as its content.
component ThreadDetailsInline
  props
    details: ShellDetails
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  view
    column position="absolute" top="4rem" right="0.75rem" width="17.5rem" max-height=maxHeight z-index=20 box-sizing="border-box" border-radius="1.375rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" overflow="hidden" role="complementary" aria-label="Thread details" testId="thread-details-inline"
      DetailsBody(details=details, maxHeight=maxHeight, editorsOpen=editorsOpen, act=act, local=local, still=still)

component DetailsBody
  inject
    rem: number
  props
    details: ShellDetails
    maxHeight: number
    editorsOpen: bool
    act: action
    // chatLocal: the card's Git popups take keystrokes without the command gate (lane r4-git).
    local: action
    // prefers-reduced-motion: the running automation's dot stays still.
    still: bool
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  state scriptsOpen = false
  // fix-keyboard-focus: the script and editor menus take the focus as they open: the popup, or its first
  // item when Enter or Space opened it (menu-keys.contract).
  state menuByKey = false
  action menuKey(k: string)
    menuByKey = kmOpenKey(k)
  action toggleScripts
    scriptsOpen = not scriptsOpen
    if scriptsOpen
      focus(menuByKey ? "details-scripts-keys-first" : "details-scripts-keys")
    menuByKey = false
  action toggleEditors
    act("editors", "", "")
    if not editorsOpen
      focus(menuByKey ? "details-editors-keys-first" : "details-editors-keys")
    menuByKey = false
  view
    scroll width="100%" min-height=0 max-height=(maxHeight - 2)
      // The content's full height, scrolled or not: the canvas keeps a floating player below it (chat-canvas-view.ts).
      column width="100%" position="relative" hatch="t3-frame" data-frame="details-content"
        DetailsSection(title="Workspace", separated=false, heading=false)
          // server-update-banner: "Client and server versions differ" (ThreadDetailsPanel.tsx), dismissed with the composer's notice.
          when details.versionServer != ""
            row margin-left="0.25rem" margin-right="0.25rem" margin-bottom="0.5rem" padding="0.75rem" gap="0.5rem" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e171004d, #fe9a004d)" background-color="light-dark(#e171000f, #fe9a000f)" align-items="flex-start" testId="details-version-mismatch"
              box padding-top="0.125rem" flex-shrink=0 display="flex"
                ShellIcon(name="triangle-alert", size=14, color="light-dark(#e17100, #fe9a00)")
              column flex=1 min-width=0 gap="0.25rem"
                text "Client and server versions differ" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
                text `Client ${details.versionClient} · ${details.versionLabel} ${details.versionServer}` font-size="0.625rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="details-version-detail"
              button press=act("su:dismiss", "", "") aria-label="Dismiss version mismatch warning" testId="details-version-dismiss" width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                ShellIcon(name="x", size=14, color="light-dark(#71717b, #818181)")
          when details.envShow
            // BranchToolbarEnvironmentSelector: a Select for a draft with somewhere else to run, else its static label (lane r4-git).
            R4EnvRow(details=details, act=act)
          when details.envModeSelect
            // BranchToolbarEnvModeSelector as a select row (THREAD_DETAILS_PANEL_SELECT_ROW_CLASS): its value, the kind, a hairline and the chevron.
            box position="relative" width="100%"
              button popovertarget="details-workspace-menu" hover=hover("workspace") aria-label="Workspace" testId="details-workspace" width="100%" height="2rem" padding-left="0.6875rem" padding-right=0 box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color=(hovered == "workspace" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
                ShellIcon(name=details.envIcon, size=16, color="light-dark(#71717b, #818181)")
                row flex=1 min-width=0 gap="0.375rem" align-items="center"
                  when details.folderName != ""
                    text details.folderName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-folder-name"
                  when details.folderLabel != ""
                    text details.folderLabel flex-shrink=0 font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717bb3, #818181b3)" testId="details-folder-kind"
                box width="2rem" height="2rem" position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
                  box position="absolute" left=-1 top="0.5rem" width=1 height="1rem" background-color="light-dark(#e4e4e7a6, #ffffff10)"
                  ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
              WorkspaceMenu(details=details, act=act)
          else
            row width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" align-items="center" border-radius="0.625rem" testId="details-folder"
              box display="flex" flex-shrink=0
                ShellIcon(name=details.envIcon, size=16, color="light-dark(#71717b, #818181)")
              // Mounted with its name: a text first drawn empty here was never repainted once the panel loaded.
              row flex=1 min-width=0
                when details.folderName != ""
                  text details.folderName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-folder-name"
              when details.folderLabel != ""
                text details.folderLabel flex-shrink=0 font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717bb3, #818181b3)" testId="details-folder-kind"
          // OpenInPicker (panel form): shown for this machine, and for other machines unless they open locally (remote-open.ts).
          when details.editorShow
            row height="2rem" align-items="center" border-radius="0.625rem" background-color=(hovered == "editor" or hovered == "editor-menu" or editorsOpen ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
              button press=act("shell:open-editor", details.cwd, details.editorId) hover=hover("editor") testId="details-open-editor" flex=1 min-width=0 height="2rem" padding-left="0.6875rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" disabled=(details.cwd == "" or details.editorId == "" or details.editorUnavailable != "") opacity=(details.cwd == "" or details.editorId == "" or details.editorUnavailable != "" ? 0.64 : 1)
                when details.editorId != ""
                  ShellEditorIcon(editor=details.editorId, size=16)
                else
                  box width="1rem" height="1rem" flex-shrink=0
                text details.editorLabel flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)"
              box width=1 height="1rem" flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
              button press=toggleEditors key=menuKey hover=hover("editor-menu") aria-label="Choose editor" aria-expanded=editorsOpen testId="details-choose-editor" width="2rem" height="2rem" padding=0 border-width=0 border-radius="0.625rem" background-color=(editorsOpen or hovered == "editor-menu" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
          // r6-polish: a project with scripts shows its primary script as a split row (r6-polish.contract).
          when details.scriptName != ""
            R6ScriptRow(details=details, open=scriptsOpen, toggle=toggleScripts, toggleKey=menuKey, run=act("terminallocal:run-script", "", ""))
          else
            button press=act("ui:project-settings", "", "") hover=hover("script") testId="details-add-script" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color=(hovered == "script" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
                ShellIcon(name="plus", size=14, color="light-dark(#27272acc, #f5f5f5cc)")
              text "Add project script" flex=1 min-width=0 text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)"
        when details.cwd != ""
          DetailsSection(title="Version Control", separated=true, heading=false)
            // lane r4-git: the branch select, the split Git action (or Initialize Git) and Changes.
            R4GitRows(details=details, act=act, local=local)
            when details.error != ""
              text details.error padding-left="0.6875rem" padding-right="0.6875rem" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="details-vcs-error"
        when details.automations.show
          ThreadAutomationsSection(automations=details.automations, still=still, act=act)
        when details.showLineage
          DetailsSection(title=details.lineageTitle, separated=true, heading=true)
            LineageGroups(details=details, act=act)
        // OpenInPicker's menu, 4pt under its row and as wide: drawn over the card (it paints last) with a
        // click-away layer under it, since a popover would anchor at the chevron rather than the row.
        when scriptsOpen and details.scriptName != ""
          R6ScriptMenu(details=details, top=((76 + (details.envShow ? 32 : 0) + (details.editorShow ? 32 : 0)) * rem / 16), act=act, close=toggleScripts)
        when editorsOpen
          button press=act("editors", "", "") aria-label="Close editor menu" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="details-editors-backdrop"
          column position="absolute" left="0.5rem" right="0.5rem" top=(details.envShow ? "6.75rem" : "4.75rem") padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Open in" testId="details-editors"
            when details.editorUnavailable != ""
              DisabledEditorItem(label=details.editorUnavailable, testId="details-editor-no-route")
            when details.editorEmpty
              DisabledEditorItem(label="No installed editors found", testId="details-editor-none")
            KeyMenu(menuId="details-editors-keys", items=map(details.editors, (editor) => KmItem(id=`details-editor-${editor.id}`, label=editor.label)), keyed=0, gap="0px")
              each editor in details.editors key=editor.id
                EditorOption(editor=editor, cwd=details.cwd, shortcut=details.editorShortcut, act=act)
            when details.editorHint != ""
              DisabledEditorItem(label=details.editorHint, testId="details-editor-remote-hint")

// ThreadDetailsSection: px-2 pt-2 pb-2.5, a hairline above all but the first; the
// heading row is hidden for Workspace and Version Control (upstream 429c625a85).
component DetailsSection
  props
    title: string
    separated: bool
    heading: bool
  slot
  view
    column width="100%" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.5rem" padding-bottom="0.625rem" box-sizing="border-box" border-top-style="solid" border-top-width=(separated ? 1 : 0) border-color="light-dark(#e4e4e7a6, #ffffff10)" role="region" aria-label=title
      when heading
        row min-height="2rem" margin-bottom="0.25rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" align-items="center"
          text title font-size="0.6875rem" font-weight=500 line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)" role="heading" aria-level=3 testId="details-lineage-title"
      children

// ThreadLineageGroup ×3: related threads and active agents expanded, "Previous
// agents" folded behind a CollapsibleSectionHeader; each list shows 6 rows,
// then "Show N more" adds 12 at a time.
component LineageGroups
  props
    details: ShellDetails
    act: action
  state hovered = ""
  state relatedShown = 6
  state activeShown = 6
  state previousShown = 6
  state previousOpen = false
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action more(group: string)
    relatedShown = group == "related" ? relatedShown + 12 : relatedShown
    activeShown = group == "active" ? activeShown + 12 : activeShown
    previousShown = group == "previous" ? previousShown + 12 : previousShown
  action togglePrevious
    previousOpen = not previousOpen
  derive relatedCount = length(filter(details.lineage, (r) => r.group == "related"))
  derive activeCount = length(filter(details.lineage, (r) => r.group == "active"))
  view
    column width="100%" role="list" aria-label="Related threads"
      each row in details.lineage key=row.id
        when row.group == "related" and row.index < relatedShown
          LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
    when relatedCount > relatedShown
      ShowMore(count=min(relatedCount - relatedShown, 12), hovered=(hovered == "more-related"), hover=hover("more-related"), press=more("related"))
    when activeCount > 0
      column width="100%" role="list" aria-label="Related threads"
        each row in details.lineage key=row.id
          when row.group == "active" and row.index < activeShown
            LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
      when activeCount > activeShown
        ShowMore(count=min(activeCount - activeShown, 12), hovered=(hovered == "more-active"), hover=hover("more-active"), press=more("active"))
    when details.previousCount > 0
      button press=togglePrevious aria-expanded=previousOpen testId="details-previous-agents" width="100%" height="2rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        text (previousOpen ? "Previous agents" : `Previous agents (${details.previousCount})`) flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b99, #81818199)"
        box height=1 min-width="0.5rem" flex=1 background-color="light-dark(#e4e4e799, #ffffff0a)"
        when details.previousFailed > 0
          text `${details.previousFailed} failed` flex-shrink=0 font-size="0.625rem" line-height="0.625rem" color="light-dark(#c10007, #ff6467)"
        box display="flex" flex-shrink=0 rotate=(previousOpen ? 180 : 0)
          ShellIcon(name="chevron-down", size=12, color="light-dark(#71717b99, #81818199)")
      when previousOpen
        column width="100%" role="list" aria-label="Related threads"
          each row in details.lineage key=row.id
            when row.group == "previous" and row.index < previousShown
              LineageRow(row=row, details=details, hovered=hovered, hover=hover, act=act)
        when details.previousCount > previousShown
          ShowMore(count=min(details.previousCount - previousShown, 12), hovered=(hovered == "more-previous"), hover=hover("more-previous"), press=more("previous"))

component ShowMore
  props
    count: number
    hovered: bool
    hover: action
    press: action
  view
    button press=press hover=hover width="100%" height="2rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color=(hovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      ShellIcon(name="plus", size=16, color=(hovered ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717bb3, #818181b3)"))
      text `Show ${count} more` font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(hovered ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717bb3, #818181b3)")

// One related thread: the relationship glyph (a subagent's provider mark) with
// its status badge, the title, then the agent's elapsed time or the hover
// arrow, then the status. The merge-back target is a split row whose second
// half merges this fork's latest finished run back into it.
component LineageRow
  props
    row: ShellLineage
    details: ShellDetails
    hovered: string
    hover: action
    act: action
  view
    row height="2rem" align-items="center" border-radius="0.625rem" role="listitem" background-color=(hovered == row.id or hovered == `merge-${row.id}` ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
      button press=act("select-thread", row.id, "") hover=hover(row.id) disabled=row.missing aria-label=`${row.title} ${row.status}` testId=`details-lineage-${row.id}` flex=1 min-width=0 height="2rem" padding-left="0.6875rem" padding-right=(row.mergeTarget ? "0.625rem" : "0.6875rem") box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" border-top-right-radius=(row.mergeTarget ? "0px" : "0.625rem") border-bottom-right-radius=(row.mergeTarget ? "0px" : "0.625rem") background-color=(row.mergeTarget and hovered == row.id ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        box width="1rem" height="1rem" position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
          when row.driver != ""
            ProviderMark(driver=row.driver, size=16, color="light-dark(#71717b, #818181)")
          else
            ShellIcon(name=row.icon, size=16, color="light-dark(#71717b, #818181)")
          box position="absolute" right="-0.25rem" bottom="-0.25rem" width="0.5rem" height="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-style="solid" border-width=2 border-color="light-dark(#ffffff, #111111)" background-color=row.dot
        text row.title flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#27272ad9, #f5f5f5d9)"
        when row.agent
          when row.elapsed != ""
            text row.elapsed flex-shrink=0 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        else
          box opacity=(hovered == row.id ? 1 : 0) display="flex" flex-shrink=0
            ShellIcon(name="arrow-right", size=12, color="light-dark(#71717b, #818181)")
        when not row.mergeTarget
          text row.status flex-shrink=0 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      when row.mergeTarget
        box width=1 height="1rem" flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
        box position="relative" flex-shrink=0 hover=hover(`merge-${row.id}`)
          button press=act("shell:merge-back", details.mergeSourceId, `${details.mergeTargetId}|${details.mergeRunId}`) disabled=(details.mergeRunId == "") aria-label=details.mergeLabel testId=`details-merge-${row.id}` width="2rem" height="2rem" padding=0 border-width=0 border-radius="0.625rem" border-top-left-radius=0 border-bottom-left-radius=0 opacity=(details.mergeRunId == "" ? 0.64 : 1) background-color=(hovered == `merge-${row.id}` and details.mergeRunId != "" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
            ShellIcon(name="git-merge", size=12, color="light-dark(#27272acc, #f5f5f5cc)")
          TipBubble(label=details.mergeHint, side="top", align="end", offset=36, inset=0, shown=(hovered == `merge-${row.id}`))
        text row.status flex-shrink=0 padding-left="0.25rem" padding-right="0.6875rem" font-size="0.6875rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"

// The workspace select's popup (SelectPopup alignItemWithTrigger=false, the trigger's width): a
// "Workspace" group label, then Current checkout (the folder's name), New worktree and the
// previous worktree; the current value is highlighted.
component WorkspaceMenu
  props
    details: ShellDetails
    act: action
  view
    // Popovers anchor at the invoker's bottom edge and ignore margins: the 4pt side offset is padding.
    column id="details-workspace-menu" popover="auto" position="absolute" padding-top="0.25rem" width="16.5rem" testId="details-workspace-menu"
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="listbox" aria-label="Workspace"
        text "Workspace" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"
        WorkspaceOption(label="Current checkout", icon="folder", selected=(details.envMode == "local"), op="cclocal:env-mode", value="local", act=act)
        WorkspaceOption(label="New worktree", icon="folder-git-2", selected=(details.envMode == "worktree"), op="cclocal:env-mode", value="worktree", act=act)
        when details.previousLabel != ""
          WorkspaceOption(label=details.previousLabel, icon="folder-git", selected=false, op="cclocal:previous-worktree", value="", act=act)

component WorkspaceOption
  props
    label: string
    icon: string
    selected: bool
    op: string
    value: string
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=act(op, "", value) popovertarget="details-workspace-menu" popovertargetaction="hide" hover=hover role="option" aria-selected=selected testId=`details-workspace-${value == "" ? "previous" : value}` width="100%" min-height="1.8125rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.375rem" border-width=0 border-radius="0.375rem" background-color=(over or selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      ShellIcon(name=icon, size=12, color="light-dark(#71717b, #818181)")
      text label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.3125rem" color="light-dark(#18181b, #fafafa)"

// GitQuickActionIcon: a lucide glyph, or GitHub's mark for a pull request on GitHub.
component ActionIcon
  props
    name: string
  view
    when name == "github"
      svg width="1rem" height="1rem" viewBox="0 0 16 16" color="light-dark(#71717b, #818181)" fill="currentColor" flex-shrink=0 aria-hidden=true
        path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
    else
      ShellIcon(name=name, size=16, color="light-dark(#71717b, #818181)")

component EditorOption
  props
    editor: ShellEditor
    cwd: string
    shortcut: string
    act: action
  state over = false
  state lit = false
  action hover(value: bool)
    over = value
  action focused(on: bool)
    lit = on
  view
    button id=`details-editor-${editor.id}` press=act("ui:editor", cwd, editor.id) hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=`details-editor-${editor.id}` width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(over or lit ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box margin-left="-0.125rem" margin-right="-0.125rem" display="flex" flex-shrink=0
        ShellEditorIcon(editor=editor.id, size=16)
      text editor.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      when editor.selected and shortcut != ""
        text shortcut flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.05em" color="light-dark(#71717b, #818181)"

// A disabled MenuItem (opacity-64, no hover): OpenInPicker's "No SSH route to …", "No installed
// editors found" and the one-time "Opens over SSH. Needs your key on …".
component DisabledEditorItem
  props
    label: string
    testId: string
  view
    button disabled=true role="menuitem" testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=0.64 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
      text label flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
