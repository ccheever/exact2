// browser-surface part 1: a Browser tab's body (MIT reference, see LICENSE-T3, T3 Code 1e2ecbd975:
// apps/web/src/components/preview/PreviewView.tsx, PreviewChromeRow.tsx, PreviewMoreMenu.tsx,
// PreviewEmptyState.tsx, PreviewUnreachable.tsx; index.css `.preview-loading-progress`). The chrome row
// over the page, which is the module's `t3-browser` view (T3BrowserView.swift); the empty state for an idle
// tab; the load-failed page. `view` is browser-surface.ts `browserView`; `local` runs `surface-browser-<op>`.
// Annotate, Capture and Float preview are drawn disabled until part 3; the More menu's separate window waits
// for part 3. Part 2 adds the page area (browser-stage.contract: the device toolbar, the fitted viewport, the rails,
// the zoom pill), the More menu's device toolbar, appearance and zoom rows, the empty state's Recently used and Local
// servers, and the load-failed page's Details; part 4 made the More menu's Profile group's actions work.
// The reference's "Open DevTools" item is absent: Safari's Web Inspector attaches to the page in a
// development build instead, and cannot be opened from code (EXACT2-GAPS.md X1, X2).
use TipBubble from "./shell-tip.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use kmArrow from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"
use ShellSurface from "./shell-shapes.contract"
use BrowserPanel from "./browser-shapes.contract"
use BrowserProfileChoice from "./browser-shapes.contract"
use BrowserRecent from "./browser-shapes.contract"
use BrowserServer from "./browser-shapes.contract"
use BrowserStage from "./browser-stage.contract"

keyframes bsSpin
  from rotate=0
  to rotate=360
// .preview-loading-progress: scaleX 0.04 → 0.9 over 5.3 s from the left edge; here the full-width bar
// slides in from the left by the same fractions (a box scales about both axes only).
keyframes bsLoading
  from translate="-96% 0%"
  to translate="-10% 0%"

// Lucide 0.553 (ISC) glyphs the chrome draws, one path each.
fn bsPath(name: string): string = includes(["arrow-left", "arrow-right", "refresh-cw", "external-link", "mouse-pointer-click"], name) ? (name == "arrow-left" ? "M12 19l-7-7 7-7M19 12H5" : name == "arrow-right" ? "M5 12h14M12 5l7 7-7 7" : name == "refresh-cw" ? "M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5" : name == "external-link" ? "M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" : "M14 4.1 12 6M5.1 8l-2.9-.8M6 12l-1.9 2M7.2 2.2 8 5.1M9.037 9.69a.498.498 0 0 1 .653-.653l11 4.5a.5.5 0 0 1-.074.949l-4.349 1.041a1 1 0 0 0-.74.739l-1.04 4.35a.5.5 0 0 1-.95.074z") : includes(["camera", "picture-in-picture-2", "ellipsis-vertical", "minus", "plus"], name) ? (name == "camera" ? "M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4zM9 13a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" : name == "picture-in-picture-2" ? "M21 9V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10c0 1.1.9 2 2 2h4M14 13h6a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2h-6a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2Z" : name == "ellipsis-vertical" ? "M11 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M11 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M11 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" : name == "minus" ? "M5 12h14" : "M5 12h14M12 5v14") : includes(["rotate-ccw", "globe", "earth", "chevron-right", "history"], name) ? (name == "rotate-ccw" ? "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5" : name == "globe" ? "M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" : name == "earth" ? "M21.54 15H17a2 2 0 0 0-2 2v4.54M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0" : name == "chevron-right" ? "M9 18l6-6-6-6" : "M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5M12 7v5l4 2") : includes(["radio-tower", "x", "check"], name) ? (name == "radio-tower" ? "M4.9 16.1C1 12.2 1 5.8 4.9 1.9M7.8 4.7a6.14 6.14 0 0 0-.8 7.5M10 9a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M16.2 4.8c2 2 2.26 5.11.8 7.47M19.1 1.9a9.96 9.96 0 0 1 0 14.1M9.5 18h5M8 22l4-11 4 11" : name == "x" ? "M18 6 6 18M6 6l12 12" : "M20 6 9 17l-5-5") : ""

component BsIcon
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=bsPath(name)

// The surface, rebuilt per scheme so its SVG glyphs resolve light-dark().
component BrowserSurface
  props
    view: BrowserPanel
    scheme: string
    local: action
    urlFocus: action
    urlFocused: bool
  view
    when scheme == "dark"
      BrowserBody(view=view, local=local, urlFocus=urlFocus, urlFocused=urlFocused)
    else
      BrowserBody(view=view, local=local, urlFocus=urlFocus, urlFocused=urlFocused)

// PreviewView: the chrome row, then the page (or the empty state, or the load-failed page) below it.
component BrowserBody
  props
    view: BrowserPanel
    local: action
    urlFocus: action
    urlFocused: bool
  // The page area's size (the reference's surface rect): the layout of a fixed viewport, and the size the device
  // toolbar opens at.
  state pw = 0
  state ph = 0
  action measured(width: number, height: number)
    pw = width
    ph = height
  view
    column flex=1 min-height=0 width="100%" testId="browser-surface"
      // One chrome per tab: a draft typed in one tab's field never carries over to another.
      each tabKey in [view.tabId] key=tabKey
        BrowserChrome(view=view, local=local, urlFocus=urlFocus, pw=pw, ph=ph)
      box flex=1 min-height=0 position="relative" overflow="hidden" resize=measured
        // The page stays mounted under the load-failed page, as the reference's slot does (its keys keep working).
        when view.live or view.failed
          BrowserStage(view=view, pw=pw, ph=ph, urlFocused=urlFocused, local=local)
        when view.empty
          BrowserEmpty(view=view, local=local)
        when view.failed
          BrowserLoadFailed(view=view, local=local)

// PreviewChromeRow: 40pt, 8pt sides, 4pt gaps, a hairline under it; Back, Forward and Refresh, the
// address field, Annotate, Capture, Float preview and More, and the loading bar along its bottom edge.
component BrowserChrome
  inject
    still: bool
  props
    view: BrowserPanel
    local: action
    urlFocus: action
    pw: number
    ph: number
  state draft = ""
  state focused = false
  state touched = false
  state addressOver = false
  action addressHover(on: bool)
    addressOver = on
  // The field shows the page URL at rest and the draft while it has the focus; focusing it starts the draft
  // at the URL with all of it selected; Enter goes there; Escape puts the URL back and leaves the field.
  // While it has the focus, Escape is the field's, not the panel toggle's (SurfacePanel `urlFocused`). The focus
  // is view state: a command sent on focus or blur would let go of the navigation Enter just sent through the
  // same mutation. Text that arrives before the focus does (the agent's `type`) is kept as the draft.
  action focusField(on: bool)
    focused = on
    draft = on and not touched ? view.url : draft
    touched = on ? touched : false
    urlFocus(view.tabId, on)
    if on and not touched
      selectText("browser-url")
  action edit(text: string)
    draft = text
    touched = true
  action go
    if trim(draft) != ""
      local("surface-browser-navigate", view.tabId, draft)
      touched = false
      blur()
  action fieldKey(k: string)
    if k == "Escape"
      preventDefault()
      draft = view.url
      touched = false
      blur()
  view
    column position="relative" flex-shrink=0 width="100%"
      row height="2.5rem" flex-shrink=0 width="100%" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.25rem" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" testId="browser-chrome"
        row gap="0.125rem" align-items="center" flex-shrink=0 role="group" aria-label="Navigation"
          BsButton(icon="arrow-left", label="Back", tip="Back", disabled=(not view.canGoBack), pressed=false, spin=false, align="start", press=local("surface-browser-back", view.tabId, ""), testId="browser-back")
          BsButton(icon="arrow-right", label="Forward", tip="Forward", disabled=(not view.canGoForward), pressed=false, spin=false, align="center", press=local("surface-browser-forward", view.tabId, ""), testId="browser-forward")
          // The reference names the button Stop while a page loads, and pressing it reloads (PreviewManager.refresh).
          BsButton(icon="refresh-cw", label=(view.loading ? "Stop" : "Refresh"), tip=(view.loading ? "Loading…" : "Refresh"), disabled=view.refreshDisabled, pressed=false, spin=(view.loading and not still), align="center", press=local("surface-browser-refresh", view.tabId, ""), testId="browser-refresh")
        // leadingActions: the tab's profile, only when it is not the configured default (part 4), its name on hover.
        when view.showProfile
          BsProfileBadge(name=view.profileName)
        // InputGroup ghost (h-7): transparent until hovered (muted/40) or focused (the background and a ring).
        row flex=1 min-width=0 height="1.75rem" box-sizing="border-box" align-items="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(focused ? "light-dark(#a1a1aa, #71717a)" : "#00000000") box-shadow=(focused ? "0 0 0 3px light-dark(#a1a1aa3d, #71717a3d)" : "none") background-color=(focused ? "light-dark(#ffffff, #0a0a0a)" : addressOver ? "light-dark(#f4f4f566, #ffffff0a)" : "#00000000") hover=addressHover role="group" testId="browser-address"
          input id="browser-url" value=(focused or touched ? draft : view.url) input=edit submit=go key=fieldKey focus=focusField(true) blur=focusField(false) placeholder="Search or enter URL" aria-label="Search or enter URL" autocorrect="off" spellcheck="false" testId="browser-url" flex=1 min-width=0 height="1.625rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#27272a, #f5f5f5)"
          // Revealed on hover, so a resting address bar reads as plain text, and while it has the focus.
          when not focused
            BsRevealButton(shown=addressOver, press=local("surface-browser-external", view.tabId, ""))
        // Part 3 (browser-surface-capture): annotation, screenshots and recordings, and the floating preview.
        BsButton(icon="mouse-pointer-click", label="Annotate preview", tip="Annotate elements, regions, and drawings (part 3)", disabled=true, pressed=false, spin=false, align="end", press=local("surface-browser-noop", view.tabId, ""), testId="browser-annotate")
        BsButton(icon="camera", label="Capture screenshot", tip="Screenshot · Shift-click to record (part 3)", disabled=true, pressed=false, spin=false, align="end", press=local("surface-browser-noop", view.tabId, ""), testId="browser-capture")
        BsButton(icon="picture-in-picture-2", label="Float preview over chat", tip="Float preview over chat (part 3)", disabled=true, pressed=false, spin=false, align="end", press=local("surface-browser-noop", view.tabId, ""), testId="browser-float")
        BrowserMore(view=view, local=local, pw=pw, ph=ph)
      // The loading bar: 2pt, the primary colour, from the left edge; it stops moving with reduced motion.
      box position="absolute" left=0 right=0 bottom=0 height="0.125rem" overflow="hidden" pointer-events="none" aria-hidden=true
        box width="100%" height="100%" border-top-right-radius="624.9375rem" border-bottom-right-radius="624.9375rem" background-color="light-dark(#1b4ed8, #346bf1)" opacity=(view.loading ? 1 : 0) translate=(view.loading ? "-10% 0%" : "0% 0%") animation=(view.loading and not still ? "bsLoading 5.3s cubic-bezier(0.1, 0.5, 0.2, 1) forwards" : "none") transition=(still ? "none" : "translate 150ms ease-out, opacity 150ms ease-out 220ms") testId="browser-loading-bar"

// Button ghost icon-xs: 24pt, a 14pt glyph in the muted colour, the accent on hover, 64% when disabled,
// and its tooltip under it.
component BsButton
  props
    icon: string
    label: string
    tip: string
    disabled: bool
    pressed: bool
    spin: bool
    align: string
    press: action
    testId: string
  state over = false
  action hover(on: bool)
    over = on
  view
    box position="relative" flex-shrink=0 hover=hover
      button press=press disabled=disabled aria-label=label aria-pressed=pressed testId=testId width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" display="flex" flex-direction="row" align-items="center" justify-content="center" opacity=(disabled ? 0.64 : 1) background-color=((over and not disabled) or pressed ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        box display="flex" flex-shrink=0 animation=(spin ? "bsSpin 1s linear infinite" : "none")
          BsIcon(name=icon, size=14, color="light-dark(#71717b, #a1a1aa)")
      TipBubble(label=tip, side="bottom", align=align, offset=28, inset=0, shown=over)

// The address bar's Open in system browser (InputGroupAddon): transparent and untouchable at rest, shown while
// the address is hovered or the button has the focus (`focus-within:opacity-100`), so Tab never stops on an
// invisible button.
component BsRevealButton
  props
    shown: bool
    press: action
  state over = false
  state focused = false
  action hover(on: bool)
    over = on
  action focusOn(on: bool)
    focused = on
  view
    box position="relative" flex-shrink=0 margin-right="0.125rem" hover=hover opacity=(shown or focused ? 1 : 0) pointer-events=(shown or focused ? "auto" : "none")
      button press=press focus=focusOn(true) blur=focusOn(false) aria-label="Open in system browser" testId="browser-open-external" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        BsIcon(name="external-link", size=14, color="light-dark(#71717b, #a1a1aa)")
      TipBubble(label="Open in system browser", side="bottom", align="end", offset=28, inset=0, shown=over)

// PreviewMoreMenu: "More" (aria-label "Preview menu"), the menu end-aligned 6pt under it. Hard reload, Show or
// Hide device toolbar, Appearance (System, Light, Dark) and the Zoom row (its buttons keep the menu open) work;
// the rest is listed where the reference lists it and enabled by its own part. The reference menu is as wide as
// its longest row; 17.5rem holds "Open separate preview window" beside its part note.
component BrowserMore
  inject
    rem: number
  props
    view: BrowserPanel
    local: action
    pw: number
    ph: number
  state over = false
  state keyed = 0
  state keyArmed = false
  action hover(on: bool)
    over = on
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    column position="relative" flex-shrink=0 hover=hover
      button popovertarget="browser-more-menu" key=triggerKey focus=keyArm(true) blur=keyArm(false) aria-label="Preview menu" testId="browser-more" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        BsIcon(name="ellipsis-vertical", size=14, color="light-dark(#71717b, #a1a1aa)")
      KeyMenuOpen(menuId="browser-more-menu", armed=keyArmed, opened=keyOpened)
      TipBubble(label="More", side="bottom", align="end", offset=28, inset=0, shown=over)
      column id="browser-more-menu" popover="auto" position="absolute" margin-top="0.375rem" width="17.5rem" margin-left="-16rem"
        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Preview menu" testId="browser-more-popup"
          KeyMenu(menuId="browser-more-keys", items=(view.hasWebContents ? [KmItem(id="browser-more-hard-reload", label="Hard reload"), KmItem(id="browser-more-device-toolbar", label=(view.viewportMode != "fill" ? "Hide device toolbar" : "Show device toolbar")), KmItem(id="browser-more-appearance", label="Appearance"), KmItem(id="browser-more-clear-cookies", label="Clear cookies"), KmItem(id="browser-more-clear-cache", label="Clear cache")] : [KmItem(id="browser-more-clear-cookies", label="Clear cookies"), KmItem(id="browser-more-clear-cache", label="Clear cache")]), keyed=keyed, gap="0px", modal=true)
            BsMenuItem(id="browser-more-hard-reload", label="Hard reload", note="", chevron=false, disabled=(not view.hasWebContents), press=local("surface-browser-hard-reload", view.tabId, ""))
            BsMenuItem(id="browser-more-window", label="Open separate preview window", note="Part 3", chevron=false, disabled=true, press=local("surface-browser-noop", view.tabId, ""))
            BsMenuItem(id="browser-more-device-toolbar", label=(view.viewportMode != "fill" ? "Hide device toolbar" : "Show device toolbar"), note="", chevron=false, disabled=(not view.hasWebContents), press=local("surface-browser-device-toolbar", view.tabId, `${pw}|${ph}`))
            BrowserAppearanceItem(view=view, local=local)
            box width="100%" height=1 margin-top="0.25rem" margin-bottom="0.25rem" flex-shrink=0 background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
            // The zoom row: label, −, the level, +, reset; its buttons keep the menu open (closeOnClick false).
            row width="100%" height="2rem" padding-left="0.5rem" padding-right="0.25rem" box-sizing="border-box" align-items="center" justify-content="space-between" opacity=(view.hasWebContents ? 1 : 0.64) testId="browser-more-zoom"
              text "Zoom" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
              row align-items="center" gap="0.25rem"
                BsZoomButton(icon="minus", label="Zoom out", outlined=true, disabled=(not view.hasWebContents), press=local("surface-browser-zoom-out", view.tabId, ""), testId="browser-zoom-out")
                text view.zoomLabel min-width="3rem" text-align="center" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" testId="browser-zoom-level"
                BsZoomButton(icon="plus", label="Zoom in", outlined=true, disabled=(not view.hasWebContents), press=local("surface-browser-zoom-in", view.tabId, ""), testId="browser-zoom-in")
                BsZoomButton(icon="rotate-ccw", label="Reset zoom", outlined=false, disabled=(not view.hasWebContents), press=local("surface-browser-zoom-reset", view.tabId, ""), testId="browser-zoom-reset")
            box width="100%" height=1 margin-top="0.25rem" margin-bottom="0.25rem" flex-shrink=0 background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
            text `Profile: ${view.profileName}` max-width="16rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)" testId="browser-more-profile"
            // Part 4: this tab's environment and profile only (PreviewMoreMenu's Profile group).
            BsMenuItem(id="browser-more-clear-cookies", label="Clear cookies", note="", chevron=false, disabled=false, press=local("surface-browser-clear-cookies", view.tabId, ""))
            BsMenuItem(id="browser-more-clear-cache", label="Clear cache", note="", chevron=false, disabled=false, press=local("surface-browser-clear-cache", view.tabId, ""))

// MenuItem: 28pt, 8pt sides, the highlight on hover or focus; a disabled row at 64%.
component BsMenuItem
  props
    id: string
    label: string
    note: string
    chevron: bool
    disabled: bool
    press: action
  state hovered = false
  state lit = false
  action hover(on: bool)
    hovered = on
  action focused(on: bool)
    lit = on
  view
    button id=id press=press popovertarget="browser-more-menu" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role="menuitem" testId=id display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(disabled ? 0.64 : 1) background-color=((hovered or lit) and not disabled ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      text label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      when note != ""
        text note flex-shrink=0 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      when chevron
        BsIcon(name="chevron-right", size=14, color="light-dark(#71717b, #818181)")

component BsZoomButton
  props
    icon: string
    label: string
    outlined: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(on: bool)
    over = on
  view
    button press=press hover=hover disabled=disabled aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=(outlined ? 1 : 0) border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      BsIcon(name=icon, size=14, color="light-dark(#71717b, #a1a1aa)")

// The Appearance submenu (MenuSubTrigger, MenuRadioGroup): the row opens System, Light and Dark beside the menu
// (to its left: the menu sits at the panel's right edge); the checked one is the scheme pages are told to prefer.
// Choosing one keeps the menus open, as a Base UI radio item does.
component BrowserAppearanceItem
  props
    view: BrowserPanel
    local: action
  state hovered = false
  state lit = false
  action hover(on: bool)
    hovered = on
  action focused(on: bool)
    lit = on
  view
    box position="relative" width="100%"
      button id="browser-more-appearance" popovertarget="browser-appearance-menu" hover=hover focus=focused(true) blur=focused(false) disabled=(not view.hasWebContents) role="menuitem" aria-haspopup="menu" testId="browser-more-appearance" display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(view.hasWebContents ? 1 : 0.64) background-color=((hovered or lit) and view.hasWebContents ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
        text "Appearance" flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        BsIcon(name="chevron-right", size=14, color="light-dark(#71717b, #818181)")
