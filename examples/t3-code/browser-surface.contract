// PreviewUnreachable (LoadFailed): the error glyph, "This site can't be reached", the host and the error's
// words, the Details checklist (shown by the Details button, which then reads Hide details), the error's name,
// and Reload.
component BrowserLoadFailed
  props
    view: BrowserPanel
    local: action
  state over = false
  state detailsOver = false
  state showDetails = false
  action hover(on: bool)
    over = on
  action hoverDetails(on: bool)
    detailsOver = on
  action toggleDetails
    showDetails = not showDetails
  view
    scroll position="absolute" left=0 top=0 right=0 bottom=0 height="100%" z-index=10 background-color="light-dark(#fcfcfc, #0a0a0a)" testId="browser-failed"
      column width="100%" max-width="36rem" min-height="100%" padding-left="2rem" padding-right="2rem" padding-top="3rem" padding-bottom="3rem" box-sizing="border-box" align-self="center"
        svg width="3rem" height="3rem" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width=2.5 color="light-dark(#71717bb3, #818181b3)" margin-bottom="1.5rem" flex-shrink=0 aria-hidden=true
          path d="M16 12 L48 12 L48 52 L16 52 Z"
          path d="M22 22 L42 22 M22 30 L36 30 M22 38 L40 38" stroke-linecap="round"
          path d="M52 8 L12 56" stroke-linecap="round"
        text "This site can’t be reached" margin-bottom="0.75rem" font-size="1.5rem" line-height="1.875rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1 testId="browser-failed-title"
        text `${view.failHost}: ${view.failMessage}.` font-size="0.875rem" line-height="1.4375rem" color="light-dark(#71717b, #818181)" testId="browser-failed-text"
        when showDetails
          column margin-top="1.5rem" padding="1rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#f4f4f566, #ffffff0a)" testId="browser-failed-details"
            text "Try:" margin-bottom="0.5rem" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            column gap="0.25rem" role="list"
              BrowserTryRow(label="Checking your connection")
              BrowserTryRow(label="Confirming the dev server is running")
              BrowserTryRow(label="Checking the proxy and the firewall")
        text view.failLabel margin-top="2rem" font-size="0.75rem" line-height="1rem" letter-spacing="0.025rem" text-transform="uppercase" color="light-dark(#71717bb3, #818181b3)" testId="browser-failed-code"
        row flex=1 min-height="2rem" align-items="flex-end" gap="0.5rem" padding-top="2rem"
          button press=toggleDetails hover=hoverDetails aria-expanded=showDetails testId="browser-failed-details-toggle" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(detailsOver ? "light-dark(#f4f4f5, #ffffff0f)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center"
            text (showDetails ? "Hide details" : "Details") font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
          box flex=1
          button press=local("surface-browser-refresh", view.tabId, "") hover=hover testId="browser-failed-reload" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color=(over ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") box-shadow="inset 0 1px 0 #ffffff29" display="flex" flex-direction="row" align-items="center"
            text "Reload" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="#ffffff"

// RightPanelTabs PreviewFavicon: the captured icon, then the public favicon service, then the globe (Globe2,
// lucide's "earth"), the glyph showing until an image has loaded and again when every source fails.
component BrowserTabIcon
  props
    captured: string
    fallback: string
    size: number
    color: string
  state loaded = ""
  state failedCaptured = ""
  state failedFallback = ""
  derive source = captured != "" and failedCaptured != captured ? captured : (fallback != "" and failedFallback != fallback ? fallback : "")
  action didLoad
    loaded = source
  action didFail(message: string)
    failedCaptured = source == captured ? captured : failedCaptured
    failedFallback = source == fallback ? fallback : failedFallback
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 testId=(source == "" ? "browser-tab-globe" : loaded == source ? "browser-tab-favicon" : "browser-tab-favicon-loading")
      when loaded != source or source == ""
        BsIcon(name="earth", size=size, color=color)
      when source != ""
        image source width=`${size / 16}rem` height=`${size / 16}rem` object-fit="contain" border-radius="0.125rem" aria-hidden=true load=didLoad error=didFail position=(loaded == source ? "relative" : "absolute") left=0 top=0 visibility=(loaded == source ? "visible" : "hidden")

// The "+" menu's Browser row (RightPanelTabs MenuSubTrigger): the row opens a tab under the default profile;
// its chevron opens the profile list (part 4 fills it beyond Default). The reference opens that list on hover;
// a popover opened by hover has no Contract mechanism yet (X66, exact2 #319), so the chevron is pressed.
component BrowserAddItem
  props
    surface: ShellSurface
    profiles: list<BrowserProfileChoice>
    choose: action
    local: action
  state hovered = false
  state lit = false
  state chevronOver = false
  action hover(over: bool)
    hovered = over
  action focused(on: bool)
    lit = on
  action chevronHover(over: bool)
    chevronOver = over
  view
    box position="relative" width="100%" hover=hover
      button id="add-surface-browser" press=choose popovertarget="r4-add-surface" popovertargetaction="hide" focus=focused(true) blur=focused(false) role="menuitem" aria-label=`${surface.label} ${surface.shortcut}` aria-keyshortcuts=surface.shortcut aria-haspopup="menu" testId="add-surface-browser" display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="1.75rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(hovered or lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
        box width="1rem" height="1rem" flex-shrink=0 opacity=0.8
          BsIcon(name="earth", size=16, color="light-dark(#71717b, #818181)")
        text surface.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        text surface.shortcut flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.075rem" color="light-dark(#71717b, #818181)"
      button popovertarget="r4-browser-profiles" hover=chevronHover aria-label="Open browser in a profile" tabindex=-1 testId="add-surface-browser-profiles" position="absolute" right="0.125rem" top="0.125rem" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.375rem" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(chevronOver ? "light-dark(#27272914, #f5f5f514)" : "#00000000") title=""
        BsIcon(name="chevron-right", size=14, color="light-dark(#71717b, #818181)")
      column id="r4-browser-profiles" popover="auto" position="absolute" margin-top="-1.75rem" margin-left="11.75rem" width="10rem"
        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Browser profiles" testId="browser-profile-menu"
          each profile in profiles key=profile.id
            BrowserProfileItem(profile=profile, open=local("surface-browser-open", "", profile.id))

component BrowserProfileItem
  props
