      text name max-width="7rem" padding-left="0.375rem" padding-right="0.375rem" height="1.25rem" line-height="1.125rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" font-size="0.75rem" font-weight=500 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)" testId="browser-profile"
      TipBubble(label=name, side="top", align="start", offset=24, inset=0, shown=over)

// browser-surface part 4: the launcher's Browser row chevron (RightPanelEmptyState), shown with more than one profile:
// the row opens the default profile, the chevron the list (the same choice as the "+" menu's submenu).
component BrowserLauncherProfiles
  props
    profiles: list<BrowserProfileChoice>
    local: action
  state over = false
  state keyed = 0
  state keyArmed = false
  action hover(on: bool)
    over = on
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  // Base UI's menu trigger: Enter and Space open the list at its first item, ↓ and ↑ (KeyMenuOpen) at the first and
  // the last. The launcher (shell-panels.contract SurfaceLauncher) takes Enter only on itself and ignores a key the
  // menu handled (`handleKeyDown`: `event.target !== event.currentTarget`, `event.defaultPrevented`), so neither the
  // chevron's keys nor the list's Enter opens or moves the launcher's highlighted row.
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
    if k == "Enter" or kmArrow(k)
      stopPropagation()
  action listKey(k: string)
    if k == "Enter"
      stopPropagation()
  view
    box position="absolute" right="2rem" top="0.25rem" width="1.5rem" height="1.5rem"
      button popovertarget="launcher-browser-profiles" key=triggerKey focus=keyArm(true) blur=keyArm(false) hover=hover aria-label="Open browser in a profile" aria-haspopup="menu" testId="surface-browser-profiles" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.375rem" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over ? "light-dark(#27272914, #f5f5f514)" : "#00000000") title=""
        svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="light-dark(#71717b, #818181)" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="m6 9 6 6 6-6"
      KeyMenuOpen(menuId="launcher-browser-profiles", armed=keyArmed, opened=keyOpened)
      column id="launcher-browser-profiles" popover="auto" key=listKey position="absolute" position-area="bottom span-right" margin-top="0.375rem" margin-left="-12.5rem" width="14rem"
        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Browser profiles" testId="launcher-browser-profile-menu"
          KeyMenu(menuId="launcher-browser-profiles-keys", items=map(profiles, (profile) => KmItem(id=`launcher-browser-profile-${profile.id}`, label=profile.name)), keyed=keyed, gap="0px", modal=true)
            each profile in profiles key=profile.id
              BrowserLauncherProfileItem(profile=profile, open=local("surface-browser-open", "", profile.id))

component BrowserLauncherProfileItem
  props
    profile: BrowserProfileChoice
    open: action
  state hovered = false
  state lit = false
  action hover(over: bool)
    hovered = over
  action focused(on: bool)
    lit = on
  view
    button id=`launcher-browser-profile-${profile.id}` press=open popovertarget="launcher-browser-profiles" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=`launcher-browser-profile-${profile.id}` display="flex" flex-direction="row" align-items="center" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(hovered or lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      text profile.name flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// One of the checklist's list-disc rows: the bullet in the muted colour, then the advice.
component BrowserTryRow
  props
    label: string
  view
    row gap="0.5rem" padding-left="0.375rem" align-items="flex-start" role="listitem"
      text "•" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" aria-hidden=true
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
