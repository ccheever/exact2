    checked: bool
    press: action
  state lit = false
  action hover(on: bool)
    lit = on
  view
    button id=`browser-appearance-${id}` press=press hover=hover focus=hover(true) blur=hover(false) role="menuitemradio" aria-checked=checked testId=`browser-appearance-${id}` display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      box width="1rem" height="1rem" flex-shrink=0 display="flex" align-items="center" justify-content="center"
        when checked
          BsIcon(name="check", size=14, color="light-dark(#27272a, #f5f5f5)")
      text label flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// PreviewEmptyState: with nothing to recommend, the globe in the EmptyMedia icon card over its two fanned copies,
// "No preview yet" and the hint; else "Recently used" (at most 8, each removable) and "Local servers" (the live
// ones the server's scanner found, configured project preview URLs first), each a DiscoveryList.
component BrowserEmpty
  props
    view: BrowserPanel
    local: action
  view
    when length(view.recents) > 0 or length(view.servers) > 0
      scroll position="absolute" left=0 top=0 right=0 bottom=0 height="100%" testId="browser-empty-lists"
        column width="100%" max-width="36rem" padding-left="1.25rem" padding-right="1.25rem" padding-top="2rem" padding-bottom="2rem" gap="1.5rem" box-sizing="border-box" align-self="center"
          when length(view.recents) > 0
            column width="100%" gap="0.75rem" testId="browser-recents"
              row align-items="center" gap="0.5rem"
                BsIcon(name="history", size=16, color="light-dark(#71717b, #818181)")
                text "Recently used" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #818181)" role="heading" aria-level=2
              column width="100%" gap="1px" overflow="hidden" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#e4e4e799, #ffffff0f)"
                each entry in view.recents key=entry.url
                  BrowserRecentRow(entry=entry, open=local("surface-browser-open-url", view.tabId, entry.url), remove=local("surface-browser-remove-recent", view.tabId, entry.url))
          when length(view.servers) > 0
            column width="100%" gap="0.75rem" testId="browser-servers"
              row align-items="center" gap="0.5rem"
                BsIcon(name="radio-tower", size=16, color="light-dark(#71717b, #818181)")
                text "Local servers" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #818181)" role="heading" aria-level=2
              column width="100%" gap="1px" overflow="hidden" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#e4e4e799, #ffffff0f)"
                each server in view.servers key=server.key
                  BrowserServerRow(server=server, open=local("surface-browser-open-url", view.tabId, server.url))
              text "Select a live local server to open it in this browser tab." padding-left="0.25rem" padding-right="0.25rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="browser-servers-hint"
    else
      BrowserNothingYet()

// PreviewRecentUrlCard: the site's icon, its title (else its address) and the address with the visit's age; the
// remove button (×) shows while the row is hovered or the button has the focus.
component BrowserRecentRow
  props
    entry: BrowserRecent
    open: action
    remove: action
  state over = false
  state removeFocus = false
  state removeOver = false
  action hover(on: bool)
    over = on
  action focusRemove(on: bool)
    removeFocus = on
  action hoverRemove(on: bool)
    removeOver = on
  view
    box position="relative" width="100%" hover=hover testId="browser-recent"
      button press=open aria-label=entry.title testId="browser-recent-open" display="flex" flex-direction="row" align-items="center" gap="0.75rem" width="100%" padding-left="0.75rem" padding-right="2.5rem" padding-top="0.75rem" padding-bottom="0.75rem" box-sizing="border-box" border-width=0 border-radius=0 background-color=(over ? "light-dark(#f4f4f5, #171717)" : "light-dark(#fcfcfc, #0a0a0a)")
        BrowserTabIcon(captured=entry.favicon, fallback=entry.fallback, size=16, color="light-dark(#71717b, #818181)")
        column flex=1 min-width=0
          text entry.title white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" testId="browser-recent-title"
          text entry.subtitle white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="browser-recent-subtitle"
      button press=remove hover=hoverRemove focus=focusRemove(true) blur=focusRemove(false) aria-label=entry.removeLabel testId="browser-recent-remove" position="absolute" right="0.75rem" top="50%" translate="0% -50%" padding="0.25rem" border-width=0 border-radius="0.25rem" opacity=(over or removeFocus ? 1 : 0) background-color=(removeOver ? "light-dark(#f4f4f5, #ffffff14)" : "#00000000") display="flex" align-items="center" justify-content="center" title=""
        BsIcon(name="x", size=14, color=(removeOver ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

