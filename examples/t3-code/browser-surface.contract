      text profile.name flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// browser-surface part 4: the chrome row's profile badge (Badge outline, max 7rem, truncated) with its name in a tooltip.
component BsProfileBadge
  props
    name: string
  state over = false
