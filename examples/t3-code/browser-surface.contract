        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Appearance" testId="browser-appearance-popup"
          BrowserRadioItem(id="system", label="System", checked=(view.colorScheme == "system"), press=local("surface-browser-color-scheme", view.tabId, "system"))
          BrowserRadioItem(id="light", label="Light", checked=(view.colorScheme == "light"), press=local("surface-browser-color-scheme", view.tabId, "light"))
          BrowserRadioItem(id="dark", label="Dark", checked=(view.colorScheme == "dark"), press=local("surface-browser-color-scheme", view.tabId, "dark"))

component BrowserRadioItem
  props
