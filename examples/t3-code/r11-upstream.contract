// 737993303d: WorkEntryLogRow's Retry under a failed workspace preparation
// (ms-7 pb-1; Button size xs, variant outline, RotateCcwIcon).
component R11RetryPreparation
  props
    runId: string
    command: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row margin-left="1.75rem" padding-bottom="0.25rem"
      button press=command("chat:retry-preparation", "", runId, 0) hover=hover aria-label="Retry" testId=`retry-preparation-${runId}` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff1f)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" flex-shrink=0 display="flex" flex-direction="row" align-items="center" justify-content="center"
        box margin-left="-0.125rem" margin-right="-0.125rem" display="flex"
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="light-dark(#71717b, #a3a3a3)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5"
        text "Retry" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
