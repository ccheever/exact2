// The floating composer over a pull request (lane "pages"; pr-writing-and-metadata), measured
// against T3 Code 1e2ecbd975 (MIT, see LICENSE-T3) components/pullRequest/PullRequestComposer.tsx,
// PullRequestCommentForm.tsx and PullRequestReviewForm.tsx: one round button at the panel's
// bottom right (its label carries the pending line-comment count, the badge beside the icon is
// decorative) opening a popover above it, end-aligned, with two modes — a comment on the pull
// request (optionally the one that closes or reopens it) and a review (a summary and a verdict, sent
// with the line comments the Code tab collects). Each mode keeps its own draft across the toggle,
// closing the popover and a visit to another pull request (the drafts are kept by
// pages-pr-writes.ts; the box sends its words there when it loses the focus). A posted comment or
// a submitted review closes the popover: the popover is rebuilt when the write's serial arrives.
use PgIcon from "./pages-icons.contract"
use PrmIcon from "./pages-pr-meta.contract"
use PrPicker from "./pages-pr-meta.contract"
use PrReactionChoice from "./pages-pr-meta.contract"
use PrdSegment from "./pages-pr-edit.contract"
use PrdSmallButton from "./pages-pr-edit.contract"

shape PrWrites
  key: string
  composer: bool
  canComment: bool
  verdicts: list<string>
  followUp: string
  commentDraft: string
  summary: string
  summaryRequired: bool
  pendingCount: number
  submitting: string
  actionPending: bool
  reviewPending: bool
  closeSerial: number
  commentSerial: number
  reviewSerial: number
  canEditChange: bool
  rawBody: string
  titleSaving: bool
  titleSerial: number
  bodySaving: bool
  bodySerial: number
  reactionChoices: list<PrReactionChoice>
  reviewers: PrPicker
  labels: PrPicker

fn prcMuted(): string = "light-dark(#71717b, #818181)"
fn prcInk(): string = "light-dark(#27272a, #f5f5f5)"
fn prcVerdictLabel(verdict: string): string = verdict == "approve" ? "Approve" : verdict == "request-changes" ? "Request changes" : "Comment"
// canSubmit: an approval may be empty; the rest need a summary or a pending line comment, and a
// request for changes needs a summary where the host requires one (Forgejo).
fn prcCanSubmit(verdict: string, summary: string, pending: number, required: bool): bool = verdict == "request-changes" and required ? trim(summary) != "" : (verdict == "approve" or trim(summary) != "" or pending > 0)

component PrdComposer
  props
    writes: PrWrites
    selected: string
    scope: string
    act: action
    local: action
  state mode = "comment"
  state verdict = "comment"
  // The drafts as typed, and the write serial each was typed against: a write that landed clears
  // the words it sent (a summary revised while the review was out is kept, as clearSummary keeps it).
  state commentText = writes.commentDraft
  state commentSeen = writes.commentSerial
  state summaryText = writes.summary
  state summarySeen = writes.reviewSerial
  state summarySent = ""
  derive comment = commentSeen == writes.commentSerial ? commentText : ""
  derive summary = summarySeen != writes.reviewSerial and summaryText == summarySent ? "" : summaryText
  derive reviewStarted = writes.pendingCount > 0 or trim(summary) != ""
  derive both = writes.canComment and length(writes.verdicts) > 0
  derive shownMode = writes.canComment ? (length(writes.verdicts) == 0 ? "comment" : mode) : "review"
  derive chosen = includes(writes.verdicts, verdict) ? verdict : join(slice(writes.verdicts, 0, 1), "")
  // A header action out (merge, close...) holds the comment form too, as the reference's isActionPending does.
  derive locked = writes.submitting != "" or writes.actionPending
  derive popId = `${scope}-composer`
  // Opening picks the mode with work waiting in it.
  action opening
    mode = reviewStarted ? "review" : "comment"
  action pick(value: string)
    mode = value
  action editComment(text: string)
    commentText = text
    commentSeen = writes.commentSerial
  // Kept beside the writes' one-at-a-time route, so the blur a press on Comment causes never holds that press back.
  action keepComment(text: string)
    local("prw-draft-comment", selected, text)
  action editSummary(text: string)
    summaryText = text
    summarySeen = writes.reviewSerial
  action keepSummary(text: string)
    local("prw-draft-summary", selected, text)
  action chooseVerdict(value: string)
    verdict = value
  // Closing keeps the shown draft (the box also keeps it whenever it loses the focus).
  action closing
    if shownMode == "review"
      local("prw-draft-summary", selected, summary)
    else
      local("prw-draft-comment", selected, comment)
  action post(kind: string)
    if trim(comment) != "" and not locked
      act(kind == "comment" ? "post-comment" : `comment-${kind}`, comment)
  action commentKeys(k: string, e: KeyboardEvent)
    if k == "Enter" and (e.metaKey or e.ctrlKey) and not e.shiftKey and not e.altKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        post("comment")
  action submitReview
    let text = summary
    let payload = `${chosen}|${text}`
    if not writes.reviewPending and chosen != "" and prcCanSubmit(chosen, text, writes.pendingCount, writes.summaryRequired)
      summarySent = text
      summarySeen = writes.reviewSerial
      act("review", payload)
  view
    column position="relative" testId=`${scope}-composer-anchor`
      PrdComposerTrigger(popId=popId, count=writes.pendingCount, label=(writes.pendingCount > 0 ? `Review pull request, ${writes.pendingCount} ${writes.pendingCount == 1 ? "comment" : "comments"} pending` : (reviewStarted or not writes.canComment ? "Review pull request" : "Comment on pull request")), press=opening)
      // Rebuilt (so closed) once a comment is posted or a review submitted.
      each closeKey in [writes.closeSerial] key=closeKey
        // PopoverPopup side="top" align="end" sideOffset=8 width="lg": the transparent tail lets the
        // window's edge push the card back over the trigger's right edge (X17: no `span-left` area).
        row id=popId popover="auto" position="absolute" position-area="top span-right" padding-bottom="0.5rem" align-items="flex-end" testId=`${scope}-composer-layer`
          column width="24rem" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label="Pull request composer" testId="pull-request-composer"
            row width="100%" margin-bottom="0.75rem" align-items="center" justify-content="space-between" gap="0.5rem"
              when both
                row padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="group" aria-label="Composer mode"
                  PrdSegment(label="Comment", pressed=(shownMode == "comment"), disabled=false, press=pick("comment"), testId="pull-request-composer-mode-comment")
                  PrdSegment(label=(writes.pendingCount > 0 ? `Review (${writes.pendingCount})` : "Review"), pressed=(shownMode == "review"), disabled=false, press=pick("review"), testId="pull-request-composer-mode-review")
              else
                text (shownMode == "review" ? "Review pull request" : "Comment on pull request") font-size="0.875rem" line-height="1rem" font-weight=600 color=prcInk() role="heading" aria-level=2
              row align-items="center" gap="0.25rem"
                when shownMode == "review" and writes.pendingCount > 0
                  PrdComposerIcon(icon="trash-2", label="Discard pending line comments", popId="", disabled=writes.reviewPending, press=act("discard-pending", ""), testId="pull-request-composer-discard")
                PrdComposerIcon(icon="x", label="Close composer", popId=popId, disabled=false, press=closing, testId="pull-request-composer-close")
            // Both forms stay mounted across the toggle, so their drafts and in-flight guards survive.
            when length(writes.verdicts) > 0
              column width="100%" display=(shownMode == "review" ? "flex" : "none") testId="pull-request-review-form"
                textarea value=summary input=editSummary change=keepSummary autofocus=(shownMode == "review") rows=3 placeholder=(writes.summaryRequired and includes(writes.verdicts, "request-changes") ? "Summarize your review (required to request changes)" : "Summarize your review (optional)") aria-label="Review summary" autocorrect="off" spellcheck="false" testId="pull-request-review-summary" width="100%" min-height="4.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=prcInk()
                row width="100%" margin-top="0.5rem" justify-content="space-between" align-items="center" gap="0.5rem"
                  select value=chosen change=chooseVerdict disabled=writes.reviewPending aria-label="Review verdict" testId="pull-request-review-verdict" height="1.5rem" font-size="0.75rem"
                    each choice in writes.verdicts key=choice
                      option prcVerdictLabel(choice) value=choice
                  PrdSmallButton(label=(writes.reviewPending ? "Submitting..." : "Submit review"), icon="", tone="primary", disabled=(writes.reviewPending or chosen == "" or not prcCanSubmit(chosen, summary, writes.pendingCount, writes.summaryRequired)), press=submitReview, testId="pull-request-review-submit")
            when writes.canComment
              column width="100%" gap="0.5rem" display=(shownMode == "comment" ? "flex" : "none") testId="pull-request-comment-form"
                // Locked while posting: the box is cleared on success, which would throw away words typed meanwhile.
                textarea value=comment input=editComment change=keepComment key=commentKeys autofocus=(shownMode == "comment") disabled=locked rows=3 placeholder="Leave a comment" aria-label="Comment on this pull request" autocorrect="off" spellcheck="false" testId="pull-request-comment-text" width="100%" min-height="4.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=prcInk() opacity=(locked ? 0.64 : 1)
                row width="100%" flex-wrap="wrap" justify-content="flex-end" gap="0.5rem"
                  when writes.followUp == "close"
                    PrdSmallButton(label=(writes.submitting == "close" ? "Closing..." : "Close with comment"), icon="git-pull-request-closed", tone="destructive", disabled=(trim(comment) == "" or locked), press=post("close"), testId="pull-request-comment-close")
                  when writes.followUp == "reopen"
                    PrdSmallButton(label=(writes.submitting == "reopen" ? "Reopening..." : "Reopen with comment"), icon="git-pull-request-arrow", tone="outline", disabled=(trim(comment) == "" or locked), press=post("reopen"), testId="pull-request-comment-reopen")
                  PrdSendButton(label=(writes.submitting == "comment" ? "Posting..." : "Comment"), disabled=(trim(comment) == "" or locked), press=post("comment"))
          box width="1rem" height=1 flex-shrink=0

// Button size="icon" variant="glass": the 32pt round trigger and its pending-count badge.
component PrdComposerTrigger
  props
    popId: string
    count: number
    label: string
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press popovertarget=popId hover=hover aria-label=label testId="pull-request-composer-trigger" position="relative" width="2rem" height="2rem" padding=0 border-radius="624.9375rem" border-width=1 border-style="solid" border-color=(over ? "light-dark(#e4e4e7, #ffffff1a)" : "light-dark(#e4e4e799, #ffffff0f)") background-color="light-dark(#ffffffe6, #0a0a0ae6)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center"
      PgIcon(name="message-square", size=16, color=prcInk())
      when count > 0
        text `${count}` position="absolute" top="-0.25rem" right="-0.25rem" min-width="0.875rem" height="0.875rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="624.9375rem" background-color="light-dark(#2563eb, #3b82f6)" font-size="0.5625rem" line-height="0.875rem" font-weight=600 font-variant-numeric="tabular-nums" text-align="center" color="#ffffff" aria-hidden=true testId="pull-request-composer-badge"

// Button size="icon-xs" variant="ghost": the header's discard and close.
component PrdComposerIcon
  props
    icon: string
    label: string
    popId: string
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    when popId != ""
      button press=press popovertarget=popId popovertargetaction="hide" hover=hover aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" align-items="center" justify-content="center"
        PrmIcon(name=icon, size=14, color=prcMuted())
    else
      button press=press hover=hover disabled=disabled aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(disabled ? 0.64 : 1) background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" align-items="center" justify-content="center"
        PrmIcon(name=icon, size=14, color=prcMuted())

// The Comment button: outline, the send glyph.
component PrdSendButton
  props
    label: string
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId="pull-request-comment-submit" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
      PrmIcon(name="send", size=14, color=prcMuted())
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=prcInk()
