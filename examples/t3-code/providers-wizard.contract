use PvField from "./providers-kit.contract"
use PvOutline from "./providers-kit.contract"
use PvGhost from "./providers-kit.contract"
use PvPrimary from "./providers-kit.contract"
use PvIconButton from "./providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use DriverMark from "./provider-icons.contract"
use AcpRegistryAgentIcon from "./provider-icons.contract"
use ProviderOption from "./providers.contract"
use ProviderHub from "./providers.contract"
use ProviderMark from "./icons.contract"
use ProviderWizardAuth from "./providers-setup.contract"
use ProviderWizardAuthStep from "./providers-setup.contract"
use AppConfirm from "./shell-panels.contract"
use ChatGptDialogSetup from "./codex-setup.contract"
use CodexPicker from "./codex-setup.contract"
use ChatGptAccountSetup from "./codex-setup.contract"

shape WizardDriver
  id: string
  label: string
  selected: bool
shape WizardField
  rowKey: string
  key: string
  first: bool
  index: number
  label: string
  description: string
  placeholder: string
  control: string
  value: string
  redacted: bool
  clearable: bool
  options: list<ProviderOption>
shape WizardSession
  key: string
shape AcpAgent
  id: string
  name: string
  description: string
  link: string
  icon: string
  iconUrl: string
  version: string
  distribution: string
  added: bool
shape ProviderWizard
  sessions: list<WizardSession>
  drivers: list<WizardDriver>
  driver: string
  driverLabel: string
  label: string
  instanceId: string
  idError: string
  preview: string
  idPlaceholder: string
  fields: list<WizardField>
  environment: string
  prepared: list<AcpAgent>
  created: string
  auth: list<ProviderWizardAuth>
  chatgpt: list<ChatGptDialogSetup>
  chatgptConnected: bool
  codexPicker: list<CodexPicker>
shape AcpRegistry
  ready: bool
  status: string
  error: string
  agents: list<AcpAgent>

// One step pill of WizardSteps (ui/wizard.tsx).
component WizardStep
  props
    number: number
    title: string
    summary: string
    current: number
    disabled: bool
    go: action
  view
    button press=go("step", `${number}`) disabled=disabled flex=1 min-width=0 height="2.25rem" box-sizing="border-box" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="0.5rem" border-radius="0.625rem" border-width=(current == number ? 1 : 0) border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" background-color=(current == number ? "light-dark(#ffffff, #111111)" : "#00000000") box-shadow=(current == number ? "0 1px 2px #0000000d" : "none") aria-label=(summary == "" ? `${title}, step ${number + 1}` : `${title}, step ${number + 1}, ${summary}`) testId=`wizard-step-${number}`
      box width="1.25rem" height="1.25rem" border-radius="624.9375rem" flex-shrink=0 display="flex" align-items="center" justify-content="center" box-sizing="border-box" border-style="solid" border-width=1 border-color=(current > number ? "light-dark(#1b4ed8, #346bf1)" : (current == number ? "light-dark(#1b4ed84d, #346bf14d)" : "light-dark(#0000001a, #ffffff1a)")) background-color=(current > number ? "light-dark(#1b4ed8, #346bf1)" : (current == number ? "light-dark(#1d4ed81a, #316cf51a)" : "light-dark(#ffffff, #ffffff0d)"))
        when current > number
          PvIcon(name="check", size=14, color="#ffffff")
        else
          text `${number + 1}` font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(current == number ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b, #818181)")
      text title font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(current == number ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// AddProviderInstanceDialog.tsx: Provider → Identity → Config, or the ACP
// Registry's Provider → Identity → Sign in. Config drafts are row state, so
// every opening starts empty.
component AddProviderDialog
  inject
    rem: number
  props
    wizard: ProviderWizard
    acp: AcpRegistry
    step: number
    attempted: bool
    labelSet: bool
    label: string
    idSet: bool
    id: string
    query: string
    manual: bool
    viewportHeight: number
    scheme: string
    busy: bool
    setupBusy: bool
    error: string
    ui: action
    add: action
    op: action
  state f0 = ""
  state f1 = ""
  state f2 = ""
  state f3 = ""
  state f4 = ""
  state accentOpen = false
  state accent = ""
  state signOutOpen = false
  action askSignOut
    signOutOpen = true
  action confirmSignOut
    signOutOpen = false
    op("setup:auth-logout", wizard.created, "", "", true)
  action cancelSignOut
    signOutOpen = false
    focus(`wizard-provider-sign-out-${wizard.created}`)
  action setField(index: number, value: string)
    if index == 0
      f0 = value
    if index == 1
      f1 = value
    if index == 2
      f2 = value
    if index == 3
      f3 = value
    if index == 4
      f4 = value
  action toggleAccent
    accentOpen = not accentOpen
    accent = accent == "" ? "#2563eb" : accent
  action editAccent(value: string)
    accent = value
  action clearAccent
    accent = ""
    accentOpen = false
  derive isAcp = wizard.driver == "acpRegistry"
  derive shownLabel = labelSet ? label : wizard.label
  derive shownId = idSet ? id : wizard.instanceId
  derive lastStep = isAcp ? 1 : 2
  // Once an ACP instance is created the wizard is on its Sign in step (AddProviderInstanceDialog setWizardStep(2)).
  derive shownStep = wizard.created != "" ? 2 : step
  view
    column class=PvOverlay testId="add-provider-overlay"
      column width="100%" max-width="48rem" max-height=(viewportHeight - 2 * rem) box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" position="relative" overflow="hidden" role="dialog" aria-label="Add provider" testId="add-provider-dialog"
        column width="100%" box-sizing="border-box" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" gap="0.5rem" flex-shrink=0
          text "Add provider" font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text `Add an account or configure a provider on ${wizard.environment}.` font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
          row width="100%" height="2.75rem" box-sizing="border-box" padding="0.25rem" gap="0.25rem" border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfc, #ffffff0a)" role="list" aria-label="Setup progress"
            WizardStep(number=0, title="Provider", summary=(shownStep > 0 ? (isAcp ? wizard.label : wizard.driverLabel) : ""), current=shownStep, disabled=(wizard.created != ""), go=ui)
            WizardStep(number=1, title="Identity", summary=(shownStep > 1 ? wizard.preview : ""), current=shownStep, disabled=(wizard.created != ""), go=ui)
            WizardStep(number=2, title=(isAcp ? "Sign in" : "Config"), summary="", current=shownStep, disabled=(wizard.created != ""), go=ui)
        scroll width="100%" flex=1 min-height=0 box-sizing="border-box" border-top-style="solid" border-top-width=1 border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfccc, #ffffff05)" testId="add-provider-panel"
          column width="100%" box-sizing="border-box" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" gap=0
            when shownStep == 0
              column width="100%" gap="0.5rem"
                text "Provider" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                row width="100%" gap="0.75rem" flex-wrap="wrap" role="radiogroup" aria-label="Provider"
                  each driver in wizard.drivers key=driver.id
                    button press=ui("driver", driver.id) role="radio" aria-checked=(driver.selected and not manual) aria-label=driver.label testId=`provider-driver-${driver.id}` width="calc(50% - 6px)" height="2.75rem" box-sizing="border-box" padding="0.75rem" gap="0.75rem" border-radius="0.625rem" border-style="solid" border-width=(driver.selected and not manual ? 2 : 1) border-color=(driver.selected and not manual ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#0000000d, #ffffff0d)") display="flex" flex-direction="row" align-items="center" justify-content="flex-start" background-color=(driver.selected and not manual ? "light-dark(#1a4dd914, #366bf226)" : "light-dark(#ffffff, #ffffff08)")
                      DriverMark(driver=driver.id, size=16, initials=driver.label, icon="")
                      text driver.label flex=1 min-width=0 font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 text-align="left"
                      when driver.selected and not manual
                        box width="1.25rem" height="1.25rem" border-radius="624.9375rem" flex-shrink=0 display="flex" align-items="center" justify-content="center" background-color="light-dark(#1b4ed8, #346bf1)"
                          PvIcon(name="check", size=14, color="#ffffff")
              column width="100%" gap="1rem" padding-top="1rem"
                row width="100%" gap="0.75rem" align-items="center"
                  box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff12)"
                  text "Or choose from ACP Registry" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
                  box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff12)"
                when manual
                  column width="100%" gap="1rem" testId="acp-manual"
                    row width="100%" gap="0.75rem" align-items="flex-start" justify-content="space-between"
                      column gap="0.125rem" flex=1 min-width=0
                        text "Enter manually" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                        text "Enter an official registry ID and any local executable or auth override." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
                      button press=ui("manual", "false") class=PvGhost height="1.5rem" testId="acp-search-registry"
                        text "Search registry" font-size="0.75rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                    each session in wizard.sessions key=session.key
                      column width="100%" gap="0.25rem"
                        each field in wizard.fields key=field.key
                          WizardFieldRow(field=field, value=(field.index == 0 ? f0 : (field.index == 1 ? f1 : (field.index == 2 ? f2 : (field.index == 3 ? f3 : f4)))), set=setField)
                    when attempted and f0 == ""
                      text "Select an ACP or configure one manually." font-size="0.6875rem" color="light-dark(#e7000b, #ff6467)" role="alert"
                else
                  column width="100%" gap="0.75rem" testId="acp-search"
                    row width="100%" gap="0.5rem" align-items="center"
                      row flex=1 min-width="10rem" height="1.75rem" box-sizing="border-box" padding-left="0.5rem" gap="0.375rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" align-items="center"
                        PvIcon(name="search", size=16, color="light-dark(#71717b, #818181)")
                        input value=query input=ui("acp") placeholder="Search agents…" aria-label="Search ACP Registry" disabled=busy flex=1 min-width=0 height="1.125rem" padding=0 border-width=0 background-color="#00000000" font-size="0.875rem" color="light-dark(#27272a, #f5f5f5)" testId="acp-registry-search" autocorrect="off"
                      button press=ui("manual", "true") class=PvGhost height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" disabled=busy testId="acp-enter-manually"
                        text "Enter manually" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #818181)"
                    text acp.status font-size=1 color="#00000000" role="status" height=1 overflow="hidden"
                    when acp.error != "" or (error != "" and step == 0)
                      text (error != "" ? error : acp.error) font-size="0.75rem" line-height="1rem" padding="0.5rem" border-radius="0.5rem" color="light-dark(#e7000b, #ff6467)" background-color="light-dark(#e7000b0d, #ff64671a)" role="status" testId="acp-error"
                    when not acp.ready
                      row min-height="5rem" align-items="center" justify-content="center"
                        text "Searching the registry..." font-size="0.875rem" color="light-dark(#71717b, #818181)"
                    when acp.ready and acp.error == "" and length(acp.agents) == 0
                      column min-height="7rem" align-items="center" justify-content="center" border-radius="1rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" padding-left="1rem" padding-right="1rem"
                        text "No compatible agents found" font-size="0.875rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                        text "Try a broader search." font-size="0.75rem" margin-top="0.25rem" color="light-dark(#71717b, #818181)"
                    when acp.ready and length(acp.agents) > 0
                      scroll width="100%" max-height="16rem" testId="acp-agent-list"
                        column width="100%" padding-right="0.625rem" box-sizing="border-box"
                          each agent in acp.agents key=agent.id
                            row width="100%" min-width=0 padding-top="0.625rem" padding-bottom="0.625rem" gap="0.75rem" align-items="center" role="article" testId=`acp-agent-${agent.id}`
                              row flex=1 min-width=0 gap="0.75rem" align-items="center"
                                // AcpRegistrySearchStep's ProviderInstanceIcon (size-6, muted): the allow-listed icon, else the agent id's.
                                box width="1.5rem" height="1.5rem" border-radius="0.375rem" flex-shrink=0 display="flex" align-items="center" justify-content="center" overflow="hidden"
                                  AcpRegistryAgentIcon(icon=agent.iconUrl, size=24, color="light-dark(#71717b, #818181)")
                                column flex=1 min-width=0
                                  text agent.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 role="heading" aria-level=4
                                  when agent.description != ""
                                    text agent.description font-size="0.75rem" line-height="1rem" margin-top="0.125rem" color="light-dark(#71717b, #818181)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" width="100%"
                              row gap="0.375rem" align-items="center" flex-shrink=0
                                when agent.link != ""
                                  link cursor="pointer" href=agent.link aria-label=`About ${agent.name}` width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" border-radius="0.5rem" testId=`acp-about-${agent.id}` title=""
                                    PvIcon(name="external", size=14, color="light-dark(#71717b, #818181)")
                                button press=op("acp-prepare", "", agent.id, agent.name, true) class=PvOutline height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" font-size="0.75rem" disabled=(agent.added or busy) aria-label=`${agent.added ? "Already added" : (busy ? "Preparing" : "Add")} ${agent.name}` testId=`acp-add-${agent.id}`
                                  text (agent.added ? "Added" : "Add") font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            when shownStep == 1
              column width="100%" gap="0.25rem" min-height=(isAcp ? "18rem" : "0px")
                each agent in wizard.prepared key=agent.id
                  row width="100%" gap="0.75rem" padding-bottom="0.75rem" margin-bottom="1rem" align-items="flex-start" justify-content="space-between" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e7b3, #ffffff12)"
                    column flex=1 min-width=0
                      text agent.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1
                      text `v${agent.version} · ${agent.distribution}` font-size="0.75rem" line-height="1rem" margin-top="0.125rem" color="light-dark(#71717b, #818181)"
                    when agent.link != ""
                      text "Docs" href=agent.link font-size="0.6875rem" color="light-dark(#71717b, #818181)" aria-label=`Open documentation for ${agent.name} (${agent.id})`
                WizardRow(title="Label", description="Shown in the provider list.", status="")
                  input value=shownLabel input=ui("label") placeholder="e.g. Work" aria-label="Label" class=PvField width="14rem" testId="new-provider-name" autocorrect="off"
                WizardRow(title="Instance ID", description="Letters, digits, '-', or '_'.", status=(attempted ? wizard.idError : ""))
                  input value=shownId input=ui("id") placeholder=wizard.idPlaceholder aria-label="Instance ID" class=PvField width="14rem" testId="new-provider-id" autocorrect="off"
                WizardRow(title="Accent color", description="Optional marker shown in the picker.", status="")
                  row gap="0.5rem" align-items="center"
                    when accentOpen
                      input value=accent input=editAccent aria-label="Custom hex accent color" class=PvField width="6.5rem" font-family="ui-monospace" font-size="0.75rem" testId="new-provider-accent-hex" autocorrect="off"
                      button press=clearAccent class=PvGhost height="1.75rem" testId="new-provider-accent-clear"
                        PvIcon(name="x", size=14, color="light-dark(#71717b, #818181)")
                        text "Clear color" font-size="0.75rem" font-weight=500 color="light-dark(#71717b, #818181)"
                    button press=toggleAccent class=PvIconButton width="1.75rem" height="1.75rem" background-color=(accent == "" ? "#00000000" : accent) aria-label=`${accent == "" ? "Add" : "Change"} accent color for ${shownLabel == "" ? wizard.driverLabel : shownLabel}` aria-expanded=accentOpen testId="new-provider-accent" title=""
                      when accent == ""
                        PvIcon(name="plus", size=16, color="light-dark(#71717b, #818181)")
            when shownStep == 2 and not isAcp
              column width="100%" gap="0.25rem"
                when length(wizard.fields) == 0
                  text "This driver has no required configuration. You can add the instance now." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
                each session in wizard.sessions key=session.key
                  column width="100%" gap="0.25rem"
                    each field in wizard.fields key=field.key
                      WizardFieldRow(field=field, value=(field.index == 0 ? f0 : (field.index == 1 ? f1 : (field.index == 2 ? f2 : (field.index == 3 ? f3 : f4)))), set=setField)
            // ProviderWizardAuthenticationStep: the created agent's Account row (AddProviderInstanceDialog createdInstanceId).
            each auth in wizard.auth key=auth.instanceId
              ProviderWizardAuthStep(auth=auth, scheme=scheme, wide=true, busy=setupBusy, op=op, askSignOut=askSignOut)
            when error != "" and shownStep > 0
              text error font-size="0.75rem" line-height="1rem" padding-top="0.75rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="add-provider-error"
        row width="100%" box-sizing="border-box" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" justify-content="flex-end" align-items="center" flex-shrink=0
          // WizardFooter of the Sign in step: Done once signed in, else Skip for now; held while a sign-in runs.
          each auth in wizard.auth key=auth.instanceId
            button press=ui("close", "") class=(auth.signedIn ? PvPrimary : PvOutline) disabled=auth.active opacity=(auth.active ? 0.64 : 1) testId="wizard-finish"
              text (auth.signedIn ? "Done" : "Skip for now") font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(auth.signedIn ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")
          when wizard.created == ""
            button press=ui(step == 0 ? "close" : "step", step == 0 ? "" : "back") class=(step == 0 ? PvGhost : PvOutline) height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" disabled=busy aria-keyshortcuts=(step == 0 ? "Escape" : "") testId=(step == 0 ? "close-add-provider" : "wizard-back")
              text (step == 0 ? "Cancel" : "Back") font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(step == 0 ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
            when step == 0 and wizard.driver == "codex" and not manual
              button press=ui("step", "next") class=PvOutline testId="configure-manually"
                text "Configure manually" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
              button press=ui("open", "chatgpt") class=PvPrimary disabled=busy testId="continue-with-chatgpt"
                ProviderMark(driver="codex", size=16, color="#ffffff")
                text "Continue with ChatGPT" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
            when (step == 0 and (wizard.driver != "codex" or manual)) or (step == 1 and not isAcp)
              button press=ui("step", "next") class=PvPrimary disabled=busy testId="wizard-next"
                text "Next" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
            when step == lastStep
              button press=add(wizard.driver, shownLabel, idSet ? id : "", accent, f0, f1, f2, f3, f4) class=PvPrimary disabled=busy testId="create-provider"
                text (busy ? "Adding..." : (isAcp ? "Continue to sign-in" : "Add instance")) font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
        button press=ui("close", "") class=PvIconButton width="2rem" height="2rem" position="absolute" top="0.5rem" right="0.5rem" aria-label="Close" aria-keyshortcuts="Escape" disabled=busy testId="close-add-provider-x" title=""
          PvIcon(name="x", size=16, color="light-dark(#71717b, #818181)")
      // The Sign in step's Sign out confirmation (dialogs.confirm) over the wizard.
      when signOutOpen
        each auth in wizard.auth key=auth.instanceId
          each account in auth.account key=account.key
            AppConfirm(title=account.signOutTitle, body=account.signOutBody, destructive=false, busy=setupBusy, confirmId="wizard-sign-out-confirm", cancel=cancelSignOut, confirm=confirmSignOut)

// A plain-group SettingsRow inside the wizard (title left, control right).
component WizardRow
  props
    title: string
    description: string
    status: string
  slot
  view
    row width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="2rem" align-items="center"
      column flex=1 min-width=0 gap="0.25rem"
        text title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
        text description font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
        when status != ""
          text status font-size="0.75rem" line-height="1rem" padding-top="0.125rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="new-provider-id-error"
      row flex-shrink=0 justify-content="flex-end" align-items="center"
        children

// One driver setting in the wizard's Config step (ProviderSettingsForm).
component WizardFieldRow
  props
    field: WizardField
    value: string
    set: action
  view
    WizardRow(title=field.label, description=field.description, status="")
      when field.control == "select"
        row gap="0.25rem" role="radiogroup" aria-label=field.label flex-wrap="wrap" justify-content="flex-end" max-width="20rem"
          each option in field.options key=option.value
            button press=set(field.index, option.value) role="radio" aria-checked=(value == option.value or (value == "" and option.selected)) class=PvOutline height="1.75rem" background-color=(value == option.value or (value == "" and option.selected) ? "light-dark(#1b4ed814, #346bf126)" : "light-dark(#ffffff, #ffffff08)") testId=`new-provider-${field.key}-${option.value}`
              text option.label font-size="0.8125rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
      else
        input value=value input=set(field.index) placeholder=field.placeholder aria-label=field.label type=(field.control == "password" ? "password" : "text") autocorrect="off" spellcheck="false" class=PvField width="14rem" testId=`new-provider-${field.key}`

style PvOverlay
  position="absolute" left=0 right=0 top=0 bottom=0
  display="flex" align-items="center" justify-content="center"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" padding="1rem" box-sizing="border-box" z-index=40

// AddUsageLimitSourceDialog.tsx: one CLIProxyAPI hub, saved on the environment.
component UsageHubDialog
  props
    environment: string
    busy: bool
    error: string
    close: action
    save: action
  state url = ""
  state secret = ""
  state label = ""
  action editUrl(value: string)
    url = value
  action editSecret(value: string)
    secret = value
  action editLabel(value: string)
    label = value
  view
    column class=PvOverlay testId="usage-hub-overlay"
      column width="100%" max-width="28rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" position="relative" role="dialog" aria-label="Add a CLIProxyAPI hub" testId="usage-hub-dialog"
        column padding="1.5rem" gap="0.5rem" padding-bottom="0.75rem"
          text "Add a CLIProxyAPI hub" font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text `Show the quota of every account the hub pools, next to the providers on ${environment}. The key stays on that server.` font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        column padding-left="1.5rem" padding-right="1.5rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="1rem"
          column gap="0.375rem"
            text "Hub URL" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            input value=url input=editUrl submit=save(label, url, secret, true) placeholder="https://hub.example.ts.net:8318" aria-label="Hub URL" class=PvField height="2rem" padding-top="0.375rem" padding-bottom="0.375rem" width="100%" testId="usage-hub-url" autocorrect="off"
          column gap="0.375rem"
            text "Management key" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            input value=secret input=editSecret submit=save(label, url, secret, true) type="password" aria-label="Management key" class=PvField height="2rem" padding-top="0.375rem" padding-bottom="0.375rem" width="100%" testId="usage-hub-key" autocorrect="off"
          column gap="0.375rem"
            text "Label (optional)" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            input value=label input=editLabel submit=save(label, url, secret, true) placeholder="Defaults to the hub's host name" aria-label="Label (optional)" class=PvField height="2rem" padding-top="0.375rem" padding-bottom="0.375rem" width="100%" testId="usage-hub-label" autocorrect="off"
          when error != ""
            text error font-size="0.75rem" line-height="1rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="usage-hub-error"
        row padding="1.5rem" padding-top="0.75rem" gap="0.5rem" justify-content="flex-end"
          button press=close class=PvOutline disabled=busy aria-keyshortcuts="Escape" testId="usage-hub-cancel"
            text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          button press=save(label, url, secret, true) class=PvPrimary disabled=(busy or url == "" or secret == "") opacity=(url == "" or secret == "" ? 0.64 : 1) testId="usage-hub-save"
            text "Add hub" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"

// RemoveUsageProviderButton's confirmation.
component HubRemoveDialog
  props
    hub: ProviderHub
    busy: bool
    cancel: action
    confirm: action
  view
    column class=PvOverlay testId="usage-hub-remove-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="alertdialog" aria-label=`Remove ${hub.label}?` testId="usage-hub-remove-dialog"
        column padding="1.5rem" gap="0.5rem"
          text `Remove ${hub.label}?` font-size="1.25rem" line-height="1.75rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "The hub's management key is deleted from this server. Its accounts leave the Limits view; the hub itself is untouched. Add it again with the URL and key to bring them back." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" justify-content="flex-end" border-top-style="solid" border-top-width=1 border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#f4f4f580, #ffffff05)"
          button press=cancel class=PvOutline disabled=busy aria-keyshortcuts="Escape" testId="usage-hub-remove-cancel"
            text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          button press=confirm class=PvPrimary background-color="#e7000b" disabled=busy testId="usage-hub-remove-confirm"
            text "Remove" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"

// AddCodexAccountDialog.tsx: name the account; Continue creates its managed Codex instance
// (codex_<uuid>), then the dialog carries that account's setup (it starts on its own) with
// Finish later, until the plan is shared (app.contract closes it). From the welcome, Continue
// closes the dialog and the new row starts there (onAccountCreated).
component ChatGptAccountDialog
  props
    wizard: ProviderWizard
    busy: bool
    setupBusy: bool
    error: string
    close: action
    create: action
    op: action
    ui: action
  state name = "Personal"
  action editName(value: string)
    name = value
  // Focus stays in the dialog while it asks for the name (Base UI's focus trap).
  action nameKeys(k: string, e: KeyboardEvent)
    if k == "Tab" and e.shiftKey
      focus("chatgpt-account-continue-button")
      preventDefault()
  action lastKeys(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.shiftKey
      focus("chatgpt-account-name-field")
      preventDefault()
  view
    column class=PvOverlay testId="chatgpt-account-overlay"
      column width="100%" max-width="48rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" position="relative" overflow="hidden" role="dialog" aria-modal=true aria-label=(length(wizard.chatgpt) > 0 ? join(map(wizard.chatgpt, (created) => created.title), "") : "Add ChatGPT account") testId="chatgpt-account-dialog"
        column padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" gap="0.5rem"
          text (length(wizard.chatgpt) > 0 ? join(map(wizard.chatgpt, (created) => created.title), "") : "Add ChatGPT account") font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="chatgpt-account-title"
          text "Each account has its own Codex instance and sign-in. Choose the other account on the sign-in page." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        column width="100%" box-sizing="border-box" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" border-top-style="solid" border-top-width=1 border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfccc, #ffffff05)"
          when length(wizard.chatgpt) > 0
            each created in wizard.chatgpt key=created.key
              ChatGptAccountSetup(created=created, wide=true, busy=setupBusy, op=op, ui=ui)
          else
            WizardRow(title="Account name", description="Shown in the provider list and model picker.", status=error)
              input value=name input=editName submit=create(name, "", true) key=nameKeys id="chatgpt-account-name-field" placeholder="e.g. Personal or Work" aria-label="Account name" class=PvField width="14rem" disabled=busy autofocus=true testId="chatgpt-account-name" autocorrect="off"
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" justify-content="flex-end"
          when length(wizard.chatgpt) > 0
            button press=close class=PvOutline aria-keyshortcuts="Escape" testId="chatgpt-account-finish-later"
              text "Finish later" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          else
            button press=close class=PvOutline disabled=busy aria-keyshortcuts="Escape" testId="chatgpt-account-cancel"
              text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            box key=lastKeys tabindex=-1 display="flex"
              button press=create(name, "", true) id="chatgpt-account-continue-button" class=PvPrimary disabled=(busy or trim(name) == "") opacity=(busy or trim(name) == "" ? 0.64 : 1) testId="chatgpt-account-continue"
                text (busy ? "Adding account…" : "Continue") font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
