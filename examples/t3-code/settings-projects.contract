// Settings → Project (reference ProjectsSettings.tsx / ProjectSettingsPanel.tsx):
// without a project scope, a notice with the project choices; with one, the
// group's name, icon, new-thread defaults, checkouts and removal.
use SelectOption from "./settings-kit.contract"
use SettingsSelect from "./settings-kit.contract"
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use ScopedRow from "./settings-source-control.contract"
use Inheritance from "./settings-source-control.contract"
use Card from "./settings-source-control.contract"
use SectionTitle from "./settings-source-control.contract"
use LucideInfo from "./settings-icons.contract"
use LucideTrash2 from "./settings-icons.contract"
use LucideUndo2 from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use ProviderInstanceMark from "./icons.contract"
use CnScriptIcon from "./settings-b-kit.contract"
use CnGlyph from "./settings-b-kit.contract"
use CnMenu from "./settings-b-kit.contract"
use CnSeparator from "./settings-b-kit.contract"
use LucideLayers from "./settings-icons.contract"
use ProjectIconMark from "./settings-b-iconmark.contract"
use KmItem from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"

shape ProjectChoice
  key: string
  label: string
  member: string
shape ProjectMember
  id: string
  title: string
  path: string
  environment: string
  first: bool
shape ProjectAction
  id: string
  first: bool
  name: string
  command: string
  icon: string
  setup: bool
  wait: bool
  preview: bool
  previewUrl: string
  autoOpen: bool
  keybinding: string
  shortcut: string
shape ImportScript
  key: string
  name: string
  command: string
  icon: string
  payload: string
shape ProjectsPage
  ready: bool
  selected: bool
  message: string
  choices: list<ProjectChoice>
  confirmTitle: string
  confirmDescription: string
  key: string
  name: string
  mark: string
  ink: string
  surface: string
  icon: string
  iconCustom: bool
  members: list<ProjectMember>
  hasOther: bool
  threads: number
  workspace: ScopedRow
  removeTitle: string
  removeDescription: string
  removeLabel: string
  confirm: string
  removeTarget: string
  names: list<string>
  actionScope: string
  actionsMixed: bool
  actionsWritable: bool
  t3Invalid: bool
  actions: list<ProjectAction>
  importable: list<ImportScript>
  actionsRow: ScopedRow
  blankActions: list<ProjectAction>
  iconKind: string
  iconName: string
  iconD: string
  iconInk: string
  iconSurface: string
  iconText: string
  iconTextWidth: number
  iconEmoji: string
  iconPickColor: string
  iconLetters: string
  faviconSrc: string
  iconScope: string
  iconCwd: string
  // desktop-shell-details: the picker footer's "Open in Finder", or "" where it is not offered.
  iconPickExternal: string

component ProjectsPanel
  props
    data: ProjectsPage
    busy: bool
    error: string
    choose: action
    rest: action
    restInput: action
    raw: action
    open: action
  // The New threads card's Model row: General's ProviderModelPicker + TraitsPicker row (CoreRowView).
  slot
  view
    column width="100%" gap="1.5rem" testId="projects-settings"
      when error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)" role="alert" testId="projects-error" padding-left="1rem"
      when data.ready and not data.selected and data.message != ""
        Card()
          column gap="0.75rem" padding="1rem" box-sizing="border-box" width="100%" testId="projects-scope-notice"
            text data.message font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
            when length(data.choices) > 0
              row gap="0.5rem" flex-wrap="wrap"
                each choice in data.choices key=choice.key
                  button press=choose(true, choice.key, choice.member) disabled=busy testId=`projects-choose-${choice.label}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
                    text choice.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      when data.selected
        row width="100%" box-sizing="border-box" gap="0.625rem" align-items="center" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="0.875rem" padding-right="0.875rem" border-radius="0.875rem" border-style="solid" border-width=1 border-color="#2c80ff52" background-color="#3380ff0a" role="alert" testId="projects-alert"
          LucideInfo(size=16, color="light-dark(#1b4ed8, #4d8bff)")
          text "Can't find a setting? Keep this project picked above and hop to any other settings page." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" flex=1 min-width=0
        Card()
          row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" testId="project-name-row"
            column flex=1 min-width=0 gap="0.25rem"
              text "Name" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              text "The shared name for this project group in the sidebar and thread lists." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
            each current in data.names key=current
              ProjectName(name=current, groupKey=data.key, busy=busy, raw=raw)
          row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" testId="project-icon-row"
            column flex=1 min-width=0 gap="0.25rem"
              row min-height="1.25rem" gap="0.375rem" align-items="center"
                text "Project icon" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                box width="1.25rem" height="1.25rem"
                  when data.iconCustom
                    button press=rest("project-icon", "action=reset") disabled=busy aria-label="Reset project icon to default" testId="reset-project-icon" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                      LucideUndo2(size=12, color="light-dark(#71717b, #818181)")
              text data.icon font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" testId="project-icon-description"
            // ProjectFavicon size-6, then Choose icon (ProjectIconPickerDialog) and Choose file (ProjectFaviconPickerDialog).
            row flex-shrink=0 gap="0.5rem" align-items="center"
              ProjectIconMark(kind=data.iconKind, d=data.iconD, ink=data.iconInk, surface=data.iconSurface, text=data.iconText, textWidth=data.iconTextWidth, emoji=data.iconEmoji, src=data.faviconSrc, size=24)
              button press=open("project-icon", "", "") disabled=busy aria-label="Choose a project icon" testId="project-choose-icon" class=PjOutline
                text "Choose icon" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
              button press=open("project-favicon", "", "") disabled=busy aria-label="Choose a project icon file" testId="project-choose-file" class=PjOutline
                text "Choose file" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
        column width="100%" gap="0.625rem" testId="project-new-threads"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="New threads")
          Card()
            children
            row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" testId="project-workspace-row"
              column flex=1 min-width=0 gap="0.25rem"
                row min-height="1.25rem" gap="0.375rem" align-items="center"
                  text "Workspace" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                  Inheritance(row=data.workspace)
                  box width="1.25rem" height="1.25rem"
                    when data.workspace.reset != ""
                      button press=rest("scoped", data.workspace.reset) disabled=busy aria-label="Reset default workspace to default" testId="reset-project-workspace" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                        LucideUndo2(size=12, color="light-dark(#71717b, #818181)")
                text data.workspace.description font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
              SettingsSelect(selectId="project-workspace", label="Default workspace", valueLabel=data.workspace.valueLabel, value="", width=160, disabled=(busy or data.workspace.disabled), options=data.workspace.options, choose=restInput("scoped", "key=defaultThreadEnvMode&value="))
        ProjectActionsSection(data=data, busy=busy, raw=raw, open=open)
        when length(data.members) > 0
          column width="100%" gap="0.625rem" testId="project-checkouts"
            row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
              SectionTitle(title="Checkouts")
            Card()
              each member in data.members key=member.id
                row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=(member.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)"
                  column flex=1 min-width=0 gap="0.25rem"
                    text member.environment font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                    text member.path font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
                  button press=open("project-remove-member", member.id, member.title) disabled=busy aria-label=`Remove checkout ${member.path}` testId=`remove-checkout-${member.id}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
                    text "Remove" font-size="0.875rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        column width="100%" gap="0.625rem" testId="project-danger"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Danger")
          Card()
            row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center"
              column flex=1 min-width=0 gap="0.25rem"
                text data.removeTitle font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                text data.removeDescription font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
              button press=open("project-remove", data.removeTarget, data.key) disabled=busy testId="remove-project" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
                LucideTrash2(size=16, color="light-dark(#c10007, #ff6467)")
                text data.removeLabel font-size="0.875rem" font-weight=500 color="light-dark(#c10007, #ff6467)"

// Name: commits on blur or Enter; blank is refused (renameGroup).
component ProjectName
  props
    name: string
    groupKey: string
    busy: bool
    raw: action
  state draft = name
  action edit(next: string)
    draft = next
  view
    input value=draft input=edit change=raw("rename-group", groupKey) aria-label="Project name" disabled=busy testId="managed-project-name" box-sizing="border-box" width="16rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.1875rem" padding-bottom="0.1875rem" line-height="1.25rem" flex-shrink=0 border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size="0.875rem" color="light-dark(#27272a, #f5f5f5)"

// ProviderModelPicker / TraitsPicker triggers in a settings row: ghost buttons.
component GhostSelect
  props
    selectId: string
    label: string
    driver: string
    badge: string
    accent: string
    valueLabel: string
    disabled: bool
    options: list<SelectOption>
    choose: action
  // fix-keyboard-focus: Enter or Space opens the menu from the keyboard (menu-keys.contract).
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    box position="relative"
      button popovertarget=`${selectId}-menu` key=triggerKey focus=keyArm(true) blur=keyArm(false) role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-width=0 border-radius="0.5rem" background-color="#00000000" opacity=(disabled ? 0.64 : 1)
        when driver != ""
          ProviderInstanceMark(driver=driver, size=16, color="light-dark(#71717b, #818181)", badge=badge, accent=accent)
        text valueLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#71717b, #818181)"
        LucideChevronDown(size=14, color="light-dark(#71717b, #818181)")
      KeyMenuOpen(menuId=`${selectId}-menu`, armed=keyArmed, opened=keyOpened)
      SkPopup(menuId=`${selectId}-menu`, label=label, width=256, list=true, endAlign=0, items=map(options, (option) => KmItem(id=`${selectId}-option-${option.value}`, label=option.label)), keyed=keyed)
        each option in options key=option.value
          SkMenuItem(keysId=`${selectId}-menu-keys`, label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=option.selected, check=true, destructive=false, disabled=false, choose=choose(option.value))

// ProjectActionsSettings + ProjectActionsList: a project's actions on the
// selected checkouts, t3.json import, and the editor (settings-b-actions.contract).
component ProjectActionsSection
  props
    data: ProjectsPage
    busy: bool
    raw: action
    open: action
  // fix-keyboard-focus: the "Import scripts" menu's keyboard (menu-keys.contract).
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    column width="100%" gap="0.625rem" testId="project-actions"
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
        SectionTitle(title="Actions")
      Card()
        row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" testId="project-actions-row"
          column flex=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" gap="0.375rem" align-items="center"
              text "Actions" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              Inheritance(row=data.actionsRow)
              box width="1.25rem" height="1.25rem"
                when data.actionsRow.reset != ""
                  button press=raw("sb:action-reset", data.actionScope, "") disabled=(busy or not data.actionsWritable) aria-label="Reset Actions to default" testId="reset-project-actions" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                    LucideUndo2(size=12, color="light-dark(#71717b, #818181)")
            text "Commands that run in this project's checkout or its worktree, with optional shortcuts." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
          row flex-shrink=0 gap="0.375rem" align-items="center" flex-wrap="wrap"
            when length(data.importable) > 0
              box position="relative"
                button popovertarget="import-scripts-menu" key=triggerKey focus=keyArm(true) blur=keyArm(false) disabled=(busy or not data.actionsWritable) id="import-scripts" testId="import-scripts" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-width=1 border-style="solid" border-color="#00000000" border-radius="0.5rem" background-color="#00000000"
                  text "Import scripts" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                  CnGlyph(name="chevron-down", size=14, color="light-dark(#71717b, #818181)")
                KeyMenuOpen(menuId="import-scripts-menu", armed=keyArmed, opened=keyOpened)
                CnMenu(menuId="import-scripts-menu", label="Import scripts", width=442, endAlign=111, offsetX=0, offsetY=0, items=(busy ? [] : map(data.importable, (script) => KmItem(id=`import-script-${script.name}`, label=script.name))), keyed=keyed)
                  text "Import from t3.json" font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" color="light-dark(#71717b, #818181)" role="presentation"
                  text "Add actions declared by this checkout without editing them first." font-size="0.875rem" line-height="1.25rem" padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717b, #818181)"
                  CnSeparator()
                  each script in data.importable key=script.key
                    ImportScriptItem(keysId="import-scripts-menu-keys", script=script, scope=data.actionScope, busy=busy, raw=raw)
            button press=open("project-action", "", "") disabled=(busy or not data.actionsWritable) testId="add-project-action" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" border-radius="0.5rem" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d"
              CnGlyph(name="plus", size=14, color="light-dark(#71717b, #818181)")
              text "Add action" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        when data.actionsMixed
          row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
            column flex=1 min-width=0 gap="0.25rem"
              text "Different actions across environments" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              text "Choose one environment to edit its list. Adding an action here adds it on every selected environment." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
        when not data.actionsMixed and length(data.actions) == 0
          text "No actions configured." font-size="0.875rem" line-height="1.25rem" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" color="light-dark(#71717b, #818181)" testId="project-actions-empty"
        when not data.actionsMixed
          each entry in data.actions key=entry.id
            ProjectActionRow(item=entry, busy=busy, writable=data.actionsWritable, open=open)
        when data.t3Invalid
          column width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="0.25rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" testId="t3-json-invalid"
            text "t3.json is invalid" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#e17100, #fdb022)" role="heading" aria-level=3
            text "A t3.json exists in this checkout but fails to parse, so every action and icon it declares is ignored. Check the JSON syntax and icon values." font-size="0.75rem" line-height="1.125rem" color="light-dark(#e17100cc, #fdb022cc)" max-width="36rem"

// One MenuItem of "Import from t3.json": icon, name and command.
component ImportScriptItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    script: ImportScript
    scope: string
    busy: bool
    raw: action
  state lit = false
  action hover(over: bool)
    if over
      focus(`import-script-${script.name}-km`)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=`import-script-${script.name}` press=raw("sb:action-import", scope, script.payload) popovertarget="import-scripts-menu" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=busy role="menuitem" aria-label=`${script.name} ${script.command}` testId=`import-script-${script.name}` display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" width="100%" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      CnScriptIcon(icon=script.icon, size=16, color="light-dark(#71717b, #818181)")
      column flex=1 min-width=0 align-items="flex-start"
        text script.name font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
        text script.command font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" line-clamp=1 color="light-dark(#71717b, #818181)"

// ProjectActionsList row: icon, name, setup/preview badges, the command, the
// shortcut, and the edit gear that appears on hover or focus.
component ProjectActionRow
  props
    item: ProjectAction
    busy: bool
    writable: bool
    open: action
  state hovered = false
  state focused = false
  action hover(over: bool)
    hovered = over
  action focusGear(on: bool)
    focused = on
  view
    row hover=hover width="100%" box-sizing="border-box" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" testId=`project-action-${item.id}`
      column flex=1 min-width=0 gap="0.25rem"
        row min-width=0 gap="0.5rem" align-items="center"
          CnScriptIcon(icon=item.icon, size=16, color="light-dark(#71717b, #818181)")
          text item.name font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 min-width=0 color="light-dark(#27272a, #f5f5f5)"
          when item.setup
            text "setup" font-size="0.625rem" line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" padding-top=1 padding-bottom=1 border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)" flex-shrink=0 color="light-dark(#71717b, #818181)"
          when item.preview
            text "preview · desktop only" font-size="0.625rem" line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" padding-top=1 padding-bottom=1 border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)" flex-shrink=0 color="light-dark(#71717b, #818181)"
        text item.command font-family="ui-monospace" font-size="0.75rem" line-height="1.125rem" line-clamp=1 color="light-dark(#70707acc, #818181cc)"
      row flex-shrink=0 gap="0.5rem" align-items="center"
        when item.shortcut != ""
          text item.shortcut font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId=`project-action-shortcut-${item.id}`
        button press=open("project-action", item.id, item.name) focus=focusGear(true) blur=focusGear(false) aria-label=`Edit ${item.name}` disabled=(busy or not writable) opacity=(hovered or focused ? 1 : 0) testId=`edit-project-action-${item.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          CnGlyph(name="settings", size=14, color="light-dark(#71717b, #818181)")

// Button variant="outline" size="sm": h-7, px 9, radius 8, border-input, bg-popover, shadow-xs/5.
style PjOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" box-sizing="border-box" height="1.75rem" min-width="2.5rem" padding-left="0.5625rem" padding-right="0.5625rem" flex-shrink=0
  border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d"
