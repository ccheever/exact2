// browser-surface part 4 (profiles): Settings › Integrations › Browser › Browser profiles, its Add profile and row menus,
// "Remove “<name>”?" and the cookie import wizard (MIT reference, see LICENSE-T3, T3 Code 1e2ecbd975:
// apps/web/src/components/settings/IntegrationsSettings.tsx BrowserProfilesSetting, BrowserImportWizard.tsx,
// permissions/PermissionChecklist.tsx). `view` is browser-profiles-settings.ts `browserProfilesView`; every action is a
// `restlocal:browser-…` op. The dialogs are mounted with the settings window (app-settings.contract), so they cover it.
use LucidePlus from "./settings-icons.contract"
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use KmItem from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"
use LucideEllipsisVertical from "./settings-icons.contract"
use LucideCheck from "./settings-icons.contract"
use LucideHardDrive from "./settings-icons.contract"
use LucideX from "./settings-icons.contract"
use R4Glyph from "./r4-git.contract"
use BrowserDefaultsView from "./browser-defaults.contract"

shape BrowserProfileRowView
  id: string
  name: string
  builtIn: bool
  isDefault: bool
  first: bool
shape BrowserImportSourceRow
  id: string
  name: string
shape WizardTileView
  key: string
  title: string
  subtitle: string
  selected: bool
shape BrowserImportWizardView
  open: bool
  step: string
  sourceName: string
  environmentName: string
  canClose: bool
  check: string
  from: list<WizardTileView>
  into: list<WizardTileView>
  feedback: string
  importDisabled: bool
  fdaGranted: bool
  fdaStillRequired: bool
  fdaBusy: bool
  fdaNote: string
  fdaResume: string
  doneTitle: string
  doneDescription: string
  skipped: string
  blockedText: string
  retry: bool
shape BrowserProfilesView
  hydrated: bool
  writesDisabled: bool
  importInFlight: bool
  atLimit: bool
  rows: list<BrowserProfileRowView>
  sourcesState: string
  sources: list<BrowserImportSourceRow>
  canImport: bool
  removalAvailable: bool
  removalNote: string
  removalOpen: bool
  removalName: string
  removalError: string
  removalBusy: bool
  wizard: BrowserImportWizardView
  defaults: BrowserDefaultsView

keyframes bpSpin
  from rotate=0
  to rotate=360

style BpOverlay
  position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)"
style BpPopup
  width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)"
  background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" position="relative"

// SettingsRow with the profile list under it: "Browser profiles", its description, and Add profile (a keyboard menu,
// end-aligned under its trigger: Blank profile, then "Import from" and every browser found on this machine).
component BrowserProfilesSetting
  props
    view: BrowserProfilesView
    local: action
  state addOver = false
  state keyed = 0
  state keyArmed = false
  action addHover(on: bool)
    addOver = on
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
    local("browser-profiles-sources", "")
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    column width="100%" testId="browser-profiles-setting"
      row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center"
        column flex=1 min-width=0 gap="0.25rem"
          text "Browser profiles" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          text "Profiles separate cookies and logins. Incognito data is cleared when the app closes." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
        box position="relative" flex-shrink=0
          button press=local("browser-profiles-sources", "") popovertarget="browser-profiles-add-menu" key=triggerKey focus=keyArm(true) blur=keyArm(false) hover=addHover disabled=view.writesDisabled aria-label="Add profile" aria-haspopup="menu" testId="browser-profiles-add" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(addOver and not view.writesDisabled ? "light-dark(#f4f4f5, #ffffff0f)" : "light-dark(#ffffff, #ffffff07)") opacity=(view.writesDisabled ? 0.64 : 1)
            LucidePlus(size=16, color="light-dark(#27272a, #f5f5f5)")
            text "Add profile" font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
          KeyMenuOpen(menuId="browser-profiles-add-menu", armed=keyArmed, opened=keyOpened)
          SkPopup(menuId="browser-profiles-add-menu", label="Add profile", width=216, list=false, endAlign=116, items=(view.hydrated and not view.atLimit ? [KmItem(id="browser-profiles-blank", label="Blank profile")] : []), keyed=keyed)
            SkMenuItem(keysId="browser-profiles-add-menu-keys", label="Blank profile", menuId="browser-profiles-add-menu", itemId="browser-profiles-blank", selected=false, check=false, destructive=false, disabled=(not view.hydrated or view.atLimit), choose=local("browser-profiles-create", ""))
            when view.atLimit
              SkMenuItem(keysId="browser-profiles-add-menu-keys", label="You’ve reached the profile limit", menuId="browser-profiles-add-menu", itemId="browser-profiles-limit", selected=false, check=false, destructive=false, disabled=true, choose=local("browser-profiles-noop", ""))
            box width="100%" height=1 margin-top="0.25rem" margin-bottom="0.25rem" flex-shrink=0 background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
            text "Import from" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)" testId="browser-profiles-import-label"
            when view.sourcesState == "loading"
              SkMenuItem(keysId="browser-profiles-add-menu-keys", label="Looking for browsers…", menuId="browser-profiles-add-menu", itemId="browser-profiles-looking", selected=false, check=false, destructive=false, disabled=true, choose=local("browser-profiles-noop", ""))
            when view.sourcesState == "empty"
              SkMenuItem(keysId="browser-profiles-add-menu-keys", label="No supported browsers found", menuId="browser-profiles-add-menu", itemId="browser-profiles-none", selected=false, check=false, destructive=false, disabled=true, choose=local("browser-profiles-noop", ""))
            when view.sourcesState == "ready"
              each source in view.sources key=source.id
                SkMenuItem(keysId="browser-profiles-add-menu-keys", label=source.name, menuId="browser-profiles-add-menu", itemId=`browser-import-source-${source.id}`, selected=false, check=false, destructive=false, disabled=(not view.canImport), choose=local("browser-import-open", `source=${source.id}`))
              when not view.canImport
                SkMenuItem(keysId="browser-profiles-add-menu-keys", label="Connect to an environment to import cookies", menuId="browser-profiles-add-menu", itemId="browser-profiles-connect", selected=false, check=false, destructive=false, disabled=true, choose=local("browser-profiles-noop", ""))
      // The bordered list groups rows at any width; Incognito is not a row (it holds nothing to manage).
      column margin-top="0.5rem" margin-bottom="0.5rem" margin-left="1rem" margin-right="1rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e899, #ffffff09)" testId="browser-profiles-list"
        // Keyed by the name too, so a rename made elsewhere (the import naming a new profile) resets the field.
        each row in view.rows key=`${row.id}:${row.name}`
          BrowserProfileRow(row=row, view=view, local=local)

// One profile: its name (a rename field for a profile of the user's), the Default badge, and its menu.
component BrowserProfileRow
  props
    row: BrowserProfileRowView
    view: BrowserProfilesView
    local: action
  state draft = row.name
  state menuOver = false
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  action edit(next: string)
    draft = next
  action commit(value: string)
    // DraftInput: an empty name is not saved; the field shows the profile's name again.
    draft = trim(value) == "" ? row.name : value
    local("browser-profiles-rename", `id=${encodeURIComponent(row.id)}&name=${encodeURIComponent(value)}`)
  action menuHover(on: bool)
    menuOver = on
  view
    row width="100%" box-sizing="border-box" min-height="2.625rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="0.75rem" align-items="center" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e4e4e899, #ffffff09)" testId=`browser-profile-row-${row.id}`
      row flex=1 min-width=0 gap="0.5rem" align-items="center"
        when row.builtIn
          text row.name font-size="0.875rem" line-height="1.25rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)" opacity=(view.writesDisabled ? 0.64 : 1)
        else
          input value=draft input=edit change=commit disabled=view.writesDisabled aria-label=`Rename ${row.name}` maxlength=48 autocorrect="off" spellcheck="false" testId=`browser-profile-name-${row.id}` width="100%" max-width="14rem" min-width=0 height="1.75rem" box-sizing="border-box" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" opacity=(view.writesDisabled ? 0.64 : 1)
        when row.isDefault
          text "Default" flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.25rem" padding-right="0.25rem" border-radius="0.375rem" background-color="light-dark(#1b4ed8, #346bf1)" color="#ffffff" opacity=(view.writesDisabled ? 0.64 : 1) testId=`browser-profile-default-${row.id}`
      box position="relative" flex-shrink=0
        button popovertarget=`browser-profile-menu-${row.id}` key=triggerKey focus=keyArm(true) blur=keyArm(false) hover=menuHover disabled=view.writesDisabled aria-label=`${row.name} options` aria-haspopup="menu" testId=`browser-profile-options-${row.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(menuOver and not view.writesDisabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(view.writesDisabled ? 0.64 : 1) title=""
          LucideEllipsisVertical(size=14, color="light-dark(#71717b, #818181)")
        KeyMenuOpen(menuId=`browser-profile-menu-${row.id}`, armed=keyArmed, opened=keyOpened)
        SkPopup(menuId=`browser-profile-menu-${row.id}`, label=`${row.name} options`, width=272, list=false, endAlign=24, items=rowItems(row, view), keyed=keyed)
          SkMenuItem(keysId=`browser-profile-menu-${row.id}-keys`, label="Set as default", menuId=`browser-profile-menu-${row.id}`, itemId=`browser-profile-set-default-${row.id}`, selected=false, check=false, destructive=false, disabled=(not view.hydrated or row.isDefault), choose=local("browser-profiles-default", `id=${encodeURIComponent(row.id)}`))
          SkMenuItem(keysId=`browser-profile-menu-${row.id}-keys`, label="Clear cookies and cache", menuId=`browser-profile-menu-${row.id}`, itemId=`browser-profile-clear-${row.id}`, selected=false, check=false, destructive=false, disabled=(not view.hydrated or not view.removalAvailable), choose=local("browser-profiles-clear", `id=${encodeURIComponent(row.id)}`))
          when not row.builtIn
            SkMenuItem(keysId=`browser-profile-menu-${row.id}-keys`, label="Remove profile and data", menuId=`browser-profile-menu-${row.id}`, itemId=`browser-profile-remove-${row.id}`, selected=false, check=false, destructive=true, disabled=(not view.hydrated or not view.removalAvailable), choose=local("browser-profiles-remove-ask", `id=${encodeURIComponent(row.id)}`))
          when not view.removalAvailable
            box width="100%" height=1 margin-top="0.25rem" margin-bottom="0.25rem" flex-shrink=0 background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
            SkMenuItem(keysId=`browser-profile-menu-${row.id}-keys`, label=view.removalNote, menuId=`browser-profile-menu-${row.id}`, itemId=`browser-profile-note-${row.id}`, selected=false, check=false, destructive=false, disabled=true, choose=local("browser-profiles-noop", ""))

// The row menu's keyboard stops: its enabled rows in order.
fn rowItems(row: BrowserProfileRowView, view: BrowserProfilesView): list<KmItem> = view.hydrated and view.removalAvailable ? (row.builtIn ? (row.isDefault ? [KmItem(id=`browser-profile-clear-${row.id}`, label="Clear cookies and cache")] : [KmItem(id=`browser-profile-set-default-${row.id}`, label="Set as default"), KmItem(id=`browser-profile-clear-${row.id}`, label="Clear cookies and cache")]) : (row.isDefault ? [KmItem(id=`browser-profile-clear-${row.id}`, label="Clear cookies and cache"), KmItem(id=`browser-profile-remove-${row.id}`, label="Remove profile and data")] : [KmItem(id=`browser-profile-set-default-${row.id}`, label="Set as default"), KmItem(id=`browser-profile-clear-${row.id}`, label="Clear cookies and cache"), KmItem(id=`browser-profile-remove-${row.id}`, label="Remove profile and data")])) : (view.hydrated and not row.isDefault ? [KmItem(id=`browser-profile-set-default-${row.id}`, label="Set as default")] : [])

// "Remove “<name>”?" (AlertDialog, destructive), and the import wizard while one is open.
component BrowserProfileDialogs
  props
    view: BrowserProfilesView
    local: action
    still: bool
  action cancelRemoval
    if not view.removalBusy
      local("browser-profiles-remove-cancel", "")
  view
    when view.removalOpen
      column class=BpOverlay testId="browser-profile-remove-overlay"
        column class=BpPopup role="alertdialog" aria-modal=true aria-label=`Remove “${view.removalName}”?` testId="browser-profile-remove-dialog"
          column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
            text `Remove “${view.removalName}”?` font-size="1.25rem" font-weight=600 line-height="1.5rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
            text "Its cookies and logins are deleted. Tabs already open in this profile stay open until you close them." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #8f8f8f)"
            when view.removalError != ""
              text view.removalError font-size="0.875rem" line-height="1.25rem" color="light-dark(#e7000b, #ff6467)" aria-live="polite" testId="browser-profile-remove-error"
            when not view.removalAvailable
              text "Connect to an environment to remove this profile and its data." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #8f8f8f)"
          row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
            BiButton(buttonId="browser-profile-remove-cancel", label="Cancel", tone="outline", disabled=view.removalBusy, keys="Escape", first=true, press=cancelRemoval)
            BiButton(buttonId="browser-profile-remove-confirm", label=(view.removalBusy ? "Removing…" : "Remove profile"), tone="destructive", disabled=(view.removalBusy or not view.hydrated or not view.removalAvailable), keys="", first=false, press=local("browser-profiles-remove", ""))
    when view.wizard.open
      BrowserImportWizard(wizard=view.wizard, local=local, still=still)

// BrowserImportWizard: one screen per step; every screen is a place the user can act from.
component BrowserImportWizard
  props
    wizard: BrowserImportWizardView
    local: action
    still: bool
  view
    column class=BpOverlay testId="browser-import-overlay"
      column class=BpPopup role="dialog" aria-modal=true aria-label=(wizard.step == "quit" ? `Quit ${wizard.sourceName} to import` : wizard.step == "configure" ? `Import from ${wizard.sourceName}` : wizard.step == "fullDiskAccess" ? `Let T3 Code read ${wizard.sourceName}’s cookies` : wizard.step == "importing" ? "Importing cookies" : wizard.step == "checking" ? `Checking ${wizard.sourceName}` : wizard.step == "done" ? wizard.doneTitle : `Couldn’t import from ${wizard.sourceName}`) testId=`browser-import-step-${wizard.step}`
        when wizard.step == "quit"
          BiHeader(title=`Quit ${wizard.sourceName} to import`, description=`${wizard.sourceName} is open, so its cookies can’t be read yet. Quit it, then continue.`)
          BiFooter()
            BiButton(buttonId="browser-import-cancel", label="Cancel", tone="outline", disabled=false, keys="Escape", first=false, press=local("browser-import-close", ""))
            BiButton(buttonId="browser-import-quit", label="I’ve quit it", tone="default", disabled=false, keys="", first=true, press=local("browser-import-quit", ""))
        when wizard.step == "fullDiskAccess"
          BiHeader(title=`Let T3 Code read ${wizard.sourceName}’s cookies`, description=`To import cookies from ${wizard.sourceName}, T3 Code needs Full Disk Access. Turn it on in System Settings, then come back to finish the import — you can revoke it again once the import is done.`)
          column padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1rem" box-sizing="border-box"
            // PermissionChecklist: the permission's row with Allow, or "Allowed" once granted.
            row gap="0.75rem" align-items="center" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" testId="browser-import-fda-row"
              LucideHardDrive(size=32, color="light-dark(#71717b, #818181)")
              column flex=1 min-width=0
                text "Full Disk Access" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
                text `Read ${wizard.sourceName}'s cookies for this import.` font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              when wizard.fdaGranted
                row gap="0.25rem" align-items="center" role="status" testId="browser-import-fda-allowed"
                  LucideCheck(size=16, color="light-dark(#008236, #05df72)")
                  text "Allowed" font-size="0.75rem" line-height="1rem" color="light-dark(#008236, #05df72)"
              else
                button press=local("browser-import-fda-allow", "") disabled=wizard.fdaBusy testId="browser-import-fda-allow" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" opacity=(wizard.fdaBusy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
                  text "Allow" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
            when not wizard.fdaGranted
              text wizard.fdaNote margin-top="0.75rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="status" testId="browser-import-fda-note"
          BiFooter()
            BiButton(buttonId="browser-import-cancel", label="Cancel", tone="outline", disabled=false, keys="Escape", first=true, press=local("browser-import-close", ""))
            BiButton(buttonId="browser-import-fda-continue", label="Continue", tone="default", disabled=(not wizard.fdaGranted or wizard.fdaBusy), keys="", first=false, press=local("browser-import-fda-continue", ""))
        when wizard.step == "configure"
          BiHeader(title=`Import from ${wizard.sourceName}`, description=`Choose which cookies to import for ${wizard.environmentName}.`)
          column padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1rem" box-sizing="border-box" gap="0.75rem"
            row gap="1rem" align-items="center"
              column flex=1 min-width=0 gap="0.5rem" testId="browser-import-from"
                text "FROM" font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.025rem" color="light-dark(#71717b, #818181)"
                each tile in wizard.from key=tile.key
                  BiTile(tile=tile, press=local("browser-import-from", `directory=${encodeURIComponent(tile.key)}`))
              box flex-shrink=0 display="flex" align-items="center" justify-content="center"
                svg width="1rem" height="1rem" viewBox="0 0 24 24" color="light-dark(#71717b, #818181)" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                  path d="M5 12h14M12 5l7 7-7 7"
              column flex=1 min-width=0 gap="0.5rem" testId="browser-import-into"
                text "INTO" font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.025rem" color="light-dark(#71717b, #818181)"
                each tile in wizard.into key=tile.key
                  BiTile(tile=tile, press=local("browser-import-into", `target=${encodeURIComponent(tile.key == "new" ? "new" : slice(tile.key, 9))}`))
            when wizard.feedback != ""
              text wizard.feedback font-size="0.875rem" line-height="1.25rem" color="light-dark(#e7000b, #ff6467)" role="alert" testId="browser-import-feedback"
          BiFooter()
            BiButton(buttonId="browser-import-cancel", label="Cancel", tone="outline", disabled=false, keys="Escape", first=false, press=local("browser-import-close", ""))
            BiButton(buttonId="browser-import-run", label="Import", tone="default", disabled=wizard.importDisabled, keys="", first=true, press=local("browser-import-run", ""))
        when wizard.step == "importing" or wizard.step == "checking"
          BiHeader(title=(wizard.step == "importing" ? "Importing cookies" : `Checking ${wizard.sourceName}`), description=(wizard.step == "importing" ? "This may take a moment." : wizard.check == "fullDiskAccess" ? "Checking Full Disk Access." : "Checking whether the browser has closed."))
          row gap="0.75rem" align-items="center" padding-left="1.5rem" padding-right="1.5rem" padding-top="0.5rem" padding-bottom="1.5rem" box-sizing="border-box"
            box width="1.25rem" height="1.25rem" display="flex" animation=(still ? "none" : "bpSpin 1s linear infinite") testId="browser-import-spinner"
              R4Glyph(name="loader-circle", size=20, color="light-dark(#71717b, #818181)")
            text (wizard.step == "importing" ? "Importing…" : wizard.check == "fullDiskAccess" ? "Checking access…" : "Checking…") font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        when wizard.step == "done"
          BiHeader(title=wizard.doneTitle, description=wizard.doneDescription)
          when wizard.skipped != ""
            column padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1rem" box-sizing="border-box" gap="0.25rem" testId="browser-import-skipped"
              text "SKIPPED" font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.025rem" color="light-dark(#71717b, #818181)"
              text wizard.skipped font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          BiFooter()
            BiButton(buttonId="browser-import-done", label="Done", tone="default", disabled=false, keys="Escape", first=true, press=local("browser-import-close", ""))
        when wizard.step == "blocked"
          BiHeader(title=`Couldn’t import from ${wizard.sourceName}`, description=wizard.blockedText)
          BiFooter()
            BiButton(buttonId="browser-import-close", label="Close", tone="outline", disabled=false, keys="Escape", first=true, press=local("browser-import-close", ""))
            when wizard.retry
              BiButton(buttonId="browser-import-retry", label="Try again", tone="default", disabled=false, keys="", first=false, press=local("browser-import-retry", ""))
        when wizard.canClose
          BiClose(press=local("browser-import-close", ""))

component BiHeader
  props
    title: string
    description: string
  view
    column gap="0.5rem" padding="1.5rem" padding-right="3rem" box-sizing="border-box"
      text title font-size="1.25rem" font-weight=600 line-height="1.5rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="browser-import-title"
      text description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #8f8f8f)" testId="browser-import-description"

component BiFooter
  slot
  view
    row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
      children

// A footer button (ui/button): outline, default (primary) or destructive, 64% while disabled.
component BiButton
  props
    buttonId: string
    label: string
    tone: string
    disabled: bool
    keys: string
    first: bool
    press: action
  view
    button id=buttonId press=press disabled=disabled autofocus=first aria-keyshortcuts=keys testId=buttonId display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 box-shadow="0 1px 2px #0000000d" opacity=(disabled ? 0.64 : 1) border-color=(tone == "outline" ? "light-dark(#d4d4d8, #ffffff14)" : tone == "destructive" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#1b4ed8, #346bf1)") background-color=(tone == "outline" ? "light-dark(#ffffff, #ffffff07)" : tone == "destructive" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#1b4ed8, #346bf1)")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" color=(tone == "outline" ? "light-dark(#27272a, #f5f5f5)" : "#ffffff")

// DialogPopup's Close (ghost icon button, top right).
component BiClose
  props
    press: action
  view
    button press=press aria-label="Close" testId="browser-import-x" position="absolute" right="0.5rem" top="0.5rem" width="2rem" height="2rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
      LucideX(size=16, color="light-dark(#71717b, #818181)")

// SelectableTile: a name, an optional detail line, and a check; the primary border and tint when selected.
component BiTile
  props
    tile: WizardTileView
    press: action
  state over = false
  action hover(on: bool)
    over = on
  view
    button press=press hover=hover aria-pressed=tile.selected testId=`browser-import-tile-${tile.key}` display="flex" flex-direction="row" align-items="center" justify-content="space-between" gap="0.75rem" width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=(tile.selected ? "light-dark(#1b4ed8, #346bf1)" : over ? "light-dark(#e4e4e7, #ffffff14)" : "light-dark(#e4e4e799, #ffffff0a)") background-color=(tile.selected ? "light-dark(#1b4ed814, #346bf114)" : over ? "light-dark(#f4f4f566, #ffffff0a)" : "#00000000")
      column flex=1 min-width=0 align-items="flex-start"
        text tile.title max-width="100%" font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" color="light-dark(#27272a, #f5f5f5)"
        when tile.subtitle != ""
          text tile.subtitle max-width="100%" font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      box width="1rem" height="1rem" flex-shrink=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(tile.selected ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff26)") background-color=(tile.selected ? "light-dark(#1b4ed8, #346bf1)" : "#00000000") display="flex" align-items="center" justify-content="center"
        when tile.selected
          LucideCheck(size=10, color="#ffffff")
