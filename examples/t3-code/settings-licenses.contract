// Settings → Open source licenses (reference OpenSourceLicenses.tsx): the
// connected server's third-party manifest, filterable, one collapsible notice
// per entry. The manifest is the T3 server's; nothing here lists this client's
// own dependencies.
use LicenseSettings from "./shapes.contract"
use SettingsNotice from "./settings-kit.contract"
use LucideSearch from "./settings-icons.contract"
use LucideChevronRight from "./settings-icons.contract"
use LucideExternalLink from "./settings-icons.contract"

component NoticesPanel
  props
    data: LicenseSettings
    query: string
    searchOpen: bool
    edit: action
    openSearch: action
    closeSearch: action
    searchKey: action
    toggle: action
    retry: action
  view
    column width="100%" gap="0.625rem" testId="licenses-settings"
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" justify-content="space-between" gap="1rem" box-sizing="border-box"
        text "Third-party notices" font-size="0.875rem" line-height="1.25rem" color="light-dark(#262629b3, #f5f5f5b3)" role="heading" aria-level=2
        when data.ready
          row align-items="center" gap=(searchOpen ? "0.5rem" : "0.375rem")
            text (data.matched == data.total ? `${data.total} notices` : `${data.matched} of ${data.total}`) font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="license-count"
            when not searchOpen
              button press=openSearch aria-label="Search open-source licenses" id="open-license-search" testId="open-license-search" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                LucideSearch(size=12, color="light-dark(#71717b, #818181)")
            when searchOpen
              row width="11rem" height="1.75rem" align-items="center" gap="0.375rem" box-sizing="border-box" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)"
                LucideSearch(size=12, color="light-dark(#71717b, #818181)")
                input value=query input=edit key=searchKey blur=closeSearch placeholder="Search licenses" aria-label="Search open-source licenses" testId="license-search" flex=1 min-width=0 height="1.5rem" padding=0 position="relative" top="0.21875rem" line-height="1.5rem" border-width=0 background-color="#00000000" font-size="0.8125rem" color="light-dark(#27272a, #f5f5f5)"
      column width="100%" box-sizing="border-box" border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
        when data.error != ""
          column align-items="flex-start" gap="0.75rem" padding-left="1rem" padding-right="1rem" padding-top="1.25rem" padding-bottom="1.25rem" box-sizing="border-box"
            column gap="0.25rem"
              text "Open-source notices are unavailable" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              text data.error font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" role="alert" testId="license-load-error"
            button press=retry testId="retry-license-load" display="flex" flex-direction="row" align-items="center" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
              text "Try again" font-size="0.75rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        when data.error == "" and not data.ready
          text "Loading open-source notices…" font-size="0.875rem" line-height="1.5rem" padding-left="1rem" padding-right="1rem" padding-top="1.25rem" padding-bottom="1.25rem" color="light-dark(#71717b, #818181)" role="status" testId="license-loading"
        when data.ready
          column width="100%" box-sizing="border-box"
            when length(data.entries) == 0
              text "No licenses match that search." font-size="0.875rem" line-height="1.5rem" text-align="center" padding-top="2rem" padding-bottom="2rem" color="light-dark(#71717b, #818181)" testId="license-no-matches"
            each entry in data.entries key=entry.id
              column width="100%"
                row min-height="2.25rem" align-items="center" width="100%"
                  button press=toggle(entry.id) aria-expanded=entry.expanded testId=`license-${entry.id}` display="flex" flex-direction="row" align-items="center" gap="0.625rem" flex=1 min-width=0 min-height="2.25rem" padding-left="1rem" padding-right="1rem" border-width=0 background-color="#00000000" justify-content="flex-start"
                    box transform=(entry.expanded ? "rotate(90deg)" : "none")
                      LucideChevronRight(size=14, color="light-dark(#71717b, #818181)")
                    row flex=1 min-width=0 gap="0.5rem" align-items="baseline"
                      text entry.name font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
                      when entry.version != ""
                        text entry.version font-family="monospace" font-size="0.75rem" line-height="1rem" flex-shrink=0 color="light-dark(#71717b, #818181)"
                    text `${entry.license} · ${entry.bundles}` font-size="0.75rem" line-height="1rem" max-width="42%" flex-shrink=0 line-clamp=1 color="light-dark(#71717b, #818181)"
                  when entry.sourceUrl != ""
                    link cursor="pointer" href=entry.sourceUrl aria-label=`View project source for ${entry.name}` title="Project source" testId=`license-source-${entry.id}` width="1.25rem" height="1.25rem" margin-right="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0 border-radius="0.25rem"
                      LucideExternalLink(size=12, color="light-dark(#71717b, #818181)")
                when entry.expanded
                  text entry.noticeText font-family="monospace" font-size="0.75rem" line-height="1.25rem" white-space="pre-wrap" overflow-wrap="anywhere" max-width="45.625rem" padding-left="2.5rem" padding-right="2.5rem" padding-top="0.25rem" padding-bottom="1rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="license-notice-text"
