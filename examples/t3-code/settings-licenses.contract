// Settings → Open source licenses (reference OpenSourceLicenses.tsx): the
// connected server's third-party manifest, filterable, one collapsible notice
// per entry. The manifest is the T3 server's; nothing here lists this client's
// own dependencies.
use LicenseSettings from "./shapes.contract"
use SettingsNotice from "./settings-kit.contract"
use LucideSearch from "./settings-icons.contract"
use LucideChevronRight from "./settings-icons.contract"
use LucideExternalLink from "./settings-icons.contract"

component NoticesPanel
  props
    data: LicenseSettings
    query: string
    searchOpen: bool
    edit: action
    openSearch: action
    closeSearch: action
    searchKey: action
    toggle: action
    retry: action
  view
    column width="100%" gap=10 testId="licenses-settings"
      row min-height=28 padding-left=16 padding-right=16 align-items="center" justify-content="space-between" gap=16 box-sizing="border-box"
        text "Third-party notices" font-size=14 line-height="20px" color="light-dark(#262629b3, #f5f5f5b3)" role="heading" aria-level=2
        when data.ready
          row align-items="center" gap=(searchOpen ? 8 : 6)
            text (data.matched == data.total ? `${data.total} notices` : `${data.matched} of ${data.total}`) font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" testId="license-count"
            when not searchOpen
              button press=openSearch aria-label="Search open-source licenses" id="open-license-search" testId="open-license-search" width=20 height=20 padding=0 border-width=0 border-radius=4 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                LucideSearch(size=12, color="light-dark(#71717b, #818181)")
            when searchOpen
              row width=176 height=28 align-items="center" gap=6 box-sizing="border-box" padding-left=9 padding-right=9 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)"
                LucideSearch(size=12, color="light-dark(#71717b, #818181)")
                input value=query input=edit key=searchKey blur=closeSearch placeholder="Search licenses" aria-label="Search open-source licenses" testId="license-search" flex=1 min-width=0 height=24 padding=0 position="relative" top=3.5 line-height="24px" border-width=0 background-color="#00000000" font-size=13 color="light-dark(#27272a, #f5f5f5)"
      column width="100%" box-sizing="border-box" border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
        when data.error != ""
          column align-items="flex-start" gap=12 padding-left=16 padding-right=16 padding-top=20 padding-bottom=20 box-sizing="border-box"
            column gap=4
              text "Open-source notices are unavailable" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              text data.error font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" role="alert" testId="license-load-error"
            button press=retry testId="retry-license-load" display="flex" flex-direction="row" align-items="center" height=24 padding-left=7 padding-right=7 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
              text "Try again" font-size=12 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        when data.error == "" and not data.ready
          text "Loading open-source notices…" font-size=14 line-height="24px" padding-left=16 padding-right=16 padding-top=20 padding-bottom=20 color="light-dark(#71717b, #818181)" role="status" testId="license-loading"
        when data.ready
          column width="100%" box-sizing="border-box"
            when length(data.entries) == 0
              text "No licenses match that search." font-size=14 line-height="24px" text-align="center" padding-top=32 padding-bottom=32 color="light-dark(#71717b, #818181)" testId="license-no-matches"
            each entry in data.entries key=entry.id
              column width="100%"
                row min-height=36 align-items="center" width="100%"
                  button press=toggle(entry.id) aria-expanded=entry.expanded testId=`license-${entry.id}` display="flex" flex-direction="row" align-items="center" gap=10 flex=1 min-width=0 min-height=36 padding-left=16 padding-right=16 border-width=0 background-color="#00000000" justify-content="flex-start"
                    box transform=(entry.expanded ? "rotate(90deg)" : "none")
                      LucideChevronRight(size=14, color="light-dark(#71717b, #818181)")
                    row flex=1 min-width=0 gap=8 align-items="baseline"
                      text entry.name font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
                      when entry.version != ""
                        text entry.version font-family="monospace" font-size=12 line-height="16px" flex-shrink=0 color="light-dark(#71717b, #818181)"
                    text `${entry.license} · ${entry.bundles}` font-size=12 line-height="16px" max-width="42%" flex-shrink=0 line-clamp=1 color="light-dark(#71717b, #818181)"
                  when entry.sourceUrl != ""
                    link cursor="pointer" href=entry.sourceUrl aria-label=`View project source for ${entry.name}` title="Project source" testId=`license-source-${entry.id}` width=20 height=20 margin-right=16 display="flex" align-items="center" justify-content="center" flex-shrink=0 border-radius=4
                      LucideExternalLink(size=12, color="light-dark(#71717b, #818181)")
                when entry.expanded
                  text entry.noticeText font-family="monospace" font-size=12 line-height="20px" white-space="pre-wrap" overflow-wrap="anywhere" max-width=730 padding-left=40 padding-right=40 padding-top=4 padding-bottom=16 color="light-dark(#27272acc, #f5f5f5cc)" testId="license-notice-text"
