// Lane r7-handoff (MIT reference, see LICENSE-T3, upstream f90b77d809): the composer context
// strip's pull request badge, ThreadPullRequestBadgeControl rendered as a ComposerControl
// size="xs" before the branch trigger (BranchToolbarBranchSelector, toolbar mode;
// r7-handoff-strip.ts). The control is 24pt high, px-1.75 inside a 1pt transparent border,
// gap-1; the badge is the state glyph (size-3, [&_svg]:-mx-0.5) and the number in text-xs
// tabular-nums, both in the state's tone. A single pull request is a link to it; a stack or
// several links open the thread's Pull requests tab. The tooltip (side top, offset 0, glass,
// w-80) is ThreadPullRequestsMiniList, or the one pull request.
use PgIcon from "./pages-icons.contract"
use prdTone from "./pages-pr-detail.contract"

shape StripPrTip
  key: string
  number: string
  title: string
  icon: string
  state: string
  url: string
  target: string
  depth: number
  stack: string

fn r7Muted(): string = "light-dark(#71717b, #818181)"
fn r7Tone(lifecycle: string): string = lifecycle == "" ? r7Muted() : prdTone(lifecycle)

component StripPrBadge
  props
    text: string
    icon: string
    tone: string
    label: string
    list: bool
    url: string
    target: string
    tips: list<StripPrTip>
    disabled: bool
    command: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" flex-shrink=0 display="flex"
      when list
        button press=command("chatlocal:surface-open", "pull-requests", "", 0) disabled=disabled border-width=0 hover=hover aria-label=label testId="composer-pr-badge" height=24 padding-left=8 padding-right=8 gap=4 box-sizing="border-box" border-radius=8 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
            PgIcon(name=icon, size=12, color=r7Tone(tone))
          text text font-size=12 line-height="16px" font-variant-numeric="tabular-nums" white-space="nowrap" color=r7Tone(tone)
      when not list and target != ""
        button press=command("chatlocal:surface-r5-pr-open", target, url, 0) disabled=disabled border-width=0 hover=hover aria-label=label testId="composer-pr-badge" height=24 padding-left=8 padding-right=8 gap=4 box-sizing="border-box" border-radius=8 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
            PgIcon(name=icon, size=12, color=r7Tone(tone))
          text text font-size=12 line-height="16px" font-variant-numeric="tabular-nums" white-space="nowrap" color=r7Tone(tone)
      when not list and target == ""
        link href=url text-decoration-line="none" hover=hover aria-label=label testId="composer-pr-badge" height=24 padding-left=8 padding-right=8 gap=4 box-sizing="border-box" border-radius=8 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
            PgIcon(name=icon, size=12, color=r7Tone(tone))
          text text font-size=12 line-height="16px" font-variant-numeric="tabular-nums" white-space="nowrap" color=r7Tone(tone)
      // The glass tooltip centred above the badge with no offset (side top, sideOffset 0): 320 wide, py-1 px-2.
      row position="absolute" bottom=24 left=-200 right=-200 justify-content="center" pointer-events="none" z-index=140
        column width=320 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 box-sizing="border-box" gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffeb, #121212eb)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" opacity=(over ? 1 : 0) transition=(over ? "opacity 150ms ease 600ms" : "opacity 0ms") role="tooltip" aria-hidden=(not over) testId=(over ? "composer-pr-tip" : "composer-pr-tip-hidden")
          each tip in tips key=tip.key
            row min-width=0 gap=8 align-items="center" padding-left=(4 + tip.depth * 12) padding-right=4 padding-top=4 padding-bottom=4 border-radius=4 height=24.5 box-sizing="border-box"
              PgIcon(name=tip.icon, size=12, color=r7Tone(tip.state))
              text tip.number flex-shrink=0 font-family="ui-monospace" font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
              text tip.title flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size=12 line-height="16px" color="light-dark(#27272abf, #f5f5f5bf)"
              when tip.stack != ""
                text tip.stack flex-shrink=0 padding-left=4 font-size=10 line-height="14px" color="light-dark(#27272a, #f5f5f5)"
