// Lane r12-threads: the right panel's tab strip scroll (r12-threads-tabs.ts; T3 Code, MIT, see
// LICENSE-T3: RightPanelTabs.tsx).

// The strip's geometry: whether its tabs overflow, the viewport width, the furthest scroll, and
// the active tab's span within the content row.
shape R12TabStrip
  overflow: bool
  view: number
  content: number
  max: number
  activeLeft: number
  activeRight: number
  serial: number // active-tab changes; the strip scrolls the new one into view once

// "Scroll panel tabs": two ghost icon-xs buttons (24pt, rounded 8, 14pt chevrons in the muted
// icon colour), disabled at 64% at their end of the strip.
component R12TabScroll
  props
    canLeft: bool
    canRight: bool
    left: action
    right: action
  view
    row flex-shrink=0 gap="0.125rem" align-items="center" role="group" aria-label="Scroll panel tabs" testId="panel-tab-scroll-buttons"
      R12TabScrollButton(label="Scroll tabs left", geometry="M15 18l-6-6 6-6", enabled=canLeft, press=left, testId="panel-tabs-left")
      R12TabScrollButton(label="Scroll tabs right", geometry="M9 18l6-6-6-6", enabled=canRight, press=right, testId="panel-tabs-right")

component R12TabScrollButton
  props
    label: string
    geometry: string
    enabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=(not enabled) aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(enabled ? 1 : 0.64) background-color=(over and enabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
      svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="light-dark(#71717b, #a1a1a1)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
        path d=geometry
