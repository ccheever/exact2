// The details card's pull request rows, the right panel's
// "pull-request" surface reference and a sent attachment's preview, as
// r5-panels-pr.ts and r5-panels-attach.ts answer them.
use CodeHighlight from "./markdown.contract"
use MarkdownEnv from "./markdown.contract"
use MarkdownSource from "./markdown.contract"
use MermaidDiagram from "./markdown.contract"
use AttachmentUrl from "./timeline-attachments.contract"
use R6PrExtra from "./r6-pr-shapes.contract"
use R6MergeAsk from "./r6-pr-shapes.contract"

shape R5CodeRun
  id: string
  text: string
  syntax: string
shape R5CodeLine
  id: string
  number: string
  runs: R5CodeRun[]
shape R5TableRow
  id: string
  header: bool
  cells: R5CodeRun[]
shape R5PrRow
  key: string
  label: string
  tooltip: string
  icon: string
  state: string
  tinted: bool
  target: string
  url: string
  aria: string
  split: bool
  checks: string
  checksCount: string
  checksAria: string
  action: string
  actionTarget: string
  actionLabel: string
  actionTooltip: string
  actionDisabled: bool
  r6: R6PrExtra
shape R5PrRows
  show: bool
  rows: R5PrRow[]
  rest: R5PrRow[]
  moreLabel: string
  expanded: bool
  merge: R6MergeAsk
shape R5PrSurface
  selected: string
  number: number
  label: string
shape R5Attachment
  id: string
  // The first crumb: "Attachment", or "Draft" for a composer file chip's preview, which also has Remove from draft and Close.
  origin: string
  canRemove: bool
  canClose: bool
  name: string
  size: string
  preview: string
  error: string
  canRender: bool
  rendered: bool
  renderLabel: string
  renderIcon: string
  showWrap: bool
  wrap: bool
  canCopy: bool
  copyLabel: string
  copied: bool
  canSave: bool
  saving: bool
  saveLabel: string
  truncatedNote: string
  table: R5TableRow[]
  lines: R5CodeLine[]
  gutter: number
  url: string
  noPreview: string
  // The rendered Markdown is ChatMarkdown, as Files' (R4Files): app.contract's filesMarkdown
  // answers markdownSource (kind "attachment"); md, code, diagrams, mdUrls and Copy code's check as the transcript's.
  markdownSource: MarkdownSource[]
  md: MarkdownEnv
  code: CodeHighlight[]
  diagrams: MermaidDiagram[]
  mdUrls: AttachmentUrl[]
  codeCopied: string
  codeCopyNonce: number
// A composer file chip's preview (composer-chip-file.ts): open while its draft file is in the open draft.
shape ComposerFilePreview
  open: bool
  file: R5Attachment
