    projectsSettings: ProjectsPage
    settingsThemeSubject: string
    coreThemeChange: action
    coreThemeLive: action
    welcome: WelcomeView
    welcomeStep: string
    welcomeLink: string
    welcomePairOpen: bool
    welcomeGo: action
