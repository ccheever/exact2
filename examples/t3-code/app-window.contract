    providerWizard: ProviderWizard
    acpAgents: AcpRegistry
    wizardStep: number
    wizardLabelSet: bool
    wizardLabel: string
    wizardIdSet: bool
    wizardId: string
    acpQuery: string
    wizardManual: bool
    providerAddRoot: action
    providerTarget: string
    catalog: PickerCatalog
    modelQuery: string
    modelTarget: PickerTarget
    closeModels: action
    searchModels: action
    paletteOpen: bool
    palette: PaletteView
    paletteQuery: string
    paletteHighlight: number
    paletteScroll: number
    paletteBusy: bool
    paletteEdit: action
    paletteKey: action
    paletteHover: action
    paletteClose: action
    paletteFlag: action
    answerRevert: action
    confirmTitle: string
    confirmBody: string
    confirmDestructive: bool
    confirmUi: action
    toastHover: bool
    toastHovering: action
    toastAct: action
    sshResponding: bool
    sshAnswer: action
    providerAuthPending: bool
    // fix-hover-cards: the root's hover clock (hover-layer.contract).
    hoverWait: number
    hoverHold: action
    composerFocused: bool
    settingsEnvironmentId: string
    settingsProjectId: string
    clearModalError: action
    titleSend: action
  provide
    rem = data.look.fontSize
    still = viewport.prefersReducedMotion
    hoverTipAt
    hoverTip
    hoverShown
    linkOpen
  // browser-surface part 5: a link that follows "Open links in" (browser-links.ts `openLinkFromUi`): a Markdown link
  // ("link": ⌘ or Ctrl held opens the default browser), a check's details or the published repository ("button").
  action linkOpen(kind: string, href: string)
    chatLocal("link-open", kind, href)
  // fix-hover-cards: the hover layer's tooltip or card (hover-layer.contract). It shows once its trigger has had the
  // pointer for its open delay (Base UI's delay, hoverOpenDelay; nothing is drawn before it, so a card still waiting
  // takes no press) while the trigger or the card has it (hoverOn), then a card for its closeDelay (hoverDelay), so the
  // pointer can cross into it. The clock stops where it opens (hoverOpen): a surface change, which moves it past, ends a
  // tip whose trigger went with no leave. A close blocks it until the pointer enters again (Base UI's blockMouseMove).
  state hoverTip = noHoverTip()
  state hoverOn = ""
  state hoverOpen = 0
  state hoverUntil = 0
  derive hoverShown = hoverTip.key != "" and (hoverOn != "" ? hoverWait == hoverOpen : hoverWait < hoverUntil)
  action hoverTipAt(tip: HoverTip, part: string, inside: bool)
    if inside
      let at = tip.key == hoverTip.key and hoverShown ? hoverWait : hoverWait + hoverOpenDelay(tip.kind)
      hoverTip = tip
      hoverOn = part
      hoverOpen = at
      hoverHold(at)
    else if tip.key == hoverTip.key and hoverOn == part
      let until = hoverShown ? hoverWait + hoverDelay(tip.kind) : hoverWait
      hoverOn = ""
      hoverUntil = until
      hoverHold(until)
  // popover-escape-parity: primary presses anywhere in the window outside the Usage page (which takes its
  // own, pages-usage.contract pressDown), counted as they end; a pinned usage popover closes on one, as
  // Base UI's outside press does (the sidebar, the theme editor, a toast all count).
  state outsideDown = false
  state outsidePresses = 0
  action outsidePressDown(e: PointerEvent)
    outsideDown = e.buttons == 1
  action outsidePressUp
    outsidePresses = outsideDown ? outsidePresses + 1 : outsidePresses
    outsideDown = false
  // A press in a text field reaches no node's pointerdown on macOS (the field editor takes it), so the
  // floating theme editor's fields count the focus a press gives them instead.
  action outsideFocus
    outsidePresses = outsidePresses + 1
  // The root rewrite (20261008-app-contract-root-rewrite): the sidebar's hover card geometry, its list's scroll
  // offset and a row drag, moved from app.contract. The sidebars are drawn in `when` arms (legacy, dark, light),
  // so the window keeps their state. sidebarHoverId stays in the root: openSettings and openPage close the card.
  state sidebarHoverLast = ""
  state sidebarHoverY = 0 // the hovered row's frame in the window (r5-shell: less the list's scroll)
  state sidebarHoverH = 0
  state sidebarScrollY = 0
  state dragId = ""
  state dragSection = ""
  state dragDx = 0
  state dragDy = 0
  state dragX0 = 0
  state dragY0 = 0
  state dragW = 0
  state dragH = 0
  state dragTopY = 0
  state dragDividerY = 0
  state dragWorkingY = 0
  state dragSnoozedY = 0
  state dragSettledY = 0
  derive dragCX = dragX0 + dragW / 2 + dragDx
  derive dragCY = dragY0 + dragH / 2 + dragDy
  derive dragTarget = dragId == "" ? "" : (dragCX > sidebarWidth ? "context" : (dragSettledY > 0 and dragCY >= dragSettledY ? "settled" : (dragSnoozedY > 0 and dragCY >= dragSnoozedY ? "snoozed" : (dragWorkingY > 0 and dragCY >= dragWorkingY ? "working" : (dragCY < dragDividerY + 36 ? "pinned" : "active")))))
  derive dragVerb = (dragTarget == "" or dragTarget == dragSection or dragTarget == "working" or dragTarget == "snoozed" or dragTarget == "context") ? "" : (dragTarget == "pinned" ? "pin" : (dragTarget == "settled" ? "settle" : (dragSection == "pinned" ? "unpin" : (dragSection == "settled" ? "unsettle" : "wake"))))
  derive dragOffset = dragDy - (dragSection == "pinned" ? 24 : (dragSection == "active" ? 48 : 0))
  // The root rewrite: the sidebar's own local ops, through the root's command dispatch (`sidebar` and `search`
  // send localChanged there), moved from app.contract.
  action toggleSidebar
    command("sidebar", "", data.sidebarOpen ? "closed" : "open", 0)
  action finishResize(vx: number, vy: number)
    command("sidebar", "", "open", sidebarWidth)
  action search(value: string)
    command("search", "", value, 0)
  // The root rewrite: the composer's resting state and left edge, which only the view reads (moved from app.contract).
  derive canRest = data.composerCollapseOnScroll and data.threadId != "" and not composerFocused and not includes(composerText, "\n") and length(data.approvals) == 0 and length(data.questions) == 0 and not data.settled
  derive resting = data.composerResting and canRest
  derive composerLeft = (data.sidebarOpen ? sidebarWidth : 0) + (canvas.ready ? canvas.left : (conversationWidth - min(data.look.chatMax, conversationWidth - 2.5 * data.look.fontSize)) / 2) // the chat lane (chat-canvas-view.ts)
  // The root rewrite: whether Add provider has tried to go past an invalid id (AddProviderDialog shows its error),
  // moved from app.contract. The wizard's fields stay in the root: providerWizard reads them.
  state wizardAttempted = false
  action providerUi(what: string, value: string)
    let target = value == "back" ? max(0, wizardStep - 1) : min(wizardManual ? 1 : 2, value == "next" ? wizardStep + 1 : (value == "2" ? 2 : (value == "1" ? 1 : 0)))
    if what == "open" or what == "driver" or what == "manual"
      wizardAttempted = false
    if what == "step" and wizardStep <= 1 and target > 1 and providerWizard.idError != ""
      wizardAttempted = true
    providerUiRoot(what, value)
  action providerAdd(driver: string, label: string, id: string, accent: string, f0: string, f1: string, f2: string, f3: string, f4: string)
    wizardAttempted = true
    providerAddRoot(driver, label, id, accent, f0, f1, f2, f3, f4)
  // The root rewrite: the settings editors' row menu and dialog label (Settings' panels and ProjectDialogs), moved
  // from app.contract. A settings editor's command is the root's restRaw; rest and restInput name its op and scope.
  state restLabel = ""
  state restMenu = ""
  action restOpen(editor: string, subject: string, label: string)
    restLabel = label
    restMenu = ""
    restOpenRoot(editor, subject)
  action restMenuOpen(id: string)
    restMenu = id
  action restClose
    restMenu = ""
    restCloseRoot()
  action restRaw(op: string, id: string, value: string)
    restMenu = ""
    restRawRoot(op, id, value)
  action rest(op: string, value: string)
    restRaw(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, value)
  action restInput(op: string, value: string, input: string)
    restRawRoot(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, `${value}${encodeURIComponent(input)}`)
  // The root rewrite: SnapShot's setup dialog (Settings' SnapShot panel and SettingsModals), moved from app.contract.
  state snapshotSetupOpen = false
  state snapshotSetupWasEnabled = false
  action toggleSnapshots
    if snapshotSettings.enabled and not commandPending
      snapshotSetupOpen = false
      settingsCommand("setting-snapshot", "snapShotEnabled", "false")
    else
      snapshotSetupOpen = true
      snapshotSetupWasEnabled = false
      clearModalError()
  action showSnapshotSetup(open: bool)
    snapshotSetupOpen = open
    snapshotSetupWasEnabled = snapshotSettings.enabled
    clearModalError()
  // The root rewrite: Add environment's credential and route target (SettingsModals draws the dialog; Settings ›
  // Connections and the sidebar open it), moved from app.contract. Each wrapper sets the window's half, then calls
  // the root's (`…Root`). The connections' row menu and remove confirm stay in the root: as a window action,
  // connectionAskRemove makes the compiler refuse its captured argument in connections-network.contract
  // (type-cannot-infer, @capture parameter of NetworkAccessRows' `ask`).
  state routeTarget = "" // lane environment-routes: Add environment as "Add a route to <routeLabel>"
  state routeLabel = ""
  state credential = ""
  action openConnection
    credential = ""
    routeTarget = ""
    openConnectionRoot()
  action openRoute(target: string, label: string)
    credential = ""
    routeTarget = target
    routeLabel = label
    openConnectionRoot()
  action closeConnection
    routeTarget = ""
    credential = ""
    closeConnectionRoot()
  action editOrigin(value: string)
    credential = pairFields.host != "" and pairFields.source == origin and credential == "" ? pairFields.code : credential
    editOriginRoot(value)
  action editCredential(value: string)
    credential = value
    editCredentialRoot()
  action closeModal
    snapshotSetupOpen = false
    routeTarget = ""
    credential = ""
    closeModalRoot()
  // The root rewrite: the thread title's menu and rename field, the right panel's maximize and the details card's
  // editors list, moved from app.contract. Each wrapper sets the window's half, then calls the root's (`…Root`),
  // which keeps what resources read and the sends. The fold hold stays in the root: chatLocal is called inside the
  // timeline's and the panels' repeated rows, where a window wrapper would be inlined at every call (+5.5 MB of plan).
  state titleMenuOpen = false
  state titleMenuFromTitle = false
  state titleMenuSerial = 0
  state titleMenuX = 0
  state titleMenuY = 0
  state renaming = false
  state renameText = ""
  state rightMaximized = false
  state detailsEditors = false
  action titleUi(what: string, value: string)
    let typed = renameText // the commit sends the field's text as the action found it
    if what == "open" or what == "context"
      titleMenuX = frame("thread-title").x
      titleMenuY = frame("thread-title").y + frame("thread-title").height + 4
      titleMenuOpen = (what == "context" or not titleMenuOpen) and not renaming
      titleMenuSerial = titleMenuSerial + 1
      titleMenuFromTitle = what == "open"
    if what == "close" // Escape or a press outside: the fallback menu's cleanup gives the focus back to what held it, the title when the title opened it (a right-click leaves it where it was)
      titleMenuOpen = false
      if titleMenuFromTitle
        focus("thread-title")
    if what == "rename" and shell.serverThread
      titleMenuOpen = false
      renaming = true
      renameText = data.threadTitle
      focus("header-rename")
    if what == "edit"
      renameText = value
    if what == "key" and value == "Escape"
      renaming = false
    if (what == "commit" and renaming) or (what == "new-thread" and data.projectId != "")
      renaming = false
      titleSend(what, typed)
  action titleMenuPick(op: string, target: string, value: string, askTitle: string, askBody: string, destructive: bool)
    titleMenuOpen = op == "ui:submenu" and titleMenuOpen
    if op == "ui:rename"
      renaming = true
      renameText = data.threadTitle
      focus("header-rename")
    titleMenuPickRoot(op, target, value, askTitle, askBody, destructive)
  action panelUi(what: string, id: string)
    let closingTerminal = what == "tab-close" and length(filter(shell.panel.tabs, (tab) => tab.id == id and tab.closeTitle != "")) > 0
    titleMenuOpen = false
    if what == "toggle" or what == "close" or what == "tab-close" or (what == "key" and id == "Escape")
      rightMaximized = closingTerminal ? rightMaximized : what == "tab-close" and shell.panel.count > 1 and rightMaximized
    if what == "maximize"
      rightMaximized = not rightMaximized
    panelUiRoot(what, id)
  action detailsAct(op: string, target: string, value: string)
    detailsEditors = op == "editors" and not detailsEditors
    titleMenuOpen = false
    detailsActRoot(op, target, value)
  action sidebarScrolled(x: number, y: number)
    sidebarScrollY = y
  action sidebarHover(id: string, over: bool)
    if over
      sidebarHoverLast = id
      sidebarHoverY = frame(`row-${id}`).y - sidebarScrollY
      sidebarHoverH = frame(`row-${id}`).height
    else if id == ""
      sidebarHoverY = -10000
    sidebarHoverRoot(id, over)
  action sidebarDrag(id: string, section: string, dx: number, dy: number)
    if section != "working" and data.sidebar.dragEnabled and not commandPending
      if dragId != id
        dragId = id
        dragSection = section
        dragDx = 0
        dragDy = 0
        sidebarHoverRoot(sidebarHoverId, false) // the root's half closes the hovered row's card
        dragX0 = frame(`row-${id}`).x
        dragY0 = frame(`row-${id}`).y
        dragW = frame(`row-${id}`).width
        dragH = frame(`row-${id}`).height
        dragTopY = frame("sidebar-list-top").y
        dragDividerY = frame("sidebar-pinned-divider").y
        dragWorkingY = data.sidebar.workingCount > 0 ? frame("shelf-working").y : 0
        dragSnoozedY = data.sidebar.snoozedCount > 0 ? frame("shelf-snoozed").y : 0
        dragSettledY = frame("shelf-settled").y
      dragDx = dragDx + dx
      dragDy = dragDy + dy
  action sidebarDragEnd(id: string, vx: number, vy: number) // r11-upstream: a row-action sweep's release (`sweep|…`, sidebar.contract ThreadSection) is a drop too; sidebarRun sends `sidebar:drop` while no command is pending
    if dragId == id or startsWith(id, "sweep|")
      if dragTarget == "context"
        sidebarRun("drop", id, `context|${dragCY}|${dragTopY}|${dragDividerY}|${dragCX >= frame("composer").x - 16 and dragCX <= frame("composer").x + frame("composer").width + 16 and dragCY >= frame("composer").y - 24 and dragCY <= frame("composer").y + frame("composer").height + 64}`)
      else if dragTarget != "" or startsWith(id, "sweep|")
        sidebarRun("drop", id, `${dragTarget}|${dragCY}|${dragTopY}|${dragDividerY}|false`)
      dragId = ""
      dragSection = ""
      dragDx = 0
      dragDy = 0
  view
    main testId="t3-code" pointerdown=outsidePressDown pointerup=outsidePressUp viewport-fit="cover" width="100%" height="100%" position="relative" display="flex" flex-direction="row" overflow="hidden" class=Canvas background-color=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas) font-family=(settingsCore.interfaceFont == "ui-serif" ? "ui-serif" : settingsCore.interfaceFont == "ui-rounded" ? "ui-rounded" : settingsCore.interfaceFont == "serif" ? "serif" : settingsCore.interfaceFont == "sans-serif" ? "sans-serif" : settingsCore.interfaceFont == "monospace" ? "monospace" : settingsCore.interfaceFont == "ui-monospace" ? "ui-monospace" : settingsCore.interfaceFont == "ui-sans-serif" ? "ui-sans-serif" : "system-ui") color=(settingsCore.palette.text == "" ? "light-dark(#27272a, #f5f5f5)" : settingsCore.palette.text)
      row width="100%" height="100%" min-width=0 position="relative" inert=sshPrompt.open testId="ssh-background"
        row width="100%" height="100%" min-width=0 inert=(modal or shell.panel.deviceSetup)
          when data.sidebarOpen
            when data.legacy.enabled
