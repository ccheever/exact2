use ThemeEditorHost from "./settings-appearance-editor.contract"
use SidebarOverlays from "./sidebar-overlays.contract"
use ChatCanvasView from "./chat-canvas.contract"
use TerminalDrawerView, TerminalDrawer from "./terminal.contract"
use HoverTip, HoverLayer, HoverText, HoverScopes, noHoverTip, hoverDelay, hoverOpenDelay from "./hover-layer.contract" // fix-hover-cards
use PaFreshnessCard from "./pages-pr-actions.contract"
use PrLinkPreviewCard from "./pages-pr-links.contract" // pr-links-previews-and-routing
component T3Window
  props
    data: Snapshot
