// ExpandedImageDialog for a Mermaid diagram (T3 Code, MIT; see LICENSE-T3):
// MermaidDiagram's "Expand diagram" opens the flattened drawing on the page's
// background at its own size, never larger, up to 92% of the window (less the
// arrows' 96pt) and min(86vh, 100vh − 160pt) high, named "Mermaid diagram".
use MermaidDiagram from "./markdown.contract"
use MermaidSvg from "./markdown.contract"
use Icon from "./icons.contract"

fn diagramScale(width: number, height: number, maxWidth: number, maxHeight: number): number = min(1, min(maxWidth / max(1, width), maxHeight / max(1, height)))

component DiagramPreviewDialog
  props
    diagram: MermaidDiagram
    windowWidth: number
    windowHeight: number
    scheme: string
    local: action
  derive scale = diagramScale(diagram.width, diagram.height, windowWidth * 0.92 - 96, min(windowHeight * 0.86, windowHeight - 160))
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=45 align-items="center" justify-content="center" background-color="#000000bf" role="dialog" aria-label="Expanded image preview" testId="diagram-preview"
      button press=local("diagram-close", "", "") aria-label="Close image preview" aria-keyshortcuts="Escape" position="absolute" left=0 right=0 top=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="diagram-preview-backdrop"
      column min-width=0 align-items="center"
        box position="relative" width=(diagram.width * scale) height=(diagram.height * scale)
          // ZoomableImage: the page's background (bg-background), rounded-lg, ring-1 ring-border/70 and shadow-2xl.
          // audit-wave-followups-3 FW-1: the card takes the page's colour as the window draws it (light-dark(), the window's
          // appearance, which the drawing's paints resolve by too), never the scheme fact on its own: where the two parted
          // (mode System in agent mode: the window drawn Light, the fact the Mac's Dark) a light drawing sat on a black card.
          // The drawing is rebuilt per scheme so its light-dark() paints resolve again.
          box width="100%" height="100%" border-radius="0.5rem" overflow="hidden" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 0 0 1px light-dark(#e4e4e7b3, #ffffff12), 0 25px 50px -12px #00000040"
            when scheme == "dark"
              MermaidSvg(diagram=diagram, width=(diagram.width * scale))
            else
              MermaidSvg(diagram=diagram, width=(diagram.width * scale))
          button press=local("diagram-close", "", "") aria-label="Close image preview" testId="diagram-preview-close" position="absolute" right=0 top="-2.5rem" width="1.5rem" height="1.5rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#ffffff33" background-color="#000000a6" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center"
            Icon(name="x", size=14, color="#ffffff")
        text "Mermaid diagram" margin-top="0.5rem" line-clamp=1 font-size="0.75rem" line-height="1rem" color="#ffffffcc"
