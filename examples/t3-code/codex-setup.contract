// Managed Codex with a ChatGPT account (T3 Code 1e2ecbd975, MIT; see LICENSE-T3):
// CodexSetupSection.tsx (the Settings "ChatGPT account" row, the welcome card, "Having trouble
// signing in?" and its pasted-URL form, CodexManagedRuntimeFields), ChatGptConnectionButton,
// ChatGptUsageButton, ChatGptAccountPicker ("Reconnect ChatGPT"), ChatGptWelcomeCoordinator
// ("Your ChatGPT plan is connected") and ChatGptSharingControl ("Using ChatGPT plan"). The view
// models are codex-setup.ts and chatgpt-plan.ts; every command is `op("setup:codex-<what>",
// instance, token, value)`, queued through the root's providerAuthChanged (codex-setup-ops.ts).
use PvField from "./providers-kit.contract"
use PvOutline from "./providers-kit.contract"
use PvPrimary from "./providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use PgIcon from "./pages-icons.contract"
use ProviderMark from "./icons.contract"
use RedactedText from "./redacted-text.contract"

// The dialogs' backdrop (PvOverlay's values; providers-wizard.contract uses this file).
style CxOverlay
  position="absolute" left=0 right=0 top=0 bottom=0
  display="flex" align-items="center" justify-content="center"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" padding="1rem" box-sizing="border-box" z-index=40

shape CodexSetup
  target: string
  key: string
  instanceId: string
  token: string
  presentation: string
  title: string
  kind: string
  description: string
  email: string
  emailPlaceholder: string
  help: string
  control: string
  controlLabel: string
  controlDisabled: bool
  secondary: string
  secondaryDisabled: bool
  showCancel: bool
  cancelDisabled: bool
  savedAccount: bool
  differentDisabled: bool
  accountDisabled: bool
  usage: bool
  logoutWarning: string
  callback: bool
  formKey: string
  flowId: string
  pasteDisabled: bool
  error: string
shape CodexRuntimeFields
  key: string
  binaryPath: string
  binaryPlaceholder: string
  homePath: string
  shadowPath: string
  shadowPlaceholder: string
  shadowDescription: string
shape CodexPickerProfile
  id: string
  name: string
shape CodexPicker
  key: string
  instanceId: string
  target: string
  token: string
  profiles: list<CodexPickerProfile>
  first: string
shape ChatGptDialogSetup
  key: string
  instanceId: string
  title: string
  setup: list<CodexSetup>
shape ChatGptPlanNotice
  key: string
  environmentLabel: string
  providerName: string
  detail: string

// ChatGptConnectionButton: the primary button with the OpenAI mark.
component ChatGptButton
  props
    label: string
    disabled: bool
    target: string
    testId: string
    press: action
  view
    button press=press id=target disabled=disabled testId=testId class=PvPrimary opacity=(disabled ? 0.64 : 1) box-shadow="inset 0 1px 0 #ffffff29"
      ProviderMark(driver="codex", size=16, color="#ffffff")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff" white-space="nowrap"

// A ghost sm button: `muted` is ghost-muted (the welcome card's secondary actions, Manage usage).
component CodexGhost
  props
    label: string
    muted: bool
    small: bool
    disabled: bool
    icon: string
    target: string
    testId: string
    press: action
    first: bool
  state over = false
  action hover(inside: bool)
    over = inside
  view
    button press=press hover=hover id=target disabled=disabled autofocus=first testId=testId cursor="pointer" display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" flex-shrink=0 box-sizing="border-box" height=(small ? "1.5rem" : "1.75rem") padding-left=(small ? "0.4375rem" : "0.5625rem") padding-right=(small ? "0.4375rem" : "0.5625rem") border-radius="0.5rem" border-width=0 opacity=(disabled ? 0.64 : 1) background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
      text label font-size=(small ? "0.75rem" : "0.875rem") line-height=(small ? "1rem" : "1.25rem") font-weight=500 white-space="nowrap" color=(muted and not over ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
      when icon != ""
        PvIcon(name=icon, size=14, color=(muted and not over ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)"))

// ChatGptUsageButton: "Manage usage" opens ChatGPT's usage settings.
component ChatGptUsageButton
  props
    small: bool
    testId: string
    press: action
    first: bool
  view
    CodexGhost(label="Manage usage", muted=true, small=small, disabled=false, icon="external", target="", testId=testId, press=press, first=first)

// "Signed in as <email>." with the email behind RedactedText (CodexSetupSection.tsx :73-81, :590-598).
component CodexSignedIn
  props
    email: string
    placeholder: string
    instanceId: string
  view
    row min-width=0 gap="0.25rem" align-items="baseline" flex-wrap="wrap"
      text "Signed in as" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #818181)"
      RedactedText(value=email, placeholder=placeholder, label="Toggle account email visibility", revealTip="Click to reveal email", hideTip="Click to hide email", testId=`codex-email-${instanceId}`)
      text "." font-size="0.75rem" line-height="1.21875rem" margin-left="-0.25rem" color="light-dark(#71717b, #818181)"

// CodexSignInDescription with onToggle: the disclosure button; its chevron turns 90° (instant under reduced motion).
component CodexHelpToggle
  inject
    still: bool
  props
    label: string
    open: bool
    instanceId: string
    toggle: action
  view
    button press=toggle aria-label="Having trouble signing in?" aria-expanded=open aria-controls=`codex-help-${instanceId}` testId=`codex-help-toggle-${instanceId}` cursor="pointer" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.375rem"
      text label font-size="0.75rem" line-height="1.21875rem" text-align="left" color="light-dark(#71717b, #818181)"
      box display="flex" flex-shrink=0 rotate=(open ? 90 : 0) transition=(still ? "none" : "rotate 150ms cubic-bezier(0.4, 0, 0.2, 1)") testId=`codex-help-chevron-${instanceId}`
        PgIcon(name="chevron-right", size=12, color="light-dark(#71717b, #818181)")

// callbackCompletion: paste the final localhost page's URL (a password-type field), Connect, or
// try the sign-in page in the browser again. The draft belongs to its flow (`formKey`).
component CodexCallbackForm
  props
    setup: CodexSetup
    busy: bool
    op: action
  state draft = ""
  action edit(value: string)
    draft = value
  derive off = setup.pasteDisabled or busy
  view
    column width="100%" gap="0.75rem" id=`codex-help-${setup.instanceId}` testId=`codex-callback-${setup.instanceId}`
      text "If sign-in doesn't return to T3 Code, paste the URL from the final localhost page." font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #818181)"
      row width="100%" gap="0.5rem" align-items="center"
        input value=draft input=edit submit=op("setup:codex-callback", setup.target, setup.flowId, draft, not off and trim(draft) != "") type="password" autocomplete="off" maxlength=16384 placeholder="Paste the URL from the sign-in tab" aria-label="ChatGPT sign-in redirect URL" class=PvField flex=1 min-width=0 height="2rem" disabled=off testId=`codex-callback-url-${setup.instanceId}`
        button press=op("setup:codex-callback", setup.target, setup.flowId, draft, true) class=PvOutline height="2rem" disabled=(off or trim(draft) == "") opacity=(off or trim(draft) == "" ? 0.64 : 1) testId=`codex-callback-connect-${setup.instanceId}`
          text "Connect" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
      row
        CodexGhost(label="Try sign-in in your browser", muted=true, small=true, disabled=false, icon="external", target="", testId=`codex-try-browser-${setup.instanceId}`, press=op("setup:codex-browser", setup.target, setup.token, "", true), first=false)

// ManagedCodexSetup, presentation "settings": the "ChatGPT account" row, Manage usage, the
// signed-out notice, "Having trouble signing in?" and the alert. `cancelled` is the Add ChatGPT
// account dialog's onSignInCancelled (its Close); Settings passes an action that does nothing.
component CodexSetupRow
  props
    setup: CodexSetup
    wide: bool
    busy: bool
    op: action
    ui: action
    cancelled: action
  state helpOpen = false
  action toggleHelp
    helpOpen = not helpOpen
  action cancel
    op("setup:codex-cancel", setup.target, setup.token, "", true)
    cancelled()
  derive pending = busy
  view
    column width="100%" role="region" aria-label="Codex setup" testId=`codex-setup-${setup.instanceId}`
      column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem"
        row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
          column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center"
              text "ChatGPT account" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            when setup.kind == "preparing"
              text "Preparing sign-in." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" testId=`codex-description-${setup.instanceId}`
            else
              when setup.email != ""
                CodexSignedIn(email=setup.email, placeholder=setup.emailPlaceholder, instanceId=setup.instanceId)
              else
                text setup.description max-width="36rem" font-size="0.75rem" line-height="1.125rem" role="status" aria-live="polite" color="light-dark(#70707acc, #818181cc)" testId=`codex-description-${setup.instanceId}`
          when setup.kind == "managed"
            row flex-shrink=0 min-width=0 gap="0.5rem" align-items="center" flex-wrap="wrap" justify-content=(wide ? "flex-end" : "flex-start")
              when setup.control == "waiting"
                button press=op("setup:codex-open", setup.target, setup.token, "", true) class=PvOutline disabled=setup.controlDisabled opacity=(setup.controlDisabled ? 0.64 : 1) testId=`codex-open-${setup.instanceId}`
                  text setup.controlLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
                when setup.showCancel
                  CodexGhost(label="Cancel", muted=false, small=false, disabled=setup.cancelDisabled, icon="", target="", testId=`codex-cancel-${setup.instanceId}`, press=cancel, first=false)
              when setup.control == "install"
                CodexGhost(label="Cancel", muted=false, small=false, disabled=setup.cancelDisabled, icon="", target="", testId=`codex-install-cancel-${setup.instanceId}`, press=op("setup:codex-install-cancel", setup.target, setup.token, "", true), first=false)
              when setup.control == "authenticated"
                button press=ui("codex-picker", setup.target) id=`codex-account-${setup.instanceId}` class=PvOutline disabled=(setup.accountDisabled or pending) opacity=(setup.accountDisabled or pending ? 0.64 : 1) testId=`codex-change-account-${setup.instanceId}`
                  text "Change account" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
                CodexGhost(label="Disconnect", muted=false, small=false, disabled=(setup.accountDisabled or pending), icon="", target="", testId=`codex-disconnect-${setup.instanceId}`, press=op("setup:codex-logout", setup.target, setup.token, "", true), first=false)
              when setup.control == "connect"
                when setup.savedAccount
                  ChatGptButton(label=setup.controlLabel, disabled=(setup.controlDisabled or pending), target=`codex-account-${setup.instanceId}`, testId=`codex-connect-${setup.instanceId}`, press=ui("codex-picker", setup.target))
                  CodexGhost(label="Use a different account", muted=false, small=false, disabled=(setup.differentDisabled or pending), icon="", target="", testId=`codex-different-${setup.instanceId}`, press=op("setup:codex-different", setup.target, setup.token, "", true), first=false)
                else
                  ChatGptButton(label=(pending ? "Setting up..." : setup.controlLabel), disabled=(setup.controlDisabled or pending), target=`codex-account-${setup.instanceId}`, testId=`codex-connect-${setup.instanceId}`, press=op("setup:codex-setup", setup.target, setup.token, "", true))
      when setup.usage
        row width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.25rem" padding-bottom="0.25rem" justify-content="flex-end" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
          ChatGptUsageButton(small=false, testId=`codex-manage-usage-${setup.instanceId}`, press=op("setup:chatgpt-usage", setup.target, "", "", true), first=false)
      when setup.logoutWarning != ""
        text setup.logoutWarning padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" font-size="0.75rem" line-height="1rem" role="alert" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" color="light-dark(#71717b, #818181)" testId=`codex-logout-warning-${setup.instanceId}`
      when setup.callback
        column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
          CodexHelpToggle(label="Having trouble signing in?", open=helpOpen, instanceId=setup.instanceId, toggle=toggleHelp)
          when helpOpen
            column width="100%" padding-top="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e780, #ffffff0d)"
              each key in [setup.formKey] key=key
                CodexCallbackForm(setup=setup, busy=busy, op=op)
      when setup.error != ""
        text setup.error padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" font-size="0.75rem" line-height="1rem" role="alert" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" color="light-dark(#e7000b, #ff6467)" testId=`codex-error-${setup.instanceId}`

// CodexWelcomeCard: the welcome's one calm row per Codex instance (presentation "onboarding"),
// for the existing-CLI choice, the pending setup and ManagedCodexSetup alike.
component CodexWelcomeCard
  props
    setup: CodexSetup
    busy: bool
    op: action
    ui: action
  state helpOpen = false
  action toggleHelp
    helpOpen = not helpOpen
  derive pending = busy
  view
    column width="100%" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`welcome-codex-${setup.instanceId}`
      row width="100%" gap="0.75rem" align-items="center" flex-wrap="wrap"
        ProviderMark(driver="codex", size=20, color="light-dark(#27272a, #f5f5f5)")
        column flex=1 min-width=0 gap="0.125rem"
          text setup.title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          when setup.email != ""
            CodexSignedIn(email=setup.email, placeholder=setup.emailPlaceholder, instanceId=setup.instanceId)
          else
            when setup.help == "toggle"
              CodexHelpToggle(label="Complete sign-in in your browser.", open=helpOpen, instanceId=setup.instanceId, toggle=toggleHelp)
            else
              text setup.description font-size="0.75rem" line-height="1.21875rem" role="status" aria-live="polite" color="light-dark(#71717b, #818181)" testId=`welcome-codex-description-${setup.instanceId}`
        row flex-shrink=0 gap="0.5rem" align-items="center" justify-content="flex-end"
          when setup.kind == "preparing"
            CodexGhost(label="Cancel", muted=true, small=false, disabled=true, icon="", target="", testId=`welcome-codex-cancel-${setup.instanceId}`, press=op("setup:codex-cancel-any", setup.target, setup.token, "", false), first=false)
            button class=PvOutline min-width="11rem" disabled=true opacity=0.64 testId=`welcome-codex-open-${setup.instanceId}`
              text "Open sign-in page" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          when setup.secondary == "cancel"
            CodexGhost(label="Cancel", muted=true, small=false, disabled=(setup.secondaryDisabled or pending), icon="", target="", testId=`welcome-codex-cancel-${setup.instanceId}`, press=op("setup:codex-cancel-any", setup.target, setup.token, "", true), first=false)
          when setup.secondary == "different"
            CodexGhost(label="Use a different account", muted=true, small=false, disabled=(setup.secondaryDisabled or pending), icon="", target="", testId=`welcome-codex-different-${setup.instanceId}`, press=op("setup:codex-different", setup.target, setup.token, "", true), first=false)
          when setup.secondary == "existing"
            CodexGhost(label="Use existing CLI", muted=true, small=false, disabled=(setup.secondaryDisabled or pending), icon="", target="", testId=`welcome-codex-existing-${setup.instanceId}`, press=op("setup:codex-mode", setup.target, setup.token, "existing", true), first=false)
          when setup.control == "ready"
            row gap="0.375rem" align-items="center"
              PgIcon(name="check", size=14, color="light-dark(#007a55, #00d492)")
              text "Ready" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#007a55, #00d492)"
          when setup.control == "checking"
            text "Checking..." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          when setup.control == "headline"
            text setup.controlLabel font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          when setup.control == "waiting"
            button press=op("setup:codex-open", setup.target, setup.token, "", true) class=PvOutline min-width="11rem" disabled=setup.controlDisabled opacity=(setup.controlDisabled ? 0.64 : 1) testId=`welcome-codex-open-${setup.instanceId}`
              text setup.controlLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
          when setup.control == "connect" and setup.kind == "existing"
            ChatGptButton(label="Continue with ChatGPT", disabled=(setup.controlDisabled or pending), target="", testId=`welcome-codex-chatgpt-${setup.instanceId}`, press=op("setup:codex-mode", setup.target, setup.token, "managed", true))
          when setup.control == "connect" and setup.kind == "managed"
            when setup.savedAccount
              ChatGptButton(label=setup.controlLabel, disabled=(setup.controlDisabled or pending), target=`codex-account-${setup.instanceId}`, testId=`welcome-codex-chatgpt-${setup.instanceId}`, press=ui("codex-picker", setup.target))
            else
              ChatGptButton(label=(pending ? "Setting up..." : setup.controlLabel), disabled=(setup.controlDisabled or pending), target=`codex-account-${setup.instanceId}`, testId=`welcome-codex-chatgpt-${setup.instanceId}`, press=op("setup:codex-setup", setup.target, setup.token, "", true))
      when (setup.callback and helpOpen) or setup.error != ""
        column margin-left="2rem" margin-top="0.5rem" gap="0.5rem"
          when setup.callback and helpOpen
            column width="100%" padding-top="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e780, #ffffff0d)"
              each key in [setup.formKey] key=key
                CodexCallbackForm(setup=setup, busy=busy, op=op)
          when setup.error != ""
            text setup.error font-size="0.75rem" line-height="1rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId=`welcome-codex-error-${setup.instanceId}`

// CodexManagedRuntimeFields in a FoldedSettingsSection ("Runtime", closed until its chevron opens it).
component CodexRuntimeSection
  inject
    still: bool
  props
    runtime: CodexRuntimeFields
    wide: bool
  state open = false
  action toggle
    open = not open
  view
    column width="100%" gap="0.625rem" testId=`codex-runtime-${runtime.key}`
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="flex-start" box-sizing="border-box" width="100%"
        button press=toggle aria-expanded=open testId=`codex-runtime-toggle-${runtime.key}` cursor="pointer" min-height="1.75rem" padding=0 border-width=0 border-radius="0.375rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.5rem" role="heading" aria-level=2
          text "Runtime" font-size="0.875rem" line-height="1.25rem" font-weight=400 color="light-dark(#27272ab3, #f5f5f5b3)"
          box display="flex" rotate=(open ? 90 : 0) transition=(still ? "none" : "rotate 150ms cubic-bezier(0.4, 0, 0.2, 1)")
            PgIcon(name="chevron-right", size=16, color="light-dark(#27272ab3, #f5f5f5b3)")
      when open
        column width="100%" box-sizing="border-box" border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0a)" background-color="light-dark(#ffffff66, #11111166)" overflow="hidden"
          CodexPathRow(title="Binary path", description="Selected by T3 Code.", value=runtime.binaryPath, placeholder=runtime.binaryPlaceholder, label="Codex binary path", wide=wide, divided=false, testId=`codex-binary-path-${runtime.key}`)
          CodexPathRow(title="CODEX_HOME path", description="Shared Codex config, sessions, and state.", value=runtime.homePath, placeholder="Unavailable", label="Codex home path", wide=wide, divided=true, testId=`codex-home-path-${runtime.key}`)
          CodexPathRow(title="Shadow home path", description=runtime.shadowDescription, value=runtime.shadowPath, placeholder=runtime.shadowPlaceholder, label="Codex shadow home path", wide=wide, divided=true, testId=`codex-shadow-path-${runtime.key}`)

component CodexPathRow
  props
    title: string
    description: string
    value: string
    placeholder: string
    label: string
    wide: bool
    divided: bool
    testId: string
  view
    column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" border-top-style="solid" border-top-width=(divided ? 1 : 0) border-color="light-dark(#e3e3e780, #ffffff08)"
      row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
        column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
          text title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          text description font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
        input value=value placeholder=placeholder aria-label=label title=value disabled=true class=PvField width=(wide ? "20rem" : "100%") opacity=0.64 testId=testId

// ChatGptAccountPicker ("Reconnect ChatGPT"): the saved profiles, then "Use a different account";
// Continue with ChatGPT signs in with the chosen one. Escape or Close returns focus to the opener.
component ChatGptAccountPicker
  props
    picker: CodexPicker
    busy: bool
    op: action
    ui: action
  state selection = ""
  action choose(value: string)
    selection = value
  action dismiss
    ui("close", "")
    focus(`codex-account-${picker.instanceId}`)
  action connect
    ui("close", "")
    op("setup:codex-pick", picker.target, picker.token, selected, true)
    focus(`codex-account-${picker.instanceId}`)
  // Focus stays in the dialog (Base UI's focus trap): Tab past Continue returns to the first account.
  action lastKeys(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.shiftKey
      focus(`codex-picker-option-${picker.first}`)
      preventDefault()
  derive selected = selection == "chatgpt-change-account" ? selection : (length(filter(picker.profiles, (profile) => profile.id == selection)) > 0 ? selection : picker.first)
  view
    column class=CxOverlay testId="codex-picker-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-modal=true aria-label="Reconnect ChatGPT" testId="codex-picker"
        column padding="1.5rem" padding-bottom="1rem" gap="0.5rem"
          text "Reconnect ChatGPT" font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "On OpenAI, sign in with the account you choose here." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        column padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1.5rem" gap="0.5rem" role="radiogroup" aria-label="ChatGPT account to connect"
          each profile in picker.profiles key=profile.id
            CodexPickerOption(label=profile.name, checked=(selected == profile.id), first=(profile.id == picker.first), target=`codex-picker-option-${profile.id}`, testId=`codex-picker-${profile.id}`, press=choose(profile.id))
          CodexPickerOption(label="Use a different account", checked=(selected == "chatgpt-change-account"), first=(picker.first == "chatgpt-change-account"), target="codex-picker-option-chatgpt-change-account", testId="codex-picker-different", press=choose("chatgpt-change-account"))
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" justify-content="flex-end" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button press=dismiss aria-keyshortcuts="Escape" aria-label="Close" tabindex=-1 width=1 height=1 padding=0 border-width=0 opacity=0 overflow="hidden" testId="codex-picker-close"
          box key=lastKeys tabindex=-1 display="flex"
            ChatGptButton(label="Continue with ChatGPT", disabled=busy, target="codex-picker-connect-button", testId="codex-picker-connect", press=connect)

component CodexPickerOption
  props
    label: string
    checked: bool
    first: bool
    target: string
    testId: string
    press: action
  // Shift+Tab before the first account goes round to Continue with ChatGPT.
  action keys(k: string, e: KeyboardEvent)
    if first and k == "Tab" and e.shiftKey
      focus("codex-picker-connect-button")
      preventDefault()
  view
    button press=press key=keys id=target role="radio" aria-checked=checked autofocus=first testId=testId cursor="pointer" width="100%" box-sizing="border-box" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.75rem" border-radius="0.625rem" border-style="solid" border-width=1 border-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#e4e4e7, #ffffff14)") background-color="#00000000" display="flex" flex-direction="row" align-items="center"
      box width="1rem" height="1rem" flex-shrink=0 box-sizing="border-box" border-radius="624.9375rem" border-style="solid" border-width=(checked ? 5 : 1) border-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff29)") background-color="light-dark(#ffffff, #0a0a0a)"
      text label min-width=0 font-size="0.875rem" line-height="1.25rem" font-weight=500 text-align="left" overflow-wrap="anywhere" color="light-dark(#27272a, #f5f5f5)"

// ChatGptWelcomeCoordinator: once per connected profile; Continue (or Escape, as the reference
// stores the acknowledgment on close) remembers it; Manage usage opens ChatGPT's usage settings.
component ChatGptPlanDialog
  props
    notice: ChatGptPlanNotice
    busy: bool
    op: action
  // Focus stays in the dialog: Tab after Continue and Shift+Tab before Manage usage go round.
  action firstKeys(k: string, e: KeyboardEvent)
    if k == "Tab" and e.shiftKey
      focus("chatgpt-plan-continue-button")
      preventDefault()
  action lastKeys(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.shiftKey
      focus("chatgpt-plan-usage-button")
      preventDefault()
  view
    column class=CxOverlay testId="chatgpt-plan-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-modal=true aria-label="Your ChatGPT plan is connected" testId="chatgpt-plan-dialog"
        column padding="1.5rem" gap="0.5rem"
          box margin-bottom="0.5rem"
            ProviderMark(driver="codex", size=32, color="light-dark(#27272a, #f5f5f5)")
          text "Your ChatGPT plan is connected" font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "Eligible usage in T3 Code uses your ChatGPT plan. Manage your shared usage and any credit settings in ChatGPT." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
          text notice.detail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="chatgpt-plan-detail"
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" justify-content="flex-end" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          box key=firstKeys tabindex=-1 display="flex"
            CodexGhost(label="Manage usage", muted=true, small=false, disabled=false, icon="external", target="chatgpt-plan-usage-button", testId="chatgpt-plan-usage", press=op("setup:chatgpt-usage", "", "", "", true), first=true)
          box key=lastKeys tabindex=-1 display="flex"
            button press=op("setup:chatgpt-plan-ack", "", "", notice.key, true) id="chatgpt-plan-continue-button" class=PvPrimary aria-keyshortcuts="Escape" disabled=busy testId="chatgpt-plan-continue"
              text "Continue" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"

// AddCodexAccountDialog once the account exists: its title, the managed setup (or "Preparing
// managed setup."), and Finish later. The dialog closes when sharing turns on (app.contract).
component ChatGptAccountSetup
  props
    created: ChatGptDialogSetup
    wide: bool
    busy: bool
    op: action
    ui: action
  view
    column width="100%" testId="chatgpt-account-setup"
      when length(created.setup) == 0
        column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.25rem"
          text "Codex runtime" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          text "Preparing managed setup." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
      each setup in created.setup key=setup.key
        CodexSetupRow(setup=setup, wide=wide, busy=busy, op=op, ui=ui, cancelled=ui("close", ""))
