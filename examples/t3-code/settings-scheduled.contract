// Settings → Scheduled tasks (reference ScheduledTasksSettings.tsx): a plain
// section with "New task", one row per task (switch and Edit/Run now/Delete
// menu), and the editor dialog with every field of ScheduledTaskEditorDialog.
use SelectOption from "./settings-kit.contract"
use SettingsSwitch from "./settings-kit.contract"
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use GhostSelect from "./settings-projects.contract"
use LucideLaptop from "./settings-icons.contract"
use SettingsSelect from "./settings-kit.contract"
use LucidePlus from "./settings-icons.contract"
use LucideEllipsis from "./settings-icons.contract"
use LucidePencil from "./settings-icons.contract"
use LucidePlay from "./settings-icons.contract"
use LucideTrash2 from "./settings-icons.contract"
use LucideX from "./settings-icons.contract"
use LucideGitBranch from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use LucideSearch from "./settings-icons.contract"
use LucideRefreshCw from "./settings-icons.contract"

shape TaskRowView
  id: string
  title: string
  prompt: string
  status: string
  runStatus: string
  runError: string
  enabled: bool
  first: bool
shape TaskDraftView
  key: string
  id: string
  title: string
  prompt: string
  enabled: bool
  scheduleMode: string
  intervalMinutes: string
  timeOfDay: string
  sunday: bool
  monday: bool
  tuesday: bool
  wednesday: bool
  thursday: bool
  friday: bool
  saturday: bool
  projectId: string
  threadId: string
  workspaceMode: string
  baseRef: string
  startFromOrigin: bool
  path: string
  modelKey: string
  legacyInterval: bool
  missing: bool
shape TaskRef
  value: string
  label: string
  search: string
  badge: string
shape TaskBranches
  projectId: string
  error: string
  refs: list<TaskRef>
shape TaskModelMark
  value: string
  name: string
  driver: string
  badge: string
  accent: string
shape ScheduledPage
  available: bool
  writable: bool
  error: string
  loading: bool
  environment: string
  scope: string
  missing: bool
  tasks: list<TaskRowView>
  editors: list<TaskDraftView>
  projects: list<SelectOption>
  models: list<SelectOption>
  workspaces: list<SelectOption>
  environments: list<SelectOption>
  branches: list<TaskBranches>
  marks: list<TaskModelMark>

style TkLabel
  font-size=14 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
style TkField
  box-sizing="border-box" width="100%" height=32 padding-left=11 padding-right=11 padding-top=5 padding-bottom=5 line-height="20px" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"
style TkOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=6 box-sizing="border-box" height=28 padding-left=9 padding-right=9 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" flex-shrink=0

component ScheduledPanel
  props
    data: ScheduledPage
    busy: bool
    error: string
    open: action
    rest: action
  view
    column width="100%" gap=10 testId="scheduled-settings"
      row min-height=28 padding-left=16 padding-right=16 align-items="center" justify-content="space-between" gap=16 box-sizing="border-box"
        text "Scheduled tasks" font-size=14 line-height="20px" color="light-dark(#262629b3, #f5f5f5b3)" role="heading" aria-level=2
        button press=open("task", "", "") disabled=(busy or not data.available or not data.writable) id="new-scheduled-task" testId="new-scheduled-task" display="flex" flex-direction="row" align-items="center" gap=4 height=24 padding-left=7 padding-right=7 border-width=0 border-radius=8 background-color="#00000000" opacity=(busy or not data.available or not data.writable ? 0.64 : 1)
          LucidePlus(size=12, color="light-dark(#71717b, #818181)")
          text "New task" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"
      when error != ""
        text error font-size=12 line-height="18px" color="light-dark(#dc2626, #f87171)" role="alert" testId="scheduled-error" padding-left=16
      column width="100%" box-sizing="border-box" border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
        when data.error != ""
          TaskMessage(title="Could not load scheduled tasks", description=data.error)
        when data.available and length(data.tasks) == 0
          TaskMessage(title="No scheduled tasks", description="No tasks match this environment and project selection.")
        each item in data.tasks key=item.id
          row width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=32 align-items="center" border-top-style="solid" border-top-width=(item.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)" testId=`task-row-${item.id}`
            column flex=1 min-width=0 gap=4
              text item.title font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              text item.prompt font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" max-width=576 line-clamp=2
              row padding-top=2 gap=8 align-items="center" flex-wrap="wrap"
                text item.status font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" testId=`task-status-${item.id}`
                when item.runStatus != ""
                  text item.runStatus font-size=12 font-weight=500 line-height="16px" padding-left=5 padding-right=5 border-radius=6 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" color=(item.runStatus == "failed" ? "light-dark(#dc2626, #f87171)" : (item.runStatus == "succeeded" ? "light-dark(#15803d, #4ade80)" : "light-dark(#27272a, #f5f5f5)"))
                when item.runError != ""
                  text item.runError font-size=12 line-height="16px" color="light-dark(#dc2626, #f87171)"
            row flex-shrink=0 align-items="center" gap=8
              SettingsSwitch(checked=item.enabled, label=`Enable ${item.title}`, disabled=(busy or not data.writable), switchId=`task-enabled-${item.id}`, toggle=rest("task", `action=toggle&id=${encodeURIComponent(item.id)}&enabled=${item.enabled ? "false" : "true"}`))
              button popovertarget=`task-menu-${item.id}` disabled=(busy or not data.writable) aria-label=`Actions for ${item.title}` testId=`task-actions-${item.id}` width=28 height=28 border-width=0 border-radius=8 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                LucideEllipsis(size=16, color="light-dark(#27272a, #f5f5f5)")
              SkPopup(menuId=`task-menu-${item.id}`, label=`Actions for ${item.title}`, width=160, list=false, endAlign=28)
                TaskMenuItem(label="Edit", icon="edit", menuId=`task-menu-${item.id}`, itemId=`task-edit-${item.id}`, destructive=false, choose=open("task", item.id, item.title))
                TaskMenuItem(label="Run now", icon="run", menuId=`task-menu-${item.id}`, itemId=`task-run-${item.id}`, destructive=false, choose=rest("task", `action=run&id=${encodeURIComponent(item.id)}`))
                box height=1 margin-top=4 margin-bottom=4 margin-left=8 margin-right=8 background-color="light-dark(#e4e4e7, #ffffff0f)"
                TaskMenuItem(label="Delete", icon="delete", menuId=`task-menu-${item.id}`, itemId=`task-delete-${item.id}`, destructive=false, choose=rest("task", `action=delete&id=${encodeURIComponent(item.id)}`))

// A task row's menu item with its icon (Edit / Run now / Delete).
component TaskMenuItem
  props
    label: string
    icon: string
    menuId: string
    itemId: string
    destructive: bool
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose popovertarget=menuId popovertargetaction="hide" hover=hover role="menuitem" testId=itemId display="flex" flex-direction="row" align-items="center" gap=8 width="100%" min-height=28 padding-left=8 padding-right=8 box-sizing="border-box" border-width=0 border-radius=6 background-color=(hovered ? "light-dark(#27272a14, #f5f5f50f)" : "#00000000")
      when icon == "edit"
        LucidePencil(size=16, color="light-dark(#71717b, #818181)")
      when icon == "run"
        LucidePlay(size=16, color="light-dark(#71717b, #818181)")
      when icon == "delete"
        LucideTrash2(size=16, color="light-dark(#71717b, #818181)")
      text label font-size=14 line-height="20px" white-space="nowrap" color=(destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")

component TaskMessage
  props
    title: string
    description: string
  view
    column width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=4
      text title font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
      text description font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" max-width=576

// ScheduledTaskEditorDialog. Per-instance state starts from the server's
// draft each time the dialog opens (the draft row is new per opening).
component ScheduledEditor
  props
    data: ScheduledPage
    draft: TaskDraftView
    busy: bool
    error: string
    close: action
    rest: action
  state title = draft.title
  state prompt = draft.prompt
  state enabled = draft.enabled
  state scheduleMode = draft.scheduleMode
  state intervalMinutes = draft.intervalMinutes
  state timeOfDay = draft.timeOfDay
  state sunday = draft.sunday
  state monday = draft.monday
  state tuesday = draft.tuesday
  state wednesday = draft.wednesday
  state thursday = draft.thursday
  state friday = draft.friday
  state saturday = draft.saturday
  state projectId = draft.projectId
  state workspaceMode = draft.workspaceMode
  state baseRef = draft.baseRef
  state startFromOrigin = draft.startFromOrigin
  state path = draft.path
  state modelKey = draft.modelKey
  state refQuery = ""
  derive refSearch = refQuery
  action setText(field: string, value: string)
    if field == "refs"
      refQuery = value
    if field == "title"
      title = value
    if field == "prompt"
      prompt = value
    if field == "interval"
      intervalMinutes = value
    if field == "time"
      timeOfDay = value
    if field == "path"
      path = value
  action choose(field: string, value: string)
    if field == "project"
      projectId = value
    if field == "workspace"
      workspaceMode = value
    if field == "branch"
      baseRef = value
    if field == "model"
      modelKey = value
    if field == "schedule"
      scheduleMode = value
  action toggle(field: string)
    if field == "enabled"
      enabled = not enabled
    if field == "origin"
      startFromOrigin = not startFromOrigin
    if field == "0" and (monday or tuesday or wednesday or thursday or friday or saturday)
      sunday = not sunday
    if field == "1" and (sunday or tuesday or wednesday or thursday or friday or saturday)
      monday = not monday
    if field == "2" and (sunday or monday or wednesday or thursday or friday or saturday)
      tuesday = not tuesday
    if field == "3" and (sunday or monday or tuesday or thursday or friday or saturday)
      wednesday = not wednesday
    if field == "4" and (sunday or monday or tuesday or wednesday or friday or saturday)
      thursday = not thursday
    if field == "5" and (sunday or monday or tuesday or wednesday or thursday or saturday)
      friday = not friday
    if field == "6" and (sunday or monday or tuesday or wednesday or thursday or friday)
      saturday = not saturday
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding=16 box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" testId="scheduled-task-overlay"
      column width="100%" max-width=576 max-height="100%" box-sizing="border-box" border-radius=18 border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label=(draft.id == "" ? "New task" : "Edit task") testId="scheduled-task-dialog"
        row padding-top=24 padding-left=24 padding-right=24 padding-bottom=12 align-items="flex-start" gap=8 box-sizing="border-box" position="relative"
          column flex=1 min-width=0 gap=8
            text (draft.id == "" ? "New task" : "Edit task") font-size=20 font-weight=600 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
            text "Run a prompt automatically — on an interval or at a fixed time." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
          button press=close disabled=busy aria-label="Close" aria-keyshortcuts="Escape" testId="close-scheduled-task" width=32 height=32 border-width=0 border-radius=8 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" position="absolute" top=8 right=8
            LucideX(size=16, color="light-dark(#71717b, #818181)")
        scroll flex=1 min-height=0 width="100%" testId="scheduled-editor-scroll"
          column width="100%" gap=20 padding-left=24 padding-right=24 padding-top=4 padding-bottom=24 box-sizing="border-box" testId="scheduled-editor"
            when draft.missing
              text "This scheduled task no longer exists." font-size=12 line-height="16px" color="light-dark(#dc2626, #f87171)" role="status" testId="task-missing"
            when error != ""
              text error font-size=14 line-height="20px" color="light-dark(#dc2626, #f87171)" role="alert" testId="scheduled-task-error"
            column gap=6
              text "Runs on" class=TkLabel
              button popovertarget="task-environment-menu" role="combobox" aria-label="Runs on" disabled=(draft.id != "" or busy) id="task-environment" testId="task-environment" display="flex" flex-direction="row" align-items="center" gap=8 width="100%" height=32 box-sizing="border-box" padding-left=11 padding-right=9 border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" opacity=(draft.id != "" ? 0.64 : 1)
                LucideLaptop(size=16, color="light-dark(#71717b, #818181)")
                text data.environment font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 line-clamp=1
                LucideChevronDown(size=12, color="light-dark(#71717b, #818181)")
              SkPopup(menuId="task-environment-menu", label="Runs on", width=526, list=true, endAlign=0)
                each option in data.environments key=option.value
                  SkMenuItem(label=option.label, menuId="task-environment-menu", itemId=`task-environment-option-${option.value}`, selected=option.selected, check=true, destructive=false, disabled=false, choose=choose("environment", option.value))
            column gap=6
              text "Name" class=TkLabel
              input value=title input=setText("title") placeholder="e.g. Check for Sentry issues" aria-label="Name" class=TkField disabled=busy testId="task-title"
            row gap=12 width="100%"
              column gap=6 flex=1 min-width=0
                text "Project" class=TkLabel
                SettingsSelect(selectId="task-project", label="Project", valueLabel=projectLabel(data.projects, projectId), width=257, disabled=busy, options=data.projects, choose=choose("project"))
              column gap=6 flex=1 min-width=0
                text "Workspace" class=TkLabel
                SettingsSelect(selectId="task-workspace", label="Workspace", valueLabel=(workspaceMode == "root" ? "Use the project checkout" : (workspaceMode == "existing_worktree" ? "Use a specific checkout" : "Create a new worktree")), width=257, disabled=busy, options=data.workspaces, choose=choose("workspace"))
            when workspaceMode == "worktree"
              column gap=6
                text "Base branch" class=TkLabel
                button popovertarget="task-branch-menu" disabled=busy aria-label="Base branch" role="combobox" testId="task-base-branch" class=TkOutline width="100%" justify-content="flex-start"
                  LucideGitBranch(size=14, color="light-dark(#71717b, #818181)")
                  text (baseRef == "" ? "Select ref" : (startFromOrigin ? `From origin/${baseRef}` : `From ${baseRef}`)) font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 line-clamp=1
                  LucideChevronDown(size=14, color="light-dark(#71717b, #818181)")
                // BranchPicker: ComboboxPopup at the trigger's width, Search refs..., the refs with
                // their current/worktree/remote/default tag, and the Start from origin row.
                column id="task-branch-menu" popover="auto" position="absolute" width=526 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #181818)" box-shadow="0 8px 24px #00000026" overflow="hidden" aria-label="Base branch" testId="task-branch-menu"
                  column padding-top=10 padding-left=12 padding-right=12 box-sizing="border-box" width="100%"
                    row height=33 align-items="center" gap=4 padding-bottom=6 box-sizing="border-box" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e7, #ffffff14)"
                      LucideSearch(size=16, color="light-dark(#71717b8c, #8181818c)")
                      input value=refQuery input=setText("refs") placeholder="Search refs..." aria-label="Search refs" testId="task-branch-search" flex=1 min-width=0 height=20 line-height="20px" padding=0 border-width=0 background-color="#00000000" font-size=14 color="light-dark(#27272a, #f5f5f5)"
                  scroll max-height=224 width="100%"
                    column padding-left=4 padding-top=8 padding-bottom=4 width="100%" box-sizing="border-box"
                      each group in data.branches key=group.projectId
                        when group.projectId == projectId
                          when group.error != ""
                            text group.error font-size=12 color="light-dark(#dc2626, #f87171)" padding=8
                          when group.error == "" and length(filter(group.refs, (r) => refSearch == "" or includes(r.search, refSearch))) == 0
                            text "No refs found." font-size=14 line-height="20px" text-align="center" padding=8 color="light-dark(#71717b, #818181)" testId="task-branch-empty"
                          each ref in group.refs key=ref.value
                            when refSearch == "" or includes(ref.search, refSearch)
                              button press=choose("branch", ref.value) popovertarget="task-branch-menu" popovertargetaction="hide" role="option" aria-selected=(ref.value == baseRef) testId=`task-branch-${ref.value}` display="flex" flex-direction="row" align-items="center" gap=8 width="100%" height=28 padding-left=8 padding-right=8 box-sizing="border-box" border-width=0 border-radius=6 justify-content="flex-start" background-color=(ref.value == baseRef ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000")
                                text ref.label font-size=14 line-height="20px" color="light-dark(#18181b, #fafafa)" flex=1 min-width=0 line-clamp=1
                                when ref.badge != ""
                                  text ref.badge font-size=10 line-height="14px" color="light-dark(#71717b73, #81818173)" flex-shrink=0
                  row align-items="center" justify-content="space-between" gap=12 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e799, #ffffff0f)"
                    row align-items="center" gap=6 min-width=0
                      LucideRefreshCw(size=12, color="light-dark(#71717b, #818181)")
                      text "Start from origin" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)" line-clamp=1
                    SettingsSwitch(checked=startFromOrigin, label="Start worktree from origin", disabled=busy, switchId="task-origin", toggle=toggle("origin"))
            when workspaceMode == "existing_worktree"
              column gap=6
                text "Checkout path" class=TkLabel
                input value=path input=setText("path") placeholder="/path/to/checkout" aria-label="Checkout path" class=TkField disabled=busy testId="task-worktree-path"
            column gap=6
              text "Prompt" class=TkLabel
              textarea value=prompt input=setText("prompt") placeholder="What should the agent do each time this runs?" aria-label="Prompt" class=TkField height=72 padding-top=6 disabled=busy testId="task-prompt"
            column gap=6
              text "Model" class=TkLabel
              row
                GhostSelect(selectId="task-model", label="Model", driver=markField(data.marks, modelKey, "driver"), badge=markField(data.marks, modelKey, "badge"), accent=(markField(data.marks, modelKey, "accent") == "" ? "#00000000" : markField(data.marks, modelKey, "accent")), valueLabel=(markField(data.marks, modelKey, "name") == "" ? modelLabel(data.models, modelKey) : markField(data.marks, modelKey, "name")), disabled=busy, options=data.models, choose=choose("model"))
            column gap=12
              when draft.legacyInterval
                text "This task uses a legacy interval below one minute. Saving updates it to at least one minute." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)" role="status"
              row align-items="center" justify-content="space-between" gap=8
                text "Schedule" class=TkLabel
                row role="group" aria-label="Schedule type" padding=2 gap=2 border-radius=10 background-color="light-dark(#d4d4d766, #ffffff08)"
                  button press=choose("schedule", "fixed") aria-checked=(scheduleMode == "fixed") testId="task-schedule-fixed" height=24 padding-left=10 padding-right=10 border-radius=8 border-width=0 background-color=(scheduleMode == "fixed" ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(scheduleMode == "fixed" ? "0 1px 2px #0000000d" : "none")
                    text "At a time" font-size=14 font-weight=500 line-height="20px" color=(scheduleMode == "fixed" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
                  button press=choose("schedule", "interval") aria-checked=(scheduleMode == "interval") testId="task-schedule-interval" height=24 padding-left=10 padding-right=10 border-radius=8 border-width=0 background-color=(scheduleMode == "interval" ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(scheduleMode == "interval" ? "0 1px 2px #0000000d" : "none")
                    text "Every interval" font-size=14 font-weight=500 line-height="20px" color=(scheduleMode == "interval" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
              when scheduleMode == "fixed"
                row align-items="center" gap=12 flex-wrap="wrap"
                  row align-items="center" gap=8
                    text "Run at" class=TkLabel
                    input type="time" value=timeOfDay change=setText("time") aria-label="Run at" disabled=busy testId="task-time" box-sizing="border-box" width=128 height=32 padding-left=11 padding-right=9 border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"
                    text "on" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
                  row role="group" aria-label="Days to run"
                    Weekday(label="Mon", short="Mo", on=monday, first=true, last=false, press=toggle("1"))
                    Weekday(label="Tue", short="Tu", on=tuesday, first=false, last=false, press=toggle("2"))
                    Weekday(label="Wed", short="We", on=wednesday, first=false, last=false, press=toggle("3"))
                    Weekday(label="Thu", short="Th", on=thursday, first=false, last=false, press=toggle("4"))
                    Weekday(label="Fri", short="Fr", on=friday, first=false, last=false, press=toggle("5"))
                    Weekday(label="Sat", short="Sa", on=saturday, first=false, last=false, press=toggle("6"))
                    Weekday(label="Sun", short="Su", on=sunday, first=false, last=true, press=toggle("0"))
              when scheduleMode == "interval"
                row align-items="center" gap=8
                  text "Run every" class=TkLabel
                  input value=intervalMinutes input=setText("interval") aria-label="Run every" class=TkField width=96 disabled=busy testId="task-minutes"
                  text "minutes" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
            row align-items="center" justify-content="space-between" gap=16
              column min-width=0 gap=4
                text "Enabled" class=TkLabel
                text "Disabled tasks stay saved but do not run." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
              SettingsSwitch(checked=enabled, label="Enabled", disabled=busy, switchId="task-enabled", toggle=toggle("enabled"))
        row gap=8 justify-content="flex-end" padding-left=24 padding-right=24 padding-top=16 padding-bottom=16 box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          button press=close disabled=busy testId="cancel-scheduled-task" class=TkOutline
            text "Cancel" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
          button press=rest("task", `action=save&id=${encodeURIComponent(draft.id)}&title=${encodeURIComponent(title)}&prompt=${encodeURIComponent(prompt)}&enabled=${enabled}&scheduleMode=${scheduleMode}&intervalMinutes=${encodeURIComponent(intervalMinutes)}&timeOfDay=${encodeURIComponent(timeOfDay)}&sunday=${sunday}&monday=${monday}&tuesday=${tuesday}&wednesday=${wednesday}&thursday=${thursday}&friday=${friday}&saturday=${saturday}&projectId=${encodeURIComponent(projectId)}&threadId=${encodeURIComponent(draft.threadId)}&workspaceMode=${workspaceMode}&baseRef=${encodeURIComponent(baseRef)}&startFromOrigin=${startFromOrigin}&path=${encodeURIComponent(path)}&modelKey=${encodeURIComponent(modelKey)}`) disabled=(busy or draft.missing or not data.available) testId="save-scheduled-task" display="flex" flex-direction="row" align-items="center" justify-content="center" height=28 padding-left=9 padding-right=9 border-radius=8 border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" opacity=(busy or draft.missing or not data.available ? 0.64 : 1)
            text (draft.id == "" ? "Create task" : "Save task") font-size=14 font-weight=500 line-height="20px" color="#ffffff"

fn projectLabel(options: list<SelectOption>, value: string): string = join(map(filter(options, option => option.value == value), option => option.label), "")
fn modelLabel(options: list<SelectOption>, value: string): string = join(map(filter(options, option => option.value == value), option => option.label), "")
fn markField(marks: list<TaskModelMark>, value: string, field: string): string = join(map(filter(marks, mark => mark.value == value), mark => field == "driver" ? mark.driver : (field == "badge" ? mark.badge : (field == "accent" ? mark.accent : mark.name))), "")

component Weekday
  props
    label: string
    short: string
    on: bool
    first: bool
    last: bool
    press: action
  view
    button press=press aria-label=label aria-checked=on testId=`task-day-${label}` height=28 min-width=28 padding-left=5 padding-right=5 box-sizing="border-box" border-style="solid" border-width=1 border-left-width=(first ? 1 : 0) border-color="light-dark(#d4d4d8, #ffffff14)" border-top-left-radius=(first ? 10 : 0) border-bottom-left-radius=(first ? 10 : 0) border-top-right-radius=(last ? 10 : 0) border-bottom-right-radius=(last ? 10 : 0) background-color=(on ? "light-dark(#d5d5d8a3, #ffffff14)" : "light-dark(#fcfcfc, #ffffff07)")
      text short font-size=14 font-weight=500 line-height="20px" color=(on ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#27272a, #f5f5f5)")
