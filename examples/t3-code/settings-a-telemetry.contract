// Settings → Diagnostics (lane settings-a; settings-a-telemetry.ts): the resource
// telemetry sections of ResourceTelemetryDiagnostics.tsx, and the table, badge,
// toggle group, tooltip and expandable text the whole Diagnostics page shares.
use Card from "./settings-source-control.contract"
use LucideActivity from "./settings-icons.contract"
use LucideBattery from "./settings-icons.contract"
use LucideChevronRight from "./settings-icons.contract"
use LucideCopy from "./settings-icons.contract"
use LucideCpu from "./settings-icons.contract"
use LucideDatabase from "./settings-icons.contract"
use LucideGauge from "./settings-icons.contract"
use LucideHardDrive from "./settings-icons.contract"
use LucideMemoryStick from "./settings-icons.contract"
use LucideRefreshCw from "./settings-icons.contract"
use LucideTriangleAlert from "./settings-icons.contract"

shape DxCell
  id: string
  text: string
  tone: string
  align: string
  width: number
  mono: bool
  tip: string
  lead: bool
shape DxRow
  id: string
  first: bool
  cells: list<DxCell>
  depth: number
  toggle: string
  dot: string
  signal: bool
  busy: bool
  target: string
  name: string
  expand: bool
  detail: string
  trace: string
  traceLabel: string
  level: string
shape DxTable
  id: string
  minWidth: number
  headers: list<DxCell>
  rows: list<DxRow>
  empty: string
shape KillConfirm
  pid: string
  message: string
shape TmStat
  id: string
  icon: string
  label: string
  value: string
  detail: string
  tone: string
shape TmGroup
  id: string
  label: string
  accent: string
  count: string
  cpu: string
  memory: string
  read: string
  write: string
shape TmDetail
  id: string
  label: string
  value: string
  tone: string
shape TmSource
  id: string
  label: string
  detail: string
  badge: string
  tone: string
shape TmBucket
  id: string
  cpu: number
  read: number
  write: number
  tip: string
shape TelemetryView
  ready: bool
  badge: string
  badgeTone: string
  updated: string
  updatedValue: string
  sampling: string
  error: string
  stats: list<TmStat>
  groups: list<TmGroup>
  retry: bool
  hostSignals: bool
  host: list<TmDetail>
  sources: list<TmSource>
  health: list<TmDetail>
  window: string
  historyError: string
  buckets: list<TmBucket>
  history: DxTable
  tree: DxTable
  attribution: DxTable

// Semantic tokens (index.css): success emerald, info blue, warning amber, server violet.
fn dxTone(tone: string): string = tone == "muted" ? "light-dark(#71717b, #818181)" : tone == "info" ? "light-dark(#1447e6, #51a2ff)" : tone == "warning" ? "light-dark(#bb4d00, #ffb900)" : tone == "danger" ? "light-dark(#fb2c36, #fb414a)" : tone == "success" ? "light-dark(#007a55, #00d492)" : "light-dark(#27272a, #f5f5f5)"
fn dxDot(dot: string): string = dot == "warning" ? "#fe9a00" : dot == "warning-root" ? "#fe9a00e6" : dot == "info" ? "#2b7fff" : dot == "violet" ? "#8e51ff" : "#00bc7dcc"

// SettingsSection's header: the 14pt title at 70% with its optional 16pt icon.
component DxHeading
  props
    title: string
    icon: string
  view
    row min-width=0 gap=8 align-items="center"
      when icon == "activity"
        LucideActivity(size=16, color="light-dark(#71717b, #818181)")
      when icon == "gauge"
        LucideGauge(size=16, color="light-dark(#71717b, #818181)")
      when icon == "hard-drive"
        LucideHardDrive(size=16, color="light-dark(#71717b, #818181)")
      when icon == "cpu"
        LucideCpu(size=16, color="light-dark(#71717b, #818181)")
      when icon == "database"
        LucideDatabase(size=16, color="light-dark(#71717b, #818181)")
      text title font-size=14 font-weight=400 line-height="20px" color="light-dark(#27272ab3, #f5f5f5b3)" role="heading" aria-level=2

// The rounded-2xl card the telemetry sections draw inside the section's card.
component DxInner
  slot
  view
    column width="100%" box-sizing="border-box" border-radius=13 overflow="hidden" background-color="light-dark(#ffffff, #111111)"
      children

// Button size icon-micro/icon-xs, variant ghost: the refresh glyph with its tooltip.
component DxRefresh
  props
    label: string
    tip: string
    size: number
    busy: bool
    press: action
    refreshId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box position="relative" width=size height=size flex-shrink=0
      button press=press hover=hover disabled=busy aria-label=label testId=refreshId width=size height=size padding=0 border-width=0 border-radius=6 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" opacity=(busy ? 0.64 : 1)
        LucideRefreshCw(size=(size >= 24 ? 14 : 12), color="light-dark(#71717b, #818181)")
      when hovered
        DxTip(text=tip, right=0, bottom=(size + 6))

// TooltipPopup side top: a small popover-coloured label above its trigger.
component DxTip
  props
    text: string
    right: number
    bottom: number
  view
    text text position="absolute" right=right bottom=bottom z-index=60 padding-top=4 padding-bottom=4 padding-left=8 padding-right=8 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #181818)" box-shadow="0 4px 12px #0000001f" font-size=12 line-height="16px" color="light-dark(#27272a, #f5f5f5)" white-space="pre" role="tooltip"

// SourceStatusBadge: an uppercase pill with its dot, toned by the source status.
component DxBadge
  props
    label: string
    tone: string
    badgeId: string
  view
    row flex-shrink=0 align-items="center" gap=6 height=24 padding-left=10 padding-right=10 box-sizing="border-box" border-radius=999 border-width=1 border-style="solid" border-color=(tone == "danger" ? "light-dark(#fb2c364d, #fb414a4d)" : tone == "warning" ? "#fe9a004d" : tone == "default" ? "#00bc7d40" : "light-dark(#e4e4e7b3, #ffffff0b)") background-color=(tone == "danger" ? "light-dark(#fb2c361a, #fb414a1a)" : tone == "warning" ? "#fe9a001a" : tone == "default" ? "#00bc7d1a" : "light-dark(#fafafa73, #ffffff03)") testId=badgeId
      box width=6 height=6 border-radius=3 flex-shrink=0 background-color=(tone == "danger" ? "light-dark(#fb2c36, #fb414a)" : tone == "warning" ? "#fe9a00" : tone == "default" ? "#00bc7d" : "light-dark(#71717b8c, #8181818c)")
      text label font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" white-space="nowrap" color=(tone == "danger" ? "light-dark(#fb2c36, #fb414a)" : tone == "warning" ? "light-dark(#bb4d00, #ffb900)" : tone == "default" ? "light-dark(#007a55, #00d492)" : "light-dark(#71717b, #818181)")

// ToggleGroup variant segmented: the period buttons, the pressed one raised.
component DxPeriods
  props
    label: string
    selected: string
    choose: action
    groupId: string
  view
    row role="group" aria-label=label padding=2 gap=2 border-radius=10 background-color="light-dark(#d4d4d866, #ffffff08)" testId=groupId
      DxPeriod(period="5m", selected=selected, choose=choose, groupId=groupId)
      DxPeriod(period="15m", selected=selected, choose=choose, groupId=groupId)
      DxPeriod(period="30m", selected=selected, choose=choose, groupId=groupId)
      DxPeriod(period="1h", selected=selected, choose=choose, groupId=groupId)
component DxPeriod
  props
    period: string
    selected: string
    choose: action
    groupId: string
  view
    button press=choose(period) aria-checked=(period == selected) role="radio" aria-label=period testId=`${groupId}-${period}` height=24 padding-left=10 padding-right=10 border-radius=8 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(period == selected ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(period == selected ? "0 1px 2px #0000000d" : "none")
      text period font-size=14 font-weight=500 line-height="20px" color=(period == selected ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// ExpandableText: clamped to two or three lines, with Show full error / Show less.
component DxExpandable
  props
    text: string
    lines: number
    label: string
    tone: string
  state expanded = false
  action toggle
    expanded = not expanded
  view
    column min-width=0 width="100%" gap=4 align-items="flex-start"
      when expanded
        text text font-size=12 line-height="16px" white-space="pre-wrap" overflow-wrap="anywhere" color=dxTone(tone) width="100%"
      else
        text text font-size=12 line-height="16px" white-space="pre-wrap" overflow-wrap="anywhere" color=dxTone(tone) line-clamp=lines width="100%"
      button press=toggle aria-expanded=expanded padding=0 border-width=0 background-color="#00000000"
        text (expanded ? "Show less" : label) font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"

// ProcessSignalActions: INT (muted) and KILL (destructive) inline buttons.
component DxSignals
  props
    row: DxRow
    busy: bool
    signal: action
  view
    row flex=1 min-width=0 gap=6 justify-content="flex-end" align-items="center"
      when row.signal
        button press=signal("diag-signal", `${row.target}&signal=SIGINT`) disabled=(busy or row.busy) aria-label="Send SIGINT" testId=`signal-int-${row.id}` padding=0 border-width=0 background-color="#00000000" opacity=(row.busy ? 0.64 : 1)
          text "INT" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"
        button press=signal("diag-signal", `${row.target}&signal=SIGKILL`) disabled=(busy or row.busy) aria-label="Send SIGKILL" testId=`signal-kill-${row.id}` padding=0 border-width=0 background-color="#00000000" opacity=(row.busy ? 0.64 : 1)
          text "KILL" font-size=12 font-weight=500 line-height="16px" color="light-dark(#fb2c36cc, #fb414acc)"
      else
        text "—" font-size=10 line-height="14px" color="light-dark(#71717b59, #81818159)"

// A process name: the tree indent, a disclosure (or its space), the category dot.
component DxName
  props
    row: DxRow
    cell: DxCell
    toggle: action
    toggleOp: string
  view
    row flex=1 min-width=0 gap=8 align-items="center" padding-left=(row.depth * 10) box-sizing="border-box"
      when row.toggle == "expand" or row.toggle == "collapse"
        button press=toggle(toggleOp, row.id) aria-label=`${row.toggle == "expand" ? "Expand" : "Collapse"} ${row.name}` aria-expanded=(row.toggle == "collapse") testId=`dx-toggle-${row.id}` width=20 height=20 flex-shrink=0 padding=0 border-width=0 border-radius=4 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
          // f2cc80a7 MorphIcon ChevronRight↔ChevronDown: congruent under 90°, so the glyph turns (morphicons' snappy spring).
          box rotate=(row.toggle == "collapse" ? "90deg" : "0deg") transition="rotate spring(420, 30, 1)" display="flex"
            LucideChevronRight(size=14, color="light-dark(#71717b, #818181)")
      else
        box width=20 height=20 flex-shrink=0
      box width=6 height=6 border-radius=3 flex-shrink=0 background-color=dxDot(row.dot)
      text cell.text font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 flex=1 min-width=0 aria-description=cell.tip

// DiagnosticsTable / the telemetry tables: a table-fixed colgroup over a minimum
// width, scrolled sideways when the card is narrower. variant: telemetry (3xs
// head, px-3 py-2), process (2xs head, px-3 py-2) or trace (2xs head, px-4 py-3, top-aligned).
component DxTableView
  props
    table: DxTable
    variant: string
    busy: bool
    signal: action
    toggle: action
    toggleOp: string
    copy: action
  view
    scroll width="100%" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" border-top-width=(variant == "trace" ? 0 : 1) border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" testId=`diagnostics-table-${table.id}`
      column width="100%" min-width=table.minWidth
        row width="100%" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" background-color="light-dark(#ffffff, #111111)"
          each head in table.headers key=head.id
            text head.text width=`${head.width}%` flex-shrink=0 box-sizing="border-box" padding-top=(variant == "trace" ? 10 : 8) padding-bottom=(variant == "trace" ? 10 : 8) padding-left=(head.lead ? 20 : (variant == "trace" ? 16 : 12)) padding-right=(variant == "trace" ? 16 : 12) font-size=(variant == "telemetry" ? 10 : 11) font-weight=600 line-height=(variant == "telemetry" ? "14px" : "16px") letter-spacing=1 text-transform="uppercase" text-align=head.align white-space="nowrap" line-clamp=1 color=(variant == "telemetry" ? "light-dark(#71717ba6, #818181a6)" : "light-dark(#71717bb3, #818181b3)")
        when length(table.rows) == 0
          text table.empty font-size=12 line-height="16px" padding-left=20 padding-right=20 padding-top=(variant == "telemetry" ? 20 : 16) padding-bottom=(variant == "telemetry" ? 20 : 16) color="light-dark(#71717b, #818181)" testId=`diagnostics-empty-${table.id}`
        each item in table.rows key=item.id
          row width="100%" box-sizing="border-box" align-items=(variant == "trace" ? "flex-start" : "center") border-top-width=(item.first ? 0 : 1) border-top-style="solid" border-color=(variant == "trace" ? "light-dark(#e4e4e799, #ffffff09)" : "light-dark(#e4e4e780, #ffffff08)") testId=`diagnostic-row-${table.id}-${item.id}`
            each part in item.cells key=part.id
              row width=`${part.width}%` flex-shrink=0 min-width=0 box-sizing="border-box" align-items="center" padding-top=(variant == "trace" ? 12 : 8) padding-bottom=(variant == "trace" ? 12 : 8) padding-left=(part.lead ? 20 : (variant == "trace" ? 16 : 12)) padding-right=(variant == "trace" ? 16 : (part.id == "kill" ? 16 : 12)) justify-content=(part.align == "right" ? "flex-end" : "flex-start")
                when part.id == "kill"
                  DxSignals(row=item, busy=busy, signal=signal)
                when part.id == "trace"
                  row flex=1 min-width=0 gap=8 align-items="center"
                    text item.traceLabel font-family="ui-monospace" font-size=11 line-height="16px" line-clamp=1 flex=1 min-width=0 color="light-dark(#71717b, #818181)" aria-description=item.trace
                    button press=copy(item.trace) aria-label="Copy trace ID" testId=`copy-trace-${table.id}-${item.id}` width=20 height=20 flex-shrink=0 padding=0 border-width=0 border-radius=4 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                      LucideCopy(size=12, color="light-dark(#71717b, #818181)")
                when part.id == "level"
                  text part.text font-family="ui-monospace" font-size=11 font-weight=500 line-height="16px" text-transform="uppercase" padding-left=6 padding-right=6 padding-top=2 padding-bottom=2 border-radius=4 background-color="light-dark(#f4f4f5, #ffffff0f)" color="light-dark(#27272acc, #f5f5f5cc)"
                when (part.id == "process" or part.id == "name") and item.toggle != ""
                  DxName(row=item, cell=part, toggle=toggle, toggleOp=toggleOp)
                when (part.id == "cause" or part.id == "message") and item.expand
                  DxExpandable(text=part.text, lines=(part.id == "message" ? 2 : 3), label=item.detail, tone=part.tone)
                when part.id != "kill" and part.id != "trace" and part.id != "level" and not ((part.id == "process" or part.id == "name") and item.toggle != "") and not ((part.id == "cause" or part.id == "message") and item.expand)
                  when variant == "trace" and not part.mono
                    text part.text font-size=12 font-weight=(part.tone == "strong" ? 500 : 400) line-height="16px" white-space="pre-wrap" overflow-wrap="anywhere" min-width=0 flex=1 color=dxTone(part.tone)
                  else
                    text part.text font-family=(part.mono ? "ui-monospace" : "system-ui") font-size=12 font-weight=(part.tone == "strong" or part.id == "process" ? 500 : 400) line-height="16px" text-align=part.align white-space="nowrap" line-clamp=1 min-width=0 flex=1 color=dxTone(part.tone) aria-description=part.tip

// IconStat: an uppercase label with its glyph, the 24pt mono value and its detail.
component TmStatView
  props
    stat: TmStat
    last: bool
    row: number
  view
    column width="33.333%" min-width=0 box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=20 padding-right=20 border-right-width=(last ? 0 : 1) border-right-style="solid" border-bottom-width=(row == 0 ? 1 : 0) border-bottom-style="solid" border-color="light-dark(#e4e4e78c, #ffffff08)" testId=`telemetry-stat-${stat.id}`
      row gap=8 align-items="center" min-width=0
        when stat.icon == "cpu"
          LucideCpu(size=14, color="light-dark(#71717b8c, #8181818c)")
        when stat.icon == "memory-stick"
          LucideMemoryStick(size=14, color="light-dark(#71717b8c, #8181818c)")
        when stat.icon == "activity"
          LucideActivity(size=14, color="light-dark(#71717b8c, #8181818c)")
        when stat.icon == "hard-drive"
          LucideHardDrive(size=14, color="light-dark(#71717b8c, #8181818c)")
        when stat.icon == "database"
          LucideDatabase(size=14, color="light-dark(#71717b8c, #8181818c)")
        when stat.icon == "gauge"
          LucideGauge(size=14, color="light-dark(#71717b8c, #8181818c)")
        text stat.label font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" color="light-dark(#71717bb3, #818181b3)" line-clamp=1
      text stat.value margin-top=10 font-family="ui-monospace" font-size=24 font-weight=600 line-height="32px" letter-spacing=-1.2 line-clamp=1 color=(stat.tone == "danger" ? "light-dark(#fb2c36, #fb414a)" : stat.tone == "warning" ? "light-dark(#bb4d00, #ffb900)" : "light-dark(#27272a, #f5f5f5)")
      when stat.detail != ""
        text stat.detail margin-top=6 font-size=10 line-height="14px" line-clamp=1 color="light-dark(#71717b99, #81818199)"

component TmPair
  props
    label: string
    value: string
  view
    column width="50%" min-width=0 box-sizing="border-box" padding-right=8
      text label font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" color="light-dark(#71717b73, #81818173)"
      text value font-family="ui-monospace" font-size=12 font-weight=500 line-height="16px" line-clamp=1 color="light-dark(#27272ae6, #f5f5f5e6)"

component TmDetailRow
  props
    item: TmDetail
    first: bool
  view
    row width="100%" justify-content="space-between" align-items="center" gap=16 padding-top=10 padding-bottom=10 box-sizing="border-box" border-top-width=(first ? 0 : 1) border-top-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)"
      text item.label font-size=11 line-height="16px" color="light-dark(#71717bbf, #818181bf)"
      text item.value font-family="ui-monospace" font-size=11 line-height="16px" text-align="right" line-clamp=1 min-width=0 color=(item.tone == "danger" ? "light-dark(#fb2c36, #fb414a)" : item.tone == "warning" ? "light-dark(#bb4d00, #ffb900)" : "light-dark(#27272ad9, #f5f5f5d9)")

component TmPanelTitle
  props
    title: string
    icon: string
  view
    row gap=8 align-items="center" margin-bottom=12
      box width=24 height=24 border-radius=8 background-color="light-dark(#fafafa99, #ffffff05)" display="flex" align-items="center" justify-content="center"
        when icon == "battery"
          LucideBattery(size=14, color="light-dark(#71717bb3, #818181b3)")
        else
          LucideGauge(size=14, color="light-dark(#71717bb3, #818181b3)")
      text title font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" color="light-dark(#71717bb3, #818181b3)"

// ResourceTelemetryDiagnostics: Resource monitor, Host & collection, Resource
// timeline, Live process tree and Instrumented application I/O.
component TelemetrySections
  props
    t: TelemetryView
    busy: bool
    rest: action
    local: action
    reload: action
    copy: action
  view
    column width="100%" gap=40
      column width="100%" gap=10 testId="telemetry-monitor"
        row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="center" justify-content="space-between" box-sizing="border-box"
          DxHeading(title="Resource monitor", icon="activity")
          row gap=8 align-items="center"
            when t.ready
              DxBadge(label=t.badge, tone=t.badgeTone, badgeId="telemetry-native-badge")
            row gap=3 align-items="baseline"
              text t.updated font-size=11 line-height="16px" color=(t.updatedValue == "" ? "light-dark(#71717b8c, #8181818c)" : "light-dark(#71717b99, #81818199)")
              when t.updatedValue != ""
                text t.updatedValue font-family="ui-monospace" font-size=11 line-height="16px" color="light-dark(#71717b99, #81818199)"
            DxRefresh(label="Refresh resource telemetry", tip="Refresh telemetry snapshot", size=20, busy=busy, press=reload, refreshId="refresh-resource-telemetry")
        Card()
          DxInner()
            row width="100%" gap=12 padding-top=16 padding-bottom=16 padding-left=20 padding-right=20 box-sizing="border-box" align-items="center" justify-content="space-between" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" background-image="linear-gradient(to right, #a1a1aa05, #a1a1aa03, #a1a1aa00)"
              column min-width=0 flex=1 max-width=576 gap=4
                text "T3 system footprint" font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" color="light-dark(#71717bb3, #818181b3)"
                text "Live native counters for the server, providers, terminals, desktop processes, and the monitor itself." font-size=12 line-height="19.5px" color="light-dark(#71717b, #818181)"
              row gap=8 align-items="center" flex-shrink=0
                box width=6 height=6 border-radius=3 background-color="#00bc7d"
                text t.sampling font-size=10 line-height="14px" color="light-dark(#71717ba6, #818181a6)"
            row width="100%" flex-wrap="wrap"
              each stat in t.stats key=stat.id
                TmStatView(stat=stat, last=(stat.id == "processes" or stat.id == "speed"), row=(stat.id == "cpu" or stat.id == "memory" or stat.id == "processes" ? 0 : 1))
            when t.error != ""
              row gap=8 align-items="flex-start" padding-top=12 padding-bottom=12 padding-left=20 padding-right=20 box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#fb2c3633, #fb414a33)" background-color="light-dark(#fb2c360d, #fb414a0d)"
                box padding-top=2
                  LucideTriangleAlert(size=14, color="light-dark(#fb2c36, #fb414a)")
                text t.error font-size=12 line-height="16px" color="light-dark(#fb2c36, #fb414a)" flex=1 min-width=0 role="alert" testId="telemetry-error"
            when t.ready
              row width="100%" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" background-color="light-dark(#fafafa1a, #ffffff01)"
                each group in t.groups key=group.id
                  column position="relative" width="33.333%" min-width=0 box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=20 padding-right=20 border-left-width=(group.id == "backend" ? 0 : 1) border-left-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" testId=`telemetry-group-${group.id}`
                    box position="absolute" left=20 right=20 top=0 height=2 border-radius=1 opacity=0.75 background-color=(group.accent == "success" ? "#00bc7dcc" : group.accent == "info" ? "#2b7fffcc" : "#fe9a00cc")
                    row justify-content="space-between" align-items="center" gap=12
                      text group.label font-size=10 font-weight=600 line-height="14px" letter-spacing=1 text-transform="uppercase" color="light-dark(#71717bbf, #818181bf)" line-clamp=1
                      text group.count font-family="ui-monospace" font-size=10 line-height="14px" padding-left=6 padding-right=6 padding-top=2 padding-bottom=2 border-radius=6 background-color="light-dark(#fafafa8c, #ffffff04)" color="light-dark(#71717bb3, #818181b3)" white-space="nowrap"
                    column width="100%" margin-top=14 gap=10
                      row width="100%"
                        TmPair(label="CPU", value=group.cpu)
                        TmPair(label="Memory", value=group.memory)
                      row width="100%"
                        TmPair(label="Read", value=group.read)
                        TmPair(label="Write", value=group.write)
      column width="100%" gap=10 testId="telemetry-host"
        row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="center" justify-content="space-between" box-sizing="border-box"
          DxHeading(title="Host & collection", icon="gauge")
          when t.retry
            button press=rest("diag-retry", "") disabled=busy testId="telemetry-retry" height=24 padding-left=7 padding-right=7 gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" opacity=(busy ? 0.64 : 1)
              LucideRefreshCw(size=12, color="light-dark(#71717b, #818181)")
              text "Retry monitor" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
        Card()
          DxInner()
            row width="100%" align-items="stretch"
              column width="50%" min-width=0 box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=20 padding-right=20 border-right-width=1 border-right-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
                TmPanelTitle(title="Host state", icon="battery")
                when t.hostSignals
                  each item in t.host key=item.id
                    TmDetailRow(item=item, first=(item.id == "power"))
                else
                  column gap=6 padding-top=20 padding-bottom=20 padding-left=16 padding-right=16 box-sizing="border-box" border-radius=14 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#fafafa33, #ffffff02)"
                    text "Desktop host signals not connected" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                    text "Power, idle, lock, and thermal state are supplied by the desktop host. Process telemetry remains fully active in this browser session." font-size=11 line-height="17.875px" max-width=384 color="light-dark(#71717bb3, #818181b3)"
              column width="50%" min-width=0 box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=20 padding-right=20
                TmPanelTitle(title="Collection health", icon="gauge")
                when t.ready
                  each source in t.sources key=source.id
                    row width="100%" justify-content="space-between" align-items="flex-start" gap=16 padding-top=12 padding-bottom=12 box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)" testId=`telemetry-source-${source.id}`
                      column min-width=0 flex=1 gap=4
                        text source.label font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                        text source.detail font-size=11 line-height="17.875px" color="light-dark(#71717ba6, #818181a6)"
                      DxBadge(label=source.badge, tone=source.tone, badgeId=`telemetry-source-badge-${source.id}`)
                  each item in t.health key=item.id
                    TmDetailRow(item=item, first=false)
                else
                  text "Waiting for collector health." font-size=12 line-height="16px" padding-top=16 padding-bottom=16 color="light-dark(#71717b, #818181)"
      column width="100%" gap=10 testId="telemetry-timeline"
        row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="center" justify-content="space-between" box-sizing="border-box"
          DxHeading(title="Resource timeline", icon="hard-drive")
          row gap=8 align-items="center"
            DxPeriods(label="Resource history period", selected=t.window, choose=local("diag-window"), groupId="telemetry-window")
            DxRefresh(label="Refresh resource history", tip="Refresh resource history", size=20, busy=busy, press=reload, refreshId="refresh-telemetry-history")
        Card()
          DxInner()
            when t.historyError != ""
              row gap=8 align-items="flex-start" padding-top=12 padding-bottom=12 padding-left=20 padding-right=20 box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#fb2c3633, #fb414a33)" background-color="light-dark(#fb2c360d, #fb414a0d)"
                LucideTriangleAlert(size=14, color="light-dark(#fb2c36, #fb414a)")
                text t.historyError font-size=12 line-height="16px" color="light-dark(#fb2c36, #fb414a)" flex=1 min-width=0 role="alert"
            column width="100%" padding-top=16 padding-bottom=16 padding-left=20 padding-right=20 box-sizing="border-box" gap=12
              row gap=16 align-items="center"
                TmLegend(label="CPU average", color="light-dark(#27272ab3, #f5f5f5b3)")
                TmLegend(label="I/O reads", color="#2b7fffb3")
                TmLegend(label="I/O writes", color="#fe9a00cc")
              row width="100%" height=128 align-items="flex-end" gap=4 padding-top=12 padding-bottom=8 padding-left=8 padding-right=8 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#fafafa14, #ffffff01)" overflow="hidden" testId="telemetry-chart"
                each bucket in t.buckets key=bucket.id
                  row flex=1 min-width=4 height="100%" align-items="flex-end" gap=1 aria-label=bucket.tip
                    box flex=1 height=`${bucket.cpu}%` border-radius=2 background-color="light-dark(#27272aa6, #f5f5f5a6)"
                    box flex=1 height=`${bucket.read}%` border-radius=2 background-color="#2b7fffb3"
                    box flex=1 height=`${bucket.write}%` border-radius=2 background-color="#fe9a00cc"
            DxTableView(table=t.history, variant="telemetry", busy=busy, signal=rest, toggle=local, toggleOp="diag-tree", copy=copy)
      column width="100%" gap=10 testId="telemetry-tree"
        row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="center" justify-content="space-between" box-sizing="border-box"
          DxHeading(title="Live process tree", icon="cpu")
          when t.ready
            row gap=4 align-items="baseline"
              text "Identity:" font-size=10 line-height="14px" color="light-dark(#71717b8c, #8181818c)"
              text "PID + start time" font-family="ui-monospace" font-size=10 line-height="14px" color="light-dark(#71717b8c, #8181818c)"
        Card()
          DxInner()
            DxTableView(table=t.tree, variant="telemetry", busy=busy, signal=rest, toggle=local, toggleOp="diag-tree", copy=copy)
      column width="100%" gap=10 testId="telemetry-attribution"
        row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="center" justify-content="space-between" box-sizing="border-box"
          DxHeading(title="Instrumented application I/O", icon="database")
          text "Logical bytes by operation" font-size=10 line-height="14px" color="light-dark(#71717b8c, #8181818c)"
        Card()
          DxInner()
            text "Native counters identify which process is reading or writing. These application-level counters identify known T3 operations so process spikes can be correlated with specific persistence and logging paths." font-size=11 line-height="17.875px" padding-top=12 padding-bottom=12 padding-left=20 padding-right=20 color="light-dark(#71717b, #818181)" background-color="light-dark(#fafafa26, #ffffff01)"
            DxTableView(table=t.attribution, variant="telemetry", busy=busy, signal=rest, toggle=local, toggleOp="diag-tree", copy=copy)

component TmLegend
  props
    label: string
    color: string
  view
    row gap=6 align-items="center"
      box width=12 height=6 border-radius=3 background-color=color
      text label font-size=10 line-height="14px" color="light-dark(#71717ba6, #818181a6)"
