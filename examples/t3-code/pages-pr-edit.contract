// Rewriting a pull request's words (lane "pages"; pr-writing-and-metadata), measured against T3 Code
// 1e2ecbd975 (MIT, see LICENSE-T3) components/pullRequest/PullRequestEditButton.tsx (the pencil
// revealed on hover or focus), PullRequestMarkdownEditor.tsx (Write/Preview, ⌘↵ saves, Escape
// cancels unless saving), PullRequestCommentBody.tsx (a remark taller than 240pt collapses behind
// "Show full comment"), PullRequestDetailPanel.tsx's title (one line: Enter saves, Escape cancels)
// and PullRequestSummaryTab.tsx's description. The model is pages-pr-writes.ts: an editor sends its
// words with a pages:pr-act-* write and closes when that write's serial arrives (a failure keeps
// the editor and the words; "Saving..." while the host answers).
use PgIcon from "./pages-icons.contract"
use ChatMarkdown from "./markdown.contract"
use ChatDocument from "./markdown.contract"
use CodeHighlight from "./markdown.contract"
use MarkdownEnv from "./markdown.contract"

fn preMuted(): string = "light-dark(#71717b, #818181)"
fn preInk(): string = "light-dark(#27272a, #f5f5f5)"
fn preField(): string = "light-dark(#d4d4d8, #ffffff14)"

// PullRequestEditButton: an icon-xs ghost-muted pencil, shown while its row is hovered or it has the
// focus (opacity, so it keeps its place and its Tab stop); no fade under reduced motion.
component PrdEditButton
  props
    label: string
    shown: bool
    still: bool
    press: action
    testId: string
  state focused = false
  state over = false
  action focusing(value: bool)
    focused = value
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover focus=focusing(true) blur=focusing(false) aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.5rem" border-width=0 opacity=(shown or focused ? 1 : 0) transition=(still ? "none" : "opacity 150ms cubic-bezier(0.4, 0, 0.2, 1)") background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" align-items="center" justify-content="center"
      PgIcon(name="pencil", size=12, color=(over ? preInk() : preMuted()))

// Button size="xs": outline (Save, Comment), ghost (Cancel) or primary (Submit review).
component PrdSmallButton
  props
    label: string
    icon: string
    tone: string
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(tone == "primary" ? "light-dark(#1b4ed8, #346bf1)" : tone == "ghost" ? "#00000000" : preField()) background-color=(tone == "primary" ? (over and not disabled ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") : (over and not disabled ? "light-dark(#f4f4f5, #ffffff0d)" : (tone == "ghost" ? "#00000000" : "light-dark(#ffffff, #ffffff07)"))) box-shadow=(tone == "ghost" ? "none" : "0 1px 2px #0000000d") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
      when icon != ""
        PgIcon(name=icon, size=14, color=(tone == "primary" ? "#ffffff" : tone == "destructive" ? "light-dark(#e40014, #ff6467)" : preMuted()))
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=(tone == "primary" ? "#ffffff" : tone == "destructive" ? "light-dark(#e40014, #ff6467)" : preInk())

// ToggleGroup variant="segmented": two or more pressed-or-not buttons in a tinted track.
component PrdSegment
  props
    label: string
    pressed: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled aria-pressed=pressed testId=testId height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(pressed ? "light-dark(#ffffff, #ffffff1f)" : (over ? "light-dark(#ffffff8c, #ffffff0d)" : "#00000000")) box-shadow=(pressed ? "0 1px 2px #0000001a" : "none") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=(pressed or over ? preInk() : preMuted())

// A body of words where it sits, and the box it is rewritten in (PullRequestMarkdownEditor, with
// PullRequestCommentBody's 240pt hold for a remark). One markdown slot shows either the saved words
// or, while editing, the preview — the pull request's own renderer, fed the draft once (`preview`) —
// so a site costs one document in the plan. The caller owns the draft, the mode and the pencil's
// reveal; ⌘↵ saves and Escape cancels unless a save is out (the input method keeps its composing keys).
component PrdWords
  props
    bodyId: string
    emptyText: string
    collapse: bool
    canEdit: bool
    pencil: bool
    hovered: bool
    open: bool
    previewing: bool
    draft: string
    saving: bool
    allowEmpty: bool
    label: string
    placeholder: string
    previewId: string
    pencilLabel: string
    frameId: string
    testId: string
    still: bool
    documents: list<ChatDocument>
    code: list<CodeHighlight>
    env: MarkdownEnv
    local: action
    begin: action
    edit: action
    preview: action
    save: action
    cancel: action
  state expanded = false
  state tall = false
  derive empty = trim(draft) == ""
  derive saveDisabled = saving or (empty and not allowEmpty)
  derive shownId = open ? (empty ? "" : previewId) : bodyId
  derive held = not open and collapse and tall and not expanded
  action measured(width: number, height: number)
    tall = height > 240
  action toggleFull
    if expanded
      scrollIntoView(frameId, block="nearest")
    expanded = not expanded
  action keys(k: string, e: KeyboardEvent)
    if open and k == "Enter" and (e.metaKey or e.ctrlKey) and not e.shiftKey and not e.altKey
      preventDefault()
      stopPropagation()
      if not saveDisabled and not e.repeat
        save()
    else if open and k == "Escape" and not saving
      preventDefault()
      cancel()
  view
    // aria-modal while it edits: its Escape cancels (PullRequestMarkdownEditor prevents it) rather than the Pull Requests
    // page's Back taking it, as only shortcuts inside a shown modal are heard (usage-and-pr-pages PG-7).
    column width="100%" min-width=0 gap=(open ? "0.5rem" : "0px") key=keys tabindex=-1 aria-modal=open testId=testId
      when open
        row align-self="flex-start" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="group" aria-label="Markdown editor mode"
          PrdSegment(label="Write", pressed=(not previewing), disabled=saving, press=preview(false), testId=`${testId}-write`)
          PrdSegment(label="Preview", pressed=previewing, disabled=saving, press=preview(true), testId=`${testId}-preview`)
        when not previewing
          textarea value=draft input=edit autofocus=true disabled=saving rows=6 placeholder=placeholder aria-label=label autocorrect="off" spellcheck="false" testId=`${testId}-text` width="100%" min-height="8.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color=preField() background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=preInk() opacity=(saving ? 0.64 : 1)
      when not open or previewing
        row width="100%" align-items="flex-start" gap="0.25rem"
          column flex=1 min-width=0
            column id=frameId position="relative" max-height=(held ? 240 : 100000) overflow="hidden" padding-left=(open ? "0.75rem" : "0px") padding-right=(open ? "0.75rem" : "0px") padding-top=(open ? "0.5rem" : "0px") padding-bottom=(open ? "0.5rem" : "0px") box-sizing="border-box" border-radius="0.5rem" border-width=(open ? 1 : 0) border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" testId=(open ? `${testId}-preview-body` : frameId)
              column width="100%" resize=measured
                when shownId == ""
                  when open
                    text "Nothing to preview." font-size="0.75rem" line-height="1rem" color=preMuted()
                  else
                    when emptyText != ""
                      text emptyText font-size="0.875rem" line-height="1.421875rem" font-style="italic" color=preMuted()
                else
                  each document in filter(documents, (doc) => doc.id == shownId) key=document.id
                    ChatMarkdown(document=document, local=local, code=code, env=env)
              when held
                box position="absolute" left=0 right=0 bottom=0 height="2.5rem" background-image="linear-gradient(to top, light-dark(#fcfcfc, #0a0a0a), light-dark(#fcfcfc00, #0a0a0a00))" pointer-events="none" aria-hidden=true
            when not open and collapse and tall
              PrdShowFull(expanded=expanded, controls=frameId, press=toggleFull)
          when not open and pencil and canEdit
            PrdEditButton(label=pencilLabel, shown=hovered, still=still, press=begin, testId=`${testId}-edit`)
      when open
        row width="100%" justify-content="flex-end" gap="0.5rem"
          PrdSmallButton(label="Cancel", icon="", tone="ghost", disabled=saving, press=cancel, testId=`${testId}-cancel`)
          PrdSmallButton(label=(saving ? "Saving..." : "Save"), icon="", tone="outline", disabled=saveDisabled, press=save, testId=`${testId}-save`)

component PrdShowFull
  props
    expanded: bool
    controls: string
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover aria-expanded=expanded aria-controls=controls testId=`${controls}-toggle` align-self="flex-start" margin-top="0.5rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" align-items="center"
      text (expanded ? "Show less" : "Show full comment") font-size="0.75rem" line-height="1rem" font-weight=500 color=(over ? preInk() : preMuted())

// The header's title: the heading with its pencil, or (editing) a one-line field with Cancel and
// Save. Enter saves (an unchanged or empty title sends nothing), Escape cancels.
component PrdTitle
  props
    title: string
    canEdit: bool
    saving: bool
    serial: number
    still: bool
    act: action
  state editing = false
  state seen = 0
  state draft = ""
  state over = false
  derive open = editing and seen == serial
  action hover(value: bool)
    over = value
  action begin
    editing = true
    seen = serial
    draft = title
  action edit(text: string)
    draft = text
  action cancel
    editing = false
  // saveTitle: an empty or unchanged title closes the field and sends nothing.
  action save
    if trim(draft) == "" or trim(draft) == title
      editing = false
    else if not saving
      act("edit-title", draft)
  action keys(k: string)
    if k == "Enter"
      preventDefault()
      save()
    else if k == "Escape"
      preventDefault()
      editing = false
  view
    when open
      // aria-modal: its Escape cancels the edit, not the page's Back (usage-and-pr-pages PG-7).
      column width="100%" margin-top="0.25rem" gap="0.5rem" aria-modal=true testId="pull-request-title-editor"
        input value=draft input=edit key=keys autofocus=true disabled=saving aria-label="Pull request title" autocorrect="off" spellcheck="false" testId="pull-request-title-input" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.1875rem" padding-bottom="0.1875rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=preField() background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=preInk() opacity=(saving ? 0.64 : 1)
        row width="100%" justify-content="flex-end" gap="0.5rem"
          PrdSmallButton(label="Cancel", icon="", tone="ghost", disabled=saving, press=cancel, testId="pull-request-title-cancel")
          PrdSmallButton(label=(saving ? "Saving..." : "Save"), icon="", tone="outline", disabled=(saving or trim(draft) == ""), press=save, testId="pull-request-title-save")
    else
      row width="100%" min-height="1.5rem" margin-top="0.25rem" align-items="center" gap="0.25rem" hover=hover
        text title font-size="1rem" line-height="1.375rem" font-weight=600 color=preInk() role="heading" aria-level=1 flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="pull-request-title"
        when canEdit
          PrdEditButton(label="Edit title", shown=over, still=still, press=begin, testId="pull-request-edit-title")

// The Description section's body: the markdown (or "No description provided.") with its pencil,
// or the editor ("Describe this pull request"; empty is allowed: it clears the description).
component PrdDescription
  props
    bodyId: string
    raw: string
    canEdit: bool
    saving: bool
    serial: number
    scope: string
    documents: list<ChatDocument>
    code: list<CodeHighlight>
    env: MarkdownEnv
    still: bool
    local: action
    act: action
  state editing = false
  state seen = 0
  state draft = ""
  state previewing = false
  state over = false
  derive open = editing and seen == serial
  action hover(value: bool)
    over = value
  action begin
    editing = true
    seen = serial
    draft = raw
    previewing = false
  action edit(text: string)
    draft = text
  action preview(on: bool)
    previewing = on
    if on
      act("preview", `body|${draft}`)
  action save
    if not saving
      act("edit-body", draft)
  action cancel
    editing = false
  view
    column width="100%" hover=hover
      PrdWords(bodyId=bodyId, emptyText="No description provided.", collapse=false, canEdit=canEdit, pencil=true, hovered=over, open=open, previewing=previewing, draft=draft, saving=saving, allowEmpty=true, label="Pull request description", placeholder="Describe this pull request", previewId="pr-preview:body", pencilLabel="Edit description", frameId=`${scope}-description-body`, testId=`${scope}-description`, still=still, documents=documents, code=code, env=env, local=local, begin=begin, edit=edit, preview=preview, save=save, cancel=cancel)

// A remark's words where they sit (CommentBody): the 240pt-held body with the pencil this reader has
// on their own remarks, or the editor. A remark that is nothing but its verdict shows nothing unless
// it can be rewritten here, where the pencil lives (the caller decides).
component PrdRemarkBody
  props
    remarkId: string
    bodyId: string
    raw: string
    kind: string
    canEdit: bool
    saving: bool
    serial: number
    shown: bool
    scope: string
    documents: list<ChatDocument>
    code: list<CodeHighlight>
    env: MarkdownEnv
    still: bool
    local: action
    act: action
  state editing = false
  state seen = 0
  state draft = ""
  state previewing = false
  derive open = editing and seen == serial
  action begin
    editing = true
    seen = serial
    draft = raw
    previewing = false
  action edit(text: string)
    draft = text
  action preview(on: bool)
    previewing = on
    if on
      act("preview", `comment:${remarkId}|${draft}`)
  action save
    if not saving
      act("edit-comment", `${remarkId}|${kind}|${draft}`)
  action cancel
    editing = false
  view
    PrdWords(bodyId=bodyId, emptyText="", collapse=true, canEdit=canEdit, pencil=true, hovered=shown, open=open, previewing=previewing, draft=draft, saving=saving, allowEmpty=false, label="Edit comment", placeholder="", previewId=`pr-preview:comment:${remarkId}`, pencilLabel="Edit comment", frameId=`${scope}-comment-body-${remarkId}`, testId=`${scope}-comment-${remarkId}`, still=still, documents=documents, code=code, env=env, local=local, begin=begin, edit=edit, preview=preview, save=save, cancel=cancel)
