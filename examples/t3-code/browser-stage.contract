// browser-surface part 2: a Browser tab's page area (MIT reference, see LICENSE-T3, T3 Code 1e2ecbd975:
// apps/web/src/browser/HostedBrowserWebview.tsx, BrowserDeviceToolbar.tsx, BrowserViewportResizeHandles.tsx,
// useBrowserViewportResize.ts, browserViewportLayout.ts, ScreenRotationIcon.tsx; apps/web/src/components/
// preview/ZoomIndicator.tsx). Fill puts the page over the whole area. A fixed viewport (the device toolbar is
// shown) puts it under the 32 pt toolbar, centred between 10 pt rails and scaled down to fit (presentation only:
// the module's box scales the web view, T3BrowserView.swift), with five resize handles (the two sides, the bottom
// and its corners). A drag shows its size live and asks for it on release (browser-navigation.ts
// `viewport-drag`); the drawn size stays until the server's answer lands (`viewportSerial`). Arrow keys on a
// handle step 10 px, 50 with Shift. While the page or the URL field has the focus, the module answers the
// preview's chords (`keys`) and sends their command here (`pageKey`).
use BrowserPanel from "./browser-shapes.contract"
use BrowserPresetChoice from "./browser-shapes.contract"
use TipBubble from "./shell-tip.contract"

// ZoomIndicator: in 200 ms, held to 1.5 s, out in 200 ms.
keyframes bvZoomPill
  0% opacity=0 translate="0px -4px"
  12% opacity=1 translate="0px 0px"
  88% opacity=1 translate="0px 0px"
  to opacity=0 translate="0px -4px"

// Lucide 0.553 (ISC) glyphs, and ScreenRotationIcon (its rotated square drawn as a path).
fn bvPath(name: string): string = name == "link-2" ? "M9 17H7A5 5 0 0 1 7 7h2M15 7h2a5 5 0 1 1 0 10h-2M8 12h8" : name == "unlink-2" ? "M15 7h2a5 5 0 0 1 0 10h-2M9 17H7A5 5 0 0 1 7 7h2" : name == "x" ? "M18 6 6 18M6 6l12 12" : name == "chevron-down" ? "m6 9 6 6 6-6" : name == "check" ? "M20 6 9 17l-5-5" : name == "rotation" ? "M12 5.28 18.72 12 12 18.72 5.28 12ZM12.5 2a10 10 0 0 1 8.4 5.4M20.8 3.5v4h-4M11.5 22a10 10 0 0 1-8.4-5.4M3.2 20.5v-4h4" : ""

component BvIcon
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=bvPath(name)

// The live size of a drag on a rail (resizeBrowserViewportFromRail without the area cap's square root, which
// Contract has no function for: the release asks the data module for the exact size).
fn bvEndRail(start: number, d: number, avail: number): number = (start < avail ? (avail + start) / 2 : start) + d <= avail ? ((start < avail ? (avail + start) / 2 : start) + d) * 2 - avail : (start < avail ? (avail + start) / 2 : start) + d
fn bvStartRail(start: number, d: number, avail: number): number = start > avail ? (d <= start - avail ? start - d : avail - (d - (start - avail)) * 2) : ((avail - start) / 2 + d >= 0 ? avail - ((avail - start) / 2 + d) * 2 : avail - ((avail - start) / 2 + d))
fn bvClamp(v: number): number = min(3840, max(240, round(v)))
fn bvRail(size: number, z: number, d: number, avail: number, end: bool, start: bool): number = end ? size + (bvEndRail(size * z, d, avail) - size * z) / z : (start ? size + (bvStartRail(size * z, d, avail) - size * z) / z : size)
fn bvLockedWidth(w: number, ratio: number): number = min(floor(min(3840, 3840 * ratio)), max(ceil(max(240, 240 * ratio)), round(w)))
fn bvLockedHeight(h: number, ratio: number): number = min(floor(min(3840, 3840 / ratio)), max(ceil(max(240, 240 / ratio)), round(h)))

component BrowserStage
  props
    view: BrowserPanel
    pw: number
    ph: number
    urlFocused: bool
    local: action
  state dragDir = ""
  state dragX = 0
  state dragY = 0
  // A released drag keeps its size drawn until the commit's answer bumps the serial (or the setting changes).
  state heldKey = ""
  state heldSerial = -1
  state heldW = 0
  state heldH = 0
  state over = ""
  derive fixed = view.viewportMode != "fill"
  derive z = view.zoomFactor > 0 ? view.zoomFactor : 1
  derive aw = max(1, round(pw - 20))
  derive ah = max(1, round(ph - 42))
  derive scale0 = view.viewportWidth > 0 and view.viewportHeight > 0 ? min(1, min(aw / (view.viewportWidth * z), ah / (view.viewportHeight * z))) : 1
  derive dz = z * scale0
  derive ratio = view.viewportHeight > 0 ? view.viewportWidth / view.viewportHeight : 1
  derive rawW = bvRail(view.viewportWidth, dz, dragX, aw, endsWith(dragDir, "east"), endsWith(dragDir, "west"))
  derive rawH = bvRail(view.viewportHeight, dz, dragY, ah, startsWith(dragDir, "south"), startsWith(dragDir, "north"))
  derive widthLeads = dragDir == "east" or dragDir == "west" or ((dragDir == "southeast" or dragDir == "southwest") and max(rawW - view.viewportWidth, view.viewportWidth - rawW) / view.viewportWidth >= max(rawH - view.viewportHeight, view.viewportHeight - rawH) / view.viewportHeight)
  derive lockW = widthLeads ? bvLockedWidth(rawW, ratio) : round(bvLockedHeight(rawH, ratio) * ratio)
  derive lockH = widthLeads ? round(bvLockedWidth(rawW, ratio) / ratio) : bvLockedHeight(rawH, ratio)
  derive freeW = bvClamp(rawW)
  derive freeH = bvClamp(rawH)
  derive capW = freeW * freeH <= 8294400 ? freeW : (max(dragX, 0 - dragX) >= max(dragY, 0 - dragY) ? max(240, floor(8294400 / freeH)) : freeW)
  derive capH = freeW * freeH <= 8294400 ? freeH : (max(dragX, 0 - dragX) >= max(dragY, 0 - dragY) ? freeH : max(240, floor(8294400 / freeW)))
  derive dragging = dragDir != ""
  derive held = not dragging and heldKey == view.viewportKey and heldSerial == view.viewportSerial
  derive liveW = dragging ? (view.aspectLocked ? lockW : capW) : (held ? heldW : view.viewportWidth)
  derive liveH = dragging ? (view.aspectLocked ? lockH : capH) : (held ? heldH : view.viewportHeight)
  // resolveBrowserDeviceViewportLayout over the live size (fill: the whole area).
  derive scale = fixed and liveW > 0 and liveH > 0 ? min(1, min(aw / (liveW * z), ah / (liveH * z))) : 1
  derive vw = fixed ? liveW * z * scale : pw
  derive vh = fixed ? liveH * z * scale : ph
  derive vx = fixed ? 10 + max(0, round((aw - vw) / 2)) : 0
  derive vy = fixed ? 32 + max(0, round((ah - vh) / 2)) : 0
  action drag(direction: string, dx: number, dy: number)
    dragX = dragDir == direction ? dragX + dx : dx
    dragY = dragDir == direction ? dragY + dy : dy
    dragDir = direction
  action release(vx: number, vy: number)
    if dragDir != "" and (liveW != view.viewportWidth or liveH != view.viewportHeight)
      heldKey = view.viewportKey
      heldSerial = view.viewportSerial
      heldW = liveW
      heldH = liveH
      local("surface-browser-viewport-drag", view.tabId, `${dragDir}|${dragX}|${dragY}|${pw}|${ph}`)
    dragDir = ""
    dragX = 0
    dragY = 0
  action railKey(direction: string, k: string, e: KeyboardEvent)
    if k == "ArrowLeft" or k == "ArrowRight" or k == "ArrowUp" or k == "ArrowDown"
      preventDefault()
      local("surface-browser-viewport-key", view.tabId, `${direction}|${k}|${e.shiftKey ? "true" : "false"}`)
  action hover(id: string, on: bool)
    over = on ? id : (over == id ? "" : over)
  // The preview's chords, answered by the module while the page or the URL field has the focus.
  action pageKey(name: string)
    if name == "focus-url"
      focus("browser-url")
      selectText("browser-url")
    if name == "refresh"
      local("surface-browser-refresh", view.tabId, "")
    if name == "zoom-in" or name == "zoom-out"
      local(`surface-browser-${name}`, view.tabId, "")
    if name == "reset-zoom"
      local("surface-browser-zoom-reset", view.tabId, "")
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 overflow="hidden" background-color=(fixed ? "light-dark(#f4f4f559, #2626265a)" : "#00000000") testId="browser-stage"
      when fixed
        BrowserDeviceToolbar(view=view, width=pw, liveW=liveW, liveH=liveH, local=local)
      t3-browser tab=view.runtimeId url=view.url profile=view.profileId environment=view.environment fit-scale=`${scale}` keys=view.keys chrome-focus=(urlFocused ? "true" : "false") key=pageKey aria-label="Browser page" testId="browser-page" position="absolute" left=vx top=vy width=vw height=vh box-shadow=(fixed ? "0 0 0 1px light-dark(#e4e4e7b3, #ffffff1a), 0 1px 2px #0000000d" : "none")
      when fixed
        BrowserRail(direction="west", label="Resize browser viewport from left edge", kind="vertical", cursor="ew-resize", x=(vx - 10), y=vy, w=10, h=vh, active=(dragDir == "west" or over == "west"), drag=drag, release=release, railKey=railKey, hover=hover)
        BrowserRail(direction="east", label="Resize browser viewport from right edge", kind="vertical", cursor="ew-resize", x=(vx + vw), y=vy, w=10, h=vh, active=(dragDir == "east" or over == "east"), drag=drag, release=release, railKey=railKey, hover=hover)
        BrowserRail(direction="south", label="Resize browser viewport from bottom edge", kind="horizontal", cursor="ns-resize", x=vx, y=(vy + vh), w=vw, h=10, active=(dragDir == "south" or over == "south"), drag=drag, release=release, railKey=railKey, hover=hover)
        BrowserRail(direction="southwest", label="Resize browser viewport from bottom-left corner", kind="corner-left", cursor="nesw-resize", x=(vx - 10), y=(vy + vh), w=10, h=10, active=(dragDir == "southwest" or over == "southwest"), drag=drag, release=release, railKey=railKey, hover=hover)
        BrowserRail(direction="southeast", label="Resize browser viewport from bottom-right corner", kind="corner-right", cursor="nwse-resize", x=(vx + vw), y=(vy + vh), w=10, h=10, active=(dragDir == "southeast" or over == "southeast"), drag=drag, release=release, railKey=railKey, hover=hover)
        when dragging
          text `${liveW} × ${liveH}` position="absolute" left=(vx + vw / 2) top=(vy + 10) translate="-50% 0%" z-index=40 pointer-events="none" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff1f)" background-color="light-dark(#fffffff2, #171717f2)" box-shadow="0 4px 6px -1px #0000001a" font-size="0.625rem" line-height="0.875rem" font-weight=500 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)" aria-hidden=true testId="browser-drag-size"
      // ZoomIndicator: the level, top right, each time it changes (not for the first value).
      each serial in (view.zoomSerial > 0 ? [view.zoomSerial] : []) key=serial
        text view.zoomLabel position="absolute" top="0.75rem" right="0.75rem" z-index=20 pointer-events="none" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="624.9375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff1a)" background-color="light-dark(#fffffff2, #171717f2)" box-shadow="0 4px 6px -1px #0000001a" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" opacity=0 animation="bvZoomPill 1.7s ease-out forwards" aria-hidden=true testId="browser-zoom-indicator"

// BrowserViewportResizeHandles' ResizeHandle: an invisible 10 pt rail (its hit area 4 pt larger) with a grip in
// the muted colour, the foreground while hovered, focused or dragged; arrow keys resize along its axes.
component BrowserRail
  props
    direction: string
    label: string
    kind: string
    cursor: string
    x: number
    y: number
    w: number
    h: number
    active: bool
    drag: action
    release: action
    railKey: action
    hover: action
  state focused = false
  action focusOn(on: bool)
    focused = on
  derive tone = active or focused ? "light-dark(#27272ad9, #f5f5f5d9)" : "light-dark(#71717b8c, #a1a1aa8c)"
  view
    button pan=drag(direction) panrelease=release key=railKey(direction) hover=hover(direction) focus=focusOn(true) blur=focusOn(false) touch-action="none" cursor=cursor aria-label=`${label}. Use arrow keys to resize.` testId=`browser-rail-${direction}` position="absolute" left=x top=y width=w height=h z-index=(kind == "vertical" or kind == "horizontal" ? 20 : 30) padding=0 border-width=0 background-color=(focused ? "light-dark(#0000000a, #ffffff0a)" : "#00000000") display="flex" align-items="center" justify-content="center"
      when kind == "vertical"
        row gap="1px" pointer-events="none"
          box width="1px" height="1.5rem" border-radius="624.9375rem" background-color=tone
          box width="1px" height="1.5rem" border-radius="624.9375rem" background-color=tone
      when kind == "horizontal"
        column gap="1px" pointer-events="none"
          box width="1.5rem" height="1px" border-radius="624.9375rem" background-color=tone
          box width="1.5rem" height="1px" border-radius="624.9375rem" background-color=tone
      when kind == "corner-right"
        box width="0.75rem" height="0.75rem" position="relative" pointer-events="none"
          box position="absolute" left=0 bottom="3px" width="0.75rem" height="1px" rotate=-45 border-radius="624.9375rem" background-color=tone
          box position="absolute" left="5px" bottom=0 width="0.5rem" height="1px" rotate=-45 border-radius="624.9375rem" background-color=tone
      // Mirrored (the reference's -scale-x-100).
      when kind == "corner-left"
        box width="0.75rem" height="0.75rem" position="relative" pointer-events="none"
          box position="absolute" right=0 bottom="3px" width="0.75rem" height="1px" rotate=45 border-radius="624.9375rem" background-color=tone
          box position="absolute" right="5px" bottom=0 width="0.5rem" height="1px" rotate=45 border-radius="624.9375rem" background-color=tone

// BrowserDeviceToolbar: "Dimensions" (from 560 pt), the preset select (Responsive and the 17 presets with their
// sizes), width × height (applied on Enter or when a field is left; with the ratio locked, one follows the
// other), Lock aspect ratio, Rotate viewport, and Close device toolbar, which goes back to fill.
component BrowserDeviceToolbar
  props
    view: BrowserPanel
    width: number
    liveW: number
    liveH: number
    local: action
  // A typed size: `editing` while a field is being typed in; once asked for, it stays drawn until the commit's answer
  // bumps the serial (the reference keeps its custom size until the commit resolves).
  state editing = false
  state waitSerial = -1
  state draftW = ""
  state draftH = ""
  state over = ""
  derive ratio = view.viewportHeight > 0 ? view.viewportWidth / view.viewportHeight : 1
  derive drafted = editing or (waitSerial >= 0 and waitSerial == view.viewportSerial)
  derive shownW = drafted ? draftW : `${liveW}`
  derive shownH = drafted ? draftH : `${liveH}`
  derive validW = match parseNumber(shownW) { case some(n) => n == floor(n) and n >= 240 and n <= 3840, case none => false }
  derive validH = match parseNumber(shownH) { case some(n) => n == floor(n) and n >= 240 and n <= 3840, case none => false }
  derive numW = match parseNumber(shownW) { case some(n) => n, case none => 0 }
  derive numH = match parseNumber(shownH) { case some(n) => n, case none => 0 }
  derive valid = validW and validH and numW * numH <= 8294400
  action hover(id: string, on: bool)
    over = on ? id : (over == id ? "" : over)
  action begin
    if not drafted
      draftW = `${view.viewportWidth}`
      draftH = `${view.viewportHeight}`
    editing = true
    waitSerial = -1
  // updateCustomDimension: with the ratio locked, a valid width is bounded so its height stays within 240 to 3,840
  // (resizeAtAspectRatio) and sets that height; a height the same way. The area cap's bound needs a square root, which
  // Contract has not: the size asked for is checked again by the data module.
  derive minW = ceil(max(240, 240 * ratio))
  derive maxW = floor(min(3840, 3840 * ratio))
  derive minH = ceil(max(240, 240 / ratio))
  derive maxH = floor(min(3840, 3840 / ratio))
  action editW(text: string)
    let base = drafted ? draftH : `${view.viewportHeight}`
    let locked = view.aspectLocked and (match parseNumber(text) { case some(n) => n == floor(n) and n >= 240 and n <= 3840, case none => false })
    let typedW = match parseNumber(text) { case some(n) => min(maxW, max(minW, round(n))), case none => 0 }
    editing = true
    waitSerial = -1
    draftW = locked ? `${typedW}` : text
    draftH = locked ? `${round(typedW / ratio)}` : base
  action editH(text: string)
    let base = drafted ? draftW : `${view.viewportWidth}`
    let locked = view.aspectLocked and (match parseNumber(text) { case some(n) => n == floor(n) and n >= 240 and n <= 3840, case none => false })
    let typedH = match parseNumber(text) { case some(n) => min(maxH, max(minH, round(n))), case none => 0 }
    editing = true
    waitSerial = -1
    draftH = locked ? `${typedH}` : text
    draftW = locked ? `${round(typedH * ratio)}` : base
  // applyCustomSize: a valid change is asked for (and drawn until it lands); anything else puts the size back.
  action apply
    if editing and valid and (numW != view.viewportWidth or numH != view.viewportHeight)
      local("surface-browser-viewport-size", view.tabId, `${numW}|${numH}`)
      waitSerial = view.viewportSerial
    else
      // A blur after Enter already asked for its size: only an edit that asks for nothing puts the size back.
      if editing
        waitSerial = -1
    editing = false
  action rotate
    local("surface-browser-viewport-rotate", view.tabId, editing and valid ? `${numW}|${numH}` : "")
    editing = false
    waitSerial = -1
  view
    row position="absolute" left=0 top=0 width=width height="2rem" z-index=50 padding-left="0.375rem" padding-right="0.375rem" gap="0.125rem" box-sizing="border-box" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff1a)" background-color="light-dark(#fcfcfcf2, #0a0a0af2)" box-shadow="0 1px 2px #0000000d" overflow="hidden" role="toolbar" aria-label="Browser device toolbar" testId="browser-device-toolbar"
      when width >= 560
        text "Dimensions" flex-shrink=0 margin-right="0.125rem" font-size="0.625rem" line-height="0.875rem" font-weight=500 color="light-dark(#71717b, #818181)"
      BrowserPresetSelect(view=view, wide=(width >= 440), local=local)
      row flex-shrink=0 align-items="center" gap="0.125rem" role="group" aria-label="Viewport dimensions"
        input value=shownW input=editW focus=begin blur=apply submit=apply inputmode="numeric" aria-label="Viewport width" aria-invalid=(not validW) spellcheck="false" testId="browser-viewport-width" width=(width >= 360 ? "3.5rem" : "3.25rem") height="1.5rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color=(validW ? "light-dark(#d4d4d8, #ffffff14)" : "light-dark(#fb2c36a3, #fb414aa3)") background-color="light-dark(#ffffff, #ffffff07)" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
        text "×" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        input value=shownH input=editH focus=begin blur=apply submit=apply inputmode="numeric" aria-label="Viewport height" aria-invalid=(not validH) spellcheck="false" testId="browser-viewport-height" width=(width >= 360 ? "3.5rem" : "3.25rem") height="1.5rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color=(validH ? "light-dark(#d4d4d8, #ffffff14)" : "light-dark(#fb2c36a3, #fb414aa3)") background-color="light-dark(#ffffff, #ffffff07)" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
      box position="relative" flex-shrink=0 hover=hover("lock")
        button press=local("surface-browser-viewport-lock", view.tabId, "") disabled=(not valid) aria-label=(view.aspectLocked ? "Unlock viewport aspect ratio" : "Lock viewport aspect ratio") aria-pressed=view.aspectLocked testId="browser-viewport-lock" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" display="flex" align-items="center" justify-content="center" opacity=(valid ? 1 : 0.64) background-color=(view.aspectLocked ? "light-dark(#f4f4f5, #ffffff14)" : over == "lock" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
          BvIcon(name=(view.aspectLocked ? "link-2" : "unlink-2"), size=14, color=(view.aspectLocked ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #a1a1aa)"))
        TipBubble(label=(view.aspectLocked ? "Unlock aspect ratio" : "Lock aspect ratio"), side="bottom", align="center", offset=28, inset=0, shown=(over == "lock"))
      button press=rotate hover=hover("rotate") aria-label="Rotate viewport" testId="browser-viewport-rotate" width="1.5rem" height="1.5rem" flex-shrink=0 padding=0 border-width=0 border-radius="0.5rem" display="flex" align-items="center" justify-content="center" background-color=(over == "rotate" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        BvIcon(name="rotation", size=14, color="light-dark(#71717b, #a1a1aa)")
      box flex=1 min-width=0
      button press=local("surface-browser-viewport-close", view.tabId, "") hover=hover("close") aria-label="Close device toolbar" testId="browser-viewport-close" width="1.5rem" height="1.5rem" flex-shrink=0 padding=0 border-width=0 border-radius="0.5rem" display="flex" align-items="center" justify-content="center" background-color=(over == "close" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        BvIcon(name="x", size=14, color="light-dark(#71717b, #a1a1aa)")

// The device preset Select: its value (Responsive or the preset's name) and a chevron; the popup lists
// Responsive, then "Standard" and the presets, each with its size, the chosen one checked.
component BrowserPresetSelect
  props
    view: BrowserPanel
    wide: bool
    local: action
  state over = false
  action hover(on: bool)
    over = on
  view
    column position="relative" flex-shrink=0
      button popovertarget="browser-preset-menu" hover=hover aria-label="Browser device preset" aria-haspopup="listbox" testId="browser-preset" width=(wide ? "9rem" : "6rem") height="1.5rem" padding-left="0.5rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" display="flex" flex-direction="row" align-items="center" justify-content="space-between" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        text view.presetLabel flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
        BvIcon(name="chevron-down", size=12, color="light-dark(#71717b, #a1a1aa)")
      column id="browser-preset-menu" popover="auto" position="absolute" margin-top="1.75rem" width="17rem"
        scroll max-height="22rem" width="100%" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="listbox" aria-label="Browser device preset" testId="browser-preset-popup"
          column width="100%" padding="0.25rem" box-sizing="border-box"
            BrowserPresetRow(id="responsive", label="Responsive", detail="", chosen=(view.viewportMode == "freeform"), press=local("surface-browser-viewport-preset", view.tabId, "responsive"))
            text "Standard" padding-left="0.5rem" padding-top="0.375rem" padding-bottom="0.25rem" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"
            each preset in view.presets key=preset.id
              BrowserPresetRow(id=preset.id, label=preset.label, detail=preset.detail, chosen=(view.viewportMode == "preset" and view.presetId == preset.id), press=local("surface-browser-viewport-preset", view.tabId, preset.id))

component BrowserPresetRow
  props
    id: string
    label: string
    detail: string
    chosen: bool
    press: action
  state lit = false
  action hover(on: bool)
    lit = on
  view
    button press=press popovertarget="browser-preset-menu" popovertargetaction="hide" hover=hover focus=hover(true) blur=hover(false) role="option" aria-selected=chosen testId=`browser-preset-${id}` display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      box width="1rem" height="1rem" flex-shrink=0 display="flex" align-items="center" justify-content="center"
        when chosen
          BvIcon(name="check", size=14, color="light-dark(#27272a, #f5f5f5)")
      text label flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      when detail != ""
        text detail flex-shrink=0 font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
