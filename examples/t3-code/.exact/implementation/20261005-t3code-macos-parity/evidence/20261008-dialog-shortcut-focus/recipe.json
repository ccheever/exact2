  "checks": [
    {
      "name": "the new focus tests",
      "argv": [
        "bun",
        "test",
        "examples/t3-code/dialog-focus.test.ts",
        "examples/t3-code/sidebar.test.ts"
      ],
      "cwd": ".",
      "timeout_seconds": 300
    },
    {
      "name": "every clone test",
      "argv": [
        "bun",
        "test",
        "examples/t3-code"
      ],
      "cwd": ".",
      "timeout_seconds": 900
    },
    {
      "name": "strict tsc",
      "argv": [
        "bun",
        "node_modules/typescript/bin/tsc",
        "--noEmit",
        "--strict",
        "--target",
        "ES2023",
        "--module",
        "ESNext",
        "--moduleResolution",
        "bundler",
        "--skipLibCheck",
        "--lib",
        "ES2023,DOM",
        "examples/t3-code/app.ts"
      ],
      "cwd": ".",
      "timeout_seconds": 600
    },
    {
      "name": "contract build",
      "argv": [
        "bun",
        "scripts/exact.mjs",
        "contract",
        "build",
        "examples/t3-code/app.contract"
      ],
      "cwd": ".",
      "timeout_seconds": 900
    },
    {
      "name": "t3-code-macos lib tests (EXACT_APP_DIR set by the caller)",
      "argv": [
        "cargo",
        "test",
        "-p",
        "t3-code-macos",
        "--lib"
      ],
      "cwd": ".",
      "timeout_seconds": 1800
    },
    {
      "name": "caps (the caller stages first)",
      "argv": [
        "bun",
        "scripts/caps.mjs"
      ],
      "cwd": ".",
      "timeout_seconds": 300
    },
    {
      "name": "macOS focus drives, base vs branch (agent)",
      "unavailable": "run by hand in the lane with scripts/agent.mjs (two builds, a shared T3 home): agent-focus-drives.txt",
      "required": false
    },
    {
      "name": "real-keyboard drive (orca computer)",
      "unavailable": "run by hand under the real-input lock: real-keys.txt and the before/after images",
      "required": false
    }
  ]
}
