use R4Glyph from "./r4-git.contract"
use CnMachineIcon from "./settings-b-kit.contract"
use Snapshot, Control from "./shapes.contract"
use R5ComposerLabelProbes from "./r5-composer.contract"
use R5TextProbes from "./r5-composer.contract"
use Viewport from "./shapes.contract"
use ProviderInstanceMark from "./icons.contract"
use ComposerNotice from "./composer-shapes.contract"
use ComposerQueued from "./composer-shapes.contract"
use ComposerBranches from "./composer-shapes.contract"
use Tip from "./shell-tip.contract"
use TipBubble from "./shell-tip.contract"
use RowTip from "./r8-pointer-tips.contract" // lane r8-pointer
use StripPrBadge from "./r7-handoff.contract" // lane r7-handoff

// The composer footer and its docked banners (lane composer-controls): the
// toolbar controls (ComposerControl.tsx "sm"/"xs"), the primary actions
// (ComposerPrimaryActions.tsx), the traits and runtime-mode menus
// (TraitsPicker.tsx, ChatComposer.tsx footer) and the dock above the card
// (ComposerBannerStack.tsx, ComposerTasksBadge.tsx, ComposerActivityStatus.tsx,
// ComposerPlanFollowUpBanner.tsx). Colours are the served build's tokens:
// foreground #27272a/#f5f5f5, muted #71717a/#818181, border #e4e4e7/white 6%,
// accent #f4f4f5/white 4%, message action #1b4ed8/#346bf1.

keyframes ccSpin
  from rotate=0
  to rotate=360
keyframes ccPulse
  from opacity=1
  50% opacity=0.35
  to opacity=1

// Lucide geometry (24px grid) for the composer's own glyphs.
component CcIcon
  props
    name: string
    size: number
    color: string
    weight: number
  view
    svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=weight stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      when name == "chevron-down"
        path d="m6 9 6 6 6-6"
      when name == "chevron-right"
        path d="m9 18 6-6-6-6"
      when name == "lock" or name == "lock-open"
        rect x=3 y=11 width=18 height=11 rx=2 ry=2
        path d=(name == "lock" ? "M7 11V7a5 5 0 0 1 10 0v4" : "M7 11V7a5 5 0 0 1 9.9-1")
      when name == "pen-line"
        path d="M13 21h8M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
      when name == "sparkles"
        path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4M22 4h-4"
        circle cx=4 cy=20 r=2
      when name == "bot"
        path d="M12 8V4H8M2 14h2M20 14h2M15 13v2M9 13v2"
        rect x=4 y=8 width=16 height=12 rx=2
      when name == "pencil-ruler"
        path d="M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13M8 6l2-2M18 16l2-2M17 11l4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497zM15 5l4 4"
      when name == "download"
        path d="M12 15V3M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5"
      when name == "search"
        path d="m21 21-4.34-4.34"
        circle cx=11 cy=11 r=8
      when name == "star" or name == "star-filled"
        path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" fill=(name == "star-filled" ? "currentColor" : "none")
      when name == "brain"
        path d="M12 18V5M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5M17.997 5.125a4 4 0 0 1 2.526 5.77M18 18a4 4 0 0 0 2-7.464M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517M6 18a4 4 0 0 1-2-7.464M6.003 5.125a4 4 0 0 0-2.526 5.77"
      when name == "zap"
        path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z" fill="currentColor"
      when name == "ultrafast"
        path d="m17 2-10 12h7l-1 8 10-12h-7l1-8Z" fill="currentColor" stroke="none" opacity=0.4
        path d="m11 2-10 12h7l-1 8 10-12h-7l1-8Z" fill="currentColor" stroke="none"
      when name == "list-plus"
        path d="M16 5H3M11 12H3M16 19H3M18 9v6M21 12h-6"
      when name == "corner-up-right"
        path d="m15 14 5-5-5-5M4 20v-7a4 4 0 0 1 4-4h12"
      when name == "play"
        path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z" fill="currentColor"
      when name == "check"
        path d="M20 6 9 17l-5-5"
      when name == "circle-alert"
        circle cx=12 cy=12 r=10
        path d="M12 8v4M12 16h.01"
      when name == "alarm"
        circle cx=12 cy=13 r=8
        path d="M5 3 2 6M22 6l-3-3M6.38 18.7 4 21M17.64 18.67 20 21M9 13l2 2 4-4"
      when name == "circle-check"
        circle cx=12 cy=12 r=10
        path d="m9 12 2 2 4-4"
      when name == "list-todo"
        path d="M13 5h8M13 12h8M13 19h8M3 17l2 2 4-4"
        rect x=3 y=4 width=6 height=6 rx=1
      when name == "circle-dot"
        path d="M10.1 2.18a9.93 9.93 0 0 1 3.8 0M17.6 3.71a9.95 9.95 0 0 1 2.69 2.7M21.82 10.1a9.93 9.93 0 0 1 0 3.8M20.29 17.6a9.95 9.95 0 0 1-2.7 2.69M13.9 21.82a9.94 9.94 0 0 1-3.8 0M6.4 20.29a9.95 9.95 0 0 1-2.69-2.7M2.18 13.9a9.93 9.93 0 0 1 0-3.8M3.71 6.4a9.95 9.95 0 0 1 2.7-2.69"
        circle cx=12 cy=12 r=1
      when name == "circle"
        circle cx=12 cy=12 r=10
      when name == "x"
        path d="M18 6 6 18M6 6l12 12"
      when name == "chevron-up"
        path d="m18 15-6-6-6 6"
      when name == "loader"
        path d="M21 12a9 9 0 1 1-6.219-8.56"
      when name == "minimize"
        path d="m14 10 7-7M20 10h-6V4M3 21l7-7M4 14h6v6"
      when name == "gauge"
        path d="m12 14 4-4M3.34 19a10 10 0 1 1 17.32 0"
      when name == "folder"
        path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
      when name == "folder-git"
        path d="M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5M18 19c-2.8 0-5-2.2-5-5v8"
        circle cx=13 cy=12 r=2
        circle cx=20 cy=19 r=2
      when name == "folder-git-1"
        circle cx=12 cy=13 r=2
        path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2ZM14 13h3M7 13h3"
      when name == "history"
        path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5M12 7v5l4 2"
      when name == "git-branch"
        path d="M15 6a9 9 0 0 0-9 9V3"
        circle cx=18 cy=6 r=3
        circle cx=6 cy=18 r=3
      when name == "list-ordered"
        path d="M11 5h10M11 12h10M11 19h10M4 4h1v5M4 9h2M6.5 20H3.4c0-1 2.6-1.925 2.6-3.5a1.5 1.5 0 0 0-2.6-1.02"
      when name == "pencil"
        path d="M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497zM15 5l4 4"
      when name == "arrow-up-left"
        path d="M7 17V7h10M17 17 7 7"
      when name == "paperclip"
        path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"
      when name == "grip"
        circle cx=9 cy=12 r=1
        circle cx=9 cy=5 r=1
        circle cx=9 cy=19 r=1
        circle cx=15 cy=12 r=1
        circle cx=15 cy=5 r=1
        circle cx=15 cy=19 r=1

// StageBackdropButtonArt: the Nightly sky behind the send button, the slice a
// 32px circle shows of the 96px-tall artwork (x 96–192).
component SendArt
  view
    svg width=32 height=32 viewBox="96 0 96 96" fill="none" position="absolute" left=0 top=0 aria-hidden=true
      defs
        linearGradient id="send-sky" x1=24 y1=0 x2=264 y2=96 gradientUnits="userSpaceOnUse" spreadMethod="reflect"
          stop stop-color="#07152f"
          stop offset=0.5 stop-color="#151443"
          stop offset=1 stop-color="#32155b"
        radialGradient id="send-glow" cx=0 cy=0 r=1 gradientTransform="translate(216 18) rotate(137) scale(120 84)" gradientUnits="userSpaceOnUse"
          stop stop-color="#5165d8" stop-opacity=0.4
          stop offset=0.5 stop-color="#283075" stop-opacity=0.16
          stop offset=1 stop-color="#07152f" stop-opacity=0
        linearGradient id="send-cloud" x1=0 y1=60 x2=288 y2=96 gradientUnits="userSpaceOnUse"
          stop stop-color="#4ea4ff" stop-opacity=0.5
          stop offset=0.52 stop-color="#696fea" stop-opacity=0.62
          stop offset=1 stop-color="#a85bea" stop-opacity=0.5
        filter id="send-soft" x=-24 y=-24 width=336 height=144 filterUnits="userSpaceOnUse"
          feGaussianBlur stdDeviation=4
      rect x=96 width=96 height=96 fill="url(#send-sky)"
      rect x=96 width=96 height=96 fill="url(#send-glow)"
      g fill="#e4eaff"
        circle cx=104 cy=7 r=0.6 opacity=0.8
        circle cx=126 cy=20 r=0.4 opacity=0.55
        circle cx=148 cy=11 r=0.5 opacity=0.7
        circle cx=170 cy=24 r=0.4 opacity=0.5
        circle cx=118 cy=34 r=0.4 opacity=0.45
      path d="M158.5 36h3M160 34.5v3" stroke="#c8d7ff" stroke-opacity=0.7 stroke-width=0.6 stroke-linecap="round"
      g filter="url(#send-soft)"
        path d="M-12 88C-12 74 0 63 14 63C18 50 30 41 44 41C58 41 70 49 74 62C79 57 86 54 94 54C110 54 123 66 124 82C132 83 138 88 141 96H-12V88Z" fill="url(#send-cloud)"
        path d="M150 96C151 84 161 75 173 75C176 64 186 57 198 57C210 57 220 64 223 75C231 75 238 80 241 87C250 87 257 91 260 96H150Z" fill="url(#send-cloud)" opacity=0.8

// ComposerControl size "sm" (h-7 px-2.5 gap-1.5 text-sm medium) or the resting "xs".
component ModelTrigger
  props
    data: Snapshot
    xs: bool
    open: bool
    label: bool
    keyModels: string
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover class=Control aria-label=(data.composer.fanout ? data.composer.fanoutAria : "Choose provider and model") aria-expanded=open aria-keyshortcuts=keyModels testId="model-picker" disabled=disabled opacity=(disabled ? 0.64 : 1) min-width=(xs ? 40 : 48) max-width=(xs ? 168 : 9999) flex-shrink=1 height=(xs ? 24 : 28) padding-left=(xs ? 7 : 11) padding-right=(xs ? 7 : 11) padding-top=0 padding-bottom=0 margin-left=-10 gap=(xs ? 4 : 6) border-radius=8 background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
      // Several models (a multi-model draft): up to three overlapping marks, then "+N".
      when data.composer.fanout
        row flex-shrink=0 align-items="center" aria-hidden=true
          each mark in data.composer.fanoutMarks key=mark.key
            box display="flex" margin-right=-4 border-radius=8 border-width=2 border-style="solid" border-color="light-dark(#ffffff, #161616)" background-color="light-dark(#ffffff, #161616)"
              ProviderInstanceMark(driver=mark.driver, size=16, color="light-dark(#71717a, #818181)", badge="", accent="#00000000")
          when data.composer.fanoutMore > 0
            text `+${data.composer.fanoutMore}` font-size=9 line-height="16px" min-width=16 height=16 border-radius=8 text-align="center" border-width=2 border-style="solid" border-color="light-dark(#ffffff, #161616)" background-color="light-dark(#ffffff, #161616)" color="light-dark(#71717a, #818181)"
          box width=4
      else
        ProviderInstanceMark(driver=data.providerDriver, size=(xs ? 14 : 16), color=(xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#71717a, #818181)"), badge=data.providerBadge, accent=data.providerBadgeColor)
      // The tooltip (label · ⇧⌘M) belongs to the label, 4pt above it (ProviderModelPicker TooltipTrigger).
      when label
        box position="relative" display="flex" flex-direction="row" min-width=0 flex-shrink=1
          text (data.composer.fanout ? data.composer.fanoutLabel : data.modelLabel == "" ? "Choose model" : data.modelLabel) font-size=(xs ? 12 : 14) font-weight=(xs ? 400 : 500) line-height=(xs ? "16px" : "20px") color=(over ? "light-dark(#27272a, #f5f5f5)" : xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#71717a, #818181)") line-clamp=1 min-width=0 flex-shrink=1
          TipBubble(label=data.composer.modelTip, side="top", align="center", offset=(xs ? 20 : 24), inset=0, shown=over)
      box margin-left=-2 margin-right=-2 display="flex" flex-shrink=0 opacity=(xs ? 0.5 : 1)
        CcIcon(name="chevron-down", size=(xs ? 12 : 14), color="light-dark(#71717a, #818181)", weight=2.25)

// ChatComposer's provider-unavailable control in place of the model picker.
component ProviderUnavailable
  props
    label: string
    xs: bool
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover class=Control aria-label=label testId="provider-unavailable" disabled=disabled opacity=(disabled ? 0.64 : 1) flex-shrink=0 height=(xs ? 24 : 28) padding-left=(xs ? 7 : 11) padding-right=(xs ? 7 : 11) padding-top=0 padding-bottom=0 gap=(xs ? 4 : 6) border-radius=8 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
      CcIcon(name="circle-alert", size=(xs ? 12 : 16), color="light-dark(#71717a, #818181)", weight=2)
      text label font-size=(xs ? 12 : 14) font-weight=(xs ? 400 : 500) line-height=(xs ? "16px" : "20px") color=(over and not disabled ? "light-dark(#27272a, #f5f5f5)" : xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#71717a, #818181)") white-space="nowrap"

// The traits trigger: its label, or a bolt for a speed trait; icon-only
// compact layouts show the brain glyph instead of the label.
component TraitsTrigger
  props
    label: string
    aria: string
    speed: string
    iconOnly: bool
    xs: bool
    open: bool
    disabled: bool
    keyEffort: string
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" min-width=0 max-width=192 flex-shrink=(iconOnly ? 0 : 1) hook="t3-anchor" data-anchor="traits"
      button press=press hover=hover class=Control aria-label=aria aria-expanded=open aria-keyshortcuts=keyEffort testId="reasoning-effort" disabled=disabled opacity=(disabled ? 0.64 : 1) min-width=0 max-width=192 flex-shrink=(iconOnly ? 0 : 1) height=(xs ? 24 : 28) padding-left=(xs ? 7 : 11) padding-right=(xs ? 7 : 11) padding-top=0 padding-bottom=0 gap=(xs ? 4 : 6) border-radius=8 background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        when speed != ""
          box display="flex" flex-shrink=0 opacity=0.8
            CcIcon(name=(speed == "ultrafast" ? "ultrafast" : "zap"), size=(xs ? 12 : 16), color=(xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#27272a, #f5f5f5)"), weight=2)
        else
          when iconOnly
            CcIcon(name="brain", size=(xs ? 12 : 16), color="light-dark(#71717a, #818181)", weight=2)
        when not iconOnly and label != ""
          text label font-size=(xs ? 12 : 14) font-weight=(xs ? 400 : 500) line-height=(xs ? "16px" : "20px") color=(over ? "light-dark(#27272a, #f5f5f5)" : xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#71717a, #818181)") line-clamp=1 min-width=0
        box margin-left=-2 margin-right=-2 display="flex" flex-shrink=0 opacity=(xs ? 0.5 : 1)
          CcIcon(name="chevron-down", size=(xs ? 12 : 14), color="light-dark(#71717a, #818181)", weight=2.25)
      TipBubble(label=aria, side="top", align="center", offset=(xs ? 28 : 32), inset=0, shown=over)

component RuntimeTrigger
  props
    label: string
    tip: string
    icon: string
    iconOnly: bool
    xs: bool
    open: bool
    disabled: bool
    keyMode: string
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" flex-shrink=0 hook="t3-anchor" data-anchor="runtime"
      button press=press hover=hover class=Control aria-label="Runtime mode" aria-expanded=open aria-keyshortcuts=keyMode testId="runtime-mode" disabled=disabled opacity=(disabled ? 0.64 : 1) flex-shrink=0 height=(xs ? 24 : 28) padding-left=(xs ? 7 : 11) padding-right=(xs ? 7 : 11) padding-top=0 padding-bottom=0 gap=(xs ? 4 : 6) border-radius=8 background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        CcIcon(name=icon, size=(xs ? 12 : 16), color="light-dark(#71717a, #818181)", weight=2)
        when not iconOnly
          text label font-size=(xs ? 12 : 14) font-weight=(xs ? 400 : 500) line-height=(xs ? "16px" : "20px") color=(over ? "light-dark(#27272a, #f5f5f5)" : xs ? "light-dark(#71717ab3, #818181b3)" : "light-dark(#71717a, #818181)") line-clamp=1
        box margin-left=-2 margin-right=-2 display="flex" flex-shrink=0 opacity=(xs ? 0.5 : 1)
          CcIcon(name="chevron-down", size=(xs ? 12 : 14), color="light-dark(#71717a, #818181)", weight=2.25)
      TipBubble(label=tip, side="top", align="center", offset=(xs ? 28 : 32), inset=0, shown=over)

// The plan/build toggle (aria-pressed when planning), after its separator.
component PlanToggle
  props
    active: bool
    xs: bool
    iconOnly: bool
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      button press=press hover=hover class=Control aria-label=(active ? "Plan mode — click to return to normal build mode" : "Default mode — click to enter plan mode") testId="interaction-mode" disabled=disabled opacity=(disabled ? 0.64 : 1) flex-shrink=0 height=(xs ? 24 : 28) padding-left=(xs ? 7 : 11) padding-right=(xs ? 7 : 11) padding-top=0 padding-bottom=0 gap=(xs ? 4 : 6) border-radius=8 background-color=(active ? (over ? "light-dark(#f4f4f5cc, #ffffff08)" : "light-dark(#f4f4f5, #ffffff0a)") : over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        CcIcon(name=(active ? "pencil-ruler" : "bot"), size=(xs ? 12 : active ? 16 : 18), color=(active ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717a, #818181)"), weight=2)
        when not iconOnly
          text (active ? "Plan" : "Build") font-size=(xs ? 12 : 14) font-weight=(xs ? 400 : 500) line-height=(xs ? "16px" : "20px") color=(active ? "light-dark(#18181b, #f5f5f5)" : over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717a, #818181)")
      TipBubble(label=(active ? "Plan mode — click to return to normal build mode" : "Default mode — click to enter plan mode"), side="top", align="center", offset=(xs ? 28 : 32), inset=0, shown=over)

component ToolbarSeparator
  props
    xs: bool
  view
    box width=1 height=(xs ? 14 : 16) margin-left=2 margin-right=2 flex-shrink=0 background-color="light-dark(#e4e4e7, #ffffff0f)"

// The 32pt send circle over the Nightly sky: arrow, queue (list-plus), steer
// (corner-up-right), resume (play) or a spinner while sending or connecting.
component SendGlyph
  props
    icon: string
    spinner: bool
  view
    when spinner
      box width=14 height=14 position="relative" display="flex" animation="ccSpin 1s linear infinite" aria-hidden=true
        CcIcon(name="loader", size=14, color="#ffffff", weight=2)
    else
      when icon == "arrow"
        svg width=14 height=14 viewBox="0 0 14 14" fill="none" position="relative" aria-hidden=true
          path d="M7 11.5V2.5M7 2.5L3 6.5M7 2.5L11 6.5" stroke="#ffffff" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
      else
        // While a turn runs, steer (CornerUpRight) and queue (ListPlus) morph into each
        // other (MorphIcon, f2cc80a7a4): both stay mounted and cross-fade.
        when icon == "list-plus" or icon == "corner-up-right"
          box position="relative" width=16 height=16
            box position="absolute" left=0 top=0 display="flex" opacity=(icon == "list-plus" ? 1 : 0) scale=(icon == "list-plus" ? 1 : 0.6) transition="opacity 220ms ease, scale 220ms ease"
              CcIcon(name="list-plus", size=16, color="#ffffff", weight=2)
            box position="absolute" left=0 top=0 display="flex" opacity=(icon == "corner-up-right" ? 1 : 0) scale=(icon == "corner-up-right" ? 1 : 0.6) transition="opacity 220ms ease, scale 220ms ease"
              CcIcon(name="corner-up-right", size=16, color="#ffffff", weight=2)
        else
          box position="relative" display="flex"
            CcIcon(name=icon, size=16, color="#ffffff", weight=2)

// ChatComposer's Attach files (ghost icon-sm, 28pt): picked images join the shelf.
component AttachButton
  props
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      button press=press hover=hover disabled=disabled testId="attach-files" aria-label="Attach files" opacity=(disabled ? 0.64 : 1) width=28 height=28 padding=0 border-radius=8 border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        CcIcon(name="paperclip", size=16, color="light-dark(#71717a, #818181)", weight=2)
      TipBubble(label="Attach files", side="top", align="center", offset=32, inset=0, shown=over)

// ComposerPrimaryActions outside a pending question: the plan follow-up pill,
// Stop, Resume thread, or Send with its running-turn variants.
component PrimaryActions
  props
    data: Snapshot
    sendable: bool
    hasText: bool
    busy: bool
    tipShift: number
    send: action
    stop: action
    command: action
    openOptions: action
  state over = ""
  // r8-pointer D11: the thread the hover began on. A control swapped out under the pointer (Send ↔ Stop) or a
  // keyboard thread switch leaves `over` set with no hover-out; its tooltip waits for the pointer to move again.
  state overThread = ""
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
    overThread = value ? data.threadId : overThread
  derive blocked = busy or not data.canSend
  view
    row gap=8 align-items="center" flex-shrink=0 hook="t3-anchor" data-anchor="actions"
      when data.composer.attach
        AttachButton(disabled=(busy or not data.connected), press=command("cclocal:attach", "", "", 0))
      // ContextWindowMeter (Settings › Context window indicator): a usage ring
      // whose details open above it.
      when data.composer.contextShow
        button press=openOptions("context") hover=hover("meter") hook="t3-anchor" data-anchor="meter" testId="context-window-meter" aria-label=data.composer.contextAria width=28 height=28 padding=0 border-radius=8 border-width=0 background-color=(over == "meter" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          svg width=20 height=20 viewBox="0 0 24 24" rotate=-90 aria-hidden=true
            circle cx=12 cy=12 r=9.75 fill="none" stroke="light-dark(#71717a3d, #8181813d)" stroke-width=3
            circle cx=12 cy=12 r=9.75 fill="none" stroke=(data.composer.contextOver ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717ab8, #818181b8)") stroke-width=3 stroke-linecap="round" stroke-dasharray=61.26 stroke-dashoffset=data.composer.contextOffset
      when data.composer.planReady and (hasText or not data.composer.canResume)
        when hasText
          button press=send hover=hover("refine") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-refine" height=32 padding-left=16 padding-right=16 border-radius=16 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 background-color=(over == "refine" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)") box-shadow=(blocked ? "none" : "0 1px 2px 0 #1b4ed83d")
            text (busy ? "Sending..." : "Refine") font-size=14 font-weight=500 line-height="20px" color="#ffffff" white-space="nowrap"
        else
          row align-items="center" flex-shrink=0 testId="implement-actions" hook="t3-anchor" data-anchor="implement"
            button press=command("send", "", "", 0) hover=hover("implement") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-implement" height=32 padding-left=16 padding-right=16 border-top-left-radius=16 border-bottom-left-radius=16 border-top-right-radius=0 border-bottom-right-radius=0 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over == "implement" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)")
              text (busy ? "Sending..." : "Implement") font-size=14 font-weight=500 line-height="20px" color="#ffffff" white-space="nowrap"
            button press=openOptions("implement") hover=hover("menu") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-implement-menu" aria-label="Implementation actions" height=32 padding-left=8 padding-right=8 border-top-right-radius=16 border-bottom-right-radius=16 border-top-left-radius=0 border-bottom-left-radius=0 border-left-width=1 border-top-width=0 border-right-width=0 border-bottom-width=0 border-style="solid" border-color="#ffffff33" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over == "menu" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)")
              CcIcon(name="chevron-down", size=14, color="#ffffff", weight=2)
      else
        when data.canStop and not sendable and data.composer.queueEditing == ""
          RowTip(label="Interrupt", side="top", align="center", offset=36, shown=(over == "stop" and overThread == data.threadId), hover=hover("stop"))
            button press=stop disabled=busy testId="stop" aria-label="Stop generation" width=32 height=32 border-radius=16 background-color="light-dark(#fb2c36e6, #fc414ae6)" box-shadow="0 1px 2px 0 #fb2c363d, inset 0 1px 0 0 #ffffff29" border-width=0 display="flex" align-items="center" justify-content="center" flex-shrink=0
              svg width=12 height=12 viewBox="0 0 12 12" fill="#ffffff" aria-hidden=true
                rect x=2 y=2 width=8 height=8 rx=1.5
        else
          when data.composer.canResume and not sendable
            RowTip(label=(data.composer.sendStatus != "" ? data.composer.sendStatus : "Resume thread"), side="top", align="center", offset=36, shown=(over == "resume" and overThread == data.threadId), hover=hover("resume"))
              button press=command("cc:resume", "", "", 0) disabled=(blocked or data.composer.sendSpinner) opacity=(blocked ? 0.64 : 1) testId="resume-thread" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : "Resume thread") width=32 height=32 border-radius=16 overflow="hidden" border-width=0 padding=0 position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 box-shadow=(blocked ? "none" : "0 1px 2px 0 #0000003d, inset 0 1px 0 0 #ffffff29") color="#ffffff"
                SendArt()
                SendGlyph(icon="play", spinner=data.composer.sendSpinner)
          else
            box position="relative" display="flex" flex-shrink=0 hover=hover("send")
              button press=send id="send-message" hook="t3-send" testId="send-message" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : sendable and data.composer.sendRunning ? data.composer.sendLabel : "Submit message") aria-keyshortcuts=data.composer.sendChords disabled=(busy or not sendable or data.composer.sendSpinner) opacity=(busy or not sendable ? 0.64 : 1) width=32 height=32 border-radius=16 overflow="hidden" border-width=0 padding=0 position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 scale=(over == "send" and sendable and not busy and not data.composer.sendSpinner ? 1.05 : 1) transition="scale 150ms cubic-bezier(0.4, 0, 0.2, 1)" box-shadow=(busy or not sendable ? "none" : "0 1px 2px 0 #0000003d, inset 0 1px 0 0 #ffffff29") color="#ffffff"
                SendArt()
                SendGlyph(icon=(sendable ? data.composer.sendIcon : "arrow"), spinner=data.composer.sendSpinner)
              TipBubble(label=data.composer.sendTooltip, side="top", align=(tipShift > 0 ? "end" : "center"), offset=36, inset=(tipShift > 0 ? data.composer.sendTipWidth / 2 - 16 - tipShift : 0), shown=(over == "send" and overThread == data.threadId))

// The card's footer: toolbar triggers and the primary actions, or the resting
// single-line toolbar with its absolutely positioned send button. The controls
// row reports its width (t3-anchor "controls") so trailing labels compact
// before the model name (composerFooterLayout.ts).
component ComposerFooter
  props
    data: Snapshot
    viewportWidth: number
    text: string
    resting: bool
    busy: bool
    narrow: bool
    keyModels: string
    modelsOpen: bool
    optionsOpen: string
    send: action
    stop: action
    openModels: action
    openOptions: action
    interaction: action
    command: action
    openProviders: action
  state sendOver = false
  state sendThread = "" // r8-pointer D11: as PrimaryActions' overThread
  action sendHover(value: bool)
    sendOver = value
    sendThread = value ? data.threadId : sendThread
  derive sendable = data.canSend and (text != "" or length(data.snapshotDrafts) > 0)
  derive locked = busy or not data.connected
  // The send tooltip shifts left to stay 5pt inside the window (Base UI collision padding):
  // the button's centre is 32pt in from the toolbar's right edge (resting: 4pt).
  derive sendCenter = (resting ? data.composer.toolbarRight - 4 : data.composer.toolbarRight - 32)
  derive tipShift = (data.composer.toolbarRight > 0 ? max(0, sendCenter + data.composer.sendTipWidth / 2 - (viewportWidth - 5)) : 0)
  derive runtimeIcon = (resting ? data.composer.restingRuntimeIconOnly : data.composer.runtimeIconOnly)
  derive traitsIcon = (resting ? data.composer.restingTraitsIconOnly : data.composer.traitsIconOnly)
  view
    row width=(resting ? "calc(100% - 40px)" : "100%") height=(resting ? 32 : 48) padding-left=(resting ? 14 : 16) padding-right=(resting ? 14 : 16) padding-bottom=(resting ? 0 : 16) box-sizing="border-box" align-items="center" gap=8 position=(resting ? "absolute" : "relative") left=(resting ? 20 : 0) top=(resting ? 50 : 0) border-radius=(resting ? 16 : 0) background-color=(resting ? "light-dark(#fafafa, #101010)" : "#00000000") hook="t3-frame" data-frame="toolbar" testId="composer-toolbar"
      // r5-composer: the labels' natural widths (r5-composer.contract), read by footerLayout.
      R5TextProbes(probes=data.composer.menuProbes)
      R5ComposerLabelProbes(model=(data.composer.fanout ? data.composer.fanoutLabel : data.modelLabel == "" ? "Choose model" : data.modelLabel), traits=data.composer.traitsLabel, runtime=data.composer.runtimeLabel, plan=(data.composer.planVisible ? (data.composer.planActive ? "Plan" : "Build") : ""))
      // r5-integrate: the model picker sits 10pt left of this row (-ms-2.5). Natively a child outside its parent's
      // bounds takes no press, so the row reaches 10pt further left (margin -10, padding 10) to hold it; host width
      // below subtracts that padding (composer-presentation.ts), so the label breakpoints are unchanged.
      row flex=1 min-width=0 gap=(resting ? 0 : 4) align-items="center" height=32 margin-left=-10 padding-left=10 box-sizing="border-box" hook="t3-anchor" data-anchor="controls"
        when data.composer.noProvider != ""
          ProviderUnavailable(label=data.composer.noProvider, xs=resting, disabled=(data.composer.providerSetupId == ""), press=openProviders(data.composer.providerSetupId))
        else
          ModelTrigger(data=data, xs=resting, open=modelsOpen, label=(not resting or not narrow), keyModels=keyModels, disabled=locked, press=openModels)
          when data.composer.traitsLabel != "" or data.composer.traitsSpeed != ""
            ToolbarSeparator(xs=resting)
            TraitsTrigger(label=data.composer.traitsLabel, aria=data.composer.traitsAria, speed=data.composer.traitsSpeed, iconOnly=traitsIcon, xs=resting, open=(optionsOpen == "effort"), disabled=locked, keyEffort=data.composer.keyEffort, press=openOptions("effort"))
          ToolbarSeparator(xs=resting)
          RuntimeTrigger(label=data.composer.runtimeLabel, tip=data.composer.runtimeDescription, icon=data.composer.runtimeIcon, iconOnly=runtimeIcon, xs=resting, open=(optionsOpen == "runtime"), disabled=locked, keyMode=data.composer.keyMode, press=openOptions("runtime"))
          when data.composer.planVisible
            ToolbarSeparator(xs=resting)
            PlanToggle(active=data.composer.planActive, xs=resting, iconOnly=runtimeIcon, disabled=locked, press=interaction(data.composer.planActive ? "default" : "plan"))
      when not resting
        PrimaryActions(data=data, sendable=sendable, hasText=(text != ""), busy=busy, tipShift=tipShift, send=send, stop=stop, command=command, openOptions=openOptions)
    when resting
      box position="absolute" right=8 top=7 width=32 height=32 display="flex" hover=sendHover
        button press=send id="send-message" hook="t3-send" testId="send-message" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : "Submit message") aria-keyshortcuts=data.composer.sendChords disabled=(busy or not sendable or data.running) opacity=(busy or not sendable or data.running ? 0.64 : 1) position="relative" width=32 height=32 border-radius=16 overflow="hidden" border-width=0 padding=0 display="flex" align-items="center" justify-content="center" color="#ffffff"
          SendArt()
          SendGlyph(icon="arrow", spinner=data.composer.sendSpinner)
        TipBubble(label=data.composer.sendTooltip, side="top", align=(tipShift > 0 ? "end" : "center"), offset=36, inset=(tipShift > 0 ? data.composer.sendTipWidth / 2 - 16 - tipShift : 0), shown=(sendOver and sendThread == data.threadId))

// The traits menu (MenuRadioItem rows: checked keep the foreground/8% wash,
// the highlighted row takes accent) and the runtime-mode select (SelectItem,
// selected wash wins), anchored above their trigger (side top, align start;
// end-aligned when start would overflow). Arrows move focus between rows and
// Enter/Space press the focused row; Escape is the dismiss layer's command.
// The opener focuses the menu (traits) or the selected option (runtime), as
// base-ui's Menu and Select do. Rows are inline so their key handler is this
// component's own action (a lifted action does not receive the key's name).
component ComposerMenus
  props
    data: Snapshot
    session: number
    which: string
    left: number
    viewport: Viewport
    resting: bool
    close: action
    chooseTrait: action
    chooseRuntime: action
    command: action
    branches: ComposerBranches
    branchQuery: string
    searchBranches: action
    // lane r4-git: chatLocal, for the Start from origin switch (it keeps the picker open).
    local: action
  // Child state outlives the menu (it is the root's slots), so each opening
  // is a session: focus and hover from an earlier one never highlight a row.
  state focusIndex = -1
  state focusSession = -1
  state hoverIndex = -1
  state hoverSession = -1
  // The opener focuses the ref search, so a fresh session starts focused until it blurs.
  state searchFocused = false
  state searchSession = -1
  derive searchActive = (searchSession == session ? searchFocused : true)
  derive active = (focusSession == session ? focusIndex : -1)
  derive hovered = (hoverSession == session ? hoverIndex : -1)
  derive count = (which == "effort" ? data.composer.traitsCount : which == "implement" ? 1 : which == "context" ? (data.composer.contextCompact ? 1 : 0) : which == "workspace" ? (branches.previous ? 3 : 2) : which == "branch" ? length(branches.refs) + (branches.creatable != "" ? 1 : 0) : data.composer.runtimeCount)
  // r5-composer: content-sized menus take their measured widths (r5-composer-menus.ts), within the window
  // (max-w calc(100vw - 2rem)); a previous worktree fixes the workspace menu at min(21rem, 100vw - 2rem).
  derive width = (which == "effort" ? min(data.composer.effortMenuWidth, viewport.width - 32) : which == "implement" ? 200 : which == "context" ? 256 : which == "workspace" ? (branches.previous ? min(336, viewport.width - 32) : length(branches.envOptions) > 0 ? min(branches.envMenuWidth, viewport.width - 32) : (wideWorkspace ? 154 : 160)) : which == "branch" ? 320 : min(data.composer.runtimeMenuWidth, viewport.width - 32))
  derive strip = which == "workspace" or which == "branch"
  // r4-composer: a composer at least 768pt wide (its strip 44pt narrower) shows the workspace as the desktop
  // Select (BranchToolbarEnvModeSelector): a listbox 4pt below its trigger, as wide as its rows.
  // lane r13-threads: the non-Git strip's "Run on" is that Select at every width (SelectPopup side bottom, 4pt).
  derive wideWorkspace = which == "workspace" and (branches.gitless or data.composer.stripRight - data.composer.stripLeft >= 724)
  // Menus open 4pt above their trigger (side top): the toolbar's measured
  // window position, else the bottom-docked layout's fixed offsets.
  derive menuBottom = (strip ? viewport.height - (data.composer.stripTop + 4) + 4 : data.composer.toolbarTop > 0 ? viewport.height - data.composer.toolbarTop - (resting ? 4 : 2) + 4 : (resting ? 75 : 71))
  // The implement pill and the meter sit in the actions row (anchor "actions", inside the card's 1pt border).
  derive actionsEnd = left + 1 + data.composer.actionsX + (which == "implement" ? data.composer.implementX + data.composer.implementWidth : data.composer.meterX + data.composer.meterWidth)
  derive anchor = left + 17 + (which == "effort" ? data.composer.traitsX : data.composer.runtimeX)
  derive anchorEnd = anchor + (which == "effort" ? data.composer.traitsWidth : data.composer.runtimeWidth)
  // The implementation menu and the meter's details align to their trigger's end (align end).
  derive x = (which == "workspace" ? data.composer.stripLeft + 5 : which == "branch" ? max(5, data.composer.stripRight - 9 - width) : which == "implement" or which == "context" ? max(5, actionsEnd - width) : anchor + width <= viewport.width - 5 ? anchor : max(5, anchorEnd - width))
  action mark(index: number, focused: bool)
    focusIndex = focused ? index : (active == index ? -1 : active)
    focusSession = session
  action searchFocus(value: bool)
    searchFocused = value
    searchSession = session
  action hover(index: number, over: bool)
    hoverIndex = over ? index : (hovered == index ? -1 : hovered)
    hoverSession = session
  // A row's key also bubbles to the menu (origin -1): only the menu's own
  // focus (no focused row) moves from there.
  action move(origin: number, name: string)
    if count > 0 and (origin >= 0 or active < 0)
      if name == "ArrowDown"
        focus(`composer-menu-item-${(origin < 0 or origin + 1 >= count) ? 0 : origin + 1}`)
      if name == "ArrowUp"
        focus(`composer-menu-item-${origin <= 0 ? count - 1 : origin - 1}`)
      if name == "Home"
        focus("composer-menu-item-0")
      if name == "End"
        focus(`composer-menu-item-${count - 1}`)
  view
    // A button, so Escape binds as its command (a box with a shortcut is not one).
    button position="absolute" left=0 right=0 top=0 bottom=0 z-index=19 padding=0 border-width=0 border-radius=0 background-color="#00000000" press=close aria-label="Close options" aria-keyshortcuts="Escape" testId="dismiss-composer-options"
    column position="absolute" left=x top=(wideWorkspace ? data.composer.stripTop + 33 : "auto") bottom=(wideWorkspace ? "auto" : menuBottom) width=width border-radius=10 box-shadow="0 16px 40px -18px #0000008c" z-index=30
      column id="composer-menu" key=move(-1) width="100%" padding=(which == "branch" ? 0 : 4) gap=0 border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-sizing="border-box" role=(which == "runtime" or which == "branch" or wideWorkspace ? "listbox" : "menu") aria-label=(which == "effort" ? data.composer.traitsLabel : which == "implement" ? "Implementation actions" : which == "workspace" ? "Workspace" : which == "branch" ? "Refs" : "Runtime mode") testId="composer-options"
        when which == "workspace"
          // lane r4-git: MobileRunContextSelector's "Run on" group, then a separator, when a draft can move machines.
          when length(branches.envOptions) > 0
            text "Run on" font-size=12 font-weight=500 line-height="16px" padding-left=8 padding-right=8 padding-top=6 padding-bottom=6 color="light-dark(#71717a, #818181)"
            each option in branches.envOptions key=option.id
              button press=command("environment-run-on", "", option.id, 0) role="menuitemradio" aria-checked=option.selected testId=`run-on-${option.id}` class=Control justify-content="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=6 border-radius=6 background-color=(option.selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000")
                box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
                  CnMachineIcon(kind=option.machine, size=12, color="light-dark(#27272a, #f5f5f5)")
                text option.label font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
            when not branches.gitless
              box height=1 margin-left=8 margin-right=8 margin-top=4 margin-bottom=4 background-color="light-dark(#e4e4e7, #ffffff0f)"
          when not branches.gitless
            text "Workspace" font-size=12 font-weight=500 line-height="16px" padding-left=8 padding-right=8 padding-top=6 padding-bottom=(wideWorkspace ? 6 : 4) color="light-dark(#71717a, #818181)"
            button press=command("cclocal:env-mode", "", "local", 0) disabled=branches.forceWorktree opacity=(branches.forceWorktree ? 0.64 : 1) hover=hover(0) focus=mark(0, true) blur=mark(0, false) key=move(0) id="composer-menu-item-0" role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=(branches.envMode == "local") aria-selected=(branches.envMode == "local") testId="workspace-local" class=Control justify-content="flex-start" width="100%" min-height=(wideWorkspace ? 29 : 28) padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=6 border-radius=6 background-color=(active == 0 or hovered == 0 ? "light-dark(#f4f4f5, #ffffff0a)" : branches.envMode == "local" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000")
              box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
                CcIcon(name=(branches.envIcon == "folder-git-1" ? "folder-git-1" : "folder"), size=12, color="light-dark(#27272a, #f5f5f5)", weight=2)
              text (branches.envIcon == "folder-git-1" ? "Current worktree" : "Current checkout") font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
            button press=command("cclocal:env-mode", "", "worktree", 0) hover=hover(1) focus=mark(1, true) blur=mark(1, false) key=move(1) id="composer-menu-item-1" role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=(branches.envMode == "worktree") aria-selected=(branches.envMode == "worktree") testId="workspace-worktree" class=Control justify-content="flex-start" width="100%" min-height=(wideWorkspace ? 29 : 28) padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=6 border-radius=6 background-color=(active == 1 or hovered == 1 ? "light-dark(#f4f4f5, #ffffff0a)" : branches.envMode == "worktree" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000")
              box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
                CcIcon(name="folder-git", size=12, color="light-dark(#27272a, #f5f5f5)", weight=2)
              text "New worktree" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
            when branches.previous
              button press=command("cclocal:env-mode", "", "previous", 0) hover=hover(2) focus=mark(2, true) blur=mark(2, false) key=move(2) id="composer-menu-item-2" role="menuitemradio" aria-checked=false testId="workspace-previous" class=Control justify-content="flex-start" align-items="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=6 border-radius=6 background-color=(active == 2 or hovered == 2 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2 margin-top=4
                  CcIcon(name="history", size=12, color="light-dark(#27272a, #f5f5f5)", weight=2)
                column min-width=0 flex=1 align-items="flex-start"
                  text "Previous worktree" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
                  when branches.previousBranch != ""
                    text branches.previousBranch font-size=12 line-height="16px" color="light-dark(#71717a, #818181)" line-clamp=1 min-width=0 max-width="100%"
        when which == "branch"
          // BranchPicker: ComboboxSearchInput (px-3 pt-2.5, underline that turns
          // primary on focus), the virtualized list (max-h-56, ps-1 pt-2 pb-1,
          // stable gutter) whose first item is auto-highlighted, then the status.
          column width="100%" gap=0 testId="branch-picker"
            column width="100%" padding-left=12 padding-right=12 padding-top=10 box-sizing="border-box" flex-shrink=0
              row height=33 padding-bottom=6 box-sizing="border-box" position="relative" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color=(searchActive ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#e4e4e7b3, #ffffff0b)")
                box position="absolute" left=0 top=6 display="flex"
                  CcIcon(name="search", size=16, color="light-dark(#71717a8c, #8181818c)", weight=2)
                when branchQuery == ""
                  text "Search refs..." position="absolute" left=20 top=0 font-size=14 line-height="26px" color="light-dark(#71717a, #818181)" aria-hidden=true
                input id="branch-search" value=branchQuery input=searchBranches submit=command(branches.enterOp, "", branches.enterValue, 0) focus=searchFocus(true) blur=searchFocus(false) aria-label="Search refs" testId="branch-search" flex=1 min-width=0 height=26 padding-left=20 padding-right=9 padding-top=0 padding-bottom=0 border-width=0 background-color="#00000000" font-size=14 line-height="26px" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false"
            scroll max-height=224 width="100%" hook="t3-anchor" data-anchor="scroll:strip-refs"
              column width="100%" gap=0 padding-left=8 padding-right=10 padding-top=12 padding-bottom=8 box-sizing="border-box"
                // lane r9-connect: a local draft's pull request reference leads (r9-connect-checkout.ts).
                each item in branches.checkout key=item.reference
                  button press=command("chatlocal:git-pr-open", "", item.reference, 0) hover=hover(0) testId="branch-checkout-pr" role="option" aria-selected=false class=Control justify-content="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 background-color=(hovered <= 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                    row min-width=0 gap=8 padding-top=4 padding-bottom=4 align-items="center"
                      R4Glyph(name=item.mark, size=14, color="light-dark(#71717b, #818181)")
                      column min-width=0 align-items="flex-start"
                        text item.title font-size=14 line-height="20px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 text-align="left"
                        text item.reference font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" line-clamp=1 text-align="left"
                each ref in branches.refs key=ref.name
                  button press=command("cc:branch", "", ref.name, 0) contextmenu=command("cclocal:branch-menu", "", ref.name, 0) hover=hover(ref.index) testId=`branch-${ref.name}` role="option" aria-selected=ref.selected class=Control justify-content="space-between" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=8 border-radius=6 background-color=(hovered == ref.index or (hovered < 0 and ref.index == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                    text ref.name font-size=14 line-height="20px" color=(hovered == ref.index or (hovered < 0 and ref.index == 0) ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#27272a, #f5f5f5)") line-clamp=1 min-width=0 flex=1 text-align="left"
                    when ref.badge != ""
                      text ref.badge font-size=10 line-height="14px" color="light-dark(#71717a73, #81818173)" flex-shrink=0
                when branches.creatable != ""
                  button press=command("cc:branch-create", "", branches.creatable, 0) hover=hover(length(branches.refs) + length(branches.checkout)) testId="branch-create" class=Control justify-content="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 background-color=(hovered == length(branches.refs) + length(branches.checkout) or (hovered < 0 and length(branches.refs) + length(branches.checkout) == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                    text `Create new ref "${branches.creatable}"` font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1
                when length(branches.refs) == 0 and branches.creatable == "" and length(branches.checkout) == 0
                  text (branches.loading ? "Loading refs..." : "No refs found.") font-size=14 line-height="20px" padding=8 text-align="center" color="light-dark(#71717a, #818181)"
            // BranchPicker's originControl while choosing a new worktree's base (lane r4-git).
            when branches.originShown
              button press=local("git-origin", "", "") role="switch" aria-checked=branches.originOn aria-label="Start worktree from origin" testId="branch-origin" width="100%" padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 box-sizing="border-box" gap=12 border-width=0 border-top-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
                row min-width=0 gap=6 align-items="center"
                  R4Glyph(name="refresh-cw", size=12, color="light-dark(#71717a, #818181)")
                  text "Start from origin" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717a, #818181)" white-space="nowrap"
                row width=26 height=16 padding=2 box-sizing="border-box" border-radius=8 flex-shrink=0 align-items="center" justify-content=(branches.originOn ? "flex-end" : "flex-start") background-color=(branches.originOn ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") aria-hidden=true
                  box width=12 height=12 border-radius=6 background-color="light-dark(#ffffff, #0a0a0a)" box-shadow="0 1px 2px #0000000d"
            when branches.status != ""
              text branches.status font-size=12 line-height="16px" padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 color="light-dark(#71717a, #818181)" role="status"
        when which == "context"
          column width="100%" padding=8 gap=8 box-sizing="border-box" testId="context-window-details"
            row width="100%" gap=12 align-items="center" justify-content="space-between"
              text "Context Window" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717a, #818181)"
              text (data.composer.contextPercent != "" ? `${data.composer.contextPercent} · ${data.composer.contextUsed}/${data.composer.contextMax}` : data.composer.contextUsed) font-size=11 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
            when data.composer.contextMax != ""
              box width="100%" height=6 border-radius=3 overflow="hidden" background-color="light-dark(#f4f4f599, #ffffff0f)" role="progressbar" aria-label="Context window usage"
                box height=6 border-radius=3 width=`${data.composer.contextPercent == "" ? "0%" : data.composer.contextPercent}` background-color=(data.composer.contextOver ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717ab8, #818181b8)")
            when data.composer.contextTotal != ""
              row width="100%" justify-content="space-between"
                text "Total processed" font-size=11 line-height="16px" color="light-dark(#52525b, #a1a1aa)"
                text data.composer.contextTotal font-size=11 font-weight=500 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
            when data.composer.contextCost != ""
              row width="100%" justify-content="space-between"
                text "Cost" font-size=11 line-height="16px" color="light-dark(#52525b, #a1a1aa)"
                text data.composer.contextCost font-size=11 font-weight=500 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
            when data.composer.contextNote != ""
              text data.composer.contextNote font-size=11 font-weight=500 line-height="16px" margin-top=4 color="light-dark(#52525b, #a1a1aa)"
            when data.composer.contextCompact
              button press=command("cc:compact", "", "", 0) hover=hover(0) focus=mark(0, true) blur=mark(0, false) key=move(0) id="composer-menu-item-0" testId="compact-context" margin-top=4 width="100%" height=24 gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color=(hovered == 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "light-dark(#ffffff, #ffffff08)") display="flex" flex-direction="row" align-items="center" justify-content="center"
                CcIcon(name="minimize", size=14, color="light-dark(#27272a, #f5f5f5)", weight=2)
                text "Compact context" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
        when which == "implement"
          button press=command("cc:implement-new", "", "", 0) hover=hover(0) focus=mark(0, true) blur=mark(0, false) key=move(0) id="composer-menu-item-0" role="menuitem" testId="implement-new-thread" class=Control justify-content="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=0 border-radius=6 background-color=(active == 0 or hovered == 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
            text "Implement in a new thread" font-size=14 line-height="20px" font-weight=400 color=(active == 0 or hovered == 0 ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#27272a, #f5f5f5)") white-space="nowrap"
        when which == "effort"
          each item in data.composer.traits key=item.key
            when item.kind == "header"
              text item.label font-size=12 font-weight=500 line-height="16px" padding-left=8 padding-right=8 padding-top=6 padding-bottom=4 color="light-dark(#71717a, #818181)"
            when item.kind == "divider"
              box height=1 margin-left=8 margin-right=8 margin-top=4 margin-bottom=4 background-color="light-dark(#e4e4e7, #ffffff0f)"
            when item.kind == "option"
              button press=chooseTrait(item.descriptor, item.value) hover=hover(item.index) focus=mark(item.index, true) blur=mark(item.index, false) key=move(item.index) id=`composer-menu-item-${item.index}` role="menuitemradio" aria-checked=item.selected testId=`effort-${item.value}` class=Control justify-content="flex-start" width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=0 border-radius=6 background-color=(active == item.index or hovered == item.index ? "light-dark(#f4f4f5, #ffffff0a)" : item.selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000")
                column flex=1 min-width=0 align-items="flex-start"
                  row min-width=0 max-width="100%" align-items="center"
                    text item.label font-size=14 line-height="20px" font-weight=400 color=(active == item.index or hovered == item.index ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#27272a, #f5f5f5)") line-clamp=1 min-width=0
                    when item.isDefault
                      box width=4 flex-shrink=0
                      text "Default" font-size=10 font-weight=500 line-height="14px" padding-left=3 padding-right=3 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" border-radius=4 background-color="light-dark(#fcfcfc, #ffffff07)" color="light-dark(#27272a, #f5f5f5)" flex-shrink=0
                  when item.description != ""
                    text item.description font-size=12 line-height="16px" max-width=224 color="light-dark(#71717acc, #818181cc)" text-align="left"
        when which == "runtime"
          each option in data.composer.runtimes key=option.mode
            button press=chooseRuntime(option.mode) hover=hover(option.index) focus=mark(option.index, true) blur=mark(option.index, false) key=move(option.index) id=`composer-menu-item-${option.index}` role="option" aria-selected=option.selected testId=`mode-${option.mode}` class=Control width="100%" min-height=46 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 justify-content="flex-start" align-items="flex-start" background-color=(option.selected ? "light-dark(#27272a14, #f5f5f514)" : active == option.index or hovered == option.index ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              column gap=2 min-width=0 flex=1 align-items="flex-start"
                row gap=6 align-items="center"
                  CcIcon(name=option.icon, size=14, color="light-dark(#71717a, #818181)", weight=2)
                  text option.label font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
                text option.description font-size=12 line-height="16px" color="light-dark(#71717a, #818181)" white-space="nowrap"

// ── The context strip under the draft composer ──────────────────────────────

// BranchToolbar: the workspace mode at the start, the branch at the end, on
// the drawer that hangs 32pt under the card (ps-1 pe-2 py-1, rounded-b-2xl).
component StripControl
  props
    icon: string
    label: string
    testId: string
    aria: string
    open: bool
    disabled: bool
    press: action
    context: action
    // r4-composer: the workspace label's tooltip, on the folder glyph in the compact strip
    // (MobileRunContextSelector) and on the whole Select trigger in the wide one (@3xl).
    tip: string
    tipIcon: bool
    // lane r4-git: the machine the draft runs on, beside the workspace glyph ("" for none).
    machine: string
  state over = false
  state iconOver = false
  action hover(value: bool)
    over = value
  action hoverIcon(value: bool)
    iconOver = value
  view
    // A 1pt transparent border inside px-1.75; glyphs take -0.5 inline margins ([&_svg]:-mx-0.5).
    button press=press contextmenu=context hover=hover disabled=disabled testId=testId aria-label=aria aria-expanded=open min-width=0 max-width=280 height=24 padding-left=8 padding-right=8 gap=4 box-sizing="border-box" border-radius=8 border-width=0 background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=1 position="relative"
      when machine != ""
        // showEnvironmentIndicator: the machine and the workspace glyphs 2pt apart, without the -mx-0.5.
        row gap=2 flex-shrink=0 align-items="center"
          CnMachineIcon(kind=machine, size=12, color=(over or open ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717ab3, #818181b3)"))
          when icon != ""
            CcIcon(name=icon, size=12, color=(over or open ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717ab3, #818181b3)"), weight=2)
      else
        box hover=hoverIcon display="flex" flex-shrink=0 margin-left=-2 margin-right=-2 opacity=(icon == "git-branch" ? 0.7 : 1) position="relative"
          CcIcon(name=icon, size=12, color=(over or open ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717ab3, #818181b3)"), weight=2)
          when tip != "" and tipIcon
            TipBubble(label=tip, side="top", align="center", offset=16, inset=0, shown=(iconOver and not open))
      when tip != "" and not tipIcon
        TipBubble(label=tip, side="top", align="center", offset=28, inset=0, shown=(over and not open))
      text label font-size=12 line-height="16px" color=(over or open ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717ab3, #818181b3)") line-clamp=1 min-width=0 max-width=240
      box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2 opacity=0.5
        CcIcon(name="chevron-down", size=12, color=(over or open ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717ab3, #818181b3)"), weight=2)

component ComposerStrip
  props
    strip: ComposerBranches
    open: string
    busy: bool
    openOptions: action
    command: action
    // r4-composer: the composer is at least 768pt wide (@3xl/composer-surface): the workspace
    // control is the desktop Select (BranchToolbarEnvModeSelector) instead of the compact menu.
    wide: bool
  view
    // ps-1 pe-2 inside the drawer's pseudo-element border: the drawn 1pt border eats a point of each.
    row margin-left=22 margin-right=22 padding-left=3 padding-right=7 padding-top=4 padding-bottom=4 gap=4 box-sizing="border-box" align-items="center" border-bottom-left-radius=16 border-bottom-right-radius=16 border-style="solid" border-top-width=0 border-left-width=1 border-right-width=1 border-bottom-width=1 border-color="light-dark(#00000014, #ffffff12)" box-shadow="0 12px 28px -18px light-dark(#00000040, #00000000)" hook="t3-frame" data-frame="strip" testId="composer-context-strip"
      when strip.gitless
        // lane r12-threads: a non-Git project offers only where it runs (BranchToolbarEnvironmentSelector): the
        // "Run on" Select for a draft, the static machine row (h-6 px-1.75 gap-1, text-xs /70) for a started thread.
        when strip.envLocked
          row height=24 padding-left=8 padding-right=8 gap=4 align-items="center" min-width=0 max-width="100%" testId="run-on-locked" aria-label=strip.envMachineLabel
            CnMachineIcon(kind=strip.envMachine, size=12, color="light-dark(#71717ab3, #818181b3)")
            text strip.envMachineLabel font-size=12 line-height="16px" color="light-dark(#71717ab3, #818181b3)" line-clamp=1
        else
          StripControl(icon="", label=strip.envMachineLabel, testId="workspace-mode", aria="Run on", open=(open == "workspace"), disabled=busy, press=openOptions("workspace"), context=command("cclocal:noop", "", "", 0), tip=strip.envMachineLabel, tipIcon=false, machine=strip.envMachine)
        box flex=1 min-width=0
      else
        when strip.envLocked
          row height=24 padding-left=8 padding-right=8 gap=4 align-items="center" min-width=0 max-width="48%" testId="workspace-locked"
            box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
              CcIcon(name=strip.envIcon, size=12, color="light-dark(#71717ab3, #818181b3)", weight=2)
            text strip.envLabel font-size=12 line-height="16px" color="light-dark(#71717ab3, #818181b3)" line-clamp=1
        else
          StripControl(icon=strip.envIcon, label=(strip.envShow ? strip.envMachineLabel : strip.envLabel), testId="workspace-mode", aria=(wide ? "Workspace" : `Workspace: ${strip.envLabel}`), open=(open == "workspace"), disabled=busy, press=openOptions("workspace"), context=command("cclocal:noop", "", "", 0), tip=strip.envLabel, tipIcon=(not wide), machine=(strip.envShow ? strip.envMachine : ""))
        box flex=1 min-width=0
        when strip.prShow
          StripPrBadge(text=strip.prText, icon=strip.prIcon, tone=strip.prState, label=strip.prLabel, list=strip.prList, url=strip.prUrl, target=strip.prTarget, tips=strip.prTips, disabled=busy, command=command)
        StripControl(icon="git-branch", label=strip.branchLabel, testId="branch-selector", aria=`Branch: ${strip.branchLabel}`, open=(open == "branch"), disabled=busy, press=openOptions("branch"), context=command("cclocal:branch-menu", "", strip.branch, 0), tip="", tipIcon=false, machine="")

// ── The dock above the card ─────────────────────────────────────────────────

// QueuedRunsControl: the run's queued follow-ups, each editable in the
// composer, promotable to a steer (⇧⌘↩ for the first) and removable.
component QueuedRow
  props
    row: ComposerQueued
    count: number
    data: Snapshot
    busy: bool
    command: action
    keyed: action
    drag: action
    drop: action
    dragging: bool
    insertTop: bool
    insertBottom: bool
    dropValue: string
  state over = ""
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
  view
    row width="100%" min-height=20 gap=4 align-items="center" border-radius=4 position="relative" opacity=(dragging ? 0.5 : 1) background-color=(row.editing ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") role="listitem" testId=`queued-${row.runId}`
      // The insertion line while a grip drag is over this row (bg-primary/70, 2pt).
      when insertTop
        box position="absolute" left=0 right=0 top=0 height=2 border-radius=2 background-color="light-dark(#1b4ed8b3, #346bf1b3)" testId="queued-drop-line"
      when insertBottom
        box position="absolute" left=0 right=0 bottom=0 height=2 border-radius=2 background-color="light-dark(#1b4ed8b3, #346bf1b3)" testId="queued-drop-line"
      // The grip reorders by dragging (released over a row's top or bottom half) or with ↑/↓ (queued-run.reorder).
      when data.composer.queueReorder
        button key=keyed("queued-key", row.runId) pan=drag(row.runId, row.index) panrelease=drop("queued-drop", dropValue) touch-action="none" hover=hover("grip") disabled=busy testId=`queued-grip-${row.runId}` aria-label="Reorder queued message (drag, or press the arrow keys)" width=24 height=24 padding=0 border-radius=8 border-width=0 background-color=(over == "grip" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          CcIcon(name="grip", size=14, color=(over == "grip" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2)
      else
        box width=24 height=24 flex-shrink=0
      text row.text font-size=12 line-height="16px" color="light-dark(#27272acc, #f5f5f5cc)" flex=1 min-width=0 line-clamp=1 aria-label=(row.editing ? `Editing queued message: ${row.text}` : row.text)
      when row.editing
        button press=command("cclocal:queued-cancel", "", "", 0) hover=hover("cancel") testId="queued-cancel-edit" aria-label="Cancel editing queued message" height=24 padding-left=7 padding-right=7 border-radius=8 border-width=0 background-color=(over == "cancel" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          text "Cancel" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
      else
        button press=command("cclocal:queued-edit", row.runId, "", 0) hover=hover("edit") disabled=busy testId=`queued-edit-${row.runId}` aria-label="Edit queued message" width=24 height=24 padding=0 border-radius=8 border-width=0 background-color=(over == "edit" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          CcIcon(name="pencil", size=14, color=(over == "edit" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2)
        button press=command("cc:queued-steer", row.runId, "", 0) hover=hover("steer") disabled=(busy or not data.composer.queueSteer) opacity=(busy or not data.composer.queueSteer ? 0.64 : 1) testId=`queued-steer-${row.runId}` aria-label=(data.composer.queueSteerReason != "" ? data.composer.queueSteerReason : "Send as a steer instead") aria-keyshortcuts=(row.index == 0 and data.composer.queueSteer ? "Meta+Shift+Enter" : "") height=24 padding-left=7 padding-right=7 gap=4 border-radius=8 border-width=0 background-color=(over == "steer" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left=-2 margin-right=-2
            CcIcon(name="corner-up-right", size=14, color=(over == "steer" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2)
          text "Steer" font-size=12 font-weight=500 line-height="16px" color=(over == "steer" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
        button press=command("cc:queued-remove", row.runId, "", 0) hover=hover("remove") disabled=busy testId=`queued-remove-${row.runId}` aria-label="Remove queued message" width=24 height=24 padding=0 border-radius=8 border-width=0 background-color=(over == "remove" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          CcIcon(name="x", size=14, color="light-dark(#71717b, #818181)", weight=2)

component QueuedControl
  props
    data: Snapshot
    busy: bool
    command: action
    keyed: action
    drop: action
  state collapsed = ""
  // A grip drag (QueuedRunsControl dragState): the lifted run, where it started and how far
  // the pointer moved. A finished drop bumps queueDropSeq, which settles the lifted row.
  state dragRun = ""
  state dragFrom = 0
  state dragDy = 0
  state dragSeq = -1
  action toggle
    collapsed = collapsed == data.threadId ? "" : data.threadId
  action drag(id: string, index: number, dx: number, dy: number)
    if dragRun != id or dragSeq != data.composer.queueDropSeq
      dragRun = id
      dragFrom = index
      dragDy = 0
      dragSeq = data.composer.queueDropSeq
    dragDy = dragDy + dy
  derive count = length(data.composer.queued)
  derive dragLive = dragRun != "" and dragSeq == data.composer.queueDropSeq
  // Rows are 24pt, 1pt apart: over a row's upper half inserts before it, else after it.
  derive dragInsert = (dragLive ? min(count, max(0, floor((dragFrom * 25 + 12 + dragDy + 13) / 25))) : -1)
  view
    column margin-left=22 margin-right=22 margin-bottom=-17 padding-left=3 padding-right=3 padding-top=4 padding-bottom=21 box-sizing="border-box" border-top-left-radius=18 border-top-right-radius=18 border-style="solid" border-top-width=1 border-left-width=1 border-right-width=1 border-bottom-width=0 border-color="light-dark(#00000014, #ffffff0d)" background-color="light-dark(#ffffffcc, #121212cc)" box-shadow="0 12px 28px -18px #00000066" role="region" aria-label=`${count} queued message${count == 1 ? "" : "s"}` testId="queued-control"
      button press=toggle testId="queued-toggle" aria-label=(collapsed == data.threadId ? "Expand queued messages" : "Collapse queued messages") aria-expanded=(collapsed != data.threadId) width="100%" min-height=24 padding=0 gap=4 border-radius=6 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0
          CcIcon(name="list-ordered", size=12, color="light-dark(#71717b, #818181)", weight=2)
        text "Queued" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" flex=1 min-width=0 text-align="left"
        text `${count}` font-size=12 font-weight=500 line-height="16px" min-width=24 text-align="center" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" flex-shrink=0
        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          CcIcon(name=(collapsed == data.threadId ? "chevron-up" : "chevron-down"), size=14, color="light-dark(#71717b, #818181)", weight=2)
      when collapsed != data.threadId
        scroll max-height=128 width="100%"
          column width="100%" gap=1 role="list" testId="queued-list"
            each row in data.composer.queued key=row.runId
              QueuedRow(row=row, count=count, data=data, busy=busy, command=command, keyed=keyed, drag=drag, drop=drop, dragging=(dragLive and dragRun == row.runId), insertTop=(dragLive and dragInsert == row.index), insertBottom=(dragLive and row.last and dragInsert == count), dropValue=(dragLive ? `${dragRun}|${dragInsert}` : ""))

// ComposerBanner.Root "comfortable", attached (its last 17pt tucks under the
// next surface) or floating (an expanded notice behind the peek).
component NoticeRow
  props
    notice: ComposerNotice
    attached: bool
    stacked: bool
    busy: bool
    command: action
  view
    column margin-left=(attached ? 22 : 0) margin-right=(attached ? 22 : 0) margin-bottom=(attached ? -17 : 0) padding-left=3 padding-right=3 padding-top=5 padding-bottom=(attached ? 22 : 5) box-sizing="border-box" border-top-left-radius=(stacked ? 0 : attached ? 18 : 16) border-top-right-radius=(stacked ? 0 : attached ? 18 : 16) border-bottom-left-radius=(attached ? 0 : 16) border-bottom-right-radius=(attached ? 0 : 16) border-style="solid" border-top-width=(stacked ? 0 : 1) border-left-width=1 border-right-width=1 border-bottom-width=(attached ? 0 : 1) border-color=(notice.variant == "warning" ? "light-dark(#fe9a0047, #fe9a0047)" : notice.variant == "error" ? "light-dark(#fb2c3652, #fb414a52)" : "light-dark(#00000014, #ffffff0d)") background-color=(notice.variant == "warning" ? "light-dark(#fef6eacc, #231b0fcc)" : notice.variant == "error" ? "light-dark(#feededcc, #231415cc)" : "light-dark(#ffffffcc, #121212cc)") box-shadow="0 12px 28px -18px #00000066" role="alert" testId=`notice-${notice.id}`
      row width="100%" gap=4 align-items="center"
        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0 align-self="flex-start"
          when notice.icon == "dot"
            box width=6 height=6 border-radius=3 background-color="light-dark(#27272a, #f5f5f5)" animation="ccPulse 2s ease-in-out infinite"
          else
            when notice.icon == "dot-static"
              box width=6 height=6 border-radius=3 background-color="light-dark(#27272a, #f5f5f5)"
            else
              CcIcon(name=notice.icon, size=12, color="light-dark(#71717b, #818181)", weight=2)
        text notice.title font-size=12 font-weight=500 line-height="24px" color="light-dark(#27272a, #f5f5f5)" flex-shrink=0 max-width="60%" line-clamp=1
        when length(notice.segments) > 0
          // The background-work roster: a subagent with its own thread is an InlineButton (tone muted).
          row flex=1 min-width=32 align-items="center" overflow="hidden" testId=`notice-segments-${notice.id}`
            each seg in notice.segments key=seg.key
              when seg.threadId != ""
                button press=command("select-thread", seg.threadId, "", 0) disabled=busy aria-label=`Open subagent ${seg.label}` testId=`notice-open-${seg.threadId}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" flex-shrink=0
                  text seg.label font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)" white-space="nowrap"
              else
                text seg.label font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" white-space="nowrap" flex-shrink=0
              when not seg.last
                text ", " font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" white-space="pre" flex-shrink=0
        else
          when notice.description != ""
            text notice.description font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" flex=1 min-width=32 line-clamp=1
          else
            box flex=1 min-width=0
        when notice.action != ""
          Tip(label=notice.actionReason, side="top", align="center", offset=28)
            button press=command(notice.action, "", "", 0) disabled=(busy or notice.actionReason != "") testId=`notice-action-${notice.id}` aria-label=notice.actionLabel height=24 padding-left=7 padding-right=7 border-radius=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 opacity=(busy or notice.actionReason != "" ? 0.64 : 1)
              text notice.actionLabel font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
        when notice.action2 != ""
          button press=command(notice.action2, "", "", 0) disabled=busy testId=`notice-action2-${notice.id}` aria-label=notice.action2Label height=24 padding-left=7 padding-right=7 border-radius=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 opacity=(busy ? 0.64 : 1)
            text notice.action2Label font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
        when notice.dismiss != ""
          button press=command(notice.dismiss, notice.dismissId, "", 0) disabled=busy testId=`notice-dismiss-${notice.id}` aria-label=notice.dismissLabel width=24 height=24 padding=0 border-radius=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
            CcIcon(name="x", size=14, color="light-dark(#71717b, #818181)", weight=2)
      when length(notice.lines) > 0
        column width="100%" padding-left=28 padding-right=8 padding-top=4 padding-bottom=6 gap=8 box-sizing="border-box" testId=`notice-body-${notice.id}`
          each line in notice.lines key=line
            text line font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"

// ComposerActivityRow: the thread is loading or resynchronising.
component SyncRow
  props
    label: string
  view
    row width="100%" min-height=24 gap=4 align-items="center"
      row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0
        box width=12 height=12 display="flex" animation="ccSpin 1s linear infinite"
          CcIcon(name="loader", size=12, color="light-dark(#71717b, #818181)", weight=2)
      text label font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" white-space="nowrap" role="status" testId="composer-sync-status"

// ComposerTasksBadge / ComposerTasksContent: the running turn's todo list.
component TasksRow
  props
    data: Snapshot
    expanded: bool
    toggle: action
  view
    column width="100%"
      button press=toggle testId="composer-tasks" aria-expanded=expanded aria-label=`${expanded ? "Collapse tasks" : "Tasks"}: ${data.composer.tasksDone} of ${data.composer.tasksTotal} complete. Current task: ${data.composer.tasksCurrent}` width="100%" min-height=24 padding=0 gap=4 border-radius=6 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0
          CcIcon(name="list-todo", size=12, color="light-dark(#71717b, #818181)", weight=2)
        text "Tasks" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" flex-shrink=0
        text data.composer.tasksCurrent font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272acc, #f5f5f5cc)" flex=1 min-width=0 line-clamp=1 text-align="left"
        text `${data.composer.tasksDone}/${data.composer.tasksTotal}` font-size=12 font-weight=500 line-height="16px" min-width=24 text-align="center" font-variant-numeric="tabular-nums" color=(data.composer.tasksDone >= data.composer.tasksTotal ? "light-dark(#00a63e, #00c950)" : "light-dark(#71717b, #818181)") flex-shrink=0
        when data.composer.tasksTotal > 1 and data.composer.tasksTotal <= 10
          row width=80 gap=2 align-items="center" flex-shrink=0 aria-hidden=true
            each step in data.composer.tasks key=step.key
              box flex=1 min-width=0 height=3 border-radius=2 background-color=(step.status == "completed" ? "light-dark(#00a63e, #00c950)" : step.status == "inProgress" ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b40, #81818140)")
        row width=24 height=24 align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          CcIcon(name=(expanded ? "chevron-down" : "chevron-up"), size=14, color="light-dark(#71717b, #818181)", weight=2)
      when expanded
        scroll max-height=240 width="100%"
          column width="100%" gap=1 role="list" aria-label=`Task list. ${data.composer.tasksDone} of ${data.composer.tasksTotal} complete.` testId="composer-tasks-list"
            each step in data.composer.tasks key=step.key
              row width="100%" min-height=20 padding-top=4 padding-bottom=4 padding-right=8 box-sizing="border-box" gap=4 align-items="flex-start" role="listitem"
                row width=24 height=16 align-items="center" justify-content="center" flex-shrink=0
                  CcIcon(name=(step.status == "completed" ? "check" : step.status == "inProgress" ? "circle-dot" : "circle"), size=12, color=(step.status == "completed" ? "light-dark(#00a63e, #00c950)" : step.status == "inProgress" ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b66, #81818166)"), weight=2)
                text step.text font-size=12 line-height="16px" flex=1 min-width=0 overflow-wrap="anywhere" color=(step.status == "completed" ? "light-dark(#71717b8c, #8181818c)" : step.status == "inProgress" ? "light-dark(#27272ae6, #f5f5f5e6)" : "light-dark(#71717bb3, #818181b3)") aria-label=`${step.status == "completed" ? "Completed" : step.status == "inProgress" ? "Running" : "Pending"}: ${step.text}`
                text step.duration font-size=10 line-height="16px" width=48 text-align="right" font-variant-numeric="tabular-nums" color="light-dark(#71717b73, #81818173)" flex-shrink=0

// The activity strip (sync or tasks) and plan-ready notice on the attachment
// surface (density default: 4pt block padding, 17pt tucked under).
component ActivityStrip
  props
    data: Snapshot
    stacked: bool
    expanded: bool
    toggle: action
  view
    column margin-left=22 margin-right=22 margin-bottom=-17 padding-left=3 padding-right=3 padding-top=4 padding-bottom=21 box-sizing="border-box" border-top-left-radius=(stacked ? 0 : 18) border-top-right-radius=(stacked ? 0 : 18) border-style="solid" border-top-width=(stacked ? 0 : 1) border-left-width=1 border-right-width=1 border-bottom-width=0 border-color="light-dark(#00000014, #ffffff0d)" background-color="light-dark(#ffffffcc, #121212cc)" box-shadow="0 12px 28px -18px #00000066" testId="composer-activity"
      when data.composer.activity == "sync"
        SyncRow(label=data.composer.syncStatus)
      else
        TasksRow(data=data, expanded=expanded, toggle=toggle)

// ComposerBannerStack: activity (or the first notice) stays attached; other
// notices wait behind a 12pt peek ("Show other notices") and float above it
// when opened. Then the plan-ready drawer (ComposerPlanFollowUpBanner).
component ComposerDock
  props
    data: Snapshot
    busy: bool
    command: action
    keyed: action
    drop: action
  state open = ""
  state tasksOpen = false
  action toggleStack
    open = open == data.threadId ? "" : data.threadId
  action toggleTasks
    tasksOpen = not tasksOpen
  derive activity = data.composer.activity != ""
  derive notices = length(data.composer.notices)
  derive behind = (activity ? notices : notices - 1)
  derive expanded = open == data.threadId and behind > 0
  view
    column width="100%" testId="composer-dock"
      when length(data.composer.queued) > 0
        QueuedControl(data=data, busy=busy, command=command, keyed=keyed, drop=drop)
      when behind > 0
        column width="100%" position="relative" min-height=12
          when expanded
            column width="100%" gap=8 padding-bottom=8 box-sizing="border-box" role="group" aria-label="Other notices" testId="composer-other-notices"
              each n in data.composer.notices key=n.id
                when not n.front
                  row width="100%" padding-left=22 padding-right=22 box-sizing="border-box"
                    column width="100%"
                      NoticeRow(notice=n, attached=false, stacked=false, busy=busy, command=command)
          else
            row width="100%" height=12 justify-content="center"
              button press=toggleStack testId="show-other-notices" aria-label="Show other notices" aria-expanded=false width="calc(96% - 42px)" height=12 padding=0 border-top-left-radius=16 border-top-right-radius=16 border-style="solid" border-top-width=1 border-left-width=1 border-right-width=1 border-bottom-width=0 border-color="light-dark(#00000014, #ffffff0d)" background-color="light-dark(#ffffffcc, #121212cc)" box-shadow="0 4px 6px -1px #0000001a, 0 2px 4px -2px #0000001a"
          when expanded
            button press=toggleStack testId="hide-other-notices" aria-label="Hide other notices" aria-keyshortcuts="Escape" position="absolute" left=0 top=0 width=1 height=1 padding=0 border-width=0 background-color="#00000000" opacity=0
      when activity
        ActivityStrip(data=data, stacked=(length(data.composer.queued) > 0), expanded=tasksOpen, toggle=toggleTasks)
      else
        each n in data.composer.notices key=n.id
          when n.front
            NoticeRow(notice=n, attached=true, stacked=(length(data.composer.queued) > 0), busy=busy, command=command)
      when data.composer.planReady and data.requestMode == ""
        row margin-left=22 margin-right=22 margin-bottom=-17 padding-left=3 padding-right=3 padding-top=4 padding-bottom=21 box-sizing="border-box" gap=4 align-items="center" border-top-left-radius=(activity or notices > 0 ? 0 : 18) border-top-right-radius=(activity or notices > 0 ? 0 : 18) border-style="solid" border-top-width=(activity or notices > 0 ? 0 : 1) border-left-width=1 border-right-width=1 border-bottom-width=0 border-color="light-dark(#00000014, #ffffff0d)" background-color="light-dark(#ffffffcc, #121212cc)" box-shadow="0 12px 28px -18px #00000066" testId="plan-ready"
          box width=24 height=24 flex-shrink=0
          text "Plan ready" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)" flex-shrink=0
          when data.composer.planTitle != ""
            text data.composer.planTitle font-size=12 line-height="16px" color="light-dark(#27272ad9, #f5f5f5d9)" flex=1 min-width=0 line-clamp=1

// ProviderSubagentBar: a provider-native subagent thread takes no messages, so
// this bar replaces the composer: who is working, for how long, and the way
// back to the parent.
component SubagentBar
  props
    data: Snapshot
    busy: bool
    openParent: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row width="100%" min-height=48 gap=12 align-items="center" padding-top=8 padding-bottom=8 padding-left=20 padding-right=8 box-sizing="border-box" border-radius=22 border-style="solid" border-width=1 border-color=(data.look.themed ? data.look.border : "light-dark(#00000014, #ffffff0d)") background-color=(data.look.themed ? data.look.popover : "light-dark(#fefefe, #101010)") box-shadow="0 12px 28px -18px light-dark(#00000066, #00000000), inset 0 1px 0 0 light-dark(#00000000, #ffffff08)" testId="provider-subagent-bar"
      row min-width=0 gap=8 align-items="center"
        when data.providerDriver != ""
          ProviderInstanceMark(driver=data.providerDriver, size=16, color="light-dark(#27272a, #f5f5f5)", badge=data.providerBadge, accent=data.providerBadgeColor)
        text data.composer.subagentModel font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
        when data.composer.subagentEffort != ""
          text data.composer.subagentEffort font-size=14 line-height="20px" color="light-dark(#71717a, #818181)" flex-shrink=0 white-space="nowrap"
      text data.composer.subagentStatus font-size=14 line-height="20px" font-variant-numeric="tabular-nums" color="light-dark(#71717a, #818181)" line-clamp=1 min-width=0 aria-hidden=true testId="subagent-status"
      text data.composer.subagentAnnounce position="absolute" width=1 height=1 overflow="hidden" opacity=0 font-size=1 role="status"
      box flex=1 min-width=0
      text "Runs on its own" font-size=14 line-height="20px" color="light-dark(#71717a, #818181)" flex-shrink=0 white-space="nowrap"
      when data.composer.subagentParent != ""
        button press=openParent(data.composer.subagentParent) hover=hover disabled=busy testId="subagent-open-parent" height=32 padding-left=11 padding-right=11 gap=6 border-radius=8 border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          CcIcon(name="arrow-up-left", size=16, color="light-dark(#27272a, #f5f5f5)", weight=2)
          text "Open parent" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
