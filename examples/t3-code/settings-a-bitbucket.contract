// Source Control → Bitbucket credentials (lane settings-a; settings-a-bitbucket.ts),
// the body of the Bitbucket row's details (BitbucketCredentialsSettings.tsx).

shape BitbucketView
  key: string
  saved: string
  savedLabel: string
  email: string
  apiTokenSaved: bool
  environmentId: string

// The reference's canSave: a new access token, or an email with a new or kept API token
// that changes something.
fn bbCanSave(method: string, saved: string, access: string, email: string, savedEmail: string, api: string, apiSaved: bool): bool = method == "access-token" ? trim(access) != "" : (trim(email) != "" and (trim(api) != "" or apiSaved) and (saved != method or trim(api) != "" or trim(email) != savedEmail))

component BitbucketForm
  props
    form: BitbucketView
    busy: bool
    rest: action
  state choice = ""
  state accessDraft = ""
  state emailDraft = ""
  state emailEdited = false
  state apiDraft = ""
  action choose(next: string)
    choice = next
  action editAccess(next: string)
    accessDraft = next
  action editEmail(next: string)
    emailDraft = next
    emailEdited = true
  action editApi(next: string)
    apiDraft = next
  view
    column width="100%" gap="1rem" padding-top="0.25rem" padding-left="1rem" padding-right="1rem" padding-bottom="1rem" box-sizing="border-box" testId="bitbucket-credentials"
      // ToggleGroup variant segmented: the sign-in method.
      row align-self="flex-start" role="group" aria-label="Bitbucket sign-in method" padding="0.125rem" gap="0.125rem" border-radius="0.625rem" background-color="light-dark(#d4d4d866, #ffffff08)"
        BbMethod(value="access-token", label="Access token", selected=(choice != "" ? choice : (form.saved != "" ? form.saved : "access-token")), disabled=busy, choose=choose)
        BbMethod(value="api-token", label="API token", selected=(choice != "" ? choice : (form.saved != "" ? form.saved : "access-token")), disabled=busy, choose=choose)
      when (choice != "" ? choice : (form.saved != "" ? form.saved : "access-token")) == "access-token"
        BbInfo(description="Scoped to one repository, project, or workspace. Create it in that item's Bitbucket settings.", link="https://support.atlassian.com/bitbucket-cloud/docs/access-tokens/", linkLabel="Learn more")
        BbField(label="Access token")
          input value=accessDraft input=editAccess placeholder=(form.saved == "access-token" ? "Stored secret, enter a new value to replace" : "Not set") type="password" disabled=busy aria-label="Access token" spellcheck="false" autocorrect="off" testId="bitbucket-access-token" flex=1 min-width=0 height="1.625rem" padding=0 position="relative" top="0.28125rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#27272a, #f5f5f5)"
      else
        BbInfo(description="Uses your Atlassian account, so it reaches every repository you can. Give it read and write access to repositories and pull requests, and read:user:bitbucket.", link="https://id.atlassian.com/manage-profile/security/api-tokens", linkLabel="Create an API token")
        BbField(label="Atlassian account email")
          input value=(emailEdited ? emailDraft : form.email) input=editEmail placeholder="you@example.com" type="email" disabled=busy aria-label="Atlassian account email" spellcheck="false" autocorrect="off" testId="bitbucket-email" flex=1 min-width=0 height="1.625rem" padding=0 position="relative" top="0.28125rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#27272a, #f5f5f5)"
        BbField(label="API token")
          input value=apiDraft input=editApi placeholder=(form.saved == "api-token" ? "Stored secret, enter a new value to replace" : "Not set") type="password" disabled=busy aria-label="API token" spellcheck="false" autocorrect="off" testId="bitbucket-api-token" flex=1 min-width=0 height="1.625rem" padding=0 position="relative" top="0.28125rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#27272a, #f5f5f5)"
      row width="100%" align-items="center" justify-content="space-between" gap="0.75rem"
        text (form.saved == "" ? "Without a saved token, the server falls back to its T3CODE_BITBUCKET_* environment variables." : (form.saved == (choice != "" ? choice : form.saved) ? "" : `Saving replaces your ${form.savedLabel}.`)) font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" flex=1 min-width=0 testId="bitbucket-note"
        row flex-shrink=0 gap="0.5rem"
          when form.saved != ""
            button press=rest("bitbucket", `action=remove&environment=${form.environmentId}`) disabled=busy testId="bitbucket-remove" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" opacity=(busy ? 0.64 : 1)
              text "Remove" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
          button press=rest("bitbucket", `action=save&environment=${form.environmentId}&method=${choice != "" ? choice : (form.saved != "" ? form.saved : "access-token")}&accessToken=${encodeURIComponent(accessDraft)}&email=${encodeURIComponent(emailDraft)}&emailEdited=${emailEdited ? "true" : "false"}&apiToken=${encodeURIComponent(apiDraft)}`) disabled=(busy or not bbCanSave(choice != "" ? choice : (form.saved != "" ? form.saved : "access-token"), form.saved, accessDraft, emailEdited ? emailDraft : form.email, form.email, apiDraft, form.apiTokenSaved)) testId="bitbucket-save" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" box-shadow="0 1px 2px #1b4ed83d" display="flex" flex-direction="row" align-items="center" opacity=(busy or not bbCanSave(choice != "" ? choice : (form.saved != "" ? form.saved : "access-token"), form.saved, accessDraft, emailEdited ? emailDraft : form.email, form.email, apiDraft, form.apiTokenSaved) ? 0.64 : 1)
            text "Save" font-size="0.75rem" font-weight=500 line-height="1rem" color="#ffffff"

component BbMethod
  props
    value: string
    label: string
    selected: string
    disabled: bool
    choose: action
  view
    button press=choose(value) disabled=disabled role="radio" aria-checked=(selected == value) aria-label=label testId=`bitbucket-method-${value}` height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(selected == value ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(selected == value ? "0 1px 2px #0000000d" : "none")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(selected == value ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

component BbInfo
  props
    description: string
    link: string
    linkLabel: string
  view
    // The docs link runs inline after the description (InlineButton inside the paragraph).
    text width="100%" max-width="42rem" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #818181)" testId="bitbucket-docs"
      text `${description} `
      text linkLabel href=link font-weight=500 color="light-dark(#27272a, #f5f5f5)"

component BbField
  props
    label: string
  slot
  view
    column width="100%" gap="0.375rem"
      text label font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
      row width="100%" height="1.75rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow="0 1px 2px #0000000a" align-items="center" padding-left="0.5625rem" padding-right="0.5625rem"
        children
