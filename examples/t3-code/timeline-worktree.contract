// WorktreeSetupCard (T3 Code, MIT; see LICENSE-T3): a new worktree thread's
// setup under the working header. Each stage reads like a work-log row (its
// status glyph, label, trailing detail and elapsed time); the setup script's
// last four lines sit in a fixed box once it prints; Details lists the branch,
// base, path and setup command; Cancel interrupts the bootstrap. A failed or
// cancelled setup brings its own header; once the agent's turn is live the
// card collapses to one summary row (timeline-worktree.ts).
use LiveActivity from "./timeline-work.contract"
use TimelineIcon from "./timeline-icons.contract"
use WorktreeSetupView from "./timeline-worktree-shapes.contract"

keyframes tlSetupSpin
  from rotate=0
  to rotate=360

// shared/orchestrationTiming formatDuration: "850ms", "1.5s", "12s", "1m 5s".
fn setupTenths(ms: number): number = floor(ms / 100 + 0.5)
fn setupWhole(seconds: number): string = trim(`${seconds >= 3600 ? toString(floor(seconds / 3600)) + "h " : ""}${floor(seconds % 3600 / 60) > 0 ? toString(floor(seconds % 3600 / 60)) + "m " : ""}${seconds % 60 > 0 ? toString(seconds % 60) + "s" : ""}`)
fn setupDuration(ms: number): string = ms < 1000 ? `${max(1, floor(ms + 0.5))}ms` : ms < 10000 ? (setupTenths(ms) >= 100 ? "10s" : setupTenths(ms) % 10 == 0 ? `${floor(setupTenths(ms) / 10)}.0s` : `${setupTenths(ms) / 10}s`) : ms < 60000 ? `${floor(ms / 1000 + 0.5)}s` : setupWhole(floor(ms / 1000 + 0.5))
fn setupElapsed(started: number, ended: number, now: number): string = started <= 0 ? "" : setupDuration(max(0, (ended > 0 ? ended : now) - started))
fn stageInk(status: string): string = status == "failed" ? "light-dark(#e7000b, #ff6467)" : status == "warning" ? "light-dark(#bb4d00, #fdc700)" : "light-dark(#71717b, #818181)"
fn stageGlyph(status: string): string = status == "done" ? "check-mark" : status == "failed" ? "x" : status == "warning" ? "circle-alert" : status == "skipped" ? "minus" : "circle"

component WorktreeSetupCard
  props
    setup: WorktreeSetupView
    now: number
    local: action
  view
    column width="100%" role="region" aria-label="Worktree setup" testId="worktree-setup"
      when setup.showHeader
        column width="100%" padding-top=4 padding-bottom=8 box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
          row height=24 min-width=0 padding-left=4 padding-right=4 gap=8 align-items="baseline"
            text setup.header min-width=0 line-clamp=1 font-size=14 line-height="22.75px" font-variant-numeric="tabular-nums" color=(setup.tone == "failed" ? "light-dark(#e7000b, #ff6467)" : setup.tone == "warning" ? "light-dark(#bb4d00, #fdc700)" : "light-dark(#71717b, #818181)")
            box flex=1
            text setupElapsed(setup.startedMs, setup.endedMs, now) flex-shrink=0 font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      when setup.collapsed
        SetupStageRow(label=setup.header, status=setup.summary, trailing="", elapsed=setupElapsed(setup.startedMs, setup.endedMs, now))
      else
        column width="100%" padding-top=(setup.showHeader ? 6 : 0)
          each stage in setup.stages key=stage.id
            column width="100%"
              SetupStageRow(label=stage.label, status=stage.status, trailing=stage.trailing, elapsed=(stage.status == "skipped" or stage.status == "pending" ? "" : setupElapsed(stage.startedMs, stage.endedMs, now)))
              when length(stage.tail) > 0
                column margin-left=32 margin-bottom=4 padding-left=10 padding-right=10 padding-top=6 padding-bottom=6 box-sizing="border-box" border-radius=6 border-width=1 border-style="solid" border-color=(stage.status == "failed" ? "light-dark(#e7000b33, #ff646733)" : "light-dark(#e4e4e7, #ffffff0f)") background-color=(stage.status == "failed" ? "light-dark(#fef2f2, #460809)" : "light-dark(#fafafa, #ffffff08)") testId="worktree-setup-tail"
                  each line in stage.tail key=line.id
                    text (line.text == "" ? " " : line.text) line-clamp=1 white-space="pre" font-family="ui-monospace" font-size=11 line-height="17.875px" color=(stage.status == "failed" ? "light-dark(#e7000b, #ff6467)" : "light-dark(#71717b, #818181)")
      when setup.error != ""
        text setup.error margin-top=4 margin-left=32 font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
      when setup.detailsOpen and length(setup.details) > 0
        column margin-top=4 margin-bottom=6 margin-left=32 gap=2 testId="worktree-setup-details"
          each detail in setup.details key=detail.id
            row min-width=0 gap=12 align-items="baseline"
              text detail.id width=44 flex-shrink=0 font-size=12 line-height="16px" color="light-dark(#27272acc, #f5f5f5cc)"
              text detail.text min-width=0 line-clamp=1 font-family="ui-monospace" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
      row margin-top=2 margin-left=19 gap=2 flex-wrap="wrap" align-items="center"
        when setup.terminal
          SetupButton(label="Open terminal", icon="terminal", expanded=false, press=local("setup-terminal", "", ""), testId="worktree-setup-open-terminal")
        SetupButton(label="Details", icon=(setup.detailsOpen ? "chevron-down" : "chevron-right"), expanded=setup.detailsOpen, press=local("setup-details", "", ""), testId="worktree-setup-details-toggle")
        when setup.cancel
          SetupButton(label="Cancel", icon="x", expanded=false, press=local("setup-cancel", "", ""), testId="worktree-setup-cancel")

// One stage: its glyph (a spinner while it runs, the label sweeping like a live tool), label and trailing text.
component SetupStageRow
  props
    label: string
    status: string
    trailing: string
    elapsed: string
  view
    row width="100%" min-height=24 padding-left=2 padding-right=2 padding-top=2 padding-bottom=2 box-sizing="border-box" gap=6 align-items="center" aria-label=`${label}, ${status}`
      when status == "running"
        row position="relative" flex=1 min-width=0 align-items="center"
          LiveActivity(label=label, icon="", failed=false, active=true, shimmer=true, iconLight="", iconDark="")
          box position="absolute" left=4 top=4 width=16 height=16 animation="tlSetupSpin 1s linear infinite" aria-hidden=true
            TimelineIcon(name="loader-circle", size=16, color="light-dark(#44444a, #818181)")
      else
        row flex=1 min-width=0 gap=6 align-items="center" opacity=(status == "pending" ? 0.4 : 1)
          row width=24 height=24 flex-shrink=0 align-items="center" justify-content="center"
            TimelineIcon(name=stageGlyph(status), size=16, color="light-dark(#44444a, #818181)")
          text label flex=1 min-width=0 line-clamp=1 font-size=14 line-height="22.75px" color=stageInk(status)
      when trailing != ""
        text trailing min-width=0 line-clamp=1 font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      when elapsed != ""
        text elapsed flex-shrink=0 font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"

// The card's xs ghost-muted actions: a 24pt button, 14pt glyph, 12pt label.
component SetupButton
  props
    label: string
    icon: string
    expanded: bool
    press: action
    testId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-expanded=expanded testId=testId height=24 padding-left=7 padding-right=7 box-sizing="border-box" border-radius=8 border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap=4
      TimelineIcon(name=icon, size=14, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
      text label font-size=12 font-weight=500 line-height="16px" color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
