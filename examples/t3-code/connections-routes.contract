use PvIconButton from "./providers-kit.contract"
use PvOutline from "./providers-kit.contract"
use CnTooltip from "./settings-b-kit.contract"
use FocusGuard from "./dialog-trap.contract"
use DialogOpenFocus from "./dialog-trap.contract"

// The routes of one saved environment (T3 Code 1e2ecbd975
// EnvironmentRoutesList.tsx, ConnectionsSettings.tsx SavedBackendListRow's route count
// and "Routes" menu item; MIT, see LICENSE-T3). connection-routes-ops.ts projects
// the rows. Pointer drops use native reorder; keyboard preview and announcements share
// one root-owned transaction because native grouped reorder exposes only its drop.

shape EnvRoute
  id: string
  label: string
  address: string
  inUse: bool
  removable: bool
  position: number
  first: bool
  last: bool
  learned: bool
  target: string

shape RouteKeyboard
  phase: string
  serial: number
  environmentId: string
  rowKey: string
  routeId: string
  label: string
  baseline: string[]
  position: number
  announcement: string

fn routeKeyboardIdle(): RouteKeyboard = RouteKeyboard(phase="", serial=0, environmentId="", rowKey="", routeId="", label="", baseline=[], position=0, announcement="")
fn routeGripId(environmentId: string, routeId: string): string = `environment-route-grip-${environmentId}-${routeId}`
fn routeKeyboardSame(move: RouteKeyboard, routes: EnvRoute[]): bool = move.baseline.join("\n") == routes.map((route) => route.id).join("\n")
fn routeKeyboardOrder(routes: EnvRoute[], id: string, position: number): EnvRoute[] = routes.filter((route) => route.id != id).slice(0, position).concat(routes.filter((route) => route.id == id)).concat(routes.filter((route) => route.id != id).slice(position))
fn routeKeyboardLive(move: RouteKeyboard, routes: EnvRoute[]): bool = routeKeyboardSame(move, routes) or (move.phase == "saving" and routes.map((route) => route.id).join("\n") == move.baseline.filter((id) => id != move.routeId).slice(0, move.position).concat([move.routeId]).concat(move.baseline.filter((id) => id != move.routeId).slice(move.position)).join("\n"))
fn routeKeyboardRows(routes: EnvRoute[], environmentId: string, rowKey: string, move: RouteKeyboard): EnvRoute[] = move.phase != "" and move.environmentId == environmentId and move.rowKey == rowKey and routeKeyboardLive(move, routes) ? routeKeyboardOrder(routes, move.routeId, move.position).map((route, index) => EnvRoute(route, position=index + 1, first=index == 0, last=index == routes.length - 1)) : routes
fn routeKeyboardCancel(move: RouteKeyboard): RouteKeyboard = move.phase == "" ? move : RouteKeyboard(move, phase="", serial=move.serial + 1, announcement=(move.phase == "saving" ? "" : `Canceled reordering ${move.label}. Showing saved route order.`))
fn routeKeyboardLift(move: RouteKeyboard, environmentId: string, rowKey: string, route: EnvRoute, routes: EnvRoute[]): RouteKeyboard = RouteKeyboard(phase="lifted", serial=move.serial + 1, environmentId=environmentId, rowKey=rowKey, routeId=route.id, label=route.label, baseline=routes.map((item) => item.id), position=routes.map((item) => item.id).indexOf(route.id), announcement=`Lifted ${route.label}, position ${route.position} of ${routes.length}. Use up and down arrows to move, Space to drop, Escape to cancel.`)
fn routeKeyboardStep(move: RouteKeyboard, position: number): RouteKeyboard = position == move.position ? move : RouteKeyboard(move, position=position, announcement=`Moved ${move.label} to position ${position + 1} of ${move.baseline.length}.`)
fn routeKeyboardDrop(move: RouteKeyboard): RouteKeyboard = move.position == move.baseline.indexOf(move.routeId) ? RouteKeyboard(move, phase="", announcement=`Dropped ${move.label} at position ${move.position + 1}. Order unchanged.`) : RouteKeyboard(move, phase="saving", announcement=`Saving ${move.label} at position ${move.position + 1}.`)
fn routeKeyboardHandles(move: RouteKeyboard, environmentId: string, routeId: string, k: string): bool = move.phase == "" ? (k == " " or k == "Space") : (move.environmentId == environmentId and move.routeId == routeId and [" ", "Space", "Enter", "Escape", "ArrowUp", "ArrowDown", "ArrowLeft", "ArrowRight"].includes(k))
fn routeKeyboardKey(move: RouteKeyboard, k: string, repeat: bool): RouteKeyboard = k == "Escape" ? routeKeyboardCancel(move) : k == "ArrowUp" ? routeKeyboardStep(move, max(0, move.position - 1)) : k == "ArrowDown" ? routeKeyboardStep(move, min(move.baseline.length - 1, move.position + 1)) : ((k == " " or k == "Space" or k == "Enter") and not repeat ? routeKeyboardDrop(move) : move)
fn routeKeyboardNext(move: RouteKeyboard, environmentId: string, rowKey: string, routeId: string, k: string, repeat: bool, routes: EnvRoute[], ready: bool, busy: bool): RouteKeyboard = k == "cancel" or (k == "blur" and move.environmentId == environmentId and move.routeId == routeId) ? routeKeyboardCancel(move) : not ready ? routeKeyboardCancel(move) : busy or move.phase == "saving" ? move : move.phase == "" ? ((k == " " or k == "Space") and not repeat ? (match first(routes.filter((route) => route.id == routeId)) { case some(route) => routeKeyboardLift(move, environmentId, rowKey, route, routes), case none => move }) : move) : move.environmentId != environmentId or move.rowKey != rowKey or move.routeId != routeId ? move : not routeKeyboardSame(move, routes) ? routeKeyboardCancel(move) : routeKeyboardKey(move, k, repeat)
// The first line is the existing drop command; the remaining IDs are its required saved baseline.
fn routeKeyboardValue(move: RouteKeyboard): string = `${move.routeId}>${match move.baseline.filter((id) => id != move.routeId).at(move.position) { case some(id) => id, case none => "" }}\n${move.baseline.join("\n")}`
fn routeKeyboardComplete(move: RouteKeyboard, request: number, message: string, owned: bool): RouteKeyboard = move.phase != "saving" or move.serial != request ? move : not owned ? routeKeyboardCancel(move) : RouteKeyboard(move, phase="", announcement=(message == "" ? `Dropped ${move.label} at position ${move.position + 1} of ${move.baseline.length}.` : `Reordering ${move.label} did not finish. Showing saved route order.`))

// Lucide glyphs this list draws (grip-vertical, route, x, plus, chevron-right).
component RtGlyph
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      if name == "grip"
        circle cx=9 cy=12 r=1
        circle cx=9 cy=5 r=1
        circle cx=9 cy=19 r=1
        circle cx=15 cy=12 r=1
        circle cx=15 cy=5 r=1
        circle cx=15 cy=19 r=1
      if name == "route"
        circle cx=6 cy=19 r=3
        path d="M9 19h8.5a3.5 3.5 0 0 0 0-7h-11a3.5 3.5 0 0 1 0-7H15"
        circle cx=18 cy=5 r=3
      if name == "x"
        path d="M18 6 6 18M6 6l12 12"
      if name == "plus"
        path d="M5 12h14M12 5v14"
      if name == "chevron-right"
        path d="m9 18 6-6-6-6"

// The route count after the row's status: "Routes" or "N routes", its chevron turning
// a quarter over 150 ms (none under reduced motion).
component RouteCount
  props
    label: string
    open: bool
    still: bool
    environmentId: string
    toggle: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    row gap="0.25rem" align-items="center" flex-shrink=0
      text "·" font-size="0.75rem" line-height="1rem" aria-hidden=true color="light-dark(#71717b, #818181)"
      button press=toggle hover=hover aria-expanded=open testId=`environment-routes-toggle-${environmentId}` display="flex" flex-direction="row" align-items="center" gap="0.125rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" flex-shrink=0
        text label font-size="0.75rem" line-height="1rem" white-space="nowrap" color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
        box display="flex" rotate=(open ? 90 : 0) transition=(still ? "none" : "rotate 150ms cubic-bezier(0.4, 0, 0.2, 1)") testId=`environment-routes-chevron-${environmentId}`
          RtGlyph(name="chevron-right", size=12, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

// The row menu's "Routes" / "Hide routes" item (RouteIcon).
component RouteMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    menuId: string
    itemId: string
    disabled: bool
    choose: action
  state lit = false
  action hover(over: bool)
    if over
      focus(itemId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=itemId press=choose popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role="menuitem" testId=itemId display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(disabled ? 0.64 : 1) background-color=(lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000") data-focus-stop=(disabled ? "" : "enabled")
      RtGlyph(name="route", size=16, color="light-dark(#27272a, #f5f5f5)")
      text label font-size="0.875rem" line-height="1.25rem" flex=1 min-width=0 white-space="nowrap" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"

// EnvironmentRoutesList: the ways this client reaches one machine, preferred first.
component EnvironmentRoutes
  inject
    routeKeyboard: RouteKeyboard
  props
    environmentId: string
    rowKey: string
    listLabel: string
    label: string
    routes: EnvRoute[]
    busy: bool
    op: action
    remove: action
    addRoute: action
  action dropRoute(key: string, before: option<string>)
    if not busy and routeKeyboard.phase == ""
      match before
        case some(next)
          op("environment-route-move", rowKey, `${key}>${next}`)
        case none
          op("environment-route-move", rowKey, `${key}>`)
  derive shownRoutes = routeKeyboardRows(routes, environmentId, rowKey, routeKeyboard)
  view
    column width="100%" margin-top="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #ffffff12)" testId=`environment-routes-${environmentId}`
      // appearance="none": the reference draws these rows as divs, not a platform table (LLP 1115.002 D5's opt-out).
      list appearance="none" id=`environment-routes-list-${environmentId}` virtualized=true reorderdrop=dropRoute max-height="15rem" width="100%" overflow-x="hidden" role="list" aria-label=listLabel
        for route in shownRoutes key=route.id
          RouteRow(route=route, listId=`environment-routes-list-${environmentId}`, environmentId=environmentId, rowKey=rowKey, busy=busy, remove=remove)
      row width="100%" box-sizing="border-box" padding="0.25rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7b3, #ffffff12)"
        button press=addRoute(environmentId, label) class=PvOutline disabled=busy id=`environment-route-add-${environmentId}` testId=`environment-route-add-${environmentId}` height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" border-width=0 border-radius="0.375rem" box-shadow="none" background-color="#00000000" data-focus-stop=(busy ? "" : "enabled")
          RtGlyph(name="plus", size=12, color="light-dark(#71717b, #818181)")
          text "Add route" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"

// SortableRouteRow: grip, label with "In use", the address (and "· found automatically"), remove.
component RouteRow
  inject
    routeKeyboard: RouteKeyboard
    routeKeyboardInput: action
  props
    route: EnvRoute
    listId: string
    environmentId: string
    rowKey: string
    busy: bool
    remove: action
  state tip = false
  action hover(over: bool)
    tip = over
  action gripKey(k: string, e: KeyboardEvent)
    if not e.ctrlKey and not e.altKey and not e.metaKey and routeKeyboardHandles(routeKeyboard, environmentId, route.id, k)
      preventDefault()
      stopPropagation()
      routeKeyboardInput(environmentId, rowKey, route.id, k, e.repeat)
      if not busy and (k == "ArrowUp" or k == "ArrowDown") and routeKeyboard.phase == "lifted" and routeKeyboard.environmentId == environmentId and routeKeyboard.routeId == route.id
        scrollIntoView(routeGripId(environmentId, route.id), block="nearest")
        focus(routeGripId(environmentId, route.id))
  derive saving = routeKeyboard.phase == "saving" and routeKeyboard.environmentId == environmentId and routeKeyboard.routeId == route.id
  view
    row width="100%" box-sizing="border-box" min-height="2.75rem" padding-left="0.25rem" padding-right="0.25rem" padding-top="0.375rem" padding-bottom="0.375rem" gap="0.5rem" align-items="center" border-bottom-style="solid" border-bottom-width=(route.last ? 0 : 1) border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#fcfcfc, #0a0a0a)" role="listitem" testId=`environment-route-${route.position}`
      button id=routeGripId(environmentId, route.id) tabindex=0 role="button" key=gripKey blur=routeKeyboardInput(environmentId, rowKey, route.id, "blur", false) reorderFor=(routeKeyboard.phase == "" ? listId : "") disabled=(busy and not saving) touch-action="none" aria-label=`Reorder ${route.label}, position ${route.position}` testId=`environment-route-grip-${route.position}` title="" appearance="none" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" align-items="center" justify-content="center" flex-shrink=0
        RtGlyph(name="grip", size=14, color="light-dark(#71717bb3, #818181b3)")
      column flex=1 min-width=0
        row gap="0.375rem" align-items="center"
          text route.label font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
          if route.inUse
            text "In use" font-size="0.625rem" line-height="0.875rem" padding-left="0.25rem" padding-right="0.25rem" border-radius="0.125rem" background-color="light-dark(#00a63e1f, #00c9501f)" color="light-dark(#008236, #05df72)" testId=`environment-route-in-use-${route.position}`
        if route.address != ""
          text route.address font-size="0.625rem" line-height="0.875rem" line-clamp=1 color="light-dark(#71717b, #818181)"
      if route.removable
        box position="relative" hover=hover
          button id=`environment-route-remove-${environmentId}-${route.id}` press=remove(route.target) class=PvIconButton width="1.5rem" height="1.5rem" aria-label=`Remove ${route.label} route` disabled=busy testId=`environment-route-remove-${route.position}` title="" data-focus-stop=(busy ? "" : "enabled")
            RtGlyph(name="x", size=12, color="light-dark(#71717b, #818181)")
          if tip
            CnTooltip(tip="Remove route", tipId=`environment-route-remove-tip-${route.position}`, above=28)

// requestConfirmDialog(`Remove <label> route?\n<address>`, destructive).
component RouteRemoveDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    route: EnvRoute
    busy: bool
    cancel: action
    confirm: action
  derive dialogTargets = ["route-remove-cancel", "route-remove-confirm"]
  view
    column class=RtOverlay testId="route-remove-overlay"
      column width="100%" max-width="28rem" box-sizing="border-box" padding="1.5rem" gap="1rem" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" role="alertdialog" aria-modal=true aria-label=`Remove ${route.label} route?` testId="route-remove-dialog" id="route-remove-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("route-remove-dialog") key=dialogFallback("route-remove-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract).
        FocusGuard(guardId="route-remove-guard-start", targets=dialogTargets, popup="route-remove-dialog")
        DialogOpenFocus(target="route-remove-cancel")
        column gap="0.5rem"
          text `Remove ${route.label} route?` font-size="1.125rem" line-height="1.5rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          if route.address != ""
            text route.address font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        row gap="0.5rem" justify-content="flex-end"
          button id="route-remove-cancel" press=cancel class=PvOutline aria-keyshortcuts="Escape" disabled=busy testId="route-remove-cancel" data-focus-stop=(busy ? "" : "enabled")
            text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          button id="route-remove-confirm" press=confirm class=PvOutline border-width=0 background-color="#e7000b" disabled=busy testId="route-remove-confirm" data-focus-stop=(busy ? "" : "enabled")
            text "Confirm" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
        FocusGuard(guardId="route-remove-guard-end", targets=dialogTargets, popup="route-remove-dialog")

style RtOverlay
  position="absolute" left=0 right=0 top=0 bottom=0
  display="flex" align-items="center" justify-content="center"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" padding="1rem" box-sizing="border-box" z-index=40
