// PullRequestDetailGhost (lane "pages"; pr-conversation-and-refresh), measured against T3 Code
// 1e2ecbd975 (MIT, see LICENSE-T3) components/pullRequest/PullRequestGhosts.tsx: the detail
// panel's loaded shape while the detail is out — the list row's identity and summary where the
// list has the pull request (`ghost.seeded`), bars for the rest, the tab bar inert with the
// panel's tab, the Reviewers and Labels rows and the Description's opening — so the loaded
// detail replaces placeholders in place instead of one layout with another. Without a seed the
// whole ghost breathes (animate-skeleton, off under reduced motion).
use noActOn from "./pages-pr-links.contract" // pr-links-previews-and-routing
use PgIcon from "./pages-icons.contract"
use PrAvatar from "./pages-prs.contract"
use PrChip from "./pages-prs.contract"
use PrHandoffsView from "./pages-pr-handoffs.contract"
use PrdCheckoutMenu from "./pages-pr-handoffs.contract"

shape PrGhost
  seeded: bool
  conflicting: bool
  title: string
  repository: string
  url: string
  state: string
  author: string
  avatar: string
  initial: string
  updated: string
  baseBranch: string
  headBranch: string
  files: string
  additions: string
  deletions: string
  checksLabel: string
  checksTone: string
  labelsKnown: bool
  labels: list<PrChip>

fn pgBar(): string = "light-dark(#71717b26, #81818126)"
fn pgMuted(): string = "light-dark(#71717b, #818181)"
fn pgGhostTone(state: string): string = state == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : state == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : state == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"

keyframes pgPulse
  from opacity=1
  42% opacity=1
  50% opacity=0.55
  92% opacity=0.55
  to opacity=1

component PrdGhost
  props
    ghost: PrGhost
    number: number
    checkout: string
    tab: string
    still: bool
    // pr-handoffs-and-quick-actions: with the list's row in hand (handoffSummary), the header's Check out (the page's) and
    // Resolve conflicts take the actions' place before the detail lands.
    handoffs: PrHandoffsView
    surface: string
    narrow: bool
    scheme: string
    act: action
  view
    column flex=1 min-height=0 width="100%" overflow="hidden" role="status" aria-label="Loading pull request" animation=((still or ghost.seeded) ? "none" : "pgPulse 2.4s steps(4) infinite") testId="pull-request-loading"
      column width="100%" padding-left="1rem" padding-right="1rem" padding-bottom="1rem" box-sizing="border-box" flex-shrink=0
        row height="1.75rem" width="100%" align-items="center" gap="0.25rem"
          row min-width=0 flex=1 align-items="center" gap="0.25rem"
            when ghost.seeded
              text ghost.repository font-size="0.75rem" line-height="1rem" font-weight=500 color=pgMuted() line-clamp=1 min-width=0
              link cursor="pointer" href=ghost.url aria-label=`Open pull request #${number} on host` testId="pull-request-ghost-open-host" display="flex" flex-direction="row" align-items="center" gap="0.125rem" flex-shrink=0
                text `#${number}` font-size="0.75rem" line-height="1rem" font-weight=500 color=pgGhostTone(ghost.state)
                PgIcon(name="external-link", size=10, color=pgGhostTone(ghost.state))
            else
              box width="6rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
              text `#${number}` font-size="0.75rem" line-height="1rem" color=pgMuted() flex-shrink=0
          when ghost.seeded
            when surface == "page" or not handoffs.threadOwn
              PrdCheckoutMenu(handoffs=handoffs, surface=surface, scheme=scheme, narrow=narrow, act=act, actOn=noActOn())
            when ghost.conflicting
              button press=act("handoff", `${surface}|conflicts`) disabled=(handoffs.pending != "" or (surface != "thread" and not handoffs.canCheckout)) aria-label=(handoffs.pending == "conflicts" ? "Preparing..." : "Resolve conflicts") testId="pull-request-ghost-resolve" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" opacity=(handoffs.pending != "" ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
                PgIcon(name="triangle-alert", size=14, color="light-dark(#e40014, #ff6467)")
                when not narrow
                  text (handoffs.pending == "conflicts" ? "Preparing..." : "Resolve conflicts") font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color="light-dark(#e40014, #ff6467)"
          else
            box width="4rem" height="1.5rem" border-radius="0.375rem" background-color=pgBar() flex-shrink=0
          row width="1.5rem" height="1.5rem" align-items="center" justify-content="center" opacity=0.64 aria-label="Pull request actions loading" flex-shrink=0
            PgIcon(name="ellipsis", size=16, color=pgMuted())
        row width="100%" min-height="1.5rem" margin-top="0.25rem" align-items="center"
          when ghost.seeded
            text ghost.title font-size="1rem" line-height="1.375rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=1 flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
          else
            box width="80%" max-width="28rem" height="1.25rem" border-radius="0.25rem" background-color=pgBar()
        row width="100%" min-height="1.25rem" margin-top="0.5rem" align-items="center" gap="0.375rem"
          when ghost.seeded
            PrAvatar(avatar=ghost.avatar, initial=ghost.initial, size=16)
            text ghost.author font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 flex-shrink=1 min-width=0
            text "·" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b80, #81818180)" flex-shrink=0
            text ghost.updated font-size="0.75rem" line-height="1rem" color=pgMuted() white-space="nowrap" flex-shrink=0
          else
            box width="1rem" height="1rem" border-radius="624.9375rem" background-color=pgBar() flex-shrink=0
            box width="3.5rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
            text "·" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b80, #81818180)" flex-shrink=0
            box width="4rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
          box flex=1 min-width=0
          when checkout != ""
            text checkout padding-left="0.25rem" padding-right="0.25rem" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=pgMuted() white-space="nowrap" flex-shrink=0
        row width="100%" min-height="1.25rem" margin-top="1rem" align-items="center" gap="0.5rem"
          row flex=1 min-width=0 align-items="center" gap="0.375rem"
            when ghost.seeded
              text ghost.baseBranch font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)" white-space="nowrap" flex-shrink=0
            else
              box width="3rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar() flex-shrink=0
            box width="0.875rem" height="0.875rem" aria-label="receives changes from" flex-shrink=0 opacity=0.6
              PgIcon(name="arrow-left", size=14, color="light-dark(#71717bb3, #828282b3)")
            when ghost.seeded
              text ghost.headBranch padding-left="0.25rem" padding-right="0.25rem" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)" line-clamp=1 min-width=0
            else
              box flex=1 width="8rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
          row flex-shrink=0 align-items="center" gap="0.5rem"
            row min-width="4rem" justify-content="flex-end" align-items="center" gap="0.375rem"
              PgIcon(name="file-diff", size=14, color=pgMuted())
              box width="2.5rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
            when ghost.seeded and ghost.additions != ""
              row align-items="baseline" gap="0.25rem"
                text ghost.additions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#009966, #00d492)"
                text ghost.deletions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)"
            when not ghost.seeded
              box width="5rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
      row width="100%" padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-top-width=1 border-bottom-width=1 border-top-style="solid" border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" align-items="center" gap="0.5rem" role="navigation" aria-label="Pull request tabs" inert=true flex-shrink=0
        row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center"
          PrdGhostTab(label="Summary", active=(tab != "timeline"))
          PrdGhostTab(label="Timeline", active=(tab == "timeline"))
        box flex=1 min-width=0
        when ghost.checksLabel != ""
          row align-items="center" gap="0.375rem" flex-shrink=0
            PgIcon(name=(ghost.checksTone == "failing" ? "circle-x" : "circle-dot"), size=14, color=(ghost.checksTone == "failing" ? "light-dark(#e40014, #fb414a)" : "light-dark(#e17100, #ffb900e6)"))
            text ghost.checksLabel font-size="0.75rem" line-height="1rem" color=(ghost.checksTone == "failing" ? "light-dark(#e40014, #fb414a)" : "light-dark(#e17100, #ffb900e6)") white-space="nowrap"
        else
          box width="8rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar() flex-shrink=0
      column width="100%" padding-left="1rem" padding-right="1rem" padding-top="0.625rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem"
        row min-height="1.5rem" align-items="center" gap="0.5rem"
          row width="6rem" align-items="center" gap="0.375rem" flex-shrink=0
            PgIcon(name="users", size=14, color=pgMuted())
            text "Reviewers" font-size="0.75rem" line-height="1rem" color=pgMuted()
          box width="2.5rem" height="0.75rem" border-radius="0.25rem" background-color=pgBar()
        row min-height="1.5rem" align-items="center" gap="0.5rem"
          row width="6rem" align-items="center" gap="0.375rem" flex-shrink=0
            PgIcon(name="tag", size=14, color=pgMuted())
            text "Labels" font-size="0.75rem" line-height="1rem" color=pgMuted()
          row flex-wrap="wrap" align-items="center" gap="0.25rem" min-width=0
            when ghost.labelsKnown and length(ghost.labels) > 0
              each chip in ghost.labels key=chip.key
                text chip.name max-width="12rem" line-clamp=1 height="1.125rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="0.25rem" background-color=chip.background font-size="0.75rem" line-height="1.125rem" font-weight=500 color=chip.ink
            when ghost.labelsKnown and length(ghost.labels) == 0
              text "None" font-size="0.75rem" line-height="1rem" color=pgMuted()
            when not ghost.labelsKnown
              box width="6rem" height="1.125rem" border-radius="0.25rem" background-color=pgBar()
              box width="5rem" height="1.125rem" border-radius="0.25rem" background-color=pgBar()
      row width="100%" height="2.5rem" padding-left="1rem" padding-right="1rem" box-sizing="border-box" gap="0.375rem" align-items="center"
        text "Description" font-size="0.75rem" line-height="1rem" font-weight=500 color=pgMuted()
        PgIcon(name="chevron-down", size=14, color="light-dark(#71717b99, #80808099)")
      column width="100%" padding-left="1rem" padding-right="1rem" padding-bottom="1rem" box-sizing="border-box" gap="0.75rem"
        box width="10rem" height="1.25rem" border-radius="0.25rem" background-color=pgBar()
        column width="100%" gap="0.5rem"
          box width="100%" height="1rem" border-radius="0.25rem" background-color=pgBar()
          box width="92%" height="1rem" border-radius="0.25rem" background-color=pgBar()
          box width="80%" height="1rem" border-radius="0.25rem" background-color=pgBar()
          box width="66%" height="1rem" border-radius="0.25rem" background-color=pgBar()

component PrdGhostTab
  props
    label: string
    active: bool
  view
    row height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" background-color=(active ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(active ? "0 1px 2px #0000001a" : "none") align-items="center" justify-content="center"
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
