// Integrations → Device hosts (lane settings-a; settings-a-hosts.ts): the row with
// its host list (DeviceHostsSettings.tsx) and the Add/Edit device host dialog
// (DeviceHostEditor.tsx), mounted at the window root by SettingsADialogs.
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use LucidePlus from "./settings-icons.contract"
use LucideEllipsisVertical from "./settings-icons.contract"
use LucideCheck from "./settings-icons.contract"
use LucideX from "./settings-icons.contract"
use LucideLaptop from "./settings-icons.contract"
use LucideChevronRight from "./settings-icons.contract"
use KmItem from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"

shape HostPlatform
  id: string
  label: string
shape HostToolLine
  id: string
  name: string
  running: string
  required: string
  installed: string
shape HostRow
  id: string
  label: string
  target: string
  platforms: list<HostPlatform>
  versions: string
  tools: list<HostToolLine>
  toolsKnown: bool
  owner: string
  toolError: string
  local: bool
  error: string
  progress: string
  retry: bool
  retrying: bool
  menuId: string
shape DeviceHostsView
  available: bool
  canAdd: bool
  message: string
  environmentLabel: string
  hosts: list<HostRow>
shape HostCheckRow
  id: string
  label: string
  status: string
  platforms: string
  error: string
shape HostCheckGroup
  key: string
  checking: bool
  summary: string
  results: list<HostCheckRow>
shape HostEditorView
  open: bool
  title: string
  description: string
  serial: string
  id: string
  label: string
  target: string
  identityFile: string
  port: string
  optionsOpen: bool
  checkKey: string
  checking: bool
  checked: bool
  summary: string
  results: list<HostCheckRow>

component AppleGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
component AndroidGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="m8 3-1-2m9 2 1-2" fill="none" stroke="currentColor" stroke-width=1.4 stroke-linecap="round"
      path d="M5 10a7 7 0 0 1 14 0H5Zm4-4a.8.8 0 1 0 0 1.6A.8.8 0 0 0 9 6Zm6 0a.8.8 0 1 0 0 1.6A.8.8 0 0 0 15 6Z" fill-rule="evenodd"
      path d="M5 11h14v7a2 2 0 0 1-2 2v2a1.5 1.5 0 0 1-3 0v-2h-4v2a1.5 1.5 0 0 1-3 0v-2a2 2 0 0 1-2-2v-7Z"
      rect x=1 y=11 width=3 height=8 rx=1.5
      rect x=20 y=11 width=3 height=8 rx=1.5

// Button size sm variant outline.
component HostButton
  props
    label: string
    disabled: bool
    press: action
    buttonId: string
    plus: bool
  view
    button press=press disabled=disabled testId=buttonId display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" flex-shrink=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow=(disabled ? "none" : "0 1px 2px #0000000d") opacity=(disabled ? 0.64 : 1)
      when plus
        LucidePlus(size=14, color="light-dark(#71717b, #818181)")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"

// SettingsRow over `deviceHosts` (its inheritance button is the slot), with the host list as its children.
component DeviceHostsRow
  props
    view: DeviceHostsView
    busy: bool
    rest: action
  slot
  view
    column width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.25rem" padding-left="1rem" padding-right="1rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" testId="device-row-device-hosts"
      row width="100%" gap="2rem" align-items="center"
        column flex=1 min-width=0 gap="0.25rem"
          row min-height="1.25rem" align-items="center" gap="0.375rem"
            text "Device hosts" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            children
            box width="1.25rem" height="1.25rem"
          text "Add remote machines with simulator or emulator runtimes installed, and the selected environments will connect over SSH and set up device tools automatically." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" max-width="36rem"
        row flex-shrink=0 min-width="10rem" justify-content="flex-end"
          HostButton(label="Add host", disabled=(busy or not view.canAdd), press=rest("hosts-open", ""), buttonId="device-hosts-add", plus=true)
      column width="100%" padding-top="0.75rem" padding-bottom="0.5rem" box-sizing="border-box"
        when not view.available
          text view.message font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        else
          when length(view.hosts) == 0
            text "No device hosts." font-size="0.875rem" line-height="1.25rem" padding-top="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717b, #818181)" testId="device-hosts-empty"
          each host in view.hosts key=host.id
            HostRowView(host=host, busy=(busy or not view.canAdd), rest=rest)

component HostRowView
  props
    host: HostRow
    busy: bool
    rest: action
  state showError = false
  action toggleError
    showError = not showError
  // fix-keyboard-focus: Enter or Space opens the menu from the keyboard (menu-keys.contract).
  state keyed = 0
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = keyed + 1
  view
    row width="100%" gap="0.5rem" align-items="center" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)" testId=`device-host-${host.id}`
      column flex=1 min-width=0 gap="0.125rem"
        row min-width=0 gap="0.5rem" align-items="center"
          text host.label font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
          each platform in host.platforms key=platform.id
            box aria-label=platform.label role="img" flex-shrink=0
              when platform.id == "ios"
                AppleGlyph(size=14, color="light-dark(#71717b, #818181)")
              else
                AndroidGlyph(size=14, color="light-dark(#71717b, #818181)")
        text host.target font-size="0.75rem" line-height="1rem" line-clamp=1 color="light-dark(#71717b, #818181)"
        // DeviceToolVersions without a kind: "Versions" opens both tools' versions.
        box position="relative" align-self="flex-start"
          button popovertarget=`device-host-tools-${host.id}` aria-label=`${host.label} device tools` testId=`device-host-versions-${host.id}` padding=0 border-width=0 background-color="#00000000"
            text host.versions font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"
          column id=`device-host-tools-${host.id}` popover="auto" position="absolute" margin-top="0.25rem" width="20rem" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #181818)" box-shadow="0 8px 24px #00000026" role="dialog" aria-label="Device tools"
            text "Device tools" font-size="0.875rem" font-weight=600 line-height="0.875rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
            when host.toolsKnown
              column margin-top="1rem"
                each tool in host.tools key=tool.id
                  column gap="0.5rem" padding-top=(tool.id == "hub" ? "0px" : "0.75rem") padding-bottom=(tool.id == "hub" ? "0.75rem" : "0px") border-bottom-width=(tool.id == "hub" ? 1 : 0) border-bottom-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)"
                    text tool.name font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
                    HostToolPair(term="Running", value=tool.running)
                    HostToolPair(term="Required", value=tool.required)
                    HostToolPair(term="Installed", value=tool.installed)
            else
              text "Versions have not been checked." font-size="0.75rem" line-height="1rem" margin-top="0.75rem" color="light-dark(#71717b, #818181)"
            text `Managed by ${host.owner}. Tools update automatically on this host when needed.` font-size="0.75rem" line-height="1rem" margin-top="1rem" padding-top="0.75rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)" color="light-dark(#71717b, #818181)"
            when host.toolError != ""
              text host.toolError role="status" font-size="0.75rem" line-height="1rem" margin-top="0.5rem" color="light-dark(#dc2626, #f87171)"
        when host.local
          text "Already available locally" font-size="0.75rem" line-height="1rem" margin-top="0.25rem" color="light-dark(#71717b, #818181)"
        when host.error != ""
          column margin-top="0.25rem" gap="0.25rem" role="status"
            button press=toggleError aria-expanded=showError testId=`device-host-error-${host.id}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" align-self="flex-start"
              box transform=(showError ? "rotate(90deg)" : "none")
                LucideChevronRight(size=12, color="light-dark(#dc2626, #f87171)")
              text "Connection failed" font-size="0.75rem" line-height="1rem" color="light-dark(#dc2626, #f87171)"
            when showError
              text host.error font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#dc2626, #f87171)"
      when host.progress != ""
        text host.progress role="status" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId=`device-host-progress-${host.id}`
      box position="relative" flex-shrink=0
        button popovertarget=host.menuId key=triggerKey disabled=busy aria-label=`${host.label} options` testId=`device-host-options-${host.id}` width="1.75rem" height="1.75rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" opacity=(busy ? 0.64 : 1)
          LucideEllipsisVertical(size=16, color="light-dark(#71717b, #818181)")
        SkPopup(menuId=host.menuId, label=`${host.label} options`, width=160, list=false, endAlign=28, items=[KmItem(id=`device-host-edit-${host.id}`, label="Edit"), KmItem(id=`device-host-remove-${host.id}`, label="Remove")], keyed=keyed)
          SkMenuItem(label="Edit", menuId=host.menuId, itemId=`device-host-edit-${host.id}`, selected=false, check=false, destructive=false, disabled=false, choose=rest("hosts-edit", `id=${host.id}`))
          SkMenuItem(label="Remove", menuId=host.menuId, itemId=`device-host-remove-${host.id}`, selected=false, check=false, destructive=true, disabled=false, choose=rest("hosts-remove", `id=${host.id}`))
      when host.retry
        HostButton(label=(host.retrying ? "Retrying…" : "Retry"), disabled=(busy or host.retrying), press=rest("hosts-retry", `id=${host.id}`), buttonId=`device-host-retry-${host.id}`, plus=false)
      else
        HostButton(label="Test connection", disabled=(busy or host.progress != ""), press=rest("hosts-test-row", `id=${host.id}`), buttonId=`device-host-test-${host.id}`, plus=false)

component HostToolPair
  props
    term: string
    value: string
  view
    row width="100%" justify-content="space-between" gap="1.5rem"
      text term font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      text value font-family="ui-monospace" font-size="0.75rem" line-height="1rem" text-align="right" color="light-dark(#27272a, #f5f5f5)"

// DeviceHostEditor: Name, SSH target, the SSH options disclosure and the connection
// check panel; Cancel / Save host. The draft lives here; the server checks it.
component DeviceHostDialog
  props
    editor: HostEditorView
    checks: list<HostCheckGroup>
    busy: bool
    error: string
    rest: action
  // Each field shows the edited host until it is typed into (state cannot start from a prop here).
  state labelDraft = ""
  state labelEdited = false
  state targetDraft = ""
  state targetEdited = false
  state identityDraft = ""
  state identityEdited = false
  state portDraft = ""
  state portEdited = false
  state optionsFlipped = false
  action editLabel(next: string)
    labelDraft = next
    labelEdited = true
  action editTarget(next: string)
    targetDraft = next
    targetEdited = true
  action editIdentity(next: string)
    identityDraft = next
    identityEdited = true
  action editPort(next: string)
    portDraft = next
    portEdited = true
  action toggleOptions
    optionsFlipped = not optionsFlipped
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" z-index=30 testId="device-host-dialog-overlay"
      column position="relative" width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label=editor.title testId="device-host-dialog"
        column padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" gap="0.5rem"
          text editor.title font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text editor.description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        column padding-top="0.25rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1.5rem" gap="1rem" box-sizing="border-box"
          HostField(label="Name", grow=true)
            input value=(labelEdited ? labelDraft : editor.label) input=editLabel placeholder="Mac mini" disabled=busy aria-label="Name" spellcheck="false" autocorrect="off" testId="device-host-name" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#27272a, #f5f5f5)"
          HostField(label="SSH target", grow=true)
            input value=(targetEdited ? targetDraft : editor.target) input=editTarget placeholder="user@host or SSH alias" disabled=busy aria-label="SSH target" spellcheck="false" autocorrect="off" testId="device-host-target" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#27272a, #f5f5f5)"
          column gap="0.75rem"
            button press=toggleOptions aria-expanded=(optionsFlipped != editor.optionsOpen) testId="device-host-options" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" align-self="flex-start"
              box transform=((optionsFlipped != editor.optionsOpen) ? "rotate(90deg)" : "none")
                LucideChevronRight(size=14, color="light-dark(#71717b, #818181)")
              text "SSH options" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
            when optionsFlipped != editor.optionsOpen
              row width="100%" gap="0.75rem"
                HostField(label="Identity file", grow=true)
                  input value=(identityEdited ? identityDraft : editor.identityFile) input=editIdentity placeholder="SSH config default" disabled=busy aria-label="Identity file" spellcheck="false" autocorrect="off" testId="device-host-identity" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#27272a, #f5f5f5)"
                HostField(label="Port", grow=false)
                  input value=(portEdited ? portDraft : editor.port) input=editPort placeholder="Default" disabled=busy aria-label="Port" spellcheck="false" autocorrect="off" testId="device-host-port" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#27272a, #f5f5f5)"
              text "Optional. Resolved separately on each environment." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          HostCheckPanel(checks=checks, checkKey=`${trim((targetEdited ? targetDraft : editor.target))}|${trim((portEdited ? portDraft : editor.port))}|${trim((identityEdited ? identityDraft : editor.identityFile))}`, busy=busy, valid=(trim((targetEdited ? targetDraft : editor.target)) != "" and not startsWith(trim((targetEdited ? targetDraft : editor.target)), "-") and not includes(trim((targetEdited ? targetDraft : editor.target)), " ")), test=rest("hosts-test", `id=${editor.id}&label=${encodeURIComponent((labelEdited ? labelDraft : editor.label))}&target=${encodeURIComponent((targetEdited ? targetDraft : editor.target))}&identityFile=${encodeURIComponent((identityEdited ? identityDraft : editor.identityFile))}&port=${encodeURIComponent((portEdited ? portDraft : editor.port))}`))
          when error != ""
            text error role="alert" font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)" testId="device-host-error"
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button press=rest("hosts-close", "") disabled=busy aria-keyshortcuts="Escape" testId="device-host-cancel" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button press=rest("hosts-save", `id=${editor.id}&label=${encodeURIComponent((labelEdited ? labelDraft : editor.label))}&target=${encodeURIComponent((targetEdited ? targetDraft : editor.target))}&identityFile=${encodeURIComponent((identityEdited ? identityDraft : editor.identityFile))}&port=${encodeURIComponent((portEdited ? portDraft : editor.port))}`) disabled=(busy or trim((labelEdited ? labelDraft : editor.label)) == "" or trim((targetEdited ? targetDraft : editor.target)) == "") testId="device-host-save" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" display="flex" flex-direction="row" align-items="center" opacity=(busy or trim((labelEdited ? labelDraft : editor.label)) == "" or trim((targetEdited ? targetDraft : editor.target)) == "" ? 0.64 : 1)
            text "Save host" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        button press=rest("hosts-close", "") disabled=busy aria-label="Close" position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" testId="device-host-close"
          LucideX(size=16, color="light-dark(#71717b, #818181)")

component HostField
  props
    label: string
    grow: bool
  slot
  view
    column flex=(grow ? 1 : 0) width=(grow ? "auto" : "7rem") min-width=0 gap="0.375rem"
      text label font-size="0.875rem" line-height="1.0625rem" color="light-dark(#27272a, #f5f5f5)"
      row width="100%" height="2rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow="0 1px 2px #0000000a" align-items="center" padding-left="0.6875rem" padding-right="0.6875rem"
        children

// The connection check panel: its status line and Test connection, then each environment's result.
component HostCheckPanel
  props
    checks: list<HostCheckGroup>
    checkKey: string
    busy: bool
    valid: bool
    test: action
  view
    column width="100%" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" box-sizing="border-box" testId="device-host-checks"
      row width="100%" align-items="center" justify-content="space-between" gap="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box"
        text (length(filter(checks, (group) => group.key == checkKey)) == 0 ? "Check access before saving" : join(map(filter(checks, (group) => group.key == checkKey), (group) => group.summary), "")) role="status" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="device-host-check-status"
        HostButton(label="Test connection", disabled=(busy or not valid or length(filter(checks, (group) => group.key == checkKey and group.checking)) > 0), press=test, buttonId="device-host-test", plus=false)
      each group in checks key=group.key
        when group.key == checkKey
          each result in group.results key=result.id
            column width="100%" gap="0.375rem" padding-top="0.625rem" padding-bottom="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
              row width="100%" justify-content="space-between" align-items="center" gap="0.75rem"
                text result.label font-size="0.75rem" font-weight=500 line-height="1rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
                row gap="0.375rem" align-items="center" flex-shrink=0
                  when result.status == "Already available locally"
                    LucideLaptop(size=12, color="light-dark(#71717b, #818181)")
                  when result.status == "Failed"
                    LucideX(size=12, color="light-dark(#dc2626, #f87171)")
                  when result.status == "Connected"
                    LucideCheck(size=12, color="light-dark(#71717b, #818181)")
                  text result.status font-size="0.75rem" line-height="1rem" color=(result.status == "Failed" ? "light-dark(#dc2626, #f87171)" : "light-dark(#71717b, #818181)")
              when result.platforms != ""
                text result.platforms font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              when result.error != ""
                HostCheckError(error=result.error)

// The failed check's <details>: "Show error", then the error itself.
component HostCheckError
  props
    error: string
  state open = false
  action toggle
    open = not open
  view
    column width="100%" gap="0.25rem"
      button press=toggle aria-expanded=open testId="device-host-check-error" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" align-self="flex-start"
        box transform=(open ? "rotate(90deg)" : "none")
          LucideChevronRight(size=12, color="light-dark(#71717b, #818181)")
        text "Show error" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      when open
        text error font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#71717b, #818181)"
