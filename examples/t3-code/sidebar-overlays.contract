// The sidebar's window-level layers, mounted at the root after every scroll
// container so they paint and hit-test above the page (MIT reference, see
// LICENSE-T3): the "Filter threads by project" combobox popup anchored under
// the search field, the Archive/Delete/Unpin confirmations
// (ConfirmDialogHost) and the custom snooze dialog (CustomSnoozeDialog.tsx).
use Snapshot from "./shapes.contract"
use ProviderMark from "./icons.contract"
use SidebarIcon from "./sidebar-icons.contract"
use SidebarProjectGlyph from "./sidebar-icons.contract"
use TipCard from "./shell-tip.contract"
use SettingsConfirm from "./settings-rest-dialogs.contract"
use Thread from "./sidebar-shapes.contract"
use SidebarProviderMark from "./icons.contract"
use SidebarDropVerb from "./sidebar-row.contract"
use ShellView from "./shell-shapes.contract"
use SidebarEdgeTips from "./r4-polish-tip.contract"
use SidebarWindowRail from "./r5-shell.contract"
use R6TextProbes from "./r6-polish.contract"
use LegacyDialogs from "./legacy-sidebar.contract"

component SidebarOverlays
  props
    data: Snapshot
    width: number
    open: bool
    busy: bool
    local: action
    run: action
    hoverId: string
    hoverLast: string
    hoverY: number
    dragId: string
    dragTarget: string
    dragVerb: string
    ghostX: number
    ghostY: number
    shell: ShellView
    pullRequests: bool
    viewportHeight: number
    hoverH: number
    resize: action
    finishResize: action
    resetWidth: action
    hoverCard: action
  // The card stays mounted for the last hovered row (else the open one), so
  // its 150 ms open delay has a starting opacity; moving straight to another
  // row swaps it at once, as the reference's tooltip group does.
  // A row's controls hover `${key}#control`: the card stays mounted for its row, and
  // closes while a control's own tooltip is up (one tooltip at a time, as the reference's group).
  derive hovered = filter(data.threads, (t) => hoverLast == "" ? t.id == data.threadId : t.hoverKey == hoverLast or startsWith(hoverLast, `${t.hoverKey}#`))
  view
    // r5-shell: the 16pt full-height resize rail over the sidebar's edge (r5-shell.contract).
    when open
      SidebarWindowRail(width=width, hovered=(hoverId == "sidebar-rail"), line=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #262626)"), fill=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #1d1d1d)"), resize=resize, finishResize=finishResize, resetWidth=resetWidth, hoverCard=hoverCard)
    // The lifted row rides above every shelf (the list keeps its empty slot).
    when dragId != "" and dragTarget != "context"
      each t in data.threads key=t.id
        when t.id == dragId
          SidebarLiftedCard(t=t, x=8, y=(ghostY - (t.card ? 39 : 18)), width=(width - 16), verb=dragVerb)
    when dragId != "" and dragTarget == "context"
      each t in data.threads key=t.id
        when t.id == dragId
          SidebarDragGhost(t=t, x=ghostX, y=ghostY, count=(t.multi ? data.sidebar.selectionCount : 1))
    when open and not data.sidebar.scopeOpen and dragId == ""
      each t in hovered key="hover-card"
        SidebarPlacedHoverCard(t=t, x=(width - 5), top=hoverY, height=hoverH, viewportHeight=viewportHeight, shown=(hoverId == t.hoverKey and not t.renaming))
        // The hovered control's TooltipPopup (side top, centered, 4pt off), outside the list's scroll view.
        each tip in t.tips key=tip.name
          SidebarControlTip(label=tip.label, x=(tip.fromRight ? width - tip.x : tip.x), y=(hoverY + tip.top), start=tip.start, shown=(hoverId == `${t.hoverKey}#${tip.name}`))
      each d in data.sidebar.drafts key=d.id
        SidebarControlTip(label="Discard draft", x=(width - 28), y=(hoverY + 15), start=false, shown=(hoverId == `draft:${d.id}#discard`))
    // r6-polish: the row tooltips' texts, measured (r3-sidebar-tips.ts).
    when open
      R6TextProbes(probes=data.sidebar.probes)
    // r4-polish: the sidebar chrome's tooltips (rail, search row, footer), above the page.
    when open and dragId == ""
      SidebarEdgeTips(width=width, hoverId=hoverId, newThread=`New thread${shell.keyNewThread == "" ? "" : ` (${shell.keyNewThread})`}`, newThreadDetail=(data.sidebar.projectGroupCount > 1 ? `New thread in current project: Shift+click${shell.keyNewThreadLocal == "" ? "" : ` (${shell.keyNewThreadLocal})`}` : ""), pullRequests=pullRequests)
    when open and data.sidebar.scopeOpen
      button press=local("scope-open", "", "close") position="absolute" left=0 top=0 width="100%" height="100%" z-index=30 background-color="#00000000" border-width=0 aria-label="Close project filter" testId="scope-backdrop"
      SidebarScopeMenu(data=data, width=width, local=local, run=run)
    when data.sidebar.dialog == "archive" or data.sidebar.dialog == "unpin"
      SettingsConfirm(title=data.sidebar.dialogTitle, description=data.sidebar.dialogDescription, confirmLabel="Confirm", destructive=false, busy=busy, error="", dialogId=`sidebar-${data.sidebar.dialog}`, cancel=local("dialog-close", "", ""), confirm=run("dialog-confirm", "", ""))
    when data.sidebar.dialog == "delete" or data.sidebar.dialog == "delete-many"
      SettingsConfirm(title=data.sidebar.dialogTitle, description=data.sidebar.dialogDescription, confirmLabel="Confirm", destructive=true, busy=busy, error="", dialogId=`sidebar-${data.sidebar.dialog}`, cancel=local("dialog-close", "", ""), confirm=run("dialog-confirm", "", ""))
    when data.sidebar.dialog == "snooze"
      SidebarSnoozeDialog(data=data, busy=busy, local=local, run=run)
    // legacy-sidebar: Rename project, Project grouping and the removal / archive confirms.
    LegacyDialogs(data=data, busy=busy, local=local, run=run)

// ComboboxPopup under the search field (align start, 4pt gap), at least as
// wide as the field and growing to fit names up to 18rem: the search row,
// "All projects", then each project with its settings button.
component SidebarScopeMenu
  props
    data: Snapshot
    width: number
    local: action
    run: action
  view
    column position="absolute" left=8 top=96 z-index=31 min-width=(width - 104) max-width=288 max-height=368 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" backdrop-filter="blur(16px)" box-shadow="0 17px 42px -18px light-dark(#0000008c, #000000cc)" overflow="hidden" role="dialog" testId="scope-menu"
      column padding-left=12 padding-right=12 padding-top=10 box-sizing="border-box"
        row height=33 padding-bottom=6 box-sizing="border-box" align-items="flex-start" position="relative" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#1b4ed8, #346bf1)"
          box position="absolute" left=0 top=6 width=16 height=16 pointer-events="none"
            SidebarIcon(name="search", size=16, color="light-dark(#71717b8c, #8181818c)")
          input value=data.sidebar.scopeQuery input=local("scope-query", "") key=local("scope-key", "") submit=local("scope", "", data.sidebar.scopeFirst) autofocus=true placeholder="Search projects..." aria-label="Search projects" role="combobox" testId="scope-search" flex=1 width=0 min-width=0 height=26 padding-left=20 padding-right=9 padding-top=0 padding-bottom=0 box-sizing="border-box" border-width=0 background-color="#00000000" font-size=14 color="light-dark(#27272a, #f3f3f3)"
      when length(data.sidebar.scopes) == 0
        text "No matching projects." font-size=14 line-height="20px" text-align="center" padding=8 color="light-dark(#71717b, #818181)"
      scroll flex-shrink=1 min-height=0 max-height=320
        column padding=4 box-sizing="border-box" role="listbox"
          each scope in data.sidebar.scopes key=scope.key
            button press=local("scope", "", scope.key) role="option" aria-selected=scope.selected aria-label=scope.label testId=`scope-${scope.all ? "all" : scope.label}` width="100%" min-height=(scope.all ? 28 : 32) padding-left=8 padding-right=8 box-sizing="border-box" border-radius=6 border-width=0 gap=8 display="flex" flex-direction="row" align-items="center" background-color=(scope.selected ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              when scope.all
                SidebarIcon(name="folder", size=16, color="light-dark(#71717b, #818181)")
              else
                SidebarProjectGlyph(g=scope.glyph, size=16, dim=false)
              text scope.label flex=1 min-width=0 line-clamp=1 white-space="nowrap" font-size=14 line-height="20px" color="light-dark(#27272a, #f3f3f3)" text-align="left"
              when not scope.all
                button press=run("project-settings-group", "", scope.key) aria-label=`Project settings for ${scope.label}` title=`Project settings for ${scope.label}` testId=`scope-settings-${scope.label}` width=24 height=24 padding=0 flex-shrink=0 border-radius=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                  SidebarIcon(name="settings", size=14, color="light-dark(#71717b, #818181)")

// CustomSnoozeDialog: Date and time / Duration, then Snooze. The window's
// clock seeds the date and time an hour out; resolveCustomSnooze runs in the
// client, which keeps the dialog open with its error for a past or empty time.
component SidebarSnoozeDialog
  props
    data: Snapshot
    busy: bool
    local: action
    run: action
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding=16 box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="sidebar-snooze-overlay"
      column width="100%" max-width=384 position="relative" box-sizing="border-box" border-radius=18 border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label="Custom snooze" testId="sidebar-snooze"
        button press=local("dialog-close", "", "") disabled=busy aria-label="Close" testId="snooze-close" position="absolute" top=8 right=8 z-index=1 width=32 height=32 padding=0 border-radius=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
          SidebarIcon(name="x", size=16, color="light-dark(#27272a, #f5f5f5)")
        column gap=8 padding-left=24 padding-right=24 padding-top=24 box-sizing="border-box"
          text "Custom snooze" font-size=20 font-weight=600 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "Choose when snoozed threads return to your inbox." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
        column gap=16 padding=24 box-sizing="border-box"
          row height=32 padding=2 box-sizing="border-box" border-radius=8 background-color="light-dark(#f4f4f5, #ffffff0a)" role="group" aria-label="Schedule type"
            button press=local("dialog-field", "mode", "date") testId="snooze-mode-date" flex=1 height=28 border-radius=6 border-width=0 background-color=(data.sidebar.dialogMode == "date" ? "light-dark(#ffffff, #ffffff14)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
              text "Date and time" font-size=14 font-weight=500 color=(data.sidebar.dialogMode == "date" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
            button press=local("dialog-field", "mode", "duration") testId="snooze-mode-duration" flex=1 height=28 border-radius=6 border-width=0 background-color=(data.sidebar.dialogMode == "duration" ? "light-dark(#ffffff, #ffffff14)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
              text "Duration" font-size=14 font-weight=500 color=(data.sidebar.dialogMode == "duration" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
          when data.sidebar.dialogMode == "date"
            row gap=12
              column flex=1 min-width=0 gap=6
                text "Date" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                input type="date" value=data.sidebar.dialogDate change=local("dialog-field", "date") aria-label="Date" testId="snooze-date" box-sizing="border-box" height=32 padding-left=11 padding-right=9 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"
              column flex=1 min-width=0 gap=6
                text "Time" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                input type="time" value=data.sidebar.dialogTime change=local("dialog-field", "time") aria-label="Time" testId="snooze-time" box-sizing="border-box" height=32 padding-left=11 padding-right=9 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"
          else
            row gap=12
              column flex=1 min-width=0 gap=6
                text "Snooze for" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                // NumberField: Decrease, the centered amount, Increase in one bordered group.
                row height=32 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" align-items="stretch" role="group"
                  button press=local("dialog-step", "amount", "-1") aria-label="Decrease duration" testId="snooze-decrease" flex-shrink=0 padding-left=11 padding-right=11 border-width=0 border-radius=7 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    SidebarIcon(name="minus", size=16, color="light-dark(#27272a, #f5f5f5)")
                  // The host input does not center its text: the input fits the amount and centers in the field.
                  row flex=1 min-width=0 justify-content="center" align-items="center"
                    input value=data.sidebar.dialogAmount input=local("dialog-field", "amount") inputmode="decimal" aria-label="Snooze for" testId="snooze-amount" width=(max(9, length(data.sidebar.dialogAmount) * 8.5 + 2)) height=20 line-height="20px" padding=0 box-sizing="border-box" border-width=0 background-color="#00000000" text-align="center" font-variant-numeric="tabular-nums" font-size=14 color="light-dark(#27272a, #f5f5f5)"
                  button press=local("dialog-step", "amount", "+1") aria-label="Increase duration" testId="snooze-increase" flex-shrink=0 padding-left=11 padding-right=11 border-width=0 border-radius=7 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    SidebarIcon(name="plus", size=16, color="light-dark(#27272a, #f5f5f5)")
              column flex=1 min-width=0 gap=6
                text "Unit" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
                select value=data.sidebar.dialogUnit change=local("dialog-field", "unit") aria-label="Unit" testId="snooze-unit" height=32 font-size=14
                  option "Minutes" value="minutes"
                  option "Hours" value="hours"
                  option "Days" value="days"
          when data.sidebar.dialogError != ""
            text data.sidebar.dialogError font-size=14 line-height="20px" color="light-dark(#dc2626, #f87171)" role="alert" testId="snooze-error"
        row gap=8 justify-content="flex-end" padding-left=24 padding-right=24 padding-top=16 padding-bottom=16 box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          button press=local("dialog-close", "", "") disabled=busy aria-keyshortcuts="Escape" testId="snooze-cancel" display="flex" flex-direction="row" align-items="center" justify-content="center" height=36 padding-left=13 padding-right=13 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
            text "Cancel" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
          button press=run("dialog-confirm", "", "") disabled=busy testId="snooze-confirm" display="flex" flex-direction="row" align-items="center" justify-content="center" height=36 padding-left=13 padding-right=13 box-sizing="border-box" border-radius=8 border-width=0 background-color="light-dark(#1b4ed8, #346bf1)"
            text "Snooze" font-size=14 font-weight=500 line-height="20px" color="#ffffff"

// ui/tooltip.tsx TooltipPopup for a sidebar row control, centered over the
// control's top (x, y) with the shell's bubble. Hidden bubbles move off-screen.
component SidebarControlTip
  props
    label: string
    x: number
    y: number
    start: bool
    shown: bool
  view
    // `start`: shifted against the window's left edge (x is the bubble's left), else centered on x.
    row position="absolute" left=(shown ? (start ? x : x - 160) : -4000) top=(y - 30.5) width=320 z-index=140 justify-content=(start ? "flex-start" : "center") pointer-events="none" aria-hidden=(not shown)
      TipCard(label=label, shown=shown)

// SidebarThreadTooltip in ThreadHoverCardPopup (glass, side right, align
// start, 4pt off the row): the title, then project, machine, branch, model ·
// instance, hand-offs and the last error, each behind its 12pt glyph.
// r5-shell: where ThreadHoverCardPopup (side right, align start, offset 4)
// lands after Base UI's collision avoidance (flip alignment, then shift, 5pt
// padding plus the 1pt flip bias): at the row's top when the card fits above
// the window's bottom, else bottom-aligned with the row, as the HEAD oracle
// puts a settled row's card at 840x620 (row 536–572, card 463–572). The anchor
// is the row's card (inside its 2pt padding); `top` and `height` are the row's
// frame in the window (the list's scroll subtracted). The card's height is
// fixed by its rows: 1pt borders, 12pt insets, a 15pt title and, below an 8pt
// gap, 16pt rows 6pt apart.
component SidebarPlacedHoverCard
  props
    t: Thread
    x: number
    top: number
    height: number
    viewportHeight: number
    shown: bool
  derive rows = (t.projectName != "" ? 1 : 0) + (t.hoverEnvironment != "" ? 1 : 0) + (t.branch != "" ? 1 : 0) + (t.hoverModel != "" ? 1 : 0) + (t.hoverHandoff != "" ? 1 : 0) + (t.hoverError != "" ? 1 : 0)
  derive cardH = 41 + (rows > 0 ? 2 + 22 * rows : 0)
  derive aTop = top + (t.card ? 2 : 0)
  derive aBottom = top + height - (t.card ? 2 : 0)
  derive startOver = max(0, 6 - aTop) + max(0, aTop + cardH - (viewportHeight - 6))
  derive endOver = max(0, 6 - (aBottom - cardH)) + max(0, aBottom - (viewportHeight - 6))
  derive flipped = startOver > 0 and endOver < startOver
  derive placed = flipped ? aBottom - cardH : aTop
  derive shifted = min(max(placed, 5), viewportHeight - 5 - cardH)
  view
    SidebarHoverCard(t=t, x=x, y=max(aTop - cardH, min(aBottom, shifted)), shown=shown)

component SidebarHoverCard
  props
    t: Thread
    x: number
    y: number
    shown: bool
  view
    column position="absolute" left=(shown ? x : -4000) top=y z-index=29 opacity=(shown ? 1 : 0) transition=(shown ? "opacity 0ms linear 150ms" : "opacity 0ms") aria-hidden=(not shown) max-width=320 padding-left=12 padding-right=12 padding-top=12 padding-bottom=12 box-sizing="border-box" gap=8 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" backdrop-filter="blur(16px)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" pointer-events="none" role="tooltip" testId=(shown ? `hover-card-${t.id}` : "hover-card-hidden")
      text t.title max-width=296 font-size=12 line-height="15px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1
      column gap=6 padding-left=2
        when t.projectName != ""
          row gap=8 align-items="center" height=16
            SidebarProjectGlyph(g=t.glyph, size=12, dim=false)
            text t.projectName font-size=12 line-height="16px" color="light-dark(#27272abf, #f5f5f5bf)" line-clamp=1
        when t.hoverEnvironment != ""
          row gap=8 align-items="center" height=16
            SidebarIcon(name=t.hoverMachine, size=12, color="light-dark(#71717b, #818181)")
            text t.hoverEnvironment font-size=12 line-height="16px" color="light-dark(#27272abf, #f5f5f5bf)" line-clamp=1
        when t.branch != ""
          row gap=8 align-items="center" height=16
            SidebarIcon(name="git-branch", size=12, color="light-dark(#71717b, #818181)")
            text t.branch font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" line-clamp=1
        when t.hoverModel != ""
          row gap=8 align-items="center" height=16
            box width=12 height=12 opacity=0.6 flex-shrink=0
              ProviderMark(driver=t.providerDriver, size=12, color="light-dark(#71717b, #818181)")
            text t.hoverModel font-size=12 line-height="16px" color="light-dark(#27272abf, #f5f5f5bf)" line-clamp=1
        when t.hoverHandoff != ""
          row gap=8 align-items="center" height=16
            SidebarIcon(name="arrow-right-left", size=12, color="light-dark(#71717b, #818181)")
            text t.hoverHandoff font-size=12 line-height="16px" color="light-dark(#27272abf, #f5f5f5bf)" line-clamp=1
        when t.hoverError != ""
          row gap=8 align-items="center" height=16
            SidebarIcon(name="circle-alert", size=12, color=(t.hoverErrorWarning ? "#fe9a00" : "light-dark(#fb2c36, #fb414a)"))
            text t.hoverError font-size=12 line-height="16px" color=(t.hoverErrorWarning ? "#fe9a00" : "light-dark(#fb2c36, #fb414a)") line-clamp=1

// ThreadContextDragGhost: past the list edge the lifted thread rides the
// pointer as a context chip (12pt off), "+N" for the rest of a selection.
component SidebarDragGhost
  props
    t: Thread
    x: number
    y: number
    count: number
  view
    row position="absolute" left=(x + 12) top=(y + 12) z-index=60 max-width=288 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 box-sizing="border-box" gap=8 align-items="center" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a" pointer-events="none" aria-hidden=true testId="sidebar-drag-ghost"
      SidebarIcon(name="messages-square", size=16, color="light-dark(#71717b, #818181)")
      text t.title font-size=14 line-height="20px" color="light-dark(#27272a, #f3f3f3)" line-clamp=1 min-width=0
      when count > 1
        text `+${count - 1}` flex-shrink=0 padding-left=6 padding-right=6 border-radius=10 background-color="light-dark(#f4f4f5, #ffffff0a)" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"

// The lifted row (Sidebar.tsx isDragging: the sidebar surface under the row
// tint, shadow-lg), with its destination verb in place of the age.
component SidebarLiftedCard
  props
    t: Thread
    x: number
    y: number
    width: number
    verb: string
  view
    column position="absolute" left=x top=y z-index=50 width=width height=(t.card ? 78 : 36) padding-left=10 padding-right=10 padding-top=(t.card ? 8 : 0) box-sizing="border-box" justify-content=(t.card ? "flex-start" : "center") border-radius=8 background-color="light-dark(#ffffff, #1b1b1b)" box-shadow="0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a" pointer-events="none" aria-hidden=true testId="sidebar-lifted-row"
      when t.card
        row width="100%" height=20 gap=6 align-items="center"
          SidebarProjectGlyph(g=t.glyph, size=16, dim=false)
          text t.projectName font-size=12 line-height="16px" font-weight=t.titleWeight color="light-dark(#71717b, #818181)" flex=1 min-width=0 line-clamp=1
          when t.pinned and verb == ""
            SidebarIcon(name="pin", size=12, color="light-dark(#71717ba6, #a3a3a3a6)")
          when verb != ""
            SidebarDropVerb(verb=verb, ink="light-dark(#1b4ed8, #346bf1)")
          else
            text t.age font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" font-variant-numeric="tabular-nums"
        text t.title width="100%" font-size=14 line-height="20px" margin-top=4 font-weight=t.titleWeight color=t.titleColor line-clamp=1
        row width="100%" height=14 margin-top=2 align-items="center" justify-content="flex-end"
          SidebarProviderMark(driver=t.providerDriver, badge=t.providerBadge, accent=t.providerBadgeColor)
      else
        row width="100%" height=36 gap=10 align-items="center"
          SidebarProjectGlyph(g=t.glyph, size=16, dim=false)
          text t.title font-size=14 line-height="20px" font-weight=t.titleWeight color="light-dark(#27272a, #f3f3f3)" flex=1 min-width=0 line-clamp=1
          when verb != ""
            SidebarDropVerb(verb=verb, ink="light-dark(#1b4ed8, #346bf1)")
