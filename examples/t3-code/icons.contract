5.598 1.5M17.997 5.125a4 4 0 0 1 2.526 5.77M18 18a4 4 0 0 0 2-7.464M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517M6 18a4 4 0 0 1-2-7.464M6.003 5.125a4 4 0 0 0-2.526 5.77" : name == "star" ? "M11.48 2.35a.56.56 0 0 1 1.04 0l2.49 5.06a2 2 0 0 0 1.51 1.1l5.58.82a.56.56 0 0 1 .31.96l-4.04 3.94a2 2 0 0 0-.58 1.77l.95 5.57a.56.56 0 0 1-.81.59l-5-2.63a2 2 0 0 0-1.86 0l-5 2.63a.56.56 0 0 1-.81-.59l.95-5.57a2 2 0 0 0-.58-1.77L2.59 10.3a.56.56 0 0 1 .31-.96l5.58-.82a2 2 0 0 0 1.51-1.1Z" : name == "star-filled" ? "M11.48 2.35a.56.56 0 0 1 1.04 0l2.49 5.06a2 2 0 0 0 1.51 1.1l5.58.82a.56.56 0 0 1 .31.96l-4.04 3.94a2 2 0 0 0-.58 1.77l.95 5.57a.56.56 0 0 1-.81.59l-5-2.63a2 2 0 0 0-1.86 0l-5 2.63a.56.56 0 0 1-.81-.59l.95-5.57a2 2 0 0 0-.58-1.77L2.59 10.3a.56.56 0 0 1 .31-.96l5.58-.82a2 2 0 0 0 1.51-1.1Z" : name == "file-diff" ? "M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2zM9 10h6M12 13V7M9 17h6" : name == "file-modified" ? "M4 7v10m0-10 4 6 4-6v10m7-10v10m-3-3 3 3 3-3" : name == "provider" ? "M12 2l8.66 5v10L12 22l-8.66-5V7L12 2Zm0 0v10m8.66-5L12 12m0 10V12m-8.66 5L12 12m8.66 5L12 12M3.34 7 12 12" : ""
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=(name == "bolt" ? 1 : 2) stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=geometry fill=(name == "star-filled" or name == "bolt" ? "currentColor" : "none")

