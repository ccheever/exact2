-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" : name == "clock" ? "M12 6v6l4 2M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0" : name == "settle" ? "M20 6 9 17l-5-5" : name == "external-link" ? "M15 3h6v6M10 14 21 3M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" : name == "refresh" ? "M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5" : "M14 9 9 4 4 9M20 20h-7a4 4 0 0 1-4-4V4") : includes(["git-fork", "arrow-right", "hash", "mail-open", "timer", "message-square-plus", "cursor", "folder-git"], name) ? (name == "git-fork" ? "M9 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M3 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M18 9v2c0 .6-.4 1-1 1H7c-.6 0-1-.4-1-1V9M12 12v3" : name == "arrow-right" ? "M5 12h14M12 5l7 7-7 7" : name == "hash" ? "M4 9h16M4 15h16M10 3 8 21M16 3l-2 18" : name == "mail-open" ? "M21.2 8.4c.5.38.8.97.8 1.6v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V10a2 2 0 0 1 .8-1.6l8-6a2 2 0 0 1 2.4 0l8 6ZM22 10l-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 10" : name == "timer" ? "M10 2h4M12 14l3-3M4 14a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" : name == "message-square-plus" ? "M22 17a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 21.286V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2zM12 8v6M9 11h6" : name == "cursor" ? "M12 2.5l8.5 4.9v9.2L12 21.5l-8.5-4.9V7.4ZM3.5 7.4 12 12l8.5-4.6M12 12v9.5" : "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2ZM10 13a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M14 13h3M7 13h3") : includes(["folder-git-2", "cloud-upload", "cloud-download", "bot", "eye", "eye-off"], name) ? (name == "folder-git-2" ? "M18 19a5 5 0 0 1-5-5v8M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5M11 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M18 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" : name == "cloud-upload" ? "M12 13v8M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242M8 17l4-4 4 4" : name == "cloud-download" ? "M12 13v8l-4-4M12 21l4-4M4.393 15.269A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.436 8.284" : name == "bot" ? "M12 8V4H8M6 8h12a2 2 0 0 1 2 2v8a2 2 0 0 1 -2 2h-12a2 2 0 0 1 -2 -2v-8a2 2 0 0 1 2 -2ZM2 14h2M20 14h2M15 13v2M9 13v2" : name == "eye" ? "M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" : "M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49M14.084 14.158a3 3 0 0 1-4.242-4.242M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143M2 2l20 20") : ""

// Lucide glyphs the window shell draws (toasts, panel controls, the surface
// chooser, the details panel and the title menu), copied from the built
// reference's icon modules and flattened to one path each (circles and
// rounded rects as arcs), so a use costs two nodes.
component ShellIcon
  props
    name: string
    size: number
    color: string
  derive geometry = shellIconGeometry(name)
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=geometry

// ProviderUpdateToastIcon: the provider glyph with a 12px popover-coloured
// disc at its bottom-right carrying a 10px success download arrow.
component ShellBadgedIcon
  props
    size: number
    badge: string
    badgeColor: string
    plate: string
  slot
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` position="relative" flex-shrink=0
      children
      box position="absolute" right="-0.25rem" bottom="-0.25rem" width="0.75rem" height="0.75rem" border-radius="0.375rem" background-color=plate display="flex" flex-direction="row" align-items="center" justify-content="center"
        svg width="0.625rem" height="0.625rem" viewBox="0 0 24 24" color=badgeColor fill="none" stroke="currentColor" stroke-width=2.5 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d=(badge == "download" ? "M12 15V3M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5" : "M20 6 9 17l-5-5")

// OpenInPicker's editor glyph: Cursor's filled brand mark (Icons.tsx
// CursorIcon, fill #26251E / #EDECEC), Finder's folder, and the outline
// cube for editors whose brand mark is not carried here.
component ShellEditorIcon
  props
    editor: string
    size: number
  view
    when editor == "cursor"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 466.73 532.09" color="light-dark(#26251e, #edecec)" fill="currentColor" flex-shrink=0 aria-hidden=true
        path d="M457.43,125.94L244.42,2.96c-6.84-3.95-15.28-3.95-22.12,0L9.3,125.94c-5.75,3.32-9.3,9.46-9.3,16.11v247.99c0,6.65,3.55,12.79,9.3,16.11l213.01,122.98c6.84,3.95,15.28,3.95,22.12,0l213.01-122.98c5.75-3.32,9.3-9.46,9.3-16.11v-247.99c0-6.65-3.55-12.79-9.3-16.11h-.01ZM444.05,151.99l-205.63,356.16c-1.39,2.4-5.06,1.42-5.06-1.36v-233.21c0-4.66-2.49-8.97-6.53-11.31L24.87,145.67c-2.4-1.39-1.42-5.06,1.36-5.06h411.26c5.84,0,9.49,6.33,6.57,11.39h-.01Z"
    when editor == "vscode"
      // Icons.tsx VisualStudioCode without its mask and drop-shadow filters, which stay inside the mark at this size.
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 100 100" fill="none" flex-shrink=0 aria-hidden=true
        defs
          linearGradient id="vscode-overlay" x1=49.939 y1=0.258 x2=49.939 y2=99.742 gradientUnits="userSpaceOnUse"
            stop stop-color="#ffffff"
            stop offset=1 stop-color="#ffffff" stop-opacity=0
        path fill="#0065A9" d="M96.461 10.796 75.857.876a6.23 6.23 0 0 0-7.107 1.207l-67.451 61.5a4.167 4.167 0 0 0 .004 6.162l5.51 5.009a4.167 4.167 0 0 0 5.32.236l81.228-61.62c2.725-2.067 6.639-.124 6.639 3.297v-.24a6.25 6.25 0 0 0-3.539-5.63Z"
        path fill="#007ACC" d="m96.461 89.204-20.604 9.92a6.229 6.229 0 0 1-7.107-1.207l-67.451-61.5a4.167 4.167 0 0 1 .004-6.162l5.51-5.009a4.167 4.167 0 0 1 5.32-.236l81.228 61.62c2.725 2.067 6.639.124 6.639-3.297v.24a6.25 6.25 0 0 1-3.539 5.63Z"
        path fill="#1F9CF0" d="M75.858 99.126a6.232 6.232 0 0 1-7.108-1.21c2.306 2.307 6.25.674 6.25-2.588V4.672c0-3.262-3.944-4.895-6.25-2.589a6.232 6.232 0 0 1 7.108-1.21l20.6 9.908A6.25 6.25 0 0 1 100 16.413v67.174a6.25 6.25 0 0 1-3.541 5.633l-20.601 9.906Z"
        path fill="url(#vscode-overlay)" fill-rule="evenodd" clip-rule="evenodd" opacity=0.25 d="M70.851 99.317a6.224 6.224 0 0 0 4.96-.19L96.4 89.22a6.25 6.25 0 0 0 3.54-5.633V16.413a6.25 6.25 0 0 0-3.54-5.632L75.812.874a6.226 6.226 0 0 0-7.104 1.21L29.294 38.04 12.126 25.01a4.162 4.162 0 0 0-5.317.236l-5.507 5.009a4.168 4.168 0 0 0-.004 6.162L16.186 50 1.298 63.583a4.168 4.168 0 0 0 .004 6.162l5.507 5.009a4.162 4.162 0 0 0 5.317.236L29.294 61.96l39.414 35.958a6.218 6.218 0 0 0 2.143 1.4ZM74.954 27.3 45.048 50l29.906 22.701V27.3Z"
    when editor == "zed"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 96 96" color="light-dark(#27272a, #f5f5f5)" fill="none" flex-shrink=0 aria-hidden=true
        path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 6a3 3 0 0 0-3 3v66H0V9a9 9 0 0 1 9-9h80.379c4.009 0 6.016 4.847 3.182 7.682L43.055 57.187H57V51h6v7.688a4.5 4.5 0 0 1-4.5 4.5H37.055L26.743 73.5H73.5V36h6v37.5a6 6 0 0 1-6 6H20.743L10.243 90H87a3 3 0 0 0 3-3V21h6v66a9 9 0 0 1-9 9H6.621c-4.009 0-6.016-4.847-3.182-7.682L52.757 39H39v6h-6v-7.5a4.5 4.5 0 0 1 4.5-4.5h21.257l10.5-10.5H22.5V60h-6V22.5a6 6 0 0 1 6-6h52.757L85.757 6H9Z"
    when editor == "file-manager"
      // Icons.tsx FinderIcon.
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" fill="none" flex-shrink=0 aria-hidden=true
        rect x=2 y=2 width=20 height=20 rx=4 fill="#36A9F5"
        path d="M13 2h5a4 4 0 0 1 4 4v12a4 4 0 0 1-4 4h-6c-1-4-1-7 0-10H9c0-4 2-8 4-10Z" fill="#D9F1FF"
        path d="M7 7v2m10-2v2M6 15c3 3 9 3 12 0" stroke="#163A59" stroke-width=1.5 stroke-linecap="round"
    // composer-fidelity G15: the other 17 editors' marks (editor-icons.contract); an unknown editor keeps the outline cube.
    when includes(["trae", "kiro", "vscode-insiders", "vscodium", "antigravity", "idea", "aqua", "clion", "datagrip", "dataspell", "goland", "phpstorm", "pycharm", "rider", "rubymine", "rustrover", "webstorm"], editor)
      EditorBrandIcon(editor=editor, size=size)
    when editor != "cursor" and editor != "vscode" and editor != "zed" and editor != "file-manager" and not includes(["trae", "kiro", "vscode-insiders", "vscodium", "antigravity", "idea", "aqua", "clion", "datagrip", "dataspell", "goland", "phpstorm", "pycharm", "rider", "rubymine", "rustrover", "webstorm"], editor)
      ShellIcon(name="cursor", size=size, color="light-dark(#27272a, #f5f5f5)")
