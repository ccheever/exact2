// The Diff panel's file tree, measured against T3 Code 1e2ecbd975 DiffFileTree.tsx (MIT; see
// LICENSE-T3): a "Files" header with the count and Collapse/Expand all folders, then @pierre/trees'
// compact rows, folders open and flattened (diff-tree.ts lays them out). A file press reveals the
// file in the diff: it opens, a lazy file is asked for (diff-review.ts), the list scrolls to it.
use Snapshot from "./shapes.contract"
use DiffTreeRow from "./shapes.contract"
use ReqIcon from "./requests.contract"
use diffInk from "./settings-appearance-look.contract"
use DiffGlyph from "./diff-glyphs.contract"

component DiffTree
  props
    data: Snapshot
    command: action
    scheme: string
  view
    column width="13.5rem" flex-shrink=0 height="100%" padding-left="0.75rem" padding-right="0.5rem" box-sizing="border-box" border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #191919)" role="complementary" aria-label="Files" testId="diff-tree"
      row height="1.5rem" align-items="center" margin-bottom="1rem" gap="0.25rem" padding-right=0
        text "Files" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)" flex=1
        text `${length(data.diffFiles)}` font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717a, #818181)" testId="diff-tree-count"
        when data.diffTreeFolders
          DiffTreeFolders(open=data.diffTreeAllOpen, command=command)
      column flex=1 min-height=0 overflow-y="auto" role="tree" aria-label=data.diffTreeLabel testId="diff-tree-rows"
        each entry in data.diffTreeRows key=entry.id
          DiffTreeItem(entry=entry, command=command, scheme=scheme)

// Collapse all folders / Expand all folders (ChevronsDownUp / ChevronsUpDown, icon-xs ghost).
component DiffTreeFolders
  props
    open: bool
    command: action
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    button press=command("diff-view", "folders", (open ? "collapse" : "expand"), 0) hover=hover aria-label=(open ? "Collapse all folders" : "Expand all folders") title=(open ? "Collapse all folders" : "Expand all folders") testId="diff-tree-folders" width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.375rem" border-width=0 background-color=(hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      DiffGlyph(name=(open ? "fold" : "unfold"), size=14, color="light-dark(#71717a, #818181)")

// One compact row: a folder's chevron and its (flattened) name, or a file's icon, name and git letter.
component DiffTreeItem
  props
    entry: DiffTreeRow
    command: action
    scheme: string
  state hovering = false
  action hover(over: bool)
    hovering = over
  action pick
    if entry.kind == "folder"
      command("diff-view", "folder", entry.path, 0)
    else
      // revealDiffFile: the same press on the selected row reveals again.
      command("diffreview", "reveal", entry.path, 0)
      scrollIntoView("diff-list", `file:${entry.path}`, block="start")
  view
    button press=pick hover=hover role="treeitem" aria-level=(entry.depth + 1) aria-expanded=(entry.kind == "folder" ? entry.expanded : false) aria-selected=entry.selected aria-label=entry.path testId=`diff-tree-${entry.path}` width="100%" height=24 flex-shrink=0 padding-left=(4 + entry.depth * 12) padding-right=8 gap=4 box-sizing="border-box" border-radius=6 border-width=0 background-color=(entry.selected ? "light-dark(#27272a14, #f5f5f514)" : hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      when entry.kind == "folder"
        ReqIcon(name=(entry.expanded ? "chevron-down" : "chevron-right"), size=16, color="light-dark(#71717a, #818181)")
        text entry.name font-size=12 line-height="16px" flex=1 min-width=0 line-clamp=1 text-align="left" color="light-dark(#27272a, #f5f5f5)"
      else
        box width=16 height=16 flex-shrink=0
          DiffGlyph(name=(entry.markdown ? "markdown" : "file"), size=16, color=(entry.markdown ? "light-dark(#16a34a, #4ade80)" : "light-dark(#71717a, #818181)"))
        text entry.name font-size=12 line-height="16px" flex=1 min-width=0 line-clamp=1 text-align="left" color=(entry.status == "deleted" ? diffInk(scheme, "del-text") : entry.status == "added" ? diffInk(scheme, "add-text") : "light-dark(#27272a, #f5f5f5)")
        text entry.letter font-size=12 font-weight=600 line-height="16px" color=(entry.status == "deleted" ? diffInk(scheme, "del-text") : entry.status == "added" ? diffInk(scheme, "add-text") : "light-dark(#d08700, #fdc700)")
