// The Usage page's dialogs (lane "pages", upstream e8545b293b and b05adb70b0):
// UsageModelDialog, opened from a Breakdown row, and UsagePriceOverrides
// ("Custom model prices"), opened from the environment menu's Model prices or
// the model dialog's Set price. Measured against the served reference at
// 1280×840. T3 Code, MIT (LICENSE-T3).
use UsageView from "./pages-usage.contract"
use UsageChartView from "./pages-usage.contract"
use UsageShareBar from "./pages-usage-shapes.contract"
use UsageModelDetail from "./pages-usage-shapes.contract"
use UsagePricesDialog from "./pages-usage-prices.contract"
use UsageSchemeIcon from "./pages-usage-prices.contract"
use ProviderMark from "./icons.contract"
use DriverMark from "./provider-icons.contract"
use PgIcon from "./pages-icons.contract"

// Over the whole window, above the sidebar, as the reference's portal is.
// Model prices is drawn once for both schemes (its scheme only picks
// shadows), so an appearance change never remounts the inputs being typed in.
component UsagePricesLayer
  props
    page: UsageView
    scheme: string
    viewportHeight: number
    busy: bool
    op: action
  view
    UsageDialogShell(scheme=scheme, width=896, close=op("usage-prices-close", "", ""), closeDisabled=page.prices.pending, dialogId="usage-prices-dialog", title="Custom model prices")
      UsagePricesDialog(prices=page.prices, scheme=scheme, viewportHeight=viewportHeight, busy=busy, op=op)

component UsageModelLayer
  props
    page: UsageView
    scheme: string
    viewportHeight: number
    sm: bool
    op: action
  view
    UsageDialogShell(scheme=scheme, width=768, close=op("usage-model-close", "", ""), closeDisabled=false, dialogId="usage-model-dialog", title=page.detail.model)
      UsageModelDialog(detail=page.detail, scheme=scheme, viewportHeight=viewportHeight, sm=sm, op=op)

// Dialog: the backdrop (bg-background 64% dark / 60% light, blur 4px) and
// DialogPopup (dialog-glass, rounded-2xl, centred in a 16pt inset, sized to
// its content up to the viewport) with the close button. A press outside the
// popup closes it; the popup keeps its own presses (and leaves focus where it
// is, as Base UI's popup does with outline-none).
component UsageDialogShell
  props
    scheme: string
    width: number
    close: action
    closeDisabled: bool
    dialogId: string
    title: string
  slot
  state held = false
  action hold
    held = true
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 z-index=60 background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId=`${dialogId}-layer`
      column position="absolute" left=0 top=0 right=0 bottom=0 padding="1rem" box-sizing="border-box" align-items="center" justify-content="center" press=close aria-label="Close" testId=`${dialogId}-backdrop`
        column position="relative" width="100%" max-width=width max-height="100%" min-height=0 box-sizing="border-box" border-radius="1.125rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow=(scheme == "dark" ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") press=hold retainFocus=true role="dialog" aria-label=title testId=dialogId
          children
          button press=close disabled=closeDisabled aria-label="Close" aria-keyshortcuts="Escape" position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" testId=`${dialogId}-close`
            UsageSchemeIcon(name="x", size=16, scheme=scheme, light="#27272a", dark="#f5f5f5")

// UsageModelDialog: provider mark and model id, "{Provider} · {pct} of cost",
// the stats, the trend narrowed to this model, its mixes, and Set price for
// tokens with no known price.
component UsageModelDialog
  inject
    rem: number
  props
    detail: UsageModelDetail
    scheme: string
    viewportHeight: number
    sm: bool
    op: action
  view
    column flex-shrink=0 padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" box-sizing="border-box" gap="0.5rem"
      row align-items="center" gap="0.5rem" min-width=0 padding-right="1.5rem"
        box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          when detail.driver == "codex"
            ProviderMark(driver="codex", size=20, color="light-dark(#27272a, #f5f5f5)")
          else
            DriverMark(driver=detail.driver, size=20, initials="")
        text detail.model font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 min-width=0 testId="usage-model-title"
      text detail.description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
    scroll max-height=(viewportHeight - (118 + (detail.unpricedNote != "" ? 64 : 0)) * rem / 16) min-height=0 width="100%" testId="usage-model-scroll"
      column width="100%" padding-top="0.25rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom=(detail.unpricedNote != "" ? "0.25rem" : "1.5rem") box-sizing="border-box" gap="2rem"
        box width="100%" display="grid" grid-template-columns=(sm ? "repeat(4, minmax(0, 1fr))" : "repeat(2, minmax(0, 1fr))") column-gap="1.5rem" row-gap="1rem"
          each stat in detail.stats key=stat.key
            column min-width=0 gap="0.125rem" testId=`usage-model-stat-${stat.key}`
              text stat.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              text stat.value font-size="1.5rem" line-height="2rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)"
        UsageChartView(chart=detail.chart, width=detail.plotWidth, title=detail.chartTitle, scheme=scheme)
        box width="100%" display="grid" grid-template-columns=(sm ? "repeat(2, minmax(0, 1fr))" : "minmax(0, 1fr)") column-gap="2.5rem" row-gap="2rem"
          each bar in detail.shares key=bar.key
            UsageShareBar(bar=bar, scheme=scheme)
    when detail.unpricedNote != ""
      row flex-shrink=0 padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" align-items="center" justify-content="space-between" gap="0.5rem"
        text detail.unpricedNote font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="usage-model-unpriced"
        UsagePrimaryButton(label="Set price", scheme=scheme, disabled=false, press=op("usage-prices-open", "", detail.model), testId="usage-model-set-price")

// Button (default variant, sm:h-8): primary fill, a white inset highlight and a primary-tinted shadow.
component UsagePrimaryButton
  props
    label: string
    scheme: string
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId=testId height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color=(over and not disabled ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") box-shadow=(disabled ? "none" : (scheme == "dark" ? "inset 0 1px 0 #ffffff29, 0 1px 2px #346bf13d" : "inset 0 1px 0 #ffffff29, 0 1px 2px #1b4ed83d")) opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="#ffffff"
