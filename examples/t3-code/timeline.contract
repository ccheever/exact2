// T3 MessagesTimeline rows (MIT, see LICENSE-T3), measured against the built
// reference: a 736pt lane inside a 20pt scroll gutter, rows spaced by their own
// bottom padding, hover-revealed metadata that keeps its layout space.
use ChatDocument from "./markdown.contract"
use AnswerMarkdown from "./markdown.contract"
use UserMarkdown from "./markdown.contract"
use Activity from "./shapes.contract"
use Message from "./shapes.contract"
use Icon from "./icons.contract"
use TimelineIcon from "./timeline-icons.contract"
use WorkEntry from "./timeline-work.contract"
use WorkLine from "./timeline-work.contract"
use LiveActivity from "./timeline-work.contract"
use LiveLabel from "./timeline-work.contract"
use SystemDivider from "./timeline-work.contract"
use SubagentRow from "./timeline-work.contract"
use CopyButton from "./timeline-work.contract"
use PlanCard from "./timeline-plan.contract"
use CheckpointFile from "./shapes.contract"
use FileTypeIcon from "./timeline-files.contract"
use AttachmentUrl from "./timeline-attachments.contract"
use MessageAttachments from "./timeline-attachments.contract"
use TimelineTip from "./shell-tip.contract"
use RowTip from "./r8-pointer-tips.contract"
use WorktreeSetupCard from "./timeline-worktree.contract"

// The bottom padding each row kind keeps (TimelineRowContent and WorkLogBlock).
// The gap under a row in px at the root size 16; the row lays it out in rem (Interface font size).
fn rowGap(kind: string, continues: bool, expanded: bool, actions: bool, attached: bool, meta: bool): number = kind == "fork" ? 8 : kind == "user" or actions or attached ? 16 : kind == "entry" or kind == "live" or kind == "group" or kind == "thinking" ? (continues or expanded ? 0 : 8) : kind == "details" ? (continues ? 0 : 4) : kind == "work" or kind == "working" ? 6 : kind == "assistant" ? (meta ? 0 : 8) : kind == "plan" ? 0 : kind == "checkpoint" ? 0 : kind == "compaction" or kind == "meta" ? 16 : kind == "subagents" ? 0 : 8

// MessagesTimeline formatWorkingTimer: whole seconds, then formatDuration's "1m 5s".
fn workingTimer(seconds: number): string = seconds < 60 ? `${seconds}s` : trim(`${seconds >= 3600 ? toString(floor(seconds / 3600)) + "h " : ""}${floor(seconds % 3600 / 60) > 0 ? toString(floor(seconds % 3600 / 60)) + "m " : ""}${seconds % 60 > 0 ? toString(seconds % 60) + "s" : ""}`)

component TimelineRow
  inject
    rem: number
  props
    documents: list<ChatDocument>
    message: Message
    command: action
    local: action
    lead: number
    now: number
    lane: number
    bubble: string
    ink: string
    hasMore: bool
    historyLoading: bool
    historyError: string
    busy: bool
    earlier: action
    attachments: list<AttachmentUrl>
    scheme: string
    diffScheme: string
    // r4-composer: the end reservation under the composer overlay (r4-composer-overlay.ts).
    tail: number
    // r8-pointer D9/D10: the chat column owns the row hover (ChatColumn rowHover/partHover): an
    // answer and the changed-files card attached under it share message.hoverKey, so hovering
    // the answer's text reveals the actions drawn under the card, as the reference's one row does.
    hovered: bool
    part: string
    hoverPart: action
  view
    column hover=hoverPart(message.hoverKey, "") width="100%" padding-top=(message.first ? lead : 0) padding-left="1.25rem" padding-right="1.25rem" box-sizing="border-box" align-items="center"
      when message.first and (hasMore or historyError != "")
        HistoryControl(lane=lane, hasMore=hasMore, loading=historyLoading, error=historyError, busy=busy, load=earlier)
      column width="100%" max-width=lane min-width=0 box-sizing="border-box" padding-bottom=(message.last ? 0.75 * rem + tail : 0) margin-bottom=`${rowGap(message.kind, message.continues, message.expanded, message.actionsId != "", message.kind == "checkpoint" and message.attached, message.meta) / 16}rem`
        when message.kind == "user"
          UserRow(message=message, documents=documents, command=command, local=local, hovering=hovered, hover=hoverPart(message.hoverKey, ""), part=part, hoverPart=hoverPart, bubble=bubble, ink=ink, attachments=attachments, scheme=scheme)
        else
          when message.kind == "checkpoint"
            when message.fileCount > 0
              column width="100%" padding-left="0.25rem" padding-right="0.25rem" padding-top=(message.attached ? "1rem" : "0px") box-sizing="border-box"
                ChangedFiles(message=message, command=command, local=local, diffScheme=diffScheme)
                RowActions(message=message, command=command, local=local, visible=hovered, hover=hoverPart(message.hoverKey, ""), part=part, hoverPart=hoverPart)
          else
            when message.kind == "fork"
              row width="100%" align-items="center" gap="0.5rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box"
                box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff0b)"
                // TimelineSystemDivider: a fork, or a subagent's "Subagent of · parent" with the bot glyph; the pill's action is its tooltip.
                TimelineTip(label=message.actionLabel, side="top", align="center", offset=30)
                  button press=command("select-thread", message.targetId, "", 0) disabled=(message.targetId == "") aria-label=message.actionLabel testId=`source-${message.id}` height="1.625rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.8125rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#fcfcfc, #0a0a0a)" display="flex" flex-direction="row" align-items="center" gap="0.375rem" min-width=0
                    TimelineIcon(name=(message.icon == "bot" ? "bot" : "fork"), size=12, color="light-dark(#71717b, #818181)")
                    when message.title != "" and message.detail != ""
                      text message.title flex-shrink=0 font-size="0.6875rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"
                      text `· ${message.detail}` min-width=0 max-width="20rem" font-size="0.6875rem" line-height="1rem" opacity=0.7 color="light-dark(#71717b, #818181)" line-clamp=1
                    else
                      text message.body font-size="0.6875rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)" line-clamp=1
                box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff0b)"
            else
              when message.kind == "meta"
                column width="100%" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box"
                  RowActions(message=message, command=command, local=local, visible=hovered, hover=hoverPart(message.hoverKey, ""), part=part, hoverPart=hoverPart)
              else
                TimelineContent(message=message, documents=documents, hovering=hovered, part=part, hoverPart=hoverPart, local=local, command=command, now=now, scheme=scheme, attachments=attachments)
                when message.actionsId != "" and message.kind != "checkpoint"
                  column width="100%" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box"
                    RowActions(message=message, command=command, local=local, visible=hovered, hover=hoverPart(message.hoverKey, ""), part=part, hoverPart=hoverPart)

// A sent message: attribution and intent above an 18pt bubble, then the
// hover-revealed time, Edit from here and Copy message.
component UserRow
  props
    message: Message
    documents: list<ChatDocument>
    command: action
    local: action
    hovering: bool
    hover: action
    part: string
    hoverPart: action
    bubble: string
    ink: string
    attachments: list<AttachmentUrl>
    scheme: string
  state expanded = false
  action toggleBody
    expanded = not expanded
  view
    column hatch="t3-turn" data-turn=message.id width="100%" align-items="flex-end" gap="0.25rem"
      when message.attribution != ""
        when message.attribution == "agent" and message.targetId != ""
          button press=command("select-thread", message.targetId, "", 0) aria-label="Open sending thread" margin-right="0.25rem" padding=0 border-width=0 background-color="#00000000"
            text "Sent by another agent" font-size="0.6875rem" line-height="0.9375rem" color="light-dark(#71717bb3, #818181b3)"
        else
          when message.attribution == "automation" and message.detail != ""
            button press=command("open-scheduled-task", message.detail, "", 0) aria-label="Sent by automation" margin-right="0.25rem" padding=0 border-width=0 background-color="#00000000"
              text "Sent by automation" font-size="0.6875rem" line-height="0.9375rem" color="light-dark(#71717bb3, #818181b3)"
          else
            text (message.attribution == "agent" ? "Sent by another agent" : "Sent by automation") margin-right="0.25rem" font-size="0.6875rem" line-height="0.9375rem" color="light-dark(#71717bb3, #818181b3)"
      when message.intent != ""
        row margin-right="0.25rem" justify-content="flex-end"
          TimelineTip(label=message.intentTip, side="top", align="center", offset=20)
            row gap="0.25rem" align-items="center" justify-content="flex-end" aria-label=message.intentTip aria-description=message.intentTip
              when message.intent == "Steer"
                TimelineIcon(name="redo", size=12, color="light-dark(#71717b, #818181)")
              text message.intent font-size="0.75rem" line-height="0.75rem" color="light-dark(#71717b, #818181)"
      column max-width="80%" padding="0.75rem" border-radius="1.125rem" background-color=bubble box-sizing="border-box"
        when length(message.images) > 0 or length(message.attachFiles) > 0
          MessageAttachments(messageId=message.id, images=message.images, files=message.attachFiles, urls=attachments, local=local)
        // CollapsibleUserMessageBody: past 600 characters or 8 lines the body
        // clips to 11rem under a 1.75rem fade until "Show full message".
        column max-height=(message.collapsible and not expanded ? "11rem" : "62500rem") overflow=(message.collapsible and not expanded ? "hidden" : "visible") mask-image=(message.collapsible and not expanded ? "linear-gradient(to bottom, #000000 0%, #000000 84%, #00000000 100%)" : "none")
          when message.body != ""
            when length(filter(documents, (doc) => doc.id == message.id)) > 0
              each document in filter(documents, (doc) => doc.id == message.id) key=document.id
                UserMarkdown(document=document, local=local, code=message.code, diagrams=message.diagrams, ink=ink, scheme=scheme, copiedText=message.codeCopied, copiedNonce=message.codeCopyNonce, env=message.md, urls=attachments)
            else
              text message.body font-size="0.875rem" line-height="1.421875rem" white-space="pre-wrap" overflow-wrap="anywhere" color=ink
        when message.collapsible
          row margin-top="0.375rem" justify-content="flex-end"
            ShowMoreButton(expanded=expanded, press=toggleBody, testId=`show-full-${message.id}`)
      when message.status != ""
        row margin-right="0.25rem" gap="0.375rem" align-items="center"
          text message.status font-size="0.625rem" font-weight=500 line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" padding-top="0.125rem" padding-bottom="0.125rem" border-radius="62.4375rem" border-width=1 border-style="solid" border-color="light-dark(#fb2c3640, #fb414a40)" background-color="light-dark(#fb2c3614, #fb414a14)" color="light-dark(#fb2c36, #fb414a)"
      row width="100%" max-width="80%" height="1.5rem" padding-right="0.25rem" box-sizing="border-box" justify-content="flex-end" align-items="center" gap="0.5rem" opacity=(hovering ? 1 : 0)
        RowTip(label=message.timeTip, side="top", align="center", offset=24, shown=(part == "time"), hover=hoverPart(message.hoverKey, "time"))
          text message.timestamp font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
        row gap="0.125rem" align-items="center"
          when message.revert >= 0
            RowTip(label="Edit from here", side="top", align="center", offset=28, shown=(part == "edit"), hover=hoverPart(message.hoverKey, "edit"))
              button press=local("revert", message.id, toString(message.revert)) testId=`edit-from-${message.id}` aria-label="Edit from here" focus=hover(true) blur=hover(false) width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                Icon(name="undo", size=12, color="light-dark(#71717b, #818181)")
          RowTip(label="Copy message", side="top", align="center", offset=28, shown=(part == "copy"), hover=hoverPart(message.hoverKey, "copy"))
            CopyButton(id=message.id, copied=message.copied, failed=message.copyFailed, local=local, hover=hover)

component ShowMoreButton
  props
    expanded: bool
    press: action
    testId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-expanded=expanded testId=testId height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#27272a0d, #ffffff0d)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text (expanded ? "Show less" : "Show full message") font-size="0.75rem" font-weight=500 line-height="1rem" color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// Fork, copy and the answer's wall-clock time; hidden until the row is hovered
// or one of its controls is focused, and always occupying its 24pt line.
component RowActions
  props
    message: Message
    command: action
    local: action
    visible: bool
    hover: action
    part: string
    hoverPart: action
  view
    row width="100%" height="1.5rem" margin-top="0.375rem" gap="0.5rem" align-items="center" opacity=(visible or message.copied > 0 ? 1 : 0)
      when message.actionsFork
        RowTip(label="Fork from this response", side="top", align="center", offset=28, shown=(part == "fork"), hover=hoverPart(message.hoverKey, "fork"))
          button press=command("fork-message", message.actionsId, "", 0) testId=`fork-${message.actionsId}` aria-label="Fork from this response" focus=hover(true) blur=hover(false) width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
            Icon(name="fork", size=12, color="light-dark(#71717b, #818181)")
      RowTip(label="Copy message", side="top", align="center", offset=28, shown=(part == "copy"), hover=hoverPart(message.hoverKey, "copy"))
        CopyButton(id=message.actionsId, copied=message.copied, failed=message.copyFailed, local=local, hover=hover)
      RowTip(label=message.actionsTimeTip, side="top", align="center", offset=24, shown=(part == "time"), hover=hoverPart(message.hoverKey, "time"))
        text message.actionsTime font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"

// ChangedFilesCard: the turn's files as a tree of compacted folders (all
// collapsed until "Expand all folders"), each file opening the turn diff at it.
component ChangedFiles
  props
    message: Message
    command: action
    local: action
    // Appearance → Diff colors (look.diff): DiffStatLabel's text-diff-addition / text-diff-deletion.
    diffScheme: string
  view
    column width="100%" border-radius="0.625rem" background-color="light-dark(#fafafa, #ffffff04)" testId=`checkpoint-${message.id}`
      row width="100%" height="2.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.5rem" align-items="center" justify-content="space-between"
        row flex=1 min-width=0 gap="0.75rem" align-items="center"
          text `${message.fileCount} changed ${message.fileCount == 1 ? "file" : "files"}` font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          when message.additions > 0 or message.deletions > 0
            row gap="0.25rem" align-items="center" aria-label=`${message.additions} additions, ${message.deletions} deletions`
              text `+${message.additions}` font-family="ui-monospace" font-size="0.75rem" line-height="1rem" font-weight=500 color=(diffScheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "#00bc7d")
              text `-${message.deletions}` font-family="ui-monospace" font-size="0.75rem" line-height="1rem" font-weight=500 color=(diffScheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)")
        row flex-shrink=0 gap="0.25rem" align-items="center"
          when length(filter(message.files, (f) => f.kind == "directory")) > 0
            TimelineTip(label=(message.expanded ? "Collapse all folders" : "Expand all folders"), side="top", align="center", offset=28)
              TreeIconButton(label=(message.expanded ? "Collapse all folders" : "Expand all folders"), icon=(message.expanded ? "chevrons-down-up" : "chevrons-up-down"), press=local("tree-all", (message.runId != "" ? message.runId : message.checkpointId), ""), testId=`tree-all-${message.id}`)
          TimelineTip(label="Open the full diff", side="top", align="center", offset=28)
            OpenDiffButton(message=message, command=command)
      column width="100%" padding="0.5rem" box-sizing="border-box"
        each file in message.files key=file.id
          TreeRow(file=file, message=message, command=command, local=local, diffScheme=diffScheme)

component TreeIconButton
  props
    label: string
    icon: string
    press: action
    testId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      TimelineIcon(name=icon, size=12, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

component OpenDiffButton
  props
    message: Message
    command: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=command("checkpoint-diff", message.targetId, "", message.checkpointOrdinal) hover=hover disabled=(message.checkpointOrdinal < 0) testId=`checkpoint-diff-${message.checkpointOrdinal}` aria-label="Open diff" height="1.5rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap="0.125rem" flex-shrink=0
      Icon(name="file-diff", size=12, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
      text "Open diff" font-size="0.75rem" line-height="1rem" font-weight=500 color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// A folder (chevron, open or closed folder, compacted name) or a file (its
// Pierre icon and name); both carry their own +/- in 4ch columns.
component TreeRow
  props
    file: CheckpointFile
    message: Message
    command: action
    local: action
    diffScheme: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    when file.kind == "directory"
      button press=local("tree-dir", (message.runId != "" ? message.runId : message.checkpointId), file.path) hover=hover aria-expanded=file.expanded aria-label=file.name testId=`tree-dir-${file.path}` width="100%" height="1.75rem" padding-left=(8 + file.depth * 14) padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f599, #ffffff06)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap="0.5rem"
        box width="0.875rem" height="0.875rem" flex-shrink=0 rotate=(file.expanded ? 90 : 0)
          Icon(name="right", size=14, color=(hovered ? "light-dark(#27272acc, #f5f5f5cc)" : "light-dark(#71717bb3, #818181b3)"))
        when file.expanded
          Icon(name="folder", size=14, color="light-dark(#71717bbf, #818181bf)")
        else
          TimelineIcon(name="folder-closed", size=14, color="light-dark(#71717bbf, #818181bf)")
        text file.name flex=1 min-width=0 line-clamp=1 text-align="left" font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color=(hovered ? "light-dark(#27272ae6, #f5f5f5e6)" : "light-dark(#71717be6, #818181e6)")
        when file.additions > 0 or file.deletions > 0
          TreeStat(file=file, diffScheme=diffScheme)
    else
      button press=command("checkpoint-diff", file.path, "", message.checkpointOrdinal) hover=hover disabled=(message.checkpointOrdinal < 0) aria-label=file.path testId=`tree-file-${file.path}` width="100%" height="1.75rem" padding-left=(8 + file.depth * 14) padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f599, #ffffff06)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap="0.5rem"
        when file.spacer
          box width="0.875rem" height="0.875rem" flex-shrink=0
        FileTypeIcon(token=file.icon, size=14)
        text file.name flex=1 min-width=0 line-clamp=1 text-align="left" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#27272ad9, #f5f5f5d9)")
        TreeStat(file=file, diffScheme=diffScheme)

component TreeStat
  props
    file: CheckpointFile
    diffScheme: string
  view
    row flex-shrink=0 gap="0.5rem" align-items="center" aria-label=`${file.additions} additions, ${file.deletions} deletions`
      text file.plus width="1.505rem" text-align="right" font-family="ui-monospace" font-size="0.625rem" line-height="0.875rem" font-variant-numeric="tabular-nums" color=(diffScheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "#00bc7d")
      text file.minus width="1.505rem" text-align="right" font-family="ui-monospace" font-size="0.625rem" line-height="0.875rem" font-variant-numeric="tabular-nums" color=(diffScheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)")

component TimelineContent
  props
    documents: list<ChatDocument>
    message: Message
    hovering: bool
    part: string
    hoverPart: action
    local: action
    command: action
    now: number
    scheme: string
    // media-actions: the answer's signed media URLs.
    attachments: list<AttachmentUrl>
  // diff-review (Cite): a quote from this answer goes to diff-review.ts.
  action citeQuote(id: string, value: string)
    command("diffreview", id, value, 0)
  view
    column width="100%"
      when message.kind == "assistant"
        // r5-composer: the answer registers as a citation's jump target (T3TimelineTurns.swift, `cite:` rows).
        column hatch="t3-turn" data-turn=`cite:${message.id}` width="100%" padding-left="0.25rem" padding-right="0.25rem" padding-top="0.125rem" padding-bottom="0.125rem" box-sizing="border-box"
          each document in filter(documents, (doc) => doc.id == message.id) key=document.id
            AnswerMarkdown(document=document, local=local, code=message.code, diagrams=message.diagrams, scheme=scheme, copiedText=message.codeCopied, copiedNonce=message.codeCopyNonce, env=message.md, source=message.id, cite=citeQuote, urls=attachments)
      else
        when message.kind == "plan"
          PlanCard(message=message, documents=documents, local=local, scheme=scheme)
        else
          when message.kind == "work"
            column width="100%"
              row width="100%" padding-top="0.25rem" padding-bottom="0.5rem" padding-right="0.125rem" box-sizing="border-box" gap="0.25rem" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
                button press=local("fold", message.groupId, "") testId=`activity-${message.id}` aria-expanded=message.expanded padding-left="0.25rem" padding-right="0.25rem" padding-top=0 padding-bottom=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem"
                  text message.title font-size="0.875rem" line-height="1.421875rem" color=(hovering ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") line-clamp=1 font-variant-numeric="tabular-nums"
                  Icon(name=(message.expanded ? "chevron" : "right"), size=14, color=(hovering ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
                box flex=1 min-width=0
                RowTip(label=(hovering ? message.timeTip : ""), side="top", align="center", offset=20, shown=(part == "time"), hover=hoverPart(message.hoverKey, "time"))
                  text message.timestamp font-size="0.75rem" line-height="1rem" margin-right="0.25rem" color="light-dark(#71717b, #818181)" opacity=(hovering ? 1 : 0)
          else
            when message.kind == "working"
              column width="100%" padding-top="0.25rem" padding-bottom="0.5rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
                row height="1.5rem" min-width=0 padding-left="0.25rem" padding-right="0.25rem" align-items="center" gap="0.5rem"
                  // "Setting up worktree…" sweeps like a live row while the worktree is prepared.
                  when message.live
                    LiveLabel(label=message.title)
                  else
                    text (message.startedMs > 0 ? `Working for ${workingTimer(max(0, floor((now - message.startedMs) / 1000)))}` : "Working...") testId="working-timer" font-size="0.875rem" line-height="1.421875rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
            else
              when message.kind == "thinking"
                when message.title == ""
                  // ThinkingTimelineRow keeps the activity row's height while a worktree is prepared.
                  box width="100%" height="1.5rem"
                else
                  // After a failed tool the row stands in for the run's tool calls and discloses them.
                  when message.groupId != ""
                    button press=local("group", message.groupId, "") testId=`thinking-${message.groupId}` aria-label="Thinking" aria-expanded=message.expanded width="100%" min-height="1.5rem" padding=0 padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
                      LiveActivity(label="Thinking", icon="brain", failed=false, active=true, shimmer=true, iconLight="", iconDark="")
                  else
                    row width="100%" padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" align-items="center"
                      LiveActivity(label="Thinking", icon="brain", failed=false, active=true, shimmer=true, iconLight="", iconDark="")
              else
                when message.kind == "live"
                  button press=local("group", message.groupId, "") testId=`live-${message.id}` aria-label=(message.failed ? `${message.title}, tool call failed` : message.title) aria-expanded=message.expanded width="100%" min-height="1.5rem" padding=0 padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
                    // Keyed by its label: a reused one-line text would keep drawing the old string.
                    each keyed in message.activities key=keyed.id
                      LiveActivity(label=keyed.label, icon=message.icon, failed=message.failed, active=message.live, shimmer=false, iconLight=keyed.iconLight, iconDark=keyed.iconDark)
                else
                  when message.kind == "group"
                    WorkGroupHeader(message=message, local=local)
                  else
                    when message.kind == "details" or message.kind == "entry"
                      WorkEntries(message=message, command=command)
                    else
                      when message.kind == "attempt"
                        button press=local("attempt", message.groupId, "") testId=`attempt-${message.groupId}` aria-expanded=message.expanded width="100%" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" background-color="light-dark(#fafafa33, #ffffff02)" display="flex" flex-direction="row" align-items="center" gap="0.5rem"
                          Icon(name=(message.expanded ? "chevron" : "right"), size=14, color="light-dark(#71717b, #818181)")
                          text message.title font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272acc, #f5f5f5cc)"
                          text message.detail font-size="0.6875rem" line-height="0.9375rem" color="light-dark(#71717b, #818181)"
                      else
                        when message.kind == "compaction"
                          row width="100%" align-items="center" gap="0.75rem" padding-top="0.25rem" padding-bottom="0.25rem" role="separator" aria-label=message.title
                            box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff0b)"
                            each keyed in message.activities key=keyed.id
                              when message.live
                                LiveActivity(label=keyed.label, icon="minimize", failed=false, active=true, shimmer=true, iconLight="", iconDark="")
                              else
                                // ContextCompactionRow: text-xs with a size-3 Minimize2 icon, gap-1.5.
                                row gap="0.375rem" align-items="center" flex-shrink=0
                                  TimelineIcon(name="minimize", size=12, color="light-dark(#71717b, #818181)")
                                  text keyed.label font-size="0.75rem" line-height="1rem" white-space="nowrap" color="light-dark(#71717b, #818181)"
                            box flex=1 height=1 background-color="light-dark(#e4e4e7b3, #ffffff0b)"
                        else
                          when message.kind == "event"
                            SystemDivider(label=message.title, detail=message.detail, icon=message.icon, danger=(message.tone == "danger"))
                          else
                            when message.kind == "subagent" or message.kind == "subagents"
                              column width="100%"
                                each agent in message.activities key=`${agent.id}\t${agent.label}\t${agent.body}\t${agent.result}`
                                  SubagentRow(agent=agent, command=command, now=now)
                            else
                              when message.kind == "worktree-setup"
                                each setup in message.setup key=setup.id
                                  WorktreeSetupCard(setup=setup, now=now, local=local)
                              else
                                row width="100%" align-items="center" gap="0.75rem" padding-top="1.25rem" padding-bottom="1.25rem"
                                  box flex=1 height=1 background-color="light-dark(#e4e4e7, #ffffff0f)"
                                  Icon(name="compacted", size=12, color="light-dark(#71717b, #818181)")
                                  text message.title font-size="0.75rem" color="light-dark(#71717b, #818181)"
                                  box flex=1 height=1 background-color="light-dark(#e4e4e7, #ffffff0f)"

// WorkGroupHeader: the group's icon (its tools' image, else the summary glyph) and sentence, hover time.
component WorkGroupHeader
  props
    message: Message
    local: action
  // r8-pointer D10: one keyed hover for the row and its time, so hovering the time keeps it shown.
  state over = ""
  action hover(id: string, value: bool)
    over = value ? id : (over == id ? "" : over)
  derive hovering = over != ""
  view
    button hover=hover("row") press=local("group", message.groupId, "") testId=`group-${message.id}` aria-label=(message.failed ? `${message.title}, tool call failed` : message.title) aria-expanded=message.expanded width="100%" min-height="1.75rem" padding="0.125rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
      each keyed in message.activities key=keyed.id
        WorkLine(icon=message.icon, label=keyed.label, failed=false, highlighted=false, tone="", answer="", strong=false, iconLight=keyed.iconLight, iconDark=keyed.iconDark)
      // TimelineRowTimestamp: the full date in a tooltip once the time shows.
      box position=(hovering ? "relative" : "absolute") opacity=(hovering ? 1 : 0) flex-shrink=0 margin-right="0.25rem"
        RowTip(label=(hovering ? message.timeTip : ""), side="top", align="center", offset=20, shown=(over == "time"), hover=hover("time"))
          text message.timestamp font-size="0.75rem" line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"

// What one row of an expanded group adds over a compact row: its size less 1.5rem while open, 0 shut.
shape EntryExtra
  id: string
  extra: number

// A work group's entries: standalone rows, or an expanded group's list with its own scroll
// (ExpandedWorkGroupEntries): capped at min(18rem, 50dvh) plus what its open rows add over a
// compact row (expandedContentHeight). Each row reports its own extra from its element resize
// event; only an open row counts, so a shut row taller than a compact line (a provider error's
// detail, a retry) adds nothing, as the reference sums `expandedEntries` only. Contract has no list
// sum: `opened` keeps the running total as the reports come (timeline-work-rows TH-4).
component WorkEntries
  inject
    rem: number
  props
    message: Message
    command: action
  state extras = filter([EntryExtra(id="", extra=0)], (e) => e.id != "")
  state opened = 0
  action entrySized(id: string, extra: number)
    let previous = match first(filter(extras, (e) => e.id == id)) { case some(e) => e.extra, case none => 0 }
    opened = max(0, opened - previous + extra)
    extras = concat(filter(extras, (e) => e.id != id), [EntryExtra(id=id, extra=extra)])
  view
    when message.kind == "details"
      scroll width="100%" max-height=`calc(min(${18 * rem}px, 50dvh) + ${opened}px)` overflow-x="hidden" aria-label="Tool calls" testId=`tool-calls-${message.id}`
        column width="100%"
          each entry in message.activities key=`${entry.id}\t${entry.label}`
            WorkEntry(entry=entry, grouped=true, command=command, code=message.code, codeSize=message.md.codeSize, sized=entrySized)
    else
      column width="100%"
        each entry in message.activities key=`${entry.id}\t${entry.label}`
          WorkEntry(entry=entry, grouped=false, command=command, code=message.code, codeSize=message.md.codeSize, sized=entrySized)

// TimelineHistoryControl: "Load earlier turns" leads the scrolling timeline and
// a failed load reads as a centred status line beneath it.
component HistoryControl
  props
    lane: number
    hasMore: bool
    loading: bool
    error: string
    busy: bool
    load: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    column width="100%" max-width=lane padding-bottom="0.5rem" gap="0.375rem" box-sizing="border-box"
      when hasMore
        button hover=setHover press=load disabled=(busy or loading) aria-label="Load earlier turns" testId="load-earlier" width="100%" padding-top="0.375rem" padding-bottom="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" justify-content="center"
          text (loading ? "Loading earlier turns…" : "Load earlier turns") font-size="0.75rem" line-height="1rem" color=(hovering and not loading ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b99, #81818199)")
      when error != ""
        text error role="status" testId="history-error" width="100%" text-align="center" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// .topbar-scroll-fade: rows fade out over the first 24pt below the header.
component TimelineFade
  props
    canvas: string
  view
    box position="absolute" top=0 left=0 right=0 height="1.5rem" pointer-events="none" background-color=canvas mask-image="linear-gradient(to bottom, #000000 0%, #000000e6 10%, #000000b3 24%, #0000006b 42%, #0000002e 62%, #0000000a 82%, #00000000 100%)" aria-hidden=true

// ChatView's "Edit from here?" AlertDialog: rewind the conversation to before
// the message, keeping or reverting the files the later turns changed.
component RevertDialog
  props
    busy: bool
    answer: action
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" testId="revert-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="alertdialog" aria-label="Edit from here?" testId="revert-dialog"
        column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
          text "Edit from here?" font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "Rewind chat to before this message. Your prompt and attachments return to the composer." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          button press=answer("cancel") disabled=busy aria-keyshortcuts="Escape" testId="revert-cancel" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button press=answer("files") disabled=busy testId="revert-files" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 opacity=(busy ? 0.64 : 1) background-color="#dc2626"
            text "Revert files too" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
          button press=answer("keep") disabled=busy testId="revert-keep" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 opacity=(busy ? 0.64 : 1) background-color="light-dark(#1b4ed8, #346bf1)"
            text "Revert and keep changes" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
