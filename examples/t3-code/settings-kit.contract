// Settings building blocks for the routes the settings-rest lane owns. Sizes
// and colors are the reference build's computed values (settingsLayout.tsx,
// SettingsGroup.tsx, ui/switch.tsx, ui/select.tsx, ui/button.tsx) at 1x, light
// and dark: CSS px are points.
use LucideChevronDown from "./settings-icons.contract"
use LucideInfo from "./settings-icons.contract"
use LucideTriangleAlert from "./settings-icons.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"

shape SelectOption
  value: string
  label: string
  selected: bool

style SkTitle
  font-size="0.875rem" font-weight=400 line-height="1.25rem" color="light-dark(#262629b3, #f5f5f5b3)"
style SkCard
  display="flex" flex-direction="column" width="100%" box-sizing="border-box"
  border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)"
  background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
style SkRowTitle
  font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
style SkRowText
  font-size="0.75rem" font-weight=400 line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
style SkMuted
  font-size="0.75rem" font-weight=400 line-height="1rem" color="light-dark(#71717b, #818181)"
style SkInk
  color="light-dark(#27272a, #f5f5f5)"
style SkDivider
  border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
style SkOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem"
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem"
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
style SkGhost
  display="flex" flex-direction="row" align-items="center" justify-content="center"
  box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color="#00000000" flex-shrink=0
style SkField
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.625rem"
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#fcfcfc, #ffffff07)" font-size="0.875rem" line-height="1.25rem"
  color="light-dark(#27272a, #f5f5f5)" min-width=0
style SkError
  font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)"

// SettingsSection: a muted 14px heading over a grouped card (space-y-2.5).
component SettingsSection
  props
    title: string
    sectionId: string
  slot
  view
    column width="100%" gap="0.625rem" testId=sectionId
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" gap="0.5rem" box-sizing="border-box"
        text title class=SkTitle role="heading" aria-level=2
      column class=SkCard
        children

// SettingsRow: title and description beside a right-aligned control (the
// reference's @min-[32rem] grid: minmax(0,1fr) / auto, gap 32px).
component SettingsRow
  props
    title: string
    description: string
    first: bool
    rowId: string
  slot
  view
    row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" class=SkDivider border-top-width=(first ? 0 : 1) testId=rowId
      column flex=1 min-width=0 gap="0.25rem"
        row min-height="1.25rem" align-items="center" gap="0.375rem"
          text title class=SkRowTitle role="heading" aria-level=3
        when description != ""
          text description class=SkRowText max-width="36rem"
      // grid-cols-[minmax(0,1fr)_minmax(10rem,auto)]: the control column is at least 160pt.
      row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end" gap="0.5rem"
        children

// ui/switch.tsx: 30x18 track, 14px thumb, primary when checked.
component SettingsSwitch
  props
    checked: bool
    label: string
    disabled: bool
    switchId: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled id=switchId testId=switchId display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") width="1.875rem" height="1.125rem" padding="0.125rem" box-sizing="border-box" border-width=0 border-radius="0.5625rem" flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
      box width="0.875rem" height="0.875rem" border-radius="0.4375rem" flex-shrink=0 background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 1px 3px #0000000d"

// ui/select.tsx size="sm" trigger; the popup is the platform's menu.
component SettingsSelect
  props
    selectId: string
    label: string
    valueLabel: string
    // The chosen value when the caller keeps it as local state (a dialog draft); "" reads each option's own selected.
    value: string
    width: number
    disabled: bool
    options: list<SelectOption>
    choose: action
  // fix-keyboard-focus: Enter or Space opens the menu from the keyboard (menu-keys.contract).
  state keyed = 0
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = keyed + 1
  view
    button popovertarget=`${selectId}-menu` key=triggerKey role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId class=SkField display="flex" flex-direction="row" align-items="center" gap="0.375rem" width=width opacity=(disabled ? 0.64 : 1)
      // SelectTrigger is text-left: a button centres its text by default.
      text valueLabel font-size="0.875rem" line-height="1.25rem" class=SkInk flex=1 min-width=0 line-clamp=1 text-align="left"
      LucideChevronDown(size=12, color="light-dark(#71717b, #818181)")
    SkPopup(menuId=`${selectId}-menu`, label=label, width=width, list=true, endAlign=0, items=map(options, (option) => KmItem(id=`${selectId}-option-${option.value}`, label=option.label)), keyed=keyed)
      each option in options key=option.value
        SkMenuItem(label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=(value == "" ? option.selected : option.value == value), check=true, destructive=false, disabled=false, choose=choose(option.value))

// The reference's Select/Menu popup (rounded-lg border bg-popover p-1
// shadow-lg), painted by the kernel so every host shows the same surface,
// 4pt under its invoker (sideOffset 4). endAlign > 0 is the invoker's width:
// the popup's right edge meets the invoker's (MenuPopup align="end"). Its
// margins place it only under a position-area (LLP 1021 "Placement"): without
// one the painted layer puts the popup's top-left at the invoker's bottom-left.
component SkPopup
  props
    menuId: string
    label: string
    width: number
    list: bool
    endAlign: number
    // fix-keyboard-focus: the menu's keyboard (menu-keys.contract): its enabled rows in order, and the
    // trigger's count of Enter and Space.
    items: list<KmItem>
    keyed: number
  slot
  view
    column id=menuId popover="auto" position="absolute" position-area="bottom span-right" margin-top="0.25rem" min-width=(width > 0 ? width : 160) width=(endAlign > 0 ? width : "auto") margin-left=(endAlign > 0 ? endAlign - width : 0)
      scroll width="100%" max-height="22.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role=(list ? "listbox" : "menu") aria-label=label testId=menuId
        column width="100%" padding="0.25rem" box-sizing="border-box"
          KeyMenu(menuId=`${menuId}-keys`, items=items, keyed=keyed, gap="0px")
            children

component SkMenuItem
  props
    label: string
    menuId: string
    itemId: string
    selected: bool
    check: bool
    destructive: bool
    disabled: bool
    choose: action
  state hovered = false
  state lit = false
  action hover(over: bool)
    hovered = over
  action focused(on: bool)
    lit = on
  // check: a SelectItem (ui/select.tsx), an option whose selected row keeps the
  // foreground/8% wash (data-selected) and no indicator; else a MenuItem.
  view
    button id=itemId press=choose popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role=(check ? "option" : "menuitem") aria-selected=(check and selected) testId=itemId display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(check and selected ? "light-dark(#27272a14, #f5f5f514)" : hovered or lit ? "light-dark(#27272a14, #f5f5f50f)" : "#00000000") opacity=(disabled ? 0.64 : 1)
      text label font-size="0.875rem" line-height="1.25rem" flex=1 min-width=0 white-space="nowrap" text-align="left" color=(destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")

// "Off" beside a retention switch, or the description of a disabled row.
component SettingsStatus
  props
    label: string
  view
    text label class=SkMuted

// The reference's SettingsScopeNotice / inline info line.
component SettingsNotice
  props
    message: string
    warning: bool
  view
    row width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="0.5rem" align-items="flex-start"
      box padding-top="0.1875rem"
        when warning
          LucideTriangleAlert(size=14, color="#fe9a00")
        else
          LucideInfo(size=14, color="#fe9a00")
      text message font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #818181)" flex=1 min-width=0

// ui/tooltip.tsx TooltipPopup side="top" over an icon-micro ghost-muted trigger
// (settingsLayout PolicyTooltip, the diagnostics stat details): shown while the
// pointer rests on the trigger or it holds keyboard focus. The popup is 320pt
// wide (max-w-80), centred over the 20pt trigger, 4pt above it; textWidth stands
// in for text-balance's narrower line box.
component InfoTip
  props
    label: string
    tip: string
    tipId: string
    textWidth: number
    surface: string
    border: string
    ink: string
  slot
  state hovered = false
  state focused = false
  action hover(over: bool)
    hovered = over
  action focusTip(on: bool)
    focused = on
  view
    box position="relative" width="1.25rem" height="1.25rem" flex-shrink=0
      button hover=hover focus=focusTip(true) blur=focusTip(false) aria-label=label aria-description=tip testId=tipId display="flex" flex-direction="row" align-items="center" justify-content="center" width="1.25rem" height="1.25rem" padding=0 box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(hovered or focused ? "light-dark(#27272a0f, #f5f5f50f)" : "#00000000")
        children
      when hovered or focused
        column position="absolute" left="-9.375rem" bottom="1.5rem" width="20rem" z-index=60 padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=border background-color=surface box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" role="tooltip" testId=`${tipId}-tooltip`
          text tip font-size="0.75rem" line-height="1.03125rem" color=ink max-width=textWidth
