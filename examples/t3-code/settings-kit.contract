// Settings building blocks for the settings routes. Sizes
// and colors are the reference build's computed values (settingsLayout.tsx,
// SettingsGroup.tsx, ui/switch.tsx, ui/select.tsx, ui/button.tsx) at 1x, light
// and dark: CSS px are points.
use LucideChevronDown from "./settings-icons.contract"
use LucideInfo from "./settings-icons.contract"
use LucideTriangleAlert from "./settings-icons.contract"
use KmItem from "./menu-keys.contract"
use kmTriggerKey from "./menu-keys.contract"
use kmTriggerTarget from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use hoverTipAtFrame from "./hover-layer.contract" // PolicyTip

shape SelectOption
  value: string
  label: string
  selected: bool

style SkTitle
  font-size="0.875rem" font-weight=400 line-height="1.25rem" color="light-dark(#262629b3, #f5f5f5b3)"
style SkCard
  display="flex" flex-direction="column" width="100%" box-sizing="border-box"
  border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)"
  background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
style SkRowTitle
  font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
style SkRowText
  font-size="0.75rem" font-weight=400 line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
style SkMuted
  font-size="0.75rem" font-weight=400 line-height="1rem" color="light-dark(#71717b, #818181)"
style SkInk
  color="light-dark(#27272a, #f5f5f5)"
style SkDivider
  border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
style SkOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem"
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem"
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
style SkGhost
  display="flex" flex-direction="row" align-items="center" justify-content="center"
  box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color="#00000000" flex-shrink=0
style SkField
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.625rem"
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#fcfcfc, #ffffff07)" font-size="0.875rem" line-height="1.25rem"
  color="light-dark(#27272a, #f5f5f5)" min-width=0
style SkError
  font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)"

// SettingsSection: a muted 14px heading over a grouped card (space-y-2.5).
component SettingsSection
  props
    title: string
    sectionId: string
  slot
  view
    column width="100%" gap="0.625rem" testId=sectionId
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" gap="0.5rem" box-sizing="border-box"
        text title class=SkTitle role="heading" aria-level=2
      column class=SkCard
        children

// SettingsRow: title and description beside a right-aligned control (the
// reference's @min-[32rem] grid: minmax(0,1fr) / auto, gap 32px).
component SettingsRow
  props
    title: string
    description: string
    first: bool
    rowId: string
  slot
  view
    row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" class=SkDivider border-top-width=(first ? 0 : 1) testId=rowId
      column flex=1 min-width=0 gap="0.25rem"
        row min-height="1.25rem" align-items="center" gap="0.375rem"
          text title class=SkRowTitle role="heading" aria-level=3
        if description != ""
          text description class=SkRowText max-width="36rem"
      // grid-cols-[minmax(0,1fr)_minmax(10rem,auto)]: the control column is at least 160pt.
      row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end" gap="0.5rem"
        children

// ui/switch.tsx: 30x18 track, 14px thumb, primary when checked.
component SettingsSwitch
  props
    checked: bool
    label: string
    disabled: bool
    switchId: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled id=switchId testId=switchId display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") width="1.875rem" height="1.125rem" padding="0.125rem" box-sizing="border-box" border-width=0 border-radius="0.5625rem" flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") title=""
      box width="0.875rem" height="0.875rem" border-radius="0.4375rem" flex-shrink=0 background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 1px 3px #0000000d"

// ui/select.tsx size="sm" trigger; the popup is the platform's menu.
component SettingsSelect
  props
    selectId: string
    label: string
    valueLabel: string
    // True while valueLabel is SelectValue's placeholder: ui/select.tsx colours it data-placeholder:text-placeholder.
    empty: bool
    // The chosen value when the caller keeps it as local state (a dialog draft); "" reads each option's own selected.
    value: string
    width: number
    disabled: bool
    options: SelectOption[]
    choose: action
  derive menuItems = options.map((option) => KmItem(id=`${selectId}-option-${option.value}`, label=option.label))
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`${selectId}-menu`, source=selectId)
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    box position="relative" width=width
      button popovertarget=`${selectId}-menu` key=triggerKey role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId class=SkField display="flex" flex-direction="row" align-items="center" gap="0.375rem" width=width opacity=(disabled ? 0.64 : 1) title=""
        // SelectTrigger is text-left: a button centres its text by default.
        text valueLabel font-size="0.875rem" line-height="1.25rem" class=SkInk color=(empty ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)") flex=1 min-width=0 line-clamp=1 text-align="left"
        LucideChevronDown(size=12, color="light-dark(#71717b, #818181)")
      SkPopup(menuId=`${selectId}-menu`, invoker=selectId, label=label, width=width, list=true, endAlign=0, items=menuItems, keyed=0)
        for option in options key=option.value
          SkMenuItem(keysId=`${selectId}-menu-keys`, label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=(value == "" ? option.selected : option.value == value), check=true, destructive=false, disabled=false, choose=choose(option.value))

// The reference's Select/Menu popup (rounded-lg border bg-popover p-1
// shadow-lg), painted by the kernel so every host shows the same surface,
// 4pt under its invoker (sideOffset 4), flipping near the window's edge as
// Base UI's collision avoidance does. endAlign > 0 (the callers pass the
// invoker's width) ends it at the invoker's right edge (MenuPopup align="end",
// `bottom span-left`); 0 starts it at the invoker's left (`bottom span-right`).
component SkPopup
  inject
    dialogMenuEntered: action
  props
    menuId: string
    invoker: string
    label: string
    width: number
    list: bool
    endAlign: number
    // Enabled rows in order; public triggers focus their opening row directly.
    items: KmItem[]
    keyed: number
  slot
  view
    column id=menuId data-dialog-return="menu" focusin=dialogMenuEntered(menuId, invoker) popover="auto" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" position-area=(endAlign > 0 ? "bottom span-left" : "bottom span-right") margin-top="0.25rem" min-width=(width > 0 ? width : 160) width=(endAlign > 0 ? width : "auto")
      scroll width="100%" max-height="22.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role=(list ? "listbox" : "menu") aria-label=label testId=menuId
        column width="100%" padding="0.25rem" box-sizing="border-box"
          KeyMenu(menuId=`${menuId}-keys`, items=items, keyed=keyed, gap="0px", modal=true)
            children

component SkMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    menuId: string
    itemId: string
    selected: bool
    check: bool
    destructive: bool
    disabled: bool
    choose: action
  state lit = false
  action hover(over: bool)
    if over and not disabled
      focus(itemId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  // check: a SelectItem (ui/select.tsx), an option whose selected row keeps the
  // foreground/8% wash (data-selected) and no indicator; else a MenuItem.
  view
    button id=itemId press=choose popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role=(check ? "option" : "menuitem") aria-selected=(check and selected) testId=itemId display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(check and selected ? "light-dark(#27272a14, #f5f5f514)" : lit ? "light-dark(#27272a14, #f5f5f50f)" : "#00000000") opacity=(disabled ? 0.64 : 1)
      text label font-size="0.875rem" line-height="1.25rem" flex=1 min-width=0 white-space="nowrap" text-align="left" color=(destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")

// A heading VoiceOver reads and nothing draws, as Tailwind's `sr-only` (1px, clipped, out of
// flow): SettingsSection's `hideTitle` `<h2 className="sr-only">` (Appearance's "Colors & themes", the Project page's
// "Project", Scheduled Tasks' environment). (General's Legacy features holds its `<h2>` inside its trigger, a drawn
// heading in the button, since main #451 keeps a heading inside a Mac button.)
component SettingsSrHeading
  props
    title: string
    level: number
  view
    text title role="heading" aria-level=level position="absolute" width=1 height=1 overflow="hidden" opacity=0 pointer-events="none"

// "Off" beside a retention switch, or the description of a disabled row.
component SettingsStatus
  props
    label: string
  view
    text label class=SkMuted

// The reference's SettingsScopeNotice / inline info line.
component SettingsNotice
  props
    message: string
    warning: bool
  view
    row width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="0.5rem" align-items="flex-start"
      box padding-top="0.1875rem"
        if warning
          LucideTriangleAlert(size=14, color="#fe9a00")
        else
          LucideInfo(size=14, color="#fe9a00")
      text message font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #818181)" flex=1 min-width=0

// settingsLayout PolicyTooltip: the icon-micro ghost-muted "Background policy details" button whose TooltipPopup
// (side="top", delay 200) says how a setting meets the shared Background activity policy: General's Background
// activity, Providers' Health check interval and Source Control's Git fetch interval.
// The window's hover layer draws the popup (hover-layer.contract, kind "policy"), as the reference portals every
// TooltipPopup, so the card or scroll around the row never cuts it. Hover or keyboard focus shows it; the slot is the
// page's info icon. Agent mode hovers it with `tap <tipId> hover`; the popup's test id is `<tipId>-tooltip`.
component PolicyTip
  inject
    rem: number
    hoverTipAt: action
  props
    tip: string
    tipId: string
  slot
  state hovered = false
  state focused = false
  action show(on: bool)
    hoverTipAt(hoverTipAtFrame(tipId, "policy", tip, [], "top", "center", frame(tipId), (floor(tip.length / 48) + 1) * rem + 0.625 * rem, `${tipId}-tooltip`), "trigger", on)
  action hover(over: bool)
    hovered = over
    show(over)
  action focusTip(on: bool)
    focused = on
    show(on)
  view
    button id=tipId hover=hover focus=focusTip(true) blur=focusTip(false) aria-label="Background policy details" aria-description=tip testId=tipId display="flex" flex-direction="row" align-items="center" justify-content="center" width="1.25rem" height="1.25rem" flex-shrink=0 padding=0 box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(hovered or focused ? "light-dark(#27272a0f, #f5f5f50f)" : "#00000000") title=""
      children
