// The root component's own reply and resource shapes (app.contract).
shape WorkspaceDiscovery
  key: string
  needed: bool
  timer: bool
  wake: number
shape WorkspaceRefresh
  key: string
  retry: bool
  wake: number
shape TimelineReadsResult
  complete: bool
shape Time
  epochAtZero: number
// exactPage(): the window's visibility and focus (document.visibilityState, document.hasFocus(); exact2 #219).
shape Page
  visibilityState: string
  hasFocus: bool
