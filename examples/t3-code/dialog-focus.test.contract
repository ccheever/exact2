// dialog-initial-focus-and-model-prices: a modal dialog takes the focus as it opens (dialog-trap.contract DialogOpenFocus,
// Base UI's initialFocus) and gives it back to the control that opened it as it closes (DialogFinalFocus, Base UI's
// finalFocus), through the app's own handlers and the host's `resize` events. The keys go to the window's main node, which
// takes no focus, so they reach whatever holds the focus, as a person's keyboard does; Enter then presses the focused
// control, and the state says which one that was. No click lands in a dialog before its first key.
// dialog-trap.test.ts checks every dialog's wiring. Each test relaunches the app. It needs the audit lane's T3 home and
// nightly runtime, whose two provider-update notices cover the Settings openers until they are dismissed (the second
// takes taps once the first has gone):
//   EXACT_ROOT=<worktree> target/t3-audit/clone-drive.sh <lane> <port> --test examples/t3-code/dialog-focus.test.contract
// The `clock +N real` steps let the embedded server start and answer, as a person waits for it.

test "Add provider: Tab from the focus it opens with reaches Identity, and Escape gives the focus back to Add provider"
  clock +20000 real
  clock +3000 real
  tap "Dismiss notification"
  clock +2500 real
  tap "Dismiss notification"
  clock +1000 real
  tap "connection-settings"
  clock +1500 real
  tap "settings-providers"
  clock +2500 real
  tap "add-provider"
  clock +2000 real
  expect state providerDialog == "add"
  expect state wizardStep == 0
  // The focus opened on "1 Provider": Tab goes on to "2 Identity", which Enter presses.
  type "t3-code" key "Tab"
  type "t3-code" key "Enter"
  clock +500 real
  expect state wizardStep == 1
  type "t3-code" key "Escape"
  clock +1200 real
  expect state providerDialog == ""
  // The focus is back on Add provider: Enter opens the dialog again.
  type "t3-code" key "Enter"
  clock +1500 real
  expect state providerDialog == "add"

test "New task: Escape gives the focus back to New task"
  clock +20000 real
  clock +3000 real
  tap "Dismiss notification"
  clock +2500 real
  tap "Dismiss notification"
  clock +1000 real
  tap "connection-settings"
  clock +1500 real
  tap "settings-scheduled-tasks"
  clock +2000 real
  tap "new-scheduled-task"
  clock +1500 real
  expect state restEditor == "task"
  type "t3-code" key "Escape"
  clock +1200 real
  expect state restEditor == ""
  type "t3-code" key "Enter"
  clock +1500 real
  expect state restEditor == "task"

test "Model prices opens on Limits, and Escape gives the focus back to the environment menu's trigger"
  clock +20000 real
  clock +3000 real
  tap "open-usage"
  clock +3000 real
  tap "usage-metric-limits"
  clock +2500 real
  tap "usage-environment"
  clock +1200 real
  tap "usage-model-prices"
  clock +2500 real
  expect state usage.prices.open == true
  expect tree has "usage-prices-dialog"
  type "t3-code" key "Escape"
  clock +1500 real
  expect state usage.prices.open == false
  // The focus is back on the environment menu's trigger: Enter opens its menu, Model prices in it.
  type "t3-code" key "Enter"
  clock +1200 real
  expect tree has "usage-model-prices"
