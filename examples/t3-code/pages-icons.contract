fn pgPath(name: string): string = pgPath0(name) != "" ? pgPath0(name) : pgPath1(name) != "" ? pgPath1(name) : ""
fn pgFilled(name: string): bool = name == "triangle-fill-filled" or name == "dot-filled"

component PgIcon
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=pgPath(name) fill=(pgFilled(name) ? "currentColor" : "none")

// The same geometry at another stroke weight (the conflict badge draws at 2.5).
component PgGlyph
  props
    name: string
    size: number
    color: string
    weight: number
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=weight stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=pgPath(name) fill=(pgFilled(name) ? "currentColor" : "none")
