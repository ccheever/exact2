// Lane r4-polish: sidebar control tooltips the round-3 Tip did not cover
// (MIT reference, see LICENSE-T3), drawn with shell-tip.contract's card style:
// - SidebarHeaderIconButton's two-part tooltip (SidebarThreadHeader.tsx): the
//   New thread label, then "New thread in current project: Shift+click" in the
//   muted foreground 2pt below, only while more than one project group exists.
// - SidebarRail (ui/sidebar.tsx): "Drag to resize sidebar" on the right side,
//   4pt off the rail and centred on its full height (the window's), as Base UI
//   places a side="right" TooltipPopup on the 16pt full-height rail.
//   These and the other chrome tooltips (Filter, Add project, Settings, Pull
//   Requests, Usage) are drawn by SidebarOverlays from the root hover id, which
//   also gives the buttons the reference's hover fill and foreground icon.
// - SidebarProviderUpdatePill: the view's description over the pill body and
//   "Dismiss until provider status changes" over its ×, both side="top". The
//   pill clips (overflow hidden), so the bubbles sit outside it.
use TipCard from "./shell-tip.contract"
use SidebarIcon from "./sidebar-icons.contract"

// TooltipPopup with a muted second line (`detail`); a single line without it.
component TipCard2
  props
    label: string
    detail: string
    shown: bool
  view
    column max-width=320 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 gap=2 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(shown ? 1 : 0) transition=(shown ? "opacity 150ms ease 600ms" : "opacity 0ms") pointer-events="none" role="tooltip" aria-hidden=(not shown) testId="tooltip"
      text label font-size=12 line-height="16.5px" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
      when detail != ""
        text detail font-size=12 line-height="16.5px" white-space="nowrap" color="light-dark(#71717b, #818181)"

// The resize rail itself is r5-shell.contract's SidebarWindowRail; its tooltip is SidebarEdgeTips'.

// The window-level bubbles (SidebarOverlays) for the sidebar's chrome
// controls, which hover the root sidebar hover id: a TooltipPopup inside the
// sidebar paints under the page wherever it reaches past the sidebar, and a
// hover reaches only the innermost hover handler, so one owner draws them all.
// - Rail: side right, its card 4pt past the reference's 16pt rail (11pt past
//   the sidebar's edge), centred on the window's height.
// - Search row (SidebarHeaderIconButton): side top, 4pt above the 28pt buttons
//   (62pt down), centred 78/50/22pt in from the sidebar's edge.
// - Footer (SidebarUtilityItem): side top, 4pt above the 32pt buttons (36pt
//   up from the bottom); Settings aligns to its start at 8pt, Pull Requests and
//   Usage are centred at 60 and 60 or 96pt.
component SidebarEdgeTips
  props
    width: number
    hoverId: string
    newThread: string
    newThreadDetail: string
    pullRequests: bool
  view
    row position="absolute" left=(width + 11) top=0 bottom=0 align-items="center" pointer-events="none" z-index=140
      TipCard(label="Drag to resize sidebar", shown=(hoverId == "sidebar-rail"))
    row position="absolute" left=(width - 278) width=400 top=0 height=58 align-items="flex-end" justify-content="center" pointer-events="none" z-index=140
      TipCard(label="Filter threads by project", shown=(hoverId == "sidebar-filter"))
    row position="absolute" left=(width - 250) width=400 top=0 height=58 align-items="flex-end" justify-content="center" pointer-events="none" z-index=140
      TipCard(label="Add project", shown=(hoverId == "sidebar-add-project"))
    row position="absolute" left=(width - 222) width=400 top=0 height=58 align-items="flex-end" justify-content="center" pointer-events="none" z-index=140
      TipCard2(label=newThread, detail=newThreadDetail, shown=(hoverId == "sidebar-new-thread"))
    row position="absolute" left=8 bottom=40 pointer-events="none" z-index=140
      TipCard(label="Settings", shown=(hoverId == "sidebar-settings"))
    row position="absolute" left=-140 width=400 bottom=40 justify-content="center" pointer-events="none" z-index=140
      TipCard(label="Pull Requests", shown=(hoverId == "sidebar-pull-requests"))
    row position="absolute" left=(pullRequests ? -104 : -140) width=400 bottom=40 justify-content="center" pointer-events="none" z-index=140
      TipCard(label="Usage", shown=(hoverId == "sidebar-usage"))

// SidebarProviderUpdatePill: an update in flight or its outcome; the body opens Settings › Providers.
component ProviderPill
  props
    tone: string
    title: string
    description: string
    dismissible: bool
    open: action
    dismiss: action
  state overBody = false
  state overClose = false
  action setBody(value: bool)
    overBody = value
  action setClose(value: bool)
    overClose = value
  derive ink = tone == "warning" ? "#fe9a00" : tone == "error" ? "light-dark(#e7000b, #fb2c36)" : "light-dark(#27272a, #f1f3f7)"
  view
    column position="relative" margin-left=8 margin-right=8 margin-top=4 margin-bottom=4 flex-shrink=0
      row width="100%" min-height=28 box-sizing="border-box" border-radius=10 overflow="hidden" align-items="center" background-color=(tone == "warning" ? "#fe9a001f" : tone == "error" ? "light-dark(#e7000b1f, #fb2c361f)" : "light-dark(#f4f4f5, #0a0a0a)") testId="sidebar-provider-pill"
        button press=open hover=setBody aria-label=description testId="sidebar-provider-pill-open" flex=1 min-width=0 padding-left=8 padding-right=8 padding-top=6 padding-bottom=6 box-sizing="border-box" gap=8 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          SidebarIcon(name=(tone == "loading" ? "loader" : tone == "success" ? "circle-check" : tone == "error" ? "triangle-alert" : "download"), size=14, color=ink)
          text title flex=1 min-width=0 font-size=11 line-height="16px" font-weight=500 text-align="left" color=ink
        when dismissible
          button press=dismiss hover=setClose aria-label="Dismiss provider update notice" testId="sidebar-provider-pill-dismiss" width=20 height=20 margin-right=4 padding=0 flex-shrink=0 border-radius=6 border-width=0 background-color="#00000000" opacity=(overClose ? 1 : 0.7) display="flex" flex-direction="row" align-items="center" justify-content="center"
            SidebarIcon(name="x", size=14, color=(tone == "warning" ? "#fe9a00" : "light-dark(#e7000b, #fb2c36)"))
      when description != ""
        row position="absolute" bottom="100%" left=-200 right=(dismissible ? -176 : -200) padding-bottom=4 justify-content="center" pointer-events="none" z-index=140
          TipCard(label=description, shown=(overBody and not overClose))
      when dismissible
        row position="absolute" bottom="100%" right=-196 width=420 padding-bottom=4 justify-content="center" pointer-events="none" z-index=140
          TipCard(label="Dismiss until provider status changes", shown=overClose)
