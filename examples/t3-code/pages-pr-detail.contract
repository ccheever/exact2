// The pull request detail panel (lane "pages"), measured against the served
// reference at 1280×840: the right panel's tab strip, PullRequestDetailPanel's
// header (repository and number, the actions menu, title, author, checkout
// command, branches and diff stat), the Summary/Timeline tabs and the checks
// rollup. Sources: T3 Code (MIT, see LICENSE-T3) components/pullRequest/
// {PullRequestDetailPanel,PullRequestSummaryTab,PullRequestTimelineTab}.tsx.
use Icon from "./icons.contract"
use PgIcon from "./pages-icons.contract"
use ChatMarkdown from "./markdown.contract"
use ChatDocument from "./markdown.contract"
use CodeHighlight from "./markdown.contract"
use MarkdownEnv from "./markdown.contract"
use PrChip from "./pages-prs.contract"
use PrAvatar from "./pages-prs.contract"
use PrMenuBox from "./pages-prs.contract"
use PrSummaryView from "./pages-pr-summary.contract"
use PrdSummary from "./pages-pr-summary.contract"
use PrTimelineView from "./pages-pr-timeline.contract"
use PrdTimeline from "./pages-pr-timeline.contract"
use PrdTimelineBar from "./pages-pr-timeline.contract"
use PrGhost from "./pages-pr-ghost.contract"
use PrdGhost from "./pages-pr-ghost.contract"
use PrActionsView from "./pages-pr-actions.contract"
use PrdHeaderActions from "./pages-pr-actions.contract"
use PrdBaseBranch from "./pages-pr-actions.contract"
use PrdApproveWorkflows from "./pages-pr-actions.contract"
use PrWrites from "./pages-pr-compose.contract"
use PrdComposer from "./pages-pr-compose.contract"
use PrdTitle from "./pages-pr-edit.contract"

// PullRequestCopyableCode: the value and "Copied" cross-fade (150ms) for the
// hook's 1.6s; two names let a second copy restart it.
keyframes prdShownA
  from opacity=0
  9% opacity=1
  91% opacity=1
  to opacity=0
keyframes prdShownB
  from opacity=0
  9% opacity=1
  91% opacity=1
  to opacity=0
keyframes prdHiddenA
  from opacity=1
  9% opacity=0
  91% opacity=0
  to opacity=1
keyframes prdHiddenB
  from opacity=1
  9% opacity=0
  91% opacity=0
  to opacity=1

shape PrPerson
  key: string
  login: string
  avatar: string
  initial: string
shape PrBody
  id: string
  kind: string
  title: string
  body: string
shape PrDetailView
  open: bool
  loading: bool
  phase: string
  error: string
  errorTitle: string
  githubUrl: string
  copiedCheckout: number
  copiedBranch: number
  ref: string
  number: number
  numberLabel: string
  title: string
  repository: string
  url: string
  linkMenu: string
  state: string
  stateLabel: string
  conflict: string
  author: string
  authorAvatar: string
  authorInitial: string
  updated: string
  checkoutCommand: string
  baseBranch: string
  headBranch: string
  files: string
  additions: string
  deletions: string
  checksSummary: string
  checksTone: string
  reviewers: list<PrPerson>
  labels: list<PrChip>
  bodies: list<PrBody>
  hasBody: bool
  bodyId: string
  commentCount: number
  commentsLabel: string
  activityPending: bool
  activityError: string
  ghost: PrGhost
  summary: PrSummaryView
  timeline: PrTimelineView
  // pr-writing-and-metadata (pages-pr-writes.ts): the composer, the editors and the pickers.
  writes: PrWrites
  canEdit: bool
  canClose: bool
  canReopen: bool
  canDraft: bool
  canReady: bool
  canMerge: bool
  canUpdateBranch: bool
  canReview: bool
  canLabel: bool
  projectId: string
  host: string
  hostName: string
  code: list<CodeHighlight>
  // r4-timeline: Settings → Appearance code font, size and word wrap for the Markdown.
  md: MarkdownEnv
  diffScheme: string
  // pr-header-actions-and-stacks: the primary control, the More menu, the dialogs, the base branch's mark, the stack.
  actions: PrActionsView

fn prdTone(lifecycle: string): string = lifecycle == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : lifecycle == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : lifecycle == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"
fn prdIcon(lifecycle: string): string = lifecycle == "draft" ? "git-pull-request-draft" : lifecycle == "closed" ? "git-pull-request-closed" : lifecycle == "merged" ? "git-merge" : "git-pull-request-arrow"
fn prdCheckIcon(status: string): string = status == "failure" or status == "cancelled" ? "circle-x" : status == "pending" or status == "action-required" ? "circle-dot" : status == "success" ? "circle-check" : "circle-dashed"
fn prdCheckTone(status: string): string = status == "failure" or status == "cancelled" ? "light-dark(#e40014, #fb414a)" : status == "pending" or status == "action-required" ? "light-dark(#e17100, #ffb900e6)" : status == "success" ? "light-dark(#009966, #5ee9b5e6)" : "light-dark(#71717b, #818181)"

// RightPanelTabs (inline) around the detail: the pull request's tab, then the panel body.
component PrPanel
  props
    detail: PrDetailView
    documents: list<ChatDocument>
    scheme: string
    width: number
    tab: string
    setTab: action
    close: action
    reload: action
    act: action
    copy: action
    local: action
    still: bool
    select: action
    compact: bool
  view
    column width=width height="100%" flex-shrink=0 box-sizing="border-box" border-left-width=1 border-left-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fcfcfc, #0a0a0a)" testId="pull-request-panel"
      row height=52 flex-shrink=0 width="100%" padding-left="0.5rem" padding-right="3.5rem" box-sizing="border-box" align-items="center" gap="0.25rem"
        row height="1.5rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" gap="0.125rem" border-radius="0.5rem" background-color="light-dark(#27272a0d, #ffffff0a)" align-items="center" role="tab" aria-selected=true testId="pull-request-tab"
          PrTabClose(detail=detail, close=close)
          text detail.numberLabel font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
      PrdBody(detail=detail, documents=documents, scheme=scheme, tab=tab, setTab=setTab, reload=reload, act=act, copy=copy, local=local, still=still, select=select, compact=compact, scrollId="pr-page-scroll")

// The panel's body, shared with the thread's pull request surface (r5-panels.contract): the
// ghost while the detail is out, the unavailable state, or the header, the tab bar and both tabs.
// Both tabs stay mounted (hidden with `display`), keyed by the pull request, so the comment
// window, the orders and the open groups survive a visit to the other tab and start fresh for
// another pull request (PullRequestDetailPanel mountedTabs, keyed by tabScopeKey).
component PrdBody
  props
    detail: PrDetailView
    documents: list<ChatDocument>
    scheme: string
    tab: string
    setTab: action
    reload: action
    act: action
    copy: action
    local: action
    still: bool
    select: action
    // The header's container is narrower than 30rem: its control labels go (`@max-[30rem]/pr-header:hidden`).
    compact: bool
    scrollId: string
  state timelineOrder = "newest"
  // The body's scroll offset, and an offset to move it to (a section collapsing under a pinned heading).
  state bodyTop = 0
  state anchored = 0
  state anchorSerial = 0
  action flipTimeline
    timelineOrder = timelineOrder == "newest" ? "oldest" : "newest"
  action bodyScrolled(x: number, y: number)
    bodyTop = y
  action anchorTo(y: number)
    anchored = y
    anchorSerial = anchorSerial + 1
  view
    when detail.phase == "ghost"
      PrdGhost(ghost=detail.ghost, number=detail.number, checkout=detail.checkoutCommand, tab=tab, still=still)
    when detail.phase == "error"
      PrUnavailable(detail=detail, reload=reload)
    when detail.phase == "content"
      // A repeated anchor to the same offset still moves the box (the serial's sub-pixel nudge).
      scroll id=scrollId scroll=bodyScrolled scrollTop=(anchored + (anchorSerial % 2) * 0.01) flex=1 min-height=0 width="100%" testId="pull-request-scroll"
        column width="100%" padding-bottom="4rem" box-sizing="border-box"
          PrdHeader(detail=detail, scheme=scheme, still=still, compact=compact, reload=reload, act=act, copy=copy, local=local, select=select)
          row width="100%" padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-top-width=1 border-bottom-width=1 border-top-style="solid" border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" align-items="center" gap="0.5rem" role="navigation" aria-label="Pull request tabs"
            row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="tablist"
              PrdTab(label="Summary", active=(tab != "timeline"), press=setTab("summary"), testId="pull-request-tab-summary")
              PrdTab(label="Timeline", active=(tab == "timeline"), press=setTab("timeline"), testId="pull-request-tab-timeline")
            box flex=1 min-width=0
            // showsApproveWorkflows takes the checks summary's place.
            when tab != "timeline" and detail.actions.approveWorkflows
              PrdApproveWorkflows(actions=detail.actions, ref=detail.ref, local=local)
            when tab != "timeline" and detail.checksSummary != "" and not detail.actions.approveWorkflows
              row align-items="center" gap="0.375rem" flex-shrink=0 aria-label=`Checks: ${detail.checksSummary}`
                when detail.checksTone != ""
                  PgIcon(name=prdCheckIcon(detail.checksTone == "passing" ? "success" : detail.checksTone == "failing" ? "failure" : "pending"), size=14, color=prdCheckTone(detail.checksTone == "passing" ? "success" : detail.checksTone == "failing" ? "failure" : "pending"))
                text detail.checksSummary font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap"
            when tab == "timeline"
              PrdTimelineBar(timeline=detail.timeline, dim=(detail.activityPending or detail.activityError != ""), order=timelineOrder, flip=flipTimeline)
          each prKey in [detail.summary.key] key=prKey
            column width="100%" display=(tab != "timeline" ? "flex" : "none") role="tabpanel" aria-label="Summary"
              PrdSummary(summary=detail.summary, labels=detail.labels, hasBody=detail.hasBody, bodyId=detail.bodyId, writes=detail.writes, documents=documents, code=detail.code, env=detail.md, still=still, local=local, act=act, refresh=reload, retry=act("activity-retry", "summary"), scrollId=scrollId, scrollTop=bodyTop, anchor=anchorTo)
            column width="100%" display=(tab == "timeline" ? "flex" : "none") role="tabpanel" aria-label="Timeline"
              PrdTimeline(timeline=detail.timeline, order=timelineOrder, pending=detail.activityPending, error=detail.activityError, choices=detail.writes.reactionChoices, scope=scrollId, documents=documents, code=detail.code, env=detail.md, still=still, local=local, act=act, retry=act("activity-retry", "timeline"))
      // PullRequestComposer floats over the content at the bottom right (no footer is reserved), keyed by
      // the pull request: a zero-height row under the scroll box is its anchor.
      when detail.writes.composer
        row position="relative" width="100%" height=0 flex-shrink=0
          each composerKey in [detail.writes.key] key=composerKey
            column position="absolute" right="1rem" bottom="0.75rem" z-index=20
              PrdComposer(writes=detail.writes, selected=detail.ref, scope=scrollId, act=act, local=local)

// The tab's leading slot: the lifecycle glyph, which becomes the close button.
component PrTabClose
  props
    detail: PrDetailView
    close: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=close hover=hover aria-label=`Close ${detail.numberLabel}` testId="pull-request-close" width="1rem" height="1rem" padding=0 border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#27272a14, #ffffff14)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      when over
        PgIcon(name="x", size=12, color="light-dark(#27272a, #f5f5f5)")
      else
        PgIcon(name=prdIcon(detail.state), size=12, color=prdTone(detail.state))

component PrdTab
  props
    label: string
    active: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover role="tab" aria-selected=active testId=testId height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(active ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(active ? "0 1px 2px #0000001a" : "none") display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(active or over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// Button size="xs" variant="outline": the header's actions.
// PullRequestsUnavailableState (Empty, md:p-12, gap-6): the stacked pull request
// glyph, its title ("Could not load pull requests", or "#N not found" for an
// issue link, 7bc161f869) and text, then Retry and Open on GitHub.
component PrUnavailable
  props
    detail: PrDetailView
    reload: action
  view
    column flex=1 min-height=0 width="100%" padding="3rem" box-sizing="border-box" align-items="center" justify-content="center" gap="1.5rem" testId="pull-request-error"
      box width="2.25rem" height="2.25rem" position="relative" margin-bottom="1.5rem" flex-shrink=0
        box position="absolute" left=0 bottom=1 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="-7.74px 0.48px" rotate=-10 scale=0.84
        box position="absolute" left=0 bottom=1 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="7.74px 0.48px" rotate=10 scale=0.84
        box position="absolute" left=0 top=0 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center"
          PgIcon(name="git-pull-request-arrow", size=18, color="light-dark(#27272a, #f5f5f5)")
      column max-width="24rem" align-items="center" flex-shrink=0
        text detail.errorTitle font-size="1.25rem" line-height="1.75rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="pull-request-error-title"
        text detail.error margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)" testId="pull-request-error-text"
      row flex-wrap="wrap" justify-content="center" gap="0.5rem" flex-shrink=0
        PrdOutline(icon="refresh-cw", label="Retry", press=reload, testId="pull-request-retry")
        when detail.githubUrl != ""
          link cursor="pointer" href=detail.githubUrl testId="pull-request-open-github" height="1.75rem" padding-left="0.4375rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center"
            PgIcon(name="external-link", size=14, color="light-dark(#71717b, #818181)")
            text "Open on GitHub" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

// Button size="sm" variant="outline": 28pt, a 14pt muted glyph pulled in 2pt (-mx-0.5), 6pt from the label.
component PrdOutline
  props
    icon: string
    label: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height="1.75rem" padding-left="0.4375rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color="light-dark(#71717b, #818181)")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

component PrdButton
  props
    icon: string
    label: string
    iconColor: string
    textColor: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color=iconColor)
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=textColor

component PrdHeader
  props
    detail: PrDetailView
    scheme: string
    still: bool
    compact: bool
    reload: action
    act: action
    copy: action
    local: action
    select: action
  view
    // Raised over the tab bar after it (z-index orders siblings), so the base branch's card paints on top.
    column width="100%" padding-left="1rem" padding-right="1rem" padding-bottom="1rem" box-sizing="border-box" position="relative" z-index=2
      row height="1.75rem" width="100%" align-items="center" gap="0.25rem"
        row min-width=0 flex=1 align-items="center" gap="0.25rem"
          text detail.repository font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)" line-clamp=1 min-width=0
          // PullRequestDetailPanel openNumberContextMenu: Copy link, Open on <host>.
          link cursor="pointer" href=detail.url contextmenu=local("pr-link-menu", "", detail.linkMenu) aria-label=`Open pull request ${detail.numberLabel} on host` testId="pull-request-open-host" display="flex" flex-direction="row" align-items="center" gap="0.125rem" flex-shrink=0
            text detail.numberLabel font-size="0.75rem" line-height="1rem" font-weight=500 color=prdTone(detail.state)
            PgIcon(name="external-link", size=10, color=prdTone(detail.state))
        PrdHeaderActions(actions=detail.actions, ref=detail.ref, url=detail.url, hostName=detail.hostName, numberLabel=detail.numberLabel, scheme=scheme, still=still, compact=compact, reload=reload, act=act, copy=copy, local=local, select=select)
      PrdTitle(title=detail.title, canEdit=detail.writes.canEditChange, saving=detail.writes.titleSaving, serial=detail.writes.titleSerial, still=still, act=act)
      row width="100%" min-height="1.25rem" margin-top="0.5rem" align-items="center" gap="0.375rem"
        PrAvatar(avatar=detail.authorAvatar, initial=detail.authorInitial, size=16)
        text detail.author font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 flex-shrink=1 min-width=0
        text "·" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b80, #81818180)" flex-shrink=0
        text detail.updated font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap" flex-shrink=0
        box flex=1 min-width=0
        when detail.checkoutCommand != ""
          PrdCopy(text=detail.checkoutCommand, ariaLabel="Copy checkout command", copied=detail.copiedCheckout, tone="light-dark(#71717b, #818181)", copy=copy, testId="pull-request-copy-checkout")
      row width="100%" min-height="1.25rem" margin-top="1rem" align-items="center" gap="0.5rem"
        row flex=1 min-width=0 align-items="center" gap="0.375rem"
          PrdBaseBranch(actions=detail.actions, ref=detail.ref, base=detail.baseBranch, scheme=scheme, act=act)
          box width="0.875rem" height="0.875rem" aria-label="receives changes from" flex-shrink=0
            PgIcon(name="arrow-left", size=14, color="light-dark(#71717bb3, #828282b3)")
          PrdCopy(text=detail.headBranch, ariaLabel="Copy pull request branch", copied=detail.copiedBranch, tone="light-dark(#71717bb3, #828282b3)", copy=copy, testId="pull-request-copy-branch")
        row flex-shrink=0 align-items="center" gap="0.5rem"
          row min-width="4rem" justify-content="flex-end" align-items="center" gap="0.375rem"
            PgIcon(name="file-diff", size=14, color="light-dark(#71717b, #818181)")
            text detail.files font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" white-space="nowrap"
          row align-items="baseline" gap="0.25rem"
            text detail.additions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#009966, #00d492)")
            text detail.deletions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)")

// A mono value that copies itself (the checkout command, the head branch);
// PullRequestCopyableCode swaps it for a centred "Copied" for 1.6s.
component PrdCopy
  props
    text: string
    ariaLabel: string
    copied: number
    tone: string
    copy: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=copy("", text) hover=hover aria-label=ariaLabel testId=testId height="1.25rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" min-width=0 flex-shrink=1 position="relative" text-align="left"
      text text font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=tone line-clamp=1 min-width=0 animation=(copied == 0 ? "none" : (copied % 2 == 0 ? "prdHiddenA 1.6s linear forwards" : "prdHiddenB 1.6s linear forwards"))
      when copied > 0
        row position="absolute" left="0.25rem" right="0.25rem" top="0.125rem" bottom="0.125rem" justify-content="center" align-items="center" animation=(copied % 2 == 0 ? "prdShownA 1.6s linear forwards" : "prdShownB 1.6s linear forwards") aria-hidden=true testId=`${testId}-copied`
          text "Copied" font-family=(testId == "pull-request-copy-checkout" ? "ui-monospace" : "system-ui") font-size="0.75rem" line-height="1rem" color=tone white-space="nowrap"
