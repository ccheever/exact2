// The pull request detail panel (lane "pages"), measured against the served
// reference at 1280×840: the right panel's tab strip, PullRequestDetailPanel's
// header (repository and number, the actions menu, title, author, checkout
// command, branches and diff stat), the Summary/Timeline tabs and the checks
// rollup. Sources: T3 Code (MIT, see LICENSE-T3) components/pullRequest/
// {PullRequestDetailPanel,PullRequestSummaryTab,PullRequestTimelineTab}.tsx.
use Icon from "./icons.contract"
use PgIcon from "./pages-icons.contract"
use ChatMarkdown from "./markdown.contract"
use ChatDocument from "./markdown.contract"
use CodeHighlight from "./markdown.contract"
use MarkdownEnv from "./markdown.contract"
use PrChip from "./pages-prs.contract"
use PrAvatar from "./pages-prs.contract"
use PrMenuBox from "./pages-prs.contract"
use PrPageBack from "./pages-prs.contract"
use PrSummaryView from "./pages-pr-summary.contract"
use PrdSummary from "./pages-pr-summary.contract"
use PrTimelineView from "./pages-pr-timeline.contract"
use PrdTimeline from "./pages-pr-timeline.contract"
use PrdTimelineBar from "./pages-pr-timeline.contract"
use PrGhost from "./pages-pr-ghost.contract"
use PrdGhost from "./pages-pr-ghost.contract"
use PrActionsView from "./pages-pr-actions.contract"
use PrdHeaderActions from "./pages-pr-actions.contract"
use PrdBaseBranch from "./pages-pr-actions.contract"
use PrdApproveWorkflows from "./pages-pr-actions.contract"
use PrWrites from "./pages-pr-compose.contract"
use PrdComposer from "./pages-pr-compose.contract"
use PrdTitle from "./pages-pr-edit.contract"
use PrHandoffsView from "./pages-pr-handoffs.contract"
use PrLinksView, PrPreviewView, PrActOnView, PrdBackArrow from "./pages-pr-links.contract" // pr-links-previews-and-routing
use PrCodeView from "./pages-pr-code.contract"
use PrdCode from "./pages-pr-code.contract"

// PullRequestCopyableCode: the value and "Copied" cross-fade (150ms) for the
// hook's 1.6s; two names let a second copy restart it.
keyframes prdShownA
  from opacity=0
  9% opacity=1
  91% opacity=1
  to opacity=0
keyframes prdShownB
  from opacity=0
  9% opacity=1
  91% opacity=1
  to opacity=0
keyframes prdHiddenA
  from opacity=1
  9% opacity=0
  91% opacity=0
  to opacity=1
keyframes prdHiddenB
  from opacity=1
  9% opacity=0
  91% opacity=0
  to opacity=1

shape PrPerson
  key: string
  login: string
  avatar: string
  initial: string
shape PrBody
  id: string
  kind: string
  title: string
  body: string
shape PrDetailView
  open: bool
  loading: bool
  phase: string
  error: string
  errorTitle: string
  githubUrl: string
  copiedCheckout: number
  copiedBranch: number
  ref: string
  number: number
  numberLabel: string
  title: string
  repository: string
  url: string
  linkMenu: string
  state: string
  stateLabel: string
  conflict: string
  author: string
  authorAvatar: string
  authorInitial: string
  updated: string
  // pr-handoffs-and-quick-actions: the condensed row's age ("3h ago") and file count.
  updatedAgo: string
  filesCount: string
  checkoutCommand: string
  baseBranch: string
  headBranch: string
  files: string
  additions: string
  deletions: string
  checksSummary: string
  checksTone: string
  reviewers: list<PrPerson>
  labels: list<PrChip>
  bodies: list<PrBody>
  hasBody: bool
  bodyId: string
  commentCount: number
  commentsLabel: string
  activityPending: bool
  activityError: string
  ghost: PrGhost
  summary: PrSummaryView
  timeline: PrTimelineView
  // pr-writing-and-metadata (pages-pr-writes.ts): the composer, the editors and the pickers.
  writes: PrWrites
  canEdit: bool
  canClose: bool
  canReopen: bool
  canDraft: bool
  canReady: bool
  canMerge: bool
  canUpdateBranch: bool
  canReview: bool
  canLabel: bool
  projectId: string
  host: string
  hostName: string
  code: list<CodeHighlight>
  // r4-timeline: Settings → Appearance code font, size and word wrap for the Markdown.
  md: MarkdownEnv
  diffScheme: string
  // pr-header-actions-and-stacks: the primary control, the More menu, the dialogs, the base branch's mark, the stack.
  actions: PrActionsView
  // pr-handoffs-and-quick-actions: which hand-off is preparing, whether it can check out, whose pull request it is beside a thread.
  handoffs: PrHandoffsView
  // pr-links-previews-and-routing: the linked threads, the Link item and the back arrow; the hovered link's card.
  links: PrLinksView
  preview: PrPreviewView
  actOn: PrActOnView
  // pr-code-tab: the Code tab (pages-pr-code.ts), drawn once opened for this pull request.
  codeTab: PrCodeView

fn prdTone(lifecycle: string): string = lifecycle == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : lifecycle == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : lifecycle == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"
fn prdIcon(lifecycle: string): string = lifecycle == "draft" ? "git-pull-request-draft" : lifecycle == "closed" ? "git-pull-request-closed" : lifecycle == "merged" ? "git-merge" : "git-pull-request-arrow"
fn prdCheckIcon(status: string): string = status == "failure" or status == "cancelled" ? "circle-x" : status == "pending" or status == "action-required" ? "circle-dot" : status == "success" ? "circle-check" : "circle-dashed"
fn prdCheckTone(status: string): string = status == "failure" or status == "cancelled" ? "light-dark(#e40014, #fb414a)" : status == "pending" or status == "action-required" ? "light-dark(#e17100, #ffb900e6)" : status == "success" ? "light-dark(#009966, #5ee9b5e6)" : "light-dark(#71717b, #818181)"

// Whether an editor field's hold on Escape (PrPanel) still stands where the data can tell: the code comment draft while
// one is open, a reply while its thread has not taken a reply since it opened (`reply:<thread>:<serial>`).
fn prdEscapeLive(field: string, code: PrCodeView): bool = field == "pr-code-draft" ? code.draftOpen : (startsWith(field, "reply:") ? length(filter(code.threads, (card) => `reply:${card.id}:${card.repliedSerial}` == field)) > 0 : true)

// RightPanelTabs (inline) around the detail: the pull request's tab, then the panel body.
component PrPanel
  props
    detail: PrDetailView
    documents: list<ChatDocument>
    scheme: string
    width: number
    tab: string
    setTab: action
    close: action
    reload: action
    act: action
    copy: action
    local: action
    still: bool
    select: action
    compact: bool
    // usage-and-pr-pages PG-7: the page's Back (Escape), held here while the panel shows (PrPageBack).
    back: action
  // The field of a pull request editor that has the focus (the title, a description or remark, a reply, the code
  // comment draft), reported through `local` ("pr-escape-hold", the field, "true" or ""), and the pull request it was
  // on: while it holds the focus, Escape is its own (it cancels) and Back gives it up (Settings' escapeFocus). A field
  // the view removes may send no blur, so each editor lets go itself as it closes, saves or sends; another pull
  // request or the draft's end lets go of what is left, and closing the panel starts it over.
  state escapeField = ""
  state escapeRef = ""
  derive escapeHeld = escapeField != "" and escapeRef == detail.ref and prdEscapeLive(escapeField, detail.codeTab)
  action panelLocal(op: string, id: string, value: string)
    if op == "pr-escape-hold"
      escapeField = value == "true" ? id : (escapeField == id ? "" : escapeField)
      escapeRef = detail.ref
    else
      local(op, id, value)
  view
    column width=width height="100%" flex-shrink=0 box-sizing="border-box" border-left-width=1 border-left-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fcfcfc, #0a0a0a)" testId="pull-request-panel"
      PrPageBack(held=escapeHeld, back=back)
      row height=52 flex-shrink=0 width="100%" padding-left="0.5rem" padding-right="3.5rem" box-sizing="border-box" align-items="center" gap="0.25rem"
        row height="1.5rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" gap="0.125rem" border-radius="0.5rem" background-color="light-dark(#27272a0d, #ffffff0a)" align-items="center" role="tab" aria-selected=true testId="pull-request-tab"
          PrTabClose(detail=detail, close=close)
          text detail.numberLabel font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
      // Keyed by the pull request, as the reference keys its panel: another one starts with its header open.
      each bodyRef in [detail.ref] key=bodyRef
        PrdBody(detail=detail, documents=documents, scheme=scheme, tab=tab, setTab=setTab, reload=reload, act=act, copy=copy, local=panelLocal, still=still, select=select, compact=compact, narrow=(width < 560), scrollId="pr-page-scroll")

// The panel's body, shared with the thread's pull request surface (r5-panels.contract): the
// ghost while the detail is out, the unavailable state, or the header, the tab bar and both tabs.
// Both tabs stay mounted, each in its own scroller (hidden with `visibility`, so each keeps its
// offset), keyed by the pull request, so the comment window, the orders and the open groups survive
// a visit to the other tab and start fresh for another pull request (PullRequestDetailPanel
// mountedTabs, keyed by tabScopeKey). pr-handoffs-and-quick-actions: the header and the tab bar stay
// above the scrollers, and the header folds to one condensed row once a tab is scrolled past its
// block plus 32 (the scroll position refunded by the height that left, in the same commit), and
// opens again at the hard top (under 4, no refund, easing back in over 200 ms unless motion is
// reduced); each tab remembers its own fold.
component PrdBody
  props
    detail: PrDetailView
    documents: list<ChatDocument>
    scheme: string
    tab: string
    setTab: action
    reload: action
    act: action
    copy: action
    local: action
    still: bool
    select: action
    // The header's container is narrower than 30rem: its control labels go (`@max-[30rem]/pr-header:hidden`).
    compact: bool
    // Narrower than 35rem: the Check out label goes (`@max-[35rem]/pr-header:hidden`).
    narrow: bool
    scrollId: string
  state timelineOrder = "newest"
  // The Summary scroller's offset, and an offset to move it to (a section collapsing under a pinned heading, or the fold's refund).
  state bodyTop = 0
  state anchored = 0
  state anchorSerial = 0
  // The Timeline scroller's own refund.
  state timelineAnchored = 0
  state timelineSerial = 0
  // chromeStateByTab: each tab's fold.
  state foldSummary = false
  state foldTimeline = false
  state foldCode = false
  derive surface = scrollId == "pr-surface-scroll" ? "thread" : "page"
  // pr-links-previews-and-routing: a pull request link's click in the text goes through the panel's action (its answer can select on the page).
  action textLocal(op: string, id: string, value: string)
    if op == "pr-link-open"
      act("link-open", value)
    else
      local(op, id, value)
  // pr-code-tab: a host with no patch has no Code tab, and whoever stood on it is back on the Summary.
  derive current = tab == "timeline" ? "timeline" : (tab == "code" and detail.codeTab.available ? "code" : "summary")
  derive condensed = current == "timeline" ? foldTimeline : current == "code" ? foldCode : foldSummary
  action flipTimeline
    timelineOrder = timelineOrder == "newest" ? "oldest" : "newest"
  action anchorTo(y: number)
    anchored = y
    anchorSerial = anchorSerial + 1
  action bodyScrolled(x: number, y: number)
    bodyTop = y
    let fold = frame(`${scrollId}-fold`).height
    let row = frame(`${scrollId}-condensed`).height
    if foldSummary
      if y < 4 and fold > 0
        foldSummary = false
    else if fold > 0 and y > fold + 32
      anchored = max(0, y - (fold - row))
      anchorSerial = anchorSerial + 1
      foldSummary = true
  action timelineScrolled(x: number, y: number)
    let fold = frame(`${scrollId}-fold`).height
    let row = frame(`${scrollId}-condensed`).height
    if foldTimeline
      if y < 4 and fold > 0
        foldTimeline = false
    else if fold > 0 and y > fold + 32
      timelineAnchored = max(0, y - (fold - row))
      timelineSerial = timelineSerial + 1
      foldTimeline = true
  // The Code tab's list folds the header too (its own scroller; no refund, the list owns its offset).
  action codeScrolled(x: number, y: number)
    let fold = frame(`${scrollId}-fold`).height
    if foldCode
      if y < 4 and fold > 0
        foldCode = false
    else if fold > 0 and y > fold + 32
      foldCode = true
  // A Timeline commit row opens the Code tab on that commit.
  action openCommit(oid: string)
    local("pr-code-scope", detail.ref, oid)
    setTab("code")
  view
    when detail.phase == "ghost"
      PrdGhost(ghost=detail.ghost, number=detail.number, checkout=detail.checkoutCommand, tab=tab, still=still, handoffs=detail.handoffs, surface=surface, narrow=narrow, scheme=scheme, act=act)
    when detail.phase == "error"
      PrUnavailable(detail=detail, reload=reload)
    when detail.phase == "content"
      PrdHeader(detail=detail, scheme=scheme, still=still, compact=compact, narrow=narrow, surface=surface, condensed=condensed, measureId=scrollId, reload=reload, act=act, copy=copy, local=local, select=select)
      row width="100%" padding-left="1rem" padding-right="1rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-top-width=1 border-bottom-width=1 border-top-style="solid" border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" align-items="center" gap="0.5rem" flex-shrink=0 -exact-layout-transition=(condensed or still ? "none" : "200ms ease-out") role="navigation" aria-label="Pull request tabs"
        row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="tablist"
          PrdTab(label="Summary", active=(current == "summary"), press=setTab("summary"), testId="pull-request-tab-summary")
          PrdTab(label="Timeline", active=(current == "timeline"), press=setTab("timeline"), testId="pull-request-tab-timeline")
          when detail.codeTab.available
            PrdTab(label="Code", active=(current == "code"), press=setTab("code"), testId="pull-request-tab-code")
        box flex=1 min-width=0
        // showsApproveWorkflows takes the checks summary's place.
        when current == "summary" and detail.actions.approveWorkflows
          PrdApproveWorkflows(actions=detail.actions, ref=detail.ref, local=local)
        when current == "summary" and detail.checksSummary != "" and not detail.actions.approveWorkflows
          row align-items="center" gap="0.375rem" flex-shrink=0 aria-label=`Checks: ${detail.checksSummary}`
            when detail.checksTone != ""
              PgIcon(name=prdCheckIcon(detail.checksTone == "passing" ? "success" : detail.checksTone == "failing" ? "failure" : "pending"), size=14, color=prdCheckTone(detail.checksTone == "passing" ? "success" : detail.checksTone == "failing" ? "failure" : "pending"))
            text detail.checksSummary font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap"
        when current == "timeline"
          PrdTimelineBar(timeline=detail.timeline, dim=(detail.activityPending or detail.activityError != ""), order=timelineOrder, flip=flipTimeline)
      column position="relative" flex=1 min-height=0 width="100%" -exact-layout-transition=(condensed or still ? "none" : "200ms ease-out")
        each prKey in [detail.summary.key] key=prKey
          // A repeated anchor to the same offset still moves the box (the serial's sub-pixel nudge).
          scroll id=scrollId scroll=bodyScrolled scrollTop=(anchored + (anchorSerial % 2) * 0.01) position="absolute" left=0 top=0 width="100%" height="100%" visibility=(current == "summary" ? "visible" : "hidden") role="tabpanel" aria-label="Summary" testId="pull-request-scroll"
            column width="100%" padding-bottom="4rem" box-sizing="border-box"
              PrdSummary(summary=detail.summary, labels=detail.labels, hasBody=detail.hasBody, bodyId=detail.bodyId, writes=detail.writes, documents=documents, code=detail.code, env=detail.md, still=still, local=textLocal, act=act, refresh=reload, retry=act("activity-retry", "summary"), scrollId=scrollId, scrollTop=bodyTop, anchor=anchorTo, handoffs=detail.handoffs, surface=surface)
          scroll id=`${scrollId}-timeline` scroll=timelineScrolled scrollTop=(timelineAnchored + (timelineSerial % 2) * 0.01) position="absolute" left=0 top=0 width="100%" height="100%" visibility=(current == "timeline" ? "visible" : "hidden") role="tabpanel" aria-label="Timeline" testId="pull-request-timeline-scroll"
            column width="100%" padding-bottom="4rem" box-sizing="border-box"
              PrdTimeline(timeline=detail.timeline, order=timelineOrder, pending=detail.activityPending, error=detail.activityError, choices=detail.writes.reactionChoices, scope=scrollId, documents=documents, code=detail.code, env=detail.md, still=still, local=textLocal, act=act, retry=act("activity-retry", "timeline"), openCommit=openCommit)
          // pr-code-tab: mounted once opened, so its slices, offset and draft survive a visit to another tab.
          when current == "code" or detail.codeTab.mounted
            column position="absolute" left=0 top=0 width="100%" height="100%" visibility=(current == "code" ? "visible" : "hidden") role="tabpanel" aria-label="Code" testId="pull-request-code-panel"
              PrdCode(code=detail.codeTab, ref=detail.ref, listId=`${scrollId}-code`, surface=surface, scheme=detail.diffScheme, size=detail.md.codeSize, choices=detail.writes.reactionChoices, documents=documents, highlights=detail.code, env=detail.md, handoffs=detail.handoffs, still=still, local=local, act=act, scrolled=codeScrolled)
      // PullRequestComposer floats over the content at the bottom right (no footer is reserved), keyed by
      // the pull request: a zero-height row under the scroll box is its anchor.
      when detail.writes.composer
        row position="relative" width="100%" height=0 flex-shrink=0
          each composerKey in [detail.writes.key] key=composerKey
            column position="absolute" right="1rem" bottom="0.75rem" z-index=20
              PrdComposer(writes=detail.writes, selected=detail.ref, scope=scrollId, act=act, local=local)

// The tab's leading slot: the lifecycle glyph, which becomes the close button.
component PrTabClose
  props
    detail: PrDetailView
    close: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=close hover=hover aria-label=`Close ${detail.numberLabel}` testId="pull-request-close" width="1rem" height="1rem" padding=0 border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#27272a14, #ffffff14)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      when over
        PgIcon(name="x", size=12, color="light-dark(#27272a, #f5f5f5)")
      else
        PgIcon(name=prdIcon(detail.state), size=12, color=prdTone(detail.state))

component PrdTab
  props
    label: string
    active: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover role="tab" aria-selected=active testId=testId height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(active ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(active ? "0 1px 2px #0000001a" : "none") display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(active or over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// Button size="xs" variant="outline": the header's actions.
// PullRequestsUnavailableState (Empty, md:p-12, gap-6): the stacked pull request
// glyph, its title ("Could not load pull requests", or "#N not found" for an
// issue link, 7bc161f869) and text, then Retry and Open on GitHub.
component PrUnavailable
  props
    detail: PrDetailView
    reload: action
  view
    column flex=1 min-height=0 width="100%" padding="3rem" box-sizing="border-box" align-items="center" justify-content="center" gap="1.5rem" testId="pull-request-error"
      box width="2.25rem" height="2.25rem" position="relative" margin-bottom="1.5rem" flex-shrink=0
        box position="absolute" left=0 bottom=1 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="-7.74px 0.48px" rotate=-10 scale=0.84
        box position="absolute" left=0 bottom=1 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="7.74px 0.48px" rotate=10 scale=0.84
        box position="absolute" left=0 top=0 width="2.25rem" height="2.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center"
          PgIcon(name="git-pull-request-arrow", size=18, color="light-dark(#27272a, #f5f5f5)")
      column max-width="24rem" align-items="center" flex-shrink=0
        text detail.errorTitle font-size="1.25rem" line-height="1.75rem" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="pull-request-error-title"
        text detail.error margin-top="0.25rem" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #818181)" testId="pull-request-error-text"
      row flex-wrap="wrap" justify-content="center" gap="0.5rem" flex-shrink=0
        PrdOutline(icon="refresh-cw", label="Retry", press=reload, testId="pull-request-retry")
        when detail.githubUrl != ""
          link cursor="pointer" href=detail.githubUrl testId="pull-request-open-github" height="1.75rem" padding-left="0.4375rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center"
            PgIcon(name="external-link", size=14, color="light-dark(#71717b, #818181)")
            text "Open on GitHub" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

// Button size="sm" variant="outline": 28pt, a 14pt muted glyph pulled in 2pt (-mx-0.5), 6pt from the label.
component PrdOutline
  props
    icon: string
    label: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height="1.75rem" padding-left="0.4375rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color="light-dark(#71717b, #818181)")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

component PrdButton
  props
    icon: string
    label: string
    iconColor: string
    textColor: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color=iconColor)
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=textColor

// The header: the top row (repository, number, actions) and, under it, either the full block (title,
// author, checkout command, branches, diff stat) or the condensed row (avatar and age, base ← head,
// files and diff stat). The block leaves at once; it eases back in over 200 ms (the reference's
// grid-rows 0fr↔1fr) with its content fading in after 50 ms, and the condensed row the other way.
component PrdHeader
  props
    detail: PrDetailView
    scheme: string
    still: bool
    compact: bool
    narrow: bool
    surface: string
    condensed: bool
    measureId: string
    reload: action
    act: action
    copy: action
    local: action
    select: action
  view
    // Raised over the tab bar after it (z-index orders siblings), so the base branch's card paints on top.
    column width="100%" box-sizing="border-box" position="relative" z-index=2 flex-shrink=0
      row height="1.75rem" width="100%" padding-left="1rem" padding-right="1rem" box-sizing="border-box" align-items="center" gap="0.25rem"
        row min-width=0 flex=1 align-items="center" gap="0.25rem"
          when detail.links.backShown
            PrdBackArrow(local=local)
          text detail.repository font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)" line-clamp=1 min-width=0
          // PullRequestDetailPanel openNumberContextMenu: Copy link, Open on <host>.
          link cursor="pointer" href=detail.url contextmenu=local("pr-link-menu", "", detail.linkMenu) aria-label=`Open pull request ${detail.numberLabel} on host` testId="pull-request-open-host" display="flex" flex-direction="row" align-items="center" gap="0.125rem" flex-shrink=0
            text detail.numberLabel font-size="0.75rem" line-height="1rem" font-weight=500 color=prdTone(detail.state)
            PgIcon(name="external-link", size=10, color=prdTone(detail.state))
        PrdHeaderActions(actions=detail.actions, handoffs=detail.handoffs, links=detail.links, actOn=detail.actOn.items, surface=surface, narrow=narrow, ref=detail.ref, url=detail.url, hostName=detail.hostName, numberLabel=detail.numberLabel, scheme=scheme, still=still, compact=compact, reload=reload, act=act, copy=copy, local=local, select=select)
      // The condensed row: shown at once when the block folds, easing out when it opens again.
      column width="100%" height=(condensed ? "auto" : "0px") overflow="hidden" flex-shrink=0 -exact-layout-transition=(condensed or still ? "none" : "200ms ease-out") testId="pull-request-condensed"
        row id=`${measureId}-condensed` width="100%" min-width=0 padding-left="1rem" padding-right="1rem" padding-top="0.25rem" padding-bottom="0.5rem" box-sizing="border-box" align-items="center" gap="0.5rem" inert=(not condensed) opacity=(condensed ? 1 : 0) translate=(condensed or still ? "0 0" : "0 4px") transition=(still ? "none" : condensed ? "opacity 150ms ease-out 50ms, translate 150ms ease-out 50ms" : "opacity 100ms ease-out, translate 100ms ease-out")
          row min-width=0 flex-shrink=1 align-items="center" gap="0.375rem" overflow="hidden"
            PrAvatar(avatar=detail.authorAvatar, initial=detail.authorInitial, size=16)
            text detail.updatedAgo font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap" flex-shrink=0
          box width=1 height="0.75rem" flex-shrink=0 background-color="light-dark(#e4e4e7b3, #ffffff0b)" aria-hidden=true
          row flex=1 min-width=0 align-items="center" gap="0.375rem"
            row min-width=0 max-width="40%" flex-shrink=0 align-items="center" gap="0.25rem"
              when detail.actions.stacked
                box width="0.75rem" height="0.75rem" aria-label="Stacked pull request" flex-shrink=0
                  PgIcon(name="layers", size=12, color="light-dark(#71717ba6, #828282a6)")
              text detail.baseBranch font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717ba6, #828282a6)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
            box width="0.75rem" height="0.75rem" aria-label="receives changes from" flex-shrink=0 opacity=0.6
              PgIcon(name="arrow-left", size=12, color="light-dark(#71717b, #818181)")
            text detail.headBranch flex=1 font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717ba6, #828282a6)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
          row flex-shrink=0 align-items="center" justify-content="flex-end" gap="0.5rem"
            row align-items="center" gap="0.25rem" aria-label=`${detail.filesCount} changed ${detail.filesCount == "1" ? "file" : "files"}`
              PgIcon(name="file-diff", size=12, color="light-dark(#71717b, #818181)")
              text detail.filesCount font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" white-space="nowrap"
            row align-items="baseline" gap="0.25rem" flex-shrink=0
              text detail.additions font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#009966, #00d492)")
              text detail.deletions font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)")
      // The block: it leaves at once (the scroll refund paints in the same frame) and eases back in.
      column width="100%" height=(condensed ? "0px" : "auto") overflow="hidden" flex-shrink=0 -exact-layout-transition=(condensed or still ? "none" : "200ms ease-out") testId="pull-request-fold"
        column id=`${measureId}-fold` width="100%" padding-left="1rem" padding-right="1rem" padding-bottom="1rem" box-sizing="border-box" inert=condensed opacity=(condensed ? 0 : 1) translate=(condensed and not still ? "0 -4px" : "0 0") transition=(still ? "none" : condensed ? "opacity 100ms ease-out, translate 100ms ease-out" : "opacity 150ms ease-out 50ms, translate 150ms ease-out 50ms")
          PrdTitle(title=detail.title, canEdit=detail.writes.canEditChange, saving=detail.writes.titleSaving, serial=detail.writes.titleSerial, still=still, act=act, local=local)
          row width="100%" min-height="1.25rem" margin-top="0.5rem" align-items="center" gap="0.375rem"
            PrAvatar(avatar=detail.authorAvatar, initial=detail.authorInitial, size=16)
            text detail.author font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 flex-shrink=1 min-width=0
            text "·" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b80, #81818180)" flex-shrink=0
            text detail.updated font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap" flex-shrink=0
            box flex=1 min-width=0
            when detail.checkoutCommand != ""
              PrdCopy(text=detail.checkoutCommand, ariaLabel="Copy checkout command", copied=detail.copiedCheckout, tone="light-dark(#71717b, #818181)", copy=copy, testId="pull-request-copy-checkout")
          row width="100%" min-height="1.25rem" margin-top="1rem" align-items="center" gap="0.5rem"
            row flex=1 min-width=0 align-items="center" gap="0.375rem"
              PrdBaseBranch(actions=detail.actions, ref=detail.ref, base=detail.baseBranch, scheme=scheme, act=act)
              box width="0.875rem" height="0.875rem" aria-label="receives changes from" flex-shrink=0
                PgIcon(name="arrow-left", size=14, color="light-dark(#71717bb3, #828282b3)")
              PrdCopy(text=detail.headBranch, ariaLabel="Copy pull request branch", copied=detail.copiedBranch, tone="light-dark(#71717bb3, #828282b3)", copy=copy, testId="pull-request-copy-branch")
            row flex-shrink=0 align-items="center" gap="0.5rem"
              row min-width="4rem" justify-content="flex-end" align-items="center" gap="0.375rem"
                PgIcon(name="file-diff", size=14, color="light-dark(#71717b, #818181)")
                text detail.files font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" white-space="nowrap"
              row align-items="baseline" gap="0.25rem"
                text detail.additions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#009966, #00d492)")
                text detail.deletions font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=(detail.diffScheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)")

// A mono value that copies itself (the checkout command, the head branch);
// PullRequestCopyableCode swaps it for a centred "Copied" for 1.6s.
component PrdCopy
  props
    text: string
    ariaLabel: string
    copied: number
    tone: string
    copy: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=copy("", text) hover=hover aria-label=ariaLabel testId=testId height="1.25rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" min-width=0 flex-shrink=1 position="relative" text-align="left"
      text text font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=tone line-clamp=1 min-width=0 animation=(copied == 0 ? "none" : (copied % 2 == 0 ? "prdHiddenA 1.6s linear forwards" : "prdHiddenB 1.6s linear forwards"))
      when copied > 0
        row position="absolute" left="0.25rem" right="0.25rem" top="0.125rem" bottom="0.125rem" justify-content="center" align-items="center" animation=(copied % 2 == 0 ? "prdShownA 1.6s linear forwards" : "prdShownB 1.6s linear forwards") aria-hidden=true testId=`${testId}-copied`
          text "Copied" font-family=(testId == "pull-request-copy-checkout" ? "ui-monospace" : "system-ui") font-size="0.75rem" line-height="1rem" color=tone white-space="nowrap"
