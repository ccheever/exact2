// Inline line comments, measured against T3 Code 1e2ecbd975 DiffCommentAnnotation.tsx (MIT; see
// LICENSE-T3): the draft (textarea "Add a comment…", "⌘/Ctrl Enter to send", Cancel, Comment;
// Escape cancels, ⌘/Ctrl+Enter sends a non-empty comment) and the saved card (a primary left
// border, MessageCircle, the text, "Delete comment" shown on hover or focus). The comment becomes
// a review-comment chip in the composer (diff-review.ts).
use DiffGlyph from "./diff-glyphs.contract"

component DiffDraftCard
  props
    rangeLabel: string
    text: string
    edit: action
    cancel: action
    save: action
  action keys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      cancel()
    else if k == "Enter" and (e.metaKey or e.ctrlKey) and trim(text) != ""
      // isCommentSubmitShortcut
      preventDefault()
      save()
  view
    column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" background-color="light-dark(#fcfcfc, #0a0a0a)" testId="diff-comment-draft"
      textarea id="diff-comment-draft-text" value=text input=edit key=keys autofocus=true rows=2 placeholder="Add a comment…" aria-label=`Comment on lines ${rangeLabel}` testId="diff-comment-text" width="100%" min-height="3.5rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false"
      row margin-top="0.375rem" align-items="center" gap="0.25rem"
        text "⌘/Ctrl Enter to send" flex=1 font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717ab3, #818181b3)"
        DiffCommentButton(label="Cancel", primary=false, enabled=true, choose=cancel, testId="diff-comment-cancel")
        DiffCommentButton(label="Comment", primary=true, enabled=(trim(text) != ""), choose=save, testId="diff-comment-save")

component DiffCommentButton
  props
    label: string
    primary: bool
    enabled: bool
    choose: action
    testId: string
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    button press=choose hover=hover disabled=(not enabled) testId=testId height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 opacity=(enabled ? 1 : 0.64) background-color=(primary ? (hovering and enabled ? "light-dark(#1d4ed8, #3b76f6)" : "light-dark(#1b4ed8, #346bf1)") : hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000")
      text label font-size="0.75rem" font-weight=500 line-height="1rem" color=(primary ? "#ffffff" : "light-dark(#71717a, #818181)")

component DiffCommentCard
  props
    text: string
    remove: action
  state hovering = false
  state focused = false
  action hover(over: bool)
    hovering = over
  action focusing(on: bool)
    focused = on
  view
    row width="100%" hover=hover gap="0.625rem" align-items="flex-start" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" border-left-style="solid" border-left-width=2 border-color="light-dark(#1b4ed88c, #346bf18c)" background-color="light-dark(#1b4ed80b, #346bf10b)" testId="diff-comment"
      box width="0.875rem" height="0.875rem" margin-top="0.1875rem" flex-shrink=0
        DiffGlyph(name="message-circle", size=14, color="light-dark(#1b4ed8b3, #346bf1b3)")
      text text flex=1 min-width=0 white-space="pre-wrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" testId="diff-comment-body"
      button press=remove focus=focusing(true) blur=focusing(false) aria-label="Delete comment" testId="diff-comment-delete" width="1.5rem" height="1.5rem" margin-top="-0.125rem" padding=0 flex-shrink=0 border-radius="0.375rem" border-width=0 opacity=(hovering or focused ? 1 : 0) background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
        DiffGlyph(name="trash", size=12, color="light-dark(#71717a, #818181)")
