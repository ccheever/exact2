// r4-composer: video attachments on the composer's shelf and their expanded
// preview (ChatComposer composerVideos, ExpandedImageDialog's ExpandedVideo;
// T3 Code, MIT; see LICENSE-T3). r4-composer-attachments.ts projects them.

shape ComposerVideo
  id: string
  name: string
shape ComposerVideoPreview
  open: bool
  id: string
  name: string
  // The first frame's natural size (0 when unknown, then 16:9).
  width: number
  height: number

// A video on the shelf: a 64pt black square (border-border/80, rounded-lg)
// whose whole face is the "Play" button, its first frame painted by the
// SnapShot tile hook (T3ComposerAttach.swift writes it beside the image
// drafts) under a bottom-up black gradient and a 16pt filled Play glyph, and
// the media-close Remove at its top-right corner.
component VideoDraftTile
  props
    video: ComposerVideo
    disabled: bool
    command: action
  view
    column position="relative" width="4rem" height="4rem" flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff0d)" background-color="#000000" testId=`video-draft-${video.id}`
      button press=command("editorlocal:r4c-video-play", video.id, "", 0) disabled=disabled aria-label=`Play ${video.name}` testId=`play-video-${video.id}` position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="column" align-items="center" justify-content="center" title=""
        box hatch="t3-snapshot-tile" data-snapshot-id=video.id position="absolute" top=0 left=0 right=0 bottom=0 testId=`video-thumbnail-${video.id}`
        box position="absolute" top=0 left=0 right=0 bottom=0 background-image="linear-gradient(to top, #000000b3, #0000001a 50%, #0000001a)" aria-hidden=true
        svg width="1rem" height="1rem" viewBox="0 0 24 24" position="relative" color="#ffffff" fill="currentColor" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
      row position="absolute" top="0.25rem" right="0.25rem"
        button press=command("editorlocal:r4c-video-remove", video.id, "", 0) disabled=disabled aria-label=`Remove ${video.name}` testId=`remove-video-${video.id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center" title=""
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="#ffffff" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M18 6 6 18M6 6l12 12"

// ExpandedImageDialog for a video (DialogPopup variant="media"): the window
// dimmed, the player (native controls, playing) at its natural size up to
// 92% of the window less 96pt and min(86vh, 100vh − 160pt) high, rounded-lg
// with a border-border/70 edge and shadow-2xl, its close button 40pt above
// the top-right corner and the name below it. Escape or the backdrop closes.
component VideoPreviewDialog
  props
    preview: ComposerVideoPreview
    windowWidth: number
    windowHeight: number
    command: action
  derive maxWidth = windowWidth * 0.92 - 96
  derive maxHeight = min(windowHeight * 0.86, windowHeight - 160)
  derive aspect = (preview.width > 0 and preview.height > 0) ? preview.width / preview.height : 16 / 9
  derive mediaWidth = max(64, min(preview.width > 0 ? preview.width : 640, min(maxWidth, maxHeight * aspect)))
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=45 align-items="center" justify-content="center" background-color="#000000bf" role="dialog" aria-label="Expanded video preview" testId="video-preview"
      button press=command("editorlocal:r4c-video-close", "", "", 0) aria-label="Close video preview" aria-keyshortcuts="Escape" position="absolute" left=0 right=0 top=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="video-preview-backdrop" title=""
      column min-width=0 align-items="center"
        box position="relative" width=mediaWidth height=(mediaWidth / aspect) border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #ffffff0d)" box-shadow="0 25px 50px -12px #00000040" box-sizing="border-box" background-color="#000000"
          box hatch="t3-video" data-snapshot-id=preview.id position="absolute" left=0 top=0 right=0 bottom=0 border-radius="0.4375rem" overflow="hidden" testId="video-preview-player"
          button press=command("editorlocal:r4c-video-close", "", "", 0) aria-label="Close video preview" testId="video-preview-close" position="absolute" right=0 top="-2.5rem" width="1.5rem" height="1.5rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#ffffff33" background-color="#000000a6" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
            svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="#ffffff" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
              path d="M18 6 6 18M6 6l12 12"
        text preview.name margin-top="0.5rem" max-width=maxWidth line-clamp=1 font-size="0.75rem" line-height="1rem" color="#ffffffcc"
