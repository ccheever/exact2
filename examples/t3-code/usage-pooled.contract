use PaceIcon from "./usage-bars.contract"
use ProviderMark, ProviderInstanceMark from "./icons.contract"
use DriverMark from "./provider-icons.contract"
use PgIcon from "./pages-icons.contract"
use LucideTriangleAlert from "./settings-icons.contract"
use CnTooltip from "./settings-b-kit.contract"

// The Usage page's pooled Limits view, T3 Code 1e2ecbd975 (MIT, see LICENSE-T3):
// apps/web/src/components/usage/UsageLimitsPooled.tsx (UsageLimitsPooled, PoolSection,
// PoolWindowCard, PoolBar, PoolSegment, LegendRow, SegmentPopover, RedeemableSegmentPopup,
// AccountAvatar, AccountName, AccountChip, LimitNotices) and UsagePage.tsx (CursorEnableLimits).
// The figures and words come from usage-pooled-view.ts. A segment's popover opens on hover (its
// 300 ms delay is the fade's) and stays while the pointer is on it or its email, opens and pins on
// a press (Return or Space too), and closes on Escape (the page's shortcut), a second press, "Use
// reset" or a press outside it and its triggers (UsagePage pressDown/pressUp, by these ids). The popover
// state is the page's (UsagePage), so one shows at a time and Escape there never goes back.

// One account's share of one pooled window (segmentView).
shape PooledSegment
  id: string
  column: number
  side: string
  align: string
  remaining: number
  credits: number
  name: string
  chip: string
  chipBg: string
  chipFg: string
  showName: bool
  label: string
  resets: string
  creditsAria: string
  hatch: bool
  title: string
  avatar: string
  driver: string
  badge: string
  accent: string
  email: string
  emailMask: string
  plan: string
  whereLabel: string
  where: string
  left: string
  resetsAt: string
  restores: string
  redeemable: bool
  creditsText: string
  busy: bool
  status: string
shape PooledStatus
  key: string
  row: number
  name: string
  chip: string
  chipBg: string
  chipFg: string
  text: string
shape PooledWindow
  key: string
  prefix: string
  label: string
  description: string
  remaining: number
  pace: string
  paceLabel: string
  refill: string
  count: number
  segments: list<PooledSegment>
  statuses: list<PooledStatus>
shape PooledPool
  key: string
  prefix: string
  driver: string
  icon: string
  label: string
  light: string
  dark: string
  windows: list<PooledWindow>
  cursorBefore: bool
shape PooledCursor
  key: string
  label: string
  button: string
  busy: bool
shape PooledLink
  key: string
  label: string
  chatgpt: bool
  message: string
  url: string
shape PooledNotice
  key: string
  text: string
shape PooledView
  wide: bool
  hatchWide: string
  hatchNarrow: string
  empty: bool
  pools: list<PooledPool>
  cursorAfter: bool
  cursor: list<PooledCursor>
  links: list<PooledLink>
  notices: list<PooledNotice>
  confirm: string

// UsageLimitsPooled: per provider a section of window cards (Cursor's Keychain offer after Codex
// and Claude), one section per external usage page, then what could not be read.
component UsagePooled
  props
    view: PooledView
    scheme: string
    md: bool
    reduced: bool
    shown: string
    pinned: string
    enterSeg: action
    pin: action
    // fix-hover-cards: a legend row's press, which anchors the popover to that row.
    pinLegend: action
    op: action
  view
    column width="100%" gap="2rem" testId="usage-pooled"
      when view.empty
        text "No provider on the selected environments reports subscription limits." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" testId="usage-limits-empty"
      each pool in view.pools key=pool.key
        when pool.cursorBefore
          CursorEnableLimits(cursor=view.cursor, op=op)
        PoolSection(pool=pool, view=view, scheme=scheme, md=md, reduced=reduced, shown=shown, pinned=pinned, enterSeg=enterSeg, pin=pin, pinLegend=pinLegend)
      when view.cursorAfter
        CursorEnableLimits(cursor=view.cursor, op=op)
      each link in view.links key=link.key
        ExternalUsage(link=link, op=op)
      when length(view.notices) > 0
        LimitNotices(notices=view.notices)

// PoolSection: the provider's mark and name, then a card per window. It rises over the next
// section while one of its popovers shows (z-index orders siblings).
component PoolSection
  props
    pool: PooledPool
    view: PooledView
    scheme: string
    md: bool
    reduced: bool
    shown: string
    pinned: string
    enterSeg: action
    pin: action
    // fix-hover-cards: a legend row's press, which anchors the popover to that row.
    pinLegend: action
  view
    column width="100%" gap="0.75rem" position="relative" z-index=(startsWith(shown, pool.prefix) ? 1 : 0) testId=`usage-limits-${pool.key}`
      row align-items="center" gap="0.5rem"
        box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center"
          when pool.driver == "codex"
            ProviderMark(driver="codex", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
          else
            DriverMark(driver=pool.driver, size=16, initials="", icon=pool.icon)
        text pool.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
      each window in pool.windows key=window.key
        PoolWindowCard(pool=pool, window=window, view=view, scheme=scheme, md=md, reduced=reduced, shown=shown, pinned=pinned, enterSeg=enterSeg, pin=pin, pinLegend=pinLegend)

// PoolWindowCard: the pooled share left with pace and the next refill, beside (md) or above the bar.
component PoolWindowCard
  inject
    rem: number
  props
    pool: PooledPool
    window: PooledWindow
    view: PooledView
    scheme: string
    md: bool
    reduced: bool
    shown: string
    pinned: string
    enterSeg: action
    pin: action
    // fix-hover-cards: a legend row's press, which anchors the popover to that row.
    pinLegend: action
  view
    box width="100%" display="grid" grid-template-columns=(md ? `${11 * rem}px minmax(0, 1fr)` : "minmax(0, 1fr)") column-gap="1.5rem" row-gap="0.75rem" align-items="center" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" position="relative" z-index=(startsWith(shown, window.prefix) ? 1 : 0) testId=`usage-window-${pool.key}-${window.key}`
      column gap="0.25rem" min-width=0
        text window.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        row align-items="baseline" gap="0.5rem"
          text `${window.remaining}%` font-size="1.875rem" line-height="2.25rem" font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)" testId=`usage-window-left-${pool.key}-${window.key}`
          text "left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
          when window.pace != ""
            PaceIcon(pace=window.pace, label=window.paceLabel)
        when window.refill != ""
          text window.refill font-size="0.75rem" line-height="1rem" font-weight=500 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)" testId=`usage-window-refill-${pool.key}-${window.key}`
      // PoolBar: equal-width segments, one per account; narrow, a legend under the strip.
      box min-width=0 display="grid" grid-template-columns=`repeat(${window.count}, minmax(0, 1fr))` column-gap="0.25rem" row-gap="0.25rem"
        each seg in window.segments key=seg.id
          PoolSegment(seg=seg, wide=view.wide, hatch=(view.wide ? view.hatchWide : view.hatchNarrow), light=pool.light, dark=pool.dark, scheme=scheme, reduced=reduced, open=(shown == seg.id), pinned=(pinned == seg.id), enterSeg=enterSeg, pin=pin)
        when not view.wide
          each seg in window.segments key=seg.id
            LegendRow(seg=seg, light=pool.light, dark=pool.dark, pin=pinLegend)
        each line in window.statuses key=line.key
          row grid-column="1 / -1" grid-row=line.row min-width=0 align-items="center" gap="0.25rem" role="status" testId=`usage-seg-status-${line.key}`
            AccountName(name=line.name, chip=line.chip, chipBg=line.chipBg, chipFg=line.chipFg, size="0.75rem")
            text line.text font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" min-width=0
      when window.description != ""
        text window.description grid-column=(md ? "1 / -1" : "auto") font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// AccountChip: two letters on a stable hue per address; AccountName: the instance name, else the chip.
component AccountChip
  props
    chip: string
    chipBg: string
    chipFg: string
  view
    box width="1rem" height="1rem" flex-shrink=0 border-radius="9999px" display="flex" align-items="center" justify-content="center" background-color=chipBg role="img" aria-label=`Account ${chip}`
      text chip font-size="0.625rem" line-height=1 font-weight=600 color=chipFg aria-hidden=true
component AccountName
  props
    name: string
    chip: string
    chipBg: string
    chipFg: string
    size: string
  view
    when name != ""
      text name min-width=0 font-size=size line-height="1rem" font-weight=500 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)"
    else
      row min-width=0 align-items="center"
        AccountChip(chip=chip, chipBg=chipBg, chipFg=chipFg)

// lucide TicketIcon at 12 pt.
component TicketGlyph
  view
    svg width="0.75rem" height="0.75rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"
      path d="M13 5v2"
      path d="M13 17v2"
      path d="M13 11v2"

// PoolSegment: the share of this account's quota still open (35% of the provider colour), the
// spent share hatched when a reset will restore it; wide it carries the name, the share and a plate
// with the countdown and banked credits, narrow its 1-based position. Its popover hangs off it. The
// keyboard ring is the host's (EXACT2-GAPS X47, main #189): a ring drawn from a `focus` handler
// restyled the button at mouse-down and the macOS host dropped that click's press (X56).
component PoolSegment
  props
    seg: PooledSegment
    wide: bool
    hatch: string
    light: string
    dark: string
    scheme: string
    reduced: bool
    open: bool
    pinned: bool
    enterSeg: action
    pin: action
  view
    box grid-row=1 grid-column=seg.column position="relative" min-width=0 z-index=(open ? 1 : 0)
      button id=`usage-seg-${seg.id}` press=pin(seg.id) hover=enterSeg(seg.id) aria-label=seg.label aria-expanded=open aria-haspopup="dialog" testId=`usage-seg-${seg.id}` width="100%" height=(wide ? "2rem" : "1.25rem") min-width=0 padding=0 border-width=0 border-radius="0.375rem" overflow="hidden" position="relative" cursor="pointer" display="block" background-color="light-dark(#f4f4f5, #ffffff0a)" box-shadow=(open ? "0 0 0 1px light-dark(#e4e4e7, #ffffff1a)" : "none")
        box position="absolute" left=0 top=0 bottom=0 width=`${seg.remaining}%` border-radius="0.375rem" opacity=0.35 background-color=`light-dark(${light}, ${dark})` aria-hidden=true testId=`usage-seg-fill-${seg.id}`
        when seg.hatch
          box position="absolute" right=0 top=0 bottom=0 width=`${100 - seg.remaining}%` overflow="hidden" opacity=0.2 aria-hidden=true testId=`usage-seg-hatch-${seg.id}`
            svg position="absolute" right=0 top=0 width=1400 height=(wide ? 32 : 20) viewBox=(wide ? "0 0 1400 32" : "0 0 1400 20") color=`light-dark(${light}, ${dark})` aria-hidden=true
              path d=hatch stroke="currentColor" stroke-width=1 fill="none"
        when wide
          row position="relative" height="100%" min-width=0 align-items="center" gap="0.375rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" aria-hidden=true
            when seg.showName
              AccountName(name=seg.name, chip=seg.chip, chipBg=seg.chipBg, chipFg=seg.chipFg, size="0.75rem")
            text `${seg.remaining}%` flex-shrink=0 font-size="0.75rem" line-height="1rem" font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
            row margin-left="auto" flex-shrink=0 align-items="center" gap="0.375rem" border-radius="0.25rem" padding-left="0.375rem" padding-right="0.375rem" padding-top="0.125rem" padding-bottom="0.125rem" background-color="light-dark(#fcfcfcd9, #0a0a0ad9)" color="light-dark(#27272a, #f5f5f5)"
              text seg.resets font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" white-space="nowrap"
              when seg.credits > 0
                when seg.resets != ""
                  text "·" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
                row align-items="center" gap="0.125rem"
                  TicketGlyph()
                  text `${seg.credits}` font-size="0.6875rem" line-height="1rem" font-weight=600 font-variant-numeric="tabular-nums"
        else
          row position="absolute" left=0 top=0 right=0 bottom=0 align-items="center" justify-content="center" aria-hidden=true
            text `${seg.column}` font-size="0.625rem" line-height=1 font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272acc, #f5f5f5cc)"

// SegmentPopover (PopoverPopup side="top", sideOffset 6, w-72): who the account is, its plan and
// where it is signed in, what is left and when it resets, and the banked credits with "Use reset".
// Drawn by the page in its scroll content (UsagePopups) at the segment's rect there (x, y, w, h), the
// card inside its placement box and every box around it, so the macOS host tracks the pointer on it:
// beside its segment it lay outside the segment's box, heard no pointer and closed as the pointer moved
// in (#263, X62). It stays mounted for the segment last shown, so the fade has a start and an end.
component SegmentPopup
  inject
    rem: number
  props
    seg: PooledSegment
    scheme: string
    reduced: bool
    open: bool
    pinned: bool
    x: number
    y: number
    w: number
    h: number
    // The trigger that opened it: a legend row places it itself (Base UI anchors the popup to that trigger).
    place: string
    enterPop: action
    enterMail: action
    redeem: action
  derive side = place != "" ? place : seg.side
  derive align = place != "" ? "center" : seg.align
  view
    column position="absolute" left=(align == "start" ? x : (align == "end" ? x + w - 18 * rem : x + w / 2 - 9 * rem)) width="18rem" top=(side == "bottom" ? y + h : 0) height=(side == "bottom" ? "auto" : y) justify-content=(side == "bottom" ? "flex-start" : "flex-end") pointer-events="none" z-index=50
      column hover=enterPop(seg.id) padding-top=(side == "bottom" ? "0.375rem" : 0) padding-bottom=(side == "bottom" ? 0 : "0.375rem") pointer-events=(open ? "auto" : "none") inert=(not open) aria-hidden=(not open)
        column width="18rem" padding="1rem" box-sizing="border-box" gap="0.625rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #111111)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") opacity=(open ? 1 : 0) transition=(reduced ? "opacity 0ms" : "opacity 150ms ease") animation=(open and not pinned and not reduced ? "usagePopIn 150ms ease both" : "none") role="dialog" aria-label=seg.title id=`usage-seg-pop-${seg.id}` testId=`usage-seg-pop-${seg.id}`
          column min-width=0 gap="0.125rem"
            row min-width=0 align-items="center" gap="0.5rem"
              when seg.avatar == "instance"
                box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
                  ProviderInstanceMark(driver=seg.driver, size=16, color="light-dark(#27272acc, #f5f5f5cc)", badge=seg.badge, accent=seg.accent)
              when seg.avatar == "chip"
                AccountChip(chip=seg.chip, chipBg=seg.chipBg, chipFg=seg.chipFg)
              text seg.title min-width=0 font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)"
            when seg.email != ""
              PoolEmail(value=seg.email, placeholder=seg.emailMask, testId=`usage-seg-email-${seg.id}`, keep=enterMail(seg.id))
          column gap="0.25rem" padding-top="0.625rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
            when seg.plan != ""
              PopRow(label="Plan", value=seg.plan)
            when seg.whereLabel != ""
              PopRow(label=seg.whereLabel, value=seg.where)
          column gap="0.25rem" padding-top="0.625rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
            PopRow(label="Left", value=seg.left)
            when seg.resetsAt != ""
              PopRow(label="Resets", value=seg.resetsAt)
            when seg.restores != ""
              PopRow(label="Restores", value=seg.restores)
          when seg.redeemable
            row align-items="center" gap="0.75rem" padding-top="0.625rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
              text seg.creditsText font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" testId=`usage-seg-credits-${seg.id}`
              button press=redeem(seg.id) disabled=seg.busy testId=`usage-seg-reset-${seg.id}` margin-left="auto" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" opacity=(seg.busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
                text (seg.busy ? "Using…" : "Use reset") font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

// A hover-opened popover drawn afresh (another segment) fades in, as one already mounted does by its transition;
// Base UI's 300 ms delay before it is the window hover state's (hoverOpenDelay), so nothing waits drawn.
keyframes usagePopIn
  from opacity=0
  to opacity=1

// The segments' popover, drawn by the page in its scroll content: the segment shown, else the one last
// shown, closed, so it fades out where it was.
component UsagePopups
  props
    view: PooledView
    shown: string
    last: string
    pinned: string
    scheme: string
    reduced: bool
    x: number
    y: number
    w: number
    h: number
    place: string
    enterPop: action
    enterMail: action
    redeem: action
  view
    each pool in view.pools key=pool.key
      each window in pool.windows key=window.key
        each seg in filter(window.segments, (one) => one.id == (shown != "" ? shown : last)) key=seg.id
          SegmentPopup(seg=seg, scheme=scheme, reduced=reduced, open=(shown == seg.id), pinned=(pinned == seg.id), x=x, y=y, w=w, h=h, place=place, enterPop=enterPop, enterMail=enterMail, redeem=redeem)

// Row: a 4.5rem muted label, then the value.
component PopRow
  inject
    rem: number
  props
    label: string
    value: string
  view
    box width="100%" display="grid" grid-template-columns=`${4.5 * rem}px minmax(0, 1fr)` column-gap="0.75rem"
      text label font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      text value min-width=0 font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"

// RedactedSensitiveText for the popover's email (mono 11 px, blurred until pressed). Its hover also
// keeps the popover open, which the pointer has not left.
component PoolEmail
  props
    value: string
    placeholder: string
    testId: string
    keep: action
  state revealed = false
  state over = false
  action toggle
    revealed = not revealed
  action hover(inside: bool)
    over = inside
    keep(inside)
  view
    box position="relative" align-self="flex-start" min-width=0 max-width="100%" hover=hover
      button press=toggle aria-label="Toggle account email visibility" testId=testId cursor="pointer" min-width=0 max-width="100%" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="baseline"
        text (revealed ? value : placeholder) font-family="ui-monospace" font-size="0.6875rem" line-height="1.03125rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 user-select=(revealed ? "auto" : "none") filter=(revealed ? "none" : "blur(4px)") color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") testId=`${testId}-text`
      when over
        CnTooltip(tip=(revealed ? "Click to hide email" : "Click to reveal email"), tipId=`${testId}-tip`, above=20)

// LegendRow (narrow): one ghost row per account in bar order, the same popover's second handle.
component LegendRow
  props
    seg: PooledSegment
    light: string
    dark: string
    pin: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    button grid-column="1 / -1" grid-row=(seg.column + 1) press=pin(seg.id) hover=hover aria-label=`Segment ${seg.column}: ${seg.label}` id=`usage-legend-${seg.id}` testId=`usage-legend-${seg.id}` min-width=0 height="1.75rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box position="relative" width="1rem" height="1rem" flex-shrink=0 border-radius="0.25rem" display="flex" align-items="center" justify-content="center"
        box position="absolute" left=0 top=0 right=0 bottom=0 border-radius="0.25rem" opacity=0.35 background-color=`light-dark(${light}, ${dark})` aria-hidden=true
        text `${seg.column}` position="relative" font-size="0.625rem" line-height=1 font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272acc, #f5f5f5cc)"
      AccountName(name=seg.name, chip=seg.chip, chipBg=seg.chipBg, chipFg=seg.chipFg, size="0.75rem")
      text `${seg.remaining}%` flex-shrink=0 font-size="0.75rem" line-height="1rem" font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
      row margin-left="auto" flex-shrink=0 align-items="center" gap="0.375rem" color="light-dark(#71717b, #818181)"
        text seg.resets font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" white-space="nowrap"
        when seg.credits > 0
          when seg.resets != ""
            text "·" font-size="0.6875rem" line-height="1rem"
          row align-items="center" gap="0.125rem" color="light-dark(#27272a, #f5f5f5)"
            TicketGlyph()
            text `${seg.credits}` font-size="0.6875rem" line-height="1rem" font-weight=600 font-variant-numeric="tabular-nums"

// CursorEnableLimits: Cursor's heading and a card with the Keychain copy and one Enable per environment.
component CursorEnableLimits
  props
    cursor: list<PooledCursor>
    op: action
  view
    column width="100%" gap="0.75rem" testId="usage-cursor-limits"
      row align-items="center" gap="0.5rem"
        box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center"
          DriverMark(driver="cursor", size=16, initials="", icon="")
        text "Cursor" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
      column width="100%" align-items="flex-start" gap="0.75rem" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
        text "Requires access to your Cursor login in macOS Keychain." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        row flex-wrap="wrap" gap="0.5rem"
          each env in cursor key=env.key
            button press=op("usage-pool-cursor", env.key, "") disabled=env.busy aria-busy=env.busy aria-label=`Enable Cursor usage from ${env.label}` testId=`usage-cursor-enable-${env.key}` height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" opacity=(env.busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
              text env.button font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

// An external usage page (ChatGPT's when the plan is shared), with "Manage usage" (shell.openExternal).
component ExternalUsage
  props
    link: PooledLink
    op: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    row width="100%" flex-wrap="wrap" align-items="center" justify-content="space-between" gap="0.75rem" padding="1rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" testId="usage-external-link"
      row flex=1 min-width=0 align-items="center" gap="0.75rem"
        when link.chatgpt
          ProviderMark(driver="codex", size=20, color="light-dark(#27272a, #f5f5f5)")
        column min-width=0 gap="0.25rem"
          text link.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          when link.message != ""
            text link.message max-width="36rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      button press=op("usage-pool-open", link.url, "") hover=hover testId="usage-external-manage" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        text "Manage usage" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
        PgIcon(name="external-link", size=14, color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

// LimitNotices: a warning alert (first-line aligned glyph) with one title per source or provider that could not be read.
component LimitNotices
  props
    notices: list<PooledNotice>
  view
    row width="100%" box-sizing="border-box" padding-left="0.875rem" padding-right="0.875rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.5rem" align-items="flex-start" border-radius="0.75rem" border-width=1 border-style="solid" border-color="#fe9a0052" background-color="light-dark(#fe9a0014, #fe9a0029)" role="alert" testId="usage-limit-notices"
      box padding-top="0.125rem" flex-shrink=0
        LucideTriangleAlert(size=16, color="#fe9a00")
      column flex=1 min-width=0 gap="0.25rem"
        each notice in notices key=notice.key
          text notice.text font-size="0.875rem" line-height="1.25rem" font-weight=500 overflow-wrap="break-word" color="light-dark(#bb4d00, #ffb900)"
