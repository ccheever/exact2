// media-actions (T3 Code 1e2ecbd975, MIT; see LICENSE-T3): ChatMarkdown.tsx's media lines — the
// "Image unavailable · <alt>" label (ChatMarkdownImageFallback), ChatMarkdownImage's 16:9 loading
// slot, ChatMarkdownAssetImage and ChatMarkdownVideo — each wrapped in MediaActions.
use ShellIcon from "./shell-icons.contract"
use AttachmentUrl from "./timeline-attachments.contract"
use MediaActions, MediaOpenLink from "./media-actions.contract"

// ChatMarkdownMediaUnavailableLabel inside its muted chip (ChatMarkdownImageFallback).
component MediaUnavailableLabel
  props
    alt: string
    video: bool
  view
    row gap=6 align-items="center" align-self="flex-start" max-width="100%" padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 box-sizing="border-box" border-radius=6 border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" role="alert" testId="markdown-media-unavailable"
      ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
      text (alt != "" ? `${video ? "Video unavailable" : "Image unavailable"} · ${alt}` : (video ? "Video unavailable" : "Image unavailable")) font-size=12 line-height="16px" line-clamp=1 color="light-dark(#71717b, #818181)"

// A Markdown image line: its chip (media-views.ts markdownMediaChips: `size` the kind, `icon` the
// access, `target` the URL or the signed URL's key, `detail` the actions' source) and the signed
// URLs (`media:<path>`, `media-failed:<path>`).
component MarkdownMedia
  props
    alt: string
    kind: string
    access: string
    target: string
    tip: string
    source: string
    urls: list<AttachmentUrl>
    local: action
  derive signed = filter(urls, (entry) => entry.id == target and entry.url != "")
  derive refused = length(filter(urls, (entry) => entry.id == `media-failed:${slice(target, 6)}`)) > 0
  view
    when access == "blocked"
      MediaUnavailableLabel(alt=alt, video=(kind == "video"))
    when access == "direct"
      MarkdownMediaBody(url=target, alt=alt, kind=kind, tip=tip, source=source, original=(startsWith(target, "http:") or startsWith(target, "https:")), local=local)
    when access == "environment"
      when length(signed) > 0
        each entry in signed key=entry.id
          MarkdownMediaBody(url=entry.url, alt=alt, kind=kind, tip=tip, source=source, original=false, local=local)
      else
        when refused
          MediaActions(source=source, tip=tip, local=local, testId=(kind == "video" ? "markdown-video-actions" : "markdown-image-actions"))
            when kind == "video"
              column width="100%" max-width=640 aspect-ratio="16 / 9" padding=16 box-sizing="border-box" gap=12 align-items="center" justify-content="center" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" role="alert"
                row gap=6 align-items="center"
                  ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
                  text (alt != "" ? `Video unavailable · ${alt}` : "Video unavailable") font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
            else
              MediaUnavailableLabel(alt=alt, video=false)
        else
          box width="100%" max-width=640 aspect-ratio="16 / 9" border-radius=8 background-color="light-dark(#f4f4f599, #ffffff0a)" role="status" aria-label=(kind == "video" ? "Loading video" : "Loading image")

// ChatMarkdownImage / ChatMarkdownVideo once the URL is known. A video that fails shows
// MediaVideoPlayer's slot: Retry video loads it again; the open link is "Open original" for an
// authored web URL (OpenMediaLink), else "Open in browser" with the signed URL.
component MarkdownMediaBody
  props
    url: string
    alt: string
    kind: string
    tip: string
    source: string
    original: bool
    local: action
  state failed = false
  action broke(reason: string)
    let ignored = reason
    failed = true
  action retry
    failed = false
  view
    MediaActions(source=source, tip=tip, local=local, testId=(kind == "video" ? "markdown-video-actions" : "markdown-image-actions"))
      when kind == "video"
        when failed
          column role="alert" width="100%" max-width=640 aspect-ratio="16 / 9" min-height=112 padding=16 box-sizing="border-box" gap=12 align-items="center" justify-content="center" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" testId="markdown-video-failed"
            row gap=6 align-items="center" max-width="100%"
              ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
              text (alt != "" ? `Video unavailable · ${alt}` : "Video unavailable") font-size=14 line-height="20px" line-clamp=2 text-align="center" color="light-dark(#71717b, #818181)"
            row flex-wrap="wrap" gap=8 align-items="center" justify-content="center"
              button press=retry aria-label="Retry video" testId="markdown-video-retry" height=28 padding-left=10 padding-right=10 box-sizing="border-box" gap=6 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#f4f4f5, #ffffff0f)" display="flex" flex-direction="row" align-items="center"
                svg width=14 height=14 viewBox="0 0 24 24" fill="none" stroke="light-dark(#27272a, #f5f5f5)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                  path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8M21 3v5h-5"
                text "Retry video" font-size=13 line-height="18px" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
              MediaOpenLink(url=(startsWith(url, "http:") or startsWith(url, "https:") or startsWith(url, "blob:") ? url : ""), label=(original ? "Open original" : startsWith(url, "blob:") ? "Download video" : "Open in browser"), icon=(startsWith(url, "blob:") ? "download" : "external-link"), dark=false, testId="markdown-video-open")
        else
          video url controls=true playsinline=true preload="metadata" aria-label=(alt != "" ? alt : "Video preview") error=broke width="100%" max-width=640 aspect-ratio="16 / 9" border-radius=8 background-color="#000000" object-fit="contain" testId="markdown-media-video"
      else
        image url aria-label=alt max-width="100%" max-height=480 object-fit="contain" border-radius=8 testId="markdown-media-image"
