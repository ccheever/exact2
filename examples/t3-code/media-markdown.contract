// T3 Code 1e2ecbd975 (MIT; see LICENSE-T3): ChatMarkdown.tsx's media lines — the
// "Image unavailable · <alt>" label (ChatMarkdownImageFallback), ChatMarkdownImage's 16:9 loading
// slot, ChatMarkdownAssetImage and ChatMarkdownVideo — each wrapped in MediaActions.
use ShellIcon from "./shell-icons.contract"
use AttachmentUrl from "./timeline-attachments.contract"
use MediaActions, MediaOpenLink, MediaPreviewActions from "./media-actions.contract"

// ChatMarkdownMediaUnavailableLabel inside its muted chip (ChatMarkdownImageFallback).
component MediaUnavailableLabel
  props
    alt: string
    video: bool
  view
    row gap="0.375rem" align-items="center" align-self="flex-start" max-width="100%" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" role="alert" testId="markdown-media-unavailable"
      ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
      text (alt != "" ? `${video ? "Video unavailable" : "Image unavailable"} · ${alt}` : (video ? "Video unavailable" : "Image unavailable")) font-size="0.75rem" line-height="1rem" line-clamp=1 color="light-dark(#71717b, #818181)"

// ChatMarkdownImage's standalone failure: the 16:9 frame the image
// held while it loaded (CHAT_MARKDOWN_IMAGE_FRAME_CLASS_NAME), the label centred in it, where an image in a line of text
// or one that can never load is ChatMarkdownImageFallback's chip.
component MediaFailedFrame
  props
    alt: string
  view
    row width="100%" max-width="30rem" aspect-ratio="16 / 9" padding="0.5rem" box-sizing="border-box" gap="0.375rem" align-items="center" justify-content="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f599, #ffffff0a)" role="alert" testId="markdown-media-failed"
      ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
      text (alt != "" ? `Image unavailable · ${alt}` : "Image unavailable") font-size="0.75rem" line-height="1rem" line-clamp=2 text-align="center" color="light-dark(#71717b, #818181)"

// A Markdown image (ChatMarkdown's `img` renderer): its chip (media-views.ts markdownMediaChips: `size` the kind, `icon`
// the access, `target` the URL or the signed URL's key, `detail` the actions' source) and the signed URLs (`media:<path>`,
// `media-failed:<path>`). `standalone` (an image line, or an image that is the only content of its paragraph, list item
// or quote: markStandaloneImages, markdown_media.rs) is ChatMarkdownImage's figure: the 16:9 slot while it loads, kept
// with the label in it when it fails. An image inside a line of text
// has a zero-size status span while it loads and ChatMarkdownImageFallback's chip when it fails. A video is
// ChatMarkdownVideo (MediaVideoPlayer) either way: the 16:9 slot, the player, its failure slot with Retry video.
// `link`: inside a link's text (MarkdownAnchor's `<a>` around the `<img>`), where the settled image has no preview of its
// own (expandableMarkdownImageProps returns early inside an `<a>`): the link node around it, named `linkLabel`, takes the
// press and the menu, a web link's favicon first when `favicon` (the image starts the link).
component MarkdownMedia
  inject
    galleryIds: string[]
  props
    alt: string
    kind: string
    access: string
    target: string
    tip: string
    source: string
    urls: AttachmentUrl[]
    local: action
    standalone: bool
    link: string
    linkLabel: string
    favicon: bool
    // The document the image belongs to (its chips' owner), whose images the expanded preview steps through, and the
    // occurrence's node id (owner, block, run).
    owner: string
    nodeId: string
  derive url = access == "direct" ? target : urls.filter((entry) => entry.id == target and entry.url != "").map((entry) => entry.url).join("")
  derive refused = access == "environment" and urls.filter((entry) => entry.id == `media-failed:${target.slice(6)}`).length > 0
  view
    if access == "blocked"
      MediaUnavailableLabel(alt=alt, video=(kind == "video"))
    if access != "blocked" and refused
      MediaActions(source=source, tip=tip, local=local, elementId="", testId=(kind == "video" ? "markdown-video-actions" : "markdown-image-actions"))
        if kind == "video"
          column width="100%" max-width="40rem" aspect-ratio="16 / 9" padding="1rem" box-sizing="border-box" gap="0.75rem" align-items="center" justify-content="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" role="alert"
            row gap="0.375rem" align-items="center"
              ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
              text (alt != "" ? `Video unavailable · ${alt}` : "Video unavailable") font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        if kind != "video" and standalone
          MediaFailedFrame(alt=alt)
        if kind != "video" and not standalone
          MediaUnavailableLabel(alt=alt, video=false)
    // While the URL is signed: the 16:9 slot, or for an inline image a zero-size span (its width 0 makes it 0 tall).
    if access != "blocked" and not refused and url == ""
      box width=(standalone or kind == "video" ? "100%" : "0px") max-width="40rem" aspect-ratio="16 / 9" border-radius="0.5rem" background-color="light-dark(#f4f4f599, #ffffff0a)" role="status" aria-label=(kind == "video" ? "Loading video" : "Loading image")
    if access != "blocked" and not refused and url != ""
      MarkdownMediaBody(url=url, alt=alt, kind=kind, tip=tip, source=source, original=(access == "direct" and (target.startsWith("http:") or target.startsWith("https:"))), local=local, standalone=standalone, link=link, linkLabel=linkLabel, favicon=favicon, open=local("image-md-open", target, `${owner}\n${nodeId}\n${galleryIds.map((id) => `media-${owner}-${id}`).indexOf(nodeId)}`), nodeId=nodeId)

// ChatMarkdownImage / ChatMarkdownVideo once the URL is known. A video that fails shows
// MediaVideoPlayer's slot: Retry video loads it again; the open link is "Open original" for an
// authored web URL (OpenMediaLink), else "Open in browser" with the signed URL.
component MarkdownMediaBody
  inject
    linkOpen: action
  props
    url: string
    alt: string
    kind: string
    tip: string
    source: string
    original: bool
    local: action
    standalone: bool
    link: string
    linkLabel: string
    favicon: bool
    // Opens the expanded image dialog on this image (timeline-attachments.ts `image-md-open`), and the button's id.
    open: action
    nodeId: string
  state failed = false
  action broke(reason: string)
    let ignored = reason
    failed = true
  action retry
    failed = false
  // Inside a link: a right click on the picture is MediaActions' (its menu, at the pointer), as the `<span>` around the
  // `<img>` takes it before the `<a>`.
  action linkedMenu
    local("media-menu", source, "pointer")
  // ChatMarkdownImage failedSrc: the URL whose picture reported `error` (exact2 #121).
  state brokenUrl = ""
  action imageBroke(reason: string)
    let ignored = reason
    brokenUrl = url
  view
    if kind == "video" or (brokenUrl != "" and brokenUrl == url)
      MediaActions(source=source, tip=tip, local=local, elementId="", testId=(kind == "video" ? "markdown-video-actions" : "markdown-image-actions"))
        if kind == "video" and failed
          column role="alert" width="100%" max-width="40rem" aspect-ratio="16 / 9" min-height="7rem" padding="1rem" box-sizing="border-box" gap="0.75rem" align-items="center" justify-content="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e766, #ffffff06)" background-color="light-dark(#f4f4f566, #ffffff06)" testId="markdown-video-failed"
            row gap="0.375rem" align-items="center" max-width="100%"
              ShellIcon(name="triangle-alert", size=14, color="light-dark(#71717b, #818181)")
              text (alt != "" ? `Video unavailable · ${alt}` : "Video unavailable") font-size="0.875rem" line-height="1.25rem" line-clamp=2 text-align="center" color="light-dark(#71717b, #818181)"
            row flex-wrap="wrap" gap="0.5rem" align-items="center" justify-content="center"
              button press=retry aria-label="Retry video" testId="markdown-video-retry" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#f4f4f5, #ffffff0f)" display="flex" flex-direction="row" align-items="center"
                svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="light-dark(#27272a, #f5f5f5)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                  path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8M21 3v5h-5"
                text "Retry video" font-size="0.8125rem" line-height="1.125rem" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
              MediaOpenLink(url=(url.startsWith("http:") or url.startsWith("https:") or url.startsWith("blob:") ? url : ""), label=(original ? "Open original" : url.startsWith("blob:") ? "Download video" : "Open in browser"), icon=(url.startsWith("blob:") ? "download" : "external-link"), dark=false, testId="markdown-video-open")
        if kind == "video" and not failed
          video url controls=true playsinline=true preload="metadata" aria-label=(alt != "" ? alt : "Video preview") error=broke width="100%" max-width="40rem" aspect-ratio="16 / 9" border-radius="0.5rem" background-color="#000000" object-fit="contain" testId="markdown-media-video"
        if kind != "video" and standalone
          MediaFailedFrame(alt=alt)
        if kind != "video" and not standalone
          MediaUnavailableLabel(alt=alt, video=false)
    // The settled image is the button "Preview <alt>" (ChatMarkdownImage's <img> with expandableMarkdownImageProps), or
    // inside a link the image alone in MediaActions.
    if kind != "video" and not (brokenUrl != "" and brokenUrl == url) and link != ""
      link href=link press=linkOpen("link", link) contextmenu=linkedMenu aria-label=linkLabel title="" cursor="pointer" text-decoration-line="none" display="flex" flex-direction="row" flex-shrink=1 min-width=0 max-width="100%" align-items="flex-start" testId="markdown-linked-image"
        if favicon
          box width="0.875rem" height="1.421875rem" margin-left="0.21875rem" margin-right="0.175rem" padding-top="0.28125rem" box-sizing="border-box" flex-shrink=0
            // Lucide's globe, as the link's first word draws it (TimelineIcon "globe").
            svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="light-dark(#1447e6, #50a2ff)" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
              path d="M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20"
        image url aria-label=alt error=imageBroke max-width="100%" max-height="30rem" object-fit="contain" border-radius="0.5rem" testId="markdown-media-image"
    if kind != "video" and not (brokenUrl != "" and brokenUrl == url) and link == ""
      MediaPreviewActions(source=source, tip=tip, label=`Preview ${alt.trim() != "" ? alt.trim() : "image"}`, open=open, local=local, testId="markdown-image-actions", nodeId=nodeId)
        image url aria-label=alt error=imageBroke max-width="100%" max-height="30rem" object-fit="contain" border-radius="0.5rem" testId="markdown-media-image"
