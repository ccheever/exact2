// TooltipPopup variant="code" (ui/tooltip.tsx; MIT, see LICENSE-T3): a path
// or command in 11pt monospace on 1.625 lines, up to 480 wide, on one line
// (MarkdownFileLink's full path scrolls rather than wraps). Lane r4-timeline.
use TipBubble from "./shell-tip.contract"

component CodeTip
  props
    label: string
    side: string
    offset: number
  slot
  state over = false
  action setOver(value: bool)
    over = value
  view
    box position="relative" hover=setOver flex-shrink=0 display="flex" flex-direction="row" align-items="center" min-width=0
      children
      when label != ""
        row position="absolute" bottom=(side == "top" ? offset : -100000) left="-15rem" right="-15rem" justify-content="center" pointer-events="none" z-index=140
          column max-width="30rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" overflow="hidden" opacity=(over ? 1 : 0) transition=(over ? "opacity 150ms ease 600ms" : "opacity 0ms") pointer-events="none" role="tooltip" aria-hidden=(not over) testId="tooltip"
            // The path keeps its start in view and runs off the end (overflow-x-auto, nowrap).
            row max-width="29rem" overflow="hidden" justify-content="flex-start"
              text label flex-shrink=0 font-family="ui-monospace" font-size="0.6875rem" line-height=1.625 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
