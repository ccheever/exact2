// Settings › Devices › Device sources (settings-device-sources.ts; DeviceSourcesSettings.tsx): the
// section's heading with Add source, then one row per source. The SSH and EAS editors are the
// hosts modules' dialogs, mounted at the window root by SettingsADialogs.
use SkPopup from "../settings/settings-kit.contract"
use SkMenuItem from "../settings/settings-kit.contract"
use LucidePlus from "../settings/settings-icons.contract"
use LucideChevronDown from "../settings/settings-icons.contract"
use LucideEllipsisVertical from "../settings/settings-icons.contract"
use KmItem from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"
use AppleGlyph from "./settings-a-hosts.contract"
use AndroidGlyph from "./settings-a-hosts.contract"
use EasSpinner from "./settings-eas-hosts.contract"

shape SourceLine
  id: string
  tone: string
  text: string
  action: string
  op: string
  params: string
shape SourceEntry
  id: string
  label: string
  detail: string
shape SourceGroup
  heading: string
  entries: SourceEntry[]
shape SourceCell
  id: string
  label: string
  value: string
  muted: bool
shape SourcePlatform
  id: string
  aria: string
  available: bool
  partial: bool
  title: string
  reason: string
  groups: SourceGroup[]
  grid: SourceCell[]
shape SourceRow
  key: string
  title: string
  kind: string
  description: string
  problems: SourceLine[]
  pending: string
  platforms: SourcePlatform[]
  actions: bool
  edit: string
  editParams: string
  remove: string
  removeParams: string
  test: bool
  menuId: string
shape DeviceSourcesView
  canAdd: bool
  disabled: bool
  eas: bool
  rows: SourceRow[]

// SettingsSection title="Device sources" with its headerAction, the Add source menu (Button size sm variant outline).
component DeviceSourcesSection
  inject
    dialogOpener: action
  props
    view: DeviceSourcesView
    busy: bool
    rest: action
  derive addItems = view.eas ? [KmItem(id="device-sources-add-ssh", label="Machine over SSH"), KmItem(id="device-sources-add-eas", label="EAS Simulator")] : [KmItem(id="device-sources-add-ssh", label="Machine over SSH")]
  derive addOff = busy or not view.canAdd
  action add(op: string)
    dialogOpener("device-sources-add")
    rest(op, "")
  // Menu's trigger keys (menu-keys.contract): Enter, Space or an arrow opens the popup on its first or last row.
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("device-sources-add-menu", source="device-sources-add")
        let target = kmTriggerTarget(addItems, k)
        if target != ""
          focus(target)
  view
    column width="100%" gap="0.625rem" id="device-sources" tabindex=-1 testId="integrations-device-sources"
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="flex-start" justify-content="space-between" gap="1rem"
        // The heading sits in a 28 pt box, the height of the button beside it.
        text "Device sources" font-size="1rem" font-weight=600 line-height="1.75rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
        box position="relative" flex-shrink=0
          button id="device-sources-add" popovertarget="device-sources-add-menu" key=triggerKey disabled=addOff aria-haspopup="menu" testId="device-sources-add" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" box-shadow=(addOff ? "none" : "0 1px 2px #0000000d") opacity=(addOff ? 0.64 : 1) title="" data-focus-stop=(addOff ? "" : "enabled page")
            // Button's [&_svg]:-mx-0.5: each glyph 2 pt into its neighbours' room.
            box margin-left="-0.125rem" margin-right="-0.125rem"
              LucidePlus(size=14, color="light-dark(#18181b, #f5f5f5)")
            text "Add source" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
            box margin-left="-0.125rem" margin-right="-0.125rem"
              LucideChevronDown(size=14, color="light-dark(#18181b, #f5f5f5)")
          SkPopup(menuId="device-sources-add-menu", invoker="device-sources-add", label="Add source", width=160, list=false, endAlign=1, items=addItems, keyed=0)
            SkMenuItem(keysId="device-sources-add-menu-keys", label="Machine over SSH", menuId="device-sources-add-menu", itemId="device-sources-add-ssh", selected=false, check=false, destructive=false, disabled=false, choose=add("hosts-open"))
            if view.eas
              SkMenuItem(keysId="device-sources-add-menu-keys", label="EAS Simulator", menuId="device-sources-add-menu", itemId="device-sources-add-eas", selected=false, check=false, destructive=false, disabled=false, choose=add("eas-open"))
      column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0c)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
        for source, index in view.rows key=source.key
          SourceRowView(source=source, first=(index == 0), off=(busy or view.disabled), rest=rest)

// DeviceSourceRow: title, kind badge and description, a line per environment with a problem, then the pending status
// (a spinner) or the platform icons, then Edit and More.
component SourceRowView
  inject
    dialogOpener: action
  props
    source: SourceRow
    first: bool
    off: bool
    rest: action
  derive menuItems = source.test ? [KmItem(id=`${source.menuId}-test`, label="Test connection"), KmItem(id=`${source.menuId}-remove`, label="Remove")] : [KmItem(id=`${source.menuId}-remove`, label="Remove")]
  action edit
    dialogOpener(`${source.menuId}-edit`)
    rest(source.edit, source.editParams)
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(source.menuId, source=`${source.menuId}-more`)
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    row width="100%" box-sizing="border-box" gap="0.75rem" align-items="center" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=(first ? 0 : 1) border-color="light-dark(#e4e4e780, #ffffff0a)" testId=`device-source-${source.key}`
      column flex=1 min-width=0
        row min-width=0 align-items="center" gap="0.375rem"
          text source.title font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 color="light-dark(#18181b, #f5f5f5)"
          if source.kind != ""
            text source.kind flex-shrink=0 font-size="0.625rem" line-height="0.875rem" letter-spacing="0.025em" padding-left="0.25rem" padding-right="0.25rem" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" color="light-dark(#71717b, #a1a1a1)"
        text source.description font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #a1a1a1)"
        for line in source.problems key=line.id
          row role="status" margin-top="0.25rem" flex-wrap="wrap" align-items="center" gap="0.375rem"
            text line.text font-size="0.75rem" line-height="1rem" min-width=0 overflow-wrap="anywhere" color=(line.tone == "error" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#bb4d00, #ffb900)")
            if line.action != ""
              button id=`device-source-action-${source.menuId}-${line.id}` press=rest(line.op, line.params) disabled=off testId=`device-source-action-${source.key}-${line.id}` padding=0 border-width=0 background-color="#00000000" opacity=(off ? 0.64 : 1) data-focus-stop=(off ? "" : "enabled page")
                text line.action font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" text-decoration-line="underline"
      if source.pending != ""
        row role="status" flex-shrink=0 align-items="center" gap="0.375rem" testId=`device-source-pending-${source.key}`
          EasSpinner(color="light-dark(#71717b, #a1a1a1)")
          text source.pending font-size="0.75rem" line-height="1rem" white-space="nowrap" color="light-dark(#71717b, #a1a1a1)"
      else
        row flex-shrink=0 align-items="center" gap="0.125rem"
          for platform in source.platforms key=platform.id
            SourcePlatformIcon(platform=platform, owner=source.menuId)
      if source.actions
        row flex-shrink=0 align-items="center" gap="0.25rem"
          button id=`${source.menuId}-edit` press=edit disabled=off testId=`device-source-edit-${source.key}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" box-shadow=(off ? "none" : "0 1px 2px #0000000d") opacity=(off ? 0.64 : 1) title="" data-focus-stop=(off ? "" : "enabled page")
            text "Edit" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
          box position="relative" flex-shrink=0
            button id=`${source.menuId}-more` popovertarget=source.menuId key=triggerKey disabled=off aria-label="More" aria-haspopup="menu" testId=`device-source-more-${source.key}` width="1.75rem" height="1.75rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" opacity=(off ? 0.64 : 1) title="" data-focus-stop=(off ? "" : "enabled page")
              LucideEllipsisVertical(size=16, color="light-dark(#71717b, #a1a1a1)")
            SkPopup(menuId=source.menuId, invoker=`${source.menuId}-more`, label=`${source.title} options`, width=160, list=false, endAlign=28, items=menuItems, keyed=0)
              if source.test
                SkMenuItem(keysId=`${source.menuId}-keys`, label="Test connection", menuId=source.menuId, itemId=`${source.menuId}-test`, selected=false, check=false, destructive=false, disabled=false, choose=rest("hosts-test-row", source.editParams))
              SkMenuItem(keysId=`${source.menuId}-keys`, label="Remove", menuId=source.menuId, itemId=`${source.menuId}-remove`, selected=false, check=false, destructive=true, disabled=false, choose=rest(source.remove, source.removeParams))

// PlatformIcon: a 24 pt button, the glyph solid where the platform is available and muted (45%) where not, a warning
// dot where only some environments have it. Hovering shows its popover (PopoverPopup side="top" align="end"); a press
// keeps it open until Escape or a press outside.
component SourcePlatformIcon
  props
    platform: SourcePlatform
    owner: string
  state pinned = false
  state shown = false
  action hover(value: bool)
    if value
      showPopover(`${owner}-${platform.id}-card`, source=`${owner}-${platform.id}`)
    else if not pinned
      hidePopover(`${owner}-${platform.id}-card`)
  action pressed
    if pinned and shown
      hidePopover(`${owner}-${platform.id}-card`)
    else
      pinned = true
      showPopover(`${owner}-${platform.id}-card`, source=`${owner}-${platform.id}`)
  action toggled(e: ToggleEvent)
    shown = e.newState == "open"
    if not shown
      pinned = false
  view
    box position="relative" flex-shrink=0 hover=hover
      button id=`${owner}-${platform.id}` press=pressed aria-label=platform.aria aria-expanded=shown aria-haspopup="dialog" testId=`${owner}-${platform.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.375rem" background-color=(shown ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled page"
        if platform.id == "ios"
          box position="relative" top=-1
            AppleGlyph(size=14, color=(platform.available ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b73, #a1a1a173)"))
        else
          AndroidGlyph(size=14, color=(platform.available ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b73, #a1a1a173)"))
        if platform.partial
          // ring-2 ring-background: a 2 pt border in the page colour around the 6 pt dot.
          box position="absolute" top=0 right=0 width="0.375rem" height="0.375rem" box-sizing="content-box" border-width=2 border-style="solid" border-color="light-dark(#ffffff, #000000)" border-radius="9999px" background-color="#f59e0b" aria-hidden=true
      column id=`${owner}-${platform.id}-card` popover="auto" toggle=toggled role="dialog" aria-label=platform.title position="absolute" position-area="top span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" margin-bottom="0.25rem" width="18rem" padding="1rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" testId=`${owner}-${platform.id}-card`
        text platform.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
        if platform.reason != ""
          text platform.reason margin-top="0.25rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        if platform.groups.length > 0
          column margin-top="0.5rem" gap="0.375rem"
            for group in platform.groups key=group.heading
              column
                text group.heading font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
                for entry in group.entries key=entry.id
                  column
                    text entry.label font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#18181b, #f5f5f5)"
                    if entry.detail != ""
                      text entry.detail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        if platform.grid.length > 0
          column margin-top="0.5rem" gap="0.25rem"
            for cell in platform.grid key=cell.id
              row gap="1rem"
                text cell.label font-size="0.75rem" line-height="1rem" flex-shrink=0 color="light-dark(#71717b, #a1a1a1)"
                text cell.value font-size="0.75rem" line-height="1rem" flex=1 min-width=0 color=(cell.muted ? "light-dark(#71717b, #a1a1a1)" : "light-dark(#18181b, #f5f5f5)")
