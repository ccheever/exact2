// From the MIT reference (9c161462c9, see LICENSE-T3): DeviceStreamView's foldingControls under the
// device rail. DeviceDuoControls: an iPhone Duo's "Fold shape" (Closed, Book or Laptop as the phone is
// held, Open; drawn turned a quarter for a horizontal phone) and "Device stance" (Laptop stand, Tent
// stand) groups; DeviceAndroidFoldControls: a foldable emulator's Fold / Unfold. Each group is
// a pill like the rail's (4pt inset and gap), its buttons the `icon` size (32pt, 8pt radius), ghost or,
// when chosen, secondary/90, around DeviceDuoGlyph (28pt). A failed command shows a destructive "!".
// `local` reaches device-session.ts (`surface-session-duo` / `surface-session-fold`, device-duo.ts).
use DeviceFolding from "./device-duo-shapes.contract"
use DuoStand from "./device-duo-shapes.contract"
use DuoLeftTip from "./device-duo-tips.contract"
use DuoErrorMark from "./device-duo-tips.contract"

fn duoMuted(): string = "light-dark(#71717b, #818181)"
fn duoInk(): string = "light-dark(#27272a, #f5f5f5)"

component FoldingControls
  props
    folding: DeviceFolding
    local: action
  view
    column flex-shrink=0 align-items="center" gap="0.5rem" role="group" aria-label=(folding.kind == "duo" ? "iPhone Duo stands" : "Android fold controls") testId="device-folding"
      for group in folding.groups key=group.id
        column flex-shrink=0 align-items="center" gap="0.25rem" padding="0.25rem" border-radius="62.4375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e780, #ffffff0a)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" box-shadow="0 1px 2px #0000000d" role="group" aria-label=group.label testId=`device-folding-${group.id}`
          for stand in group.stands key=stand.id
            StandButton(stand=stand, enabled=(folding.enabled and not stand.waits), press=local(`surface-session-${folding.kind}`, "", stand.id))
      if folding.error != ""
        DuoErrorMark(error=folding.error)

component StandButton
  props
    stand: DuoStand
    enabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    // The stand's TooltipPopup side="left" (device-duo-tips.contract); a disabled button still shows it, as Base UI's trigger does.
    box position="relative" flex-shrink=0
      button press=press hover=hover disabled=(not enabled) aria-label=stand.label aria-checked=stand.selected testId=`device-stand-${stand.id}` width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(enabled ? 1 : 0.64) display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(stand.selected ? "light-dark(#fafafae6, #ffffff07)" : over and enabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        DuoGlyph(pose=stand.glyph, rotated=stand.rotated, color=(stand.selected ? duoInk() : duoMuted()))
      DuoLeftTip(label=stand.tip, shown=over)

// DeviceDuoGlyph: Simulator's Duo toolbar fold outlines, drawn for a vertical phone (`rotated` turns
// the whole device a quarter clockwise for a horizontal one), and the stance contours, 28pt.
component DuoGlyph
  props
    pose: string
    rotated: bool
    color: string
  view
    svg width="1.75rem" height="1.75rem" rotate=(rotated ? 90 : 0) viewBox=(pose == "laptop" or pose == "tent" ? "0 0 22 16" : "0 0 24 24") color=color fill="none" stroke="currentColor" stroke-width=(pose == "laptop" or pose == "tent" ? 1.25 : 1.35) stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      if pose == "laptop"
        path d="M2.7351 12.9857 L15.8128 11.4159 L14.4114 3.3787 C14.1943 2.134 13.1275 1.2319 12.0283 1.3639 L2.9308 2.4559 C1.8317 2.5879 1.1167 3.7038 1.3337 4.9485 L2.7351 12.9857 Z M2.7351 12.9857 L15.8128 11.4159 L19.9103 12.8914 C20.5449 13.1199 20.1683 13.4121 19.0692 13.5441 L9.9717 14.6361 C8.8725 14.7681 7.4672 14.6898 6.8326 14.4612 L2.7351 12.9857 Z"
      if pose == "tent"
        path d="M3.2522 2.7267 L18.7478 1.4816 L16.696 9.7017 C16.3782 10.9748 15.0649 12.0915 13.7626 12.1962 L2.983 13.0623 C1.6807 13.167 0.8826 12.2199 1.2004 10.9468 L3.2522 2.7267 Z M3.2522 2.7267 L18.7478 1.4816 L20.7996 10.6909 C21.1174 12.1172 20.3193 13.3581 19.017 13.4628 L8.2374 14.3289 C6.9351 14.4336 5.6218 13.3623 5.304 11.936 L3.2522 2.7267 Z"
      if pose == "closed"
        rect x=5.8 y=3 width=12.4 height=18 rx=2.2
        circle cx=15.4 cy=5.7 r=0.6 fill="currentColor" stroke="none"
        path d="M10.6 18.2h2.8"
      if pose == "book"
        path d="M4.6 18.1V5.9Q4.6 4.9 5.9 4.9L12 7.5L18.1 4.9Q19.4 4.9 19.4 5.9V18.1Q19.4 19.1 18.1 19.1L12 16.5L5.9 19.1Q4.6 19.1 4.6 18.1Z"
      if pose == "open"
        rect x=2.5 y=5 width=19 height=14 rx=2.4
        path d="M10.5 16.3h3"
