// Settings › Devices › Device sources › Machine over SSH (settings-a-hosts.ts): the Add/Edit device
// host dialog (DeviceHostEditor.tsx), mounted at the window root by SettingsADialogs, and the
// platform glyphs the source rows draw.
use FieldPlaceholder from "../shared/field-placeholder.contract"
use LucidePlus from "../settings/settings-icons.contract"
use LucideCheck from "../settings/settings-icons.contract"
use LucideX from "../settings/settings-icons.contract"
use LucideLaptop from "../settings/settings-icons.contract"
use LucideChevronRight from "../settings/settings-icons.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

shape HostCheckRow
  id: string
  label: string
  status: string
  platforms: string
  error: string
shape HostCheckGroup
  key: string
  checking: bool
  summary: string
  results: HostCheckRow[]
shape HostEditorView
  open: bool
  title: string
  description: string
  serial: string
  id: string
  label: string
  target: string
  identityFile: string
  port: string
  optionsOpen: bool
  checkKey: string
  checking: bool
  checked: bool
  summary: string
  results: HostCheckRow[]

component AppleGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
component AndroidGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="m8 3-1-2m9 2 1-2" fill="none" stroke="currentColor" stroke-width=1.4 stroke-linecap="round"
      path d="M5 10a7 7 0 0 1 14 0H5Zm4-4a.8.8 0 1 0 0 1.6A.8.8 0 0 0 9 6Zm6 0a.8.8 0 1 0 0 1.6A.8.8 0 0 0 15 6Z" fill-rule="evenodd"
      path d="M5 11h14v7a2 2 0 0 1-2 2v2a1.5 1.5 0 0 1-3 0v-2h-4v2a1.5 1.5 0 0 1-3 0v-2a2 2 0 0 1-2-2v-7Z"
      rect x=1 y=11 width=3 height=8 rx=1.5
      rect x=20 y=11 width=3 height=8 rx=1.5

// Button size sm variant outline (the host dialog's Test connection). `stop` is its focus word when enabled.
component HostButton
  inject
    dialogOpener: action
  props
    label: string
    disabled: bool
    press: action
    buttonId: string
    plus: bool
    stop: string
  action pressed
    dialogOpener(buttonId)
    press()
  view
    button id=buttonId press=pressed disabled=disabled testId=buttonId display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" flex-shrink=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" box-shadow=(disabled ? "none" : "0 1px 2px #0000000d") opacity=(disabled ? 0.64 : 1) data-focus-stop=(disabled ? "" : stop)
      if plus
        LucidePlus(size=14, color="light-dark(#71717b, #a1a1a1)")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"

// DeviceHostEditor: Name, SSH target, the SSH options disclosure and the connection
// check panel; Cancel / Save host. The draft lives here; the server checks it.
component DeviceHostDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    editor: HostEditorView
    checks: HostCheckGroup[]
    busy: bool
    error: string
    rest: action
  // Each field shows the edited host until it is typed into (state cannot start from a prop here).
  state labelDraft = ""
  state labelEdited = false
  state targetDraft = ""
  state targetEdited = false
  state identityDraft = ""
  state identityEdited = false
  state portDraft = ""
  state portEdited = false
  state optionsFlipped = false
  action editLabel(next: string)
    labelDraft = next
    labelEdited = true
  action editTarget(next: string)
    targetDraft = next
    targetEdited = true
  action editIdentity(next: string)
    identityDraft = next
    identityEdited = true
  action editPort(next: string)
    portDraft = next
    portEdited = true
  action toggleOptions
    optionsFlipped = not optionsFlipped
  derive dialogTargets = ["device-host-name", "device-host-options", "device-host-close"]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" backdrop-filter="blur(4px)" z-index=30 testId="device-host-dialog-overlay"
      column position="relative" width="100%" max-width="32rem" box-sizing="border-box" border-radius="1rem" border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label=editor.title testId="device-host-dialog" id="device-host-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("device-host-dialog") key=dialogFallback("device-host-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract): from Name to the X (DialogPopup's last child).
        FocusGuard(guardId="device-host-guard-start", targets=dialogTargets, popup="device-host-dialog")
        DialogOpenFocus(target=(busy ? "device-host-options" : "device-host-name"))
        column padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" gap="0.5rem"
          text editor.title font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
          text editor.description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
        column padding-top="0.25rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1.5rem" gap="1rem" box-sizing="border-box"
          HostField(label="Name", grow=true)
            input id="device-host-name" value=(labelEdited ? labelDraft : editor.label) input=editLabel placeholder="Mac mini" class=FieldPlaceholder disabled=busy aria-label="Name" spellcheck="false" autocorrect="off" testId="device-host-name" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#18181b, #f5f5f5)" data-focus-stop=(busy ? "" : "enabled") data-editable="yes"
          HostField(label="SSH target", grow=true)
            input value=(targetEdited ? targetDraft : editor.target) input=editTarget placeholder="user@host or SSH alias" class=FieldPlaceholder disabled=busy aria-label="SSH target" spellcheck="false" autocorrect="off" testId="device-host-target" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#18181b, #f5f5f5)" id="field-device-host-target" data-editable="yes"
          column gap="0.75rem"
            button id="device-host-options" press=toggleOptions aria-expanded=(optionsFlipped != editor.optionsOpen) testId="device-host-options" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" align-self="flex-start" data-focus-stop="enabled"
              box rotate=((optionsFlipped != editor.optionsOpen) ? 90 : 0)
                LucideChevronRight(size=14, color="light-dark(#71717b, #a1a1a1)")
              text "SSH options" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
            if optionsFlipped != editor.optionsOpen
              row width="100%" gap="0.75rem"
                HostField(label="Identity file", grow=true)
                  input value=(identityEdited ? identityDraft : editor.identityFile) input=editIdentity placeholder="SSH config default" class=FieldPlaceholder disabled=busy aria-label="Identity file" spellcheck="false" autocorrect="off" testId="device-host-identity" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#18181b, #f5f5f5)" id="field-device-host-identity" data-editable="yes"
                HostField(label="Port", grow=false)
                  input value=(portEdited ? portDraft : editor.port) input=editPort placeholder="Default" class=FieldPlaceholder disabled=busy aria-label="Port" spellcheck="false" autocorrect="off" testId="device-host-port" flex=1 min-width=0 height="1.875rem" padding=0 position="relative" top="0.40625rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.875rem" color="light-dark(#18181b, #f5f5f5)" id="field-device-host-port" data-editable="yes"
              text "Optional. Resolved separately on each environment." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
          HostCheckPanel(checks=checks, checkKey=`${(targetEdited ? targetDraft : editor.target).trim()}|${(portEdited ? portDraft : editor.port).trim()}|${(identityEdited ? identityDraft : editor.identityFile).trim()}`, busy=busy, valid=((targetEdited ? targetDraft : editor.target).trim() != "" and not (targetEdited ? targetDraft : editor.target).trim().startsWith("-") and not (targetEdited ? targetDraft : editor.target).trim().includes(" ")), test=rest("hosts-test", `id=${editor.id}&label=${encodeURIComponent((labelEdited ? labelDraft : editor.label))}&target=${encodeURIComponent((targetEdited ? targetDraft : editor.target))}&identityFile=${encodeURIComponent((identityEdited ? identityDraft : editor.identityFile))}&port=${encodeURIComponent((portEdited ? portDraft : editor.port))}`))
          if error != ""
            text error role="alert" font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)" testId="device-host-error"
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#fafafab8, #ffffff06)"
          button press=rest("hosts-close", "") disabled=busy aria-keyshortcuts="Escape" testId="device-host-cancel" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
          button press=rest("hosts-save", `id=${editor.id}&label=${encodeURIComponent((labelEdited ? labelDraft : editor.label))}&target=${encodeURIComponent((targetEdited ? targetDraft : editor.target))}&identityFile=${encodeURIComponent((identityEdited ? identityDraft : editor.identityFile))}&port=${encodeURIComponent((portEdited ? portDraft : editor.port))}`) disabled=(busy or (labelEdited ? labelDraft : editor.label).trim() == "" or (targetEdited ? targetDraft : editor.target).trim() == "") testId="device-host-save" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" display="flex" flex-direction="row" align-items="center" opacity=(busy or (labelEdited ? labelDraft : editor.label).trim() == "" or (targetEdited ? targetDraft : editor.target).trim() == "" ? 0.64 : 1) data-focus-stop=((busy or (labelEdited ? labelDraft : editor.label).trim() == "" or (targetEdited ? targetDraft : editor.target).trim() == "") ? "" : "enabled")
            text "Save host" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        button id="device-host-close" press=rest("hosts-close", "") disabled=busy aria-label="Close" position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" testId="device-host-close" title="" data-focus-stop=(busy ? "" : "enabled")
          LucideX(size=16, color="light-dark(#71717b, #a1a1a1)")
        FocusGuard(guardId="device-host-guard-end", targets=dialogTargets, popup="device-host-dialog")

component HostField
  props
    label: string
    grow: bool
  slot
  view
    column flex=(grow ? 1 : 0) width=(grow ? "auto" : "7rem") min-width=0 gap="0.375rem"
      text label font-size="0.875rem" line-height="1.0625rem" color="light-dark(#18181b, #f5f5f5)"
      row width="100%" height="2rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" box-shadow="0 1px 2px #0000000a" align-items="center" padding-left="0.6875rem" padding-right="0.6875rem"
        children

// The connection check panel: its status line and Test connection, then each environment's result.
component HostCheckPanel
  props
    checks: HostCheckGroup[]
    checkKey: string
    busy: bool
    valid: bool
    test: action
  state expandedKey = ""
  state expanded = false
  action toggle
    expandedKey = checkKey
    expanded = not expanded
  derive results = checks.filter((group) => group.key == checkKey).map((group) => group.results).flat()
  derive checksOpen = results.length <= 1 or (expandedKey == checkKey ? expanded : results.filter((result) => result.status == "Failed").length > 0)
  view
    column width="100%" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0c)" box-sizing="border-box" testId="device-host-checks"
      row width="100%" align-items="center" justify-content="space-between" gap="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box"
        text (checks.filter((group) => group.key == checkKey).length == 0 ? "Check access before saving" : checks.filter((group) => group.key == checkKey).map((group) => group.summary).join("")) role="status" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId="device-host-check-status"
        HostButton(label="Test connection", disabled=(busy or not valid or checks.filter((group) => group.key == checkKey and group.checking).length > 0), press=test, buttonId="device-host-test", plus=false, stop="enabled")
      if results.length > 1
        button press=toggle aria-expanded=checksOpen testId="device-host-check-toggle" padding="0.5rem" border-width=0 background-color="#00000000"
          text (checksOpen ? "Hide machines" : "Show machines") font-size="0.75rem"
      for group in checks key=group.key
        if group.key == checkKey and checksOpen
          for result in group.results key=result.id
            column width="100%" gap="0.375rem" padding-top="0.625rem" padding-bottom="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff0c)"
              row width="100%" justify-content="space-between" align-items="center" gap="0.75rem"
                text result.label font-size="0.75rem" font-weight=500 line-height="1rem" line-clamp=1 color="light-dark(#18181b, #f5f5f5)"
                row gap="0.375rem" align-items="center" flex-shrink=0
                  if result.status == "Already available locally"
                    LucideLaptop(size=12, color="light-dark(#71717b, #a1a1a1)")
                  if result.status == "Failed"
                    LucideX(size=12, color="light-dark(#dc2626, #f87171)")
                  if result.status == "Connected"
                    LucideCheck(size=12, color="light-dark(#71717b, #a1a1a1)")
                  text result.status font-size="0.75rem" line-height="1rem" color=(result.status == "Failed" ? "light-dark(#dc2626, #f87171)" : "light-dark(#71717b, #a1a1a1)")
              if result.platforms != ""
                text result.platforms font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              if result.error != ""
                HostCheckError(error=result.error)

// The failed check's <details>: "Show error", then the error itself.
component HostCheckError
  props
    error: string
  state open = false
  action toggle
    open = not open
  view
    column width="100%" gap="0.25rem"
      button press=toggle aria-expanded=open testId="device-host-check-error" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" align-self="flex-start"
        box rotate=(open ? 90 : 0)
          LucideChevronRight(size=12, color="light-dark(#71717b, #a1a1a1)")
        text "Show error" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
      if open
        text error font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#71717b, #a1a1a1)"
