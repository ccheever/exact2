use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
// MIT reference, see LICENSE-T3: DeviceToolsPanel's drawer and the glyphs the
// rail gained (DeviceControlsRail: Back, Recents, Rotate menu, Device tools, 3D view, Flat view,
// Magic Keyboard, Restore 3D view). Sizes are the reference's desktop (`sm:`) values: buttons and
// selects xs (24pt), compact inputs 28pt, the small switch 26 × 16, the drawer 288pt wide; colours
// are the served build's tokens. `local` is chatLocal (`surface-session-tools-*` drafts and toggles),
// `command` the `device.action` writes (`shell:surface-session-tools-act`, device-tools.ts).
use ToolsDrawerState from "./device-tools-shapes.contract"
use ToolsOption from "./device-tools-shapes.contract"
use SkPopup from "../settings/settings-kit.contract"
use SkMenuItem from "../settings/settings-kit.contract"
use KmItem from "../shared/menu-keys.contract"

fn toolsInk(): string = "light-dark(#27272a, #f5f5f5)"
fn toolsMuted(): string = "light-dark(#71717b, #818181)"
fn toolsBorder(): string = "light-dark(#e4e4e7, #ffffff14)"
fn toolsInputBorder(): string = "light-dark(#d4d4d8, #ffffff14)"
fn toolsFieldBackground(): string = "light-dark(#fcfcfc, #ffffff07)"
fn toolsDestructive(): string = "light-dark(#e40014, #ff6467)"

keyframes toolsSpin
  from rotate=0
  to rotate=360

component ToolsGlyph
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      if name == "sliders"
        path d="M10 5H3M12 19H3M14 3v4M16 17v4M21 12h-9M21 19h-5M21 5h-7M8 10v4M8 12H3"
      if name == "box"
        path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"
        path d="m3.3 7 8.7 5 8.7-5M12 22V12"
      if name == "smartphone"
        rect x=5 y=2 width=14 height=20 rx=2 ry=2
        path d="M12 18h.01"
      if name == "back"
        path d="m15 18-6-6 6-6"
      if name == "square"
        rect x=3 y=3 width=18 height=18 rx=2
      if name == "keyboard"
        path d="M10 8h.01M12 12h.01M14 8h.01M16 12h.01M18 8h.01M6 8h.01M7 16h10M8 12h.01"
        rect x=2 y=4 width=20 height=16 rx=2
      if name == "maximize"
        path d="M8 3H5a2 2 0 0 0-2 2v3M21 8V5a2 2 0 0 0-2-2h-3M3 16v3a2 2 0 0 0 2 2h3M16 21h3a2 2 0 0 0 2-2v-3"
      if name == "chevron-down"
        path d="m6 9 6 6 6-6"
      if name == "x"
        path d="M18 6 6 18M6 6l12 12"
      if name == "spinner"
        path d="M21 12a9 9 0 1 1-6.219-8.56"

// RightPanelTabs' device tab glyph: the Apple and Android marks of Icons.tsx (filled).
component PlatformGlyph
  props
    platform: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      if platform == "apple"
        path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
      else
        path d="m8 3-1-2m9 2 1-2" fill="none" stroke="currentColor" stroke-width=1.4 stroke-linecap="round"
        path fill-rule="evenodd" d="M5 10a7 7 0 0 1 14 0H5Zm4-4a.8.8 0 1 0 0 1.6A.8.8 0 0 0 9 6Zm6 0a.8.8 0 1 0 0 1.6A.8.8 0 0 0 15 6Z"
        path d="M5 11h14v7a2 2 0 0 1-2 2v2a1.5 1.5 0 0 1-3 0v-2h-4v2a1.5 1.5 0 0 1-3 0v-2a2 2 0 0 1-2-2v-7Z"
        rect x=1 y=11 width=3 height=8 rx=1.5
        rect x=20 y=11 width=3 height=8 rx=1.5

// Spinner size sm (14pt), spinning.
component ToolsSpinner
  props
    size: number
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` display="flex" flex-shrink=0 animation="toolsSpin 1s linear infinite" role="status" aria-label="Loading"
      ToolsGlyph(name="spinner", size=size, color=toolsMuted())

// Button xs: 24pt, text-xs medium, outline (input border, popover fill) or ghost.
component ToolsButton
  props
    label: string
    outline: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(outline ? toolsInputBorder() : "#00000000") flex-shrink=0 opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0f)" : outline ? "light-dark(#ffffff, #ffffff07)" : "#00000000") box-shadow=(outline and not disabled ? "0 1px 2px #0000000d" : "none")
      text label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=toolsInk()

// Input compact, mono: a 28pt field inside its 1pt border, rounded-md.
component ToolsField
  props
    value: string
    placeholder: string
    label: string
    disabled: bool
    input: action
    submit: action
    testId: string
  view
    input value=value input=input submit=submit placeholder=placeholder aria-label=label disabled=disabled autocorrect="off" spellcheck="false" testId=testId flex=1 min-width=0 height="1.875rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=toolsInputBorder() background-color=toolsFieldBackground() box-shadow="0 1px 2px #0000000d" opacity=(disabled ? 0.64 : 1) font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=toolsInk()
      ::placeholder
        color=toolsMuted()

// Switch size sm: a 26 × 16 track, 12pt thumb.
component ToolsSwitchControl
  props
    on: bool
    label: string
    disabled: bool
    press: action
    testId: string
  view
    button press=press role="switch" aria-checked=on aria-label=label disabled=disabled testId=testId width="1.625rem" height="1rem" padding="0.125rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" flex-shrink=0 opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content=(on ? "flex-end" : "flex-start") background-color=(on ? "light-dark(#1b4ed8, #346bf1)" : toolsInputBorder()) title=""
      box width="0.75rem" height="0.75rem" border-radius="0.375rem" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 1px 2px #0000000d"

// ToggleGroup (segmented): two toggles in a tinted track.
component ToolsSegment
  props
    label: string
    value: string
    first: string
    firstLabel: string
    second: string
    secondLabel: string
    disabled: bool
    choose: action
    testId: string
  view
    row gap="0.125rem" padding="0.125rem" border-radius="0.625rem" background-color="light-dark(#d4d4d866, #ffffff08)" role="group" aria-label=label opacity=(disabled ? 0.64 : 1) testId=testId
      button press=choose(first) disabled=disabled aria-checked=(value == first) testId=`${testId}-${first}` height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" display="flex" align-items="center" background-color=(value == first ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(value == first ? "0 1px 2px #0000001a" : "none")
        text firstLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(value == first ? toolsInk() : toolsMuted())
      button press=choose(second) disabled=disabled aria-checked=(value == second) testId=`${testId}-${second}` height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" display="flex" align-items="center" background-color=(value == second ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(value == second ? "0 1px 2px #0000001a" : "none")
        text secondLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(value == second ? toolsInk() : toolsMuted())

// ChoiceSelect: an xs trigger (the placeholder muted) over a popup aligned to its end.
component ToolsSelect
  props
    selectId: string
    label: string
    valueLabel: string
    known: bool
    width: number
    disabled: bool
    options: ToolsOption[]
    choose: action
  // Keyboard opening targets the first or last enabled menu row.
  derive menuItems = options.map((option) => KmItem(id=`${selectId}-option-${option.value}`, label=option.label))
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`${selectId}-menu`, source=selectId)
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  view
    column position="relative" flex-shrink=0
      button popovertarget=`${selectId}-menu` key=triggerKey role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId width=width height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=toolsInputBorder() background-color=toolsFieldBackground() box-shadow="0 1px 2px #0000000d" opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
        text valueLabel flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=(known ? toolsInk() : toolsMuted())
        box margin-right="-0.25rem" opacity=0.5 display="flex"
          ToolsGlyph(name="chevron-down", size=12, color=toolsInk())
      SkPopup(menuId=`${selectId}-menu`, invoker=selectId, label=label, width=width, list=true, endAlign=width, items=menuItems, keyed=0)
        for option in options key=option.value
          SkMenuItem(keysId=`${selectId}-menu-keys`, label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=option.selected, check=true, destructive=false, disabled=false, choose=choose(option.value))

component ToolsSection
  props
    title: string
    last: bool
  slot
  view
    column gap="0.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" border-bottom-width=(last ? 0 : 1) border-bottom-style="solid" border-color=toolsBorder()
      text title font-size="0.75rem" font-weight=500 line-height="1rem" color=toolsMuted() role="heading" aria-level=3
      children

component ToolsRow
  props
    label: string
  slot
  view
    row min-height="1.75rem" align-items="center" justify-content="space-between" gap="0.75rem"
      text label flex-shrink=0 font-size="0.75rem" line-height="1rem" color=toolsMuted()
      row min-width=0 align-items="center" justify-content="flex-end"
        children

// DeviceToolsPanel: settings read from the device, one control per action, the hub's feeds.
component ToolsDrawer
  props
    tools: ToolsDrawerState
    local: action
    edit: action
    command: action
  view
    column min-height=0 height="100%" width=(tools.overlay ? "100%" : "18rem") max-width="18rem" flex-shrink=0 box-sizing="border-box" border-left-width=1 border-left-style="solid" border-color=toolsBorder() background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow=(tools.overlay ? "0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a" : "none") role="complementary" aria-label="Device tools" testId="device-tools"
      row height="2.25rem" flex-shrink=0 gap="0.5rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color=toolsBorder()
        text "Tools" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=toolsInk()
        if tools.pending
          ToolsSpinner(size=14)
        box flex=1
        button press=local("surface-session-tools-close", "", "") aria-label="Close tools" testId="device-tools-close" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
          ToolsGlyph(name="x", size=14, color=toolsMuted())
      scroll flex=1 min-height=0
        column width="100%"
          if tools.error != ""
            text tools.error padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" border-bottom-width=1 border-bottom-style="solid" border-color=toolsBorder() background-color="light-dark(#e400141a, #ff64671a)" font-size="0.75rem" line-height="1rem" color=toolsDestructive() role="alert" testId="device-tools-error"
          if tools.loading
            row gap="0.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.75rem" padding-bottom="0.75rem" align-items="center"
              ToolsSpinner(size=14)
              text "Reading device settings…" font-size="0.75rem" line-height="1rem" color=toolsMuted()
          if tools.diagnostics != ""
            ToolsSection(title="Host diagnostics", last=false)
              text tools.diagnostics white-space="pre-line" font-size="0.75rem" line-height="1rem" color=toolsMuted()
          ToolsSection(title="App", last=false)
            ToolsRow(label="Foreground")
              text tools.foreground min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=toolsInk() testId="device-tools-foreground"
            if tools.hasForeground
              row gap="0.375rem"
                ToolsButton(label="Terminate", outline=true, disabled=tools.disabled, press=command("shell:surface-session-tools-act", "terminate", "", 0), testId="device-tools-terminate")
                ToolsButton(label="Relaunch", outline=true, disabled=tools.disabled, press=command("shell:surface-session-tools-act", "relaunch", "", 0), testId="device-tools-relaunch")
            row gap="0.375rem" align-items="flex-start"
              ToolsField(value=tools.url, placeholder="https://… or myapp://", label="URL", disabled=tools.disabled, input=edit("surface-session-tools-draft-url", ""), submit=local("surface-session-tools-submit-url", "", ""), testId="device-tools-url")
              ToolsButton(label="Open", outline=true, disabled=tools.urlDisabled, press=command("shell:surface-session-tools-act", "url", "", 0), testId="device-tools-open-url")
            row gap="0.375rem" align-items="flex-start"
              ToolsField(value=tools.launch, placeholder=tools.launchPlaceholder, label=tools.launchPlaceholder, disabled=tools.disabled, input=edit("surface-session-tools-draft-launch", ""), submit=local("surface-session-tools-submit-launch", "", ""), testId="device-tools-launch")
              ToolsButton(label="Launch", outline=true, disabled=tools.launchDisabled, press=command("shell:surface-session-tools-act", "launch", "", 0), testId="device-tools-launch-app")
          ToolsSection(title=tools.platformTitle, last=false)
            ToolsRow(label="Appearance")
              ToolsSegment(label="Appearance", value=tools.appearance, first="light", firstLabel="Light", second="dark", secondLabel="Dark", disabled=tools.disabled, choose=edit("surface-session-tools-pick-appearance", ""), testId="device-tools-appearance")
            ToolsRow(label="Text size")
              ToolsSelect(selectId="device-tools-text-size", label="Text size", valueLabel=tools.textSizeLabel, known=tools.textSizeKnown, width=160, disabled=tools.disabled, options=tools.textSizes, choose=edit("surface-session-tools-pick-text-size", ""))
            if tools.ios
              ToolsRow(label="Liquid Glass")
                ToolsSegment(label="Liquid Glass", value=tools.liquidGlass, first="clear", firstLabel="Clear", second="tinted", secondLabel="Tinted", disabled=tools.liquidGlassDisabled, choose=edit("surface-session-tools-pick-liquid-glass", ""), testId="device-tools-liquid-glass")
              ToolsRow(label="Color filter")
                ToolsSelect(selectId="device-tools-color-filter", label="Color filter", valueLabel=tools.colorFilterLabel, known=tools.colorFilterKnown, width=160, disabled=tools.disabled, options=tools.colorFilters, choose=edit("surface-session-tools-pick-color-filter", ""))
            else
              ToolsRow(label="Orientation")
                ToolsSelect(selectId="device-tools-orientation", label="Orientation", valueLabel="Rotate to…", known=false, width=160, disabled=tools.disabled, options=tools.orientations, choose=edit("surface-session-tools-pick-orientation", ""))
            for item in tools.switches key=item.id
              ToolsRow(label=item.label)
                ToolsSwitchControl(on=item.checked, label=item.label, disabled=item.disabled, press=command("shell:surface-session-tools-act", "toggle", `${item.id}=${item.checked ? "0" : "1"}`, 0), testId=`device-tools-${item.id}`)
          ToolsSection(title="Accessibility", last=false)
            ToolsRow(label="Overlay element frames")
              ToolsSwitchControl(on=tools.axOn, label="Overlay element frames", disabled=false, press=local("surface-session-tools-ax", "", ""), testId="device-tools-ax")
          ToolsSection(title="Location", last=false)
            row gap="0.375rem"
              ToolsField(value=tools.lat, placeholder="Latitude", label="Latitude", disabled=tools.disabled, input=edit("surface-session-tools-draft-lat", ""), submit=local("surface-session-tools-submit-location", "", ""), testId="device-tools-latitude")
              ToolsField(value=tools.lng, placeholder="Longitude", label="Longitude", disabled=tools.disabled, input=edit("surface-session-tools-draft-lng", ""), submit=local("surface-session-tools-submit-location", "", ""), testId="device-tools-longitude")
            row gap="0.375rem" flex-wrap="wrap" align-items="center"
              ToolsSelect(selectId="device-tools-preset", label="Location preset", valueLabel="Preset…", known=false, width=128, disabled=tools.disabled, options=tools.presets, choose=edit("surface-session-tools-pick-preset", ""))
              ToolsButton(label="Set", outline=true, disabled=(tools.disabled or not tools.locationValid), press=command("shell:surface-session-tools-act", "location", "", 0), testId="device-tools-location-set")
              if tools.ios
                ToolsButton(label="Clear", outline=false, disabled=tools.disabled, press=command("shell:surface-session-tools-act", "location-clear", "", 0), testId="device-tools-location-clear")
          ToolsSection(title="Permissions", last=not tools.ios)
            ToolsField(value=tools.permApp, placeholder=tools.permPlaceholder, label="App ID", disabled=tools.disabled, input=edit("surface-session-tools-draft-permApp", ""), submit=local("surface-session-tools-noop", "", ""), testId="device-tools-permission-app")
            row gap="0.375rem" flex-wrap="wrap" align-items="center"
              ToolsSelect(selectId="device-tools-permission", label="Permission", valueLabel=tools.permissionLabel, known=true, width=160, disabled=tools.disabled, options=tools.permissions, choose=edit("surface-session-tools-permission", ""))
              ToolsButton(label="Grant", outline=true, disabled=tools.permDisabled, press=command("shell:surface-session-tools-act", "grant", "", 0), testId="device-tools-grant")
              ToolsButton(label="Revoke", outline=true, disabled=tools.permDisabled, press=command("shell:surface-session-tools-act", "revoke", "", 0), testId="device-tools-revoke")
              if tools.ios
                ToolsButton(label="Reset", outline=false, disabled=tools.permDisabled, press=command("shell:surface-session-tools-act", "reset", "", 0), testId="device-tools-reset")
          if tools.ios
            ToolsSection(title="Push notification", last=false)
              row gap="0.375rem" align-items="flex-start"
                ToolsField(value=tools.push, placeholder="Alert text", label="Alert text", disabled=tools.pushDisabled, input=edit("surface-session-tools-draft-push", ""), submit=local("surface-session-tools-submit-push", "", ""), testId="device-tools-push")
                ToolsButton(label="Send", outline=true, disabled=tools.pushSendDisabled, press=command("shell:surface-session-tools-act", "push", "", 0), testId="device-tools-push-send")
              if not tools.hasForeground
                text "Open an app first." font-size="0.75rem" line-height="1rem" color=toolsMuted()
          if tools.log
            button press=local("surface-session-tools-log", "", "") aria-expanded=tools.logOpen testId="device-tools-log" width="100%" gap="0.375rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" border-width=0 border-bottom-width=1 border-bottom-style="solid" border-color=toolsBorder() background-color="#00000000" display="flex" flex-direction="row" align-items="center"
              text "Event log" flex=1 text-align="left" font-size="0.75rem" font-weight=500 line-height="1rem" color=toolsMuted()
              box display="flex" rotate=(tools.logOpen ? 180 : 0)
                ToolsGlyph(name="chevron-down", size=14, color=toolsMuted())
            if tools.logOpen
              scroll max-height="16rem"
                column padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" hatch="t3-media" data-media-kind="device-events" data-device-id=tools.logDevice data-device-host=tools.logHost testId="device-tools-events"
                  if tools.eventsEmpty
                    text "No events yet." font-family="ui-monospace" font-size="0.6875rem" line-height="1.1171875rem" color=toolsMuted()
                  for entry in tools.events key=entry.id
                    row gap="0.5rem" min-width=0
                      text entry.time flex-shrink=0 font-family="ui-monospace" font-size="0.6875rem" line-height="1.1171875rem" color=toolsMuted()
                      text entry.summary min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-family="ui-monospace" font-size="0.6875rem" line-height="1.1171875rem" color=toolsInk()
