// A bundled text/object adapter embeds the server-owned document in an opaque frame.
use Icon from "../shared/icons.contract"
shape InlineDocumentBox
  key: string
  kind: string
  x: number
  y: number
  width: number
  height: number
  lines: number
shape InlineDocumentPost
  key: string
  text: string
shape InlineDocument
  key: string
  kind: string
  title: string
  src: string
  ready: bool
  error: string
  height: number
  outline: InlineDocumentBox[]
  posts: InlineDocumentPost[]
  permission: string
  permissionSerial: number
  fullscreen: bool
  closed: bool
  shortcut: string
  shortcutSerial: number

component InlineDocumentFrame
  inject
    inlineDocumentViewportWidth: number
    inlineDocumentViewportHeight: number
  props
    document: InlineDocument
    local: action
  state presented = false
  state zoom = 1
  action zoomIn
    if zoom < 2
      zoom = zoom + 0.25
  action zoomOut
    if zoom > 0.5
      zoom = zoom - 0.25
  action resetZoom
    zoom = 1
  action laidOut(width: number, height: number)
    local("inline-doc-measure", document.key, `${width}|${height}`)
    if document.fullscreen and not presented
      presented = true
      showPopover(`inline-box-${document.key}`)
    else if not document.fullscreen
      presented = false
      zoom = 1
  action reported(payload: string)
    local("inline-doc-message", document.key, payload)
  action loaded
    local("inline-doc-loaded", document.key, "")
  view
    box width="100%" min-width=0 position="relative" height=(document.height + (document.permission != "" ? 160 : 0)) overflow="hidden" testId=`inline-doc-${document.key}`
      for post in document.posts.slice(0, 1) key=post.key
        InlineDocumentPostDelivery(post=post, target=`inline-frame-${document.key}`, local=local, documentKey=document.key)
      if document.shortcut != ""
        for serial in [document.shortcutSerial] key=serial
          InlineDocumentShortcutDelivery(name=document.shortcut)
      box id=`inline-box-${document.key}` popover=(document.fullscreen ? some("manual") : none) position=(document.fullscreen ? "absolute" : "relative") width=(document.fullscreen ? inlineDocumentViewportWidth : "100%") height=(document.fullscreen ? inlineDocumentViewportHeight : document.height + (document.permission != "" ? 160 : 0)) margin=0 padding=0 border-width=0 background-color="light-dark(#fcfcfc, #0a0a0a)" resize=laidOut
        if document.closed
          row gap="0.5rem" align-items="center"
            text "This app was closed." flex=1 color="-exact-secondary-label"
            button press=local("inline-doc-retry", document.key, "") testId="inline-doc-reopen"
              text "Show app"
        else if document.error != ""
          column height="100%" width="100%" align-items="center" justify-content="center" gap="0.5rem"
            text `Unable to load ${document.title}.` color="-exact-secondary-label" font-size="0.875rem"
            button press=local("inline-doc-retry", document.key, "") testId="inline-doc-retry"
              text "Retry"
        else
          if not document.ready
            column position="absolute" left=0 right=0 top=0 bottom=0 aria-label=`Loading ${document.title}` testId="inline-doc-loading" pointer-events="none"
              if document.outline.length > 0
                for box in document.outline key=box.key
                  box position="absolute" left=box.x top=box.y width=box.width height=box.height border-radius="0.25rem" background-color="light-dark(#e4e4e7, #27272a)"
              else
                column width="100%" height="100%" gap="1rem" padding-top="1rem" box-sizing="border-box"
                  box width="40%" height="1.25rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #27272a)"
                  box width="100%" height="8rem" border-radius="0.25rem" background-color="light-dark(#f4f4f5, #18181b)"
                  box width="75%" height="0.75rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #27272a)"
          scroll width="100%" height=(document.fullscreen ? inlineDocumentViewportHeight - (document.kind == "html" ? 48 : 0) : document.height) overflow=(document.fullscreen ? "auto" : "hidden")
            box width=(document.fullscreen ? inlineDocumentViewportWidth * zoom : "100%") height=(document.fullscreen ? (inlineDocumentViewportHeight - (document.kind == "html" ? 48 : 0)) * zoom : document.height)
              if document.src != ""
                iframe id=`inline-frame-${document.key}` src=document.src sandbox="allow-scripts allow-forms allow-popups allow-downloads" message=reported load=loaded width=(document.fullscreen ? inlineDocumentViewportWidth : "100%") height=(document.fullscreen ? inlineDocumentViewportHeight - (document.kind == "html" ? 48 : 0) : document.height) scale=zoom transform-origin="0 0" border-width=0 opacity=(document.ready ? 1 : 0) aria-label=document.title testId="inline-doc-frame"
          button press=local("inline-doc-fullscreen", document.key, document.fullscreen ? "close" : "open") position="absolute" right="0.5rem" top="0.5rem" width="2rem" height="2rem" padding=0 aria-label=(document.fullscreen ? "Exit full screen" : "Expand document") testId="inline-doc-expand"
            Icon(name=(document.fullscreen ? "minimize" : "maximize"), size=14, color="-exact-label")

        if document.fullscreen and document.kind == "html"
          row position="absolute" left=0 right=0 bottom=0 height=48 justify-content="center" align-items="center" gap="0.5rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
            text document.title max-width="40%" text-overflow="ellipsis" white-space="nowrap" overflow="hidden"
            button press=zoomOut disabled=(zoom <= 0.5) aria-label="Zoom out" testId="inline-doc-zoom-out"
              Icon(name="minus", size=14, color="-exact-label")
            button press=resetZoom aria-label="Reset zoom" testId="inline-doc-zoom-reset"
              text `${zoom * 100}%` font-variant-numeric="tabular-nums"
            button press=zoomIn disabled=(zoom >= 2) aria-label="Zoom in" testId="inline-doc-zoom-in"
              Icon(name="plus", size=14, color="-exact-label")

        if document.permission != ""
          column position="absolute" left=0 right=0 bottom=0 height=160 padding="0.75rem" box-sizing="border-box" gap="0.5rem" background-color="light-dark(#fcfcfc, #0a0a0a)" role="alertdialog" aria-label="App permission" testId="inline-doc-permission"
            scroll flex=1 min-height=0
              text document.permission font-size="0.8125rem" white-space="pre-wrap"
            row justify-content="flex-end" gap="0.5rem"
              button press=local("inline-doc-permission", document.key, `${document.permissionSerial}:deny`) testId="inline-doc-deny"
                text "Decline"
              button press=local("inline-doc-permission", document.key, `${document.permissionSerial}:allow`) testId="inline-doc-allow"
                text "Allow"


component InlineDocumentPostDelivery
  props
    post: InlineDocumentPost
    target: string
    documentKey: string
    local: action
  state sent = false
  action laidOut(width: number, height: number)
    if width > 0 and height > 0 and not sent
      sent = true
      postMessage(post.text, target)
      local("inline-doc-ack", documentKey, post.key)
  view
    box width=1 height=1 position="absolute" opacity=0 pointer-events="none" aria-hidden=true resize=laidOut

component InlineDocumentShortcutDelivery
  inject
    inlineDocumentShortcut: action
  props
    name: string
  state sent = false
  action laidOut(width: number, height: number)
    if width > 0 and height > 0 and not sent
      sent = true
      inlineDocumentShortcut(name)
  view
    box width=1 height=1 position="absolute" opacity=0 pointer-events="none" aria-hidden=true resize=laidOut
