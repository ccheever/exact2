use Icon from "../shared/icons.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"

// A Markdown table's Copy menu (ChatMarkdown.tsx MenuPopup align="end",
// MIT, see LICENSE-T3) drawn at the window's top layer, as Base UI portals it: over the
// provider banner and every sheet. As a modal menu it takes the window: a press outside
// closes it and reaches nothing behind, and Escape closes it. The trigger keeps its open
// tint (data-popup-open) while the popup is up, so the layer paints it over the table.
shape TableMenuView
  id: string
  x: number
  y: number
  triggerX: number
  triggerY: number
  markdown: string
  csv: string
  // 1 when ↓ opened the menu (its first item takes the focus), -1 for ↑ (the last), 0 for none.
  keyed: number

component TableCopyMenu
  props
    menu: TableMenuView
    dark: bool
    local: action
  // Escape gives the focus back to the table's Copy button.
  action closeMenu
    local("table-menu-close", menu.id, "")
    focus(`table-copy-${menu.id}`)
  view
    button press=closeMenu aria-label="Close menu" aria-keyshortcuts="Escape" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 border-radius=0 background-color="#00000000" z-index=130 testId="table-copy-menu-backdrop" title=""
    box position="absolute" left=menu.triggerX top=menu.triggerY width="1.5rem" height="1.5rem" border-radius="0.5rem" background-color="light-dark(#f4f4f5, #ffffff0a)" display="flex" flex-direction="row" align-items="center" justify-content="center" z-index=131 pointer-events="none" aria-hidden=true
      Icon(name="copy", size=12, color="light-dark(#18181b, #f5f5f5)")
    column position="absolute" left=menu.x top=menu.y width="10rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" z-index=132 role="menu" aria-label="Copy table" testId="table-copy-menu"
      KeyMenu(menuId="table-copy-keys", items=[KmItem(id=`table-copy-markdown-${menu.id}`, label="Copy as Markdown"), KmItem(id=`table-copy-csv-${menu.id}`, label="Copy as CSV")], keyed=menu.keyed, gap="0px", modal=false)
        TableMenuItem(keysId="table-copy-keys", label="Copy as Markdown", press=local("copy-table", menu.id, menu.markdown), testId=`table-copy-markdown-${menu.id}`)
        TableMenuItem(keysId="table-copy-keys", label="Copy as CSV", press=local("copy-table", menu.id, menu.csv), testId=`table-copy-csv-${menu.id}`)

component TableMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    press: action
    testId: string
  state lit = false
  action hover(over: bool)
    if over
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press hover=hover focus=focused(true) blur=focused(false) role="menuitem" aria-label=label testId=testId width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(lit ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
