// App-local chat typography over the existing portable Markdown parser.
use FileTypeIcon from "../shared/timeline-files.contract"
use TimelineIcon from "./timeline-icons-kit.contract"
use Tip from "../shell/shell-tip.contract"
use AttachmentUrl from "./timeline-attachments.contract"
use CodeTip from "./code-tips.contract"
use Icon from "../shared/icons.contract"
use MorphMaximize, MorphCopyCheck from "../shell/shell-morph.contract"
use CitePart, CiteOffer, citePart, citeEndKey, citeLineRight, citeLineBottom, citeAxis, citeSize, citeOfferFor from "./diff-cite.contract"
use MarkdownMedia from "../media/media-markdown.contract"
use hoverTipAtFrame from "../shell/hover-layer.contract" // a pull request link's card
use kmArrow from "../shared/menu-keys.contract"
use heldModifiers from "../shared/press-modifiers.contract"
use EditorMenuIcon from "../composer/composer-editor.contract" // a pull request chip's state glyph
shape ChatRun
  id: string
  text: string
  weight: number
  slant: string
  mono: bool
  href: string
  kind: string
  icon: string
  // Every run of a link: the whole link's text (markdown.rs link_labels), the link node's name on its first word, the
  // mark that hides its other words; "" elsewhere and on a link that starts with a code span (it draws no link node).
  label: string
  // A media run inside a link's text: the link's destination (MarkdownAnchor's `<a>` around the `<img>`); "" elsewhere.
  link: string
shape ChatCell
  id: string
  runs: ChatRun[]
// A table row (markdown_tables.rs): its cells, one per column.
shape ChatTableRow
  id: string
  header: bool
  cells: ChatCell[]
// A table column: the cell that sizes it (drawn invisibly in every row, so the
// host's own metrics set the width), whether it reached the 24rem cap, and its
// share of any spare room (its estimated width).
shape ChatColumn
  id: string
  sizer: ChatRun[]
  capped: bool
  header: bool
  grow: number
  // GFM alignment from the table's rule row: "left", "right" or "center" (markdown_table_align.rs).
  align: string
shape ChatBlock
  id: string
  kind: string
  depth: number
  marker: string
  text: string
  href: string
  header: bool
  runs: ChatRun[]
  cells: ChatCell[]
  gap: number
  flow: bool
  rows: ChatTableRow[]
  columns: ChatColumn[]
  markdown: string
  csv: string
  closedFence: bool
  // A GFM task item (markdown_links.rs task_items): "open", "done" or "", and its `[`'s offset in the file's text,
  // -1 where the checkbox is GFM's disabled one (the transcript, a read-only file).
  task: string
  taskOffset: number
shape ChatDocument
  id: string
  blocks: ChatBlock[]

// A fenced block's highlight (timeline-highlight.ts), matched to the parsed
// block by its exact text.
shape CodeToken
  id: string
  text: string
  cls: string
shape CodeHighlight
  id: string
  code: string
  icon: string
  tokens: CodeToken[]
// What a fence's Mermaid page reported in one theme (timeline-mermaid.ts): `diagram` is "loading", "rendered" (its
// natural size) or "error" (Mermaid's message, whether Retry may help).
shape MermaidFrame
  diagram: string
  message: string
  retryable: bool
  width: number
  height: number
// A settled ```mermaid fence, matched to its parsed block by text: its page (assets/mermaid/) in each theme.
shape MermaidDiagram
  id: string
  code: string
  srcLight: string
  srcDark: string
  light: MermaidFrame
  dark: MermaidFrame

// pierre-light / pierre-dark, the reference's Shiki themes, by token class.
// A class ends in "+i" where the pierre theme sets italic (shiki-highlight.ts).
fn synColor(cls: string): string = synInk(cls.endsWith("+i") ? cls.slice(0, -2) : cls)
fn synSlant(cls: string): string = cls.endsWith("+i") ? "italic" : "normal"
fn synInk(cls: string): string = ["kw", "decl", "type", "fn", "var", "const"].includes(cls) ? (cls == "kw" ? "light-dark(#d32a61, #ff678d)" : cls == "decl" or cls == "type" ? "light-dark(#a631be, #d568ea)" : cls == "fn" ? "light-dark(#693acf, #9d6afb)" : cls == "var" ? "light-dark(#d47628, #ffa359)" : "light-dark(#d5901c, #ffab16)") : ["param", "pyparam", "flag", "interp", "bold", "str", "esc", "num"].includes(cls) ? (cls == "param" ? "light-dark(#636363, #a3a3a3)" : cls == "pyparam" or cls == "flag" or cls == "interp" or cls == "bold" ? "light-dark(#d5a910, #ffd452)" : cls == "str" ? "light-dark(#199f43, #5ecc71)" : cls == "esc" ? "light-dark(#16a994, #61d5c0)" : "light-dark(#1ca1c7, #68cdf2)") : ["nul", "op", "builtin", "punct", "com", "key", "tag", "heading", "attr"].includes(cls) ? (cls == "nul" or cls == "op" or cls == "builtin" ? "#08c0ef" : cls == "punct" ? "#636363" : cls == "com" ? "#737373" : cls == "key" or cls == "tag" or cls == "heading" ? "light-dark(#d5512f, #ff855e)" : "light-dark(#18a46c, #60d199)") : ["regex", "deco"].includes(cls) ? (cls == "regex" ? "light-dark(#17a5af, #64d1db)" : "light-dark(#1a85d4, #69b1ff)") : "light-dark(#0a0a0a, #fafafa)"

shape TranscriptMarkdown
  documents: ChatDocument[]
// renderFileMarkdown's message record (id, kind, a title it ignores, the text): kind "file" (Files' rendered file) lets
// task checkboxes write; kind "attachment" (a sent attachment's preview) has no folder.
shape MarkdownSource
  id: string
  kind: string
  title: string
  body: string

// A chip's presentation (message-chips.ts), matched to its run by href:
// kind "link" (a file link's full path), "mention", "file", "video", "image",
// "skill", "thread", "unresolved", or a popover kind ("terminal", "element",
// "review") whose `detail` the popover shows under `tip`.
shape ChipView
  id: string
  href: string
  kind: string
  label: string
  size: string
  tip: string
  detail: string
  icon: string
  target: string
  owner: string
// Settings → Appearance for chat Markdown (fontFamilyCode, fontSizeCode,
// wordWrap) and the message's chips.
shape MarkdownEnv
  codeFont: string
  codeSize: number
  wrap: bool
  chips: ChipView[]
  runCommands: string[]
fn noUrls(): AttachmentUrl[] = []
// diff-review (Cite): an answer's text as the reference reads it (readAssistantText: each block's
// displayed text, a line break between blocks), and where a block starts in it. A code block's
// header reads its language when no file icon stands for it (MarkdownCodeBlockTitleContent), a line before the code.
fn citeCodeLabel(b: ChatBlock, code: CodeHighlight[]): string = b.kind == "code" and code.filter((hl) => hl.code == b.text and hl.icon != "").length == 0 ? b.href : ""
fn citeBlockText(b: ChatBlock, code: CodeHighlight[]): string = b.kind == "code" ? (citeCodeLabel(b, code) != "" ? `${citeCodeLabel(b, code)}\n${b.text}` : b.text) : b.runs.map((r) => r.text).join("")
fn citeStream(blocks: ChatBlock[], code: CodeHighlight[]): string = blocks.map((b) => citeBlockText(b, code)).join("\n")
fn citeOffset(blocks: ChatBlock[], code: CodeHighlight[], blockId: string): number = blocks.map((b) => b.id).indexOf(blockId) <= 0 ? 0 : blocks.map((b) => citeBlockText(b, code)).slice(0, blocks.map((b) => b.id).indexOf(blockId)).join("\n").length + 1
// Where a selectable text starts in its block: a code block's code after its label's line, a word
// or code span of a block laid out word by word (FlowRuns) after the runs before it; a whole block's text at its start.
fn citeRunOffset(blocks: ChatBlock[], code: CodeHighlight[], blockId: string, runId: string): number = runId == "" ? 0 : runId == "code" ? blocks.filter((b) => b.id == blockId).map((b) => citeCodeLabel(b, code) != "" ? `${citeCodeLabel(b, code)}\n` : "").join("").length : blocks.filter((b) => b.id == blockId).map((b) => b.runs.slice(0, max(0, b.runs.map((r) => r.id).indexOf(runId))).map((r) => r.text).join("")).join("").length
fn noChips(): ChipView[] = []
// Where run `id` starts in its block's text (the runs before it), and where token `id` starts in
// its code; with the cited text's [start, end) in the same offsets (`ms`, `me`; -1 when nothing is marked there).
fn runAt(runs: ChatRun[], id: string): number = runs.slice(0, max(0, runs.map((r) => r.id).indexOf(id))).map((r) => r.text).join("").length
fn tokenAt(tokens: CodeToken[], id: string): number = tokens.slice(0, max(0, tokens.map((t) => t.id).indexOf(id))).map((t) => t.text).join("").length
fn citeMarks(ms: number, me: number, at: number, size: number): bool = ms >= 0 and me > at and ms < at + size

// Occurrence ids come from the same parsed blocks/runs that draw the images. Shared URLs keep separate entries.
// An image inside a link's text is the link's to press (expandableMarkdownImageProps returns early inside an `<a>`).
fn galleryImage(href: string, chips: ChipView[]): bool = chips.filter((chip) => chip.kind == "media" and chip.href == href and chip.size == "image" and chip.icon != "blocked").length > 0
fn galleryRun(run: ChatRun, chips: ChipView[]): bool = run.kind == "media" and run.link == "" and galleryImage(run.href, chips)
// A table's images, row by row and cell by cell (TableCell's node ids).
fn tableGalleryIds(block: ChatBlock, chips: ChipView[]): string = block.rows.map((row) => row.cells.map((cell) => cell.runs.filter((run) => galleryRun(run, chips)).map((run) => `${block.id}-${row.id}-${cell.id}-${run.id}`).join("\n")).join("\n")).join("\n")
fn markdownGalleryIds(blocks: ChatBlock[], chips: ChipView[]): string[] = blocks.map((block) => block.kind == "image" ? (galleryImage(block.href, chips) ? block.id : "") : block.kind == "table" ? tableGalleryIds(block, chips) : (block.flow and not ["code", "table-row", "rule"].includes(block.kind) ? block.runs.filter((run) => galleryRun(run, chips)).map((run) => `${block.id}-${run.id}`).join("\n") : "")).join("\n").split("\n").filter((id) => id != "")

component ChatMarkdown
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    env: MarkdownEnv
  view
    EnvBlocks(document=document, local=local, code=code, prose="light-dark(#27272acc, #f5f5f5cc)", fit=false, env=env)

// An answer or plan in the transcript: its settled Mermaid fences draw as
// diagrams, painted for the colour scheme.
component AnswerMarkdown
  inject
    // The open citation comment's answer (its bare message id) and quote, and the quote's start in
    // this answer's text stream when Cite measured it (-1: the quote's first place), from the window.
    citeMessage: string
    citeQuote: string
    citeAt: number
    // The window's Cite (diff-cite.contract CiteAction): the answer whose selection it offers while it
    // shows, the offer and its withdrawal.
    citeOffered: string
    citeOfferSet: action
    citeWithdraw: action
    // A double-click's wait before Cite shows (SELECTION_MULTI_CLICK_INTERVAL_MS), and whether one runs.
    citeHold: action
    citeHolding: bool
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    diagrams: MermaidDiagram[]
    scheme: string
    copiedText: string
    copiedNonce: number
    env: MarkdownEnv
    // diff-review (Cite): the assistant message id ("" for no Cite).
    source: string
    // Signed URLs for the answer's host-path media (timeline-attachments.ts).
    urls: AttachmentUrl[]
  // The selected part of each text of the answer, in the message's text stream (AssistantSelectionToolbar): a prose
  // block's, and each word or code span of a block laid out word by word and a code block's code.
  // `block` is the text's id suffix (`cite-<source>-<block>`): the block, the block and its run, or the block and "code".
  state parts = [CitePart(block="", start=0, end=0, lx=0, ly=0, lw=-1, lh=0)].filter((p) => p.end > 0)
  // observeSelectionActions: a primary button is down in this answer (Cite waits for its release),
  // and the selection changed while it was.
  state held = false
  state moved = false
  // A part's change: the selection made with the pointer is offered at the release (`up`); one made otherwise (a key, a
  // select-all, a clear) at once, Cite at its last line's right and bottom + 4, or withdrawn when nothing is left.
  action selected(blockId: string, runId: string, s: Selection)
    let key = runId == "" ? blockId : `${blockId}-${runId}`
    let offset = citeOffset(document.blocks, code, blockId) + citeRunOffset(document.blocks, code, blockId, runId)
    let rest = parts.filter((p) => p.block != key)
    let box = frame(`cite-${source}-${key}`)
    let next = s.text == "" ? rest : rest.concat([citePart(key, offset + s.start, offset + s.end, s.rects, box)])
    let endBox = frame(`cite-${source}-${citeEndKey(next)}`)
    let bounds = frame("transcript")
    parts = next
    if held
      moved = true
    else if source != "" and next.length == 0
      citeWithdraw(source)
    else if source != "" and next.length > 0
      citeOfferSet(citeOfferFor(source, next, citeStream(document.blocks, code), citeAxis(citeLineRight(next, endBox), bounds.x, bounds.width, bounds.unavailable), citeAxis(citeLineBottom(next, endBox) + 4, bounds.y, bounds.height, bounds.unavailable)))
  // A press in the answer; the window's `main` hears it too, and hides Cite there as for any press but Cite's own (the
  // reference's "interaction" dismissal).
  action down(e: PointerEvent)
    held = e.buttons == 1
    moved = false
  // The release of a press that changed the selection: Cite at the release point; within a double-click's wait (a third
  // click) the wait begins again.
  action up(e: PointerEvent)
    let bounds = frame("transcript")
    held = false
    moved = false
    if held and moved and source != "" and parts.length > 0
      citeOfferSet(citeOfferFor(source, parts, citeStream(document.blocks, code), citeAxis(e.clientX, bounds.x, bounds.width, bounds.unavailable), citeAxis(e.clientY, bounds.y, bounds.height, bounds.unavailable)))
      if citeHolding
        citeHold()
  // A double-click (after its release, which offered Cite): Cite shows once the wait is over.
  action doubled
    if source != ""
      citeHold()
  // AssistantSelectionToolbar.tsx:87-107: a plain Tab while this answer's Cite shows, enabled, and does not hold
  // the focus (it is the window's, outside this box) focuses Cite; Escape hides it and keeps the selection.
  action keys(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.shiftKey and not e.altKey and not e.ctrlKey and not e.metaKey and source != "" and citeOffered == source and citeSize(parts, citeStream(document.blocks, code)) <= 8000
      preventDefault()
      stopPropagation()
      focus("cite-action")
    // Dismiss the offer even while the double-click delay keeps it hidden. Other keys cancel a pending offer, as
    // observeSelectionActions cancels its timer; a subsequent selection change can offer the new keyboard selection.
    else if source != "" and (k == "Escape" or citeHolding)
      citeWithdraw(source)
  // The quote's place in this answer while its comment is open (the reference resolves it with
  // resolveAssistantCitationRange), or -1.
  derive citeMarked = source != "" and citeQuote != "" and citeMessage != "" and (source.indexOf(`${citeMessage}"]`) >= 0 or source == citeMessage)
  derive markStart = citeMarked ? (citeAt >= 0 ? citeAt : citeStream(document.blocks, code).indexOf(citeQuote)) : -1
  view
    column width="100%" pointerdown=down pointerup=up dblclick=doubled keycapture=keys
      DiagramBlocks(document=document, local=local, code=code, diagrams=diagrams, prose="light-dark(#27272acc, #f5f5f5cc)", fit=false, scheme=scheme, copiedText=copiedText, copiedNonce=copiedNonce, env=env, urls=urls, source=source, cite=selected, markStart=markStart, markEnd=(markStart < 0 ? -1 : markStart + citeQuote.length))

// UserMessageBody: the same Markdown in the message's own ink, single
// newlines kept as line breaks and context references drawn as chips.
component UserMarkdown
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    diagrams: MermaidDiagram[]
    ink: string
    scheme: string
    copiedText: string
    copiedNonce: number
    env: MarkdownEnv
    urls: AttachmentUrl[]
  action noCite(blockId: string, runId: string, s: Selection)
    let ignored = blockId
  view
    DiagramBlocks(document=document, local=local, code=code, diagrams=diagrams, prose=ink, fit=true, scheme=scheme, copiedText=copiedText, copiedNonce=copiedNonce, env=env, urls=urls, source="", cite=noCite, markStart=-1, markEnd=-1)

// Markdown blocks at the stock settings (13pt code, wrapped), for a document
// with no MarkdownEnv of its own.
component MarkdownBlocks
  inject
    rem: number
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    prose: string
    fit: bool
  action noCite(blockId: string, runId: string, s: Selection)
    let ignored = blockId
  derive galleryIds = markdownGalleryIds(document.blocks, noChips())
  provide
    galleryIds
  view
    // A sent message's bubble fits its text (fit); an answer fills the lane.
    column width=(fit ? "auto" : "100%") max-width="100%" gap=0
      for block in document.blocks key=block.id
        column width=(fit ? "auto" : "100%") max-width="100%" margin-top=(block.gap * rem / 16)
          if block.kind == "code"
            CodeBlock(block=block, local=local, code=code, copiedText="", copiedNonce=0, codeFont="ui-monospace", codeSize=13, wrapDefault=true, canRun=false, source="", cite=noCite, ms=-1, me=-1)
          else
            BlockBody(block=block, prose=prose, fit=fit, chips=noChips(), wrapDefault=true, urls=noUrls(), local=local, copiedText="", copiedNonce=0, source="", cite=noCite, ms=-1, me=-1)

// The same blocks under Settings → Appearance (MarkdownEnv).
component EnvBlocks
  inject
    rem: number
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    prose: string
    fit: bool
    env: MarkdownEnv
  action noCite(blockId: string, runId: string, s: Selection)
    let ignored = blockId
  derive galleryIds = markdownGalleryIds(document.blocks, env.chips)
  provide
    galleryIds
  view
    column width=(fit ? "auto" : "100%") max-width="100%" gap=0
      for block in document.blocks key=block.id
        column width=(fit ? "auto" : "100%") max-width="100%" margin-top=(block.gap * rem / 16)
          if block.kind == "code"
            CodeBlock(block=block, local=local, code=code, copiedText="", copiedNonce=0, codeFont=env.codeFont, codeSize=env.codeSize, wrapDefault=env.wrap, canRun=(block.closedFence and env.runCommands.includes(`${block.href}:${block.text}`)), source="", cite=noCite, ms=-1, me=-1)
          else
            BlockBody(block=block, prose=prose, fit=fit, chips=env.chips, wrapDefault=env.wrap, urls=noUrls(), local=local, copiedText="", copiedNonce=0, source="", cite=noCite, ms=-1, me=-1)

// The transcript's blocks: a settled ```mermaid fence draws its diagram.
component DiagramBlocks
  inject
    rem: number
  props
    document: ChatDocument
    local: action
    code: CodeHighlight[]
    diagrams: MermaidDiagram[]
    prose: string
    fit: bool
    scheme: string
    copiedText: string
    copiedNonce: number
    env: MarkdownEnv
    urls: AttachmentUrl[]
    source: string
    cite: action
    // The cited text's [start, end) in the answer's text stream (-1: none), each block's share.
    markStart: number
    markEnd: number
  derive galleryIds = markdownGalleryIds(document.blocks, env.chips)
  provide
    galleryIds
  view
    column width=(fit ? "auto" : "100%") max-width="100%" gap=0
      for block in document.blocks key=block.id
        column width=(fit ? "auto" : "100%") max-width="100%" margin-top=(block.gap * rem / 16)
          if block.kind == "code"
            if block.href == "mermaid" and diagrams.filter((entry) => entry.code == block.text).length > 0
              for entry in diagrams.filter((entry) => entry.code == block.text) key=entry.id
                MermaidBlock(block=block, local=local, diagram=entry, scheme=scheme, copied=(copiedText == block.text ? copiedNonce : 0), codeFont=env.codeFont, codeSize=env.codeSize, wrapDefault=env.wrap)
            else
              CodeBlock(block=block, local=local, code=code, copiedText=copiedText, copiedNonce=copiedNonce, codeFont=env.codeFont, codeSize=env.codeSize, wrapDefault=env.wrap, canRun=(block.closedFence and env.runCommands.includes(`${block.href}:${block.text}`)), source=source, cite=cite, ms=(markStart < 0 ? -1 : markStart - citeOffset(document.blocks, code, block.id)), me=(markStart < 0 ? -1 : markEnd - citeOffset(document.blocks, code, block.id)))
          else
            BlockBody(block=block, prose=prose, fit=fit, chips=env.chips, wrapDefault=env.wrap, urls=urls, local=local, copiedText=copiedText, copiedNonce=copiedNonce, source=source, cite=cite, ms=(markStart < 0 ? -1 : markStart - citeOffset(document.blocks, code, block.id)), me=(markStart < 0 ? -1 : markEnd - citeOffset(document.blocks, code, block.id)))

// Every block but a code fence: headings, list items, rules, tables, images, quotes and prose.
component BlockBody
  inject
    rem: number
  props
    block: ChatBlock
    prose: string
    fit: bool
    chips: ChipView[]
    wrapDefault: bool
    urls: AttachmentUrl[]
    local: action
    copiedText: string
    copiedNonce: number
    // diff-review (Cite): a prose block's selection reports to the answer (`source` "" outside answers).
    source: string
    cite: action
    // The cited text in this block's offsets while its comment is open (-1: none).
    ms: number
    me: number
  view
    if block.kind == "heading"
      if block.flow
        box role="heading" aria-level=block.depth width="100%"
          FlowRuns(runs=block.runs, color=prose, fit=fit, chips=chips, urls=urls, local=local, size=(block.depth == 1 ? 20 : block.depth == 2 ? 18 : block.depth == 3 ? 16 : 14), weight=600, source=source, blockId=block.id, cite=cite, ms=ms, me=me)
      else
        text role="heading" aria-level=block.depth id=`cite-${source}-${block.id}` selectionchange=cite(block.id, "") width="100%" font-size=(block.depth == 1 ? "1.25rem" : block.depth == 2 ? "1.125rem" : block.depth == 3 ? "1rem" : "0.875rem") line-height=1.3 color=(block.depth == 6 ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
          ChatRuns(runs=block.runs, size=(block.depth == 1 ? 20 : block.depth == 2 ? 18 : block.depth == 3 ? 16 : 14), weight=600, ms=ms, me=me)
    if block.kind == "item"
      row width="100%" padding-left=(block.depth * 1.25 * rem) box-sizing="border-box"
        if block.task != ""
          TaskCheckbox(block=block, local=local)
        if block.task == "" and block.marker == "•"
          box width="1.25rem" height="1.421875rem" flex-shrink=0 position="relative"
            box position="absolute" left="0.25rem" top="0.59375rem" width="0.3125rem" height="0.3125rem" box-sizing="border-box" border-radius=(block.depth >= 2 ? "0px" : "0.15625rem") border-width=(block.depth == 1 ? 1 : 0) border-style="solid" border-color="light-dark(#27272acc, #f5f5f5cc)" background-color=(block.depth == 1 ? "#00000000" : "light-dark(#27272acc, #f5f5f5cc)")
        if block.task == "" and block.marker != "•"
          text block.marker width="1.25rem" flex-shrink=0 padding-right="0.25rem" box-sizing="border-box" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.421875rem" color="light-dark(#27272acc, #f5f5f5cc)"
        if block.flow
          FlowRuns(runs=block.runs, color=prose, fit=fit, chips=chips, urls=urls, local=local, size=14, weight=400, source=source, blockId=block.id, cite=cite, ms=ms, me=me)
        else
          text flex=1 min-width=0 id=`cite-${source}-${block.id}` selectionchange=cite(block.id, "") font-size="0.875rem" line-height="1.421875rem" color=prose
            ChatRuns(runs=block.runs, size=14, weight=400, ms=ms, me=me)
    if block.kind == "rule"
      box width="100%" height=1 margin-top="0.5rem" margin-bottom="0.5rem" background-color="light-dark(#e4e4e7, #ffffff0f)"
    if block.kind == "table-row"
      row width="100%" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)"
        for cell in block.cells key=cell.id
          text flex=1 min-width=0 padding-left="0.75rem" padding-right="0.75rem" padding-top=(block.header ? "0.55rem" : "0.45rem") padding-bottom=(block.header ? "0.55rem" : "0.45rem") font-size="0.75rem" line-height=1.625 color=prose
            ChatRuns(runs=cell.runs, size=12, weight=(block.header ? 600 : 400), ms=-1, me=-1)
    if block.kind == "table"
      MarkdownTable(block=block, prose=prose, fit=fit, wrapDefault=wrapDefault, chips=chips, urls=urls, local=local, copied=(copiedText == block.markdown or copiedText == block.csv ? copiedNonce : 0))
    if block.kind == "image"
      // An image line draws through its media chip (media-views.ts markdownMediaChips).
      if chips.filter((c) => c.kind == "media" and c.href == block.href).length > 0
        for chip in chips.filter((c) => c.kind == "media" and c.href == block.href) key=chip.id
          MarkdownMedia(alt=block.text, kind=chip.size, access=chip.icon, target=chip.target, tip=chip.tip, source=chip.detail, urls=urls, local=local, standalone=true, link="", linkLabel="", favicon=false, owner=chip.owner, nodeId=`media-${chip.owner}-${block.id}`)
      else
        image block.href aria-label=block.text max-width="100%" object-fit="contain"
    if block.kind == "quote"
      if block.flow
        box width="100%" padding-left="0.8rem" box-sizing="border-box" border-left-width=2 border-left-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)"
          FlowRuns(runs=block.runs, color="light-dark(#71717b, #818181)", fit=fit, chips=chips, urls=urls, local=local, size=14, weight=400, source=source, blockId=block.id, cite=cite, ms=ms, me=me)
      else
        text width="100%" id=`cite-${source}-${block.id}` selectionchange=cite(block.id, "") font-size="0.875rem" padding-left="0.8rem" box-sizing="border-box" border-left-width=2 border-left-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" line-height="1.421875rem" color="light-dark(#71717b, #818181)"
          ChatRuns(runs=block.runs, size=14, weight=400, ms=ms, me=me)
    if not ["heading", "item", "rule", "table-row", "table", "image", "quote"].includes(block.kind) and block.flow
      FlowRuns(runs=block.runs, color=prose, fit=fit, chips=chips, urls=urls, local=local, size=14, weight=400, source=source, blockId=block.id, cite=cite, ms=ms, me=me)
    if not ["heading", "item", "rule", "table-row", "table", "image", "quote"].includes(block.kind) and not block.flow
      text width=(fit ? "auto" : "100%") max-width="100%" id=`cite-${source}-${block.id}` selectionchange=cite(block.id, "") font-size="0.875rem" line-height="1.421875rem" color=prose
        ChatRuns(runs=block.runs, size=14, weight=400, ms=ms, me=me)

// GFM's task checkbox in place of the list marker (`li.task-list-item`:
// list-style none, the checkbox in the 1.25rem gutter with 0.35em after it), as Electron draws an `input` checkbox on
// macOS (13pt, 12pt tall with a 1pt shade, white or the accent blue with a white tick). In a file preview
// (taskOffset >= 0) a press toggles the task and saves the file (RenderedMarkdownSurface onTaskListChange,
// files-surface.ts toggleTask); elsewhere it is GFM's disabled checkbox (MarkdownInput without onTaskListChange).
component TaskCheckbox
  props
    block: ChatBlock
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box width="1.11875rem" height="1.421875rem" flex-shrink=0 padding-top="0.33125rem" box-sizing="border-box"
      if block.taskOffset >= 0
        button press=local("surface-files-task", block.id, `${block.taskOffset}\t${block.task == "done" ? "false" : "true"}`) hover=hover role="checkbox" aria-checked=(block.task == "done") aria-label="Toggle task" testId=`task-${block.id}` width=13 height=13 padding=0 border-width=0 background-color="#00000000" cursor="default" title=""
          TaskBox(done=(block.task == "done"), disabled=false, hovered=hovered)
      else
        box role="checkbox" aria-checked=(block.task == "done") aria-label="Task" testId=`task-${block.id}` width=13 height=13
          TaskBox(done=(block.task == "done"), disabled=true, hovered=false)

component TaskBox
  props
    done: bool
    disabled: bool
    hovered: bool
  view
    box width=13 height=13 position="relative" opacity=(disabled ? 0.5 : 1)
      box position="absolute" left=0 top=0 width=13 height=12 box-sizing="border-box" border-radius=3 border-width=(done ? 0 : 1) border-style="solid" border-color=(hovered ? "light-dark(#5c5c5c, #a3a3a3)" : "light-dark(#767676, #8a8a8a)") background-color=(done ? (hovered ? "light-dark(#255fd6, #3b82f6)" : "light-dark(#3273f6, #3b82f6)") : "light-dark(#ffffff, #ffffff1f)") box-shadow="0 1px 0 light-dark(#00000026, #00000066)"
        if done
          box position="absolute" left=2 top=1.5 width=9 height=9
            TimelineIcon(name="check-mark", size=9, color="#ffffff")

// Inline runs in one text node (a chip's href is how its ChipView finds it, not a destination). Every link with a
// destination is the anchor's: its press is the link's (`linkOpen`: a web link follows "Open links in", a mailto, irc or
// xmpp link opens nothing, a fragment leaves for the new-thread draft) and its
// right-click the anchor's onContextMenu (external-link-menu.ts); an emptied anchor is link-coloured text with neither.
component ChatRuns
  inject
    linkOpen: action
    linkMenu: action
  props
    runs: ChatRun[]
    size: number
    weight: number
    // The cited text in these runs' offsets (-1: none).
    ms: number
    me: number
  view
    for run in runs key=run.id
      if run.mono and (run.kind == "link" or run.kind == "link-start") and webLink(run.href)
        text run.text href=run.href press=linkOpen("link", run.href) contextmenu=linkMenu(run.href) font-family="ui-monospace" font-size="0.75rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)"
      if run.mono and not ((run.kind == "link" or run.kind == "link-start") and webLink(run.href))
        text run.text href=(run.kind == "link" or run.kind == "link-start" ? run.href : "") font-family="ui-monospace" font-size="0.75rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)"
      if not run.mono
        if (run.kind == "link" or run.kind == "link-start") and run.href != ""
          text run.text href=run.href press=linkOpen("link", run.href) contextmenu=linkMenu(run.href) font-size=size font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant color="light-dark(#1447e6, #50a2ff)"
        if (run.kind == "link" or run.kind == "link-start") and run.href == ""
          text run.text font-size=size font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant color="light-dark(#1447e6, #50a2ff)"
        if run.kind != "link" and run.kind != "link-start"
          if ms < 0
            text run.text font-size=size font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant
          else
            text font-size=size font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant
              MarkedText(value=run.text, at=runAt(runs, run.id), ms=ms, me=me)

// The cited text's highlight while its comment is open (AssistantCitationSource.tsx
// observeAssistantCitationCommentSource: `::highlight(t3-assistant-citation-comment)`, the primary at 45%), within one
// piece of text that starts at `at` in its block: the piece before, the marked part, the piece after.
component MarkedText
  props
    value: string
    at: number
    ms: number
    me: number
  derive a = max(0, min(value.length, ms - at))
  derive b = max(a, min(value.length, me - at))
  view
    text
      text value.slice(0, a)
      text value.slice(a, b) background-color="light-dark(#1b4ed873, #346bf173)"
      text value.slice(b, value.length)

// An http(s) link follows "Open links in" (its press); any other scheme stays the shell's.
fn webLink(href: string): bool = href.startsWith("http://") or href.startsWith("https://")
// A link whose click does something on every word: a web link opens, a fragment leaves for the new-thread draft;
// a mailto, irc or xmpp link's click opens nothing, word or not.
fn pressLink(href: string): bool = webLink(href) or href.startsWith("#")
// A run of a link that is not a pull request link (a pull request link's words are each a link of their own, PrLinkRun).
fn linkRun(run: ChatRun, chips: ChipView[]): bool = (run.kind == "link" or run.kind == "link-start") and chips.filter((chip) => chip.kind == "pr-link" and chip.href == run.href).length == 0

// Prose with inline code, word by word on 22.75pt lines so every code span is a
// bordered box whose text shares the line's baseline (`.chat-markdown code`).
component FlowRuns
  inject
    linkOpen: action
    linkMenu: action
  props
    runs: ChatRun[]
    size: number
    weight: number
    color: string
    fit: bool
    chips: ChipView[]
    urls: AttachmentUrl[]
    local: action
    // Each word and code span reports its part of a selection to the answer (Cite), as the
    // reference's text nodes of one block are one stream (`source` "" outside answers).
    source: string
    blockId: string
    cite: action
    // The cited text in this block's offsets while its comment is open (-1: none).
    ms: number
    me: number
  view
    row flex-grow=(fit ? 0 : 1) min-width=0 width=(fit ? "auto" : "100%") max-width="100%" flex-wrap="wrap" align-items="flex-start"
      for run in runs key=run.id
        // A link's first run (ChatMarkdown's `<a>`): one link node per link, named with the whole link (`run.label`), on its
        // first word or code span; the link's other words and code spans follow as nodes hidden from assistive tech (their
        // `label` is the same), so a reader meets one link with its URL, not words. A press anywhere
        // opens it. Only a web link leads with its favicon and has the app's menu (ChatMarkdown's faviconHost); a mailto,
        // irc or xmpp link's press opens nothing, as the desktop shell's window-open handler opens none of them, and a
        // fragment's leaves for the new-thread draft (Electron's hash router;
        // browser-links.ts openLinkFromUi); their menu is the shell's, at the click or, for the ContextMenu
        // key, at the focused link (external-link-menu.ts). A code span is part of its link (`.chat-markdown
        // code` inside the `<a>`, after the favicon).
        if run.kind == "link-start" and linkRun(run, chips)
          link href=run.href press=linkOpen("link", run.href) contextmenu=linkMenu(run.href) aria-label=run.label cursor="pointer" text-decoration-line="none" display="flex" flex-direction="row" flex-shrink=0 align-items="flex-start"
            if webLink(run.href)
              box width="0.875rem" height="1.421875rem" margin-left="0.21875rem" margin-right="0.175rem" padding-top="0.28125rem" box-sizing="border-box" flex-shrink=0
                TimelineIcon(name="globe", size=14, color="light-dark(#1447e6, #50a2ff)")
            if not run.mono
              text run.text white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant text-decoration-line="none" color="light-dark(#1447e6, #50a2ff)"
            else
              text run.text margin-top="0.153125rem" font-family="ui-monospace" font-size="0.75rem" line-height="0.875rem" white-space="pre" font-weight=run.weight font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)"
        // A web or fragment link's later word or code span: its press and menu are the link's. Only a web link's is a Tab
        // stop (as it was); a fragment's is not, the `<a>` being one stop (its link node above).
        if run.kind == "link" and linkRun(run, chips) and pressLink(run.href)
          box press=linkOpen("link", run.href) contextmenu=linkMenu(run.href) tabindex=(webLink(run.href) ? 0 : -1) aria-hidden=(run.label != "") cursor="pointer" height="1.421875rem" padding-top=(run.mono ? "0.153125rem" : "0px") box-sizing="border-box" flex-shrink=0
            if not run.mono
              text run.text white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant text-decoration-line="none" color="light-dark(#1447e6, #50a2ff)"
            else
              text run.text font-family="ui-monospace" font-size="0.75rem" line-height="0.875rem" white-space="pre" font-weight=run.weight font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)"
        // Any other code span (one in a pull request link too); a mailto, irc or xmpp link's later one is hidden as its
        // words are, and shows the link's pointer (the `<a>`'s `cursor: pointer` covers all of it).
        if run.mono and not (linkRun(run, chips) and (run.kind == "link-start" or pressLink(run.href)))
          box aria-hidden=(run.kind == "link" and run.label != "" and not webLink(run.href)) cursor=(run.kind == "link" and run.label != "" and not webLink(run.href) ? "pointer" : "auto") height="1.421875rem" padding-top="0.153125rem" box-sizing="border-box" flex-shrink=0
            text run.text id=`cite-${source}-${blockId}-${run.id}` selectionchange=cite(blockId, run.id) font-family="ui-monospace" font-size="0.75rem" line-height="0.875rem" white-space="pre" font-weight=run.weight font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color=(ms >= 0 and citeMarks(ms, me, runAt(runs, run.id), run.text.length) ? "light-dark(#1b4ed873, #346bf173)" : "light-dark(#fafafa, #ffffff08)") color="light-dark(#27272a, #f5f5f5)"
        if not run.mono and (run.kind == "file" or chipAccent(run.kind) != "")
          if chips.filter((chip) => chip.href == run.href and run.href != "").length > 0
            for chip in chips.filter((chip) => chip.href == run.href) key=chip.id
              ResolvedChip(run=run, chip=chip, urls=urls, local=local)
          if not (chips.filter((chip) => chip.href == run.href and run.href != "").length > 0) and run.kind == "file"
            FileChip(run=run)
          if not (chips.filter((chip) => chip.href == run.href and run.href != "").length > 0) and run.kind != "file"
            ContextChipBox(run=run)
        if not run.mono and not (run.kind == "file" or chipAccent(run.kind) != "") and run.kind == "break"
          box width="100%" height=0 flex-shrink=0
        // An image inside a line of text (ChatMarkdownImage, not
        // standalone), or the only content of its paragraph, list item or quote (standalone: its `icon`), through its
        // media chip (media-views.ts markdownInlineImages); a surface with no media chips (a pull request's text) keeps
        // its alt text. One inside a link's text (`run.link`) sits in the link, whose press and menu are the link's; the
        // link's favicon leads it when the image starts the link.
        if run.kind == "media" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href).length > 0
          for chip in chips.filter((chip) => chip.kind == "media" and chip.href == run.href) key=chip.id
            MarkdownMedia(alt=run.text, kind=chip.size, access=chip.icon, target=chip.target, tip=chip.tip, source=chip.detail, urls=urls, local=local, standalone=(run.icon == "standalone"), link=run.link, linkLabel=(run.label != "" ? run.label : run.text), favicon=(webLink(run.link) and linkLeads(runs, run.id, run.link)), owner=chip.owner, nodeId=`media-${chip.owner}-${blockId}-${run.id}`)
        // With no media chip (a pull request's text) an image inside a link's text is the link's word, its alt text.
        if run.kind == "media" and run.link != "" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href).length == 0
          link href=run.link press=linkOpen("link", run.link) contextmenu=linkMenu(run.link) aria-label=(run.label != "" ? run.label : run.text) cursor="pointer" text-decoration-line="none" flex-shrink=0
            text run.text white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant text-decoration-line="none" color="light-dark(#1447e6, #50a2ff)"
        // A pull request link in a pull request's text (its chip names the card's target).
        if not run.mono and not (run.kind == "file" or chipAccent(run.kind) != "") and run.kind != "break" and ((run.kind == "link" or run.kind == "link-start") and chips.filter((chip) => chip.kind == "pr-link" and chip.href == run.href).length > 0)
          for chip in chips.filter((chip) => chip.kind == "pr-link" and chip.href == run.href) key=chip.id
            PrLinkRun(run=run, chip=chip, local=local, size=size, weight=(run.weight > weight ? run.weight : weight))
        // Prose, an emptied anchor's text, and a mailto, irc or xmpp link's later words: no href of their own, so a click
        // follows nothing (the link node above is the link); a link's words keep its pointer (an emptied anchor has no
        // `label`, and an `<a>` with no href shows none).
        if not run.mono and not (run.kind == "file" or chipAccent(run.kind) != "") and run.kind != "break" and not ((run.kind == "link" or run.kind == "link-start") and chips.filter((chip) => chip.kind == "pr-link" and chip.href == run.href).length > 0) and run.kind != "link-start" and not (run.kind == "link" and pressLink(run.href)) and not (run.kind == "media" and (run.link != "" or chips.filter((chip) => chip.kind == "media" and chip.href == run.href).length > 0))
          if ms < 0
            text run.text id=`cite-${source}-${blockId}-${run.id}` selectionchange=cite(blockId, run.id) aria-hidden=(run.kind == "link" and run.label != "") cursor=(run.kind == "link" and run.label != "" ? "pointer" : "auto") white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant text-decoration-line="none" color=(run.kind == "link" ? "light-dark(#1447e6, #50a2ff)" : color)
          else
            text id=`cite-${source}-${blockId}-${run.id}` selectionchange=cite(blockId, run.id) aria-hidden=(run.kind == "link" and run.label != "") cursor=(run.kind == "link" and run.label != "" ? "pointer" : "auto") white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant text-decoration-line="none" color=(run.kind == "link" ? "light-dark(#1447e6, #50a2ff)" : color)
              MarkedText(value=run.text, at=runAt(runs, run.id), ms=ms, me=me)

// Whether a run starts its link: the run before it is not the same link's word or image.
fn linkLeads(runs: ChatRun[], id: string, link: string): bool = runs.slice(max(0, runs.map((r) => r.id).indexOf(id) - 1), max(0, runs.map((r) => r.id).indexOf(id))).filter((r) => r.href == link or r.link == link).length == 0

// A pull request link in a pull request's text (ChatMarkdown's anchor with
// PullRequestLinkPreview, pullRequestMarkdown.logic.ts autolinks): its press asks the panel to open it
// (pages-pr-links.ts openLink: the panel for a pull request, the browser for anything else or with a modifier
// held). A web link keeps its favicon (the globe); a `#N` autolink has none, and a commit's is monospace.
component PrLinkRun
  inject
    rem: number
    hoverTipAt: action
    linkMenu: action
  props
    run: ChatRun
    chip: ChipView
    local: action
    size: number
    weight: number
  // The pointer on the link: the panel reads the card's pull request (`chatlocal:pr-preview`). The card itself is drawn by
  // the window's hover layer (hover-layer.contract, kind "pr-preview": 350 ms open, 120 ms close); a commit's link shows its URL as a tip.
  action hover(value: bool)
    hoverTipAt(hoverTipAtFrame(`pr-preview-${chip.id}`, chip.target != "" ? "pr-preview" : "tip", run.href, [], "top", "center", frame(`pr-link-${chip.id}`), 6.5 * rem, chip.target != "" ? "pull-request-link-preview" : "pull-request-link-url"), "trigger", value)
    if chip.target != ""
      local("pr-preview", chip.target, value ? "1" : "0")
  // A modifier held on the click leaves the link to the browser (pages-pr-links.ts openLink): the press's own, as a fourth line.
  action open(e: MouseEvent)
    local("pr-link-open", "", `${chip.detail}\n${chip.target}\n${run.href}\n${heldModifiers(e.metaKey, e.ctrlKey, e.altKey, e.shiftKey)}`)
  view
    button id=`pr-link-${chip.id}` press=open contextmenu=linkMenu(run.href) hover=hover role="link" aria-label=run.text testId=`pr-link-${chip.id}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="flex-start" flex-shrink=0 cursor="pointer"
      if run.kind == "link-start" and chip.detail == ""
        box width="0.875rem" height="1.421875rem" margin-left="0.21875rem" margin-right="0.175rem" padding-top="0.28125rem" box-sizing="border-box" flex-shrink=0
          TimelineIcon(name="globe", size=14, color="light-dark(#1447e6, #50a2ff)")
      if chip.detail == "commit"
        text run.text white-space="pre" flex-shrink=0 font-family="ui-monospace" font-size=size line-height="1.421875rem" font-weight=weight font-style=run.slant text-decoration-line="none" color="light-dark(#1447e6, #50a2ff)"
      else
        text run.text white-space="pre" flex-shrink=0 font-size=size line-height="1.421875rem" font-weight=weight font-style=run.slant text-decoration-line="none" color="light-dark(#1447e6, #50a2ff)"

// ContextChip's per-kind accent (oklch(0.62 C H)): a fill of the accent at
// 11%, a border mixing it 34% into the border colour and text mixing it 22%
// into the foreground; "" for runs that are not context chips.
fn chipAccent(kind: string): string = ["context-file", "context-video", "context-thread", "context-review-comment"].includes(kind) ? (kind == "context-file" ? "#0090cd" : kind == "context-video" ? "#d06217" : kind == "context-thread" ? "#009c96" : "#8a70dd") : ["context-terminal", "context-element", "context-image", "context-skill"].includes(kind) ? (kind == "context-terminal" ? "#009f6e" : kind == "context-element" ? "#b87501" : kind == "context-image" ? "#d55665" : "#b261be") : ["context-citation", "context-other"].includes(kind) ? (kind == "context-citation" ? "#4684e5" : "#71717b") : ""
fn chipBorder(kind: string): string = ["context-file", "context-video", "context-thread"].includes(kind) ? (kind == "context-file" ? "light-dark(#a8c8e0, #0090cd61)" : kind == "context-video" ? "light-dark(#e2b9a7, #d0621761)" : "light-dark(#a6cccb, #009c9661)") : ["context-review-comment", "context-terminal", "context-element"].includes(kind) ? (kind == "context-review-comment" ? "light-dark(#c3bde6, #8a70dd61)" : kind == "context-terminal" ? "light-dark(#a9cdbd, #009f6e61)" : "light-dark(#d7bfa6, #b8750161)") : ["context-image", "context-skill", "context-citation"].includes(kind) ? (kind == "context-image" ? "light-dark(#e4b6b9, #d5566561)" : kind == "context-skill" ? "light-dark(#d4b8da, #b261be61)" : "light-dark(#aec5e9, #4684e561)") : "light-dark(#e4e4e7b3, #ffffff14)"
fn chipInk(kind: string): string = ["context-file", "context-video", "context-thread"].includes(kind) ? (kind == "context-file" ? "light-dark(#2b3d4a, #cadfed)" : kind == "context-video" ? "light-dark(#4a352d, #f0d5c8)" : "light-dark(#2a3f40, #c9e2df)") : ["context-review-comment", "context-terminal", "context-element"].includes(kind) ? (kind == "context-review-comment" ? "light-dark(#3b374e, #dcd8f2)" : kind == "context-terminal" ? "light-dark(#2c3f38, #cbe2d6)" : "light-dark(#44382c, #e9d9c7)") : ["context-image", "context-skill", "context-citation"].includes(kind) ? (kind == "context-image" ? "light-dark(#4b3337, #f2d3d4)" : kind == "context-skill" ? "light-dark(#433448, #e7d5ea)" : "light-dark(#2f3b4f, #ceddf4)") : "light-dark(#27272a, #f5f5f5)"
fn chipIcon(kind: string): string = ["context-thread", "context-review-comment", "context-terminal"].includes(kind) ? (kind == "context-thread" ? "messages-square" : kind == "context-review-comment" ? "message-circle" : "square-terminal") : ["context-element", "context-image", "context-video"].includes(kind) ? (kind == "context-element" ? "mouse-pointer-click" : kind == "context-image" ? "image" : "film") : ["context-skill", "context-citation"].includes(kind) ? (kind == "context-skill" ? "skill" : "quote") : "circle-dashed"
// A resolved chip's accent family (ContextChip `kind`).
fn chipFamily(kind: string): string = ["citation", "file", "video"].includes(kind) ? (kind == "citation" ? "context-citation" : kind == "file" ? "context-file" : "context-video") : ["image", "skill", "thread"].includes(kind) ? (kind == "image" ? "context-image" : kind == "skill" ? "context-skill" : "context-thread") : ["terminal", "element", "review"].includes(kind) ? (kind == "terminal" ? "context-terminal" : kind == "element" ? "context-element" : "context-review-comment") : "context-other"

// A composer context reference in a sent message (ContextChip) the message
// carries no record view for: its kind's glyph (a file's Pierre icon) and label.
component ContextChipBox
  props
    run: ChatRun
  view
    row height="1.421875rem" flex-shrink=0 align-items="center" padding-left=1 padding-right=1
      row height="1.0625rem" max-width="15rem" padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=chipBorder(run.kind) background-color=`${chipAccent(run.kind)}1c` testId=`context-chip-${run.id}`
        if run.kind == "context-file"
          FileTypeIcon(token=run.icon, size=14)
        else
          TimelineIcon(name=chipIcon(run.kind), size=14, color=chipInk(run.kind))
        text run.text min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=chipInk(run.kind)

// MarkdownFileLink: a workspace file as a mention chip (12pt medium, 17pt
// tall, 6pt radius, teal-tinted border and fill) with its Pierre icon.
component FileChip
  props
    run: ChatRun
  view
    row height="1.421875rem" flex-shrink=0 align-items="center" padding-left=1 padding-right=1
      FileChipFace(run=run, label=run.text, icon=run.icon)

component FileChipFace
  props
    run: ChatRun
    label: string
    icon: string
  view
    row height="1.0625rem" padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#a9cad4, #39a1b861)" background-color="#0096af1c" testId=`file-chip-${run.id}`
      if icon == "folder"
        TimelineIcon(name="folder", size=14, color="light-dark(#71717a, #818181)")
      else
        FileTypeIcon(token=icon, size=14)
      text label font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color="light-dark(#2c3e45, #cbe0e6)"

// One chip with its record view (message-chips.ts): a file link's full
// path in a code tooltip; a mention's path; an attachment's name and size
// (an image previews on click, its thumbnail leading); a skill's `$name`; a
// thread that opens; a reference whose record is gone drawn dashed with
// "This context is no longer available."; terminal, element and review
// references open their details above the chip.
component ResolvedChip
  props
    run: ChatRun
    chip: ChipView
    urls: AttachmentUrl[]
    local: action
  state open = false
  action toggle
    open = not open
  view
    row height="1.421875rem" flex-shrink=0 align-items="center" padding-left=1 padding-right=1 position="relative"
      if chip.kind == "link"
        CodeTip(label=chip.tip, side="top", offset=21)
          // A file link opens in the Files surface (rightPanelStore.openFile).
          button press=local("surface-file", chip.tip, "") contextmenu=local("surface-files-link-menu", chip.tip, "") aria-label=chip.tip padding=0 border-width=0 background-color="#00000000" testId=`chip-open-${run.id}`
            FileChipFace(run=run, label=run.text, icon=chip.icon)
      if chip.kind == "mention"
        Tip(label=chip.tip, side="top", align="center", offset=21)
          button press=local("surface-file", chip.tip, "") aria-label=chip.tip padding=0 border-width=0 background-color="#00000000" testId=`chip-open-${run.id}`
            FileChipFace(run=run, label=chip.label, icon=chip.icon)
      if chip.kind == "unresolved"
        Tip(label=chip.tip, side="top", align="center", offset=21)
          // ContextChip.tsx's `border border-dashed` (state unresolved): a 1 px dashed border in the border-box, as the other chips' solid one.
          row height="1.0625rem" max-width="15rem" padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" align-items="center" border-radius="0.375rem" border-width=1 border-style="dashed" border-color="light-dark(#e4e4e7, #ffffff12)" background-color="light-dark(#f4f4f566, #ffffff04)" aria-label=`Unavailable context, ${chip.label}` testId=`context-chip-${run.id}`
            TimelineIcon(name="circle-dashed", size=14, color="light-dark(#27272a, #f5f5f5)")
            text chip.label min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color="light-dark(#27272a, #f5f5f5)"
      if chip.kind == "terminal"
        TerminalContextChip(run=run, chip=chip)
      if chip.kind == "pr"
        PrContextChip(run=run, chip=chip, local=local)
      if chip.kind == "element" or chip.kind == "review"
        button press=toggle aria-label=`${chip.label}. Show details` aria-expanded=open testId=`context-chip-${run.id}` height="1.0625rem" max-width="15rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=chipBorder(chipFamily(chip.kind)) background-color=`${chipAccent(chipFamily(chip.kind))}1c` id=`context-chip-${run.id}`
          TimelineIcon(name=chipIcon(chipFamily(chip.kind)), size=14, color=chipInk(chipFamily(chip.kind)))
          text chip.label min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=chipInk(chipFamily(chip.kind))
        if open
          ChipDetails(chip=chip, close=toggle)
      if not ["link", "mention", "unresolved", "terminal", "element", "review", "pr"].includes(chip.kind)
        Tip(label=(chip.kind == "image" ? "" : chip.tip), side="top", align="center", offset=21)
          AttachmentChip(run=run, chip=chip, urls=urls, local=local)
// PullRequestChip (contextChipParts.tsx): "#N" with its state's glyph and ContextChip kind (pr-open, pr-draft, pr-merged,
// pr-closed; pull-request when the state is unknown), a button that opens the pull request (useOpenPrLink, pr-chip-open.ts).
// The reference's hover card (PullRequestLinkPreview, or PullRequestContextDetails in a tooltip) is not drawn here.
fn prChipColour(state: string, part: number): string = part == 0 ? prChipInk(state) : part == 3 ? prChipBorder(state) : `${prChipAccent(state)}${part == 2 ? "2b" : "1c"}`
fn prChipInk(state: string): string = state == "open" ? "light-dark(#2c3f39, #cbe2d6)" : state == "draft" ? "light-dark(#393a3f, #dadcdf)" : state == "merged" ? "light-dark(#3a374e, #dcd8f2)" : state == "closed" ? "light-dark(#4b3337, #f2d3d4)" : "light-dark(#35394f, #d5daf4)"
fn prChipAccent(state: string): string = state == "open" ? "#009f6e" : state == "draft" ? "#7f8793" : state == "merged" ? "#8a70dd" : state == "closed" ? "#d55665" : "#7079e4"
fn prChipBorder(state: string): string = state == "open" ? "light-dark(#a9cdbd, #3ba97d61)" : state == "draft" ? "light-dark(#c1c3ca, #8c939d61)" : state == "merged" ? "light-dark(#c3bde6, #9580e261)" : state == "closed" ? "light-dark(#e4b6b9, #db697461)" : "light-dark(#bac1e9, #7d88e861)"
component PrContextChip
  props
    run: ChatRun
    chip: ChipView
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=local("chip-pr", chip.target, "") hover=hover aria-label=chip.tip testId=`context-chip-${run.id}` height="1.0625rem" max-width="15rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=prChipColour(chip.detail, 3) background-color=prChipColour(chip.detail, hovered ? 2 : 1) id=`context-chip-${run.id}` title=""
      EditorMenuIcon(name=(chip.detail == "draft" ? "git-pull-request-draft" : chip.detail == "merged" ? "git-merge" : chip.detail == "closed" ? "git-pull-request-closed" : "git-pull-request"), color=prChipColour(chip.detail, 0), size=14)
      text chip.label min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=prChipColour(chip.detail, 0)
// The original button-triggered ContextChipPopover. Auto popovers use the host's
// top layer: scrolling ancestors cannot clip them; Escape and outside clicks
// dismiss them, and keyboard activation returns focus to the invoking chip.
component TerminalContextChip
  props
    run: ChatRun
    chip: ChipView
  derive popupId = `terminal-context-${chip.owner}-${chip.id}-${run.id}`
  view
    button popovertarget=popupId aria-label=`Terminal excerpt, ${chip.label}. Show details` testId=`context-chip-${run.id}` height="1.0625rem" max-width="15rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=chipBorder("context-terminal") background-color="#009f6e1c" id=`context-chip-${run.id}`
      TimelineIcon(name="square-terminal", size=14, color=chipInk("context-terminal"))
      text chip.label min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=chipInk("context-terminal")
    // PopoverPopup side="top" (contextChipParts.tsx): centred 4 pt above the chip, below it when the top does not fit.
    column id=popupId popover="auto" position-try-fallbacks="flip-block" position="absolute" position-area="top" margin-bottom="0.25rem" width="24rem" max-width="100vw" testId="terminal-context-popover"
      column padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=`Terminal excerpt, ${chip.label}`
        column width="100%" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" overflow="hidden"
          row width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.5rem" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)"
            TimelineIcon(name="square-terminal", size=16, color="#009f6e")
            text chip.tip flex=1 min-width=0 font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
            text chip.size font-size="0.75rem" line-height="1rem" white-space="nowrap" color="light-dark(#71717b, #818181)"
          scroll width="100%" max-height="20rem" background-color="light-dark(#f4f4f5, #ffffff0a)"
            text chip.detail aria-label="Captured terminal output" tabindex=0 padding="0.75rem" box-sizing="border-box" font-family="ui-monospace" font-size="0.75rem" line-height="1.125rem" white-space="pre" color="light-dark(#27272a, #f5f5f5)"

// FileChip / ImageChipButton / ThreadContextChip / a skill chip: glyph or
// thumbnail, the (middle-truncated) name and, for attachments, the size.
component AttachmentChip
  props
    run: ChatRun
    chip: ChipView
    urls: AttachmentUrl[]
    local: action
  view
    if chip.kind == "image" and urls.filter((entry) => entry.id == chip.target and entry.fill != "").length > 0
      for entry in urls.filter((entry) => entry.id == chip.target and entry.fill != "") key=entry.id
        TintedImageChip(run=run, chip=chip, entry=entry, local=local)
    else
      AttachmentChipBody(run=run, chip=chip, urls=urls, local=local)

component AttachmentChipBody
  props
    run: ChatRun
    chip: ChipView
    urls: AttachmentUrl[]
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    // A sent file attachment opens its preview beside the thread (ChatView openFileAttachment).
    // A sent video's chip opens it in the media dialog (onExpandVideo).
    if chip.kind == "image" or (chip.kind == "thread" or chip.kind == "citation" or chip.kind == "file" or chip.kind == "video") and chip.target != ""
      button press=local((chip.kind == "image" or chip.kind == "video" ? "image-open" : chip.kind == "file" ? "surface-linked-attachment" : chip.kind == "citation" ? "chip-citation" : "chip-thread"), chip.target, (chip.kind == "image" or chip.kind == "file" or chip.kind == "video" ? chip.owner : chip.detail)) hover=hover aria-label=(chip.kind == "image" ? chip.tip : chip.kind == "file" or chip.kind == "video" ? `${chip.kind == "video" ? "Video" : "File"} attachment, ${chip.label}, ${chip.size}` : chip.kind == "citation" ? `View cited assistant text: ${chip.label}` : `Thread, ${chip.label}`) testId=`context-chip-${run.id}` height="1.0625rem" max-width="22.5rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=chipBorder(chipFamily(chip.kind)) background-color=`${chipAccent(chipFamily(chip.kind))}${hovered ? "2b" : "1c"}` id=`context-chip-${run.id}`
        ChipFace(chip=chip, urls=urls)
    else
      row aria-label=(chip.kind == "skill" ? `Skill, ${chip.label}` : chip.kind == "thread" ? `Thread, ${chip.label}` : `${chip.kind == "video" ? "Video" : "File"} attachment, ${chip.label}, ${chip.size}`) testId=`context-chip-${run.id}` height="1.0625rem" max-width="22.5rem" padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=chipBorder(chipFamily(chip.kind)) background-color=`${chipAccent(chipFamily(chip.kind))}1c`
        ChipFace(chip=chip, urls=urls)

component ChipFace
  props
    chip: ChipView
    urls: AttachmentUrl[]
  view
    if chip.kind == "file"
      FileTypeIcon(token=chip.icon, size=14)
    if chip.kind != "file" and (chip.kind == "image" and urls.filter((entry) => entry.id == chip.target).length > 0)
      for entry in urls.filter((entry) => entry.id == chip.target) key=entry.id
        image entry.url aria-hidden=true width="0.875rem" height="0.875rem" flex-shrink=0 border-radius="0.25rem" object-fit="cover"
    if chip.kind != "file" and not (chip.kind == "image" and urls.filter((entry) => entry.id == chip.target).length > 0)
      TimelineIcon(name=chipIcon(chipFamily(chip.kind)), size=14, color=chipInk(chipFamily(chip.kind)))
    text chip.label min-width=0 max-width=(chip.kind == "citation" ? "12rem" : "18rem") line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=chipInk(chipFamily(chip.kind))
    if chip.size != ""
      text chip.size flex-shrink=0 font-size="0.625rem" font-weight=500 line-height="0.875rem" white-space="pre" color=chipInk(chipFamily(chip.kind))

// ImageChipButton with its accent from the picture's average colour (averageImageColor).
component TintedImageChip
  props
    run: ChatRun
    chip: ChipView
    entry: AttachmentUrl
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=local("image-open", chip.target, chip.owner) hover=hover aria-label=chip.tip testId=`context-chip-${run.id}` height="1.0625rem" max-width="22.5rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.375rem" border-width=1 border-style="solid" border-color=entry.border background-color=(hovered ? entry.hover : entry.fill) id=`context-chip-${run.id}`
      image entry.url aria-hidden=true width="0.875rem" height="0.875rem" flex-shrink=0 border-radius="0.25rem" object-fit="cover"
      text chip.label min-width=0 max-width="18rem" line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color=entry.ink
      text chip.size flex-shrink=0 font-size="0.625rem" font-weight=500 line-height="0.875rem" white-space="pre" color=entry.ink

// ContextChipPopover (side top, width lg, compact padding): the reference's
// title and its details, opened from the chip and closed from it again.
component ChipDetails
  props
    chip: ChipView
    close: action
  view
    column position="absolute" left=0 bottom="1.625rem" width="20rem" max-height="17.5rem" padding="0.75rem" gap="0.375rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" overflow="hidden" z-index=60 role="dialog" aria-label=chip.label testId="context-chip-details"
      text chip.tip font-size="0.75rem" font-weight=500 line-height="1rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
      text chip.detail font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#71717b, #818181)"

// chat-markdown-codeblock: a 10pt bordered card, a header with the language and
// the wrap/copy toolbar, and 13pt code on 17.875pt lines.
component CodeBlock
  props
    canRun: bool
    block: ChatBlock
    local: action
    code: CodeHighlight[]
    copiedText: string
    copiedNonce: number
    codeFont: string
    codeSize: number
    wrapDefault: bool
    // The code reports its part of a selection to the answer (Cite; `source` "" outside answers).
    source: string
    cite: action
    // The cited text in this block's offsets while its comment is open (-1: none); the code starts
    // after its header's language line (citeRunOffset), at `codeAt`.
    ms: number
    me: number
  // readInitialWordWrapSetting: Settings → Word wrap decides; the toggle flips it.
  state flipped = false
  derive wrap = flipped ? not wrapDefault : wrapDefault
  derive codeAt = ms < 0 ? 0 : citeCodeLabel(block, code).length + (citeCodeLabel(block, code) != "" ? 1 : 0)
  action toggleWrap
    flipped = not flipped
  view
    column width="100%" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#fafafa, #ffffff08)" overflow="hidden"
      row width="100%" height="1.875rem" padding-top="0.375rem" padding-right="0.375rem" padding-left="0.75rem" box-sizing="border-box" align-items="center" justify-content="space-between" gap="0.5rem"
        row min-width=0 height="1.5rem" align-items="center" gap="0.375rem"
          if code.filter((hl) => hl.code == block.text and hl.icon != "").length > 0
            for hl in code.filter((hl) => hl.code == block.text and hl.icon != "") key=hl.id
              FileTypeIcon(token=hl.icon, size=14)
          else
            text block.href font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#27272ab8, #f5f5f5b8)" line-clamp=1
        row gap="0.125rem" align-items="center"
          if canRun
            Tip(label="Run in terminal", side="top", align="center", offset=28)
              button press=local("run-terminal", block.id, block.text) aria-label="Run in terminal" testId=`run-terminal-${block.id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                Icon(name="square-terminal", size=12, color="light-dark(#27272a, #f5f5f5)")
          Tip(label=(wrap ? "Disable line wrap" : "Wrap lines"), side="top", align="center", offset=28)
            button press=toggleWrap aria-label=(wrap ? "Disable line wrap" : "Wrap lines") width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(wrap ? "light-dark(#fafafa, #ffffff08)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              Icon(name="text-wrap", size=12, color="light-dark(#27272a, #f5f5f5)")
          Tip(label="Copy code", side="top", align="center", offset=28)
            CopyCodeButton(block=block, local=local, copied=(copiedText == block.text ? copiedNonce : 0))
      if code.filter((hl) => hl.code == block.text).length == 0
        if wrap
          if ms < 0
            text block.text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") width="100%" padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" box-sizing="border-box" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#0a0a0a, #fafafa)"
          else
            text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") width="100%" padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" box-sizing="border-box" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#0a0a0a, #fafafa)"
              MarkedText(value=block.text, at=codeAt, ms=ms, me=me)
        else
          scroll width="100%" overflow-x="scroll" overflow-y="hidden"
            if ms < 0
              text block.text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre" color="light-dark(#0a0a0a, #fafafa)"
            else
              text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre" color="light-dark(#0a0a0a, #fafafa)"
                MarkedText(value=block.text, at=codeAt, ms=ms, me=me)
      for hl in code.filter((hl) => hl.code == block.text) key=hl.id
        if wrap
          text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") width="100%" padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" box-sizing="border-box" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#0a0a0a, #fafafa)"
            for token in hl.tokens key=token.id
              if ms < 0
                text token.text color=synColor(token.cls) font-style=synSlant(token.cls)
              else
                text color=synColor(token.cls) font-style=synSlant(token.cls)
                  MarkedText(value=token.text, at=codeAt + tokenAt(hl.tokens, token.id), ms=ms, me=me)
        else
          scroll width="100%" overflow-x="scroll" overflow-y="hidden"
            text id=`cite-${source}-${block.id}-code` selectionchange=cite(block.id, "code") padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre" color="light-dark(#0a0a0a, #fafafa)"
              for token in hl.tokens key=token.id
                if ms < 0
                  text token.text color=synColor(token.cls) font-style=synSlant(token.cls)
                else
                  text color=synColor(token.cls) font-style=synSlant(token.cls)
                    MarkedText(value=token.text, at=codeAt + tokenAt(hl.tokens, token.id), ms=ms, me=me)
// MarkdownMermaidCodeBlock: a settled ```mermaid fence draws its diagram with
// no card, centred and fit to the lane, a "Show code" toggle and Copy beneath;
// "Show code" turns it back into the code block, its toolbar led by "Show
// diagram". While the diagram renders the space says so; a failure shows
// Mermaid's message (with Retry when loading failed) above the source.
// MermaidDiagram renders it with the reference's Mermaid in the Mermaid page,
// the fence's own frame; the page posts what came of it (MermaidFrameView).
component MermaidBlock
  props
    block: ChatBlock
    local: action
    diagram: MermaidDiagram
    scheme: string
    copied: number
    codeFont: string
    codeSize: number
    wrapDefault: bool
  state showCode = false
  state flipped = false
  derive wrap = flipped ? not wrapDefault : wrapDefault
  derive frame = scheme == "dark" ? diagram.dark : diagram.light
  action toggleCode
    showCode = not showCode
  action toggleWrap
    flipped = not flipped
  view
    if showCode
      column width="100%" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#fafafa, #ffffff08)" overflow="hidden"
        row width="100%" height="1.875rem" padding-top="0.375rem" padding-right="0.375rem" padding-left="0.75rem" box-sizing="border-box" align-items="center" justify-content="space-between" gap="0.5rem"
          row min-width=0 height="1.5rem" align-items="center" gap="0.375rem"
            text block.href font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#27272ab8, #f5f5f5b8)" line-clamp=1
          row gap="0.125rem" align-items="center" role="toolbar" aria-label="Code block actions"
            Tip(label="Show diagram", side="top", align="center", offset=28)
              DiagramToggle(label="Show diagram", icon="workflow", press=toggleCode)
            Tip(label=(wrap ? "Disable line wrap" : "Wrap lines"), side="top", align="center", offset=28)
              button press=toggleWrap aria-label=(wrap ? "Disable line wrap" : "Wrap lines") width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(wrap ? "light-dark(#fafafa, #ffffff08)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                Icon(name="text-wrap", size=12, color="light-dark(#27272a, #f5f5f5)")
            Tip(label="Copy code", side="top", align="center", offset=28)
              CopyCodeButton(block=block, local=local, copied=copied)
        if wrap
          text block.text width="100%" padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" box-sizing="border-box" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#0a0a0a, #fafafa)"
        else
          scroll width="100%" overflow-x="scroll" overflow-y="hidden"
            text block.text padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" font-family=codeFont font-size=codeSize letter-spacing=-0.2 line-height=1.375 white-space="pre" color="light-dark(#0a0a0a, #fafafa)"
    else
      column width="100%" testId=`mermaid-${block.id}`
        if frame.diagram == "error"
          column width="100%"
            row width="100%" align-items="center" justify-content="space-between" gap="0.5rem"
              text `Unable to render diagram: ${frame.message}` min-width=0 font-size="0.75rem" line-height="1rem" white-space="pre-wrap" color="light-dark(#fb2c36, #fb414a)" role="alert"
              if frame.retryable
                button press=local("diagram-retry", scheme, block.text) testId=`mermaid-retry-${block.id}` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
                  text "Retry" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
            text block.text width="100%" margin-top="0.5rem" padding-left="0.9rem" padding-right="0.9rem" padding-top="0.8rem" padding-bottom="0.8rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" font-family="ui-monospace" font-size=12 line-height="16px" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#27272a, #f5f5f5)"
        else
          box position="relative" width="100%"
            MermaidFrameView(src=(scheme == "dark" ? diagram.srcDark : diagram.srcLight), frame=frame, width=frame.width, local=local, testId=`mermaid-frame-${block.id}`)
            if frame.diagram == "rendered"
              // MermaidDiagram's button: the whole lane wide and as tall as the diagram, so a press beside a narrow
              // diagram expands it too.
              button press=local("diagram-open", block.id, block.text) aria-label="Expand diagram" testId=`mermaid-expand-${block.id}` position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" title="" id=`mermaid-expand-${block.id}`
            else
              column position="absolute" left=0 top=0 right=0 bottom=0 align-items="center" justify-content="center" role="status" pointer-events="none"
                text "Rendering diagram" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        row width="100%" margin-top="0.125rem" align-items="center" justify-content="space-between"
          Tip(label="Show code", side="top", align="start", offset=28)
            DiagramToggle(label="Show code", icon="code", press=toggleCode)
          Tip(label="Copy code", side="top", align="end", offset=28)
            CopyCodeButton(block=block, local=local, copied=copied)

// An icon-xs ghost-muted button: muted until hovered, then an accent fill.
component DiagramToggle
  props
    label: string
    icon: string
    press: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-label=label width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      TimelineIcon(name=icon, size=12, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

// One fence's Mermaid page (assets/mermaid/index.html) at the diagram's natural `width`, scaled down to fit
// (h-auto, max-w-full) and centred. It loads hidden in the "Rendering diagram" space and shows once it reports;
// its report goes to timeline-mermaid.ts, which keeps it for the fence's next mount. The frame takes no input: the
// expand button over it does, as the reference's button holds the SVG.
component MermaidFrameView
  props
    src: string
    frame: MermaidFrame
    width: number
    local: action
    testId: string
  derive rendered = frame.diagram == "rendered"
  action reported(payload: string)
    local("diagram-frame", "", payload)
  view
    row width="100%" min-height=(rendered ? 0 : "9rem") justify-content="center"
      box width=(rendered ? width : "100%") max-width="100%" aspect-ratio=(rendered ? `${frame.width} / ${frame.height}` : "auto") height=(rendered ? "auto" : "9rem") flex-shrink=1 position="relative"
        iframe src=src message=reported aria-hidden=true tabindex=-1 pointer-events="none" position="absolute" left=0 top=0 width="100%" height="100%" border-width=0 opacity=(rendered ? 1 : 0) testId=testId

// MarkdownCodeBlock's copy button: MorphIcon Copy ↔ Check (#123): the check from a copy until
// the root clears it 1.2 s later (codeCopyDone, app.contract), both ways on morphicons' spring (shell-morph.contract).
component CopyCodeButton
  inject
    still: bool
    codeCopyDone: number
  props
    block: ChatBlock
    local: action
    copied: number
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=local("copy-code", block.id, block.text) hover=hover aria-label="Copy code" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      MorphCopyCheck(on=(copied > 0 and copied != codeCopyDone), size=12, color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2, still=still)

// MarkdownTable (ChatMarkdown.tsx; MIT, see LICENSE-T3): a full-width table of
// 12pt cells that scrolls sideways past its content width; cells keep one line
// (an ellipsis at the column's edge) until "Expand table cells" lets body cells
// wrap across the column (Settings → Word wrap decides the start). A cell's
// 24rem max-width only caps what it asks of the column: Chrome's table layout
// ignores max-width on a td, so spare room still widens the column. The footer's Copy menu copies the
// table as Markdown or CSV; a copy morphs its icon to a check and back after 1.2s (#123, MorphCopyCheck).
component MarkdownTable
  props
    block: ChatBlock
    prose: string
    fit: bool
    wrapDefault: bool
    // A cell's images draw through their media chips (ChatMarkdownImage in the `td`).
    chips: ChipView[]
    urls: AttachmentUrl[]
    local: action
    copied: number
  state flipped = false
  derive expanded = flipped ? not wrapDefault : wrapDefault
  action toggleExpanded
    flipped = not flipped
  view
    column width=(fit ? "auto" : "100%") max-width="100%" position="relative" testId=`table-${block.id}`
      scroll width=(fit ? "auto" : "100%") max-width="100%" overflow-x="scroll" overflow-y="hidden"
        column width=(fit ? "auto" : "100%") role="table"
          for tableRow in block.rows key=tableRow.id
            row width="100%" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e799, #ffffff09)" role="row"
              for cell in tableRow.cells key=`${cell.id}\t${cell.runs.map((part) => part.text).join("")}`
                for column in block.columns.filter((entry) => entry.id == cell.id) key=column.id
                  TableCell(cell=cell, column=column, header=tableRow.header, expanded=expanded, prose=prose, chips=chips, urls=urls, local=local, nodePrefix=`${block.id}-${tableRow.id}-${cell.id}`)
      row width="100%" margin-top="0.125rem" align-items="center" justify-content="space-between"
        Tip(label=(expanded ? "Collapse table cells" : "Expand table cells"), side="top", align="start", offset=28)
          TableIconButton(label=(expanded ? "Collapse table cells" : "Expand table cells"), icon=(expanded ? "minimize" : "maximize"), pressed=expanded, press=toggleExpanded, testId=`table-expand-${block.id}`)
        Tip(label="Copy table", side="top", align="end", offset=28)
          TableCopyButton(press=local("table-menu", block.id, `${block.markdown}\t${block.csv}`), pressFirst=local("table-menu", block.id, `keys:first\t${block.markdown}\t${block.csv}`), pressLast=local("table-menu", block.id, `keys:last\t${block.markdown}\t${block.csv}`), copied=copied, open=false, testId=`table-copy-${block.id}`) // its popup is the window's (table-menu.contract)

// A th or td: 7.2/12 padding (8.8 in the header), the column's sizing cell
// drawn invisibly beneath so every row's cell takes the column's width. The
// shown content asks for no width (width 0) and fills the cell (min-width 100%),
// so only the sizer sizes the column and the text uses all of it.
component TableCell
  props
    cell: ChatCell
    column: ChatColumn
    header: bool
    expanded: bool
    prose: string
    chips: ChipView[]
    urls: AttachmentUrl[]
    local: action
    // The cell's table block, row and column: its images' node ids (markdownGalleryIds).
    nodePrefix: string
  view
    column flex-grow=column.grow flex-shrink=0 min-width=0 padding-left="0.75rem" padding-right="0.75rem" padding-top=(header ? "0.55rem" : "0.45rem") padding-bottom=(header ? "0.55rem" : "0.45rem") box-sizing="border-box" justify-content="center" role=(header ? "columnheader" : "cell")
      if cellBoxes(cell.runs)
        // A code span keeps its bordered box (inline spans paint backgrounds only); an image is its picture.
        CellRuns(runs=cell.runs, weight=(header ? 600 : 400), color=prose, nowrap=(header or not expanded), justify=(column.align == "center" ? "center" : column.align == "right" ? "flex-end" : "flex-start"), chips=chips, urls=urls, local=local, nodePrefix=nodePrefix)
      if not cellBoxes(cell.runs) and (header or not expanded)
        // One line, cut with an ellipsis at the column's edge (text-overflow: ellipsis).
        text width=0 min-width="100%" font-size="0.75rem" line-height=1.625 line-clamp=1 color=prose text-align=column.align
          ChatRuns(runs=cell.runs, size=12, weight=(header ? 600 : 400), ms=-1, me=-1)
      if not cellBoxes(cell.runs) and not (header or not expanded)
        text width=0 min-width="100%" font-size="0.75rem" line-height=1.625 overflow-wrap="anywhere" color=prose text-align=column.align
          ChatRuns(runs=cell.runs, size=12, weight=400, ms=-1, me=-1)
      box height=0 overflow="hidden" aria-hidden=true
        if column.capped
          box width="22.5rem" height=0
        if not column.capped and cellBoxes(column.sizer)
          CellSizer(runs=column.sizer, weight=(column.header ? 600 : 400), color=prose, chips=chips, urls=urls)
        if not column.capped and not cellBoxes(column.sizer)
          text max-width=(expanded and column.header ? "6250rem" : "22.5rem") font-size="0.75rem" line-height=1.625 white-space="nowrap" opacity=0
            ChatRuns(runs=column.sizer, size=12, weight=(column.header ? 600 : 400), ms=-1, me=-1)

// Whether a cell draws run by run: a code span, a chip or an image is a box of its own.
fn cellBoxes(runs: ChatRun[]): bool = runs.filter((part) => part.mono or part.kind == "file" or part.kind == "media" or chipAccent(part.kind) != "").length > 0

// A cell holding code spans, chips or images: its runs side by side, each code span 12pt SF
// Mono in its 1pt-bordered, 5.6pt-padded box on the cell's 19.5pt line, an image inline (ChatMarkdownImage, not standalone).
component CellRuns
  props
    runs: ChatRun[]
    weight: number
    color: string
    nowrap: bool
    justify: string
    chips: ChipView[]
    urls: AttachmentUrl[]
    local: action
    nodePrefix: string
  view
    // It fills its cell as TableCell's text does.
    row width=0 min-width="100%" max-width="6250rem" min-height="1.21875rem" flex-wrap=(nowrap ? "nowrap" : "wrap") align-items="center" justify-content=justify overflow=(nowrap ? "hidden" : "visible")
      for run in runs key=run.id
        if run.mono
          text run.text flex-shrink=0 font-family="ui-monospace" font-size="0.75rem" line-height="0.875rem" white-space="pre" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)"
        if not run.mono and run.kind == "file"
          FileChip(run=run)
        if not run.mono and run.kind != "file" and chipAccent(run.kind) != ""
          ContextChipBox(run=run)
        if not run.mono and run.kind == "media" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href).length > 0
          for chip in chips.filter((chip) => chip.kind == "media" and chip.href == run.href) key=chip.id
            MarkdownMedia(alt=run.text, kind=chip.size, access=chip.icon, target=chip.target, tip=chip.tip, source=chip.detail, urls=urls, local=local, standalone=false, link=run.link, linkLabel=(run.label != "" ? run.label : run.text), favicon=(webLink(run.link) and linkLeads(runs, run.id, run.link)), owner=chip.owner, nodeId=`media-${chip.owner}-${nodePrefix}-${run.id}`)
        if not run.mono and run.kind != "file" and chipAccent(run.kind) == "" and not (run.kind == "media" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href).length > 0)
          text run.text min-width=0 font-size="0.75rem" line-height=1.625 white-space=(nowrap ? "pre" : "pre-wrap") font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant color=color

// A column's sizing cell (the widest cell's runs, unseen, asking for their width capped at 24rem): an image is the same
// picture, so the column takes its width; no preview, menu or node id of its own.
component CellSizer
  props
    runs: ChatRun[]
    weight: number
    color: string
    chips: ChipView[]
    urls: AttachmentUrl[]
  view
    row width="auto" min-width=0 max-width="22.5rem" min-height="1.21875rem" flex-wrap="nowrap" align-items="center" overflow="hidden" opacity=0
      for run in runs key=run.id
        if run.mono
          text run.text flex-shrink=0 font-family="ui-monospace" font-size="0.75rem" line-height="0.875rem" white-space="pre" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant padding-left="0.35rem" padding-right="0.35rem" padding-top="0.1rem" padding-bottom="0.1rem" border-width=1 border-style="solid"
        if not run.mono and run.kind == "file"
          FileChip(run=run)
        if not run.mono and run.kind != "file" and chipAccent(run.kind) != ""
          ContextChipBox(run=run)
        if not run.mono and run.kind == "media" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href and chip.size == "image" and chip.icon != "blocked").length > 0
          for chip in chips.filter((chip) => chip.kind == "media" and chip.href == run.href and chip.size == "image" and chip.icon != "blocked") key=chip.id
            if chip.icon == "direct"
              image chip.target aria-hidden=true flex-shrink=0 max-width="22.5rem" max-height="30rem" object-fit="contain"
            else
              for entry in urls.filter((entry) => entry.id == chip.target and entry.url != "") key=entry.id
                image entry.url aria-hidden=true flex-shrink=0 max-width="22.5rem" max-height="30rem" object-fit="contain"
        if not run.mono and run.kind != "file" and chipAccent(run.kind) == "" and not (run.kind == "media" and chips.filter((chip) => chip.kind == "media" and chip.href == run.href and chip.size == "image" and chip.icon != "blocked").length > 0)
          text run.text min-width=0 font-size="0.75rem" line-height=1.625 white-space="pre" font-weight=(run.weight > weight ? run.weight : weight) font-style=run.slant color=color

// The footer's icon-xs buttons: ghost-muted, or "secondary" while pressed.
component TableIconButton
  props
    label: string
    icon: string
    pressed: bool
    press: action
    testId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-label=label testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(pressed ? "light-dark(#fafafa, #ffffff08)" : hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      // ChatMarkdown's table toggle: MorphIcon Maximize2↔Minimize2 (morphicons' morph, shell-morph.contract).
      MorphMaximize(on=(icon == "minimize"), size=12, color=(pressed or hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2, still=false)

component TableCopyButton
  inject
    still: bool
    codeCopyDone: number
  props
    press: action
    // ↓ and ↑: the same request, asking the window's menu to focus its first or last item as it mounts.
    pressFirst: action
    pressLast: action
    copied: number
    open: bool
    testId: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  // The Copy menu opens from the data module; the button lets go of the focus and the
  // menu's popup takes it as it mounts (`autofocus`, menu-keys.contract). ↓ and ↑ open it too: the menu
  // mounts at the window, past this tree, so the request itself carries the end (`menu.keyed`).
  action openMenu
    blur()
    press()
  action menuKey(k: string, e: KeyboardEvent)
    if kmArrow(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not open
      preventDefault()
      blur()
      if k == "ArrowUp"
        pressLast()
      else
        pressFirst()
  view
    button press=openMenu key=menuKey hover=hover aria-label="Copy table" aria-expanded=open id=testId testId=testId width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered or open ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      MorphCopyCheck(on=(copied > 0 and copied != codeCopyDone), size=12, color=(hovered or open ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), weight=2, still=still)

component TableMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    press: action
    testId: string
  state lit = false
  action hover(over: bool)
    if over
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press hover=hover focus=focused(true) blur=focused(false) role="menuitem" aria-label=label testId=testId width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(lit ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
