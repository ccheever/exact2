// Markdown's small controls and placements, which read no Markdown shape: GFM's task checkbox, a diagram's toggle, and
// a line's alignment.
use TimelineIcon from "./timeline-icons-kit.contract"
use MorphCopyCheck from "../shell/shell-morph.contract"
use ChatBlock from "./markdown-blocks.contract"

// GFM's task checkbox in place of the list marker (`li.task-list-item`:
// list-style none, the checkbox in the 1.25rem gutter with 0.35em after it), as Electron draws an `input` checkbox on
// macOS (13pt, 12pt tall with a 1pt shade, white or the accent blue with a white tick). In a file preview
// (taskOffset >= 0) a press toggles the task and saves the file (RenderedMarkdownSurface onTaskListChange,
// files-surface.ts toggleTask); elsewhere it is GFM's disabled checkbox (MarkdownInput without onTaskListChange).
component TaskCheckbox
  props
    id: string
    task: string
    taskOffset: number
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box width="1.11875rem" height="1.421875rem" flex-shrink=0 padding-top="0.33125rem" box-sizing="border-box"
      if taskOffset >= 0
        button press=local("surface-files-task", id, `${taskOffset}\t${task == "done" ? "false" : "true"}`) hover=hover role="checkbox" aria-checked=(task == "done") aria-label="Toggle task" testId=`task-${id}` width=13 height=13 padding=0 border-width=0 background-color="#00000000" cursor="default" title="" tabindex=0
          TaskBox(done=(task == "done"), disabled=false, hovered=hovered)
      else
        box role="checkbox" aria-checked=(task == "done") aria-label="Task" testId=`task-${id}` width=13 height=13
          TaskBox(done=(task == "done"), disabled=true, hovered=false)

component TaskBox
  props
    done: bool
    disabled: bool
    hovered: bool
  view
    box width=13 height=13 position="relative" opacity=(disabled ? 0.5 : 1)
      box position="absolute" left=0 top=0 width=13 height=12 box-sizing="border-box" border-radius=3 border-width=(done ? 0 : 1) border-style="solid" border-color=(hovered ? "light-dark(#5c5c5c, #a3a3a3)" : "light-dark(#767676, #8a8a8a)") background-color=(done ? (hovered ? "light-dark(#255fd6, #3b82f6)" : "light-dark(#3273f6, #3b82f6)") : "light-dark(#ffffff, #ffffff1f)") box-shadow="0 1px 0 light-dark(#00000026, #00000066)"
        if done
          box position="absolute" left=2 top=1.5 width=9 height=9
            TimelineIcon(name="check-mark", size=9, color="#ffffff")

component DiagramToggle
  props
    label: string
    icon: string
    press: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=press hover=hover aria-label=label width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title="" tabindex=0
      TimelineIcon(name=icon, size=12, color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"))

// A line's `text-align` (a `<p align>` or `<div align>`, markdown-parse Block) as its row's main-axis placement.
fn lineJustify(align: string): string = align == "center" ? "center" : align == "right" ? "flex-end" : "flex-start"

// An icon-xs ghost-muted button: muted until hovered, then an accent fill.
// MarkdownCodeBlock's copy button: MorphIcon Copy ↔ Check (#123): the check from a copy until
// the root clears it 1.2 s later (codeCopyDone, app.contract), both ways on morphicons' spring (shell-morph.contract).
component CopyCodeButton
  inject
    still: bool
    codeCopyDone: number
  props
    block: ChatBlock
    local: action
    copied: number
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=local("copy-code", block.id, block.text) hover=hover aria-label="Copy code" tabindex=0 width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      MorphCopyCheck(on=(copied > 0 and copied != codeCopyDone), size=12, color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"), weight=2, still=still)

// ContextChipPopover (side top, width lg, compact padding): the reference's
// title and its details, opened from the chip and closed from it again.
component ChipDetails
  props
    label: string
    tip: string
    detail: string
    close: action
  view
    column position="absolute" left=0 bottom="1.625rem" width="20rem" max-height="17.5rem" padding="0.75rem" gap="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" overflow="hidden" z-index=60 role="dialog" aria-label=label testId="context-chip-details"
      text tip font-size="0.75rem" font-weight=500 line-height="1rem" line-clamp=1 color="light-dark(#18181b, #f5f5f5)"
      text detail font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#71717b, #a1a1a1)"
