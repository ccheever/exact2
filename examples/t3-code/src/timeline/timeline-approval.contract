// A pending approval on its timeline row, from T3 Code v0.1.5's chat/TimelinePendingApprovalRow.tsx and
// ComposerPendingApprovalActions.tsx's inline presentation (MIT, see LICENSE-T3); timeline-approvals.ts builds it.
use TimelineIcon from "./timeline-icons-kit.contract"
use TipBubble from "../shell/shell-tip.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"

shape ApprovalChoice
  id: string
  label: string
  warning: string
  primary: bool
shape TimelineApproval
  id: string
  icon: string
  label: string
  detailLabel: string
  detail: string
  appName: string
  reason: string
  live: bool
  operable: bool
  responding: bool
  whyAsked: string
  options: ApprovalChoice[]
  more: ApprovalChoice[]

// WorkLogRow with a wrapping label: the request kind's muted 16pt glyph in the 24pt icon column, then what is asked
// as a monospaced block (text-xs, leading-5) that scrolls past 10rem; under it, from the label's start (ms-7.5), the
// app, the reason, and "Waiting for approval" · the decisions, or why none can be taken.
component PendingApprovalRow
  props
    approval: TimelineApproval
    command: action
  derive blocked = approval.responding or not approval.operable
  view
    column width="100%" padding-left="0.125rem" padding-right="0.125rem" padding-top="0.125rem" padding-bottom="0.125rem" box-sizing="border-box" border-radius="0.375rem" role="group" aria-label=approval.label testId=`timeline-approval-${approval.id}`
      row width="100%" min-height="1.5rem" gap="0.375rem" align-items="flex-start"
        row width="1.5rem" height="1.5rem" flex-shrink=0 align-items="center" justify-content="center"
          TimelineIcon(name=approval.icon, size=16, color="light-dark(#44444a, #a1a1a1)")
        scroll flex=1 min-width=0 max-height="10rem" tabindex=0 aria-label=approval.detailLabel testId=`timeline-approval-detail-${approval.id}`
          text approval.detail padding-top="0.125rem" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.25rem" white-space="pre-wrap" overflow-wrap="anywhere" user-select="text" color="light-dark(#18181b, #f5f5f5)"
      column margin-left="1.875rem" padding-bottom="0.25rem" gap="0.25rem" min-width=0
        if approval.appName != ""
          text approval.appName font-size="0.75rem" line-height="1rem" overflow-wrap="anywhere" color="light-dark(#71717b, #a1a1a1)"
        if approval.reason != ""
          text approval.reason font-size="0.75rem" line-height="1rem" overflow-wrap="anywhere" user-select="text" color="light-dark(#71717b, #a1a1a1)"
        row flex-wrap="wrap" align-items="center" column-gap="0.5rem" row-gap="0.25rem" min-width=0
          if approval.live
            row gap="0.25rem" align-items="center" flex-shrink=0
              TimelineIcon(name="shield", size=12, color="#fe9a00")
              text "Waiting for approval" font-size="0.75rem" line-height="1rem" white-space="nowrap" color="#fe9a00"
            text "·" aria-hidden=true font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
            for option in approval.options key=option.id
              ApprovalChoiceButton(option=option, approvalId=approval.id, disabled=blocked, choose=command("approval", approval.id, option.id, 0))
            if approval.more.length > 0
              ApprovalMore(approval=approval, command=command, disabled=blocked)
          else
            text "Provider process is gone. Interrupt or restart the run to respond." font-size="0.75rem" line-height="1rem" color="#fe9a00"
          if approval.whyAsked != ""
            ApprovalWhyAsked(id=approval.id, explanation=approval.whyAsked)

// InlineButton: medium text that underlines on hover, Approve in the foreground and every other decision muted; one
// with a warning leads with a 12pt triangle and shows the warning above it.
component ApprovalChoiceButton
  props
    option: ApprovalChoice
    approvalId: string
    disabled: bool
    choose: action
  state over = false
  state focused = false
  action hover(value: bool)
    over = value
  action mark(value: bool)
    focused = value
  view
    box position="relative" display="flex" flex-direction="row" flex-shrink=0
      if option.warning != ""
        TipBubble(label=option.warning, side="top", align="center", offset=22, inset=0, shown=(over or focused))
      button press=choose hover=hover focus=mark(true) blur=mark(false) disabled=disabled opacity=(disabled ? 0.64 : 1) testId=`timeline-approval-${approvalId}-${option.id}` aria-label=option.label aria-description=option.warning padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.125rem" title=""
        if option.warning != ""
          TimelineIcon(name="triangle-alert", size=12, color=(option.id == "accept" or over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"))
        text option.label font-size="0.75rem" font-weight=500 line-height="1rem" text-decoration-line=(over and not disabled ? "underline" : "none") color=(option.id == "accept" or over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")

// "More" (InlineButton, muted) opens the rest of the decisions above it, its right edge on the button's (side top,
// align end), as a popover: a press outside or Escape closes it and gives the focus back.
component ApprovalMore
  inject
    dialogMenuEntered: action
  props
    approval: TimelineApproval
    command: action
    disabled: bool
  state open = false
  state over = false
  action hover(value: bool)
    over = value
  derive items = disabled ? [] : approval.more.map((option) => KmItem(id=`timeline-approval-${approval.id}-${option.id}`, label=option.label))
  // Base UI's MenuTrigger: Enter, Space, ↓ open the menu at its first item, ↑ at its last.
  action menuKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`timeline-approval-menu-${approval.id}`, source=`timeline-approval-more-${approval.id}`)
        let target = kmTriggerTarget(items, k)
        if target != ""
          focus(target)
  action toggled(e: ToggleEvent)
    open = e.newState == "open"
  view
    box position="relative" display="flex" flex-shrink=0
      button id=`timeline-approval-more-${approval.id}` popovertarget=`timeline-approval-menu-${approval.id}` key=menuKey hover=hover disabled=disabled opacity=(disabled ? 0.64 : 1) aria-haspopup="menu" aria-expanded=open aria-label="More approval options" testId=`timeline-approval-more-${approval.id}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" title=""
        text "More" font-size="0.75rem" font-weight=500 line-height="1rem" text-decoration-line=((over or open) and not disabled ? "underline" : "none") color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")
      column id=`timeline-approval-menu-${approval.id}` data-dialog-return="menu" focusin=dialogMenuEntered(`timeline-approval-menu-${approval.id}`, `timeline-approval-more-${approval.id}`) toggle=toggled popover="auto" position-area="top span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-bottom="0.25rem" max-width="calc(100vw - 32px)"
        column padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="More approval options"
          KeyMenu(menuId=`timeline-approval-menu-${approval.id}-keys`, items=items, keyed=0, gap="0px", modal=true)
            for option in approval.more key=option.id
              ApprovalMenuChoice(keysId=`timeline-approval-menu-${approval.id}-keys`, menuId=`timeline-approval-menu-${approval.id}`, option=option, testId=`timeline-approval-${approval.id}-${option.id}`, disabled=disabled, choose=command("approval", approval.id, option.id, 0))

// The default MenuItem: a left-aligned 14pt row, 28pt tall; one with a warning carries it as aria-description and a
// tooltip above it.
component ApprovalMenuChoice
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    // The popover a choice closes.
    menuId: string
    option: ApprovalChoice
    testId: string
    disabled: bool
    choose: action
  state hovering = false
  state focused = false
  action setHover(over: bool)
    hovering = over
    if over
      focus(testId)
    else if focused
      focus(keysId)
  action setFocus(value: bool)
    focused = value
  view
    box position="relative" width="100%"
      if option.warning != ""
        TipBubble(label=option.warning, side="top", align="center", offset=32, inset=0, shown=(hovering or focused))
      button id=testId press=choose popovertarget=menuId popovertargetaction="hide" hover=setHover focus=setFocus(true) blur=setFocus(false) disabled=disabled opacity=(disabled ? 0.64 : 1) role="menuitem" testId=testId aria-label=option.label aria-description=option.warning width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(focused ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        if option.warning != ""
          TimelineIcon(name="triangle-alert", size=12, color="#fe9a00")
        text option.label min-width=0 font-size="0.875rem" line-height="1.25rem" white-space="nowrap" color="light-dark(#18181b, #f5f5f5)"

// "Why am I being asked this?" (InlineButton, muted) opens the explanation above it as a hover popover in the tooltip
// style. Hovering shows it; a press keeps it open until Escape, a press outside or another press. It wraps within
// min(22rem, 100vw - 2rem).
component ApprovalWhyAsked
  inject
    rem: number
  props
    id: string
    explanation: string
  state over = false
  state pinned = false
  state shown = false
  action hover(value: bool)
    over = value
    if value
      showPopover(`timeline-approval-why-card-${id}`, source=`timeline-approval-why-${id}`)
    else if not pinned
      hidePopover(`timeline-approval-why-card-${id}`)
  action pressed
    if pinned and shown
      hidePopover(`timeline-approval-why-card-${id}`)
    else
      pinned = true
      showPopover(`timeline-approval-why-card-${id}`, source=`timeline-approval-why-${id}`)
  action toggled(e: ToggleEvent)
    shown = e.newState == "open"
    if not shown
      pinned = false
  view
    box position="relative" display="flex" flex-shrink=0 hover=hover
      button id=`timeline-approval-why-${id}` press=pressed aria-expanded=shown aria-haspopup="dialog" testId=`timeline-approval-why-${id}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
        text "Why am I being asked this?" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)") text-decoration-line=(over ? "underline" : "none")
      // The 4pt between the card and the button is the card's own padding, so the pointer crossing it stays on the card.
      column id=`timeline-approval-why-card-${id}` popover="auto" toggle=toggled role="dialog" aria-label="Why am I being asked this?" testId=`timeline-approval-why-card-${id}` position="absolute" position-area="top" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" padding-bottom="0.25rem" max-width=`min(${22 * rem}px, calc(100vw - ${2 * rem}px))` background-color="#00000000"
        column padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.375rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d"
          text explanation font-size="0.75rem" line-height="1.03125rem" white-space="normal" text-wrap="balance" color="light-dark(#18181b, #f5f5f5)"
