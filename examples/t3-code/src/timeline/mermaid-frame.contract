// A ```mermaid fence's page and what it reported (timeline-mermaid.ts): the shapes markdown.contract's MermaidBlock
// and the expanded preview (timeline-mermaid.contract) read, and the frame both draw.

// One width the page drew the diagram at (`drawnFor`, its frame's width) and the drawn diagram's size there.
shape MermaidSize
  drawnFor: number
  width: number
  height: number
// What a fence's Mermaid page reported in one theme (timeline-mermaid.ts): `diagram` is "loading", "rendered" (the
// latest drawn size, and each width's in `sizes`) or "error" (pele's message, whether Retry may help).
shape MermaidFrame
  diagram: string
  message: string
  retryable: bool
  width: number
  height: number
  sizes: MermaidSize[]
// A closed ```mermaid fence, matched to its parsed block by text: its page (assets/mermaid/) in each theme.
shape MermaidDiagram
  id: string
  code: string
  srcLight: string
  srcDark: string
  light: MermaidFrame
  dark: MermaidFrame

// One fence's Mermaid page (assets/mermaid/index.html). In the lane (`width` 0) it is the lane wide, so pele lays the
// diagram out for that width and centres it, and as tall as the diagram drawn at this frame's width (the same fence
// in a narrower lane is taller); the preview gives the box its size.
// It loads hidden over the unseen source (MarkdownMermaidCodeBlock's Suspense fallback) and shows once it reports;
// its report goes to timeline-mermaid.ts, which keeps it for the fence's next mount. The frame takes no input: the
// expand button over it does, as the reference's button holds the SVG.
component MermaidFrameView
  props
    src: string
    frame: MermaidFrame
    width: number
    height: number
    placeholder: string
    local: action
    testId: string
  state boxWidth = 0
  derive rendered = frame.diagram == "rendered"
  derive drawnHeight = match first(frame.sizes.filter((size) => size.drawnFor == boxWidth)) { case some(size) => size.height, case none => frame.height }
  action reported(payload: string)
    local("diagram-frame", "", payload)
  action sized(w: number, h: number)
    boxWidth = round(w)
  view
    row width="100%" justify-content="center"
      box resize=sized width=(width > 0 ? width : "100%") max-width="100%" height=(rendered ? (height > 0 ? height : drawnHeight) : "auto") flex-shrink=1 position="relative" overflow="hidden"
        if not rendered
          text placeholder margin-top="0.65rem" margin-bottom="0.65rem" font-family="ui-monospace" font-size="0.875rem" line-height=1.625 white-space="pre" opacity=0 aria-hidden=true
        iframe src=src message=reported aria-hidden=true tabindex=-1 pointer-events="none" position="absolute" left=0 top=0 width="100%" height="100%" border-width=0 opacity=(rendered ? 1 : 0) testId=testId
