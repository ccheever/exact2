// A sent message's attachments (T3 Code, MIT; see LICENSE-T3): the image grid
// at the top of the bubble (2 columns, 210pt at most, 4:3 tiles with a 1pt
// border; a SnapShot spans both columns in a 208×112 frame under a gradient
// with its app and window title), the file list, and ExpandedImageDialog.
use FileTypeIcon from "../shared/timeline-files.contract"
use Icon from "../shared/icons.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use SentVideoTile from "../media/sent-video.contract"
use AudioPreview from "./timeline-audio.contract"
use ExpandedVideo from "../media/sent-video.contract"
use MediaActions, MediaVideoFailure, MediaView from "../media/media-actions.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

shape MessageImage
  id: string
  name: string
  snapshot: bool
  appName: string
  appInitial: string
  windowTitle: string
  accessible: bool
  // A sent video's tile (UserVideoAttachment).
  video: bool
shape MessageFile
  id: string
  name: string
  icon: string
  // userMessageFileLabel ("Pasted text" for a paste), a card's second line ("TXT · 1.20 KB"), a list row's ("Sending…",
  // a paste's size), and whether the server has not stored it yet.
  label: string
  detail: string
  note: string
  sending: bool
shape AttachmentUrl
  id: string
  url: string
shape TimelineAttachmentUrls
  items: AttachmentUrl[]
  posted: number // messages queued for inline documents so far (inline-documents.ts)

component MessageAttachments
  props
    messageId: string
    images: MessageImage[]
    files: MessageFile[]
    // Sounds, each an audio chip (timeline-audio.contract) between the images and the files.
    audio: MessageFile[]
    urls: AttachmentUrl[]
    local: action
    // Whether the images draw here as the bubble's grid (a folded message's; others stand on their own, StandaloneMedia).
    grid: bool
    // The message's shape (userMessageShape): "files" draws file cards, "audio" the voice note as a bubble.
    shape: string
    surface: string
    ink: string
  view
    column width="100%" align-items=(shape == "files" or shape == "audio" ? "flex-end" : "stretch")
      if grid and images.length > 0
        row max-width="13.125rem" margin-bottom="0.5rem" flex-wrap="wrap" gap="0.5rem"
          for image in images key=image.id
            // A sent video's still tile opens it in the media dialog (UserVideoAttachment).
            if image.video
              if urls.filter((entry) => entry.id == image.id).length > 0
                for entry in urls.filter((entry) => entry.id == image.id) key=entry.id
                  SentVideoTile(id=image.id, name=image.name, url=entry.url, messageId=messageId, local=local)
              else
                SentVideoTile(id=image.id, name=image.name, url="", messageId=messageId, local=local)
            else
              if image.snapshot
                AttachmentTile(image=image, messageId=messageId, urls=urls, width=208, height=112, local=local)
              else
                AttachmentTile(image=image, messageId=messageId, urls=urls, width=101, height=75.75, local=local)
      if audio.length > 0
        column max-width="100%" margin-bottom=(shape == "audio" ? "0px" : "0.5rem") gap="0.25rem" align-items=(shape == "audio" ? "flex-end" : "flex-start")
          for sound in audio key=sound.id
            AudioPreview(name=sound.name, src=urls.filter((entry) => entry.id == sound.id).map((entry) => entry.url).join(""), failed=(urls.filter((entry) => entry.id == `failed:${sound.id}`).length > 0), open=local("surface-linked-attachment", sound.id, ""), report=local("audio-playing", messageId), id=sound.id, bubble=(shape == "audio"), surface=surface)
      if shape == "files"
        column max-width="100%" gap="0.25rem" align-items="flex-end"
          for file in files key=file.id
            SentFileCard(file=file, local=local, surface=surface, ink=ink)
      else if files.length > 0
        column margin-bottom="0.5rem" gap="0.25rem"
          for file in files key=file.id
            SentFileRow(file=file, local=local)

component AttachmentTile
  props
    image: MessageImage
    messageId: string
    urls: AttachmentUrl[]
    width: number
    height: number
    local: action
  view
    box position="relative" width=width height=height box-sizing="border-box" overflow="hidden" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="light-dark(#fcfcfcb3, #000000b3)"
      if urls.filter((entry) => entry.id == image.id).length > 0
        for entry in urls.filter((entry) => entry.id == image.id) key=entry.id
          button press=local("image-open", image.id, messageId) aria-label=`Preview ${image.name}` testId=`attachment-image-${image.id}` width="100%" height="100%" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" title="" id=`attachment-image-${image.id}`
            image entry.url aria-label=image.name width="100%" height="100%" object-fit="cover"
      else
        column width="100%" height="100%" min-height="4.5rem" align-items="center" justify-content="center" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box"
          text image.name font-size="0.6875rem" line-height="1rem" text-align="center" line-clamp=2 color="light-dark(#71717bb3, #a1a1a1b3)"
      if image.snapshot
        row position="absolute" left=0 right=0 bottom=0 min-width=0 gap="0.375rem" align-items="center" padding-left="0.625rem" padding-right="0.625rem" padding-top="1.5rem" padding-bottom="0.5rem" box-sizing="border-box" pointer-events="none" background-image="linear-gradient(to top, #000000d9 0%, #0000008c 50%, #00000000 100%)"
          column width="1.75rem" height="1.75rem" flex-shrink=0 border-radius="0.25rem" align-items="center" justify-content="center" background-color="#ffffff33"
            text image.appInitial font-size="0.625rem" font-weight=500 line-height="0.875rem" color="#ffffff"
          column flex=1 min-width=0
            text image.appName line-clamp=1 font-size="0.6875rem" font-weight=500 line-height="0.875rem" color="#ffffff"
            text image.windowTitle line-clamp=1 font-size="0.625rem" line-height="0.875rem" color="#ffffffb3"

// A sent picture's thumbnail in its context chip (ImageChipButton). It reports a picture that does not load: a sent
// SVG's chip is then the file chip (contextChipParts.tsx SvgFileChip), drawn from the next snapshot.
component ChipThumb
  props
    url: string
    // The attachment's id.
    target: string
    local: action
  action failed(message: string)
    local("chip-preview-failed", target, url)
  view
    image url error=failed aria-hidden=true width="0.875rem" height="0.875rem" flex-shrink=0 border-radius="0.25rem" object-fit="cover"

// ExpandedImageDialog: the image at its own size up to 92% of the window
// (less 96pt for the arrows) and min(86vh, 100vh − 160pt) high, its close
// button 40pt above the top-right corner, "name (1/2)" below it, and the
// previous/next arrows at the dialog's edges. The media and its caption sit in
// MediaActions (Save, Copy image); an image with no URL says it is unavailable, and a video that
// fails shows ExpandedMediaFailure's black panel with Retry video.
component ImagePreviewHost
  props
    id: string
    urls: AttachmentUrl[]
    name: string
    position: string
    previous: bool
    next: bool
    video: bool
    source: string
    // The media's tooltip (MediaActions: its full path, URL or name), and the node the dialog gives the focus back to.
    tip: string
    returnFocus: string
    windowWidth: number
    windowHeight: number
    local: action
  derive shown = urls.filter((entry) => entry.id == id and entry.url != "")
  view
    if shown.length > 0
      for preview in shown key=preview.id
        ImagePreviewDialog(id=id, url=preview.url, failed=false, name=name, position=position, previous=previous, next=next, video=video, source=source, tip=tip, returnFocus=returnFocus, windowWidth=windowWidth, windowHeight=windowHeight, local=local)
    else
      ImagePreviewDialog(id=id, url="", failed=(urls.filter((entry) => entry.id == `failed:${id}`).length > 0), name=name, position=position, previous=previous, next=next, video=video, source=source, tip=tip, returnFocus=returnFocus, windowWidth=windowWidth, windowHeight=windowHeight, local=local)

component ImagePreviewDialog
  inject
    dialogSeated: string[]
    dialogEntered: action
    dialogFallback: action
    rem: number
  props
    id: string
    url: string
    failed: bool
    name: string
    position: string
    previous: bool
    next: bool
    video: bool
    // The media's actions source (a sent attachment's `attachment:<id>`, or a file link's media JSON).
    source: string
    tip: string
    returnFocus: string
    windowWidth: number
    windowHeight: number
    local: action
  // Closing gives the focus back to the Markdown image that opened it (Base UI Dialog's finalFocus).
  action closePreview
    local("image-close", "", "")
  // MediaVideoPlayer failedSrc / ExpandedImageDialog failedImageSrc: the URL the player or the picture
  // refused (an `image` `error`, exact2 #121); Retry video signs the attachment again.
  state failedUrl = ""
  derive videoFailed = failedUrl != "" and failedUrl == url
  action broke(reason: string)
    let ignored = reason
    failedUrl = url
  derive dialogTargets = [(previous ? "image-preview-previous" : ""), "image-preview-actions", "image-preview-close", (next ? "image-preview-next" : "")]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=45 align-items="center" justify-content="center" background-color="#000000bf" role="dialog" aria-modal=dialogSeated.includes("image-preview") aria-label=(video ? "Expanded video preview" : "Expanded image preview") testId="image-preview" id="image-preview" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("image-preview") key=dialogFallback("image-preview", dialogTargets)
      // The focus trap (dialog-trap.contract): Previous, the media's actions, the X, Next. The backdrop is no Tab stop (the reference's popup takes its clicks).
      FocusGuard(guardId="image-preview-guard-start", targets=dialogTargets, popup="image-preview")
      DialogOpenFocus(target="image-preview-close")
      button press=closePreview aria-label=(video ? "Close video preview" : "Close image preview") aria-keyshortcuts="Escape" tabindex=-1 position="absolute" left=0 right=0 top=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="image-preview-backdrop" title=""
      row width=(windowWidth * 0.92) align-items="center" justify-content="space-between"
        PreviewStep(label="Previous media", shown=previous, flip=true, press=local("image-step", "", "previous"), elementId="image-preview-previous", testId="image-preview-previous")
        MediaActions(source=source, tip=(tip != "" ? tip : name), local=local, elementId="image-preview-actions", testId="image-preview-actions")
          column min-width=0 align-items="center"
            box position="relative"
              // ExpandedVideo, the player with native controls, playing (attachment-media.contract).
              if video
                if url != "" and not videoFailed
                  ExpandedVideo(url=url, name=name, maxWidth=(windowWidth * 0.92 - 96), maxHeight=min(windowHeight * 0.86, windowHeight - 160), broke=broke)
                else
                  if failed or videoFailed
                    column width=min(windowWidth * 0.92 - 96, 512)
                      MediaVideoFailure(media=MediaView(kind="video", state="failed", url=url, name=name, tip=name, source="", failText=(name != "" ? `Video unavailable · ${name}` : "Video unavailable"), openUrl=url, openLabel="Open in browser", openIcon="external-link", retryKey=`attachment:${id}`, retrying=false, revision=""), dark=true, local=local, testId="image-preview-video-failed")
                  else
                    box width=min(windowWidth * 0.92 - 96, 512) height="12rem" border-radius="0.5rem" background-color="#000000" role="status" aria-label="Loading video"
              else
                if url != "" and not videoFailed
                  image url aria-label=name error=broke max-width=(windowWidth * 0.92 - 6 * rem) max-height=min(windowHeight * 0.86, windowHeight - 160) object-fit="contain" border-radius="0.5rem" testId="image-preview-picture"
                else
                  if failed or videoFailed
                    column role="alert" width=min(windowWidth * 0.92 - 96, 512) height="12rem" padding="1.5rem" box-sizing="border-box" gap="0.75rem" align-items="center" justify-content="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0d)" background-color="#000000" testId="image-preview-unavailable"
                      text "Image unavailable. The file may have been moved or deleted." text-align="center" font-size="0.875rem" line-height="1.25rem" color="#ffffff"
                  else
                    box width=min(windowWidth * 0.92 - 96, 512) height="12rem" border-radius="0.5rem" background-color="#000000" role="status" aria-label="Loading image"
              button id="image-preview-close" press=closePreview aria-label=(video ? "Close video preview" : "Close image preview") testId="image-preview-close" position="absolute" right=0 top="-2.5rem" width="1.5rem" height="1.5rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#ffffff33" background-color="#000000a6" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
                Icon(name="x", size=14, color="#ffffff")
            text (position != "" ? `${name} ${position}` : name) margin-top="0.5rem" line-clamp=1 font-size="0.75rem" line-height="1rem" color="#ffffffcc"
        PreviewStep(label="Next media", shown=next, flip=false, press=local("image-step", "", "next"), elementId="image-preview-next", testId="image-preview-next")
      FocusGuard(guardId="image-preview-guard-end", targets=dialogTargets, popup="image-preview")

component PreviewStep
  props
    label: string
    shown: bool
    flip: bool
    press: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  view
    box width="2.25rem" height="2.25rem" flex-shrink=0
      if shown
        button id=elementId press=press aria-label=label testId=testId width="2.25rem" height="2.25rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
          box width="1.25rem" height="1.25rem" rotate=(flip ? 180 : 0)
            Icon(name="right", size=20, color="#ffffff")

// An unreferenced sent file (MessagesTimeline unchippedFiles): "Preview {name}"
// opens it beside the thread (rightPanelStore.openAttachment), the muted download saves it.
component SentFileRow
  props
    file: MessageFile
    local: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    // A file still sending is no button, its line saying so; a paste reads "Pasted text" over its size.
    if file.sending
      row min-width=0 gap="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" align-items="center" testId=`attachment-file-${file.id}`
        FileTypeIcon(token=file.icon, size=16)
        FileIdentity(file=file, underline=false, line=file.note)
    else
      row min-width=0 gap="0.25rem" align-items="center" testId=`attachment-file-${file.id}`
        button press=local("surface-linked-attachment", file.id, "") hover=hover("preview") aria-label=`Preview ${file.label}` testId=`attachment-preview-${file.id}` flex=1 min-width=0 padding-top="0.25rem" padding-bottom="0.25rem" padding-left=0 padding-right=0 gap="0.5rem" border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          FileTypeIcon(token=file.icon, size=16)
          FileIdentity(file=file, underline=(hovered == "preview"), line=file.note)
          ShellIcon(name="eye", size=16, color="light-dark(#18181b, #f5f5f5)")
        DownloadButton(file=file, local=local)

// A sent file's name and, when given, its second line (12pt, muted, tabular digits).
component FileIdentity
  props
    file: MessageFile
    underline: bool
    line: string
  view
    column flex=1 min-width=0
      text file.label min-width=0 line-clamp=1 text-align="left" font-size="0.875rem" line-height="1.25rem" text-decoration-line=(underline ? "underline" : "none") color="light-dark(#18181b, #f5f5f5)"
      if line != ""
        text line font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" text-align="left" color="light-dark(#71717b, #a1a1a1)"

// The muted download button with its "Download {label}" tooltip; disabled while the file is sending.
component DownloadButton
  props
    file: MessageFile
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box position="relative" flex-shrink=0
      button press=local("surface-linked-att-save", file.id, "") hover=hover disabled=file.sending aria-label=(file.sending ? "Sending attachment" : `Download ${file.label}`) testId=`attachment-download-${file.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.25rem" opacity=(file.sending ? 0.64 : 1) background-color=(hovered and not file.sending ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
        ShellIcon(name="download", size=14, color=(hovered and not file.sending ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"))
      if not file.sending
        TipBubble(label=`Download ${file.label}`, side="top", align="end", offset=28, inset=0, shown=hovered)

// UserFileCard: a file sent without words, as a 16rem card in the message surface: its icon on a 36pt tile, the name
// (underlined on hover) over "EXT · size" (a paste's size alone, "Sending…" while it sends), and Download. The card's
// identity opens it beside the thread.
component SentFileCard
  props
    file: MessageFile
    local: action
    surface: string
    ink: string
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    row width="16rem" max-width="100%" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.5rem" padding-right="0.25rem" box-sizing="border-box" gap="0.25rem" align-items="center" border-radius="1rem" background-color=surface testId=`attachment-card-${file.id}`
      if file.sending
        row flex=1 min-width=0 gap="0.75rem" align-items="center"
          FileCardIdentity(file=file, underline=false, ink=ink)
      else
        button press=local("surface-linked-attachment", file.id, "") hover=hover aria-label=`Preview ${file.label}` testId=`attachment-preview-${file.id}` flex=1 min-width=0 padding=0 gap="0.75rem" border-width=0 border-radius="0.75rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          FileCardIdentity(file=file, underline=hovered, ink=ink)
      DownloadButton(file=file, local=local)

component FileCardIdentity
  props
    file: MessageFile
    underline: bool
    ink: string
  view
    box width="2.25rem" height="2.25rem" flex-shrink=0 border-radius="0.5rem" background-color="light-dark(#fcfcfc99, #00000099)" display="flex" align-items="center" justify-content="center"
      FileTypeIcon(token=file.icon, size=16)
    column flex=1 min-width=0
      text file.label min-width=0 line-clamp=1 text-align="left" font-size="0.875rem" font-weight=500 line-height="1.25rem" text-decoration-line=(underline ? "underline" : "none") color=ink
      text file.detail line-clamp=1 text-align="left" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)"
