// The chat Markdown's chips (markdown.contract), adapted from T3 Code v0.1.5 (MIT; see LICENSE-T3): ContextChip.tsx
// and lib/contextChipAccents.ts. A chip has no pill: its glyph and medium label take its kind's ink, the accent raised to
// 5:1 against the theme (shared/chip-accents.ts), which MarkdownEnv `inks` carries (message-chips.ts markdownEnv; a sent
// message's bubble has its own). Markdown without them takes the default theme's (defaultChipInk; message-chips.test.ts
// keeps it in step). An unresolved chip and a kind with no accent draw in the text's colour (inkIn).
shape ChipInk
  kind: string
  ink: string
fn noChipInks(): ChipInk[] = []
fn inkOf(inks: ChipInk[], kind: string): string = inks.filter((entry) => entry.kind == kind).length > 0 ? inks.filter((entry) => entry.kind == kind).map((entry) => entry.ink).join("") : defaultChipInk(kind)
// A chip's ink in text of colour `text`: a neutral chip (no accent, or unresolved) takes the text's (currentColor).
fn inkIn(inks: ChipInk[], kind: string, text: string): string = kind == "neutral" ? text : inkOf(inks, kind)
fn defaultChipInk(kind: string): string = ["image", "video", "file", "mention", "terminal", "element", "preview-annotation", "review-comment"].includes(kind) ? (kind == "image" ? "light-dark(#006a99, #1296d3)" : kind == "video" ? "light-dark(#a54800, #dd6e28)" : kind == "file" ? "light-dark(#006a99, #1296d3)" : kind == "mention" ? "light-dark(#006d80, #109ab4)" : kind == "terminal" ? "light-dark(#00724e, #06a16f)" : kind == "element" ? "light-dark(#8c5800, #c27f19)" : kind == "preview-annotation" ? "light-dark(#8c5800, #c27f19)" : "light-dark(#6d50ba, #957bea)") : ["pull-request", "pr-open", "pr-draft", "pr-merged", "pr-closed", "skill", "thread", "environment"].includes(kind) ? (kind == "pull-request" ? "light-dark(#5358c0, #7983ef)" : kind == "pr-open" ? "light-dark(#00724e, #06a16f)" : kind == "pr-draft" ? "light-dark(#5d6470, #858e9a)" : kind == "pr-merged" ? "light-dark(#6d50ba, #957bea)" : kind == "pr-closed" ? "light-dark(#b23649, #e46371)" : kind == "skill" ? "light-dark(#92439e, #bf6ecb)" : kind == "thread" ? "light-dark(#006f6b, #069e97)" : "light-dark(#327036, #5c9b5d)") : ["citation", "doc-pdf", "doc-word", "doc-spreadsheet", "doc-slides", "doc-epub", "invalid"].includes(kind) ? (kind == "citation" ? "light-dark(#2361be, #4d8cee)" : kind == "doc-pdf" ? "light-dark(#b33739, #e46561)" : kind == "doc-word" ? "light-dark(#0066ab, #3d92da)" : kind == "doc-spreadsheet" ? "light-dark(#117330, #479e58)" : kind == "doc-slides" ? "light-dark(#9b4f00, #cc7832)" : kind == "doc-epub" ? "light-dark(#6b51bb, #937cea)" : "light-dark(#c10007, #ff6467)") : "light-dark(#18181b, #f5f5f5)"
// Whether a parsed run is a context chip (markdown.rs context_kind), and its accent kind ("neutral" for one the parser
// does not name).
fn contextRun(kind: string): bool = kind.startsWith("context-")
fn runAccent(kind: string): string = kind == "context-other" ? "neutral" : kind.slice(8)
// A resolved chip's accent kind (message-chips.ts ChipView `kind`, a pull request's state in `detail`).
fn chipAccent(kind: string, detail: string): string = kind == "review" ? "review-comment" : kind == "pr" ? (detail != "" ? `pr-${detail}` : "pull-request") : kind == "link" ? "mention" : kind == "unresolved" ? "neutral" : kind
fn chipIcon(kind: string): string = ["context-thread", "context-review-comment", "context-terminal"].includes(kind) ? (kind == "context-thread" ? "messages-square" : kind == "context-review-comment" ? "message-circle" : "square-terminal") : ["context-element", "context-image", "context-video"].includes(kind) ? (kind == "context-element" ? "mouse-pointer-click" : kind == "context-image" ? "image" : "film") : ["context-skill", "context-citation"].includes(kind) ? (kind == "context-skill" ? "skill" : "quote") : "circle-dashed"
// A resolved chip's glyph family (chipIcon's run kinds).
fn chipFamily(kind: string): string = ["citation", "file", "video"].includes(kind) ? (kind == "citation" ? "context-citation" : kind == "file" ? "context-file" : "context-video") : ["image", "skill", "thread"].includes(kind) ? (kind == "image" ? "context-image" : kind == "skill" ? "context-skill" : "context-thread") : ["terminal", "element", "review"].includes(kind) ? (kind == "terminal" ? "context-terminal" : kind == "element" ? "context-element" : "context-review-comment") : "context-other"

// documentChipKindForFileName (pierre-icons.ts): a PDF, Word, spreadsheet, slides or EPUB file's chip takes its type's
// accent kind ("" for any other file). `name` may trail its line (`a.pdf · L3`).
fn docKind(name: string): string = docType(name) == "" ? "" : `doc-${docType(name) == "sheet" ? "spreadsheet" : docType(name)}`
fn docType(name: string): string = docTypeOf(name.split(" · ").slice(0, 1).join("").toLowerCase())
fn docTypeOf(n: string): string = n.endsWith(".pdf") ? "pdf" : n.endsWith(".doc") or n.endsWith(".docx") or n.endsWith(".odt") or n.endsWith(".rtf") ? "word" : n.endsWith(".xls") or n.endsWith(".xlsx") or n.endsWith(".ods") or n.endsWith(".csv") or n.endsWith(".tsv") ? "sheet" : n.endsWith(".ppt") or n.endsWith(".pptx") or n.endsWith(".odp") ? "slides" : n.endsWith(".epub") ? "epub" : ""
