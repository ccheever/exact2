// The inks of the chat Markdown's chips (markdown.contract).
// ContextChip's per-kind accent (oklch(0.62 C H)): a fill of the accent at
// 11%, a border mixing it 34% into the border colour and text mixing it 22%
// into the foreground; "" for runs that are not context chips.
fn chipAccent(kind: string): string = ["context-file", "context-video", "context-thread", "context-review-comment"].includes(kind) ? (kind == "context-file" ? "#0090cd" : kind == "context-video" ? "#d06217" : kind == "context-thread" ? "#009c96" : "#8a70dd") : ["context-terminal", "context-element", "context-image", "context-skill"].includes(kind) ? (kind == "context-terminal" ? "#009f6e" : kind == "context-element" ? "#b87501" : kind == "context-image" ? "#d55665" : "#b261be") : ["context-citation", "context-other"].includes(kind) ? (kind == "context-citation" ? "#4684e5" : "#71717b") : ""
fn chipBorder(kind: string): string = ["context-file", "context-video", "context-thread"].includes(kind) ? (kind == "context-file" ? "light-dark(#a8c8e0, #0090cd61)" : kind == "context-video" ? "light-dark(#e2b9a7, #d0621761)" : "light-dark(#a6cccb, #009c9661)") : ["context-review-comment", "context-terminal", "context-element"].includes(kind) ? (kind == "context-review-comment" ? "light-dark(#c3bde6, #8a70dd61)" : kind == "context-terminal" ? "light-dark(#a9cdbd, #009f6e61)" : "light-dark(#d7bfa6, #b8750161)") : ["context-image", "context-skill", "context-citation"].includes(kind) ? (kind == "context-image" ? "light-dark(#e4b6b9, #d5566561)" : kind == "context-skill" ? "light-dark(#d4b8da, #b261be61)" : "light-dark(#aec5e9, #4684e561)") : "light-dark(#e4e4e7b3, #ffffff14)"
fn chipInk(kind: string): string = ["context-file", "context-video", "context-thread"].includes(kind) ? (kind == "context-file" ? "light-dark(#2b3d4a, #cadfed)" : kind == "context-video" ? "light-dark(#4a352d, #f0d5c8)" : "light-dark(#2a3f40, #c9e2df)") : ["context-review-comment", "context-terminal", "context-element"].includes(kind) ? (kind == "context-review-comment" ? "light-dark(#3b374e, #dcd8f2)" : kind == "context-terminal" ? "light-dark(#2c3f38, #cbe2d6)" : "light-dark(#44382c, #e9d9c7)") : ["context-image", "context-skill", "context-citation"].includes(kind) ? (kind == "context-image" ? "light-dark(#4b3337, #f2d3d4)" : kind == "context-skill" ? "light-dark(#433448, #e7d5ea)" : "light-dark(#2f3b4f, #ceddf4)") : "light-dark(#18181b, #f5f5f5)"
fn chipIcon(kind: string): string = ["context-thread", "context-review-comment", "context-terminal"].includes(kind) ? (kind == "context-thread" ? "messages-square" : kind == "context-review-comment" ? "message-circle" : "square-terminal") : ["context-element", "context-image", "context-video"].includes(kind) ? (kind == "context-element" ? "mouse-pointer-click" : kind == "context-image" ? "image" : "film") : ["context-skill", "context-citation"].includes(kind) ? (kind == "context-skill" ? "skill" : "quote") : "circle-dashed"
// A resolved chip's accent family (ContextChip `kind`).
fn chipFamily(kind: string): string = ["citation", "file", "video"].includes(kind) ? (kind == "citation" ? "context-citation" : kind == "file" ? "context-file" : "context-video") : ["image", "skill", "thread"].includes(kind) ? (kind == "image" ? "context-image" : kind == "skill" ? "context-skill" : "context-thread") : ["terminal", "element", "review"].includes(kind) ? (kind == "terminal" ? "context-terminal" : kind == "element" ? "context-element" : "context-review-comment") : "context-other"

// A pull request chip's ink by its state: part 0 the text, 1 the fill, 2 hovered, 3 the border.
fn prChipColour(state: string, part: number): string = part == 0 ? prChipInk(state) : part == 3 ? prChipBorder(state) : `${prChipAccent(state)}${part == 2 ? "2b" : "1c"}`
fn prChipInk(state: string): string = state == "open" ? "light-dark(#2c3f39, #cbe2d6)" : state == "draft" ? "light-dark(#393a3f, #dadcdf)" : state == "merged" ? "light-dark(#3a374e, #dcd8f2)" : state == "closed" ? "light-dark(#4b3337, #f2d3d4)" : "light-dark(#35394f, #d5daf4)"
fn prChipAccent(state: string): string = state == "open" ? "#009f6e" : state == "draft" ? "#7f8793" : state == "merged" ? "#8a70dd" : state == "closed" ? "#d55665" : "#7079e4"
fn prChipBorder(state: string): string = state == "open" ? "light-dark(#a9cdbd, #3ba97d61)" : state == "draft" ? "light-dark(#c1c3ca, #8c939d61)" : state == "merged" ? "light-dark(#c3bde6, #9580e261)" : state == "closed" ? "light-dark(#e4b6b9, #db697461)" : "light-dark(#bac1e9, #7d88e861)"

// documentIconColorForFileName (pierre-icons.ts, T3 Code 7c3b3b3605ef): a PDF, Word, spreadsheet, slides or EPUB
// file's chip takes its type's accent, mixed as ContextChip mixes any accent (the light ink into #27272a): its ink,
// border and fill (`hover` the hovered one). `name` may trail its line (`a.pdf · L3`).
fn docType(name: string): string = docTypeOf(name.split(" · ").slice(0, 1).join("").toLowerCase())
fn docTypeOf(n: string): string = n.endsWith(".pdf") ? "pdf" : n.endsWith(".doc") or n.endsWith(".docx") or n.endsWith(".odt") or n.endsWith(".rtf") ? "word" : n.endsWith(".xls") or n.endsWith(".xlsx") or n.endsWith(".ods") or n.endsWith(".csv") or n.endsWith(".tsv") ? "sheet" : n.endsWith(".ppt") or n.endsWith(".pptx") or n.endsWith(".odp") ? "slides" : n.endsWith(".epub") ? "epub" : ""
fn docInk(kind: string): string = kind == "pdf" ? "light-dark(#4c2e2f, #fcd8d4)" : kind == "word" ? "light-dark(#2b3b4c, #d7e7f9)" : kind == "sheet" ? "light-dark(#2d4032, #d7edd8)" : kind == "slides" ? "light-dark(#4a382f, #f9e4d5)" : "light-dark(#332f4c, #e0d8f9)"
fn docBorder(kind: string): string = kind == "pdf" ? "light-dark(#e7adaa, #ff676261)" : kind == "word" ? "light-dark(#a8c5e3, #69b1ff61)" : kind == "sheet" ? "light-dark(#aaceb0, #5ecc7161)" : kind == "slides" ? "light-dark(#e2c0ab, #ffa35961)" : "light-dark(#b5aee3, #9d6afb61)"
fn docFill(kind: string, hover: bool): string = `light-dark(${docAccent(kind, false)}${hover ? "2b" : "1c"}, ${docAccent(kind, true)}${hover ? "2b" : "1c"})`
fn docAccent(kind: string, dark: bool): string = kind == "pdf" ? (dark ? "#ff6762" : "#d52c36") : kind == "word" ? (dark ? "#69b1ff" : "#1a85d4") : kind == "sheet" ? (dark ? "#5ecc71" : "#199f43") : kind == "slides" ? (dark ? "#ffa359" : "#d47628") : (dark ? "#9d6afb" : "#693acf")
