// A skill in a sent message or an answer (T3 Code 7c3b3b3605ef, MIT; see LICENSE-T3): SkillInlineText's
// SkillChipPopover, the composer's ContextChipPopover (composer-chip-popover.contract). The chip, named "Skill
// <label>. Show details", opens a popover above it (side top, width lg, padding compact) with the label
// (font-medium), the skill's description or "No description is available for this skill.", and an outline small
// "View instructions" for a skill with a path, which opens that file in the right panel.
use TimelineIcon from "./timeline-icons-kit.contract"

component SkillChip
  props
    label: string
    description: string
    // The skill's instructions file, "" when it has none.
    path: string
    // The chip's id among the document's runs (the trigger's test id and the popover's).
    id: string
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  derive popupId = `skill-chip-${id}`
  view
    button popovertarget=popupId hover=hover aria-label=`Skill ${label}. Show details` testId=`context-chip-${id}` height="1.0625rem" max-width="15rem" padding=0 padding-left="0.375rem" padding-right="0.375rem" gap="0.25rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#d4b8da, #b261be61)" background-color=(hovered ? "#b261be2b" : "#b261be1c") title=""
      TimelineIcon(name="skill", size=14, color="light-dark(#433448, #e7d5ea)")
      text label min-width=0 line-clamp=1 font-size="0.75rem" font-weight=500 line-height="0.9375rem" white-space="pre" color="light-dark(#433448, #e7d5ea)"
    column id=popupId popover="auto" position-try-fallbacks="flip-block" position="absolute" position-area="top" margin-bottom="0.25rem" width="24rem" max-width="calc(100vw - 32px)" testId="skill-chip-popover"
      column padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=`Skill ${label}`
        column padding="0.5rem" gap="0.75rem" align-items="flex-start" color="light-dark(#18181b, #f5f5f5)"
          text label font-size="0.875rem" line-height="1.25rem" font-weight=500
          text (description != "" ? description : "No description is available for this skill.") font-size="0.875rem" line-height="1.25rem" overflow-wrap="anywhere"
          if path != ""
            button press=local("surface-file", path, "") popovertarget=popupId popovertargetaction="hide" testId="skill-chip-instructions" display="flex" flex-direction="row" align-items="center" justify-content="center" box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0 title=""
              text "View instructions" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap"
