// SecretRequestCard.tsx at T3 Code 9c161462c9 (MIT, LICENSE-T3).
use TimelineIcon from "./timeline-icons-kit.contract"
shape SecretCardView
  id: string
  key: string
  label: string
  reason: string
  placeholder: string
  kind: string
  outcome: string
  icon: string
  disabled: bool
  pending: bool
  submitted: bool
  error: string
component SecretRequestCard
  props
    card: SecretCardView
    command: action
  state secret = ""
  action edit(value: string)
    secret = value
  action save
    if not card.disabled and secret.trim() != ""
      command("secretlocal:save", card.key, secret, 0)
  action decline
    if not card.disabled
      command("secretlocal:decline", card.key, "", 0)
  view
    if card.kind == "pending"
      column width="100%" min-width=0 gap="0.75rem" padding="1rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)" background-color="light-dark(#ffffff, #141414)" testId=`secret-request-${card.id}`
        column width="100%" gap="0.25rem"
          text card.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          if card.reason.trim() != ""
            text card.reason font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        row width="100%" align-items="center" gap="0.5rem"
          input id=`secret-value-${card.id}` testId=`secret-value-${card.id}` value=secret input=edit submit=save type="password" autocomplete="off" autocorrect="off" spellcheck="false" aria-label=card.label aria-describedby=(card.error != "" ? `secret-privacy-${card.id} secret-error-${card.id}` : `secret-privacy-${card.id}`) aria-invalid=(card.error != "") placeholder=card.placeholder disabled=card.disabled flex=1 min-width=0 height="2rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(card.error != "" ? "light-dark(#e7000b5c, #fb414a5c)" : "light-dark(#e4e4e7, #ffffff1a)") background-color="light-dark(#ffffff, #171717)" color="light-dark(#27272a, #f5f5f5)"
          button press=save disabled=(card.disabled or secret.trim() == "") testId=`secret-save-${card.id}` height="2rem" padding-left="0.75rem" padding-right="0.75rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#18181b, #f5f5f5)" color="light-dark(#ffffff, #171717)" opacity=(card.disabled or secret.trim() == "" ? 0.5 : 1)
            text "Save securely" font-size="0.875rem" font-weight=500
        if card.error != ""
          text card.error id=`secret-error-${card.id}` role="alert" font-size="0.75rem" line-height="1rem" color="light-dark(#e7000b, #fb414a)" testId=`secret-error-${card.id}`
        row width="100%" align-items="center" justify-content="space-between" gap="0.5rem"
          row flex=1 min-width=0 align-items="center" gap="0.375rem" id=`secret-privacy-${card.id}`
            TimelineIcon(name="shield-check", size=14, color="light-dark(#71717b, #818181)")
            text "Stored securely, never shown to the agent" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          button press=decline disabled=card.disabled testId=`secret-decline-${card.id}` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-width=0 border-radius="0.5rem" background-color="#00000000" color="light-dark(#71717b, #818181)"
            text "Decline" font-size="0.75rem" line-height="1rem"
    else
      row width="100%" min-height="1.5rem" align-items="center" gap="0.375rem" testId=`secret-outcome-${card.id}`
        row width="1.5rem" height="1.5rem" align-items="center" justify-content="center"
          TimelineIcon(name=card.icon, size=14, color="light-dark(#71717b, #818181)")
        text `${card.label} · ${card.outcome}` font-size="0.875rem" line-height="1.421875rem" color="light-dark(#71717b, #818181)"
