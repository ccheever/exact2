// The chat's link menus as context popovers (LLP 1021 §5.1): a reply's web link (ChatMarkdown's anchor
// onContextMenu, external-link-menu.ts) and a file link (ChatMarkdown's MarkdownFileLink menu,
// file-link-menu.ts). The node's `contextmenu` records which link it is, then the host presents the popover's
// rows: on macOS an NSMenu at the pointer, or at the focused link for the ContextMenu key; the web and the
// agent paint it at the link. The rows come from the data module (no row of these menus is destructive),
// and a row's press names its id to `pick`.

// One row of a link's menu.
shape LinkMenuRow
  id: string
  label: string
// A pull request link's rows over the open thread: "Link to thread" or "Unlink from thread" first.
shape PullLinkMenu
  href: string
  rows: LinkMenuRow[]
// A web link's rows (external-link-menu.ts chatLinkMenuView): over the open thread, on a page over it (the pull
// request page, which has no thread), and for each pull request link the open thread can link or links.
shape ChatLinkMenu
  thread: LinkMenuRow[]
  page: LinkMenuRow[]
  pulls: PullLinkMenu[]

// The sidebar's menu card and rows (sidebar-row.contract SidebarMenuCard, SidebarMenuItem), which this file cannot
// `use` (the sidebar reaches the Markdown that uses this file).
style LinkMenuCard
  min-width="12rem" max-width="24rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1
  border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040"
style LinkMenuItem
  width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box"
  gap="0.5rem" border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"

component LinkMenuPopover
  props
    menuId: string
    rows: LinkMenuRow[]
    pick: action
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id=menuId popover="auto" position-try-fallbacks="none" role="menu" class=LinkMenuCard testId=menuId
        for row in rows key=row.id
          button press=pick(row.id) popovertarget=menuId popovertargetaction="hide" role="menuitem" testId=`${menuId}-${row.id}` class=LinkMenuItem
            text row.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"

// A file link's menu that its press opens where it was clicked (LLP 1021 D2), as MarkdownFileLink with no primary action
// shows it at the click's clientX, clientY: `left` and `top` are that point, `auto` after a key's press, which hangs
// the menu from the link (the reference's bounds.left, bounds.bottom).
component LinkMenuPopoverAt
  props
    menuId: string
    rows: LinkMenuRow[]
    pick: action
    left: string
    top: string
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id=menuId popover="auto" role="menu" class=LinkMenuCard margin=0 left=left top=top testId=menuId
        for row in rows key=row.id
          button press=pick(row.id) popovertarget=menuId popovertargetaction="hide" role="menuitem" testId=`${menuId}-${row.id}` class=LinkMenuItem
            text row.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"

// A file link chip's button (markdown.contract InlineFileChip, ResolvedChip): its press opens the file
// (`surface-file-link`), its right-click, Control-click or ContextMenu key the file link's menu with the chip's own
// rows (`menu`), which the window's `fileLinkMenu` holds for the `fileLinkPopover` popover. Where a file link has no
// press of its own (MarkdownFileLink with no primary action: the pull request page, which has no Files panel), its
// press opens the menu instead, at the click: `<fileLinkPopover>-press`, a LinkMenuPopoverAt, whose point the press
// hands its owner as `file-link-at` (`fileLinkPressMenu`).
component FileLinkButton
  inject
    fileLinkMenu: action
    fileLinkPopover: string
    fileLinkPressMenu: bool
  props
    tip: string
    target: string
    menu: LinkMenuRow[]
    local: action
    testId: string
  slot
  action press(e: MouseEvent)
    fileLinkMenu(tip, target, menu)
    if fileLinkPressMenu
      local("file-link-at", `${e.clientX}`, `${e.clientY}`)
    else
      local("surface-file-link", tip, target)
  view
    button press=press contextmenu=fileLinkMenu(tip, target, menu) contextPopover=fileLinkPopover popovertarget=(fileLinkPressMenu ? `${fileLinkPopover}-press` : "") aria-label=tip padding=0 border-width=0 background-color="#00000000" testId=testId title=""
      children
