// The background highlighter turn's reply (shiki-highlight.ts highlightSlice).
// A long code text paints with the heuristic colours first; the root's highlightPump task runs
// highlightSlice turns of at most 50 ms while data or shell reports highlightPending, and refreshes
// each whose answer is not in flight when a text's Shiki tokens are done (app.contract highlightStepped).
shape HighlightStep
  finished: bool
  pending: bool
