// The highlighter's pump (app.contract highlightStep): the texts waiting for their tokens (highlights.ts
// highlightAsk), the lexers' line records for them (data/src/highlights.rs highlightCode), and whether storing those
// gave a text its tokens (highlightStore).
shape HighlightRequest
  id: number
  // The lexer (highlights-tables.ts LEXER_IDS).
  language: number
  text: string
shape HighlightAsk
  requests: HighlightRequest[]
  pending: bool
shape HighlightRecords
  id: number
  records: number[]
shape HighlightCoded
  results: HighlightRecords[]
shape HighlightStored
  finished: bool
  pending: bool
