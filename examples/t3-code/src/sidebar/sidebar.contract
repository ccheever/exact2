// T3's thread sidebar (Sidebar.tsx, SidebarChrome.tsx, SidebarThreadHeader.tsx;
// MIT, see LICENSE-T3), measured against the built reference: 52pt stage
// header with the window controls inset to 90pt, the search group with the
// project filter, add-project and new-thread buttons, cards for live threads
// and slim rows for the snoozed and settled shelves at the bottom. Rows arrive
// in paint order (sidebar-view.ts); every gesture is a sidebar op.
use Snapshot from "../shared/shapes.contract"
use Thread from "./sidebar-shapes.contract"
use NightlyBackdrop from "./nightly.contract"
use Icon from "../shared/icons.contract"
use Wordmark from "../shared/icons.contract"
use LookWordmark from "../appearance/settings-appearance-look.contract"
use LookPill from "../appearance/settings-appearance-look.contract"
use SidebarProviderMark from "../shared/icons-kit.contract"
use PgIcon from "../shared/pages-icons.contract"
use SidebarIcon from "./sidebar-icons.contract"
use SidebarUpdatePill from "./sidebar-icons-kit.contract"
use UpdateEverything from "./update-everything.contract"
use SidebarProjectGlyph from "./sidebar-icons-kit.contract"
use ThreadRow from "./sidebar-row.contract"
use SearchResult from "./sidebar-row.contract"
use DraftCard from "./sidebar-row.contract"
use ThreadMenu from "./sidebar-row.contract"
use DraftMenu from "./sidebar-row.contract"
use ShellView from "../shell/shell-shapes.contract"
use SidebarTip from "./sidebar-row.contract"
use ProviderPill from "./sidebar-control-tips.contract"
use FooterUndoNotice from "./undo-notice.contract"

component Sidebar
  props
    reduced: bool
    data: Snapshot
    // The root's live clock (epoch ms), so a Working row's label ticks each second.
    now: number
    width: number
    busy: bool
    keySidebar: string
    keyNewThread: string
    toggle: action
    search: action
    openProjects: action
    addProject: action
    newThread: action
    select: action
    openSettings: action
    openConnection: action
    reconnect: action
    resize: action
    finishResize: action
    command: action
    page: string
    pullRequests: bool
    navigate: action
    local: action
    run: action
    open: action
    resetWidth: action
    hoverCard: action
    pressDown: action
    drag: action
    dragEnd: action
    dragId: string
    focusWithin: action // the window's toggle hands the focus on when it collapses this sidebar
    dragTarget: string
    dragVerb: string
    dragOffset: number
    hoverId: string
    // The window's hover count (ThreadSection's resting hover).
    hoverSeq: number
    openProviders: action
    shell: ShellView
    scrolled: action
    // The list's scroll offset, which a row-action sweep clamps the pointer to.
    scrollY: number
  // The thread list is a tree (lib/sidebarTree.ts): one Tab stop, the focused row's, which ArrowUp and ArrowDown, Home
  // and End move; ArrowRight opens a closed shelf or enters an open one, ArrowLeft closes an open shelf or goes to a
  // row's shelf. The rows' own handlers keep Enter, Space and the context menu. Before a row takes the focus the open
  // one holds the stop; a focused row that leaves the list hands it to the row now at its place.
  state treeFocus = ""
  state treeIndex = 0
  derive treeIds = data.sidebar.tree.map((r) => r.id)
  derive treeAt = min(treeIndex, max(0, treeIds.length - 1))
  derive treeStop = treeIds.includes(treeFocus) ? treeFocus : (treeFocus == "" and data.sidebar.treeCurrent != "" ? data.sidebar.treeCurrent : treeIds.slice(treeAt, treeAt + 1).join(""))
  action treeFocused(id: string)
    treeFocus = id
    treeIndex = max(0, treeIds.indexOf(id))
  action treeKey(id: string, k: string, e: KeyboardEvent)
    let index = treeIds.indexOf(id)
    // SidebarThreadRow's handleKeyDown: F2 renames the focused thread in place, as a double click does.
    if k == "F2" and id.startsWith("thread-") and not e.isComposing and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      local("rename-start", id.slice(7), "")
    else if index >= 0 and not e.isComposing and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and ["ArrowDown", "ArrowUp", "Home", "End", "ArrowRight", "ArrowLeft"].includes(k)
      preventDefault()
      stopPropagation()
      let expanded = data.sidebar.tree.filter((r) => r.id == id).map((r) => r.expanded).join("")
      let parent = data.sidebar.tree.filter((r) => r.id == id).map((r) => r.parent).join("")
      let child = data.sidebar.tree.filter((r) => r.parent == id).map((r) => r.id).slice(0, 1).join("")
      let target = k == "ArrowDown" ? treeIds.slice(min(index + 1, treeIds.length - 1), min(index + 1, treeIds.length - 1) + 1).join("") : (k == "ArrowUp" ? treeIds.slice(max(index - 1, 0), max(index - 1, 0) + 1).join("") : (k == "Home" ? treeIds.slice(0, 1).join("") : (k == "End" ? treeIds.slice(-1).join("") : (k == "ArrowRight" ? (expanded == "false" ? "" : child) : (expanded == "true" ? "" : parent)))))
      if (k == "ArrowRight" and expanded == "false") or (k == "ArrowLeft" and expanded == "true")
        local("shelf", id.slice(6), "")
      if target != ""
        // Revealing before focusing; the focus itself does not scroll (a settled row moves to the bottom shelf).
        scrollIntoView(target, block="nearest", behavior="instant")
        treeFocus = target
        treeIndex = max(0, treeIds.indexOf(target))
        focus(target)
  provide
    sidebarTreeStop = treeStop
    treeFocused
    treeKey
  // The row a right-click named, for its context popover (ThreadMenu, DraftMenu): the row's `contextmenu` runs first.
  // `target` is what the press landed on: the row, or a focusable control in it (Unpin, Snooze, Discard draft), which
  // answers the press itself and opens the same popover, as Chromium focuses the control and its event reaches the row.
  state menuThread = ""
  // SidebarThreadHeader's search field: focus-within takes the row hover surface and a ring/70 inset ring.
  state searchFocused = false
  action searchFocus(on: bool)
    searchFocused = on
  state menuDraft = ""
  // Sidebar's thread search ignores a key that confirms an input method's candidate.
  action searchKey(k: string, e: KeyboardEvent)
    if not e.isComposing
      local("search-key", "", k)
  action threadMenu(id: string, target: string)
    menuThread = id
    // Chromium focuses the reference's row on a right press (Sidebar.tsx:1759-1760, 1924-1925). Writing it is the
    // author's choice, and LLP 1115.000 D7 keeps a focus an action set over D7.1's default.
    focus(target)
  // The open row scrolls into view (block nearest) on each route change and once for each mount of the sidebar
  // (useActiveRowReveal): a marker mounts once the row is listed, and its first layout scrolls, as the row's own ref does.
  state mountRevealed = false
  derive revealTarget = data.sidebar.revealPending != "" ? data.sidebar.revealPending : (mountRevealed ? "" : data.sidebar.revealRow)
  action revealDue(id: string, w: number, h: number)
    scrollIntoView(`row-${id}`, block="nearest", behavior="instant")
    mountRevealed = true
    local("reveal-done", id, "")
  action draftMenu(id: string, target: string)
    menuDraft = id
    // Chromium focuses the reference's draft row on a right press (Sidebar.tsx:872-873). Writing it is the
    // author's choice, and LLP 1115.000 D7 keeps a focus an action set over D7.1's default.
    focus(target)
  view
    column width=width height="100%" flex-shrink=0 box-sizing="border-box" background-color=(data.look.themed ? data.look.sidebar : "light-dark(#f9f9f9, #030303)") border-right-style="solid" border-right-width=1 border-color=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #141414)") position="relative" testId="sidebar" id="sidebar" focusin=focusWithin(true) focusout=focusWithin(false) data-paint=`${(data.look.themed ? "sidebar" : "")} ${(data.look.themed ? "border" : "")}` data-pick=((data.look.themed ? "sidebar" : "") != "" ? (data.look.themed ? "sidebar" : "") : ((data.look.themed ? "border" : "") != "" ? (data.look.themed ? "border" : "") : ""))
      ThreadMenu(threads=data.threads, owner=menuThread, run=run)
      DraftMenu(drafts=data.sidebar.drafts, owner=menuDraft, run=run)
      if revealTarget != ""
        for target in [revealTarget] key=target
          box position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" aria-hidden=true resize=revealDue(target) testId="sidebar-reveal"
      // Environment identification (Appearance): the stage artwork, a version pill, or neither.
      if data.look.artwork
        NightlyBackdrop()
      row height=52 flex-shrink=0 padding-left=(data.controlsLeft + 1) padding-right="0.5rem" gap="0.6875rem" align-items="center" position="relative"
        // The window's SidebarToggle (sidebar-toggle.contract) stands over this place.
        box width="1.75rem" height="1.75rem" flex-shrink=0
        button cursor="pointer" press=run("home", "", "") height="1.75rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" aria-label="Go to threads" testId="sidebar-brand"
          if data.look.artwork
            Wordmark()
            text "Code" font-size="0.875rem" font-weight=500 letter-spacing=-0.35 color="#ffffffb3"
          else
            LookWordmark(ink=(data.look.themed ? data.look.sidebarText : "light-dark(#18181b, #f1f3f7)"), muted=(data.look.themed ? data.look.sidebarMuted : "light-dark(#71717b, #a3a3a3)"))
        // Upstream 9efb016900: the pill sits on the brand's line only while it fits inside the
        // header's 12pt right padding and the 1pt border (it wraps onto the clipped second line
        // otherwise): brand at 130 + 53.77, 12pt, the 43.27pt pill (the brand at controlsLeft + 40: 52 in full screen).
        if data.look.pill != "" and width - 13 >= data.controlsLeft + 149.04
          LookPill(label=data.look.pill)
      row width="100%" padding="0.5rem" box-sizing="border-box" gap="0.25rem" flex-shrink=0 align-items="center" position="relative"
        row flex=1 min-width=0 height="2rem" padding-left="0.5rem" padding-right=(data.query == "" ? "0.5rem" : "0.25rem") box-sizing="border-box" border-radius="0.375rem" align-items="center" gap="0.5rem" position="relative" background-color=(data.query == "" and not searchFocused ? "#00000000" : "light-dark(#fcfcfc, #f1f3f714)") box-shadow=(searchFocused ? "inset 0 0 0 1px light-dark(#1b4ed8b3, #346bf1b3)" : "none")
          Icon(name="search", size=16, color="light-dark(#86868e, #8b8b8b)")
          if data.query == ""
            text "Search" position="absolute" left="2rem" top="0.375rem" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#71717b, #a3a3a3)" pointer-events="none"
          input value=data.query input=search key=searchKey submit=open(data.sidebar.searchSelectedId, "search") placeholder="" focus=searchFocus(true) blur=searchFocus(false) aria-label="Search threads" testId="search-threads" font-size="0.875rem" font-weight=500 flex=1 min-width=0 height="1.3125rem" padding=0 border-width=0 background-color="#00000000" color="light-dark(#18181b, #f3f3f3)" autocorrect="off" id="search-threads" data-editable="yes"
          if data.query != ""
            button cursor="pointer" press=search("") aria-label="Clear thread search" testId="clear-thread-search" width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              Icon(name="x", size=14, color="light-dark(#71717b, #a3a3a3)")
        row flex-shrink=0 align-items="center"
          // Filter and Add project show only with a project group (SidebarThreadHeader `hasProjects`).
          if data.sidebar.projectGroupCount > 0
            SidebarTip(tip="sidebar-filter", hoverCard=hoverCard)
              button cursor="pointer" press=local("scope-open", "", "") width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(data.sidebar.scopeOpen ? "light-dark(#f4f4f5, #ffffff0a)" : hoverId == "sidebar-filter" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label=(data.sidebar.scopeKey == "" ? "Filter threads by project" : `Filter threads by project: ${data.sidebar.scopeLabel}`) aria-expanded=data.sidebar.scopeOpen testId="filter-project" title=""
                if data.sidebar.scopeKey == ""
                  SidebarIcon(name="list-filter", size=16, color=(data.sidebar.scopeOpen or hoverId == "sidebar-filter" ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
                else if data.sidebar.scopeCount > 1
                  // Several projects: the first two glyphs overlap (-space-x-1.5).
                  row flex-shrink=0
                    SidebarProjectGlyph(g=data.sidebar.scopeGlyph, size=14, dim=false)
                    box margin-left="-0.375rem"
                      SidebarProjectGlyph(g=data.sidebar.scopeGlyphSecond, size=14, dim=false)
                else
                  SidebarProjectGlyph(g=data.sidebar.scopeGlyph, size=16, dim=false)
            SidebarTip(tip="sidebar-add-project", hoverCard=hoverCard)
              button cursor="pointer" press=addProject width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-add-project" and data.connected ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Add project" testId="add-project" disabled=(not data.connected) title=""
                Icon(name="folder-plus", size=16, color=(hoverId == "sidebar-add-project" and data.connected ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
          // These controls hover the root sidebar hover id; SidebarOverlays draws their tooltips (sidebar-control-tips.contract).
          SidebarTip(tip="sidebar-new-thread", hoverCard=hoverCard)
            button cursor="pointer" press=newThread width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-new-thread" and data.connected ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="New thread" testId="new-thread" disabled=(busy or not data.connected or not data.sidebar.hasProjects) title=""
              Icon(name="compose", size=16, color=(hoverId == "sidebar-new-thread" and data.connected ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
      scroll id="thread-list" flex=1 min-height=0 padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" scroll=scrolled testId="thread-list"
        if not data.sidebar.searching
          column min-height="100%" width="100%" gap=1 role="tree" aria-label="Threads"
            for d in data.sidebar.drafts key=d.id
              DraftCard(d=d, run=run, menu=draftMenu, hoverCard=hoverCard, hoverId=hoverId)
            if data.sidebar.drafts.length > 0
              box height=1 flex-shrink=0 margin-left="0.625rem" margin-right="0.625rem" margin-top="0.375rem" margin-bottom="0.375rem" background-color="light-dark(#e4e4e799, #ffffff0c)" testId="sidebar-draft-divider"
            box id="sidebar-list-top" width="100%" height=(dragId != "" ? "1.5rem" : "0px") margin-bottom=-1 position="relative" testId="sidebar-pinned-header"
              if dragId != ""
                SidebarDragLabel(label="Pinned", target=(dragTarget == "pinned"))
            ThreadSection(reduced=reduced, threads=data.threads, data=data, now=now, section="pinned", label="", busy=busy, local=local, run=run, menu=threadMenu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=hoverId, hoverSeq=hoverSeq, drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=dragOffset, dragTarget=dragTarget, page=page, scrollY=scrollY)
            box id="sidebar-pinned-divider" width="100%" height=(dragId != "" ? "1.5rem" : "0px") margin-bottom=-1 position="relative" testId="sidebar-pinned-divider"
              if dragId != ""
                SidebarDragLabel(label="Active", target=(dragTarget == "active"))
            ThreadSection(reduced=reduced, threads=data.threads, data=data, now=now, section="active", label="", busy=busy, local=local, run=run, menu=threadMenu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=hoverId, hoverSeq=hoverSeq, drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=dragOffset, dragTarget=dragTarget, page=page, scrollY=scrollY)
            if data.sidebar.emptyText != ""
              column align-items="center" gap="0.5rem" margin-top="-0.125rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="1.5rem" padding-bottom="1.5rem" box-sizing="border-box" testId="sidebar-empty"
                text data.sidebar.emptyText font-size="0.75rem" line-height="1rem" text-align="center" color="light-dark(#71717b99, #a3a3a399)"
                if data.sidebar.emptyAddProject
                  button cursor="pointer" press=addProject height="1.375rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="#00000000" display="flex" flex-direction="row" align-items="center" testId="sidebar-empty-add-project"
                    SidebarIcon(name="plus", size=12, color="light-dark(#71717b, #a3a3a3)")
                    text "Add project" font-size="0.6875rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #a3a3a3)"
            else
              // The first shelf header's mt-auto: no space of its own once the list overflows.
              box flex=1
              if data.sidebar.workingCount > 0
                ThreadSection(reduced=reduced, threads=data.threads, data=data, now=now, section="working", label="Working", busy=busy, local=local, run=run, menu=threadMenu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=hoverId, hoverSeq=hoverSeq, drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=dragOffset, dragTarget=dragTarget, page=page, scrollY=scrollY)
              if data.sidebar.snoozedCount > 0
                ThreadSection(reduced=reduced, threads=data.threads, data=data, now=now, section="snoozed", label="Snoozed", busy=busy, local=local, run=run, menu=threadMenu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=hoverId, hoverSeq=hoverSeq, drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=dragOffset, dragTarget=dragTarget, page=page, scrollY=scrollY)
              ThreadSection(reduced=reduced, threads=data.threads, data=data, now=now, section="settled", label="Settled", busy=busy, local=local, run=run, menu=threadMenu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=hoverId, hoverSeq=hoverSeq, drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=dragOffset, dragTarget=dragTarget, page=page, scrollY=scrollY)
              if data.sidebar.showMore > 0
                button cursor="pointer" id="settled-more" press=local("more", "", "") role="treeitem" aria-level=2 tabindex=(treeStop == "settled-more" ? 0 : -1) focus=treeFocused("settled-more") key=treeKey("settled-more") width="100%" height="2.25rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" testId="sidebar-show-more"
                  :focus-visible
                    box-shadow="inset 0 0 0 2px light-dark(#1b4ed8, #346bf1)"
                  // Plus means "add", so revealing more uses a chevron.
                  SidebarIcon(name="chevron-down", size=16, color="light-dark(#71717b, #a3a3a3)")
                  text `Show ${data.sidebar.showMore} more` font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a3a3a3)"
        else
          column width="100%" gap=1 role="listbox" aria-label="Thread search results" testId="thread-search-results"
            for t in data.threads key=t.id
              SearchResult(t=t, open=open, hoverCard=hoverCard, hoverId=hoverId)
            if data.threads.length == 0
              text (data.sidebar.searchPending ? "Searching thread messages…" : "No threads found") role="status" font-size="0.75rem" line-height="1rem" text-align="center" padding-top="1.5rem" padding-bottom="1.5rem" padding-left="0.5rem" padding-right="0.5rem" color="light-dark(#71717b, #a3a3a3)"
      // SidebarProviderUpdatePill (sidebar-control-tips.contract: with its two tooltips).
      // One pill a view, so a changed view leaves as the reference's does; a timed one leaves when its time is up.
      if data.sidebar.pillKey != "" and (data.sidebar.pillUntil == 0 or now < data.sidebar.pillUntil)
        for pillKey in [data.sidebar.pillKey] key=pillKey
          ProviderPill(tone=data.sidebar.pillTone, title=data.sidebar.pillTitle, description=data.sidebar.pillDescription, dismissible=data.sidebar.pillDismissible, countdown=(data.sidebar.pillUntil > 0), open=openProviders(""), dismiss=local("pill-dismiss", "", pillKey))
      // SidebarUtilityMenu: Settings, Pull requests and Usage; the Pull requests page shows Back instead
      // (isSidebarUtilityPage), while Usage opens as a modal over the view and keeps the menu;
      // then SidebarUpdatePill at the end (ml-auto).
      row height="2.5rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" align-items="center" gap="0.25rem" flex-shrink=0 role="list"
        if page != "pull-requests"
          SidebarTip(tip="sidebar-settings", hoverCard=hoverCard)
            button cursor="pointer" press=openSettings testId="connection-settings" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-settings" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Settings" title=""
              Icon(name="settings", size=16, color=(hoverId == "sidebar-settings" ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
          if pullRequests
            SidebarTip(tip="sidebar-pull-requests", hoverCard=hoverCard)
              button cursor="pointer" press=navigate("pull-requests") testId="open-pull-requests" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-pull-requests" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Pull requests" title=""
                Icon(name="pull-requests", size=16, color=(hoverId == "sidebar-pull-requests" ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
          SidebarTip(tip="sidebar-usage", hoverCard=hoverCard)
            button cursor="pointer" press=navigate("usage") testId="open-usage" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-usage" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Usage" title=""
              Icon(name="usage", size=16, color=(hoverId == "sidebar-usage" ? "light-dark(#18181b, #f3f3f3)" : "light-dark(#86868e, #8b8b8b)"))
        else
          button cursor="pointer" press=navigate("") testId="sidebar-back" flex=1 min-width=0 height="2rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" aria-label="Back"
            PgIcon(name="arrow-left", size=16, color="light-dark(#86868e, #8b8b8b)")
            text "Back" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#70707acc, #a2a2a2cc)"
        // SidebarThreadUndoNotice fills the row's free space, before the update pill.
        if data.sidebar.undoShort != "" and now < data.sidebar.undoUntil
          FooterUndoNotice(text=data.sidebar.undoShort, label=data.sidebar.undoLabel, muted=(data.look.themed ? data.look.sidebarMuted : "light-dark(#71717b, #a3a3a3)"), ink=(data.look.themed ? data.look.sidebarText : "light-dark(#18181b, #f1f3f7)"), run=run)
        if data.updateEverything.running or data.updateEverything.available
          UpdateEverything(v=data.updateEverything, run=run)
        else
          row margin-left="auto" flex-shrink=0
            SidebarTip(tip="sidebar-update", hoverCard=hoverCard)
              SidebarUpdatePill(color="light-dark(#86868e, #8b8b8b)", testId="sidebar-check-updates")
      // The resize rail is SidebarOverlays' (sidebar-rail.contract): a strip reaching past the sidebar is not hit-testable here.

// The hover a section's rows see: none while a row-action sweep is live (the
// reference's list takes `**:pointer-events-none`), a cancelled sweep's resting row until the window's hover count moves
// on, else the window's.
fn sweepRowHover(live: bool, rest: string, restSeq: number, seq: number, hoverId: string): string = live ? "" : rest != "" and seq == restSeq ? rest : hoverId

// The row a control's hover key belongs to (`<row>#<control>`: SidebarTip, DraftCard's Discard), "" for a row's own key
// or another hover (the window gives the row its hover back as the tip ends).
fn sidebarTipRow(id: string): string = id.includes("#") ? id.slice(0, id.indexOf("#")) : ""

// A shelf of rows. Working, Snoozed and Settled carry the collapsible header
// (CollapsibleSectionHeader: muted, its count trailing, the rule hidden so the count does not read as a leader's);
// a collapsed shelf still paints the open thread, which the projection already decided.
component ThreadSection
  inject
    sidebarTreeStop: string
    treeFocused: action
    treeKey: action
  props
    reduced: bool
    threads: Thread[]
    data: Snapshot
    now: number
    section: string
    label: string
    busy: bool
    local: action
    run: action
    menu: action
    open: action
    hoverCard: action
    pressDown: action
    hoverId: string
    drag: action
    dragEnd: action
    dragId: string
    dragVerb: string
    dragOffset: number
    dragTarget: string
    page: string
    scrollY: number
    hoverSeq: number
  // Upstream 1826fb55cc: pressing a row's Settle, Un-settle or Wake and
  // dragging 6 pt arms every row of this section between it and the pointer
  // (resolveSidebarSweepKeys, the pointer clamped to the visible list; a gap
  // resolves to the row above). The release is a `sweep|…` drop; the client
  // bumps sweepEpoch when it lands, which ends the sweep here.
  state sweepId = ""
  state sweepVerb = ""
  state sweepEpoch = -1
  state sweepY = 0
  state sweepTop = 0
  state sweepLo = 0
  state sweepHi = 0
  state sweepAt = 0
  state sweepDx = 0
  state sweepDy = 0
  state sweepKeys = ""
  // Escape cancels a live sweep (SidebarPointerSensor keydown): nothing is applied at the release.
  state sweepCancelled = false
  // A cancelled sweep gives the rows the pointer again, as the reference's
  // `**:pointer-events-none` comes off: the row under the pointer is the hovered one (its actions, no card yet), through
  // the release, until the window's hover moves on. The host keeps the pressed row hovered through a pan and hovers
  // nothing new at the release until the pointer moves; that first move, out of the section too, sends the leave of
  // the node it kept hovered (the pressed control's tip) through the window's `sidebarHover`, which counts it.
  // `sweepRestSeq` is the window's hover count when it was cancelled. The section takes no `hover` of its own: the
  // macOS host hovered one node at a time before main #327, so it traded the hover with the row under the pointer.
  state sweepRest = ""
  state sweepRestSeq = 0
  derive sweepLive = sweepKeys != "" and sweepEpoch == data.sidebar.sweepEpoch and not busy and not sweepCancelled
  action cancelSweep
    sweepCancelled = true
    sweepKeys = ""
    sweepRest = rows.filter((t) => frame(`row-${t.id}`).y <= sweepAt and frame(`row-${t.id}`).y + frame(`row-${t.id}`).height > sweepAt).map((t) => t.hoverKey).join("")
    sweepRestSeq = hoverSeq
  // A press on another row, or the first move after the last sweep's release (sweepEpoch), starts a sweep: fresh, as
  // the reference's startActionSweep makes a new closure per press. An action reads the values from before it, so the
  // start's values and this move's offset are bound first and every slot is written from them
  // (the old body read what its start branch reset, so a sweep kept the last one's offset, origin, verb, armed rows and
  // cancel, and each move armed the rows of the move before; sidebar-sweep.test.ts).
  action sweep(id: string, verb: string, dx: number, dy: number)
    let fresh = sweepId != id or sweepEpoch != data.sidebar.sweepEpoch
    let mode = fresh ? verb : sweepVerb
    let cancelled = fresh ? false : sweepCancelled
    let armed = fresh ? "" : sweepKeys
    let originY = fresh ? frame(`sweep-${id}`).y + frame(`sweep-${id}`).height / 2 : sweepY
    let originTop = fresh ? frame(`row-${id}`).y : sweepTop
    let lo = fresh ? frame("thread-list").y + scrollY : sweepLo
    let hi = fresh ? frame("thread-list").y + scrollY + frame("thread-list").height - 1 : sweepHi
    let movedX = (fresh ? 0 : sweepDx) + dx
    let movedY = (fresh ? 0 : sweepDy) + dy
    let at = min(max(originY + movedY, lo), hi)
    if fresh
      sweepId = id
      sweepVerb = verb
      sweepEpoch = data.sidebar.sweepEpoch
      sweepCancelled = false
      sweepRest = ""
      sweepY = originY
      sweepTop = originTop
      sweepLo = lo
      sweepHi = hi
    sweepDx = movedX
    sweepDy = movedY
    sweepAt = at
    if not cancelled and (armed != "" or movedX * movedX + movedY * movedY >= 36)
      // SidebarPointerSensor's onStart: the list stops taking the pointer (`**:pointer-events-none`), so a row's card or
      // a control's tooltip closes as the sweep takes over, whether or not the press moved the focus (the
      // buttons' `focus` only moves them off): the hovered row hears its leave through the window's `sidebarHover`, as a
      // pointer leaving it does (since main #478 an action bound to `pan=` may call it; #468 called the root's half).
      if armed == ""
        hoverCard(hoverId, false)
      sweepKeys = `|${rows.filter((t) => (mode == "settle" ? t.canSettle : mode == "unsettle" ? t.canUnsettle : t.canWake) and (at >= originTop ? frame(`row-${t.id}`).y >= originTop and frame(`row-${t.id}`).y <= at : frame(`row-${t.id}`).y <= originTop and frame(`row-${t.id}`).y + frame(`row-${t.id}`).height + 1 > at)).map((t) => t.id).join("|")}|`
    else if fresh
      sweepKeys = ""
  derive rows = threads.filter((t) => t.section == section)
  derive count = section == "settled" ? data.sidebar.settledCount : section == "snoozed" ? data.sidebar.snoozedCount : data.sidebar.workingCount
  derive expanded = section == "settled" ? data.sidebar.settledExpanded : section == "snoozed" ? data.sidebar.snoozedExpanded : data.sidebar.workingExpanded
  derive tone = "light-dark(#71717b, #a3a3a3)"
  // The drop target's accent and the lifted row's emphasis (tones accent and emphasized).
  derive ink = section == "settled" and dragTarget == "settled" ? "light-dark(#1b4ed8, #346bf1)" : section == "settled" and dragId != "" ? "light-dark(#18181bcc, #f3f3f3cc)" : tone
  derive dragFrom = threads.filter((t) => t.id == dragId).map((t) => t.section).join("")
  derive settledHint = dragId != "" and (rows.length == 0 or (dragFrom == "settled" and rows.length == 1 and dragTarget != "" and dragTarget != "settled"))
  action revealSettledHint(w: number, h: number)
    scrollIntoView("sidebar-settled-placeholder", block="nearest", behavior="instant")
  view
    // An empty pinned or active block takes no gap (the reference's markers are 0pt tall with a -1pt margin).
    column gap=1 width="100%" margin-bottom=(label == "" and rows.length == 0 ? "-1px" : "0px")
      if label != ""
        box position="relative" width="calc(100% - 4px)" margin-left="0.125rem" height="2rem" flex-shrink=0
          button cursor="pointer" id=`shelf-${section}` press=local("shelf", section, "") role="treeitem" aria-level=1 tabindex=(sidebarTreeStop == `shelf-${section}` ? 0 : -1) focus=treeFocused(`shelf-${section}`) key=treeKey(`shelf-${section}`) width="100%" height="2rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.5rem" aria-label=`Toggle ${label}` aria-expanded=expanded testId=`toggle-${section}`
            // CollapsibleSectionHeader: focus-visible:ring-2 ring-inset ring-ring/70.
            :focus-visible
              box-shadow="inset 0 0 0 2px light-dark(#1b4ed8b3, #346bf1b3)"
            text label font-size="0.75rem" font-weight=500 line-height="1rem" color=ink flex-shrink=0
            box flex=1 min-width="0.5rem"
            text `${count}` font-size="0.75rem" font-weight=400 line-height="1rem" font-variant-numeric="tabular-nums" color=ink flex-shrink=0
            SidebarIcon(name=(expanded ? "chevron-down" : "chevron-right"), size=12, color=ink) // CollapsibleSectionHeader: -rotate-90 while collapsed
      // SidebarSectionPlaceholder: while a row is lifted and Settled lists none (or only the lifted row, headed elsewhere),
      // a dashed "Settled" box hangs below the header; it scrolls into the list's viewport as it shows (revealOverflow).
      if section == "settled" and settledHint
        box position="relative" height=0 margin-left="0.125rem" margin-right="0.125rem" margin-bottom="-1px" flex-shrink=0
          row id="sidebar-settled-placeholder" position="absolute" left=0 right=0 top=0 height="2.25rem" box-sizing="border-box" align-items="center" justify-content="center" border-radius="0.375rem" border-width=1 border-style="dashed" border-color=(dragTarget == "settled" ? "light-dark(#1b4ed866, #346bf166)" : "light-dark(#18181b40, #f3f3f340)") background-color=(dragTarget == "settled" ? "light-dark(#1b4ed80d, #346bf10d)" : "#00000000") resize=revealSettledHint testId="sidebar-settled-placeholder"
            text "Settled" font-size="0.75rem" line-height="1rem" color=(dragTarget == "settled" ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#18181bcc, #f3f3f3cc)")
      for t in rows key=t.rowKey // kept while an open moves the window to the row's environment (scopedRowKey)
        ThreadRow(reduced=reduced, t=t, now=now, presets=t.snoozePresets, busy=busy, local=local, run=run, menu=menu, open=open, hoverCard=hoverCard, pressDown=pressDown, hoverId=sweepRowHover(sweepLive, sweepRest, sweepRestSeq, hoverSeq, hoverId), drag=drag, dragEnd=dragEnd, dragId=dragId, dragVerb=dragVerb, dragOffset=(dragId == t.id ? dragOffset : 0), page=page, sweep=sweep, sweepKeys=(sweepCancelled and sweepEpoch == data.sidebar.sweepEpoch ? "|cancel|" : sweepLive ? sweepKeys : ""), sweepVerb=sweepVerb)
      // The sweep owns Escape while it is armed (a window shortcut: the pan's section gets no keys).
      if sweepLive
        button press=cancelSweep aria-keyshortcuts="Escape" aria-label="Cancel sweep" tabindex=-1 testId=`sweep-cancel-${section}` position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" opacity=0 padding=0 border-width=0 background-color="#00000000" title=""

// SidebarDragBoundary: "Pinned" and "Active" open 24pt while a row is lifted.
component SidebarDragLabel
  props
    label: string
    target: bool
  view
    row position="absolute" left="0.5rem" right="0.5rem" top="0.25rem" height="1rem" gap="0.5rem" align-items="center" pointer-events="none"
      text label font-size="0.75rem" line-height="1rem" font-weight=500 color=(target ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#18181bcc, #f3f3f3cc)") flex-shrink=0
      box flex=1 height=1 background-color=(target ? "light-dark(#1b4ed880, #346bf180)" : "light-dark(#18181b40, #f3f3f340)")
