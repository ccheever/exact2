// The sidebar's project glyph and update pill.
use ProjectGlyph from "./sidebar-shapes.contract"
use ProjectMark from "../shared/icons-kit.contract"

// ProjectFavicon on sidebar surfaces (sidebar-glyph.ts): a Lucide override
// in its color, an emoji at 80% of the tile, the favicon image (25% rounded),
// else the monogram tile. `dim` is a receding slim row's grayscale.
component SidebarProjectGlyph
  props
    g: ProjectGlyph
    size: number
    dim: bool
  view
    if g.kind == "lucide"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=(dim ? g.gray : g.ink) fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
        path d=g.d
    else
      if g.kind == "emoji"
        box width=`${size / 16}rem` height=`${size / 16}rem` display="flex" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          text g.emoji font-size=`${size * 0.8 / 16}rem` line-height=`${size * 0.8 / 16}rem`
      else
        if g.kind == "image"
          image g.src width=`${size / 16}rem` height=`${size / 16}rem` border-radius=`${size / 64}rem` object-fit="contain" flex-shrink=0 aria-hidden=true
        else
          ProjectMark(label=g.text, muted=false, ink=(dim ? g.gray : g.ink), surface=(dim ? g.graySurface : g.surface), size=size)

// SidebarUpdatePill (SidebarUpdatePill.tsx) as the reference draws it with no update feed: this build has
// none (the user's decision), so `canCheckForUpdate` is false and the control is the disabled
// round RefreshCw button (opacity 60%, not-allowed), `aria-disabled` as the reference's (main `9074a745b`,
// issues/closed/20261010-aria-disabled-focusable-control.md): it reads as disabled and Tab still reaches it.
// Its owner draws the "Check for updates"
// tooltip (side top) from the wrapper's hover; a press does nothing. No check, download or install exists behind it.
component SidebarUpdatePill
  props
    color: string
    testId: string
  view
    button aria-disabled=true aria-label="Check for updates" cursor="not-allowed" testId=testId width="2rem" height="2rem" padding=0 border-radius="9999px" border-width=0 background-color="#00000000" opacity=0.6 display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      svg width="1rem" height="1rem" viewBox="0 0 24 24" fill="none" color=color flex-shrink=0 aria-hidden=true
        path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5" stroke=color stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round"
