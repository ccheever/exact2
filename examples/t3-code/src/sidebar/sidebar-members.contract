// The window's Back and Forward (sidebar-history.ts): the sidebar header's Go back and Go forward buttons and a mouse's
// side buttons step what ⌘[ and ⌘] step, through the same targets the keyboard dispatch runs.
use NavigationHistory from "./sidebar-shapes.contract"
members T3Code
  resource navigationHistory = navigationHistory(data.revision, utilityPage, settingsOpen) as shape NavigationHistory
  // Each visit is mirrored onto the router, so the Mac's swipe, its mouse buttons and the agent's `back` step it
  // (LLP 1115.000 D5.5): Back is a pop to the visit beneath, Forward a push of the one ahead, any other a new push. A
  // new visit goes over the one the history has beneath it, which drops a visit left in between (Settings closed, or a
  // Back, in the same turn as the new visit). Not while a link's tab is up, which hands back to `home` once handled.
  task visitRecorded when navigationHistory.here != "" and top(promptLinks).tab == "home" key=navigationHistory.here
    after(1, recordVisit)
  action recordVisit
    let here = navigationHistory.here
    let beneath = navigationHistory.backHref
    promptLinks = go(stack(promptLinks).filter((e) => e.url == here).length > 0 or beneath == "" ? promptLinks : go(promptLinks, beneath), here)
  // `direction` is "back" or "forward", or the location the root's `navigate` asks for (the Mac's swipe, its mouse
  // buttons, the agent's `back`): a step when it is where one of them goes, not under the palette or a dialog other than
  // Settings, as ⌘[ and ⌘]; else a link (/open, /notification), which opens its own tab and so leaves home's visits.
  action historyGo(direction: string)
    let steps = not paletteOpen and (not modal or settingsOpen)
    let way = not steps ? "" : (direction == "back" or direction == navigationHistory.backHref ? "back" : (direction == "forward" or direction == navigationHistory.forwardHref ? "forward" : ""))
    let kind = way == "back" ? navigationHistory.backKind : (way == "forward" ? navigationHistory.forwardKind : "")
    let target = way == "back" ? navigationHistory.backTarget : navigationHistory.forwardTarget
    let extra = way == "back" ? navigationHistory.backExtra : navigationHistory.forwardExtra
    if kind != ""
      promptLinks = go(promptLinks, way == "back" ? navigationHistory.backHref : navigationHistory.forwardHref)
    if kind == "thread"
      selectThread(target)
    else if kind == "back"
      closeModal()
    else if kind != ""
      paletteRun(kind == "palette-run" ? target : "new-thread", kind == "palette-run" ? extra : target, "")
    else if way == "" and top(open(promptLinks, direction)).tab != "home"
      promptLinks = open(promptLinks, direction)
