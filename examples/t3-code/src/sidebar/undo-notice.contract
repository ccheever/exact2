// SidebarThreadUndoNotice (T3 Code 6d450a4284, MIT; see LICENSE-T3): one muted line and the "⌘Z to undo" button in
// the foreground, with no box. It fades in and out in 200 ms; the window removes it when its five seconds end. It is
// announced as "<summary>, ⌘Z to undo" through the shell's announcer (sidebar-commands.ts noticeChanged,
// showThreadUndoNotice.ts's setNotice), so the line itself is not a live region.
//  - FooterUndoNotice: the main sidebar's, filling the free space of the footer's utility row, so it never moves or
//    covers the list. Its summary is short ("Settled 2,").
//  - UndoNotice: the legacy sidebar's, in its footer's flow with the full summary ("Settled 2 threads,").

keyframes undoNoticeIn
  from opacity=0
  to opacity=1
keyframes undoNoticeOut
  from opacity=1
  to opacity=0

component FooterUndoNotice
  props
    text: string
    label: string
    muted: string
    ink: string
    run: action
  state hovered = false
  action hover(on: bool)
    hovered = on
  view
    // No min-width 0 on the item: the undo button sets its minimum, so a shared row squeezes its neighbour.
    row flex=1 role="listitem" animation="undoNoticeIn 200ms ease-out" -exact-exit-animation="undoNoticeOut 200ms ease-out" testId="sidebar-undo-notice"
      // The button comes first (screen readers' browse order) and sits at the end; a summary that does not fit beside
      // it clips, where the reference wraps it to a hidden second line.
      row height="1.5rem" min-width=0 flex=1 flex-direction="row-reverse" column-gap="0.25rem" overflow="hidden"
        button cursor="pointer" press=run("undo", "", "") hover=hover testId="sidebar-undo" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0
          text label font-size="0.6875rem" line-height="1.5rem" font-weight=500 color=ink white-space="nowrap" text-decoration-line=(hovered ? "underline" : "none")
        text text min-width=0 flex-shrink=1 overflow="hidden" white-space="nowrap" font-size="0.6875rem" line-height="1.5rem" color=muted

component UndoNotice
  props
    text: string
    label: string
    muted: string
    ink: string
    run: action
  state hovered = false
  action hover(on: bool)
    hovered = on
  view
    // It keeps the footer's insets (px 0.5rem, py 0.25rem) and its 0.5rem gap to the utility menu.
    row position="relative" margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.25rem" align-items="center" flex-shrink=0 animation="undoNoticeIn 200ms ease-out" -exact-exit-animation="undoNoticeOut 200ms ease-out" role="group" testId="legacy-undo-notice"
      text text min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" font-size="0.6875rem" line-height="1.5rem" color=muted
      button cursor="pointer" press=run("undo", "", "") hover=hover testId="sidebar-undo" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0
        text label font-size="0.6875rem" line-height="1.5rem" font-weight=500 color=ink white-space="nowrap" text-decoration-line=(hovered ? "underline" : "none")
