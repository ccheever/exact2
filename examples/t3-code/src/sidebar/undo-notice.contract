// SidebarThreadUndoNotice (T3 Code 7c3b3b3605ef, MIT; see LICENSE-T3): one muted line, "Settled 2 threads," (the
// text carries its comma), and the "⌘Z to undo" button in the foreground, with no box. It fades in and out in
// 200 ms; the window removes it when its five seconds end. The main sidebar lays it over the list just above its
// first bottom shelf header (the header's own box places it); the legacy sidebar, and the main one while it searches
// or lists no rows, put it in the footer. It is announced as "<summary>, ⌘Z to undo" through the shell's announcer
// (sidebar-commands.ts noticeChanged, showThreadUndoNotice.ts's setNotice), so the line is a group, not a live region.

keyframes undoNoticeIn
  from opacity=0
  to opacity=1
keyframes undoNoticeOut
  from opacity=1
  to opacity=0

component UndoNotice
  props
    text: string
    label: string
    // Laid over the list above a shelf header, on the sidebar's surface; else in the footer's flow.
    over: bool
    surface: string
    muted: string
    ink: string
    run: action
  state hovered = false
  action hover(on: bool)
    hovered = on
  view
    // In the footer it keeps the footer's insets (px 0.5rem, py 0.25rem) and its 0.5rem gap to the utility menu.
    row position=(over ? "absolute" : "relative") left=0 right=0 bottom=(over ? "100%" : "auto") z-index=(over ? 2 : 0) margin-left=(over ? "0px" : "0.5rem") margin-right=(over ? "0px" : "0.5rem") margin-top=(over ? "0px" : "0.25rem") margin-bottom=(over ? "0px" : "0.25rem") padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.25rem" align-items="center" flex-shrink=0 background-color=(over ? surface : "#00000000") animation="undoNoticeIn 200ms ease-out" -exact-exit-animation="undoNoticeOut 200ms ease-out" role="group" testId="sidebar-undo-notice"
      text text min-width=0 overflow="hidden" text-overflow="ellipsis" white-space="nowrap" font-size="0.6875rem" line-height="1.5rem" color=muted
      button cursor="pointer" press=run("undo", "", "") hover=hover testId="sidebar-undo" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0
        text label font-size="0.6875rem" line-height="1.5rem" font-weight=500 color=ink white-space="nowrap" text-decoration-line=(hovered ? "underline" : "none")
