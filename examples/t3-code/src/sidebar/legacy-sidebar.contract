use DialogFinalFocus from "../shared/dialog-trap.contract"
// T3's "Sidebar (legacy)" (LegacySidebar.tsx, sidebar/SidebarChrome.tsx, ui/sidebar.tsx; MIT,
// see LICENSE-T3): the chrome header, the Search trigger, "Projects" with Sidebar options and
// Add project, then each project row (chevron or collapsed status, favicon, name, "N projects",
// the hover New thread button, the remote badge, a drag handle in Manual order) over its thread
// list (status, PR, title, worktree and remote glyphs, relative time or the ⌘ jump label, the
// hover Archive with its Confirm), Show more / Show less, and the chrome footer. Every gesture is
// a `sidebarlocal:legacy-*` or `sidebar:legacy-*` op (legacy-sidebar-commands.ts).
use Snapshot from "../shared/shapes.contract"
use LegacyProjectRow from "./legacy-sidebar-shapes.contract"
use LegacyThreadRow from "./legacy-sidebar-shapes.contract"
use LegacySidebarView from "./legacy-sidebar-shapes.contract"
use ShellView from "../shell/shell-shapes.contract"
use NightlyBackdrop from "./nightly.contract"
use Icon from "../shared/icons.contract"
use Wordmark from "../shared/icons.contract"
use Tip from "../shell/shell-tip.contract"
use LookWordmark from "../appearance/settings-appearance-look.contract"
use LookPill from "../appearance/settings-appearance-look.contract"
use PgIcon from "../shared/pages-icons.contract"
use SidebarIcon from "./sidebar-icons.contract"
use SidebarUpdatePill from "./sidebar-icons-kit.contract"
use SidebarProjectGlyph from "./sidebar-icons-kit.contract"
use CnMachineIcon from "../settings/settings-b-kit.contract"
use HoverTip, hoverTipAtFrame from "../shell/hover-layer.contract"
use SidebarTip from "./sidebar-row.contract"
use SidebarMenuCard, SidebarMenuItem from "./sidebar-row.contract"
use TerminalGlyph from "./sidebar-row.contract"
use ProviderPill from "./sidebar-control-tips.contract"
use SettingsConfirm from "../settings/settings-rest-dialogs.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use FieldOpenSelect from "../shared/dialog-trap.contract"

// animate-status-pulse: full, then half opacity.
keyframes lsStatusPulse
  from opacity=1
  40% opacity=1
  50% opacity=0.5
  90% opacity=0.5
  to opacity=1

// auto-animate's removal and addition (SIDEBAR_LIST_ANIMATION_OPTIONS: 180 ms ease-out): a leaving row fades and shrinks
// a little; an arriving one (legacy-sidebar-view.ts `enter`) the reverse.
keyframes lsRowOut
  from opacity=1 scale=1
  to opacity=0 scale=0.98
keyframes lsRowIn
  from opacity=0 scale=0.98
  to opacity=1 scale=1

// A row's or a header's tooltip in the window's hover layer (LegacyRowTip, LegacyTitleTip): kind "tooltip" (Base UI's 600 ms,
// no provider). Every legacy tip shares one key, so the row or header the pointer is next on closes one a gone trigger left.
fn legacyTip(label: string, side: string, align: string, at: Geometry, rem: number, testId: string): HoverTip = hoverTipAtFrame("legacy-tip", "tooltip", label, [], side, align, at, (floor(label.length / 48) + 1) * rem + 0.625 * rem, testId)
fn legacyTipOff(): HoverTip = HoverTip(key="legacy-tip", kind="tooltip", text="", lines=[], side="top", align="center", x=0, y=0, width=0, height=0, estimate=0, testId="")
// Trigger IDs identify the owner; every legacy tip deliberately shares the same hover-controller key.
fn legacyTipOwner(testId: string, projects: LegacyProjectRow[]): bool = projects.filter(p => [`legacy-tip-status-${p.key}-bubble`, `legacy-tip-new-${p.key}-bubble`].includes(testId) or p.threads.filter(t => not t.renaming and ["title", "pr", "port", "worktree", "terminal", "archive"].map(kind => `legacy-tip-${kind}-${t.id}-bubble`).includes(testId)).length > 0).length > 0

fn lsPrTone(lifecycle: string): string = lifecycle == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : lifecycle == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : lifecycle == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : lifecycle == "open" ? "light-dark(#009966, #5ee9b5e6)" : "light-dark(#71717b, #818181)"

// The legacy sidebar's own Lucide glyphs (24px grid, stroke 2).
component LegacyIcon
  props
    name: string
    size: number
    color: string
  derive geometry = name == "chevron-right" ? "m9 18 6-6-6-6" : name == "archive" ? "M3 3h18a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1ZM4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8M10 12h4" : name == "arrow-up-down" ? "m21 16-4 4-4-4M17 20V4M3 8l4-4 4 4M7 4v16" : name == "folder-plus" ? "M12 10v6M9 13h6M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" : name == "grip-vertical" ? "M8 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M8 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M8 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M14 12a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M14 5a1 1 0 1 0 2 0a1 1 0 1 0 -2 0M14 19a1 1 0 1 0 2 0a1 1 0 1 0 -2 0" : name == "git-pull-request" ? "M18 15a3 3 0 1 0 0 6a3 3 0 1 0 0-6M6 3a3 3 0 1 0 0 6a3 3 0 1 0 0-6M13 6h3a2 2 0 0 1 2 2v7M6 9v12" : name == "globe-2" ? "M21.54 15H17a2 2 0 0 0-2 2v4.54M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0" : ""
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=geometry

component LegacySidebar
  props
    reduced: bool
    data: Snapshot
    shell: ShellView
    now: number
    width: number
    busy: bool
    keySidebar: string
    page: string
    pullRequests: bool
    toggle: action
    addProject: action
    openPalette: action
    open: action
    local: action
    run: action
    openSettings: action
    navigate: action
    openProviders: action
    hoverCard: action
    hoverId: string
  derive legacy = data.legacy
  // Manual order: a project dropped before another (or at the end) keeps that place across launches.
  action dropped(item: string, before: option<string>)
    local("legacy-reorder", item, match before { case some(b) => b, case none => "" })
  // The row or header a right press named, for the sidebar's one thread and one project context popover
  // (LegacyThreadMenu, LegacyProjectMenu): the node's `contextmenu` runs before the host reads the popover.
  state menuThread = ""
  state menuProject = ""
  action threadMenu(id: string)
    menuThread = id
  action projectMenu(key: string)
    menuProject = key
  view
    column width=width height="100%" flex-shrink=0 box-sizing="border-box" background-color=(data.look.themed ? data.look.sidebar : "light-dark(#f9f9f9, #030303)") border-right-style="solid" border-right-width=1 border-color=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #141414)") position="relative" testId="legacy-sidebar" id="legacy-sidebar" data-paint=`${(data.look.themed ? "sidebar" : "")} ${(data.look.themed ? "border" : "")}` data-pick=((data.look.themed ? "sidebar" : "") != "" ? (data.look.themed ? "sidebar" : "") : ((data.look.themed ? "border" : "") != "" ? (data.look.themed ? "border" : "") : ""))
      LegacyThreadMenu(projects=legacy.projects, owner=menuThread, run=run)
      LegacyProjectMenu(projects=legacy.projects, owner=menuProject, run=run)
      // SidebarChromeHeader: the titlebar row with the stage artwork or the version pill.
      if data.look.artwork
        NightlyBackdrop()
      row height=52 flex-shrink=0 padding-left=(data.controlsLeft + 1) padding-right="0.5rem" gap="0.6875rem" align-items="center" position="relative"
        // The window's SidebarToggle (sidebar-toggle.contract) stands over this place.
        box width="1.75rem" height="1.75rem" flex-shrink=0
        button cursor="pointer" press=run("home", "", "") height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.25rem" aria-label="Go to threads" testId="sidebar-brand"
          if data.look.artwork
            Wordmark()
            text "Code" font-size="0.875rem" font-weight=500 letter-spacing=-0.35 color="#ffffffb3"
          else
            LookWordmark(ink=(data.look.themed ? data.look.sidebarText : "light-dark(#27272a, #f1f3f7)"), muted=(data.look.themed ? data.look.sidebarMuted : "light-dark(#71717b, #a3a3a3)"))
        if data.look.pill != "" and width - 13 >= data.controlsLeft + 149.04
          LookPill(label=data.look.pill)
      // SidebarContent's fixed header: the command palette trigger.
      column padding="0.5rem" box-sizing="border-box" flex-shrink=0
        button cursor="pointer" press=openPalette testId="command-palette-trigger" aria-label="Search" width="100%" height="2rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=0 background-color=(hoverId == "legacy-search" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" hover=hoverCard("legacy-search")
          SidebarIcon(name="search", size=16, color="light-dark(#71717b, #818181)")
          text "Search" flex=1 min-width=0 font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#71717bcc, #818181cc)" line-clamp=1 text-align="left"
          if legacy.searchShortcut != ""
            LegacyKbd(label=legacy.searchShortcut)
      // "Projects" with Sidebar options and Add project.
      row margin-left="0.5rem" margin-right="0.5rem" margin-bottom="0.25rem" padding-left="0.5rem" padding-right="0.375rem" align-items="center" justify-content="space-between" flex-shrink=0
        text "Projects" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717bcc, #818181cc)"
        row gap="0.25rem" align-items="center"
          LegacyOptions(legacy=legacy, local=local)
          Tip(label="Add project", side="right", align="center", offset=30)
            button cursor="pointer" press=addProject aria-label="Add project" testId="sidebar-add-project-trigger" disabled=(not data.connected) width="1.5rem" height="1.5rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              LegacyIcon(name="folder-plus", size=14, color="light-dark(#71717b, #818181)")
      // appearance="none": the reference draws these rows as divs, not a platform table (LLP 1115.002 D5's opt-out).
      list appearance="none" id="legacy-projects" reorderdrop=dropped virtualized=true estimated-item-height=120 flex=1 min-height=0 width="100%" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" overflow-x="hidden" aria-label="Projects" testId="legacy-project-list"
        for p in legacy.projects key=p.key
          LegacyProject(reduced=reduced, p=p, legacy=legacy, now=now, page=page, busy=busy, open=open, local=local, run=run, menu=projectMenu, threadMenu=threadMenu)
      if legacy.noProjects
        text "No projects yet" padding-left="0.5rem" padding-right="0.5rem" padding-top="1rem" font-size="0.75rem" line-height="1rem" text-align="center" color="light-dark(#71717b, #818181)" testId="legacy-no-projects" flex-shrink=0
      // SidebarChromeFooter: the undo notice, the provider pill and the utility menu.
      if data.sidebar.undoText != "" and now < data.sidebar.undoUntil
        row margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#f4f4f5, #0a0a0a)" align-items="center" gap="0.1875rem" flex-shrink=0 role="status" testId="sidebar-undo-notice"
          text data.sidebar.undoText font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #a3a3a3)"
          button cursor="pointer" press=run("undo", "", "") testId="sidebar-undo" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            text data.sidebar.undoLabel font-size="0.6875rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f1f3f7)" white-space="nowrap"
      if data.sidebar.pillKey != ""
        ProviderPill(tone=data.sidebar.pillTone, title=data.sidebar.pillTitle, description=data.sidebar.pillDescription, dismissible=data.sidebar.pillDismissible, open=openProviders(""), dismiss=local("pill-dismiss", "", data.sidebar.pillKey))
      row height="2.5rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" align-items="center" gap="0.25rem" flex-shrink=0 role="list"
        if page == ""
          SidebarTip(tip="sidebar-settings", hoverCard=hoverCard)
            button cursor="pointer" press=openSettings testId="connection-settings" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-settings" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Settings" title=""
              Icon(name="settings", size=16, color=(hoverId == "sidebar-settings" ? "light-dark(#27272a, #f3f3f3)" : "light-dark(#a8a8ae, #545454)"))
          if pullRequests
            SidebarTip(tip="sidebar-pull-requests", hoverCard=hoverCard)
              button cursor="pointer" press=navigate("pull-requests") testId="open-pull-requests" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-pull-requests" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Pull Requests" title=""
                Icon(name="pull-requests", size=16, color=(hoverId == "sidebar-pull-requests" ? "light-dark(#27272a, #f3f3f3)" : "light-dark(#a8a8ae, #545454)"))
          SidebarTip(tip="sidebar-usage", hoverCard=hoverCard)
            button cursor="pointer" press=navigate("usage") testId="open-usage" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(hoverId == "sidebar-usage" ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Usage" title=""
              Icon(name="usage", size=16, color=(hoverId == "sidebar-usage" ? "light-dark(#27272a, #f3f3f3)" : "light-dark(#a8a8ae, #545454)"))
        else
          button cursor="pointer" press=navigate("") testId="sidebar-back" flex=1 min-width=0 height="2rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" aria-label="Back"
            PgIcon(name="arrow-left", size=16, color="light-dark(#a8a8ae, #545454)")
            text "Back" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#70707acc, #a2a2a2cc)"
        row margin-left="auto" flex-shrink=0
          SidebarTip(tip="sidebar-update", hoverCard=hoverCard)
            SidebarUpdatePill(color="light-dark(#a8a8ae, #545454)", testId="sidebar-check-updates")

component LegacyKbd
  props
    label: string
  view
    text label height="1.25rem" min-width="1.25rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="0.25rem" background-color="light-dark(#27272a0d, #ffffff0d)" font-size="0.6875rem" line-height="1.25rem" font-weight=500 text-align="center" color="light-dark(#71717b, #818181)" flex-shrink=0

// ProjectSortMenu: Sort projects, Sort threads (radio groups) and Visible threads (a 1-15 number field).
component LegacyOptions
  props
    legacy: LegacySidebarView
    local: action
  derive items = [KmItem(id="legacy-sort-projects-updated_at", label="Last user message"), KmItem(id="legacy-sort-projects-created_at", label="Created at"), KmItem(id="legacy-sort-projects-manual", label="Manual"), KmItem(id="legacy-sort-threads-updated_at", label="Last user message"), KmItem(id="legacy-sort-threads-created_at", label="Created at")]
  derive focusIds = items.map((item) => item.id).concat(["legacy-sidebar-options-keys", "legacy-sidebar-options-keys-first", "legacy-sidebar-options-keys-last", "legacy-preview-count", "legacy-preview-decrease", "legacy-preview-increase"])
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("legacy-sidebar-options", source="legacy-options")
        let target = kmTriggerTarget(items, k)
        if target != ""
          focus(target)
  action left(e: FocusEvent)
    match e.relatedTarget
      case some(id)
        if not focusIds.includes(id)
          hidePopover("legacy-sidebar-options")
      case none
        hidePopover("legacy-sidebar-options")
  view
    column position="relative" flex-shrink=0
      Tip(label="Sidebar options", side="right", align="center", offset=30)
        button cursor="pointer" id="legacy-options" popovertarget="legacy-sidebar-options" key=triggerKey aria-label="Sidebar options" aria-haspopup="menu" testId="legacy-sidebar-options" width="1.5rem" height="1.5rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
          LegacyIcon(name="arrow-up-down", size=14, color="light-dark(#71717b, #818181)")
      // MenuPopup align="end" side="bottom" (LegacySidebar.tsx ProjectSortMenu): its right edge under the trigger's.
      row id="legacy-sidebar-options" focusout=left popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId="legacy-sidebar-options-layer"
        column width="12rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fffffff5, #111111f5)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Sidebar options" flex-shrink=0
          KeyMenu(menuId="legacy-sidebar-options-keys", items=items, keyed=0, gap="0px", modal=true)
            text "Sort projects" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
            LegacyRadio(keysId="legacy-sidebar-options-keys", label="Last user message", checked=(legacy.projectSort == "updated_at"), press=local("legacy-sort-projects", "", "updated_at"), testId="legacy-sort-projects-updated_at")
            LegacyRadio(keysId="legacy-sidebar-options-keys", label="Created at", checked=(legacy.projectSort == "created_at"), press=local("legacy-sort-projects", "", "created_at"), testId="legacy-sort-projects-created_at")
            LegacyRadio(keysId="legacy-sidebar-options-keys", label="Manual", checked=(legacy.projectSort == "manual"), press=local("legacy-sort-projects", "", "manual"), testId="legacy-sort-projects-manual")
            text "Sort threads" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.5rem" padding-bottom="0.25rem" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
            LegacyRadio(keysId="legacy-sidebar-options-keys", label="Last user message", checked=(legacy.threadSort == "updated_at"), press=local("legacy-sort-threads", "", "updated_at"), testId="legacy-sort-threads-updated_at")
            LegacyRadio(keysId="legacy-sidebar-options-keys", label="Created at", checked=(legacy.threadSort == "created_at"), press=local("legacy-sort-threads", "", "created_at"), testId="legacy-sort-threads-created_at")
          text "Visible threads" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.5rem" padding-bottom="0.25rem" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
          LegacyCount(count=legacy.previewCount, local=local)

component LegacyRadio
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    checked: bool
    press: action
    testId: string
  state lit = false
  action hover(value: bool)
    if value
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId cursor="pointer" press=press hover=hover focus=focused(true) blur=focused(false) role="menuitemradio" aria-checked=checked testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" data-focus-stop="enabled"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
        if checked
          box width="0.375rem" height="0.375rem" border-radius="0.1875rem" background-color="light-dark(#27272a, #f5f5f5)"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 text-align="left" white-space="nowrap"

// NumberField (w-28, sm): decrement, the value, increment; clamps to 1-15.
component LegacyCount
  props
    count: number
    local: action
  // NumberFieldIncrement/Decrement (Base UI 1.4.1 useNumberFieldButton: tabIndex -1): the steppers are no Tab
  // stops and a press leaves the focus where it is, so Tab from the field leaves the popup and a clamp
  // that disables a stepper never strands the focus on it.
  state draft = ""
  state dirty = false
  derive value = dirty ? draft : `${count}`
  action edit(text: string)
    draft = text
    dirty = true
  action commit(text: string)
    dirty = false
    local("legacy-preview", "", text)
  action submitDraft
    let submitted = value
    dirty = false
    local("legacy-preview", "", submitted)
  action step(delta: string)
    dirty = false
    local("legacy-preview-step", "", delta)
  view
    row margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" width="7rem" height="1.75rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" align-items="stretch" role="group" aria-label="Visible thread count"
      button cursor="pointer" id="legacy-preview-decrease" press=step("-1") tabindex=-1 disabled=(count <= 1) aria-label="Decrease visible thread count" testId="legacy-preview-decrease" width="1.75rem" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
        SidebarIcon(name="minus", size=14, color="light-dark(#71717b, #818181)")
      input id="legacy-preview-count" value=value input=edit change=commit submit=submitDraft inputmode="numeric" aria-label="Visible thread count" testId="legacy-preview-count" flex=1 min-width=0 padding=0 border-width=0 background-color="#00000000" text-align="center" font-variant-numeric="tabular-nums" font-size="0.8125rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off"
      button cursor="pointer" id="legacy-preview-increase" press=step("1") tabindex=-1 disabled=(count >= 15) aria-label="Increase visible thread count" testId="legacy-preview-increase" width="1.75rem" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
        SidebarIcon(name="plus", size=14, color="light-dark(#71717b, #818181)")

// SidebarProjectItem: the header button (a sortable handle in Manual) over SidebarProjectThreadList.
component LegacyProject
  inject
    hoverTipAt: action
  props
    reduced: bool
    p: LegacyProjectRow
    legacy: LegacySidebarView
    now: number
    page: string
    busy: bool
    open: action
    local: action
    run: action
    // The header's and each row's context popover owner (LegacySidebar).
    menu: action
    threadMenu: action
  state over = false
  // group-focus-within/project-header: the focus on the header or its New thread shows New thread and hides the badge.
  state inside = false
  // The pointer on the header's status or New thread tooltip trigger (LegacyThread `inner`). A trigger's box stays
  // while it draws nothing (LegacyRowTip `shown`), so its leave arrives as the status box goes (a press expands the
  // project, its status clears) even when the projects re-sort in that batch; the header's own hover clears it too.
  state inner = false
  action hover(value: bool)
    over = value
    if value
      inner = false
      hoverTipAt(legacyTipOff(), "trigger", false)
  action innerHover(value: bool)
    inner = value
  action within(value: bool)
    inside = value
  // Base UI closes a tooltip on any press of its trigger, a right-click too: the tip goes before the menu can remove it.
  action openMenu
    hoverTipAt(legacyTipOff(), "trigger", false)
    // Chromium focuses the reference's header on a right press (LegacySidebar.tsx:2373-2381). Writing it is the
    // author's choice, and LLP 1115.000 D7 keeps a focus an action set over D7.1's default.
    focus(`legacy-project-toggle-${p.key}`)
    menu(p.key)
  derive pointed = over or inner
  derive revealed = pointed or inside
  view
    // autoAnimate on the project list and each thread list (180 ms ease-out; none under reduced motion): rows slide
    // when one comes or goes, and a leaving row fades.
    column width="100%" padding-bottom="0.25rem" box-sizing="border-box" -exact-layout-transition=(reduced ? "none" : "180ms ease-out") -exact-exit-animation=(reduced ? "none" : "lsRowOut 180ms ease-out") animation=(p.enter and not reduced ? "lsRowIn 180ms ease-out" : "none") testId=`legacy-project-${p.key}`
      row width="100%" height="2rem" position="relative" hover=hover
        if legacy.manual
          box reorderFor="legacy-projects" touch-action="none" aria-label=`Drag ${p.name} to reorder` testId=`legacy-project-grip-${p.key}` width="0.875rem" height="2rem" margin-left="-0.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0 cursor="grab"
            LegacyIcon(name="grip-vertical", size=12, color=(pointed ? "light-dark(#71717b, #818181)" : "light-dark(#71717b4d, #8181814d)"))
        button cursor="pointer" press=local("legacy-toggle", p.key, "") contextmenu=openMenu contextPopover="legacy-project-menu" focus=within(true) blur=within(false) aria-expanded=p.expanded aria-label=p.name testId=`legacy-project-toggle-${p.key}` flex=1 min-width=0 height="2rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=0 background-color=(pointed ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000") display="flex" flex-direction="row" align-items="center" id=`legacy-project-toggle-${p.key}`
          LegacyRowTip(label=p.statusLabel, side="top", align="start", tipId=`legacy-tip-status-${p.key}`, shown=(not p.expanded and p.statusLabel != ""), relay=innerHover)
            if not p.expanded and p.statusLabel != ""
              box width="0.875rem" height="0.875rem" margin-left="-0.125rem" display="flex" align-items="center" justify-content="center" flex-shrink=0 role="img" aria-label=p.statusLabel testId=`legacy-project-status-${p.key}`
                if pointed
                  LegacyIcon(name="chevron-right", size=14, color="light-dark(#71717b, #818181)")
                else
                  box width="0.5625rem" height="0.5625rem" border-radius="0.3125rem" background-color=p.statusDot animation=(p.statusPulse ? "lsStatusPulse 2s infinite" : "none")
          if p.expanded or p.statusLabel == ""
            box margin-left="-0.125rem" flex-shrink=0 rotate=(p.expanded ? "90deg" : "0deg") transition="rotate 150ms ease"
              LegacyIcon(name="chevron-right", size=14, color="light-dark(#71717bb3, #818181b3)")
          SidebarProjectGlyph(g=p.glyph, size=16, dim=false)
          row flex=1 min-width=0 gap="0.5rem" align-items="center"
            text p.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272ae6, #f3f3f3e6)" line-clamp=1 min-width=0 text-align="left"
            if p.countLabel != ""
              text p.countLabel font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717b, #818181)" flex-shrink=0 white-space="nowrap"
          box width="1rem" flex-shrink=0
        // The environment badge and New thread crossfade (opacity, pointer-events), so New thread stays in the tab order.
        if p.remoteMachine != ""
          box position="absolute" right="0.375rem" top="0.375rem" width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" opacity=(revealed ? 0 : 1) pointer-events="none" role="img" aria-label=p.remoteLabel testId=`legacy-project-remote-${p.key}`
            CnMachineIcon(kind=p.remoteMachine, size=12, color="light-dark(#71717b, #818181)")
        box position="absolute" right="0.125rem" top="0.25rem" opacity=(revealed ? 1 : 0) pointer-events=(revealed ? "auto" : "none")
          LegacyRowTip(label=legacy.newThreadTip, side="top", align="end", tipId=`legacy-tip-new-${p.key}`, shown=true, relay=innerHover)
            button cursor="pointer" press=run("legacy-new-thread", p.key, "") focus=within(true) blur=within(false) aria-label=p.newThreadLabel testId="new-thread-button" width="1.5rem" height="1.5rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              SidebarIcon(name="square-pen", size=14, color="light-dark(#71717b, #818181)")
      if p.threads.length > 0 or p.showEmpty or p.showMore or p.showLess
        column margin-left="0.25rem" margin-right="0.25rem" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.125rem" padding-bottom="0.125rem" box-sizing="border-box" gap="0.25rem" border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" overflow="hidden" -exact-layout-transition=(reduced ? "none" : "180ms ease-out") -exact-exit-animation=(reduced ? "none" : "lsRowOut 180ms ease-out") role="list" testId=`legacy-threads-${p.key}`
          if p.showEmpty
            row height="2rem" padding-left="0.5rem" padding-right="0.5rem" align-items="center" testId=`legacy-empty-${p.key}`
              text "No threads yet" font-size="0.75rem" line-height="1rem" color="light-dark(#71717bbf, #818181bf)"
          for t in p.threads key=t.dropKey // the scoped thread: kept while an open moves the window to its environment
            LegacyThread(reduced=reduced, t=t, legacy=legacy, page=page, busy=busy, open=open, local=local, run=run, menu=threadMenu)
          if p.showMore
            button cursor="pointer" press=local("legacy-more", p.key, "") testId=`legacy-show-more-${p.key}` height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
              if p.hiddenLabel != ""
                box width="0.875rem" height="0.875rem" display="flex" align-items="center" justify-content="center" flex-shrink=0 role="img" aria-label=p.hiddenLabel
                  box width="0.5625rem" height="0.5625rem" border-radius="0.3125rem" background-color=p.hiddenDot animation=(p.hiddenPulse ? "lsStatusPulse 2s infinite" : "none")
              text "Show more" font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f3f3f3)"
          if p.showLess
            button cursor="pointer" press=local("legacy-less", p.key, "") testId=`legacy-show-less-${p.key}` height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
              text "Show less" font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f3f3f3)"

// SidebarThreadRow: status, the pull request link, title (double-click renames), then the discovered
// port, the worktree glyph, the terminal glyph and the meta slot (remote machine, the ⌘ jump label or the
// relative time), which Archive covers on hover or while the focus is in the row (group-hover and
// group-focus-within: Archive stays in the tab order at opacity 0); with Archive confirmation on, the first
// press shows Confirm, which takes the focus. The row's button is a file drop target (the `t3-row-drop`
// hatch, T3RowDrop.swift: a file drag rings it, a drop opens the thread with the files in its composer).
component LegacyThread
  inject
    hoverTipAt: action
  props
    reduced: bool
    t: LegacyThreadRow
    legacy: LegacySidebarView
    page: string
    busy: bool
    open: action
    local: action
    run: action
    // The sidebar's thread context popover owner (LegacySidebar `threadMenu`).
    menu: action
  state over = false
  state confirming = false
  // The pointer on one of the row's own tooltip triggers (title, pull request, port, worktree, terminal, Archive): the host
  // hovers only the nearest node with a hover handler, so a pointer entering the row on its title would leave the
  // row itself unhovered; the triggers report it here (group-hover holds for the whole row in the reference). A
  // destroyed node hears no leave (Presenter `send`), so each trigger's box stays while its trigger is not drawn
  // (LegacyRowTip `shown`): Archive as the thread starts running or Confirm replaces it, the port, the terminal glyph.
  // Its leave then arrives with the host's hit-test after the layout, also when the row moved away in that batch
  // (a new message re-sorts it to the top). The row's own hover clears it too (the title, which a rename replaces).
  state inner = false
  // The row's control that holds the focus ("row", "pr", "port", "archive", "confirm", "rename"; "" for none). A
  // control that goes away with the focus reports no blur, so only one still drawn counts (group-focus-within).
  state focused = ""
  // When the pointer left the row and its triggers, and when the focus left its controls (performanceNow(); -1
  // while on it). The host moves the hover from the row to a trigger, and the focus from one control to the next,
  // by a leave and an enter at one instant, which is no leave. A real one ends the confirmation (handleMouseLeave;
  // handleBlurCapture, which looks a frame later for the focus in the row).
  state pointerLeft = -1
  state focusLeft = -1
  action hover(value: bool)
    over = value
    if value
      inner = false
      hoverTipAt(legacyTipOff(), "trigger", false)
      if pointerLeft >= 0 and performanceNow() - pointerLeft > 16
        confirming = false
      pointerLeft = -1
    else if not inner
      pointerLeft = performanceNow()
  action innerHover(value: bool)
    inner = value
    if value
      if pointerLeft >= 0 and performanceNow() - pointerLeft > 16
        confirming = false
      pointerLeft = -1
    else if not over
      pointerLeft = performanceNow()
  // The click's modifiers are the press's MouseEvent's (⌘/⇧ select; ⌘ or
  // Ctrl leaves the pull request to the system browser, handlePrClick), not a native click monitor's.
  action openPress(e: MouseEvent)
    open(t.id, e.metaKey ? "click:meta" : (e.shiftKey ? "click:shift" : "click"))
  action prPress(e: MouseEvent)
    run("legacy-pr", t.id, (e.metaKey or e.ctrlKey) ? `mod:${page}` : page)
  action within(name: string, value: bool)
    if value
      if focusLeft >= 0 and performanceNow() - focusLeft > 16
        confirming = false
      focused = name
      focusLeft = -1
    else if focused == name
      focused = ""
      focusLeft = performanceNow()
  // handleRowDoubleClick ignores a double-click on a nested control (a button or a link): no rename. It leaves `focused`
  // to the control's focus and blur: the first click's thread change can move the focus to the composer before it.
  action nested
    stopPropagation()
  // Base UI closes a tooltip as its trigger is pressed (closeOnClick): the row may go at once.
  action archive
    hoverTipAt(legacyTipOff(), "trigger", false)
    if legacy.confirmArchive
      confirming = true
      pointerLeft = -1
      focusLeft = -1
    else
      run("legacy-archive", t.id, "")
  action confirmArchive
    confirming = false
    run("legacy-archive", t.id, "")
  // As Archive's press: the row's menu can archive or delete it, so its tooltip (the title's) goes first. The row's
  // ContextMenu key reaches this through the host's default (exact2 #314), which opens the menu at the row's centre, as
  // Chromium's keyboard contextmenu does; a right press outside the selection clears it (legacy-sidebar-commands `thread-menu`).
  action openMenu
    hoverTipAt(legacyTipOff(), "trigger", false)
    // Chromium focuses the reference's row on a right press (LegacySidebar.tsx:715-717). Writing it is the author's
    // choice, and LLP 1115.000 D7 keeps a focus an action set over D7.1's default.
    focus(`thread-${t.id}`)
    menu(t.id)
    run("legacy-thread-menu", t.id, "")
  derive isOpen = t.active and page == ""
  derive highlighted = isOpen or t.selected
  derive pointed = over or inner
  derive confirmShown = confirming and pointerLeft < 0 and focusLeft < 0 and not t.running and not t.renaming
  derive inside = t.renaming ? focused == "rename" : focused == "row" or (focused == "pr" and t.prIcon != "") or (focused == "port" and t.portLabel != "") or (focused == "archive" and not confirmShown and not t.running) or (focused == "confirm" and confirmShown)
  derive revealed = (pointed or inside) and not t.running
  derive surface = isOpen ? "light-dark(#ffffff, #f1f3f71c)" : t.selected ? "light-dark(#ffffff, #f1f3f712)" : pointed ? "light-dark(#fcfcfc, #f1f3f714)" : "#00000000"
  view
    row id=`legacy-row-${t.id}` width="100%" height="2rem" position="relative" hover=hover -exact-layout-transition=(reduced ? "none" : "180ms ease-out") -exact-exit-animation=(reduced ? "none" : "lsRowOut 180ms ease-out") animation=(t.enter and not reduced ? "lsRowIn 180ms ease-out" : "none") testId=`thread-row-${t.id}`
      if t.renaming
        row width="100%" height="2rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" border-radius="0.375rem" background-color=surface
          LegacyRenameField(t=t, local=local, run=run, within=within)
      else
        button cursor="pointer" press=openPress dblclick=local("legacy-rename-start", t.id, "") contextmenu=openMenu contextPopover="legacy-thread-menu" focus=within("row", true) blur=within("row", false) hatch="t3-row-drop" data-thread-key=t.dropKey data-thread-open=(isOpen ? "1" : "0") aria-label=t.label aria-current=(isOpen ? "page" : "false") testId=`thread-${t.id}` width="100%" height="2rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=surface display="flex" flex-direction="row" align-items="center" id=`thread-${t.id}`
          row flex=1 min-width=0 gap="0.375rem" align-items="center"
            // handlePrClick: the pull request beside the thread, on the Pull Requests page, or as a link (legacy-sidebar-links.ts).
            LegacyRowTip(label=(t.prPending ? "" : t.prTooltip), side="top", align="start", tipId=`legacy-tip-pr-${t.id}`, shown=(t.prIcon != ""), relay=innerHover)
              if t.prIcon != ""
                button cursor="pointer" press=prPress dblclick=nested focus=within("pr", true) blur=within("pr", false) aria-label=t.prTooltip testId=`thread-pr-${t.id}` padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
                  if t.prPending
                    LegacyIcon(name="git-pull-request", size=12, color="light-dark(#71717b, #818181)")
                  else
                    PgIcon(name=t.prIcon, size=12, color=lsPrTone(t.prState))
            if t.statusLabel != ""
              row gap="0.25rem" align-items="center" flex-shrink=0 role="img" aria-label=t.statusLabel testId=`thread-status-${t.id}`
                box width="0.375rem" height="0.375rem" border-radius="0.1875rem" background-color=t.statusDot animation=(t.statusPulse ? "lsStatusPulse 2s infinite" : "none")
                text t.statusLabel font-size="0.625rem" line-height="0.875rem" color=t.statusColor white-space="nowrap"
            // The title's own tooltip (its full text), as the reference's TooltipTrigger around the title span.
            LegacyTitleTip(label=t.title, tipId=`legacy-tip-title-${t.id}`, relay=innerHover)
              text t.title testId=`thread-title-${t.id}` flex=1 min-width=0 font-size="0.875rem" line-height="1.25rem" font-weight=(isOpen ? 500 : 400) color=(highlighted or pointed ? "light-dark(#27272a, #f3f3f3)" : "light-dark(#71717bcc, #818181cc)") line-clamp=1 text-align="left"
          row margin-left="auto" gap="0.375rem" align-items="center" flex-shrink=0
            // handleOpenDiscoveredPort: the first server a terminal of this thread listens on, in a Browser tab beside it.
            LegacyRowTip(label=t.portTip, side="top", align="center", tipId=`legacy-tip-port-${t.id}`, shown=(t.portLabel != ""), relay=innerHover)
              if t.portLabel != ""
                button cursor="pointer" press=run("legacy-port", t.id, "") dblclick=nested focus=within("port", true) blur=within("port", false) aria-label=t.portLabel testId=`thread-port-${t.id}` padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
                  LegacyIcon(name="globe-2", size=12, color="light-dark(#007a55, #00d492)")
            LegacyRowTip(label=t.worktreeLabel, side="top", align="center", tipId=`legacy-tip-worktree-${t.id}`, shown=t.worktree, relay=innerHover)
              if t.worktree
                box flex-shrink=0 display="flex" role="img" aria-label=t.worktreeLabel testId=`thread-worktree-${t.id}`
                  SidebarIcon(name="folder-git-2", size=12, color="light-dark(#71717b66, #81818166)")
            LegacyRowTip(label="Terminal process running", side="top", align="center", tipId=`legacy-tip-terminal-${t.id}`, shown=(t.terminalCount > 0), relay=innerHover)
              if t.terminalCount > 0
                TerminalGlyph(label="Terminal process running", size=12, reduced=reduced, id=`sidebar-terminal-status-${t.id}`)
            row min-width="3rem" justify-content="flex-end" align-items="center" gap="0.25rem" opacity=(revealed or confirmShown ? 0 : 1)
              if t.remoteMachine != ""
                box flex-shrink=0 display="flex" role="img" aria-label=t.remoteLabel testId=`thread-remote-${t.id}`
                  CnMachineIcon(kind=t.remoteMachine, size=12, color="light-dark(#71717b66, #81818166)")
              if t.jump != ""
                text t.jump height="1.25rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="light-dark(#ffffffe6, #0a0a0ae6)" font-family="ui-monospace, monospace" font-size="0.625rem" line-height="1.125rem" font-weight=500 color="light-dark(#27272a, #f3f3f3)" white-space="nowrap" aria-label=t.jump testId=`thread-jump-${t.id}`
              else
                text t.age font-size="0.625rem" line-height="0.875rem" font-variant-numeric="tabular-nums" color=(highlighted ? "light-dark(#27272a, #f3f3f3)" : "light-dark(#71717b, #818181)") white-space="nowrap"
        if confirmShown
          DialogOpenFocus(target=`thread-archive-confirm-${t.id}`)
          button cursor="pointer" press=confirmArchive focus=within("confirm", true) blur=within("confirm", false) autofocus=true id=`thread-archive-confirm-${t.id}` aria-label=`Confirm archive ${t.title}` testId=`thread-archive-confirm-${t.id}` position="absolute" right="0.25rem" top="0.375rem" height="1.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color="light-dark(#e7000b1f, #ff646f2e)" display="flex" flex-direction="row" align-items="center"
            text "Confirm" font-size="0.625rem" line-height="0.875rem" font-weight=500 color="light-dark(#e7000b, #ff646f)"
        // Archive's trigger stays while Confirm replaces it or the thread runs (its leave must arrive: `inner`).
        box position="absolute" right="0.125rem" top="0.25rem" opacity=(revealed ? 1 : 0) pointer-events=(revealed ? "auto" : "none")
          // The tooltip shows only without the confirmation (LegacySidebar.tsx: the confirm path has none).
          LegacyRowTip(label=(legacy.confirmArchive ? "" : "Archive"), side="top", align="center", tipId=`legacy-tip-archive-${t.id}`, shown=(not confirmShown and not t.running), relay=innerHover)
            if not confirmShown and not t.running
              button cursor="pointer" press=archive focus=within("archive", true) blur=within("archive", false) aria-label=`Archive ${t.title}` testId=`thread-archive-${t.id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
                LegacyIcon(name="archive", size=14, color="light-dark(#71717b, #818181)")

// A legacy row's or project header's tooltip trigger (TooltipTrigger; LegacySidebar.tsx's TooltipPopups are portaled to
// the body): the window's hover layer draws the bubble (hover-layer.contract, `legacyTip`), so neither the thread list's
// clip (overflow hidden, for autoAnimate) nor the sidebar's scroll cuts it, as a bubble drawn beside the first row was.
// It tells its row the pointer is on it (`relay`: LegacyThread `inner`, LegacyProject `inner`;
// the host hovers only the nearest node with a hover handler). With `shown` false its box draws nothing (display none;
// the trigger's own `when` is inside) but stays, so a pointer resting on it as its trigger goes hears the leave when the
// host's hit-test after the layout moves the hover: a destroyed node's is dropped (Presenter `send`).
// handleRowContextMenu, handleThreadContextMenu and handleMultiSelectContextMenu (LegacySidebar.tsx:544-592, 2241-2352,
// 1895-1999) as the legacy rows' one
// context popover, as the flat sidebar's ThreadMenu (sidebar-row.contract): macOS presents it as an NSMenu at the
// pointer with the 12pt trash glyph on Delete, as ElectronMenu.ts shows the reference's; the web and the agent paint
// it at the row. A selected row's rows are the multi-selection menu (legacy-sidebar-view.ts `menu`).
component LegacyThreadMenu
  props
    projects: LegacyProjectRow[]
    owner: string
    run: action
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id="legacy-thread-menu" popover="auto" position-try-fallbacks="none" role="menu" class=SidebarMenuCard testId="legacy-thread-menu"
        for p in projects key=p.key
          for t in p.threads key=t.id
            if t.id == owner
              for e in t.menu key=e.id
                if e.separated
                  hr height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" border-width=0 background-color="light-dark(#e4e4e7, #ffffff0f)"
                button press=run("legacy-thread-choice", owner, e.id) popovertarget="legacy-thread-menu" popovertargetaction="hide" role="menuitem" disabled=e.disabled testId=`legacy-thread-menu-${e.id}` class=SidebarMenuItem opacity=(e.disabled ? 0.64 : 1)
                  if e.destructive
                    image "symbol:sf/trash" width=12 height=12 object-fit="contain"
                  text e.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color=(e.destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")

// handleProjectButtonContextMenu (LegacySidebar.tsx:1683-1788) as the project headers' one context popover: Rename,
// Group into…, Copy Path, Project settings, Remove; with several members each targeted row is a submenu of the members
// (LLP 1021 §5.2), its destructive rows with the trash glyph.
component LegacyProjectMenu
  props
    projects: LegacyProjectRow[]
    owner: string
    run: action
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id="legacy-project-menu" popover="auto" position-try-fallbacks="none" role="menu" class=SidebarMenuCard testId="legacy-project-menu"
        for p in projects key=p.key
          if p.key == owner
            for e in p.menu.filter((e) => e.parent == "") key=e.id
              if e.separated
                hr height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" border-width=0 background-color="light-dark(#e4e4e7, #ffffff0f)"
              if e.sub
                button popovertarget=`legacy-project-menu-sub-${e.id}` aria-haspopup="menu" role="menuitem" disabled=e.disabled testId=`legacy-project-menu-${e.id}` class=SidebarMenuItem opacity=(e.disabled ? 0.64 : 1)
                  text e.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
                  text "›" aria-hidden=true font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
              else
                button press=run("legacy-project-choice", owner, e.id) popovertarget="legacy-project-menu" popovertargetaction="hide" role="menuitem" disabled=e.disabled testId=`legacy-project-menu-${e.id}` class=SidebarMenuItem opacity=(e.disabled ? 0.64 : 1)
                  if e.destructive
                    image "symbol:sf/trash" width=12 height=12 object-fit="contain"
                  text e.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color=(e.destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")
      for p in projects key=p.key
        if p.key == owner
          for s in p.menu.filter((e) => e.sub) key=s.id
            column id=`legacy-project-menu-sub-${s.id}` popover="auto" position-try-fallbacks="flip-inline" role="menu" position-area="right span-bottom" class=SidebarMenuCard testId=`legacy-project-menu-sub-${s.id}`
              for e in p.menu.filter((c) => c.parent == s.id) key=e.id
                if e.separated
                  hr height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" border-width=0 background-color="light-dark(#e4e4e7, #ffffff0f)"
                button press=run("legacy-project-choice", owner, e.id) popovertarget="legacy-project-menu" popovertargetaction="hide" role="menuitem" disabled=e.disabled testId=`legacy-project-menu-${e.id}` class=SidebarMenuItem opacity=(e.disabled ? 0.64 : 1)
                  if e.destructive
                    image "symbol:sf/trash" width=12 height=12 object-fit="contain"
                  text e.label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color=(e.destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")

component LegacyRowTip
  inject
    rem: number
    hoverTipAt: action
  props
    label: string
    side: string
    align: string
    tipId: string
    shown: bool
    relay: action
  slot
  action setOver(value: bool)
    relay(value)
    if label != "" or not value
      hoverTipAt(legacyTip(label, side, align, frame(tipId), rem, `${tipId}-bubble`), "trigger", value)
  view
    box id=tipId testId=tipId position="relative" hover=setOver flex-shrink=0 display=(shown ? "flex" : "none") flex-direction="row" align-items="center" min-width=0
      children

// The title's trigger: unlike LegacyRowTip's box it grows and shrinks with the row, so the title still clamps.
component LegacyTitleTip
  inject
    rem: number
    hoverTipAt: action
  props
    label: string
    tipId: string
    relay: action
  slot
  action setOver(value: bool)
    relay(value)
    if label != "" or not value
      hoverTipAt(legacyTip(label, "top", "start", frame(tipId), rem, `${tipId}-bubble`), "trigger", value)
  view
    box id=tipId testId=tipId position="relative" hover=setOver flex=1 min-width=0 display="flex" flex-direction="row" align-items="center"
      children

// The rename field reports its focus to its row (LegacyThread `focused`), which then counts the row button it
// replaced as left.
component LegacyRenameField
  props
    t: LegacyThreadRow
    local: action
    run: action
    within: action
  state title = t.title
  action edit(value: string)
    title = value
  view
    FieldOpenSelect(target=`rename-${t.id}`, length=t.title.length)
    input id=`rename-${t.id}` value=title input=edit submit=run("legacy-rename", t.id, title) blur=run("legacy-rename", t.id, title) focus=within("rename", true) key=local("rename-key", t.id) autofocus=true aria-label="Thread title" testId=`rename-${t.id}` flex=1 min-width=0 height="1.375rem" padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="#00000000" font-size="0.875rem" color="light-dark(#27272a, #f3f3f3)" autocorrect="off"

// The legacy sidebar's dialogs, mounted with the window's overlays (sidebar-overlays.contract):
// Rename project, Project grouping, the project removal confirm and "Archive N threads?".
component LegacyDialogs
  props
    data: Snapshot
    busy: bool
    local: action
    run: action
  view
    DialogFinalFocus(open=(data.legacy.dialog == "rename-project"), owner="legacy-rename-project")
    DialogFinalFocus(open=(data.legacy.dialog == "grouping"), owner="legacy-grouping")
    DialogFinalFocus(open=(data.legacy.dialog == "remove-project"), owner="legacy-remove-project")
    DialogFinalFocus(open=(data.legacy.dialog == "archive-many"), owner="legacy-archive-many")
    if data.legacy.dialog == "rename-project"
      LegacyRenameProject(legacy=data.legacy, busy=busy, local=local, run=run)
    if data.legacy.dialog == "grouping"
      LegacyGroupingDialog(legacy=data.legacy, busy=busy, local=local, run=run)
    if data.legacy.dialog == "remove-project"
      SettingsConfirm(title=data.legacy.dialogTitle, description=data.legacy.dialogDescription, confirmLabel=data.legacy.dialogConfirmLabel, destructive=true, busy=busy, error="", dialogId="legacy-remove-project", cancel=local("legacy-dialog-close", "", ""), confirm=run("legacy-dialog-confirm", "", ""))
    if data.legacy.dialog == "archive-many"
      SettingsConfirm(title=data.legacy.dialogTitle, description="", confirmLabel=data.legacy.dialogConfirmLabel, destructive=false, busy=busy, error="", dialogId="legacy-archive-many", cancel=local("legacy-dialog-close", "", ""), confirm=run("legacy-dialog-confirm", "", ""))

component LegacyDialogFrame
  inject
    dialogSeated: string[]
    dialogEntered: action
    dialogFallback: action
  props
    title: string
    description: string
    label: string
    // The dialog's first Tab stop, for the focus trap (dialog-trap.contract).
    first: string
    busy: bool
    cancel: action
    save: action
  slot
  derive dialogTargets = [first, `${label}-close`]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" testId=`${label}-overlay`
      column position="relative" width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-modal=dialogSeated.includes(label) aria-label=title testId=label id=label tabindex=-1 data-dialog-focus="open" focusin=dialogEntered(label) key=dialogFallback(label, dialogTargets)
        // The focus trap (dialog-trap.contract): the field, Cancel, Save, then the X.
        FocusGuard(guardId="legacy-dialog-guard-start", targets=dialogTargets, popup=label)
        DialogOpenFocus(target=first)
        column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
          text title font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
          column gap="0.75rem" padding-top="0.5rem"
            children
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          button id=`${label}-cancel` cursor="pointer" press=cancel disabled=busy aria-keyshortcuts="Escape" testId=`${label}-cancel` display="flex" flex-direction="row" align-items="center" justify-content="center" height="2.25rem" padding-left="0.8125rem" padding-right="0.8125rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" data-focus-stop=(busy ? "" : "enabled")
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button id=`${label}-save` cursor="pointer" press=save disabled=busy testId=`${label}-save` display="flex" flex-direction="row" align-items="center" justify-content="center" height="2.25rem" padding-left="0.8125rem" padding-right="0.8125rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 opacity=(busy ? 0.64 : 1) background-color="light-dark(#1b4ed8, #346bf1)" data-focus-stop=(busy ? "" : "enabled")
            text "Save" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        // DialogPopup's X (LegacySidebar's dialogs keep showCloseButton), its last child.
        button id=`${label}-close` press=cancel disabled=busy aria-label="Close" testId=`${label}-close` position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop=(busy ? "" : "enabled")
          Icon(name="x", size=16, color="light-dark(#71717b, #818181)")
        FocusGuard(guardId="legacy-dialog-guard-end", targets=dialogTargets, popup=label)

component LegacyRenameProject
  props
    legacy: LegacySidebarView
    busy: bool
    local: action
    run: action
  state title = legacy.dialogField
  action edit(value: string)
    title = value
  action save
    run("legacy-rename-project", legacy.dialogTarget, title)
  view
    LegacyDialogFrame(title=legacy.dialogTitle, description=legacy.dialogDescription, label="legacy-rename-project", first="legacy-project-title", busy=busy, cancel=local("legacy-dialog-close", "", ""), save=save)
      column gap="0.375rem"
        text "Project title" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        input id="legacy-project-title" value=title input=edit submit=save autofocus=true aria-label="Project title" testId="legacy-project-title" height="2rem" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.3125rem" padding-bottom="0.3125rem" line-height="1.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" font-size="0.875rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" data-focus-stop="enabled"
      if legacy.dialogDetail != ""
        text legacy.dialogDetail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

component LegacyGroupingDialog
  props
    legacy: LegacySidebarView
    busy: bool
    local: action
    run: action
  view
    // Base UI's Dialog opens on its popup's first Tab stop, the grouping rule's SelectTrigger (LegacySidebar.tsx:2594).
    LegacyDialogFrame(title=legacy.dialogTitle, description=legacy.dialogDescription, label="legacy-grouping", first="legacy-grouping-rule", busy=busy, cancel=local("legacy-dialog-close", "", ""), save=run("legacy-grouping-save", "", ""))
      column gap="0.375rem"
        text "Grouping rule" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        select id="legacy-grouping-rule" value=legacy.dialogGrouping change=local("legacy-dialog-grouping", "") aria-label="Project grouping rule" testId="legacy-grouping-rule" height="2rem" box-sizing="border-box" font-size="0.875rem" data-focus-stop="enabled"
          option "Use global default" value="inherit"
          option "Group by repository" value="repository"
          option "Group by repository path" value="repository_path"
          option "Keep separate" value="separate"
      text legacy.dialogGroupingDescription font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="legacy-grouping-description"
