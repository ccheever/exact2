use TextProbe from "../composer/composer-label-probes.contract"
// The sidebar's projected rows and view state (sidebar-view.ts).
// Custom snooze's calendar month (snooze-calendar.ts, drawn by snooze-calendar.contract).
shape CalendarDay
  id: string
  label: string
  aria: string
  outside: bool
  disabled: bool
  selected: bool
  today: bool
  stop: bool
shape CalendarWeek
  id: string
  days: CalendarDay[]
shape CalendarWeekday
  id: string
  short: string
  name: string
shape SnoozeCalendar
  dateLabel: string
  title: string
  weekdays: CalendarWeekday[]
  weeks: CalendarWeek[]
  focus: string
  focusSeq: number

shape SnoozePreset
  id: string
  label: string
  wakeLabel: string
  until: string
// ProjectFavicon: an override (monogram, emoji, Lucide) or the favicon image,
// else the automatic monogram; gray inks for a receding slim row (sidebar-glyph.ts).
shape ProjectGlyph
  kind: string
  d: string
  emoji: string
  src: string
  text: string
  ink: string
  surface: string
  gray: string
  graySurface: string
// A row control's tooltip: center x from the sidebar's left (or right) edge, the control's top in the row (sidebar-tips.ts).
shape SidebarRowTip
  name: string
  label: string
  x: number
  fromRight: bool
  top: number
  start: bool
// One row of a context popover menu (sidebar-menu.ts menuRows): `parent` is the submenu row that holds it.
shape SidebarMenuRow
  id: string
  label: string
  parent: string
  sub: bool
  disabled: bool
  check: bool
  checked: bool
  destructive: bool
  separated: bool
shape SearchPart
  id: string
  text: string
  hit: bool
shape Thread
  // The title's direction ("ltr", "rtl": textDirection's majority), and the rename field's (its first strong letter).
  titleDir: string
  renameDir: string
  // The branch cut for middle truncation (details/middle-truncate.ts): the head, and the tail it keeps ("" for none).
  branchHead: string
  branchTail: string
  terminalCount: number
  terminalLabel: string
  id: string
  // Working's start (epoch ms; the label ticks from the root clock) and a background environment's machine glyph.
  workingSince: number
  remoteMachine: string
  // A "No project" thread's machine glyph and label, in the branch's place, when the projects span machines.
  scratchMachine: string
  scratchLabel: string
  // A search result's matching pull request: its number, lifecycle state ('' unknown) and accessible label.
  searchPr: string
  searchPrIcon: string
  searchPrState: string
  searchPrLabel: string
  title: string
  projectName: string
  projectMark: string
  projectInk: string
  projectSurface: string
  projectGray: string
  projectGraySurface: string
  providerDriver: string
  providerBadge: string
  providerBadgeColor: string
  providerName: string
  providerIcon: string
  age: string
  badge: string
  stacked: bool
  badgeIcon: string
  badgeState: string
  section: string
  status: string
  selected: bool // the open thread's row, or its ancestor's while a subagent is open
  routeThread: bool // the open thread itself (a drop on it attaches without opening)
  searchFirst: bool
  matchLabel: string
  matchUser: bool
  matchParts: SearchPart[]
  card: bool
  metaEmpty: bool // a card with no branch, machine, pull request, remote glyph or terminal: two lines, its provider beside the title
  statusIcon: string
  statusColor: string
  duration: string
  titleColor: string
  titleWeight: number
  recede: bool
  pinned: bool
  canPin: bool
  canSettle: bool
  canSnooze: bool
  canUnsettle: bool
  canWake: bool
  wakeLabel: string
  woke: bool
  branch: string
  worktree: bool
  draft: bool
  jump: string
  renaming: bool
  multi: bool
  regenerating: bool
  label: string
  hoverKey: string
  rowKey: string // the thread with its environment, kept when the window moves there (sidebar-view.ts scopedRowKey)
  glyph: ProjectGlyph
  idleRecede: bool
  idleTitleColor: string
  idleTitleWeight: number
  tips: SidebarRowTip[]
  hoverEnvironment: string
  hoverMachine: string
  hoverModel: string
  hoverHandoff: string
  hoverError: string
  hoverErrorWarning: bool
  // handleThreadContextMenu's items, or the bulk menu's on a selected row (the row's context popover).
  menu: SidebarMenuRow[]
  // The row's own environment's snooze options (SidebarThreadRow's), none while it cannot snooze.
  snoozePresets: SnoozePreset[]
// A row of the sidebar's tree (sidebar-view.ts sidebarTree), by element id; `expanded` is "true" or "false" on a shelf header.
shape SidebarTreeRow
  id: string
  parent: string
  expanded: string
// UpdateEverythingDialog (update-everything.ts updateEverythingDialog): a row per machine that updates.
shape UpdateDialogRow
  id: string
  label: string
  app: string // "This app", "Server", "Desktop app", or "" for a provider-only machine
  skipped: bool
  restartsLast: bool
  providers: string
  running: string // "2 running" when its restart interrupts threads
shape UpdateDialogSkipped
  id: string
  label: string
  reason: string
shape UpdateDialogView
  open: bool
  title: string
  version: string
  providers: string
  rows: UpdateDialogRow[]
  skippedRows: UpdateDialogSkipped[]
  skippedOpen: bool
  warning: string
shape SidebarScope
  key: string
  label: string
  mark: string
  ink: string
  surface: string
  selected: bool
  all: bool
  glyph: ProjectGlyph
shape SidebarDraft
  id: string
  projectName: string
  mark: string
  ink: string
  surface: string
  preview: string
  glyph: ProjectGlyph
  // handleDraftContextMenu's items (the row's context popover).
  menu: SidebarMenuRow[]
shape SidebarView
  drafts: SidebarDraft[]
  // A row shows Working, or a Working grace waits (the root's one-second clock runs); the texts its tooltips are placed
  // by (project-scripts.contract).
  ticking: bool
  // The soonest Working grace's end in window time, 0 for none (thread-inbox.ts).
  graceUntil: number
  graceOwed: number
  probes: TextProbe[]
  searching: bool
  searchPending: bool
  searchIndex: number
  searchSelectedId: string
  settledCount: number
  snoozedCount: number
  workingCount: number
  settledExpanded: bool
  snoozedExpanded: bool
  workingExpanded: bool
  showMore: number
  emptyText: string
  emptyAddProject: bool
  hasProjects: bool
  projectGroupCount: number
  dragEnabled: bool
  scopeKey: string
  scopeLabel: string
  scopeMark: string
  scopeInk: string
  scopeSurface: string
  scopeGlyph: ProjectGlyph
  scopeGlyphSecond: ProjectGlyph
  scopeCount: number
  scopes: SidebarScope[]
  scopeOpen: bool
  scopeQuery: string
  scopeFirst: string
  renameId: string
  renameTitle: string
  renameHeld: bool // a double-click's rename waits for its row's environment (sidebar-rename-wait.ts)
  selectionCount: number
  undoText: string
  undoShort: string // the footer's summary: "Settled," or "Settled 2,"
  undoLabel: string
  undoUntil: number
  dialog: string
  dialogTitle: string
  dialogDescription: string
  dialogMode: string
  dialogDate: string
  dialogAmount: string
  dialogUnit: string
  dialogTime: string
  dialogError: string
  // The `id` a closed dialog gives the focus back to (its thread's row), "" for none.
  dialogReturn: string
  // Custom snooze's date button and its calendar popover (snooze-calendar.ts).
  calendar: SnoozeCalendar
  jumpModifiers: string[]
  pillKey: string
  pillTone: string
  pillTitle: string
  pillDescription: string
  pillDismissible: bool
  // A timed provider pill's end in window time (its countdown bar runs to it), 0 for one that stays.
  pillUntil: number
  // Upstream 1826fb55cc: a released row-action sweep bumps it, ending the section's sweep.
  sweepEpoch: number
  // The open row while it is listed (each mount of the sidebar scrolls to it), and again while a route change owes its
  // scroll (route-reveal.ts).
  tree: SidebarTreeRow[]
  treeCurrent: string
  updateDialog: UpdateDialogView
  revealRow: string
  revealPending: string
