use R5Probe from "../composer/composer-label-probes.contract"
// The sidebar's projected rows and view state (sidebar-view.ts).
// Custom snooze's calendar month (snooze-calendar.ts, drawn by snooze-calendar.contract).
shape CalendarDay
  id: string
  label: string
  aria: string
  outside: bool
  disabled: bool
  selected: bool
  today: bool
  stop: bool
shape CalendarWeek
  id: string
  days: CalendarDay[]
shape CalendarWeekday
  id: string
  short: string
  name: string
shape SnoozeCalendar
  dateLabel: string
  title: string
  weekdays: CalendarWeekday[]
  weeks: CalendarWeek[]
  focus: string
  focusSeq: number

shape SnoozePreset
  id: string
  label: string
  wakeLabel: string
  until: string
// ProjectFavicon: an override (monogram, emoji, Lucide) or the favicon image,
// else the automatic monogram; gray inks for a receding slim row (sidebar-glyph.ts).
shape ProjectGlyph
  kind: string
  d: string
  emoji: string
  src: string
  text: string
  ink: string
  surface: string
  gray: string
  graySurface: string
// A row control's tooltip: center x from the sidebar's left (or right) edge, the control's top in the row (sidebar-tips.ts).
shape SidebarRowTip
  name: string
  label: string
  x: number
  fromRight: bool
  top: number
  start: bool
// One row of a context popover menu (sidebar-menu.ts menuRows): `parent` is the submenu row that holds it.
shape SidebarMenuRow
  id: string
  label: string
  parent: string
  sub: bool
  disabled: bool
  check: bool
  checked: bool
  destructive: bool
  separated: bool
shape SearchPart
  id: string
  text: string
  hit: bool
shape Thread
  terminalCount: number
  terminalLabel: string
  id: string
  // Working's start (epoch ms; the label ticks from the root clock) and a background environment's machine glyph.
  workingSince: number
  remoteMachine: string
  title: string
  projectName: string
  projectMark: string
  projectInk: string
  projectSurface: string
  projectGray: string
  projectGraySurface: string
  providerDriver: string
  providerBadge: string
  providerBadgeColor: string
  providerName: string
  age: string
  badge: string
  stacked: bool
  badgeIcon: string
  badgeState: string
  section: string
  status: string
  selected: bool
  searchFirst: bool
  matchLabel: string
  matchUser: bool
  matchParts: SearchPart[]
  card: bool
  statusIcon: string
  statusColor: string
  duration: string
  titleColor: string
  titleWeight: number
  recede: bool
  pinned: bool
  canPin: bool
  canSettle: bool
  canSnooze: bool
  canUnsettle: bool
  canWake: bool
  wakeLabel: string
  woke: bool
  branch: string
  worktree: bool
  draft: bool
  jump: string
  renaming: bool
  multi: bool
  regenerating: bool
  label: string
  hoverKey: string
  rowKey: string // the thread with its environment, kept when the window moves there (sidebar-view.ts scopedRowKey)
  glyph: ProjectGlyph
  idleRecede: bool
  idleTitleColor: string
  idleTitleWeight: number
  tips: SidebarRowTip[]
  hoverEnvironment: string
  hoverMachine: string
  hoverModel: string
  hoverHandoff: string
  hoverError: string
  hoverErrorWarning: bool
  // handleThreadContextMenu's items, or the bulk menu's on a selected row (the row's context popover).
  menu: SidebarMenuRow[]
shape SidebarScope
  key: string
  label: string
  mark: string
  ink: string
  surface: string
  selected: bool
  all: bool
  glyph: ProjectGlyph
shape SidebarDraft
  id: string
  projectName: string
  mark: string
  ink: string
  surface: string
  preview: string
  glyph: ProjectGlyph
  // handleDraftContextMenu's items (the row's context popover).
  menu: SidebarMenuRow[]
shape SidebarView
  drafts: SidebarDraft[]
  // A row shows Working (the root's one-second clock runs); the texts its tooltips are placed by (project-scripts.contract).
  ticking: bool
  probes: R5Probe[]
  searching: bool
  searchPending: bool
  searchIndex: number
  searchSelectedId: string
  settledCount: number
  snoozedCount: number
  workingCount: number
  settledExpanded: bool
  snoozedExpanded: bool
  workingExpanded: bool
  showMore: number
  emptyText: string
  emptyAddProject: bool
  hasProjects: bool
  projectGroupCount: number
  dragEnabled: bool
  scopeKey: string
  scopeLabel: string
  scopeMark: string
  scopeInk: string
  scopeSurface: string
  scopeGlyph: ProjectGlyph
  scopes: SidebarScope[]
  scopeOpen: bool
  scopeQuery: string
  scopeFirst: string
  renameId: string
  renameTitle: string
  renameHeld: bool // a double-click's rename waits for its row's environment (sidebar-rename-wait.ts)
  selectionCount: number
  undoText: string
  undoLabel: string
  undoUntil: number
  dialog: string
  dialogTitle: string
  dialogDescription: string
  dialogMode: string
  dialogDate: string
  dialogAmount: string
  dialogUnit: string
  dialogTime: string
  dialogError: string
  // The `id` a closed dialog gives the focus back to (its thread's row), "" for none.
  dialogReturn: string
  // Custom snooze's date button and its calendar popover (snooze-calendar.ts).
  calendar: SnoozeCalendar
  jumpHints: bool
  pillKey: string
  pillTone: string
  pillTitle: string
  pillDescription: string
  pillDismissible: bool
  // Upstream 1826fb55cc: a released row-action sweep bumps it, ending the section's sweep.
  sweepEpoch: number
