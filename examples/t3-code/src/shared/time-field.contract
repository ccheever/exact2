// Chromium's `input type="time"` as T3 Code v0.1.6 shows it (MIT reference, see LICENSE-T3): ui/input.tsx's
// `nativeInput` field holding Electron's own time editor. The fields are `h:mm a` in the en-US locale: the hour and
// minutes zero-padded, a space, AM or PM, each a spinbutton with 1 pt of padding that takes the Highlight fill while
// focused; empty parts read "--". The clock button (`::-webkit-calendar-picker-indicator`: a 14.7 pt glyph in 3 pt of
// padding, 8 pt after the fields, at the content box's end) opens Chromium's time picker: three columns of 36 pt
// cells under the field's start, each rotated to start at the value it opened on, where a click or an arrow sets
// that part at once and Enter closes it.
//
// The value is HTML's, `HH:MM` on a 24-hour clock or "" while a part is empty, and `commit` hears every change, as
// an input's `change` does: a key's on its release, a picked cell's at once. A host's `input type="time"` is the
// platform's control (an NSDatePicker on the Mac), so the clone draws Chromium's here.
//
// Keys, as Chromium's DateTimeEditElement takes them: digits fill the focused part and move on once no further
// digit could follow (a second digit within a second of the first joins it), Up and Down step it with wrap-around,
// Left and Right move between the parts, Backspace and Delete clear it, A and P choose the meridiem, and Alt+Down
// opens the picker.

fn timeHour24(value: string): number = value.length == 5 ? (match parseNumber(value.slice(0, 2)) { case some(n) => n, case none => -1 }) : -1
fn timeMinute(value: string): number = value.length == 5 ? (match parseNumber(value.slice(3, 5)) { case some(n) => n, case none => -1 }) : -1
fn timeHour12(h24: number): number = h24 < 0 ? -1 : (h24 % 12 == 0 ? 12 : h24 % 12)
fn timeMeridiem(h24: number): number = h24 < 0 ? -1 : (h24 >= 12 ? 1 : 0)
fn timePad(n: number): string = n < 0 ? "--" : (n < 10 ? `0${n}` : `${n}`)
fn timeValue(h: number, m: number, a: number): string = (h < 0 or m < 0 or a < 0) ? "" : `${timePad(h % 12 + a * 12)}:${timePad(m)}`
fn timeMeridiemLabel(a: number): string = a < 0 ? "--" : (a == 1 ? "PM" : "AM")
// One step of a part, wrapping: an empty hour steps to 1 or 12, an empty minute to 0 or 59, an empty meridiem to AM.
fn timeStep(part: string, n: number, by: number): number = part == "h" ? (n < 0 ? (by > 0 ? 1 : 12) : (n - 1 + by + 12) % 12 + 1) : (part == "m" ? (n < 0 ? (by > 0 ? 0 : 59) : (n + by + 60) % 60) : (n < 0 ? 0 : 1 - n))

component TimeField
  props
    fieldId: string
    value: string
    label: string
    width: string
    height: string
    padding: string
    radius: string
    edge: string
    fill: string
    ink: string
    shadow: string
    disabled: bool
    stop: string
    testId: string
    commit: action
  // The parts as last edited here, shown while the value is what that edit committed or what it was before it (a
  // reply in flight); any other value replaces them.
  state editH = -1
  state editM = -1
  state editA = -1
  state editedTo = ""
  state editedFrom = ""
  state edited = false
  state pending = false
  state focusedPart = ""
  state typed = ""
  state typedPart = ""
  state typedAt = -10000
  // The picker: the part whose column has the focus, and the values its columns start at.
  state pickerPart = ""
  state startH = 12
  state startM = 0
  state startA = 0
  state opens = 0
  derive local = edited and (value == editedTo or value == editedFrom)
  derive h = local ? editH : timeHour12(timeHour24(value))
  derive m = local ? editM : timeMinute(value)
  derive a = local ? editA : timeMeridiem(timeHour24(value))
  derive pickerId = `${fieldId}-picker`
  derive hours = range(12).map((i) => (startH - 1 + i) % 12 + 1)
  derive minutes = range(60).map((i) => (startM + i) % 60)
  derive meridiems = [startA, 1 - startA]
  derive ringed = focusedPart != "" or pickerPart != ""
  action assign(nh: number, nm: number, na: number)
    let next = timeValue(nh, nm, na)
    editedFrom = local ? editedFrom : value
    editH = nh
    editM = nm
    editA = na
    editedTo = next
    edited = true
    pending = next != value
  // The change goes out on the key's release, from an action of its own: an action and the actions it calls are one
  // body, and a caller's `commit` (Settings' coreChange) leaves room for little else.
  action flush(k: string)
    if pending
      pending = false
      commit(editedTo)
  // A cell's press sets its part and commits at once.
  action pick(part: string, v: number)
    let next = timeValue(part == "h" ? v : h, part == "m" ? v : m, part == "a" ? v : a)
    editedFrom = local ? editedFrom : value
    editH = part == "h" ? v : h
    editM = part == "m" ? v : m
    editA = part == "a" ? v : a
    editedTo = next
    edited = true
    if next != value
      commit(next)
  action partFocus(part: string)
    focusedPart = part
    typed = ""
  action partBlur(part: string)
    if focusedPart == part
      focusedPart = ""
    typed = ""
  // A click on the field's ground focuses the hour, as Chromium's field does from its start.
  action groundPress
    if not disabled
      focus(`${fieldId}-h`)
  action openPicker
    if not disabled
      startH = h < 0 ? 12 : h
      startM = m < 0 ? 0 : m
      startA = a < 0 ? 0 : a
      pickerPart = "h"
      opens = opens + 1
      showPopover(pickerId, source=fieldId)
      focus(`${pickerId}-h`)
  // Each key sets at most one part, through one `assign`.
  action partKey(part: string, k: string, e: KeyboardEvent)
    let plain = not e.metaKey and not e.ctrlKey and not e.altKey
    let stepping = plain and (k == "ArrowUp" or k == "ArrowDown")
    let clearing = plain and (k == "Backspace" or k == "Delete")
    let digit = plain and part != "a" and k.length == 1 and "0123456789".includes(k)
    let meridiem = plain and part == "a" and k.length == 1 and "aApP".includes(k)
    if not e.metaKey and not e.ctrlKey and e.altKey and k == "ArrowDown"
      preventDefault()
      openPicker()
    else if plain and (k == "ArrowLeft" or k == "ArrowRight")
      preventDefault()
      typed = ""
      if k == "ArrowRight" and part != "a"
        focus(part == "h" ? `${fieldId}-m` : `${fieldId}-a`)
      else if k == "ArrowLeft" and part != "h"
        focus(part == "a" ? `${fieldId}-m` : `${fieldId}-h`)
    else if stepping or clearing or digit or meridiem
      preventDefault()
      let most = part == "h" ? 12 : 59
      let least = part == "h" ? 1 : 0
      let joined = typedPart != part or performanceNow() - typedAt > 1000 ? k : typed + k
      let n = match parseNumber(joined) { case some(v) => v, case none => -1 }
      let use = joined.length == 2 and (n < least or n > most) ? k : joined
      let u = match parseNumber(use) { case some(v) => v, case none => -1 }
      let done = digit and (use.length == 2 or u * 10 > most)
      let current = part == "h" ? h : (part == "m" ? m : a)
      let next = stepping ? timeStep(part, current, k == "ArrowUp" ? 1 : -1) : (clearing ? -1 : (meridiem ? (k == "a" or k == "A" ? 0 : 1) : (u >= least ? u : current)))
      typed = digit and not done ? use : ""
      typedPart = part
      typedAt = performanceNow()
      assign(part == "h" ? next : h, part == "m" ? next : m, part == "a" ? next : a)
      if done
        focus(part == "h" ? `${fieldId}-m` : `${fieldId}-a`)
  // The picker's column keys: Up and Down set the part, Left and Right move between columns, Enter closes.
  action pickerKey(part: string, k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey
      if k == "ArrowUp" or k == "ArrowDown"
        preventDefault()
        let next = timeStep(part, part == "h" ? h : (part == "m" ? m : a), k == "ArrowUp" ? -1 : 1)
        assign(part == "h" ? next : h, part == "m" ? next : m, part == "a" ? next : a)
      else if k == "ArrowLeft" or k == "ArrowRight"
        preventDefault()
        let next = k == "ArrowRight" ? (part == "h" ? "m" : "a") : (part == "a" ? "m" : "h")
        pickerPart = next
        focus(`${pickerId}-${next}`)
      else if k == "Enter"
        preventDefault()
        hidePopover(pickerId)
  action pickerFocus(part: string)
    pickerPart = part
  action pickerToggled(e: ToggleEvent)
    if e.newState == "closed"
      pickerPart = ""
  view
    box position="relative" width=width flex-shrink=0
      row id=fieldId press=groundPress role="group" aria-label=label testId=testId width="100%" height=height box-sizing="border-box" padding-left=padding padding-right=padding border-radius=radius border-width=1 border-style="solid" border-color=(ringed ? "light-dark(#1b4ed8, #346bf1)" : edge) background-color=fill box-shadow=(ringed ? "inset 0 0 0 3px light-dark(#1b4ed83d, #346bf13d)" : shadow) align-items="center" opacity=(disabled ? 0.64 : 1)
        row align-items="center" flex-shrink=0
          TimeFieldPart(partId=`${fieldId}-h`, part="h", label="Hours", text=timePad(h), now=h, least=1, most=12, focused=(focusedPart == "h"), ink=ink, disabled=disabled, stop=stop, focusAct=partFocus("h"), blurAct=partBlur("h"), keyAct=partKey("h"), upAct=flush)
          text ":" font-size="0.875rem" color=ink white-space="pre"
          TimeFieldPart(partId=`${fieldId}-m`, part="m", label="Minutes", text=timePad(m), now=m, least=0, most=59, focused=(focusedPart == "m"), ink=ink, disabled=disabled, stop=stop, focusAct=partFocus("m"), blurAct=partBlur("m"), keyAct=partKey("m"), upAct=flush)
          text " " font-size="0.875rem" color=ink white-space="pre"
          TimeFieldPart(partId=`${fieldId}-a`, part="a", label="AM/PM", text=timeMeridiemLabel(a), now=(a < 0 ? -1 : a + 1), least=1, most=2, focused=(focusedPart == "a"), ink=ink, disabled=disabled, stop=stop, focusAct=partFocus("a"), blurAct=partBlur("a"), keyAct=partKey("a"), upAct=flush)
        box flex=1 min-width=0
        button id=`${fieldId}-clock` press=openPicker disabled=disabled aria-label="Show time picker" aria-haspopup="menu" title="" testId=`${testId}-picker` flex-shrink=0 margin-left="0.5rem" width="1.2934rem" height="1.2934rem" padding=0 border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center" data-focus-stop=(disabled ? "" : stop)
          svg width="0.9184rem" height="0.9184rem" viewBox="0 0 24 24" fill="none" aria-hidden=true
            circle cx=12 cy=12 r=8.8 stroke="light-dark(#000000, #ffffff)" stroke-width=2
            path d="M12 6.7V12.5l3.9 3" stroke="light-dark(#000000, #ffffff)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
      // Chromium's picker popup: its own window under the field's start, a 1 pt frame outside a 172 × 260 pt page.
      row id=pickerId popover="auto" toggle=pickerToggled position="absolute" position-area="bottom span-right" position-try-fallbacks="flip-block" margin-left="-0.0625rem" margin-top="-0.125rem" padding="0.25rem" gap="0.25rem" box-sizing="content-box" border-width=1 border-style="solid" border-color="light-dark(#c6c6c6, #4b4b4b)" background-color="light-dark(#ffffff, #3b3b3b)" box-shadow="0 4px 12px #00000040" role="dialog" aria-label="Time picker" testId=`${testId}-popup`
        for opened in [opens] key=opened
          TimePickerColumn(columnId=`${pickerId}-h`, label="Hours", values=hours, labels=hours.map((v) => timePad(v)), chosen=h, focused=(pickerPart == "h"), keyAct=pickerKey("h"), upAct=flush, focusAct=pickerFocus("h"), pick=pick("h"))
          TimePickerColumn(columnId=`${pickerId}-m`, label="Minutes", values=minutes, labels=minutes.map((v) => timePad(v)), chosen=m, focused=(pickerPart == "m"), keyAct=pickerKey("m"), upAct=flush, focusAct=pickerFocus("m"), pick=pick("m"))
          TimePickerColumn(columnId=`${pickerId}-a`, label="AM/PM", values=meridiems, labels=meridiems.map((v) => timeMeridiemLabel(v)), chosen=a, focused=(pickerPart == "a"), keyAct=pickerKey("a"), upAct=flush, focusAct=pickerFocus("a"), pick=pick("a"))

// One part of the field: a spinbutton whose border box takes the Highlight fill while it has the focus.
component TimeFieldPart
  props
    partId: string
    part: string
    label: string
    text: string
    now: number
    least: number
    most: number
    focused: bool
    ink: string
    disabled: bool
    stop: string
    focusAct: action
    blurAct: action
    keyAct: action
    upAct: action
  view
    box id=partId tabindex=(disabled ? -1 : 0) focus=focusAct blur=blurAct key=keyAct keyup=upAct role="spinbutton" aria-label=label aria-valuemin=least aria-valuemax=most aria-valuenow=max(now, least) aria-valuetext=text padding-left=1 padding-right=1 background-color=(focused ? "light-dark(#bad5fa, #a3c7fa)" : "#00000000") testId=partId data-focus-stop=(disabled ? "" : stop)
      text text font-size="0.875rem" color=(focused ? "#000000" : ink) white-space="pre"

// One column of the picker: 52 × 36 pt cells in a 252 pt scroller with no bar, the chosen one filled and bold. On a
// dark page Chromium rings every chosen cell in white; on a light one only the focused column's, in black.
component TimePickerColumn
  props
    columnId: string
    label: string
    values: number[]
    labels: string[]
    chosen: number
    focused: bool
    keyAct: action
    upAct: action
    focusAct: action
    pick: action
  view
    scroll id=columnId tabindex=0 key=keyAct keyup=upAct focus=focusAct role="listbox" aria-label=label width="3.25rem" height="15.75rem" scrollbar-width="none" overflow-x="hidden" testId=columnId
      column width="100%"
        for i in range(values.length) key=i
          TimePickerCell(text=(match labels.at(i) { case some(t) => t, case none => "" }), value=(match values.at(i) { case some(v) => v, case none => -1 }), chosen=chosen, focused=focused, pick=pick)

component TimePickerCell
  props
    text: string
    value: number
    chosen: number
    focused: bool
    pick: action
  derive on = value == chosen
  view
    button press=pick(value) tabindex=-1 role="option" aria-selected=on aria-label=text title="" width="100%" height="2.25rem" flex-shrink=0 padding=0 box-sizing="border-box" border-radius="0.1875rem" border-width=(on ? 2 : 0) border-style="solid" border-color=(on ? (focused ? "light-dark(#101010, #ffffff)" : "light-dark(#3273f6, #ffffff)") : "#00000000") background-color=(on ? "light-dark(#3273f6, #a3c7fa)" : "#00000000") display="flex" align-items="center" justify-content="center"
      text text font-family="Arial, Helvetica" font-size="0.875rem" font-weight=(on ? 700 : 400) color=(on ? "light-dark(#ffffff, #3b3b3b)" : "light-dark(#101010, #ffffff)")
