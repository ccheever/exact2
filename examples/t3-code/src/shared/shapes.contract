use InlineDocument from "../timeline/inline-documents.contract"
use CommandSpan from "../timeline/command-output.contract"
use SecretCardView from "../timeline/secret-card.contract"
use TimelineApproval from "../timeline/timeline-approval.contract"
use CodeToken from "../timeline/markdown.contract"
use DiffFindView, FindDiffSegment from "../diff/diff-find.contract"
use CodeHighlight from "../timeline/markdown.contract"
use MermaidDiagram from "../timeline/mermaid-frame.contract"
use MathFrame from "../timeline/markdown-math.contract"
use MarkdownEnv from "../timeline/markdown.contract"
use ChatLinkMenu from "../timeline/link-menus.contract"
use WorktreeSetupView from "../timeline/timeline-worktree-shapes.contract"
use MinimapItem from "../timeline/timeline-minimap.contract"
use FindLine from "../timeline/thread-find.contract"
use MessageImage from "../timeline/timeline-attachments.contract"
use MessageFile from "../timeline/timeline-attachments.contract"
use ComposerView from "../composer/composer-shapes.contract"
use Thread from "../sidebar/sidebar-shapes.contract"
use ChatGptPlanNotice from "../providers/codex-setup.contract"
use SidebarView from "../sidebar/sidebar-shapes.contract"
use Look from "../appearance/settings-appearance-look.contract"
use ComposerVideo from "../composer/composer-video.contract"
use ComposerVideoPreview from "../composer/composer-video.contract"
use ComposerImagePreview from "../composer/composer-chip-image.contract"
use TableMenuView from "../timeline/table-menu.contract"
shape Project
  id: string
  name: string
  path: string
  selected: bool
shape CheckpointFile
  id: string
  path: string
  additions: number
  deletions: number
  kind: string
  name: string
  depth: number
  expanded: bool
  icon: string
  spacer: bool
  plus: string
  minus: string
shape MarkdownSkill
  name: string
  displayName: string
// One V2ItemInspector list item: a file search result ("file": path and
// line over its preview), a web result ("web": its title, a link when href is set, over its snippet)
// or one change of a file edit ("change").
shape InspectorResult
  id: string
  kind: string
  label: string
  href: string
  preview: string
shape ToolImage
  id: string
  name: string
  source: string
shape ReplArgument
  id: string
  key: string
  text: string
  tokens: CodeToken[]
shape Activity
  replArguments: ReplArgument[]
  terminal: bool
  terminalTruncated: bool
  terminalSpans: CommandSpan[]
  toolImages: ToolImage[]
  id: string
  label: string
  body: string
  icon: string
  output: string
  outputState: string
  detailOpen: bool
  iconLight: string
  iconDark: string
  result: string
  failed: bool
  timestamp: string
  tone: string
  ok: bool
  reasoning: bool
  expandable: bool
  detail: string
  status: string
  targetId: string
  answer: string
  // The full date under the hover time (formatChatTimestampTooltip).
  timeTip: string
  // Upstream 737993303d: the failed run a workspace preparation Retry prepares again.
  retryRunId: string
  // The inspector's results, and a file change's path, +/- counts and Open diff.
  results: InspectorResult[]
  changePath: string
  stats: bool
  additions: number
  deletions: number
  diffRunId: string
  diffPath: string
  // SubagentAvatar's driver mark (`detail` is the driver) and a live agent's start (ms; 0 when settled).
  initials: string
  driverIcon: string
  modelLine: string
  effort: string
  speed: string
  speedLabel: string
  startedMs: number
  // The trailing button's text for targetId ("Open chat" for a created thread, "Open subagent").
  targetLabel: string
  // A thread read's label in parts (`<linkPrefix> “<linkTitle>”`); the title opens linkThreadId.
  linkPrefix: string
  linkTitle: string
  linkThreadId: string
  // A handoff endpoint's instance badge (shouldShowInstanceBadge): its initials and accent ("" for none).
  badge: string
  badgeColor: string
shape Message
  id: string
  kind: string
  title: string
  body: string
  checkpointId: string
  checkpointOrdinal: number
  additions: number
  deletions: number
  files: CheckpointFile[]
  runId: string
  sourceThreadId: string
  canFork: bool
  completed: bool
  createdAt: string
  timestamp: string
  activities: Activity[]
  first: bool
  attached: bool
  // The row hover this row shares (an attached changed-files card takes its answer's).
  hoverKey: string
  actionsId: string
  actionsFork: bool
  actionsTime: string
  expanded: bool
  last: bool
  icon: string
  tone: string
  failed: bool
  live: bool
  startedMs: number
  // A settled subagent group's fixed elapsed time ("1m 05s").
  elapsed: string
  detail: string
  status: string
  groupId: string
  continues: bool
  revert: number
  intent: string
  intentTip: string
  attribution: string
  // A folded automation or agent message's one line (its task title or first line).
  summary: string
  // A queued automation or agent message's fold heading ("Automation", or the sending thread's title).
  sender: string
  targetId: string
  actionLabel: string
  copied: number
  copyFailed: bool
  meta: bool
  collapsible: bool
  code: CodeHighlight[]
  diagrams: MermaidDiagram[]
  inlineDocuments: InlineDocument[]
  setup: WorktreeSetupView[]
  timeTip: string
  actionsTimeTip: string
  codeCopied: string
  codeCopyNonce: number
  fileCount: number
  images: MessageImage[]
  attachFiles: MessageFile[]
  // A sent message's sounds, each an audio chip (timeline-audio.contract).
  audio: MessageFile[]
  // Code font/size, word wrap and the message's chips (message-chips.ts).
  md: MarkdownEnv
  secret: SecretCardView[]
  // A pending approval answerable on its work row (timeline-approvals.ts).
  approval: TimelineApproval[]
  // A workflow opening's title, description and phase titles with the thread find's matches marked.
  findLines: FindLine[]
shape Provider
  id: string
  name: string
  available: bool
shape Model
  id: string
  name: string
  providerId: string
  selected: bool
shape ModelOption
  id: string
  label: string
  value: string
  selected: bool
  default: bool
shape ApprovalOption
  id: string
  label: string
  warning: string
  primary: bool
shape Approval
  id: string
  label: string
  appName: string
  count: string
  mono: bool
  detail: string
  // The composer's presentation (requests.ts) carries these too; a snapshot field outside its shape refuses it whole.
  reason: string
  whyAsked: string
  feedback: bool
  canRespond: bool
  operable: bool
  live: bool
  responding: bool
  responseReason: string
  options: ApprovalOption[]
  more: ApprovalOption[]
shape QuestionOption
  id: string
  label: string
  description: string
  selected: bool
  shortcut: string
shape Question
  id: string
  requestId: string
  header: string
  question: string
  multiSelect: bool
  canRespond: bool
  operable: bool
  live: bool
  responding: bool
  dismissible: bool
  responseReason: string
  customAllowed: bool
  answer: string
  position: string
  index: number
  last: bool
  canAdvance: bool
  // An image of this question's answer still uploads: Next and Submit wait (ChatComposer's attachmentBlockReason).
  uploading: bool
  complete: bool
  action: string
  options: QuestionOption[]
  md: MarkdownEnv
shape DiffSegment
  id: string
  text: string
  mark: bool
  syntax: string
shape DiffTurn
  id: string
  label: string
  time: string
  selected: bool
shape DiffFile
  id: string
  name: string
  path: string
  status: string
  letter: string
  additions: number
  deletions: number
  markdown: bool
// One row of the Diff panel's comparison target picker: a ref, its value, the remote column ("switch", "only" or "") and the ref its switch picks.
shape DiffBaseRef
  id: string
  label: string
  value: string
  remote: string
  remoteOn: bool
  other: string
  selected: bool
shape DiffItem
  id: string
  kind: string
  path: string
  name: string
  status: string
  letter: string
  additions: number
  deletions: number
  expanded: bool
  markdown: bool
  tone: string
  number: string
  segments: FindDiffSegment[]
  leftTone: string
  leftNumber: string
  leftSegments: FindDiffSegment[]
  rightTone: string
  rightNumber: string
  rightSegments: FindDiffSegment[]
  label: string
  gutter: number
  // diff-review: a line's side and number for selection and comments (split: left/right), file marks, gap expansion, comment entries.
  side: string
  line: number
  selected: bool
  leftLine: number
  rightLine: number
  leftSelected: bool
  rightSelected: bool
  // The file has a selection: its gutter "+" is pinned to the selection's bottom line (pin, or leftPin/rightPin in split), not hover.
  pinned: bool
  pin: bool
  leftPin: bool
  rightPin: bool
  error: bool
  partial: bool
  unavailable: bool
  expandable: bool
  entry: string
  text: string
  // A file header's counts (diff.ts headerStat): Pierre's "-d +a", or DiffStatLabel's aligned "+a -d" for a large source.
  statAligned: bool
  addText: string
  delText: string
// Appearance › Typography's code sample (settings-font-previews.ts): the sample patch's
// unified rows, each with its tone, number and syntax/emphasis segments.
shape FontDiffLine
  id: string
  tone: string
  number: string
  segments: DiffSegment[]
shape FontDiffPreview
  path: string
  status: string
  additions: number
  deletions: number
  scheme: string
  lines: FontDiffLine[]
// diff-review: one row of the Diff panel's file tree (diff-tree.ts).
shape DiffTreeRow
  id: string
  kind: string
  path: string
  name: string
  depth: number
  status: string
  letter: string
  markdown: bool
  expanded: bool
  selected: bool
// A citation's View source (citation-source.ts): the transcript row whose answer goes under its top; each request a new nonce.
shape CiteJump
  key: string
  nonce: number
// Save file (save-file.ts): the app file the window's Save panel copies out, under its name; each request a new nonce.
shape SaveRequest
  from: string
  name: string
  nonce: number
shape DiffRecordedContent
  label: string
  text: string

shape SnapshotDraft
  id: string
  name: string
  // false for an image picked with Attach files: a plain 64pt tile (composer-editor.contract ImageDraftTile).
  snapshot: bool
  app: string
  title: string
  letter: string
  included: bool
  contents: string
  // Its image chip is in the prompt, so Remove asks first (removeComposerImage).
  referenced: bool
// server-update-notices.ts serverUpdateView: the offline banner's timer episodes,
// the details toggle's warning dot and the desktop-managed update's confirmation.
shape ServerUpdateView
  reconnecting: string
  unavailable: string
  attention: bool
  confirmTitle: string
  confirmBody: string
shape UpdateMachineView
  id: string
  label: string
  status: string
  failure: string
  elapsed: string
  failed: bool
shape UpdateEverythingView
  available: bool
  running: bool
  details: bool
  label: string
  tone: string
  elapsed: string
  action: string
  confirm: bool
  title: string
  body: string
  summary: string
  ticking: bool
  machines: UpdateMachineView[]
// The latest link to open outside the app (external-open.ts); app.contract's externalOpen task opens it once per serial.
shape ExternalOpen
  serial: number
  url: string
// The ChatGPT sign-in's loopback receiver's answer (codex-setup-host.ts codexReceive): "idle", "received", "failed" or "gone".
shape CodexReceive
  phase: string
shape Snapshot
  externalOpen: ExternalOpen
  // The ChatGPT sign-ins whose callbacks the loopback receivers wait for, one per slot, "" for a free one
  // (codex-setup-host.ts codexReceiving): app.contract codexLoopback and codexLoopbackSecond.
  codexReceiving: string
  codexReceivingSecond: string
  updateEverything: UpdateEverythingView
  serverUpdate: ServerUpdateView
  timelineReadsNeeded: bool
  highlightPending: bool // a code text waits for its tokens (highlights.ts)
  markdownSkills: MarkdownSkill[]
  composer: ComposerView
  // The AlertStack wrapper's clip to its banners (laid-out-widths.ts alertClip).
  alertClip: string
  // The draft hero's one-line heading's natural width, 0 before it is laid out (laid-out-widths.ts heroInlineWidth).
  heroInlineWidth: number
  // The window's draft is sending its launch: the new-thread shortcut opens a fresh one beside it (draft-launch.ts).
  draftLaunching: bool
  snapshotDrafts: SnapshotDraft[]
  snapshotOwner: string
  // ChatGptWelcomeCoordinator's next "Your ChatGPT plan is connected" (chatgpt-plan.ts).
  chatgptPlan: ChatGptPlanNotice[]
  // A Markdown web link's menu rows (external-link-menu.ts chatLinkMenuView).
  linkMenu: ChatLinkMenu
  revision: number
  // Resource telemetry samples drained (client.ts drain): Diagnostics' live Resource monitor redraws on it alone.
  telemetry: number
  available: bool
  connected: bool
  connecting: bool
  syncComplete: bool
  status: string
  error: string
  providerBannerKey: string
  providerBannerTitle: string
  providerBannerMessage: string
  providerBannerWarning: bool
  // provider-status-message.ts: role, dismiss label and the instance "Open provider setup" opens.
  providerBannerAlert: bool
  providerBannerDismiss: string
  providerBannerSetup: string
  serverUrl: string
  // auto-balance-owner.ts: the open draft's identity; a draft Auto balance moved keeps its earlier one.
  composerOwner: string
  uncertain: bool
  uncertainMessage: string
  sidebarWidth: number
  // resolveThreadSidebarMinimumWidth at the Interface font size (sidebar-min-width.ts).
  sidebarMinWidth: number
  // --workspace-controls-left, 90 beside the traffic lights, 0.75rem in full screen (sidebar-min-width.ts).
  controlsLeft: number
  sidebarOpen: bool
  query: string
  projectId: string
  projectName: string
  threadId: string
  threadTitle: string
  threadHeading: CommandChoice[]
  // The title's majority direction (shared/text-direction.ts), "ltr" or "rtl": ChatHeader's `dir` on the title.
  threadTitleDir: string
  // The header's rename field's direction, `dir="auto"` over the text being typed (timeline-presentation.ts headerRenameDir).
  renameDir: string
  // A subagent thread's parent (id and title) for the header's crumb; empty otherwise.
  parentThread: CommandChoice[]
  draft: string
  running: bool
  // A live subagent's elapsed time ticks on the timeline clock (AgentElapsed).
  subagentsLive: bool
  canSend: bool
  canStop: bool
  providerId: string
  modelId: string
  // The model trigger's accessible name (the full name), its text (the short one) and its Unavailable badge.
  modelLabel: string
  modelShortLabel: string
  modelUnavailable: bool
  planModeEnabled: bool
  composerResting: bool
  transcriptAway: bool
  // composer-overlay.ts: the transcript's end reservation under the composer overlay, the Scroll to end pill's rise,
  // and the composer height the column keeps (the terminal drawer's cap, the empty timeline's centring).
  transcriptTail: number
  scrollLift: number
  composerReserved: number
  // composer-attachments.ts: the draft's attached videos on the shelf, and the one being previewed (0 or 1).
  composerVideos: ComposerVideo[]
  composerVideoPreview: ComposerVideoPreview[]
  // composer-chip-details.ts: an image chip's expanded preview over the draft's images (0 or 1).
  composerImagePreview: ComposerImagePreview[]
  tableMenu: TableMenuView[]
  providerDriver: string
  providerBadge: string
  providerBadgeColor: string
  optionLabel: string
  optionId: string
  modelOptions: ModelOption[]
  settled: bool
  projectMark: string
  projectInk: string
  projectSurface: string
  runtimeMode: string
  modeLabel: string
  interactionMode: string
  hasMore: bool
  historyLoading: bool
  threadLoading: bool // a server thread's detail is not in yet (ChatView threadDetailLoading)
  diffOpen: bool
  diffLoading: bool
  diffError: string
  diffScopeLabel: string
  diffScope: string
  diffTurns: DiffTurn[]
  diffLatestSelected: bool
  diffCanRefresh: bool
  diffLayout: string
  diffWrap: bool
  diffIgnoreWhitespace: bool
  diffTree: bool
  diffTestFiles: number
  diffHideTests: bool
  // A tool call's diff: the files its record names that the patch omits, and the content recorded without a diff.
  diffToolCallNote: string
  diffToolCallContent: DiffRecordedContent[]
  diffTruncated: bool
  diffEmpty: bool
  diffEmptyLabel: string
  diffAdditions: number
  diffDeletions: number
  diffAdditionsText: string
  diffDeletionsText: string
  // The Changes header's "<head> → <base>" and the comparison target picker (diff-base-ref.ts).
  diffCompare: bool
  diffHead: string
  diffBase: string
  diffBaseRefs: DiffBaseRef[]
  diffBaseAutomatic: bool
  diffBaseEmpty: bool
  diffAllCollapsed: bool
  diffFiles: DiffFile[]
  diffFind: DiffFindView
  diffItems: DiffItem[]
  diffTreeRows: DiffTreeRow[]
  diffTreeLabel: string
  diffTreeFolders: bool
  diffTreeAllOpen: bool
  diffCommentOpen: bool
  diffLoadingLabel: string
  // Loading with no answer for this selection yet (DiffPanel isLoadingSelectedPatch): only then the skeleton shows.
  diffPending: bool
  // A turn diff's named file to scroll to, and the reveal request that bumps each time it is opened (DiffPanel revealDiffFile).
  diffReveal: number
  diffRevealTarget: string
  projects: Project[]
  searchFirstId: string
  threads: Thread[]
  sidebar: SidebarView
  messages: Message[]
  // The transcript's rows its window keeps mounted (timeline-kept-rows.ts): the first and last message, a playing
  // sound's row and a full-screen app's.
  transcriptKeep: string[]
  historyError: string
  revertPending: string
  minimap: MinimapItem[]
  citing: bool // a citation is placing its answer (ChatColumn restores nothing meanwhile)
  citeJump: CiteJump // the answer a citation's View source places (ChatColumn citeBegin)
  saveRequest: SaveRequest // the app file the window's Save panel offers next (app.contract saveNow)
  imagePreviewId: string
  imagePreviewName: string
  imagePreviewPosition: string
  imagePreviewPrevious: bool
  imagePreviewNext: bool
  imagePreviewVideo: bool
  imagePreviewSource: string
  // The shown media's tooltip (MediaActions: its full path, URL or name).
  imagePreviewTip: string
  // The Markdown image's node the dialog gives the focus back to ("" for an attachment or a link's media).
  imagePreviewReturn: string
  // The thread's last code copy (Copy code, Copy table); the root clears its check after 1.2 s (#123).
  codeCopyNonce: number
  diagramPreview: MermaidDiagram[]
  // What the math pages reported (markdown-math.ts), which every MathBlock reads.
  mathFrames: MathFrame[]
  planSaveOpen: bool
  planSavePath: string
  planSaveRoot: string
  planSaving: bool
  planSaveRow: string
  providers: Provider[]
  models: Model[]
  approvals: Approval[]
  questions: Question[]
  requestMode: string
  requestKey: string
  clientError: string
  errorWarning: bool
  // ThreadErrorBanner's collapsed message (a JSON error's message) and whether it expands to the full text.
  errorSummary: string
  errorExpandable: bool
  // A ChatGPT sharing limit the server named by its code (timeline-errors.ts): "workspace", "chatgpt" or "".
  errorLimit: string
  look: Look
shape Change
  revision: number
  message: string
  relaunch: bool
  routeReorder: number
shape Viewport
  width: number
  height: number
  prefersColorScheme: string
  prefersReducedMotion: bool
  displayMode: string // "fullscreen" while the window is in full screen (LLP 1039)

style Ink
  color="light-dark(#18181b, #ededed)"
style Muted
  color="light-dark(#71717a, #858585)"
style Canvas
  background-color="light-dark(#fcfcfc, #000000)"
style Surface
  background-color="light-dark(#ffffff, #101010)"
style Edge
  border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #252525)"
style Control
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center"
  box-sizing="border-box"
  padding="0.4375rem" gap="0.375rem" border-radius="0.5rem" border-width=0
  background-color="#00000000" min-height="1.75rem" flex-shrink=0
  color="light-dark(#52525b, #b0b0b0)"
style Field
  box-sizing="border-box" min-width=0 padding="0.625rem" border-radius="0.5rem"
  border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #303030)"
  background-color="light-dark(#fafafa, #191919)"
  color="light-dark(#18181b, #ededed)" font-size="0.8125rem"
style Primary
  display="flex" flex-direction="row" align-items="center" justify-content="center"
  box-sizing="border-box"
  padding-left="0.8125rem" padding-right="0.8125rem" height="2rem" border-radius="1rem" border-width=0
  background-color="light-dark(#2451cc, #4475ed)" color="#ffffff"
style Overlay
  position="absolute" left=0 right=0 top=0 bottom=0
  display="flex" align-items="center" justify-content="center"
  background-color="#00000055" padding="1.5rem" box-sizing="border-box" z-index=20


