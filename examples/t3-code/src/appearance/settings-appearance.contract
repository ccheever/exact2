// Appearance: colour scheme tiles and the theme library.
// Reference ThemeSettings.tsx ThemeLibrary, ThemeWireframe.tsx, ThemePreviewCircles.tsx.
use CoreIcon, CorePaintIcon from "../settings/settings-core.contract"
use CorePalette from "../settings/settings-core-shared.contract"
use SettingsGhost from "../settings/settings-core-shared.contract"
use SettingsSrHeading from "../settings/settings-kit.contract"
use ModeTile from "../settings/settings-core.contract"
use ThemeCard from "../settings/settings-core.contract"
use Wire from "../settings/settings-core.contract"
use CollectionOrbs from "./settings-a-collections.contract"
use ThemeOrbView from "./settings-a-collections.contract"

component AppearanceLibrary
  props
    tiles: ModeTile[]
    themes: ThemeCard[]
    pal: CorePalette
    busy: bool
    change: action
    dialog: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    column width="100%" gap="0.75rem" id="appearance" tabindex=-1 testId="settings-section-appearance"
      // ThemeSettings.tsx's SettingsSection "Colors & themes" (hideTitle: an sr-only `<h2>`) and its
      // two `<h3>`s.
      SettingsSrHeading(title="Colors & themes", level=2)
      // The section hides its title, so the jump centres its group (settingsLayout.tsx SettingsSection).
      column width="100%" gap="0.75rem" id="appearance-scroll-target"
        text "Color scheme" font-size="1rem" font-weight=600 line-height="1.5rem" color=pal.text padding-left="1rem" padding-right="1rem" role="heading" aria-level=3 id="paint-AppearanceLibrary-1" data-paint="text" data-pick="text"
        row width="100%" gap="0.75rem" role="group" aria-label="Appearance mode"
          // The picked tile's ring-2 ring-inset ring-ring: its 1pt accent border and a 1pt inset shadow.
          for tile in tiles key=tile.id
            button press=change("appearance-mode", "appearanceMode", tile.id) hover=hover(tile.id) aria-label=tile.aria aria-checked=tile.selected role="radio" disabled=busy data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost flex=1 min-width=0 flex-direction="column" align-items="stretch" gap="0.375rem" padding="0.5rem" border-radius="0.75rem" border-width=1 border-style="solid" border-color=(tile.selected ? pal.accent : pal.cardBorder) box-shadow=(tile.selected ? `inset 0 0 0 1px ${pal.accent}` : "none") background-color=(tile.selected ? pal.tileActive : (hovered == tile.id ? pal.tileActive : pal.card)) id=(tile.id == "system" ? "setting-appearance" : `setting-appearance-${tile.id}`) testId=`setting-appearance-${tile.id}` data-paint=`${(tile.selected ? "accent" : "border")} ${(tile.selected ? "accentSurface" : (hovered == tile.id ? "accentSurface" : "surface"))}` data-pick=((tile.selected ? "accentSurface" : (hovered == tile.id ? "accentSurface" : "surface")) != "" ? (tile.selected ? "accentSurface" : (hovered == tile.id ? "accentSurface" : "surface")) : ((tile.selected ? "accent" : "border") != "" ? (tile.selected ? "accent" : "border") : ""))
              box position="relative" width="100%" height="8.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.cardBorder overflow="hidden" box-sizing="border-box" id=`paint-AppearanceLibrary-3-${tile.id}` data-paint="border" data-pick="border"
                WirePane(colors=tile.left, offset=0)
                if tile.split
                  box position="absolute" top=0 bottom=0 left="50%" right=0 overflow="hidden" padding-left=1
                    WirePane(colors=tile.right, offset=1)
              text tile.label font-size="0.75rem" font-weight=500 line-height="1rem" text-align="center" color=(tile.selected ? pal.text : pal.muted) id=`paint-AppearanceLibrary-4-${tile.id}` data-paint=`${(tile.selected ? "text" : "mutedForeground")}` data-pick=((tile.selected ? "text" : "mutedForeground") != "" ? (tile.selected ? "text" : "mutedForeground") : "")
        row width="100%" min-height="2rem" padding-top="1.25rem" padding-left="1rem" padding-right="1rem" gap="0.75rem" align-items="center" justify-content="space-between" flex-wrap="wrap" box-sizing="border-box"
          text "Themes" font-size="1rem" font-weight=600 line-height="1.5rem" color=pal.text role="heading" aria-level=3 id="paint-AppearanceLibrary-5" data-paint="text" data-pick="text"
          row gap="0.5rem" align-items="center"
            button press=dialog("create", "") data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" disabled=busy aria-label="Create theme" testId="create-theme" id="create-theme" data-paint="input canvas" data-pick="canvas"
              CorePaintIcon(ownId="paint-icon-AppearanceLibrary-1", paint="text", name="paintbrush", size=14, color=pal.text)
              text "Create theme" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.text id="paint-AppearanceLibrary-7" data-paint="text" data-pick="text"
            button id="add-theme" press=dialog("import", "") data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" disabled=busy aria-label="Add theme" testId="add-theme" data-paint="input canvas" data-pick="canvas"
              CorePaintIcon(ownId="paint-icon-AppearanceLibrary-2", paint="text", name="plus", size=14, color=pal.text)
              text "Add theme" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.text id="paint-AppearanceLibrary-9" data-paint="text" data-pick="text"
        // grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr)).
        box width="100%" display="grid" gap="0.5rem" grid-template-columns="repeat(auto-fit, minmax(256px, 1fr))"
          for card in themes key=card.id
            column min-width=0 border-radius="0.75rem" border-width=1 border-style="solid" border-color=pal.cardBorder background-color=pal.card overflow=(card.collection ? "visible" : "hidden") box-sizing="border-box" testId=`theme-card-${card.id}` id=`theme-card-${card.id}` data-paint="border surface" data-pick="surface"
              // settings-a: an imported collection's light and dark variant pickers.
              if card.collection
                CollectionOrbs(card=card, pal=pal, busy=busy, change=change)
              row min-height="4rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.75rem" gap="0.625rem" align-items="center" justify-content="center" display=(card.collection ? "none" : "flex")
                for orb in card.orbs key=orb.mode
                  button id=`theme-orb-${card.id}-${orb.mode}` press=change("theme-half", orb.mode == "light" ? "themeLight" : "themeDark", card.id) aria-label=`Use ${card.label} ${orb.mode} mode` aria-checked=orb.picked role="checkbox" disabled=busy data-focus-stop=(busy or card.collection ? "" : "enabled page") class=SettingsGhost position="relative" width="4.25rem" height="4.25rem" padding="0.375rem" border-radius="2.125rem" box-shadow=(orb.picked ? `inset 0 0 0 2px ${pal.accent}` : "none") testId=`theme-orb-${card.id}-${orb.mode}` title=""
                    ThemeOrbView(orb=orb, id=`${card.id}-${orb.mode}`, ring=pal.thumb)
                    if orb.picked
                      box position="absolute" right="0.125rem" bottom="0.125rem" width="1.25rem" height="1.25rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.cardBorder background-color=pal.thumb display="flex" align-items="center" justify-content="center" box-shadow="0 1px 2px #0000001a" id=`paint-AppearanceLibrary-11-${card.id}-${orb.mode}` data-paint="border canvas" data-pick="canvas"
                        CorePaintIcon(ownId=`paint-icon-AppearanceLibrary-3-${card.id}-${orb.mode}`, paint="text", name=(orb.mode == "light" ? "sun" : "moon"), size=12, color=pal.text)
              row padding-left="0.75rem" padding-right="0.75rem" padding-bottom="0.75rem" padding-top="0.5rem" gap="0.5rem" align-items="center"
                if card.collection
                  // "Use the first variants for light and dark".
                  button id=`theme-use-${card.id}` press=change("theme-collection", "", card.collectionId) aria-label=`Use ${card.label}, ${card.primaryLabel} variant` role="radio" aria-checked=false disabled=busy data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost padding=0 justify-content="flex-start" flex=1 min-width=0 testId=`theme-use-${card.id}`
                    text card.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text line-clamp=1 id=`paint-AppearanceLibrary-12-${card.id}` data-paint="text" data-pick="text"
                else
                  button id=`theme-use-${card.id}` press=change("theme", "theme", card.id) aria-label=`Use ${card.label} theme` aria-checked=card.selected role="radio" disabled=busy data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost padding=0 justify-content="flex-start" flex=1 min-width=0 testId=`theme-use-${card.id}`
                    text card.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text line-clamp=1 id=`paint-AppearanceLibrary-13-${card.id}` data-paint="text" data-pick="text"
                // ThemeCard actions: icon-xs ghost buttons with their tooltips; Remove is ghost-destructive.
                row flex-shrink=0 gap="0.25rem" align-items="center"
                  // A collection's actions act on its selected variant (card.primary).
                  ThemeCardAction(icon="copy", label=`Duplicate ${card.primaryLabel}`, tip="Duplicate theme", destructive=false, pal=pal, busy=busy, press=dialog("duplicate", card.primary), actionId=`theme-duplicate-${card.id}`)
                  if card.custom
                    ThemeCardAction(icon="pen-line", label=`Edit ${card.primaryLabel}`, tip="Edit theme", destructive=false, pal=pal, busy=busy, press=dialog("edit", card.primary), actionId=`theme-edit-${card.id}`)
                    ThemeCardAction(icon="upload", label=`Export ${card.primaryLabel}`, tip="Export theme file", destructive=false, pal=pal, busy=busy, press=change("theme-export", "", card.primary), actionId=`theme-export-${card.id}`)
                    ThemeCardAction(icon="trash-2", label=(card.collection ? `Remove themes from ${card.label}` : `Remove ${card.label}`), tip=(card.collection ? "Remove themes" : "Remove theme"), destructive=true, pal=pal, busy=busy, press=dialog("remove", card.id), actionId=`theme-remove-${card.id}`)

// ThemeWireframePane: sidebar, a short conversation, the composer and the floating island.
component WirePane
  props
    colors: Wire
    offset: number
  view
    box position="absolute" top=0 bottom=0 left=(offset > 0 ? "-100%" : "0%") width=(offset > 0 ? "200%" : "100%") background-color=colors.canvas
      box position="absolute" left=0 top=0 bottom=0 width="22%" background-color=colors.sidebar box-shadow="inset -1px 0 0 #7f7f7f40"
      box position="absolute" left="3%" top="8%" height="8%" width="16%" border-radius="0.25rem" background-color=colors.surface box-shadow="inset 0 0 0 1px #7f7f7f40"
      box position="absolute" left="3%" top="22%" height="7%" width="16%" border-radius="0.25rem" background-color=colors.accentSurface
      box position="absolute" left="3%" top="32%" height="7%" width="16%" border-radius="0.25rem" background-color=colors.message opacity=0.7
      box position="absolute" left="3%" top="42%" height="7%" width="16%" border-radius="0.25rem" background-color=colors.message opacity=0.5
      box position="absolute" right="28%" top="11%" height="9%" width="24%" border-radius="0.5rem" background-color=colors.message
      box position="absolute" left="27%" top="28%" height="5%" width="34%" border-radius="0.125rem" background-color="#7f7f7f40"
      box position="absolute" left="27%" top="38%" height="5%" width="26%" border-radius="0.125rem" background-color="#7f7f7f40"
      row position="absolute" bottom="8%" left="26%" right="6%" height="15%" border-radius="0.25rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" align-items="center" justify-content="space-between" background-color=colors.surface box-shadow="inset 0 0 0 1px #7f7f7f40"
        box height="26%" width="34%" border-radius="6.1875rem" background-color="#7f7f7f40" opacity=0.7
        box height="58%" aspect-ratio=1 border-radius="6.1875rem" background-color=colors.action
      column position="absolute" right="5%" top="8%" height="46%" width="20%" border-radius="0.5rem" background-color=colors.surface box-shadow="inset 0 0 0 1px #7f7f7f40, 0 2px 5px #00000024"
        WireRow(top="10%", dot="#34d399")
        WireRow(top="40%", dot=colors.action)
        WireRow(top="70%", dot="#fbbf24")

component WireRow
  props
    top: string
    dot: string
  view
    row position="absolute" left="11%" right="11%" top=top height="20%" gap="0.25rem" align-items="center"
      box height="26%" aspect-ratio=1 border-radius="6.1875rem" background-color=dot opacity=0.55
      box height="30%" width="52%" border-radius="0.125rem" background-color="#7f7f7f40"

component ThemeCardAction
  inject
    rem: number
  props
    icon: string
    label: string
    tip: string
    destructive: bool
    pal: CorePalette
    busy: bool
    press: action
    actionId: string
  state hovered = false
  state focused = false
  action hover(over: bool)
    hovered = over
  action focusTip(on: bool)
    focused = on
  view
    box position="relative" width="1.5rem" height="1.5rem" flex-shrink=0
      button id=actionId press=press hover=hover focus=focusTip(true) blur=focusTip(false) aria-label=label disabled=busy data-focus-stop=(busy ? "" : "enabled page") class=SettingsGhost width="1.5rem" height="1.5rem" border-radius="0.25rem" background-color=(hovered ? pal.highlight : "#00000000") testId=actionId title="" data-paint=`${(hovered ? "text" : "")}` data-pick=((hovered ? "text" : "") != "" ? (hovered ? "text" : "") : "")
        CorePaintIcon(ownId=`paint-icon-ThemeCardAction-1-${actionId}`, paint=(destructive and hovered ? "" : (hovered ? "text" : "mutedForeground")), name=icon, size=14, color=(destructive and hovered ? "light-dark(#fb2c36, #fb414a)" : (hovered ? pal.text : pal.muted)))
      if hovered or focused
        text tip position="absolute" bottom="1.75rem" left=((12 - (tip.length * 6.3 + 18) / 2) * rem / 16) width=((tip.length * 6.3 + 18) * rem / 16) z-index=60 padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover font-size="0.75rem" line-height="1.03125rem" color=pal.text white-space="nowrap" text-align="center" role="tooltip" id=`paint-ThemeCardAction-2-${actionId}` data-paint="text surfaceOverlay" data-pick="surfaceOverlay"
