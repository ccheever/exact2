// Appearance → Typography: FontFamilyPicker. A SelectButton that
// opens a 288pt combobox: Search fonts…, the default family first with its
// "default" tag, then the families this app can draw, each in its own face, a
// check on the one in use, and "No fonts found." when the search misses.
// The search field takes the focus as the popup opens (ComboboxSearchInput in the popup). The highlighted
// row is Base UI's activeIndex: the popup opens on the family in use, scrolled into view (useListNavigation syncs
// activeIndex to the selectedIndex AriaCombobox keeps while closed), typing lights the first match (autoHighlight),
// ↓/↑ walk the matches (past either end back to none, loopFocus), and Return picks the lit row.
// A pick gives the focus back to the trigger, as Base UI's popup does to its trigger as it closes. The trigger is not
// disabled while the write is in flight: a disabled control cannot hold the focus, so the window would keep it.
use CoreOption from "../settings/settings-core-shared.contract"
use dbStep from "../diff/diff.contract"
use CorePalette from "../settings/settings-core-shared.contract"
use CoreIcon, CorePaintIcon from "../settings/settings-core.contract"

component FontFamilyPicker
  props
    rowId: string
    label: string
    value: string
    families: CoreOption[]
    pal: CorePalette
    choose: action
  state query = ""
  // The row the keys or the pointer lit since the last edit ("-" for none); "" leaves it to the query.
  state cursor = ""
  derive needle = query.trim().toLowerCase()
  derive matches = families.filter((family) => needle == "" or (family.value != "" and family.label.toLowerCase().includes(needle)))
  derive current = families.filter((family) => family.selected).map((family) => family.id).join("")
  derive highlight = cursor != "" ? cursor : (needle == "" ? "-" : matches.slice(0, 1).map((family) => family.id).join(""))
  action open
    query = ""
    cursor = current
  // Clearing the search keeps Base UI's activeIndex, so the row at that place in the full list stays lit.
  action search(next: string)
    let place = matches.map((family) => family.id).indexOf(highlight)
    query = next
    cursor = next.trim() != "" or place < 0 ? "" : families.slice(place, place + 1).map((family) => family.id).join("")
  action toggled(e: ToggleEvent)
    if e.newState == "open" and current != ""
      scrollIntoView(`font-picker-${rowId}-option-${current}`, block="nearest")
  action searchKey(k: string)
    if k == "ArrowDown" or k == "ArrowUp"
      preventDefault()
      let next = dbStep(matches.map((family) => family.id), highlight, k == "ArrowDown")
      cursor = next
      if next != "-"
        scrollIntoView(`font-picker-${rowId}-option-${next}`, block="nearest")
  action pick
    if highlight != "-" and matches.filter((family) => family.id == highlight).length > 0
      pickRow(highlight)
  action pickRow(id: string)
    hidePopover(`font-picker-${rowId}`)
    focus(`setting-${rowId}-family`)
    choose(families.filter((family) => family.id == id).map((family) => family.value).join(""))
  action hoverRow(id: string, over: bool)
    cursor = over ? id : (highlight == id ? "-" : highlight)
  view
    box position="relative" flex-shrink=0
      button data-focus-stop="enabled page" press=open popovertarget=`font-picker-${rowId}` role="combobox" aria-label=label id=`setting-${rowId}-family` testId=`setting-${rowId}-family` border-width=0 padding=0 background-color="#00000000"
        row justify-content="space-between" align-items="center" gap="0.5rem" width="11rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.3125rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" box-sizing="border-box" id=`paint-FontFamilyPicker-1-${rowId}` data-paint="input canvas" data-pick="canvas"
          text value font-size="0.875rem" line-height="1.25rem" color=pal.text line-clamp=1 white-space="nowrap" flex-shrink=1 min-width=0 id=`paint-FontFamilyPicker-2-${rowId}` data-paint="text" data-pick="text"
          box opacity=0.7 flex-shrink=0
            CorePaintIcon(ownId=`paint-icon-FontFamilyPicker-1-${rowId}`, paint="text", name="chevron-down", size=14, color=pal.text)
      // ComboboxPopup align end: the popup's right edge meets the trigger's, 4 pt below, flipping near an edge. Escape
      // closes it (the host's light dismiss) and Settings stays: the popup is the window's modal scope while it shows, so
      // Back's Escape shortcut does not take the key first (Base UI's dismissal prevents it).
      column id=`font-picker-${rowId}` toggle=toggled popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" aria-modal=true position="absolute" margin-top="0.25rem" width="18rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=label testId=`font-picker-${rowId}` data-paint="text surfaceOverlay" data-pick="surfaceOverlay"
        column padding-top="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" width="100%"
          row height="2.0625rem" align-items="center" gap="0.25rem" padding-bottom="0.375rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color=pal.border id=`paint-FontFamilyPicker-4-${rowId}` data-paint="border" data-pick="border"
            CorePaintIcon(ownId=`paint-icon-FontFamilyPicker-2-${rowId}`, paint="mutedForeground", name="search", size=16, color=pal.muted)
            input value=query input=search key=searchKey submit=pick autofocus=true role="combobox" aria-expanded=true placeholder="Search fonts…" aria-label="Search fonts" spellcheck="false" autocorrect="off" testId=`font-picker-${rowId}-search` flex=1 min-width=0 height="1.625rem" padding=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color=pal.text id=`font-picker-${rowId}-search` data-paint="text" data-pick="text" data-editable="yes"
              ::placeholder
                color=pal.muted
        scroll max-height="18rem" width="100%"
          column padding="0.25rem" width="100%" box-sizing="border-box"
            if matches.length == 0
              text "No fonts found." font-size="0.875rem" line-height="1.25rem" text-align="center" padding="0.5rem" color=pal.muted testId=`font-picker-${rowId}-empty` id=`font-picker-${rowId}-empty` data-paint="mutedForeground" data-pick="mutedForeground"
            for family in matches key=family.id
              button press=pickRow(family.id) hover=hoverRow(family.id) role="option" aria-selected=family.selected id=`font-picker-${rowId}-option-${family.id}` testId=`font-picker-${rowId}-${family.id}` display="flex" flex-direction="row" align-items="center" justify-content="space-between" gap="0.5rem" width="100%" height="1.875rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(highlight == family.id ? pal.optionHighlight : family.selected ? pal.optionSelected : "#00000000")
                text family.label font-family=family.detail font-size="0.875rem" line-height="1.25rem" color=pal.text line-clamp=1 min-width=0 flex=1 text-align="left" id=`paint-FontFamilyPicker-7-${rowId}-${family.id}` data-paint="text" data-pick="text"
                row gap="0.375rem" align-items="center" flex-shrink=0
                  if family.value == ""
                    text "default" font-size="0.625rem" line-height="0.875rem" color=pal.muted opacity=0.6 id=`paint-FontFamilyPicker-8-${rowId}-${family.id}` data-paint="mutedForeground" data-pick="mutedForeground"
                  if family.selected
                    CorePaintIcon(ownId=`paint-icon-FontFamilyPicker-3-${rowId}-${family.id}`, paint="mutedForeground", name="check", size=14, color=pal.muted)
