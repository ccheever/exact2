// Appearance → the floating theme editor (settings-appearance-editor.ts).
// Reference ThemeEditorPanel.tsx: a 416pt panel at the window's bottom-right with
// its header (title, "Select a color below", minimize, close), Theme name,
// Appearance (Light/Dark), Colors with Advanced and Filter colors, the colour
// families, and Cancel / Create theme. ThemeColorPicker's popover chooses a colour
// (theme-color-picker.contract).
use CoreIcon from "../settings/settings-core.contract"
use CorePalette from "../settings/settings-core-shared.contract"
use SettingsGhost from "../settings/settings-core-shared.contract"
use EditorRow from "./settings-appearance-editor-shapes.contract"
use ThemeRoleUsage from "./settings-appearance-editor-shapes.contract"
use EditorView from "./settings-appearance-editor-shapes.contract"
use SettingsCore from "../settings/settings-core.contract"
use Viewport from "../shared/shapes.contract"
use ThemeColorSwatch from "./theme-color-picker.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

// ThemeEditorHost: the editor floats above every route while its session is open
// (the window's create/edit/duplicate dialog), so it stays across threads, pages and
// Settings; each session is a fresh panel (keyed by its id), as `key={session.id}`.
component ThemeEditorHost
  props
    inspecting: bool
    inspectSet: action
    usage: ThemeRoleUsage[]
    reveal: action
    kind: string
    core: SettingsCore
    viewport: Viewport
    busy: bool
    error: string
    close: action
    commit: action
    live: action
    save: action
  view
    if (kind == "create" or kind == "duplicate" or kind == "edit") and core.editor.open
      for editor in [core.editor] key=editor.session
        ThemeEditorPanel(inspecting=inspecting, inspectSet=inspectSet, reveal=reveal, usage=usage, editor=editor, pal=core.palette, vw=viewport.width, vh=viewport.height, reduced=viewport.prefersReducedMotion, busy=busy, error=error, close=close, commit=commit, live=live, save=save)

// The panel's place and size are its own state (ThemeEditorPanel.tsx at 7c3b3b3605ef):
// null parks it bottom-right 16; a drag or the corner grip gives an explicit top-left,
// clamped so the header (48) stays reachable within margin 8; the grip grows toward the
// right and bottom only, at least 280x220. The place and size are kept as the person left
// them and fitted to the window where the panel is drawn (`boxW`, `boxH`, `left`, `top`), so
// a window that shrinks and grows back returns the panel to where it was. An unsized panel
// is clamped by the width it had at the last drag (`pw`), as the reference's position keeps it.
component ThemeEditorPanel
  inject
    rem: number
    interacted: action
  props
    editor: EditorView
    inspecting: bool
    inspectSet: action
    usage: ThemeRoleUsage[]
    reveal: action
    pal: CorePalette
    vw: number
    vh: number
    reduced: bool
    busy: bool
    error: string
    close: action
    commit: action
    live: action
    save: action
  state selected = ""
  state hoveredId = ""
  state hoveredRole = ""
  derive selection = usage.filter((group) => group.role == selected)
  action selectRole(role: string)
    selected = selected == role ? "" : role
    inspectSet(false)
  action pickRole(role: string)
    selected = role
    inspectSet(false)
  action toggleAdvanced
    if editor.advanced and selected != "canvas" and selected != "accent"
      selected = ""
    commit("theme-editor", "advanced", editor.advanced ? "false" : "true")
  action armInspect
    inspectSet(not inspecting)
    hoveredId = ""
    hoveredRole = ""
  action cancelInspect
    inspectSet(false)
    selected = ""
    hoveredId = ""
    hoveredRole = ""
  action inspectUp(e: PointerEvent)
    inspectPointer(true, e)
  action inspectPointer(pick: bool, e: PointerEvent)
    interacted()
    let hits = elementsFromPoint(e.clientX, e.clientY)
    let matches = hits.filter((id) => usage.filter((group) => group.nodes.map((node) => node.id).includes(id)).length > 0)
    let hitId = matches.slice(0, 1).join("")
    let roles = usage.filter((group) => group.primaryIds.includes(hitId))
    let role = roles.slice(0, 1).map((group) => group.role).join("")
    hoveredId = hitId
    hoveredRole = role
    if pick and role != ""
      preventDefault()
      selected = role
      inspectSet(false)
      commit("theme-editor", "inspect", role)
      reveal(role)
  action inspectorKey(k: string, e: KeyboardEvent)
    if k == "Escape" and inspecting
      preventDefault()
      cancelInspect()
  state minimized = false
  state name = ""
  state named = false
  state placed = false
  state rx = 0
  state ry = 0
  state sized = false
  state rw = 0
  state rh = 0
  state pw = 0
  state dragging = false
  state growing = false
  derive boxW = sized ? max(280, min(rw, vw - 16)) : min(416, vw - 32)
  derive boxH = max(220, min(rh, vh - 16))
  derive capH = min(672, vh - 96)
  derive left = min(max(rx, 8), max(8, vw - (sized ? boxW : pw) - 8))
  derive top = min(max(ry, 8), max(8, vh - 48))
  action toggleMinimized
    minimized = not minimized
  // The name travels with Save (no commit on blur: a blur-time write would make Save's
  // own click land on a busy, disabled button). Each keystroke also reaches the draft as a
  // stamped `live` op (themelocal, never behind another command), so the submit label follows the name as typed.
  state nameSent = 0
  action editName(next: string)
    let t = max(performanceNow(), nameSent + 0.001)
    name = next
    named = true
    nameSent = t
    live("name", `${editor.session}|name`, next, t)
  // Header drag: the move since the last event; the first one starts from where the panel is drawn.
  action drag(dx: number, dy: number)
    pw = dragging ? pw : frame("theme-editor").width
    rx = (dragging ? rx : (placed ? left : frame("theme-editor").x)) + dx
    ry = (dragging ? ry : (placed ? top : frame("theme-editor").y)) + dy
    dragging = true
    placed = true
  action dropDrag(vx: number, vy: number)
    dragging = false
    rx = left
    ry = top
  // Corner grip: the top-left holds still (a parked panel converts to an explicit place first).
  action grow(dx: number, dy: number)
    pw = growing ? pw : frame("theme-editor").width
    rx = placed ? left : frame("theme-editor").x
    ry = placed ? top : frame("theme-editor").y
    rw = min(max((growing ? rw : frame("theme-editor").width) + dx, 280), max(280, vw - 8 - (placed ? left : frame("theme-editor").x)))
    rh = min(max((growing ? rh : frame("theme-editor").height) + dy, 220), max(220, vh - 8 - (placed ? top : frame("theme-editor").y)))
    growing = true
    sized = true
    placed = true
  action dropGrow(vx: number, vy: number)
    growing = false
    rw = boxW
    rh = boxH
  view
    // The pane stays usable above the inspecting layer. Its hits have no paint tags.
    if inspecting
      box position="absolute" left=0 top=0 width=vw height=vh z-index=109 cursor="crosshair" pointermove=inspectPointer(false) pointerup=inspectUp key=inspectorKey tabindex=-1 autofocus id="theme-inspector" testId="theme-inspector" aria-label="Inspect app colors"
      button press=cancelInspect tabindex=-1 title="" aria-keyshortcuts="Escape" position="absolute" width=1 height=1 opacity=0 z-index=109 aria-label="Cancel color inspection" testId="theme-inspector-cancel"
    for group in usage key=group.role
      if (not inspecting and group.role == selected) or (inspecting and group.role == hoveredRole)
        for node in group.nodes key=node.id
          if (not inspecting or node.id == hoveredId) and node.frame.width > 0 and node.frame.height > 0
            box position="absolute" left=node.frame.x top=node.frame.y width=node.frame.width height=node.frame.height border-width=2 border-style="solid" border-color="#3b82f6" border-radius=3 box-sizing="border-box" pointer-events="none" aria-hidden=true z-index=109 testId=`theme-usage-${node.id}`
    column position="absolute" left=(placed ? left : "auto") top=(placed ? top : "auto") right=(placed ? "auto" : "1rem") bottom=(placed ? "auto" : "1rem") width=boxW height=(sized and not minimized ? boxH : "auto") max-height=(minimized ? vh : (sized ? vh - rem : capH)) border-radius="0.75rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.canvas box-shadow="0 20px 25px -5px #0000001a, 0 8px 10px -6px #0000001a" box-sizing="border-box" overflow="hidden" z-index=110 role="dialog" aria-label=editor.title id="theme-editor" testId="theme-editor"
      row flex-shrink=0 align-items="center" gap="0.25rem" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" border-bottom-width=(minimized ? 0 : 1) border-bottom-style="solid" border-color=pal.divider box-sizing="border-box" touch-action="none" cursor=(dragging ? "grabbing" : "grab") pan=drag panrelease=dropDrag testId="theme-editor-header"
        row flex=1 min-width=0 gap="0.5rem" align-items="baseline"
          text editor.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text role="heading" aria-level=2 flex-shrink=0
          if not minimized
            if inspecting
              text "Select an element · Esc to cancel" testId="theme-editor-usage" font-size="0.75rem" line-height="1rem" color=pal.muted line-clamp=1
            else if selection.length > 0
              for selectedGroup in selection key=selectedGroup.role
                text `${selectedGroup.label} · ${selectedGroup.nodes.length} ${selectedGroup.nodes.length == 1 ? "use" : "uses"}` testId="theme-editor-usage" font-size="0.75rem" line-height="1rem" color=pal.muted line-clamp=1
            else
              text "Select a color below" testId="theme-editor-usage" font-size="0.75rem" line-height="1rem" color=pal.muted line-clamp=1
        button press=armInspect aria-label="Inspect app colors" aria-pressed=inspecting class=SettingsGhost width="1.5rem" height="1.5rem" border-radius="0.5rem" background-color=(inspecting ? pal.highlight : "#00000000") testId="theme-editor-inspect" title="Inspect app colors"
          CoreIcon(name="search", size=14, color=pal.muted)
        button press=toggleMinimized aria-label=(minimized ? "Expand the theme editor" : "Minimize the theme editor") aria-expanded=(not minimized) class=SettingsGhost width="1.5rem" height="1.5rem" border-radius="0.5rem" cursor="default" testId="theme-editor-minimize" title=""
          // f2cc80a7 MorphIcon ChevronDown↔ChevronUp: a half turn on morphicons' snappy spring (none under reduced motion).
          box rotate=(minimized ? "180deg" : "0deg") transition=(reduced ? "none" : "rotate -exact-spring(420, 30, 1)")
            CoreIcon(name="chevron-down", size=14, color=pal.muted)
        // No Escape of its own, as the reference's panel (ThemeEditorPanel.tsx: a plain role="dialog" whose
        // only key listener cancels Inspect): Escape in the editor reaches the page under it (Settings' Back,
        // the Usage page's), and the editor stays (user decision 2026-10-08). An open
        // colour popover is aria-modal, so its Escape is its own: it closes and the focus goes to the swatch.
        button press=close aria-label="Close the theme editor" class=SettingsGhost width="1.5rem" height="1.5rem" border-radius="0.5rem" cursor="default" testId="theme-editor-close" title=""
          CoreIcon(name="x", size=14, color=pal.muted)
      if not minimized
        // ThemeEditorPanel's name input has `autoFocus`: the focus moves to it as the body mounts.
        DialogOpenFocus(target="theme-editor-name")
        scroll flex=1 min-height=0 max-height=((sized ? boxH : capH) - 5.5 * rem) width="100%"
          column padding-top="0.75rem" padding-bottom="0.75rem" padding-left="0.75rem" padding-right="0.375rem" gap="0.75rem" box-sizing="border-box" width="100%"
            row width="100%" gap="0.75rem" align-items="center"
              text "Theme name" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text width="8rem" flex-shrink=0
              input id="theme-editor-name" value=(named ? name : editor.name) input=editName placeholder=(editor.title == "Edit theme" ? "Theme name" : "e.g. Aurora") aria-label="Theme name" spellcheck="false" flex=1 min-width=0 height="1.75rem" padding-top="0.1875rem" padding-bottom="0.1875rem" line-height="1.25rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field font-size="0.875rem" color=pal.text testId="theme-editor-name" autocorrect="off" data-editable="yes"
                ::placeholder
                  color=pal.muted
            row width="100%" gap="0.75rem" align-items="center"
              text "Appearance" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text width="8rem" flex-shrink=0
              row role="group" aria-label="Theme appearance" padding="0.125rem" gap="0.125rem" border-radius="0.5rem" background-color=pal.highlight
                EditorToggle(label="Light", on=(editor.appearance == "light"), pal=pal, press=commit("theme-editor", "appearance", "light"))
                EditorToggle(label="Dark", on=(editor.appearance == "dark"), pal=pal, press=commit("theme-editor", "appearance", "dark"))
            column width="100%" gap="0.75rem"
              row width="100%" gap="0.75rem" align-items="flex-start"
                column width="8rem" flex-shrink=0
                  text "Colors" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text role="heading" aria-level=3
                  if not editor.advanced
                    text "Two colors, rest derived" font-size="0.75rem" line-height="1rem" color=pal.muted
                row flex=1 min-width=0 gap="0.75rem" align-items="flex-start"
                  if editor.advanced
                    for filterValue in [editor.filter] key=filterValue
                      EditorFilter(value=filterValue, pal=pal, commit=commit("theme-editor", "filter"))
                  else
                    box flex=1
                  row gap="0.5rem" align-items="center" padding-top="0.125rem" flex-shrink=0
                    text "Advanced" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text
                    button press=toggleAdvanced role="switch" aria-checked=editor.advanced aria-label="Advanced Use advanced theme colors" class=SettingsGhost justify-content="flex-start" width="1.875rem" height="1.125rem" padding="0.125rem" border-radius="0.4375rem" background-color=(editor.advanced ? pal.accent : pal.switchOff) testId="theme-editor-advanced" title=""
                      box width="0.875rem" height="0.875rem" border-radius="0.4375rem" background-color=(editor.advanced ? pal.thumb : pal.thumbOff) margin-left=(editor.advanced ? "0.75rem" : "0px")
              if editor.advanced
                column width="100%" gap="1.25rem"
                  for group in editor.groups key=group.id
                    column width="100%" gap="0.5rem"
                      text group.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text role="heading" aria-level=4
                      column width="100%" gap="0.25rem"
                        for row in group.rows key=row.id
                          EditorColorRow(pick=pickRole, selected=(selected == row.role), select=selectRole, row=row, session=editor.session, pal=pal, commit=commit, live=live)
                  if editor.groups.length == 0
                    text "No matches." font-size="0.75rem" line-height="1rem" color=pal.muted
              else
                column width="100%" gap="0.25rem"
                  for row in editor.rows key=row.id
                    EditorColorRow(pick=pickRole, selected=(selected == row.role), select=selectRole, row=row, session=editor.session, pal=pal, commit=commit, live=live)
            if error != ""
              text error role="alert" font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)" testId="theme-editor-error"
        row flex-shrink=0 justify-content="flex-end" align-items="center" gap="0.5rem" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" border-top-width=1 border-top-style="solid" border-color=pal.divider box-sizing="border-box"
          button press=close class=SettingsGhost height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" testId="theme-editor-cancel"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text
          button press=save(named ? name : editor.name) disabled=(busy or (named ? name : editor.name) == "" or not editor.canSave) class=SettingsGhost height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" gap="0.375rem" border-radius="0.5rem" background-color=pal.accent opacity=(busy or (named ? name : editor.name) == "" or not editor.canSave ? 0.64 : 1) testId="theme-editor-save"
            if editor.saveIcon != ""
              CoreIcon(name=editor.saveIcon, size=16, color=pal.accentText)
            text editor.saveLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.accentText

      // The corner grip (aria-hidden in the reference): grows toward the right and bottom only.
      if not minimized
        box position="absolute" right=0 bottom=0 width="1.25rem" height="1.25rem" z-index=10 padding="0.25rem" box-sizing="border-box" display="flex" align-items="flex-end" justify-content="flex-end" touch-action="none" cursor="se-resize" pan=grow panrelease=dropGrow aria-hidden=true testId="theme-editor-grip"
          svg width="0.625rem" height="0.625rem" viewBox="0 0 8 8" fill="none"
            path d="M7 1 1 7M7 4.5 4.5 7" stroke=pal.muted stroke-width=1.2 stroke-linecap="round"

component EditorToggle
  props
    label: string
    on: bool
    pal: CorePalette
    press: action
  view
    button press=press role="radio" aria-checked=on class=SettingsGhost height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" background-color=(on ? pal.canvas : "#00000000") box-shadow=(on ? "0 1px 2px #0000000d" : "none") testId=`theme-editor-appearance-${label}`
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(on ? pal.text : pal.muted)

component EditorFilter
  props
    value: string
    pal: CorePalette
    commit: action
  state draft = ""
  state edited = false
  action edit(next: string)
    draft = next
    edited = true
  view
    input value=(edited ? draft : value) input=edit change=commit placeholder="Filter colors" aria-label="Filter colors" spellcheck="false" flex=1 min-width=0 height="1.75rem" padding-top="0.1875rem" padding-bottom="0.1875rem" line-height="1.25rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field font-size="0.875rem" color=pal.text testId="theme-editor-filter" autocorrect="off" id="field-theme-editor-filter" data-editable="yes"
      ::placeholder
        color=pal.muted

// ThemeColorField: the family label, the swatch (opens the picker) and the hex value.
component EditorColorRow
  props
    selected: bool
    select: action
    pick: action
    row: EditorRow
    session: string
    pal: CorePalette
    commit: action
    live: action
  state hovered = false
  state draft = ""
  state editing = false
  action hover(over: bool)
    hovered = over
  action edit(next: string)
    draft = next
    editing = true
  action leave
    editing = false
  view
    row width="100%" height="2.75rem" padding-top="0.375rem" padding-bottom="0.375rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" align-items="center" box-sizing="border-box" border-radius="0.5rem" hover=hover background-color=(selected or hovered ? pal.highlight : "#00000000") id=`theme-editor-row-${row.role}` testId=`theme-editor-row-${row.id}`
      button press=select(row.role) aria-pressed=selected aria-label=`Highlight ${row.label} uses` testId=`theme-editor-select-${row.id}` flex=1 min-width=0 padding=0 border-width=0 background-color="#00000000" text-align="left"
        text row.label font-size="0.875rem" line-height="1.25rem" color=(selected or hovered ? pal.text : pal.muted) line-clamp=1
      ThemeColorSwatch(select=pick(row.role), row=row, session=session, pal=pal, live=live)
      input value=(editing ? draft : row.value) input=edit change=commit("theme-editor", `color:${row.role}`) blur=leave aria-label=`${row.label} hex value` spellcheck="false" width="7rem" height="1.875rem" flex-shrink=0 padding-top="0.25rem" padding-bottom="0.25rem" line-height="1.25rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field font-family="ui-monospace" font-size="0.75rem" color=pal.text testId=`theme-editor-hex-${row.id}` autocorrect="off" id=`field-theme-editor-hex-${row.id}` data-editable="yes"
