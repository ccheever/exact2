// Settings › Appearance's prompt sample, adapted from T3 Code (MIT, see LICENSE-T3):
// SettingsFontPreviews.tsx PromptFontPreview, "a live composer editor: type in it to feel the
// family and size". It holds the composer's serialized sample (a `$skill` and two Markdown file
// links, drawn as chips) in separate root state, so typing never reaches a thread's draft or sends,
// and a remount (Advanced on or off) starts it again from the sample. Its editable sample has its own
// value and never changes the active thread's metadata. The chips are the editor's atoms, so the field
// styles Markdown, where PromptFontPreview disables rich syntax (LLP 1045.000 D3: atoms are Markdown's).
use ComposerRichView, citation, context, file, mention, skill, composerAtomFace from "../composer/composer-rich.contract"
use CorePalette from "../settings/settings-core-shared.contract"

fn promptPreviewSample(): string = "Use $frontend-design to fix the flaky test in [surface.test.ts](apps/web/src/terminal/ghostty/surface.test.ts) and align the header with [SettingsPanels.tsx](apps/web/src/components/settings/SettingsPanels.tsx) before shipping."

component PromptFontPreview
  inject
    richPromptPreview: ComposerRichView
    promptPreviewText: string
    promptPreviewWrite: action
    promptPreviewOwner: string
    promptPreviewSnapshotOwner: string
    promptPreviewSerial: number
    composerChipPress: action
  props
    family: string
    size: number
    pal: CorePalette
  derive faces = richPromptPreview.chips.map((c) => composerAtomFace(c))
  action write(value: string, e: InputEvent)
    promptPreviewWrite(value, e)
  action pressed(e: AtomEvent)
    composerChipPress("preview", promptPreviewOwner, promptPreviewText, promptPreviewSerial, e.start, e.end, e.source, false)
  view
    // rounded-lg border bg-background px-3 py-2 around ComposerPromptEditor (max-h-42, leading-relaxed):
    // the bare box (appearance none: no field look), and focus:outline-none is `outline="none"`, no focus ring
    // (main #459).
    column width="100%" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.border background-color=pal.thumb box-sizing="border-box" id=`paint-PromptFontPreview-1-${family}` data-paint="border canvas" data-pick="canvas"
      scroll width="100%" max-height="10.5rem"
        box position="relative" width="100%" id="prompt-preview-field-wrap"
          textarea data-focus-stop="enabled page" value=promptPreviewText input=write markup="markdown" atoms="citation context file mention skill" atomFaces=faces atompress=pressed hatch="t3-prompt-preview" data-snapshot-owner=promptPreviewSnapshotOwner data-owner=promptPreviewOwner aria-label="Prompt font preview" placeholder="Ask anything. @ files, $ skills, / commands" testId="prompt-font-preview" appearance="none" width="100%" field-sizing="content" padding=0 border-width=0 box-sizing="border-box" background-color="#00000000" font-family=family font-size=size line-height=`${size * 1.625}px` color=pal.text caret-color=pal.text autocorrect="off" outline="none" id="prompt-font-preview" data-paint="text" data-pick="text" data-editable="yes"
            // The editor's placeholder role (text-placeholder, at 75% there); the palette has no 75% token.
            ::placeholder
              color=pal.muted
