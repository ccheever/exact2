// ServerBrowserSurface.tsx, T3 Code 9c161462c9 (MIT, LICENSE-T3).
// Page pixels use Exact's ordinary image leaf. Inputs keep page CSS coordinates.
shape ServerBrowserFrame
  decoding: bool
  decodeSequence: number
  attention: bool
  runtimeId: string
  image: string
  seq: number
  connected: bool
  width: number
  height: number
  label: string
  canOperate: bool
  controlled: bool
  anotherViewer: bool
  dialogType: string
  dialogMessage: string
  dialogDefault: string
  pointerX: number
  pointerY: number
  pointerSequence: number
  pointerClick: bool
  clipboard: string
  clipboardSequence: number
  chooserId: string
  chooserMultiple: bool
  chooserAccept: string
  transferError: string
  refused: bool
  gone: bool
  setupNeed: string
  setupCommand: string

component ServerBrowserPage
  props
    runtimeId: string
    url: string
    pageWidth: number
    pageHeight: number
    followSize: bool
    mini: bool
  inject
    serverFrame: ServerBrowserFrame
    serverMiniFrame: ServerBrowserFrame
    streamPainted: action
    streamControl: action
    streamMouse: action
    streamWheel: action
    streamKey: action
    streamText: action
    streamDialog: action
    streamUpload: action
    streamMeasured: action
  derive frame = mini ? serverMiniFrame : serverFrame
  derive imageScale = frame.width > 0 and frame.height > 0 ? min(pageWidth / frame.width, pageHeight / frame.height) : 1
  derive pointerLeft = (pageWidth - frame.width * imageScale) / 2 + frame.pointerX * imageScale
  derive pointerTop = (pageHeight - frame.height * imageScale) / 2 + frame.pointerY * imageScale
  action chooseFiles
    showPicker(`server-browser-file-picker-${runtimeId}`)
  action picked(files: Picked[])
    streamUpload(runtimeId, frame.chooserId, files)
  action cancelFiles
    streamUpload(runtimeId, frame.chooserId, [])
  state composing = false
  state typed = ""
  state promptText = ""
  state promptFor = ""
  derive prompt = promptFor == frame.dialogMessage ? promptText : frame.dialogDefault
  action measured(width: number, height: number)
    streamMeasured(runtimeId, width, height, followSize)
  action painted
    streamPainted(runtimeId, frame.image)
  action broken(message: string)
    streamPainted(runtimeId, frame.image)
  action control(kind: string)
    streamControl(runtimeId, kind)
  action mouse(phase: string, e: PointerEvent)
    if frame.controlled
      if phase == "down"
        focus(`server-browser-keys-${runtimeId}`)
      streamMouse(runtimeId, e, phase, pageWidth, pageHeight)
  action wheel(e: WheelEvent)
    if frame.controlled
      preventDefault()
      streamWheel(runtimeId, e, "", pageWidth, pageHeight)
  action key(phase: string, k: string, e: KeyboardEvent)
    if frame.controlled and not composing and k != "Process" and k != "Unidentified"
      if k == "Escape" and e.shiftKey
        preventDefault()
        blur()
      else if k.length != 1 or e.ctrlKey or e.metaKey
        if not ((e.ctrlKey or e.metaKey) and (k == "v" or k == "V")) and not (e.shiftKey and k == "Insert")
          preventDefault()
          streamKey(runtimeId, e, phase)
  action input(text: string, e: InputEvent)
    composing = e.isComposing
    typed = text
    if not e.isComposing and text != ""
      streamText(runtimeId, text)
      typed = ""
  action promptEdit(text: string)
    promptFor = frame.dialogMessage
    promptText = text
  action dialog(accept: bool)
    streamDialog(runtimeId, accept, prompt)
  view
    box width="100%" height="100%" position="relative" overflow="hidden" background-color="light-dark(#f4f4f5, #171717)" testId="server-browser-surface" resize=measured
      if frame.image != ""
        image frame.image load=painted error=broken width="100%" height="100%" object-fit="contain" aria-label="Server browser page" testId="server-browser-image" pointerdown=mouse("down") pointermove=mouse("move") pointerup=mouse("up") wheel=wheel
      if frame.pointerSequence >= 0 and not frame.controlled
        svg position="absolute" left=pointerLeft top=pointerTop width=18 height=24 viewBox="0 0 18 24" fill="#3b82f6" stroke="#ffffff" stroke-width=1.5 aria-hidden=true pointer-events="none" testId="server-browser-agent-pointer"
          path d="M1 1v18l4-5 4 8 4-2-4-8h8Z"
      textarea id=`server-browser-keys-${runtimeId}` value=typed input=input key=key("down") keyup=key("up") aria-label="Type in browser page" tabindex=-1 width=1 height=1 position="absolute" left=0 bottom=0 opacity=0 autocorrect="off" spellcheck="false"
      if frame.image == "" and not frame.refused and not frame.gone and frame.setupNeed == ""
        text "Connecting to browser…" position="absolute" left="1rem" top="3rem" color="light-dark(#71717a, #a1a1aa)"
      row position="absolute" top=(mini ? "auto" : "0.5rem") bottom=(mini ? "0.5rem" : "auto") right="0.5rem" align-items="center" gap="0.5rem" padding="0.375rem 0.5rem" border-radius="0.5rem" background-color="light-dark(#fffffff0, #171717f0)" box-shadow="0 1px 3px #00000033" testId="server-browser-control"
        text frame.label font-size="0.75rem"
        if frame.canOperate
          button (frame.controlled ? "Release control" : "Take control") disabled=frame.anotherViewer press=control(frame.controlled ? "releaseControl" : "takeControl") testId="server-browser-take-control"
      if frame.refused or frame.gone or frame.setupNeed != ""
        column position="absolute" left="1rem" top="3rem" right="1rem" gap="0.5rem" padding="1rem" background-color="light-dark(#ffffff, #171717)" border-radius="0.5rem" role="alert" testId="server-browser-error"
          text (frame.gone ? "This browser tab has closed." : frame.refused ? "Browser access was refused. Reconnect to the environment and try again." : "Set up the browser on this environment.")
          if frame.setupCommand != ""
            text frame.setupCommand user-select="text" font-family="monospace"
          button "Retry" press=control("retry") testId="server-browser-retry"
      if frame.chooserId != "" and frame.controlled
        row position="absolute" bottom="0.5rem" left="0.5rem" gap="0.5rem" padding="0.5rem" background-color="light-dark(#ffffff, #171717)" border-radius="0.5rem" role="group" aria-label="Browser file picker"
          text "Choose files for this page" font-size="0.75rem"
          button "Choose files…" press=chooseFiles testId="server-browser-choose-files"
          button "Cancel" press=cancelFiles
          input type="file" id=`server-browser-file-picker-${runtimeId}` display="none" multiple=frame.chooserMultiple change=picked
      if frame.transferError != ""
        text frame.transferError role="alert" position="absolute" bottom="3rem" left="0.5rem" right="0.5rem" padding="0.5rem" background-color="light-dark(#ffffff, #171717)"
      dialog id=`server-browser-dialog-${runtimeId}` role="dialog" aria-label="Browser dialog" cancel=dialog(false)
        column gap="0.75rem" padding="1rem" min-width="18rem"
          text frame.dialogMessage white-space="pre-wrap"
          if frame.dialogType == "prompt" and frame.controlled
            input value=prompt input=promptEdit aria-label="Browser prompt" testId="server-browser-prompt"
          row justify-content="flex-end" gap="0.5rem"
            if not frame.controlled
              text frame.label
              button "Take control" disabled=(not frame.canOperate or frame.anotherViewer) press=control("takeControl")
            if frame.dialogType != "alert" and frame.controlled
              button "Cancel" press=dialog(false) commandfor=`server-browser-dialog-${runtimeId}` command="close"
            button "OK" disabled=(not frame.controlled) press=dialog(true) commandfor=`server-browser-dialog-${runtimeId}` command="close"
