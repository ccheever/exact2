// ServerBrowserSurface.tsx, T3 Code 2359643cff (MIT, LICENSE-T3; its PDF overlay at 74541bab17).
// Page pixels use Exact's ordinary image leaf. Inputs keep page CSS coordinates.
use ViewerFrame from "../panel/viewer-frame.contract"
use ViewerFrameView from "../panel/viewer-frame.contract"
use BrowserPip from "./browser-shapes.contract"
shape ServerBrowserFrame
  decoding: bool
  decodeSequence: number
  attention: bool
  runtimeId: string
  image: string
  seq: number
  connected: bool
  width: number
  height: number
  label: string
  canOperate: bool
  controlled: bool
  anotherViewer: bool
  dialogType: string
  dialogMessage: string
  dialogDefault: string
  pointerX: number
  pointerY: number
  pointerSequence: number
  pointerClick: bool
  clipboard: string
  clipboardSequence: number
  chooserId: string
  chooserMultiple: bool
  chooserAccept: string
  transferError: string
  refused: bool
  gone: bool
  setupNeed: string
  setupCommand: string

component ServerBrowserPage
  props
    runtimeId: string
    url: string
    // The environment's PDF the tab shows, drawn here over the server's placeholder page (ServerBrowserSurface `pdfUrl`):
    // its signed URL, which the viewer page's PDF.js reads (`pdfViewer`, server-pdf-viewer.ts), where the reference
    // embeds the URL in the browser's own viewer.
    pdfUrl: string
    pdfViewer: ViewerFrameView
    local: action
    pageWidth: number
    pageHeight: number
    followSize: bool
    mini: bool
  inject
    scheme: string
    serverFrame: ServerBrowserFrame
    serverMiniFrame: ServerBrowserFrame
    streamPainted: action
    streamControl: action
    streamMouse: action
    streamWheel: action
    streamKey: action
    streamText: action
    streamDialog: action
    streamUpload: action
    streamMeasured: action
    interacted: action
  derive frame = mini ? serverMiniFrame : serverFrame
  derive imageScale = frame.width > 0 and frame.height > 0 ? min(pageWidth / frame.width, pageHeight / frame.height) : 1
  derive pointerLeft = (pageWidth - frame.width * imageScale) / 2 + frame.pointerX * imageScale
  derive pointerTop = (pageHeight - frame.height * imageScale) / 2 + frame.pointerY * imageScale
  action chooseFiles
    showPicker(`server-browser-file-picker-${runtimeId}`)
  action picked(files: Picked[])
    streamUpload(runtimeId, frame.chooserId, files)
  action cancelFiles
    streamUpload(runtimeId, frame.chooserId, [])
  state composing = false
  state reconnectOver = false
  action reconnectHover(on: bool)
    reconnectOver = on
  state typed = ""
  state promptText = ""
  state promptFor = ""
  derive prompt = promptFor == frame.dialogMessage ? promptText : frame.dialogDefault
  action measured(width: number, height: number)
    streamMeasured(runtimeId, width, height, followSize)
  action painted
    streamPainted(runtimeId, frame.image)
  action broken(message: string)
    streamPainted(runtimeId, frame.image)
  action control(kind: string)
    streamControl(runtimeId, kind)
  // A mouse's Back (button 3) and Forward (4) step this tab's history at the release, never the page; the release's
  // preventDefault keeps the window's own history where it is.
  action mouse(phase: string, e: PointerEvent)
    interacted()
    if e.button == 3 or e.button == 4
      if phase == "up"
        preventDefault()
        streamControl(runtimeId, e.button == 3 ? "back" : "forward")
    else if frame.controlled and pdfUrl == ""
      if phase == "down"
        focus(`server-browser-keys-${runtimeId}`)
      streamMouse(runtimeId, e, phase, pageWidth, pageHeight)
  action wheel(e: WheelEvent)
    if frame.controlled and pdfUrl == ""
      preventDefault()
      streamWheel(runtimeId, e, "", pageWidth, pageHeight)
  // ⌘C or ⌘X reached the page as its key: the field's copy or cut that follows it must not send the chord again.
  state keyClip = false
  action key(phase: string, k: string, e: KeyboardEvent)
    if (e.ctrlKey != e.metaKey) and not e.altKey and not e.shiftKey and (k == "c" or k == "C" or k == "x" or k == "X")
      keyClip = phase == "down" and frame.controlled
    if frame.controlled and not composing and not e.isComposing and k != "Process" and k != "Unidentified"
      if k == "Escape" and e.shiftKey
        preventDefault()
        blur()
      else if k.length != 1 or e.ctrlKey or e.metaKey
        if not ((e.ctrlKey or e.metaKey) and (k == "v" or k == "V")) and not (e.shiftKey and k == "Insert")
          preventDefault()
          streamKey(runtimeId, e, phase)
  action input(text: string, e: InputEvent)
    composing = e.isComposing
    typed = text
    if not e.isComposing and text != ""
      streamText(runtimeId, text)
      typed = ""
  // Edit › Copy and Cut fire no key, so the shortcut the server copies on is sent (Control+C or X); the field's own copy
  // never runs, which keeps its typing buffer off the clipboard.
  action clip(kind: string)
    preventDefault()
    if keyClip
      keyClip = false
    else if frame.controlled
      streamControl(runtimeId, kind)
  action promptEdit(text: string)
    promptFor = frame.dialogMessage
    promptText = text
  action dialog(accept: bool)
    streamDialog(runtimeId, accept, prompt)
  // The viewer page's messages, by this page's runtime and place (server-pdf-viewer.ts).
  action pdfSaid(payload: string)
    local(`surface-server-pdf-viewer:${payload}`, runtimeId, mini ? "mini" : "tab")
  action pdfPosted(key: string)
    local(`surface-server-pdf-viewer-posted:${key}`, runtimeId, mini ? "mini" : "tab")
  action pdfPicked(value: string)
    local(`surface-server-pdf-viewer-pick:${value}`, runtimeId, mini ? "mini" : "tab")
  view
    box width="100%" height="100%" position="relative" overflow="hidden" background-color="light-dark(#f4f4f5, #171717)" testId="server-browser-surface" resize=measured
      if frame.image != ""
        image frame.image load=painted error=broken width="100%" height="100%" object-fit="contain" aria-label="Server browser page" testId="server-browser-image" pointerdown=mouse("down") pointermove=mouse("move") pointerup=mouse("up") wheel=wheel
      // A PDF renders in this client and cannot appear in the server's stream: the viewer page reading its signed URL
      // covers it, and the agent's cursor and page input stand down.
      if pdfUrl != ""
        column position="absolute" left=0 top=0 right=0 bottom=0
          ViewerFrame(frame=pdfViewer, scheme=scheme, sheet=false, message=pdfSaid, posted=pdfPosted, pick=pdfPicked, label="PDF document", testId="server-browser-pdf")
      if frame.pointerSequence >= 0 and not frame.controlled and pdfUrl == ""
        svg position="absolute" left=pointerLeft top=pointerTop width=18 height=24 viewBox="0 0 18 24" fill="#3b82f6" stroke="#ffffff" stroke-width=1.5 aria-hidden=true pointer-events="none" testId="server-browser-agent-pointer"
          path d="M1 1v18l4-5 4 8 4-2-4-8h8Z"
      textarea id=`server-browser-keys-${runtimeId}` value=typed input=input key=key("down") keyup=key("up") copy=clip("copy") cut=clip("cut") aria-label="Type in browser page" tabindex=-1 width=1 height=1 position="absolute" left=0 bottom=0 opacity=0 autocorrect="off" spellcheck="false" data-editable="yes"
      if frame.image == "" and not frame.refused and not frame.gone and frame.setupNeed == ""
        text "Connecting to browser…" position="absolute" left="1rem" top="3rem" color="light-dark(#71717a, #a1a1aa)"
      row position="absolute" top=(mini ? "auto" : "0.5rem") bottom=(mini ? "0.5rem" : "auto") right="0.5rem" align-items="center" gap="0.5rem" padding="0.375rem 0.5rem" border-radius="0.5rem" background-color="light-dark(#fffffff0, #171717f0)" box-shadow="0 1px 3px #00000033" testId="server-browser-control"
        text frame.label font-size="0.75rem"
        if frame.canOperate
          button (frame.controlled ? "Release control" : "Take control") disabled=frame.anotherViewer press=control(frame.controlled ? "releaseControl" : "takeControl") testId="server-browser-take-control"
      // The access-denied state covers the page, which can be invisible beneath it, so Reconnect stays reachable.
      if frame.refused and not frame.gone and frame.setupNeed == ""
        column position="absolute" left=0 top=0 right=0 bottom=0 align-items="center" justify-content="center" gap="0.5rem" padding="0.75rem" background-color="light-dark(#fcfcfc, #000000)" text-align="center" testId="server-browser-error"
          text "Browser connection was refused." role="alert" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
          button press=control("retry") hover=reconnectHover testId="server-browser-retry" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color=(reconnectOver ? "light-dark(#f4f4f5, #ffffff0f)" : "light-dark(#ffffff, #ffffff09)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center"
            text "Reconnect" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#18181b, #f5f5f5)"
      if frame.gone or frame.setupNeed != ""
        column position="absolute" left="1rem" top="3rem" right="1rem" gap="0.5rem" padding="1rem" background-color="light-dark(#ffffff, #171717)" border-radius="0.5rem" role="alert" testId="server-browser-error"
          text (frame.gone ? "This browser tab has closed." : "Set up the browser on this environment.")
          if frame.setupCommand != ""
            text frame.setupCommand user-select="text" font-family="monospace"
          button "Retry" press=control("retry") testId="server-browser-retry"
      if frame.chooserId != "" and frame.controlled
        row position="absolute" bottom="0.5rem" left="0.5rem" gap="0.5rem" padding="0.5rem" background-color="light-dark(#ffffff, #171717)" border-radius="0.5rem" role="group" aria-label="Browser file picker"
          text "Choose files for this page" font-size="0.75rem"
          button "Choose files…" press=chooseFiles testId="server-browser-choose-files"
          button "Cancel" press=cancelFiles
          input type="file" id=`server-browser-file-picker-${runtimeId}` display="none" multiple=frame.chooserMultiple change=picked
      if frame.transferError != ""
        text frame.transferError role="alert" position="absolute" bottom="3rem" left="0.5rem" right="0.5rem" padding="0.5rem" background-color="light-dark(#ffffff, #171717)"
      dialog id=`server-browser-dialog-${runtimeId}` role="dialog" aria-label="Browser dialog" cancel=dialog(false)
        column gap="0.75rem" padding="1rem" min-width="18rem"
          text frame.dialogMessage white-space="pre-wrap"
          if frame.dialogType == "prompt" and frame.controlled
            input value=prompt input=promptEdit autocorrect="off" aria-label="Browser prompt" testId="server-browser-prompt" id="field-server-browser-prompt" data-editable="yes"
          row justify-content="flex-end" gap="0.5rem"
            if not frame.controlled
              text frame.label
              button "Take control" disabled=(not frame.canOperate or frame.anotherViewer) press=control("takeControl")
            if frame.dialogType != "alert" and frame.controlled
              button "Cancel" press=dialog(false) commandfor=`server-browser-dialog-${runtimeId}` command="close"
            button "OK" disabled=(not frame.controlled) press=dialog(true) commandfor=`server-browser-dialog-${runtimeId}` command="close"

// serverPictureInPicture.ts's hidden video: the tab's own stream (server-browser-members.contract `serverPipFrame`)
// paints a 1-point image that `requestPictureInPicture` floats; the window shows each picture it names next. The
// window's close, or the pill's `exitPictureInPicture()`, is `leavepictureinpicture`; a failure is
// `pictureinpictureerror`; the image unmounted closes the window.
component ServerBrowserPip
  props
    pip: BrowserPip
    local: action
  inject
    serverPipFrame: ServerBrowserFrame
    streamPainted: action
  derive streamed = serverPipFrame.runtimeId == pip.runtimeId and serverPipFrame.image != ""
  action painted
    if streamed
      streamPainted(pip.runtimeId, serverPipFrame.image)
  action broken(message: string)
    painted()
  action left
    local("surface-browser-pip-left", pip.runtimeId, "")
  // The platform could not float it (LLP 1042 §9's `pictureinpictureerror`): the reference's rejected open.
  action failed(message: string)
    local("surface-browser-pip-failed", pip.runtimeId, message)
  view
    if streamed or pip.seed != ""
      image (streamed ? serverPipFrame.image : pip.seed) id="server-browser-pip" load=painted error=broken leavepictureinpicture=left pictureinpictureerror=failed aria-hidden=true position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" testId="server-browser-pip"
