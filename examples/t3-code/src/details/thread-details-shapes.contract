// The thread details card's choosable items, Servers and Usage, as shellDetails gives them (thread-details-items.ts,
// thread-servers.ts, thread-details-usage.ts).

// resolveThreadDetailsVisibility: each item on or off.
shape DetailsItems
  environment: bool
  openIn: bool
  scripts: bool
  branch: bool
  gitActions: bool
  changes: bool
  servers: bool
  automations: bool
  lineage: bool
  usage: bool

shape DetailsItemRow
  id: string
  label: string
  checked: bool

// ThreadDetailsItemsMenuItems: a checkbox per item, then Reset to default.
shape DetailsItemsMenu
  items: DetailsItemRow[]
  resetDisabled: bool

shape ThreadServerRow
  key: string
  port: number
  label: string
  source: string
  stoppable: bool
  stopping: bool

shape ThreadServersView
  show: bool
  canOpen: bool
  busy: bool
  rows: ThreadServerRow[]

// `left` is -1 for a row with no percentage; `tone` is "", "warning" or "error".
shape UsageRow
  id: string
  label: string
  left: number
  value: string
  tone: string
  muted: bool
  spaced: bool
  aria: string
  tip: string
  tipLines: string[]

shape UsageView
  show: bool
  rows: UsageRow[]
  labelWidth: number
  valueWidth: number
