// The workspace card's Version Control rows and their popups, after
// T3 Code (MIT; see LICENSE-T3): BranchToolbarBranchSelector + BranchPicker in the
// panel display mode, GitActionsControl (panel: the split quick action, its options
// menu, the inline progress and success rows, Initialize Git) and its commit,
// default-branch and publish dialogs. The rows and their popovers live in the card
// (shell-details.contract): the ref picker hangs under the whole branch row at its
// width, the options menu under the chevron, end-aligned to the row; the host owns
// their open state, light dismiss, Escape and the search field's focus. The dialogs
// are drawn over the window (app-overlays.contract). `act` is the card's detailsAct
// (server writes as `shell:git-*`); `local` is chatLocal (`chatlocal:git-*` view
// state, keystrokes without the command gate).
use ShellDetails from "../shell/shell-shapes.contract"
use GitCard from "./git-shapes.contract"
use GitMenuItem from "./git-shapes.contract"
use GitFile from "./git-shapes.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use CnMachineIcon from "../settings/settings-b-kit.contract"
use RunOnOption from "./git-shapes.contract"
use DetailsPrRows from "../panel/pr-attachment.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use RefPageScroll from "../composer/ref-paging.contract"

keyframes gitSpin
  from rotate=0
  to rotate=360

fn gitAdd(scheme: string): string = scheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "#00bc7d"
fn gitDel(scheme: string): string = scheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #fb414a)"

// Lucide glyphs the shell set lacks, and the source-control host marks.
component ExtraGlyph
  props
    name: string
    size: number
    color: string
  view
    if name == "github"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 16 16" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
        path fill-rule="evenodd" clip-rule="evenodd" d="M8 0C3.58 0 0 3.58 0 8C0 11.54 2.29 14.53 5.47 15.59C5.87 15.66 6.02 15.42 6.02 15.21C6.02 15.02 6.01 14.39 6.01 13.72C4 14.09 3.48 13.23 3.32 12.78C3.23 12.55 2.84 11.84 2.5 11.65C2.22 11.5 1.82 11.13 2.49 11.12C3.12 11.11 3.57 11.7 3.72 11.94C4.44 13.15 5.59 12.81 6.05 12.6C6.12 12.08 6.33 11.73 6.56 11.53C4.78 11.33 2.92 10.64 2.92 7.58C2.92 6.71 3.23 5.99 3.74 5.43C3.66 5.23 3.38 4.41 3.82 3.31C3.82 3.31 4.49 3.1 6.02 4.13C6.66 3.95 7.34 3.86 8.02 3.86C8.7 3.86 9.38 3.95 10.02 4.13C11.55 3.09 12.22 3.31 12.22 3.31C12.66 4.41 12.38 5.23 12.3 5.43C12.81 5.99 13.12 6.7 13.12 7.58C13.12 10.65 11.25 11.33 9.47 11.53C9.76 11.78 10.01 12.26 10.01 13.01C10.01 14.08 10 14.94 10 15.21C10 15.42 10.15 15.67 10.55 15.59C13.71 14.53 16 11.53 16 8C16 3.58 12.42 0 8 0Z"
    else
      if name == "git-branch-plus" or name == "search" or name == "lock" or name == "globe" or name == "loader-circle" or name == "refresh-cw" or name == "gitlab" or name == "forgejo" or name == "bitbucket" or name == "azure-devops"
        svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d=(name == "git-branch-plus" ? "M6 3v12M18 9a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM6 21a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM15 6a9 9 0 0 0-9 9M18 15v6M21 18h-6" : name == "search" ? "m21 21-4.34-4.34M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" : name == "lock" ? "M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-7a2 2 0 0 1 2 -2ZM7 11V7a5 5 0 0 1 10 0v4" : name == "globe" ? "M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20M2 12h20" : name == "loader-circle" ? "M21 12a9 9 0 1 1-6.219-8.56" : name == "refresh-cw" ? "M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5" : "M6 3h12a3 3 0 0 1 3 3v12a3 3 0 0 1 -3 3h-12a3 3 0 0 1 -3 -3v-12a3 3 0 0 1 3 -3ZM8 12h8M12 8v8")
      else
        ShellIcon(name=name, size=size, color=color)

// THREAD_DETAILS_PANEL rows: the branch select, the split quick action (or
// Initialize Git), Changes, and the status error. Replaces the card's static rows.
component GitRows
  inject
    rem: number
  props
    details: ShellDetails
    // ThreadDetailsCard's compact and essential rows (GitActionsControl compact): the action group shows only while an
    // action runs or just finished.
    compact: bool
    // The docked card (280pt) or the popover (264pt): the menus take its inner width.
    inline: bool
    act: action
    local: action
  state hovered = ""
  state groupHovered = false
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action hoverGroup(over: bool)
    groupHovered = over
  derive menuItems = details.git.menu.filter((item) => not item.disabled).map((item) => KmItem(id=`details-git-menu-${item.id}`, label=item.label))
  action gitMenuKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        local("git-open", "menu", "")
        showPopover("details-git-options", source="details-git-menu")
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    if details.git.branch.show
      // The whole row is the combobox trigger; its chevron sits behind a hairline.
      box position="relative" width="100%"
        button popovertarget="details-branch-menu" popovertargetaction="show" press=local("git-open", "branch", "") hover=hover("branch") disabled=details.git.branch.disabled aria-label=`Branch: ${details.git.branch.label}` testId="details-branch" width="100%" height="2rem" padding-left="0.6875rem" padding-right=0 box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" opacity=(details.git.branch.disabled ? 0.64 : 1) background-color=(hovered == "branch" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" id="details-branch"
          box opacity=0.7 display="flex" flex-shrink=0
            ShellIcon(name="git-branch", size=16, color="light-dark(#71717b, #818181)")
          text details.git.branch.label flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-branch-label" text-box-trim="trim-both" text-box-edge="cap alphabetic"
          box width="2rem" height="2rem" position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
            box position="absolute" left=-1 top="0.5rem" width=1 height="1rem" background-color="light-dark(#e4e4e7a6, #ffffff10)"
            ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
        GitBranchPicker(git=details.git, width=((inline ? 262 : 246) * rem / 16), act=act, local=local)
      // The thread's pull request rows under the branch (ThreadDetailsPrRows).
      DetailsPrRows(prs=details.prRows, act=act, local=local)
    if not details.git.repo
      button press=act("shell:git-init", details.cwd, "") hover=hover("init") disabled=(details.git.initPending or not details.git.writable) testId="details-git-init" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" opacity=(details.git.initPending ? 0.64 : 1) background-color=(hovered == "init" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        ExtraGlyph(name="git-branch-plus", size=14, color="light-dark(#27272acc, #f5f5f5cc)")
        text details.git.initLabel flex=1 min-width=0 margin-left="0.125rem" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" text-box-trim="trim-both" text-box-edge="cap alphabetic"
    else
      if not compact or details.git.progress or details.git.success
        // GitActionsControl's split group: the quick action (or, while an action runs, its phase and
        // the hook's last line; after it, the inline success) beside the options chevron. A running
        // action disables the menu and its chevron slot counts the elapsed time instead. The whole
        // group lights on hover, as the reference's group surface does.
        row width="100%" min-height="2rem" align-items="center" border-radius="0.625rem" position="relative" role="group" aria-label="Git actions" hover=hoverGroup background-color=(details.git.progress ? "light-dark(#00000009, #ffffff0e)" : groupHovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") testId="details-git-group"
          // At rest the group is `full` only: its height is what the compact rows leave out (thread-details-card-layout.ts).
          if not details.git.progress and not details.git.success
            box position="absolute" left=0 top=0 bottom=0 width=0 pointer-events="none" aria-hidden=true hatch="t3-frame" data-frame="details-full-git"
          if not details.git.progress
            button id="details-git-menu" popovertarget="details-git-options" key=gitMenuKey press=local("git-open", "menu", "") hover=hover("git-menu") disabled=details.git.menuDisabled aria-label="Git action options" testId="details-git-menu" position="absolute" right=0 top=0 bottom=0 width="2rem" padding=0 border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="flex-end" title="" data-focus-stop=(details.git.menuDisabled ? "" : "enabled")
              box width="2rem" height="2rem" border-radius="0.625rem" border-top-left-radius=0 border-bottom-left-radius=0 background-color=(hovered == "git-menu" ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" align-items="center" justify-content="center"
                ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
            box position="absolute" right="2rem" top=0 bottom=0 display="flex" align-items="center" pointer-events="none"
              box width=1 height="1rem" background-color="light-dark(#e4e4e7a6, #ffffff10)"
          GitMenu(git=details.git, cwd=details.cwd, width=((inline ? 262 : 246) * rem / 16), items=menuItems, act=act)
          if details.git.progress
            column flex=1 min-width=0 padding-left="0.6875rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" role="status" aria-label=(details.git.progressOutput != "" ? `${details.git.progressStatus} ${details.git.progressOutput}` : details.git.progressStatus) testId="details-git-progress"
              row height="1.5rem" gap="0.625rem" align-items="center"
                box width="1rem" height="1rem" margin-left="-0.125rem" flex-shrink=0 display="flex" animation="gitSpin 1s linear infinite"
                  ExtraGlyph(name="loader-circle", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
                text details.git.progressStatus flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-git-progress-status" text-box-trim="trim-both" text-box-edge="cap alphabetic"
              if details.git.progressOutput != ""
                text details.git.progressOutput margin-left="1.5rem" padding-top="0.125rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
            text details.git.progressElapsed align-self="flex-start" height="2rem" padding-right="0.625rem" flex-shrink=0 font-size="0.6875rem" line-height="2rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" testId="details-git-elapsed"
          else
            if details.git.success
              column position="relative" flex=1 min-width=0 margin-right="2.0625rem" padding-left="0.6875rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" role="status" testId="details-git-success"
                row height="1.5rem" gap="0.75rem" align-items="center"
                  ShellIcon(name="check", size=14, color="light-dark(#009966, #00bc7d)")
                  text details.git.successTitle flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" font-size="0.8125rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272acc, #f5f5f5cc)" text-box-trim="trim-both" text-box-edge="cap alphabetic"
                if details.git.successDescription != ""
                  text details.git.successDescription margin-left="1.625rem" padding-top="0.125rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
            else
              box position="relative" flex=1 min-width=0 margin-right="2.0625rem" hover=hover("git")
                button id="details-git-action" press=act("shell:git-quick", details.cwd, "") disabled=details.git.quickDisabled testId="details-git-action" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" border-top-right-radius=0 border-bottom-right-radius=0 opacity=(details.git.quickDisabled ? 0.64 : 1) background-color="#00000000" display="flex" flex-direction="row" align-items="center" data-focus-stop=(details.git.quickDisabled ? "" : "enabled")
                  ExtraGlyph(name=details.git.quickIcon, size=16, color="light-dark(#71717b, #818181)")
                  text details.git.quickLabel flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-git-action-label" text-box-trim="trim-both" text-box-edge="cap alphabetic"
                TipBubble(label=details.git.quickHint, side="bottom", align="start", offset=36, inset=0, shown=(hovered == "git" and details.git.quickHint != ""))
      button press=act("ui:changes", "", "") hover=hover("changes") disabled=(not details.changesEnabled) testId="details-changes" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" opacity=(details.changesEnabled ? 1 : 0.64) background-color=(hovered == "changes" and details.changesEnabled ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        ShellIcon(name="file-diff", size=16, color="light-dark(#71717b, #818181)")
        text "Changes" flex=1 min-width=0 text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" text-box-trim="trim-both" text-box-edge="cap alphabetic"
        row gap="0.25rem" align-items="center" flex-shrink=0
          text `+${details.insertions}` font-family="ui-monospace" font-size="0.6875rem" font-weight=500 line-height="1rem" color=gitAdd(details.diffScheme)
          text `-${details.deletions}` font-family="ui-monospace" font-size="0.6875rem" font-weight=500 line-height="1rem" color=gitDel(details.diffScheme)

// The dialogs, over the window.
component GitLayers
  props
    details: ShellDetails
    windowHeight: number
    act: action
    local: action
  view
    if details.ready and details.git.dialog == "commit"
      GitCommitDialog(git=details.git, cwd=details.cwd, scheme=details.diffScheme, windowHeight=windowHeight, act=act, local=local)
    if details.ready and details.git.dialog == "confirm"
      GitConfirmDialog(git=details.git, cwd=details.cwd, act=act, local=local)

// BranchPicker's ComboboxPopup at the row's width: search, the refs, Create new
// ref, Start from origin (choosing a new worktree's base), the status line.
component GitBranchPicker
  inject
    dialogMenuEntered: action
  props
    git: GitCard
    width: number
    act: action
    local: action
  state hovered = -1
  state focused = true
  action hover(index: number, over: bool)
    hovered = over ? index : (hovered == index ? -1 : hovered)
  action searchFocus(value: bool)
    focused = value
  action acceptedReturn
    if git.branch.enterOp != ""
      hidePopover("details-branch-menu")
      focus("details-branch")
      act(git.branch.enterOp, "enter", git.branch.enterValue)
  view
    // BranchPicker's ComboboxPopup in the panel (align="start" side="bottom", the anchor's width): 4 pt below, flipping near an edge.
    column id="details-branch-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width=width testId="details-branch-layer" data-dialog-return="menu" focusin=dialogMenuEntered("details-branch-menu", "details-branch")
      column width="100%" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" overflow="hidden" role="dialog" aria-label="Refs" testId="details-branch-picker"
        column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" box-sizing="border-box" flex-shrink=0
          row height="2.0625rem" padding-bottom="0.375rem" box-sizing="border-box" position="relative" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color=(focused ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#e4e4e7b3, #ffffff0b)")
            box position="absolute" left=0 top="0.375rem" display="flex" pointer-events="none"
              ExtraGlyph(name="search", size=16, color="light-dark(#71717a8c, #8181818c)")
            if git.branch.query == ""
              text "Search refs..." position="absolute" left="1.25rem" top=0 font-size="0.875rem" line-height="1.625rem" color="light-dark(#71717a, #818181)" aria-hidden=true pointer-events="none"
            input id="details-branch-search" value=git.branch.query input=local("git-query", "") submit=acceptedReturn focus=searchFocus(true) blur=searchFocus(false) autofocus=true role="combobox" aria-label="Search refs" testId="details-branch-search" flex=1 min-width=0 height="1.625rem" padding-left="1.25rem" padding-right="0.5625rem" padding-top=0 padding-bottom=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false" data-focus-stop="enabled"
        if git.branch.empty != ""
          text git.branch.empty font-size="0.875rem" line-height="1.25rem" padding="0.5rem" text-align="center" color="light-dark(#71717a, #818181)"
        RefPageScroll(name="details-refs")
          column width="100%" gap=0 padding-left="0.5rem" padding-right="0.25rem" padding-top="0.75rem" padding-bottom="0.5rem" box-sizing="border-box" role="listbox"
            // A local draft's pull request reference leads (pr-checkout.ts).
            for item in git.branch.checkout key=item.reference
              button press=act("chatlocal:git-pr-open", "", item.reference) popovertarget="details-branch-menu" popovertargetaction="hide" hover=hover(0) role="option" aria-selected=false testId="details-branch-checkout-pr" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(hovered <= 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" id="details-branch-checkout-pr"
                row min-width=0 gap="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" align-items="center"
                  ExtraGlyph(name=item.mark, size=14, color="light-dark(#71717b, #818181)")
                  column min-width=0 align-items="flex-start"
                    text item.title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 text-align="left"
                    text item.reference font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" line-clamp=1 text-align="left"
            for ref in git.branch.refs key=ref.name
              button press=act("shell:git-branch", "", ref.name) popovertarget="details-branch-menu" popovertargetaction="hide" hover=hover(ref.index) role="option" aria-selected=ref.selected testId=`details-branch-${ref.name}` width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(hovered == ref.index or (hovered < 0 and ref.index == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : ref.selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="space-between"
                text ref.name font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0 flex=1 text-align="left"
                if ref.badge != ""
                  text ref.badge font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717a73, #81818173)" flex-shrink=0
            if git.branch.creatable != ""
              button press=act("shell:git-branch-create", "", git.branch.creatable) popovertarget="details-branch-menu" popovertargetaction="hide" hover=hover(git.branch.refs.length + git.branch.checkout.length) testId="details-branch-create" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(hovered == git.branch.refs.length + git.branch.checkout.length or (hovered < 0 and git.branch.refs.length + git.branch.checkout.length == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
                text `Create new ref "${git.branch.creatable}"` font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 text-align="left"
        if git.branch.originShown
          button press=local("git-origin", "", "") role="switch" aria-checked=git.branch.originOn aria-label="Start worktree from origin" testId="details-branch-origin" width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.75rem" border-width=0 border-top-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
            row min-width=0 gap="0.375rem" align-items="center"
              ExtraGlyph(name="refresh-cw", size=12, color="light-dark(#71717b, #818181)")
              text "Start from origin" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap"
            ToggleSwitch(on=git.branch.originOn)
        if git.branch.status != ""
          text git.branch.status font-size="0.75rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717a, #818181)" role="status"

// ui/switch.tsx size="sm": a 26×16 track, 12pt thumb, primary when on.
component ToggleSwitch
  props
    on: bool
  view
    row width="1.625rem" height="1rem" padding="0.125rem" box-sizing="border-box" border-radius="0.5rem" flex-shrink=0 align-items="center" justify-content=(on ? "flex-end" : "flex-start") background-color=(on ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") aria-hidden=true
      box width="0.75rem" height="0.75rem" border-radius="0.375rem" background-color="light-dark(#ffffff, #0a0a0a)" box-shadow="0 1px 2px #0000000d"

// GitActionsControl's MenuPopup (align end, the split group's width): Commit, Push,
// Create PR, Publish repository..., then the warnings; a disabled item explains itself on hover.
component GitMenu
  inject
    dialogMenuEntered: action
  props
    git: GitCard
    cwd: string
    width: number
    items: KmItem[]
    act: action
  view
    // Under the group at its width (MenuPopup anchor the group, align end, w-(--anchor-width)), flipping near an edge:
    // the chevron trigger ends where the group does, so `span-left` aligns the menu's right edge to both.
    column id="details-git-options" popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width=width testId="details-git-options-layer" data-dialog-return="menu" focusin=dialogMenuEntered("details-git-options", "details-git-menu")
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Git actions" testId="details-git-options"
        KeyMenu(menuId="details-git-options-keys", items=items, keyed=0, gap="0px", modal=true)
          for item in git.menu key=item.id
            GitMenuRow(keysId="details-git-options-keys", item=item, cwd=cwd, act=act)
        for note in git.notes key=note.id
          text note.text padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" line-height="1rem" color=(note.tone == "error" ? "light-dark(#e7000b, #ff6467)" : "light-dark(#bb4d00, #fdc700)")

component GitMenuRow
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    item: GitMenuItem
    cwd: string
    act: action
  state over = false
  state lit = false
  action hover(value: bool)
    if value and not item.disabled
      focus(`details-git-menu-${item.id}`)
    else if lit
      focus(keysId)
    over = value
  action focused(on: bool)
    lit = on
  // Base UI's Menu gives the focus back to its trigger as a chosen item closes it, so a dialog the item opens gives the
  // focus back to the chevron as it closes (DialogFinalFocus). Left to the popover's own restore, the focus went to
  // whatever held it before the menu opened (the prompt, or nothing after a pointer press), and the dialog returned there.
  action choose()
    focus("details-git-menu")
    act("shell:git-menu", cwd, item.id)
  view
    box position="relative" width="100%" hover=hover
      button id=`details-git-menu-${item.id}` press=choose popovertarget="details-git-options" popovertargetaction="hide" focus=focused(true) blur=focused(false) disabled=item.disabled role="menuitem" testId=`details-git-menu-${item.id}` width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" opacity=(item.disabled ? 0.64 : 1) background-color=(lit and not item.disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" data-focus-stop=(item.disabled ? "" : "enabled")
        box margin-left="-0.125rem" margin-right="-0.125rem" display="flex" flex-shrink=0 opacity=0.8
          ExtraGlyph(name=item.icon, size=16, color="light-dark(#71717b, #818181)")
        text item.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      // PopoverPopup tooltipStyle side="left": the reason sits left of the item.
      if item.reason != ""
        row position="absolute" right="100%" top=0 bottom=0 padding-right="0.25rem" align-items="center" pointer-events="none" z-index=72
          column max-width="20rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(over ? 1 : 0) transition=(over ? "opacity 150ms ease" : "opacity 0ms") role="tooltip" aria-hidden=(not over) testId=`details-git-menu-reason-${item.id}`
            text item.reason font-size="0.75rem" line-height="1.03125rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

// The shared dialog frame (ui/dialog.tsx DialogPopup): a blurred backdrop, a
// rounded popup centred in the window, the corner close button. Base UI's Dialog is modal and closes only the topmost
// popup on Escape, so the popup is `aria-modal` (only shortcuts inside it are heard while it shows) and Escape is its
// close button's: an Escape shortcut declared earlier outside it, such as the right panel sheet's, no longer takes it.
component DialogFrame
  inject
    dialogSeated: string[]
    dialogEntered: action
    dialogFallback: action
  props
    label: string
    maxWidth: number
    close: action
    testId: string
    // The dialog's first Tab stop, for the focus trap (dialog-trap.contract); the X is its last.
    first: string
  slot
  derive dialogTargets = [first, `${testId}-close`]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=80 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId=`${testId}-overlay`
      button press=close aria-label="Close" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId=`${testId}-backdrop` title=""
      column width="100%" max-width=maxWidth max-height="100%" position="relative" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-modal=dialogSeated.includes(testId) aria-label=label testId=testId id=testId tabindex=-1 data-dialog-focus="open" focusin=dialogEntered(testId) key=dialogFallback(testId, dialogTargets)
        // The focus trap (dialog-trap.contract): the content, then the X (DialogPopup's last child).
        FocusGuard(guardId="dialog-frame-guard-start", targets=dialogTargets, popup=testId)
        DialogOpenFocus(target=first)
        children
        button id=`${testId}-close` press=close aria-label="Close" aria-keyshortcuts="Escape" testId=`${testId}-close` position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
          ShellIcon(name="x", size=16, color="light-dark(#27272a, #f5f5f5)")
        FocusGuard(guardId="dialog-frame-guard-end", targets=dialogTargets, popup=testId)

component DialogButton
  props
    label: string
    primary: bool
    disabled: bool
    press: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  view
    button id=elementId press=press disabled=disabled testId=testId display="flex" flex-direction="row" align-items="center" justify-content="center" min-height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 opacity=(disabled ? 0.64 : 1) border-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") background-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" data-focus-stop=(disabled ? "" : "enabled")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(primary ? "#ffffff" : "light-dark(#27272a, #f5f5f5)") text-align="center"

component DialogCheckbox
  props
    checked: bool
    mixed: bool
    press: action
    label: string
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  view
    button id=elementId press=press role="checkbox" aria-checked=checked aria-label=label testId=testId width="1rem" height="1rem" padding=0 flex-shrink=0 box-sizing="border-box" border-radius="0.25rem" border-style="solid" border-width=1 border-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff26)") background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : mixed ? "light-dark(#f4f4f5, #ffffff0f)" : "light-dark(#ffffff, #ffffff07)") display="flex" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
      if checked
        ShellIcon(name="check", size=12, color="#ffffff")
      if mixed and not checked
        box width="0.5rem" height=2 border-radius=1 background-color="light-dark(#27272a, #f5f5f5)"

// The commit dialog: branch (and the default-branch warning), the files to
// include (Edit picks them), an optional message; Commit or Commit on new branch.
component GitCommitDialog
  inject
    rem: number
  props
    git: GitCard
    cwd: string
    scheme: string
    windowHeight: number
    act: action
    local: action
  state message = ""
  action write(value: string)
    message = value
  view
    DialogFrame(label="Commit changes", maxWidth=512, close=local("git-dialog-close", "", ""), testId="git-commit-dialog", first=(git.editing and git.fileCount > 0 ? "git-commit-all" : (git.fileCount > 0 ? "git-commit-edit" : "git-commit-message")))
      column gap="0.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" box-sizing="border-box"
        text "Commit changes" font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        text "Review and confirm your commit. Leave the message blank to auto-generate one." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
      scroll flex-shrink=1 min-height=0 max-height=(windowHeight - 12.5 * rem)
        column gap="1rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box"
          column gap="0.75rem" padding="0.6875rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfc, #ffffff09)"
            row gap="0.5rem" align-items="center"
              text "Branch" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
              row flex=1 min-width=0 gap="0.5rem" align-items="center" justify-content="space-between"
                text git.commitBranch font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0 testId="git-commit-branch"
                if git.commitDefault
                  text "Default branch" font-size="0.875rem" line-height="1.25rem" color="light-dark(#f59e0b, #fbbf24)" flex-shrink=0
            column gap="0.25rem"
              row height="1.5rem" align-items="center" justify-content="space-between"
                row gap="0.5rem" align-items="center"
                  if git.editing and git.fileCount > 0
                    DialogCheckbox(checked=git.allSelected, mixed=git.someSelected, press=local("git-files-all", "", ""), label="Include all files", elementId="git-commit-all", testId="git-commit-all")
                  text "Files" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
                  if not git.allSelected and not git.editing
                    text `(${git.selectedCount} of ${git.fileCount})` font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
                if git.fileCount > 0
                  button id="git-commit-edit" press=local("git-files-edit", "", "") testId="git-commit-edit" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(git.editing ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" data-focus-stop="enabled"
                    text (git.editing ? "Done" : "Edit") font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
              if git.fileCount == 0
                text "none" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
              else
                column gap="0.5rem"
                  scroll height="11rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#ffffff, #ffffff06)"
                    column gap="0.25rem" padding="0.1875rem" box-sizing="border-box"
                      for file in git.files key=file.path
                        GitCommitFile(file=file, editing=git.editing, scheme=scheme, local=local)
                  row justify-content="flex-end"
                    text `+${git.selectedInsertions}` font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color=gitAdd(scheme)
                    text "/" font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
                    text `-${git.selectedDeletions}` font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color=gitDel(scheme)
          column gap="0.25rem"
            text "Commit message (optional)" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
            box position="relative" width="100%" border-radius="0.5rem" background-color="light-dark(#ffffff, #ffffff07)"
              textarea id="git-commit-message" value=message input=write aria-label="Commit message" autocorrect="off" testId="git-commit-message" width="100%" height="4.1875rem" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.4375rem" padding-bottom="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" spellcheck="false" data-focus-stop="enabled"
              if message == ""
                text "Leave empty to auto-generate" position="absolute" left="0.6875rem" top="0.375rem" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717a, #818181)" pointer-events="none" aria-hidden=true
      row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box"
        DialogButton(label="Cancel", primary=false, disabled=false, press=local("git-dialog-close", "", ""), elementId="", testId="git-commit-cancel")
        DialogButton(label="Commit on new branch", primary=false, disabled=git.noneSelected, press=act("shell:git-commit-branch", cwd, message), elementId="", testId="git-commit-new-branch")
        DialogButton(label="Commit", primary=true, disabled=git.noneSelected, press=act("shell:git-commit", cwd, message), elementId="", testId="git-commit-submit")

component GitCommitFile
  props
    file: GitFile
    editing: bool
    scheme: string
    local: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" align-items="center" border-radius="0.375rem" hover=hover background-color=(over ? "light-dark(#f4f4f580, #ffffff05)" : "#00000000")
      if editing
        DialogCheckbox(checked=(not file.excluded), mixed=false, press=local("git-file", file.path, ""), label=`Include ${file.path}`, elementId="", testId=`git-commit-file-${file.path}`)
      button press=local("git-open-file", file.path, "") testId=`git-commit-open-${file.path}` flex=1 min-width=0 padding=0 gap="0.75rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
        text file.path flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color=(file.excluded ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
        if file.excluded
          text "Excluded" flex-shrink=0 font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        else
          row flex-shrink=0
            text `+${file.insertions}` font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color=gitAdd(scheme)
            text " / " font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" white-space="pre" color="light-dark(#71717b, #818181)"
            text `-${file.deletions}` font-family="ui-monospace" font-size="0.875rem" line-height="1.25rem" color=gitDel(scheme)

// The default-branch confirmation: Abort, continue on this ref, or a feature ref.
component GitConfirmDialog
  props
    git: GitCard
    cwd: string
    act: action
    local: action
  view
    DialogFrame(label=git.confirmTitle, maxWidth=576, close=local("git-dialog-close", "", ""), testId="git-confirm-dialog", first="git-confirm-abort")
      column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
        text git.confirmTitle font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="git-confirm-title"
        text git.confirmDescription font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
      row gap="0.5rem" align-items="center" flex-wrap="wrap" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box"
        DialogButton(label="Abort", primary=false, disabled=false, press=local("git-dialog-close", "", ""), elementId="git-confirm-abort", testId="git-confirm-abort")
        box flex=1
        DialogButton(label=git.confirmContinue, primary=false, disabled=false, press=act("shell:git-confirm", cwd, "continue"), elementId="", testId="git-confirm-continue")
        DialogButton(label="Check out feature branch & continue", primary=true, disabled=false, press=act("shell:git-confirm", cwd, "feature"), elementId="", testId="git-confirm-feature")

// BranchToolbarEnvironmentSelector in the panel: an unstarted draft whose project
// also lives on another connected environment picks where it runs (a Select at the
// row's width, "Run on" over the machines); otherwise the static label with its tooltip.
component RunOnRow
  props
    details: ShellDetails
    // The docked card (280pt) or the popover (264pt): the menu takes its inner width.
    inline: bool
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    if details.git.envPick
      box position="relative" width="100%"
        button popovertarget="details-environment-menu" hover=hover aria-label="Run on" testId="details-environment" width="100%" height="2rem" padding-left="0.6875rem" padding-right=0 box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color=(over ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
          CnMachineIcon(kind=details.envKind, size=16, color="light-dark(#71717b, #818181)")
          text details.envLabel flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-environment-label" text-box-trim="trim-both" text-box-edge="cap alphabetic"
          box width="2rem" height="2rem" position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
            box position="absolute" left=-1 top="0.5rem" width=1 height="1rem" background-color="light-dark(#e4e4e7a6, #ffffff10)"
            ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
        // SelectPopup alignItemWithTrigger={false} (BranchToolbarEnvironmentSelector.tsx, align start): flipping near an edge.
        column id="details-environment-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width=(inline ? "16.375rem" : "15.375rem") testId="details-environment-layer"
          column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="listbox" aria-label="Run on" testId="details-environment-menu"
            text "Run on" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #818181)"
            for option in details.git.envOptions key=option.id
              RunOnOptionRow(option=option, act=act)
    else
      row position="relative" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" align-items="center" border-radius="0.625rem" hover=hover testId="details-environment"
        CnMachineIcon(kind=details.envKind, size=16, color="light-dark(#71717b, #818181)")
        text details.envLabel flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)" testId="details-environment-label" text-box-trim="trim-both" text-box-edge="cap alphabetic"
        TipBubble(label=details.envLabel, side="top", align="center", offset=36, inset=0, shown=over)

component RunOnOptionRow
  props
    option: RunOnOption
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=act("environment-run-on", "", option.id) popovertarget="details-environment-menu" popovertargetaction="hide" hover=hover role="option" aria-selected=option.selected testId=`details-environment-${option.id}` width="100%" min-height="1.8125rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.375rem" border-width=0 border-radius="0.375rem" background-color=(over or option.selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      CnMachineIcon(kind=option.machine, size=12, color="light-dark(#71717b, #818181)")
      text option.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.3125rem" color="light-dark(#18181b, #fafafa)"
