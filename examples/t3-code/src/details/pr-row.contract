// Adapted from T3 Code 9c161462c9 (MIT); see LICENSE-T3.
// Measured on the served HEAD reference (MIT, see LICENSE-T3;
// chat/ThreadDetailsPrRow.tsx, pullRequest/PullRequestChecksPopover.tsx,
// pullRequestPresentation.tsx, ui/popover.tsx, ui/tooltip.tsx variant "glass",
// ui/alert-dialog.tsx):
// - ChecksPopover: PopoverPopup width md (320), side bottom 4pt off, aligned
//   with the checks trigger's end (its start would cross the window): the
//   headline (14/20 medium), the summary (12/16 muted), the checks (attention,
//   running, then "Show all"), each with its status, label and Details link.
//   Popovers here anchor at the invoker's bottom-left and clamp to the window,
//   so the layer carries a transparent tail as wide as the window right of the
//   trigger (`tail`, from pr-row.ts): the clamp lands it end-aligned. Its
//   glass (white/#111 at 83.6% over a 12-16pt blur) is drawn as the colour the
//   blur settles to over the card (#fff, #121212): backdrop blur here sees only
//   its parent, so a translucent popup would show the rows under it.
// - PrCard: the row's tooltip with the host's detail: title and number, then
//   the state, base ← head, the checks while open, a draft's conflict and the
//   diff size; 4pt above the row, start-aligned unless it would cross the window
//   (`flipped`: its end meets the link half's end). The reference portals it; here
//   the details card clips it, so a flipped card wider than the room left of the
//   link half's end is held inside the card's 8pt insets (`clamped`).
// - MergeDialog: "Merge pull request?" / "This merges #N using <method>." with
//   Cancel (Escape) and Merge.
use DetailsPrRow from "../panel/pr-attachment-shapes.contract"
use PrCard from "./pr-row-shapes.contract"
use MergeAsk from "./pr-row-shapes.contract"
use PrCheck from "./pr-row-shapes.contract"
use ShellDetails from "../shell/shell-shapes.contract"
use PgIcon from "../shared/pages-icons.contract"
use prdTone from "../pull-requests/pages-pr-detail.contract"
use Tip from "../shell/shell-tip.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use DialogFinalFocus from "../shared/dialog-trap.contract"

keyframes prRowSpin
  from rotate=0
  to rotate=360

fn prRowInk(): string = "light-dark(#27272a, #f5f5f5)"
fn prRowMuted(): string = "light-dark(#71717b, #818181)"
fn prRowSoft(): string = "light-dark(#27272abf, #f5f5f5bf)"
fn prRowPrimary(): string = "light-dark(#1b4ed8, #346bf1)"
fn prRowDestructive(): string = "light-dark(#fb2c36, #fb414a)"
// CHECK_STATUS_PRESENTATION tones: emerald-600 / emerald-300/90, text-destructive, amber-500 for a running spinner.
fn checkTone(status: string): string = status == "success" ? "light-dark(#009966, #5ee9b5e6)" : status == "failure" or status == "cancelled" ? "light-dark(#fb2c36, #fb414a)" : status == "pending" ? "#fe9a00" : status == "action-required" ? "light-dark(#e17100, #ffb900e6)" : "light-dark(#71717bb3, #818181b3)"
fn checkIcon(status: string): string = status == "success" ? "circle-check" : status == "failure" or status == "cancelled" ? "circle-x" : status == "action-required" ? "circle-dot" : "circle-dashed"
// CHECKS_STATE_PRESENTATION: the trigger's rollup glyph (a running set is the amber dot).
fn rollupTone(rollup: string): string = rollup == "passing" ? "light-dark(#009966, #5ee9b5e6)" : rollup == "failing" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#e17100, #ffb900e6)"
fn rollupIcon(rollup: string): string = rollup == "passing" ? "circle-check" : rollup == "failing" ? "circle-x" : "circle-dot"

// One check's status glyph: the Spinner while it runs, else its circle.
component CheckGlyph
  props
    status: string
    size: number
  view
    if status == "pending"
      box width=`${size / 16}rem` height=`${size / 16}rem` flex-shrink=0 display="flex" animation="prRowSpin 1s linear infinite" aria-label="Loading"
        svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color="#fe9a00" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M21 12a9 9 0 1 1-6.219-8.56"
    else
      PgIcon(name=checkIcon(status), size=size, color=checkTone(status))

// The checks on the row's second line (ThreadDetailsControl part "meta": 24pt, 6pt insets, 12pt medium muted text)
// and the popover they open.
component ChecksTrigger
  props
    row: DetailsPrRow
    hovered: bool
    hover: action
  view
    button popovertarget=row.extra.popId hover=hover aria-label=row.checksAria testId=`details-pr-checks-${row.key}` height="1.5rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" gap="0.25rem" border-width=0 border-radius="0.375rem" background-color=(hovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
      PgIcon(name=rollupIcon(row.checks), size=14, color=rollupTone(row.checks))
      if row.checksCount != ""
        text row.checksCount font-size="0.75rem" font-weight=500 line-height="1rem" font-variant-numeric="tabular-nums" color=prRowMuted()

component ChecksPopover
  props
    row: DetailsPrRow
    local: action
  view
    // PullRequestChecksPopover: PopoverPopup align="start" side="bottom", flipping near an edge.
    row id=row.extra.popId popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId=`details-pr-checks-layer-${row.key}`
      column width="20rem" box-sizing="border-box" padding="1rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #121212)" box-shadow="0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a" role="dialog" aria-label=row.extra.checksTitle testId=`details-pr-checks-popover-${row.key}`
        text row.extra.checksTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color=prRowInk() margin-bottom="0.5rem"
        text row.extra.checksSummary font-size="0.75rem" line-height="1rem" color=prRowMuted() margin-bottom="0.5rem"
        column width="100%" gap="0.25rem" role="list"
          for check in row.extra.checksList key=check.key
            PrCheckRow(check=check)
        if row.extra.collapsible
          button press=local("surface-linked-pr-checks-all", row.key, "") aria-expanded=row.extra.expanded testId=`details-pr-checks-all-${row.key}` align-self="flex-start" margin-top="0.125rem" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            text (row.extra.expanded ? "Show less" : "Show all") font-size="0.75rem" line-height="1rem" font-weight=500 color=prRowInk()
      box width=row.extra.tail height=1 flex-shrink=0

component PrCheckRow
  props
    check: PrCheck
  view
    row width="100%" height="1rem" gap="0.5rem" align-items="center" role="listitem"
      CheckGlyph(status=check.status, size=14)
      box flex=1 min-width=0 display="flex"
        Tip(label=check.description, side="top", align="center", offset=20)
          text check.name min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=prRowInk()
      text check.label flex-shrink=0 font-size="0.75rem" line-height="1rem" color=prRowMuted()
      if check.url != ""
        link cursor="pointer" href=check.url aria-label=`Details: ${check.name}` flex-shrink=0 text-decoration-line="none"
          text "Details" font-size="0.75rem" line-height="1rem" color=prRowPrimary()

// The tooltip card above the row's link half.
component PrCardView
  props
    card: PrCard
    shown: bool
  view
    row position="absolute" bottom="2.25rem" left=(card.clamped ? "-0.5rem" : card.flipped ? "-25rem" : "0px") right=(card.flipped and not card.clamped ? "0px" : "-25rem") justify-content=(card.flipped and not card.clamped ? "flex-end" : "flex-start") pointer-events="none" z-index=140
      column max-width=card.maxWidth padding-left="0.8125rem" padding-right="0.8125rem" padding-top="0.8125rem" padding-bottom="0.8125rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #121212)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" opacity=(shown ? 1 : 0) transition=(shown ? "opacity 150ms ease 600ms" : "opacity 0ms") role="tooltip" aria-hidden=(not shown) testId=(shown ? "details-pr-card" : "details-pr-card-hidden")
        row gap="0.375rem" align-items="baseline" min-width=0
          text card.title min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="0.75rem" font-weight=500 color=prRowInk()
          text card.number flex-shrink=0 font-size="0.75rem" line-height="0.75rem" color=prRowMuted()
        column gap="0.375rem" padding-left="0.125rem"
          row gap="0.5rem" height="1rem" align-items="center"
            PgIcon(name=(card.stateKey == "draft" ? "git-pull-request-draft" : card.stateKey == "closed" ? "git-pull-request-closed" : card.stateKey == "merged" ? "git-merge" : "git-pull-request-arrow"), size=12, color=prdTone(card.stateKey))
            text card.stateLabel min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=prRowSoft()
          row gap="0.5rem" height="1rem" align-items="center"
            PgIcon(name="git-branch", size=12, color=prRowMuted())
            text card.branches min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=prRowSoft()
          if card.checksShown
            row gap="0.5rem" height="1rem" align-items="center"
              CheckGlyph(status=card.checksStatus, size=14)
              text card.checksText min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=prRowSoft()
          if card.conflictText != ""
            row gap="0.5rem" align-items="flex-start"
              box margin-top="0.125rem" display="flex" flex-shrink=0
                PgIcon(name="triangle-alert", size=12, color=prRowDestructive())
              text card.conflictText flex=1 min-width=0 font-size="0.75rem" line-height="1.25rem" color=prRowDestructive()
          row gap="0.5rem" height="1rem" align-items="center"
            PgIcon(name="file-diff", size=12, color=prRowMuted())
            row gap="0.25rem" align-items="baseline" min-width=0
              text card.files white-space="nowrap" font-size="0.75rem" line-height="1rem" color=prRowSoft()
              if card.additions != ""
                text card.additions font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#009966, #00d492)"
                text card.deletions font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color=prRowDestructive()

// The action at the second line's end (part "meta", tone primary or destructive): Resolve and Fix (with the
// hand-off arrow), Ready, Merge.
component PrActionButton
  props
    row: DetailsPrRow
    hovered: bool
    hover: action
    act: action
    local: action
  view
    // Merge asks first (the AlertDialog); the others act on the press.
    if row.action == "merge"
      button id=`details-pr-merge-${row.actionTarget}` press=local("surface-linked-pr-merge-ask", row.actionTarget, row.extra.method) hover=hover disabled=row.actionDisabled testId=`details-pr-action-${row.key}` height="1.5rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" gap="0.25rem" border-width=0 border-radius="0.375rem" opacity=(row.actionDisabled ? 0.64 : 1) background-color=(hovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 data-focus-stop=(row.actionDisabled ? "" : "enabled")
        PrActionLabel(row=row)
    else
      button press=act(`shell:surface-linked-pr-${row.action}`, row.actionTarget, "") hover=hover disabled=row.actionDisabled testId=`details-pr-action-${row.key}` height="1.5rem" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" gap="0.25rem" border-width=0 border-radius="0.375rem" opacity=(row.actionDisabled ? 0.64 : 1) background-color=(hovered ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        PrActionLabel(row=row)

component PrActionLabel
  props
    row: DetailsPrRow
  view
    text row.actionLabel white-space="nowrap" font-size="0.75rem" font-weight=500 line-height="1rem" color=(row.extra.destructive ? prRowDestructive() : prRowPrimary())
    if row.extra.suffix
      PgIcon(name="arrow-up-right", size=12, color=(row.extra.destructive ? prRowDestructive() : prRowPrimary()))

// The Merge AlertDialog over the window.
component PrRowLayers
  props
    details: ShellDetails
    scheme: string
    act: action
    local: action
  view
    // Cancel gives the focus back to the row's Merge (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=details.prRows.merge.open, owner="pr-merge-dialog")
    if details.prRows.merge.open
      MergeDialog(merge=details.prRows.merge, dark=(scheme == "dark"), act=act, local=local)

component MergeDialog
  inject
    dialogSeated: string[]
    dialogEntered: action
    dialogFallback: action
  props
    merge: MergeAsk
    dark: bool
    act: action
    local: action
  derive dialogTargets = ["pr-merge-cancel", (merge.pending ? "pr-merge-cancel" : "pr-merge-confirm")]
  // Base UI's AlertDialog is modal: while it shows only its own shortcuts are heard, so Cancel's Escape closes it
  // before an Escape declared under it (the right panel sheet's toggle) does.
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=80 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="pr-merge-dialog-overlay"
      column width="100%" max-width="32rem" position="relative" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow=(dark ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") overflow="hidden" role="alertdialog" aria-modal=dialogSeated.includes("pr-merge-dialog") aria-describedby="pr-merge-dialog-description" aria-label="Merge pull request?" testId="pr-merge-dialog" id="pr-merge-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("pr-merge-dialog") key=dialogFallback("pr-merge-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract).
        FocusGuard(guardId="pr-merge-guard-start", targets=dialogTargets, popup="pr-merge-dialog")
        DialogOpenFocus(target="pr-merge-cancel")
        column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
          text "Merge pull request?" font-size="1.25rem" font-weight=600 line-height="1.25rem" color=prRowInk() role="heading" aria-level=2
          text merge.description font-size="0.875rem" line-height="1.25rem" color=prRowMuted() testId="pr-merge-dialog-description" id="pr-merge-dialog-description"
        row width="100%" gap="0.5rem" justify-content="flex-end" align-items="center" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button id="pr-merge-cancel" press=local("surface-linked-pr-merge-cancel", "", "") aria-keyshortcuts="Escape" testId="pr-merge-cancel" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center" data-focus-stop="enabled"
            text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color=prRowInk()
          button id="pr-merge-confirm" press=act("shell:surface-linked-pr-merge", merge.target, "") disabled=merge.pending testId="pr-merge-confirm" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=prRowPrimary() background-color=prRowPrimary() box-shadow="inset 0 1px 0 #ffffff29, 0 1px 2px #0000000d" opacity=(merge.pending ? 0.64 : 1) display="flex" align-items="center" justify-content="center" data-focus-stop=(merge.pending ? "" : "enabled")
            text "Merge" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
        FocusGuard(guardId="pr-merge-guard-end", targets=dialogTargets, popup="pr-merge-dialog")
