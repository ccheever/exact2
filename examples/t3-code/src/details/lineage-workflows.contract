// Claude workflow phases and members (T3 Code 9c161462c9, MIT; ThreadLineageWorkflowRow.tsx).
// The source flattens expanded phases so the plan needs one bounded row loop.
use ShellLineage from "../shell/shell-shapes.contract"
use ShellIcon from "../shell/shell-icons.contract"
use ProviderMark from "../shared/icons.contract"
use HoverTip from "../shell/hover-layer.contract"
use hoverTipAtFrame from "../shell/hover-layer.contract"

component LineageBodyRow
  inject
    rem: number
    hoverTipAt: action
  props
    row: ShellLineage
    act: action
  state over = false
  derive testKey = `details-workflow-member-${row.id}`
  action hover(on: bool)
    over = on
    if row.kind == "member"
      hoverTipAt(hoverTipAtFrame(testKey, "workflow-member", row.title, [row.modelLine, row.status, row.elapsed, row.preview, row.driver], "left", "start", frame(testKey), 20.25 * rem, `${testKey}-hover`), "trigger", on)
  action open
    hover(false)
    act("select-thread", row.hint, "")
  view
    if row.kind == "phase"
      button press=act("ui:workflow-phase", row.phaseId, row.phaseOpen ? "close" : "open") aria-expanded=row.phaseOpen aria-label=`${row.phaseOpen ? "Collapse" : "Expand"} ${row.title} phase, ${row.status}` testId=`details-workflow-phase-${row.phaseId}` width="100%" height="2rem" padding-left="1.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        text row.title flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b99, #81818199)"
        box height=1 min-width="0.5rem" flex=1 background-color="light-dark(#e4e4e799, #ffffff0a)"
        if row.failed
          text "Failed" font-size="0.625rem" color="light-dark(#c10007, #ff6467)"
        text row.count flex-shrink=0 font-size="0.625rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b99, #81818199)"
        if row.elapsed != ""
          text row.elapsed flex-shrink=0 font-size="0.625rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b99, #81818199)"
        box rotate=(row.phaseOpen ? 0 : 180) display="flex" flex-shrink=0
          ShellIcon(name="chevron-down", size=12, color="light-dark(#71717b99, #81818199)")
    else if row.kind == "member"
      button id=testKey testId=testKey hover=hover focus=hover(true) blur=hover(false) press=open disabled=row.missing aria-label=`Open ${row.title} chat, ${row.status}` width="100%" height="2rem" padding-left="1.5rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color=(over ? "light-dark(#0000000e, #ffffff13)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        box width="1rem" height="1rem" position="relative" flex-shrink=0 display="flex" align-items="center" justify-content="center"
          if row.driver != ""
            ProviderMark(driver=row.driver, size=16, color="light-dark(#71717b, #818181)")
          else
            ShellIcon(name="bot", size=16, color="light-dark(#71717b, #818181)")
          box position="absolute" right="-0.25rem" bottom="-0.25rem" width="0.5rem" height="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-style="solid" border-width=2 border-color="light-dark(#ffffff, #111111)" background-color=row.dot
        text row.title flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#27272ad9, #f5f5f5d9)"
        if row.elapsed != ""
          text row.elapsed flex-shrink=0 font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
    else
      text row.title padding-left="1.5rem" padding-top="0.25rem" padding-bottom="0.5rem" font-size="0.75rem" color="light-dark(#71717b, #818181)"

// The member card is drawn by the window hover layer so the Lineage scroll cannot clip it.
fn workflowTipLine(lines: string[], index: number): string = match lines.at(index) { case some(line) => line, case none => "" }

component WorkflowMemberCard
  props
    tip: HoverTip
  view
    column max-width="20rem" min-width="16rem" padding="0.75rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 8px 24px #00000033" role="tooltip" testId=tip.testId
      text tip.text font-size="0.75rem" font-weight=500
      row gap="0.25rem" align-items="center"
        if workflowTipLine(tip.lines, 4) != ""
          ProviderMark(driver=workflowTipLine(tip.lines, 4), size=12, color="light-dark(#71717b, #818181)")
        text workflowTipLine(tip.lines, 0) font-size="0.6875rem" color="light-dark(#71717b, #818181)" line-clamp=1 min-width=0
      row justify-content="space-between" gap="1rem"
        text workflowTipLine(tip.lines, 1) font-size="0.6875rem"
        text workflowTipLine(tip.lines, 2) font-size="0.625rem" font-variant-numeric="tabular-nums"
      if workflowTipLine(tip.lines, 3) != ""
        text workflowTipLine(tip.lines, 3) font-size="0.6875rem" line-clamp=2
