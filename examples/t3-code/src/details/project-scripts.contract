// Texts the app places things by, measured from laid-out text
// instead of estimated (as composer-label-probes.contract's probes): each probe is drawn
// once, invisible and passing the pointer through (`pointer-events="none"`,
// which the macOS host honours on boxes since 652a6c865), and reports [x, width] through the t3-anchor hook
// (T3Composer.swift); composer-menus.ts `measured` reads it back.
use TextProbe from "../composer/composer-label-probes.contract"
use ShellDetails from "../shell/shell-shapes.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use CnScriptIcon from "../settings/settings-b-kit.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"

component PlacementProbes
  props
    probes: TextProbe[]
  view
    column position="absolute" left=0 top=0 opacity=0 pointer-events="none" aria-hidden=true align-items="flex-start" testId="placement-text-probes"
      for probe in probes key=probe.key
        box hatch="t3-anchor" data-anchor=probe.key display="flex" flex-direction="row" flex-shrink=0
          text probe.text font-size=probe.size font-weight=probe.weight line-height=`${probe.size + 4}px` white-space="nowrap" flex-shrink=0

// ProjectScriptsControl displayMode="panel" (project-scripts.ts): the primary
// script's icon and name, a hairline and the chevron, as the card's Open in row.
// Running a script needs the terminal, so the run part is disabled; the
// chevron's menu lists the scripts (also disabled) and "Add project script".
component ScriptRow
  props
    details: ShellDetails
    // The row's width, which the menu takes (MenuPopup's w-(--anchor-width)).
    menuWidth: number
    run: action
    act: action
  state hovered = ""
  state open = false
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  derive menuItems = details.scripts.map((script) => KmItem(id=`details-script-${script.id}`, label=script.label)).concat([KmItem(id="details-scripts-add", label="Add project script")])
  // Base UI's MenuTrigger: Enter, Space, ↓ open the menu at its first item, ↑ at its last.
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("details-scripts-menu", source="details-script-actions")
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  action toggled(e: ToggleEvent)
    open = e.newState == "open"
  view
    row height="2rem" align-items="center" border-radius="0.625rem" role="group" aria-label="Project scripts" testId="details-scripts" background-color=(hovered == "menu" or open ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
      if details.scriptName != ""
        box position="relative" flex=1 min-width=0 hover=hover("run")
          button press=run aria-label=`Run ${details.scriptName}` testId="details-run-script" width="100%" min-width=0 height="2rem" padding-left="0.6875rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            box display="flex" flex-shrink=0
              CnScriptIcon(icon=details.scriptIcon, size=16, color="light-dark(#71717b, #818181)")
            text details.scriptName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)"
          TipBubble(label=`Run ${details.scriptName}`, side="top", align="center", offset=36, inset=0, shown=(hovered == "run"))
        box width=1 height="1rem" flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
      box position="relative" flex-shrink=0 flex=(details.scriptName == "" ? 1 : 0)
        button id="details-script-actions" popovertarget="details-scripts-menu" key=triggerKey hover=hover("menu") aria-label="Script actions" aria-haspopup="menu" aria-expanded=open testId="details-script-actions" width=(details.scriptName == "" ? "100%" : "2rem") height="2rem" padding=(details.scriptName == "" ? "0 0.6875rem" : "0px") border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
          if details.scriptName == ""
            CnScriptIcon(icon="configure", size=16, color="light-dark(#71717b, #818181)")
            text "Actions" flex=1 text-align="left" font-size="0.8125rem" color="light-dark(#71717b, #818181)"
          ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")
        ScriptMenu(details=details, items=menuItems, width=menuWidth, act=act, toggled=toggled)

// The scripts menu (MenuPopup align="end", anchored at the row, as wide): 4pt under the row, its right edge on the
// chevron's, which ends the row. A popover, so a press anywhere outside it or Escape closes it, as Base UI's Menu
// does; it is modal while it shows, so its Escape is not the details popover's backdrop's.
component ScriptMenu
  inject
    dialogMenuEntered: action
  props
    details: ShellDetails
    items: KmItem[]
    width: number
    act: action
    toggled: action
  state lit = ""
  // As in menu-keys.contract: the pointer entering a row focuses it; leaving the row that holds the focus hands it to the popup.
  action hover(id: string, rowId: string, value: bool)
    if value
      focus(rowId)
    else if lit == id
      focus("details-scripts-keys")
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    column id="details-scripts-menu" data-dialog-return="menu" focusin=dialogMenuEntered("details-scripts-menu", "details-script-actions") toggle=toggled popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width=width
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Project scripts" testId="details-scripts-menu"
        KeyMenu(menuId="details-scripts-keys", items=items, keyed=0, gap="0px", modal=true)
          for script in details.scripts key=script.id
            button id=`details-script-${script.id}` press=act("terminallocal:run-script", script.id, "") popovertarget="details-scripts-menu" popovertargetaction="hide" hover=hover(script.id, `details-script-${script.id}`) focus=focused(script.id, true) blur=focused(script.id, false) role="menuitem" testId=`details-script-${script.id}` width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(lit == script.id ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              CnScriptIcon(icon=script.icon, size=16, color="light-dark(#71717b, #818181)")
              text script.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button id="details-scripts-add" press=act("ui:add-script", "", "") popovertarget="details-scripts-menu" popovertargetaction="hide" hover=hover("add", "details-scripts-add") focus=focused("add", true) blur=focused("add", false) role="menuitem" testId="details-scripts-add" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(lit == "add" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
            ShellIcon(name="plus", size=16, color="light-dark(#71717b, #818181)")
            text "Add project script" flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
