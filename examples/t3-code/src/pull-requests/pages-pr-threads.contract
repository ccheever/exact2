// The pull request Code tab's cards, measured against T3 Code 1e2ecbd975
// (MIT, see LICENSE-T3) components/pullRequest/PullRequestReviewAnnotation.tsx and
// components/diffs/DiffCommentAnnotation.tsx: a conversation already on the host (ReviewThreadCard),
// a comment waiting for the review (PendingReviewCommentCard) and the line comment being written,
// with "Add to review" and "Add to agent". pages-pr-threads.ts and pages-pr-code.ts make them.
use PgIcon from "../shared/pages-icons.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use PrAvatar from "./pages-prs.contract"
use ChatDocument from "../timeline/markdown.contract"
use CodeHighlight from "../timeline/markdown.contract"
use MarkdownEnv from "../timeline/markdown.contract"
use LayerTip from "../shell/hover-layer.contract" // the Tips on the window's hover layer (#307), so the list and the cards around them do not clip them
use PrReactionPill from "./pages-pr-meta.contract"
use PrReactionChoice from "./pages-pr-meta.contract"
use PrdReactionBar from "./pages-pr-meta.contract"
use PrdEditButton from "./pages-pr-edit.contract"
use PrdSmallButton from "./pages-pr-edit.contract"
use PrdWords from "./pages-pr-edit.contract"
use PrdFixButton from "./pages-pr-handoffs.contract"
use PrHandoffsView from "./pages-pr-handoffs.contract"

shape PrThreadComment
  id: string
  author: string
  avatar: string
  initial: string
  authorTip: string
  age: string
  bodyId: string
  raw: string
  canEdit: bool
  saving: bool
  savedSerial: number
  reactions: PrReactionPill[]
  reacted: string[]
shape PrThreadCard
  id: string
  key: string
  resolved: bool
  outdated: bool
  countLabel: string
  canReply: bool
  canResolve: bool
  canReact: bool
  fix: string
  comments: PrThreadComment[]
  more: bool
  loadingMore: bool
  pending: bool
  repliedSerial: number
  lineLabel: string
  path: string

fn ptMuted(): string = "light-dark(#71717b, #818181)"
fn ptInk(): string = "light-dark(#27272a, #f5f5f5)"
// CARD_CLASS: mx-3 my-2 rounded-xl border border-border/70 bg-background p-3 text-sm shadow-sm.
fn ptBorder(): string = "light-dark(#e4e4e7b3, #ffffff0b)"
fn ptCircle(): string = "M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0"

// ReviewThreadCard: open threads start expanded and resolved ones folded to their header; every
// control waits while a thread write is out (`card.pending`).
component PrdThreadCard
  props
    card: PrThreadCard
    surface: string
    handoffs: PrHandoffsView
    choices: PrReactionChoice[]
    documents: ChatDocument[]
    code: CodeHighlight[]
    env: MarkdownEnv
    still: bool
    local: action
    act: action
  // `toggled` flips the starting state (open unless resolved), so a refreshed card keeps the reader's choice.
  state toggled = false
  state replying = false
  state seenReply = 0
  state reply = ""
  state headerOver = false
  derive expanded = card.resolved ? toggled : not toggled
  derive replyOpen = replying and seenReply == card.repliedSerial
  action flip
    toggled = not toggled
  action hoverHeader(value: bool)
    headerOver = value
  action openReply
    replying = true
    seenReply = card.repliedSerial
    reply = ""
  // The reply field holds Escape while it has the focus (submitKeys' onCancel; PrPanel's
  // "pr-escape-hold"), named with the reply serial it opened on, so PrPanel lets go once a sent reply closes it (its
  // field goes with no blur); abandoning it lets go here.
  action replyHold(on: bool)
    local("pr-escape-hold", `reply:${card.id}:${seenReply}`, on ? "true" : "")
  action editReply(text: string)
    reply = text
  action cancelReply
    replying = false
    replyHold(false)
  action send
    if not card.pending and reply.trim() != ""
      act("thread-reply", `${card.id}|${reply}`)
  action replyKeys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      cancelReply()
    else if k == "Enter" and (e.metaKey or e.ctrlKey) and not e.repeat
      // isCommentSubmitShortcut: a non-empty reply that is not already sending.
      preventDefault()
      send()
  view
    column margin-left="0.75rem" margin-right="0.75rem" margin-top="0.5rem" margin-bottom="0.5rem" padding="0.75rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color=ptBorder() background-color="light-dark(#ffffff, #0a0a0a)" box-shadow="0 1px 2px #0000000d" role="article" aria-label=`Conversation on ${card.path}` testId=`pull-request-thread-${card.id}`
      row align-items="center" gap="0.5rem" min-width=0
        svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color=(card.resolved ? "light-dark(#009966, #00d492)" : ptMuted()) fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d=(card.resolved ? "M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0M9 12l2 2 4-4" : ptCircle())
        button press=flip hover=hoverHeader aria-expanded=expanded testId=`pull-request-thread-toggle-${card.id}` padding=0 border-width=0 background-color="#00000000" flex-shrink=0
          text card.countLabel font-size="0.75rem" line-height="1rem" white-space="nowrap" color=(headerOver ? ptInk() : ptMuted())
        if card.outdated
          text "outdated" font-size="0.75rem" line-height="1rem" color=ptMuted() flex-shrink=0
        box flex=1 min-width=0
        PrdFixButton(finding=card.fix, label=(surface == "thread" ? "Fix in this thread" : "Fix in a thread"), pending=(card.pending and handoffs.pending == "" ? "thread-write" : handoffs.pending), surface=surface, act=act, testId=`pull-request-thread-fix-${card.id}`)
        if card.canResolve
          PrdSmallButton(label=(card.resolved ? "Unresolve" : "Resolve"), icon="", tone="ghost", disabled=card.pending, press=act("thread-resolve", `${card.id}|${card.resolved ? "false" : "true"}`), testId=`pull-request-thread-resolve-${card.id}`)
      if expanded
        column margin-top="0.5rem" gap="0.75rem" min-width=0
          for comment in card.comments key=comment.id
            PrdThreadComment(comment=comment, threadId=card.id, canReact=card.canReact, pending=card.pending, choices=choices, documents=documents, code=code, env=env, still=still, local=local, act=act)
        if card.more
          row margin-top="0.5rem"
            PrdSmallButton(label=(card.loadingMore ? "Loading..." : "Load more comments"), icon="", tone="ghost", disabled=card.loadingMore, press=act("thread-more", card.id), testId=`pull-request-thread-more-${card.id}`)
        if card.canReply
          if replyOpen
            column margin-top="0.5rem" gap="0.5rem"
              DialogOpenFocus(target=`pull-request-thread-reply-text-${card.id}`)
              textarea data-editable="yes" id=`pull-request-thread-reply-text-${card.id}` value=reply input=editReply key=replyKeys focus=replyHold(true) blur=replyHold(false) autofocus=true rows=2 placeholder="Reply" aria-label="Reply to this conversation" autocorrect="off" spellcheck="false" testId=`pull-request-thread-reply-text-${card.id}` width="100%" min-height="4rem" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=ptInk()
                ::placeholder
                  color=ptMuted()
              row justify-content="flex-end" gap="0.5rem"
                PrdSmallButton(label="Cancel", icon="", tone="ghost", disabled=false, press=cancelReply, testId=`pull-request-thread-reply-cancel-${card.id}`)
                PrdSmallButton(label="Reply", icon="", tone="primary", disabled=(card.pending or reply.trim() == ""), press=send, testId=`pull-request-thread-reply-send-${card.id}`)
          else
            row margin-top="0.5rem"
              PrdSmallButton(label="Reply", icon="", tone="ghost", disabled=false, press=openReply, testId=`pull-request-thread-reply-${card.id}`)

// One remark in a conversation: the author, the age, its reactions, then its words with the
// reader's own pencil, which turns them into the editor (PullRequestMarkdownEditor).
component PrdThreadComment
  props
    comment: PrThreadComment
    threadId: string
    canReact: bool
    pending: bool
    choices: PrReactionChoice[]
    documents: ChatDocument[]
    code: CodeHighlight[]
    env: MarkdownEnv
    still: bool
    local: action
    act: action
  state over = false
  state focused = false
  state editing = false
  state seen = 0
  state draft = ""
  state previewing = false
  derive open = editing and seen == comment.savedSerial
  action hover(value: bool)
    over = value
  // Both events bubble for links without IDs; the incoming event retains the settled focus state.
  action focusWithin(on: bool)
    focused = on
  action begin
    editing = true
    seen = comment.savedSerial
    draft = comment.raw
    previewing = false
  action edit(text: string)
    draft = text
  action preview(on: bool)
    previewing = on
    if on
      act("preview", `comment:${comment.id}|${draft}`)
  action save
    if not comment.saving and not pending
      act("thread-edit", `${threadId}|${comment.id}|${draft}`)
  action cancel
    editing = false
  view
    column min-width=0 hover=hover focusin=focusWithin(true) focusout=focusWithin(false) role="article" testId=`pull-request-thread-comment-${comment.id}`
      row min-width=0 flex-wrap="wrap" align-items="center" gap="0.5rem"
        LayerTip(label=comment.authorTip, side="top", align="start", tipId=`pull-request-thread-author-tip-${comment.id}`)
          row align-items="center" gap="0.375rem" min-width=0
            PrAvatar(avatar=comment.avatar, initial=comment.initial, size=16)
            text comment.author font-size="0.75rem" line-height="1rem" font-weight=500 color=ptInk() white-space="nowrap"
        // The age has no tip: ReviewThreadCard's `<span>{formatRelativeTimeLabel(comment.createdAt)}</span>` (the full date
        // is the Summary tab's, PullRequestSummaryTab's CommentMeta).
        text comment.age font-size="0.75rem" line-height="1rem" color=ptMuted() white-space="nowrap" testId=`pull-request-thread-age-${comment.id}`
        PrdReactionBar(pills=comment.reactions, reacted=comment.reacted, canReact=canReact, choices=choices, subject=comment.id, pickerId=`pr-code-react-${comment.id}`, act=act)
      column margin-top="0.25rem" min-width=0
        PrdWords(bodyId=comment.bodyId, emptyText="", collapse=false, canEdit=comment.canEdit, pencil=true, hovered=(over or focused), open=open, previewing=previewing, draft=draft, saving=comment.saving, allowEmpty=false, label="Edit comment", placeholder="", previewId=`pr-preview:comment:${comment.id}`, pencilLabel="Edit comment", frameId=`pr-code-comment-body-${comment.id}`, testId=`pr-code-comment-${comment.id}`, still=still, documents=documents, code=code, env=env, local=local, begin=begin, edit=edit, preview=preview, save=save, cancel=cancel)

// PendingReviewCommentCard: dashed, "Pending — sent when you submit the review", a trash to discard it.
component PrdPendingCard
  props
    id: string
    body: string
    discard: action
  state over = false
  action hover(value: bool)
    over = value
  view
    // CARD_CLASS plus `border-dashed`: the thread card's 1 px border in the border-box, dashed. A border takes no press, so
    // the trash keeps its whole 1.5rem target (the old stroked overlay took its presses).
    column margin-left="0.75rem" margin-right="0.75rem" margin-top="0.5rem" margin-bottom="0.5rem" padding="0.75rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="dashed" border-color=ptBorder() background-color="light-dark(#ffffff, #0a0a0a)" box-shadow="0 1px 2px #0000000d" testId=`pull-request-pending-${id}`
      row align-items="center" gap="0.5rem"
        PgIcon(name="message-square", size=14, color=ptMuted())
        text "Pending — sent when you submit the review" flex=1 min-width=0 font-size="0.75rem" line-height="1rem" color=ptMuted()
        button press=discard hover=hover aria-label="Discard this comment" testId=`pull-request-pending-discard-${id}` width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" align-items="center" justify-content="center" title=""
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color=ptMuted() fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M10 11v6M14 11v6M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
      text body margin-top="0.5rem" white-space="pre-wrap" font-size="0.875rem" line-height="1.421875rem" color=ptInk()

// DiffCommentAnnotation kind="draft" with submitLabel "Add to review" and the secondary "Add to agent", or, where
// the reader may not comment on the host, "Add to agent" alone: Escape cancels, ⌘/Ctrl+Enter submits a
// non-empty comment.
component PrdCodeDraft
  props
    rangeLabel: string
    text: string
    // Under the selected lines the row takes the selection's colour (diff-rows.contract diffSel).
    selected: bool
    reviewable: bool
    edit: action
    cancel: action
    add: action
    agent: action
    // The field's hold on Escape (PrPanel's "pr-escape-hold").
    local: action
  // The field holds Escape while it has the focus (its onKeyDown cancels the draft); PrPanel lets go of it once no
  // draft is open (`codeTab.draftOpen`), as the draft's field goes with no blur.
  action hold(on: bool)
    local("pr-escape-hold", "pr-code-draft", on ? "true" : "")
  action typed(value: string)
    edit(value)
    hold(true)
  action keys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      cancel()
    else if k == "Enter" and (e.metaKey or e.ctrlKey) and text.trim() != ""
      preventDefault()
      if reviewable
        add()
      else
        agent()
  view
    column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" background-color=(selected ? "light-dark(#eff7fd, #0f151a)" : "light-dark(#fcfcfc, #0a0a0a)") testId="pull-request-comment-draft"
      DialogOpenFocus(target="pr-code-draft-text")
      textarea data-editable="yes" id="pr-code-draft-text" value=text input=typed key=keys focus=hold(true) blur=hold(false) autofocus=true rows=2 placeholder="Add a comment…" aria-label=`Comment on lines ${rangeLabel}` testId="pull-request-comment-text" width="100%" min-height="3.5rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color=ptInk() autocorrect="off" spellcheck="false"
        ::placeholder
          color=ptMuted()
      row margin-top="0.375rem" align-items="center" gap="0.25rem"
        text "⌘/Ctrl Enter to send" flex=1 font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717ab3, #818181b3)"
        PrdSmallButton(label="Cancel", icon="", tone="ghost", disabled=false, press=cancel, testId="pull-request-comment-cancel")
        if reviewable
          PrdSmallButton(label="Add to agent", icon="", tone="outline", disabled=(text.trim() == ""), press=agent, testId="pull-request-comment-agent")
          PrdSmallButton(label="Add to review", icon="", tone="primary", disabled=(text.trim() == ""), press=add, testId="pull-request-comment-add")
        else
          PrdSmallButton(label="Add to agent", icon="", tone="primary", disabled=(text.trim() == ""), press=agent, testId="pull-request-comment-agent")
