// The pull request panel header's host actions, drawn
// from pages-pr-actions.ts presentActions: the armed badge, the primary control (Merge with its method,
// "Auto-merge (method)", Ready for review, Resolve conflicts, Merged/Closed), the More menu (Refresh,
// the open pull request's group — draft toggle, Merge now, Enable/Disable auto-merge, the merge-method
// radios — the host links, Close/Reopen/Revert changes), the out-of-date base branch's mark with its
// popover (Update branch, Update with rebase), "Approve workflows to run", and their confirmations in
// place (useInlineActionConfirm). Sources: T3 Code 9c161462c9 (MIT, see LICENSE-T3)
// components/pullRequest/{PullRequestDetailPanel.tsx,useInlineActionConfirm.ts}, components/AnimatedWidth.tsx,
// ui/{button,badge,menu,popover}.tsx.
use PgIcon from "../shared/pages-icons.contract"
use PrMenuBox from "./pages-prs.contract"
use Tip from "../shell/shell-tip.contract"
use PrStackView from "./pages-pr-stack.contract"
use PrdStackControls from "./pages-pr-stack.contract"
use PrStackDialog from "./pages-pr-stack.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
use PrHandoffsView from "./pages-pr-handoffs.contract"
use PrdCheckoutMenu from "./pages-pr-handoffs.contract"
use PrdHandoffItems from "./pages-pr-handoffs.contract"
use PrLinksView, PrActOnItem, PrdLinkedCount, PrdActOnItems from "./pages-pr-links.contract"
use hoverTipAtFrame from "../shell/hover-layer.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use DialogFinalFocus from "../shared/dialog-trap.contract"

keyframes paSpin
  from rotate=0
  to rotate=360

shape PrMergeMethodItem
  key: string
  method: string
  label: string
  selected: bool
shape PrUpdateItem
  key: string
  value: string
  label: string
shape PrActionsView
  guideEnabled: bool
  guideDisabled: bool
  guideLabel: string
  primary: string
  primaryLabel: string
  primaryBase: string
  primaryIcon: string
  primaryDisabled: bool
  armedLabel: string
  armedTip: string
  stateLabel: string
  stateKey: string
  refreshing: bool
  moreLabel: string
  pending: bool
  open: bool
  draftToggle: string
  mergeNow: bool
  mergeNowLabel: string
  autoMerge: string
  autoMergeLabel: string
  methods: PrMergeMethodItem[]
  methodsSeparator: bool
  groupSeparator: bool
  closeItem: bool
  closeLabel: string
  reopenItem: bool
  revertItem: bool
  revertLabel: string
  deleteBranchItem: bool
  deleteBranchDisabled: bool
  deleteBranchLabel: string
  freshness: bool
  freshnessSummary: string
  freshnessMethods: PrUpdateItem[]
  stacked: bool
  baseTip: string
  approveWorkflows: bool
  approveLabel: string
  armedControl: string
  armedAction: string
  armedSerial: number
  dialogOpen: bool
  dialogTitle: string
  dialogDescription: string
  dialogConfirm: string
  dialogDestructive: bool
  dialogValue: string
  stack: PrStackView

fn paInk(): string = "light-dark(#27272a, #f5f5f5)"
fn paMuted(): string = "light-dark(#71717b, #818181)"
fn paPrimary(): string = "light-dark(#1b4ed8, #346bf1)"
fn paDanger(): string = "light-dark(#e40014, #ff6467)"
fn paWarn(): string = "light-dark(#bb4d00, #ffb900)"
fn paTone(state: string): string = state == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : state == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"

// The header row's right side: the stack, the armed badge, the primary control, the Check out menu, then More
// (Check out beside the menu, so host actions arriving on its left move nothing under the pointer).
component PrdHeaderActions
  props
    actions: PrActionsView
    // The hand-offs, which surface the panel is on, and a header narrower than 35rem.
    handoffs: PrHandoffsView
    links: PrLinksView
    actOn: PrActOnItem[]
    surface: string
    narrow: bool
    ref: string
    url: string
    hostName: string
    numberLabel: string
    scheme: string
    still: bool
    compact: bool
    reload: action
    act: action
    copy: action
    local: action
    select: action
  // The merge and auto-merge confirm in place: the first press arms the button, the second runs it.
  action confirmPrimary
    if actions.armedControl == "primary" and actions.armedAction == actions.primary
      act("action", actions.primary)
    else
      local("pr-ui-arm", ref, `primary|${actions.primary}`)
  action primaryBlur
    if actions.armedControl == "primary"
      local("pr-ui-disarm", ref, `primary|${actions.armedAction}`)
  view
    row flex-shrink=0 align-items="center" gap="0.25rem" testId="pull-request-header-actions"
      PrdStackControls(stack=actions.stack, ref=ref, scheme=scheme, local=local, select=select)
      // PullRequestThreadLinks display="count", on the page only.
      if surface == "page" and links.countShown
        PrdLinkedCount(links=links, act=act)
      if actions.armedLabel != ""
        PaArmedBadge(label=actions.armedLabel, tip=actions.armedTip, compact=compact, testId="pull-request-auto-merge-armed")
      if actions.primary == "auto-merge-armed"
        PaArmedBadge(label=actions.primaryLabel, tip=actions.armedTip, compact=compact, testId="pull-request-primary")
      if actions.primary == "merge" or actions.primary == "enable-auto-merge"
        PaPrimaryButton(icon=actions.primaryIcon, label=actions.primaryLabel, base=actions.primaryBase, disabled=actions.primaryDisabled, destructive=false, press=confirmPrimary, left=primaryBlur, compact=compact, still=still, testId="pull-request-primary")
      if actions.primary == "ready"
        PaPrimaryButton(icon="git-pull-request-arrow", label=actions.primaryLabel, base=actions.primaryBase, disabled=actions.primaryDisabled, destructive=false, press=act("action", "ready"), left=primaryBlur, compact=compact, still=still, testId="pull-request-primary")
      if actions.primary == "resolve"
        PaPrimaryButton(icon="triangle-alert", label=actions.primaryLabel, base=actions.primaryBase, disabled=(handoffs.pending != "" or (surface != "thread" and not handoffs.canCheckout)), destructive=true, press=act("handoff", `${surface}|conflicts`), left=primaryBlur, compact=compact, still=still, testId="pull-request-primary")
      if actions.stateKey != ""
        row height="1.5rem" min-width="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff0a)" align-items="center" flex-shrink=0 testId="pull-request-state-badge"
          PgIcon(name=(actions.stateKey == "merged" ? "git-merge" : "git-pull-request-closed"), size=14, color=paTone(actions.stateKey))
          text actions.stateLabel font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=paTone(actions.stateKey)
      // Beside a thread, its own pull request's branch is already under the reader's feet (context "thread").
      if surface == "page" or not handoffs.threadOwn
        PrdCheckoutMenu(handoffs=handoffs, surface=surface, scheme=scheme, narrow=narrow, act=act, actOn=actOn)
      PrdActionsMenu(actions=actions, handoffs=handoffs, links=links, actOn=actOn, surface=surface, ref=ref, url=url, hostName=hostName, numberLabel=numberLabel, scheme=scheme, still=still, reload=reload, act=act, copy=copy, local=local)

// Badge size="control" variant="info": the merge the host is holding.
component PaArmedBadge
  props
    label: string
    tip: string
    compact: bool
    testId: string
  view
    Tip(label=tip, side="top", align="center", offset=20)
      row height="1.5rem" min-width="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" background-color="light-dark(#2b7fff14, #2b7fff29)" align-items="center" flex-shrink=0 role="img" aria-label=label testId=testId
        PgIcon(name="git-merge", size=14, color="light-dark(#1447e6cc, #51a2ffcc)")
        if not compact
          text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color="light-dark(#1447e6, #51a2ff)" aria-hidden=true

// Button size="xs": variant "default" (the merge and readiness), "destructive-outline" (Resolve conflicts); the label is its tooltip.
// The label is at least as wide as `base`, the button's resting label, and eases to a wider one ("Confirm
// auto-merge?") over 150 ms (AnimatedWidth: transition-[width] duration-150 ease-out, none under reduced motion).
component PaPrimaryButton
  props
    icon: string
    label: string
    base: string
    disabled: bool
    destructive: bool
    press: action
    // The button lost the focus (an armed confirmation lapses).
    left: action
    compact: bool
    still: bool
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    Tip(label=label, side="top", align="center", offset=20)
      button id=testId press=press hover=hover blur=left disabled=disabled aria-label=label testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(destructive ? (over ? "light-dark(#fb2c3652, #fb414a52)" : "light-dark(#d4d4d8, #ffffff14)") : paPrimary()) background-color=(destructive ? (over ? "light-dark(#fb2c360a, #fb414a0a)" : "light-dark(#ffffff, #ffffff07)") : (over ? "light-dark(#1b4ed8e6, #346bf1e6)" : paPrimary())) box-shadow=(destructive ? "0 1px 2px #0000000d" : "inset 0 1px 0 #ffffff29, 0 1px 2px #1b4ed83d") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
        PgIcon(name=icon, size=14, color=(destructive ? paDanger() : "#ffffff"))
        if not compact
          column align-items="flex-start" flex-shrink=0 overflow="hidden" -exact-layout-transition=(still ? "none" : "150ms ease-out")
            text base font-size="0.75rem" line-height=0 height=0 font-weight=500 white-space="nowrap" visibility="hidden" aria-hidden=true
            text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=(destructive ? paDanger() : "#ffffff")

// "More pull request actions" (Button size="icon-xs" variant="ghost-muted"); while the host is read
// again the dots become the turning refresh glyph and the name "Refreshing pull request".
component PrdActionsMenu
  props
    actions: PrActionsView
    handoffs: PrHandoffsView
    links: PrLinksView
    actOn: PrActOnItem[]
    surface: string
    ref: string
    url: string
    hostName: string
    numberLabel: string
    scheme: string
    still: bool
    reload: action
    act: action
    copy: action
    local: action
  state over = false
  // The menu's keyboard (menu-keys.contract): Enter or Space on "…" opens it with the
  // focus on its first row, and the arrows, Home, End and a letter move through the enabled rows.
  derive gated = not actions.pending and actions.open
  derive handing = handoffs.pending == ""
  derive rows = [KmItem(id=(links.menuShown and not links.pending ? "pr-more-link" : ""), label=links.menuLabel), KmItem(id=(actions.refreshing ? "" : "pr-more-refresh"), label="Refresh"), KmItem(id=(handing ? "pr-more-ask" : ""), label="Ask a question"), KmItem(id=(handing ? "pr-more-explain" : ""), label="Explain this PR"), KmItem(id=(handing ? "pr-more-fix-findings" : ""), label="Fix findings"), KmItem(id=(actions.guideEnabled and not actions.guideDisabled ? "pr-more-guide" : ""), label=actions.guideLabel)].concat(actOn.map((item) => KmItem(id=(handing ? `pr-more-act-on-${item.key}` : ""), label=item.label))).concat([KmItem(id=(gated and actions.draftToggle == "draft" ? "pr-more-draft" : ""), label="Convert to draft"), KmItem(id=(gated and actions.draftToggle == "ready" ? "pr-more-ready" : ""), label="Ready for review"), KmItem(id=(gated and actions.mergeNow ? "pr-more-merge-now" : ""), label=actions.mergeNowLabel), KmItem(id=(gated and actions.autoMerge == "disable" ? "pr-more-disable-auto-merge" : ""), label="Disable auto-merge"), KmItem(id=(gated and actions.autoMerge == "enable" ? "pr-more-enable-auto-merge" : ""), label=actions.autoMergeLabel)]).concat(actions.methods.map((item) => KmItem(id=(gated ? `pr-more-method-${item.method}` : ""), label=item.label))).concat([KmItem(id="pr-more-open-host", label=`Open on ${hostName}`), KmItem(id="pr-more-copy-link", label="Copy link"), KmItem(id="pr-more-copy-number", label="Copy PR number"), KmItem(id=(actions.closeItem and not actions.pending ? "pr-more-close" : ""), label=actions.closeLabel), KmItem(id=(actions.reopenItem and not actions.pending ? "pr-more-reopen" : ""), label="Reopen pull request"), KmItem(id=(actions.revertItem and not actions.pending ? "pr-more-revert" : ""), label=actions.revertLabel), KmItem(id=(actions.deleteBranchItem and not actions.deleteBranchDisabled ? "pr-more-delete-branch" : ""), label="Delete branch")]).filter((item) => item.id != "")
  action hover(value: bool)
    over = value
  // menu-keys.contract: the link row is a MenuItem too, highlighted by its focus alone; the
  // pointer entering it focuses it, and leaving it while it holds the focus hands the focus to the popup.
  state hostLit = false
  action hostLitHover(on: bool)
    if on
      focus("pr-more-open-host")
    else if hostLit
      focus("pr-more-keys")
  action hostLitFocus(on: bool)
    hostLit = on
  action moreKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("pr-more-menu", source="pull-request-more")
        let target = kmTriggerTarget(rows, k)
        if target != ""
          focus(target)
  // A row that confirms in place: its first press arms it and keeps the menu open, its second runs it.
  action askDeleteBranch
    hidePopover("pr-more-menu")
    blur()
    local("pr-ui-ask", ref, "delete-branch")
  action confirmRow(what: string)
    if actions.armedControl == "menu" and actions.armedAction == what
      act("action", what)
    else
      local("pr-ui-arm", ref, `menu|${what}`)
  action rowLeft(what: string)
    if actions.armedControl == "menu" and actions.armedAction == what
      local("pr-ui-disarm", ref, `menu|${what}`)
  view
    column position="relative" flex-shrink=0
      Tip(label=actions.moreLabel, side="top", align="center", offset=20)
        button id="pull-request-more" popovertarget="pr-more-menu" hover=hover key=moreKey aria-label=actions.moreLabel testId="pull-request-more" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          if actions.refreshing
            box width="1rem" height="1rem" display="flex" animation=(still ? "none" : "paSpin 1s linear infinite") testId="pull-request-refreshing"
              PgIcon(name="refresh-cw", size=16, color=paMuted())
          else
            PgIcon(name="ellipsis", size=16, color=paMuted())
      // MenuPopup align="end" side="bottom" (PullRequestDetailPanel.tsx): its right edge under the trigger's.
      row id="pr-more-menu" popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId="pr-more-layer"
        // As wide as its widest line: "Opens a thread that knows which pull request you mean." (318 at 12px) and the
        // item's glyph, gap and insets.
        PrMenuBox(scheme=scheme, width=380, label="More pull request actions")
          KeyMenu(menuId="pr-more-keys", items=rows, keyed=0, gap="0px", modal=true)
            PrdConfirmEscape(actions=actions, ref=ref, local=local, inMenu=true)
            // PullRequestThreadLinks display="menu-item" (no thread to link to: the picker).
            if links.menuShown
              PaMenuItem(keysId="pr-more-keys", icon=links.menuIcon, label=links.menuLabel, shortcut="", disabled=links.pending, destructive=false, press=act("links", links.menuPicker ? "picker" : "toggle"), testId="pr-more-link")
            PaMenuItem(keysId="pr-more-keys", icon="refresh-cw", label="Refresh", shortcut="", disabled=actions.refreshing, destructive=false, press=reload, testId="pr-more-refresh")
            PrdHandoffItems(keysId="pr-more-keys", handoffs=handoffs, surface=surface, menuId="pr-more-menu", act=act)
            if actions.guideEnabled
              PaMenuItem(keysId="pr-more-keys", icon="sparkles", label=actions.guideLabel, shortcut="", disabled=actions.guideDisabled, destructive=false, press=act("guide-write", ""), testId="pr-more-guide")
            PrdActOnItems(keysId="pr-more-keys", items=actOn, disabled=(handoffs.pending != ""), act=act, idPrefix="pr-more-act-on-")
            PaSeparator()
            if actions.open
              if actions.draftToggle == "draft"
                PaMenuItem(keysId="pr-more-keys", icon="git-pull-request-draft", label="Convert to draft", shortcut="", disabled=actions.pending, destructive=false, press=act("action", "draft"), testId="pr-more-draft")
              if actions.draftToggle == "ready"
                PaMenuItem(keysId="pr-more-keys", icon="git-pull-request-arrow", label="Ready for review", shortcut="", disabled=actions.pending, destructive=false, press=act("action", "ready"), testId="pr-more-ready")
              if actions.mergeNow
                PaConfirmItem(keysId="pr-more-keys", icon="git-merge", label=actions.mergeNowLabel, armed=(actions.armedControl == "menu" and actions.armedAction == "merge"), disabled=actions.pending, destructive=false, press=confirmRow("merge"), left=rowLeft("merge"), testId="pr-more-merge-now")
              if actions.autoMerge == "disable"
                PaMenuItem(keysId="pr-more-keys", icon="git-merge", label="Disable auto-merge", shortcut="", disabled=actions.pending, destructive=false, press=act("action", "disable-auto-merge"), testId="pr-more-disable-auto-merge")
              if actions.autoMerge == "enable"
                PaConfirmItem(keysId="pr-more-keys", icon="git-merge", label=actions.autoMergeLabel, armed=(actions.armedControl == "menu" and actions.armedAction == "enable-auto-merge"), disabled=actions.pending, destructive=false, press=confirmRow("enable-auto-merge"), left=rowLeft("enable-auto-merge"), testId="pr-more-enable-auto-merge")
              if actions.methodsSeparator
                PaSeparator()
              if actions.methods.length > 0
                column width="100%" role="group" aria-label="Merge method"
                  for item in actions.methods key=item.key
                    PaRadioItem(keysId="pr-more-keys", label=item.label, selected=item.selected, disabled=actions.pending, press=local("pr-ui-method", ref, item.method), testId=`pr-more-method-${item.method}`)
              if actions.groupSeparator
                PaSeparator()
            link id="pr-more-open-host" hover=hostLitHover focus=hostLitFocus(true) blur=hostLitFocus(false) cursor="pointer" href=url role="menuitem" testId="pr-more-open-host" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" background-color=(hostLit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              PgIcon(name="arrow-up-right", size=14, color=paMuted())
              text `Open on ${hostName}` font-size="0.875rem" line-height="1.25rem" color=paInk() flex=1 min-width=0 white-space="nowrap"
            PaMenuItem(keysId="pr-more-keys", icon="link", label="Copy link", shortcut="⇧⌘C", disabled=false, destructive=false, press=copy("PR link", url), testId="pr-more-copy-link")
            PaMenuItem(keysId="pr-more-keys", icon="copy", label="Copy PR number", shortcut="⇧⌘K", disabled=false, destructive=false, press=copy("PR number", numberLabel), testId="pr-more-copy-number")
            if actions.closeItem
              PaSeparator()
              PaConfirmItem(keysId="pr-more-keys", icon="git-pull-request-closed", label=actions.closeLabel, armed=(actions.armedControl == "menu" and actions.armedAction == "close"), disabled=actions.pending, destructive=true, press=confirmRow("close"), left=rowLeft("close"), testId="pr-more-close")
            if actions.reopenItem
              PaSeparator()
              PaMenuItem(keysId="pr-more-keys", icon="git-pull-request-arrow", label="Reopen pull request", shortcut="", disabled=actions.pending, destructive=false, press=act("action", "reopen"), testId="pr-more-reopen")
            if actions.revertItem
              PaSeparator()
              PaConfirmItem(keysId="pr-more-keys", icon="rotate-ccw", label=actions.revertLabel, armed=(actions.armedControl == "menu" and actions.armedAction == "revert"), disabled=actions.pending, destructive=(actions.armedAction == "revert"), press=confirmRow("revert"), left=rowLeft("revert"), testId="pr-more-revert")
            if actions.deleteBranchItem
              PaSeparator()
              PaMenuItem(keysId="pr-more-keys", icon="trash-2", label=actions.deleteBranchLabel, shortcut="", disabled=actions.deleteBranchDisabled, destructive=true, press=askDeleteBranch, testId="pr-more-delete-branch")
      box width="1rem" height=1 flex-shrink=0

component PaSeparator
  view
    box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff0f)" role="separator"

component PaMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    icon: string
    label: string
    shortcut: string
    disabled: bool
    destructive: bool
    press: action
    testId: string
  state lit = false
  action hover(value: bool)
    if value and not disabled
      focus(testId)
    else if not value and lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press popovertarget="pr-more-menu" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role="menuitem" testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
      PgIcon(name=icon, size=14, color=(destructive ? paDanger() : paMuted()))
      text label font-size="0.875rem" line-height="1.25rem" color=(destructive ? paDanger() : paInk()) flex=1 min-width=0 text-align="left" white-space="nowrap"
      if shortcut != ""
        text shortcut font-size="0.75rem" line-height="1rem" color=paMuted() flex-shrink=0

// A MenuItem that confirms in place (closeOnClick only once armed): the arming press leaves the menu open
// with the row's label asking "Confirm …?"; the focus leaving the row lets the arming go.
component PaConfirmItem
  props
    keysId: string
    icon: string
    label: string
    armed: bool
    disabled: bool
    destructive: bool
    press: action
    left: action
    testId: string
  state lit = false
  action hover(value: bool)
    if value and not disabled
      focus(testId)
    else if not value and lit
      focus(keysId)
  action focused(on: bool)
    lit = on
    if not on
      left()
  view
    button id=testId press=press popovertarget=(armed ? "pr-more-menu" : "") popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role="menuitem" aria-label=label testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit and not disabled ? (destructive ? "light-dark(#fb2c3614, #fb414a1f)" : "light-dark(#f4f4f5, #ffffff0a)") : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
      PgIcon(name=icon, size=14, color=(destructive ? paDanger() : paMuted()))
      text label font-size="0.875rem" line-height="1.25rem" color=(destructive ? paDanger() : paInk()) flex=1 min-width=0 text-align="left" white-space="nowrap"

// MenuRadioItem (closeOnClick): the chosen method is tinted (bg-foreground/8).
component PaRadioItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    selected: bool
    disabled: bool
    press: action
    testId: string
  state lit = false
  action hover(value: bool)
    if value and not disabled
      focus(testId)
    else if not value and lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press popovertarget="pr-more-menu" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=disabled role="menuitemradio" aria-checked=selected testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(lit and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : selected ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
      PgIcon(name="git-merge", size=14, color=paMuted())
      text label font-size="0.875rem" line-height="1.25rem" color=paInk() flex=1 min-width=0 text-align="left" white-space="nowrap"

// The base branch: out of date, it is amber with the warning mark, and pointing at it (or pressing it)
// opens PullRequestBaseFreshnessWarning; current, it keeps its plain tooltip ("Stacked on …" for a
// stacked base, with the layers glyph).
component PrdBaseBranch
  props
    actions: PrActionsView
    ref: string
    base: string
    scheme: string
    act: action
  view
    if actions.freshness
      // Keyed by the pull request, so a pointer left over another one's mark starts no card here.
      for prKey in [ref] key=prKey
        PaFreshnessMark(actions=actions, prKey=prKey, base=base, scheme=scheme, act=act)
    else
      Tip(label=actions.baseTip, side="top", align="center", offset=20)
        row min-width=0 align-items="center" gap="0.25rem" flex-shrink=0 testId="pull-request-base"
          if actions.stacked
            box width="0.75rem" height="0.75rem" aria-label="Stacked pull request" flex-shrink=0
              PgIcon(name="layers", size=12, color="light-dark(#71717bb3, #828282b3)")
          text base font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0

// PullRequestBaseFreshnessWarning's trigger: the amber base branch and mark. Pressed (or Return), it opens
// the card as a popover; pointed at, the window's hover layer draws the same card under it (openOnHover
// delay 0, closeDelay 120, side bottom, align start: hover-layer.contract), where the pointer can move
// into it and press its buttons (#262; issues/closed/20261009-macos-subtree-hover.md, #322, fixed on main by #327: the layer stays as the reference's portal).
component PaFreshnessMark
  inject
    rem: number
    hoverTipAt: action
  props
    actions: PrActionsView
    prKey: string
    base: string
    scheme: string
    act: action
  action hover(value: bool)
    hoverTipAt(hoverTipAtFrame(`pr-freshness-${prKey}`, "freshness", actions.freshnessSummary, [], "bottom", "start", frame("pr-freshness-mark"), 6.5 * rem, "pr-freshness-hover"), "trigger", value)
  // The pressed popover's buttons keep nothing open (the top layer holds it); their hover is only their own.
  state popoverButtonOver = false
  action stay(value: bool)
    popoverButtonOver = value
  view
    column position="relative" flex-shrink=0 min-width=0 max-width="40%" hover=hover
      button id="pr-freshness-mark" popovertarget="pr-freshness" aria-label=actions.freshnessSummary testId="pull-request-base-freshness" height="1rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" gap="0.25rem" display="flex" flex-direction="row" align-items="center" min-width=0 cursor="help"
        if actions.stacked
          PgIcon(name="layers", size=12, color=paWarn())
        text base font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=paWarn() white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
        PgIcon(name="triangle-alert", size=14, color=paWarn())
      // aria-modal: while it shows, its Escape closes it, not the Pull Requests page.
      // PopoverPopup align="start" side="bottom": 4 pt below the mark's start, flipping near an edge. The reference opens
      // it on hover too; here the hover shows the window's hover tip, so this pressed popover needs no hover bridge.
      row id="pr-freshness" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" aria-modal=true position="absolute" margin-top="0.25rem" testId="pr-freshness-layer"
        PaFreshnessCard(actions=actions, scheme=scheme, act=act, keep=stay, testId="pr-freshness-popover")

// PopoverPopup (compact, max-w-80): the sentence, "Changes can be cleanly merged.", each way to update.
component PaFreshnessCard
  props
    actions: PrActionsView
    scheme: string
    act: action
    // The pointer on a button is still on the card (the hover layer's card hears a leave as it moves onto one).
    keep: action
    testId: string
  view
    column max-width="20rem" flex-shrink=0 padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #121212)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a") role="dialog" aria-label=actions.freshnessSummary testId=testId
      text actions.freshnessSummary font-size="0.75rem" line-height="1rem" color=paInk() font-family="system-ui"
      text "Changes can be cleanly merged." margin-top="0.125rem" font-size="0.75rem" line-height="1rem" color=paMuted() font-family="system-ui"
      if actions.freshnessMethods.length > 0
        row margin-top="0.5rem" flex-wrap="wrap" align-items="center" gap="0.375rem"
          for item in actions.freshnessMethods key=item.key
            PaOutlineButton(icon="git-merge", label=item.label, disabled=actions.pending, press=act("action", item.value), keep=keep, testId=`${testId}-${item.key}`)

// Button size="xs" variant="outline".
component PaOutlineButton
  props
    icon: string
    label: string
    disabled: bool
    press: action
    keep: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
    keep(value)
  view
    button press=press hover=hover disabled=disabled testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=12, color=paMuted())
      text label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=paInk() font-family="system-ui"

// Button size="xs" variant="warning-outline": the Summary tab bar's "Approve workflows to run".
// It confirms in place ("Confirm approve?"), at the width of its longest label.
component PrdApproveWorkflows
  props
    actions: PrActionsView
    ref: string
    act: action
    local: action
  action confirm
    if actions.armedControl == "approve" and actions.armedAction == "approve-workflows"
      act("action", "approve-workflows")
    else
      local("pr-ui-arm", ref, "approve|approve-workflows")
  action left
    if actions.armedControl == "approve"
      local("pr-ui-disarm", ref, "approve|approve-workflows")
  view
    Tip(label=actions.approveLabel, side="top", align="center", offset=20)
      button id="pull-request-approve-workflows" press=confirm blur=left disabled=actions.pending aria-label=actions.approveLabel testId="pull-request-approve-workflows" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#fe9a0052" background-color="light-dark(#fe9a0014, #fe9a0029)" box-shadow="0 1px 2px #0000000d" opacity=(actions.pending ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
        PgIcon(name="play", size=14, color=paWarn())
        column align-items="flex-start" flex-shrink=0
          text "Approve workflows to run" font-size="0.75rem" line-height=0 height=0 font-weight=500 white-space="nowrap" visibility="hidden" aria-hidden=true
          text "Confirm approve?" font-size="0.75rem" line-height=0 height=0 font-weight=500 white-space="nowrap" visibility="hidden" aria-hidden=true
          text actions.approveLabel font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=paWarn()

// Over the window: the stack's Dialog for the panel's pull request.
component PrActionLayers
  props
    actions: PrActionsView
    ref: string
    dark: bool
    act: action
    local: action
  view
    if actions.dialogOpen
      PrActionDialog(actions=actions, ref=ref, dark=dark, act=act, local=local)
    DialogFinalFocus(open=actions.dialogOpen, owner="pr-action-dialog")
    // The stack's Dialog gives the focus back to the stack menu's trigger (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=actions.stack.dialogOpen, owner="pr-stack-dialog")
    if actions.stack.dialogOpen
      PrStackDialog(stack=actions.stack, ref=ref, dark=dark, act=act, local=local)

// While a confirmation is armed, Escape lets it go (useInlineActionConfirm's capturing keydown) instead of
// leaving the page or closing the thread's panel.
component PrdConfirmEscape
  props
    actions: PrActionsView
    ref: string
    local: action
    inMenu: bool
  view
    if actions.armedAction != "" and (actions.armedControl == "menu") == inMenu
      box position="absolute" left=0 top=0 width=0 height=0 overflow="hidden"
        button press=local("pr-ui-disarm", ref, "") aria-keyshortcuts="Escape" aria-label="Cancel confirmation" tabindex=-1 testId="pull-request-confirm-escape" width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
          text "Cancel" font-size=1

// Destructive source-branch confirmation: start on Cancel and restore the prior focus when it closes.
component PrActionDialog
  inject
    dialogEntered: action
    dialogSeated: string[]
  props
    actions: PrActionsView
    ref: string
    dark: bool
    act: action
    local: action
  derive opener = "pull-request-more"
  action fromCancel(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      focus(actions.pending ? "pr-action-dialog-cancel" : "pr-action-dialog-confirm")
  action dismiss
    local("pr-ui-cancel", ref, "")
    focus(opener)
  action fromConfirm(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      focus("pr-action-dialog-cancel")
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=80 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="pr-action-dialog-overlay"
      column width="100%" max-width="32rem" position="relative" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow=(dark ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") overflow="hidden" retainFocus=true role="alertdialog" aria-describedby="pr-action-dialog-description" aria-modal=dialogSeated.includes("pr-action-dialog") aria-label=actions.dialogTitle testId="pr-action-dialog" id="pr-action-dialog" data-dialog-focus="open" focusin=dialogEntered("pr-action-dialog")
        DialogOpenFocus(target="pr-action-dialog-cancel")
        column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
          text actions.dialogTitle font-size="1.25rem" font-weight=600 line-height="1.25rem" color=paInk() role="heading" aria-level=2 testId="pr-action-dialog-title"
          text actions.dialogDescription font-size="0.875rem" line-height="1.25rem" color=paMuted() testId="pr-action-dialog-description" id="pr-action-dialog-description"
        row width="100%" gap="0.5rem" justify-content="flex-end" align-items="center" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button id="pr-action-dialog-cancel" press=dismiss key=fromCancel autofocus=true aria-keyshortcuts="Escape" testId="pr-action-dialog-cancel" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center"
            text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color=paInk()
          button id="pr-action-dialog-confirm" press=act("action", actions.dialogValue) key=fromConfirm disabled=actions.pending testId="pr-action-dialog-confirm" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(actions.dialogDestructive ? "light-dark(#fb2c36, #fb414a)" : paPrimary()) background-color=(actions.dialogDestructive ? "light-dark(#fb2c36, #fb414a)" : paPrimary()) box-shadow="inset 0 1px 0 #ffffff29, 0 1px 2px #0000000d" opacity=(actions.pending ? 0.64 : 1) display="flex" align-items="center" justify-content="center"
            text actions.dialogConfirm font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff"
