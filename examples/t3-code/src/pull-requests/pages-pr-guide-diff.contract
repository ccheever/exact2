// T3 Code 9c161462c9 (MIT, LICENSE-T3): GuideExcerpt and GuideFileDiff over the shared diff rows.
use DiffItem from "../shared/shapes.contract"
use PrCodeView, PrdCodeRow from "./pages-pr-code.contract"
use PrHandoffsView from "./pages-pr-handoffs.contract"
use PrReactionChoice from "./pages-pr-threads.contract"
use ChatDocument, CodeHighlight, MarkdownEnv from "../timeline/markdown.contract"
use PgIcon from "../shared/pages-icons.contract"
use DiffGlyph from "../diff/diff-glyphs.contract"
use diffInk from "../appearance/settings-appearance-look.contract"
use diffChangeInk from "../diff/diff-rows.contract"

shape GuideRowNote
  key: string
  row: string
  marker: string
  title: string
shape GuideDiffCard
  rowNotes: GuideRowNote[]
  id: string
  path: string
  caption: string
  status: string
  additions: number
  deletions: number
  removed: bool
  missing: bool
  full: bool
  note: string
  open: bool
  expandable: bool
  shown: number
  total: number
  items: DiffItem[]
shape GuideDiffView
  cards: GuideDiffCard[]
  code: PrCodeView
  canComment: bool

component GuideDiffs
  props
    view: GuideDiffView
    ref: string
    width: number
    surface: string
    scheme: string
    env: MarkdownEnv
    handoffs: PrHandoffsView
    choices: PrReactionChoice[]
    documents: ChatDocument[]
    highlights: CodeHighlight[]
    still: bool
    local: action
    act: action
    reveal: action
  state draftText = ""
  action press(op: string, value: string)
    local(`pr-guide-${op}`, ref, value)
  action edit(text: string)
    draftText = text
  action begin(card: string, path: string, side: string, line: number)
    draftText = ""
    press("begin", `${card}|${side}|${line}|${path}`)
  action cancel
    draftText = ""
    press("cancel", "")
  action add
    if view.canComment and draftText.trim() != ""
      press("add", draftText)
      draftText = ""
  action agent
    act("guide-lines", `${surface}|${draftText}`)
    draftText = ""
  action rowCommand(card: string, op: string, id: string, value: string, n: number)
    if id == "expand"
      press("excerpt-expand", `${card}|${n}|${value}`)
    else
      press(id.startsWith("drag:") or id.startsWith("gutter:") or id == "to" or id == "end" ? "drag" : "row", `${card}|${op}|${id}|${n}|${value}`)
  view
    column width="100%" min-width=0 gap="1rem" testId="review-guide-excerpts"
      if view.code.message != ""
        text view.code.message font-size="0.75rem" color="light-dark(#71717b, #a1a1aa)"
      for card in view.cards key=card.id
        column width="100%" min-width=0 gap="0.375rem" testId=`guide-excerpt-${card.id}`
          if card.caption.trim() != ""
            text card.caption font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1aa)"
          column width="100%" min-width=0 border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" overflow="hidden"
            row width="100%" min-width=0 min-height="2rem" align-items="center" gap="0.5rem" padding=(card.full ? "0.75rem" : "0.375rem 0.5rem") box-sizing="border-box" background-color="light-dark(#f4f4f5, #ffffff06)"
              if card.full
                button press=press("file-toggle", card.path) aria-expanded=card.open aria-label=`${card.open ? "Collapse" : "Expand"} ${card.path}` title="" testId=`guide-file-toggle-${card.id}` padding=0 border-width=0 background-color="#00000000"
                  PgIcon(name=(card.open ? "chevron-down" : "chevron-right"), size=14, color="light-dark(#71717b, #a1a1aa)")
                text card.path flex=1 min-width=0 font-family=env.codeFont font-size="0.75rem" line-height="1.125rem" text-overflow="ellipsis" white-space="nowrap"
                button press=reveal(card.path) aria-label=`Open ${card.path} in Code` testId=`guide-open-code-${card.id}`
                  text "Open in Code"
              else
                if not card.missing
                  DiffGlyph(name=card.status, size=16, color=diffChangeInk(scheme, card.status))
                text card.path flex=1 min-width=0 font-size="0.75rem" line-height="1rem" text-overflow="ellipsis" white-space="nowrap"
                row align-items="center" gap="0.5rem" flex-shrink=0
                  if not card.missing
                    row align-items="baseline" gap="0.25rem" aria-label=`${card.additions} additions, ${card.deletions} deletions`
                      if card.deletions > 0
                        text `-${card.deletions}` font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "del-count")
                      if card.additions > 0
                        text `+${card.additions}` font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "add-count")
                    text `${card.removed ? "removed code, " : ""}showing ${card.shown} of ${card.total} diff lines` font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1aa)"
                  button press=reveal(card.path) aria-label=`Open ${card.path} in Code` testId=`guide-open-code-${card.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
                    PgIcon(name="arrow-up-right", size=14, color="light-dark(#71717b, #a1a1aa)")
            if card.note != ""
              text card.note padding="0.75rem" font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1aa)"
            if card.missing
              text "This diff range is not available. Open the file in Code to inspect it." padding="0.75rem" font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1aa)"
            if card.open and not card.missing
              for item in card.items key=item.id
                if item.kind == "pr-draft" and not view.canComment
                  column width="100%" gap="0.5rem" padding="0.75rem" box-sizing="border-box" testId="guide-ask-lines-draft"
                    textarea data-editable="yes" id="guide-lines-question" value=draftText input=edit rows=2 placeholder="Ask about these lines…" aria-label="Question about selected guide lines" autocorrect="off" spellcheck="false" testId="guide-lines-question" width="100%" min-height="3rem"
                    row gap="0.5rem" justify-content="flex-end"
                      button press=cancel testId="guide-lines-cancel"
                        text "Cancel"
                      button press=agent testId="guide-lines-ask"
                        text "Ask agent"
                else
                  PrdCodeRow(width=width, item=item, code=view.code, scheme=scheme, size=env.codeSize, surface=surface, draftText=draftText, handoffs=handoffs, choices=choices, documents=documents, highlights=highlights, env=env, still=still, local=local, act=act, press=press, rowCommand=rowCommand(card.id), begin=begin(card.id), cancel=cancel, editDraft=edit, add=add, agent=agent)
                  if card.rowNotes.filter((note) => note.row == item.id).length > 0
                    row width="100%" min-width=0 flex-wrap="wrap" align-items="center" column-gap="0.75rem" row-gap="0.25rem" padding-top="0.25rem" padding-bottom="0.25rem" padding-left=(item.gutter + 12) padding-right="0.75rem" box-sizing="border-box" background-color="light-dark(#f4f4f5, #ffffff0a)"
                      for note in card.rowNotes.filter((note) => note.row == item.id) key=note.key
                        row min-width=0 align-items="center" gap="0.375rem" testId=`guide-note-marker-${note.key}`
                          box width="1.125rem" height="1.125rem" flex-shrink=0 border-radius="50%" background-color="light-dark(#155dfc29, #51a2ff29)" display="flex" align-items="center" justify-content="center" aria-hidden=true
                            text note.marker font-size="0.5625rem" line-height="1rem" font-weight=500 font-variant-numeric="tabular-nums" color="light-dark(#155dfc, #8ec5ff)"
                          text note.title min-width=0 font-size="0.75rem" line-height="1rem"
