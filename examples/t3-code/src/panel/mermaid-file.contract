// A Mermaid file's body in Files and in a sent file's preview (MIT reference, see LICENSE-T3:
// components/files/MermaidViewer.tsx, chat/MermaidDiagram.tsx; T3 Code 7c3b3b3605ef): the diagram in a scrolling pane
// with 24pt sides, the whole width a button that expands it ("Expand diagram"), or pele's error over the source; a file
// the reference refuses to lay out names why instead (mermaid-file.ts). The diagram is the Mermaid page the chat's
// fences draw in (timeline-mermaid.ts, view "file"), so its reports and Retry are the window's chat ops.
use MermaidDiagram from "../timeline/mermaid-frame.contract"
use MermaidFrameView from "../timeline/mermaid-frame.contract"

component MermaidFileView
  props
    diagrams: MermaidDiagram[]
    note: string
    scheme: string
    local: action
    testId: string
  view
    if note != ""
      text note padding="1.5rem" box-sizing="border-box" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="alert" testId=`${testId}-refused`
    else
      scroll flex=1 min-height=0 width="100%" testId=testId
        column width="100%" padding="1.5rem" box-sizing="border-box"
          for diagram in diagrams key=diagram.id
            MermaidFileDiagram(diagram=diagram, scheme=scheme, local=local, testId=testId)

component MermaidFileDiagram
  props
    diagram: MermaidDiagram
    scheme: string
    local: action
    testId: string
  derive frame = scheme == "dark" ? diagram.dark : diagram.light
  view
    if frame.diagram == "error"
      // DiagramError: the message (with Retry when another load may help), then the source.
      column width="100%"
        row width="100%" align-items="center" justify-content="space-between" gap="0.5rem"
          text `Unable to render diagram: ${frame.message}` min-width=0 font-size="0.75rem" line-height="1rem" white-space="pre-wrap" color="light-dark(#fb2c36, #fb414a)" role="alert"
          if frame.retryable
            button press=local("diagram-retry", scheme, diagram.code) testId=`${testId}-retry` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
              text "Retry" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
        text diagram.code width="100%" margin-top="0.5rem" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
    else
      box position="relative" width="100%"
        MermaidFrameView(src=(scheme == "dark" ? diagram.srcDark : diagram.srcLight), frame=frame, width=0, height=0, placeholder=diagram.code, local=local, testId=`${testId}-frame`)
        if frame.diagram == "rendered"
          button press=local("diagram-open", diagram.id, diagram.code) aria-label="Expand diagram" testId=`${testId}-expand` cursor="zoom-in" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" title="" id=`${testId}-expand`
