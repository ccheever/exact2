use PrQuickActions from "../pull-requests/pages-pr-quick.contract"
use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
use TerminalContent from "../terminal/terminal.contract"
use Look from "../appearance/settings-appearance-look.contract"
// The right panel's tab bar and its non-diff surfaces (panel-surfaces.ts),
// measured on the served reference (MIT, see LICENSE-T3:
// RightPanelTabs.tsx, ui/panel-tab-close-button.tsx, PanelLayoutControls.tsx,
// pullRequest/ThreadPullRequestsPanel.tsx, PullRequestListRow.tsx,
// device/DeviceSetup.tsx, DevicePanel.tsx, ui/wizard.tsx). `ui` is the window's
// panelUi (choose, tab-close, toggle, maximize), `local` its chatLocal (a
// `surface-*` op without the command gate) and `command` its gated command.
use PanelView from "./panel-shapes.contract"
use PanelTab from "./panel-shapes.contract"
use LinkedPrs from "./panel-shapes.contract"
use LinkedPrRow from "./panel-shapes.contract"
use DeviceSurface from "./panel-shapes.contract"
use SimulatorSupportSection from "../device/device-support.contract"
use TabScroll from "./tab-strip.contract"
use ShellSurface from "../shell/shell-shapes.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use MorphMaximize from "../shell/shell-morph.contract"
use FileTypeIcon from "../shared/timeline-files.contract"
use PgIcon from "../shared/pages-icons.contract"
use PrAvatar from "../pull-requests/pages-prs.contract"
use prStateIcon from "../pull-requests/pages-prs.contract"
use prStateTone from "../pull-requests/pages-prs.contract"
use prChecksIcon from "../pull-requests/pages-prs.contract"
use prChecksTone from "../pull-requests/pages-prs.contract"
use prReviewIcon from "../pull-requests/pages-prs.contract"
use prReviewTone from "../pull-requests/pages-prs.contract"
use PvSwitch from "../settings/providers-kit.contract"
use PanelIcon from "./panel-icons.contract"
use DeviceStatus from "../device/device-workspace.contract"
use DeviceLoading from "../device/device-workspace.contract"
use DeviceWorkspaceView from "../device/device-workspace.contract"
use PlatformGlyph from "../device/device-tools.contract" // the device tab's platform mark
use FilesBody from "./files-surface.contract"
use ChatDocument from "../timeline/markdown.contract"
use prdTone from "../pull-requests/pages-pr-detail.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmKeyEnd from "../shared/menu-keys.contract"
use kmEndKeyed from "../shared/menu-keys.contract"
use BrowserSurface from "../browser/browser-surface.contract" // a Browser tab's body, its tab icon and the "+" menu row
use BrowserTabIcon from "../browser/browser-surface.contract"
use BrowserAddItem from "../browser/browser-surface.contract"
use BrowserProfileChoice from "../browser/browser-shapes.contract"
use BrowserAudioButton from "../browser/browser-automation.contract" // the tab's audio button
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use FieldOpenSelect from "../shared/dialog-trap.contract"

// The panel's top bar (52pt): the surface tabs and "Add panel surface", then the
// layout controls (details toggle in a sheet, else maximize; the terminal drawer;
// the right panel toggle). With no tabs it is the launcher's bar.
component PanelHeader
  props
    panel: PanelView
    surfaces: ShellSurface[]
    sheet: bool
    maximized: bool
    detailsOpen: bool
    keyThreadPanel: string
    keyRightPanel: string
    terminalAvailable: bool // the layout controls' toggle
    terminalOpen: bool
    keyTerminal: string
    still: bool
    ui: action
    details: action
    local: action
    scheme: string
    searchFocused: bool // the Files search has the focus (SurfacePanel filesSearchAt)
  view
    PanelHeaderBar(panel=panel, surfaces=surfaces, sheet=sheet, maximized=maximized, detailsOpen=detailsOpen, keyThreadPanel=keyThreadPanel, keyRightPanel=keyRightPanel, terminalAvailable=terminalAvailable, terminalOpen=terminalOpen, keyTerminal=keyTerminal, still=still, ui=ui, details=details, local=local, searchFocused=searchFocused)

// The bar itself, drawn by PanelHeader.
component PanelHeaderBar
  props
    panel: PanelView
    surfaces: ShellSurface[]
    sheet: bool
    maximized: bool
    detailsOpen: bool
    keyThreadPanel: string
    keyRightPanel: string
    terminalAvailable: bool // the layout controls' toggle
    terminalOpen: bool
    keyTerminal: string
    still: bool
    ui: action
    details: action
    local: action
    searchFocused: bool
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  // The tabs scroll when they overflow (tab-strip.ts). The offset is kept
  // here; an active-tab change (tabStrip.serial) scrolls it into view until the strip scrolls again.
  state tabsAt = 0
  state tabsSerial = 0
  // A tab just added has no anchor yet (activeRight 0) on the first answer that makes it
  // active, and the strip a new surface brings (the Diff and the other surfaces draw their own header) mounts at
  // 0 and reports that offset: neither may use up the change before the tab is measured, or a Files tab added at
  // the end stayed out of view (strip at 0 where the oracle scrolls to 222).
  action tabsScrolled(x: number, y: number)
    tabsAt = x
    tabsSerial = panel.tabStrip.activeRight > 0 ? panel.tabStrip.serial : tabsSerial
  action scrollTabs(step: number)
    tabsAt = min(panel.tabStrip.max, max(0, tabsScroll + step))
    tabsSerial = panel.tabStrip.serial
  // ScrollArea's scrollFade keeps `scroll-p-[var(--fade-size)]` (1.5rem) on the viewport, so
  // scrollIntoView "nearest" leaves the active tab 24 clear of either edge (measured on the f870c41
  // oracle at 840: a Files tab added at 321–379 scrolls the 181 strip to 222, not 198); each edge's fade
  // is min(24, the distance scrolled from that edge), as mask-l/r-from-[calc(100%-min(fade, overflow))].
  derive tabsNearest = panel.tabStrip.activeLeft - 24 < tabsAt ? panel.tabStrip.activeLeft - 24 : (panel.tabStrip.activeRight + 24 > tabsAt + panel.tabStrip.view ? panel.tabStrip.activeRight + 24 - panel.tabStrip.view : tabsAt)
  derive tabsScroll = (tabsSerial == panel.tabStrip.serial or not panel.tabStrip.overflow or panel.tabStrip.activeRight <= 0) ? tabsAt : min(panel.tabStrip.max, max(0, tabsNearest))
  derive tabsStep = max(120, panel.tabStrip.view * 0.75)
  derive tabsFadeLeft = panel.tabStrip.view > 0 ? min(24, max(0, tabsScroll)) * 100 / panel.tabStrip.view : 0
  derive tabsFadeRight = panel.tabStrip.view > 0 ? min(24, max(0, panel.tabStrip.max - tabsScroll)) * 100 / panel.tabStrip.view : 0
  derive tabsMask = not panel.tabStrip.overflow ? "none" : `linear-gradient(to right, #00000000 0%, #000000 ${tabsFadeLeft}%, #000000 ${100 - tabsFadeRight}%, #00000000 100%)`
  // The tab a right-click named. Its `contextmenu` runs before the host
  // shows the one `panel-tab-menu` popover (LLP 1021 §5.1), so the popover lists that tab's rows.
  state menuTab = ""
  action tabMenu(id: string)
    menuTab = id
  view
    row height=52 flex-shrink=0 padding-left="0.5rem" padding-right="0.8125rem" box-sizing="border-box" align-items="center" gap="0.25rem" position="relative" z-index=20 testId="panel-tabbar"
      // RightPanelTabs handleTabContextMenu: api.contextMenu.show at the pointer. macOS presents these
      // rows as an NSMenu (plain items, no separators, disabled ones dimmed); the agent and the web paint
      // the popover at the tab. A row presses the same `surface-<id>` op as the menu's choice. Its placement
      // stays `none`: the reference's is the system context menu's, at the pointer, not a Base UI popup.
      column id="panel-tab-menu" popover="auto" position-try-fallbacks="none" position="absolute" role="menu" width="12rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" testId="tab-menu"
        for menuOf in panel.tabs key=menuOf.id
          if menuOf.id == menuTab
            for item in menuOf.menu key=item.id
              button press=local(`surface-${item.id}`, menuOf.id, "") disabled=item.disabled popovertarget="panel-tab-menu" popovertargetaction="hide" role="menuitem" testId=`tab-menu-${item.id}` display="flex" flex-direction="row" align-items="center" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(item.disabled ? 0.64 : 1) background-color="#00000000"
                text item.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      scroll flex=1 min-width=0 height="1.5rem" overflow-x="scroll" overflow-y="hidden" scrollLeft=tabsScroll scroll=tabsScrolled mask-image=tabsMask hatch="t3-anchor" data-anchor="tab-strip-view" testId="panel-tab-strip"
        row flex-shrink=0 width=(panel.tabStrip.content > panel.tabStrip.view ? panel.tabStrip.content : "100%") gap="0.25rem" align-items="center" role="tablist" aria-label="Panel surfaces" hatch="t3-anchor" data-anchor="tab-strip-content"
          for tab in panel.tabs key=tab.id
            PanelTabChip(tab=tab, ui=ui, local=local, menu=tabMenu)
          if panel.count > 0
            AddSurfaceMenu(surfaces=surfaces, profiles=panel.browser.profiles, ui=ui, local=local)
      if panel.tabStrip.overflow
        TabScroll(canLeft=(tabsScroll > 1), canRight=(tabsScroll < panel.tabStrip.max - 1), left=scrollTabs(0 - tabsStep), right=scrollTabs(tabsStep))
      if sheet
        box position="relative" flex-shrink=0
          button press=details("toggle", "", "") hover=hover("details") aria-label="Toggle thread details panel" aria-expanded=detailsOpen testId="panel-toggle-details" width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(detailsOpen or hovered == "details" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
            ShellIcon(name="square-menu", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
          TipBubble(label=(keyThreadPanel == "" ? "Toggle thread details" : `Toggle thread details (${keyThreadPanel})`), side="bottom", align="center", offset=32, inset=0, shown=(hovered == "details"))
      else
        box position="relative" flex-shrink=0
          button press=ui("maximize", "") hover=hover("maximize") aria-label=(maximized ? "Restore panel size" : "Maximize panel") testId="maximize-right-panel" width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(maximized or hovered == "maximize" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
            MorphMaximize(on=maximized, size=16, color="light-dark(#27272acc, #f5f5f5cc)", weight=2, still=still)
          TipBubble(label=(maximized ? "Restore panel size" : "Maximize panel"), side="bottom", align="center", offset=32, inset=0, shown=(hovered == "maximize"))
      box position="relative" flex-shrink=0 hover=hover("terminal")
        button press=ui("terminal", "") disabled=(not terminalAvailable) aria-label="Toggle terminal drawer" aria-pressed=terminalOpen testId="panel-toggle-terminal" width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 opacity=(terminalAvailable ? 1 : 0.64) display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(terminalAvailable and (terminalOpen or hovered == "terminal") ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
          ShellIcon(name="panel-bottom", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
        TipBubble(label=(terminalAvailable ? (keyTerminal == "" ? "Toggle terminal drawer" : `Toggle terminal drawer (${keyTerminal})`) : "Terminal drawer is unavailable"), side="bottom", align="end", offset=32, inset=40, shown=(hovered == "terminal"))
      // T3 Code binds no Escape to the right panel (rightPanel.toggle is ⌘⌥B, rightPanel.close ⌘W); only
      // its sheet (a window 980pt wide or less: RightPanelSheet, a Base UI Dialog) closes on Escape, from any focus that lets
      // the key reach the document: the URL field and the Files search close it too. What keeps it there keeps it here: a
      // nested dialog (device setup) or menu (the file's editor menu), the file editor (installFileEditorDismissal blurs
      // it first), and the Browser pick, which focuses the page (PickPreload cancels it). Checked on the reference over CDP.
      // The Files search clears itself before its sheet closes (FileSearchField's onKeyDown runs first), so while it has
      // the focus the field takes the key and closes the sheet (FilesExplorer searchKey). The thread details popover drawn
      // above the sheet (app-overlays.contract) is the topmost layer while it shows, so its Escape comes first.
      box position="relative" flex-shrink=0
        button press=ui("toggle", "") hover=hover("toggle") aria-label="Toggle right panel" aria-keyshortcuts=((sheet and not (detailsOpen or panel.deviceSetup or panel.files.editing or searchFocused or panel.browser.capture.pickActive)) ? "Escape" : "") testId="panel-toggle-right" width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color="light-dark(#f4f4f5, #ffffff0a)" title=""
          ShellIcon(name="panel-right", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
        TipBubble(label=(keyRightPanel == "" ? "Toggle right panel" : `Toggle right panel (${keyRightPanel})`), side="bottom", align="end", offset=32, inset=8, shown=(hovered == "toggle"))

// One tab (24pt, 144pt at most, 6/8pt sides, 2pt gap, 12/16 text): the active one
// on the accent fill; a hovered tab turns its glyph into the close ×.
component PanelTabChip
  props
    tab: PanelTab
    ui: action
    local: action
    menu: action
  state over = false
  action hover(value: bool)
    over = value
  // Shift+F10 at the focused tab (its title or close button, `source`) opens the tab's menu from that button: the
  // strip's one popover, which with no `position-area` sits below its source, left edges aligned (LLP 1021 D2). The
  // buttons' own key handler reads the modifiers (exact2 8a0afbeab). ContextMenu is the host's default (exact2 #314),
  // the same menu at the focused button's centre.
  action tabKey(source: string, k: string, e: KeyboardEvent)
    if e.shiftKey and not e.metaKey and not e.ctrlKey and not e.altKey and k == "F10"
      preventDefault()
      menu(tab.id)
      showPopover("panel-tab-menu", source=source)
  // handleTabAuxClick: the middle button closes the tab, as an `auxclick` does, when it goes down and comes up
  // on the tab. A down that holds the primary or secondary button too is no middle click.
  state middleDown = false
  action tabPointerDown(e: PointerEvent)
    middleDown = e.buttons == 4
  action tabPointerUp(e: PointerEvent)
    let box = frame(`panel-tab-row-${tab.id}`)
    if middleDown and e.clientX >= box.x and e.clientX <= box.x + box.width and e.clientY >= box.y and e.clientY <= box.y + box.height
      ui("tab-close", tab.id)
    middleDown = false
  view
    row id=`panel-tab-row-${tab.id}` pointerdown=tabPointerDown pointerup=tabPointerUp contextmenu=menu(tab.id) contextPopover="panel-tab-menu" height="1.5rem" max-width="9rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" gap="0.125rem" align-items="center" border-radius="0.5rem" flex-shrink=0 hover=hover role="tab" aria-selected=tab.active background-color=(tab.active ? "light-dark(#f4f4f5, #141414)" : over ? "light-dark(#f4f4f599, #14141499)" : "#00000000") hatch="t3-anchor" data-anchor=`tab-chip:${tab.id}` testId=`panel-tab-${tab.id}`
      button id=`panel-tab-close-${tab.id}` hatch="t3-anchor" data-anchor=`tab-close:${tab.id}` press=ui("tab-close", tab.id) key=tabKey(`panel-tab-close-${tab.id}`) aria-label=`Close ${tab.title}` testId=`close-tab-${tab.id}` width="1rem" height="1rem" padding=0 border-radius="0.25rem" border-width=0 position="relative" flex-shrink=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
        if over
          ShellIcon(name="x", size=12, color=(tab.active or over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
        else
          if tab.fileToken != ""
            FileTypeIcon(token=tab.fileToken, size=12)
          else
            // A pull request tab wears its lifecycle glyph in its tone, else the muted glyph (PullRequestSurfaceIcon).
            if tab.kind == "pull-request"
              PgIcon(name=tab.icon, size=12, color=(tab.tone == "" ? "light-dark(#71717b, #818181)" : prdTone(tab.tone)))
            else
              if tab.kind == "browser"
                BrowserTabIcon(captured=tab.favicon, fallback=tab.faviconFallback, size=12, color=(tab.active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
              else
                if tab.icon == "apple" or tab.icon == "android"
                  PlatformGlyph(platform=tab.icon, size=12, color=(tab.active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
                else
                  ShellIcon(name=tab.icon, size=12, color=(tab.active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
        if tab.pending
          box position="absolute" right=-1 bottom=-1 width="0.375rem" height="0.375rem" border-radius="0.1875rem" background-color=(tab.active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
      if tab.audio == "audible" or tab.audio == "muted"
        BrowserAudioButton(tabId=tab.id, title=tab.title, audio=tab.audio, color=(tab.active or over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"), local=local)
      box hatch="t3-anchor" data-anchor=`tab-cancel:${tab.id}` press=local("surface-rename-cancel", tab.id, "") tabindex=-1 width=0 height=0 padding=0 border-width=0 opacity=0 aria-hidden=true position="absolute"
      if tab.renaming
        PanelTabNameField(tab=tab, local=local)
      else
        button id=`panel-tab-title-${tab.id}` hatch="t3-anchor" data-anchor=`tab-focus:${tab.id}` press=local("surface-activate", tab.id, "") dblclick=local("surface-rename", tab.id, "") key=tabKey(`panel-tab-title-${tab.id}`) aria-label=tab.title testId=`tab-${tab.id}` min-width=0 padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          text tab.title min-width=0 font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color=(tab.active or over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")


// The device tab's inline name editor (RightPanelTabs.tsx rename input, aria-label "Device tab
// name"): mounted when renaming starts, focused with its text selected (FieldOpenSelect). The
// name is the field's own state, and Enter and blur commit it as their argument, as
// SidebarRenameField does: a commit never depends on an earlier per-keystroke command having
// landed (a drive that typed then pressed Enter kept the old name). Escape is the native
// monitor's tab-cancel, which closes the editor first, so the blur after it commits nothing.
component PanelTabNameField
  props
    tab: PanelTab
    local: action
  state name = tab.renameValue
  action edit(value: string)
    name = value
  view
    FieldOpenSelect(target=`tab-name-${tab.id}`, length=tab.renameValue.length)
    input hatch="t3-anchor" data-anchor=`tab-editor:${tab.id}` id=`tab-name-${tab.id}` value=name input=edit blur=local("surface-rename-commit", tab.id, name) submit=local("surface-rename-commit", tab.id, name) autofocus=true aria-label="Device tab name" testId=`tab-name-${tab.id}` width="6rem" min-width=0 height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" box-shadow="0 0 0 1px light-dark(#a1a1aa80, #73737380)" background-color="#00000000" font-size="0.75rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" data-focus-stop="enabled"

// "Add panel surface": a 24pt ghost-muted "+" and the menu of every surface,
// unavailable ones at 64% with their reason.
component AddSurfaceMenu
  inject
    dialogMenuEntered: action
  props
    surfaces: ShellSurface[]
    profiles: BrowserProfileChoice[]
    ui: action
    local: action
  state over = false
  action hover(value: bool)
    over = value
  // Keyboard opening targets the first or last enabled menu row.
  derive menuItems = surfaces.filter((surface) => surface.available).map((surface) => KmItem(id=`add-surface-${surface.id}`, label=surface.label))
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("add-surface-menu", source="panel-add-surface")
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  view
    column position="relative" flex-shrink=0
      button popovertarget="add-surface-menu" key=triggerKey hover=hover aria-label="Add panel surface" testId="panel-add-surface" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="panel-add-surface"
        ShellIcon(name="plus", size=14, color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
      // MenuPopup align="start" side="bottom" sideOffset 6 (RightPanelTabs.tsx), flipping near an edge.
      column id="add-surface-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.375rem" width="12rem" data-dialog-return="menu" focusin=dialogMenuEntered("add-surface-menu", "panel-add-surface")
        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Add panel surface"
          KeyMenu(menuId="add-surface-menu-keys", items=menuItems, keyed=0, gap="0px", modal=true)
            for surface in surfaces key=surface.id
              if surface.id == "browser" and surface.available
                BrowserAddItem(keysId="add-surface-menu-keys", surface=surface, profiles=profiles, choose=ui("choose", surface.id), local=local)
              else
                AddSurfaceMenuItem(keysId="add-surface-menu-keys", surface=surface, choose=ui("choose", surface.id))

component AddSurfaceMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    surface: ShellSurface
    choose: action
  state hovered = false
  state lit = false
  action hover(over: bool)
    if over
      focus(`add-surface-${surface.id}`)
    else if lit
      focus(keysId)
    hovered = over
  action focused(on: bool)
    lit = on
  view
    box position="relative" width="100%" hover=hover
      button id=`add-surface-${surface.id}` press=choose popovertarget="add-surface-menu" popovertargetaction="hide" focus=focused(true) blur=focused(false) disabled=(not surface.available) role="menuitem" aria-label=`${surface.label} ${surface.shortcut}` aria-keyshortcuts=surface.shortcut testId=`add-surface-${surface.id}` display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(surface.available ? 1 : 0.64) background-color=(lit and surface.available ? "light-dark(#27272914, #f5f5f514)" : "#00000000") data-focus-stop=((not surface.available) ? "" : "enabled")
        box width="1rem" height="1rem" flex-shrink=0 opacity=0.8
          ShellIcon(name=surface.icon, size=16, color="light-dark(#71717b, #818181)")
        text surface.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        text surface.shortcut flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.075rem" color="light-dark(#71717b, #818181)"
      if not surface.available
        TipBubble(label=surface.reason, side="top", align="center", offset=32, inset=0, shown=hovered)

// The active non-diff surface under the tab bar.
component SurfaceBody
  props
    look: Look
    confirm: action
    closePending: bool
    panel: PanelView
    scheme: string
    sheet: bool
    local: action
    command: action
    paletteShow: action
    urlFocus: action
    urlFocused: bool // the URL field has the focus (the module answers the preview's chords)
    // The rendered Markdown file (app.contract filesMarkdown).
    filesDocuments: ChatDocument[]
    searchFocus: action // the Files search's focus and blur (SurfacePanel filesSearchFocus)
  view
    if panel.kind == "terminal"
      TerminalContent(view=panel.terminal, look=look, dark=(scheme == "dark"), closePending=closePending, command=command, confirm=confirm)
    if panel.kind == "files" or panel.kind == "file"
      FilesBody(family=look.codeFont, files=panel.files, documents=filesDocuments, scheme=scheme, sheet=sheet, local=local, searchFocus=searchFocus)
    if panel.kind == "pull-requests"
      LinkedPrsBody(prs=panel.prs, scheme=scheme, local=local, command=command, link=paletteShow("command", "link-pr"))
    if panel.kind == "device"
      DeviceSurfaceBody(device=panel.device, scheme=scheme, local=local, command=command)
    if panel.kind == "browser"
      BrowserSurface(view=panel.browser, scheme=scheme, local=local, urlFocus=urlFocus, urlFocused=urlFocused)

// ThreadPullRequestsPanel; one subtree serves both schemes: an svg's light-dark() paint follows an appearance change (main 9223aad88).
component LinkedPrsBody
  props
    prs: LinkedPrs
    scheme: string
    local: action
    command: action
    link: action
  view
    LinkedPrsList(prs=prs, local=local, command=command, link=link)

component LinkedPrsList
  props
    prs: LinkedPrs
    local: action
    command: action
    link: action
  view
    if not prs.supported
      column flex=1 align-items="center" justify-content="center" gap="0.5rem" padding="1.5rem" box-sizing="border-box" testId="linked-prs-unavailable"
        text "Linked pull requests unavailable" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        text "This environment does not support multiple linked pull requests." max-width="15rem" text-align="center" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
    if prs.supported and prs.rows.length == 0
      column flex=1 align-items="center" justify-content="center" gap="0.5rem" padding="1.5rem" box-sizing="border-box" testId="linked-prs-empty"
        PanelIcon(name="link-2", size=24, color="light-dark(#71717b99, #81818199)")
        text "No linked pull requests" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        text "Pull requests the agent opens from this thread land here. Link one yourself from a URL or a number." max-width="15rem" text-align="center" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        button press=link testId="linked-prs-link" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)"
          PanelIcon(name="plus", size=14, color="light-dark(#27272a, #f5f5f5)")
          text "Link pull request" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
    if prs.supported and prs.rows.length > 0
      column flex=1 min-height=0 position="relative" testId="linked-prs"
        scroll flex=1 min-height=0
          column width="100%" padding="0.375rem" box-sizing="border-box"
            for row in prs.rows key=row.key
              LinkedPrRowView(row=row, speedMode=prs.speedMode, local=local, command=command)
        row flex-shrink=0 align-items="center" justify-content="space-between" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)"
          text prs.footer font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="linked-prs-footer"
          button press=link testId="linked-prs-link-footer" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color="#00000000"
            PanelIcon(name="plus", size=14, color="light-dark(#27272a, #f5f5f5)")
            text "Link" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"

// LinkRow: the lifecycle glyph, "#n title" with the watch/checks/review signals
// and the diff stat, then stack, author, repository and branches over the age.
// Its actions menu shows over the second line's end while the row is hovered.
component LinkedPrRowView
  inject
    rem: number
    dialogMenuEntered: action
  props
    row: LinkedPrRow
    speedMode: bool
    local: action
    command: action
  state over = false
  action hover(value: bool)
    over = value
  // The actions menu is a popover under "…"; its rows mount while it shows (each row has its own, and the rows' ids are
  // one menu's), and read the end a key on "…" asked for as they mount (menu-keys.contract).
  state dragX = 0
  state dragY = 0
  state dragging = false
  state middleDown = false
  action down(e: PointerEvent)
    middleDown = e.buttons == 4
    dragX = e.clientX
    dragY = e.clientY
    dragging = false
  action drag(dx: number, dy: number)
    dragging = true
    dragX = dragX + dx
    dragY = dragY + dy
  action drop(vx: number, vy: number)
    let box = frame("composer-surface")
    if dragging and dragX >= box.x and dragX <= box.x + box.width and dragY >= box.y and dragY <= box.y + box.height
      local("surface-pr-insert", "", row.context)
    dragging = false
  action up(e: PointerEvent)
    let bounds = frame(`linked-pr-open-${row.number}`)
    if middleDown and e.clientX >= bounds.x and e.clientX <= bounds.x + bounds.width and e.clientY >= bounds.y and e.clientY <= bounds.y + bounds.height
      local("surface-linked-pr-open", "held", row.url)
    middleDown = false
  action open(e: MouseEvent)
    if not dragging
      local("surface-linked-pr-open", (e.metaKey or e.ctrlKey) ? "held" : "", row.url)
  action context(e: PointerEvent)
    menuOpen = true
  action ignoreDown(kind: string, e: PointerEvent)
    dragging = false
  action ignoreMove(e: PointerEvent)
    middleDown = false
  action quick(op: string, value: string)
    local("surface-pr-quick", "", value)
  state menuOpen = false
  state menuEnd = ""
  action menuKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        menuEnd = kmKeyEnd(k)
        showPopover(`linked-pr-menu-${row.key}`, source=`linked-pr-actions-${row.key}`)
  action toggled(e: ToggleEvent)
    menuOpen = e.newState == "open"
    if e.newState != "open"
      menuEnd = ""
  view
    row width="100%" position="relative" align-items="center" gap="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" padding-right="0.25rem" padding-left=((0.5 + row.depth * 1.25) * rem) box-sizing="border-box" border-radius="0.375rem" hover=hover background-color=(over or menuOpen ? "light-dark(#f4f4f599, #ffffff06)" : "#00000000") contextmenu=context contextPopover=`linked-pr-menu-${row.key}` testId=`linked-pr-${row.number}`
      if row.depth > 0
        box width=1 height="1.5rem" margin-left="-0.5rem" flex-shrink=0 background-color="light-dark(#e4e4e7b3, #ffffff12)"
      box width="1rem" flex-shrink=0 position="relative" aria-label=(row.waiting ? "Waiting for host state" : row.stateLabel)
        PgIcon(name=(row.waiting ? "git-pull-request-arrow" : prStateIcon(row.state)), size=16, color=(row.waiting ? "light-dark(#71717b, #818181)" : prStateTone(row.state)))
      button id=`linked-pr-open-${row.number}` press=open pointerdown=down pointerup=up pan=drag panrelease=drop cursor="pointer" padding=0 border-width=0 background-color="#00000000" align-items="stretch" text-align="left" flex=1 min-width=0 display="flex" flex-direction="column" testId=`linked-pr-open-${row.number}`
        row min-width=0 align-items="center" gap="0.375rem"
          text `#${row.number}` flex-shrink=0 font-family="ui-monospace" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" aria-label=row.sourceLabel
          text row.title min-width=0 font-size="0.875rem" line-height="1.25rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#262626, #f5f5f5)"
          if row.open and (row.watching or row.checks != "" or row.review != "")
            row flex-shrink=0 align-items="center" gap="0.25rem"
              if row.watching
                box width="0.875rem" height="0.875rem" aria-label="Watching" testId=`linked-pr-watching-${row.number}`
                  PanelIcon(name="eye", size=14, color="light-dark(#27272a, #f5f5f5)")
              if row.checks != ""
                box width="0.875rem" height="0.875rem" aria-label=row.checksLabel
                  PgIcon(name=prChecksIcon(row.checks), size=14, color=prChecksTone(row.checks))
              if row.review != ""
                box width="0.875rem" height="0.875rem" aria-label=row.reviewLabel
                  PgIcon(name=prReviewIcon(row.review), size=14, color=prReviewTone(row.review))
          box flex=1 min-width=0
          if row.additions != ""
            row flex-shrink=0 align-items="baseline" gap="0.25rem"
              text row.additions font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#009966, #00d492)"
              text row.deletions font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#fb2c36, #fb414a)"
        row min-width=0 height="1rem" align-items="center" gap="0.375rem" overflow="hidden"
          if row.stackSize > 0
            row flex-shrink=0 align-items="center" gap="0.125rem" aria-label=row.stackLabel
              PanelIcon(name="layers", size=12, color="light-dark(#27272ab3, #f5f5f5b3)")
              text `${row.stackSize}` font-size="0.6875rem" line-height="1rem" color="light-dark(#27272ab3, #f5f5f5b3)"
          if row.author != ""
            row flex-shrink=0 align-items="center" gap="0.25rem" max-width="8rem"
              PrAvatar(avatar=row.avatar, initial=row.initial, size=14)
              text row.author min-width=0 font-size="0.6875rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
          if row.waiting
            text `${row.host}/${row.repository}` min-width=0 font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.19 line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
          else
            text row.repository max-width="8rem" min-width=0 flex-shrink=1 font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
            row min-width=0 align-items="center" gap="0.25rem" flex-shrink=1
              text row.head min-width=0 font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
              text "→" flex-shrink=0 font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              text row.base min-width=0 flex-shrink=0 font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" white-space="nowrap" color="light-dark(#71717b, #818181)"
          box flex=1 min-width=0
          if row.age != ""
            text row.age flex-shrink=0 font-size="0.6875rem" line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      if row.speed.length > 0 and (speedMode or row.speedPending)
        PrQuickActions(actions=row.speed, number=row.number, pending=row.speedPending, act=quick, sweepDown=ignoreDown, sweepMove=ignoreMove, sweepUp=ignoreMove)
      row position="absolute" right=0 bottom="0.125rem" opacity=(over or menuOpen ? 1 : 0) padding-left="1.25rem" padding-right="0.25rem" align-items="center" border-radius="0.375rem" background-color="light-dark(#f7f7f8, #101010)"
        button id=`linked-pr-actions-${row.key}` popovertarget=`linked-pr-menu-${row.key}` key=menuKey aria-label=`Actions for #${row.number}` aria-haspopup="menu" aria-expanded=menuOpen testId=`linked-pr-actions-${row.number}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          PanelIcon(name="ellipsis", size=14, color="light-dark(#27272a, #f5f5f5)")
        // The row's MenuPopup (align end, side bottom): 4pt under "…", its right edge on the button's.
        column id=`linked-pr-menu-${row.key}` data-dialog-return="menu" focusin=dialogMenuEntered(`linked-pr-menu-${row.key}`, `linked-pr-actions-${row.key}`) toggle=toggled popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" min-width="10rem" testId=`linked-pr-menu-layer-${row.number}`
          if menuOpen
            LinkedPrMenu(row=row, menuId=`linked-pr-menu-${row.key}`, local=local, command=command, keyed=kmEndKeyed(menuEnd))


// The row's actions (Copy link, Open, Watch for changes / Stop watching, Unlink) in its popover.
component LinkedPrMenu
  props
    row: LinkedPrRow
    // The popover the rows close as they act.
    menuId: string
    local: action
    command: action
    keyed: number
  // menu-keys.contract: the link row is a MenuItem too, highlighted by its focus alone; the
  // pointer entering it focuses it (its door), and leaving it while it holds the focus hands the focus to the popup.
  state openLit = false
  action openLitHover(on: bool)
    if on
      focus("linked-pr-menu-open")
    else if openLit
      focus("linked-pr-menu-keys")
  action openLitFocus(on: bool)
    openLit = on
  action open(e: MouseEvent)
    local("surface-linked-pr-open", (e.metaKey or e.ctrlKey) ? "held" : "", row.url)
  view
    column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label=`Actions for #${row.number}` testId=`linked-pr-menu-${row.number}`
      KeyMenu(menuId="linked-pr-menu-keys", items=[KmItem(id="linked-pr-menu-copy", label="Copy link"), KmItem(id="linked-pr-menu-open", label="Open")].concat((row.canWatch ? [KmItem(id="linked-pr-menu-watch", label=(row.watching ? "Stop watching" : "Watch for changes"))] : []).concat([KmItem(id="linked-pr-menu-unlink", label=row.unlinkLabel)])), keyed=keyed, gap="0px", modal=true)
        PanelMenuItem(keysId="linked-pr-menu-keys", menuId=menuId, icon="link", label="Copy link", test="copy", press=local("surface-pr-copy", row.key, ""))
        button id="linked-pr-menu-open" press=open popovertarget=menuId popovertargetaction="hide" padding=0 border-width=0 hover=openLitHover focus=openLitFocus(true) blur=openLitFocus(false) cursor="pointer" role="menuitem" testId="linked-pr-menu-open" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" background-color=(openLit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
          PanelIcon(name="arrow-up-right", size=14, color="light-dark(#71717b, #818181)")
          text "Open" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        if row.canWatch
          PanelMenuItem(keysId="linked-pr-menu-keys", menuId=menuId, icon=(row.watching ? "eye-off" : "eye"), label=(row.watching ? "Stop watching" : "Watch for changes"), test="watch", press=command("shell:surface-pr-watch", row.key, (row.watching ? "false" : "true"), 0))
        PanelMenuItem(keysId="linked-pr-menu-keys", menuId=menuId, icon="unlink-2", label=row.unlinkLabel, test="unlink", press=command("shell:surface-pr-unlink", row.key, "", 0))

component PanelMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    menuId: string
    icon: string
    label: string
    test: string
    press: action
  state lit = false
  action hover(over: bool)
    if over
      focus(`linked-pr-menu-${test}`)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=`linked-pr-menu-${test}` press=press popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=`linked-pr-menu-${test}` width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 display="flex" flex-direction="row" align-items="center" background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") data-focus-stop="enabled"
      PanelIcon(name=icon, size=14, color="light-dark(#71717b, #818181)")
      text label flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// DevicePanel after onboarding: status, the simulators by platform and Refresh devices.
component DeviceSurfaceBody
  props
    device: DeviceSurface
    scheme: string
    local: action
    command: action
  view
    column flex=1 min-height=0 testId="device-surface"
      for notice in device.notices key=notice.id
        column margin="0.75rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" role=(notice.failed ? "alert" : "status")
          text notice.label font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
          text notice.detail font-size="0.75rem" line-height="1rem" white-space="pre-wrap" color="light-dark(#71717b, #818181)"
      // Status rows, then the opened device or its loading view (device-workspace.contract).
      DeviceStatus(view=device.session, local=local)
      if device.session.mode == "workspace"
        DeviceWorkspaceView(ws=device.session.workspace, local=local, command=command)
      if device.session.mode == "opening"
        DeviceLoading(name=device.session.openingName, description=device.session.openingDescription, message=device.session.openingMessage, stage="opening", error=false, reconnect=local("surface-session-menu", "", ""))
      if device.session.mode == "list"
        if device.panelStatus != ""
          column flex=1 align-items="center" justify-content="center" gap="0.5rem"
            PanelIcon(name="loader", size=20, color="light-dark(#71717b, #818181)")
            text device.panelStatus font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        else
          scroll flex=1 min-height=0
            column width="100%" max-width="36rem" padding-left="1.25rem" padding-right="1.25rem" padding-top="2rem" padding-bottom="2rem" gap="1.5rem" box-sizing="border-box" align-self="center"
              if device.empty != ""
                column align-items="center" gap="0.75rem"
                  PanelIcon(name="smartphone", size=24, color="light-dark(#71717b99, #81818199)")
                  text device.empty max-width="24rem" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
              for group in device.groups key=group.id
                column gap="0.75rem"
                  row gap="0.5rem" align-items="center"
                    PanelIcon(name="smartphone", size=16, color="light-dark(#71717b, #818181)")
                    text group.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#71717b, #818181)"
                  column border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" overflow="hidden"
                    for item in group.devices key=item.id
                      // The row opens (or starts) the device for this thread (device.open).
                      button press=command("shell:surface-session-open", item.id, "", 0) disabled=(device.session.pendingKey != "") testId=`device-row-${item.name}` width="100%" height="3.25rem" padding-left="0.75rem" padding-right="0.75rem" gap="0.75rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" border-width=0 border-radius=0 background-color="#00000000" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e766, #ffffff08)" aria-label=`${item.action} ${item.name}`
                        box width="2rem" height="2rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" display="flex" align-items="center" justify-content="center"
                          PanelIcon(name="smartphone", size=16, color="light-dark(#27272a, #f5f5f5)")
                        column flex=1 min-width=0
                          text item.name font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
                          text item.description font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
                        text item.action font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              if device.hint != ""
                text device.hint max-width="24rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              if device.refreshable
                button press=command("shell:surface-device-list", "", "", 0) testId="device-refresh" align-self=(device.groups.length > 0 ? "flex-start" : "center") height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=(device.groups.length > 0 ? 0 : 1) border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(device.groups.length > 0 ? "#00000000" : "light-dark(#ffffff, #ffffff08)")
                  text "Refresh devices" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// The "Set up devices" wizard (Dialog + WizardPopup max-w-xl, measured on the
// served reference): header 24/24/12 with the 20pt title, description and the
// three-step progress; the 20/24 panel on its tinted band; the 16/24 footer.
component DeviceSurfaceSetup
  props
    device: DeviceSurface
    scheme: string
    viewportHeight: number
    local: action
    command: action
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=45 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="device-setup-overlay"
      button press=local("surface-setup-close", "", "") aria-label="Close device setup" aria-keyshortcuts="Escape" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="device-setup-backdrop" title=""
      DeviceSurfaceDialog(device=device, viewportHeight=viewportHeight, local=local, command=command)

component DeviceSurfaceDialog
  inject
    dialogEntered: action
    dialogFallback: action
    rem: number
    wizardPanel: string
    wizardSteps: string
  props
    device: DeviceSurface
    viewportHeight: number
    local: action
    command: action
  derive dialogTargets = ["device-setup-step-0", "device-setup-close"]
  view
    column width="100%" max-width="36rem" max-height=(viewportHeight - 2 * rem) position="relative" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label="Set up devices" testId="device-setup" id="device-setup" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("device-setup") key=dialogFallback("device-setup", dialogTargets)
      // The focus trap (dialog-trap.contract): the steps, the panel, the footer, then the X.
      FocusGuard(guardId="device-setup-guard-start", targets=dialogTargets, popup="device-setup")
      DialogOpenFocus(target=(device.busy or device.pending != "" ? "device-setup-close" : "device-setup-step-0"))
      column padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" box-sizing="border-box" gap="0.5rem" flex-shrink=0
        text "Set up devices" font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        text "Review what runs on this environment before using simulators and emulators." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        row height="2.75rem" padding="0.25rem" gap="0.25rem" box-sizing="border-box" border-radius="0.875rem" border-style="solid" border-width=1 border-color="light-dark(#0000000d, #ffffff0d)" background-color=wizardSteps role="list" aria-label="Setup progress"
          DeviceWizardStep(number=0, title="Device hub", current=device.step, disabled=(device.busy or device.pending != ""), local=local)
          DeviceWizardStep(number=1, title="Simulators", current=device.step, disabled=(device.busy or device.pending != "" or device.step < 1), local=local)
          DeviceWizardStep(number=2, title="Agent access", current=device.step, disabled=(device.busy or device.pending != "" or device.step < 2), local=local)
      column flex-shrink=1 min-height=0 padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" box-sizing="border-box" gap="0.75rem" border-top-width=1 border-bottom-width=1 border-left-width=0 border-right-width=0 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color=wizardPanel testId="device-setup-panel"
        for notice in device.notices key=notice.id
          column padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" role=(notice.failed ? "alert" : "status")
            text notice.label font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
            text notice.detail font-size="0.75rem" line-height="1rem" white-space="pre-wrap" color="light-dark(#71717b, #818181)"
        if device.step == 0
          text "Enable the device hub" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          row gap="1rem" align-items="flex-start" justify-content="space-between"
            text "Enable this environment to open simulators and emulators, whether they run here or on a remote device host." flex=1 min-width=0 font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
            PvSwitch(checked=device.enabled, small=false, disabled=(device.busy or device.pending != ""), label="Enable device hub", test="device-hub-switch", toggle=command("shell:surface-device-hub", "", (device.enabled ? "false" : "true"), 0))
          if device.hubStatus != ""
            row gap="0.5rem" align-items="center" role="status"
              PanelIcon(name=(device.hubReady ? "check" : "loader"), size=12, color=(device.hubReady ? "light-dark(#00a63e, #05df72)" : "light-dark(#71717b, #818181)"))
              text device.hubStatus font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        // 1e2ecbd975 (5318d054a5): step 0 also checks simulator support when the hub is on
        // and a local host has no available platform (device-support.contract).
        if device.step == 1 or (device.step == 0 and device.enabled and device.localPlatformsUnavailable)
          SimulatorSupportSection(device=device, command=command)
        if device.step == 2
          text "Allow agent control" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          row gap="1rem" align-items="flex-start" justify-content="space-between"
            text "Allow new agent sessions in this environment to start and control local and remote devices, with required tools set up automatically." flex=1 min-width=0 font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
            PvSwitch(checked=device.agentEnabled, small=false, disabled=(not device.enabled or device.busy or device.pending != ""), label="Allow agents to control devices", test="device-agent-switch", toggle=command("shell:surface-device-agent", "", (device.agentEnabled ? "false" : "true"), 0))
          if device.agentStatus != ""
            row gap="0.5rem" align-items="center" role="status"
              PanelIcon(name=(device.agentReady ? "check" : "loader"), size=12, color=(device.agentReady ? "light-dark(#00a63e, #05df72)" : "light-dark(#71717b, #818181)"))
              text device.agentStatus font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          text "Leave this off to keep manual device controls without giving agents access." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        if device.failure != ""
          text device.failure margin-top="0.75rem" font-size="0.75rem" line-height="1rem" color="light-dark(#e40014, #ff6467)" role="alert"
      row height="4rem" flex-shrink=0 padding-left="1.5rem" padding-right="1.5rem" gap="0.5rem" box-sizing="border-box" align-items="center" justify-content="flex-end"
        if device.step == 0
          button press=local("surface-setup-close", "", "") testId="device-setup-cancel" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        else
          button press=local("surface-device-back", "", "") disabled=(device.busy or device.pending != "") testId="device-setup-back" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d"
            text "Back" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        if device.step < 2
          button press=local("surface-device-continue", "", "") disabled=(not device.canContinue) testId="device-setup-continue" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" opacity=(device.canContinue ? 1 : 0.64) box-shadow="0 1px 2px #0000000d"
            text "Continue" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        else
          button press=command("shell:surface-device-complete", "", "", 0) disabled=(not device.canContinue) testId="device-setup-done" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" opacity=(device.canContinue ? 1 : 0.64) box-shadow="0 1px 2px #0000000d"
            text device.doneLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
      button id="device-setup-close" press=local("surface-setup-close", "", "") aria-label="Close" testId="device-setup-close" position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
        PanelIcon(name="x", size=16, color="light-dark(#71717b, #818181)")
      FocusGuard(guardId="device-setup-guard-end", targets=dialogTargets, popup="device-setup")

// WizardSteps' cell: a 20pt numbered disc and the medium label; only earlier steps reopen.
component DeviceWizardStep
  props
    number: number
    title: string
    current: number
    disabled: bool
    local: action
  view
    // The dialog's first tabbable takes focus when it opens (Base UI Dialog), so Escape reaches the dialog, not the composer behind it.
    button id=`device-setup-step-${number}` press=local("surface-device-step", "", `${number}`) autofocus=(number == 0) disabled=disabled flex=1 min-width=0 height="2.25rem" box-sizing="border-box" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.5rem" padding-bottom="0.5rem" gap="0.5rem" border-radius="0.625rem" border-width=(current == number ? 1 : 0) border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" background-color=(current == number ? "light-dark(#ffffff, #111111)" : "#00000000") box-shadow=(current == number ? "0 1px 2px #0000000d" : "none") aria-label=`${title}, step ${number + 1}` testId=`device-step-${number}` data-focus-stop=(disabled ? "" : "enabled")
      box width="1.25rem" height="1.25rem" border-radius="624.9375rem" flex-shrink=0 display="flex" align-items="center" justify-content="center" box-sizing="border-box" border-style="solid" border-width=1 border-color=(current > number ? "light-dark(#1b4ed8, #346bf1)" : (current == number ? "light-dark(#1b4ed84d, #346bf14d)" : "light-dark(#0000001a, #ffffff1a)")) background-color=(current > number ? "light-dark(#1b4ed8, #346bf1)" : (current == number ? "light-dark(#1d4ed81a, #316cf51a)" : "light-dark(#ffffff, #ffffff0d)"))
        if current > number
          PanelIcon(name="check", size=14, color="#ffffff")
        else
          text `${number + 1}` font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(current == number ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b, #818181)")
      text title font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(current == number ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
