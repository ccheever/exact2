// Adapted from T3 Code 7c3b3b3605ef (MIT); see LICENSE-T3.
// Measured on the served reference (MIT, see LICENSE-T3):
// - DetailsPrRows: the details card's pull request rows under the branch select
//   (chat/ThreadDetailsPrRows.tsx, ThreadDetailsPrRow.tsx, ThreadDetailsControl
//   part "row"/"meta", threadDetailsPanelStyles.ts);
// - PrSurfaceBody: the right panel's "pull-request" surface, the Pull Requests
//   page's detail panel without its own tab bar (ChatView rightPanelContent:
//   PullRequestDetailPanel, PullRequestsUnavailableState);
// - AttachmentBody: a sent attachment's preview (files/AttachmentFilePreview.tsx at 7c3b3b3605ef,
//   fileSurfaceChrome.tsx FILE_SURFACE_SUBHEADER_CLASS, FileSurfaceAction).
// `local` is the window's chatLocal (`surface-linked-*` reaches pr-attachment-surfaces.ts),
// `act` the card's detailsAct (gated writes as `shell:surface-linked-*`).
use DetailsPrRowList from "./pr-attachment-shapes.contract"
use DetailsPrRow from "./pr-attachment-shapes.contract"
use PrSurface from "./pr-attachment-shapes.contract"
use AttachmentSurface from "./pr-attachment-shapes.contract"
use AttachmentCodeLine from "./pr-attachment-shapes.contract"
use PrDetailView from "../pull-requests/pages-pr-detail.contract"
use PrdBody from "../pull-requests/pages-pr-detail.contract"
use prdTone from "../pull-requests/pages-pr-detail.contract"
use prdCheckIcon from "../pull-requests/pages-pr-detail.contract"
use prdCheckTone from "../pull-requests/pages-pr-detail.contract"
use ChatDocument from "../timeline/markdown.contract"
use DiagramBlocks from "../timeline/markdown.contract"
use synColor, synSlant, synWeight from "../highlight/syntax-ink.contract"
use PgIcon from "../shared/pages-icons.contract"
use ShellIcon from "../shell/shell-icons.contract"
use PanelIcon from "./panel-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use ChecksTrigger from "../details/pr-row.contract"
use ChecksPopover from "../details/pr-row.contract"
use hoverTipAtFrame, hoverTipWide from "../shell/hover-layer.contract"
use PrActionButton from "../details/pr-row.contract"
use AttachmentMediaBody from "../media/attachment-media.contract"
use FileSurfaceAction from "./file-surface-chrome.contract"
use PreviewImage from "./preview-image.contract"
use MermaidFileView from "./mermaid-file.contract"
use FontSpecimen from "./font-preview.contract"

fn surfaceMuted(): string = "light-dark(#71717b, #a1a1a1)"
fn surfaceRowInk(): string = "light-dark(#18181bcc, #f5f5f5cc)"
fn surfaceRowHover(): string = "light-dark(#0000000e, #ffffff13)"
fn prCheckStatus(rollup: string): string = rollup == "passing" ? "success" : rollup == "failing" ? "failure" : "pending"

// ThreadDetailsPrRows: the current pull request's row, then (with other links)
// "Show N more" and, expanded, one row per other link.
component DetailsPrRows
  inject
    frameMoved: action
  props
    prs: DetailsPrRowList
    act: action
    local: action
  state over = false
  action hover(value: bool)
    over = value
  view
    if prs.show
      for row in prs.rows key=row.key
        DetailsPrRowView(row=row, act=act, local=local)
      // The other links as one list (data-thread-details-pr-list): it scrolls with the card, so the
      // details card's density leaves its height out (thread-details-card-layout.ts).
      if prs.rest.length > 0
        column width="100%" id="frame-details-pr-list" resize=frameMoved
          for row in prs.rest key=row.key
            DetailsPrRowView(row=row, act=act, local=local)
      if prs.moreLabel != ""
        button press=local("surface-linked-pr-more", "", "") hover=hover aria-expanded=prs.expanded testId="details-pr-more" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.5rem" background-color=(over ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="center"
          // Chevrons, not plus and minus: the plus already means "add" in this card.
          SurfaceGlyph(name=(prs.expanded ? "chevron-up" : "chevron-down"), size=16, color=(over ? surfaceRowInk() : "light-dark(#71717b, #a1a1a1)"))
          text prs.moreLabel flex=1 min-width=0 text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color=(over ? surfaceRowInk() : "light-dark(#71717b, #a1a1a1)") text-box-trim="trim-both" text-box-edge="cap alphabetic"

// One row: the plain row (no host detail, or nothing to show under it), else two lines so the title keeps the
// whole row: the number, the checks and the next action sit underneath, aligned with the title text, and the block
// keeps 8pt below so stacked pull requests read as separate pairs. A link no project here can read stays an
// ordinary link.
component DetailsPrRowView
  inject
    hoverTipAt: action
  props
    row: DetailsPrRow
    act: action
    local: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
    // The card's split is read when the card is first pointed at (PullRequestChangeBreakdownRows reads on mount).
    if over and id == "row" and not row.extra.card.breakdown.requested
      local("surface-pr-breakdown", "card", row.extra.card.breakdown.ref)
    // The tooltip card: drawn by the window's hover layer above the link half (side top, start-aligned, or ending
    // where the link half ends when it would cross the window), so the details card around the row cannot clip it.
    if id == "row" and row.split and row.extra.card.show
      hoverTipAt(hoverTipWide(hoverTipAtFrame(`details-pr-card-${row.key}`, "pr-card", row.key, [], "top", (row.extra.card.flipped ? "end" : "start"), frame(`details-pr-open-${row.key}`), row.extra.card.height, "details-pr-card"), row.extra.card.width), "trigger", over)
  action open(e: MouseEvent)
    local("surface-linked-pr-open", (e.metaKey or e.ctrlKey) ? "held" : row.target, row.url)
  // onAuxClick: the middle button opens it in the browser when it goes down and comes up on the row.
  state middleDown = false
  action openDown(e: PointerEvent)
    middleDown = e.buttons == 4
  action openUp(e: PointerEvent)
    let box = frame(`details-pr-open-${row.key}`)
    if middleDown and e.clientX >= box.x and e.clientX <= box.x + box.width and e.clientY >= box.y and e.clientY <= box.y + box.height
      local("surface-linked-pr-open", "held", row.url)
    middleDown = false
  view
    box position="relative" width="100%"
      if not row.split and not row.watching
        button id=`details-pr-open-${row.key}` press=open pointerdown=openDown pointerup=openUp hover=hover("row") aria-label=row.aria testId=`details-pr-${row.key}` width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.5rem" background-color=(hovered == "row" ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="center"
          PgIcon(name=row.icon, size=16, color=(row.tinted ? prdTone(row.state) : surfaceMuted()))
          text row.label flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color=surfaceRowInk() text-box-trim="trim-both" text-box-edge="cap alphabetic"
        TipBubble(label=row.tooltip, side="top", align="center", offset=36, inset=0, shown=(hovered == "row"))
      else if row.split
        column width="100%" padding-bottom=(row.checks != "" or row.action != "" or row.watching ? "0.375rem" : "0px") box-sizing="border-box" testId=`details-pr-${row.key}`
          box position="relative" width="100%" display="flex"
            // With a second line the title wraps to two (ThreadDetailsPrRow openRow wrap: a conventional-commit prefix eats most of one).
            if row.checks != "" or row.action != "" or row.watching
              button id=`details-pr-open-${row.key}` press=open pointerdown=openDown pointerup=openUp hover=hover("row") aria-label=row.aria flex=1 min-width=0 min-height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.1875rem" padding-bottom="0.1875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.5rem" background-color=(hovered == "row" ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="flex-start"
                box flex-shrink=0 margin-top="0.125rem" display="flex"
                  PgIcon(name=row.icon, size=16, color=(row.tinted ? prdTone(row.state) : surfaceMuted()))
                text row.extra.card.title flex=1 min-width=0 line-clamp=2 text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.125rem" color=surfaceRowInk() testId=`details-pr-title-${row.key}`
            else
              button id=`details-pr-open-${row.key}` press=open pointerdown=openDown pointerup=openUp hover=hover("row") aria-label=row.aria flex=1 min-width=0 height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.5rem" background-color=(hovered == "row" ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="center"
                PgIcon(name=row.icon, size=16, color=(row.tinted ? prdTone(row.state) : surfaceMuted()))
                text row.label flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color=surfaceRowInk() text-box-trim="trim-both" text-box-edge="cap alphabetic" testId=`details-pr-title-${row.key}`
            if not row.extra.card.show
              TipBubble(label=row.tooltip, side="top", align="start", offset=36, inset=0, shown=(hovered == "row"))
          if row.checks != "" or row.action != "" or row.watching
            row width="100%" min-width=0 height="1.25rem" padding-left="2.25rem" padding-right="0.625rem" box-sizing="border-box" gap="0.125rem" align-items="center" testId=`details-pr-meta-${row.key}`
              text row.extra.card.number flex-shrink=0 margin-right="0.25rem" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color=surfaceMuted()
              if row.checks != ""
                box position="relative" flex-shrink=0 display="flex"
                  ChecksTrigger(row=row, hovered=(hovered == "checks"), hover=hover("checks"))
                  ChecksPopover(row=row, local=local)
              if row.watching
                PrWatchControl(row=row, secondary=false, over=(hovered == "watch"), hover=hover("watch"), act=act)
              box flex=1 min-width=0
              if row.action != ""
                box position="relative" flex-shrink=0 display="flex"
                  PrActionButton(row=row, hovered=(hovered == "action"), hover=hover("action"), act=act, local=local)
                  TipBubble(label=row.actionTooltip, side="top", align="end", offset=28, inset=0, shown=(hovered == "action"))
      else
        row width="100%" height="2rem" align-items="center" border-radius="0.5rem" background-color=(hovered != "" ? surfaceRowHover() : "#00000000") role="group" testId=`details-pr-${row.key}`
          box position="relative" flex=1 min-width=0 display="flex"
            button id=`details-pr-open-${row.key}` press=open pointerdown=openDown pointerup=openUp hover=hover("row") aria-label=row.aria flex=1 min-width=0 height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.5rem" border-top-right-radius=0 border-bottom-right-radius=0 background-color=(hovered == "row" ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="center"
              PgIcon(name=row.icon, size=16, color=(row.tinted ? prdTone(row.state) : surfaceMuted()))
              text row.label flex=1 min-width=0 white-space="nowrap" overflow-x="clip" overflow-y="visible" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color=surfaceRowInk() text-box-trim="trim-both" text-box-edge="cap alphabetic"
            TipBubble(label=row.tooltip, side="top", align="start", offset=36, inset=0, shown=(hovered == "row"))
          box width=1 height="1rem" flex-shrink=0 background-color=(hovered != "" ? "light-dark(#e4e4e7a6, #ffffff0d)" : "#00000000")
          PrWatchControl(row=row, secondary=true, over=(hovered == "watch"), hover=hover("watch"), act=act)

component PrWatchControl
  props
    row: DetailsPrRow
    secondary: bool
    over: bool
    hover: action
    act: action
  view
    box position="relative" flex-shrink=0 display="flex"
      button press=act("shell:surface-pr-watch", row.watchKey, "false") hover=hover aria-label=row.stopWatchLabel testId=`details-pr-watch-${row.key}` width=(secondary ? "2rem" : "1.5rem") height=(secondary ? "2rem" : "1.5rem") padding=0 flex-shrink=0 border-width=0 border-radius=(secondary ? "0.5rem" : "0.25rem") border-top-left-radius=(secondary ? "0px" : "0.25rem") border-bottom-left-radius=(secondary ? "0px" : "0.25rem") background-color=(over ? surfaceRowHover() : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
        PanelIcon(name=(over ? "eye-off" : "eye"), size=(secondary ? 16 : 14), color=surfaceRowInk())
      TipBubble(label="Watching: the agent wakes when checks finish, someone comments, or the branch conflicts. Click to stop.", side="top", align="end", offset=(secondary ? 36 : 28), inset=0, shown=over)

// The pull-request surface's body: the detail the window's `prDetail` read for
// this surface (pages-pr-detail.ts) — its ghost, its unavailable state, or the panel.
component PrSurfaceBody
  props
    pr: PrSurface
    detail: PrDetailView
    documents: ChatDocument[]
    scheme: string
    tab: string
    setTab: action
    reload: action
    act: action
    copy: action
    local: action
    still: bool
    compact: bool
    width: number
  // An editor's hold on Escape is the Pull Requests page's (PrPanel); this surface has no page Back.
  action bodyLocal(op: string, id: string, value: string)
    if op != "pr-escape-hold"
      local(op, id, value)
  view
    column flex=1 min-height=0 width="100%" testId="pull-request-surface"
      // Another surface's answer (the one resource read for a different reference) is not drawn here.
      if detail.ref != pr.selected
        box flex=1 width="100%"
      else
        for bodyRef in [detail.ref] key=bodyRef
          PrdBody(detail=detail, documents=documents, scheme=scheme, tab=tab, setTab=setTab, reload=reload, act=act, copy=copy, local=bodyLocal, still=still, select=local("pr-ui-select", ""), compact=compact, narrow=compact, width=width, scrollId="pr-surface-scroll")

// AttachmentFilePreview: "Attachment › name  size" with the icon actions, then the document.
component AttachmentBody
  props
    att: AttachmentSurface
    // app.contract's filesMarkdown, which parses the attachment as ChatMarkdown does.
    documents: ChatDocument[]
    scheme: string
    sheet: bool
    local: action
    // The header actions' element ids are `<actionIds>-<action>` in a dialog that moves the focus to them; "" elsewhere.
    actionIds: string
  view
    // AttachmentFilePreview paints bg-background over the panel (the sheet's own fill is white).
    column flex=1 min-height=0 width="100%" position="relative" overflow="hidden" background-color="light-dark(#fcfcfc, #000000)" testId="attachment-surface"
      AttachmentHeader(att=att, sheet=sheet, local=local, actionIds=actionIds)
      if att.truncatedNote != ""
        text att.truncatedNote flex-shrink=0 padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#fe9a0033, #fe9a0033)" background-color="light-dark(#fffbeb, #fe9a0014)" font-size="0.6875rem" line-height="1rem" color="light-dark(#bb4d00, #ffb900)" role="status"
      if att.preview == "loading"
        column flex=1 align-items="center" justify-content="center" role="status" aria-label="Loading file" testId="attachment-loading"
          PanelIcon(name="loader", size=24, color=surfaceMuted())
      if att.preview == "error"
        column flex=1 align-items="center" justify-content="center" gap="0.75rem" padding-left="1.5rem" padding-right="1.5rem" role="alert" testId="attachment-error"
          text att.error text-align="center" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#e40014, #ff6467)"
          button press=local("surface-linked-att-retry", att.id, "") testId="attachment-retry" padding-left="0.625rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="#00000000"
            text "Try again" font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
      if att.preview == "markdown"
        AttachmentMarkdown(att=att, documents=documents, scheme=scheme, local=local)
      if att.preview == "table"
        scroll flex=1 min-height=0 width="100%" testId="attachment-table"
          column min-width="100%"
            for row in att.table key=row.id
              row min-width="100%" background-color=(row.header ? "light-dark(#f4f4f520, #ffffff0a)" : "#00000000")
                for cell in row.cells key=cell.id
                  text cell.text flex=1 max-width="20rem" min-width="4rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color=(row.header ? "light-dark(#e4e4e7, #ffffff14)" : "light-dark(#e4e4e799, #ffffff0c)") white-space="pre-wrap" font-size="0.75rem" line-height="1rem" font-weight=(row.header ? 500 : 400) font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)"
      if att.preview == "code"
        scroll flex=1 min-height=0 width="100%" testId="attachment-code"
          column width=(att.wrap ? "100%" : "auto") min-width="100%" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" background-color="light-dark(#ffffff, #111111)" role="code" aria-label=att.name
            for line in att.lines key=line.id
              AttachmentCodeRow(line=line, gutter=att.gutter, wrap=att.wrap)
      if att.preview == "mermaid"
        MermaidFileView(diagrams=att.diagrams, note=att.mermaidNote, scheme=scheme, local=local, testId="attachment-mermaid")
      // The picture's error is the surface's ("Unable to load image." with Try again).
      if att.preview == "image"
        for url in [att.url] key=url
          PreviewImage(url=url, name=att.name, zoomId=(actionIds != "" ? `${actionIds}-image-zoom` : "attachment-image-zoom"), expand=local("surface-linked-att-image-open", att.id, ""), failed=local("surface-linked-att-media-error", att.id), testId="attachment-image")
      if att.preview == "font"
        FontSpecimen(src=att.url, name=att.name, scheme=scheme, failed=local("surface-linked-att-font-failed", att.id, ""), testId="attachment-font")
      // PDF, rendered HTML, audio and video (attachment-media.contract).
      if att.preview == "pdf" or att.preview == "html" or att.preview == "audio" or att.preview == "video"
        AttachmentMediaBody(att=att, local=local)
      if att.preview == "none"
        column flex=1 min-height=0 align-items="center" justify-content="center" gap="0.25rem" padding-left="1.5rem" padding-right="1.5rem" box-sizing="border-box" role=(att.noPreviewAlert ? "alert" : "") testId="attachment-no-preview"
          text "No preview for this file" text-align="center" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
          text att.noPreview max-width="24rem" text-align="center" font-size="0.75rem" line-height="1.21875rem" color=surfaceMuted()

// AttachmentFilePreview: <ChatMarkdown text cwd={undefined} className="mx-auto max-w-4xl px-6 py-5" /> in a ScrollArea, the
// chat renderer Files' rendered file uses (FilePreview), with no folder (attachment-surface.ts renderedAttachment).
component AttachmentMarkdown
  props
    att: AttachmentSurface
    documents: ChatDocument[]
    scheme: string
    local: action
  action noCite(blockId: string, runId: string, s: Selection)
    let ignored = blockId
  view
    scroll flex=1 min-height=0 width="100%" testId="attachment-markdown"
      column width="100%" max-width="56rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" box-sizing="border-box" align-self="center"
        for document in documents.filter((entry) => entry.id == `attachment:${att.id}`) key=document.id
          DiagramBlocks(document=document, local=local, code=att.code, diagrams=att.diagrams, prose="light-dark(#18181bcc, #f5f5f5cc)", fit=false, scheme=scheme, copiedText=att.codeCopied, copiedNonce=att.codeCopyNonce, env=att.md, urls=att.mdUrls, source="", cite=noCite, markStart=-1, markEnd=-1)

component AttachmentHeader
  props
    att: AttachmentSurface
    sheet: bool
    local: action
    actionIds: string
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    // FILE_SURFACE_SUBHEADER_CLASS: 28pt with 12pt below in the inline panel; 40pt over a hairline in a sheet.
    row height=(sheet ? "2.5rem" : "1.75rem") flex-shrink=0 margin-bottom=(sheet ? "0px" : "0.75rem") padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" gap="0.5rem" align-items="center" position="relative" z-index=5 border-bottom-width=(sheet ? 1 : 0) border-bottom-style="solid" border-color="light-dark(#0000001b, #ffffff1f)" testId="attachment-subheader"
      row flex=1 min-width=0 align-items="center" overflow="hidden"
        text att.origin flex-shrink=0 padding-left="0.125rem" padding-right="0.125rem" font-size="0.75rem" line-height="1rem" white-space="nowrap" color=surfaceMuted()
        box margin-left="0.25rem" margin-right="0.25rem" flex-shrink=0 display="flex"
          ShellIcon(name="chevron-right", size=14, color="light-dark(#71717b99, #a1a1a199)")
        text att.name min-width=0 padding-left="0.125rem" padding-right="0.125rem" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#18181b, #f5f5f5)" testId="attachment-name"
        if att.size != ""
          text att.size margin-left="0.5rem" flex-shrink=0 font-size="0.75rem" line-height="1rem" white-space="nowrap" color=surfaceMuted() testId="attachment-size"
      if att.canRender
        FileSurfaceAction(id="render", ids=actionIds, label=att.renderLabel, icon=att.renderIcon, toggle=true, pressed=att.rendered, disabled=false, hovered=hovered, hover=hover, press=local("surface-linked-att-render", att.id, ""))
      if att.showWrap
        FileSurfaceAction(id="wrap", ids=actionIds, label=(att.wrap ? "Disable word wrap" : "Enable word wrap"), icon="wrap-text", toggle=true, pressed=att.wrap, disabled=false, hovered=hovered, hover=hover, press=local("surface-linked-att-wrap", att.id, ""))
      if att.canCopy
        FileSurfaceAction(id="copy", ids=actionIds, label=att.copyLabel, icon=(att.copied ? "check" : "copy"), toggle=false, pressed=false, disabled=false, hovered=hovered, hover=hover, press=local("surface-linked-att-copy", att.id, ""))
      if att.canSave
        FileSurfaceAction(id="save", ids=actionIds, label=att.saveLabel, icon="download", toggle=false, pressed=false, disabled=att.saving, hovered=hovered, hover=hover, press=local("surface-linked-att-save", att.id, ""))
      if att.canRemove
        FileSurfaceAction(id="remove", ids=actionIds, label="Remove from draft", icon="trash", toggle=false, pressed=false, disabled=false, hovered=hovered, hover=hover, press=local("surface-linked-att-remove", att.id, ""))
      if att.canClose
        FileSurfaceAction(id="close", ids=actionIds, label="Close", icon="x", toggle=false, pressed=false, disabled=false, hovered=hovered, hover=hover, press=local("surface-linked-att-close", att.id, ""))

component AttachmentCodeRow
  props
    line: AttachmentCodeLine
    gutter: number
    wrap: bool
  view
    row width="100%" align-items="flex-start"
      text line.number width=gutter flex-shrink=0 padding-right="0.614375rem" box-sizing="border-box" text-align="right" font-family="ui-monospace" font-size="0.8125rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#565656, #9d9d9d)" text-box-trim="trim-both" text-box-edge="cap alphabetic"
      text flex=1 min-width=0 padding-left="0.4875rem" padding-right="0.4875rem" box-sizing="border-box" font-family="ui-monospace" font-size="0.8125rem" line-height="1.25rem" white-space=(wrap ? "pre-wrap" : "pre") overflow-wrap=(wrap ? "break-word" : "normal") color="light-dark(#0a0a0a, #fafafa)" text-box-trim="trim-both" text-box-edge="cap alphabetic"
        for run in line.runs key=run.id
          text run.text color=synColor(run.syntax) font-style=synSlant(run.syntax) font-weight=synWeight(run.syntax)

// The Show more chevrons from the shell set (the pull request icon set has no chevron-up), else the pages glyphs.
component SurfaceGlyph
  props
    name: string
    size: number
    color: string
  view
    if name == "chevron-up" or name == "chevron-down"
      ShellIcon(name=name, size=size, color=color)
    else
      PgIcon(name=name, size=size, color=color)
