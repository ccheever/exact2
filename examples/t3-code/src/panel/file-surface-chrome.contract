// The file surfaces' shared chrome (MIT reference, see LICENSE-T3: components/files/fileSurfaceChrome.tsx; T3 Code
// 7c3b3b3605ef): FileSurfaceAction, the subheader's and the image bar's 28pt icon button, and FileSurfaceFailure, a
// body's error with Try again.
use ShellIcon from "../shell/shell-icons.contract"
use PanelIcon from "./panel-icons.contract"
use TipBubble from "../shell/shell-tip.contract"

// FileSurfaceAction: 28pt; a toggle wears the accent fill when pressed, a command is a ghost icon button.
component FileSurfaceAction
  props
    id: string
    ids: string
    label: string
    icon: string
    toggle: bool
    pressed: bool
    disabled: bool
    hovered: string
    hover: action
    press: action
  view
    box position="relative" flex-shrink=0
      button id=(ids != "" ? `${ids}-${id}` : "") press=press hover=hover(id) disabled=disabled aria-label=label aria-keyshortcuts=(ids != "" and id == "close" ? "Escape" : "") testId=`attachment-action-${id}` data-focus-stop=(ids != "" and not disabled ? "enabled" : "") width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(pressed ? "light-dark(#f4f4f5, #ffffff0f)" : hovered == id ? "light-dark(#f4f4f599, #ffffff0a)" : "#00000000") title=""
        if icon == "copy" or icon == "download" or icon == "check" or icon == "trash"
          ShellIcon(name=icon, size=14, color=(pressed ? "light-dark(#18181b, #fafafa)" : "light-dark(#71717b, #a1a1aa)"))
        else
          PanelIcon(name=icon, size=14, color=(pressed ? "light-dark(#18181b, #fafafa)" : "light-dark(#71717b, #a1a1aa)"))
      TipBubble(label=label, side="bottom", align="end", offset=32, inset=0, shown=(hovered == id))

// FileSurfaceFailure: the message in the destructive ink, with Try again when the body can load again.
component FileSurfaceFailure
  props
    message: string
    canRetry: bool
    retry: action
    testId: string
  view
    column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" gap="0.75rem" padding-left="1.5rem" padding-right="1.5rem" box-sizing="border-box" role="alert" testId=testId
      text message text-align="center" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#e40014, #ff6467)"
      if canRetry
        button press=retry testId=`${testId}-retry` padding-left="0.625rem" padding-right="0.625rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="#00000000"
          text "Try again" font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
