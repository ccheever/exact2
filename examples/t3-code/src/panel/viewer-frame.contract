// The document viewers' page (file-preview-host/src/entry.ts, built into assets/file-preview/) as an LLP 1020.001
// bundled page in an `iframe`, framed by the attachment body and Files for a PDF, text past 1 MB, a CSV or TSV table,
// an Office, OpenDocument, RTF, EPUB or notebook file, an archive or a database (viewer-frames.ts). The page fetches
// the file itself; the app tells it what to show by `postMessage` and hears it by `message`. The config goes again
// whenever it changes and whenever the page boots; TypeScript's posts (a draft's bytes, a pick) go one at a time once
// it has booted. A Select's popup (BinaryViewer's Table, OfficeViewer's Sheet and Chapter) is a menu-shaped popover at
// the trigger the page names, as the terminal page's menu is.
use ShellIcon from "../shell/shell-icons.contract"

shape ViewerPost
  key: string
  text: string
shape ViewerMenuRow
  id: string
  label: string
  selected: bool
shape ViewerMenu
  serial: number
  x: number
  y: number
  width: number
  height: number
  label: string
  rows: ViewerMenuRow[]
shape ViewerFrameView
  id: string
  src: string
  config: string
  posts: ViewerPost[]
  menu: ViewerMenu

component ViewerFrame
  props
    frame: ViewerFrameView
    scheme: string
    // The panel is a sheet (the attachment dialog), so a viewer's subheader rows are its 40pt ones.
    sheet: bool
    message: action // (payload) every message the page posts
    posted: action // (key) the page took a post
    pick: action // (`<serial>|<row>`) a menu row was chosen
    label: string
    testId: string
  state boots = 0
  derive config = frame.config == "" ? "" : `${frame.config.slice(0, frame.config.length - 1)},"scheme":"${scheme == "dark" ? "dark" : "light"}","sheet":${sheet}}`
  derive menuId = `${frame.id}-menu`
  derive anchorId = `${frame.id}-anchor`
  action received(payload: string)
    if payload == "{\"type\":\"boot\"}"
      boots = boots + 1
    message(payload)
  view
    // The surface's own fill, so nothing shows through before the page has drawn.
    box flex=1 min-width=0 min-height=0 position="relative" overflow="hidden" background-color="light-dark(#fcfcfc, #000000)"
      // WebKit suspends an unpartitioned frame's page once its window has been covered for about 4 minutes, or never
      // shown for about 8 s, so a file would wait for the window to load, index and draw; the reference's page keeps
      // running (LLP 1020.002, "A hidden window's sockets"), as the terminal page does.
      iframe id=frame.id src=frame.src message=received color-scheme=scheme aria-label=label testId=testId apple.inactiveSchedulingPolicy="throttle" position="absolute" left=0 top=0 width="100%" height="100%" border-width=0
      if boots > 0 and config != ""
        for key in [`${boots}|${config}`] key=key
          ViewerPostOnce(text=config, target=frame.id)
        for post in frame.posts key=post.key
          ViewerPostAck(post=post, target=frame.id, posted=posted)
      box id=anchorId position="absolute" left=frame.menu.x top=(frame.menu.y + frame.menu.height + 4) width=(frame.menu.width > 0 ? frame.menu.width : 1) height=1 pointer-events="none" aria-hidden=true
      // SelectPopup: the rows, the chosen one checked, at least as wide as its trigger.
      column id=menuId popover="auto" position-try-fallbacks="none" role="menu" aria-label=frame.menu.label min-width=(frame.menu.width > 0 ? frame.menu.width : 160) max-height="20rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" overflow-y="auto" testId=`${testId}-menu`
        for row in frame.menu.rows key=row.id
          button press=pick(`${frame.menu.serial}|${row.id}`) popovertarget=menuId popovertargetaction="hide" role="menuitemradio" aria-checked=row.selected testId=`${testId}-menu-${row.id}` width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            text row.label flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
            if row.selected
              ShellIcon(name="check", size=14, color="light-dark(#18181b, #f5f5f5)")
      for serial in (frame.menu.rows.length > 0 ? [frame.menu.serial] : []) key=serial
        ViewerMenuOpen(menuId=menuId, anchorId=anchorId)

// Posts `text` to the frame once, as it mounts (keyed by what it posts).
component ViewerPostOnce
  props
    text: string
    target: string
  state sent = false
  action laidOut(width: number, height: number)
    if not sent
      sent = true
      postMessage(text, target)
  view
    box width=1 height=1 position="absolute" opacity=0 pointer-events="none" aria-hidden=true resize=laidOut

// One of TypeScript's posts, posted once and acknowledged, so the next one can follow.
component ViewerPostAck
  props
    post: ViewerPost
    target: string
    posted: action
  state sent = false
  action laidOut(width: number, height: number)
    if not sent
      sent = true
      postMessage(post.text, target)
      posted(post.key)
  view
    box width=1 height=1 position="absolute" opacity=0 pointer-events="none" aria-hidden=true resize=laidOut

component ViewerMenuOpen
  props
    menuId: string
    anchorId: string
  state sent = false
  action laidOut(width: number, height: number)
    if not sent
      sent = true
      showPopover(menuId, source=anchorId)
  view
    box width=1 height=1 position="absolute" opacity=0 pointer-events="none" aria-hidden=true resize=laidOut
