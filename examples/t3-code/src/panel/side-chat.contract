// A side chat tab (T3 Code 2359643cff, MIT, see LICENSE-T3: components/chat/SideChatPane.tsx): a 36pt header with the
// side chat's title, Bring back (ghost xs, aria-disabled with its reason as the tooltip), Delete and Close (icon-xs), over
// the side chat's conversation (side-chat.ts sideChatView): "Context from" its parent, its own messages, its pending
// requests and a field that sends to it.
use SideChatPane from "./panel-shapes.contract"
use SideChatRow from "./panel-shapes.contract"
use SideChatRequest from "./panel-shapes.contract"
use ChatDocument from "../timeline/markdown.contract"
use ChatMarkdown from "../timeline/markdown.contract"
use MarkdownEnv from "../timeline/markdown.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"

component SideChatBody
  props
    view: SideChatPane
    // app.contract's filesMarkdown: each message's document, `side-chat:<thread>:<row>`.
    documents: ChatDocument[]
    local: action
    command: action
    confirm: action
    still: bool // prefers-reduced-motion: the working dot stays still
  state hovered = ""
  state text = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action bringBack
    if not view.bringBackDisabled
      command("shell:surface-side-chat-bring-back", view.threadId, "", 0)
  action remove
    if view.confirmDelete
      confirm("ui:confirm:side-chat-delete", view.threadId, "shell:surface-side-chat-delete", view.deleteTitle, view.deleteBody, true)
    else
      command("shell:surface-side-chat-delete", view.threadId, "", 0)
  action edit(value: string)
    text = value
  action send
    if view.canSend and text.trim() != ""
      command("shell:surface-side-chat-send", view.threadId, text, 0)
      text = ""
  // ChatComposer's Enter sends; Shift+Enter keeps the newline.
  action keys(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey and not e.altKey and not e.isComposing
      preventDefault()
      send()
  view
    column flex=1 min-height=0 width="100%" testId="side-chat-pane"
      row height="2.25rem" flex-shrink=0 padding-left="0.75rem" padding-right="0.25rem" box-sizing="border-box" gap="0.25rem" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)"
        text view.title flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" testId="side-chat-title"
        box position="relative" flex-shrink=0 hover=hover("bring-back")
          button press=bringBack aria-disabled=view.bringBackDisabled testId="side-chat-bring-back" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(view.bringBackDisabled ? 0.64 : 1) background-color=(hovered == "bring-back" and not view.bringBackDisabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" title=""
            text "Bring back" white-space="nowrap" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
          TipBubble(label=view.bringBackTip, side="bottom", align="center", offset=32, inset=0, shown=(hovered == "bring-back"))
        button id="side-chat-delete" press=remove hover=hover("delete") disabled=view.deleteDisabled aria-label="Delete side chat" testId="side-chat-delete" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.375rem" opacity=(view.deleteDisabled ? 0.64 : 1) background-color=(hovered == "delete" and not view.deleteDisabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          ShellIcon(name="trash", size=14, color="light-dark(#18181b, #f5f5f5)")
        button press=local("surface-close", `side-chat:${view.threadId}`, "") hover=hover("close") aria-label="Close side chat" testId="side-chat-close" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.375rem" background-color=(hovered == "close" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          ShellIcon(name="x", size=14, color="light-dark(#18181b, #f5f5f5)")
      if view.deleted
        text "This side chat was deleted." padding="0.75rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId="side-chat-deleted"
      else
        scroll flex=1 min-height=0 width="100%" scrollFollowEnd=true testId="side-chat-transcript"
          column width="100%" padding="0.75rem" box-sizing="border-box" gap="0.75rem"
            // MessagesTimeline's parent link: a side chat's inherited rows collapse into it.
            row gap="0.375rem" align-items="center" testId="side-chat-context"
              ShellIcon(name="messages-square", size=12, color="light-dark(#71717b, #a1a1a1)")
              text "Context from" flex-shrink=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              text view.contextFrom min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181bcc, #f5f5f5cc)"
            for message in view.rows key=message.id
              SideChatMessage(message=message, threadId=view.threadId, documents=documents, local=local, env=view.md)
            for request in view.requests key=request.requestId
              SideChatRequestCard(request=request, threadId=view.threadId, enabled=view.canSend, command=command)
            if view.working
              row gap="0.375rem" align-items="center" testId="side-chat-working"
                box width="0.375rem" height="0.375rem" border-radius="0.1875rem" background-color="light-dark(#71717b, #a1a1a1)" animation=(still ? "none" : "sideChatPulse 1.2s ease-in-out infinite")
                text "Working…" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        column flex-shrink=0 padding="0.5rem" box-sizing="border-box"
          row gap="0.5rem" align-items="flex-end" padding="0.5rem" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)"
            textarea id=`side-chat-input-${view.threadId}` data-editable="yes" value=text input=edit key=keys disabled=(not view.canSend) rows=1 placeholder=view.placeholder aria-label="Message the side chat" autocorrect="off" testId="side-chat-input" flex=1 min-width=0 field-sizing="content" max-height="8rem" padding=0 border-width=0 box-sizing="border-box" background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" outline="none" resize="none"
            if view.working and text.trim() == ""
              button press=command("shell:surface-side-chat-stop", view.threadId, "", 0) aria-label="Stop" testId="side-chat-stop" width="1.75rem" height="1.75rem" padding=0 border-width=0 border-radius="0.875rem" background-color="light-dark(#18181b, #f5f5f5)" display="flex" align-items="center" justify-content="center" flex-shrink=0 title=""
                box width="0.625rem" height="0.625rem" border-radius="0.125rem" background-color="light-dark(#ffffff, #18181b)"
            else
              button press=send disabled=(not view.canSend or text.trim() == "") aria-label="Send" testId="side-chat-send" width="1.75rem" height="1.75rem" padding=0 border-width=0 border-radius="0.875rem" opacity=(view.canSend and text.trim() != "" ? 1 : 0.5) background-color="light-dark(#18181b, #f5f5f5)" display="flex" align-items="center" justify-content="center" flex-shrink=0 title=""
                ShellIcon(name="arrow-up", size=14, color="light-dark(#ffffff, #18181b)")

keyframes sideChatPulse
  from opacity=1
  50% opacity=0.4
  to opacity=1

// A user message in its bubble, an answer as chat Markdown, a failed turn in the destructive tone, a tool or thinking row
// as its muted title.
component SideChatMessage
  props
    message: SideChatRow
    threadId: string
    documents: ChatDocument[]
    local: action
    env: MarkdownEnv
  derive docId = `side-chat:${threadId}:${message.id}`
  view
    if message.kind == "user"
      column align-self="flex-end" max-width="85%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="0.75rem" background-color="light-dark(#f4f4f5, #ffffff0f)" testId=`side-chat-user-${message.id}`
        for document in documents.filter((entry) => entry.id == docId) key=document.id
          ChatMarkdown(document=document, local=local, code=[], env=env)
    else if message.kind == "assistant"
      column width="100%" testId=`side-chat-assistant-${message.id}`
        for document in documents.filter((entry) => entry.id == docId) key=document.id
          ChatMarkdown(document=document, local=local, code=[], env=env)
    else if message.kind == "error"
      text message.text font-size="0.75rem" line-height="1rem" color="light-dark(#c10007, #ff6467)"
    else
      text message.text white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"

// A pending approval with the decisions the provider offers, or the open question with its options (the field answers
// a question in words).
component SideChatRequestCard
  props
    request: SideChatRequest
    threadId: string
    enabled: bool
    command: action
  view
    column width="100%" padding="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" testId=`side-chat-request-${request.requestId}`
      text request.title font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
      if request.detail != ""
        text request.detail font-size="0.75rem" line-height="1rem" white-space="pre-wrap" color="light-dark(#71717b, #a1a1a1)"
      if request.choices.length > 0
        row gap="0.375rem" flex-wrap="wrap"
          for choice in request.choices key=choice.value
            button press=command("shell:surface-side-chat-answer", threadId, `${request.requestId}|${choice.value}`, 0) disabled=(not enabled) testId=`side-chat-choice-${choice.value}` height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff08)" display="flex" align-items="center"
              text choice.label white-space="nowrap" font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
