// The details card's pull request rows, the right panel's
// "pull-request" surface reference and a sent attachment's preview, as
// pr-surface.ts and attachment-surface.ts answer them.
use CodeHighlight from "../timeline/markdown.contract"
use MarkdownEnv from "../timeline/markdown.contract"
use MarkdownSource from "../timeline/markdown.contract"
use MermaidDiagram from "../timeline/mermaid-frame.contract"
use AttachmentUrl from "../timeline/timeline-attachments.contract"
use PrRowExtra from "../details/pr-row-shapes.contract"
use MergeAsk from "../details/pr-row-shapes.contract"
use ViewerFrameView from "./viewer-frame.contract"

shape AttachmentCodeRun
  id: string
  text: string
  syntax: string
shape AttachmentCodeLine
  id: string
  number: string
  runs: AttachmentCodeRun[]
shape AttachmentTableRow
  id: string
  header: bool
  cells: AttachmentCodeRun[]
shape DetailsPrRow
  key: string
  label: string
  tooltip: string
  icon: string
  state: string
  tinted: bool
  target: string
  url: string
  aria: string
  split: bool
  checks: string
  checksCount: string
  checksAria: string
  action: string
  actionTarget: string
  actionLabel: string
  actionTooltip: string
  actionDisabled: bool
  extra: PrRowExtra
  watching: bool
  watchKey: string
  stopWatchLabel: string
shape DetailsPrRowList
  show: bool
  rows: DetailsPrRow[]
  rest: DetailsPrRow[]
  moreLabel: string
  expanded: bool
  merge: MergeAsk
  // The row's checks timer (usePullRequestChecksRefresh): "pending" (45 s), "settled" (60 s) or "" (off), and the pull
  // request it runs for.
  checksPoll: string
  checksKey: string
shape PrSurface
  selected: string
  number: number
  label: string
  surface: string
  tab: string
shape AttachmentSurface
  id: string
  // The first crumb: "Attachment", or "Draft" for a composer file chip's preview, which also has Remove from draft and Close.
  origin: string
  canRemove: bool
  canClose: bool
  name: string
  size: string
  preview: string
  error: string
  canRender: bool
  rendered: bool
  renderLabel: string
  renderIcon: string
  showWrap: bool
  wrap: bool
  canCopy: bool
  copyLabel: string
  copied: bool
  canSave: bool
  saving: bool
  saveLabel: string
  truncatedNote: string
  lines: AttachmentCodeLine[]
  gutter: number
  url: string
  noPreview: string
  // The rendered Markdown is ChatMarkdown, as Files' (FilesView): app.contract's filesMarkdown
  // answers markdownSource (kind "attachment"); md, code, diagrams, mdUrls and Copy code's check as the transcript's.
  markdownSource: MarkdownSource[]
  md: MarkdownEnv
  code: CodeHighlight[]
  diagrams: MermaidDiagram[]
  mdUrls: AttachmentUrl[]
  codeCopied: string
  codeCopyNonce: number
  // A Mermaid file's refusal (MermaidViewer), drawn instead of its diagram.
  mermaidNote: string
  // "No preview for this file" reports a failure: a font that did not load.
  noPreviewAlert: bool
  // The viewer page (viewer-frame.contract) for a PDF, text past 1 MB, a table, a document, an archive or a database;
  // an archive entry it opened, drawn under its bar; a notebook's cells it parsed (notebook-preview.contract).
  viewer: ViewerFrameView
  entry: ArchiveEntry
  notebook: NotebookPreviewView
// BinaryViewer ArchiveFile: an opened entry's source lines, its picture, or why it cannot open (notebook-preview.ts).
shape ArchiveEntry
  open: bool
  path: string
  preview: string
  lines: AttachmentCodeLine[]
  gutter: number
  url: string
  message: string
  truncatedNote: string
shape NotebookOutput
  id: string
  kind: string
  text: string
  url: string
  frame: ViewerFrameView
  height: number
shape NotebookCell
  id: string
  label: string
  aria: string
  // The markdown cell's document id in the preview's parse; "" for a source cell.
  document: string
  lines: AttachmentCodeLine[]
  gutter: number
  sourceHeight: number
  outputs: NotebookOutput[]
shape NotebookPreviewView
  open: bool
  status: string
  cells: NotebookCell[]
  empty: bool
  more: string
// A composer file chip's preview (composer-chip-file.ts): open while its draft file is in the open draft.
shape ComposerFilePreview
  open: bool
  file: AttachmentSurface
