// The expanded video previews' player (MediaVideoPlayer `<video controls autoplay>`, T3 Code 2359643cff, MIT; see
// LICENSE-T3), with the controls Chromium draws for it (BSD, The Chromium Authors: Blink's modern media controls, as
// Electron 44.10 ships them) over a `video` without the platform's: AVKit's control set reads to VoiceOver as some
// twenty items of the dialog, where Chromium's reads as the one video group. The group holds play or pause, the time,
// mute, full screen, the overflow menu (Download, Playback speed, Picture in Picture) and the scrubber, labelled with
// Blink's accessible names ("play", "video time scrubber", …), and shows them while the pointer is over the player or
// it is paused. Full screen is HTML's `requestFullscreen`, which the macOS host does not present yet
// (clone/issues/match1102-media-video-fullscreen.md).

// m:ss, or h:mm:ss from an hour (MediaControlsImpl's FormatTime).
fn clockText(seconds: number): string = seconds >= 3600 ? `${floor(seconds / 3600)}:${floor(seconds % 3600 / 60) < 10 ? "0" : ""}${floor(seconds % 3600 / 60)}:${floor(seconds % 60) < 10 ? "0" : ""}${floor(seconds % 60)}` : `${floor(seconds / 60)}:${floor(seconds % 60) < 10 ? "0" : ""}${floor(seconds % 60)}`
// The playback speed menu's rows (MediaControlPlaybackSpeedListElement).
fn speedLabel(rate: number): string = rate == 1 ? "Normal" : `${rate}`

component PreviewPlayer
  inject
    interacted: action
  props
    src: string
    name: string
    // The player's box; 0 for the video's own size, up to the two maxima.
    width: number
    height: number
    maxWidth: number
    maxHeight: number
    radius: string
    playerId: string
    testId: string
    // The player's onError (MediaVideoPlayer failedSrc).
    broke: action
    // The overflow menu's Download: the file saved where the person chooses.
    download: action
  state paused = false
  state muted = false
  state rate = 1
  state now = 0
  state duration = 0
  state full = false
  state hovering = false
  state scrubbing = false
  state scrubWidth = 0
  // The overflow menu: "", "main" or "speed".
  state menu = ""
  derive shown = paused or scrubbing or hovering or menu != ""
  derive progress = duration > 0 ? min(1, now / duration) : 0
  derive speeds = [0.25, 0.5, 0.75, 1, 1.25, 1.5, 1.75, 2]
  action timed(seconds: number)
    if not scrubbing
      now = seconds
  action measured(seconds: number)
    duration = seconds
  action started
    paused = false
  action stopped
    paused = true
  // A press on the picture plays or pauses, as Chromium's does, or closes the open menu.
  action picture
    if menu != ""
      menu = ""
    else
      paused = not paused
  action toggle
    paused = not paused
  action toggleMute
    muted = not muted
  action hover(on: bool)
    hovering = on
  action seek(seconds: number)
    now = max(0, min(duration, seconds))
    fastSeek(playerId, now)
  action fullscreen
    menu = ""
    requestFullscreen(playerId)
  action fullscreenChanged(on: bool)
    full = on
  action openMenu
    menu = menu == "" ? "main" : ""
    if menu == "main"
      focus(`${playerId}-menu-download`)
  action speedMenu
    menu = "speed"
    focus(`${playerId}-speed-${rate}`)
  action pickSpeed(value: number)
    rate = value
    menu = ""
    focus(`${playerId}-overflow`)
  action save
    menu = ""
    download()
  action pictureInPicture
    menu = ""
    requestPictureInPicture(playerId)
  action menuKey(key: string)
    if key == "Escape"
      menu = ""
      focus(`${playerId}-overflow`)
      preventDefault()
      stopPropagation()
  action sized(w: number, h: number)
    let ignored = h
    scrubWidth = w
  action scrubDown(e: PointerEvent)
    scrubbing = true
    seek(duration * max(0, min(1, e.offsetX / max(1, scrubWidth))))
  action scrubMove(e: PointerEvent)
    interacted()
    if scrubbing
      seek(duration * max(0, min(1, e.offsetX / max(1, scrubWidth))))
  action scrubUp(e: PointerEvent)
    let ignored = e
    scrubbing = false
  // The scrubber's keys (MediaControlTimelineElement): Left and Right step 5 s, Home and End go to either end.
  action scrubKey(key: string)
    if key == "ArrowLeft" or key == "ArrowDown"
      seek(now - 5)
      preventDefault()
    else if key == "ArrowRight" or key == "ArrowUp"
      seek(now + 5)
      preventDefault()
    else if key == "Home"
      seek(0)
      preventDefault()
    else if key == "End"
      seek(duration)
      preventDefault()
  // K plays or pauses, M mutes, F takes full screen (MediaControlsImpl's keyboard shortcuts).
  action playerKey(key: string)
    if key == "k"
      toggle()
      preventDefault()
    else if key == "m"
      toggleMute()
      preventDefault()
    else if key == "f"
      fullscreen()
      preventDefault()
  view
    column role="group" aria-label=name position="relative" width=(width > 0 ? width : "auto") height=(height > 0 ? height : "auto") border-radius=radius overflow="hidden" background-color="#000000" hover=hover key=playerKey testId=testId
      video src controls=false autoplay=true playsinline=true preload="metadata" muted=muted paused=paused playbackRate=rate allowsPictureInPicturePlayback=true id=playerId aria-hidden=true play=started pause=stopped ended=stopped timeupdate=timed durationchange=measured fullscreenchange=fullscreenChanged error=broke width=(width > 0 ? "100%" : "auto") height=(height > 0 ? "100%" : "auto") max-width=maxWidth max-height=maxHeight object-fit="contain" display="block" testId=`${testId}-video`
      button press=picture tabindex=-1 aria-hidden=true position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" title=""
      column position="absolute" left=0 right=0 bottom=0 padding-top="2.75rem" opacity=(shown ? 1 : 0) transition="opacity 0.3s" background-image="linear-gradient(to top, #000000e6, #00000000)" pointer-events=(shown ? "auto" : "none") testId=`${testId}-controls`
        row align-items="center" height="2.25rem"
          PlayerButton(label=(paused ? "play" : "pause"), icon=(paused ? "M8 5v14l11-7z" : "M6 19h4V5H6v14zm8-14v14h4V5h-4z"), press=toggle, elementId="", testId=`${testId}-play`)
          text `${clockText(now)} / ${clockText(duration)}` aria-label=`elapsed time: ${clockText(now)}` font-size="0.875rem" line-height="1rem" color="#ffffff" white-space="nowrap" font-variant-numeric="tabular-nums" testId=`${testId}-time`
          box flex=1
          PlayerButton(label=(muted ? "unmute" : "mute"), icon=(muted ? "M16.5 12c0-1.77-1.02-3.29-2.5-4.03v2.21l2.45 2.45c.03-.2.05-.41.05-.63zm2.5 0c0 .94-.2 1.82-.54 2.64l1.51 1.51C20.63 14.91 21 13.5 21 12c0-4.28-2.99-7.86-7-8.77v2.06c2.89.86 5 3.54 5 6.71zM4.27 3 3 4.27 7.73 9H3v6h4l5 5v-6.73l4.25 4.25c-.67.52-1.42.93-2.25 1.18v2.06c1.38-.31 2.63-.95 3.69-1.81L19.73 21 21 19.73l-9-9L4.27 3zM12 4 9.91 6.09 12 8.18V4z" : "M3 9v6h4l5 5V4L7 9H3zm13.5 3c0-1.77-1.02-3.29-2.5-4.03v8.05c1.48-.73 2.5-2.25 2.5-4.02zM14 3.23v2.06c2.89.86 5 3.54 5 6.71s-2.11 5.85-5 6.71v2.06c4.01-.91 7-4.49 7-8.77s-2.99-7.86-7-8.77z"), press=toggleMute, elementId="", testId=`${testId}-mute`)
          PlayerButton(label=(full ? "exit full screen" : "enter full screen"), icon=(full ? "M5 16h3v3h2v-5H5v2zm3-8H5v2h5V5H8v3zm6 11h2v-3h3v-2h-5v5zm2-11V5h-2v5h5V8h-3z" : "M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"), press=fullscreen, elementId="", testId=`${testId}-fullscreen`)
          PlayerButton(label="show more media controls", icon="M12 8c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z", press=openMenu, elementId=`${playerId}-overflow`, testId=`${testId}-overflow`)
        // The scrubber: a 4 pt track 16 pt in from either side, the played part white (MediaControlTimelineElement).
        box role="slider" tabindex=0 aria-label="video time scrubber" aria-valuemin=0 aria-valuemax=round(duration) aria-valuenow=round(now) aria-valuetext=`${clockText(now)} / ${clockText(duration)}` key=scrubKey resize=sized pointerdown=scrubDown pointermove=scrubMove pointerup=scrubUp touch-action="none" cursor="pointer" height="1rem" margin="0 1rem 0.875rem" display="flex" align-items="center" testId=`${testId}-scrubber`
          box position="relative" width="100%" height="0.25rem" border-radius="0.125rem" background-color="#ffffffb3" pointer-events="none"
            box position="absolute" left=0 top=0 bottom=0 width=`${progress * 100}%` border-radius="0.125rem" background-color="#ffffff"
      // The overflow menu over the controls' right end (MediaControlOverflowMenuListElement), or its speed list.
      if menu != ""
        column role="menu" aria-label=(menu == "speed" ? "Playback speed" : "Options") key=menuKey position="absolute" right="0.25rem" bottom="1.75rem" width="12.5rem" max-height=`calc(100% - 2rem)` overflow="auto" padding="0.25rem 0" border-radius="0.25rem" background-color="#3c3c3c" box-shadow="0 1px 3px #0000004d" testId=`${testId}-menu`
          if menu == "main"
            PlayerMenuItem(label="Download", icon="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z", radio=false, checked=false, press=save, elementId=`${playerId}-menu-download`)
            PlayerMenuItem(label="Playback speed", icon="M13.05 9.79 10 7.5v9l3.05-2.29L16 12zM11 4.07V2.05c-2.01.2-3.84 1-5.32 2.21L7.1 5.69A7.941 7.941 0 0 1 11 4.07zM5.69 7.1 4.26 5.68A9.949 9.949 0 0 0 2.05 11h2.02c.18-1.46.76-2.79 1.62-3.9zM4.07 13H2.05c.2 2.01 1 3.84 2.21 5.32l1.43-1.43A7.868 7.868 0 0 1 4.07 13zm1.61 6.74A9.981 9.981 0 0 0 11 21.95v-2.02a7.941 7.941 0 0 1-3.9-1.62l-1.42 1.43zM22 12c0 5.16-3.92 9.42-8.95 9.95v-2.02C16.97 19.41 20 16.05 20 12s-3.03-7.41-6.95-7.93V2.05C18.08 2.58 22 6.84 22 12z", radio=false, checked=false, press=speedMenu, elementId=`${playerId}-menu-speed`)
            PlayerMenuItem(label="Picture in Picture", icon="M19 11h-8v6h8v-6zm4 8V4.98C23 3.88 22.1 3 21 3H3c-1.1 0-2 .88-2 1.98V19c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2zm-2 .02H3V4.97h18v14.05z", radio=false, checked=false, press=pictureInPicture, elementId=`${playerId}-menu-pip`)
          else
            PlayerMenuItem(label="Playback speed", icon="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z", radio=false, checked=false, press=openMenu, elementId=`${playerId}-speed-back`)
            for value in speeds key=value
              PlayerMenuItem(label=speedLabel(value), icon=(value == rate ? "M9 16.17 4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z" : ""), radio=true, checked=(value == rate), press=pickSpeed(value), elementId=`${playerId}-speed-${value}`)

// A control in the button row: 48 pt wide, its 20 pt glyph white.
component PlayerButton
  props
    label: string
    icon: string
    press: action
    elementId: string
    testId: string
  view
    button id=elementId press=press aria-label=label title="" width="3rem" height="2.25rem" flex-shrink=0 padding=0 border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center" testId=testId
      svg width="1.25rem" height="1.25rem" viewBox="0 0 24 24" fill="#ffffff" aria-hidden=true
        path d=icon

// An overflow menu row: its glyph, then its label, lit while the pointer is on it or it has the focus; a speed row is
// a radio item, checked at the current rate.
component PlayerMenuItem
  props
    label: string
    icon: string
    radio: bool
    checked: bool
    press: action
    elementId: string
  state lit = false
  action light(on: bool)
    lit = on
  view
    if radio
      button id=elementId press=press hover=light focus=light(true) blur=light(false) role="menuitemradio" aria-checked=checked title="" height="2.875rem" flex-shrink=0 padding="0 1rem" gap="1rem" border-width=0 background-color=(lit ? "#ffffff1a" : "#00000000") display="flex" align-items="center" color="#e8e8e8" font-size="0.875rem" text-align="left"
        PlayerMenuGlyph(icon=icon)
        text label
    else
      button id=elementId press=press hover=light focus=light(true) blur=light(false) role="menuitem" title="" height="2.875rem" flex-shrink=0 padding="0 1rem" gap="1rem" border-width=0 background-color=(lit ? "#ffffff1a" : "#00000000") display="flex" align-items="center" color="#e8e8e8" font-size="0.875rem" text-align="left"
        PlayerMenuGlyph(icon=icon)
        text label

component PlayerMenuGlyph
  props
    icon: string
  view
    box width="1.5rem" height="1.5rem" flex-shrink=0
      if icon != ""
        svg width="1.5rem" height="1.5rem" viewBox="0 0 24 24" fill="#ffffff" aria-hidden=true
          path d=icon
