// From the MIT reference (see LICENSE-T3): AttachmentFilePreview's media bodies.
// - PDF and HTML: BrowserDocumentFrame ("min-h-0 flex-1 border-0 bg-white"), a Contract `iframe` (media-frame.contract):
//   a PDF at its signed URL in WebKit's PDF view (a PDF the attachment surface shows is the viewer page's); the page in
//   a sandboxed frame.
// - Audio: AudioPreview, `<audio controls preload="metadata" class="w-full max-w-xl">` centred
//   in `p-6`; Chrome's audio controls are a 54 px pill.
// - Video: `<video controls playsInline class="max-h-full max-w-full">` centred on black.
// Audio and video are Contract `video` nodes with `controls` (AVKit), a draft's playing its staged copy's typed link
// (composer-chip-file.ts); their `error` event is the reference's onError ("Unable to load audio." / "Unable to load
// video.", attachment-media.ts).
use AttachmentSurface from "../panel/pr-attachment-shapes.contract"
use MediaFrame from "./media-frame.contract"

component AttachmentMediaBody
  props
    att: AttachmentSurface
    local: action
  view
    if att.preview == "pdf" or att.preview == "html"
      box position="relative" flex=1 min-height=0 width="100%" background-color="#ffffff"
        MediaFrame(kind=att.preview, src=att.url, name=att.name, testId=`attachment-${att.preview}`)
    if att.preview == "audio"
      column flex=1 min-height=0 width="100%" padding="1.5rem" box-sizing="border-box" align-items="center" justify-content="center" testId="attachment-audio"
        video att.url controls=true preload="metadata" aria-label=att.name error=local("surface-linked-att-media-error", att.id) width="100%" max-width="36rem" height="3.375rem" flex-shrink=0 border-radius="1.6875rem" overflow="hidden" testId="attachment-audio-player"
    if att.preview == "video"
      column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" overflow="hidden" background-color="#000000" testId="attachment-video"
        video att.url controls=true playsinline=true preload="metadata" aria-label=att.name error=local("surface-linked-att-media-error", att.id) max-width="100%" max-height="100%" object-fit="contain" testId="attachment-video-player"
