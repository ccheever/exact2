// DiffPanel's Commits submenu and the header's short SHA (T3 Code 2359643cff, MIT, see LICENSE-T3), over
// diff-commits.ts. A row's subject and time pick the commit (`diff-scope` `commit:<sha>`; the commit already shown goes
// back to Changes); its short SHA opens the commit's code host page and never selects it (`diffreview commit-url`).
use Snapshot from "../shared/shapes.contract"
use DiffCommitRow from "./diff-commits-shapes.contract"
use ReqIcon from "../composer/requests.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"

// DropdownMenuSubTrigger "Commits" and its DropdownMenuSubContent (max-h-80, max-w-96) beside it, as the Turn submenu
// sits. The list it opens with stays while it is open; the read it starts (`commits-open`) shows next time.
component DiffCommitsItem
  props
    keysId: string
    data: Snapshot
    command: action
  state lit = false
  state open = false
  action hover(over: bool)
    if over
      focus("diff-scope-commits")
      showPopover("diff-commits-menu", source="diff-scope-commits")
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  action key(k: string, e: KeyboardEvent)
    if k == "ArrowRight" and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      stopPropagation()
      showPopover("diff-commits-menu", source="diff-scope-commits")
  action toggled(e: ToggleEvent)
    open = e.newState == "open"
    command("diffreview", (e.newState == "open" ? "commits-open" : "commits-close"), "", 0)
  view
    box position="relative" width="100%"
      button id="diff-scope-commits" popovertarget="diff-commits-menu" hover=hover focus=focused(true) blur=focused(false) key=key role="menuitem" aria-haspopup="menu" aria-expanded=open testId="diff-scope-commits" aria-label="Commits" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(lit or open ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        text "Commits" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
        ReqIcon(name="chevron-right", size=14, color="light-dark(#71717a, #a1a1a1)")
      column id="diff-commits-menu" toggle=toggled popover="auto" position-area="right span-bottom" position-try-fallbacks="flip-inline" position="absolute" margin-top="-0.3125rem" min-width="8rem" max-width="24rem" testId="diff-commits-layer"
        column width="100%" max-height="20rem" overflow-y="auto" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Commits" testId="diff-commits-menu"
          KeyMenu(menuId="diff-commits-keys", items=data.diffCommits.rows.map((row) => [KmItem(id=`diff-commit-${row.sha}`, label=row.subject)].concat(row.url != "" ? [KmItem(id=`diff-commit-url-${row.sha}`, label=`Open commit ${row.short}`)] : [])).flat(), keyed=1, gap="0px", modal=true)
            for row in data.diffCommits.rows key=row.id
              DiffCommitEntry(keysId="diff-commits-keys", row=row, command=command)
          if data.diffCommits.note != ""
            row height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" opacity=0.64 role="menuitem" aria-disabled=true testId="diff-commits-note"
              text data.diffCommits.note font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

// One commit: the radio item (subject truncating before the relative time; its tooltip is the whole subject) and the
// short SHA, underlined as a link when the host has a page for it. The row tints as either part is lit; the commit
// shown keeps its own tint.
component DiffCommitEntry
  props
    keysId: string
    row: DiffCommitRow
    command: action
  state lit = ""
  action setHover(id: string, over: bool)
    if over
      focus(id)
    else if lit == id
      focus(keysId)
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  action openUrl(e: MouseEvent)
    command("diffreview", "commit-url", row.url, ((e.metaKey or e.ctrlKey) ? 1 : 0))
  view
    row width="100%" align-items="center" border-radius="0.25rem" background-color=(row.selected ? "light-dark(#18181b14, #f5f5f514)" : lit != "" ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") testId=`diff-commit-row-${row.short}`
      button id=`diff-commit-${row.sha}` press=command("diff-scope", "", row.id, 0) popovertarget="diff-scope-menu" popovertargetaction="hide" hover=setHover(`diff-commit-${row.sha}`) focus=focused(`diff-commit-${row.sha}`, true) blur=focused(`diff-commit-${row.sha}`, false) role="menuitemradio" aria-checked=row.selected aria-label=row.subject title=row.subject testId=`diff-commit-${row.short}` flex=1 min-width=0 height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.75rem" box-sizing="border-box" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        text row.subject font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text row.time flex-shrink=0 font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717a, #a1a1a1)"
      if row.url != ""
        button id=`diff-commit-url-${row.sha}` press=openUrl popovertarget="diff-scope-menu" popovertargetaction="hide" hover=setHover(`diff-commit-url-${row.sha}`) focus=focused(`diff-commit-url-${row.sha}`, true) blur=focused(`diff-commit-url-${row.sha}`, false) role="menuitem" aria-label=`Open commit ${row.short}` title=row.url testId=`diff-commit-url-${row.short}` flex-shrink=0 height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 background-color="#00000000" display="flex" align-items="center"
          text row.short font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" text-decoration-line="underline" color="light-dark(#71717a, #a1a1a1)"
      else
        text row.short flex-shrink=0 padding-left="0.5rem" padding-right="0.5rem" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)"

// The header's short SHA beside the scope trigger while a commit shows: a link to its code host page (its tooltip the
// URL), or plain text when the host has none.
component DiffCommitSha
  props
    data: Snapshot
    command: action
  action openUrl(e: MouseEvent)
    command("diffreview", "commit-url", data.diffCommits.url, ((e.metaKey or e.ctrlKey) ? 1 : 0))
  view
    if data.diffCommits.url != ""
      button press=openUrl aria-label=`Open commit ${data.diffCommits.sha}` title=data.diffCommits.url testId="diff-commit-sha" flex-shrink=0 padding=0 border-width=0 background-color="#00000000" display="flex" align-items="center"
        text data.diffCommits.sha font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" text-decoration-line="underline" color="light-dark(#71717a, #a1a1a1)"
    else
      text data.diffCommits.sha flex-shrink=0 font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" testId="diff-commit-sha"
