use DiffFindBar from "./diff-find.contract"
// The changes side panel (wide) and sheet (narrow), measured against T3's served
// right panel: DiffPanel header/toolbar, @pierre/diffs file headers and rows.
// Every patch comes from the server's diff APIs; nothing here invents content.
use Snapshot from "../shared/shapes.contract"
use DiffItem from "../shared/shapes.contract"
use DiffSegment from "../shared/shapes.contract"
use DiffFile from "../shared/shapes.contract"
use DiffBaseRef from "../shared/shapes.contract"
use ExtraGlyph from "../details/git.contract"
use ToggleSwitch from "../details/git.contract"
use ReqIcon from "../composer/requests.contract"
use diffInk from "../appearance/settings-appearance-look.contract"
use ShellView from "../shell/shell-shapes.contract"
use ShellSurface from "../shell/shell-shapes.contract"
use ShellIcon from "../shell/shell-icons.contract"
use TipBubble from "../shell/shell-tip.contract"
use PanelHeader from "../panel/panel.contract"
use DiffGlyph from "./diff-glyphs.contract"
use DiffTree from "./diff-tree.contract"
use DiffRow, DiffTool from "./diff-rows.contract"
use diffStatInk from "./diff-rows.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use DiffCommitsItem, DiffCommitSha from "./diff-commits.contract"

// Rebuilt on a scheme change so native SVG glyphs resolve the new light-dark() side.
component DiffPanel
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    scheme: string
    detailsOpen: bool
    details: action
    local: action
  view
    DiffPanelBody(data=data, shell=shell, command=command, close=close, ui=ui, maximized=maximized, resize=resize, finishResize=finishResize, sheet=sheet, detailsOpen=detailsOpen, details=details, local=local)

// DiffPanelShell's header: the Diff tab and "Add panel surface", then
// Maximize panel, the terminal drawer and the right panel toggle; an inline
// panel resizes from an 8pt handle over its left edge (RightPanelResizeHandle).
component DiffPanelBody
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    detailsOpen: bool
    details: action
    local: action
  state hovered = ""
  // The file under the pointer, any row of it (DiffRow hoveredPath).
  state hoveredFile = ""
  action hoverFile(path: string)
    hoveredFile = path
  action listHover(over: bool)
    if not over
      hoveredFile = ""
  // diff-review: the open comment draft's text (AnnotatableCodeView draftText), kept here so a scrolled-away row keeps it.
  state draftText = ""
  action findOp(op: string, value: string)
    local(`diff-find-${op}`, "", value)
  action findJump(e: IntersectionObserverEntry)
    if data.diffFind.target != ""
      scrollIntoView("diff-list", data.diffFind.target, offset=-48, behavior="instant")
  action revealJump(e: IntersectionObserverEntry)
    if data.diffRevealTarget != ""
      scrollIntoView("diff-list", data.diffRevealTarget, block="start")
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action editDraft(text: string)
    draftText = text
  action beginComment(path: string, side: string, line: number)
    draftText = ""
    command("diffreview", `comment:${side}`, path, line)
  action cancelComment
    draftText = ""
    command("diffreview", "cancel", "", 0)
  action saveComment
    command("diffreview", "save", draftText, 0)
    draftText = ""
  view
    // Maximized, the left edge meets the sidebar's own border or the window edge, so the panel draws none (PreviewPanelShell).
    column height="100%" width="100%" min-width=0 position="relative" box-sizing="border-box" background-color=(sheet ? "light-dark(#ffffff, #000000)" : "light-dark(#fcfcfc, #000000)") border-left-style="solid" border-left-width=(maximized ? 0 : 1) border-color="light-dark(#e4e4e7, #191919)" box-shadow=(sheet ? "0 10px 15px -3px #0000000d, 0 4px 6px -4px #0000000d" : "none") testId="diff-panel" pointerdown=local("diff-find-focus", "", "") focusin=local("diff-find-focus", "", "") role=(sheet ? "dialog" : "region") aria-label="Diff"
      // The shared tab bar (every open surface, "+", the layout controls; the details toggle in a sheet).
      PanelHeader(panel=shell.panel, surfaces=shell.surfaces, sheet=sheet, maximized=maximized, detailsOpen=detailsOpen, keyThreadPanel=shell.keyThreadPanel, keyRightPanel=shell.keyRightPanel, terminalAvailable=shell.terminalAvailable, terminalOpen=shell.terminalOpen, keyTerminal=shell.keyTerminal, still=false, ui=ui, details=details, local=local, scheme="", searchFocused=false)
      // A sheet's toolbar sits 6pt lower over the same content top (served reference at 840).
      column margin-top=(sheet ? "0.375rem" : "0px")
        DiffToolbar(data=data, command=command)
      if data.diffFind.open
        DiffFindBar(find=data.diffFind, op=findOp, prefix="diff")
        for navigation in [data.diffFind.navigation] key=navigation
          box intersect=findJump width=0 height=0 position="absolute" pointer-events="none"
      // A turn diff opened on a file scrolls to it once the answer lists it (diff.ts revealNamedFile).
      if data.diffReveal > 0
        for reveal in [data.diffReveal] key=reveal
          box intersect=revealJump width=0 height=0 position="absolute" pointer-events="none"
      row flex=1 min-height=0 width="100%" margin-top=(sheet ? "0.375rem" : "0.75rem")
        column flex=1 min-width=0 min-height=0
          if data.diffError != ""
            text data.diffError font-size="0.6875rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-bottom="0.5rem" color="light-dark(#fb2c36cc, #fb414acc)" testId="diff-error"
          if data.diffTruncated
            text "This preview exceeds the size limit. Changes shown are incomplete." font-size="0.6875rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" flex-shrink=0 background-color="light-dark(#f4f4f566, #1c1c1c66)" color="light-dark(#71717a, #a1a1a1)"
          if data.diffToolCallNote != ""
            text data.diffToolCallNote font-size="0.6875rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" flex-shrink=0 border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #191919b3)" background-color="light-dark(#f4f4f566, #1c1c1c66)" color="light-dark(#71717a, #a1a1a1)" testId="diff-tool-call-note"
          // A tool call recorded file content without a diff: that content, before and after.
          if data.diffToolCallContent.length > 0
            scroll flex=1 min-height=0 width="100%" testId="diff-tool-call-content"
              column width="100%" padding="0.75rem" box-sizing="border-box" gap="0.75rem"
                text "The provider recorded file content without a diff." font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)"
                for entry in data.diffToolCallContent key=entry.label
                  column width="100%" gap="0.25rem"
                    text entry.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)"
                    text entry.text font-family=data.look.codeFont font-size="0.6875rem" line-height="1rem" white-space=(data.diffWrap ? "pre-wrap" : "pre") overflow-wrap=(data.diffWrap ? "break-word" : "normal") color="light-dark(#18181b, #f5f5f5)"
          else if data.diffPending and data.diffItems.length == 0
            column flex=1 padding-top="0.25rem" gap="0.5rem" role="status" aria-label=data.diffLoadingLabel testId="diff-loading"
              row height="2rem" padding-left="0.5rem" padding-right="0.75rem" gap="0.5rem" align-items="center"
                box width="0.625rem" height="0.625rem" border-radius="0.1875rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width="1.25rem" height="1.25rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width="45%" height="0.75rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
              column padding-left="0.75rem" padding-right="0.75rem" gap="0.5rem"
                box width="66%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
                box width="80%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
                box width="60%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
          else
            if data.diffEmpty and data.diffError == ""
              column flex=1 align-items="center" justify-content="center" padding-left="0.75rem" padding-right="0.75rem"
                text data.diffEmptyLabel font-size="0.75rem" line-height="1rem" text-align="center" color="light-dark(#71717ab3, #a1a1a1b3)" testId="diff-empty"
            else
              // DiffFileLoadingBoundary: nearing the end of a large diff asks for four more files (diff-review.ts).
              // appearance="none": the reference draws these rows as divs, not a platform table (LLP 1115.002 D5's opt-out).
              list appearance="none" virtualized=true id="diff-list" hover=listHover reachend=command("diffreview", "next", "", 0) flex=1 min-height=0 width="100%" testId="diff-content"
                for item in data.diffItems key=item.id
                  DiffRow(family=data.look.codeFont, item=item, wrap=data.diffWrap, command=command, scheme=data.look.diff, size=data.look.codeSize, commentOpen=data.diffCommentOpen, draftText=draftText, editDraft=editDraft, beginComment=beginComment, cancelComment=cancelComment, saveComment=saveComment, hoveredPath=hoveredFile, hoverPath=hoverFile)
        if data.diffTree and data.diffFiles.length > 0
          DiffTree(data=data, command=command, scheme=data.look.diff)
      // The rail sits inside the panel and above its body: an overflowing child is not hit-testable natively.
      if not sheet and not maximized
        box position="absolute" top=0 bottom=0 left=0 width="0.375rem" z-index=28 cursor="col-resize" touch-action="none" pan=resize panrelease=finishResize hover=hover("resize") role="separator" aria-orientation="vertical" aria-label="Resize diff panel" testId="diff-resize"
          box position="absolute" top=0 bottom=0 left=0 width=1 pointer-events="none" background-color=(hovered == "resize" ? "light-dark(#e4e4e7, #ffffff1a)" : "#00000000")

// One "Add panel surface" row: 28pt, 16pt glyph at 80%, label, letter key.
component AddSurfaceItem
  props
    surface: ShellSurface
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose popovertarget="diff-add-surface" popovertargetaction="hide" hover=hover disabled=(not surface.available) role="menuitem" aria-label=`${surface.label} ${surface.shortcut}` testId=`add-surface-${surface.id}` display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" opacity=(surface.available ? 1 : 0.64) background-color=(hovered and surface.available ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
      box width="1rem" height="1rem" flex-shrink=0 opacity=0.8
        ShellIcon(name=surface.icon, size=16, color="light-dark(#71717b, #a1a1a1)")
      text surface.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
      text surface.shortcut flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.075rem" color="light-dark(#71717b, #a1a1a1)"

component DiffToolbar
  inject
    rem: number
  props
    data: Snapshot
    command: action
  state scopeOpen = false
  // The scope and refs group's width (DiffPanel's @container/diff-refs).
  state refsWidth = 1000
  action refsSized(width: number, height: number)
    refsWidth = width
  derive scopeItems = [KmItem(id="diff-scope-branch", label="Changes"), KmItem(id="diff-scope-unstaged", label="Uncommitted"), KmItem(id="diff-scope-latest", label="Latest turn"), KmItem(id="diff-scope-turns", label="Turn"), KmItem(id="diff-scope-commits", label="Commits")]
  // Base UI's MenuTrigger: Enter, Space, ↓ open the scope menu at its first item, ↑ at its last.
  action scopeKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("diff-scope-menu", source="diff-scope")
        let target = kmTriggerTarget(scopeItems, k)
        if target != ""
          focus(target)
  action scopeToggled(e: ToggleEvent)
    scopeOpen = e.newState == "open"
  view
    row height="1.75rem" flex-shrink=0 padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" gap="0.25rem"
      row flex=1 min-width=0 gap="0.25rem" align-items="center" resize=refsSized
        box position="relative" min-width=0 display="flex"
          button id="diff-scope" popovertarget="diff-scope-menu" key=scopeKey aria-label=`Diff scope: ${data.diffScopeLabel}` aria-haspopup="menu" aria-expanded=scopeOpen testId="diff-scope" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#fafafa, #111111)" display="flex" flex-direction="row" align-items="center" min-width=0 flex-shrink=(data.diffCompare ? 0 : 1)
            text data.diffScopeLabel font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
            ReqIcon(name="chevron-down", size=14, color="light-dark(#18181b, #f5f5f5)")
          DiffScopeMenu(data=data, command=command, items=scopeItems, toggled=scopeToggled)
        // A commit shown names its short SHA beside the trigger (DiffPanel's gap-3), and the trigger gives way first.
        if data.diffCommits.sha != ""
          box flex-shrink=0 margin-left="0.5rem" display="flex"
            DiffCommitSha(data=data, command=command)
        // Changes with a base ref names "<head> → <base>", the base being the comparison target picker.
        if data.diffCompare
          DiffCompare(data=data, command=command, narrow=(refsWidth < 20 * rem))
        box flex=1
      // DiffPanel header: the stat shows with files to count, refresh with a git workspace, expand-all and the tree with files.
      if data.diffFiles.length > 0 or data.diffAdditions + data.diffDeletions > 0
        row gap="0.25rem" align-items="center" flex-shrink=0 margin-right="0.25rem" role="group" aria-label=`${data.diffAdditions} additions, ${data.diffDeletions} deletions`
          text data.diffAdditionsText font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="1rem" color=diffStatInk(data.look.diff, "add")
          text data.diffDeletionsText font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="1rem" color=diffStatInk(data.look.diff, "del")
      if data.diffCanRefresh
        DiffTool(icon="refresh", label=(data.diffLoading ? "Refreshing diff" : "Refresh diff"), pressed=false, toggle=false, radius=8, testId="diff-refresh", choose=command("diff-refresh", "", "", 0))
      if data.diffFiles.length > 0
        DiffTool(icon=(data.diffAllCollapsed ? "unfold" : "fold"), label=(data.diffAllCollapsed ? "Expand all files" : "Collapse all files"), pressed=false, toggle=false, radius=8, testId="diff-expand-all", choose=command("diff-view", (data.diffAllCollapsed ? "expand-all" : "collapse-all"), "", 0))
      row padding="0.125rem" gap="0.125rem" border-radius="0.5rem" background-color="light-dark(#e6e6e8, #121212)" role="group" aria-label="Diff layout" flex-shrink=0
        button press=command("diff-view", "layout", "stacked", 0) aria-label="Stacked diff view" testId="diff-stacked" width="2rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(data.diffLayout == "stacked" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          if data.diffLayout == "stacked"
            DiffGlyph(name="stacked", size=14, color="light-dark(#18181b, #f5f5f5)")
          else
            DiffGlyph(name="stacked", size=14, color="light-dark(#71717a, #a1a1a1)")
        button press=command("diff-view", "layout", "split", 0) aria-label="Split diff view" testId="diff-split" width="2rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(data.diffLayout == "split" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          if data.diffLayout == "split"
            DiffGlyph(name="split", size=14, color="light-dark(#18181b, #f5f5f5)")
          else
            DiffGlyph(name="split", size=14, color="light-dark(#71717a, #a1a1a1)")
      DiffTool(icon="wrap", label=(data.diffWrap ? "Disable diff line wrapping" : "Enable diff line wrapping"), pressed=data.diffWrap, toggle=true, radius=8, testId="diff-wrap", choose=command("diff-view", "wrap", "", 0))
      DiffTool(icon="pilcrow", label=(data.diffIgnoreWhitespace ? "Show whitespace changes" : "Hide whitespace changes"), pressed=data.diffIgnoreWhitespace, toggle=true, radius=8, testId="diff-whitespace", choose=command("diff-whitespace", "", "", 0))
      if data.diffTestFiles > 0
        DiffTool(icon="hide-tests", label="Hide test files", pressed=data.diffHideTests, toggle=true, radius=8, testId="diff-hide-tests", choose=command("diff-view", "hide-tests", "", 0))
      if data.diffFiles.length > 0
        DiffTool(icon="tree", label=(data.diffTree ? "Hide file tree" : "Show file tree"), pressed=data.diffTree, toggle=true, radius=8, testId="diff-tree-toggle", choose=command("diff-view", "tree", "", 0))

// DiffPanel's DropdownMenuContent (align start): 4pt under the trigger, flipping near an edge. A popover, so a press
// anywhere outside it or Escape closes it, as Base UI's Menu does; it is modal while it shows, so its Escape is not the
// right panel sheet's toggle's. DiffPanel lists Changes, Uncommitted, Latest turn, the Turn submenu and the Commits
// submenu (diff-commits.contract) whether or not the thread has turns; Latest turn without one only closes the menu (client-ops-diff.ts), and Turn then opens nothing,
// as the reference's empty submenu shows nothing.
component DiffScopeMenu
  inject
    dialogMenuEntered: action
  props
    data: Snapshot
    command: action
    items: KmItem[]
    toggled: action
  view
    column id="diff-scope-menu" data-dialog-return="menu" focusin=dialogMenuEntered("diff-scope-menu", "diff-scope") toggle=toggled popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width="10rem" testId="diff-scope-layer"
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label=`Diff scope: ${data.diffScopeLabel}` testId="diff-scope-menu"
        KeyMenu(menuId="diff-scope-keys", items=items, keyed=0, gap="0px", modal=true)
          DiffMenuItem(keysId="diff-scope-keys", menuId="diff-scope-menu", label="Changes", time="", selected=(data.diffScope == "branch"), testId="diff-scope-branch", choose=command("diff-scope", "", "branch", 0))
          DiffMenuItem(keysId="diff-scope-keys", menuId="diff-scope-menu", label="Uncommitted", time="", selected=(data.diffScope == "unstaged"), testId="diff-scope-unstaged", choose=command("diff-scope", "", "unstaged", 0))
          DiffMenuItem(keysId="diff-scope-keys", menuId="diff-scope-menu", label="Latest turn", time="", selected=data.diffLatestSelected, testId="diff-scope-latest", choose=command("diff-scope", "", "latest", 0))
          DiffTurnsItem(keysId="diff-scope-keys", data=data, command=command)
          DiffCommitsItem(keysId="diff-scope-keys", data=data, command=command)

// DropdownMenuSubTrigger "Turn" and its DropdownMenuSubContent beside it (MenuSubPopup: side end, 5pt up), flipping to
// the start side near an edge; the pointer resting on the row opens it, as →, Enter or Space do.
component DiffTurnsItem
  props
    keysId: string
    data: Snapshot
    command: action
  state lit = false
  state open = false
  action hover(over: bool)
    if over
      focus("diff-scope-turns")
      if data.diffTurns.length > 0
        showPopover("diff-turns-menu", source="diff-scope-turns")
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  action key(k: string, e: KeyboardEvent)
    if k == "ArrowRight" and not e.metaKey and not e.ctrlKey and not e.altKey and data.diffTurns.length > 0
      preventDefault()
      stopPropagation()
      showPopover("diff-turns-menu", source="diff-scope-turns")
  action toggled(e: ToggleEvent)
    open = e.newState == "open"
  view
    box position="relative" width="100%"
      button id="diff-scope-turns" popovertarget=(data.diffTurns.length > 0 ? "diff-turns-menu" : "") hover=hover focus=focused(true) blur=focused(false) key=key role="menuitem" aria-haspopup="menu" aria-expanded=open testId="diff-scope-turns" aria-label="Turn" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(lit or open ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
        text "Turn" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
        ReqIcon(name="chevron-right", size=14, color="light-dark(#71717a, #a1a1a1)")
      column id="diff-turns-menu" toggle=toggled popover="auto" position-area="right span-bottom" position-try-fallbacks="flip-inline" position="absolute" margin-top="-0.3125rem" width="10rem" testId="diff-turn-layer"
        column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Turn" testId="diff-turn-menu"
          KeyMenu(menuId="diff-turns-keys", items=data.diffTurns.map((turn) => KmItem(id=`diff-${turn.id}`, label=turn.label)), keyed=1, gap="0px", modal=true)
            for turn in data.diffTurns key=turn.id
              DiffMenuItem(keysId="diff-turns-keys", menuId="diff-scope-menu", label=turn.label, time=turn.time, selected=turn.selected, testId=`diff-${turn.id}`, choose=command("diff-scope", "", turn.id, 0))

component DiffMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    // The popover a choice closes (the scope menu, which takes the turn submenu with it).
    menuId: string
    label: string
    time: string
    selected: bool
    testId: string
    choose: action
  state lit = false
  action setHover(over: bool)
    if over
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=choose popovertarget=menuId popovertargetaction="hide" hover=setHover focus=focused(true) blur=focused(false) role="menuitemradio" aria-checked=selected testId=testId aria-label=label width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-radius="0.25rem" border-width=0 background-color=(selected ? "light-dark(#18181b14, #f5f5f514)" : lit ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
      if time != ""
        text time font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" flex-shrink=0

// DiffPanel's comparison (Changes with a base ref): "<head> →" (the head truncates first: the
// trigger keeps its width) and the Combobox trigger "Change comparison target. Currently <base>".
// Its popup reads the ref lists as it opens and as the search changes (`diffbase`, diff-base-ref.ts);
// a choice asks for the preview against it (`diff-base`).
component DiffCompare
  props
    data: Snapshot
    command: action
    // Too narrow for both refs: the target stays readable and the head, the thread's own branch, gives way to "vs".
    narrow: bool
  state hovered = false
  state query = ""
  state opened = 0
  action hover(over: bool)
    hovered = over
  action open
    query = ""
    opened = opened + 1
    command("diffbase", "open", "", 0)
  action search(text: string)
    query = text
    command("diffbase", "query", text, 0)
  view
    // DiffPanel's comparison group is overflow-hidden, so neither ref is drawn over the stats beside it. The popup
    // stays outside the clip.
    row min-width=0 flex-shrink=1 margin-left="0.5rem" align-items="center" role="group" aria-label=`Comparing ${data.diffHead} against ${data.diffBase}` testId="diff-compare"
      row min-width=0 flex-shrink=1 gap="0.5rem" align-items="center" overflow="hidden"
        // The head ref keeps 3rem while the row has room; the base ref button does not shrink, so its menu stays reachable.
        if narrow
          text "vs" flex-shrink=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" title=`${data.diffHead} → ${data.diffBase}` aria-hidden=true testId="diff-compare-vs"
        else
          row min-width="min(48px, calc(100% - 44px))" flex-shrink=1 gap="0.5rem" align-items="center" overflow="hidden" title=`${data.diffHead} → ${data.diffBase}`
            text data.diffHead min-width=0 max-width="12rem" flex-shrink=1 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" testId="diff-compare-head"
            box flex-shrink=0 opacity=0.7 display="flex"
              ShellIcon(name="arrow-right", size=14, color="light-dark(#71717a, #a1a1a1)")
        button id="diff-base" popovertarget="diff-base-menu" popovertargetaction="show" press=open hover=hover role="combobox" aria-label=`Change comparison target. Currently ${data.diffBase}` testId="diff-base" flex-shrink=0 min-width="2.25rem" max-width="12rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
          text data.diffBase min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" font-weight=500 line-height="1rem" color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717a, #a1a1a1)") testId="diff-base-label"
          box flex-shrink=0 opacity=0.7 display="flex"
            ReqIcon(name="chevron-down", size=14, color="light-dark(#71717a, #a1a1a1)")
      DiffBasePicker(data=data, command=command, query=query, search=search, session=opened)

// Base UI Combobox's list navigation (loopFocus, allowEscape): ↓ from no item goes to the first and past
// the last to none; ↑ from no item goes to the last and before the first to none ("-").
fn dbStep(ids: string[], current: string, down: bool): string = ids.length == 0 ? "-" : (down ? (ids.indexOf(current) < 0 ? ids.slice(0, 1).join("") : (ids.indexOf(current) + 1 >= ids.length ? "-" : ids.slice(ids.indexOf(current) + 1, ids.indexOf(current) + 2).join(""))) : (ids.indexOf(current) < 0 ? ids.slice(ids.length - 1).join("") : (ids.indexOf(current) == 0 ? "-" : ids.slice(ids.indexOf(current) - 1, ids.indexOf(current)).join(""))))

// The keys' items, as the reference's are. With no query: Automatic and the refs. With a query
// (filteredBaseRefItems, trimmed) Base UI counts only the matching refs, but the static Automatic row
// keeps its place in the list: the first N rows (Automatic, then all but the last ref) take the N indices.
fn dbKeys(refIds: string[], query: string): string[] = query.trim() == "" ? ["automatic"].concat(refIds) : ["automatic"].concat(refIds).slice(0, refIds.length)
// ↓/↑ over those items. With a query, ↑ from no item lands past the counted items and Base UI drops it.
fn dbMove(keys: string[], current: string, down: bool, query: string): string = (query.trim() != "" and not down and keys.indexOf(current) < 0) ? "-" : dbStep(keys, current, down)
// Return: "pick" the highlighted item, "close" with none, or "stay" on Automatic under a query (its
// list slot holds no item to click: nothing is picked and the popup stays open).
fn dbReturn(keys: string[], current: string, query: string): string = keys.indexOf(current) < 0 ? "close" : ((query.trim() != "" and current == "automatic") ? "stay" : "pick")

// ComboboxPopup (w-72, align start): the search, the Branch / Remote heading, "No matching refs.",
// Automatic and the refs. The popup scopes the window's shortcuts while it shows (`aria-modal`), so
// Escape closes it rather than the right panel, and gives the focus back to the trigger.
// The highlighted item is Base UI's activeIndex, by id: an opening starts at the selected item, the
// pointer and ↓/↑ in the search move it, typing clears it, and Return picks it (none: Return only
// closes). The selected item keeps its own tint (data-selected) under a moving highlight. Under a query
// the keys follow the reference's static Automatic row (dbKeys, PR #360):
// ↓ lights Automatic first, Return on it does nothing, and the last matching ref takes no key. A Return
// hides the popup after an accepted pick or an empty selection.
component DiffBasePicker
  props
    data: Snapshot
    command: action
    query: string
    search: action
    session: number
  state cursor = ""
  state cursorAt = -1
  state focused = true
  derive selectedId = (data.diffBaseAutomatic ? "automatic" : data.diffBaseRefs.filter((r) => r.selected).map((r) => r.id).join(""))
  derive highlight = (cursorAt == session ? cursor : selectedId)
  derive keys = dbKeys(data.diffBaseRefs.map((r) => r.id), query)
  derive pickValue = (highlight == "automatic" ? "__automatic_base_ref__" : data.diffBaseRefs.filter((r) => r.id == highlight).map((r) => r.value).join(""))
  action hover(id: string, over: bool)
    cursor = over ? id : (highlight == id ? "-" : highlight)
    cursorAt = session
  action edit(text: string)
    cursor = "-"
    cursorAt = session
    search(text)
  action searchKey(k: string)
    if k == "ArrowDown" or k == "ArrowUp"
      preventDefault()
      let next = dbMove(keys, highlight, k == "ArrowDown", query)
      cursor = next
      cursorAt = session
      if next != "-"
        scrollIntoView(`diff-base-option-${next}`, block="nearest")
  action pick
    let outcome = dbReturn(keys, highlight, query)
    if outcome != "stay"
      hidePopover("diff-base-menu")
      focus("diff-base")
      if outcome == "pick" and pickValue != ""
        command("diff-base", "", pickValue, 0)
  action searchFocus(value: bool)
    focused = value
  action back
    focus("diff-base")
  view
    column id="diff-base-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width="18rem" testId="diff-base-layer"
      column aria-modal=true width="100%" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" overflow="hidden" role="dialog" aria-label="Comparison target" testId="diff-base-picker"
        button press=back popovertarget="diff-base-menu" popovertargetaction="hide" aria-keyshortcuts="Escape" aria-label="Close comparison target" tabindex=-1 aria-hidden=true position="absolute" left=0 top=0 width=1 height=1 padding=0 border-width=0 opacity=0 overflow="hidden" testId="diff-base-escape" title=""
        column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" box-sizing="border-box" flex-shrink=0
          row height="2.0625rem" padding-bottom="0.375rem" box-sizing="border-box" position="relative" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color=(focused ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#e4e4e7b3, #ffffff0e)")
            box position="absolute" left=0 top="0.375rem" display="flex" pointer-events="none"
              ExtraGlyph(name="search", size=16, color="light-dark(#71717a8c, #a1a1a18c)")
            if query == ""
              text "Search refs..." position="absolute" left="1.25rem" top=0 font-size="0.875rem" line-height="1.625rem" color="light-dark(#71717a, #a1a1a1)" aria-hidden=true pointer-events="none"
            DialogOpenFocus(target="diff-base-search")
            input id="diff-base-search" value=query input=edit key=searchKey submit=pick focus=searchFocus(true) blur=searchFocus(false) autofocus=true role="combobox" aria-label="Search refs..." testId="diff-base-search" flex=1 min-width=0 height="1.625rem" padding-left="1.25rem" padding-right="0.5625rem" padding-top=0 padding-bottom=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" spellcheck="false" data-editable="yes"
        row width="100%" padding-left="0.75rem" padding-right="1.625rem" padding-top="0.5rem" padding-bottom="0.375rem" gap="0.5rem" box-sizing="border-box" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)"
          box width="1rem" flex-shrink=0 aria-hidden=true
          text "Branch" flex=1 min-width=0 font-size="0.625rem" font-weight=500 line-height="0.875rem" letter-spacing="0.025rem" text-transform="uppercase" color="light-dark(#71717a, #a1a1a1)"
          text "Remote" width="2rem" text-align="right" font-size="0.625rem" font-weight=500 line-height="0.875rem" letter-spacing="0.025rem" text-transform="uppercase" color="light-dark(#71717a, #a1a1a1)"
        if data.diffBaseEmpty
          text "No matching refs." role="status" width="100%" padding="0.5rem" box-sizing="border-box" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717a, #a1a1a1)" testId="diff-base-empty"
        scroll max-height="16rem" width="100%"
          column width="100%" padding="0.25rem" box-sizing="border-box" role="listbox" aria-label="Refs"
            button id="diff-base-option-automatic" press=command("diff-base", "", "__automatic_base_ref__", 0) popovertarget="diff-base-menu" popovertargetaction="hide" hover=hover("automatic") role="option" aria-selected=data.diffBaseAutomatic aria-label="Automatic" testId="diff-base-automatic" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(highlight == "automatic" ? "light-dark(#f4f4f5, #ffffff0a)" : data.diffBaseAutomatic ? "light-dark(#18181b14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              text "Automatic" flex=1 min-width=0 line-clamp=1 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
            for ref in data.diffBaseRefs key=ref.id
              DiffBaseRow(ref=ref, lit=(highlight == ref.id), command=command, hover=hover(ref.id))

// One ref: its name, and the remote column: the "Use remote version of" switch for a ref with
// both sides (it picks the other side), the "Remote only" mark for a remote ref alone.
component DiffBaseRow
  props
    ref: DiffBaseRef
    lit: bool
    command: action
    hover: action
  view
    row id=`diff-base-option-${ref.id}` width="100%" min-height="1.75rem" box-sizing="border-box" border-radius="0.25rem" align-items="center" hover=hover background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : ref.selected ? "light-dark(#18181b14, #f5f5f514)" : "#00000000") testId=`diff-base-row-${ref.id}`
      button press=command("diff-base", "", ref.value, 0) popovertarget="diff-base-menu" popovertargetaction="hide" role="option" aria-selected=ref.selected aria-label=(ref.remote == "switch" ? `${ref.label} Use remote version of ${ref.label}` : ref.remote == "only" ? `${ref.label} Remote only` : ref.label) testId=`diff-base-${ref.label}` flex=1 min-width=0 min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
        text ref.label flex=1 min-width=0 line-clamp=1 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
      row width="2rem" margin-right="0.5rem" flex-shrink=0 justify-content="flex-end" align-items="center"
        if ref.remote == "switch"
          button press=command("diff-base", "", ref.other, 0) popovertarget="diff-base-menu" popovertargetaction="hide" role="switch" aria-checked=ref.remoteOn aria-label=`Use remote version of ${ref.label}` testId=`diff-base-remote-${ref.label}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" title=""
            ToggleSwitch(on=ref.remoteOn)
        if ref.remote == "only"
          box display="flex" role="img" aria-label="Remote only" title="Remote only" testId=`diff-base-remote-only-${ref.label}`
            ShellIcon(name="check", size=12, color="light-dark(#71717a, #a1a1a1)")
