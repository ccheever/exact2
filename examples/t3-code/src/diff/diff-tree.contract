// The Diff panel's file tree, measured against T3 Code 5d3d78ab93 DiffFileTree.tsx (MIT; see
// LICENSE-T3): a "Files" header with the count and Collapse/Expand all folders, then @pierre/trees'
// compact rows with their file icons and git status colours, folders open and flattened (diff-tree.ts
// lays them out). A file press reveals the
// file in the diff: it opens, a lazy file is asked for (diff-review.ts), the list scrolls to it.
use Snapshot from "../shared/shapes.contract"
use DiffTreeRow from "../shared/shapes.contract"
use ReqIcon from "../composer/requests.contract"
use DiffGlyph from "./diff-glyphs.contract"
use FileTypeIcon from "../shared/timeline-files.contract"
use ExplorerResizeHandle from "../panel/tree-resize.contract"
use treePaneMax from "../panel/tree-resize.contract"
use treePaneWidth from "../panel/tree-resize.contract"

// FileExplorerPane resizable: 40% of the row up to 256 at first, at least 160; its left edge resizes it ("Resize Changes
// files") and the width it ends on is the one PR Code's tree shares.
component DiffTree
  props
    data: Snapshot
    command: action
    scheme: string
    // The row the tree shares with the diff, measured by the panel.
    rowWidth: number
  state userWidth = -1
  derive most = treePaneMax(rowWidth, 256, 160)
  derive width = treePaneWidth(rowWidth, userWidth >= 0 ? userWidth : data.diffTreeWidth, 256, 160)
  action resize(dx: number, dy: number)
    userWidth = max(160, min(most, width - dx))
  action resized(vx: number, vy: number)
    command("diff-view", "tree-width", `${width}`, 0)
  action set(next: number)
    let chosen = max(160, min(most, next))
    userWidth = chosen
    command("diff-view", "tree-width", `${chosen}`, 0)
  view
    column position="relative" width=`${width}px` flex-shrink=0 height="100%" padding-left="0.75rem" padding-right="0.5rem" box-sizing="border-box" border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #191919)" role="complementary" aria-label="Files" testId="diff-tree"
      ExplorerResizeHandle(width=width, least=160, max=most, label="Resize Changes files", testId="diff-tree-resize", resize=resize, finish=resized, set=set)
      row height="1.5rem" align-items="center" margin-bottom="1rem" gap="0.25rem" padding-right=0
        text "Files" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" flex=1
        text `${data.diffFiles.length}` font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717a, #a1a1a1)" testId="diff-tree-count"
        if data.diffTreeFolders
          DiffTreeFolders(open=data.diffTreeAllOpen, command=command)
      column flex=1 min-height=0 overflow-y="auto" role="tree" aria-label=data.diffTreeLabel testId="diff-tree-rows"
        for entry in data.diffTreeRows key=entry.id
          DiffTreeItem(entry=entry, command=command, scheme=scheme)

// Collapse all folders / Expand all folders (ChevronsDownUp / ChevronsUpDown, icon-xs ghost).
component DiffTreeFolders
  props
    open: bool
    command: action
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    button press=command("diff-view", "folders", (open ? "collapse" : "expand"), 0) hover=hover aria-label=(open ? "Collapse all folders" : "Expand all folders") title=(open ? "Collapse all folders" : "Expand all folders") testId="diff-tree-folders" width="1.5rem" height="1.5rem" padding=0 flex-shrink=0 border-radius="0.25rem" border-width=0 background-color=(hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      DiffGlyph(name=(open ? "fold" : "unfold"), size=14, color="light-dark(#71717a, #a1a1a1)")

// One compact row: a folder's chevron and its (flattened) name, or a file's icon, name and git letter.
component DiffTreeItem
  props
    entry: DiffTreeRow
    command: action
    scheme: string
  state hovering = false
  action hover(over: bool)
    hovering = over
  action pick
    if entry.kind == "folder"
      command("diff-view", "folder", entry.path, 0)
    else
      // revealDiffFile: the same press on the selected row reveals again.
      command("diffreview", "reveal", entry.path, 0)
      scrollIntoView("diff-list", `file:${entry.path}`, block="start")
  view
    button press=pick hover=hover role="treeitem" aria-level=(entry.depth + 1) aria-expanded=(entry.kind == "folder" ? entry.expanded : false) aria-selected=entry.selected aria-label=entry.path testId=`diff-tree-${entry.path}` width="100%" height=24 flex-shrink=0 padding-left=(4 + entry.depth * 12) padding-right=6 gap=4 box-sizing="border-box" border-radius=6 border-width=0 background-color=(entry.selected ? "light-dark(#18181b14, #f5f5f514)" : hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      if entry.kind == "folder"
        ReqIcon(name=(entry.expanded ? "chevron-down" : "chevron-right"), size=16, color="light-dark(#71717a, #a1a1a1)")
        text entry.name font-size=12 line-height="16px" flex=1 min-width=0 line-clamp=1 text-align="left" color="light-dark(#18181b, #f5f5f5)"
        // Every folder here holds a change: Pierre's git lane draws its 6pt dot, half the modified colour over the panel.
        box width=12 flex-shrink=0 display="flex" align-items="center" justify-content="center"
          box width=6 height=6 border-radius=3 background-color="light-dark(#1ca1c780, #08c0ef80)"
      else
        FileTypeIcon(token=entry.token, size=16)
        text entry.name font-size=12 line-height="16px" flex=1 min-width=0 line-clamp=1 text-align="left" color=(treeGitInk(entry.status))
        text entry.letter width=12 flex-shrink=0 text-align="center" font-size=12 font-weight=600 line-height="16px" color=(treeGitInk(entry.status))

// @pierre/trees' git status colours (--trees-added-light/-dark …): the tree's own, whatever the diff's colours are.
fn treeGitInk(status: string): string = status == "added" ? "light-dark(#16a994, #00cab1)" : status == "deleted" ? "light-dark(#ff2e3f, #ff6762)" : status == "renamed" ? "light-dark(#d5a910, #ffd452)" : "light-dark(#1ca1c7, #08c0ef)"
