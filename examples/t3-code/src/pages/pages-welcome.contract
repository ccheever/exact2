// The first-run "Set up T3 Code" wizard, measured against the
// served reference /welcome at 1280×840: the T3 wordmark, the three-stage
// progress list, Connect (computers, Add a computer with the pairing form),
// Agents (each computer's Codex and Claude readiness) and Projects (Claude
// Code and Codex history to import). T3 Code, MIT (LICENSE-T3):
// components/onboarding/WelcomeWizard.tsx, components/ui/wizard.tsx.
use TerminalFrame, TerminalFrameView from "../terminal/terminal-frame.contract"
use PgIcon from "../shared/pages-icons.contract"
use FieldPlaceholder from "../shared/field-placeholder.contract"
use MorphCopyCheck from "../shell/shell-morph.contract"
use ProviderMark from "../shared/icons.contract"
use DriverMark from "../providers/provider-icons-kit.contract"
use CodexSetup from "../providers/codex-setup.contract"
use CodexWelcomeCard from "../providers/codex-setup.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

shape WelcomeComputer
  key: string
  environmentId: string
  label: string
  url: string
  status: string
  selected: bool
shape WelcomeAgent
  key: string
  driver: string
  kind: string
  instanceId: string
  name: string
  summary: string
  state: string
  badge: string
  terminalOpen: bool
  terminalAvailable: bool
  codex: CodexSetup[]
shape WelcomeSetupTerminal
  face: string // the terminal page's {family, size} JSON
  light: string
  dark: string
  open: bool
  ready: bool
  retry: bool
  status: string
  environmentId: string
  terminalId: string
  driver: string
  cwd: string
  providerInstanceId: string
  threadId: string
  frame: TerminalFrameView // the setup terminal page (pages-welcome.ts)
shape WelcomeMachine
  key: string
  label: string
  agents: WelcomeAgent[]
  chatgpt: bool
  terminal: WelcomeSetupTerminal
shape WelcomeCandidate
  key: string
  title: string
  path: string
  parent: string
  detail: string
  selected: bool
// One computer's project scan: its candidates, or its own error or empty state.
shape WelcomeScan
  key: string
  label: string
  error: string
  empty: bool
  truncated: bool
  candidates: WelcomeCandidate[]
shape WelcomeView
  show: bool
  step: string
  computers: WelcomeComputer[]
  ready: bool
  skipped: string
  pairStartsOpen: bool
  machines: WelcomeMachine[]
  scanning: bool
  scans: WelcomeScan[]
  // A legend names each computer's group only when there are several.
  legend: bool
  candidateCount: number
  selectedCount: number
  selectionLabel: string
  importLabel: string
  importing: bool
  commandCopied: number

// T3Wordmark (h-4) and "Code" in the muted 2xl beside it.
component WelcomeIdentity
  props
    scheme: string
  view
    row height="2rem" align-items="baseline" gap="0.375rem" role="img" aria-label="T3 Code"
      svg width="1.65625rem" height="1rem" viewBox="15.5309 37 94.3941 56.96" aria-hidden=true flex-shrink=0
        path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z" fill=(scheme == "dark" ? "#f5f5f5" : "#18181b")
      text "Code" font-size="1.5rem" line-height="2rem" font-weight=500 letter-spacing=-0.6 color="light-dark(#71717b, #a1a1a1)"

// WizardSteps: three equal cells; only earlier stages can be reopened.
component WelcomeSteps
  inject
    wizardSteps: string
  props
    step: string
    busy: bool
    go: action
  derive index = step == "agents" ? 1 : step == "import" ? 2 : 0
  view
    row width="100%" height="2.75rem" padding="0.25rem" gap="0.25rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color=wizardSteps role="list" aria-label="Setup progress"
      WelcomeStep(number=1, label="Connect", current=(index == 0), done=(index > 0), enabled=(index > 0 and not busy), press=go("connect"))
      WelcomeStep(number=2, label="Agents", current=(index == 1), done=(index > 1), enabled=(index > 1 and not busy), press=go("agents"))
      WelcomeStep(number=3, label="Projects", current=(index == 2), done=false, enabled=false, press=go("import"))

component WelcomeStep
  props
    number: number
    label: string
    current: bool
    done: bool
    enabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button id=`welcome-step-${number}` press=press hover=hover disabled=(not enabled) aria-label=`${label}, step ${number}` testId=`welcome-step-${number}` flex=1 min-width=0 height="2.25rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=(current ? 1 : 0) border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color=(current or (over and enabled) ? "light-dark(#ffffff, #111111)" : "#00000000") box-shadow=(current ? "0 1px 2px #0000000d" : "none") display="flex" flex-direction="row" align-items="center" data-focus-stop=((not enabled) ? "" : "enabled")
      box width="1.25rem" height="1.25rem" flex-shrink=0 box-sizing="border-box" border-radius="624.9375rem" border-width=1 border-style="solid" border-color=(done ? "light-dark(#1b4ed8, #346bf1)" : current ? "light-dark(#1b4ed84d, #346bf14d)" : "light-dark(#0000001a, #ffffff1a)") background-color=(done ? "light-dark(#1b4ed8, #346bf1)" : current ? "light-dark(#1d4ed81a, #316cf51a)" : "light-dark(#ffffff, #ffffff0d)") display="flex" align-items="center" justify-content="center"
        if done
          PgIcon(name="check", size=16, color="#ffffff")
        else
          text `${number}` font-size="0.875rem" line-height="1.25rem" font-weight=500 color=(current ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b, #a1a1a1)")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 line-clamp=1 color=(current ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")

// Button (default/primary): 32pt, px 11, rounded-lg, a trailing 14pt glyph.
component WelcomePrimary
  props
    label: string
    icon: string
    disabled: bool
    press: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  state over = false
  action hover(value: bool)
    over = value
  // Return on the focused button presses it, as in Chrome; the Mac host leaves Return to a dialog's default button
  // (LLP 1115.000 D7.3), and the wizard's box has none.
  action buttonKey(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat and not disabled
        press()
  view
    button id=elementId press=press key=buttonKey hover=hover disabled=disabled testId=testId height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color=(over and not disabled ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") box-shadow="inset 0 1px 0 #ffffff29" opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 data-focus-stop=(disabled ? "" : "enabled")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff" white-space="nowrap"
      if icon != ""
        PgIcon(name=icon, size=14, color="#ffffff")

// Button variant="ghost-muted": muted text that lifts to the foreground.
component WelcomeGhost
  props
    label: string
    small: bool
    terminalIcon: bool
    disabled: bool
    press: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button id=elementId press=press hover=hover disabled=disabled testId=testId height=(small ? "1.5rem" : "2rem") padding-left=(small ? "0.4375rem" : "0.6875rem") padding-right=(small ? "0.4375rem" : "0.6875rem") box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 data-focus-stop=(disabled ? "" : "enabled")
      if terminalIcon
        PgIcon(name="terminal", size=14, color="light-dark(#71717b, #a1a1a1)")
      text label margin-left=(terminalIcon ? "0.375rem" : "0px") font-size=(small ? "0.75rem" : "0.875rem") line-height=(small ? "1rem" : "1.25rem") font-weight=500 white-space="nowrap" color=(over and not disabled ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")

// The modal (Dialog with disablePointerDismissal): Escape and outside clicks do nothing.
component WelcomeWizard
  inject
    dialogEntered: action
    dialogFallback: action
    rem: number
    wizardPanel: string
  props
    view: WelcomeView
    scheme: string
    viewportHeight: number
    step: string
    busy: bool
    error: string
    link: string
    pairOpen: bool
    helpOpen: bool
    go: action
    local: action
    editLink: action
    pair: action
    togglePair: action
    toggleHelp: action
    copy: action
    setup: action
    chatgpt: action
    finish: action
    setupOp: action
    setupBusy: bool
    ui: action
  derive dialogTargets = [(step != "connect" and not view.importing ? "welcome-step-1" : (step == "import" ? "welcome-skip-import" : (view.computers.length > 0 ? "welcome-computer-0" : "welcome-add-computer"))), (step == "agents" ? (busy ? "welcome-step-1" : "welcome-agents-continue") : (step == "import" ? (not view.scanning and view.step == "import" and not view.importing and not busy and view.selectedCount > 0 ? "welcome-import" : "welcome-skip-import") : (view.ready and not busy ? "welcome-continue" : (pairOpen ? (helpOpen ? "welcome-copy-command" : (busy or link.trim() == "" ? "welcome-pairing-help" : "welcome-pair")) : "welcome-add-computer"))))]
  view
    column position="absolute" left=0 top=0 right=0 bottom=0 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #000000a3)" backdrop-filter="blur(4px)" testId="welcome-wizard"
      column width="100%" max-width="48rem" max-height="100%" box-sizing="border-box" border-radius="1rem" border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #000000cc)" backdrop-filter="blur(12px)" box-shadow=(scheme == "dark" ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") overflow="hidden" role="dialog" aria-label="Set up T3 Code" testId="welcome-dialog" id="welcome-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("welcome-dialog") key=dialogFallback("welcome-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract; the reference's WelcomeWizard is a Dialog with no X): the done steps, then the step's own controls.
        FocusGuard(guardId="welcome-guard-start", targets=dialogTargets, popup="welcome-dialog")
        DialogOpenFocus(target=(step == "connect" and pairOpen ? "welcome-pairing-link" : (step == "connect" and view.ready and not busy ? "welcome-continue" : (step != "connect" and not view.importing ? "welcome-step-1" : (step == "import" ? "welcome-skip-import" : (view.computers.length > 0 ? "welcome-computer-0" : "welcome-add-computer"))))))
        column width="100%" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" box-sizing="border-box" gap="0.5rem" flex-shrink=0
          text "Set up T3 Code" width=1 height=1 overflow="hidden" opacity=0 position="absolute" role="heading" aria-level=2
          WelcomeIdentity(scheme=scheme)
          WelcomeSteps(step=step, busy=view.importing, go=go)
        scroll width="100%" max-height=(viewportHeight - 9.625 * rem) testId="welcome-scroll"
          column width="100%" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color=wizardPanel
            if step == "connect"
              WelcomeConnect(view=view, busy=busy, error=error, link=link, pairOpen=pairOpen, helpOpen=helpOpen, local=local, editLink=editLink, pair=pair, togglePair=togglePair, toggleHelp=toggleHelp, copy=copy, setup=setup)
            if step == "agents"
              WelcomeAgents(view=view, scheme=scheme, busy=busy, local=local, go=go, chatgpt=chatgpt, setupOp=setupOp, setupBusy=setupBusy, ui=ui)
            if step == "import"
              WelcomeImport(view=view, busy=busy, local=local, finish=finish)
        FocusGuard(guardId="welcome-guard-end", targets=dialogTargets, popup="welcome-dialog")

component WelcomeTitle
  props
    title: string
    description: string
  view
    column width="100%"
      text title font-size="1.5rem" line-height="2rem" font-weight=600 letter-spacing=-0.6 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=1
      if description != ""
        text description margin-top="0.625rem" font-size="0.875rem" line-height="1.421875rem" color="light-dark(#71717b, #a1a1a1)"

// ConnectionStep: the saved computers as checkbox rows, then "Add a computer".
component WelcomeConnect
  props
    view: WelcomeView
    busy: bool
    error: string
    link: string
    pairOpen: bool
    helpOpen: bool
    local: action
    editLink: action
    pair: action
    togglePair: action
    toggleHelp: action
    copy: action
    setup: action
  view
    column width="100%" testId="welcome-connect"
      WelcomeTitle(title="Connect your computers", description="Choose one or more computers. We’ll set up agents and projects on each.")
      if view.computers.length > 0
        column width="100%" margin-top="1.25rem" gap="0.5rem" role="group" aria-label="Computers to set up"
          for computer, i in view.computers key=computer.key
            button id=`welcome-computer-${i}` press=local("select", computer.key, "") role="checkbox" aria-checked=computer.selected aria-label=`${computer.label} ${computer.status} ${computer.url}` testId=`welcome-computer-${computer.environmentId}` width="100%" padding="0.75rem" box-sizing="border-box" gap="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#fcfcfc, #000000)" display="flex" flex-direction="row" align-items="center" data-focus-stop="enabled"
              box width="1rem" height="1rem" flex-shrink=0 box-sizing="border-box" border-radius="0.25rem" border-width=(computer.selected ? 0 : 1) border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color=(computer.selected ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#fcfcfc, #000000)") display="flex" align-items="center" justify-content="center"
                if computer.selected
                  PgIcon(name="check", size=12, color="#ffffff")
              PgIcon(name="monitor", size=16, color="light-dark(#71717b, #a1a1a1)")
              column flex=1 min-width=0 gap="0.125rem"
                row width="100%" align-items="baseline" justify-content="space-between" gap="0.75rem"
                  text computer.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" min-width=0 text-align="left"
                  text computer.status font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
                text computer.url font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" text-align="left"
      column width="100%" margin-top="1rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#fcfcfc, #000000)"
        WelcomeDisclosure(icon="link", label="Add a computer", detail="", open=pairOpen, disabled=busy, press=togglePair, elementId="welcome-add-computer", testId="welcome-add-computer")
        if pairOpen
          column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-bottom="0.75rem" box-sizing="border-box" gap="0.75rem"
            column width="100%" gap="0.5rem"
              text "Pairing link" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              input id="welcome-pairing-link" value=link input=editLink submit=pair placeholder="https://your-server:5230/pair#token=…" class=FieldPlaceholder aria-label="Pairing link" autocorrect="off" spellcheck="false" disabled=busy testId="welcome-pairing-link" width="100%" height="2.25rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" line-height="1.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(error != "" ? "light-dark(#e40014, #ff6467)" : "light-dark(#d4d4d8, #ffffff1c)") background-color="light-dark(#ffffff, #ffffff09)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)" data-focus-stop=(busy ? "" : "enabled") data-editable="yes"
            if error != ""
              row width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4001433, #ff646733)" background-color="light-dark(#e400140d, #ff64670f)" align-items="flex-start" role="alert" testId="welcome-pairing-error"
                PgIcon(name="circle-x", size=16, color="light-dark(#e40014, #ff6467)")
                text error flex=1 min-width=0 font-size="0.875rem" line-height="1.25rem" color="light-dark(#e40014, #ff6467)"
            row width="100%" min-height="2rem" align-items="center" justify-content="space-between" gap="0.75rem"
              button id="welcome-pairing-help" press=toggleHelp aria-expanded=helpOpen testId="welcome-pairing-help" padding=0 gap="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" data-focus-stop="enabled"
                PgIcon(name=(helpOpen ? "chevron-down" : "chevron-right"), size=14, color="light-dark(#71717b, #a1a1a1)")
                text "Need a pairing link?" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              WelcomePrimary(label=(busy ? "Pairing..." : "Pair"), icon="", disabled=(busy or link.trim() == ""), press=pair, elementId="welcome-pair", testId="welcome-pair")
            if helpOpen
              column width="100%"
                text "Run this on the computer with your code." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
                WelcomeCommand(command="npx t3 pair", copied=view.commandCopied, local=local)
                row margin-top="0.5rem" flex-wrap="wrap" align-items="baseline"
                  text "Start T3 Code first, or run " font-size="0.75rem" line-height="1.21875rem" white-space="pre" color="light-dark(#71717b, #a1a1a1)"
                  text "npx t3 serve" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #a1a1a1)"
                  text ". Add " font-size="0.75rem" line-height="1.21875rem" white-space="pre" color="light-dark(#71717b, #a1a1a1)"
                  text "--tailscale" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #a1a1a1)"
                  text " to use your tailnet." font-size="0.75rem" line-height="1.21875rem" white-space="pre" color="light-dark(#71717b, #a1a1a1)"
      if view.skipped != ""
        text view.skipped font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" margin-top="1rem" role="status" testId="welcome-skipped"
      row width="100%" margin-top="1.5rem" justify-content="flex-end" align-items="center" gap="0.75rem"
        WelcomePrimary(label="Continue", icon="arrow-right", disabled=(not view.ready or busy), press=setup, elementId="welcome-continue", testId="welcome-continue")

// CollapsibleTrigger as Button ghost sm: glyph, label, status, a chevron that turns.
component WelcomeDisclosure
  props
    icon: string
    label: string
    detail: string
    open: bool
    disabled: bool
    press: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button id=elementId press=press hover=hover disabled=disabled aria-expanded=open testId=testId width="100%" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" data-focus-stop=(disabled ? "" : "enabled")
      PgIcon(name=icon, size=16, color="light-dark(#71717b, #a1a1a1)")
      text label flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
      if detail != ""
        text detail font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
      PgIcon(name=(open ? "chevron-down" : "chevron-right"), size=16, color="light-dark(#71717b, #a1a1a1)")

// CommandBlock: "$ command" in mono with its copy button: MorphIcon Copy ↔ Check (#123), the
// check from a copy until the root clears it 1.5 s later (useCopyToClipboard's timeout; welcomeCopyDone, app.contract).
component WelcomeCommand
  inject
    still: bool
    welcomeCopyDone: number
  props
    command: string
    copied: number
    local: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row width="100%" margin-top="0.5rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" gap="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#f4f4f580, #ffffff04)" align-items="center" justify-content="space-between"
      row min-width=0 align-items="baseline"
        text "$" margin-right="0.5rem" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
        text command font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1
      button id="welcome-copy-command" press=local("copy-command", "", command) hover=hover aria-label="Copy command" testId="welcome-copy-command" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 position="relative" title="" data-focus-stop="enabled"
        box testId=(copied > 0 and copied != welcomeCopyDone ? "welcome-copy-command-check" : "welcome-copy-command-icon")
          MorphCopyCheck(on=(copied > 0 and copied != welcomeCopyDone), size=14, color="light-dark(#71717b, #a1a1a1)", weight=2, still=still)

// AgentsStep: one section per computer; Codex accounts first, then Claude.
component WelcomeAgents
  props
    scheme: string
    view: WelcomeView
    busy: bool
    local: action
    go: action
    chatgpt: action
    setupOp: action
    setupBusy: bool
    ui: action
  view
    column width="100%" testId="welcome-agents"
      // AgentsStep's Continue has `autoFocus`: the focus moves to it as the step mounts.
      DialogOpenFocus(target=(busy ? "" : "welcome-agents-continue"))
      WelcomeTitle(title="Connect your agents", description="Choose an agent to start coding. You can add more later.")
      column width="100%" margin-top="1.25rem" padding-right="0.75rem" box-sizing="border-box" gap="1.25rem"
        for machine in view.machines key=machine.key
          column width="100%"
            text machine.label margin-bottom="0.5rem" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
            column width="100%" gap="0.375rem"
              for agent in machine.agents key=agent.key
                if agent.codex.length > 0
                  for setup in agent.codex key=setup.key
                    CodexWelcomeCard(setup=setup, busy=setupBusy, op=setupOp, ui=ui)
                else
                  WelcomeAgentCard(agent=agent, machine=machine.key, busy=busy, local=local)
            if machine.terminal.open
              WelcomeSetup(terminal=machine.terminal, scheme=scheme, local=local)
            if machine.chatgpt
              row margin-top="0.75rem"
                WelcomeGhost(terminalIcon=false, label="Connect another ChatGPT account", small=true, disabled=busy, press=chatgpt, elementId="", testId="welcome-another-chatgpt")
      row width="100%" margin-top="1.5rem" justify-content="flex-end"
        WelcomePrimary(label="Continue", icon="arrow-right", disabled=busy, press=go("import"), elementId="welcome-agents-continue", testId="welcome-agents-continue")

component WelcomeAgentCard
  props
    agent: WelcomeAgent
    machine: string
    busy: bool
    local: action
  view
    row width="100%" padding="1rem" box-sizing="border-box" gap="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#fcfcfc, #000000)" align-items="center" testId=`welcome-agent-${agent.key}`
      if agent.driver == "codex"
        ProviderMark(driver="codex", size=20, color="light-dark(#18181b, #f5f5f5)")
      else
        DriverMark(driver=agent.driver, size=20, initials="", icon="")
      column flex=1 min-width=0 gap="0.125rem"
        text agent.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role=(agent.kind == "codex-setup" ? "heading" : "none") aria-level=3
        text agent.summary font-size="0.75rem" line-height="1.21875rem" color="light-dark(#71717b, #a1a1a1)"
      if agent.kind == "codex-setup"
        row flex-shrink=0 gap="0.5rem" align-items="center"
          WelcomeGhost(terminalIcon=false, label="Use existing CLI", small=false, disabled=busy, press=local("codex-mode", agent.instanceId, "existing"), elementId="", testId="welcome-codex-existing")
          button press=local("codex-mode", agent.instanceId, "managed") disabled=busy testId="welcome-codex-chatgpt" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" box-shadow="inset 0 1px 0 #ffffff29" display="flex" flex-direction="row" align-items="center"
            ProviderMark(driver="codex", size=16, color="#ffffff")
            text "Continue with ChatGPT" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="#ffffff" white-space="nowrap"
      if agent.kind == "card" and agent.state == "ready"
        row flex-shrink=0 gap="0.375rem" align-items="center"
          PgIcon(name="check", size=14, color="light-dark(#007a55, #00d492)")
          text "Ready" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#007a55, #00d492)"
      if agent.kind == "card" and (agent.state == "install" or agent.state == "signIn")
        WelcomeGhost(label=agent.badge, small=true, terminalIcon=true, disabled=(busy or agent.terminalOpen or not agent.terminalAvailable), press=local("terminal-open", machine, agent.key), elementId="", testId=`welcome-terminal-${agent.key}`)
      if agent.kind == "card" and agent.state != "ready" and agent.state != "install" and agent.state != "signIn"
        text agent.badge flex-shrink=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"

// ImportStep: the scan, the candidates as checkboxes, then skip or import.
component WelcomeImport
  props
    view: WelcomeView
    busy: bool
    local: action
    finish: action
  view
    column width="100%" testId="welcome-import"
      if view.scanning or view.step != "import"
        column width="100%" min-height="10rem"
          text "Your projects" font-size="1.5rem" line-height="2rem" font-weight=600 letter-spacing=-0.6 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=1
          column flex=1 width="100%" padding-top="1.5rem" padding-bottom="1.5rem" align-items="center" justify-content="center" gap="0.75rem"
            PgIcon(name="refresh-cw", size=20, color="light-dark(#71717b, #a1a1a1)")
            text "Looking for projects from Claude Code and Codex…" font-size="0.875rem" line-height="1.25rem" text-align="center" color="light-dark(#71717b, #a1a1a1)"
          row width="100%" justify-content="flex-end"
            WelcomeGhost(terminalIcon=false, label="Do not import projects", small=false, disabled=false, press=finish, elementId="welcome-skip-import", testId="welcome-skip-import")
      else
        WelcomeTitle(title="Import your projects", description="Import projects and conversations from Claude Code and Codex on your selected computers.")
        if view.candidateCount > 0
          row width="100%" margin-top="1.25rem" align-items="center" justify-content="space-between" gap="0.75rem"
            text view.selectionLabel font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="status"
            row gap="0.25rem" align-items="center"
              WelcomeGhost(terminalIcon=false, label="Select all", small=true, disabled=(view.importing or view.selectedCount == view.candidateCount), press=local("pick-all", "", ""), elementId="", testId="welcome-select-all")
              WelcomeGhost(terminalIcon=false, label="Select none", small=true, disabled=(view.importing or view.selectedCount == 0), press=local("pick-none", "", ""), elementId="", testId="welcome-select-none")
        // One group per computer (a fieldset with its label as legend when there are several), each with its own state.
        column width="100%" margin-top="0.5rem" gap="1.25rem"
          for scan in view.scans key=scan.key
            column width="100%" min-width=0 gap="0.125rem" role="group" aria-label=(view.legend ? scan.label : "") testId=`welcome-scan-${scan.key}`
              if view.legend
                text scan.label margin-bottom="0.5rem" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" testId=`welcome-scan-legend-${scan.key}`
              if scan.error != ""
                row width="100%" align-items="center" justify-content="space-between" gap="0.75rem" role="alert"
                  text `Could not check projects. ${scan.error}` font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              if scan.empty
                text "No existing Claude Code or Codex projects found." padding-top="0.5rem" padding-bottom="0.5rem" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              if scan.truncated
                text "Scan limit reached. Some projects or conversations may be missing." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="status"
              for candidate in scan.candidates key=candidate.key
                WelcomeCandidateRow(candidate=candidate, importing=view.importing, local=local)
        row width="100%" margin-top="1.5rem" flex-wrap="wrap" justify-content="flex-end" align-items="center" gap="0.75rem"
          WelcomeGhost(terminalIcon=false, label="Do not import projects", small=false, disabled=(view.importing or busy), press=finish, elementId="welcome-skip-import", testId="welcome-skip-import")
          WelcomePrimary(label=view.importLabel, icon="", disabled=(view.importing or busy or view.selectedCount == 0), press=local("import", "", ""), elementId="welcome-import", testId="welcome-import")

component WelcomeCandidateRow
  props
    candidate: WelcomeCandidate
    importing: bool
    local: action
  view
    button press=local("pick", candidate.key, "") disabled=importing role="checkbox" aria-checked=candidate.selected testId=`welcome-candidate-${candidate.key}` width="100%" min-height="2.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" gap="0.625rem" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
      box width="1rem" height="1rem" flex-shrink=0 box-sizing="border-box" border-radius="0.25rem" border-width=(candidate.selected ? 0 : 1) border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color=(candidate.selected ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#fcfcfc, #000000)") display="flex" align-items="center" justify-content="center"
        if candidate.selected
          PgIcon(name="check", size=12, color="#ffffff")
      column flex=1 min-width=0 gap="0.125rem"
        text candidate.title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" text-align="left" line-clamp=1
        row min-width=0 width="100%"
          text candidate.parent flex-shrink=1 min-width=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" text-align="left" line-clamp=1
          text candidate.path flex-shrink=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" text-align="left" white-space="nowrap"
      text candidate.detail flex-shrink=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"

component WelcomeSetup
  props
    scheme: string
    terminal: WelcomeSetupTerminal
    local: action
  // Every message of the setup terminal page (its boot and ticket, its exit, its links), its posts taken and its menu's rows.
  action pageMessage(message: string)
    local("terminal-page", terminal.environmentId, message)
  action pageTicket(message: string)
    local("terminal-page:ticket", terminal.environmentId, message)
  action pagePosted(key: string)
    local("terminal-page", terminal.environmentId, `{"type":"posted","key":"${key}"}`)
  action pageMenu(value: string)
    local("terminal-page-menu", terminal.environmentId, value)
  view
    column width="100%" margin-top="1rem" border-radius="0.5rem" overflow="hidden" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#fcfcfc, #000000)" testId="welcome-setup-terminal"
      row padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" gap="0.25rem" align-items="center" border-bottom-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0f)"
        text terminal.status flex=1 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        if terminal.retry
          WelcomeGhost(terminalIcon=false, label="Retry", small=true, disabled=false, press=local("terminal-retry", terminal.environmentId, ""), elementId="", testId="welcome-terminal-retry")
        WelcomeGhost(terminalIcon=false, label="Close", small=true, disabled=false, press=local("terminal-close", terminal.environmentId, ""), elementId="", testId="welcome-terminal-close")
      box height="16rem" width="100%" display="flex"
        if terminal.ready
          for key in [terminal.terminalId] key=key
            TerminalFrame(frame=terminal.frame, theme=(scheme == "dark" ? terminal.dark : terminal.light), font=terminal.face, visible=true, keybindings="[]", closePending=false, focusRequest=1, message=pageMessage, ticket=pageTicket, posted=pagePosted, pick=pageMenu, label=`Install ${terminal.driver}`, testId="welcome-terminal-view")
