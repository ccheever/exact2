// The provider marks of the settings routes, over the generated provider-icons.contract.
use ProviderMark from "../shared/icons.contract"
use AcpRegistryGlyph, ClaudeDriverMark, CursorDriverMark, GrokDriverMark, OpenCodeDriverMark, PiDriverMark, MuseDriverMark from "./provider-icons.contract"

// T3's ProviderInstanceIcon marks (Icons.tsx), drawn at `size` in the
// driver's own colors; unknown drivers fall back to initials. An ACP Registry
// instance draws its registry icon (`icon`, acp-icons.ts) over the ACP glyph.
component DriverMark
  props
    driver: string
    size: number
    initials: string
    icon: string
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` display="flex" align-items="center" justify-content="center" flex-shrink=0
      if driver == "codex"
        ProviderMark(driver="codex", size=size, color="light-dark(#27272acc, #f5f5f5cc)")
      if driver == "claudeAgent"
        ClaudeDriverMark(size=size)
      if driver == "cursor"
        CursorDriverMark(size=size)
      if driver == "grok"
        GrokDriverMark(size=size)
      if driver == "opencode"
        OpenCodeDriverMark(size=size)
      if driver == "antigravity"
        image "assets/provider-antigravity.png" width=`${size / 16}rem` height=`${size / 16}rem` object-fit="contain" aria-hidden=true
      if driver == "muse"
        MuseDriverMark(size=size)
      if driver == "pi"
        PiDriverMark(size=size)
      if driver == "acpRegistry"
        AcpRegistryAgentIcon(icon=icon, size=size, color="light-dark(#000000, #ffffff)")
      if driver != "codex" and driver != "claudeAgent" and driver != "cursor" and driver != "grok" and driver != "opencode" and driver != "antigravity" and driver != "pi" and driver != "muse" and driver != "acpRegistry"
        text initials font-size="0.4375rem" font-weight=600 line-height=1 color="light-dark(#27272a, #f5f5f5)"

// AcpRegistryAgentIcon (settings/AcpRegistryIcon.tsx:73-170): the ACP glyph until the registry
// image loads, and again when it fails (an SVG is a load error on Apple, #121); the monochrome
// glyph is tinted to the theme. No URL draws the glyph alone.
component AcpRegistryAgentIcon
  props
    icon: string
    size: number
    color: string
  state loaded = ""
  state failed = ""
  action didLoad
    loaded = icon
  action didFail(message: string)
    failed = icon
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 testId=(icon == "" ? "acp-icon-fallback" : `acp-icon-${loaded == icon ? "loaded" : failed == icon ? "failed" : "loading"}`)
      if icon == "" or loaded != icon
        AcpRegistryGlyph(size=size, color=color)
      if icon != "" and failed != icon
        image icon width=`${size / 16}rem` height=`${size / 16}rem` object-fit="contain" aria-hidden=true -exact-tint-color=color load=didLoad error=didFail position=(loaded == icon ? "relative" : "absolute") left=0 top=0 visibility=(loaded == icon ? "visible" : "hidden")
