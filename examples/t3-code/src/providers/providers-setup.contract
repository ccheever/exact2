use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
// Provider setup rows (T3 Code 1e2ecbd975, MIT; see LICENSE-T3):
// ProviderAuthenticationSection.tsx (the Account row), ProviderSetupSection.tsx
// (Antigravity's Environment and Runtime rows), ProviderWizardAuthenticationStep.tsx
// and ProviderStatusBanner's InlineButton. The view models are provider-auth.ts and
// provider-install.ts; every command is `op("setup:<what>", instance, token, value)`,
// sent through the root's queue mutation (provider-setup.ts). `busy` is that
// mutation in flight, the reference's per-row `pending`.
use PvGroup from "../settings/providers-kit.contract"
use PvRow from "../settings/providers-kit.contract"
use PvField from "../settings/providers-kit.contract"
use PvOutline from "../settings/providers-kit.contract"
use PvIconButton from "../settings/providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use CnTooltip from "../settings/settings-b-kit.contract"
use CnMenu from "../settings/settings-b-kit.contract"
use CnMenuItem from "../settings/settings-b-kit.contract"
use CnGlyph from "../settings/settings-b-kit.contract"
use RedactedText from "../shared/redacted-text.contract"
use AppConfirm from "../shell/shell-panels.contract"
use CodexSetup from "./codex-setup.contract"
use KmItem from "../shared/menu-keys.contract"
use TerminalFrame, TerminalFrameView from "../terminal/terminal-frame.contract"

shape ProviderAuthMethod
  id: string
  name: string
shape ProviderCredentialField
  index: number
  name: string
  label: string
  secret: bool
shape ProviderAccount
  instanceId: string
  key: string
  description: string
  email: string
  emailPlaceholder: string
  status: string
  disabled: bool
  token: string
  draftId: string
  methods: ProviderAuthMethod[]
  pickMethod: bool
  url: string
  docsUrl: string
  showCancel: bool
  showStart: bool
  startLabel: string
  startDisabled: bool
  showSignOut: bool
  signOutDisabled: bool
  signOutTitle: string
  signOutBody: string
  details: bool
  deviceCode: string
  terminal: bool
  flow: string
  output: string
  offset: number
  frame: TerminalFrameView // the sign-in terminal page (provider-auth-terminal.ts)
  credentials: ProviderCredentialField[]
  callback: bool
  formKey: string
  error: string
shape ProviderRuntime
  key: string
  statusMessage: string
  progressValue: number
  progressMax: number
  message: string
  customNote: bool
  unavailableNote: bool
  token: string
  showCancel: bool
  cancelDisabled: bool
  showInstall: bool
  installDisabled: bool
  installLabel: string
  showRemove: bool
  removeDisabled: bool
  removeTitle: string
  removeBody: string
  pendingLabel: string
  error: string
  showRetry: bool
shape ProviderSetupView
  kind: string
  environmentLabel: string
  mode: string
  showEnable: bool
  runtime: ProviderRuntime[]
  account: ProviderAccount[]
  codex: CodexSetup[]
  cursorNote: string
shape ProviderWizardAuth
  instanceId: string
  account: ProviderAccount[]
  discovering: bool
  signedIn: bool
  active: bool
  description: string
  docsUrl: string

// A wizard's optional account is a singleton in providerWizardAuth (provider-auth.ts).
fn wizardCredentialStops(auth: ProviderWizardAuth): string[] = match auth.account.at(0) { case some(account) => account.credentials.map(field => `wizard-provider-auth-credential-${account.instanceId}-${field.name}`), case none => [] }

// InlineButton (ui/button.tsx inlineButtonVariants, tone default): medium weight,
// foreground, no wrap, underlined on hover; its text size is the sentence's.
component ProviderSetupLink
  props
    label: string
    fontSize: string
    lineHeight: string
    testId: string
    press: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    button press=press hover=hover testId=testId cursor="pointer" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.125rem" flex-shrink=0 id=testId data-focus-stop="enabled"
      text label font-size=fontSize line-height=lineHeight font-weight=500 white-space="nowrap" text-decoration=(over ? "underline" : "none") color="light-dark(#18181b, #f5f5f5)"

// An outline "sm" button (Open browser, Sign in, Open docs, Install …).
component SetupButton
  props
    label: string
    disabled: bool
    full: bool
    testId: string
    press: action
    stop: string // its focus word when enabled: "enabled page" on a Settings page, "enabled" elsewhere
  view
    button id=testId data-focus-stop=(disabled ? "" : stop) press=press class=PvOutline disabled=disabled width=(full ? "100%" : "auto") opacity=(disabled ? 0.64 : 1) testId=testId
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color="light-dark(#18181b, #f5f5f5)"

// One SettingsRow's frame (px-4, py-3, or pt-3 pb-1 with children under it); the
// rows put their title, description, status and control inside it.
component SetupRowFrame
  props
    divided: bool
    tight: bool
    testId: string
  slot
  view
    column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom=(tight ? "0.25rem" : "0.75rem") border-top-style="solid" border-top-width=(divided ? 1 : 0) border-color="light-dark(#e3e3e780, #ffffff0a)" testId=testId
      children

// ProviderAuthenticationSection: "Account" with its status, the sign-in controls and,
// under the row, the device code, the sign-in terminal, the credentials form, the
// paste-redirect form and the row's error. `idPrefix` keeps its element ids its own: the
// Add provider dialog shows the instance Settings › Providers shows behind it, and a
// popovertarget or a focus() that names a shared id reaches the row behind the dialog.
component ProviderAccountRow
  props
    account: ProviderAccount
    scheme: string
    wide: bool
    divided: bool
    busy: bool
    op: action
    askSignOut: action
    idPrefix: string
    stop: string // its focus word when enabled: "enabled page" on a Settings page, "enabled" in a dialog
  state methodId = ""
  state copyOver = false
  action pickMethod(value: string)
    methodId = value
  action copyHover(inside: bool)
    copyOver = inside
  // The real trigger owns opening focus for the sign-in method menu.
  derive menuItems = [KmItem(id=`${idPrefix}provider-auth-method-${account.instanceId}-default`, label="Provider default")].concat(account.methods.map((method) => KmItem(id=`${idPrefix}provider-auth-method-${account.instanceId}-${method.id}`, label=method.name)))
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`${idPrefix}provider-auth-method-${account.instanceId}-menu`, source=`${idPrefix}provider-auth-method-${account.instanceId}`)
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  action authEvent(message: string)
    op("setup:auth-event", account.instanceId, "", message, true)
  action authTicket(message: string)
    op("setup:auth-ticket", account.instanceId, "", message, true)
  action authPosted(key: string)
    op("setup:auth-event", account.instanceId, "", `{"type":"posted","key":"${key}"}`, true)
  action authMenu(value: string)
    op("setup:auth-event", account.instanceId, "", "{\"type\":\"menu\"}", true)
  derive off = account.disabled or busy
  derive methodLabel = account.methods.filter((m) => m.id == methodId).map((m) => m.name).join("")
  derive methodValue = (methodLabel == "" ? "" : methodId)
  view
    SetupRowFrame(divided=divided, tight=account.details, testId=`${idPrefix}provider-account-${account.instanceId}`)
      row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
        column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
          row min-height="1.25rem" align-items="center"
            text "Account" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3 autofocus=(idPrefix == "wizard-")
          if account.email != ""
            row max-width="36rem" min-width=0 gap="0.25rem" align-items="baseline" flex-wrap="wrap"
              text "Signed in as" font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)"
              RedactedText(stop=stop, value=account.email, placeholder=account.emailPlaceholder, label="Toggle account email visibility", revealTip="Click to reveal email", hideTip="Click to hide email", testId=`${idPrefix}provider-email-${account.instanceId}`)
          else
            text account.description max-width="42rem" text-wrap="balance" font-size="0.75rem" line-height="1.125rem" role="status" color="light-dark(#71717b, #a1a1a1)" testId=`${idPrefix}provider-account-description-${account.instanceId}`
          if account.status != ""
            text account.status padding-top="0.125rem" font-size="0.75rem" line-height="1rem" role="status" color="light-dark(#71717b, #a1a1a1)" testId=`${idPrefix}provider-account-message-${account.instanceId}`
        row flex-shrink=0 min-width=0 gap="0.375rem" align-items="center" flex-wrap="wrap" justify-content=(wide ? "flex-end" : "flex-start")
          if account.pickMethod
            box position="relative" flex-shrink=0
              button popovertarget=`${idPrefix}provider-auth-method-${account.instanceId}-menu` key=triggerKey role="combobox" aria-label="Sign-in method" disabled=off testId=`${idPrefix}provider-auth-method-${account.instanceId}` display="flex" flex-direction="row" align-items="center" gap="0.25rem" width="11rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff08)" opacity=(off ? 0.64 : 1) id=`${idPrefix}provider-auth-method-${account.instanceId}` data-focus-stop=(off ? "" : stop)
                text (methodLabel == "" ? "Provider default" : methodLabel) font-size="0.875rem" line-height="1.25rem" flex=1 min-width=0 line-clamp=1 text-align="left" color="light-dark(#18181b, #f5f5f5)"
                CnGlyph(name="chevron-down", size=14, color="light-dark(#71717b, #a1a1a1)")
              CnMenu(menuId=`${idPrefix}provider-auth-method-${account.instanceId}-menu`, invoker=`${idPrefix}provider-auth-method-${account.instanceId}`, label="Sign-in method", width=176, area="none", items=menuItems, keyed=0)
                CnMenuItem(keysId=`${idPrefix}provider-auth-method-${account.instanceId}-menu-keys`, label="Provider default", menuId=`${idPrefix}provider-auth-method-${account.instanceId}-menu`, itemId=`${idPrefix}provider-auth-method-${account.instanceId}-default`, destructive=false, disabled=false, radio=false, highlighted=(methodValue == ""), note="", icon="", submenu="", choose=pickMethod(""))
                for method in account.methods key=method.id
                  CnMenuItem(keysId=`${idPrefix}provider-auth-method-${account.instanceId}-menu-keys`, label=method.name, menuId=`${idPrefix}provider-auth-method-${account.instanceId}-menu`, itemId=`${idPrefix}provider-auth-method-${account.instanceId}-${method.id}`, destructive=false, disabled=false, radio=false, highlighted=(method.id == methodValue), note="", icon="", submenu="", choose=pickMethod(method.id))
          if account.url != ""
            SetupButton(stop=stop, label="Open browser", disabled=off, full=false, testId=`${idPrefix}provider-auth-open-${account.instanceId}`, press=op("setup:auth-open", account.instanceId, account.draftId, "", true))
            box position="relative" flex-shrink=0 hover=copyHover
              button press=op("setup:auth-copy", account.instanceId, account.draftId, "", true) class=PvIconButton width="1.75rem" height="1.75rem" disabled=off opacity=(off ? 0.64 : 1) aria-label="Copy sign-in link" testId=`${idPrefix}provider-auth-copy-${account.instanceId}` title="" id=`${idPrefix}provider-auth-copy-${account.instanceId}` data-focus-stop=(off ? "" : stop)
                PvIcon(name="copy", size=14, color="light-dark(#71717b, #a1a1a1)")
              if copyOver
                CnTooltip(tip="Copy sign-in link", tipId=`${idPrefix}provider-auth-copy-tip-${account.instanceId}`, above=32)
          if account.docsUrl != ""
            link href=account.docsUrl class=PvOutline testId=`${idPrefix}provider-auth-docs-${account.instanceId}` id=`${idPrefix}provider-auth-docs-${account.instanceId}` data-focus-stop=stop
              text "Open docs" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
          if account.showCancel
            button press=op("setup:auth-cancel", account.instanceId, account.token, "", true) class=PvOutline border-width=0 background-color="#00000000" disabled=off opacity=(off ? 0.64 : 1) aria-label="Cancel sign-in" testId=`${idPrefix}provider-auth-cancel-${account.instanceId}` id=`${idPrefix}provider-auth-cancel-${account.instanceId}` data-focus-stop=(off ? "" : stop)
              text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)"
          if account.showStart
            SetupButton(stop=stop, label=account.startLabel, disabled=(account.startDisabled or busy), full=false, testId=`${idPrefix}provider-sign-in-${account.instanceId}`, press=op("setup:auth-start", account.instanceId, account.token, methodValue, true))
          if account.showSignOut
            button press=askSignOut id=`${idPrefix}provider-sign-out-${account.instanceId}` class=PvOutline border-width=0 background-color="#00000000" disabled=(account.signOutDisabled or busy) opacity=(account.signOutDisabled or busy ? 0.64 : 1) testId=`${idPrefix}provider-sign-out-${account.instanceId}` data-focus-stop=((account.signOutDisabled or busy) ? "" : stop)
              text "Sign out" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
      if account.details
        column width="100%"
          if account.deviceCode != ""
            row padding-top="0.5rem" padding-bottom="0.5rem" gap="0.25rem" align-items="baseline" flex-wrap="wrap" testId=`${idPrefix}provider-auth-device-code-${account.instanceId}`
              text "Enter code" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              text account.deviceCode font-family="ui-monospace" user-select="all" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
              text "in your browser." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
          if account.terminal
            for key in [account.flow] key=key
              column padding-top="0.5rem" padding-bottom="0.5rem"
                // ProviderAuthTerminal: the surface is not focused as it opens (no focus request).
                box height="16rem" width="100%" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" overflow="hidden" display="flex"
                  TerminalFrame(frame=account.frame, theme=(scheme == "dark" ? "{\"dark\":true}" : "{\"dark\":false}"), font="{\"size\":13}", visible=true, keybindings="[]", closePending=false, focusRequest=0, message=authEvent, ticket=authTicket, posted=authPosted, pick=authMenu, label="Provider sign-in terminal", testId="provider-auth-terminal")
          if account.credentials.length > 0
            for key in [account.formKey] key=key
              ProviderCredentialsForm(stop=stop, account=account, off=off, op=op, idPrefix=idPrefix)
          if account.callback
            for key in [account.formKey] key=key
              ProviderCallbackForm(stop=stop, account=account, off=off, op=op, idPrefix=idPrefix)
          if account.error != ""
            text account.error padding-top="0.5rem" padding-bottom="0.5rem" font-size="0.75rem" line-height="1rem" role="alert" color="light-dark(#fb2c36, #fb414a)" testId=`${idPrefix}provider-auth-error-${account.instanceId}`

// The credentials form (an ACP `env_var` method): one field per advertised value,
// password-type when secret; Connect sends them; the drafts belong to this flow.
component ProviderCredentialsForm
  props
    idPrefix: string
    account: ProviderAccount
    off: bool
    op: action
    stop: string // its focus word when enabled: "enabled page" on a Settings page, "enabled" elsewhere
  state f0 = ""
  state f1 = ""
  state f2 = ""
  state f3 = ""
  state f4 = ""
  state f5 = ""
  state f6 = ""
  state f7 = ""
  state f8 = ""
  state f9 = ""
  state f10 = ""
  state f11 = ""
  state f12 = ""
  state f13 = ""
  state f14 = ""
  state f15 = ""
  action set(index: number, value: string)
    if index == 0
      f0 = value
    if index == 1
      f1 = value
    if index == 2
      f2 = value
    if index == 3
      f3 = value
    if index == 4
      f4 = value
    if index == 5
      f5 = value
    if index == 6
      f6 = value
    if index == 7
      f7 = value
    if index == 8
      f8 = value
    if index == 9
      f9 = value
    if index == 10
      f10 = value
    if index == 11
      f11 = value
    if index == 12
      f12 = value
    if index == 13
      f13 = value
    if index == 14
      f14 = value
    if index == 15
      f15 = value
  // The values in field order, each URI-encoded and joined by "&" (provider-setup.ts decodes them).
  derive values = [f0, f1, f2, f3, f4, f5, f6, f7, f8, f9, f10, f11, f12, f13, f14, f15].map((v) => encodeURIComponent(v)).join("&")
  view
    column width="100%" gap="0.5rem" padding-top="0.5rem" padding-bottom="0.5rem" align-items="flex-start" testId=`${idPrefix}provider-auth-credentials-${account.instanceId}`
      for field in account.credentials key=field.name
        column width="100%" gap="0.25rem"
          text field.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
          input value=(field.index == 0 ? f0 : field.index == 1 ? f1 : field.index == 2 ? f2 : field.index == 3 ? f3 : field.index == 4 ? f4 : field.index == 5 ? f5 : field.index == 6 ? f6 : field.index == 7 ? f7 : field.index == 8 ? f8 : field.index == 9 ? f9 : field.index == 10 ? f10 : field.index == 11 ? f11 : field.index == 12 ? f12 : field.index == 13 ? f13 : field.index == 14 ? f14 : f15) input=set(field.index) submit=op("setup:auth-credentials", account.instanceId, account.draftId, values, not off) type=(field.secret ? "password" : "text") autocomplete="off" autocorrect="off" spellcheck="false" maxlength=16384 aria-label=field.label class=PvField width="100%" disabled=off testId=`${idPrefix}provider-auth-credential-${account.instanceId}-${field.name}` id=`${idPrefix}provider-auth-credential-${account.instanceId}-${field.name}` data-focus-stop=(off ? "" : stop) data-editable="yes"
      SetupButton(stop=stop, label="Connect", disabled=off, full=false, testId=`${idPrefix}provider-auth-connect-${account.instanceId}`, press=op("setup:auth-credentials", account.instanceId, account.draftId, values, true))

// The paste-redirect form: a browser flow that accepts its callback (or the flow's own
// authorization URL) takes the final localhost page's URL; Continue completes the flow.
component ProviderCallbackForm
  props
    idPrefix: string
    account: ProviderAccount
    off: bool
    op: action
    stop: string // its focus word when enabled: "enabled page" on a Settings page, "enabled" elsewhere
  state callback = ""
  action edit(value: string)
    callback = value
  view
    column width="100%" gap="0.5rem" padding-top="0.5rem" padding-bottom="0.5rem" align-items="flex-start" testId=`${idPrefix}provider-auth-callback-form-${account.instanceId}`
      column width="100%" gap="0.25rem"
        text "If the final localhost page does not load, paste its full URL here." font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
        input value=callback input=edit submit=op("setup:auth-callback", account.instanceId, account.draftId, callback, not off and callback.trim() != "") type="url" autocomplete="off" autocorrect="off" spellcheck="false" maxlength=16384 aria-label="If the final localhost page does not load, paste its full URL here." class=PvField width="100%" disabled=off testId=`${idPrefix}provider-callback-${account.instanceId}` id=`${idPrefix}provider-callback-${account.instanceId}` data-focus-stop=(off ? "" : stop) data-editable="yes"
      SetupButton(stop=stop, label="Continue", disabled=(off or callback.trim() == ""), full=false, testId=`${idPrefix}provider-auth-continue-${account.instanceId}`, press=op("setup:auth-callback", account.instanceId, account.draftId, callback, true))

// ProviderSetupActions' Runtime row: status, byte progress, notes, Install/Update/
// Reinstall/Retry or Cancel installation, and the Remove icon (it confirms first).
component ProviderRuntimeRow
  props
    runtime: ProviderRuntime
    instanceId: string
    wide: bool
    busy: bool
    op: action
    ui: action
    stop: string // its focus word when enabled: "enabled page" on a Settings page, "enabled" elsewhere
  state removeOver = false
  action removeHover(inside: bool)
    removeOver = inside
  view
    SetupRowFrame(divided=true, tight=false, testId=`provider-runtime-${instanceId}`)
      row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
        column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
          row min-height="1.25rem" align-items="center"
            text "Runtime" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
          text "Install and manage Antigravity." max-width="42rem" text-wrap="balance" font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)"
          if runtime.customNote or runtime.unavailableNote
            column gap="0.5rem" padding-top="0.125rem"
              if runtime.customNote
                text "Uses the custom binary path below. Installation keeps that path." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              if runtime.unavailableNote
                text "Automatic installation unavailable. Set a binary path or use another environment." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        column flex-shrink=0 width=(wide ? "14rem" : "100%") min-width=0 gap="0.5rem" align-items="stretch"
          text runtime.statusMessage min-height="1rem" font-size="0.75rem" line-height="1rem" text-align=(wide ? "right" : "left") font-variant-numeric="tabular-nums" role="status" color="light-dark(#71717b, #a1a1a1)" testId=`provider-runtime-status-${instanceId}`
          // `<div className="h-1">` around `<progress aria-label="Antigravity download" value max>`, a rounded muted
          // track with a primary fill drawn in system colours: the platform's determinate bar (AppKit's
          // NSProgressIndicator, which takes no tint, LLP 1116 D8), which says its value, minimum and maximum itself.
          box width="100%" height="0.25rem"
            if runtime.progressMax > 0
              progress value=runtime.progressValue max=runtime.progressMax aria-label="Antigravity download" display="block" width="100%" height="0.25rem" accent-color="light-dark(#1b4ed8, #346bf1)" testId=`provider-runtime-progress-${instanceId}`
          if runtime.message != ""
            text runtime.message font-size="0.75rem" line-height="1rem" text-align=(wide ? "right" : "left") color="light-dark(#71717b, #a1a1a1)" testId=`provider-runtime-message-${instanceId}`
          row width="100%" min-height="1.75rem" gap="0.5rem" align-items="center"
            box width="1.75rem" height="1.75rem" flex-shrink=0 position="relative" hover=removeHover
              if runtime.showRemove
                button press=ui("setup-remove", instanceId) id=`provider-runtime-remove-${instanceId}` class=PvIconButton width="1.75rem" height="1.75rem" disabled=(runtime.removeDisabled or busy) opacity=(runtime.removeDisabled or busy ? 0.64 : 1) aria-label="Remove downloaded runtime" testId=`provider-runtime-remove-${instanceId}` title="" data-focus-stop=(runtime.removeDisabled or busy ? "" : stop)
                  PvIcon(name="trash", size=14, color="light-dark(#18181b, #f5f5f5)")
                if removeOver
                  CnTooltip(tip="Remove downloaded runtime", tipId=`provider-runtime-remove-tip-${instanceId}`, above=32)
            column flex=1 min-width=0
              if runtime.showCancel
                SetupButton(stop=stop, label="Cancel installation", disabled=(runtime.cancelDisabled or busy), full=true, testId=`provider-runtime-cancel-${instanceId}`, press=op("setup:install-cancel", instanceId, runtime.token, "", true))
              if runtime.showInstall
                SetupButton(stop=stop, label=runtime.installLabel, disabled=(runtime.installDisabled or busy), full=true, testId=`provider-runtime-install-${instanceId}`, press=op("setup:install-start", instanceId, runtime.token, "", true))

// ProviderSetupSection (Antigravity): Environment, then "Setup unavailable" (read-only),
// "Update required" (an environment without setup), or Runtime and Account with the
// screen-reader pending text and the error with "Retry setup status".
component ProviderAntigravitySetup
  props
    setup: ProviderSetupView
    instanceId: string
    scheme: string
    wide: bool
    busy: bool
    op: action
    ui: action
  view
    column width="100%" role="region" aria-label="Antigravity setup" testId=`provider-antigravity-setup-${instanceId}`
      SetupRowFrame(divided=false, tight=false, testId=`provider-environment-${instanceId}`)
        row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
          column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center"
              text "Environment" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
            text "Device that runs this provider." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)"
          column flex-shrink=0 min-width=0 gap="0.5rem" align-items=(wide ? "flex-end" : "flex-start")
            text setup.environmentLabel font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
            if setup.showEnable
              SetupButton(stop="enabled page", label="Enable Antigravity", disabled=busy, full=false, testId=`provider-enable-antigravity-${instanceId}`, press=op("provider-enabled", instanceId, "", "true", true))
      if setup.mode == "unavailable"
        PvRow(title="Setup unavailable", description="Provider setup is read-only.", status="", policy="", wide=wide, divided=true)
      if setup.mode == "update"
        PvRow(title="Update required", description="Update this environment to manage Antigravity.", status="", policy="", wide=wide, divided=true)
      for runtime in setup.runtime key=runtime.key
        ProviderRuntimeRow(stop="enabled page", runtime=runtime, instanceId=instanceId, wide=wide, busy=busy, op=op, ui=ui)
        for account in setup.account key=account.key
          ProviderAccountRow(stop="enabled page", account=account, scheme=scheme, wide=wide, divided=true, busy=busy, op=op, askSignOut=ui("setup-logout", instanceId), idPrefix="")
        // ProviderSetupSection's sr-only `<p role="status">`: polite by its role since main #457
        // (issues/closed/20261009-macos-role-modal-accessibility.md; the explicit `aria-live` that stood in for it went,
        // here and on the runtime and account status).
        text runtime.pendingLabel font-size=1 height=1 overflow="hidden" color="#00000000" role="status"
        if runtime.error != ""
          column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.5rem" align-items="flex-start" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)"
            text runtime.error font-size="0.75rem" line-height="1rem" role="alert" color="light-dark(#fb2c36, #fb414a)" testId=`provider-setup-error-${instanceId}`
            if runtime.showRetry
              SetupButton(stop="enabled page", label="Retry setup status", disabled=false, full=false, testId=`provider-setup-retry-${instanceId}`, press=op("setup:retry", instanceId, "", "", true))

// The Sign out and Remove confirmations (ensureLocalApi().dialogs.confirm → ConfirmDialogHost),
// over the window. Cancel and Escape send nothing and return focus to the opening control.
component ProviderSetupConfirm
  props
    what: string
    instanceId: string
    title: string
    body: string
    busy: bool
    op: action
    ui: action
  action accept
    ui("close", "")
    op(what == "setup-logout" ? "setup:auth-logout" : "setup:install-remove", instanceId, "", "", true)
  action cancel
    ui("close", "")
    focus(what == "setup-logout" ? `provider-sign-out-${instanceId}` : `provider-runtime-remove-${instanceId}`)
  view
    AppConfirm(confirmLabel="Confirm", title=title, body=body, destructive=false, busy=busy, confirmId="provider-setup-confirm", cancel=cancel, confirm=accept)

// ProviderWizardAuthenticationStep's panel: the Account row once the created agent
// can sign in (or is signed in), else a plain Account row.
component ProviderWizardAuthStep
  props
    auth: ProviderWizardAuth
    scheme: string
    wide: bool
    busy: bool
    op: action
    askSignOut: action
  // The step replaces the focused "Continue to sign-in" (AddProviderInstanceDialog swaps its content). Base UI's
  // DialogPopup puts the focus back in the popup (restoreFocus "popup") and Tab goes on to the step's first control.
  // Here the step's "Account" heading takes it at mount: a paragraph, no Tab stop and no ring, where Tab starts from
  // (the host's key-view loop, LLP 1088 D7.3), so the next Tab reaches the first control as there.
  view
    column width="100%" min-height="18rem" testId="acp-sign-in"
      for account in auth.account key=account.key
        ProviderAccountRow(stop="enabled", account=account, scheme=scheme, wide=wide, divided=false, busy=busy, op=op, askSignOut=askSignOut, idPrefix="wizard-")
      if auth.account.length == 0
        SetupRowFrame(divided=false, tight=false, testId=`wizard-provider-account-${auth.instanceId}`)
          row width="100%" flex-direction=(wide ? "row" : "column") gap=(wide ? "2rem" : "0.75rem") align-items=(wide ? "center" : "stretch")
            column flex-grow=(wide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
              row min-height="1.25rem" align-items="center"
                text "Account" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3 autofocus=true
              text auth.description max-width="42rem" text-wrap="balance" font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" testId=`wizard-provider-account-description-${auth.instanceId}`
            if auth.discovering
              SetupButton(stop="enabled", label="Sign in", disabled=true, full=false, testId=`wizard-provider-sign-in-${auth.instanceId}`, press=op("setup:retry", auth.instanceId, "", "", false))
            if not auth.discovering and auth.docsUrl != ""
              link href=auth.docsUrl class=PvOutline testId=`wizard-provider-auth-docs-${auth.instanceId}` id=`wizard-provider-auth-docs-${auth.instanceId}` data-focus-stop="enabled"
                text "Open docs" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
