// ProviderAccentColorPicker (ProviderCustomColorPicker /
// ProviderCustomColorPanel): a popover with the saturation/brightness plane,
// the hue slider and the hex field; "Clear color" once a color is set.
// Dragging edits locally; releasing commits the color (`release`), as the
// reference commits each change. HSV → hex is lib/color.ts hsvToHex.
//
// The plane and the slider are ui/color-picker.tsx's ColorSaturationValuePlane (variant "edge") and
// ColorHueSlider, as the theme editor's picker (theme-color-picker.contract): the plane's two stops are
// invisible and focusable inside it, as the reference's visually hidden `<input type="range" min=0
// max=100>`, each with ARIA's range values and `aria-valuetext="N%"` (LLP 1116 D8) and described by the
// plane's instructions; the hue slider is a `role="slider"` of 0–360. The first stop takes the focus as
// the popover opens (Base UI's initial focus); a drag focuses its control, as the reference's pointerdown.
// Keys, as the reference: on a stop the arrows step 2 % (10 % with Shift), Home and End go to the ends;
// on the hue the arrows step 1° (10° with Shift) and wrap. Each key commits its colour, as the reference
// commits each change; one the window drops while a command is pending (`busy`) is sent once it lands
// (the tracker by the trigger, the pattern of issues/20261009-intersection-visibility-event-design.md), so the last colour a key reached is the one saved.
use CnGlyph from "../settings/settings-b-kit.contract"

fn sbHexDigit(n: number): string = n < 1 ? "0" : n < 2 ? "1" : n < 3 ? "2" : n < 4 ? "3" : n < 5 ? "4" : n < 6 ? "5" : n < 7 ? "6" : n < 8 ? "7" : n < 9 ? "8" : n < 10 ? "9" : n < 11 ? "a" : n < 12 ? "b" : n < 13 ? "c" : n < 14 ? "d" : n < 15 ? "e" : "f"
fn sbByte(n: number): string = `${sbHexDigit(floor(n / 16))}${sbHexDigit(n - floor(n / 16) * 16)}`
// f(n) = v − v·s·max(0, min(k, 4 − k, 1)), k = (n + h/60) mod 6; r = f(5), g = f(3), b = f(1).
fn sbK(h: number, n: number): number = n + h / 60 - 6 * floor((n + h / 60) / 6)
fn sbChannel(h: number, s: number, v: number, n: number): number = floor((v - v * s * max(0, min(min(sbK(h, n), 4 - sbK(h, n)), 1))) * 255 + 0.5)
fn sbHex(h: number, s: number, v: number): string = `#${sbByte(sbChannel(h, s, v, 5))}${sbByte(sbChannel(h, s, v, 3))}${sbByte(sbChannel(h, s, v, 1))}`
fn sbArrow(k: string): bool = k == "ArrowRight" or k == "ArrowUp" or k == "ArrowLeft" or k == "ArrowDown"
fn sbUp(k: string): number = k == "ArrowRight" or k == "ArrowUp" ? 1 : -1
// ColorSaturationValuePlane's keys for one axis (0–1).
fn sbAxisKey(cur: number, k: string, shift: bool): number = k == "Home" ? 0 : (k == "End" ? 1 : min(1, max(0, cur + sbUp(k) * (shift ? 0.1 : 0.02))))

component ProviderAccentPicker
  inject
    rem: number
  props
    editorId: string
    title: string
    accent: string
    h0: number
    s0: number
    v0: number
    writable: bool
    busy: bool
    op: action
    release: action
  state h = 0
  state s = 0
  state v = 0
  state dragging = false
  state hexDraft = ""
  state hexEditing = false
  state hovered = false
  // The colour last sent; a key's colour the window dropped while busy differs from it until the landing sends it.
  state sentHex = ""
  // The focused stop or slider ("s", "v", "hue"), and whether the last input was a pointer (no focus ring then).
  state focusPart = ""
  state mouse = false
  // Enter or Space on the trigger: the popover opens from the keyboard, so its first stop shows the ring
  // (focus-visible). The trigger takes no pointer event, so a press on it still reaches the window's
  // outside-press count (the Usage page's pinned popover, usage-pooled.test.ts).
  state keyOpen = false
  action open
    dragging = false
    hexEditing = false
    focusPart = ""
    mouse = not keyOpen
    keyOpen = false
  action triggerKey(k: string)
    keyOpen = k == "Enter" or k == " "
  action dragPlane(dx: number, dy: number)
    s = min(1, max(0, (dragging ? s : s0) + dx / 224))
    v = min(1, max(0, (dragging ? v : v0) - dy / 144))
    h = dragging ? h : h0
    dragging = true
    hexEditing = false
    mouse = true
    if focusPart != "s" and focusPart != "v"
      focus(`provider-accent-${editorId}-saturation`)
  action dragHue(dx: number, dy: number)
    h = min(359.999, max(0, (dragging ? h : h0) + dx * 360 / 200))
    s = dragging ? s : s0
    v = dragging ? v : v0
    dragging = true
    hexEditing = false
    mouse = true
    if focusPart != "hue"
      focus(`provider-accent-${editorId}-hue`)
  // One colour to the instance; the window takes none while a command is pending, so it waits for `landed`.
  action commit(c: string)
    if not busy
      sentHex = c
      release(editorId, c, 0, 0)
  action letGo(vx: number, vy: number)
    commit(hex)
  // The pending command landed (the tracker is 1 wide again): a colour the picker reached since is sent.
  action landed(w: number, ht: number)
    if w < 1.5 and dragging and hex != sentHex
      commit(hex)
  action axisKey(axis: string, k: string, e: KeyboardEvent)
    mouse = false
    if sbArrow(k) or k == "Home" or k == "End"
      preventDefault()
      let hh = ch
      let ss = axis == "s" ? sbAxisKey(cs, k, e.shiftKey) : cs
      let vv = axis == "v" ? sbAxisKey(cv, k, e.shiftKey) : cv
      h = hh
      s = ss
      v = vv
      dragging = true
      hexEditing = false
      commit(sbHex(hh, ss, vv))
  action hueKey(k: string, e: KeyboardEvent)
    mouse = false
    if sbArrow(k)
      preventDefault()
      let nh = (ch + sbUp(k) * (e.shiftKey ? 10 : 1) + 360) % 360
      let ss = cs
      let vv = cv
      h = nh
      s = ss
      v = vv
      dragging = true
      hexEditing = false
      commit(sbHex(nh, ss, vv))
  action focusOn(part: string)
    focusPart = part
  action focusOff(part: string)
    if focusPart == part
      focusPart = ""
  action editHex(value: string)
    hexDraft = value
    hexEditing = true
    dragging = false
  action hover(over: bool)
    hovered = over
  derive ch = dragging ? h : h0
  derive cs = dragging ? s : s0
  derive cv = dragging ? v : v0
  derive r = sbChannel(ch, cs, cv, 5)
  derive g = sbChannel(ch, cs, cv, 3)
  derive b = sbChannel(ch, cs, cv, 1)
  derive hex = `#${sbByte(r)}${sbByte(g)}${sbByte(b)}`
  derive hueColor = `rgb(${sbChannel(ch, 1, 1, 5)}, ${sbChannel(ch, 1, 1, 3)}, ${sbChannel(ch, 1, 1, 1)})`
  // A keyboard focus draws the ring (focus-visible, ring-2 ring-offset-2 ring-offset-popover); a drag does not.
  derive planeRing = not mouse and (focusPart == "s" or focusPart == "v")
  derive hueRing = not mouse and focusPart == "hue"
  derive ring = "0 0 0 2px light-dark(#ffffff, #000000), 0 0 0 4px light-dark(#1b4ed8, #346bf1)"
  view
    box position="relative" flex-shrink=0
      // The busy tracker: 2 wide while a command is pending, back to 1 when it lands (`landed`).
      box position="absolute" left=0 top=0 width=(busy ? 2 : 1) height=1 opacity=0 pointer-events="none" inert=true aria-hidden=true resize=landed testId="provider-accent-landing"
      button press=open key=triggerKey popovertarget=`provider-accent-${editorId}` hover=hover aria-label=`${accent == "" ? "Add" : "Change"} accent color for ${title}` disabled=(not writable) testId="provider-accent" display="flex" flex-direction="row" align-items="center" justify-content="center" width="1.75rem" height="1.75rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(accent != "" ? accent : (hovered ? "light-dark(#27272914, #f5f5f514)" : "#00000000")) title="" id="provider-accent" data-focus-stop=(not writable ? "" : "enabled page")
        if accent == ""
          // Button variant="ghost-muted": muted-foreground, foreground on hover.
          CnGlyph(name="plus", size=16, color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"))
      // ProviderAccentColorPicker: PopoverPopup side="bottom" align="start" sideOffset 6, flipping near an edge.
      column id=`provider-accent-${editorId}` popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.375rem" width="14.125rem"
        column width="14.125rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffffd5, #171717d5)" box-shadow="0 16px 40px -18px #0000008c" overflow="hidden" role="dialog" aria-label="Accent color" testId="provider-accent-panel"
          column width="14rem" background-color="light-dark(#ffffff, #000000)"
            box width="14rem" height="9rem" position="relative" overflow="hidden" background-color=hueColor cursor="crosshair" pan=dragPlane panrelease=letGo touch-action="none" box-shadow=(planeRing ? ring : "none") role="group" aria-label="Accent color saturation and brightness" testId="provider-accent-plane"
              box position="absolute" left=0 top=0 right=0 bottom=0 background-image="linear-gradient(to right, #ffffff, #ffffff00)"
              box position="absolute" left=0 top=0 right=0 bottom=0 background-image="linear-gradient(to top, #000000, #00000000)"
              // The plane's sr-only instructions, which each stop's aria-describedby names.
              text "Use arrow keys to adjust the focused value. Hold Shift for larger steps. Use Home and End for the minimum and maximum. Press Tab to move between saturation and brightness." id=`provider-accent-${editorId}-instructions` position="absolute" width=1 height=1 overflow="hidden" opacity=0 pointer-events="none"
              box id=`provider-accent-${editorId}-saturation` tabindex=0 autofocus key=axisKey("s") focus=focusOn("s") blur=focusOff("s") role="slider" aria-label="Accent color saturation" aria-describedby=`provider-accent-${editorId}-instructions` aria-valuemin=0 aria-valuemax=100 aria-valuenow=(cs * 100) aria-valuetext=`${round(cs * 100)}%` position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" testId="provider-accent-saturation"
              box id=`provider-accent-${editorId}-brightness` tabindex=0 key=axisKey("v") focus=focusOn("v") blur=focusOff("v") role="slider" aria-label="Accent color brightness" aria-describedby=`provider-accent-${editorId}-instructions` aria-valuemin=0 aria-valuemax=100 aria-valuenow=(cv * 100) aria-valuetext=`${round(cv * 100)}%` position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" testId="provider-accent-brightness"
              if planeRing
                text `${focusPart == "s" ? "Saturation" : "Brightness"} ${round((focusPart == "s" ? cs : cv) * 100)}%` position="absolute" left="0.5rem" bottom="0.5rem" z-index=10 padding-left="0.375rem" padding-right="0.375rem" padding-top="0.125rem" padding-bottom="0.125rem" border-radius="0.25rem" background-color="light-dark(#ffffff, #000000)" font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)" pointer-events="none" aria-hidden=true
              box position="absolute" left=((cs * 224 - 6) * rem / 16) top=(((1 - cv) * 144 - 6) * rem / 16) width="0.75rem" height="0.75rem" box-sizing="border-box" border-radius="624.9375rem" border-width=2 border-style="solid" border-color="#ffffff" box-shadow="0 0 0 1px #0000004d, 0 1px 3px #0000004d" testId="provider-accent-plane-thumb"
            column padding="0.75rem" gap="0.75rem" box-sizing="border-box"
              box id=`provider-accent-${editorId}-hue` tabindex=0 key=hueKey focus=focusOn("hue") blur=focusOff("hue") position="relative" width="12.5rem" height="1.5rem" display="flex" align-items="center" border-radius="0.75rem" cursor="pointer" pan=dragHue panrelease=letGo touch-action="none" box-shadow=(hueRing ? ring : "none") role="slider" aria-label="Accent color hue" aria-valuemin=0 aria-valuemax=360 aria-valuenow=round(ch) testId="provider-accent-hue"
                box width="12.5rem" height="0.625rem" border-radius="624.9375rem" background-image="linear-gradient(to right, #ff0000, #ffff00, #00ff00, #00ffff, #0000ff, #ff00ff, #ff0000)" box-shadow="inset 0 0 0 1px #0000001f"
                box position="absolute" left=((ch / 360 * 200 - 8) * rem / 16) top="0.25rem" width="1rem" height="1rem" box-sizing="border-box" border-radius="624.9375rem" border-width=2 border-style="solid" border-color="#ffffff" background-color=hueColor box-shadow="0 0 0 1px #0000004d, 0 1px 3px #0000004d" testId="provider-accent-hue-thumb"
              input value=(hexEditing ? hexDraft : hex) input=editHex submit=op("provider-accent", editorId, "", hexDraft, hexEditing) aria-label="Custom hex accent color" autocorrect="off" spellcheck="false" disabled=(not writable) testId="provider-accent-hex" box-sizing="border-box" width="12.5rem" height="1.875rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff08)" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" id="field-provider-accent-hex" data-editable="yes" data-focus-stop=(not writable ? "" : "enabled")
          if accent != ""
            column padding="0.25rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)"
              // Never disabled: the press marks the command pending, and a button disabled by its
              // own press dropped its popovertarget hide (the popover stayed open over the cleared swatch).
              button press=op("provider-accent", editorId, "", "", true) popovertarget=`provider-accent-${editorId}` popovertargetaction="hide" testId="provider-accent-clear" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.375rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color="#00000000" id="provider-accent-clear" data-focus-stop="enabled"
                CnGlyph(name="x", size=14, color="light-dark(#71717b, #9a9a9a)")
                text "Clear color" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #9a9a9a)"
