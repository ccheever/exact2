use MorphLock from "../shell/shell-morph.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use PvSectionTitle from "../settings/providers-kit.contract"
use PvGroup from "../settings/providers-kit.contract"
use PvFlatGroup from "../settings/providers-kit.contract"
use PvRow from "../settings/providers-kit.contract"
use PvRemoveButton from "../settings/providers-kit.contract"
use PvField from "../settings/providers-kit.contract"
use PvOutline from "../settings/providers-kit.contract"
use PvGhost from "../settings/providers-kit.contract"
use PvIconButton from "../settings/providers-kit.contract"
use PvMicro from "../settings/providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use CnTooltip from "../settings/settings-b-kit.contract"
use providerAccentInk from "../shared/accent-ink.contract"
use hoverTipAtFrame from "../shell/hover-layer.contract"
use Tip from "../shell/shell-tip.contract"
use ProviderAccentPicker from "./settings-b-accent.contract"
use DriverMark from "./provider-icons-kit.contract"
use ProviderSetupView from "./providers-setup.contract"
use ProviderAccountRow from "./providers-setup.contract"
use ProviderAntigravitySetup from "./providers-setup.contract"
use RedactedText from "../shared/redacted-text.contract"
use ProviderAdvisory, ProviderUpdateAll, ProviderUpkeep from "./providers-upkeep.contract"
use ProviderVersionAdvisory, ProviderUpdatesAllButton, ProviderUrlAuth, AcpManagement, CustomModelEditor from "./providers-upkeep.contract"
use CodexRuntimeFields from "./codex-setup.contract"
use CodexSetupRow from "./codex-setup.contract"
use CodexRuntimeSection from "./codex-setup.contract"
use CoreRowView from "../settings/settings-rows.contract"
use CoreRow from "../settings/settings-core.contract"
use CorePalette from "../settings/settings-core-shared.contract"
use FontDiffPreview from "../shared/shapes.contract"
use SettingsPageSelect from "../settings/settings-kit.contract"
use SelectOption from "../settings/settings-kit.contract"

shape ProviderOption
  value: string
  label: string
  selected: bool
shape ProviderFieldRow
  rowKey: string
  key: string
  first: bool
  label: string
  description: string
  placeholder: string
  control: string
  value: string
  redacted: bool
  clearable: bool
  options: ProviderOption[]
shape ProviderVariable
  rowKey: string
  index: number
  name: string
  value: string
  sensitive: bool
  redacted: bool
  label: string
shape ProviderModelRow
  rowKey: string
  slug: string
  name: string
  showSlug: bool
  custom: bool
  favorite: bool
  capabilities: string
  groupLabel: string
  firstGroup: bool
  hidden: bool
  moves: bool
  canUp: bool
  canDown: bool
  pickerTip: string
  editing: bool
shape ProviderBlockKey
  key: string
shape ProviderCommandArgument
  key: string
  index: number
  value: string
shape ProviderEditorData
  localAcp: bool
  commandArgs: ProviderCommandArgument[]
  id: string
  key: string
  setup: ProviderSetupView
  nameRows: ProviderBlockKey[]
  modelBlocks: ProviderBlockKey[]
  driver: string
  title: string
  displayName: string
  placeholder: string
  accent: string
  accentH: number
  accentS: number
  accentV: number
  version: string
  enabled: bool
  icon: string
  update: ProviderAdvisory
  upkeep: ProviderUpkeep
  statusLead: string
  statusEmail: string
  statusEmailPlaceholder: string
  statusLabel: string
  statusDetail: string
  dot: string
  canDelete: bool
  canReset: bool
  known: bool
  showSetup: bool
  envFields: ProviderFieldRow[]
  fields: ProviderFieldRow[]
  codexRuntime: CodexRuntimeFields[]
  variables: ProviderVariable[]
  hasVariables: bool
  models: ProviderModelRow[]
  modelSummary: string
  bulkLabel: string
  modelPlaceholder: string
  canAddModel: bool
shape ProviderRow
  projectOverride: bool
  id: string
  first: bool
  name: string
  driver: string
  enabled: bool
  selected: bool
  version: string
  update: ProviderAdvisory
  status: string
  dot: string
  accent: string
  badge: string
  icon: string
shape ProviderHub
  id: string
  first: bool
  label: string
  description: string
shape ProviderPage
  settingsWritable: bool
  enableWritable: bool
  projectIds: string
  available: bool
  writable: bool
  message: string
  checked: string
  selectedId: string
  rows: ProviderRow[]
  editors: ProviderEditorData[]
  emptyEditor: string
  healthSeconds: string
  healthDown: string
  healthUp: string
  healthCustom: bool
  cursorUsage: bool
  macos: bool
  hubs: ProviderHub[]
  updateAll: ProviderUpdateAll
  escapeOwned: bool
  environment: string // the environment the page's reads and actions go to (providers-scope.ts): '' while Settings is closed, "-" when the scope names none
  // Advanced's settings-core rows after Health check interval (CompactIdleThreadsRow), which write to the settings scope
  // `writeScope` names, as the core pages' rows do (providers-scope.ts advancedRows).
  advanced: CoreRow[]
  writeScope: string
  codePreview: FontDiffPreview

// Settings → Providers (ProviderSettingsPanel.tsx). `width` is the page's
// content width; T3 switches to the two-pane card at a 48rem container.
component ProvidersPanel
  inject
    corePal: CorePalette
    still: bool
  props
    scheme: string
    page: ProviderPage
    width: number
    height: number
    busy: bool
    setupBusy: bool
    error: string
    select: action
    op: action
    accent: action
    ui: action
    addingUi: action
    // The "Models" block whose "Add custom model" field is open (the window holds it, so
    // Settings' Back knows whether that field is there to own Escape).
    modelAdding: string
  state healthDraft = ""
  state healthEdited = false
  action editHealth(value: string)
    healthDraft = value
    healthEdited = true
  derive wide = width >= 768
  derive cardHeight = max(512, min(704, height - 176))
  derive health = healthEdited ? healthDraft : page.healthSeconds
  state coreMenuOpen = ""
  action coreChange(row: string, part: string, value: string)
    op("settings-core", `${row}:${part}|${page.writeScope}`, "", value, true)
  // Advanced's core rows hold no slider. A slider's key action that reached `op` through here would grow past the
  // statements one action may expand to (syntax-call-size), so this only closes a menu.
  action coreSlide(row: string, part: string, value: number)
    coreMenuOpen = ""
  action coreGo(route: string)
    ui("navigate", route)
  action coreMenu(section: string, id: string)
    coreMenuOpen = (id == "" or coreMenuOpen == id) ? "" : id
  action coreMenuClose
    coreMenuOpen = ""
  view
    column width="100%" gap="2rem" testId="providers-settings"
      if not page.available
        if page.message != "" // SettingsScopeBoundary's own message stands alone (settings-core-body.contract)
          text page.message font-size="0.875rem" line-height="1.25rem" padding="2rem" color="light-dark(#71717b, #a1a1a1)" testId="providers-unavailable"
      else
        column width="100%" gap="0.625rem" id="providers" tabindex=-1
          // SettingsSection's title row: Add provider sits right after the title (titleAction); the updates and refresh
          // controls stay at the end (headerAction).
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" gap="1rem" align-items="flex-start" justify-content="space-between" box-sizing="border-box" width="100%" id="providers-scroll-target"
            row min-height="1.75rem" gap="0.25rem" align-items="center" min-width=0
              text "Providers" font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
              if page.writable
                Tip(label="Add provider", side="top", align="center", offset=28)
                  button press=ui("open", "add") class=PvIconButton aria-label="Add provider" disabled=busy testId="add-provider" id="add-provider" title="" data-focus-stop=(busy ? "" : "enabled page")
                    PvIcon(name="plus", size=14, color="light-dark(#71717b, #a1a1a1)")
            row min-height="1.75rem" min-width="1.75rem" gap="0.5rem" align-items="center" justify-content="flex-end" margin-right="-0.5rem"
              if page.updateAll.show
                ProviderUpdatesAllButton(updateAll=page.updateAll, op=op)
              button press=op("provider-refresh", "", "", "", true) class=PvGhost disabled=busy aria-label="Refresh provider status" testId="refresh-providers" id="refresh-providers" data-focus-stop=(busy ? "" : "enabled page")
                PvIcon(name="refresh", size=14, color="light-dark(#71717b, #a1a1a1)")
                text (busy ? "Refreshing providers" : page.checked) font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)"
          if not page.writable
            PvGroup()
              PvRow(title="Limited permissions", description=page.message, status="", policy="", wide=(width - 34 >= 512), divided=false)
          PvGroup()
            row width="100%" flex-direction=(wide ? "row" : "column") height=(wide ? cardHeight : "auto") testId="providers-card"
              scroll flex-shrink=0 width=(wide ? "17rem" : "100%") height=(wide ? "100%" : "auto") box-sizing="border-box" border-style="solid" border-color="light-dark(#e4e4e899, #ffffff0a)" border-top-width=0 border-left-width=0 border-right-width=(wide ? 1 : 0) border-bottom-width=(wide ? 0 : 1) background-color="light-dark(#f5f5f51a, #ffffff00)" testId="provider-list"
                column width="100%"
                  for row in page.rows key=row.id
                    row width="100%" min-height="4.5rem" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.75rem" align-items="center" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)" background-color=(row.selected ? "light-dark(#18181b0f, #f5f5f50f)" : "#00000000") testId=`provider-list-row-${row.id}`
                      // The row is one select button under its content; the advisory icon takes its own presses (pointer-events-auto).
                      box position="relative" flex=1 min-width=0 display="flex" flex-direction="row" align-items="flex-start" justify-content="flex-start" gap="0.75rem" border-radius="0.5rem" pointer-events="none" opacity=(not row.enabled and not row.selected ? 0.6 : 1)
                        button press=select(row.id) aria-label=`Select ${row.name}` aria-selected=row.selected testId=`settings-provider-${row.id}` position="absolute" left=0 top=0 right=0 bottom=0 pointer-events="auto" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" title="" id=`settings-provider-${row.id}` data-focus-stop="enabled page"
                        box width="1.25rem" height="1.25rem" position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0
                          DriverMark(driver=row.driver, size=16, initials=row.badge, icon=row.icon)
                          if row.accent != ""
                            box position="absolute" right="-0.125rem" bottom="-0.125rem" min-width="0.75rem" height="0.75rem" padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" border-radius="624.9375rem" background-color=row.accent display="flex" align-items="center" justify-content="center"
                              text row.badge font-size="0.4375rem" font-weight=600 line-height=1 color=providerAccentInk(row.accent)
                        column flex=1 min-width=0 align-items="flex-start"
                          row width="100%" min-width=0 gap="0.5rem" align-items="center"
                            text row.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 flex-shrink=1
                            if row.version != ""
                              text row.version font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" max-width="6rem" line-clamp=1 flex-shrink=0
                            if row.update.show
                              ProviderVersionAdvisory(advisory=row.update, op=op)
                          row margin-top="0.125rem" gap="0.375rem" align-items="flex-start" width="100%"
                            if row.dot != ""
                              box height="1.0625rem" display="flex" align-items="center" flex-shrink=0
                                box width="0.375rem" height="0.375rem" border-radius="624.9375rem" background-color=(row.dot == "error" ? "light-dark(#e7000b, #ff6467)" : "#fe9a00")
                            text row.status font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)" line-clamp=2 text-align="left" testId=`provider-list-status-${row.id}`
                      row height="1.25rem" display="flex" align-items="center" gap="0.25rem" flex-shrink=0
                        if row.projectOverride
                          button press=op("provider-enabled", row.id, "", "inherit", true) aria-label=`Reset ${row.name} to environment setting` disabled=(busy or not page.enableWritable) testId=`provider-inherit-${row.id}` class=PvIconButton width="1.25rem" height="1.25rem" title="Use environment setting" id=`provider-inherit-${row.id}` data-focus-stop=(busy or not page.enableWritable ? "" : "enabled page")
                            PvIcon(name="undo", size=12, color="light-dark(#71717b, #a1a1a1)")
                        button press=op("provider-enabled", row.id, "", (row.enabled ? "false" : "true"), true) role="switch" aria-checked=row.enabled aria-label=`Enable ${row.name}` disabled=(busy or not page.enableWritable) testId=`provider-enable-${row.id}` width="1.875rem" height="1.125rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(row.enabled ? "flex-end" : "flex-start") flex-shrink=0 background-color=(row.enabled ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff1c)") title="" id=`provider-enable-${row.id}` data-focus-stop=(busy or not page.enableWritable ? "" : "enabled page")
                          box width="0.875rem" height="0.875rem" border-radius="624.9375rem" background-color=(row.enabled ? "light-dark(#fcfcfc, #000000)" : "light-dark(#fcfcfc, #a1a1a1)")
                  // The list's last row opens the same wizard.
                  if page.writable
                    AddProviderRow(divided=(page.rows.length > 0), busy=busy, open=ui("open", "add"))
              scroll flex-grow=1 flex-shrink=1 flex-basis=(wide ? "0%" : "auto") min-width=0 width=(wide ? "auto" : "100%") height=(wide ? "100%" : "auto") testId="provider-editor-scroll"
                column width="100%" padding-top="1rem" padding-bottom="1rem" gap="1.5rem" box-sizing="border-box"
                  for editor in page.editors key=editor.key
                    ProviderEditor(editor=editor, scheme=scheme, rowWide=((wide ? width - 275 : width - 2) - 32 >= 512), busy=busy, setupBusy=setupBusy, writable=page.writable, settingsWritable=page.settingsWritable, error=error, op=op, accent=accent, ui=ui, addingUi=addingUi, modelAdding=modelAdding)
                  if page.editors.length == 0
                    text page.emptyEditor font-size="0.875rem" line-height="1.25rem" padding="0.5rem" color="light-dark(#71717b, #a1a1a1)"
        column width="100%" gap="0.625rem" id="usage-providers" tabindex=-1
          column width="100%" id="usage-providers-scroll-target"
            PvSectionTitle(title="Usage providers")
              if page.writable
                button id="add-usage-hub" press=ui("open", "hub") class=PvOutline height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" disabled=busy testId="add-usage-hub" data-focus-stop=(busy ? "" : "enabled page")
                  PvIcon(name="plus", size=12, color="light-dark(#18181b, #f5f5f5)")
                  text "Add hub" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
          PvGroup()
            if page.macos
              column width="100%" id="cursor-keychain-usage" tabindex=-1
                PvRow(title="Cursor account usage", description="Read your existing Cursor CLI login from macOS Keychain to show account history and monthly limits. macOS may ask you to allow access.", status="", policy="", wide=(width - 34 >= 512), divided=false)
                  button press=op("provider-cursor-usage", "", "", (page.cursorUsage ? "false" : "true"), true) role="switch" aria-checked=page.cursorUsage aria-label="Cursor account usage" disabled=(busy or not page.settingsWritable) testId="cursor-account-usage" width="1.875rem" height="1.125rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(page.cursorUsage ? "flex-end" : "flex-start") background-color=(page.cursorUsage ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff1c)") title="" id="cursor-account-usage" data-focus-stop=(busy or not page.settingsWritable ? "" : "enabled page")
                    box width="0.875rem" height="0.875rem" border-radius="624.9375rem" background-color=(page.cursorUsage ? "light-dark(#fcfcfc, #000000)" : "light-dark(#fcfcfc, #a1a1a1)")
            if page.hubs.length == 0
              PvRow(title="No hubs configured.", description="", status="", policy="", wide=(width - 34 >= 512), divided=page.macos)
            for hub in page.hubs key=hub.id
              PvRow(title=hub.label, description=hub.description, status="", policy="", wide=(width - 34 >= 512), divided=(page.macos or not hub.first))
                if page.writable
                  button id=`remove-usage-hub-${hub.id}` press=ui("hub-remove", hub.id) class=PvGhost height="1.5rem" disabled=busy testId=`remove-usage-hub-${hub.id}` data-focus-stop=(busy ? "" : "enabled page")
                    text "Remove" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Advanced")
          PvGroup()
            column width="100%" id="provider-health-check-interval" tabindex=-1
              PvRow(title="Health check interval", description="Refresh provider status, versions, and models in the background. Set to 0 to disable.", status="", policy="This interval is configured here, then the shared Background activity policy decides whether provider probes may run when the timer fires. Custom intervals appear as Advanced in Maintenance settings.", wide=(width - 34 >= 512), divided=false)
                if page.healthCustom
                  button press=op("provider-health", "", "", "reset", true) class=PvMicro aria-label="Reset provider health check interval to default" disabled=(busy or not page.settingsWritable) testId="reset-provider-health" title="" id="reset-provider-health" data-focus-stop=(busy or not page.settingsWritable ? "" : "enabled page")
                    PvIcon(name="undo", size=12, color="light-dark(#71717b, #a1a1a1)")
                row gap="0.5rem" align-items="center" flex-shrink=0 opacity=(page.settingsWritable ? 1 : 0.5)
                  row width="8rem" height="1.75rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff08)" align-items="center" role="group"
                    button press=op("provider-health", "", "", page.healthDown, true) class=PvMicro width="2.125rem" height="1.625rem" aria-label="Decrease provider health check interval" disabled=(busy or not page.settingsWritable) testId="health-decrease" title="" id="health-decrease" data-focus-stop=(busy or not page.settingsWritable ? "" : "enabled page")
                      PvIcon(name="minus", size=14, color="light-dark(#71717b, #a1a1a1)")
                    input value=health input=editHealth submit=op("provider-health", "", "", health, healthEdited) blur=op("provider-health", "", "", health, healthEdited) aria-label="Provider health check interval in seconds" disabled=(busy or not page.settingsWritable) testId="health-interval" flex=1 min-width=0 height="1.125rem" padding=0 border-width=0 background-color="#00000000" text-align="center" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" id="field-health-interval" data-editable="yes" data-focus-stop=(busy or not page.settingsWritable ? "" : "enabled page")
                    button press=op("provider-health", "", "", page.healthUp, true) class=PvMicro width="2.125rem" height="1.625rem" aria-label="Increase provider health check interval" disabled=(busy or not page.settingsWritable) testId="health-increase" title="" id="health-increase" data-focus-stop=(busy or not page.settingsWritable ? "" : "enabled page")
                      PvIcon(name="plus", size=14, color="light-dark(#71717b, #a1a1a1)")
                  text "seconds" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
            for row in page.advanced key=row.id
              CoreRowView(reduced=still, row=row, section="provider-advanced", pal=corePal, codePreview=page.codePreview, busy=busy, menu=coreMenuOpen, openMenu=coreMenu, closeMenu=coreMenuClose, change=coreChange, slide=coreSlide, navigate=coreGo)

// The selected instance's editor (ProviderInstanceCard mode="editor"). Its
// drafts are row state: they reset whenever the instance's saved value changes.
component ProviderEditor
  props
    settingsWritable: bool
    scheme: string
    editor: ProviderEditorData
    rowWide: bool
    busy: bool
    setupBusy: bool
    writable: bool
    error: string
    op: action
    accent: action
    ui: action
    addingUi: action
    modelAdding: string
  view
    column width="100%" gap="1.5rem" testId=`provider-editor-${editor.id}`
      column width="100%" gap="0.625rem"
        row min-height="1.75rem" padding-left="1rem" padding-right="1rem" gap="1rem" align-items="flex-start" justify-content="space-between" box-sizing="border-box" width="100%"
          row min-height="1.75rem" gap="0.5rem" align-items="center" min-width=0
            box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              DriverMark(driver=editor.driver, size=16, initials=editor.title, icon=editor.icon)
            text editor.title font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2 line-clamp=1
          row min-height="1.75rem" gap="0.375rem" align-items="center" justify-content="flex-end" flex-shrink=0
            if editor.version != ""
              text editor.version font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId="provider-editor-version"
            if editor.update.show
              ProviderVersionAdvisory(advisory=editor.update, op=op)
            row gap="0.25rem" align-items="center" opacity=(writable ? 1 : 0.5)
              if editor.canReset
                button press=op("provider-reset", editor.id, "", "", true) class=PvMicro aria-label=`Reset ${editor.placeholder} provider settings to default` disabled=(busy or not writable) testId="reset-provider" title="" id="reset-provider" data-focus-stop=(busy or not writable ? "" : "enabled page")
                  PvIcon(name="undo", size=12, color="light-dark(#71717b, #a1a1a1)")
              if editor.canDelete
                PvRemoveButton(label=`Delete instance ${editor.id}`, buttonId="delete-provider-instance", icon="trash", size="xs", disabled=(busy or not writable), stop="enabled page", press=op("provider-remove", editor.id, "", "", true))
        PvFlatGroup()
          for nameRow in editor.nameRows key=nameRow.key
            ProviderNameRow(editor=editor, rowWide=rowWide, busy=busy, writable=writable, op=op, accent=accent)
        if error != ""
          text error font-size="0.75rem" line-height="1rem" role="alert" padding-left="1rem" color="light-dark(#e7000b, #ff6467)" testId="provider-editor-error"
      // ProviderInstanceCard's Setup section: the `setup` slot (ProviderSettingsPanel.tsx:1066-1118), then the env fields.
      if editor.showSetup
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Setup")
          PvFlatGroup()
            if editor.setup.kind == "antigravity"
              ProviderAntigravitySetup(setup=editor.setup, instanceId=editor.id, scheme=scheme, wide=rowWide, busy=setupBusy, op=op, ui=ui)
            for codex in editor.setup.codex key=codex.key
              CodexSetupRow(stop="enabled page", setup=codex, wide=rowWide, busy=setupBusy, op=op, ui=ui, cancelled=ui("none", ""))
            if editor.setup.kind == "account"
              for account in editor.setup.account key=account.key
                ProviderAccountRow(stop="enabled page", account=account, scheme=scheme, wide=rowWide, divided=false, busy=setupBusy, op=op, askSignOut=ui("setup-logout", editor.id), idPrefix="")
            if editor.setup.cursorNote != ""
              PvRow(title="Cursor account", description=editor.setup.cursorNote, status="", policy="", wide=rowWide, divided=false)
            for field in editor.envFields key=field.rowKey
              ProviderSecretField(field=field, instance=editor.id, wide=rowWide, divided=(editor.setup.kind != ""), writable=writable, op=op)
      for runtime in editor.codexRuntime key=runtime.key
        column width="100%" opacity=(writable ? 1 : 0.5) inert=(not writable)
          CodexRuntimeSection(runtime=runtime, wide=rowWide)
      if editor.fields.length > 0 or not editor.known
        column width="100%" gap="0.625rem" opacity=(writable ? 1 : 0.5)
          PvSectionTitle(title="Runtime")
          PvFlatGroup()
            if not editor.known
              PvRow(title="Driver", description=`This instance uses ${editor.driver}, which is not available in this build. Its configuration is preserved.`, status="", policy="", wide=rowWide, divided=false)
            for field in editor.fields key=field.rowKey
              ProviderConfigField(field=field, instance=editor.id, first=field.first, wide=rowWide, writable=writable, op=op)
            if editor.localAcp
              column padding="1rem" gap="0.5rem"
                row align-items="center" justify-content="space-between"
                  text "Arguments" font-size="0.875rem" font-weight=500
                  button press=op("provider-argument-add", editor.id, "", "", true) disabled=(busy or not writable) class=PvOutline testId="provider-add-argument" id="provider-add-argument" data-focus-stop=(busy or not writable ? "" : "enabled page")
                    text "Add argument" font-size="0.8125rem"
                text "One literal argument per row, in launch order." font-size="0.75rem" color="light-dark(#71717b, #a1a1a1)"
                for arg in editor.commandArgs key=arg.key
                  ProviderCommandArgumentRow(arg=arg, instance=editor.id, writable=(writable and not busy), op=op)
      column width="100%" gap="0.625rem" opacity=(writable ? 1 : 0.5)
        PvSectionTitle(title="Environment")
        PvFlatGroup()
          column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom=(editor.hasVariables ? "0.25rem" : "0.75rem")
            row width="100%" flex-direction=(rowWide ? "row" : "column") gap=(rowWide ? "2rem" : "0.75rem") align-items=(rowWide ? "center" : "stretch")
              column flex-grow=(rowWide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
                row min-height="1.25rem" align-items="center"
                  text "Variables" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                text "API keys, base URLs, and other per-instance CLI settings." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)"
              row justify-content="flex-end"
                button press=op("provider-env-add", editor.id, "", "", true) class=PvOutline disabled=(busy or not writable) testId="add-provider-variable" id="add-provider-variable" data-focus-stop=(busy or not writable ? "" : "enabled page")
                  PvIcon(name="plus", size=12, color="light-dark(#71717b, #a1a1a1)")
                  text "Add variable" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
            if editor.hasVariables
              column width="100%" gap="0.5rem" margin-top="0.75rem" padding-bottom="0.5rem"
                for variable in editor.variables key=variable.rowKey
                  ProviderVariableRow(variable=variable, instance=editor.id, writable=writable, op=op)
                text "Sensitive values are stored separately and never returned to the app." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
          // AcpSessionManagementSection, inside the Environment section.
          for acp in editor.upkeep.acp key=acp.key
            AcpManagement(acp=acp, wide=rowWide, op=op, ui=ui)
      if editor.known
        for block in editor.modelBlocks key=block.key
          ProviderModels(editor=editor, busy=busy, writable=writable, settingsWritable=settingsWritable, op=op, ui=ui, addingUi=addingUi, blockKey=block.key, adding=(modelAdding == block.key))

// The Status and Display name rows: name draft and accent color, reset whenever either saves.
component ProviderNameRow
  props
    editor: ProviderEditorData
    rowWide: bool
    busy: bool
    writable: bool
    op: action
    accent: action
  state nameDraft = ""
  state nameEdited = false
  action editName(value: string)
    nameDraft = value
    nameEdited = true
  derive name = nameEdited ? nameDraft : editor.displayName
  view
    column width="100%"
      // Provider status gets its own row instead of hanging under the name field (ProviderInstanceCard.tsx).
      column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.25rem"
        row min-height="1.25rem" align-items="center"
          text "Status" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
        row width="100%" min-width=0 padding-top="0.125rem" gap="0.375rem" flex-wrap="wrap" align-items="baseline" testId="provider-editor-status"
          if editor.dot != ""
            box width="0.375rem" height="0.375rem" border-radius="624.9375rem" background-color=(editor.dot == "error" ? "light-dark(#e7000b, #ff6467)" : "#fe9a00")
          text editor.statusLead font-size="0.75rem" line-height="1rem" min-width=0 color="light-dark(#71717b, #a1a1a1)"
          if editor.statusEmail != ""
            RedactedText(stop="enabled page", value=editor.statusEmail, placeholder=editor.statusEmailPlaceholder, label="Toggle account email visibility", revealTip="Click to reveal email", hideTip="Click to hide email", testId=`provider-status-email-${editor.id}`)
          if editor.statusLabel != ""
            text editor.statusLabel font-size="0.75rem" line-height="1rem" min-width=0 color="light-dark(#71717b, #a1a1a1)"
          if editor.statusDetail != ""
            text editor.statusDetail font-size="0.75rem" line-height="1rem" min-width=0 flex-shrink=1 color="light-dark(#71717b, #a1a1a1)"
        // An ACP agent's browser authentication request (ProviderInstanceCard.tsx:994-1011).
        for auth in editor.upkeep.urlAuth key=auth.key
          ProviderUrlAuth(auth=auth, instanceId=editor.id, op=op)
      column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)"
        column width="100%" gap=(rowWide ? "0px" : "0.75rem")
          row width="100%" flex-direction=(rowWide ? "row" : "column") gap=(rowWide ? "2rem" : "0.75rem") align-items=(rowWide ? "center" : "stretch")
            column flex-grow=(rowWide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
              row min-height="1.25rem" align-items="center"
                text "Display name" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
            row gap="0.5rem" align-items="center" justify-content="flex-end" width=(rowWide ? "auto" : "100%") opacity=(writable ? 1 : 0.5)
              ProviderAccentPicker(editorId=editor.id, title=editor.title, accent=editor.accent, h0=editor.accentH, s0=editor.accentS, v0=editor.accentV, writable=writable, busy=busy, op=op, release=accent)
              input value=name input=editName blur=op("provider-display", editor.id, "", name, nameEdited) submit=op("provider-display", editor.id, "", name, nameEdited) placeholder=editor.placeholder aria-label="Display name" class=PvField width=(rowWide ? "14rem" : "auto") flex-grow=(rowWide ? 0 : 1) flex-shrink=(rowWide ? 0 : 1) min-width=0 disabled=(not writable) testId="provider-display-name" autocorrect="off" id="field-provider-display-name" data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")

// One driver setting (ProviderSettingsForm): commits on blur or Return.
component ProviderConfigField
  props
    field: ProviderFieldRow
    instance: string
    first: bool
    wide: bool
    writable: bool
    op: action
  state draft = ""
  state edited = false
  action edit(value: string)
    draft = value
    edited = true
  derive value = edited ? draft : field.value
  derive choices = field.options.map((option) => SelectOption(value=option.value, label=option.label, selected=option.selected))
  derive chosen = field.options.filter((option) => option.selected).map((option) => option.label).join("")
  action pick(next: string)
    op("provider-field", instance, field.key, next, true)
  view
    PvRow(title=field.label, description=field.description, status="", policy="", wide=wide, divided=(not first))
      if field.control == "select"
        // ProviderSettingsSelect: a size-sm SelectTrigger, w-56 beside the title and the row's width once it stacks, its
        // popup starting at the trigger.
        SettingsPageSelect(selectId=`provider-field-${field.key}`, label=field.label, valueLabel=chosen, empty=false, value="", width=(wide ? 224 : 0), disabled=(not writable), options=choices, choose=pick)
      else if field.control == "password"
        row width=(wide ? "14rem" : "100%") gap="0.5rem" align-items="center"
          input value=value input=edit blur=op("provider-field", instance, field.key, value, edited) submit=op("provider-field", instance, field.key, value, edited) placeholder=field.placeholder aria-label=field.label type="password" autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 disabled=(not writable) testId=`provider-field-${field.key}` id=`field-provider-field-${field.key}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")
          if field.clearable
            PvRemoveButton(label=`Clear ${field.label}`, buttonId=`clear-provider-field-${field.key}`, icon="x", size="sm", disabled=(not writable), stop="enabled page", press=op("provider-field", instance, field.key, "", true))
      else
        input value=value input=edit blur=op("provider-field", instance, field.key, value, edited) submit=op("provider-field", instance, field.key, value, edited) placeholder=field.placeholder aria-label=field.label type=(field.control == "password" ? "password" : "text") autocorrect="off" spellcheck="false" class=PvField width=(wide ? "14rem" : "auto") flex-grow=(wide ? 0 : 1) flex-shrink=(wide ? 0 : 1) min-width=0 disabled=(not writable) testId=`provider-field-${field.key}` id=`field-provider-field-${field.key}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")

// A dedicated environment secret (Cursor API key).
component ProviderSecretField
  props
    field: ProviderFieldRow
    instance: string
    wide: bool
    divided: bool
    writable: bool
    op: action
  state draft = ""
  state edited = false
  action edit(value: string)
    draft = value
    edited = true
  derive value = edited ? draft : field.value
  view
    PvRow(title=field.label, description=field.description, status="", policy="", wide=wide, divided=divided)
      row gap="0.5rem" align-items="center" width=(wide ? "14rem" : "100%")
        input value=value input=edit blur=op("provider-env-field", instance, field.key, value, edited) submit=op("provider-env-field", instance, field.key, value, edited) placeholder=field.placeholder aria-label=field.label type="password" class=PvField flex=1 min-width=0 disabled=(not writable) testId=`provider-env-${field.key}` autocorrect="off" id=`field-provider-env-${field.key}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")
        if field.clearable
          PvRemoveButton(label=`Clear ${field.label}`, buttonId=`clear-provider-env-${field.key}`, icon="x", size="sm", disabled=(not writable), stop="enabled page", press=op("provider-env-field", instance, field.key, "", true))

// One environment variable row: NAME = value, sensitivity lock, remove.
component ProviderVariableRow
  props
    variable: ProviderVariable
    instance: string
    writable: bool
    op: action
  state nameDraft = ""
  state nameEdited = false
  state valueDraft = ""
  state valueEdited = false
  action editName(value: string)
    nameDraft = value
    nameEdited = true
  action editValue(value: string)
    valueDraft = value
    valueEdited = true
  derive name = nameEdited ? nameDraft : variable.name
  derive value = valueEdited ? valueDraft : variable.value
  view
    row width="100%" min-width=0 gap="0.375rem" align-items="center" flex-wrap="wrap" testId=`provider-variable-${variable.index}`
      input value=name input=editName blur=op("provider-env-name", instance, `${variable.index}`, name, nameEdited) submit=op("provider-env-name", instance, `${variable.index}`, name, nameEdited) placeholder="VARIABLE_NAME" aria-label=`Environment variable name ${variable.index + 1}` autocorrect="off" spellcheck="false" class=PvField width="11rem" flex-shrink=0 font-family="ui-monospace" font-size="0.8125rem" disabled=(not writable) testId=`provider-variable-name-${variable.index}` id=`field-provider-variable-name-${variable.index}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")
      text "=" font-size="0.75rem" color="light-dark(#71717b, #a1a1a1)" aria-hidden=true
      input value=value input=editValue blur=op("provider-env-value", instance, `${variable.index}`, value, valueEdited) submit=op("provider-env-value", instance, `${variable.index}`, value, valueEdited) placeholder=(variable.redacted ? "Stored secret, enter a new value to replace" : "value") type=(variable.sensitive ? "password" : "text") aria-label=`Environment variable value ${variable.index + 1}` autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 font-family="ui-monospace" font-size="0.8125rem" disabled=(not writable) testId=`provider-variable-value-${variable.index}` id=`field-provider-variable-value-${variable.index}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")
      button press=op("provider-env-sensitive", instance, `${variable.index}`, (variable.sensitive ? "false" : "true"), true) class=PvMicro aria-selected=variable.sensitive aria-label=`Mark environment variable ${variable.label} as sensitive` disabled=(not writable) testId=`provider-variable-sensitive-${variable.index}` title="" id=`provider-variable-sensitive-${variable.index}` data-focus-stop=(not writable ? "" : "enabled page")
        // f2cc80a7 MorphIcon LockOpen↔Lock: the shackle closes (morphicons' morph, shell-morph.contract).
        MorphLock(on=variable.sensitive, size=12, color="light-dark(#71717b, #a1a1a1)", weight=2, still=false)
      PvRemoveButton(label=`Remove environment variable ${variable.label}`, buttonId=`provider-variable-remove-${variable.index}`, icon="x", size="micro", disabled=(not writable), stop="enabled page", press=op("provider-env-remove", instance, `${variable.index}`, "", true))

// ProviderModelsSection: count, favorites, custom-model add/remove, and the custom model
// editor (providers-upkeep.contract) under the row its pencil opened.
component ProviderModels
  props
    settingsWritable: bool
    editor: ProviderEditorData
    busy: bool
    writable: bool
    op: action
    // isAdding is the window's, held by this block's key (`ui("model-adding", blockKey)`):
    // a successful add or remove gives the block a new key, so the field closes as handleAdd's setIsAdding(false)
    // does, and the window knows whether the field is there. The slug field tells the window when it has the focus
    // (`ui("slug-focus", …)`): only then does it own Escape (its onKeyDown cancelAdd), and Back gives Escape up.
    ui: action
    // "model-adding" and "slug-focus" alone (app-settings.contract modelAddingUi): Escape's cancelAdd expands only them.
    addingUi: action
    blockKey: string
    adding: bool
  state slug = ""
  action startAdd
    slug = ""
    addingUi("model-adding", blockKey)
  action cancelAdd
    slug = ""
    addingUi("model-adding", "")
  action editSlug(value: string)
    slug = value
  action slugKey(name: string)
    if name == "Escape"
      preventDefault()
      cancelAdd()
  view
    column width="100%" gap="0.625rem" opacity=(writable or settingsWritable ? 1 : 0.5)
      PvSectionTitle(title="Models")
      PvFlatGroup()
        column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem"
          text "Model preferences and custom models are saved on the selected environment and shared across connected devices." font-size="0.75rem" line-height="1rem" margin-bottom="0.75rem" color="light-dark(#71717b, #a1a1a1)"
          row width="100%" gap="0.5rem" align-items="center" justify-content="space-between" flex-wrap="wrap"
            row gap="0.5rem" align-items="center"
              if editor.bulkLabel != ""
                button press=op("provider-model-bulk", editor.id, "", "", true) class=PvGhost disabled=(busy or not settingsWritable) testId="provider-model-bulk" id="provider-model-bulk" data-focus-stop=(busy or not settingsWritable ? "" : "enabled page")
                  text editor.bulkLabel font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)"
              text editor.modelSummary font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId="provider-model-count"
            if editor.canAddModel and not adding
              button press=startAdd class=PvGhost margin-right="-0.5rem" disabled=(busy or not writable) testId="add-custom-model" id="add-custom-model" data-focus-stop=(busy or not writable ? "" : "enabled page")
                PvIcon(name="plus", size=12, color="light-dark(#71717b, #a1a1a1)")
                text "Add custom model" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)"
          column width="100%" margin-top="0.5rem" gap=0 testId="provider-model-list"
            if editor.models.length == 0
              text "No models reported for this provider yet." font-size="0.75rem" line-height="1rem" padding-top="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717b, #a1a1a1)"
            for model in editor.models key=model.rowKey
              column width="100%"
                if model.groupLabel != ""
                  text model.groupLabel font-size="0.6875rem" line-height="1rem" padding-bottom="0.375rem" padding-top=(model.firstGroup ? "0.25rem" : "1.25rem") color="light-dark(#71717b, #a1a1a1)"
                ProviderModelLine(model=model, instanceId=editor.id, busy=busy, writable=writable, settingsWritable=settingsWritable, op=op)
                if model.editing
                  for custom in editor.upkeep.modelEditor key=custom.key
                    CustomModelEditor(editor=custom, op=op)
          if adding
            row width="100%" margin-top="0.75rem" gap="0.5rem" align-items="center"
              DialogOpenFocus(target="custom-model-slug")
              input id="custom-model-slug" value=slug input=editSlug submit=op("provider-model-add", editor.id, slug, "", true) key=slugKey focus=addingUi("slug-focus", "true") blur=addingUi("slug-focus", "") autofocus=true placeholder=editor.modelPlaceholder aria-label="Custom model slug" autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 testId="custom-model-slug" data-editable="yes" data-focus-stop="enabled page"
              button press=op("provider-model-add", editor.id, slug, "", true) class=PvOutline disabled=busy testId="custom-model-add" id="custom-model-add" data-focus-stop=(busy ? "" : "enabled page")
                text "Add" font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
              button press=cancelAdd class=PvGhost height="1.75rem" testId="custom-model-cancel" id="custom-model-cancel" data-focus-stop="enabled page"
                text "Cancel" font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"

// One ProviderModelsSection row: star, name/slug/custom, capabilities, the
// move arrows (not for hidden rows), custom edit/remove, and the picker switch.
component ProviderModelLine
  inject
    rem: number
    hoverTipAt: action
  props
    settingsWritable: bool
    model: ProviderModelRow
    instanceId: string
    busy: bool
    writable: bool
    op: action
  state tip = ""
  state over = false
  action hover(which: string, inside: bool)
    tip = inside ? which : (tip == which ? "" : tip)
  // The name's tooltip (TooltipPopup side="top" align="start") is the window's hover layer's, so the list's scroll area
  // does not cut it, a hidden row's opacity does not fade it, and it opens after Base UI's delay.
  action nameTip(inside: bool)
    hoverTipAt(hoverTipAtFrame(`provider-model-name-tip-${model.slug}`, "model-name", model.name, (model.showSlug ? [model.slug] : []), "top", "start", frame(`provider-model-name-${instanceId}-${model.slug}`), 2.5 * rem, `provider-model-name-tip-${model.slug}`), "trigger", inside)
  action hoverRow(inside: bool)
    over = inside
  view
    row width="100%" height="1.75rem" gap="0.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" border-radius="0.5rem" opacity=(model.hidden ? 0.5 : 1) background-color=(over ? "light-dark(#f4f4f54d, #ffffff08)" : "#00000000") hover=hoverRow testId=`provider-model-${model.slug}`
      box position="relative" hover=hover("star")
        button press=op("favorite-model", instanceId, model.slug, "", true) class=PvMicro disabled=(busy or not settingsWritable) aria-label=`${model.favorite ? "Remove" : "Add"} ${model.name} ${model.favorite ? "from" : "to"} favorites` testId=`provider-model-favorite-${model.slug}` title="" id=`provider-model-favorite-${model.slug}` data-focus-stop=(busy or not settingsWritable ? "" : "enabled page")
          PvIcon(name=(model.favorite ? "star-filled" : "star"), size=12, color=(model.favorite ? "#fe9a00" : "light-dark(#71717b, #a1a1a1)"))
        if tip == "star"
          CnTooltip(tip=(model.favorite ? "Remove from favorites" : "Add to favorites"), tipId=`provider-model-star-tip-${model.slug}`, above=24)
      row flex=1 min-width=0 gap="0.5rem" align-items="baseline"
        // The name keeps its width and the slug truncates first; the tooltip (hover or focus) shows both whole.
        row id=`provider-model-name-${instanceId}-${model.slug}` min-width=0 overflow="hidden" gap="0.5rem" align-items="baseline" tabindex=0 hover=nameTip focus=nameTip(true) blur=nameTip(false) testId=`provider-model-name-${model.slug}`
          text model.name font-size="0.75rem" line-height="1rem" color=(model.hidden ? "light-dark(#71717b, #a1a1a1)" : "light-dark(#18181be6, #f5f5f5e6)") line-clamp=1 max-width="100%" flex-shrink=0
          if model.showSlug
            text model.slug font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)" line-clamp=1 min-width=0
        if model.custom
          text "custom" flex-shrink=0 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)"
      text model.capabilities font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)"
      row gap="0.125rem" align-items="center" justify-content="flex-end" flex-shrink=0 min-width="5.5rem"
        if model.moves
          box position="relative" hover=hover("up")
            button press=op("provider-model-move", instanceId, model.slug, "up", true) class=PvMicro disabled=(busy or not settingsWritable or not model.canUp) opacity=(model.canUp ? 1 : 0.64) aria-label=`Move ${model.name} up` testId=`provider-model-up-${model.slug}` title="" id=`provider-model-up-${model.slug}` data-focus-stop=(busy or not settingsWritable or not model.canUp ? "" : "enabled page")
              PvIcon(name="arrow-up", size=12, color="light-dark(#71717b, #a1a1a1)")
            if tip == "up"
              CnTooltip(tip="Move up", tipId=`provider-model-up-tip-${model.slug}`, above=24)
          box position="relative" hover=hover("down")
            button press=op("provider-model-move", instanceId, model.slug, "down", true) class=PvMicro disabled=(busy or not settingsWritable or not model.canDown) opacity=(model.canDown ? 1 : 0.64) aria-label=`Move ${model.name} down` testId=`provider-model-down-${model.slug}` title="" id=`provider-model-down-${model.slug}` data-focus-stop=(busy or not settingsWritable or not model.canDown ? "" : "enabled page")
              PvIcon(name="arrow-down", size=12, color="light-dark(#71717b, #a1a1a1)")
            if tip == "down"
              CnTooltip(tip="Move down", tipId=`provider-model-down-tip-${model.slug}`, above=24)
        box position="relative" hover=hover("edit")
          button press=op("upkeep:cm-open", instanceId, model.slug, "", true) class=PvMicro aria-label=`Edit ${model.slug}` aria-expanded=model.editing disabled=(not writable) testId=`provider-model-edit-${model.slug}` title="" id=`provider-model-edit-${model.slug}` data-focus-stop=(not writable ? "" : "enabled page")
            PvIcon(name="pencil", size=12, color="light-dark(#71717b, #a1a1a1)")
          if tip == "edit"
            CnTooltip(tip="Edit name and options", tipId=`provider-model-edit-tip-${model.slug}`, above=24)
        if model.custom
          box position="relative" hover=hover("remove")
            button press=op("provider-model-remove", instanceId, model.slug, "", true) class=PvMicro aria-label=`Remove ${model.slug}` disabled=(busy or not writable) testId=`provider-model-remove-${model.slug}` title="" id=`provider-model-remove-${model.slug}` data-focus-stop=(busy or not writable ? "" : "enabled page")
              PvIcon(name="x", size=12, color="light-dark(#71717b, #a1a1a1)")
            if tip == "remove"
              CnTooltip(tip="Remove custom model", tipId=`provider-model-remove-tip-${model.slug}`, above=24)
      box position="relative" hover=hover("switch")
        button press=op("provider-model-hide", instanceId, model.slug, (model.hidden ? "false" : "true"), true) role="switch" aria-checked=(not model.hidden) aria-label=`Show ${model.name} in the model picker` disabled=(busy or not settingsWritable or model.custom) testId=`provider-model-visible-${model.slug}` width="1.625rem" height="1rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(model.hidden ? "flex-start" : "flex-end") flex-shrink=0 opacity=(model.custom ? 0.64 : 1) background-color=(model.hidden ? "light-dark(#d4d4d8, #ffffff1c)" : "light-dark(#1b4ed8, #346bf1)") title="" id=`provider-model-visible-${model.slug}` data-focus-stop=(busy or not settingsWritable or model.custom ? "" : "enabled page")
          box width="0.75rem" height="0.75rem" border-radius="624.9375rem" background-color=((not model.hidden) ? "light-dark(#fcfcfc, #000000)" : "light-dark(#fcfcfc, #a1a1a1)")
        if tip == "switch"
          CnTooltip(tip=model.pickerTip, tipId=`provider-model-switch-tip-${model.slug}`, above=20)

component ProviderCommandArgumentRow
  props
    arg: ProviderCommandArgument
    instance: string
    writable: bool
    op: action
  state value = arg.value
  action edit(text: string)
    value = text
  view
    // A row of ProviderSettingsForm's Arguments, as in Add provider: the mono field and the ghost-destructive remove.
    row width="100%" min-width=0 gap="0.375rem" align-items="center"
      input value=value input=edit blur=op("provider-argument-value", instance, `${arg.index}`, value, true) submit=op("provider-argument-value", instance, `${arg.index}`, value, true) disabled=(not writable) aria-label=`Argument ${arg.index + 1}` autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 font-family="ui-monospace" font-size="0.8125rem" testId=`provider-argument-${arg.index}` id=`field-provider-argument-${arg.index}` data-editable="yes" data-focus-stop=(not writable ? "" : "enabled page")
      PvRemoveButton(label=`Remove argument ${arg.index + 1}`, buttonId=`provider-argument-remove-${arg.index}`, icon="x", size="micro", disabled=(not writable), stop="enabled page", press=op("provider-argument-remove", instance, `${arg.index}`, "", true))

// ProviderSettingsPanel's list row "Add provider": muted until hovered (hover:bg-muted/25 hover:text-foreground).
component AddProviderRow
  props
    divided: bool
    busy: bool
    open: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=open hover=hover disabled=busy testId="add-provider-row" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.75rem" width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" border-width=0 border-top-style="solid" border-top-width=(divided ? 1 : 0) border-color="light-dark(#e3e3e780, #ffffff0a)" background-color=(over ? "light-dark(#f4f4f540, #ffffff0a)" : "#00000000") title="" id="add-provider-row" data-focus-stop=(busy ? "" : "enabled page")
      PvIcon(name="plus", size=16, color=(over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"))
      text "Add provider" font-size="0.875rem" line-height="1.25rem" text-align="left" color=(over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")
