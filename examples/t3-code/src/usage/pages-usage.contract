use kmTriggerKey, kmTriggerTarget from "../shared/menu-keys.contract"
// The Usage page, measured against the served reference at
// 1280×840 and 840×620: UsagePage's header (breadcrumb with the environment and
// provider filters, metric and period toggles or selects, refresh), the cost/tokens
// summary with the provider chart, Totals, Breakdown, and the Limits view. Figures
// still coming in are muted (figureClass). T3 Code 9c161462c9, MIT (LICENSE-T3).
use TextProbe from "../composer/composer-label-probes.contract"
use TextProbes from "../composer/composer-label-probes.contract"
use ProviderMark from "../shared/icons.contract"
use DriverMark from "../providers/provider-icons-kit.contract"
use PgIcon from "../shared/pages-icons.contract"
use AppRouteModalClose from "../shell/app-route-modal.contract"
use UsageChart from "./pages-usage-shapes.contract"
use UsageShare from "./pages-usage-shapes.contract"
use UsageModelDetail from "./pages-usage-shapes.contract"
use UsagePrices from "./pages-usage-shapes.contract"
use UsageShareBar from "./pages-usage-shapes.contract"
use ChatGptUsageButton from "../providers/codex-setup.contract"
use UsagePooled, PooledView, UsagePopups from "./usage-pooled.contract"
use HoverTip, noHoverTip from "../shell/hover-layer.contract"
use CnTooltip from "../settings/settings-b-kit.contract"
use KmItem from "../shared/menu-keys.contract"
use KeyMenu from "../shared/menu-keys.contract"

keyframes usageSpin
  from rotate=0
  to rotate=360

shape UsageText
  key: string
  text: string
shape UsageProviderRow
  key: string
  driver: string
  label: string
  light: string
  dark: string
  sessions: string
  value: string
  detail: string
  // Its figures are still coming in (muted); `awaiting`: it has no usage yet, so its figures hold their place.
  loading: bool
  awaiting: bool
  // A CursorEnableRow (its environment id) in place of a provider's figures.
  enable: string
  enableLabel: string
  busy: bool
shape UsageTotal
  key: string
  label: string
  value: string
shape UsageModelRow
  key: string
  rank: string
  row: number
  driver: string
  model: string
  cost: string
  share: string
  tokens: string
  unpriced: bool
  bar: number
  light: string
  dark: string
  loading: bool
shape UsageColumn
  key: string
  label: string
shape UsageCell
  key: string
  text: string
  loading: bool
shape UsagePeriodRow
  key: string
  label: string
  cells: UsageCell[]
  total: string
  tokens: string
// One environment of the filter (every connected one, and those that are not, disabled).
shape UsageEnvRow
  key: string
  label: string
  checked: bool
  disabled: bool
  status: string
// UsageProviderFilter: a provider of the menu, and the trigger's label ("All providers", "Codex", "2 providers").
shape UsageProviderOption
  key: string
  label: string
  driver: string
  checked: bool
shape UsageProviderFilter
  label: string
  all: bool
  rows: UsageProviderOption[]
shape UsageView
  // A selected environment shares a ChatGPT plan (UsagePage.tsx:543-548).
  chatgptShared: bool
  metric: string
  windowDays: number
  breakdown: string
  plotWidth: number
  // The environment menu's least width (composer-menus.ts checkMenu from the measured texts): the menu sizes to its
  // content from it.
  menuWidth: number
  // The menus' texts to measure (composer-menus.ts checkMenu).
  menuProbes: TextProbe[]
  empty: string
  error: string
  environmentLabel: string
  allSelected: bool
  environments: UsageEnvRow[]
  // UsageEnvironmentFilter's glyph: "issue" when a selected environment failed or needs an update.
  environmentIcon: string
  partial: string
  refreshing: bool
  providerFilter: UsageProviderFilter
  // The totals are still coming in: every total is muted, and the content is aria-busy.
  loading: bool
  windowLabel: string
  total: string
  sessions: string
  unpriced: string
  notices: UsageText[]
  providers: UsageProviderRow[]
  chartTitle: string
  chart: UsageChart
  totals: UsageTotal[]
  models: UsageModelRow[]
  shares: UsageShare[]
  detail: UsageModelDetail
  prices: UsagePrices
  periodLabel: string
  // The Day/Hour table's grid-template-columns (pages-usage.ts periodColumns).
  periodColumns: string
  columns: UsageColumn[]
  periods: UsagePeriodRow[]
  pooled: PooledView
  coverage: UsageText[]
shape UsageKey
  id: string
  chord: string
  kind: string
  value: string
  days: number
  label: string
  // UsagePage's shortcutTitle, "Cost (C)", "Past 24h (⇧⌘1)".
  title: string

// The `title` of a metric or period option: its label and its effective shortcut (usageKeys), or the label alone.
fn usageTitle(keys: UsageKey[], id: string, label: string): string = match first(keys.filter((k) => k.id == id)) { case some(k) => k.title, case none => label }

// figureClass: a figure still coming in is muted to 40%, after a 150 ms delay so a quick answer never flashes.
fn usageDim(loading: bool): number = loading ? 0.4 : 1
fn usageFade(loading: bool): string = loading ? "opacity 150ms cubic-bezier(0.4, 0, 0.2, 1) 150ms" : "opacity 150ms cubic-bezier(0.4, 0, 0.2, 1)"

// Whether a trigger kept at opening (`id=identity`, "" for one that is not a segment) is still drawn.
fn usageDrawn(drawn: string[], entry: string): bool = entry == "" or drawn.includes(entry)
fn usageDrawnOf(drawn: string[], id: string): string = drawn.filter((entry) => entry.startsWith(`${id}=`)).join("")

// Whether a viewport point lies in a box `frame()` read (a missing box is 0 by 0 and holds none).
fn usageHit(g: Geometry, x: number, y: number): bool = x >= g.x and x < g.x + g.width and y >= g.y and y < g.y + g.height

component UsagePage
  inject
    rem: number
    // The window's hover state (T3Window, hover-layer.contract) holds a segment's hover-opened popover.
    hoverTipAt: action
    hoverTip: HoverTip
    hoverShown: bool
  props
    page: UsageView
    keys: UsageKey[]
    scheme: string
    wide: bool
    lg: bool
    md: bool
    sm: bool
    op: action
    setMetric: action
    setWindow: action
    setBreakdown: action
    reload: action
    back: action
    // The reset credit confirm's commands report the focus back (app.contract commandCompleted).
    command: action
    // The confirm shows (PagesCover closes it for the page as it is answered).
    confirmOpen: bool
    reduced: bool
    // The window's count of presses outside this page (app-window.contract T3Window).
    outside: number
  // The pooled segments' popovers (usage-pooled.contract, drawn in the scroll content by UsagePopups): the one the
  // pointer opened (the window's hover state: segment, popover or email, then a 50 ms crossing
  // grace), else the pressed one, which holds until a press outside it (`pinnedAt` is `outside` when it was pinned);
  // at its trigger's rect in the content (x, y, w, h), taken when it opens. A press outside the page closes the
  // hover-opened one too (`hoverAt`: `outside` at the last enter), as Base UI's outside press does however it opened.
  // A popover whose segment is no longer drawn (ActiveSegmentPopover) closes at once, with no fade: each opening
  // keeps its segment's `id=identity.appearance` (`pinnedDrawn`, `hoverDrawn`, `lastDrawn`; "" for a trigger that is not a
  // segment), and a kept entry missing from `page.pooled.drawn` closes it.
  state pinned = ""
  state pinnedAt = 0
  state hoverAt = 0
  state downOutside = false
  state last = ""
  state popX = 0
  state popY = 0
  state popW = 0
  state popH = 0
  state popPlace = ""
  state pinnedDrawn = ""
  state hoverDrawn = ""
  state lastDrawn = ""
  derive held = pinnedAt == outside and usageDrawn(page.pooled.drawn, pinnedDrawn) ? pinned : ""
  derive hovered = hoverShown and hoverTip.kind == "usage" and hoverAt == outside and usageDrawn(page.pooled.drawn, hoverDrawn) ? hoverTip.key : ""
  derive shown = hovered != "" ? hovered : held
  // `trigger` "seg" or "legend": Base UI anchors the popup to the trigger that opened it; above a legend row when it
  // fits (side top), else below it.
  action place(id: string, trigger: string)
    let box = frame(`usage-${trigger}-${id}`)
    let content = frame("usage-content")
    last = id
    lastDrawn = usageDrawnOf(page.pooled.drawn, id)
    popX = box.x - content.x
    popY = box.y - content.y
    popW = box.width
    popH = box.height
    popPlace = trigger == "legend" ? (box.y - content.y >= 17 * rem ? "top" : "bottom") : ""
  action enterSeg(id: string, inside: bool)
    if inside
      place(id, "seg")
      hoverAt = outside
      hoverDrawn = usageDrawnOf(page.pooled.drawn, id)
    hoverTipAt(HoverTip(key=id, kind="usage", text="", lines=[], side="top", align="center", x=0, y=0, width=0, height=0, estimate=0, wide=0, testId=`usage-seg-pop-${id}`), "trigger", inside)
  action enterPop(id: string, inside: bool)
    hoverAt = inside ? outside : hoverAt
    hoverTipAt(HoverTip(key=id, kind="usage", text="", lines=[], side="top", align="center", x=0, y=0, width=0, height=0, estimate=0, wide=0, testId=`usage-seg-pop-${id}`), "card", inside)
  action enterMail(id: string, inside: bool)
    enterPop(id, inside)
  // A press on the popover's own trigger (Base UI's useClick): pins it, or closes it when pinned, hover-opened state
  // too, which then waits for the pointer to enter again (Base UI's blockMouseMove after a close).
  action pin(id: string)
    place(id, "seg")
    toggle(id)
  action pinLegend(id: string)
    place(id, "legend")
    toggle(id)
  action toggle(id: string)
    if held == id
      hoverTipAt(noHoverTip(), "", true)
    pinned = held == id ? "" : id
    pinnedAt = outside
    pinnedDrawn = usageDrawnOf(page.pooled.drawn, id)
  // Light dismiss (Base UI Popover's useDismiss, outsidePressEvent "intentional" for a mouse): a primary
  // press that starts outside the pinned popover's card and both its triggers (the segment, the legend
  // row), and does not end in the card, closes it as the press ends, before that press's own action; a
  // press on another segment then pins that one. Presses on the page come here and stop, so the window
  // counts only the rest (`outside`). Base UI closes it however it opened, so the hover-opened state goes too.
  action pressDown(e: PointerEvent)
    stopPropagation()
    let seg = frame(`usage-seg-${held}`)
    let pop = frame(`usage-seg-pop-${held}`)
    let leg = frame(`usage-legend-${held}`)
    downOutside = held != "" and e.buttons == 1 and not (usageHit(seg, e.clientX, e.clientY) or usageHit(pop, e.clientX, e.clientY) or usageHit(leg, e.clientX, e.clientY))
  action pressUp(e: PointerEvent)
    stopPropagation()
    let id = held
    let pop = frame(`usage-seg-pop-${id}`)
    if downOutside and not usageHit(pop, e.clientX, e.clientY)
      pinned = ""
      hoverTipAt(noHoverTip(), "", true)
    downOutside = false
  // Escape (UsageKeys' one shortcut): a showing popover closes and its segment takes the focus; else the page goes
  // back, blurring the focus first as useEscapeToGoBack does (a field of the floating theme editor keeps none).
  action escape
    if shown != ""
      focus(`usage-seg-${shown}`)
      pinned = ""
      hoverTipAt(noHoverTip(), "", true)
    else
      blur()
      back()
  action redeem(id: string)
    pinned = ""
    hoverTipAt(noHoverTip(), "", true)
    command("pageslocal:usage-pool-reset-ask", id, "", 0)
  view
    column position="absolute" left=0 top=0 right=0 bottom=0 background-color="light-dark(#fcfcfc, #000000)" inert=(page.detail.open or page.prices.open or confirmOpen) pointerdown=pressDown pointerup=pressUp testId="usage-page"
      UsageKeys(keys=keys, limits=(page.metric == "limits"), dialog=(page.detail.open or page.prices.open or confirmOpen), setMetric=setMetric, setWindow=setWindow, back=escape)
      if wide
        row width="100%" height="3rem" flex-shrink=0 padding-left="1.25rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" gap="0.75rem" position="relative" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)"
          UsageBreadcrumb(page=page, scheme=scheme, op=op)
          row margin-left="auto" align-items="center" gap="0.5rem" flex-shrink=0
            // Limits are always current, so they have no period; it sits before the metric tabs so dropping it never moves them.
            if page.metric != "limits"
              row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" background-color="light-dark(#d4d4d766, #ffffff0b)" align-items="center" role="group" aria-label="Usage period"
                Segment(label="Past 24h", title=usageTitle(keys, "usage.period.day", "Past 24h"), pressed=(page.windowDays == 1), disabled=false, press=setWindow(1), testId="usage-period-1")
                Segment(label="7 days", title=usageTitle(keys, "usage.period.week", "7 days"), pressed=(page.windowDays == 7), disabled=false, press=setWindow(7), testId="usage-period-7")
                Segment(label="30 days", title=usageTitle(keys, "usage.period.month", "30 days"), pressed=(page.windowDays == 30), disabled=false, press=setWindow(30), testId="usage-period-30")
                Segment(label="90 days", title=usageTitle(keys, "usage.period.quarter", "90 days"), pressed=(page.windowDays == 90), disabled=false, press=setWindow(90), testId="usage-period-90")
            row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" background-color="light-dark(#d4d4d766, #ffffff0b)" align-items="center" role="group" aria-label="Usage metric"
              Segment(label="Cost", title=usageTitle(keys, "usage.cost", "Cost"), pressed=(page.metric == "cost"), disabled=false, press=setMetric("cost"), testId="usage-metric-cost")
              Segment(label="Tokens", title=usageTitle(keys, "usage.tokens", "Tokens"), pressed=(page.metric == "tokens"), disabled=false, press=setMetric("tokens"), testId="usage-metric-tokens")
              Segment(label="Limits", title=usageTitle(keys, "usage.limits", "Limits"), pressed=(page.metric == "limits"), disabled=false, press=setMetric("limits"), testId="usage-metric-limits")
            UsageRefresh(limits=(page.metric == "limits"), busy=page.refreshing, reduced=reduced, reload=reload)
          // AppRouteModalClose; UsageKeys holds Escape (a showing popover closes first).
          AppRouteModalClose(closeId="close-usage", escape=false, color="light-dark(#18181b, #f5f5f5)", hoverFill="light-dark(#f4f4f5, #ffffff0a)", dismiss=back)
      else
        // Below xl the breadcrumb and the selects share the one top-bar row (WorkspacePageHeader's fixed height).
        row width="100%" height="3rem" flex-shrink=0 padding-left="1.25rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" gap="0.75rem" position="relative" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)"
          UsageBreadcrumb(page=page, scheme=scheme, op=op)
          row margin-left="auto" flex-shrink=0 justify-content="flex-end" align-items="center" gap="0.25rem"
            if page.metric != "limits"
              UsageSelect(menuId="usage-period-select", label=(page.windowDays == 1 ? "Past 24h" : page.windowDays == 7 ? "7 days" : page.windowDays == 90 ? "90 days" : "30 days"), ariaLabel="Usage period", disabled=false, scheme=scheme)
                UsageOption(menuId="usage-period-select", label="Past 24h", title=usageTitle(keys, "usage.period.day", "Past 24h"), selected=(page.windowDays == 1), press=setWindow(1))
                UsageOption(menuId="usage-period-select", label="7 days", title=usageTitle(keys, "usage.period.week", "7 days"), selected=(page.windowDays == 7), press=setWindow(7))
                UsageOption(menuId="usage-period-select", label="30 days", title=usageTitle(keys, "usage.period.month", "30 days"), selected=(page.windowDays == 30), press=setWindow(30))
                UsageOption(menuId="usage-period-select", label="90 days", title=usageTitle(keys, "usage.period.quarter", "90 days"), selected=(page.windowDays == 90), press=setWindow(90))
            UsageSelect(menuId="usage-metric-select", label=(page.metric == "cost" ? "Cost" : page.metric == "tokens" ? "Tokens" : "Limits"), ariaLabel="Usage metric", disabled=false, scheme=scheme)
              UsageOption(menuId="usage-metric-select", label="Cost", title=usageTitle(keys, "usage.cost", "Cost"), selected=(page.metric == "cost"), press=setMetric("cost"))
              UsageOption(menuId="usage-metric-select", label="Tokens", title=usageTitle(keys, "usage.tokens", "Tokens"), selected=(page.metric == "tokens"), press=setMetric("tokens"))
              UsageOption(menuId="usage-metric-select", label="Limits", title=usageTitle(keys, "usage.limits", "Limits"), selected=(page.metric == "limits"), press=setMetric("limits"))
            UsageRefresh(limits=(page.metric == "limits"), busy=page.refreshing, reduced=reduced, reload=reload)
          // AppRouteModalClose; UsageKeys holds Escape (a showing popover closes first).
          AppRouteModalClose(closeId="close-usage", escape=false, color="light-dark(#18181b, #f5f5f5)", hoverFill="light-dark(#f4f4f5, #ffffff0a)", dismiss=back)
      scroll flex=1 min-height=0 width="100%" testId="usage-scroll"
        // A press on the port's empty ground (below or beside the content) reaches the page's pointerdown and pointerup:
        // main 3998e650e passes an empty scroll port's press on to the scroll node and its ancestors (issues/closed/20261009-macos-empty-scroll-pointer.md).
        column id="usage-content" position="relative" width="100%" max-width="64rem" margin-left="auto" margin-right="auto" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="3rem" box-sizing="border-box" gap="1.5rem"
          if page.empty != ""
            text page.empty font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" testId="usage-empty"
          else
            if page.metric == "limits"
              UsagePooled(view=page.pooled, scheme=scheme, md=md, reduced=reduced, shown=shown, pinned=held, enterSeg=enterSeg, pin=pin, pinLegend=pinLegend, op=op)
              UsagePopups(view=page.pooled, shown=shown, last=(usageDrawn(page.pooled.drawn, lastDrawn) ? last : ""), pinned=held, scheme=scheme, reduced=reduced, x=popX, y=popY, w=popW, h=popH, place=popPlace, enterPop=enterPop, enterMail=enterMail, redeem=redeem)
            else
              if page.total == ""
                UsageSkeleton(lg=lg, md=md)
              else
                UsageSummary(page=page, scheme=scheme, lg=lg, md=md, sm=sm, shown=shown, setBreakdown=setBreakdown, enterSeg=enterSeg, pin=pin, op=op)
                if shown == "unpriced"
                  UnpricedPopup(text=page.unpriced, x=popX, y=popY, w=popW, enterPop=enterPop)

// WorkspaceBreadcrumb: "Usage / All environments / All providers", the environment filter menu, then the provider filter.
component UsageBreadcrumb
  inject
    dialogMenuEntered: action
  props
    page: UsageView
    scheme: string
    op: action
  state over = false
  action hover(value: bool)
    over = value
  // Keyboard opening targets the first or last enabled menu row.
  derive menuItems = [KmItem(id="usage-environment-all", label="All environments")].concat(page.environments.filter((env) => not env.disabled).map((env) => KmItem(id=`usage-environment-${env.key}`, label=env.label))).concat([KmItem(id="usage-model-prices", label="Model prices")])
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("usage-environment-menu", source="usage-environment")
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  view
    row align-items="center" gap="0.75rem" min-width=0 role="navigation" aria-label="Usage breadcrumb"
      text "Usage" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)" role="heading" aria-level=1 flex-shrink=0
      text "/" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
      column position="relative" min-width="2.5rem" flex-shrink=1
        TextProbes(probes=page.menuProbes)
        button id="usage-environment" popovertarget="usage-environment-menu" key=triggerKey hover=hover testId="usage-environment" data-focus-stop="enabled page" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.125rem" min-width=0
          text page.environmentLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" text-decoration-line=(over ? "underline" : "none") line-clamp=1
          // An alert when a selected environment failed, else the chevron (60% at rest); scan progress is in the menu.
          box width="0.875rem" height="0.875rem" flex-shrink=0 opacity=(over or page.environmentIcon != "" ? 1 : 0.6) display="flex" role=(page.environmentIcon != "" ? "img" : "none") aria-label=(page.environmentIcon == "issue" ? "Some environments could not report usage" : "") testId="usage-environment-glyph"
            if page.environmentIcon == "issue"
              svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" color="light-dark(#bb4d00, #ffb900)" aria-hidden=true
                path d="M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0"
                path d="M12 8v4"
                path d="M12 16h.01"
            else
              PgIcon(name="chevron-down", size=14, color="light-dark(#71717b, #a1a1a1)")
        // MenuPopup align="start" (UsagePage.tsx): 4 pt below the trigger's start, flipping near an edge.
        column id="usage-environment-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId="usage-environment-layer" data-dialog-return="menu" focusin=dialogMenuEntered("usage-environment-menu", "usage-environment")
          // MenuPopup sizes to its content: the measured width (10rem at least) is its least width
          // and no row truncates, where that width as the width cut a long machine name ("Morgan's MacBook Pro") at a word. Its dropdown glass
          // blurs what is under it, which the macOS presenter cannot, so the glass sits on the popover colour itself, as in
          // the pull request Code tab's menus, or the headline reads through it.
          column min-width=`${page.menuWidth / 16}rem` padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #111111)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" testId="usage-environment-menu"
            KeyMenu(menuId="usage-environment-keys", items=menuItems, keyed=0, gap="0px", modal=true)
              CheckRow(keysId="usage-environment-keys", label="All environments", status="", driver="", checked=page.allSelected, disabled=false, press=op("usage-pool-env", "", ""), testId="usage-environment-all")
              box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
              for env in page.environments key=env.key
                CheckRow(keysId="usage-environment-keys", label=env.label, status=env.status, driver="", checked=env.checked, disabled=env.disabled, press=op("usage-pool-env", env.key, ""), testId=`usage-environment-${env.key}`)
              if page.environments.length == 0
                text "No environments connected." padding="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              if page.partial != "" and page.metric != "limits"
                text page.partial padding="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              if page.coverage.length > 0 and page.metric != "limits"
                column width="100%" padding="0.5rem" gap="0.25rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" box-sizing="border-box"
                  for line in page.coverage key=line.key
                    text line.text font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
              UsageMenuItem(keysId="usage-environment-keys", label="Model prices", icon="sliders-horizontal", press=op("usage-prices-open", "", ""), menuId="usage-environment-menu", testId="usage-model-prices")
      text "/" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
      UsageProviderMenu(filter=page.providerFilter, scheme=scheme, op=op)

// UsageProviderFilter: provider visibility shared by every tab ("All providers", a provider, "2 providers",
// "No providers"); its checks keep the menu open, as closeOnClick={false} does. Stored as the hidden set.
component UsageProviderMenu
  inject
    dialogMenuEntered: action
  props
    filter: UsageProviderFilter
    scheme: string
    op: action
  state over = false
  action hover(value: bool)
    over = value
  derive menuItems = [KmItem(id="usage-provider-all", label="All providers")].concat(filter.rows.map((row) => KmItem(id=`usage-provider-${row.key}`, label=row.label)))
  action triggerKey(k: string, e: KeyboardEvent)
    if kmTriggerKey(k) and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("usage-provider-menu", source="usage-provider")
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  view
    column position="relative" min-width="2.5rem"
      button id="usage-provider" popovertarget="usage-provider-menu" key=triggerKey hover=hover data-focus-stop="enabled page" testId="usage-provider" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.125rem" min-width=0
        text filter.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" text-decoration-line=(over ? "underline" : "none") line-clamp=1
        box width="0.875rem" height="0.875rem" flex-shrink=0 opacity=(over ? 1 : 0.6) display="flex" testId="usage-provider-glyph"
          PgIcon(name="chevron-down", size=14, color="light-dark(#71717b, #a1a1a1)")
      column id="usage-provider-menu" popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId="usage-provider-layer" data-dialog-return="menu" focusin=dialogMenuEntered("usage-provider-menu", "usage-provider")
        column min-width="10rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #111111)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" testId="usage-provider-menu"
          KeyMenu(menuId="usage-provider-keys", items=menuItems, keyed=0, gap="0px", modal=true)
            CheckRow(keysId="usage-provider-keys", label="All providers", status="", driver="", checked=filter.all, disabled=false, press=op("usage-provider", "", ""), testId="usage-provider-all")
            box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)" role="separator"
            for row in filter.rows key=row.key
              CheckRow(keysId="usage-provider-keys", label=row.label, status="", driver=row.driver, checked=row.checked, disabled=false, press=op("usage-provider", "", row.key), testId=`usage-provider-${row.key}`)

// MenuCheckboxItem: a 16pt check column, then the label (and scan status).
component CheckRow
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    status: string
    // A provider's mark before the label (the provider filter), "" for none.
    driver: string
    checked: bool
    // An environment that is not connected is listed with its phase and cannot be chosen.
    disabled: bool
    press: action
    testId: string
  state lit = false
  action hover(value: bool)
    if value
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press hover=hover focus=focused(true) blur=focused(false) disabled=disabled opacity=(disabled ? 0.64 : 1) role="menuitemcheckbox" aria-checked=checked testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="1rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.25rem" border-width=0 background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
        if checked
          PgIcon(name="check", size=14, color="light-dark(#18181b, #f5f5f5)")
      if driver == "codex"
        ProviderMark(driver="codex", size=14, color="light-dark(#18181b, #f5f5f5)")
      else if driver != ""
        DriverMark(driver=driver, size=14, initials="", icon="")
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex-grow=1 flex-shrink=0 white-space="nowrap" text-align="left"
      if status != ""
        text status margin-left="0.25rem" font-size="0.75rem" line-height="1rem" color=(status == "Unavailable" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717b, #a1a1a1)") flex-shrink=0

// MenuItem: a 16pt muted glyph at 80% (pulled in 2pt), then the label; closes the menu.
component UsageMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    icon: string
    press: action
    menuId: string
    testId: string
  state lit = false
  action hover(value: bool)
    if value
      focus(testId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=testId width="100%" min-height="1.75rem" padding-left="0.375rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.375rem" border-radius="0.25rem" border-width=0 background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box opacity=0.8 display="flex"
        PgIcon(name=icon, size=16, color="light-dark(#71717b, #a1a1a1)")
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"

// ToggleGroup variant="segmented": a 24pt toggle, raised when pressed. `title` is the reference Toggle's (the
// metric and period toggles' label and shortcut): HTML's tooltip, the platform's on macOS;
// "" for none (Breakdown's toggles have no title).
component Segment
  props
    label: string
    title: string
    pressed: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    if title != ""
      button id=testId press=press hover=hover disabled=disabled data-focus-stop=(disabled ? "" : "enabled page") title=title role="radio" aria-checked=pressed testId=testId height="1.5rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(pressed ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(pressed ? "0 1px 2px #0000001a" : "none") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
        text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(pressed or (over and not disabled) ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")
    else
      button id=testId press=press hover=hover disabled=disabled data-focus-stop=(disabled ? "" : "enabled page") role="radio" aria-checked=pressed testId=testId height="1.5rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(pressed ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(pressed ? "0 1px 2px #0000001a" : "none") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
        text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(pressed or (over and not disabled) ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")

// RefreshIcon: busy and disabled while the refresh runs, the glyph turning unless motion is reduced.
component UsageRefresh
  props
    limits: bool
    busy: bool
    reduced: bool
    reload: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button id="usage-refresh" press=reload hover=hover disabled=busy data-focus-stop=(busy ? "" : "enabled page") aria-busy=busy aria-label=(limits ? "Refresh limits" : "Refresh usage") testId="usage-refresh" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(busy ? 0.64 : 1) background-color=(over and not busy ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
      box display="flex" animation=(busy and not reduced ? "usageSpin 1s linear infinite" : "none")
        PgIcon(name="refresh-cw", size=14, color="light-dark(#71717b, #a1a1a1)")

// The narrow header's SelectTrigger (size compact, ghost) and its popup.
component UsageSelect
  props
    menuId: string
    label: string
    ariaLabel: string
    disabled: bool
    scheme: string
  slot
  state over = false
  action hover(value: bool)
    over = value
  view
    column position="relative"
      button id=`${menuId}-trigger` popovertarget=menuId hover=hover disabled=disabled data-focus-stop=(disabled ? "" : "enabled page") role="combobox" aria-label=ariaLabel testId=menuId height="1.75rem" padding-left="0.6875rem" padding-right="0.1875rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
        text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap"
        PgIcon(name="chevron-down", size=12, color="light-dark(#71717b, #a1a1a1)")
      // aria-modal: Base UI's Select popup is modal, so its Escape closes it before the page's Back hears it.
      // SelectPopup align="end" alignItemWithTrigger={false}: its right edge under the trigger's, flipping near an edge.
      column id=menuId popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" aria-modal=true position="absolute" margin-top="0.25rem"
        column min-width="8rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #111111)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="listbox" aria-label=ariaLabel
          children

component UsageOption
  props
    menuId: string
    label: string
    // SelectItem's title (UsagePage shortcutTitle), as on the wide layout's toggles.
    title: string
    selected: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press popovertarget=menuId popovertargetaction="hide" hover=hover title=title role="option" aria-selected=selected width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.25rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" flex=1 text-align="left" white-space="nowrap"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center"
        if selected
          PgIcon(name="check", size=14, color="light-dark(#18181b, #f5f5f5)")

// usageShortcuts: c / t / l and ⇧⌘1–4 while the page is open, Escape to go back.
component UsageKeys
  props
    keys: UsageKey[]
    limits: bool
    dialog: bool
    setMetric: action
    setWindow: action
    back: action
  view
    box position="absolute" left=0 top=0 width=0 height=0 overflow="hidden" testId="usage-keys"
      if not dialog
        button press=back aria-keyshortcuts="Escape" aria-label="Back" tabindex=-1 testId="usage-key-back" width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
          text "Back" font-size=1
      for entry in keys key=entry.id
        if entry.kind == "metric"
          button -exact-menu="none" press=setMetric(entry.value) aria-keyshortcuts=entry.chord aria-label=entry.label tabindex=-1 testId=`usage-key-${entry.id}` width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
            text entry.label font-size=1
        if entry.kind == "window" and not limits
          button -exact-menu="none" press=setWindow(entry.days) aria-keyshortcuts=entry.chord aria-label=entry.label tabindex=-1 testId=`usage-key-${entry.id}` width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
            text entry.label font-size=1

component UsageSummary
  inject
    rem: number
  props
    page: UsageView
    scheme: string
    lg: bool
    md: bool
    sm: bool
    // The page's popover machinery (UsagePage), for the unpriced info's.
    shown: string
    setBreakdown: action
    enterSeg: action
    pin: action
    op: action
  view
    column width="100%" gap="1.5rem" aria-busy=page.loading
      for notice in page.notices key=notice.key
        text notice.text font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
      if lg
        row width="100%" gap="1.5rem" align-items="flex-start"
          column width="18rem" flex-shrink=0 gap="1.25rem"
            UsageHeadline(page=page, scheme=scheme, shown=shown, enterSeg=enterSeg, pin=pin, op=op)
          column flex=1 min-width=0 gap="0.75rem"
            text page.chartTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
            UsageChartView(chart=page.chart, width=page.plotWidth, title=page.chartTitle, scheme=scheme)
      else
        column width="100%" gap="1.5rem"
          column width="100%" gap="1.25rem"
            UsageHeadline(page=page, scheme=scheme, shown=shown, enterSeg=enterSeg, pin=pin, op=op)
          column width="100%" gap="0.75rem"
            text page.chartTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
            UsageChartView(chart=page.chart, width=page.plotWidth, title=page.chartTitle, scheme=scheme)
      column width="100%" gap="0.5rem"
        text "Totals" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
        row width="100%" flex-wrap=(md ? "nowrap" : "wrap") column-gap="1.5rem" row-gap="1rem" padding-top="0.25rem" padding-bottom="0.25rem"
          for metric in page.totals key=metric.key
            column flex=(md ? 1 : 0) flex-basis=(md ? "0px" : "auto") width=(md ? "auto" : `calc(50% - ${0.75 * rem}px)`) min-width=0 gap="0.125rem"
              text metric.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              text metric.value font-size="1rem" line-height="1.5rem" font-weight=500 font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)" opacity=usageDim(page.loading) transition=usageFade(page.loading)
      // Cost (or tokens) by type, and by speed when fast requests ran: grid gap-x-12 gap-y-8 lg:grid-cols-2.
      if page.shares.length > 0
        box width="100%" display="grid" grid-template-columns=(lg ? "repeat(2, minmax(0, 1fr))" : "minmax(0, 1fr)") column-gap="3rem" row-gap="2rem" opacity=usageDim(page.loading) transition=usageFade(page.loading) testId="usage-shares"
          for bar in page.shares key=bar.key
            UsageShareBar(bar=bar, scheme=scheme)
      column width="100%" gap="0.75rem"
        row width="100%" align-items="center" justify-content="space-between" gap="0.75rem"
          text "Breakdown" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
          row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" background-color="light-dark(#d4d4d766, #ffffff0b)" align-items="center" role="group" aria-label="Usage breakdown"
            Segment(label="Model", title="", pressed=(page.breakdown == "model"), disabled=false, press=setBreakdown("model"), testId="usage-breakdown-model")
            Segment(label=page.periodLabel, title="", pressed=(page.breakdown == "time"), disabled=false, press=setBreakdown("time"), testId="usage-breakdown-time")
        if page.breakdown == "model"
          ModelTable(page=page, scheme=scheme, sm=sm, op=op)
        else
          PeriodTable(page=page)

component UsageHeadline
  props
    page: UsageView
    scheme: string
    shown: string
    enterSeg: action
    pin: action
    op: action
  view
    column width="100%" gap="0.25rem"
      text page.total font-size="2.25rem" line-height="2.5rem" font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)" opacity=usageDim(page.loading) transition=usageFade(page.loading) testId="usage-total"
      row align-items="center" gap=0
        text page.sessions font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="pre" opacity=usageDim(page.loading) transition=usageFade(page.loading) testId="usage-sessions"
        if page.metric == "cost"
          text " · API estimate" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="pre"
        if page.unpriced != ""
          UnpricedInfo(open=(shown == "unpriced"), enter=enterSeg("unpriced"), press=pin("unpriced"))
    if page.chatgptShared
      row width="100%" align-items="center" justify-content="space-between" gap="0.5rem" testId="usage-chatgpt-shared"
        text "ChatGPT shared usage" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        ChatGptUsageButton(small=true, testId="usage-manage-usage", press=op("usage-chatgpt", "", ""), first=false)
    for provider in page.providers key=provider.key
      if provider.enable != ""
        CursorEnableRow(row=provider, scheme=scheme, op=op)
      else
        column width="100%" gap="0.25rem"
          row width="100%" justify-content="space-between" align-items="flex-end" gap="1rem"
            row min-width=0 align-items="center" gap="0.5rem"
              box width="0.5rem" height="0.5rem" border-radius="624.9375rem" flex-shrink=0 background-color=(scheme == "dark" ? provider.dark : provider.light)
              if provider.driver == "codex"
                ProviderMark(driver="codex", size=16, color="light-dark(#18181b, #f5f5f5)")
              else
                DriverMark(driver=provider.driver, size=16, initials="", icon="")
              row min-width=0 align-items="baseline" gap="0.375rem"
                text provider.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1 min-width=0
                text provider.sessions font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap" flex-shrink=0 font-variant-numeric="tabular-nums" opacity=usageDim(provider.loading) transition=usageFade(provider.loading) visibility=(provider.awaiting ? "hidden" : "visible")
            text provider.value font-size="0.875rem" line-height="1.25rem" font-weight=500 flex-shrink=0 font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)" opacity=usageDim(provider.loading) transition=usageFade(provider.loading) testId=`usage-provider-value-${provider.key}`
          // Kept while awaiting data so the row does not grow when it lands.
          text provider.detail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" opacity=usageDim(provider.loading) transition=usageFade(provider.loading) visibility=(provider.awaiting ? "hidden" : "visible")

// CursorEnableRow: Cursor's dot and mark, then "Enable" (InlineButton) with the
// Keychain copy as its tooltip; it turns on Cursor account usage on that environment.
component CursorEnableRow
  props
    row: UsageProviderRow
    scheme: string
    op: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    row width="100%" min-width=0 justify-content="space-between" align-items="center" gap="1rem" testId=`usage-cursor-row-${row.enable}`
      row min-width=0 align-items="center" gap="0.5rem"
        box width="0.5rem" height="0.5rem" border-radius="624.9375rem" flex-shrink=0 background-color=(scheme == "dark" ? row.dark : row.light)
        DriverMark(driver="cursor", size=16, initials="", icon="")
        text row.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1 min-width=0
      box position="relative" flex-shrink=0 hover=hover
        button id=`usage-cursor-row-enable-${row.enable}` press=op("usage-pool-cursor", row.enable, "") disabled=row.busy data-focus-stop=(row.busy ? "" : "enabled page") aria-busy=row.busy aria-label=row.enableLabel testId=`usage-cursor-enable-${row.enable}` padding=0 border-width=0 background-color="#00000000" opacity=(row.busy ? 0.64 : 1) display="flex"
          text "Enable" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" text-decoration-line=(over ? "underline" : "none") color="light-dark(#18181b, #f5f5f5)"
        if over
          CnTooltip(tip="Requires access to your Cursor login in macOS Keychain.", tipId=`usage-cursor-tip-${row.enable}`, above=24)

// The "Unpriced usage details" info glyph (PopoverTrigger openOnHover, InlineButton tone="muted"). Its popover is the
// page's, as a pooled segment's is: the pointer opens it after Base UI's 300 ms delay and it
// closes as the pointer leaves (the window's hover clock, kind "usage"), a press pins it until a press outside, Escape
// closes it and gives the glyph the focus. `id` is the frame the page places the popup by (`usage-seg-unpriced`).
component UnpricedInfo
  props
    open: bool
    enter: action
    press: action
  view
    button id="usage-seg-unpriced" press=press hover=enter data-focus-stop="enabled page" aria-label="Unpriced usage details" aria-expanded=open aria-haspopup="dialog" testId="usage-unpriced" margin-left="0.25rem" width="0.75rem" height="0.75rem" padding=0 border-width=0 background-color="#00000000" display="flex" title=""
      PgIcon(name="info", size=12, color="light-dark(#71717b, #a1a1a1)")

// PopoverPopup side="top" (align center, sideOffset 4) with tooltipStyle: w-fit, rounded-md, text-xs, py-1 px-2 inside
// the dropdown glass's 1pt border, shadow-md/5; "API estimate excludes 10.0% unpriced records." Drawn in the page's
// scroll content above the glyph's rect there (x, y, w), inside its placement box so the macOS host tracks the pointer on it
// (before main #327): the popover's own hover keeps it open, as Base UI's does.
component UnpricedPopup
  inject
    rem: number
  props
    text: string
    x: number
    y: number
    w: number
    enterPop: action
  view
    column position="absolute" left=(x + w / 2 - 10 * rem) width="20rem" top=0 height=y justify-content="flex-end" align-items="center" pointer-events="none" z-index=50
      column hover=enterPop("unpriced") padding-bottom="0.25rem" pointer-events="auto"
        column id="usage-seg-pop-unpriced" text-wrap="balance" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" role="dialog" aria-label="Unpriced usage details" testId="usage-seg-pop-unpriced"
          text text font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)"

// UsageProviderChart: a 56pt axis, the 224pt plot (layered areas at 12%, then
// 2pt lines), and three period labels under it.
component UsageChartView
  props
    chart: UsageChart
    width: number
    title: string
    scheme: string
  view
    column width="100%" gap="0.25rem"
      row width="100%" gap="0.5rem"
        column width="3.5rem" height="14rem" position="relative" flex-shrink=0
          if chart.labeled
            for tick in chart.ticks key=tick.key
              text tick.label position="absolute" right=0 top=(tick.top - 7) font-size="0.625rem" line-height="0.875rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)"
        box flex=1 min-width=0 height="14rem" overflow="hidden"
          svg width=width height="14rem" viewBox=`0 0 ${width} 224` role="img" aria-label=`${title} by provider` testId="usage-chart"
            for tick in chart.ticks key=tick.key
              path d=`M0 ${tick.top}H${width}` stroke=(scheme == "dark" ? "#ffffff14" : "#e4e4e7") stroke-width=1 fill="none"
            // A series still coming in is muted to 40%.
            for series in chart.series key=series.key
              path d=series.area fill=(scheme == "dark" ? series.dark : series.light) fill-opacity=(series.loading ? 0.048 : 0.12) stroke="none"
            for series in chart.series key=series.key
              path d=series.line fill="none" stroke=(scheme == "dark" ? series.dark : series.light) stroke-width=2 stroke-opacity=(series.loading ? 0.4 : 1)
      row width="100%" padding-left="4rem" box-sizing="border-box" justify-content="space-between"
        text chart.start font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #a1a1a1)"
        text chart.middle font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #a1a1a1)"
        text chart.end font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #a1a1a1)"

// Breakdown → Model (UsagePage, e8545b293b): a table laid out as a grid so the
// rank and number columns take their content and the model column the rest.
// Each row is a button over the whole row (the reference's after:inset-0
// overlay); focus or hover shows as the row's bg-muted/50 fill.
component ModelTable
  props
    page: UsageView
    scheme: string
    sm: bool
    op: action
  state hovered = ""
  action hover(rowKey: string, over: bool)
    hovered = over ? rowKey : (hovered == rowKey ? "" : hovered)
  view
    box width="100%" display="grid" grid-template-columns=(sm ? "auto minmax(0, 1fr) auto auto auto" : "auto minmax(0, 1fr) auto auto") role="table" testId="usage-model-table"
      box grid-row=1 grid-column="1 / -1" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)"
      text "#" grid-row=1 grid-column=1 padding-top="0.5rem" padding-bottom="0.5625rem" padding-right="0.75rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="columnheader"
      text "Model" grid-row=1 grid-column=2 padding-top="0.5rem" padding-bottom="0.5625rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="columnheader"
      text "Cost" grid-row=1 grid-column=3 padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="columnheader"
      if sm
        text "Share" grid-row=1 grid-column=4 padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="columnheader"
      text "Tokens" grid-row=1 grid-column=(sm ? 5 : 4) padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="columnheader"
      if page.models.length == 0
        text "No activity in this window." grid-row=2 grid-column="1 / -1" padding-top="1.5rem" padding-bottom="1.5rem" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
      for model in page.models key=model.key
        box grid-row=model.row grid-column="1 / -1" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e780, #ffffff0a)" background-color=(hovered == model.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
        text model.rank grid-row=model.row grid-column=1 align-self="center" padding-right="0.75rem" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap"
        column grid-row=model.row grid-column=2 min-width=0 padding-top="0.625rem" padding-bottom="0.6875rem"
          // A model with no bar keeps the row's height around its name (py-1).
          row align-items="center" gap="0.5rem" min-width=0 padding-top=(model.bar > 0 ? 0 : "0.25rem") padding-bottom=(model.bar > 0 ? 0 : "0.25rem")
            if model.driver == "codex"
              ProviderMark(driver="codex", size=14, color="light-dark(#18181b, #f5f5f5)")
            else
              DriverMark(driver=model.driver, size=14, initials="", icon="")
            text model.model font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" min-width=0
          if model.bar > 0
            box margin-top="0.375rem" height=2 width="100%" max-width="12rem" aria-hidden=true opacity=usageDim(model.loading) transition=usageFade(model.loading)
              box height=2 width=`${model.bar}%` min-width="0.5rem" border-radius="624.9375rem" background-color=(scheme == "dark" ? model.dark : model.light)
        text model.cost grid-row=model.row grid-column=3 align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color=(model.unpriced ? "light-dark(#71717b, #a1a1a1)" : "light-dark(#18181b, #f5f5f5)") opacity=usageDim(model.loading) transition=usageFade(model.loading)
        if sm
          text model.share grid-row=model.row grid-column=4 align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" opacity=usageDim(model.loading) transition=usageFade(model.loading)
        text model.tokens grid-row=model.row grid-column=(sm ? 5 : 4) align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" opacity=usageDim(model.loading) transition=usageFade(model.loading)
        button id=`usage-model-${model.key}` press=op("usage-model-open", "", model.key) data-focus-stop="enabled page" hover=hover(model.key) grid-row=model.row grid-column="1 / -1" aria-label=model.model testId=`usage-model-${model.key}` padding=0 border-width=0 background-color="#00000000" title=""

// Breakdown → Day / Hour (UsagePage, 805ff51e58): a table whose columns are never narrower than their
// figures (whitespace-nowrap), the period column 40% when there is room; a narrow page scrolls it
// sideways (a focusable region). Laid out as a grid so the columns line up across rows (pages-usage.ts
// periodColumns); each cell draws its row's rule and hover fill (bg-muted/50).
component PeriodTable
  props
    page: UsageView
  state hovered = ""
  action hover(rowKey: string, over: bool)
    hovered = over ? rowKey : (hovered == rowKey ? "" : hovered)
  view
    scroll id="usage-period-scroll" width="100%" overflow-x="scroll" overflow-y="hidden" role="region" aria-label="Usage breakdown by time" tabindex=0 data-focus-stop="enabled page" testId="usage-period-scroll"
      // A flex item never shrinks below its content (min-width: auto), so a grid wider than the page overflows the row and the region scrolls.
      row width="100%"
        box flex-grow=1 flex-shrink=1 flex-basis=0 display="grid" grid-template-columns=page.periodColumns role="table" testId="usage-period-table"
          text page.periodLabel padding-top="0.5rem" padding-bottom="0.5625rem" white-space="nowrap" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" role="columnheader"
          for column in page.columns key=column.key
            text column.label padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" text-align="right" white-space="nowrap" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" role="columnheader"
          text "Total" padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" text-align="right" white-space="nowrap" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" role="columnheader"
          text "Tokens" padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" text-align="right" white-space="nowrap" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" role="columnheader"
          if page.periods.length == 0
            text "No activity in this window." grid-column="1 / -1" padding-top="1.5rem" padding-bottom="1.5rem" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
          for period in page.periods key=period.key
            text period.label hover=hover(period.key) padding-top="0.5rem" padding-bottom="0.5625rem" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(hovered == period.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
            for cell in period.cells key=cell.key
              box hover=hover(period.key) padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(hovered == period.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
                text cell.text text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" opacity=usageDim(cell.loading) transition=usageFade(cell.loading)
            box hover=hover(period.key) padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(hovered == period.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
              text period.total text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)" opacity=usageDim(page.loading) transition=usageFade(page.loading)
            box hover=hover(period.key) padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(hovered == period.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
              text period.tokens text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" opacity=usageDim(page.loading) transition=usageFade(page.loading)

