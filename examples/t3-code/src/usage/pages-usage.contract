        box width="100%" display="grid" grid-template-columns=(md ? "repeat(5, minmax(0, 1fr))" : "repeat(2, minmax(0, 1fr))") column-gap="1.5rem" row-gap="1rem" padding-top="0.25rem" padding-bottom="0.25rem"
