// General → About → Mobile app, ported from T3 Code 9c161462c9 MobileAppSettingsRow.tsx (MIT, LICENSE-T3).
use CoreRow from "./settings-core.contract"
use CorePalette from "./settings-core.contract"
use SettingsGhost from "./settings-core.contract"

component MobileAppControl
  props
    row: CoreRow
    pal: CorePalette
    busy: bool
  state opened = ""
  action show(id: string)
    opened = id
  view
    row gap="0.5rem" align-items="center" flex-shrink=0 testId="mobile-app-control"
      for mark in row.qr key=mark.id
        box position="relative" flex-shrink=0
          button popovertarget=`mobile-app-${mark.id}-popup` press=show(mark.id) class=SettingsGhost gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" testId=`mobile-app-${mark.id}`
            box margin-left="-0.125rem" margin-right="-0.125rem" display="flex"
              if mark.id == "ios"
                MbAppleGlyph(size=16, color=pal.muted)
              else
                MbAndroidGlyph(size=16, color=pal.muted)
            text mark.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text white-space="nowrap"
          row id=`mobile-app-${mark.id}-popup` popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" testId=`mobile-app-${mark.id}-popup`
            column padding="1rem" gap="0.75rem" align-items="center" flex-shrink=0 box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=mark.caption
              text mark.caption font-size="0.875rem" font-weight=600 line-height="0.875rem" color=pal.text white-space="nowrap" role="heading" aria-level=2
              text "Scan with your phone camera." font-size="0.75rem" line-height="1rem" color=pal.muted white-space="nowrap"
              box width="8.75rem" height="8.75rem" padding="0.375rem" box-sizing="border-box" border-radius="0.625rem" background-color="#ffffff" flex-shrink=0
                box width="8rem" height="8rem" position="relative" background-color="#ffffff" role="img" aria-label=`${mark.caption} link` testId=`mobile-app-qr-${mark.id}`
                  if opened == mark.id
                    for cell in mark.cells key=`${cell.x}:${cell.y}`
                      box position="absolute" left=cell.x top=cell.y width=cell.w height=cell.h background-color="#000000"
              link href=mark.url class=SettingsGhost height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" testId=`mobile-app-open-${mark.id}`
                text `Open ${mark.caption}` font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text white-space="nowrap"

// Icons.tsx AppleIcon and AndroidIcon (24-unit grid, currentColor).
component MbAppleGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"
component MbAndroidGlyph
  props
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
      path d="m8 3-1-2m9 2 1-2" fill="none" stroke="currentColor" stroke-width=1.4 stroke-linecap="round"
      path d="M5 10a7 7 0 0 1 14 0H5Zm4-4a.8.8 0 1 0 0 1.6A.8.8 0 0 0 9 6Zm6 0a.8.8 0 1 0 0 1.6A.8.8 0 0 0 15 6Z" fill-rule="evenodd"
      path d="M5 11h14v7a2 2 0 0 1-2 2v2a1.5 1.5 0 0 1-3 0v-2h-4v2a1.5 1.5 0 0 1-3 0v-2a2 2 0 0 1-2-2v-7Z"
      rect x=1 y=11 width=3 height=8 rx=1.5
      rect x=20 y=11 width=3 height=8 rx=1.5
