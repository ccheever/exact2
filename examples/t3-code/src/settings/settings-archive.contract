// Settings → Archive (reference SettingsPanels.tsx ArchivedThreadsPanel): one
// section per project, newest archive first; Unarchive on each row, and the
// row's context menu (ArchiveMenu; settings-a-archive.ts runs its choice).
use SettingsSection from "./settings-kit.contract"
use SidebarMenuCard, SidebarMenuItem from "../sidebar/sidebar-row.contract"
use SettingsRow from "./settings-kit.contract"
use SettingsNotice from "./settings-kit.contract"
use LucideArchive from "./settings-icons.contract"
use LucideArchiveX from "./settings-icons.contract"

shape ArchiveThreadView
  id: string
  scope: string
  title: string
  description: string
  first: bool
shape ArchiveGroupView
  id: string
  title: string
  first: bool
  mark: string
  ink: string
  surface: string
  threads: ArchiveThreadView[]
shape ArchivePage
  available: bool
  loading: bool
  error: string
  groups: ArchiveGroupView[]

component ArchivedPanel
  props
    data: ArchivePage
    busy: bool
    error: string
    menu: string
    raw: action
    open: action
    showMenu: action
    close: action
  // The right-clicked row's scope: its `contextmenu` runs before the host shows the panel's one `archive-menu` popover.
  state menuOf = ""
  action menuFor(scope: string)
    menuOf = scope
  view
    column width="100%" gap="2rem" testId="archived-settings"
      ArchiveMenu(owner=menuOf, raw=raw)
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="archive-error" padding-left="1rem"
      if data.groups.length == 0
        SettingsSection(title="Archived threads", sectionId="archive")
          row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" testId="archive-empty"
            column flex=1 min-width=0 gap="0.375rem"
              row min-height="1.25rem" align-items="center" gap="0.5rem"
                LucideArchive(size=14, color="light-dark(#71717b, #a1a1a1)")
                text (data.loading ? "Loading archived threads" : (data.error != "" ? "Could not load archived threads" : "No archived threads")) font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              text (data.loading ? "Checking connected environments." : (data.error != "" ? data.error : "Archived threads will appear here.")) font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance" testId="archive-load-error"
      // The first group's section is the "Archived threads" result's target (ArchivedThreadsPanel.tsx), its header the scroll's.
      for group in data.groups key=group.id
        column width="100%" gap="0.625rem" id=(group.first ? "archive" : "") tabindex=-1 testId=`archive-group-${group.id}`
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" gap="0.5rem" box-sizing="border-box" id=(group.first ? "archive-scroll-target" : "")
            box width="1rem" height="1rem" border-radius="0.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0 background-color=group.surface
              text group.mark font-family="monospace" font-size="0.515625rem" font-weight=700 line-height="0.75rem" color=group.ink
            text group.title font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
          column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0c)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
            for thread in group.threads key=thread.id
              ArchivedRow(thread=thread, busy=(busy or not data.available), menu=(menu == thread.scope), raw=raw, open=open, showMenu=showMenu(thread.scope), close=close, menuFor=menuFor)

// The row's Unarchive button is named by its text, "Unarchive", as the reference's Button (no aria-label); it is
// Button size="sm" (ArchivedThreadsPanel.tsx at 74541bab17): 28pt tall, 14pt text, the icon 4pt from its label (gap-1.5 less the icon's -mx-0.5).
component ArchivedRow
  props
    thread: ArchiveThreadView
    busy: bool
    menu: bool
    raw: action
    open: action
    showMenu: action
    close: action
    menuFor: action
  view
    column width="100%" position="relative" contextmenu=menuFor(thread.scope) contextPopover="archive-menu" testId=`archived-row-${thread.id}`
      SettingsRow(title=thread.title, description=thread.description, first=thread.first, rowId=`archived-${thread.id}`)
        button press=raw("unarchive-thread", thread.scope, "") disabled=busy testId=`unarchive-${thread.id}` display="flex" flex-direction="row" align-items="center" gap="0.25rem" box-sizing="border-box" height="1.75rem" padding-left="0.4375rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" box-shadow="0 1px 2px #0000000d" flex-shrink=0 opacity=(busy ? 0.64 : 1) id=`unarchive-${thread.id}` data-focus-stop=(busy ? "" : "enabled page")
          LucideArchiveX(size=14, color="light-dark(#71717b, #a1a1a1)")
          text "Unarchive" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"

// ArchivedThreadsPanel's row menu (api.contextMenu.show, ElectronMenu.ts showContextMenu: Unarchive, then Delete after a
// separator with the trash glyph), as the panel's one context popover (#292; it was
// T3ContextMenu's NSMenu). The host presents it as a native menu at the pointer, or at the focused row's centre from the
// ContextMenu key, and schedules it; the agent paints it. A choice runs settings-a-archive.ts `archive-pick`: Unarchive
// toasts a failure, Delete asks first while Delete confirmation is on.
component ArchiveMenu
  props
    owner: string
    raw: action
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id="archive-menu" popover="auto" position-try-fallbacks="none" role="menu" class=SidebarMenuCard testId="archive-menu"
        button press=raw("rest:archive-pick", owner, "unarchive") popovertarget="archive-menu" popovertargetaction="hide" role="menuitem" disabled=(owner == "") testId="archive-menu-unarchive" class=SidebarMenuItem
          text "Unarchive" flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
        hr height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" border-width=0 background-color="light-dark(#e4e4e7, #ffffff14)"
        button press=raw("rest:archive-pick", owner, "delete") popovertarget="archive-menu" popovertargetaction="hide" role="menuitem" disabled=(owner == "") testId="archive-menu-delete" class=SidebarMenuItem
          image "symbol:sf/trash" width=12 height=12 object-fit="contain"
          text "Delete" flex=1 min-width=0 text-align="left" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" color="light-dark(#c10007, #ff6467)"
