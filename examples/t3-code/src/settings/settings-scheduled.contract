                          button press=removeFilter(rule.id) disabled=busy aria-label=`Remove filter ${index + 1}` title="" testId=`task-webhook-filter-remove-${index}` width="1.75rem" height="1.75rem" flex-shrink=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" id=`task-webhook-filter-remove-${index}` data-focus-stop=(busy ? "" : "enabled")
                            LucideTrash2(size=16, color="light-dark(#18181b, #f5f5f5)")
                        row align-items="center" gap="0.5rem"
                          SettingsSelect(selectId=`task-webhook-filter-op-${rule.id}`, label=`Filter ${index + 1} test`, valueLabel=filterOpLabel(rule.op), empty=false, value=rule.op, width=176, disabled=busy, options=filterOps, choose=setFilter(rule.id, "op"))
                          if rule.op != "exists"
                            input value=rule.value input=setFilter(rule.id, "value") placeholder=(rule.op == "in" ? "opened, reopened" : "opened") aria-label=`Filter ${index + 1} value` disabled=busy class=TkField flex=1 min-width=0 testId=`task-webhook-filter-value-${index}` autocorrect="off" id=`field-task-webhook-filter-value-${rule.id}` data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                  column gap="0.375rem"
                    TaskFieldLabel(label="Replay key", hint="template, optional")
                    input value=replayKey input=setText("replayKey") placeholder="{{headers.delivery-id}}" aria-label="Replay key" disabled=busy class=TkField testId="task-webhook-replay-key" autocorrect="off" id="field-task-webhook-replay-key" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                  column gap="0.375rem"
                    TaskFieldLabel(label="Coalesce key", hint="template, optional")
