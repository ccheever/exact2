                  row align-items="center" justify-content="space-between" gap="0.75rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e799, #ffffff14)"
