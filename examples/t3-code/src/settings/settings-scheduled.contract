                    SettingsSwitch(checked=signatureEnabled, label="Require signature", disabled=busy, switchId="task-webhook-signature", toggle=toggle("signature"))
                  if signatureEnabled
                    column gap="0.5rem"
                      input value=signatureHeader input=setText("signatureHeader") aria-label="Header" placeholder="Header" class=TkField disabled=busy testId="task-webhook-header" autocorrect="off" id="field-task-webhook-header" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                      input value=signaturePrefix input=setText("signaturePrefix") aria-label="Prefix" placeholder="None" class=TkField disabled=busy testId="task-webhook-prefix" autocorrect="off" id="field-task-webhook-prefix" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
