// Settings → Scheduled tasks (T3 Code 7c3b3b3605ef ScheduledTasksSettings.tsx): a plain
// section with "New task", one row per task (switch and Edit/Run now/Delete
// menu), and the editor dialog with every field of ScheduledTaskEditorDialog.
use SelectOption from "./settings-kit.contract"
use FieldPlaceholder from "../shared/field-placeholder.contract"
use SettingsSwitch from "./settings-kit.contract"
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use SettingsModelTrigger from "./settings-picker.contract"
use CnMachineIcon from "./settings-b-kit.contract"
use LucideLaptop from "./settings-icons.contract"
use SettingsSelect from "./settings-kit.contract"
use SettingsSrHeading from "./settings-kit.contract"
use SettingsPageSwitch from "./settings-kit.contract"
use LucidePlus from "./settings-icons.contract"
use LucideEllipsis from "./settings-icons.contract"
use LucidePencil from "./settings-icons.contract"
use LucidePlay from "./settings-icons.contract"
use LucideTrash2 from "./settings-icons.contract"
use LucideX from "./settings-icons.contract"
use LucideGitBranch from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use LucideSearch from "./settings-icons.contract"
use LucideRefreshCw from "./settings-icons.contract"
use KmItem from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogFinalFocus from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use RefPageScroll from "../composer/ref-paging.contract"

shape TaskRowView
  webhook: bool
  id: string
  environmentId: string
  title: string
  prompt: string
  status: string
  runStatus: string
  runError: string
  enabled: bool
  first: bool
// WebhookFilterDraft: one filter row of the editor; `id` is its identity in the form.
shape WebhookFilterRow
  id: string
  path: string
  op: string
  value: string
shape TaskDraftView
  key: string
  id: string
  environmentId: string
  title: string
  prompt: string
  enabled: bool
  signatureEnabled: bool
  signatureHeader: string
  signatureEncoding: string
  signaturePrefix: string
  signatureSecret: string
  maxDeliveryAgeMinutes: string
  replayKey: string
  coalesceKey: string
  coalesceWindowSeconds: string
  filters: WebhookFilterRow[]
  hasSecret: bool
  address: string
  copyable: bool
  note: string
  scheduleMode: string
  intervalMinutes: string
  timeOfDay: string
  sunday: bool
  monday: bool
  tuesday: bool
  wednesday: bool
  thursday: bool
  friday: bool
  saturday: bool
  projectId: string
  threadId: string
  workspaceMode: string
  baseRef: string
  startFromOrigin: bool
  path: string
  modelKey: string
  legacyInterval: bool
  missing: bool
shape TaskRef
  value: string
  label: string
  search: string
  badge: string
  remote: bool
// `refs`: the pages loaded for the picker's search (all of them for another project: its first page). `selected`: the
// editor's base when `refs` does not list it, as the picker's selectedRefQuery finds it. `status`: BranchPicker's line.
shape TaskBranches
  projectId: string
  error: string
  refs: TaskRef[]
  selected: TaskRef[]
  status: string
shape TaskModelMark
  value: string
  name: string
  driver: string
  badge: string
  accent: string
// ScheduledTaskEnvironmentSection: `state` is disconnected, error, loading or ready.
shape TaskSectionView
  secondary: string
  kind: string
  transport: string
  id: string
  label: string
  heading: bool
  state: string
  title: string
  description: string
  linkMissing: bool
  tasks: TaskRowView[]
// `tone` is deliveryOutcomeVariant's (success, warning, error, outline); `note` a filtered request's failed filter.
shape DeliveryItem
  id: string
  label: string
  tone: string
  method: string
  age: string
  note: string
  missing: string
shape DeliveryBlock
  title: string
  value: string
shape WebhookDeliveries
  open: bool
  title: string
  selected: string
  error: string
  empty: bool
  items: DeliveryItem[]
  blocks: DeliveryBlock[]
  outcome: string
  tone: string
  method: string
  age: string
  verified: bool
  missing: string
  filtered: bool
shape TaskSummary
  id: string
  text: string
shape TaskChoice
  value: string
  label: string
  secondary: string
  kind: string
  selected: bool

shape ScheduledPage
  deliveries: WebhookDeliveries
  available: bool
  writable: bool
  error: string
  loading: bool
  environment: string
  scope: string
  missing: bool
  tasks: TaskRowView[]
  compact: bool
  emptyTasks: bool
  summaries: TaskSummary[]
  sections: TaskSectionView[]
  editors: TaskDraftView[]
  projects: TaskChoice[]
  workspaces: SelectOption[]
  environments: TaskChoice[]
  branches: TaskBranches[]
  marks: TaskModelMark[]

style TkLabel
  font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
style TkField
  box-sizing="border-box" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.3125rem" padding-bottom="0.3125rem" line-height="1.25rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)"
  ::placeholder
    color="light-dark(#71717b, #a1a1a1)"
style TkOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" flex-shrink=0

component ScheduledPanel
  props
    data: ScheduledPage
    busy: bool
    error: string
    open: action
    rest: action
  view
    column width="100%" gap="0.625rem" testId="scheduled-settings"
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" justify-content="space-between" gap="1rem" box-sizing="border-box"
        text "Scheduled tasks" font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
        button press=open("task", "", "") disabled=(busy or not data.available or not data.writable) id="new-scheduled-task" testId="new-scheduled-task" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-width=0 border-radius="0.5rem" background-color="#00000000" opacity=(busy or not data.available or not data.writable ? 0.64 : 1) data-focus-stop=((busy or not data.available or not data.writable) ? "" : "enabled page")
          LucidePlus(size=12, color="light-dark(#71717b, #a1a1a1)")
          text "New task" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="scheduled-error" padding-left="1rem"
      if data.error != ""
        TaskCard()
          TaskMessage(title="Could not load scheduled tasks", description=data.error, status=false)
      if data.compact
        TaskCard()
          for section in data.sections key=section.id
            if section.tasks.length > 0
              row width="100%" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.75rem" box-sizing="border-box" align-items="center"
                CnMachineIcon(kind=section.kind, size=16, color="light-dark(#71717b, #a1a1a1)")
                column flex=1 min-width=0
                  text section.label line-clamp=1 font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
                  if section.secondary != ""
                    text section.secondary line-clamp=1 font-size="0.75rem" color="light-dark(#71717b, #a1a1a1)"
                  text section.transport font-size="0.75rem" color="light-dark(#71717b, #a1a1a1)"
                text "Connected" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
              for item in section.tasks key=item.id
                TaskRow(item=item, data=data, busy=busy, open=open, rest=rest)
            if section.linkMissing
              TaskMessage(title="Task unavailable", description="This task no longer exists or is outside the selected project scope.", status=true)
          if data.emptyTasks
            TaskMessage(title="No scheduled tasks", description="No tasks match this environment and project selection.", status=false)
          for summary in data.summaries key=summary.id
            text summary.text title=summary.text role="status" width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.625rem" padding-bottom="0.625rem" line-clamp=1 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId=`task-summary-${summary.id}`
      else
        column width="100%" gap="2rem"
          for section in data.sections key=section.id
            column width="100%" gap="0.625rem" testId=`task-section-${section.id}`
              // EnvironmentTasks' SettingsSection title is an `<h2>`, sr-only while one environment shows.
              if section.heading
                row min-height="1.25rem" padding-left="1rem" padding-right="1rem" gap="0.375rem" align-items="center" box-sizing="border-box"
                  LucideLaptop(size=14, color="light-dark(#71717b, #a1a1a1)")
                  text section.label font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #a1a1a1)" role="heading" aria-level=2 testId=`task-section-title-${section.id}`
              else
                SettingsSrHeading(title=section.label, level=2)
              TaskCard()
                if section.state != "ready"
                  TaskMessage(title=section.title, description=section.description, status=(section.state == "loading"))
                else
                  if section.linkMissing
                    TaskMessage(title="Task unavailable", description="This task no longer exists or is outside the selected project scope.", status=true)
                  if section.tasks.length == 0
                    TaskMessage(title=section.title, description=section.description, status=false)
                  for item in section.tasks key=item.id
                    TaskRow(item=item, data=data, busy=busy, open=open, rest=rest)

// SettingsSection's card around one environment's rows.
component TaskCard
  slot
  view
    column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0c)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
      children

// ScheduledTaskRow: the switch and the Edit / Run now / Delete menu.
component TaskRow
  props
    item: TaskRowView
    data: ScheduledPage
    busy: bool
    open: action
    rest: action
  derive target = `id=${encodeURIComponent(item.id)}&environmentId=${encodeURIComponent(item.environmentId)}`
  derive menuItems = [KmItem(id=`task-edit-${item.id}`, label="Edit"), KmItem(id=`task-run-${item.id}`, label=(item.webhook ? "Deliveries" : "Run now")), KmItem(id=`task-delete-${item.id}`, label="Delete")]
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`task-menu-${item.id}`, source=`task-actions-${item.environmentId}|${item.id}`)
        let openingTarget = kmTriggerTarget(menuItems, k)
        if openingTarget != ""
          focus(openingTarget)
  view
    row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=(item.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)" testId=`task-row-${item.id}`
      column flex=1 min-width=0 gap="0.25rem"
        text item.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
        text item.prompt font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance" line-clamp=2
        row padding-top="0.125rem" gap="0.5rem" align-items="center" flex-wrap="wrap"
          text item.status font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId=`task-status-${item.id}`
          if item.runStatus != ""
            text item.runStatus font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.3125rem" padding-right="0.3125rem" border-radius="0.375rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" color=(item.runStatus == "failed" ? "light-dark(#c10007, #ff6467)" : (item.runStatus == "succeeded" ? "light-dark(#15803d, #4ade80)" : (item.runStatus == "running" ? "light-dark(#1447e6, #51a2ff)" : "light-dark(#18181b, #f5f5f5)"))) testId=`task-run-status-${item.id}`
          if item.runError != ""
            text item.runError font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)" testId=`task-run-error-${item.id}`
      row flex-shrink=0 align-items="center" gap="0.5rem"
        SettingsPageSwitch(checked=item.enabled, label=`Enable ${item.title}`, disabled=(busy or not data.writable), switchId=`task-enabled-${item.id}`, toggle=rest("task", `action=toggle&${target}&enabled=${item.enabled ? "false" : "true"}`))
        box position="relative" flex-shrink=0
          button id=`task-actions-${item.environmentId}|${item.id}` popovertarget=`task-menu-${item.id}` key=triggerKey disabled=(busy or not data.writable) aria-label=`Actions for ${item.title}` testId=`task-actions-${item.id}` width="1.75rem" height="1.75rem" border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop=((busy or not data.writable) ? "" : "enabled page")
            LucideEllipsis(size=16, color="light-dark(#18181b, #f5f5f5)")
          SkPopup(menuId=`task-menu-${item.id}`, invoker=`task-actions-${item.environmentId}|${item.id}`, label=`Actions for ${item.title}`, width=160, list=false, endAlign=28, items=menuItems, keyed=0)
            TaskMenuItem(keysId=`task-menu-${item.id}-keys`, label="Edit", icon="edit", menuId=`task-menu-${item.id}`, itemId=`task-edit-${item.id}`, destructive=false, choose=open("task", `${item.environmentId}|${item.id}`, item.title))
            if item.webhook
              TaskMenuItem(keysId=`task-menu-${item.id}-keys`, label="Deliveries", icon="edit", menuId=`task-menu-${item.id}`, itemId=`task-run-${item.id}`, destructive=false, choose=open("task-deliveries", `${item.environmentId}|${item.id}`, item.title))
            else
              TaskMenuItem(keysId=`task-menu-${item.id}-keys`, label="Run now", icon="run", menuId=`task-menu-${item.id}`, itemId=`task-run-${item.id}`, destructive=false, choose=rest("task", `action=run&${target}`))
            box height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" background-color="light-dark(#e4e4e7, #ffffff14)"
            TaskMenuItem(keysId=`task-menu-${item.id}-keys`, label="Delete", icon="delete", menuId=`task-menu-${item.id}`, itemId=`task-delete-${item.id}`, destructive=false, choose=rest("task", `action=delete&${target}`))

// A task row's menu item with its icon (Edit / Run now / Delete).
component TaskMenuItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    icon: string
    menuId: string
    itemId: string
    destructive: bool
    choose: action
  state lit = false
  action hover(over: bool)
    if over
      focus(itemId)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=itemId press=choose popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=itemId display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(lit ? "light-dark(#18181b14, #f5f5f50f)" : "#00000000") data-focus-stop="enabled"
      if icon == "edit"
        LucidePencil(size=16, color="light-dark(#71717b, #a1a1a1)")
      if icon == "run"
        LucidePlay(size=16, color="light-dark(#71717b, #a1a1a1)")
      if icon == "delete"
        LucideTrash2(size=16, color="light-dark(#71717b, #a1a1a1)")
      text label font-size="0.875rem" line-height="1.25rem" white-space="nowrap" color=(destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#18181b, #f5f5f5)")

component TaskMessage
  props
    title: string
    description: string
    status: bool
  view
    column width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="0.25rem" role=(status ? "status" : "group") aria-label=title testId="task-message"
      text title font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
      if description != ""
        text description font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"

// resolveBranchTriggerLabel for a future worktree (WorktreeBaseBranchPicker): "(remote)" only while Start from remote is on
// and the ref is a local branch the project lists; a ref it does not list (the Verification fixture's "No refs found.")
// or a remote one reads as it is.
fn taskBaseLabel(baseRef: string, startFromOrigin: bool, local: bool): string = baseRef == "" ? "Select ref" : (startFromOrigin and local ? `From ${baseRef} (remote)` : `From ${baseRef}`)
// The editor's picker as the root's page resource reads it (scheduled-view.ts pickerOf): the project it shows, the base to
// look up when that project's list lacks it, and the search the server filters by (usePaginatedBranches' query).
fn taskPicker(key: string, project: string, ref: string, query: string): string = `key=${encodeURIComponent(key)}&project=${encodeURIComponent(project)}&ref=${encodeURIComponent(ref)}&query=${encodeURIComponent(query)}`

// ScheduledTaskEditorDialog. Per-instance state starts from the server's
// draft each time the dialog opens (the draft row is new per opening). A new task's "Runs on" switches its environment
// in place, as the reference's setEnvironmentId and setDraft: the dialog stays open with
// its name, prompt, workspace, schedule and Enabled; project, model, base branch, Start from remote and checkout path
// start over, and the page resource (scheduled-view.ts) gives the chosen environment's projects, models and refs.
component ScheduledEditor
  // Model is the provider picker (ProviderModelPicker, no setup and no disabled reasons), opened by the
  // root's `pickModel`; its pick is the root's `taskModelPick` until this editor closes.
  inject
    dialogEntered: action
    dialogFallback: action
    pickModel: action
    taskModelPick: string
  props
    data: ScheduledPage
    draft: TaskDraftView
    busy: bool
    error: string
    close: action
    rest: action
    lookupBase: action
    // The root's restOpen for the editor: `new|<environmentId>` is a new task on that environment (scheduled-view.ts editTarget).
    runsOn: action
  state title = draft.title
  state prompt = draft.prompt
  state enabled = draft.enabled
  state confirmRotate = false
  action askRotate(on: bool)
    confirmRotate = on
  action rotate
    confirmRotate = false
    rest("task", `action=rotate-webhook&id=${encodeURIComponent(draft.id)}&environmentId=${encodeURIComponent(draft.environmentId)}`)
  state signatureEnabled = draft.signatureEnabled
  state signatureHeader = draft.signatureHeader
  state signatureEncoding = draft.signatureEncoding
  state signaturePrefix = draft.signaturePrefix
  state signatureSecret = ""
  state maxDeliveryAgeMinutes = draft.maxDeliveryAgeMinutes
  state replayKey = draft.replayKey
  state coalesceKey = draft.coalesceKey
  state coalesceWindowSeconds = draft.coalesceWindowSeconds
  // The rows the dialog opened with: a save sends `filters` only when the rows differ from them.
  state savedFilters = draft.filters
  state filters = draft.filters
  state filterSeq = 0
  derive filterOps = [SelectOption(value="equals", label="equals", selected=false), SelectOption(value="notEquals", label="does not equal", selected=false), SelectOption(value="in", label="is one of", selected=false), SelectOption(value="startsWith", label="starts with", selected=false), SelectOption(value="exists", label="exists", selected=false)]
  action addFilter
    filters = filters.concat([WebhookFilterRow(id=`new-${filterSeq}`, path="", op="equals", value="")])
    filterSeq = filterSeq + 1
  // By id, so a removed row's identity never passes to the row after it.
  action removeFilter(id: string)
    filters = filters.filter((rule) => rule.id != id)
  action setFilter(id: string, field: string, value: string)
    filters = filters.map((rule) => rule.id == id ? WebhookFilterRow(id=rule.id, path=(field == "path" ? value : rule.path), op=(field == "op" ? value : rule.op), value=(field == "value" ? value : rule.value)) : rule)
  state scheduleMode = draft.scheduleMode
  state intervalMinutes = draft.intervalMinutes
  state timeOfDay = draft.timeOfDay
  state sunday = draft.sunday
  state monday = draft.monday
  state tuesday = draft.tuesday
  state wednesday = draft.wednesday
  state thursday = draft.thursday
  state friday = draft.friday
  state saturday = draft.saturday
  state projectId = draft.projectId
  // selectedProjectId: the chosen project, else the environment's first (the draft's), as after a Runs on change.
  derive chosenProject = projectId != "" ? projectId : draft.projectId
  state workspaceMode = draft.workspaceMode
  state baseRef = draft.baseRef
  state startFromOrigin = draft.startFromOrigin
  state path = draft.path
  derive modelKey = (taskModelPick != "" ? taskModelPick : draft.modelKey)
  derive modelName = (markField(data.marks, modelKey, "name") == "" ? modelKey.slice(modelKey.indexOf(":") + 1, modelKey.length) : markField(data.marks, modelKey, "name"))
  state refQuery = ""
  // The base is a local branch of the chosen project's refs (WorktreeBaseBranchPicker's selectedRef, isRemote false): from
  // the loaded page, else from the lookup by name (`selected`), which the page makes for the draft's project and after a
  // switch (chooseProject).
  derive baseLocal = data.branches.filter((group) => group.projectId == chosenProject and (group.refs.filter((ref) => ref.value == baseRef and not ref.remote).length > 0 or group.selected.filter((ref) => ref.value == baseRef and not ref.remote).length > 0)).length > 0
  action setText(field: string, value: string)
    if field == "signatureHeader"
      signatureHeader = value
    if field == "signaturePrefix"
      signaturePrefix = value
    if field == "signatureSecret"
      signatureSecret = value
    if field == "maxDeliveryAgeMinutes"
      maxDeliveryAgeMinutes = value
    if field == "replayKey"
      replayKey = value
    if field == "coalesceKey"
      coalesceKey = value
    if field == "coalesceWindowSeconds"
      coalesceWindowSeconds = value
    if field == "refs"
      refQuery = value
      lookupBase(taskPicker(draft.key, chosenProject, baseRef, value))
    if field == "title"
      title = value
    if field == "prompt"
      prompt = value
    if field == "interval"
      intervalMinutes = value
    if field == "time"
      timeOfDay = value
    if field == "path"
      path = value
  // The picker is keyed by project, so another project asks for the base again (selectedRefQuery): when its list does not
  // have the base, the root's page resource looks it up by name (scheduled-view.ts `taskBase`).
  action chooseProject(value: string)
    projectId = value
    refQuery = ""
    lookupBase(taskPicker(draft.key, value, baseRef, ""))
  // WorktreeBaseBranchPicker's handleOpenChange: the search starts empty each time the picker opens.
  action openRefs
    if refQuery != ""
      refQuery = ""
      lookupBase(taskPicker(draft.key, chosenProject, baseRef, ""))
  action choose(field: string, value: string)
    if field == "encoding"
      signatureEncoding = value
    if field == "workspace"
      workspaceMode = value
    if field == "branch"
      baseRef = value
      refQuery = ""
      lookupBase(taskPicker(draft.key, chosenProject, value, ""))
    if field == "schedule"
      scheduleMode = value
      if value == "webhook" and prompt.trim() == ""
        prompt = "Handle this webhook:\n{{body}}"
    // Runs on: the reference's onValueChange (a new task only; the trigger is disabled for an existing one).
    if field == "environment" and value != draft.environmentId
      projectId = ""
      baseRef = "main"
      startFromOrigin = true
      path = ""
      refQuery = ""
      runsOn(`new|${value}`, "")
  action toggle(field: string)
    if field == "signature"
      signatureEnabled = not signatureEnabled
    if field == "enabled"
      enabled = not enabled
    if field == "origin"
      startFromOrigin = not startFromOrigin
    if field == "0" and (monday or tuesday or wednesday or thursday or friday or saturday)
      sunday = not sunday
    if field == "1" and (sunday or tuesday or wednesday or thursday or friday or saturday)
      monday = not monday
    if field == "2" and (sunday or monday or wednesday or thursday or friday or saturday)
      tuesday = not tuesday
    if field == "3" and (sunday or monday or tuesday or thursday or friday or saturday)
      wednesday = not wednesday
    if field == "4" and (sunday or monday or tuesday or wednesday or friday or saturday)
      thursday = not thursday
    if field == "5" and (sunday or monday or tuesday or wednesday or thursday or saturday)
      friday = not friday
    if field == "6" and (sunday or monday or tuesday or wednesday or thursday or friday)
      saturday = not saturday
  derive dialogTargets = [(draft.id == "" and not busy ? "task-environment" : "task-title"), "close-scheduled-task"]
  derive projectItems = data.projects.map((option) => KmItem(id=`task-project-option-${option.value}`, label=option.label))
  derive menuItems = data.environments.map((option) => KmItem(id=`task-environment-option-${option.value}`, label=option.label))
  action environmentKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("task-environment-menu", source="task-environment")
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)" testId="scheduled-task-overlay"
      DialogFinalFocus(open=confirmRotate, owner="webhook-rotate-dialog")
      column position="relative" width="100%" max-width="36rem" max-height="100%" box-sizing="border-box" border-radius="1rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="dialog" aria-label=(draft.id == "" ? "New task" : "Edit task") testId="scheduled-task-dialog" id="scheduled-task-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("scheduled-task-dialog") key=dialogFallback("scheduled-task-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract): from Runs on (a new task's) or Name to the X.
        FocusGuard(guardId="scheduled-task-guard-start", targets=dialogTargets, popup="scheduled-task-dialog")
        DialogOpenFocus(target=(draft.id == "" and not busy ? "task-environment" : "task-title"))
        row padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" align-items="flex-start" gap="0.5rem" box-sizing="border-box" position="relative"
          column flex=1 min-width=0 gap="0.5rem"
