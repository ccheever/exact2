            text "Run a prompt automatically on an interval, at a fixed time, or when a webhook is called." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
        scroll flex=1 min-height=0 width="100%" testId="scheduled-editor-scroll"
          column width="100%" gap="1.25rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="0.25rem" padding-bottom="1.5rem" box-sizing="border-box" testId="scheduled-editor"
            if draft.missing
              text "This scheduled task no longer exists." font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)" role="status" testId="task-missing"
            if error != ""
