                          text "base64"
                      input type="password" value=signatureSecret input=setText("signatureSecret") aria-label="Secret" placeholder=(draft.hasSecret ? "Unchanged" : "Shared secret") class=TkField disabled=busy testId="task-webhook-secret" autocorrect="off" id="field-task-webhook-secret" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
              if scheduleMode == "fixed"
                row align-items="center" gap="0.75rem" flex-wrap="wrap"
                  row align-items="center" gap="0.5rem"
                    text "Run at" class=TkLabel
                    input type="time" value=timeOfDay change=setText("time") aria-label="Run at" disabled=busy testId="task-time" box-sizing="border-box" width="8rem" height="2rem" padding-left="0.6875rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" id="field-task-time" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                    text "on" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
                  row role="group" aria-label="Days to run"
                    Weekday(label="Mon", short="Mo", on=monday, first=true, last=false, press=toggle("1"))
                    Weekday(label="Tue", short="Tu", on=tuesday, first=false, last=false, press=toggle("2"))
                    Weekday(label="Wed", short="We", on=wednesday, first=false, last=false, press=toggle("3"))
                    Weekday(label="Thu", short="Th", on=thursday, first=false, last=false, press=toggle("4"))
                    Weekday(label="Fri", short="Fr", on=friday, first=false, last=false, press=toggle("5"))
                    Weekday(label="Sat", short="Sa", on=saturday, first=false, last=false, press=toggle("6"))
                    Weekday(label="Sun", short="Su", on=sunday, first=false, last=true, press=toggle("0"))
              if scheduleMode == "interval"
                row align-items="center" gap="0.5rem"
                  text "Run every" class=TkLabel
                  input value=intervalMinutes input=setText("interval") aria-label="Run every" class=TkField width="6rem" disabled=busy testId="task-minutes" autocorrect="off" id="field-task-minutes" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                  text "minutes" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
            row align-items="center" justify-content="space-between" gap="1rem"
              column min-width=0 gap="0.25rem"
                text "Enabled" class=TkLabel
                text "Disabled tasks stay saved but do not run." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
              SettingsSwitch(checked=enabled, label="Enabled", disabled=busy, switchId="task-enabled", toggle=toggle("enabled"))
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          button press=close disabled=busy testId="cancel-scheduled-task" class=TkOutline id="cancel-scheduled-task" data-focus-stop=(busy ? "" : "enabled")
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"
          button press=rest("task", `action=save&id=${encodeURIComponent(draft.id)}&environmentId=${encodeURIComponent(draft.environmentId)}&title=${encodeURIComponent(title)}&prompt=${encodeURIComponent(prompt)}&enabled=${enabled}&scheduleMode=${scheduleMode}&signatureEnabled=${signatureEnabled}&signatureHeader=${encodeURIComponent(signatureHeader)}&signatureEncoding=${signatureEncoding}&signaturePrefix=${encodeURIComponent(signaturePrefix)}&signatureSecret=${encodeURIComponent(signatureSecret)}&maxDeliveryAgeMinutes=${encodeURIComponent(maxDeliveryAgeMinutes)}&replayKey=${encodeURIComponent(replayKey)}&coalesceKey=${encodeURIComponent(coalesceKey)}&coalesceWindowSeconds=${encodeURIComponent(coalesceWindowSeconds)}&filters=${encodeURIComponent(encodeFilters(filters))}&savedFilters=${encodeURIComponent(encodeFilters(savedFilters))}&intervalMinutes=${encodeURIComponent(intervalMinutes)}&timeOfDay=${encodeURIComponent(timeOfDay)}&sunday=${sunday}&monday=${monday}&tuesday=${tuesday}&wednesday=${wednesday}&thursday=${thursday}&friday=${friday}&saturday=${saturday}&projectId=${encodeURIComponent(chosenProject)}&threadId=${encodeURIComponent(draft.threadId)}&workspaceMode=${workspaceMode}&baseRef=${encodeURIComponent(baseRef)}&startFromOrigin=${startFromOrigin}&path=${encodeURIComponent(path)}&modelKey=${encodeURIComponent(modelKey)}`) disabled=(busy or draft.missing or not data.available) testId="save-scheduled-task" display="flex" flex-direction="row" align-items="center" justify-content="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" opacity=(busy or draft.missing or not data.available ? 0.64 : 1) data-focus-stop=((busy or draft.missing or not data.available) ? "" : "enabled")
            text (draft.id == "" ? "Create task" : "Save task") font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        // DialogPopup's X, after the footer (Base UI renders it last; it is placed at the top right).
        button id="close-scheduled-task" press=close disabled=busy aria-label="Close" aria-keyshortcuts="Escape" testId="close-scheduled-task" width="2rem" height="2rem" border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" position="absolute" top="0.5rem" right="0.5rem" title="" data-focus-stop=(busy ? "" : "enabled")
          LucideX(size=16, color="light-dark(#71717b, #a1a1a1)")
        FocusGuard(guardId="scheduled-task-guard-end", targets=dialogTargets, popup="scheduled-task-dialog")

// The rows as the save sends them (scheduled-webhook.ts decodeWebhookFilterRows): `path:op:value` joined by ",".
fn encodeFilters(rows: WebhookFilterRow[]): string = rows.map((rule) => `${encodeURIComponent(rule.path)}:${rule.op}:${encodeURIComponent(rule.value)}`).join(",")
fn filterOpLabel(op: string): string = op == "notEquals" ? "does not equal" : (op == "in" ? "is one of" : (op == "startsWith" ? "starts with" : (op == "exists" ? "exists" : "equals")))
fn projectLabel(options: TaskChoice[], value: string): string = options.filter(option => option.value == value).map(option => option.label).join("")
fn markField(marks: TaskModelMark[], value: string, field: string): string = marks.filter(mark => mark.value == value).map(mark => field == "driver" ? mark.driver : (field == "badge" ? mark.badge : (field == "accent" ? mark.accent : mark.name))).join("")

// Field's label: the name, and its hint at the right.
component TaskFieldLabel
  props
    label: string
    hint: string
  view
    row align-items="baseline" justify-content="space-between" gap="0.5rem"
      text label class=TkLabel
      text hint font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717bcc, #a1a1a1cc)"

component Weekday
  props
    label: string
    short: string
    on: bool
    first: bool
    last: bool
    press: action
  view
    button press=press aria-label=label aria-checked=on testId=`task-day-${label}` height="1.75rem" min-width="1.75rem" padding-left="0.3125rem" padding-right="0.3125rem" box-sizing="border-box" border-style="solid" border-width=1 border-left-width=(first ? 1 : 0) border-color="light-dark(#d4d4d8, #ffffff1c)" border-top-left-radius=(first ? "0.625rem" : "0px") border-bottom-left-radius=(first ? "0.625rem" : "0px") border-top-right-radius=(last ? "0.625rem" : "0px") border-bottom-right-radius=(last ? "0.625rem" : "0px") background-color=(on ? "light-dark(#d5d5d8a3, #ffffff14)" : "light-dark(#fcfcfc, #ffffff09)") id=`task-day-${label}` data-focus-stop="enabled"
      text short font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(on ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181b, #f5f5f5)")


component TaskChoiceItem
  props
    option: TaskChoice
    menuId: string
    itemId: string
    choose: action
  state lit = false
  action hover(over: bool)
    if over
      focus(itemId)
    else if lit
      focus(`${menuId}-keys`)
  action focused(on: bool)
    lit = on
  view
    button id=itemId press=choose popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="option" aria-label=option.label aria-selected=option.selected testId=itemId display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" padding="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(option.selected or lit ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
      if option.kind != ""
        CnMachineIcon(kind=option.kind, size=16, color="light-dark(#71717b, #a1a1a1)")
      column flex=1 min-width=0 align-items="flex-start"
        text option.label line-clamp=1 font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)"
        if option.secondary != ""
          text option.secondary max-width="18rem" line-clamp=1 font-size="0.75rem" color="light-dark(#71717b, #a1a1a1)"

component WebhookRotateDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    busy: bool
    cancel: action
    confirm: action
  derive targets = ["task-webhook-rotate-cancel", "task-webhook-rotate-confirm"]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=50 align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #090909a3)"
      column role="alertdialog" aria-label="Rotate this webhook URL?" id="webhook-rotate-dialog" testId="webhook-rotate-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("webhook-rotate-dialog") key=dialogFallback("webhook-rotate-dialog", targets) gap="0.75rem" padding="1.5rem" max-width="24rem" border-radius="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow="0 24px 64px -24px #000000a6"
        FocusGuard(guardId="webhook-rotate-guard-start", targets=targets, popup="webhook-rotate-dialog")
        DialogOpenFocus(target="task-webhook-rotate-cancel")
        text "Rotate this webhook URL?" font-size="1rem" font-weight=600 role="heading" aria-level=2
        text "The current URL stops working." font-size="0.875rem"
        row gap="0.5rem" justify-content="flex-end"
          button data-focus-stop="enabled" id="task-webhook-rotate-cancel" press=cancel class=TkOutline aria-keyshortcuts="Escape"
            text "Cancel"
          button data-focus-stop=(busy ? "" : "enabled") id="task-webhook-rotate-confirm" press=confirm disabled=busy class=TkOutline testId="task-webhook-rotate-confirm"
            text "Rotate"
        FocusGuard(guardId="webhook-rotate-guard-end", targets=targets, popup="webhook-rotate-dialog")
