                  column gap="0.375rem"
                    TaskFieldLabel(label="Coalesce window", hint="seconds, 10–3600")
                    input type="number" min=10 max=3600 step=1 inputmode="numeric" value=coalesceWindowSeconds input=setText("coalesceWindowSeconds") placeholder="120" aria-label="Coalesce window" disabled=busy class=TkField testId="task-webhook-coalesce-window" autocorrect="off" id="field-task-webhook-coalesce-window" data-editable="yes" data-focus-stop=(busy ? "" : "enabled")
                  text "Replay keys suppress repeat deliveries for 7 days. Coalescing runs the latest payload once when the window from the first delivery closes. Empty keys run normally." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
                  row align-items="center" justify-content="space-between" gap="1rem"
                    column gap="0.25rem" flex=1
                      text "Require signature" class=TkLabel
