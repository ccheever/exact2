// T3 settings primitives (settingsLayout.tsx, SettingsGroup.tsx, ui/switch,
// ui/button, ui/input) at the computed sizes and colors of the served
// reference, for the Providers and Connections routes.
use PolicyTip from "./settings-kit.contract"
use PvIcon from "../providers/provider-icons.contract"

// SettingsSection: a muted 14px title row (min-height 28, inset 16) above a group.
component PvSectionTitle
  props
    title: string
  slot
  view
    row min-height="1.75rem" padding-left="1rem" padding-right="1rem" gap="1rem" align-items="flex-start" justify-content="space-between" box-sizing="border-box" width="100%"
      row min-height="1.75rem" gap="0.5rem" align-items="center" min-width=0
        text title font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
      row min-height="1.75rem" min-width="1.75rem" gap="0.5rem" align-items="center" justify-content="flex-end"
        children

// SettingsGroup (grouped): rounded-xl card, border/60, card/40.
component PvGroup
  slot
  view
    column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0a)" background-color="light-dark(#ffffff66, #11111166)" overflow="hidden"
      children

// SettingsGroup in the provider detail pane: the card's border, fill and shadow drop (index.css
// `[data-provider-detail] [data-slot="settings-group"]`), so its sections sit flat in the pane's card;
// headings and row dividers still separate them.
component PvFlatGroup
  slot
  view
    column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="#00000000" overflow="hidden"
      children

// One SettingsRow. Its own container query (≥ 32rem) puts the control beside
// the title; narrower rows stack it underneath. `divided` draws the border/50
// separator a grouped card draws between rows.
component PvRow
  props
    title: string
    description: string
    status: string
    // PolicyTooltip's words beside the title ("" for none): only the Health check interval has one, so its id is fixed.
    policy: string
    wide: bool
    divided: bool
  slot
  view
    column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" border-top-style="solid" border-top-width=(divided ? 1 : 0) border-color="light-dark(#e3e3e780, #ffffff0a)"
      if wide
        row width="100%" gap="2rem" align-items="center"
          column flex=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center" gap="0.375rem"
              text title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              if policy != ""
                PolicyTip(tip=policy, tipId="provider-health-policy")
                  PvIcon(name="info", size=14, color="light-dark(#71717b, #a1a1a1)")
            if description != ""
              text description font-size="0.75rem" line-height="1.125rem" max-width="42rem" text-wrap="balance" color="light-dark(#71717b, #a1a1a1)"
            if status != ""
              text status font-size="0.75rem" line-height="1rem" padding-top="0.125rem" color="light-dark(#71717b, #a1a1a1)"
          row flex-shrink=0 min-width="10rem" gap="0.5rem" align-items="center" justify-content="flex-end"
            children
      else
        column width="100%" gap="0.75rem"
          column min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center" gap="0.375rem"
              text title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              if policy != ""
                PolicyTip(tip=policy, tipId="provider-health-policy")
                  PvIcon(name="info", size=14, color="light-dark(#71717b, #a1a1a1)")
            if description != ""
              text description font-size="0.75rem" line-height="1.125rem" text-wrap="balance" color="light-dark(#71717b, #a1a1a1)"
            if status != ""
              text status font-size="0.75rem" line-height="1rem" padding-top="0.125rem" color="light-dark(#71717b, #a1a1a1)"
          row width="100%" min-width=0 gap="0.5rem" align-items="center"
            children

// ui/switch: 30×18 (sm 26×16), 2px inset thumb; primary when on.
component PvSwitch
  props
    checked: bool
    small: bool
    disabled: bool
    label: string
    test: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled testId=test width=(small ? "1.625rem" : "1.875rem") height=(small ? "1rem" : "1.125rem") padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff1c)") title="" id=test data-focus-stop=(disabled ? "" : "enabled")
      box width=(small ? "0.75rem" : "0.875rem") height=(small ? "0.75rem" : "0.875rem") border-radius="624.9375rem" background-color=(checked ? "light-dark(#fcfcfc, #000000)" : "light-dark(#fcfcfc, #a1a1a1)")

// ui/input size=sm: 28px outline field (radius 10, 9px inset, 14px text).
style PvField
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.5rem"
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)"
  background-color="light-dark(#fcfcfc, #ffffff08)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)"
  // ui/input.tsx placeholder:text-placeholder, the muted foreground.
  ::placeholder
    color="light-dark(#71717b, #a1a1a1)"

// Button variants (ui/button): outline sm, ghost-muted xs and icon sizes.
style PvOutline
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" flex-shrink=0
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1
  border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff08)"
  font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
style PvGhost
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.25rem" flex-shrink=0
  box-sizing="border-box" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-width=0
  background-color="#00000000" font-size="0.75rem" font-weight=500 color="light-dark(#71717b, #a1a1a1)"
style PvIconButton
  cursor="pointer"
  display="flex" align-items="center" justify-content="center" flex-shrink=0
  box-sizing="border-box" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0
  background-color="#00000000" color="light-dark(#71717b, #a1a1a1)"
style PvMicro
  cursor="pointer"
  display="flex" align-items="center" justify-content="center" flex-shrink=0
  box-sizing="border-box" width="1.25rem" height="1.25rem" padding=0 border-radius="0.375rem" border-width=0
  background-color="#00000000" color="light-dark(#71717b, #a1a1a1)"
// Button variant="ghost-destructive" (ui/button.tsx), size "micro" (icon-micro: 20 pt), "xs" (icon-xs: 24 pt) or "sm"
// (icon-sm: 28 pt): muted ink at rest; hovered or pressed, the accent behind it and the destructive ink. The icon's size is
// the row's: an argument's bare XIcon takes the button base's 16 at sm and up, which icon-micro's size-3 does not undo,
// where a variable's says size-3. A :hover block cannot set `color`, so the button keeps its hover in state; its :active
// block is the pressed paint. The icon draws in the button's ink.
component PvRemoveButton
  props
    label: string
    buttonId: string
    icon: string
    size: string
    iconSize: number
    disabled: bool
    stop: string // its focus word when enabled
    press: action
  state over = false
  action hover(value: bool)
    over = value
  derive micro = size == "micro"
  derive side = micro ? "1.25rem" : (size == "xs" ? "1.5rem" : "1.75rem")
  view
    button press=press hover=hover class=PvMicro width=side height=side border-radius=(micro ? "0.375rem" : "0.5rem") aria-label=label disabled=disabled testId=buttonId title="" id=buttonId data-focus-stop=(disabled ? "" : stop) background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") color=(over and not disabled ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717b, #a1a1a1)")
      :active
        background-color="light-dark(#f4f4f5, #ffffff0a)"
        color="light-dark(#fb2c36, #fb414a)"
      PvIcon(name=icon, size=iconSize, color="currentColor")

style PvPrimary
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" flex-shrink=0
  box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-width=0
  background-color="light-dark(#1b4ed8, #346bf1)" font-size="0.875rem" font-weight=500 color="#ffffff"
