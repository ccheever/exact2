use LucideCheck, LucideChevronDown, LucideChevronRight from "./settings-icons.contract"

shape CoreOption
  id: string
  value: string
  label: string
  detail: string
  icon: string
  selected: bool
  disabled: bool
shape InheritanceOverride
  id: string
  label: string
  machine: string
  value: string
shape InheritanceGroup
  id: string
  title: string
  winner: string
  value: string
  labels: string[]
  folded: bool
  sameEverywhere: bool
  layers: CoreOption[]
  overrides: InheritanceOverride[]
  overrideTargets: string

// One resolution chain, collapsed only when several machines disagree.
component InheritanceGroupView
  props
    group: InheritanceGroup
    textColor: string
    muted: string
    highlight: string
    accent: string
    rowId: string
    clear: action
  state open = false
  state overridesOpen = false
  action toggleOverrides
    overridesOpen = not overridesOpen
  action toggle
    open = not open
  view
    column width="100%" gap="0.375rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box"
      if group.folded
        button press=toggle aria-expanded=open testId=`inheritance-group-${rowId}-${group.id}` border-width=0 background-color="#00000000" width="100%" height="auto" padding="0.5rem" justify-content="flex-start" text-align="left"
          column flex=1 min-width=0 gap="0.25rem"
            row width="100%" gap="0.5rem" align-items="center"
              text group.value flex=1 min-width=0 line-clamp=1 font-size="0.875rem" line-height="1.25rem" color=textColor font-variant-numeric="tabular-nums"
              text group.winner font-size="0.75rem" line-height="1rem" color=muted
              if open
                LucideChevronDown(size=12, color=muted)
              else
                LucideChevronRight(size=12, color=muted)
            for label in group.labels key=label
              text label max-width="100%" line-clamp=1 font-size="0.75rem" line-height="1rem" color=muted
      else if not group.sameEverywhere
        text group.title font-size="0.75rem" font-weight=500 line-height="1rem" color=muted padding-left="0.25rem"
      if not group.folded or open
        for layer in group.layers key=layer.id
          row min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" align-items="center" border-radius="0.375rem" background-color=(layer.selected ? highlight : "#00000000") testId=`setting-inheritance-${rowId}-${layer.id}`
            text layer.label font-size="0.875rem" line-height="1.25rem" color=textColor flex=1 min-width=0 line-clamp=1
            text layer.detail font-size="0.875rem" line-height="1.25rem" max-width="10rem" line-clamp=1 color=(layer.selected ? textColor : muted) font-variant-numeric="tabular-nums"
            if layer.selected
              LucideCheck(size=14, color=accent)
        if group.sameEverywhere
          text "Same on all machines" padding-left="0.5rem" font-size="0.75rem" line-height="1rem" color=muted
      if group.overrides.length > 0
        column width="100%" gap="0.25rem" padding-top="0.5rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)"
          row width="100%" align-items="center" justify-content="space-between"
            button press=toggleOverrides aria-expanded=overridesOpen testId=`inheritance-overrides-${rowId}-${group.id}` padding="0.25rem" border-width=0 background-color="#00000000"
              text "Overridden by" font-size="0.75rem" color=muted
            button press=clear testId=`inheritance-clear-${rowId}-${group.id}` padding="0.25rem" border-width=0 background-color="#00000000"
              text (group.overrides.length == 1 ? "Reset it" : "Reset all") font-size="0.75rem" color=muted
          if group.overrides.length <= 3 or overridesOpen
            scroll width="100%" max-height="12rem"
              column width="100%"
                for override in group.overrides key=override.id
                  row width="100%" padding="0.25rem" gap="0.5rem" align-items="center" box-sizing="border-box"
                    column flex=1 min-width=0
                      text override.label line-clamp=1 font-size="0.875rem" color=textColor
                      if group.folded or group.sameEverywhere
                        text override.machine line-clamp=1 font-size="0.75rem" color=muted
                    text override.value max-width="8rem" line-clamp=1 font-size="0.875rem" color=muted font-variant-numeric="tabular-nums"
