// The settings page body: the scope sentence on
// every scoped route, the scope boundary messages, and the General and Appearance pages.
use SettingsCore from "./settings-core.contract"
use ScopeSentence from "./settings-rows.contract"
use ScopeNotice from "./settings-scope-notice.contract"
use LucideLayers from "./settings-icons.contract"
use CoreSections from "./settings-rows.contract"
use AppearanceLibrary from "../appearance/settings-appearance.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

component SettingsCoreBody
  inject
    rem: number
  props
    core: SettingsCore
    route: string
    busy: bool
    menu: string
    legacyOpen: bool
    toggleLegacy: action
    openMenu: action
    closeMenu: action
    change: action
    slide: action
    navigate: action
    choose: action
    noticeChoose: action
    dialog: action
    reduced: bool
  view
    column width="100%" gap="2rem" position="relative" z-index=(menu != "" ? 50 : 1) margin-bottom=((route == "general" or route == "appearance" ? 0 : (route == "diagnostics" ? 22 : 14)) * rem / 16) testId="settings-core-body"
      if core.showScope
        ScopeSentence(pal=core.palette, projectLabel=core.projectLabel, projectMark=core.projectMark, projectInk=core.projectInk, projectSurface=core.projectSurface, environmentLabel=core.environmentLabel, environmentIcon=core.environmentIcon, connective=core.connective, projects=core.projectChoices, environments=core.environmentChoices, projectKeyed=core.projectKeyed, environmentKeyed=core.environmentKeyed, menu=menu, openMenu=openMenu, closeMenu=closeMenu, choose=choose)
      if core.notice != ""
        ScopeNotice(message=core.notice, groups=core.noticeGroups, noticeId="settings-scope-notice", choose=noticeChoose)
      if core.message != "" and core.showScope
        column align-items="flex-start" gap="0.75rem" padding-left="1rem" padding-right="1rem"
          text core.message role="status" font-size="0.875rem" line-height="1.25rem" color=core.palette.muted testId="settings-unavailable" id="settings-unavailable" data-paint="mutedForeground" data-pick="mutedForeground"
          // ProjectsSettings: Button variant="outline" size="xs" with LayersIcon.
          if core.showAllEnvironments
            button press=noticeChoose(core.allEnvironmentsProject, "", core.allEnvironmentsMember) testId="settings-show-all-environments" display="flex" flex-direction="row" align-items="center" gap="0.125rem" box-sizing="border-box" height="1.5rem" padding-left="0.3125rem" padding-right="0.4375rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d"
              LucideLayers(size=14, color="light-dark(#71717b, #818181)")
              text "Show all environments" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
      if route == "general" and core.message == "" and core.notice == ""
        CoreSections(reduced=reduced, sections=core.sections, pal=core.palette, codePreview=core.codePreview, busy=busy, menu=menu, legacyOpen=legacyOpen, toggleLegacy=toggleLegacy, openMenu=openMenu, closeMenu=closeMenu, change=change, slide=slide, navigate=navigate)
      if route == "general" and core.message != "" and core.notice == ""
        CoreSections(reduced=reduced, sections=core.cliSections, pal=core.palette, codePreview=core.codePreview, busy=busy, menu=menu, legacyOpen=legacyOpen, toggleLegacy=toggleLegacy, openMenu=openMenu, closeMenu=closeMenu, change=change, slide=slide, navigate=navigate)
      if route == "appearance" and core.notice == ""
        AppearanceLibrary(tiles=core.tiles, themes=core.themes, pal=core.palette, busy=busy, change=change, dialog=dialog)
        CoreSections(reduced=reduced, sections=core.sections, pal=core.palette, codePreview=core.codePreview, busy=busy, menu=menu, legacyOpen=legacyOpen, toggleLegacy=toggleLegacy, openMenu=openMenu, closeMenu=closeMenu, change=change, slide=slide, navigate=navigate)

// useSettingsRestore's confirmation: names every value it resets before restoring. ConfirmDialogHost's buttons
// read Cancel and Confirm (the destructive variant), whatever the question.
component SettingsRestoreDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    core: SettingsCore
    busy: bool
    cancel: action
    confirm: action
  derive dialogTargets = ["restore-defaults-cancel", "restore-defaults-confirm"]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 display="flex" align-items="center" justify-content="center" background-color="#00000055" padding="1.5rem" box-sizing="border-box" z-index=30 testId="restore-defaults-overlay"
      column width="100%" max-width="28rem" padding="1.5rem" gap="1rem" border-radius="1rem" border-width=1 border-style="solid" border-color=core.palette.cardBorder background-color=core.palette.canvas box-shadow="0 16px 40px -18px #0000008c" box-sizing="border-box" role="alertdialog" aria-describedby="restore-defaults-list" aria-label="Restore default settings?" testId="restore-defaults-dialog" id="restore-defaults-dialog" data-paint="border canvas" data-pick="canvas" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("restore-defaults-dialog") key=dialogFallback("restore-defaults-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract).
        FocusGuard(guardId="restore-defaults-guard-start", targets=dialogTargets, popup="restore-defaults-dialog")
        DialogOpenFocus(target="restore-defaults-cancel")
        text "Restore default settings?" font-size="1.125rem" font-weight=600 line-height="1.5rem" color=core.palette.text id="paint-SettingsRestoreDialog-2" data-paint="text" data-pick="text"
        text core.restoreText font-size="0.875rem" line-height="1.25rem" color=core.palette.muted testId="restore-defaults-list" id="restore-defaults-list" data-paint="mutedForeground" data-pick="mutedForeground"
        row gap="0.5rem" justify-content="flex-end"
          button id="restore-defaults-cancel" press=cancel disabled=busy aria-keyshortcuts="Escape" display="flex" align-items="center" justify-content="center" height="2rem" padding-left="0.75rem" padding-right="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=core.palette.input background-color=core.palette.field testId="restore-defaults-cancel" data-paint="input canvas" data-pick="canvas" data-focus-stop=(busy ? "" : "enabled")
            text "Cancel" font-size="0.875rem" font-weight=500 color=core.palette.text id="paint-SettingsRestoreDialog-5" data-paint="text" data-pick="text"
          button id="restore-defaults-confirm" press=confirm disabled=busy display="flex" align-items="center" justify-content="center" height="2rem" padding-left="0.75rem" padding-right="0.75rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#fb2c36, #fb414a)" testId="restore-defaults-confirm" data-focus-stop=(busy ? "" : "enabled")
            text "Confirm" font-size="0.875rem" font-weight=500 color="#ffffff"
        FocusGuard(guardId="restore-defaults-guard-end", targets=dialogTargets, popup="restore-defaults-dialog")
