// Adapted from T3 Code 7c3b3b3605ef (MIT); see LICENSE-T3.
use HostCredentials from "./source-control-credentials.contract"
use HostCredentialsForm from "./source-control-credentials.contract"
// Settings → Source control, Browser and Devices (reference SourceControlSettings.tsx,
// ProjectDefaultsSettings.tsx, BranchNamingSettings.tsx, SourceControlWritingSettings.tsx,
// IntegrationsSettings.tsx). Scoped rows show where their value comes from (SettingInheritance)
// and a reset arrow.
use InheritanceGroup, InheritanceGroupView from "./settings-inheritance.contract"
use RedactedText from "../shared/redacted-text.contract"
use FieldPlaceholder from "../shared/field-placeholder.contract"
use SelectOption from "./settings-kit.contract"
use SettingsNotice from "./settings-kit.contract"
use SettingsPageSwitch from "./settings-kit.contract"
use SettingsPageSelect from "./settings-kit.contract"
use LucideLayers from "./settings-icons.contract"
use LucideUndo2 from "./settings-icons.contract"
use LucideCheck from "./settings-icons.contract"
use LucideRefreshCw from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use LucideChevronUp from "./settings-icons.contract"
use BrandGit from "./settings-brands.contract"
use BrandJujutsu from "./settings-brands.contract"
use BrandGitHub from "./settings-brands.contract"
use BrandGitLab from "./settings-brands.contract"
use BrandAzureDevOps from "./settings-brands.contract"
use BrandBitbucket from "./settings-brands.contract"
use BrandGitCafe from "./settings-brands.contract"
use BrandForgejo from "./settings-brands.contract"
use DeviceHostsView from "../device/settings-a-hosts.contract"
use DeviceHostsRow from "../device/settings-a-hosts.contract"
use EasHostsView from "../device/settings-eas-hosts.contract"
use EasDeviceHostsRow from "../device/settings-eas-hosts.contract"
use SimulatorSupportRow from "../device/device-support.contract"
use SimulatorSupportSettingsRow from "../device/device-support.contract"
use ScopedSwitch from "./settings-scoped-switch.contract"
use BrowserProfilesView from "../browser/browser-profiles.contract"
use BrowserProfilesSetting from "../browser/browser-profiles.contract"
use BrowserDefaultsView from "../browser/browser-defaults.contract"
use BdRow from "../browser/browser-defaults.contract"
use BdViewportSelect from "../browser/browser-defaults.contract"
use BdViewportSize from "../browser/browser-defaults.contract"
use BrowserAutoShowRow from "../browser/browser-defaults.contract"
use BrowserSearchEngineRow from "../browser/browser-defaults.contract"
use AdvancedFold from "./settings-advanced.contract"
use SettingsModelTrigger from "./settings-picker.contract"
use CoreOption from "./settings-core-shared.contract"
use CorePalette from "./settings-core-shared.contract"
use SettingsPickerFace from "./settings-picker.contract"
use TraitsMenu from "./settings-traits.contract"
use CcIcon from "../composer/composer-controls.contract"
use KmItem from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"

shape InheritLayer
  key: string
  label: string
  value: string
  effective: bool
  set: bool
shape ScopedRow
  key: string
  kind: string
  title: string
  description: string
  checked: bool
  value: string
  valueLabel: string
  options: SelectOption[]
  placeholder: string
  disabled: bool
  first: bool
  summary: string
  state: string
  layers: InheritLayer[]
  layerGroups: InheritanceGroup[]
  reset: string
  status: string
  child: string
  mixed: bool
  // The control's accessible name and the reset's "Reset <resetLabel> to default", as the reference names them; "" uses the title.
  control: string
  resetLabel: string
  // A model row's picker trigger mark.
  driver: string
  badge: string
  accent: string
  // The writer model's TraitsPicker: its trigger label ("" draws none) and menu rows.
  traitsLabel: string
  traits: CoreOption[]
  // The row's search target (settings-catalog.ts `targetId ?? id`), "" for a row no result names.
  target: string
shape DiscoveryRow
  kind: string
  label: string
  version: string
  comingSoon: bool
  badge: string
  dot: string
  summary: string
  account: bool
  enabled: bool
  details: bool
  accountValue: string
  accountPlaceholder: string
shape SourceControlPage
  available: bool
  error: string
  project: bool
  scope: string
  repositories: ScopedRow[]
  // Writing & review's rows, then the ones under its Advanced fold.
  writing: ScopedRow[]
  writingAdvanced: ScopedRow[]
  vcsTitle: string
  scanned: bool
  scanError: string
  vcs: DiscoveryRow[]
  providers: DiscoveryRow[]
  hostCredentials: HostCredentials[]
shape DeviceTool
  kind: string
  title: string
  label: string
  aria: string
  known: bool
  running: string
  required: string
  installed: string
  update: string
  inspect: bool
  error: string
shape IntegrationsPage
  available: bool
  // The settings scope the device switches write (settings-integrations-scope.ts): `machine|projectKey|checkout`.
  deviceScope: string
  error: string
  project: bool
  scope: string
  browser: ScopedRow[]
  deviceHub: ScopedRow
  agentDevice: ScopedRow
  hubStatus: string
  agentStatus: string
  hosts: number
  hubTool: DeviceTool
  agentTool: DeviceTool
  hostsRow: ScopedRow
  deviceHosts: DeviceHostsView
  // EAS Simulator hosts (settings-eas-hosts.ts), shown when the device state says `supportsEasHosts`.
  easHostsRow: ScopedRow
  easHosts: EasHostsView
  simulatorSupport: SimulatorSupportRow[]
  // Browser profiles and the import wizard (browser-profiles-settings.ts).
  browserProfiles: BrowserProfilesView
  // "Open links in" ("system" or "app", the client setting browserLinkTarget).
  linkTarget: string

component SectionTitle
  props
    title: string
  view
    text title font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2

component Card
  slot
  view
    column width="100%" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0c)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
      children

// SettingInheritance: the layers icon opens the top-down resolution chain (PopoverPopup align="start", 4 pt below,
// flipping near an edge).
component Inheritance
  props
    row: ScopedRow
    rest: action
    // True while the row is hovered: a marker for a value set right here (default or environment, no project
    // overriding it) waits for hover, its own focus or its open popover (settingsLayout.tsx).
    rowHovered: bool
  derive quiet = (row.state == "default" or row.state == "environment") and row.layerGroups.filter((group) => group.overrides.length > 0).length == 0
  state focused = false
  state open = false
  action focusMarker(on: bool)
    focused = on
  action toggled(e: ToggleEvent)
    open = e.newState == "open"
  view
    button popovertarget=`inherit-${row.key}` focus=focusMarker(true) blur=focusMarker(false) opacity=(quiet and not rowHovered and not focused and not open ? 0 : 1) aria-label=`${row.summary}. Show where this value comes from` testId=`inherit-${row.key}` width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.375rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title="" id=`inherit-${row.key}` data-focus-stop="enabled page"
      LucideLayers(size=12, color=(row.state == "overridden" ? "light-dark(#1b4ed8, #346bf1)" : (row.state == "mixed" ? "#fe9a00" : "light-dark(#71717b, #a1a1a1)")))
    column id=`inherit-${row.key}` toggle=toggled popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width="20rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #181818)" box-shadow="0 8px 24px #00000026" aria-label=row.summary testId=`inherit-popup-${row.key}`
      if row.layerGroups.length > 0
        for group in row.layerGroups key=group.id
          InheritanceGroupView(group=group, textColor="light-dark(#18181b, #f5f5f5)", muted="light-dark(#71717b, #a1a1a1)", highlight="light-dark(#18181b0f, #f5f5f50f)", accent="light-dark(#1b4ed8, #346bf1)", rowId=row.key, clear=rest("scoped-overrides", `key=${encodeURIComponent(row.key)}&entries=${encodeURIComponent(group.overrideTargets)}`))
      else
        text "This environment" font-size="0.75rem" font-weight=500 line-height="1rem" padding-bottom="0.375rem" color="light-dark(#71717b, #a1a1a1)"
        for layer in row.layers key=layer.key
          row align-items="center" gap="0.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.375rem" background-color=(layer.effective ? "light-dark(#18181b0f, #f5f5f50f)" : "#00000000")
            text layer.label font-size="0.875rem" line-height="1.25rem" font-weight=(layer.effective ? 500 : 400) color=(layer.effective ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)") flex=1 min-width=0 line-clamp=1
            text layer.value font-size="0.875rem" line-height="1.25rem" max-width="8rem" line-clamp=1 color=(layer.effective ? "light-dark(#18181b, #f5f5f5)" : (layer.set ? "light-dark(#71717b, #a1a1a1)" : "light-dark(#71717b99, #a1a1a199)"))
            box width="0.875rem" height="0.875rem"
              if layer.effective
                LucideCheck(size=14, color="light-dark(#1b4ed8, #346bf1)")

// SettingsRow over a scoped server setting.
component ScopedSettingRow
  inject
    rem: number
    pickModel: action
  props
    row: ScopedRow
    // The page's `<environmentId>:<projectId>`, which the writer model's picker writes to.
    scope: string
    busy: bool
    rest: action
    restInput: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    column hover=hover id=(row.target != "" ? row.target : `scoped-row-${row.key}`) tabindex=-1 width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom=(row.child != "" or row.kind == "textarea" ? "0.25rem" : "0.75rem") padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)" opacity=(row.disabled and row.kind != "model" ? 0.64 : 1) testId=`scoped-row-${row.key}`
      if row.kind == "note"
        text row.description font-size="0.875rem" line-height="1.25rem" padding-bottom=0 color="light-dark(#71717b, #a1a1a1)"
      if row.kind != "note"
        row width="100%" gap="2rem" align-items="center"
          column flex=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center" gap="0.375rem"
              text row.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              if row.summary != ""
                Inheritance(row=row, rest=rest, rowHovered=hovered)
              box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center"
                if row.reset != ""
                  button press=rest("scoped", row.reset) disabled=busy aria-label=`Reset ${row.resetLabel != "" ? row.resetLabel : row.title} to default` testId=`reset-${row.key}` width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id=`reset-${row.key}` data-focus-stop=(busy ? "" : "enabled page")
                    LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
            if row.description != ""
              text row.description font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
            if row.status != ""
              text row.status font-size="0.75rem" line-height="1rem" padding-top="0.125rem" color="light-dark(#71717b, #a1a1a1)"
          row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end" gap="0.5rem"
            if row.kind == "switch"
              SettingsPageSwitch(checked=row.checked, label=(row.control != "" ? row.control : row.title), disabled=(busy or row.disabled), switchId=`scoped-${row.key}`, toggle=rest("scoped", `key=${row.key}&value=${row.checked ? "false" : "true"}`))
            if row.kind == "select"
              SettingsPageSelect(selectId=`scoped-${row.key}`, label=(row.control != "" ? row.control : row.title), valueLabel=row.valueLabel, empty=false, value="", width=((row.key == "sourceControlWritingStyle" ? 224 : 160) * rem / 16), disabled=(busy or row.disabled), options=row.options, choose=restInput("scoped", `key=${row.key == "sourceControlWritingStyle" ? "sourceControlWritingStyle.mode" : row.key}&value=`))
            if row.kind == "text"
              ScopedTextField(value=row.value, placeholder=row.placeholder, label=row.title, fieldKey=row.key, busy=(busy or row.disabled), restInput=restInput)
            if row.kind == "model"
              // ProviderModelPicker: the window's picker under this trigger, while a provider can write.
              if row.checked and row.status == ""
                SettingsModelTrigger(stop="enabled page", rowId=(row.key == "reviewGuideModelSelection" ? "review-guide-model" : "source-control-writer-model"), label=row.valueLabel, name=row.title, driver=row.driver, badge=row.badge, accent=row.accent, disabled=(busy or row.disabled), press=pickModel((row.key == "reviewGuideModelSelection" ? "review-guide-model" : "source-control-writer-model"), scope))
                if row.traitsLabel != ""
                  WriterTraitsPicker(row=row, disabled=(busy or row.disabled), restInput=restInput)
              SettingsPageSwitch(checked=row.checked, label=(row.key == "reviewGuideModelSelection" ? "Use a separate review guide model" : "Use a separate source control writer model"), disabled=(busy or row.disabled or (not row.checked and row.status != "")), switchId=`scoped-${row.key}-enabled`, toggle=rest("scoped", `key=${row.key}&value=${row.checked ? "off" : "default"}`))
      if row.kind == "textarea"
        ScopedTextArea(mixed=row.mixed, value=row.value, placeholder=row.placeholder, label=row.title, fieldKey=row.key, busy=(busy or row.disabled), restInput=restInput)
      if row.child != "" or (row.key == "sourceControlWritingStyle" and row.value == "custom")
        ScopedTextArea(mixed=row.mixed, value=row.child, placeholder=row.placeholder, label="Custom source control writing instructions", fieldKey="sourceControlWritingStyle.customInstructions", busy=(busy or row.disabled), restInput=restInput)

// TraitsPicker beside the writer model (SourceControlWritingSettings): a pick saves that one trait
// on the resolved writer selection ("instance:model#optionId=value", source-control-view.ts).
component WriterTraitsPicker
  inject
    corePal: CorePalette
  props
    row: ScopedRow
    disabled: bool
    restInput: action
  derive items = row.traits.filter((option) => option.icon != "section" and option.icon != "section-rule").map((option) => KmItem(id=`scoped-${row.key}-effort-menu-${option.id}`, label=option.label))
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`effort-scoped-${row.key}`, source=`scoped-${row.key}-effort`)
        let target = kmTriggerTarget(items, k)
        if target != ""
          focus(target)
  view
    box position="relative"
      button id=`scoped-${row.key}-effort` popovertarget=`effort-scoped-${row.key}` key=triggerKey class=SettingsPickerFace border-color=corePal.input background-color=corePal.field disabled=disabled aria-label=row.traitsLabel testId=`scoped-${row.key}-effort` data-focus-stop=(disabled ? "" : "enabled page")
        CcIcon(name="brain", size=16, color=corePal.muted, weight=1.75)
        text row.traitsLabel font-size="0.875rem" line-height="1.25rem" color=corePal.text
        box opacity=0.7 flex-shrink=0
          CcIcon(name="chevron-down", size=14, color=corePal.text, weight=1.75)
      TraitsMenu(options=row.traits, pal=corePal, menuId=`effort-scoped-${row.key}`, items=items, keyed=0, choose=restInput("scoped", `key=${row.key}&value=${encodeURIComponent(row.value)}#`), testId=`scoped-${row.key}-effort-menu`)

// Inputs commit on blur, as the reference's onBlur writes do.
component ScopedTextField
  props
    value: string
    placeholder: string
    label: string
    fieldKey: string
    busy: bool
    restInput: action
  state draft = value
  action edit(next: string)
    draft = next
  view
    input value=draft input=edit change=restInput("scoped", `key=${fieldKey}&value=`) placeholder=placeholder class=FieldPlaceholder aria-label=label disabled=busy testId=`scoped-input-${fieldKey}` box-sizing="border-box" width="11.125rem" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.3125rem" padding-bottom="0.3125rem" line-height="1.25rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" id=`field-scoped-input-${fieldKey}` data-editable="yes" data-focus-stop=(busy ? "" : "enabled page")

component ScopedTextArea
  props
    mixed: bool
    value: string
    placeholder: string
    label: string
    fieldKey: string
    busy: bool
    restInput: action
  state draft = mixed ? "" : value
  state edited = false
  action edit(next: string)
    draft = next
    edited = true
  action commit(next: string)
    let saved = next.trim()
    if edited and (mixed or saved != value)
      restInput("scoped", `key=${fieldKey}&value=`, saved)
    draft = saved
    edited = false
  view
    column width="100%" max-width="42rem" padding-top="0.75rem" padding-bottom="0.875rem" box-sizing="border-box"
      textarea value=draft input=edit autocorrect="off" change=commit placeholder=placeholder class=FieldPlaceholder aria-label=label disabled=busy testId=`scoped-input-${fieldKey}` box-sizing="border-box" width="100%" height="6rem" padding="0.6875rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" id=`field-scoped-input-${fieldKey}` data-editable="yes" data-focus-stop=(busy ? "" : "enabled page") resize="vertical"

component DiscoveryMark
  props
    kind: string
    dot: string
  view
    box position="relative" width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
      if kind == "git"
        BrandGit(size=18)
      if kind == "jj"
        BrandJujutsu(size=18)
      if kind == "github"
        BrandGitHub(size=18)
      if kind == "gitlab"
        BrandGitLab(size=18)
      if kind == "azure-devops"
        BrandAzureDevOps(size=18)
      if kind == "bitbucket"
        BrandBitbucket(size=18)
      if kind == "gitcafe"
        BrandGitCafe(size=18)
      if kind == "forgejo"
        BrandForgejo(size=18)
      box position="absolute" left="-0.125rem" top="-0.125rem" width="0.5rem" height="0.5rem" border-radius="0.375rem" border-style="solid" border-width=2 border-color="light-dark(#fcfcfc, #000000)" box-sizing="content-box" margin-left="-0.125rem" margin-top="-0.125rem" background-color=(dot == "success" ? "#00bc7d" : (dot == "warning" ? "#fe9a00" : "light-dark(#70707b59, #a1a1a159)"))

component DiscoveryItem
  props
    item: DiscoveryRow
    first: bool
    credentials: HostCredentials[]
    busy: bool
    rest: action
    restInput: action
  state open = false
  action toggleOpen
    open = not open
  action reveal
    open = true
  view
    column width="100%" border-top-style="solid" border-top-width=(first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)" opacity=(item.comingSoon ? 0.8 : 1) testId=`discovery-${item.kind}`
      // A search jump to this host's settings lands on the stop while the details are closed; focusing it opens them
      // (AdvancedFold's reveal stop, settings-advanced.contract).
      if item.details
        box id=`source-control-host-${item.kind}-reveal` tabindex=-1 focusin=reveal position="absolute" width=1 height=1 opacity=0 pointer-events="none" aria-label=`${item.label} settings` data-focus-stop="reveal"
      row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="0.75rem" align-items="center"
        column flex=1 min-width=0 gap="0.25rem"
          row min-width=0 gap="0.5rem" align-items="center" flex-wrap="wrap"
            DiscoveryMark(kind=item.kind, dot=item.dot)
            text item.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1
            if item.version != ""
              text item.version font-family="monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
            if item.comingSoon
              text "Coming Soon" font-size="0.625rem" font-weight=500 line-height="0.875rem" padding-left="0.1875rem" padding-right="0.1875rem" border-radius="0.25rem" background-color="light-dark(#ff990014, #ff9b0029)" color="light-dark(#bb4d00, #ffb900)"
            if item.badge != ""
              text item.badge font-size="0.625rem" font-weight=500 line-height="0.875rem" padding-left="0.1875rem" padding-right="0.1875rem" border-radius="0.25rem" background-color="light-dark(#ff990014, #ff9b0029)" color="light-dark(#bb4d00, #ffb900)"
          row gap="0.25rem" align-items="center" flex-wrap="wrap"
            text item.summary font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)"
            if item.account
              text "as" font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)" aria-hidden=true
              // RedactedAccount (SourceControlSettings.tsx:160-168): each item reveals its own account.
              RedactedText(stop="enabled page", value=item.accountValue, placeholder=item.accountPlaceholder, label="Toggle source control account visibility", revealTip="Click to reveal account", hideTip="Click to hide account", testId=`reveal-account-${item.kind}`)
        row flex-shrink=0 align-items="center" gap="0.5rem"
          if item.details
            button press=toggleOpen aria-expanded=open aria-label=`Toggle ${item.label} details` testId=`discovery-details-${item.kind}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id=`discovery-details-${item.kind}` data-focus-stop="enabled page"
              if open
                LucideChevronUp(size=14, color="light-dark(#71717b, #a1a1a1)")
              else
                LucideChevronDown(size=14, color="light-dark(#71717b, #a1a1a1)")
          if not item.comingSoon
            SettingsPageSwitch(checked=item.enabled, label=`${item.label} availability`, disabled=true, switchId=`discovery-switch-${item.kind}`, toggle=toggleOpen)
      if open
        column width="100%" id=`source-control-host-${item.kind}` tabindex=-1
          for form in credentials.filter(form => form.kind == item.kind) key=form.key
            HostCredentialsForm(form=form, busy=busy, rest=rest, restInput=restInput)

component SourceControlPanel
  props
    data: SourceControlPage
    busy: bool
    error: string
    rest: action
    restInput: action
    restLocal: action
  view
    column width="100%" gap="2rem" testId="source-control-settings"
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="source-control-error" padding-left="1rem"
      if data.error != ""
        Card()
          SettingsNotice(message=data.error, warning=false)
      if data.available
        column width="100%" gap="0.625rem" testId="source-control-repositories"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Repositories")
          Card()
            for item in data.repositories key=`${data.scope}:${item.key}:${item.value}:${item.checked}`
              ScopedSettingRow(row=item, scope=data.scope, busy=busy, rest=rest, restInput=restInput)
        if data.vcs.length > 0
          column width="100%" gap="0.625rem" id="source-control" tabindex=-1 testId="source-control-vcs"
            row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" justify-content="space-between" id="source-control-scroll-target"
              SectionTitle(title=data.vcsTitle)
              button press=restLocal("rescan", "") disabled=busy aria-label="Rescan server environment" testId="rescan-source-control" width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="rescan-source-control" data-focus-stop=(busy ? "" : "enabled page")
                LucideRefreshCw(size=14, color="light-dark(#71717b, #a1a1a1)")
            Card()
              for item in data.vcs key=item.kind
                DiscoveryItem(item=item, first=(item.kind == "git"), credentials=data.hostCredentials, busy=busy, rest=rest, restInput=restInput)
        if data.providers.length > 0
          column width="100%" gap="0.625rem" id=(data.vcs.length > 0 ? "source-control-hosts" : "source-control") tabindex=-1 testId="source-control-providers"
            row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" id=(data.vcs.length > 0 ? "source-control-hosts-scroll-target" : "source-control-scroll-target")
              SectionTitle(title="Source control providers")
            Card()
              for item in data.providers key=item.kind
                DiscoveryItem(item=item, first=(item.kind == "github"), credentials=data.hostCredentials, busy=busy, rest=rest, restInput=restInput)
        if data.scanned and data.vcs.length == 0 and data.providers.length == 0
          column width="100%" gap="0.625rem" id="source-control" tabindex=-1
            row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" id="source-control-scroll-target"
              SectionTitle(title="Server environment")
            Card()
              column align-items="center" gap="0.5rem" padding="2rem" box-sizing="border-box" width="100%" text-wrap="balance"
                text (data.scanError != "" ? "Could not scan the server environment" : "Nothing detected yet") font-size="1rem" font-weight=600 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)"
                text (data.scanError != "" ? data.scanError : "Install Git on the server, add optional hosting integrations or credentials your workspace needs, then rescan.") font-size="0.875rem" line-height="1.25rem" text-align="center" max-width="24rem" color="light-dark(#71717b, #a1a1a1)"
                button press=restLocal("rescan", "") disabled=busy testId="scan-source-control" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" id="scan-source-control" data-focus-stop=(busy ? "" : "enabled page")
                  LucideRefreshCw(size=14, color="light-dark(#71717b, #a1a1a1)")
                  text "Scan" font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
        column width="100%" gap="0.625rem" testId="source-control-text-generation"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Writing & review")
          Card()
            for item in data.writing key=`${data.scope}:${item.key}:${item.value}:${item.checked}:${item.child}`
              ScopedSettingRow(row=item, scope=data.scope, busy=busy, rest=rest, restInput=restInput)
            AdvancedFold(foldId="source-control-text-generation", muted="light-dark(#71717b, #a1a1a1)", text="light-dark(#18181b, #f5f5f5)", divider="light-dark(#e3e3e780, #ffffff0a)")
              for item in data.writingAdvanced key=`${data.scope}:${item.key}:${item.value}:${item.checked}:${item.child}`
                ScopedSettingRow(row=item, scope=data.scope, busy=busy, rest=rest, restInput=restInput)

// The Browser and Devices pages (96fc7b9551, Integrations split by 9db433f4ba #25651): `view` "browser" or "devices".
component IntegrationsPanel
  props
    data: IntegrationsPage
    view: string
    busy: bool
    error: string
    rest: action
    restInput: action
    local: action // the profiles row's `restlocal:` ops
  view
    column width="100%" gap="2rem" testId="integrations-settings"
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="integrations-error" padding-left="1rem"
      if data.error != ""
        Card()
          SettingsNotice(message=data.error, warning=false)
      // BrowserSettingsPanel: Agent access (a scoped server setting, so only with a connected environment); Browsing and
      // Recordings, device-local ("ignore the header selection"), so they show with no connected environment too.
      // Browsing holds the profiles, "Open links in", Auto-show and Search engine, and the tab defaults under Advanced.
      if view == "browser" and data.available
        column width="100%" gap="0.625rem" testId="integrations-browser-access"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Agent access")
          Card()
            for item in data.browser key=`${data.scope}:${item.key}:${item.checked}`
              ScopedSettingRow(row=item, scope=data.scope, busy=busy, rest=rest, restInput=restInput)
      if view == "browser"
        column width="100%" gap="0.625rem" id="browser" tabindex=-1 testId="integrations-browser"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" id="browser-scroll-target"
            SectionTitle(title="Browsing")
          Card()
            column width="100%" id="browser-profiles" tabindex=-1
              BrowserProfilesSetting(view=data.browserProfiles, local=local)
            CardDivided()
              BrowserDefaults(linkTarget=data.linkTarget, restInput=restInput)
            CardDivided()
              BrowserAutoShowRow(view=data.browserProfiles.defaults, local=local)
            CardDivided()
              BrowserSearchEngineRow(view=data.browserProfiles.defaults, local=local)
            AdvancedFold(foldId="browser", muted="light-dark(#71717b, #a1a1a1)", text="light-dark(#18181b, #f5f5f5)", divider="light-dark(#e3e3e780, #ffffff0a)")
              BrowserTabDefaults(view=data.browserProfiles.defaults, local=local)
        column width="100%" gap="0.625rem" testId="integrations-browser-recordings"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Recordings")
          Card()
            BrowserRecordings(view=data.browserProfiles.defaults, local=local)
      if view == "devices" and data.available
        column width="100%" gap="0.625rem" id="devices" tabindex=-1 testId="integrations-devices"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" id="devices-scroll-target"
            SectionTitle(title="Devices")
          Card()
            DeviceRow(row=data.deviceHub, tool=data.hubTool, scope=data.deviceScope, busy=busy, rest=rest)
            // 1e2ecbd975 (5318d054a5): Simulator support, revealed once the hub is ready or the local host lacks a platform.
            for support in data.simulatorSupport key=support.key
              SimulatorSupportSettingsRow(row=support, busy=busy, rest=rest)
            DeviceRow(row=data.agentDevice, tool=data.agentTool, scope=data.deviceScope, busy=busy, rest=rest)
            column width="100%" id="device-hosts" tabindex=-1
              DeviceHostsRow(view=data.deviceHosts, busy=busy, rest=rest)
                if data.hostsRow.summary != ""
                  Inheritance(row=data.hostsRow, rest=rest, rowHovered=true)
            if data.easHosts.supported
              EasDeviceHostsRow(view=data.easHosts, busy=busy, rest=rest)
                if data.easHostsRow.summary != ""
                  Inheritance(row=data.easHostsRow, rest=rest, rowHovered=true)

component DeviceRow
  props
    row: ScopedRow
    tool: DeviceTool
    scope: string
    busy: bool
    rest: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    row hover=hover width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)" testId=`device-row-${row.key}`
      column flex=1 min-width=0 gap="0.25rem"
        row min-height="1.25rem" align-items="center" gap="0.375rem"
          text row.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
          if row.summary != ""
            Inheritance(row=row, rest=rest, rowHovered=hovered)
          box width="1.25rem" height="1.25rem"
        text row.description font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
      row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end" gap="0.5rem"
        DeviceVersions(tool=tool, busy=busy, rest=rest)
        ScopedSwitch(checked=row.checked, mixed=row.mixed, label=row.title, disabled=(busy or row.disabled), faded=(busy or row.disabled), on="light-dark(#1b4ed8, #346bf1)", off="light-dark(#d4d4d8, #ffffff1c)", thumb="light-dark(#fcfcfc, #000000)", thumbOff="light-dark(#fcfcfc, #a1a1a1)", reduced=false, switchId=`device-${row.key}`, press=rest("device", `key=${row.key}&value=${row.mixed or not row.checked ? "true" : "false"}&scope=${scope}`))

// SettingsGroup's divider above a row that draws none of its own.
component CardDivided
  slot
  view
    column width="100%" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)"
      children

// Browsing's Advanced rows (BrowserViewportSetting, BrowserZoomSetting, BrowserAppearanceSetting) and the Recordings
// rows (BrowserRecordingFrameRateSetting, BrowserRecordingInputSettings): browser-defaults.ts `browserDefaultsView`, each
// write `restlocal:browser-defaults` with `key=…&value=…`.
component BrowserTabDefaults
  inject
    rem: number
  props
    view: BrowserDefaultsView
    local: action
  action pick(key: string, value: string)
    local("browser-defaults", `key=${key}&value=${encodeURIComponent(value)}`)
  view
    column width="100%" testId="browser-defaults"
      BdRow(rowId="viewport", title="Default browser viewport", description="Tab size for you and agents. Fill fits the panel; other sizes show the device toolbar.", reset=view.viewportReset, resetLabel="default browser viewport", resetPress=pick("reset", "viewport"))
        BdViewportSelect(label=view.viewportLabel, width=(176 * rem / 16), options=view.viewportOptions, choose=pick("viewport"))
        if view.viewportSized
          BdViewportSize(view=view, pick=pick)
      CardDivided()
        BdRow(rowId="zoom", title="Default browser zoom", description="Page zoom applied to new browser tabs.", reset=view.zoomReset, resetLabel="default browser zoom", resetPress=pick("reset", "zoom"))
          SettingsPageSelect(selectId="browser-default-zoom", label="Default browser zoom", valueLabel=view.zoomLabel, empty=false, value="", width=(160 * rem / 16), disabled=false, options=view.zoomOptions, choose=pick("zoom"))
      CardDivided()
        BdRow(rowId="appearance", title="Default browser appearance", description="The color scheme pages are told to prefer. System follows your OS setting.", reset=view.appearanceReset, resetLabel="default browser appearance", resetPress=pick("reset", "appearance"))
          SettingsPageSelect(selectId="browser-default-appearance", label="Default browser appearance", valueLabel=view.appearanceLabel, empty=false, value="", width=(160 * rem / 16), disabled=false, options=view.appearanceOptions, choose=pick("appearance"))

component BrowserRecordings
  inject
    rem: number
  props
    view: BrowserDefaultsView
    local: action
  action pick(key: string, value: string)
    local("browser-defaults", `key=${key}&value=${encodeURIComponent(value)}`)
  view
    column width="100%" testId="browser-recordings"
      BdRow(rowId="frame-rate", title="Browser recording frame rate", description="Maximum recording rate. 30 fps saves CPU and storage; 60 fps is smoother.", reset=view.frameRateReset, resetLabel="browser recording frame rate", resetPress=pick("reset", "frame-rate"))
        SettingsPageSelect(selectId="browser-recording-frame-rate", label="Browser recording frame rate", valueLabel=view.frameRateLabel, empty=false, value="", width=(160 * rem / 16), disabled=false, options=view.frameRateOptions, choose=pick("frame-rate"))
      CardDivided()
        BdRow(rowId="key-presses", title="Show key presses in recordings", description="Show pressed keys and shortcuts in new recordings. Password fields are excluded.", reset=false, resetLabel="", resetPress=pick("reset", "none"))
          SettingsPageSwitch(checked=view.keyPresses, label="Show key presses in recordings", disabled=false, switchId="browser-recording-key-presses", toggle=pick("key-presses", view.keyPresses ? "false" : "true"))
      CardDivided()
        BdRow(rowId="mouse-presses", title="Show mouse presses in recordings", description="Highlight mouse presses and held buttons in new recordings.", reset=false, resetLabel="", resetPress=pick("reset", "none"))
          SettingsPageSwitch(checked=view.mousePresses, label="Show mouse presses in recordings", disabled=false, switchId="browser-recording-mouse-presses", toggle=pick("mouse-presses", view.mousePresses ? "false" : "true"))

// "Open links in" (BrowserLinkTargetRow), after the profiles.
component BrowserDefaults
  props
    linkTarget: string
    restInput: action
  view
    column width="100%" testId="browser-defaults-links"
      BrowserLinkTargetRow(value=linkTarget, restInput=restInput)

// IntegrationsSettings `BrowserLinkTargetSetting`, live (the client setting, written by
// `rest:browser-link-target`); its reset shows while it is not the default.
component BrowserLinkTargetRow
  inject
    rem: number
  props
    value: string
    restInput: action
  view
    row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" testId="browser-link-target-row"
      column flex=1 min-width=0 gap="0.25rem"
        row min-height="1.25rem" align-items="center" gap="0.375rem"
          text "Open links in" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
          box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center"
            if value != "system"
              button press=restInput("browser-link-target", "", "system") aria-label="Reset link target to default" testId="reset-browser-link-target" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="reset-browser-link-target" data-focus-stop="enabled page"
                LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
        text "Where links in the chat and terminal open. Hold ⌘ or Ctrl while clicking a link to open it in your default browser either way." font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
      row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end"
        SettingsPageSelect(selectId="browser-link-target", label="Open links in", valueLabel=(value == "app" ? "T3 Code" : "Your default browser"), empty=false, value=(value == "app" ? "app" : "system"), width=(160 * rem / 16), disabled=false, options=linkTargetOptions(), choose=restInput("browser-link-target", ""))

fn linkTargetOptions(): SelectOption[] = [SelectOption(value="system", label="Your default browser", selected=false), SelectOption(value="app", label="T3 Code", selected=false)]

// DeviceToolVersions: a muted inline button (underlined while hovered or open) and
// its popover — Running / Required / Installed in monospace, the update note and
// versionActions' Update / Check versions. PopoverPopup align="end": the popup's
// end at the trigger's end, 4 pt below, flipping near an edge.
component DeviceVersions
  props
    tool: DeviceTool
    busy: bool
    rest: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box position="relative" flex-shrink=0
      button popovertarget=`device-versions-${tool.kind}` hover=hover aria-label=tool.aria testId=`device-status-${tool.kind}` display="flex" flex-direction="row" align-items="center" height="1.5rem" padding=0 border-width=0 background-color="#00000000" id=`device-status-${tool.kind}` data-focus-stop="enabled page"
        text tool.label font-size="1rem" font-weight=500 line-height="1.5rem" color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)") text-decoration-line=(hovered ? "underline" : "none") white-space="nowrap"
      column id=`device-versions-${tool.kind}` popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" width="20rem" padding="1rem" gap=0 box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=tool.title testId=`device-versions-${tool.kind}-popover`
        text tool.title font-size="0.875rem" font-weight=600 line-height="0.875rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=2
        if tool.known
          column gap="0.25rem" margin-top="1rem"
            DeviceVersionLine(term="Running", value=tool.running)
            DeviceVersionLine(term="Required", value=tool.required)
            DeviceVersionLine(term="Installed", value=tool.installed)
        else
          text "Versions have not been checked." font-size="0.75rem" line-height="1rem" margin-top="0.75rem" color="light-dark(#71717b, #a1a1a1)"
        text "Tools update automatically on this host when needed." font-size="0.75rem" line-height="1rem" margin-top="1rem" padding-top="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e780, #ffffff0a)" color="light-dark(#71717b, #a1a1a1)"
        if tool.error != ""
          text tool.error role="status" font-size="0.75rem" line-height="1rem" margin-top="0.5rem" color="light-dark(#fb2c36, #fb414a)"
        if tool.update != "" or tool.inspect
          row gap="0.5rem" margin-top="0.75rem" flex-wrap="wrap"
            if tool.update != ""
              button press=rest("device-tools", `action=update&tool=${tool.kind}`) disabled=busy testId=`device-update-${tool.kind}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" opacity=(busy ? 0.64 : 1) id=`device-update-${tool.kind}` data-focus-stop=(busy ? "" : "enabled page")
                text tool.update font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff" white-space="nowrap"
            if tool.inspect
              button press=rest("device-tools", "action=check") disabled=busy testId=`device-check-${tool.kind}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" opacity=(busy ? 0.64 : 1) id=`device-check-${tool.kind}` data-focus-stop=(busy ? "" : "enabled page")
                text (busy ? "Checking…" : "Check versions") font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"

component DeviceVersionLine
  props
    term: string
    value: string
  view
    row width="100%" gap="1.5rem" align-items="flex-start"
      text term font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
      text value font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" text-align="right" flex=1 min-width=0 overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
