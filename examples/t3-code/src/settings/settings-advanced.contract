// AdvancedSettings (T3 Code 7c3b3b3605ef apps/web/src/components/settings/AdvancedSettings.tsx): power-user rows
// folded at the end of a section, closed on arrival. The trigger is a 40 pt row of muted 12 pt medium text, the
// foreground while hovered, with a 14 pt chevron that turns 90° in 150 ms; the open fold's rows sit under a divider
// and are divided as the section's are. A search jump to a row inside a closed fold lands on its `-reveal` stop
// (settings-search.ts FOLDED_TARGETS): taking the focus opens the fold, as the reference opens it for a target id
// before the row mounts. Only that jump focuses the stop (tabindex -1; its focus-stop word is "reveal", which the dialog
// and Settings guards, reading "enabled", pass by). The Mac host focuses only a node with a box, so the stop is a
// transparent 1 pt square out of the flow.
component AdvancedFold
  inject
    still: bool
  props
    foldId: string
    muted: string
    text: string
    divider: string
  slot
  state open = false
  state hovered = false
  action toggle
    open = not open
  action reveal
    open = true
  action hover(over: bool)
    hovered = over
  view
    column width="100%" border-top-width=1 border-top-style="solid" border-color=divider testId=`settings-advanced-${foldId}` data-paint="border" data-pick="border"
      button press=toggle hover=hover aria-expanded=open id=`settings-advanced-${foldId}` testId=`settings-advanced-${foldId}-toggle` display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.375rem" width="100%" min-height="2.5rem" padding-left="1rem" padding-right="1rem" box-sizing="border-box" border-width=0 border-bottom-left-radius=(open ? "0px" : "0.75rem") border-bottom-right-radius=(open ? "0px" : "0.75rem") background-color="#00000000" data-focus-stop="enabled page" title=""
        // AdvancedSettings.tsx: rounded-b-xl until it opens, focus-visible:ring-2 ring-inset ring-ring.
        :focus-visible
          box-shadow="inset 0 0 0 2px light-dark(#1b4ed8, #346bf1)"
        box display="flex" flex-shrink=0 rotate=(open ? "90deg" : "0deg") transition=(still ? "none" : "rotate 150ms cubic-bezier(0.4, 0, 0.2, 1)")
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" aria-hidden=true
            path d="m9 18 6-6-6-6" stroke=(hovered ? text : muted) stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round"
        text "Advanced" font-size="0.75rem" font-weight=500 line-height="1rem" color=(hovered ? text : muted) id=`paint-AdvancedFold-${foldId}` data-paint="mutedForeground" data-pick="mutedForeground"
      box id=`settings-advanced-${foldId}-reveal` tabindex=-1 focusin=reveal position="absolute" width=1 height=1 opacity=0 pointer-events="none" aria-label="Advanced settings" data-focus-stop="reveal" testId=`settings-advanced-${foldId}-reveal`
      if open
        column width="100%" border-top-width=1 border-top-style="solid" border-color=divider testId=`settings-advanced-${foldId}-rows`
          children
