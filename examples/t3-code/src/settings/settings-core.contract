// SETTINGS_DETAIL_PAGE_PARENTS: a detail page without a nav entry highlights the page that links to it.
fn navActiveRoute(route: string): string = route == "diagnostics" ? "maintenance" : (route == "open-source-licenses" ? "about" : route)

component CoreIcon
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" fill="none" color=color flex-shrink=0 aria-hidden=true
      path d=coreIconPath(name) stroke=color stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round"

component CorePaintIcon
  props
    ownId: string
    paint: string
    name: string
    size: number
    color: string
  view
    svg id=ownId data-paint=paint data-pick=paint width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" fill="none" color=color flex-shrink=0 aria-hidden=true
      path d=coreIconPath(name) stroke=color stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round"

component CoreMark
  props
    label: string
    ink: string
    surface: string
  view
    box width="0.875rem" height="0.875rem" border-radius="0.21875rem" background-color=surface display="flex" align-items="center" justify-content="center" flex-shrink=0
      text label font-family="ui-monospace" font-size="0.4375rem" font-weight=700 color=ink

// SettingsSidebarNav (96fc7b9551): the modal's own nav column, w-60 with border-e on bg-sidebar. Search (role
// combobox, `/` focuses it), then the section groups (SETTINGS_NAV_GROUPS: a heading or, without one, space alone)
// or the ranked results. testIds keep `settings-<route>` for the drivers.
component SettingsNav
  props
    nav: CoreNav
    route: string
    query: string
    pal: CorePalette
    active: number
    edit: action
    onKey: action
    pick: action
    clear: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  // SettingsSidebarNav's search ignores a key that confirms an input method's candidate.
  action searchKey(k: string, e: KeyboardEvent)
    if not e.isComposing
      onKey(k)
  view
    column width="15rem" height="100%" flex-shrink=0 position="relative" background-color=pal.sidebar border-right-width=1 border-right-style="solid" border-color=pal.sidebarBorder testId="settings-navigation" id="settings-navigation" data-paint="sidebar border" data-pick="sidebar"
      column flex=1 min-height=0 padding="0.5rem" gap="0.5rem" position="relative"
        row height="2rem" flex-shrink=0 padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" border-radius="0.375rem" align-items="center" box-sizing="border-box"
          CorePaintIcon(ownId=`paint-icon-SettingsNav-2-${route}`, paint="mutedForeground", name="search", size=16, color=pal.sidebarMuted)
          // "Search" is drawn under the transparent field in SidebarInput's placeholder:text-sidebar-muted-foreground
          // while it is empty; it stays text (not a ::placeholder part) as the theme inspector's mutedForeground pick.
          box flex=1 min-width=0 height="1.3125rem" position="relative"
            if query == ""
              text "Search" font-size="0.875rem" font-weight=500 line-height="1.3125rem" color=pal.sidebarMuted white-space="nowrap" position="absolute" left=0 top=0 testId="settings-search-placeholder" id="settings-search-placeholder" data-paint="mutedForeground" data-pick="mutedForeground"
            input value=query input=edit key=searchKey placeholder="" aria-label="Search settings" role="combobox" aria-expanded=(nav.searching and nav.count > 0) id="settings-search" testId="settings-search" font-size="0.875rem" font-weight=500 line-height="1.3125rem" position="absolute" left=0 top=0 width="100%" height="1.3125rem" border-width=0 padding=0 background-color="#00000000" color=pal.sidebarText autocorrect="off" data-paint="sidebar" data-pick="sidebar" data-editable="yes" data-focus-stop="enabled"
          if query != ""
            button press=clear class=SettingsGhost width="1.25rem" height="1.25rem" min-height="1.25rem" padding="0.25rem" border-radius="0.375rem" aria-label="Clear settings search" testId="clear-settings-search" title="" id="clear-settings-search" data-focus-stop="enabled"
              CorePaintIcon(ownId=`paint-icon-SettingsNav-3-${route}`, paint="mutedForeground", name="x", size=12, color=pal.sidebarMuted)
          else
            box height="1.25rem" min-width="1.25rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-radius="0.25rem" background-color=pal.kbd display="flex" align-items="center" justify-content="center" id=`paint-SettingsNav-5-${route}` data-paint="sidebar" data-pick="sidebar"
              text "/" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.muted id=`paint-SettingsNav-6-${route}` data-paint="mutedForeground" data-pick="mutedForeground"
        if nav.searching and nav.count == 0
          text "No settings found" role="status" font-size="0.75rem" color=pal.sidebarMuted text-align="center" padding-top="1.5rem" padding-bottom="1.5rem" testId="settings-search-empty" id="settings-search-empty" data-paint="mutedForeground" data-pick="mutedForeground"
        scroll flex=1 min-height=0 width="100%" testId="settings-navigation-scroll"
          column gap="0.25rem" width="100%" role=(nav.searching ? "listbox" : "list") aria-label=(nav.searching ? "Settings search results" : "Settings sections")
            for item in nav.items key=item.id
              if nav.searching
                button press=pick(item.route, item.target, item.scope, item.id) hover=hover(item.id) role="option" aria-selected=(item.id == hovered or (hovered == "" and item.active)) class=SettingsGhost justify-content="flex-start" align-items="flex-start" width="100%" min-height="3.25rem" padding="0.5rem" gap="0.5rem" border-radius="0.5rem" background-color=((item.id == hovered or (hovered == "" and item.active)) ? pal.rowActive : "#00000000") testId=`settings-${item.id}` id=`settings-${item.id}` data-paint=`${((item.id == hovered or (hovered == "" and item.active)) ? "sidebarRowSelected" : "")}` data-pick=(((item.id == hovered or (hovered == "" and item.active)) ? "sidebarRowSelected" : "") != "" ? ((item.id == hovered or (hovered == "" and item.active)) ? "sidebarRowSelected" : "") : "")
                  // SettingsSectionIcon (size-4): on the title's line.
                  box height="1.25rem" flex-shrink=0 display="flex" align-items="center"
                    CorePaintIcon(ownId=`paint-icon-SettingsNav-4-${route}-${item.id}`, paint=((item.id == hovered or (hovered == "" and item.active)) ? "sidebar" : "mutedForeground"), name=item.icon, size=16, color=((item.id == hovered or (hovered == "" and item.active)) ? pal.sidebarText : pal.sidebarIcon))
                  column flex=1 min-width=0 gap=0 align-items="flex-start"
                    text item.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.sidebarText line-clamp=1 id=`paint-SettingsNav-9-${route}-${item.id}` data-paint="sidebar" data-pick="sidebar"
                    text item.section font-size="0.6875rem" font-weight=500 line-height="1rem" color=pal.sectionMuted line-clamp=1 id=`paint-SettingsNav-10-${route}-${item.id}` data-paint="mutedForeground" data-pick="mutedForeground"
              else
                if item.heading != ""
                  text item.heading role="heading" aria-level=3 font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" margin-top=(item.groupStart ? "0.75rem" : "0rem") color=pal.sectionMuted id=`paint-SettingsNav-heading-${item.id}` data-paint="mutedForeground" data-pick="mutedForeground"
                button press=pick(item.route, "", "", item.id) margin-top=(item.groupStart and item.heading == "" ? "0.75rem" : "0rem") hover=hover(item.id) aria-selected=(navActiveRoute(route) == item.route) class=SettingsGhost justify-content="flex-start" width="100%" height="2rem" padding-left="0.625rem" padding-right="0.625rem" gap="0.5rem" border-radius="0.5rem" background-color=(navActiveRoute(route) == item.route ? pal.rowActive : (item.id == hovered ? pal.rowHover : "#00000000")) testId=`settings-${item.id}` id=`settings-${item.id}` data-paint=`${(navActiveRoute(route) == item.route ? "sidebarRowSelected" : (item.id == hovered ? "sidebarRowSelected" : ""))}` data-pick=((navActiveRoute(route) == item.route ? "sidebarRowSelected" : (item.id == hovered ? "sidebarRowSelected" : "")) != "" ? (navActiveRoute(route) == item.route ? "sidebarRowSelected" : (item.id == hovered ? "sidebarRowSelected" : "")) : "") data-focus-stop="enabled"
                  CorePaintIcon(ownId=`paint-icon-SettingsNav-5-${route}-${item.id}`, paint=(navActiveRoute(route) == item.route ? "sidebar" : "mutedForeground"), name=item.icon, size=16, color=(navActiveRoute(route) == item.route ? pal.sidebarText : pal.sidebarIcon))
                  text item.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(navActiveRoute(route) == item.route ? pal.sidebarText : pal.sidebarMuted) line-clamp=1 id=`paint-SettingsNav-12-${route}-${item.id}` data-paint=`${(navActiveRoute(route) == item.route ? "sidebar" : "mutedForeground")}` data-pick=((navActiveRoute(route) == item.route ? "sidebar" : "mutedForeground") != "" ? (navActiveRoute(route) == item.route ? "sidebar" : "mutedForeground") : "")
      button press=onKey("/") aria-keyshortcuts="/" aria-label="Focus settings search" position="absolute" width=1 height=1 opacity=0 left=0 top=0 tabindex=-1 testId="settings-search-shortcut" title=""
      // ⌘F focuses it too, from a text field as well (SettingsSidebarNav's isFindShortcut).
      button -exact-menu="none" press=onKey("/") aria-keyshortcuts="Meta+F" aria-label="Find in settings" position="absolute" width=1 height=1 opacity=0 left=0 top=0 tabindex=-1 testId="settings-find-shortcut" title=""

// The settings route's header (96fc7b9551 _chat.settings.tsx): h-12 with border-b, ps-5 pe-2, the breadcrumb,
// then Restore device defaults on General only and AppRouteModalClose ("Close (Esc)").
component SettingsTopBar
  props
    route: string
    crumb: string
    pal: CorePalette
    busy: bool
    restorable: bool
    // Escape is the close button's unless something inside owns it (app-settings.contract escapeOwned).
    escapeFree: bool
    restore: action
    close: action
  view
    row height="3rem" min-height="3rem" flex-shrink=0 align-items="center" gap="0.75rem" padding-left="1.25rem" padding-right="0.5rem" box-sizing="border-box" width="100%" border-bottom-width=1 border-bottom-style="solid" border-color=pal.border testId="settings-header"
      row role="navigation" aria-label="Settings breadcrumb" gap="0.75rem" align-items="center" min-width=0
        if crumb != "Settings"
          text "Settings" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.muted flex-shrink=0 id=`paint-SettingsTopBar-1-${route}` data-paint="mutedForeground" data-pick="mutedForeground"
          text "/" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.muted flex-shrink=0 aria-hidden=true id=`paint-SettingsTopBar-2-${route}` data-paint="mutedForeground" data-pick="mutedForeground"
        text crumb font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text line-clamp=1 testId="settings-breadcrumb-current" id="settings-breadcrumb-current" data-paint="text" data-pick="text"
      row margin-left="auto" flex-shrink=0 align-items="center" gap="0.25rem"
        if route == "general"
          // Ghost xs: px 7, the icon's -mx-0.5 inside mx-1, gap 1; disabled:opacity-64 dims icon and label.
          button id="settings-restore-defaults" press=restore class=SettingsGhost height="1.5rem" min-height="1.5rem" padding-left="0.3125rem" padding-right="0.4375rem" gap="0.125rem" border-radius="0.5rem" disabled=(busy or not restorable) opacity=(restorable ? 1 : 0.64) aria-label="Restore device defaults" testId="restore-device-defaults" data-focus-stop=(busy or not restorable ? "" : "enabled")
            svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" flex-shrink=0 aria-hidden=true
              path d=coreIconPath("rotate-ccw") stroke=pal.muted stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round"
            text "Restore device defaults" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.text id=`paint-SettingsTopBar-4-${route}` data-paint="text" data-pick="text"
        AppRouteModalClose(closeId="close-settings", escape=escapeFree, color=pal.text, hoverFill=pal.rowHover, dismiss=close)
