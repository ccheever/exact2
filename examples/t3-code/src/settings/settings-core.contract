// Settings shell: navigation sidebar, top bar, scope sentence and the setting rows.
// Geometry and colours follow the served reference
// (SettingsSidebarNav, WorkspacePageHeader, SettingsScopeSentence, settingsLayout,
// ui/select, ui/switch); colours arrive as light-dark() tokens from the theme palette.
use CoreOption, CorePalette, SettingsGhost from "./settings-core-shared.contract"
use AppRouteModalClose from "../shell/app-route-modal.contract"
use FontDiffPreview from "../shared/shapes.contract"
use EditorView from "../appearance/settings-appearance-editor-shapes.contract"
use ImportView from "../appearance/settings-appearance-editor-shapes.contract"
use KillConfirm from "./settings-a-telemetry.contract"
use HostEditorView from "../device/settings-a-hosts.contract"
use HostCheckGroup from "../device/settings-a-hosts.contract"
use EasEditorView from "../device/settings-eas-hosts.contract"
use ProviderInstanceMark from "../shared/icons-kit.contract"

use InheritanceGroup from "./settings-inheritance.contract"
shape CoreRow
  id: string
  title: string
  description: string
  status: string
  kind: string
  checked: bool
  value: string
  label: string
  icon: string
  width: number
  options: CoreOption[]
  value2: string
  label2: string
  options2: CoreOption[]
  driver: string
  badge: string
  badgeColor: string
  markIcon: string
  inheritance: string
  inheritanceSummary: string
  resettable: bool
  resetLabel: string
  disabled: bool
  inert: bool
  mixed: bool
  note: string
  min: number
  max: number
  step: number
  target: string
  placeholder: string
  suffix: string
  info: string
  divider: bool
  layers: CoreOption[]
  layerGroups: InheritanceGroup[]
  layerTitle: string
  amount: number
  // A font row's preview size in px: the prompt sample uses the Prompt font size, the code sample the code size.
  previewSize: number
  menuWidth: number
  qr: QrMark[]
// About → Mobile app (settings-mobile-beta.ts): one QR code as boxes, one per dark run.
shape QrCell
  x: number
  y: number
  w: number
  h: number
shape QrMark
  id: string
  url: string
  label: string
  caption: string
  cells: QrCell[]
shape CoreSection
  id: string
  title: string
  collapsible: bool
  toggle: bool
  rows: CoreRow[]
  // The rows its Advanced fold holds (settings-advanced.contract); empty draws no fold.
  advanced: CoreRow[]
shape ScopeChoice
  id: string
  label: string
  secondary: string
  mark: string
  ink: string
  surface: string
  member: string
  selected: bool
  offline: bool
// SettingsScopeNotice's rows (settings-scope-notice.ts, drawn by settings-scope-notice.contract).
shape ScopeNoticeChoice
  key: string
  label: string
  secondary: string
  icon: string
  kind: string
  mark: string
  ink: string
  surface: string
  project: string
  machine: string
  member: string
shape ScopeNoticeGroup
  key: string
  title: string
  choices: ScopeNoticeChoice[]
shape CoreNavItem
  id: string
  route: string
  target: string
  title: string
  section: string
  icon: string
  scope: string
  active: bool
  // SETTINGS_NAV_GROUPS: the heading drawn above a group's first page ("" for none), and whether the page starts a
  // group after the first (gap-4 between groups, gap-1 between pages).
  heading: string
  groupStart: bool
shape CoreNav
  items: CoreNavItem[]
  searching: bool
  count: number
  firstRoute: string
  firstTarget: string
  firstId: string

shape Wire
  canvas: string
  sidebar: string
  surface: string
  accentSurface: string
  message: string
  action: string
shape ModeTile
  id: string
  label: string
  aria: string
  selected: bool
  split: bool
  left: Wire
  right: Wire
shape ThemeOrb
  mode: string
  base: string
  accent: string
  accentMid: string
  action: string
  picked: bool
  ax: number
  ay: number
  px: number
  py: number
  ar: number
  pr: number
shape ThemeCard
  id: string
  label: string
  selected: bool
  custom: bool
  canvasLight: string
  accentLight: string
  canvasDark: string
  accentDark: string
  orbs: ThemeOrb[]
  collection: bool
  collectionId: string
  primary: string
  primaryLabel: string
  variants: VariantMode[]
  removal: RemovalOption[]
  picked: number
  pickedIds: string
shape VariantOption
  themeId: string
  label: string
  active: bool
  aria: string
  orb: ThemeOrb
  x: number
  y: number
  delay: number
shape VariantMode
  mode: string
  themeId: string
  label: string
  more: number
  active: bool
  aria: string
  offset: number
  orb: ThemeOrb
  options: VariantOption[]
shape RemovalOption
  themeId: string
  label: string
  orbs: ThemeOrb[]
  checked: bool

shape BackgroundSwitch
  id: string
  label: string
  checked: bool
shape BackgroundDialog
  available: bool
  policy: string
  policyLabel: string
  policies: CoreOption[]
  git: number
  health: number
  active: number
  idle: number
  switches: BackgroundSwitch[]

shape ArchiveConfirm
  id: string
  title: string
shape SettingsCore
  // The search jump this answer is for (settingsFocusTarget) and the reveal stop of the fold its row sits under, '' for none.
  jumpTarget: string
  jumpStop: string
  // The jump names a row that exists only with Separate fonts on, which is still off: the jump waits for it.
  separateFontsWanted: bool
  ready: bool
  route: string
  breadcrumb: string
  showScope: bool
  kind: string
  message: string
  notice: string
  noticeGroups: ScopeNoticeGroup[]
  environmentLabel: string
  projectLabel: string
  projectMark: string
  projectInk: string
  projectSurface: string
  connective: string
  environmentChoices: ScopeChoice[]
  environmentIcon: string
  projectChoices: ScopeChoice[]
  // One entry each, keyed by its label: the scope sentence remounts a label that changes.
  environmentKeyed: ScopeChoice[]
  projectKeyed: ScopeChoice[]
  representative: string
  showAllEnvironments: bool
  allEnvironmentsProject: string
  allEnvironmentsMember: string
  scopeEnvironment: string // the scope's representative environment; Settings' own setup links open Providers there
  scopeKey: string
  sections: CoreSection[]
  cliSections: CoreSection[]
  // The Project page's Model row (General's default-model row in the project scope), or none.
  projectModel: CoreRow[]
  restoreCount: number
  restoreText: string
  appearanceMode: string
  tiles: ModeTile[]
  themes: ThemeCard[]
  typographyAdvanced: bool
  themeLight: string
  palette: CorePalette
  interfaceFont: string
  codeFont: string
  interfaceSize: number
  codeSize: number
  // Appearance › Typography's code sample (settings-font-previews.ts).
  codePreview: FontDiffPreview
  wordWrap: bool
  panelDuration: number
  // The Quit shortcut setting ("direct", "hold" or "double-click"), which the window's ⌘Q hold reads (app.contract quitHoldKey).
  quitMode: string
  background: BackgroundDialog
  archiveConfirm: ArchiveConfirm
  updateConfirm: bool
  killConfirm: KillConfirm
  hostEditor: HostEditorView
  hostChecks: HostCheckGroup[]
  easEditor: EasEditorView
  saOpen: bool
  editor: EditorView
  themeImport: ImportView

// Lucide geometry from the served reference, one path per icon (circles and rects as arcs).
