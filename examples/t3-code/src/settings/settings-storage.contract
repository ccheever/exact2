// Settings → Storage (reference StorageSettings.tsx): Worktrees and Artifacts
// and logs at an environment scope; the project's cleanup mode and, when it is
// Custom, its own worktree rules at a project scope.
use SettingsSection from "./settings-kit.contract"
use SettingsRow from "./settings-kit.contract"
use SettingsSwitch from "./settings-kit.contract"
use SettingsSelect from "./settings-kit.contract"
use SettingsNotice from "./settings-kit.contract"
use SelectOption from "./settings-kit.contract"
use LucideChevronRight from "./settings-icons.contract"
use LucideMinus from "./settings-icons.contract"
use LucidePlus from "./settings-icons.contract"

shape StorageRuleView
  key: string
  label: string
  description: string
  enabled: bool
  days: string
  retention: bool
  first: bool
  decrease: string
  increase: string
shape CleanupEntry
  id: string
  path: string
  detail: string
shape CleanupReport
  id: string
  label: string
  counts: string
  description: string
  entries: CleanupEntry[]
shape StoragePage
  available: bool
  project: bool
  error: string
  notice: string
  mode: string
  modeLabel: string
  modeDescription: string
  scope: string
  modes: SelectOption[]
  worktrees: StorageRuleView[]
  artifacts: StorageRuleView[]
  cleanupSummary: string
  cleanupReports: CleanupReport[]

component StoragePanel
  props
    data: StoragePage
    busy: bool
    error: string
    rest: action
    restInput: action
  view
    column width="100%" gap="2rem" testId="storage-settings"
      if data.error != ""
        SettingsNotice(message=data.error, warning=true)
      if data.notice != ""
        SettingsNotice(message=data.notice, warning=false)
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#dc2626, #f87171)" role="alert" testId="storage-error" padding-left="1rem"
      if data.available
        SettingsSection(title="Worktrees", sectionId="storage-worktrees")
          if data.project
            SettingsRow(title="Automatic worktree cleanup", description=data.modeDescription, first=true, rowId="storage-row-mode")
              SettingsSelect(selectId="storage-mode", label="Automatic worktree cleanup", valueLabel=data.modeLabel, empty=false, value="", width=160, disabled=busy, options=data.modes, choose=restInput("storage", "key=mode&value="))
          for rule in data.worktrees key=`${data.scope}:${rule.key}:${rule.days}:${rule.enabled}`
            SettingsRow(title=rule.label, description=rule.description, first=rule.first, rowId=`storage-row-${rule.key}`)
              StorageControl(rule=rule, busy=busy, rest=rest, restInput=restInput)
        if data.artifacts.length > 0
          SettingsSection(title="Artifacts and logs", sectionId="storage-artifacts")
            for rule in data.artifacts key=`${data.scope}:${rule.key}:${rule.days}:${rule.enabled}`
              SettingsRow(title=rule.label, description=rule.description, first=rule.first, rowId=`storage-row-${rule.key}`)
                StorageControl(rule=rule, busy=busy, rest=rest, restInput=restInput)

      if data.cleanupReports.length > 0
        CleanupLastRun(summary=data.cleanupSummary, reports=data.cleanupReports)

component CleanupLastRun
  props
    summary: string
    reports: CleanupReport[]
  state open = false
  action toggle
    open = not open
  view
    column width="100%" border-radius="0.875rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e899, #ffffff09)" background-color="light-dark(#ffffff66, #11111166)" testId="storage-cleanup-last-run"
      button press=toggle aria-expanded=open width="100%" box-sizing="border-box" padding="1rem" gap="0.75rem" display="flex" align-items="center" background-color="#00000000" border-width=0
        LucideChevronRight(size=14, color="light-dark(#71717b, #818181)")
        text "Last run" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        text summary title=summary flex=1 min-width=0 line-clamp=1 text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" font-variant-numeric="tabular-nums"
      if open
        for report in reports key=report.id
          column width="100%" padding="1rem" gap="0.5rem" box-sizing="border-box" border-top-width=1 border-top-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)"
            if reports.length > 1
              text report.label font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            text report.counts font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
            text report.description font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
            for entry in report.entries key=entry.id
              column width="100%" gap="0.125rem"
                text entry.path title=entry.path max-width="100%" line-clamp=1 font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
                text entry.detail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// A switch, or RetentionControl: [−][N days][+] when on, "Off" when off.
component StorageControl
  inject
    rem: number
  props
    rule: StorageRuleView
    busy: bool
    rest: action
    restInput: action
  state draft = rule.days
  action edit(next: string)
    draft = next
  view
    row align-items="center" gap="0.75rem"
      if rule.retention and rule.enabled
        row role="group" align-items="center" height="1.75rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow="0 1px 2px #0000000a"
          button press=rest("storage", `key=${rule.key}&value=${rule.decrease}`) disabled=busy aria-label=`Decrease ${rule.label}` testId=`storage-decrease-${rule.key}` width="2.125rem" height="1.625rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
            LucideMinus(size=16, color="light-dark(#27272a, #f5f5f5)")
          input value=draft input=edit change=restInput("storage", `key=${rule.key}&value=`) disabled=busy aria-label=`${rule.label} in days` testId=`storage-days-${rule.key}` width=((draft.length * 8 + 19) * rem / 16) height="1.625rem" padding-left="0.5625rem" padding-right=0 padding-top=0 padding-bottom=0 position="relative" top="0.28125rem" line-height="1.625rem" border-width=0 background-color="#00000000" font-size="0.875rem" text-align="right" color="light-dark(#27272a, #f5f5f5)" autocorrect="off"
          text "days" font-size="0.75rem" line-height="1rem" padding-right="0.5rem" color="light-dark(#27272a, #f5f5f5)" aria-hidden=true
          button press=rest("storage", `key=${rule.key}&value=${rule.increase}`) disabled=busy aria-label=`Increase ${rule.label}` testId=`storage-increase-${rule.key}` width="2.125rem" height="1.625rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
            LucidePlus(size=16, color="light-dark(#27272a, #f5f5f5)")
      if rule.retention and not rule.enabled
        text "Off" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      SettingsSwitch(checked=rule.enabled, label=rule.label, disabled=busy, switchId=`storage-toggle-${rule.key}`, toggle=rest("storage", `key=${rule.key}&value=${rule.retention ? (rule.enabled ? "null" : "8") : (rule.enabled ? "false" : "true")}`))
