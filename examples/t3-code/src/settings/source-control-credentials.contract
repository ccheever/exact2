// SourceControlHostSettings and GitHubAccountSettings/GitHubTokenSettings, T3 Code 9c161462c9.
use SelectOption from "./settings-kit.contract"
use SettingsSelect from "./settings-kit.contract"
use SettingsSwitch from "./settings-kit.contract"
use RedactedText from "../shared/redacted-text.contract"

shape BrokenHostAccount
  key: string
  value: string
  placeholder: string
  error: string
shape GitHubHostAccount
  host: string
  enabled: bool
  selected: string
  accountValue: string
  accountPlaceholder: string
  options: SelectOption[]
  warning: string
  environmentWarning: string
  broken: BrokenHostAccount[]
shape HostCredentialField
  key: string
  label: string
  description: string
  secret: bool
  value: string
  saved: bool
shape SavedTokenHost
  host: string
shape HostCredentials
  kind: string
  key: string
  environmentId: string
  disabled: bool
  groups: GitHubHostAccount[]
  savedHosts: SavedTokenHost[]
  fields: HostCredentialField[]

component HostCredentialsForm
  props
    form: HostCredentials
    busy: bool
    rest: action
    restInput: action
  state tokenHost = "github.com"
  state tokenDraft = ""
  action hostInput(next: string)
    tokenHost = next
  action tokenInput(next: string)
    tokenDraft = next
  view
    column width="100%" gap="0.75rem" padding="1rem" padding-top="0.25rem" box-sizing="border-box" testId=`host-credentials-${form.kind}`
      if form.kind == "github"
        text "Choose which gh login each GitHub host uses, or turn a host off." font-size="0.75rem" color="light-dark(#71717b, #818181)"
        if form.groups.length == 0
          text "Sign in with gh auth login on the server host, then rescan to choose accounts here." font-size="0.75rem" color="light-dark(#71717b, #818181)"
        for group in form.groups key=group.host
          column width="100%" gap="0.5rem"
            row width="100%" align-items="center" justify-content="space-between"
              text group.host font-size="0.75rem" font-weight=500
              SettingsSwitch(checked=group.enabled, label=`Use GitHub on ${group.host}`, disabled=(busy or form.disabled), switchId=`github-host-${group.host}`, toggle=rest("host-credentials", `environment=${form.environmentId}&kind=github&action=enabled&host=${encodeURIComponent(group.host)}&value=${group.enabled ? "false" : "true"}`))
            row width="100%" align-items="center" justify-content="space-between" gap="0.5rem"
              RedactedText(value=group.accountValue, placeholder=group.accountPlaceholder, label="Toggle GitHub account visibility", revealTip="Reveal account", hideTip="Hide account", testId=`github-account-reveal-${group.host}`)
              if group.options.length > 2
                SettingsSelect(selectId=`github-account-${group.host}`, label=`GitHub account for ${group.host}`, valueLabel=(group.selected == "" ? "Active gh account" : "Chosen account"), empty=false, value="", width=192, disabled=(busy or form.disabled or not group.enabled), options=group.options, choose=restInput("host-credentials", `environment=${form.environmentId}&kind=github&action=account&host=${encodeURIComponent(group.host)}&value=`))
            for option in group.options.filter(option => option.value != "") key=option.value
              row gap="0.5rem" align-items="center"
                text option.label font-size="0.75rem" color="light-dark(#71717b, #818181)"
                RedactedText(value=option.value, placeholder=option.label, label=`Reveal ${option.label}`, revealTip="Reveal account", hideTip="Hide account", testId=`github-option-${group.host}-${option.value}`)
            if group.warning != ""
              text group.warning font-size="0.75rem" color="light-dark(#bb4d00, #ffb900)"
              button appearance="none" press=rest("host-credentials", `environment=${form.environmentId}&kind=github&action=account&host=${encodeURIComponent(group.host)}&value=`) disabled=(busy or form.disabled)
                text "Use active login" font-size="0.75rem"
            for account in group.broken key=account.key
              row gap="0.25rem"
                RedactedText(value=account.value, placeholder=account.placeholder, label="Toggle unavailable account visibility", revealTip="Reveal account", hideTip="Hide account", testId=`github-broken-${group.host}-${account.key}`)
                text `can't be used: ${account.error}` font-size="0.75rem" color="light-dark(#71717b, #818181)"
            if group.environmentWarning != ""
              text group.environmentWarning font-size="0.75rem" color="light-dark(#bb4d00, #ffb900)"
        text "A token saved here is used before GH_TOKEN and the gh login. Give it read and write access to pull requests and contents." font-size="0.75rem" color="light-dark(#71717b, #818181)"
        BbField(label="Host")
          input value=tokenHost input=hostInput disabled=(busy or form.disabled) aria-label="GitHub token host" testId="github-token-host" autocorrect="off" spellcheck="false" width="100%" border-width=0 background-color="#00000000" font-size="0.875rem"
        BbField(label="Token")
          input value=tokenDraft input=tokenInput type="password" disabled=(busy or form.disabled) aria-label="GitHub token" testId="github-token" placeholder="Enter a token" autocorrect="off" spellcheck="false" width="100%" border-width=0 background-color="#00000000" font-size="0.875rem"
        row width="100%" justify-content="space-between" align-items="center"
          link href=`https://${tokenHost.trim() != "" ? tokenHost.trim() : "github.com"}/settings/personal-access-tokens/new`
            text "Create a token" font-size="0.75rem"
          button appearance="none" press=rest("host-credentials", `environment=${form.environmentId}&kind=github&action=token&host=${encodeURIComponent(tokenHost)}&value=${encodeURIComponent(tokenDraft)}`) disabled=(busy or form.disabled or tokenHost.trim() == "" or tokenDraft.trim() == "") testId="github-token-save"
            text "Save" font-size="0.75rem"
        if form.savedHosts.length == 0
          text "No token saved; the server uses GH_TOKEN or the gh login." font-size="0.75rem" color="light-dark(#71717b, #818181)"
        for saved in form.savedHosts key=saved.host
          row width="100%" align-items="center" justify-content="space-between"
            text `Saved for ${saved.host}` font-size="0.75rem" color="light-dark(#71717b, #818181)"
            button appearance="none" press=rest("host-credentials", `environment=${form.environmentId}&kind=github&action=token&host=${encodeURIComponent(saved.host)}&value=&remove=true`) disabled=(busy or form.disabled) testId=`github-token-remove-${saved.host}`
              text "Remove" font-size="0.75rem"
      for field in form.fields key=field.key
        HostCredentialInput(field=field, kind=form.kind, environmentId=form.environmentId, busy=(busy or form.disabled), restInput=restInput)
      if form.fields.filter(field => field.saved).length > 0
        button appearance="none" press=rest("host-credentials", `environment=${form.environmentId}&kind=${form.kind}&action=remove`) disabled=(busy or form.disabled) align-self="flex-end" testId=`host-remove-${form.kind}`
          text "Remove" font-size="0.75rem"

component HostCredentialInput
  props
    field: HostCredentialField
    kind: string
    environmentId: string
    busy: bool
    restInput: action
  state draft = field.value
  action edit(next: string)
    draft = next
  action commit(next: string)
    if next != field.value
      restInput("host-credentials", `environment=${environmentId}&kind=${kind}&action=field&key=${field.key}&value=`, next)
  view
    column width="100%" gap="0.375rem"
      BbField(label=field.label)
        input value=draft input=edit change=commit type=(field.secret ? "password" : "text") disabled=busy aria-label=field.label testId=`host-${kind}-${field.key}` placeholder=(field.secret and field.saved ? "Stored secret, enter a new value to replace" : "Not set") autocorrect="off" spellcheck="false" width="100%" border-width=0 background-color="#00000000" font-size="0.875rem"
      text field.description font-size="0.75rem" color="light-dark(#71717b, #818181)"

component BbField
  props
    label: string
  slot
  view
    column width="100%" gap="0.375rem"
      text label font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
      row width="100%" height="1.75rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow="0 1px 2px #0000000a" align-items="center" padding-left="0.5625rem" padding-right="0.5625rem"
        children
