// The project icon (ProjectFavicon), "Choose project icon"
// (ProjectIconPickerDialog: Icons / Emoji / Monogram) and the image-file picker
// (ProjectFaviconPickerDialog, a CommandDialog). The dialogs mount at the window
// root so their overlays take hits above the settings scroll view.
use ProjectsPage from "./settings-projects.contract"
use FieldPlaceholder from "../shared/field-placeholder.contract"
use FileTypeIcon from "../shared/timeline-files.contract"
use PaletteIcon from "../palette/palette.contract"
use CnGlyph from "./settings-b-kit.contract"
use MonogramTile from "./settings-b-iconmark.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"

shape SbIconChoice
  name: string
  label: string
  d: string
shape SbColor
  value: string
  label: string
  swatch: string
  ink: string
  surface: string
  inkLight: string
  inkDark: string
shape SbEmoji
  emoji: string
  label: string
shape SbFileChoice
  index: number
  path: string
  name: string
  token: string
  src: string
shape SbSeed
  key: string
  mode: string
  iconName: string
  color: string
  emoji: string
  letters: string
shape SbPicker
  seeds: SbSeed[]
  icons: SbIconChoice[]
  iconsEmpty: bool
  colors: SbColor[]
  emojis: SbEmoji[]
  files: SbFileChoice[]
  fileGroup: string
  fileEmpty: string
  monogram: string
  monogramValid: bool
  monogramWidth: number
  pasted: string

style SbOverlay
  position="absolute" left=0 right=0 top=0 bottom=0 display="flex" align-items="center" justify-content="center"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" padding="1rem" box-sizing="border-box" z-index=40
style SbField
  box-sizing="border-box" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.3125rem" padding-bottom="0.3125rem" border-radius="0.625rem" border-style="solid" border-width=1
  border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
  ::placeholder
    color="light-dark(#71717b, #818181)"
style SbOutline
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.5rem" box-sizing="border-box" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem"
  border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d" flex-shrink=0

// ToggleGroup variant="segmented": one 24pt toggle.
component SbToggle
  props
    label: string
    selected: bool
    choose: action
  view
    button id=`project-icon-mode-${label}` press=choose aria-label=label aria-checked=selected role="radio" testId=`project-icon-mode-${label}` display="flex" flex-direction="row" align-items="center" justify-content="center" height="1.5rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#00000000" background-color=(selected ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(selected ? "0 1px 2px #0000001a" : "none")
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(selected ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #9a9a9a)")

// The dialog opens on the project's current override (the picker's one seed).
component ProjectIconDialog
  props
    data: ProjectsPage
    picker: SbPicker
    query: string
    letters: string
    custom: string
    dark: bool
    busy: bool
    error: string
    raw: action
    set: action
    close: action
  view
    for seed in picker.seeds key=seed.key
      ProjectIconEditor(seed=seed, scope=data.iconScope, picker=picker, query=query, letters=letters, custom=custom, dark=dark, busy=busy, error=error, raw=raw, set=set, close=close)

component ProjectIconEditor
  inject
    dialogEntered: action
    dialogFallback: action
  props
    seed: SbSeed
    scope: string
    picker: SbPicker
    query: string
    letters: string
    custom: string
    dark: bool
    busy: bool
    error: string
    raw: action
    set: action
    close: action
  state mode = seed.mode
  state iconName = seed.iconName
  state color = seed.color
  state emoji = seed.emoji
  state pickedOver = ""
  state hovered = ""
  action chooseMode(value: string)
    mode = value
  action modeKey(label: string, k: string, e: KeyboardEvent)
    if (k == "ArrowLeft" or k == "ArrowRight") and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      stopPropagation()
      let next = k == "ArrowRight" ? (label == "Icons" ? "Emoji" : (label == "Emoji" ? "Monogram" : "Icons")) : (label == "Icons" ? "Monogram" : (label == "Emoji" ? "Icons" : "Emoji"))
      mode = next == "Icons" ? "lucide" : (next == "Emoji" ? "emoji" : "monogram")
      focus("project-icon-mode")
  action chooseColor(value: string)
    color = value
  action chooseIcon(value: string)
    iconName = value
  action chooseEmoji(value: string)
    emoji = value
    pickedOver = custom
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  derive shownEmoji = (picker.pasted != "" and custom != pickedOver) ? picker.pasted : emoji
  derive ink = picker.colors.filter((c) => c.value == color).map((c) => c.ink).join("")
  derive surface = picker.colors.filter((c) => c.value == color).map((c) => c.surface).join("")
  derive inkLight = picker.colors.filter((c) => c.value == color).map((c) => c.inkLight).join("")
  derive inkDark = picker.colors.filter((c) => c.value == color).map((c) => c.inkDark).join("")
  derive canSave = not busy and (mode != "monogram" or picker.monogramValid)
  derive payload = mode == "monogram" ? `kind=monogram&text=${encodeURIComponent(picker.monogram)}&color=${color}` : (mode == "lucide" ? `kind=lucide&name=${iconName}&color=${color}` : `kind=emoji&emoji=${encodeURIComponent(shownEmoji)}`)
  derive modeLabel = mode == "emoji" ? "Emoji" : (mode == "monogram" ? "Monogram" : "Icons")
  derive dialogTargets = ["project-icon-mode", "project-icon-close"]
  view
    column class=SbOverlay testId="project-icon-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727291a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow=(dark ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") position="relative" role="dialog" aria-label="Choose project icon" testId="project-icon-dialog" id="project-icon-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("project-icon-dialog") key=dialogFallback("project-icon-dialog", dialogTargets)
        // AppKit projects the radio children into one segmented control. Its visible group owns the Tab stop and keys.
        FocusGuard(guardId="project-icon-guard-start", targets=dialogTargets, popup="project-icon-dialog")
        DialogOpenFocus(target="project-icon-mode")
        column padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" gap="0.5rem"
          text "Choose project icon" font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "Choose an icon, emoji, or monogram." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #9a9a9a)"
        column padding-top="0.25rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="1.5rem" gap="1rem"
          row id="project-icon-mode" tabindex=0 key=modeKey(modeLabel) data-focus-stop="enabled" align-self="flex-start" padding="0.125rem" gap="0.125rem" border-radius="0.625rem" background-color="light-dark(#d4d4d866, #ffffff08)" role="radiogroup" aria-label="Icon type" testId="project-icon-mode"
            SbToggle(label="Icons", selected=(mode == "lucide"), choose=chooseMode("lucide"))
            SbToggle(label="Emoji", selected=(mode == "emoji"), choose=chooseMode("emoji"))
            SbToggle(label="Monogram", selected=(mode == "monogram"), choose=chooseMode("monogram"))
          if mode != "emoji"
            column
              text "Color" font-size="0.75rem" line-height="1rem" font-weight=500 margin-bottom="0.5rem" color="light-dark(#71717b, #9a9a9a)"
              row flex-wrap="wrap" gap="0.375rem" role="group" aria-label="Icon color" testId="project-icon-colors"
                for option in picker.colors key=option.value
                  button press=chooseColor(option.value) aria-label=option.label aria-checked=(color == option.value) role="radio" testId=`project-icon-color-${option.value}` width="1.5rem" height="1.5rem" padding=0 box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color=(color == option.value ? "light-dark(#27272aa3, #f5f5f5a3)" : "#00000000") background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
                    box width="1rem" height="1rem" border-radius="0.5rem" background-color=option.swatch
          if mode == "lucide"
            input value=query input=set("query") placeholder="Search all Lucide icons" aria-label="Search Lucide icons" autocorrect="off" spellcheck="false" class=SbField testId="project-icon-search" id="field-project-icon-search" data-editable="yes"
            column max-height="16rem" overflow-y="scroll" testId="project-icon-grid-scroll"
              row flex-wrap="wrap" gap="0.25rem" padding="0.125rem" testId="project-icon-grid"
                for item in picker.icons key=item.name
                  button press=chooseIcon(item.name) hover=hover(item.name) aria-label=item.label aria-checked=(iconName == item.name) role="radio" testId=`project-icon-${item.name}` width="2.63125rem" height="2.63125rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(iconName == item.name ? "light-dark(#e4e4e7, #ffffff14)" : "#00000000") background-color=(iconName == item.name or hovered == item.name ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") display="flex" align-items="center" justify-content="center" title=""
                    svg width="1.25rem" height="1.25rem" viewBox="0 0 24 24" color=`light-dark(${inkLight}, ${inkDark})` fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
                      path d=item.d
            if picker.iconsEmpty
              text "No icons found." font-size="0.875rem" line-height="1.25rem" text-align="center" padding-top="2rem" padding-bottom="2rem" color="light-dark(#71717b, #9a9a9a)" testId="project-icon-empty"
          if mode == "monogram"
            row gap="1rem" align-items="center" padding-top="0.5rem" padding-bottom="0.5rem"
              MonogramTile(text=(picker.monogramValid ? picker.monogram : seed.letters), width=picker.monogramWidth, ink=ink, surface=surface, size=48)
              column flex=1 min-width=0 gap="0.5rem"
                text "Letters" font-size="0.875rem" line-height="1.0625rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                input value=letters input=set("letters") aria-label="Letters" autocorrect="off" spellcheck="false" class=SbField border-color=(picker.monogramValid ? "light-dark(#d4d4d8, #ffffff14)" : "light-dark(#fb2c36, #ff6467)") box-shadow=(picker.monogramValid ? "none" : "0 0 0 3px light-dark(#fb2c3629, #ff646733)") testId="project-monogram" id="field-project-monogram" data-editable="yes"
                text "One or two letters or numbers." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #9a9a9a)"
          if mode == "emoji"
            column max-height="16rem" overflow-y="scroll"
              row flex-wrap="wrap" gap="0.25rem" padding="0.125rem" testId="project-emoji-grid"
                for option in picker.emojis key=option.emoji
                  button press=chooseEmoji(option.emoji) hover=hover(option.emoji) aria-label=option.label aria-checked=(shownEmoji == option.emoji) role="radio" testId=`project-emoji-${option.label}` width="2.63125rem" height="2.63125rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(shownEmoji == option.emoji ? "light-dark(#e4e4e7, #ffffff14)" : "#00000000") background-color=(shownEmoji == option.emoji or hovered == option.emoji ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") display="flex" align-items="center" justify-content="center"
                    text option.emoji font-size="1.25rem" line-height="1.75rem"
            column
              text "Or paste any emoji" font-size="0.75rem" line-height="1rem" font-weight=500 margin-bottom="0.5rem" color="light-dark(#71717b, #9a9a9a)"
              input value=custom input=set("emoji") placeholder="Paste an emoji" aria-label="Custom emoji" autocorrect="off" spellcheck="false" class=SbField testId="project-emoji-custom" id="field-project-emoji-custom" data-editable="yes"
          if error != ""
            text error font-size="0.875rem" line-height="1.25rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="project-icon-error"
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" align-items="center" justify-content="flex-end" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff05)" border-bottom-left-radius="1.0625rem" border-bottom-right-radius="1.0625rem"
          button press=close aria-keyshortcuts="Escape" class=SbOutline testId="project-icon-cancel"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button press=raw("sb:project-icon-set", scope, payload) disabled=(not canSave) display="flex" flex-direction="row" align-items="center" justify-content="center" box-sizing="border-box" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" opacity=(canSave ? 1 : 0.64) testId="project-icon-save"
            text "Save icon" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        button id="project-icon-close" press=close class=SbOutline width="2rem" height="2rem" padding-left=0 padding-right=0 border-width=0 box-shadow="none" background-color="#00000000" position="absolute" top="0.5rem" right="0.5rem" aria-label="Close" testId="project-icon-close" title="" data-focus-stop="enabled"
          CnGlyph(name="x", size=16, color="light-dark(#71717b, #9a9a9a)")
        FocusGuard(guardId="project-icon-guard-end", targets=dialogTargets, popup="project-icon-dialog")

// ProjectFaviconPickerDialog: CommandDialog over the project's image files.
component ProjectFaviconDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    data: ProjectsPage
    picker: SbPicker
    query: string
    vw: number
    vh: number
    dark: bool
    busy: bool
    raw: action
    set: action
    close: action
  state highlight = 0
  action onKey(name: string)
    if name == "ArrowDown"
      highlight = highlight + 1 >= picker.files.length ? 0 : highlight + 1
    if name == "ArrowUp"
      highlight = highlight <= 0 ? max(0, picker.files.length - 1) : highlight - 1
  action point(index: number, over: bool)
    highlight = over ? index : highlight
  // ProjectFaviconThumbnail asks for a preview only once its row is visible.
  action seen(path: string, e: IntersectionObserverEntry)
    if e.isIntersecting
      set("thumb", path)
  derive width = min(576, vw - 32)
  derive top = vw >= 640 ? floor(vh * 0.1) : max(16, floor(vh * 0.04))
  derive chosen = picker.files.filter((f) => f.index == highlight).map((f) => f.path).join("")
  derive dialogTargets = ["project-favicon-search", (data.iconPickExternal != "" and not busy ? "project-favicon-pick-external" : "project-favicon-search")]
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 z-index=60 background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" press=close aria-label="Close" aria-keyshortcuts="Escape" testId="project-favicon-backdrop"
    column position="absolute" left=floor((vw - width) / 2) top=top width=width max-height=min(544, vh * 0.76) z-index=61 box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727291a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow=(dark ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") overflow="hidden" role="dialog" aria-label="Choose project icon" testId="project-favicon-picker" id="project-favicon-picker" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("project-favicon-picker") key=dialogFallback("project-favicon-picker", dialogTargets)
      // The focus trap (dialog-trap.contract): the field, then the footer's button. The files are Autocomplete items, no Tab stops (the field's arrows move the highlight).
      FocusGuard(guardId="project-favicon-guard-start", targets=dialogTargets, popup="project-favicon-picker")
      DialogOpenFocus(target="project-favicon-search")
      row padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" flex-shrink=0 box-sizing="border-box"
        box position="relative" width="100%" height="2.25rem" border-radius="0.625rem" box-sizing="border-box"
          box position="absolute" left="0.625rem" top="0.625rem" width="1rem" height="1rem" display="flex"
            PaletteIcon(name="search", size=16, color="light-dark(#71717b, #9a9a9a)")
          input id="project-favicon-search" value=query input=set("query") key=onKey submit=raw("sb:project-favicon-set", data.iconScope, `path=${encodeURIComponent(chosen)}`) placeholder="Search image files…" class=FieldPlaceholder aria-label="Search image files…" role="combobox" aria-expanded=true autocorrect="off" spellcheck="false" testId="project-favicon-search" width="100%" height="2.25rem" padding-left="2.0625rem" padding-right="0.6875rem" padding-top="0.5rem" padding-bottom="0.5rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" box-sizing="border-box" data-focus-stop="enabled" data-editable="yes"
      column flex-shrink=1 min-height=0 overflow-y="scroll" padding="0.5rem" box-sizing="border-box" border-top-left-radius="0.875rem" border-top-right-radius="0.875rem" role="listbox" testId="project-favicon-list"
        if picker.files.length == 0
          text picker.fileEmpty font-size="0.875rem" line-height="1.25rem" text-align="center" padding-top="1.5rem" padding-bottom="1.5rem" color="light-dark(#71717b, #9a9a9a)" testId="project-favicon-empty"
        else
          text picker.fileGroup font-size="0.75rem" line-height="1rem" font-weight=500 padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" color="light-dark(#71717b, #9a9a9a)" role="presentation"
          for file in picker.files key=file.path
            button press=raw("sb:project-favicon-set", data.iconScope, `path=${encodeURIComponent(file.path)}`) hover=point(file.index) disabled=busy tabindex=-1 role="option" aria-selected=(file.index == highlight) aria-label=`${file.name} ${file.path}` testId=`project-favicon-${file.path}` width="100%" min-height="3rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" gap="0.5rem" border-width=0 border-radius="0.375rem" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" box-sizing="border-box" background-color=(file.index == highlight ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              box intersect=seen(file.path) flex-shrink=0
                ProjectFaviconThumbnail(src=file.src, token=file.token, testId=`project-favicon-thumb-${file.path}`)
              column flex=1 min-width=0 align-items="flex-start"
                text file.name font-size="0.875rem" line-height="1.25rem" color=(file.index == highlight ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#27272a, #f5f5f5)") line-clamp=1
                text file.path font-size="0.75rem" line-height="1rem" color="light-dark(#71717bb3, #9a9a9ab3)" line-clamp=1
      // CommandFooter: the key hints, then the trailing "Open in Finder" (CommandFooterAction, ghost-muted xs).
      row height="2.5rem" padding-left="1rem" padding-right="1rem" gap="0.5rem" align-items="center" justify-content="space-between" flex-shrink=0 box-sizing="border-box" background-color="light-dark(#27272a06, #f5f5f506)" testId="project-favicon-footer"
        row gap="0.75rem" align-items="center"
          row gap="0.25rem" align-items="center"
            SbKbd(label="", icon="arrow-up", dark=dark)
            SbKbd(label="", icon="arrow-down", dark=dark)
            text "Navigate" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #9a9a9a)"
          row gap="0.25rem" align-items="center"
            SbKbd(label="Enter", icon="", dark=dark)
            text "Select icon" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #9a9a9a)"
          row gap="0.25rem" align-items="center"
            SbKbd(label="Esc", icon="", dark=dark)
            text "Close" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #9a9a9a)"
        if data.iconPickExternal != ""
          // Disabled while the panel is open (the command stays pending until it answers).
          button id="project-favicon-pick-external" press=raw("sb:project-favicon-pick", data.iconScope, `cwd=${encodeURIComponent(data.iconCwd)}`) disabled=busy aria-label=data.iconPickExternal testId="project-favicon-pick-external" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" border-width=0 border-radius="0.375rem" background-color="#00000000" opacity=(busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" data-focus-stop=(busy ? "" : "enabled")
            text data.iconPickExternal font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #9a9a9a)"
      FocusGuard(guardId="project-favicon-guard-end", targets=dialogTargets, popup="project-favicon-picker")

// ProjectFaviconThumbnail: a size-8 slot that keeps the file-type icon until the preview has loaded, the
// image hidden until then; a preview that fails to load is dropped and the icon stays. `src` is '' until
// the row has been on screen and its signed URL is known.
component ProjectFaviconThumbnail
  props
    src: string
    token: string
    testId: string
  state loaded = ""
  state failed = ""
  action didLoad
    loaded = src
  action didFail(message: string)
    failed = src
  view
    box width="2rem" height="2rem" position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 testId=(src == "" ? testId : `${testId}-${loaded == src ? "loaded" : failed == src ? "failed" : "loading"}`)
      if src == "" or loaded != src
        FileTypeIcon(token=token, size=16)
      if src != "" and failed != src
        image src max-width="2rem" max-height="2rem" border-radius="0.125rem" object-fit="contain" aria-hidden=true load=didLoad error=didFail position="absolute" visibility=(loaded == src ? "visible" : "hidden")

// Kbd: h-5 min-w-5 rounded px-1, foreground/8%.
component SbKbd
  props
    label: string
    icon: string
