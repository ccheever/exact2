// General → About (settings-a-about.ts): the Version row's title, whose version copies itself,
// and its update button over the app's own delivery facts (LLP 1030 D7).
use CoreRow from "./settings-core.contract"
use CorePalette from "./settings-core-shared.contract"
use SettingsGhost from "./settings-core-shared.contract"

// The two delivery facts the About section reads (exactDelivery, by field name).
shape AboutDelivery
  stream: string
  staged: bool

keyframes aboutCopiedA
  from opacity=1
  99% opacity=1
  to opacity=0
keyframes aboutCopiedB
  from opacity=1
  99% opacity=1
  to opacity=0

// AboutVersionTitle: "Version" and the version as an InlineButton tone="muted" (muted, the foreground and underlined
// on hover) with its "Copy version" tooltip. A copy shows the anchored "Copied!" for 1 s (showAnchoredCopySuccessToast,
// tooltip style): `row.amount` counts the copies, so each one starts its fade again. The faded text stays drawn, so it
// is hidden from assistive technology; the copy announces "Copied!" (settings-a-about.ts copyVersion).
component AboutVersionTitle
  props
    row: CoreRow
    pal: CorePalette
    change: action
  state hovered = false
  state pressed = false
  action hover(over: bool)
    hovered = over
    pressed = false
  action copy
    pressed = true
    change(row.id, "copy", "")
  view
    row align-items="baseline" gap="0.5rem" role="heading" aria-level=3 id=`paint-CoreRowView-2-${row.id}`
      text "Version" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text data-paint="text" data-pick="text"
      box position="relative" flex-shrink=0
        button press=copy hover=hover aria-label=`Copy version ${row.value}` testId="setting-version-copy" id="setting-version-copy" display="flex" flex-direction="row" align-items="center" padding=0 border-width=0 background-color="#00000000" title="" data-focus-stop="enabled page"
          text row.value font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" font-weight=500 line-height="1rem" color=(hovered ? pal.text : pal.muted) text-decoration-line=(hovered ? "underline" : "none") white-space="nowrap" id=`paint-CoreRowView-3-${row.id}` data-paint=(hovered ? "text" : "mutedForeground") data-pick="text"
        if hovered and not pressed
          text "Copy version" position="absolute" bottom="1.5rem" left="50%" translate="-50% 0%" z-index=60 padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover font-size="0.75rem" line-height="1.03125rem" color=pal.text white-space="nowrap" role="tooltip" testId="setting-version-copy-tip" data-paint="text surfaceOverlay" data-pick="surfaceOverlay"
        if row.amount > 0
          text "Copied!" position="absolute" bottom="1.5rem" left="50%" translate="-50% 0%" z-index=61 pointer-events="none" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover font-size="0.75rem" line-height="1.03125rem" color=pal.text white-space="nowrap" aria-hidden=true testId="setting-version-copied" animation=(row.amount % 2 == 0 ? "aboutCopiedA 1s linear forwards" : "aboutCopiedB 1s linear forwards") data-paint="text surfaceOverlay" data-pick="surfaceOverlay"

// AboutVersionSection's Button size sm variant outline, with its tooltip.
// Check runs deliveryCheck (Checking… until the store stages an entry);
// Install asks first (the root dialog), then deliveryActivate.
component AboutUpdateButton
  props
    row: CoreRow
    pal: CorePalette
    busy: bool
    change: action
  state checking = false
  state hovered = false
  action check
    checking = true
    deliveryCheck()
  action hover(over: bool)
    hovered = over
  view
    box position="relative" flex-shrink=0
      if row.value2 == "install"
        button press=change(row.id, "install", "") hover=hover disabled=busy class=SettingsGhost height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" opacity=(busy ? 0.64 : 1) id="setting-version-update" testId="setting-version-update" data-paint="input canvas" data-pick="canvas" data-focus-stop=(busy ? "" : "enabled page")
          text row.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text white-space="nowrap" opacity=(busy ? 0.64 : 1) id=`paint-AboutUpdateButton-2-${row.id}` data-paint="text" data-pick="text"
      else
        button press=check hover=hover disabled=(row.disabled or checking) aria-label=(checking ? "Checking…" : row.label) class=SettingsGhost height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow=(row.disabled or checking ? "none" : "0 1px 2px #0000000d") opacity=(row.disabled or checking ? 0.64 : 1) id="setting-version-update" testId="setting-version-update" data-paint="input canvas" data-pick="canvas" data-focus-stop=(row.disabled or checking ? "" : "enabled page")
          text (checking ? "Checking…" : row.label) font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text white-space="nowrap" opacity=(row.disabled or checking ? 0.64 : 1) id=`paint-AboutUpdateButton-4-${row.id}` data-paint="text" data-pick="text"
      if hovered and not row.disabled
        text row.note position="absolute" bottom="2.125rem" right=0 z-index=60 padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover font-size="0.75rem" line-height="1.03125rem" color=pal.text white-space="nowrap" role="tooltip" testId="setting-version-update-tip" id="setting-version-update-tip" data-paint="text surfaceOverlay" data-pick="surfaceOverlay"
