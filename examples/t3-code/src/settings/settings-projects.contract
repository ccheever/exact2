// Settings → Project (reference ProjectsSettings.tsx / ProjectSettingsPanel.tsx):
// without a project scope, a notice with the project choices; with one, the
// group's name, icon, new-thread defaults, checkouts and removal.
use SelectOption from "./settings-kit.contract"
use SettingsSrHeading from "./settings-kit.contract"
use SkPopup from "./settings-kit.contract"
use SkMenuItem from "./settings-kit.contract"
use SettingsPageSelect from "./settings-kit.contract"
use ScopedRow from "./settings-source-control.contract"
use Inheritance from "./settings-source-control.contract"
use ScopeNotice from "./settings-scope-notice.contract"
use ScopeNoticeGroup from "./settings-core.contract"
use Card from "./settings-source-control.contract"
use SectionTitle from "./settings-source-control.contract"
use LucideInfo from "./settings-icons.contract"
use LucideTrash2 from "./settings-icons.contract"
use LucideUndo2 from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use ProviderInstanceMark from "../shared/icons-kit.contract"
use CnScriptIcon from "./settings-b-kit.contract"
use CnGlyph from "./settings-b-kit.contract"
use CnMenu from "./settings-b-kit.contract"
use CnSeparator from "./settings-b-kit.contract"
use LucideLayers from "./settings-icons.contract"
use ProjectIconMark from "./settings-b-iconmark.contract"
use KmItem from "../shared/menu-keys.contract"
use kmTriggerKey from "../shared/menu-keys.contract"
use kmTriggerTarget from "../shared/menu-keys.contract"

shape ProjectMember
  id: string
  title: string
  path: string
  environment: string
  first: bool
shape ProjectAction
  id: string
  first: bool
  name: string
  command: string
  icon: string
  setup: bool
  settle: bool
  wait: bool
  preview: bool
  previewUrl: string
  autoOpen: bool
  keybinding: string
  shortcut: string
shape ImportScript
  key: string
  name: string
  command: string
  icon: string
  payload: string
shape ProjectCheckoutGroup
  id: string
  label: string
  secondary: string
  members: ProjectMember[]
  first: bool
shape ProjectsPage
  ready: bool
  selected: bool
  message: string
  noticeGroups: ScopeNoticeGroup[]
  confirmTitle: string
  confirmDescription: string
  key: string
  name: string
  mark: string
  ink: string
  surface: string
  icon: string
  iconCustom: bool
  // Every member is the Scratch project and one was renamed: Reset restores "No project".
  nameResettable: bool
  members: ProjectMember[]
  checkoutGroups: ProjectCheckoutGroup[]
  hasOther: bool
  threads: number
  workspace: ScopedRow
  removeTitle: string
  removeDescription: string
  removeLabel: string
  confirm: string
  removeTarget: string
  names: string[]
  actionScope: string
  actionsMixed: bool
  actionsWritable: bool
  t3Invalid: bool
  actions: ProjectAction[]
  importable: ImportScript[]
  actionsRow: ScopedRow
  blankActions: ProjectAction[]
  iconKind: string
  iconName: string
  iconD: string
  iconInk: string
  iconSurface: string
  iconText: string
  iconTextWidth: number
  iconEmoji: string
  iconPickColor: string
  iconLetters: string
  faviconSrc: string
  iconScope: string
  iconCwd: string
  // The picker footer's "Open in Finder", or "" where it is not offered.
  iconPickExternal: string

component ProjectsPanel
  props
    data: ProjectsPage
    busy: bool
    error: string
    choose: action
    rest: action
    restInput: action
    raw: action
    open: action
  // The New threads card's Model row: General's ProviderModelPicker + TraitsPicker row (CoreRowView).
  slot
  view
    column width="100%" gap="1.5rem" testId="projects-settings"
      if error != ""
        text error font-size="0.75rem" line-height="1.125rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="projects-error" padding-left="1rem"
      if data.ready and not data.selected and data.message != ""
        if data.noticeGroups.length > 0
          ScopeNotice(message=data.message, groups=data.noticeGroups, noticeId="projects-scope-notice", choose=choose)
        else
          text data.message role="status" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" padding-left="1rem" padding-right="1rem" testId="projects-scope-notice"
      if data.selected
        row width="100%" box-sizing="border-box" gap="0.625rem" align-items="center" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="0.875rem" padding-right="0.875rem" border-radius="0.75rem" border-style="solid" border-width=1 border-color="#2c80ff52" background-color="#3380ff0a" role="alert" testId="projects-alert"
          LucideInfo(size=16, color="light-dark(#1b4ed8, #4d8bff)")
          text "Can't find a setting? Keep this project picked above and hop to any other settings page." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" flex=1 min-width=0
        // ProjectSettingsPanel.tsx's SettingsSection "Project" (hideTitle: an sr-only `<h2>`).
        column width="100%" id="project-overview" tabindex=-1
          SettingsSrHeading(title="Project", level=2)
          column width="100%" id="project-overview-scroll-target"
            Card()
              row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" testId="project-name-row"
                column flex=1 min-width=0 gap="0.25rem"
                  row min-height="1.25rem" gap="0.375rem" align-items="center"
                    text "Name" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                    box width="1.25rem" height="1.25rem"
                      if data.nameResettable
                        button press=raw("rename-group", data.key, "No project") disabled=busy aria-label="Reset project name to default" testId="reset-project-name" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="reset-project-name" data-focus-stop=(busy ? "" : "enabled page")
                          LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
                  text "The shared name for this project group in the sidebar and thread lists." font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
                for current in data.names key=current
                  ProjectName(name=current, groupKey=data.key, busy=busy, raw=raw)
              row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)" testId="project-icon-row"
                column flex=1 min-width=0 gap="0.25rem"
                  row min-height="1.25rem" gap="0.375rem" align-items="center"
                    text "Project icon" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                    box width="1.25rem" height="1.25rem"
                      if data.iconCustom
                        button press=rest("project-icon", "action=reset") disabled=busy aria-label="Reset project icon to default" testId="reset-project-icon" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="reset-project-icon" data-focus-stop=(busy ? "" : "enabled page")
                          LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
                  text data.icon font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #a1a1a1cc)" testId="project-icon-description"
                // ProjectFavicon size-6, then Choose icon (ProjectIconPickerDialog) and Choose file (ProjectFaviconPickerDialog).
                row flex-shrink=0 gap="0.5rem" align-items="center"
                  ProjectIconMark(kind=data.iconKind, d=data.iconD, ink=data.iconInk, surface=data.iconSurface, text=data.iconText, textWidth=data.iconTextWidth, emoji=data.iconEmoji, src=data.faviconSrc, size=24)
                  button id="project-choose-icon" press=open("project-icon", "", "") disabled=busy aria-label="Choose a project icon" testId="project-choose-icon" class=PjOutline data-focus-stop=(busy ? "" : "enabled page")
                    text "Choose icon" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
                  button id="project-choose-file" press=open("project-favicon", "", "") disabled=busy aria-label="Choose a project icon file" testId="project-choose-file" class=PjOutline data-focus-stop=(busy ? "" : "enabled page")
                    text "Choose file" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
        column width="100%" gap="0.625rem" testId="project-new-threads"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="New threads")
          Card()
            children
            row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)" testId="project-workspace-row"
              column flex=1 min-width=0 gap="0.25rem"
                row min-height="1.25rem" gap="0.375rem" align-items="center"
                  text "Workspace" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                  Inheritance(row=data.workspace, rest=rest, rowHovered=true)
                  box width="1.25rem" height="1.25rem"
                    if data.workspace.reset != ""
                      button press=rest("scoped", data.workspace.reset) disabled=busy aria-label="Reset default workspace to default" testId="reset-project-workspace" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="reset-project-workspace" data-focus-stop=(busy ? "" : "enabled page")
                        LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
                text data.workspace.description font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
              SettingsPageSelect(selectId="project-workspace", label="Default workspace", valueLabel=data.workspace.valueLabel, empty=false, value="", width=160, disabled=(busy or data.workspace.disabled), options=data.workspace.options, choose=restInput("scoped", "key=defaultThreadEnvMode&value="))
        ProjectActionsSection(data=data, busy=busy, raw=raw, open=open, rest=rest)
        if data.members.length > 0
          column width="100%" gap="0.625rem" testId="project-checkouts"
            row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
              SectionTitle(title="Checkouts")
            Card()
              if data.checkoutGroups.length > 0
                for group in data.checkoutGroups key=group.id
                  column width="100%" box-sizing="border-box" padding="1rem" gap="0.5rem" border-top-style="solid" border-top-width=(group.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)"
                    text group.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                    if group.secondary != ""
                      text group.secondary title=group.secondary line-clamp=1 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
                    for member in group.members key=member.id
                      row width="100%" gap="0.75rem" align-items="center"
                        text member.path title=member.path flex=1 min-width=0 line-clamp=1 font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
                        button id=`remove-checkout-${member.id}` press=open("project-remove-member", member.id, member.title) disabled=busy aria-label=`Remove checkout ${member.path}` testId=`remove-checkout-${member.id}` class=PjOutline data-focus-stop=(busy ? "" : "enabled page")
                          text "Remove" font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
              else
                for member in data.members key=member.id
                  row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=(member.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff0a)"
                    column flex=1 min-width=0 gap="0.25rem"
                      text member.environment font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                      text member.path font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
                    button id=`remove-checkout-${member.id}` press=open("project-remove-member", member.id, member.title) disabled=busy aria-label=`Remove checkout ${member.path}` testId=`remove-checkout-${member.id}` display="flex" flex-direction="row" align-items="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" data-focus-stop=(busy ? "" : "enabled page")
                      text "Remove" font-size="0.875rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
        column width="100%" gap="0.625rem" testId="project-danger"
          row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center"
            SectionTitle(title="Danger")
          Card()
            row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center"
              column flex=1 min-width=0 gap="0.25rem"
                text data.removeTitle font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
                text data.removeDescription font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
              // Button variant="destructive-outline": the input border at rest; hovered, border destructive/32 over destructive/4.
              button id="remove-project" press=open("project-remove", data.removeTarget, data.key) disabled=busy testId="remove-project" display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff09)" data-focus-stop=(busy ? "" : "enabled page")
                :hover
                  border-color="light-dark(#fb2c3652, #fb414a52)"
                  background-color="light-dark(#fb2c360a, #fb414a0a)"
                LucideTrash2(size=16, color="light-dark(#c10007, #ff6467)")
                text data.removeLabel font-size="0.875rem" font-weight=500 color="light-dark(#c10007, #ff6467)"

// Name: commits on blur or Enter; blank is refused (renameGroup).
component ProjectName
  props
    name: string
    groupKey: string
    busy: bool
    raw: action
  state draft = name
  action edit(next: string)
    draft = next
  view
    input value=draft input=edit change=raw("rename-group", groupKey) aria-label="Project name" disabled=busy testId="managed-project-name" box-sizing="border-box" width="16rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.1875rem" padding-bottom="0.1875rem" line-height="1.25rem" flex-shrink=0 border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#fcfcfc, #ffffff09)" font-size="0.875rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" id="field-managed-project-name" data-editable="yes" data-focus-stop=(busy ? "" : "enabled page")

// ProviderModelPicker / TraitsPicker triggers in a settings row: ghost buttons.
component GhostSelect
  props
    selectId: string
    label: string
    driver: string
    badge: string
    accent: string
    valueLabel: string
    disabled: bool
    options: SelectOption[]
    choose: action
  derive menuItems = options.map((option) => KmItem(id=`${selectId}-option-${option.value}`, label=option.label))
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover(`${selectId}-menu`, source=selectId)
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    box position="relative"
      button popovertarget=`${selectId}-menu` key=triggerKey role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId display="flex" flex-direction="row" align-items="center" gap="0.375rem" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-width=0 border-radius="0.5rem" background-color="#00000000" opacity=(disabled ? 0.64 : 1) data-focus-stop=(disabled ? "" : "enabled page")
        if driver != ""
          ProviderInstanceMark(driver=driver, size=16, color="light-dark(#71717b, #a1a1a1)", badge=badge, accent=accent)
        text valueLabel font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
        LucideChevronDown(size=14, color="light-dark(#71717b, #a1a1a1)")
      SkPopup(menuId=`${selectId}-menu`, invoker=selectId, label=label, width=256, list=true, endAlign=0, items=menuItems, keyed=0)
        for option in options key=option.value
          SkMenuItem(keysId=`${selectId}-menu-keys`, label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=option.selected, check=true, destructive=false, disabled=false, choose=choose(option.value))

// ProjectActionsSettings + ProjectActionsList: a project's actions on the
// selected checkouts, t3.json import, and the editor (settings-b-actions.contract).
component ProjectActionsSection
  props
    data: ProjectsPage
    busy: bool
    raw: action
    open: action
    rest: action
  derive menuItems = (busy ? [] : data.importable.map((script) => KmItem(id=`import-script-${script.name}`, label=script.name)))
  action triggerKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("import-scripts-menu", source="import-scripts")
        let target = kmTriggerTarget(menuItems, k)
        if target != ""
          focus(target)
  view
    column width="100%" gap="0.625rem" id="project-actions" tabindex=-1 testId="project-actions"
      row min-height="1.75rem" padding-left="1rem" padding-right="1rem" align-items="center" id="project-actions-scroll-target"
        SectionTitle(title="Actions")
      Card()
        row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" testId="project-actions-row"
          column flex=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" gap="0.375rem" align-items="center"
              text "Actions" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              Inheritance(row=data.actionsRow, rest=rest, rowHovered=true)
              box width="1.25rem" height="1.25rem"
                if data.actionsRow.reset != ""
                  button press=raw("sb:action-reset", data.actionScope, "") disabled=(busy or not data.actionsWritable) aria-label="Reset Actions to default" testId="reset-project-actions" width="1.25rem" height="1.25rem" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" id="reset-project-actions" data-focus-stop=(busy or not data.actionsWritable ? "" : "enabled page")
                    LucideUndo2(size=12, color="light-dark(#71717b, #a1a1a1)")
            text "Commands that run in this project's checkout or its worktree, with optional shortcuts." font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
          row flex-shrink=0 gap="0.375rem" align-items="center" flex-wrap="wrap"
            if data.importable.length > 0
              box position="relative"
                button popovertarget="import-scripts-menu" key=triggerKey disabled=(busy or not data.actionsWritable) id="import-scripts" testId="import-scripts" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-width=1 border-style="solid" border-color="#00000000" border-radius="0.5rem" background-color="#00000000" data-focus-stop=(busy or not data.actionsWritable ? "" : "enabled page")
                  text "Import scripts" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
                  CnGlyph(name="chevron-down", size=14, color="light-dark(#71717b, #a1a1a1)")
                CnMenu(menuId="import-scripts-menu", invoker="import-scripts", label="Import scripts", width=442, area="bottom span-left", items=menuItems, keyed=0)
                  text "Import from t3.json" font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" color="light-dark(#71717b, #a1a1a1)" role="presentation"
                  text "Add actions declared by this checkout without editing them first." font-size="0.875rem" line-height="1.25rem" padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717b, #a1a1a1)"
                  CnSeparator()
                  for script in data.importable key=script.key
                    ImportScriptItem(keysId="import-scripts-menu-keys", script=script, scope=data.actionScope, busy=busy, raw=raw)
            button id="add-project-action" press=open("project-action", "", "") disabled=(busy or not data.actionsWritable) testId="add-project-action" display="flex" flex-direction="row" align-items="center" gap="0.25rem" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" border-radius="0.5rem" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d" data-focus-stop=(busy or not data.actionsWritable ? "" : "enabled page")
              CnGlyph(name="plus", size=14, color="light-dark(#71717b, #a1a1a1)")
              text "Add action" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"
        if data.actionsMixed
          row width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)"
            column flex=1 min-width=0 gap="0.25rem"
              text "Different actions across environments" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" role="heading" aria-level=3
              text "Choose one environment to edit its list. Adding an action here adds it on every selected environment." font-size="0.75rem" line-height="1.125rem" color="light-dark(#71717b, #a1a1a1)" max-width="42rem" text-wrap="balance"
        if not data.actionsMixed and data.actions.length == 0
          text "No actions configured." font-size="0.875rem" line-height="1.25rem" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="1rem" padding-right="1rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)" color="light-dark(#71717b, #a1a1a1)" testId="project-actions-empty"
        if not data.actionsMixed
          for entry in data.actions key=entry.id
            ProjectActionRow(item=entry, busy=busy, writable=data.actionsWritable, open=open)
        if data.t3Invalid
          column width="100%" box-sizing="border-box" padding-top="0.75rem" padding-bottom="0.75rem" padding-left="1rem" padding-right="1rem" gap="0.25rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)" testId="t3-json-invalid"
            text "t3.json is invalid" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#e17100, #fdb022)" role="heading" aria-level=3
            text "A t3.json exists in this checkout but fails to parse, so every action and icon it declares is ignored. Check the JSON syntax and icon values." font-size="0.75rem" line-height="1.125rem" color="light-dark(#e17100cc, #fdb022cc)" max-width="36rem"

// One MenuItem of "Import from t3.json": icon, name and command.
component ImportScriptItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    script: ImportScript
    scope: string
    busy: bool
    raw: action
  state lit = false
  action hover(over: bool)
    if over
      focus(`import-script-${script.name}`)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=`import-script-${script.name}` press=raw("sb:action-import", scope, script.payload) popovertarget="import-scripts-menu" popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) disabled=busy role="menuitem" aria-label=`${script.name} ${script.command}` testId=`import-script-${script.name}` display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" width="100%" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.375rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color=(lit ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      CnScriptIcon(icon=script.icon, size=16, color="light-dark(#71717b, #a1a1a1)")
      column flex=1 min-width=0 align-items="flex-start"
        text script.name font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 color="light-dark(#18181b, #f5f5f5)"
        text script.command font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.875rem" line-height="1.25rem" line-clamp=1 color="light-dark(#71717b, #a1a1a1)"

// ProjectActionsList row: icon, name, setup/preview badges, the command, the
// shortcut, and the edit gear that appears on hover or focus.
component ProjectActionRow
  props
    item: ProjectAction
    busy: bool
    writable: bool
    open: action
  state hovered = false
  state focused = false
  action hover(over: bool)
    hovered = over
  action focusGear(on: bool)
    focused = on
  view
    row hover=hover width="100%" box-sizing="border-box" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="1rem" padding-right="1rem" gap="2rem" align-items="center" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff0a)" testId=`project-action-${item.id}`
      column flex=1 min-width=0 gap="0.25rem"
        row min-width=0 gap="0.5rem" align-items="center"
          CnScriptIcon(icon=item.icon, size=16, color="light-dark(#71717b, #a1a1a1)")
          text item.name font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 min-width=0 color="light-dark(#18181b, #f5f5f5)"
          if item.setup
            text "setup" font-size="0.625rem" line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" padding-top=1 padding-bottom=1 border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)" flex-shrink=0 color="light-dark(#71717b, #a1a1a1)"
          if item.settle
            text "on settle" font-size="0.625rem" line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" border-radius="0.125rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e799, #ffffff14)" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
          if item.preview
            text "preview · desktop only" font-size="0.625rem" line-height="0.875rem" padding-left="0.375rem" padding-right="0.375rem" padding-top=1 padding-bottom=1 border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff14)" flex-shrink=0 color="light-dark(#71717b, #a1a1a1)"
        text item.command font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.125rem" line-clamp=1 color="light-dark(#70707acc, #a1a1a1cc)"
      row flex-shrink=0 gap="0.5rem" align-items="center"
        if item.shortcut != ""
          text item.shortcut font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId=`project-action-shortcut-${item.id}`
        button id=`edit-project-action-${item.id}` press=open("project-action", item.id, item.name) focus=focusGear(true) blur=focusGear(false) aria-label=`Edit ${item.name}` disabled=(busy or not writable) opacity=(hovered or focused ? 1 : 0) testId=`edit-project-action-${item.id}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop=(busy or not writable ? "" : "enabled page")
          CnGlyph(name="settings", size=14, color="light-dark(#71717b, #a1a1a1)")

// Button variant="outline" size="sm": h-7, px 9, radius 8, border-input, bg-popover, shadow-xs/5.
style PjOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.375rem" box-sizing="border-box" height="1.75rem" min-width="2.5rem" padding-left="0.5625rem" padding-right="0.5625rem" flex-shrink=0
  border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d"
