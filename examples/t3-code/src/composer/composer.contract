use Snapshot from "../shared/shapes.contract"
use QueueEditAttachment from "./composer-shapes.contract"
use ComposerUpload from "./composer-shapes.contract"
use Viewport from "../shared/shapes.contract"
use ProviderInstanceMark from "../shared/icons-kit.contract"
use SnapshotDrafts from "../snapshot/snapshot.contract"
use ComposerFooter from "./composer-controls.contract"
use ComposerEditorView from "./composer-editor.contract"
use PromptLengthValidation from "./composer-editor.contract"
use uploadChipStatus from "./composer-editor.contract"
use AttachmentUrl from "../timeline/timeline-attachments.contract"
use ComposerRichView, citation, context, file, mention, skill, composerAtomFace from "./composer-rich.contract"
use ComposerCodeHeaders from "./composer-code-headers.contract"

// T3's ChatComposer: the composer card, its toolbar controls (ComposerControl.tsx
// "sm"), the send/stop actions (ComposerPrimaryActions.tsx) and the traits and
// runtime-mode menus (TraitsPicker.tsx, ChatComposer.tsx footer). Colours are
// the served build's tokens: foreground #18181b/#f5f5f5, muted #71717a/#a1a1a1,
// border #e4e4e7/white 8%, accent #f4f4f5/white 4%.

// Lucide geometry (24px grid) for the composer's own glyphs.
component CmpIcon
  props
    name: string
    size: number
    color: string
    weight: number
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=weight stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      if name == "chevron-down"
        path d="m6 9 6 6 6-6"
      if name == "chevron-right"
        path d="m9 18 6-6-6-6"
      if name == "lock" or name == "lock-open"
        rect x=3 y=11 width=18 height=11 rx=2 ry=2
        path d=(name == "lock" ? "M7 11V7a5 5 0 0 1 10 0v4" : "M7 11V7a5 5 0 0 1 9.9-1")
      if name == "pen-line"
        path d="M13 21h8M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
      if name == "sparkles"
        path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4M22 4h-4"
        circle cx=4 cy=20 r=2
      if name == "bot"
        path d="M12 8V4H8M2 14h2M20 14h2M15 13v2M9 13v2"
        rect x=4 y=8 width=16 height=12 rx=2
      if name == "pencil-ruler"
        path d="M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13M8 6l2-2M18 16l2-2M17 11l4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497zM15 5l4 4"
      if name == "search"
        path d="m21 21-4.34-4.34"
        circle cx=11 cy=11 r=8
      if name == "star" or name == "star-filled"
        path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" fill=(name == "star-filled" ? "currentColor" : "none")

// shouldHandleComposerAttachmentPaste (composerAttachmentFiles.ts) over a paste's `doc:` handles, which carry only
// their names: an image of any type attaches; other files attach only when the paste has no text, so a copy that
// carries text beside a file (a Finder copy carries the file's name) pastes the text.
fn composerPasteImage(path: string): bool = ["png", "jpg", "jpeg", "gif", "webp", "heic", "heif", "tif", "tiff", "bmp", "svg", "ico", "avif", "jxl"].includes(path.toLowerCase().split(".").slice(-1).join(""))
fn composerPasteTakesFiles(files: string[], text: string): bool = files.length > 0 and (files.filter((path) => composerPasteImage(path)).length > 0 or text == "")
// foldPastedText over pastedTextDisposition and wouldTextPasteExceedLimit (ChatComposer.tsx, client-runtime textPaste.ts):
// a text paste folds into a pasted-text.txt file at 32 KB, in UTF-16 units or UTF-8 bytes, or when it would take the
// prompt past 120,000 units; it is refused with the reference's toasts when it cannot be staged ("too-large-message")
// or is over the server's limit ("too-large-attach"); else it is the field's ("inline"). A unit is 1 to 3 bytes, so
// lengths alone decide most pastes; where only the byte count can, the paste is held and "measure" lets
// composer-editor-files.ts pasteDisposition decide. `limit` is the staging limit: 0 when the paste cannot be staged, -1
// for a literal answer, which keeps every paste inline (composer-editor-files.ts foldLimit).
fn composerPasteExceeds(text: string, valueLength: number, start: number, end: number): bool = valueLength - (max(min(start, valueLength), min(end, valueLength)) - min(start, valueLength)) + text.length > 120000
fn composerPasteOver(text: string, exceeds: bool, limit: number): string = limit == 0 ? (exceeds ? "too-large-message" : "inline") : (text.length * 3 <= limit ? "fold" : (text.length > limit ? (exceeds ? "too-large-attach" : "inline") : "measure"))
fn composerPasteDisposition(text: string, valueLength: number, start: number, end: number, limit: number): string = text == "" or limit < 0 ? "inline" : (composerPasteExceeds(text, valueLength, start, end) ? composerPasteOver(text, true, limit) : (text.length * 3 < 32768 or limit == 0 ? "inline" : (text.length < 32768 ? "measure" : composerPasteOver(text, false, limit))))

component ComposerCard
  inject
    frameMoved: action
    rem: number
    richComposer: ComposerRichView
    richComposerOwner: string
    composerFieldInputSerial: number
    composerMoved: action
    // A press in the prompt: a resting composer expands (composer-members.contract).
    composerPressed: action
    composerBeforeInput: action
    composerIntentNotice: string
    composerKeyEvent: action
    composerKeyReleased: action
    // Whether the resting composer's change animates (cite-members.contract).
    restMotion: bool
    // A copy or cut of the prompt's selection: its image and file chips are held for a paste into another draft.
    composerCopied: action
    // A press on a reference's pill (app.contract composerChipPress).
    composerChipPress: action
    // A drop, a paste or Attach files (app.contract attachFiles, composer-controls-attach.ts).
    attachFiles: action
    // The upload resources' answers (composer-controls-members.contract), for the image tiles' percentages.
    composerUploads: ComposerUpload[]
  props
    editor: ComposerEditorView
    data: Snapshot
    viewportWidth: number
    text: string
    resting: bool
    busy: bool
    narrow: bool
    keyModels: string
    modelsOpen: bool
    optionsOpen: string
    write: action
    send: action
    stop: action
    onFocus: action
    onBlur: action
    openModels: action
    openOptions: action
    removeSnapshot: action
    // app.contract titleMenuPick, for the shelf's "ui:confirm" before removing a referenced image.
    askRemove: action
    interaction: action
    command: action
    openProviders: action
    // A sidebar thread dragged over the composer (threadContextDrag.ts data-thread-context-over).
    contextOver: bool
    // Signed URLs for the queued edit's kept images.
    urls: AttachmentUrl[]
  // An image's chip follows its size with its upload's state, as its tile reads it (ImageContextChip).
  derive faces = richComposer.chips.map((c) => composerAtomFace(c, uploadChipStatus(c.face.imageId, data.composer.uploads.images, composerUploads)))
  derive sendable = data.canSend and data.composer.uploadBlock == "" and (text != "" or data.snapshotDrafts.length > 0)
  derive restingChip = data.composer.compactTokens != "" and not (data.composer.canResume and not sendable) and data.composer.queueEditing == ""
  // The field's value and selection as its events last reported them, where a held paste goes. Focused but not yet
  // edited or moved in, the field reports none: its caret is at the end of its value.
  state pasteValue = ""
  state pasteStart = 0
  state pasteEnd = 0
  action richMoved(e: InputEvent)
    pasteValue = e.value
    pasteStart = e.selectionStart
    pasteEnd = e.selectionEnd
    composerMoved(e)
  action richBeforeInput(e: InputEvent)
    pasteValue = e.value
    pasteStart = e.selectionStart
    pasteEnd = e.selectionEnd
    composerBeforeInput(e)
  // isPasteAsTextShortcut (⇧⌘V, no ⌥ or ⌃) arms the paste its menu item brings as Paste as Text for one second
  // (armPasteAsTextShortcut's deadline).
  action richKey(k: string, e: KeyboardEvent)
    if k.toLowerCase() == "v" and e.shiftKey and e.metaKey and not e.altKey and not e.ctrlKey
      pasteAsTextUntil = performanceNow() + 1000
    composerKeyEvent(k, e)
  action richKeyReleased(k: string, e: KeyboardEvent)
    composerKeyReleased(k, e)
  action richWrite(value: string, e: InputEvent)
    write(value, e)
  action richCopied
    composerCopied()
  action richAtom(e: AtomEvent)
    composerChipPress("composer", richComposerOwner, text, composerFieldInputSerial, e.start, e.end, e.source, e.kind == "citation" and e.altKey)
  action richBlurred
    pasteAsTextUntil = 0
    onBlur()
  // onComposerPaste: with a thread open, the paste's files attach (preventDefault keeps their names out of the
  // prompt); a large text paste is held (preventDefault) and folds into a file (composer-editor-files.ts foldPaste,
  // through attachFiles' queue: the field's value and selection let it put the chip where the paste would have gone,
  // and its id, microseconds on the runner's clock, rises with each paste). Armed by its key (richKey), the paste is Paste as Text
  // (consumePasteAsTextShortcut, one paste only): its images get no inline chip and its text stays inline however large
  // (bypassAutoAttachment). Edit › Paste as Text chosen with the pointer arms it in the module (T3Menus.swift, the
  // reference's DESKTOP_PASTE_AS_TEXT_EVENT), which TypeScript reads for the paste it held or the files it attaches.
  // Leaving the composer disarms it, as the reference's window blur does.
  state pasteAsTextUntil = 0
  action pasted(e: ClipboardEvent)
    let asText = performanceNow() <= pasteAsTextUntil
    let current = pasteValue == text
    let start = current ? pasteStart : text.length
    let end = current ? pasteEnd : text.length
    let fold = asText ? "inline" : composerPasteDisposition(e.text, text.length, start, end, editor.foldLimit)
    pasteAsTextUntil = 0
    if data.projectId != "" and composerPasteTakesFiles(e.files, e.text)
      preventDefault()
      attachFiles("paste", e.files, [], asText, "")
    else if fold != "inline"
      preventDefault()
      attachFiles("fold", [`${fold}\t${data.snapshotOwner}\t${richComposerOwner}\t${start}\t${end}\t${round(performanceNow() * 1000)}`, text, e.text], [], false, "")
  view
    column width="100%" border-radius="1rem" border-style="solid" border-width=1 border-color=(contextOver ? "light-dark(#1b4ed8b3, #346bf1b3)" : (data.look.themed ? data.look.border : "light-dark(#00000014, #ffffff0d)")) background-color=(data.look.themed ? data.look.popover : "light-dark(#fefefe, #101010)") box-shadow="0 1px 2px light-dark(#0000000d, #00000000), inset 0 1px 0 0 light-dark(#00000000, #ffffff08)" box-sizing="border-box" testId="composer-surface" position="relative" resize=frameMoved id="composer-surface" -exact-layout-transition=(restMotion ? `${data.look.panelMs}ms cubic-bezier(0.32, 0.72, 0, 1)` : "none") data-paint=`${(contextOver ? "" : (data.look.themed ? "border" : ""))} ${(data.look.themed ? "surfaceOverlay" : "")}` data-pick=((data.look.themed ? "surfaceOverlay" : "") != "" ? (data.look.themed ? "surfaceOverlay" : "") : ((contextOver ? "" : (data.look.themed ? "border" : "")) != "" ? (contextOver ? "" : (data.look.themed ? "border" : "")) : ""))
      // bg-accent/45 and ring-primary/70 while a thread is held over the composer.
      // ultrathink-frame, a static 2pt spectrum ring over the card's edge (index.css .ultrathink-frame::before:
      // the 120deg six-stop spectrum at 220% size shows its first 45%; saturate(.82) brightness(.92) baked into the stops). An SVG
      // stroke 4pt wide on the card's outline, clipped to the card, leaves the inner 2pt; SVG takes no presses.
      if data.composer.ultrathink
        svg position="absolute" left=-1 top=-1 width="calc(100% + 2px)" height="calc(100% + 2px)" overflow="hidden" pointer-events="none" aria-hidden=true testId="composer-ultrathink-frame"
          defs
            linearGradient id="ultrathink-spectrum" x1=0 y1=0 x2=1 y2=1
              stop offset=0 stop-color="#d76868"
              stop offset=0.396 stop-color="#d49324"
              stop offset=0.792 stop-color="#33ae61"
              stop offset=1 stop-color="#2da87c"
          rect x=0 y=0 width="100%" height="100%" rx=16 ry=16 fill="none" stroke="url(#ultrathink-spectrum)" stroke-width=4
      if contextOver
        box position="absolute" left=0 top=0 right=0 bottom=0 border-radius="0.9375rem" background-color="light-dark(#f4f4f573, #ffffff05)" aria-hidden=true testId="composer-context-over"
      // Resting, the prompt row reserves the floating actions' width: the send, and the Compact chip beside it.
      column padding-top=(resting ? "0.4375rem" : "1rem") padding-bottom=(resting ? "0.4375rem" : "0.5rem") padding-left="1rem" padding-right=(resting ? (restingChip ? `${3.5 * rem + data.composer.compactWidth + 0.5 * rem}px` : "3.5rem") : "1rem") gap="0.5rem" box-sizing="border-box" width="100%"
        // SnapShot attachment frames are snapshot.contract's.
        SnapshotDrafts(images=data.snapshotDrafts, disabled=(busy or data.uncertain), remove=removeSnapshot, ask=askRemove, videos=data.composerVideos, preparing=data.composer.preparingImages, command=command, uploads=data.composer.uploads, live=composerUploads)
        // The queued message's own attachments while it is edited (removable; new ones attach as usual).
        if data.composer.queueEditing != "" and data.composer.queueEditAttachments.length > 0
          row width="100%" gap="0.5rem" flex-wrap="wrap" align-items="center" testId="queued-edit-attachments"
            for item in data.composer.queueEditAttachments key=item.id
              QueuedEditChip(item=item, urls=urls, disabled=busy, remove=command("cclocal:queued-attachment-remove", item.id, "", 0))
        // The reference paints this placeholder as its own element (ComposerPromptEditorTiptap, text-placeholder),
        // so it stays text, not a ::placeholder part. Positioned, it paints above the field, so it takes no press
        // (the reference's pointer-events-none): a press on its line puts the caret in the field.
        // The field checks spelling, as the reference's editor does (its spellCheck={false} is on the chips only), so a
        // misspelled word is underlined and the shell's menu suggests (T3TextContextMenu.swift).
        // The reference editor is focus:outline-none (ComposerPromptEditorTiptap.tsx), so no ring shows while it has the
        // focus: `outline="none"` (main #459, issues/closed/20261009-field-outline-none.md).
        // Its -m-1 p-1 sits in a flow-root container, so the text and the placeholder both start at the container's top;
        // the field here has neither margin nor padding (a negative margin would collapse through the wrap and lift both).
        box width="100%" max-height=(resting ? "2rem" : "12.5rem") overflow-y=(resting ? "hidden" : "auto") pointerdown=composerPressed testId="composer-scroll-region"
          box position="relative" width="100%" id="composer-field-wrap"
            if text == ""
              text data.composer.placeholder font-family=data.look.promptFont position="absolute" left=0 top=0 right=0 font-size="0.875rem" line-height=(resting ? "2rem" : "1.421875rem") line-clamp=(resting ? 1 : 3) color="light-dark(#71717a, #a1a1a1)" pointer-events="none" aria-hidden=true testId="composer-placeholder"
            // Switching threads lands the focus here, so the field's name says the thread (ChatComposer ariaLabel). Each source
            // line reads in its block's majority direction (ComposerTextDirectionExtension); on macOS the arrow keys follow it.
            if richComposer.mode == "rich"
              textarea id="composer" testId="composer" hatch="t3-composer" data-snapshot-owner=data.snapshotOwner data-owner=richComposerOwner value=text input=richWrite paste=pasted copy=richCopied cut=richCopied markup="markdown" atoms="citation context file mention skill" atomFaces=faces paragraphDirs=richComposer.dirs atompress=richAtom selectionchange=richMoved beforeinput=richBeforeInput key=richKey keyup=richKeyReleased focus=onFocus blur=richBlurred aria-label=data.composer.fieldLabel aria-description=data.composer.placeholder width="100%" field-sizing=(resting ? "fixed" : "content") height=(resting ? "2rem" : "auto") min-height=(resting ? "2rem" : "2.5rem") font-family=data.look.promptFont font-size=data.look.promptSize line-height=(resting ? "2rem" : `${data.look.promptSize * 1.625}px`) padding=0 border-width=0 box-sizing="border-box" background-color="#00000000" color="light-dark(#18181b, #f5f5f5)" caret-color="light-dark(#18181b, #f5f5f5)" autocorrect="off" outline="none" data-editable="yes"
            else
              // With Markdown formatting off the field is plain source: the editor draws atoms only where it styles Markdown
              // (LLP 1045.000 D3), so a reference shows its source there. A literal answer has no chips (the reference's too).
              textarea id="composer" testId="composer" hatch="t3-composer" data-snapshot-owner=data.snapshotOwner data-owner=richComposerOwner value=text input=richWrite paste=pasted copy=richCopied cut=richCopied selectionchange=richMoved beforeinput=richBeforeInput key=richKey keyup=richKeyReleased focus=onFocus blur=richBlurred aria-label=data.composer.fieldLabel aria-description=data.composer.placeholder width="100%" field-sizing=(resting ? "fixed" : "content") height=(resting ? "2rem" : "auto") min-height=(resting ? "2rem" : "2.5rem") font-family=data.look.promptFont font-size=data.look.promptSize line-height=(resting ? "2rem" : `${data.look.promptSize * 1.625}px`) padding=0 border-width=0 box-sizing="border-box" background-color="#00000000" color="light-dark(#18181b, #f5f5f5)" caret-color="light-dark(#18181b, #f5f5f5)" autocorrect="off" outline="none" data-editable="yes"
        ComposerCodeHeaders(source=richComposer, owner=richComposerOwner, value=text, resting=resting)
      // The prompt editor (composer-editor.contract): the length line.
      if composerIntentNotice != ""
        text composerIntentNotice role="status" padding="0.5rem 1rem" testId="composer-intent-notice"
      if editor.promptLimit != "" and not resting
        PromptLengthValidation(message=editor.promptLimit)
      ComposerFooter(data=data, viewportWidth=viewportWidth, text=text, resting=resting, busy=busy, narrow=narrow, keyModels=keyModels, modelsOpen=modelsOpen, optionsOpen=optionsOpen, send=send, stop=stop, openModels=openModels, openOptions=openOptions, interaction=interaction, command=command, openProviders=openProviders)

// One attachment the queued edit keeps (ChatView composerEditingQueuedAttachments):
// an image's 56pt thumbnail or a file's name, with its remove button.
component QueuedEditChip
  props
    item: QueueEditAttachment
    urls: AttachmentUrl[]
    disabled: bool
    remove: action
  view
    row position="relative" height=(item.image ? "3.5rem" : "2rem") min-width=(item.image ? "3.5rem" : "0px") max-width="13.75rem" gap="0.375rem" align-items="center" padding-left=(item.image ? "0px" : "0.5rem") padding-right=(item.image ? "0px" : "1.75rem") box-sizing="border-box" overflow="hidden" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="light-dark(#fcfcfcb3, #000000b3)" testId=`queued-edit-attachment-${item.id}`
      if item.image
        box width="3.5rem" height="3.5rem"
          for entry in urls.filter((entry) => entry.id == item.id) key=entry.id
            image entry.url aria-label=item.name width="100%" height="100%" object-fit="cover"
      else
        svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="light-dark(#71717a, #a1a1a1)" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7ZM14 2v4a2 2 0 0 0 2 2h4"
        text item.name font-size="0.75rem" line-height="1rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1 min-width=0
      button press=remove disabled=disabled aria-label=`Remove ${item.name}` testId=`queued-edit-remove-${item.id}` position="absolute" right="0.25rem" top="0.25rem" width="1.25rem" height="1.25rem" padding=0 border-radius="0.5rem" border-width=0 background-color="light-dark(#ffffffe6, #18181be6)" display="flex" align-items="center" justify-content="center" title=""
        svg width="0.75rem" height="0.75rem" viewBox="0 0 24 24" color="light-dark(#18181b, #f5f5f5)" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M18 6 6 18M6 6l12 12"
