// T3Code's composer controls: the rich composer, the prompt preview, the options menu, attachments and commands (LLP 1091.002).
use promptPreviewSample from "../appearance/settings-prompt-preview.contract"
use ComposerRichView, ComposerFieldObservation from "./composer-rich.contract"
use layoutFrame, optionsTriggerId from "../shell/layout-frames.contract"
use routeKeyboardComplete from "../connections/connections-routes.contract"
use ComposerUpload from "./composer-shapes.contract"
use Change from "../shared/shapes.contract"
members T3Code
  derive composerOwner = data.composerOwner // `${serverUrl}:${projectId}:${threadId}`; a draft Auto balance moved keeps its own (auto-balance-owner.ts)
  derive composerText = draftOwner == `${composerOwner}${data.requestKey}` ? draft : data.draft
  derive richComposerOwner = `${composerOwner}${data.requestKey}`
  resource richComposer = composerRich(data.snapshotOwner, richComposerOwner, composerText, data.revision, composerInputType, "composer", "") as shape ComposerRichView
  state promptPreviewText = promptPreviewSample()
  state promptPreviewInputType = ""
  state promptPreviewSerial = 0
  state promptPreviewComposing = false
  state promptPreviewStart = 0
  state promptPreviewEnd = 0
  derive promptPreviewSnapshotOwner = data.snapshotOwner
  derive promptPreviewOwner = `${data.snapshotOwner}:prompt-preview`
  derive promptPreviewVisible = settingsOpen and settingsRoute == "appearance" and settingsCore.sections.filter((section) => section.rows.filter((row) => row.info == "preview-prompt").length > 0).length > 0
  resource richPromptPreview = composerRich(data.snapshotOwner, promptPreviewOwner, promptPreviewText, data.revision, promptPreviewInputType, "preview", "") as shape ComposerRichView
  action promptPreviewWrite(value: string, e: InputEvent)
    let serial = promptPreviewSerial + 1
    promptPreviewText = value
    promptPreviewInputType = e.inputType
    promptPreviewSerial = serial
    promptPreviewComposing = e.isComposing
    promptPreviewStart = e.selectionStart
    promptPreviewEnd = e.selectionEnd
    observePromptPreview(value, e.selectionStart, e.selectionEnd, e.isComposing, serial)
  task promptPreviewLifecycle key=`${promptPreviewOwner}|${promptPreviewVisible}|${richPromptPreview.generation}`
    after(1, promptPreviewMounted)
  action promptPreviewMounted
    let serial = promptPreviewSerial + 1
    promptPreviewSerial = serial
    observePromptPreview(promptPreviewText, promptPreviewStart, promptPreviewEnd, promptPreviewComposing, serial)
  action observePromptPreview(value: string, start: number, end: number, composing: bool, serial: number)
    send chipObserved = composerChipObserved(ComposerFieldObservation(generation=richPromptPreview.generation, snapshotOwner=data.snapshotOwner, owner=promptPreviewOwner, value=value, start=min(value.length, start), end=min(value.length, end), composing=composing, live=(promptPreviewVisible and frame("prompt-font-preview").width > 0), focused=false, inputSerial=serial))
  task promptPreviewHidden when not promptPreviewVisible
    after(1, promptPreviewReset)
  action promptPreviewReset
    let value = promptPreviewSample()
    let serial = promptPreviewSerial + 1
    promptPreviewText = value
    promptPreviewInputType = ""
    promptPreviewComposing = false
    promptPreviewStart = 0
    promptPreviewEnd = 0
    promptPreviewSerial = serial
    observePromptPreview(value, 0, 0, false, serial)
  action closeOptions
    optionsOpen = ""
    focus(composerTarget == "" ? "composer" : "side-chat-composer")
  // The trigger a composer menu opens from, measured as it opens and again with the layout frames while it is open:
  // ComposerMenus aligns the menu to its start, or its end (the implement pill, the meter). -1 while the trigger is not
  // laid out (a shortcut for a control in the overflow).
  state optionsAnchorX = -1
  state optionsAnchorWidth = 0
  // The window-space boxes the TypeScript layouts read, by name (src/shell/layout-frames.ts): the composer's drawer
  // and overlay, its menus' rows, the chat canvas and the thread details card, the device tools. Each box's `resize`
  // measures them all again, so a box that only moves is measured with the box whose change of size moved it.
  state layoutFrames = ""
  action frameMoved(w: number, h: number)
    layoutFrames = [layoutFrame("chat", frame("frame-chat")), layoutFrame("overlay", frame("frame-overlay")), layoutFrame("shoulder", frame("frame-shoulder")), layoutFrame("dock", frame("frame-dock")), layoutFrame("stack", frame("frame-stack")), layoutFrame("card", frame("composer-surface")), layoutFrame("subagent", frame("provider-subagent-bar")), layoutFrame("toolbar", frame("frame-toolbar")), layoutFrame("strip", frame("frame-strip")), layoutFrame("details-content", frame("frame-details-content")), layoutFrame("details-density-compact", frame("frame-details-density-compact")), layoutFrame("details-full-top", frame("frame-details-full-top")), layoutFrame("details-vcs", frame("frame-details-vcs")), layoutFrame("details-full-tail", frame("frame-details-full-tail")), layoutFrame("details-lineage", frame("frame-details-lineage")), layoutFrame("details-full-git", frame("frame-details-full-git")), layoutFrame("details-pr-list", frame("frame-details-pr-list")), layoutFrame("device-area", frame("frame-device-area")), layoutFrame("side-toolbar", frame("side-chat-frame-toolbar")), layoutFrame("side-card", frame("side-chat-composer-surface"))].filter((row) => row != "").join(";")
    if optionsOpen != ""
      measureOptionsTrigger(optionsOpen)
  action measureOptionsTrigger(name: string)
    let trigger = frame(`${composerTarget == "" ? "" : "side-chat-"}${optionsTriggerId(name)}`) // a side chat's composer (side-chat-members.contract)
    optionsAnchorX = trigger.unavailable or trigger.width <= 0 ? -1 : trigger.x
    optionsAnchorWidth = trigger.unavailable ? 0 : trigger.width
  action openOptions(name: string)
    composerTarget = "" // the window's composer
    measureOptionsTrigger(name)
    focus(optionsOpen == name ? "composer" : name == "effort" ? "composer-menu" : name == "runtime" ? `composer-menu-item-${data.composer.runtimeSelected}` : name == "branch" ? "branch-search" : name == "workspace" ? "composer-menu" : "composer-menu-item-0")
    optionsOpen = optionsOpen == name ? "" : name
    branchQuery = ""
    modelsOpen = false
    popoverSession = popoverSession + 1
  action menuCommand(op: string, id: string, value: string, n: number)
    optionsOpen = ""
    focus(composerTarget == "" ? "composer" : "side-chat-composer")
    if not commandPending
      commandPending = true
      send changed = command(composerTarget == "" ? op : `scope:${composerTarget}|${op}`, id, value, n)
  action searchBranches(value: string)
    branchQuery = value
  action composerKey(op: string, id: string, value: string) // A composer control's key name (composer-controls-commands.ts).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, value, 0)
  action composerDrop(op: string, id: string, vx: number, vy: number) // A queued row's grip released (pan release).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, "", 0)
  // The model trigger's edges as the picker opens from it (ProviderModelPicker's PopoverPopup aligns its start, or its
  // end when the start would overflow); -1 until measured. A press from the trigger opens the picker on its search.
  state modelAnchorX = -1
  state modelAnchorWidth = 0
  action modelMeasure
    composerTarget = "" // the window's composer
    let trigger = frame("model-picker-trigger")
    modelAnchorX = trigger.unavailable or trigger.width <= 0 ? -1 : trigger.x
    modelAnchorWidth = trigger.unavailable ? 0 : trigger.width
    modelOpenTarget = ""
    modelFocusedPick = `${data.providerId}:${data.modelId}`
  // composer.effort and composer.mode aimed at the model picker (markOpenToEffort, takeOpenTarget): it opens, or stays
  // open, with the focus on the effort column, or with its footer's Permissions menu open on the checked mode.
  state modelOpenTarget = ""
  action modelOpenTo(target: string)
    modelMeasure()
    if not modelsOpen
      openModels()
    modelPermissions(target == "permissions")
    if target == "effort" and data.composer.effortFocusAny >= 0
      focus(`model-effort-row-${data.composer.effortFocusAny}`)
  action modelPermissions(open: bool)
    modelOpenTarget = open ? "permissions" : ""
    if open
      focus(`model-permission-${data.composer.runtimeSelected}`)
  // A model picked in the composer's picker keeps it open; once the new model's levels are drawn, the focus moves to
  // the checked one (handleInstanceModelChange's focusEffort("levels")). The model the picker opened on, or last
  // moved the focus for, is `modelFocusedPick`.
  state modelFocusedPick = ""
  task modelEffortFocusTask when modelsOpen and modelTarget.id == "" and not commandPending key=`${data.providerId}:${data.modelId}`
    after(1, modelEffortFocused)
  action modelEffortFocused
    let pick = `${data.providerId}:${data.modelId}`
    if pick != modelFocusedPick
      modelFocusedPick = pick
      if data.composer.effortFocusLevel >= 0
        focus(`model-effort-row-${data.composer.effortFocusLevel}`)
  // An effort, speed or permissions pick inside the model picker, which stays open until Escape or an outside press.
  action pickerPick(op: string, id: string, value: string)
    if not commandPending
      commandPending = true
      send changed = command(composerTarget == "" ? op : `scope:${composerTarget}|${op}`, id, value, 0)
  action menuPick(op: string, id: string, value: string)
    optionsOpen = ""
    focus(composerTarget == "" ? "composer" : "side-chat-composer")
    if not commandPending
      commandPending = true
      send changed = command(composerTarget == "" ? op : `scope:${composerTarget}|${op}`, id, value, 0)
  action commandCompleted
    noticeExit = ""
    match changed
      case some(result)
        routeKeyboard = routeKeyboardComplete(routeKeyboard, result.routeReorder, result.message, routeKeyboardOwned)
        if result.relaunch
          relaunch()
        if pendingModal != ""
          modalError = result.message == "task-webhook-keep" or result.message.startsWith("toasted:") ? "" : result.message
        if result.message == "" or result.message == "task-webhook-keep"
          if pendingModal == "connect-first" or pendingModal == "connect"
            connecting = false
            origin = ""
            originEdited = false
          if pendingModal == "welcome-pair"
            welcomeLink = ""
            welcomePairFold = "closed"
            welcomePaired = welcomePaired + 1
          if pendingModal == "provider-add" or pendingModal == "provider-add-local"
            providerDialog = pendingModal == "provider-add-local" ? "" : wizardManual or wizardDriver == "acpRegistry" ? providerDialog : ""
            providerSelected = providerCreated
          if pendingModal == "provider-close"
            providerDialog = ""
          if pendingModal == "provider-acp"
            wizardManual = false
            wizardDriver = "acpRegistry"
            wizardStep = 1
          if pendingModal == "rest" and keybindingSaving != ""
            // The written row's draft ends; the other rows keep theirs (buildKeybindingRows' stable row ids).
            keybindingDrafts = keybindingDrafts.filter((d) => d.row != keybindingSaving and (d.row == "new" or bindings.ids.includes(d.row)))
            keybindingOpen = keybindingOpen and keybindingSaving != "new"
            keybindingPrevious = keybindingPrevious == keybindingSaving ? "" : keybindingPrevious
            keybindingRecording = keybindingRecording and keybindingPrevious != keybindingSaving
          if pendingModal == "rest"
            if restEditor == "project-remove" and restSubject == ""
              projectRemoved()
            if result.message != "task-webhook-keep"
              restEditor = ""
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "settings"
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "theme-dialog"
            settingsThemeDialog = ""
        if result.message.startsWith("branch-restore-confirm:")
          confirmTitle = `Switch to ${result.message.slice(23)}?`
          confirmBody = "You have uncommitted changes. They'll carry over to the other branch, or block the switch if they conflict."
          confirmDestructive = false
          confirmOp = "cc:branch-restore-confirmed"
          confirmTarget = ""
          confirmValue = ""
          focus("app-confirm-cancel")
        if result.message == "terminal:focus-composer"
          focus("composer")
        if result.message.startsWith("focus:") and (result.message != "focus:composer" or (data.sidebar.renameId == "" and renameAfterOp == "" and not data.sidebar.renameHeld)) // an opening rename owns focus over its row's late thread-open result
          focus(result.message.slice(6))
        if result.message.startsWith("sidebar:pr-page:") // with no thread open, the pull request on the Pull Requests page (before any branch below sets utilityPage: openPage reads it)
          openPage("pull-requests")
          prSelect(result.message.slice(16))
        if result.message == "pr-guide:asked"
          prTab = "guide"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
        if result.message == "sidebar:new-thread" or result.message == "pr-handoff-next"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
        if result.message.startsWith("sidebar:opened") // a row's pull request or port went to its thread first (openThread's own effects); `:focus`, ChatView's composer focus on a thread change
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          if result.message == "sidebar:opened:focus"
            focus("composer")
        if result.message == "pr-handoff-next" // the thread shows first, then its checkout runs (pages-pr-handoffs.ts)
          send prHandoffChanged = command("pageslocal:pr-act-handoff-run", "", "", 0)
        if result.message == "sidebar:palette-new-thread" or result.message.startsWith("palette:") // `palette:<page>` (the linked threads, on the pull request's URL; the thread picker)
          paletteOpen = true
          paletteMode = "command"
          palettePage = result.message == "sidebar:palette-new-thread" ? "new-thread-in" : result.message.slice(8)
          paletteQuery = result.message.startsWith("palette:pr-linked|") ? result.message.slice(18) : ""
          paletteTrailPages = []
          paletteTrailQueries = []
          paletteReturnQuery = ""
          paletteRestore = false
          paletteCursor = -1
          paletteScroll = 0
          modelsOpen = false
          optionsOpen = ""
          focus("palette-input")
        if result.message.startsWith("pr-select:") // a pull request link opens on the page
          prSelect(result.message.slice(10))
        if result.message.startsWith("sidebar:project-settings:")
          openSettings() // a project link replaces the whole scope (retainSettingsScope)
          settingsProjectId = result.message.slice(25)
          settingsRoute = "projects"
        if result.message.startsWith("sidebar:settings:") // a settings page by its route, then a row to land on (Custom snooze's Edit snooze options)
          openSettings()
          let settingsPageLink = result.message.slice(17)
          settingsRoute = settingsPageLink.includes(":") ? settingsPageLink.slice(0, settingsPageLink.indexOf(":")) : settingsPageLink
          settingsFocusTarget = settingsPageLink.includes(":") ? settingsPageLink.slice(settingsPageLink.indexOf(":") + 1) : ""
          settingsJumpOpened = ""
      case none
    pendingModal = ""
    commandPending = false
    lineageStopping = ""
    if renameAfterOp != ""
      send localChanged = command(`sidebarlocal:${renameAfterOp}`, renameAfterId, "", 0)
      renameAfterOp = ""
  action attachFiles(origin: string, files: string[], picked: Picked[], asText: bool, target: string)
    send filesAdded = composerAttach(origin, files, picked, asText, target, "")
  // ChatComposer's drop and Attach files focus the prompt; a sidebar row's drop opens its thread (handleThreadFileDrop).
  action filesAddedDone
    match filesAdded
      case some(result)
        if result.message == "focus:composer"
          focus("composer")
        if result.message.startsWith("open:")
          openThread(result.message.slice(5), "click")
      case none
  action chooseAttachments
    showPicker("composer-attach-input")
  // attachmentUploadQueue.ts: a draft image uploads as it joins the draft, three at once on each machine, each in one of
  // these streams, whose fetch tells the bytes it has sent (composer-uploads.ts), so no answer waits on one. An image
  // keeps its resource until its upload ends, since new arguments let a running upload go.
  resource composerUpload0 = composerUpload(0, data.composer.uploads.u0.id, data.composer.uploads.u0.attachmentId) as shape ComposerUpload
  resource composerUpload1 = composerUpload(1, data.composer.uploads.u1.id, data.composer.uploads.u1.attachmentId) as shape ComposerUpload
  resource composerUpload2 = composerUpload(2, data.composer.uploads.u2.id, data.composer.uploads.u2.attachmentId) as shape ComposerUpload
  resource composerUpload3 = composerUpload(3, data.composer.uploads.u3.id, data.composer.uploads.u3.attachmentId) as shape ComposerUpload
  resource composerUpload4 = composerUpload(4, data.composer.uploads.u4.id, data.composer.uploads.u4.attachmentId) as shape ComposerUpload
  resource composerUpload5 = composerUpload(5, data.composer.uploads.u5.id, data.composer.uploads.u5.attachmentId) as shape ComposerUpload
  derive composerUploads = [composerUpload0, composerUpload1, composerUpload2, composerUpload3, composerUpload4, composerUpload5]
  // An upload that ended, by its resource's answer for the attachment it carries now; one cut off on its way fails
  // with no answer. The root's `cclocal:uploads` lands or fails them and starts the images waiting for a resource.
  derive composerUploadEnd0 = composerUpload0.attachmentId != "" and composerUpload0.attachmentId == data.composer.uploads.u0.attachmentId and (composerUpload0.status == "ready" or composerUpload0.status == "failed")
  derive composerUploadEnd1 = composerUpload1.attachmentId != "" and composerUpload1.attachmentId == data.composer.uploads.u1.attachmentId and (composerUpload1.status == "ready" or composerUpload1.status == "failed")
  derive composerUploadEnd2 = composerUpload2.attachmentId != "" and composerUpload2.attachmentId == data.composer.uploads.u2.attachmentId and (composerUpload2.status == "ready" or composerUpload2.status == "failed")
  derive composerUploadEnd3 = composerUpload3.attachmentId != "" and composerUpload3.attachmentId == data.composer.uploads.u3.attachmentId and (composerUpload3.status == "ready" or composerUpload3.status == "failed")
  derive composerUploadEnd4 = composerUpload4.attachmentId != "" and composerUpload4.attachmentId == data.composer.uploads.u4.attachmentId and (composerUpload4.status == "ready" or composerUpload4.status == "failed")
  derive composerUploadEnd5 = composerUpload5.attachmentId != "" and composerUpload5.attachmentId == data.composer.uploads.u5.attachmentId and (composerUpload5.status == "ready" or composerUpload5.status == "failed")
  derive composerUploadsCut = [(data.composer.uploads.u0.id != "" and failed(composerUpload0) ? "0" : ""), (data.composer.uploads.u1.id != "" and failed(composerUpload1) ? "1" : ""), (data.composer.uploads.u2.id != "" and failed(composerUpload2) ? "2" : ""), (data.composer.uploads.u3.id != "" and failed(composerUpload3) ? "3" : ""), (data.composer.uploads.u4.id != "" and failed(composerUpload4) ? "4" : ""), (data.composer.uploads.u5.id != "" and failed(composerUpload5) ? "5" : "")].filter((slot) => slot != "").join(" ")
  derive composerUploadsDue = data.composer.uploads.pending != "" or data.composer.uploads.settle > 0 or composerUploadEnd0 or composerUploadEnd1 or composerUploadEnd2 or composerUploadEnd3 or composerUploadEnd4 or composerUploadEnd5 or composerUploadsCut != ""
  mutation uploadsChanged as shape Change queue refreshes data
  task composerUploadsRun when composerUploadsDue key=`${data.composer.uploads.pending}|${data.composer.uploads.settle}|${composerUploadEnd0}:${data.composer.uploads.u0.attachmentId}|${composerUploadEnd1}:${data.composer.uploads.u1.attachmentId}|${composerUploadEnd2}:${data.composer.uploads.u2.attachmentId}|${composerUploadEnd3}:${data.composer.uploads.u3.attachmentId}|${composerUploadEnd4}:${data.composer.uploads.u4.attachmentId}|${composerUploadEnd5}:${data.composer.uploads.u5.attachmentId}|${composerUploadsCut}`
    after(1, composerUploadsNow)
  action composerUploadsNow
    send uploadsChanged = command("cclocal:uploads", "", composerUploadsCut, 0)
  // A send kept while its images uploaded (useComposerSend's await) goes once they have landed, as a command of its own,
  // whichever thread is shown: no answer waits for them, so none let go meanwhile is left waiting (composer-uploads.ts).
  task sendResume when data.composer.sendResume != "" and not commandPending key=data.composer.sendResume
    after(1, sendResumeNow)
  action sendResumeNow
    if not commandPending and data.composer.sendResume != ""
      commandPending = true
      send changed = command("send-resume", data.composer.sendResume, "", 0)
  // The pump's requests (an upload URL, an attachment let go) wait on a server reply, so the tick publishes the
  // transport's table as it starts and ends, as transportAnswered does for the answers it names.
  task composerUploadsAnswered key=`${pending(uploadsChanged)}`
    after(1, transportPump)
  action command(op: string, id: string, value: string, n: number)
    if op == "sidebar:undo" and id != ""
      undoHeldKey = id // the undo chord's key (keyboard-dispatch.ts chordKey), whose repeats modifierKey cancels
    if op.startsWith("secretlocal:")
      send secretAnswered = command(op, id, value, n)
    else if op == "chatlocal:item-detail"
      send timelineDisclosureChanged = command(op, id, value, n)
    else if op == "diffreview" and (id.startsWith("drag:") or id.startsWith("gutter:") or id.startsWith("comment:") or id == "to" or id == "end")
      // A gutter drag sends at its press, on each line and at its release; a click's press and
      // release come within a few ms, so they queue on their own send (a later send on one mutation would replace the
      // press before it ran, and `changed` takes one command at a time). The "+"'s press queues behind its drag.
      send lineDragChanged = command(op, id, value, n)
    else
      if op.endsWith(":ticket")
        send terminalTicketChanged = command(op, id, value, n)
      else if op.startsWith("terminallocal:") or op.startsWith("terminalpanellocal:") or op.startsWith("pageslocal:welcome-terminal-page")
        send terminalChanged = command(op, id, value, n)
      else if op == "draft" or op == "search" or op == "sidebar" or op == "answer" or op == "choice" or op == "dismiss-error" or op == "close-diff" or op == "diff-view" or op == "favorite-model"
        send localChanged = command(op, id, value, n)
      else if op == "chatlocal:diagram-frame" or op == "chatlocal:math-frame"
        send frameReported = command(op, id, value, n) // a page's report is never dropped while a command runs
      else
        if not commandPending
          commandPending = true
          send changed = command(op, id, value, (n == 0 and op.startsWith("chat:")) ? wallTime.epochAtZero + performanceNow() : n)
