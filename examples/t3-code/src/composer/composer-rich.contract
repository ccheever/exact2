use ProjectGlyph from "../sidebar/sidebar-shapes.contract"

shape ComposerCodeHeader
  start: number
  end: number
  infoStart: number
  infoEnd: number
  info: string
  language: string
  label: string

shape ComposerCodeLanguage
  id: string
  label: string

shape ComposerSourceChip
  kind: string
  start: number
  end: number
  source: string
  label: string
  name: string
  path: string
  href: string
  contextKind: string
  contextId: string
  image: bool
  comment: string
  quote: string
  face: ComposerChipFace

// SURROUND_CLOSE's openers (composer-surround.ts): typed over a selection, the app wraps it.
fn composerSurrounds(text: string): bool = ["(", "[", "{", "'", "\u{22}", "“", "`", "<", "«", "*", "_"].includes(text)

shape ComposerChipFace
  kind: string
  label: string
  suffix: string
  icon: string
  fileToken: string
  imageId: string
  available: bool
  interactive: bool
  comment: bool
  tip: string
  // A thread chip's project icon (ThreadContextChip's ProjectFavicon); kind "" with no known project.
  glyph: ProjectGlyph
  ariaLabel: string
  ink: string

// The reference's chips are atom nodes of its editor (ComposerPromptEditorTiptap: composer-mention, composer-skill,
// composer-citation, composer-context-reference); here each is an atom of the Markdown source (LLP 1045.000). A file
// link or a token is one only while composerChips names it, by a face keyed by its source. A skill token begins with
// any currency symbol (`\p{Sc}`), as composerChips' does. Since v0.1.5 a ContextChip has no pill: no fill, and its
// text is its kind's accent raised to 5:1 on the theme (the face's `ink`, shared/chip-accents.ts); an unresolved chip
// takes the field's text.
atom citation link="t3-citation:" color="light-dark(#18181b, #f5f5f5)" background-color="#00000000"
atom context link="t3-context:" color="light-dark(#18181b, #f5f5f5)" background-color="#00000000"
atom file link="relative" color="light-dark(#18181b, #f5f5f5)" background-color="#00000000"
atom mention prefix="@" color="light-dark(#18181b, #f5f5f5)" background-color="#00000000"
atom skill prefix="$¢£¤¥֏؋߾߿৲৳৻૱௹฿៛₠₡₢₣₤₥₦₧₨₩₪₫€₭₮₯₰₱₲₳₴₵₶₷₸₹₺₻₼₽₾₿⃀⃁꠸﷼﹩＄￠￡￥￦𑿝𑿞𑿟𑿠𞋿𞲰" color="light-dark(#18181b, #f5f5f5)" background-color="#00000000"

// A chip's pill: its label, its suffix and an image's upload state (`upload`, composer-editor.contract
// uploadChipStatus), its kind's glyph as the nearest SF Symbol (the Apple host draws only `symbol:sf/` icons), its
// tooltip, which names how a citation's comment opens (the reference's chip has a pencil for it), its accessible name
// (the reference chip's aria-label: an image's names its size, not its upload state), and its ink. A file mention keeps its icon before its path in a
// right-to-left line (ComposerMentionNodeView's dir="ltr"); the other chips follow their line, as the reference's do.
fn composerAtomFace(c: ComposerSourceChip, upload: string): AtomFace = AtomFace(source=c.source, label=[c.face.label, c.face.suffix, upload].filter((part) => part != "").join(" "), icon=`symbol:sf/${composerAtomSymbol(c.face.icon)}`, title=(c.face.comment ? `${c.face.tip}\n⌥-click to comment` : c.face.tip), color=c.face.ink, backgroundColor="", direction=(c.kind == "mention" ? "ltr" : ""), ariaLabel=c.face.ariaLabel)
fn composerAtomSymbol(icon: string): string = icon == "at-sign" or icon == "file" ? "doc" : icon == "folder" or icon == "sparkles" or icon == "film" ? icon : icon == "quote" ? "quote.opening" : icon == "image" ? "photo" : icon == "messages-square" ? "bubble.left.and.bubble.right" : icon == "square-terminal" ? "apple.terminal" : icon == "message-circle" ? "bubble.left" : icon == "mouse-pointer-2" ? "cursorarrow" : icon == "git-merge" ? "arrow.triangle.merge" : icon.startsWith("git-pull-request") ? "arrow.triangle.pull" : "circle.dashed"

shape ComposerSourceBlock
  kind: string
  start: number
  end: number
  contentStart: number
  bodyStart: number
  bodyEnd: number
  bodyLine: bool // false: a fence closed on the next line, projected where its body would be
  nested: bool // a list line whose marker is indented

// Deferred input metadata; field source and undo remain owned by the textarea.
shape ComposerIntentMetadata
  serial: number
  kind: string
  text: string
  key: string
  shift: bool
  command: bool
  start: number
  end: number
  inputSerial: number

shape ComposerIntentReply
  owner: string
  value: string
  mode: string
  serial: number
  kind: string
  start: number
  end: number
  text: string
  selectionStart: number
  selectionEnd: number
  preserveSelection: bool

shape ComposerRichView
  generation: number
  historyPrevious: bool
  historyNext: bool
  languages: ComposerCodeLanguage[]
  owner: string
  value: string
  mode: string
  headers: ComposerCodeHeader[]
  blocks: ComposerSourceBlock[]
  chips: ComposerSourceChip[]
  // The field's base direction for each source line (paragraphDirs, composer-text-direction.ts); "" outside rich mode.
  dirs: string

shape ComposerFieldObservation
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  start: number
  end: number
  composing: bool
  live: bool
  focused: bool
  inputSerial: number

shape ComposerFieldCommand
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  start: number
  end: number
  text: string
  selectionStart: number
  selectionEnd: number
  focus: bool
  then: string
  seq: number
  ready: bool
  history: number
  citation: number
  completion: number

shape ComposerFieldResult
  applied: bool
  reason: string
  value: string
  start: number
  end: number

shape ComposerFieldAcknowledgement
  applied: bool
  reason: string
  value: string
  start: number
  end: number
  generation: number
  snapshotOwner: string
  owner: string
  seq: number
  then: string
  send: bool
  focus: string
  removedImage: string
  inputSerial: number
