use ProjectGlyph from "../sidebar/sidebar-shapes.contract"

shape ComposerCodeHeader
  start: number
  end: number
  infoStart: number
  infoEnd: number
  info: string
  language: string
  label: string

shape ComposerCodeLanguage
  id: string
  label: string

shape ComposerSourceChip
  kind: string
  start: number
  end: number
  source: string
  label: string
  name: string
  path: string
  href: string
  contextKind: string
  contextId: string
  image: bool
  comment: string
  quote: string
  face: ComposerChipFace

// SURROUND_CLOSE's openers (composer-surround.ts): typed over a selection, the app wraps it.
fn composerSurrounds(text: string): bool = ["(", "[", "{", "'", "\u{22}", "“", "`", "<", "«", "*", "_"].includes(text)

shape ComposerChipFace
  kind: string
  label: string
  suffix: string
  icon: string
  fileToken: string
  imageId: string
  available: bool
  interactive: bool
  comment: bool
  tip: string
  // A thread chip's project icon (ThreadContextChip's ProjectFavicon); kind "" with no known project.
  glyph: ProjectGlyph

// The reference's chips are atom nodes of its editor (ComposerPromptEditorTiptap: composer-mention, composer-skill,
// composer-citation, composer-context-reference); here each is an atom of the Markdown source (LLP 1045.000). A file
// link or a token is one only while composerChips names it, by a face keyed by its source. A skill token begins with
// any currency symbol (`\p{Sc}`), as composerChips' does. The paint is the ContextChip kind's: its accent at 11%
// behind, mixed 22% into the text; a context reference keeps the platform's token look.
atom citation link="t3-citation:" color="light-dark(#2f3b4f, #ceddf4)" background-color="#4684e51c"
atom context link="t3-context:"
atom file link="relative" color="light-dark(#2c3e45, #cbe0e6)" background-color="#0096af1c"
atom mention prefix="@" color="light-dark(#2c3e45, #cbe0e6)" background-color="#0096af1c"
atom skill prefix="$¢£¤¥֏؋߾߿৲৳৻૱௹฿៛₠₡₢₣₤₥₦₧₨₩₪₫€₭₮₯₰₱₲₳₴₵₶₷₸₹₺₻₼₽₾₿⃀⃁꠸﷼﹩＄￠￡￥￦𑿝𑿞𑿟𑿠𞋿𞲰" color="light-dark(#433448, #e7d5ea)" background-color="#b261be1c"

// A chip's pill: its label, its kind's glyph as the nearest SF Symbol (the Apple host draws only `symbol:sf/` icons),
// and its tooltip, which names how a citation's comment opens: the reference's chip has a pencil for it.
fn composerAtomFace(c: ComposerSourceChip): AtomFace = AtomFace(source=c.source, label=(c.face.suffix == "" ? c.face.label : `${c.face.label} ${c.face.suffix}`), icon=`symbol:sf/${composerAtomSymbol(c.face.icon)}`, title=(c.face.comment ? `${c.face.tip}\n⌥-click to comment` : c.face.tip), color="", backgroundColor="", direction="")
fn composerAtomSymbol(icon: string): string = icon == "at-sign" or icon == "file" ? "doc" : icon == "folder" or icon == "sparkles" or icon == "film" ? icon : icon == "quote" ? "quote.opening" : icon == "image" ? "photo" : icon == "messages-square" ? "bubble.left.and.bubble.right" : icon == "square-terminal" ? "apple.terminal" : icon == "message-circle" ? "bubble.left" : icon == "mouse-pointer-2" ? "cursorarrow" : icon == "git-merge" ? "arrow.triangle.merge" : icon.startsWith("git-pull-request") ? "arrow.triangle.pull" : "circle.dashed"

shape ComposerSourceBlock
  kind: string
  start: number
  end: number
  contentStart: number
  bodyStart: number
  bodyEnd: number
  bodyLine: bool // false: a fence closed on the next line, projected where its body would be

// Deferred input metadata; field source and undo remain owned by the textarea.
shape ComposerIntentMetadata
  serial: number
  kind: string
  text: string
  key: string
  shift: bool
  command: bool
  start: number
  end: number
  inputSerial: number

shape ComposerIntentReply
  owner: string
  value: string
  mode: string
  serial: number
  kind: string
  start: number
  end: number
  text: string
  selectionStart: number
  selectionEnd: number
  preserveSelection: bool

shape ComposerRichView
  generation: number
  historyPrevious: bool
  historyNext: bool
  languages: ComposerCodeLanguage[]
  owner: string
  value: string
  mode: string
  headers: ComposerCodeHeader[]
  blocks: ComposerSourceBlock[]
  chips: ComposerSourceChip[]

shape ComposerFieldObservation
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  start: number
  end: number
  composing: bool
  live: bool
  focused: bool
  inputSerial: number

shape ComposerFieldCommand
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  start: number
  end: number
  text: string
  selectionStart: number
  selectionEnd: number
  focus: bool
  then: string
  seq: number
  ready: bool
  history: number
  citation: number
  completion: number

shape ComposerFieldResult
  applied: bool
  reason: string
  value: string
  start: number
  end: number

shape ComposerFieldAcknowledgement
  applied: bool
  reason: string
  value: string
  start: number
  end: number
  generation: number
  snapshotOwner: string
  owner: string
  seq: number
  then: string
  send: bool
  focus: string
  removedImage: string
  inputSerial: number
