// A composer chip's details popover (a skill's; a terminal excerpt's, a review comment's and a preview annotation's
// below), adapted from
// T3 Code 1e2ecbd975 (MIT, see LICENSE-T3): ComposerPromptEditorTiptap.tsx ComposerSkillNodeView's
// ContextChipPopover (contextChipParts.tsx) and ui/popover.tsx PopoverPopup (side top, align center,
// sideOffset 4, width "lg": w-96 capped at the viewport less 2rem, padding "compact": py-2 px-3,
// dropdown-glass, drawn opaque as there is no backdrop blur here). Its content is `space-y-3 p-2 text-sm`:
// the label (font-medium), the skill's description or "No description is available for this skill.", and an
// outline small "View instructions" for a skill with a path. The chip is an atom of the prompt's editor,
// whose press anchors this at the pill (app.contract composerChipPress); the window draws this above every
// page (the Settings prompt sample's chip included), as Base UI portals the popup to the body. Base UI's
// collision avoidance: the side flips below when the window leaves no room above, and the popup shifts to
// stay 5 pt inside it.

// A press on a reference's pill, with its source identity and the pill's frame (app.contract composerChipPress).
shape ComposerChipRequest
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  inputSerial: number
  start: number
  end: number
  source: string
  surface: string
  comment: bool
  frame: Geometry

shape ComposerChipFinish
  seq: number
  generation: number
  snapshotOwner: string
  owner: string
  value: string
  inputSerial: number
  surface: string
  start: number
  end: number
  focus: string
  send: bool
  interaction: number

shape ChipPopover
  finish: ComposerChipFinish
  seq: number
  open: bool
  surface: string
  label: string
  title: string
  description: string
  path: string
  x: number
  y: number
  width: number
  height: number
  // "skill", or "citation" (its comment, citation-comment.contract); a citation's saved comment,
  // its anchor ("chip": the comment button, "source": the cited text after Cite) and the anchor's window frame.
  kind: string
  comment: string
  anchor: string
  ax: number
  ay: number
  aw: number
  ah: number
  // The cited answer (its message id without the kind prefix) and quote, highlighted while the comment is open, and the
  // quote's start in that answer's text stream when this app's Cite measured it (-1: unknown).
  message: string
  quote: string
  at: number
  // A terminal excerpt's "Line N" / "Lines a–b" and its output's line count (the
  // output is `description`, the terminal's name `label`).
  lines: string
  rows: number
  // A review comment's diff, a preview annotation's crop (a draft image id) and its height over its width (0: unknown),
  // and an action press the window has not sent yet (composer-chip-details.ts; `open` false).
  diff: string
  image: string
  aspect: number
  act: string

// The popup's height for the flip: py-2 and p-2 around the label, space-y-3, the description's lines at
// 20/14 (about 7 pt a character across the content width), and the 28 pt button with its 12 pt gap.
fn chipPopoverEstimate(chip: ChipPopover, width: number): number = (chip.kind == "terminal" ? 2 + 16 + 2 + 37 + min(320, chip.rows * 19.5 + 24) : chip.kind == "review-comment" ? 2 + 16 + 2 + 24 + 16 + 14 + (chip.description != "" ? 8 + (floor(chip.description.length * 7 / max(width - 50, 100)) + 1) * 20 : 0) + (chip.diff != "" ? 8 + 256 : 0) : chip.kind == "preview-annotation" ? 2 + 16 + 2 + (chip.image == "" ? 33 : chipShotHeight(chip, width)) + 20 + (chip.description.split("\n").length + floor(chip.description.length * 7 / max(width - 50, 100))) * 20 : 2 + 32 + 20 + 12 + (floor(chip.description.length * 7 / max(width - 42, 100)) + 1) * 20 + (chip.path != "" ? 40 : 0))

// The annotation's crop at the popover's content width (w-full), capped at 16rem (max-h-64), object-contain.
fn chipShotHeight(chip: ChipPopover, width: number): number = min(256, chip.aspect > 0 ? (width - 26) * chip.aspect : 160)

// What takes the focus as the popup opens (PopoverPopup's `initialFocus`: the first tabbable, else the popup itself): a
// terminal excerpt's output, a skill's View instructions, else the popup.
fn chipPopoverFocus(chip: ChipPopover): string = chip.kind == "terminal" ? "chip-popover-output" : chip.kind == "skill" and chip.path != "" ? "chip-popover-instructions" : "chip-popover"

// Within the window, 5 pt from its edges (Base UI's collision padding).
fn chipPopoverLeft(chip: ChipPopover, width: number, viewportWidth: number): number = max(5, min(viewportWidth - width - 5, chip.x + chip.width / 2 - width / 2))

component ChipPopoverLayer
  inject
    rem: number
  props
    chip: ChipPopover
    viewportWidth: number
    viewportHeight: number
    // View instructions: the skill's file opens in the right panel (rightPanelStore.openFile).
    instructions: action
  derive width = min(24 * rem, viewportWidth - 2 * rem)
  derive estimate = chipPopoverEstimate(chip, width)
  derive above = chip.y - 9 >= estimate or chip.y >= viewportHeight - chip.y - chip.height
  view
    column id="chip-popover" position="absolute" left=chipPopoverLeft(chip, width, viewportWidth) top=(above ? "auto" : chip.y + chip.height + 4) bottom=(above ? viewportHeight - chip.y + 4 : "auto") width=width padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 16px 40px -18px #0000008c" z-index=130 role="dialog" aria-label=chip.title tabindex=-1 testId="chip-popover"
      // TerminalContextInlineChip's details (rounded-md border, the header with its
      // TerminalIcon in the success colour, the terminal's name and lines, then the captured output, max-h-80, scrolling).
      if chip.kind == "terminal"
        column width="100%" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" background-color="light-dark(#fcfcfccc, #000000cc)" overflow="hidden" testId="chip-popover-terminal"
          row width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.5rem" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)"
            svg width="1rem" height="1rem" viewBox="0 0 24 24" fill="none" stroke="#00bc7d" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
              path d="M12 19h8M4 17l6-6-6-6"
            text chip.label flex=1 min-width=0 font-size="0.875rem" font-weight=500 line-height="1.25rem" line-clamp=1 color="light-dark(#18181b, #f5f5f5)" testId="chip-popover-label"
            text chip.lines font-size="0.75rem" line-height="1rem" white-space="nowrap" flex-shrink=0 color="light-dark(#71717b, #a1a1a1)" testId="chip-popover-lines"
          scroll width="100%" max-height="20rem" background-color="light-dark(#fafafa, #ffffff08)"
            text chip.description id="chip-popover-output" aria-label="Captured terminal output" tabindex=0 padding="0.75rem" box-sizing="border-box" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.21875rem" white-space="pre" color="light-dark(#18181b, #f5f5f5)" testId="chip-popover-output"
      // ComposerReviewCommentDetails (rounded-lg border-border/70 bg-background/70 p-3, space-y-2): the file path and
      // "<section> · <range>", the comment, and the diff in an h-64 bordered box. The comment is ChatMarkdown and the
      // diff ReadOnlySourcePreview (highlighted, numbered) in the reference; here both are plain text.
      else if chip.kind == "review-comment"
        column width="100%" padding="0.75rem" gap="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" background-color="light-dark(#fcfcfcb3, #000000b3)" overflow="hidden" color="light-dark(#18181b, #f5f5f5)" testId="chip-popover-review"
          column gap="0.25rem" min-width=0
            text chip.label font-size="0.75rem" line-height="1rem" font-weight=500 line-clamp=1 testId="chip-popover-label"
            text chip.lines font-size="0.6875rem" line-height="0.875rem" color="light-dark(#71717b, #a1a1a1)" testId="chip-popover-lines"
          if chip.description != ""
            text chip.description font-size="0.875rem" line-height="1.25rem" white-space="pre-wrap" overflow-wrap="anywhere" testId="chip-popover-description"
          if chip.diff != ""
            scroll width="100%" height="16rem" box-sizing="border-box" border-radius="0.25rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#fafafa, #ffffff08)"
              text chip.diff aria-label="review.diff" padding="0.5rem" box-sizing="border-box" font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1.125rem" white-space="pre" testId="chip-popover-diff"
      // ComposerPreviewAnnotationDetails (rounded-lg border-border/70 bg-background/70): the crop (max-h-64 w-full
      // object-contain, border-b, bg-muted) or "Screenshot unavailable", then the summary (whitespace-pre-wrap px-3 py-2.5 text-sm).
      else if chip.kind == "preview-annotation"
        column width="100%" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" background-color="light-dark(#fcfcfcb3, #000000b3)" overflow="hidden" color="light-dark(#18181b, #f5f5f5)" testId="chip-popover-annotation"
          if chip.image != ""
            box width="100%" height=chipShotHeight(chip, width) border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" background-color="light-dark(#f4f4f5, #ffffff0a)" position="relative"
              box hatch="t3-snapshot-tile" data-snapshot-id=`contain:${chip.image}` position="absolute" left=0 top=0 right=0 bottom=0 role="img" aria-label="Annotated preview crop" testId="chip-popover-screenshot"
          else
            text "Screenshot unavailable" width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff14)" background-color="light-dark(#f4f4f566, #ffffff05)" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" testId="chip-popover-no-screenshot"
          text chip.description padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" padding-bottom="0.625rem" box-sizing="border-box" font-size="0.875rem" line-height="1.25rem" white-space="pre-wrap" overflow-wrap="anywhere" testId="chip-popover-description"
      else
        column padding="0.5rem" gap="0.75rem" align-items="flex-start" color="light-dark(#18181b, #f5f5f5)"
          text chip.label font-size="0.875rem" line-height="1.25rem" font-weight=500 testId="chip-popover-label"
          text chip.description font-size="0.875rem" line-height="1.25rem" testId="chip-popover-description"
          if chip.path != ""
            button press=instructions id="chip-popover-instructions" testId="chip-popover-instructions" display="flex" flex-direction="row" align-items="center" justify-content="center" box-sizing="border-box" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
              text "View instructions" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap"

// The details' Escape: Base UI's Popover dismisses on an Escape anywhere in the document,
// wherever the focus is. The native editor's own cancelOperation only heard it while its text view had the focus, so a
// real Escape after a click elsewhere (the heading, then the chip) left the details open. A hidden shortcut button, as
// the palette's and the diff menus': a shortcut reaches it from any focus in the window before a field or the text
// view hears the key. The host gives an Escape to the oldest shortcut button that declares it (ShortcutsMac `nodes()`,
// the lowest node id), so this one is the window's first node, mounted with the window: a holder made before the chip
// opened (the right panel's toggle while a panel shows, the notice stack's "Hide other notices", a surface menu's
// backdrop beside the composer) would otherwise take the key and leave the details open; T3 Code binds none of them to
// Escape over the popover (the right panel closes on mod+w). `held` is false while nothing shows, and while a palette,
// menu or dialog opened over the details holds Escape (the palette's Escape closes only the palette, as T3 Code's
// Dialog over the popover does).
component ChipPopoverEscape
  props
    held: bool
    dismiss: action
  view
    box position="absolute" left=0 top=0 width=0 height=0 overflow="hidden" testId="chip-popover-keys"
      button press=dismiss aria-keyshortcuts=(held ? "Escape" : "") aria-hidden=true tabindex=-1 testId="chip-popover-escape" width=1 height=1 overflow="hidden" opacity=0 padding=0 border-width=0 background-color="#00000000"
        text "Close" font-size=1
