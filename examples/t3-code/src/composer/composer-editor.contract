// T3's prompt editor surfaces (composer-editor.ts): the command menu drawer
// above the composer (ComposerCommandMenu.tsx in a ComposerBanner.Surface),
// the prompt-length line (ComposerPromptLengthValidation.tsx) and the stash.
// The composer's own key action takes ↑ ↓ ↩ ⇥ and Escape while a menu is open
// (app.contract composerKeyEvent).
use ComposerUpload, ComposerUploadImage from "./composer-shapes.contract"

shape ComposerMenuRow
  id: string
  index: number
  type: string
  label: string
  prefix: string
  description: string
  icon: string
  iconLight: string
  iconDark: string
  badge: string
  badgeIcon: string
shape ComposerMenu
  open: bool
  kind: string
  listLabel: string
  searchKey: string
  loading: bool
  emptyText: string
  count: number
  rows: ComposerMenuRow[]
shape ComposerStashRow
  id: string
  index: number
  snippet: string
  age: string
  label: string
shape ComposerStash
  count: number
  pulse: number
  rows: ComposerStashRow[]
  menuOpen: bool
  keyStash: string
// ComposerCommandMenuLayer: the drawers' place over the chat column (composer-editor-drawer.ts).
shape ComposerDrawer
  placed: bool
  left: number
  width: number
  bottom: number
  listMax: number
  // The card's window frame (a sidebar thread held over it rings it).
  cardX: number
  cardY: number
  cardWidth: number
  cardHeight: number
  // The expanded stack's height, kept while the composer rests (composerStackHold).
  hold: number
shape ComposerEditorView
  owner: string
  menu: ComposerMenu
  promptLimit: string
  overLimit: bool
  usageLimits: number
  stash: ComposerStash
  // The byte limit for folding a large paste into a file, 0 when it cannot be staged (composer.contract composerPasteDisposition).
  foldLimit: number
  drawer: ComposerDrawer

// The stash badge's count lifts to the primary ink for 1.2s after a save;
// two names let a later save restart it (ComposerStashBadge pulseKey).
keyframes cePulseA
  from opacity=1
  99% opacity=1
  to opacity=0
keyframes cePulseB
  from opacity=1
  99% opacity=1
  to opacity=0

// Row glyphs: lucide strokes, Pierre file-type icons (16px grid, filled).
component EditorMenuIcon
  props
    name: string
    color: string
    size: number
  view
    if name == "messages-square" or name == "folder" or name == "blocks" or name == "user-round" or name == "settings" or name == "package" or name == "git-pull-request" or name == "git-pull-request-draft" or name == "git-merge" or name == "git-pull-request-closed"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
        if name == "messages-square"
          path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
          path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"
        if name == "folder"
          path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
        if name == "blocks"
          path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2"
          rect x=14 y=2 width=8 height=8 rx=1
        if name == "user-round"
          circle cx=12 cy=8 r=5
          path d="M20 21a8 8 0 0 0-16 0"
        if name == "settings"
          path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
          circle cx=12 cy=12 r=3
        if name == "package"
          path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73zM12 22V12M3.29 7 12 12l8.71-5M7.5 4.27l9 5.15"
        if name == "git-pull-request" or name == "git-pull-request-draft" or name == "git-merge" or name == "git-pull-request-closed"
          circle cx=6 cy=6 r=3
          circle cx=18 cy=18 r=3
          if name == "git-pull-request"
            path d="M13 6h3a2 2 0 0 1 2 2v7M6 9v12"
          if name == "git-pull-request-draft"
            path d="M18 6V5M18 11v-1M6 9v12"
          if name == "git-merge"
            path d="M6 21V9a9 9 0 0 0 9 9"
          if name == "git-pull-request-closed"
            path d="M6 9v12m15-18-6 6m6 0-6-6m3 8.5V15"
    else
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 16 16" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
        if name == "pierre-markdown"
          path d="M1 12V4h2l2 2.5L7 4h2v8H7V7.5l-2 2-2-2V12zm9-3 3 3.5L16 9h-2V4h-2v5z"
        if name == "pierre-typescript" or name == "pierre-javascript" or name == "pierre-bash" or name == "pierre-python" or name == "pierre-go" or name == "pierre-react"
          path d="M8 1C2.24 1 1 2.24 1 8s1.24 7 7 7 7-1.24 7-7-1.24-7-7-7" opacity=0.2
          if name == "pierre-typescript"
            path d="M8.1 9.64h.95c.04.62.28.76 1.28.76s1.2-.14 1.2-.85c0-.66-.2-.85-1.2-1.07-1.79-.38-2.18-.7-2.18-1.86C8.15 5.3 8.54 5 10.31 5c1.67 0 2.04.26 2.07 1.42h-.95c-.02-.43-.23-.53-1.1-.53-1 0-1.22.14-1.22.74 0 .52.22.7 1.24.92 1.76.38 2.15.73 2.15 2 0 1.44-.4 1.75-2.24 1.75-1.8 0-2.18-.3-2.15-1.66m-3 1.57V5.99H3.5v-.9h4.21v.9H6.1v5.22z"
        if name == "pierre-image"
          path d="M12.5 2A2.5 2.5 0 0 1 15 4.5v4.67l-4.05-3.54-4.08 4.08-3-2L1 10.6V4.5A2.5 2.5 0 0 1 3.5 2z" opacity=0.3
          path d="M15 10.5v1a2.5 2.5 0 0 1-2.5 2.5h-9a2.5 2.5 0 0 1-2.46-2.04L4 9l3 2 4-4zm-7-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"
        if name == "pierre-text"
          path d="M8 4a3 3 0 0 0 3 3h3v5.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 12.5v-9A2.5 2.5 0 0 1 4.5 1H8z" fill-rule="evenodd" opacity=0.4
          path d="M8.5 11a.5.5 0 0 1 0 1h-3a.5.5 0 0 1 0-1zm2-2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1zm-1-8a.5.5 0 0 1 .354.146l4 4A.5.5 0 0 1 14 5.5V6h-3a2 2 0 0 1-2-2V1z"
        if name != "pierre-markdown" and name != "pierre-typescript" and name != "pierre-javascript" and name != "pierre-bash" and name != "pierre-python" and name != "pierre-go" and name != "pierre-react" and name != "pierre-image" and name != "pierre-text"
          path d="M8 1v3a3 3 0 0 0 3 3h3v5.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 12.5v-9A2.5 2.5 0 0 1 4.5 1z" opacity=0.4
          path d="M9.5 1a.5.5 0 0 1 .354.146l4 4A.5.5 0 0 1 14 5.5V6h-3a2 2 0 0 1-2-2V1z"

// The drawer: a ComposerBanner surface attached above the composer card,
// 22pt inside its edges, whose last 17pt the card covers (the seam).
component ComposerCommandMenu
  inject
    rem: number
    composerMenuActive: number
    composerMenuHover: action
  props
    menu: ComposerMenu
    dark: bool
    listMax: number
    layered: bool
    op: action
  // The highlight is the window's (app.contract composerMenuActive): the composer's ↑ ↓ move it and Return picks it.
  derive active = composerMenuActive
  view
    column width=(layered ? "100%" : `calc(100% - ${2.75 * rem}px)`) margin-left=(layered ? "0px" : "1.375rem") margin-right=(layered ? "0px" : "1.375rem") margin-bottom=(layered ? "0px" : "-1.0625rem") padding-bottom="1.0625rem" box-sizing="border-box" position="relative" border-top-left-radius="1rem" border-top-right-radius="1rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#18181b14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" backdrop-filter=(layered ? "none" : (dark ? "blur(16px)" : "blur(12px)")) box-shadow="0 1px 2px light-dark(#0000000d, #00000000), 0 14px 32px -18px light-dark(#00000000, #000000bf)" testId="composer-command-menu"
      // Dark surfaces shade the 10pt above the seam (bg-composer-seam-above).
      box position="absolute" left=0 right=0 bottom="1.0625rem" height="0.625rem" pointer-events="none" background-image=(dark ? "linear-gradient(to top, #0000002e, #00000000)" : "none") aria-hidden=true
      if menu.count > 0
        column max-height=listMax overflow-y="scroll" padding="0.5rem" box-sizing="border-box" width="100%" role="listbox" aria-label=menu.listLabel testId="composer-command-list"
          for row in menu.rows key=row.id
            button press=op("pick", row.id, "") hover=composerMenuHover(row.index) role="option" aria-selected=(row.index == active) aria-label=`${row.prefix}${row.label} ${row.description}` testId=`composer-suggestion-${row.index}` width="100%" height="1.75rem" flex-shrink=0 padding-top="0.375rem" padding-bottom="0.375rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" border-width=0 border-radius="0.25rem" background-color=(row.index == active ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              if row.icon != ""
                EditorMenuIcon(name=row.icon, color=`light-dark(${row.iconLight}, ${row.iconDark})`, size=16)
              row flex=1 min-width=0 gap="0.5rem" align-items="center"
                row max-width="45%" min-width=0 flex-shrink=0
                  if row.prefix != ""
                    text row.prefix font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #a1a1a1)" white-space="nowrap" flex-shrink=0
                  text row.label font-size="0.75rem" font-weight=500 line-height="1rem" color=(row.index == active ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#262626, #f5f5f5)") line-clamp=1 min-width=0
                text row.description flex=1 min-width=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" line-clamp=1 text-align="left"
                if row.badge != ""
                  row height="1.125rem" min-width="1.125rem" padding-left="0.1875rem" padding-right="0.1875rem" gap="0.25rem" margin-left="auto" align-items="center" justify-content="center" border-radius="0.25rem" background-color="light-dark(#f4f4f5, #ffffff0f)" flex-shrink=0
                    box opacity=0.8 display="flex"
                      EditorMenuIcon(name=row.badgeIcon, color="light-dark(#18181b, #f5f5f5)", size=12)
                    text row.badge font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
      else
        column padding-top="0.875rem" padding-bottom="1.75rem" padding-left="1.25rem" padding-right="1.25rem" box-sizing="border-box" width="100%" role="status" testId="composer-command-empty"
          text menu.emptyText font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)"

// ComposerPromptLengthValidation: px-4 pb-2 text-xs destructive (#fb2c36 / #fb414a served), role=alert.
component PromptLengthValidation
  props
    message: string
  view
    text message role="alert" padding-left="1rem" padding-right="1rem" padding-bottom="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)" testId="composer-prompt-length"

component StashGlyph
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      if name == "bookmark"
        path d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"
      if name == "file-text"
        path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2zM14 2v5a1 1 0 0 0 1 1h5M10 9H8M16 13H8M16 17H8"
      if name == "x"
        path d="M18 6 6 18M6 6l12 12"
      if name == "chevron-down"
        path d="m6 9 6 6 6-6"
      if name == "refresh-cw"
        path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5"

// ComposerStashBadge: a shoulder tab at the composer's top-right (22pt in),
// whose last 17pt the card covers, beside the banners (app.contract puts it
// at the end of their row). ⌘S's chord is its key binding.
component StashKey
  props
    stash: ComposerStash
    op: action
  view
    button -exact-menu="none" press=op("stash", "", "") aria-keyshortcuts=stash.keyStash aria-label="Stash prompt" position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true tabindex=-1 testId="composer-stash-key"
      text "composer-stash-key" font-size=1

component StashBadge
  props
    stash: ComposerStash
    op: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row flex-shrink=0 padding-right="1.375rem" box-sizing="border-box" margin-bottom=(stash.count > 0 ? "-1.0625rem" : "0px") position="relative"
      if stash.count > 0
        column padding-top="0.3125rem" padding-bottom="1.375rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-top-left-radius="1rem" border-top-right-radius="1rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#18181b14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" box-shadow="0 1px 2px light-dark(#0000000d, #00000000), 0 14px 32px -18px light-dark(#00000000, #000000bf)"
          button press=op("stash-menu", "", "toggle") hover=hover aria-label=`Stashed prompts: ${stash.count}. Open stash.` aria-expanded=false testId="composer-stash-badge" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap=0
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              StashGlyph(name="bookmark", size=12, color=(over ? "light-dark(#262626, #f5f5f5)" : "light-dark(#71717a, #a1a1a1)"))
            text "Stash" font-size="0.75rem" line-height="1rem" color=(over ? "light-dark(#262626, #f5f5f5)" : "light-dark(#71717a, #a1a1a1)") padding-right="0.25rem"
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" position="relative" flex-shrink=0
              text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #a1a1a1)"
              if stash.pulse > 0
                box position="absolute" left=0 top=0 width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" opacity=0 animation=(stash.pulse % 2 == 0 ? "cePulseA 1.2s linear forwards" : "cePulseB 1.2s linear forwards") aria-hidden=true
                  text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #fafafa)"

// ComposerStashMenu: the attached drawer listing stashed prompts. ↑ ↓ ↩, ⌘⌫ and
// Escape typed in the composer are its (app.contract composerKeyEvent); Escape
// pressed inside the drawer closes it too. Escape elsewhere (a terminal, a diff
// comment, a dialog) is left alone (T3 Code 74541bab17, ComposerStashMenu.tsx).
component StashMenu
  inject
    rem: number
    composerStashActive: number
    composerStashHover: action
  props
    stash: ComposerStash
    layered: bool
    op: action
  // The highlight is the window's (app.contract composerStashActive), which the composer's keys move.
  derive active = composerStashActive
  action drawerKey(k: string, e: KeyboardEvent)
    if k == "Escape" and not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey
      preventDefault()
      stopPropagation()
      op("stash-menu", "", "close")
  view
    column key=drawerKey width=(layered ? "100%" : `calc(100% - ${2.75 * rem}px)`) margin-left=(layered ? "0px" : "1.375rem") margin-right=(layered ? "0px" : "1.375rem") margin-bottom=(layered ? "0px" : "-1.0625rem") padding-top="0.25rem" padding-left="0.25rem" padding-right="0.25rem" padding-bottom="1.3125rem" box-sizing="border-box" border-top-left-radius="1rem" border-top-right-radius="1rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#18181b14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" box-shadow="0 1px 2px light-dark(#0000000d, #00000000), 0 14px 32px -18px light-dark(#00000000, #000000bf)" testId="composer-stash-menu"
      button press=op("stash-menu", "", "close") aria-label="Close stash" aria-expanded=true testId="composer-stash-close" width="100%" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap=0
        box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          StashGlyph(name="bookmark", size=12, color="light-dark(#71717a, #a1a1a1)")
        text "Stash" flex=1 font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" text-align="left"
        box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #a1a1a1)"
        box width="1.5rem" height="1.5rem" margin-left="0.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          StashGlyph(name="chevron-down", size=14, color="light-dark(#71717a, #a1a1a1)")
      column width="100%" gap=1 max-height="12.5rem" overflow-y="scroll" role="list" aria-label="Stashed prompts" testId="composer-stash-list"
        for entry in stash.rows key=entry.id
          row width="100%" height="1.5rem" flex-shrink=0 align-items="center" border-radius="0.25rem" background-color=(entry.index == active ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") role="listitem" hover=composerStashHover(entry.index)
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              StashGlyph(name="file-text", size=12, color="light-dark(#71717a, #a1a1a1)")
            button press=op("stash-restore", entry.id, "") aria-label=entry.label testId=`composer-stash-restore-${entry.index}` flex=1 min-width=0 height="1.5rem" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="flex-start"
              text entry.snippet font-size="0.75rem" line-height="1rem" color="light-dark(#18181bcc, #f5f5f5cc)" line-clamp=1 min-width=0 text-align="left"
            row gap="0.25rem" align-items="center" flex-shrink=0 padding-left="0.25rem"
              text entry.age font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" white-space="nowrap"
              button press=op("stash-delete", entry.id, "") aria-label="Delete stashed prompt" testId=`composer-stash-delete-${entry.index}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
                StashGlyph(name="x", size=14, color="light-dark(#71717a, #a1a1a1)")

// Everything the prompt editor attaches above the composer card: ⌘S and, until
// the layer below is placed, the command or stash menu in the composer's flow. (The
// stash badge rides the banners' row, app.contract.)
component ComposerEditorDock
  inject
    rem: number
  props
    editor: ComposerEditorView
    dark: bool
    op: action
  view
    column width="100%" position="relative"
      StashKey(stash=editor.stash, op=op)
      if not editor.drawer.placed
        if editor.menu.open
          ComposerCommandMenu(menu=editor.menu, dark=dark, listMax=288, layered=false, op=op)
        else
          if editor.stash.menuOpen and editor.drawer.cardWidth > 2.75 * rem
            StashMenu(stash=editor.stash, layered=false, op=op)

// ComposerCommandMenuLayer: the open drawer over the chat column, 22pt inside
// the card's edges, its last 17pt (the seam) under the card. Nothing in the
// transcript or the composer moves when it opens, and the banners stay under it.
// app-main.contract paints it after the composer overlay (banners
// and card together), so the layer ends at the card's top and clips its seam
// (margin-bottom -17 inside overflow hidden), which the card covered before.
// The layer carries the surface's backdrop blur: a blur sees its parent's
// subtree, here the chat column with the transcript and the overlay.
component ComposerDrawerLayer
  inject
    rem: number
  props
    editor: ComposerEditorView
    dark: bool
    op: action
  view
    if editor.drawer.placed and editor.drawer.width > 2.75 * rem and (editor.menu.open or editor.stash.menuOpen)
      column position="absolute" left=(editor.drawer.left + 1.375 * rem) width=(editor.drawer.width - 2.75 * rem) bottom=editor.drawer.bottom overflow="hidden" border-top-left-radius="1rem" border-top-right-radius="1rem" backdrop-filter=(dark ? "blur(16px)" : "blur(12px)") testId="composer-drawer-layer"
        column width="100%" margin-bottom="-1.0625rem" flex-shrink=0
          if editor.menu.open
            ComposerCommandMenu(menu=editor.menu, dark=dark, listMax=editor.drawer.listMax, layered=true, op=op)
          else
            StashMenu(stash=editor.stash, layered=true, op=op)

// An image picked with Attach files on the shelf (ChatComposer's non-snap-shot
// frame): a 64pt square thumbnail (object-cover, the SnapShot tile hook draws
// the draft PNG) with its media-close Remove always shown, no capture details.
// The thumbnail is the "Preview <name>" button that opens the expanded preview,
// then Remove follows, in the reference's DOM order; the frame itself is unnamed.
component ImageDraftTile
  props
    id: string
    name: string
    // Its chip is in the prompt, so Remove asks first (removeComposerImage).
    referenced: bool
    disabled: bool
    remove: action
    ask: action
    command: action
    // Where the focus goes when its focused Remove removes it (snapshot.contract draftFocusAfter).
    after: string
    // Its upload, if any (composer-uploads.ts), and the upload resources' answers.
    uploads: ComposerUploadImage[]
    live: ComposerUpload[]
  state removeFocused = false
  action removeFocus(on: bool)
    removeFocused = on
  action removeNow
    remove(id)
    if removeFocused
      focus(after)
  view
    column position="relative" width="4rem" height="4rem" flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff10)" background-color="light-dark(#fcfcfc, #000000)" testId=`image-draft-${id}`
      ImagePreviewButton(id=id, name=name, command=command)
      for upload in uploads key=upload.id
        UploadMeter(upload=upload, live=live, name=name, command=command)
      row position="absolute" top="0.25rem" right="0.25rem"
        // Asking first, a focused Remove names where the focus goes after the confirmed removal; the confirm moves the
        // focus there on Confirm, or back to this Remove on Cancel, before it closes (app.contract confirmUi).
        if referenced
          button id=`remove-snapshot-${id}` press=ask(removeFocused ? `ui:confirm:${after}` : "ui:confirm", id, "remove-snapshot", `Remove ${name} from the message?`, "It is referenced in your text; removing it also removes every reference.", true) focus=removeFocus(true) blur=removeFocus(false) disabled=disabled aria-label=`Remove ${name}` testId=`remove-snapshot-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center" title=""
            StashGlyph(name="x", size=14, color="#ffffff")
        else
          button id=`remove-snapshot-${id}` press=removeNow focus=removeFocus(true) blur=removeFocus(false) disabled=disabled aria-label=`Remove ${name}` testId=`remove-snapshot-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center" title=""
            StashGlyph(name="x", size=14, color="#ffffff")

// An image taken into the draft whose file is still being prepared (ComposerAttachmentMediaRow's preparing image): the
// same 64pt tile at once, its "Preview" disabled and its name for a thumbnail until the image joins the draft under
// this id; Remove cancels it.
component PreparingImageTile
  props
    id: string
    name: string
    // ComposerImageThumbnail: a 256 px thumbnail of the taken image; "" until it is made (or for none), when the name shows.
    source: string
    command: action
    // The server stages uploads: the tile's upload line shows at once, at 0% (supportsAttachmentUploads).
    uploading: bool
  view
    column position="relative" width="4rem" height="4rem" flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff10)" background-color="light-dark(#fcfcfc, #000000)" testId=`preparing-image-${id}`
      button disabled=true aria-label=`Preview ${name}` testId=`preview-image-${id}` position="absolute" left=0 top=0 right=0 bottom=0 padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center" title=""
        if source != ""
          image source aria-hidden=true position="absolute" left=0 top=0 width="100%" height="100%" object-fit="cover" testId=`preparing-thumbnail-${id}`
        else
          text name font-size="0.625rem" line-height="0.875rem" text-align="center" color="light-dark(#71717a, #a1a1a1)" line-clamp=3 overflow-wrap="anywhere"
      if uploading
        UploadLine(id=id, label="0%")
      row position="absolute" top="0.25rem" right="0.25rem"
        button press=command("cclocal:preparing-image-cancel", id, "", 0) aria-label=`Remove ${name}` testId=`remove-snapshot-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center" title=""
          StashGlyph(name="x", size=14, color="#ffffff")

// The upload of a draft image's tile (ComposerAttachmentStrip): its percentage along the tile's foot while it uploads
// (formatAttachmentUploadProgress), from 0% while it waits for a resource, and a Retry at the lower left once it failed,
// whose tip is the reason (retryAttachmentUpload). A resource's answer counts for the attachment it carries now.
fn uploadPercent(progress: number): string = `${floor(max(0, min(1, progress)) * 100)}%`
fn uploadLive(upload: ComposerUploadImage, live: ComposerUpload[]): ComposerUpload[] = live.filter((each) => upload.status == "slot" and each.attachmentId == upload.attachmentId and each.id == upload.id)
fn uploadLabel(upload: ComposerUploadImage, live: ComposerUpload[]): string = upload.status == "queued" ? "0%" : upload.status != "slot" ? "" : uploadLive(upload, live).length == 0 ? "0%" : uploadLive(upload, live).filter((each) => each.status == "uploading").map((each) => uploadPercent(each.progress)).join("")
fn uploadFailure(upload: ComposerUploadImage, live: ComposerUpload[]): string = upload.status == "failed" ? upload.reason : uploadLive(upload, live).filter((each) => each.status == "failed").map((each) => each.reason).join("")
// Whether a tile's upload line or Retry shows, for the SnapShot details above them.
fn uploadShows(uploads: ComposerUploadImage[], live: ComposerUpload[]): string = uploads.map((upload) => uploadFailure(upload, live) != "" ? "failed" : uploadLabel(upload, live) != "" ? "uploading" : "").join("")

component UploadMeter
  props
    upload: ComposerUploadImage
    live: ComposerUpload[]
    name: string
    command: action
  view
    if uploadLabel(upload, live) != ""
      UploadLine(id=upload.id, label=uploadLabel(upload, live))
    if uploadFailure(upload, live) != ""
      button press=command("cclocal:upload-retry", upload.id, "", 0) aria-label=`Retry upload for ${name}` title=uploadFailure(upload, live) testId=`retry-upload-${upload.id}` position="absolute" left="0.25rem" bottom="0.25rem" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#000000b3" display="flex" align-items="center" justify-content="center"
        StashGlyph(name="refresh-cw", size=14, color="#ffffffa6")

// The upload's percentage along a tile's foot: bg-background/85, 10/14 text.
component UploadLine
  props
    id: string
    label: string
  view
    text label position="absolute" left=0 right=0 bottom=0 padding-left="0.25rem" padding-right="0.25rem" background-color="light-dark(#fcfcfcd9, #000000d9)" font-size="0.625rem" line-height="0.875rem" text-align="center" color="light-dark(#18181b, #f5f5f5)" pointer-events="none" font-variant-numeric="tabular-nums" testId=`upload-progress-${id}`

// The draft image's thumbnail as its "Preview <name>" button (ChatComposer's
// `image.previewUrl` button, cursor-zoom-in): a press opens the expanded preview
// over the draft's images, as the image's chip does.
component ImagePreviewButton
  props
    id: string
    name: string
    command: action
  view
    button press=command("editorlocal:chip-image-open", id, "", 0) aria-label=`Preview ${name}` testId=`preview-image-${id}` id=`preview-image-${id}` position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" cursor="zoom-in" title=""
      box hatch="t3-snapshot-tile" data-snapshot-id=id position="absolute" top=0 left=0 right=0 bottom=0 testId=`snapshot-thumbnail-${id}`
