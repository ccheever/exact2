// Video attachments on the composer's shelf and their expanded
// preview (ChatComposer composerVideos, ExpandedImageDialog's ExpandedVideo;
// T3 Code, MIT; see LICENSE-T3). composer-attachments.ts projects them.
use FocusGuard from "../shared/dialog-trap.contract"
use DialogOpenFocus from "../shared/dialog-trap.contract"
use PreviewPlayer from "../media/preview-player.contract"

shape ComposerVideo
  id: string
  name: string
  // The staged file as an app file (composer-attachments.ts stagedMediaSrc).
  src: string
shape ComposerVideoPreview
  open: bool
  id: string
  name: string
  // The video's display size (0 when unknown, then 16:9).
  width: number
  height: number
  // The staged file as an app file (composer-attachments.ts stagedMediaSrc).
  src: string

// A video on the shelf: a 64pt black square (border-border/80, rounded-lg)
// whose whole face is the "Play" button, its first frame (ComposerVideoThumbnail:
// the staged copy muted and paused, object-cover) under a bottom-up black
// gradient and a 16pt filled Play glyph, and the media-close Remove at its
// top-right corner.
component VideoDraftTile
  inject
    dialogOpener: action
  props
    video: ComposerVideo
    disabled: bool
    command: action
    // Where the focus goes when its focused Remove removes it (snapshot.contract draftFocusAfter).
    after: string
  state removeFocused = false
  // prepareVideoFirstFrame: once the duration is known, the paused thumbnail seeks to min(0.1 s, half the duration).
  state firstFrameAt = 0
  action durationKnown(seconds: number)
    if firstFrameAt == 0 and seconds > 0
      firstFrameAt = min(0.1, seconds / 2)
  action removeFocus(on: bool)
    removeFocused = on
  action removeNow
    command("editorlocal:shelf-video-remove", video.id, "", 0)
    if removeFocused
      focus(after)
  action play
    dialogOpener(`play-video-${video.id}`)
    command("editorlocal:shelf-video-play", video.id, "", 0)
  view
    column position="relative" width="4rem" height="4rem" flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff10)" background-color="#000000" testId=`video-draft-${video.id}`
      button press=play disabled=disabled aria-label=`Play ${video.name}` testId=`play-video-${video.id}` position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="column" align-items="center" justify-content="center" title="" id=`play-video-${video.id}`
        video src=video.src muted=true preload="metadata" currentTime=firstFrameAt durationchange=durationKnown object-fit="cover" position="absolute" top=0 left=0 width="100%" height="100%" pointer-events="none" aria-hidden=true testId=`video-thumbnail-${video.id}`
        box position="absolute" top=0 left=0 right=0 bottom=0 background-image="linear-gradient(to top, #000000b3, #0000001a 50%, #0000001a)" aria-hidden=true
        svg width="1rem" height="1rem" viewBox="0 0 24 24" position="relative" color="#ffffff" fill="currentColor" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
      row position="absolute" top="0.25rem" right="0.25rem"
        button press=removeNow focus=removeFocus(true) blur=removeFocus(false) disabled=disabled aria-label=`Remove ${video.name}` testId=`remove-video-${video.id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center" title=""
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="#ffffff" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M18 6 6 18M6 6l12 12"

// ExpandedImageDialog for a video (DialogPopup variant="media"): the window
// dimmed, the player (native controls, playing) at its natural size up to
// 92% of the window less 96pt and min(86vh, 100vh − 160pt) high, rounded-lg
// with a border-border/70 edge and shadow-2xl, its close button 40pt above
// the top-right corner and the name below it. Escape or the backdrop closes.
component VideoPreviewDialog
  inject
    dialogSeated: string[]
    dialogEntered: action
    dialogFallback: action
  props
    preview: ComposerVideoPreview
    windowWidth: number
    windowHeight: number
    command: action
  derive maxWidth = windowWidth * 0.92 - 96
  derive maxHeight = min(windowHeight * 0.86, windowHeight - 160)
  derive aspect = (preview.width > 0 and preview.height > 0) ? preview.width / preview.height : 16 / 9
  derive mediaWidth = max(64, min(preview.width > 0 ? preview.width : 640, min(maxWidth, maxHeight * aspect)))
  derive dialogTargets = ["video-preview-close", "video-preview-close"]
  // The staged copy plays or says nothing, as the reference's player does without an onError of its own.
  action unplayable(reason: string)
    let ignored = reason
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=45 align-items="center" justify-content="center" background-color="#000000bf" role="dialog" aria-modal=dialogSeated.includes("video-preview") aria-label="Expanded video preview" testId="video-preview" id="video-preview" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("video-preview") key=dialogFallback("video-preview", dialogTargets)
      // The focus trap (dialog-trap.contract): the X is the only Tab stop; the backdrop is none (the reference's popup takes its clicks).
      FocusGuard(guardId="video-preview-guard-start", targets=dialogTargets, popup="video-preview")
      DialogOpenFocus(target="video-preview-close")
      // The backdrop closes too, but is no item of the dialog: VoiceOver reads its three (the player, Close, the name).
      button press=command("editorlocal:shelf-video-close", "", "", 0) aria-label="Close video preview" aria-keyshortcuts="Escape" tabindex=-1 aria-hidden=true position="absolute" left=0 right=0 top=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="video-preview-backdrop" title=""
      column min-width=0 align-items="center"
        box position="relative" width=mediaWidth height=(mediaWidth / aspect) border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #ffffff0d)" box-shadow="0 25px 50px -12px #00000040" box-sizing="border-box" background-color="#000000"
          // MediaVideoPlayer: `<video controls autoplay>`, with Chromium's controls.
          box position="absolute" left=0 top=0 width="100%" height="100%"
            PreviewPlayer(src=preview.src, name=preview.name, width=mediaWidth - 2, height=mediaWidth / aspect - 2, maxWidth=mediaWidth, maxHeight=mediaWidth / aspect, radius="0.4375rem", playerId="video-preview-media", testId="video-preview-player", broke=unplayable, download=command("editorlocal:shelf-video-save", preview.id, "", 0))
          button id="video-preview-close" press=command("editorlocal:shelf-video-close", "", "", 0) aria-label="Close video preview" testId="video-preview-close" position="absolute" right=0 top="-2.5rem" width="1.5rem" height="1.5rem" padding=0 box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="#ffffff33" background-color="#000000a6" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
            svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="#ffffff" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
              path d="M18 6 6 18M6 6l12 12"
        text preview.name margin-top="0.5rem" max-width=maxWidth line-clamp=1 font-size="0.75rem" line-height="1rem" color="#ffffffcc"
      FocusGuard(guardId="video-preview-guard-end", targets=dialogTargets, popup="video-preview")
