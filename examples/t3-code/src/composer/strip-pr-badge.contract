// (MIT reference, see LICENSE-T3, upstream 9c161462c9): the composer context
// strip's pull request badge, ThreadPullRequestBadgeControl rendered as a ComposerControl
// size="xs" before the branch trigger (BranchToolbarBranchSelector, toolbar mode;
// strip-pr-badge.ts). The control is 24pt high, px-1.75 inside a 1pt transparent border,
// gap-1; the badge is the state glyph (size-3, [&_svg]:-mx-0.5) and the number in text-xs
// tabular-nums, both in the state's tone. A single pull request is a link to it; a stack or
// several links open the thread's Pull requests tab. The tooltip (side top, offset 0, glass,
// w-80, pointer-events-auto) is ThreadPullRequestsMiniList, or the one pull request: drawn on the
// window's hover layer (kind "pr-badge", StripPrTipCard), so its rows open their pull request and
// a long list scrolls inside the window's height.
use PgIcon from "../shared/pages-icons.contract"
use hoverTipAtFrame from "../shell/hover-layer.contract"

shape StripPrTip
  key: string
  number: string
  title: string
  icon: string
  state: string
  url: string
  target: string
  depth: number
  stack: string

fn stripMuted(): string = "light-dark(#71717b, #a1a1a1)"
// pages-pr-detail.contract prdTone, kept here: shapes.contract reaches this file, and the panel now reaches shapes.contract.
fn stripPrTone(lifecycle: string): string = lifecycle == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : lifecycle == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : lifecycle == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"
fn stripTone(lifecycle: string): string = lifecycle == "" ? stripMuted() : stripPrTone(lifecycle)

component StripPrBadge
  inject
    rem: number
    hoverTipAt: action
  props
    text: string
    icon: string
    tone: string
    label: string
    list: bool
    url: string
    target: string
    tips: StripPrTip[]
    disabled: bool
    command: action
  state over = false
  // The card's height for the layer's flip: its rows (24.5 pt each) and its insets.
  action hover(value: bool)
    over = value
    if tips.length > 0
      hoverTipAt(hoverTipAtFrame("composer-pr-badge", "pr-badge", "", [], "top", "center", frame("composer-pr-badge-box"), tips.length * 1.53125 * rem + 0.75 * rem, "composer-pr-tip"), "trigger", value)
  state middleDown = false
  action open(e: MouseEvent)
    command("chatlocal:surface-linked-pr-open", (e.metaKey or e.ctrlKey) ? "held" : target, url, 0)
  action down(e: PointerEvent)
    middleDown = e.buttons == 4
  action up(e: PointerEvent)
    let bounds = frame("composer-pr-link")
    if middleDown and e.clientX >= bounds.x and e.clientX <= bounds.x + bounds.width and e.clientY >= bounds.y and e.clientY <= bounds.y + bounds.height
      command("chatlocal:surface-linked-pr-open", "held", url, 0)
    middleDown = false
  view
    // Its laid-out width counts toward the context strip's label measurement (context-strip.ts).
    box id="composer-pr-badge-box" position="relative" flex-shrink=0 display="flex" hatch="t3-anchor" data-anchor="sc:pr"
      if list
        button press=command("chatlocal:surface-open", "pull-requests", "", 0) disabled=disabled border-width=0 hover=hover aria-label=label testId="composer-pr-badge" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
            PgIcon(name=icon, size=12, color=stripTone(tone))
          text text font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" white-space="nowrap" color=stripTone(tone)
      if not list and target != ""
        button id="composer-pr-link" press=open pointerdown=down pointerup=up disabled=disabled border-width=0 hover=hover aria-label=label testId="composer-pr-badge" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
            PgIcon(name=icon, size=12, color=stripTone(tone))
          text text font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" white-space="nowrap" color=stripTone(tone)
      if not list and target == ""
        link cursor="pointer" href=url text-decoration-line="none" hover=hover aria-label=label testId="composer-pr-badge" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
          box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
            PgIcon(name=icon, size=12, color=stripTone(tone))
          text text font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" white-space="nowrap" color=stripTone(tone)

// The badge's tooltip on the window's hover layer (TooltipPopup variant glass, w-80, py-1 px-2): ThreadPullRequestsMiniList's
// rows, each a link that opens its pull request (in the panel where a project reads it, else the browser; ⌘ or Ctrl
// the browser), the list held to the window's height (max-h-[calc(var(--available-height)-0.5rem-2px)]) and scrolling.
component StripPrTipCard
  inject
    rem: number
  props
    tips: StripPrTip[]
    maxHeight: number
    testId: string
    command: action
  view
    column width="20rem" padding-left="0.25rem" padding-right="0.25rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#ffffffeb, #121212eb)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" role="tooltip" testId=testId
      column width="100%" gap="0.25rem" max-height=`${max(0, maxHeight - 0.5 * rem - 2)}px` overflow-y="auto" overscroll-behavior="contain" testId="composer-pr-tip-list"
        for tip in tips key=tip.key
          StripPrTipRow(tip=tip, command=command)

component StripPrTipRow
  inject
    rem: number
  props
    tip: StripPrTip
    command: action
  state over = false
  action hover(value: bool)
    over = value
  action open(e: MouseEvent)
    command("chatlocal:surface-linked-pr-open", (e.metaKey or e.ctrlKey) ? "held" : tip.target, tip.url, 0)
  view
    button press=open hover=hover role="link" aria-label=`${tip.number} ${tip.title}` testId=`composer-pr-tip-${tip.number}` width="100%" min-width=0 flex-shrink=0 gap="0.5rem" align-items="center" display="flex" flex-direction="row" padding-left=((4 + tip.depth * 12) * rem / 16) padding-right="0.25rem" padding-top="0.25rem" padding-bottom="0.25rem" border-width=0 border-radius="0.25rem" height="1.53125rem" box-sizing="border-box" background-color=(over ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") cursor="pointer" title=""
      PgIcon(name=tip.icon, size=12, color=stripTone(tip.state))
      text tip.number flex-shrink=0 font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#18181b, #f5f5f5)"
      text tip.title flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color="light-dark(#18181bbf, #f5f5f5bf)"
      if tip.stack != ""
        text tip.stack flex-shrink=0 padding-left="0.25rem" font-size="0.625rem" line-height="0.875rem" color="light-dark(#18181b, #f5f5f5)"
