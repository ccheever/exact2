// ChildThreadApprovals at T3 Code 5d3d78ab93 (MIT; see LICENSE-T3), above the composer: one card per approval a subagent
// or side chat below this thread waits on (child-approvals.ts builds them). The list (mb-2, gap-2) scrolls past 20rem.
use ChildApprovalCard from "./composer-shapes.contract"
use TimelineApproval from "../timeline/timeline-approval.contract"
use ApprovalChoiceButton from "../timeline/timeline-approval.contract"
use ApprovalMore from "../timeline/timeline-approval.contract"

component ChildApprovals
  props
    cards: ChildApprovalCard[]
    busy: bool
    command: action
  view
    if cards.length > 0
      scroll width="100%" max-height="20rem" margin-bottom="0.5rem" testId="child-approvals"
        column width="100%" gap="0.5rem"
          for card in cards key=card.key
            ChildApproval(card=card, busy=busy, command=command)

// ChildApproval (rounded-lg border bg-background p-3 text-xs): "Approval needed from <child>", what it asks in the code
// font (at most 10rem, scrolling), the app, a dead process's warning, the reason and why full access still asked, the
// decisions inline (InlineButton, Approve in the foreground, the rest under More), and an inline error.
component ChildApproval
  props
    card: ChildApprovalCard
    busy: bool
    command: action
  derive blocked = busy or card.responding or not card.operable or not card.live
  action answer(op: string, id: string, decision: string, n: number)
    command("cc:child-approval", card.key, decision, 0)
  view
    column width="100%" padding="0.75rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #0a0a0a)" role="region" aria-label=`Approval from ${card.title}` testId=`child-approval-${card.requestId}`
      text `Approval needed from ${card.title}` margin-bottom="0.5rem" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
      scroll width="100%" max-height="10rem"
        text card.detail font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" user-select="text" color="light-dark(#18181b, #f5f5f5)"
      if card.appName != ""
        text card.appName margin-top="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
      if not card.live
        text "Provider process is gone. Interrupt or restart the child thread to respond." margin-top="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#e17100, #fe9a00)"
      if card.reason != ""
        text card.reason margin-top="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
      if card.whyAsked != ""
        text card.whyAsked margin-top="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
      row margin-top="0.5rem" flex-wrap="wrap" gap="0.5rem" align-items="center"
        for option in card.options key=option.id
          ApprovalChoiceButton(option=option, approvalId=`child-${card.requestId}`, disabled=blocked, choose=command("cc:child-approval", card.key, option.id, 0))
        if card.more.length > 0
          ApprovalMore(approval=TimelineApproval(id=`child-${card.requestId}`, icon="", label="", detailLabel="", detail=card.detail, appName=card.appName, reason=card.reason, live=card.live, operable=card.operable, responding=card.responding, whyAsked=card.whyAsked, options=card.options, more=card.more), command=answer, disabled=blocked)
      if card.error != ""
        text card.error role="alert" margin-top="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#e40014, #ff6467)"
