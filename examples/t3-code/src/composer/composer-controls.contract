      button -exact-menu="none" press=press hover=hover class=Control aria-label="More composer controls" aria-haspopup="menu" aria-expanded=open aria-keyshortcuts=keys testId="composer-more-controls" disabled=disabled opacity=(disabled ? 0.64 : 1) flex-shrink=0 height=(xs ? "1.5rem" : "1.75rem") padding-left=(xs ? "0.4375rem" : "0.5625rem") padding-right=(xs ? "0.4375rem" : "0.5625rem") padding-top=0 padding-bottom=0 border-radius="0.5rem" background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        svg width=(xs ? "0.75rem" : "1rem") height=(xs ? "0.75rem" : "1rem") viewBox="0 0 24 24" color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)") fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          circle cx=12 cy=12 r=1
          circle cx=19 cy=12 r=1
          circle cx=5 cy=12 r=1


// The 32pt send circle's glyph: arrow, queue (list-plus), steer (corner-up-right), resume (play) or a spinner while
// sending or connecting, in `ink`.
component SendGlyph
  props
    icon: string
    spinner: bool
    ink: string
  view
    if spinner
      box width="0.875rem" height="0.875rem" position="relative" display="flex" animation="ccSpin 1s linear infinite" aria-hidden=true
        CcIcon(name="loader", size=14, color=ink, weight=1.75)
    else
      if icon == "arrow"
        svg width="0.875rem" height="0.875rem" viewBox="0 0 14 14" fill="none" position="relative" aria-hidden=true
          path d="M7 11.5V2.5M7 2.5L3 6.5M7 2.5L11 6.5" stroke=ink stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
      else
        // While a turn runs, steer (CornerUpRight) and queue (ListPlus) morph into each
        // other (MorphIcon, f2cc80a7a4; morphicons' morph, shell-morph.contract).
        if icon == "list-plus" or icon == "corner-up-right"
          MorphQueueSteer(on=(icon == "list-plus"), size=16, color=ink, weight=2, still=false)
        else
          box position="relative" display="flex"
            CcIcon(name=icon, size=16, color=ink, weight=1.75)

// ChatComposer's Attach files (ghost icon-sm, 28pt): picked images join the shelf.
// ChatComposer's Attach files: the hidden file input's picker (app-main.contract ChatColumn, app.contract chooseAttachments).
component AttachButton
  inject
    chooseAttachments: action
  props
    disabled: bool
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      button press=chooseAttachments hover=hover disabled=disabled testId="attach-files" aria-label="Attach files" opacity=(disabled ? 0.64 : 1) width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
        CcIcon(name="paperclip", size=16, color="light-dark(#71717a, #a1a1a1)", weight=1.75)
      TipBubble(label="Attach files", side="top", align="center", offset=32, inset=0, shown=over)

// ComposerPrimaryActions outside a pending question: the plan follow-up pill,
// Stop, Resume thread, or Send with its running-turn variants. Send declares no
// chord: the reference resolves its send chords only in the composer's editor
// (composerSubmissionIntentForKey), which here is app.contract composerKeyEvent.
component PrimaryActions
  inject
    // ⌘ or Control held: Send shows the follow-up alternate.
    composerSendHeld: bool
    rem: number
  props
    data: Snapshot
    sendable: bool
    hasText: bool
    busy: bool
    tipShift: number
    send: action
    stop: action
    command: action
    openOptions: action
  state over = ""
  // The thread the hover began on. A control swapped out under the pointer (Send ↔ Stop) or a
  // keyboard thread switch leaves `over` set with no hover-out; its tooltip waits for the pointer to move again.
  state overThread = ""
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
    overThread = value ? data.threadId : overThread
  // Refine and Implement wait for the draft's uploads, as Send does (ComposerPrimaryActions' isSendDisabled).
  derive blocked = busy or not data.canSend or data.composer.uploadBlock != ""
  // A pointer press's modifiers ride with it (⌘-click is the follow-up alternate); a keyboard or shortcut press
  // holds none. A send chord typed in the composer carries its own (app.contract composerKeyEvent).
  action sendPress(e: MouseEvent)
    send(heldModifiers(e.metaKey, e.ctrlKey, e.altKey, e.shiftKey))
  view
    row gap="0.5rem" align-items="center" flex-shrink=0
      if data.composer.attach
        AttachButton(disabled=(busy or not data.connected))
      // ContextWindowMeter (Settings › Context window indicator): a usage ring
      // whose details open above it (a PopoverTrigger: `aria-haspopup="dialog"`).
      if data.composer.contextShow
        button press=openOptions("context") hover=hover("meter") id="context-window-meter" testId="context-window-meter" aria-label=data.composer.contextAria aria-haspopup="dialog" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over == "meter" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
          svg width="1.25rem" height="1.25rem" viewBox="0 0 24 24" rotate=-90 aria-hidden=true
            circle cx=12 cy=12 r=9.75 fill="none" stroke="light-dark(#71717a3d, #a1a1a13d)" stroke-width=3
            circle cx=12 cy=12 r=9.75 fill="none" stroke=(data.composer.contextOver ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717ab8, #a1a1a1b8)") stroke-width=3 stroke-linecap="round" stroke-dasharray=61.26 stroke-dashoffset=data.composer.contextOffset
      if data.composer.planReady and (hasText or not data.composer.canResume)
        if hasText
          button press=sendPress hover=hover("refine") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-refine" height="2rem" padding-left="1rem" padding-right="1rem" border-radius="1rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 background-color=(over == "refine" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)") box-shadow=(blocked ? "none" : "0 1px 2px 0 #1b4ed83d")
            text (busy ? "Sending..." : "Refine") font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff" white-space="nowrap"
        else
          row align-items="center" flex-shrink=0 id="implement-actions" testId="implement-actions"
            button press=command("send", "", "", 0) hover=hover("implement") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-implement" height="2rem" padding-left="1rem" padding-right="1rem" border-top-left-radius="1rem" border-bottom-left-radius="1rem" border-top-right-radius=0 border-bottom-right-radius=0 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over == "implement" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)")
              text (busy ? "Sending..." : "Implement") font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff" white-space="nowrap"
            button press=openOptions("implement") hover=hover("menu") disabled=blocked opacity=(blocked ? 0.64 : 1) testId="plan-implement-menu" aria-label="Implementation actions" height="2rem" padding-left="0.5rem" padding-right="0.5rem" border-top-right-radius="1rem" border-bottom-right-radius="1rem" border-top-left-radius=0 border-bottom-left-radius=0 border-left-width=1 border-top-width=0 border-right-width=0 border-bottom-width=0 border-style="solid" border-color="#ffffff33" display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(over == "menu" and not blocked ? "light-dark(#1d4ed8e6, #3b74f5)" : "light-dark(#1b4ed8, #346bf1)") title=""
              CcIcon(name="chevron-down", size=14, color="#ffffff", weight=1.75)
      else
        if data.canStop and not sendable and data.composer.queueEditing == ""
          StillRowTip(label="Interrupt", side="top", align="center", offset=36, shown=(over == "stop" and overThread == data.threadId), hover=hover("stop"))
            button press=stop disabled=busy testId="stop" aria-label="Stop generation" width="2rem" height="2rem" border-radius="1rem" background-color="light-dark(#fb2c36e6, #fc414ae6)" box-shadow="0 1px 2px 0 #fb2c363d, inset 0 1px 0 0 #ffffff29" border-width=0 display="flex" align-items="center" justify-content="center" flex-shrink=0 title=""
              svg width="0.75rem" height="0.75rem" viewBox="0 0 12 12" fill="#ffffff" aria-hidden=true
                rect x=2 y=2 width=8 height=8 rx=1.5
        else
          if data.composer.canResume and not sendable
            StillRowTip(label=(data.composer.sendStatus != "" ? data.composer.sendStatus : "Resume thread"), side="top", align="center", offset=36, shown=(over == "resume" and overThread == data.threadId), hover=hover("resume"))
              button press=command("cc:resume", "", "", 0) disabled=(blocked or data.composer.sendSpinner) opacity=(data.look.artwork and blocked ? 0.64 : 1) testId="resume-thread" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : "Resume thread") width="2rem" height="2rem" border-radius="1rem" overflow="hidden" border-width=0 padding=0 position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 background-color=sendFace(data.look.artwork, blocked, over == "resume") box-shadow=sendShadow(data.look.artwork, blocked) title=""
                if data.look.artwork
                  SendArt()
                SendGlyph(icon="play", spinner=data.composer.sendSpinner, ink=sendInk(data.look.artwork, blocked))
          else
            if data.composer.compactTokens != ""
              CompactChip(data=data, busy=busy, command=command)
            box position="relative" display="flex" flex-shrink=0 hover=hover("send")
              button press=sendPress id="send-message" testId="send-message" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : (sendable and data.composer.sendRunning) or data.composer.compactSend ? (composerSendHeld ? data.composer.sendHeldLabel : data.composer.sendLabel) : "Submit message") disabled=(busy or not sendable or data.composer.sendSpinner) opacity=(data.look.artwork and (busy or not sendable) ? 0.64 : 1) width="2rem" height="2rem" border-radius="1rem" overflow="hidden" border-width=0 padding=0 position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0 scale=(over == "send" and sendable and not busy and not data.composer.sendSpinner ? 1.05 : 1) transition="scale 150ms cubic-bezier(0.4, 0, 0.2, 1)" background-color=sendFace(data.look.artwork, busy or not sendable, over == "send") box-shadow=sendShadow(data.look.artwork, busy or not sendable) title=""
                if data.look.artwork
                  SendArt()
                SendGlyph(icon=(sendable ? (composerSendHeld ? data.composer.sendHeldIcon : data.composer.sendIcon) : "arrow"), spinner=data.composer.sendSpinner, ink=sendInk(data.look.artwork, busy or not sendable))
              TipBubble(label=data.composer.sendTooltip, side="top", align=(tipShift > 0 ? "end" : "center"), offset=36, inset=(tipShift > 0 ? data.composer.sendTipWidth / 2 - rem - tipShift : 0), shown=(over == "send" and overThread == data.threadId))

// ComposerPrimaryActions' Compact chip (h-7 rounded-(--control-radius) px-2 gap-1.5, medium text-sm
// foreground/80, a 16pt muted Minimize2, then the token count muted): "Compact 312k" while on (aria-pressed:
// accent/60 and the foreground), and the next send compacts first; "Keep 312k" while off, and the next send keeps
// the whole history.
component CompactChip
  props
    data: Snapshot
    busy: bool
    command: action
  state over = false
  state overThread = ""
  action hover(value: bool)
    over = value
    overThread = value ? data.threadId : overThread
  derive keep = data.composer.compactKeepFull
  derive label = (keep ? "Keep" : "Compact")
  view
    box position="relative" display="flex" flex-shrink=0 hover=hover hatch="t3-anchor" data-anchor=`compact:${label}:${data.composer.compactTokens}`
      button press=command("cclocal:compact-full", "", "", 0) disabled=busy testId="compact-chip" aria-label=`Compact ${data.composer.compactTokens} tokens of history before sending` aria-pressed=(not keep) height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.375rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(over and not busy ? "light-dark(#f4f4f5, #ffffff0a)" : not keep ? "light-dark(#f4f4f599, #ffffff06)" : "#00000000") opacity=(busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
        CcIcon(name="minimize", size=16, color="light-dark(#71717a, #a1a1a1)", weight=1.75)
        text label font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" font-variant-numeric="tabular-nums" color=(over or not keep ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bcc, #f5f5f5cc)")
        text data.composer.compactTokens font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)"
      TipBubble(label=data.composer.compactTip, side="top", align="center", offset=32, inset=0, shown=(over and overThread == data.threadId))

// The card's footer: toolbar triggers and the primary actions, or the resting
// single-line toolbar with its absolutely positioned send button. The controls
// row reports its width (t3-anchor "controls") so trailing labels compact
// before the model name (composerFooterLayout.ts).
component ComposerFooter
  inject
    // ⌘ or Control held: Send shows the follow-up alternate.
    composerSendHeld: bool
    frameMoved: action
    rem: number
    // Whether the composer's rest or expansion animates (cite-members.contract).
    restMotion: bool
  props
    data: Snapshot
    viewportWidth: number
    text: string
    resting: bool
    busy: bool
    narrow: bool
    keyModels: string
    modelsOpen: bool
    optionsOpen: string
    send: action
    stop: action
    openModels: action
    openOptions: action
    interaction: action
    command: action
    openProviders: action
  state sendOver = false
  state sendThread = "" // as PrimaryActions' overThread
  action sendHover(value: bool)
    sendOver = value
    sendThread = value ? data.threadId : sendThread
  action sendPress(e: MouseEvent) // as PrimaryActions' sendPress
    send(heldModifiers(e.metaKey, e.ctrlKey, e.altKey, e.shiftKey))
  derive sendable = data.canSend and data.composer.uploadBlock == "" and (text != "" or data.snapshotDrafts.length > 0)
  derive locked = busy or not data.connected
  // The send tooltip shifts left to stay 5pt inside the window (Base UI collision padding):
  // the button's centre is 32pt in from the toolbar's right edge (resting: 4pt).
  derive sendCenter = (resting ? data.composer.toolbarRight - 4 : data.composer.toolbarRight - 32)
  derive tipShift = (data.composer.toolbarRight > 0 ? max(0, sendCenter + data.composer.sendTipWidth / 2 - (viewportWidth - 5)) : 0)
  derive runtimeIcon = (resting ? data.composer.restingRuntimeIconOnly : data.composer.runtimeIconOnly)
  derive traitsIcon = (resting ? data.composer.restingTraitsIconOnly : data.composer.traitsIconOnly)
  // Trailing blocks in the overflow menu, and the whole cluster hidden.
  derive modeOut = (resting ? data.composer.restingModeOverflow : data.composer.modeOverflow)
  derive traitsOut = (resting ? data.composer.restingTraitsOverflow : data.composer.traitsOverflow)
  derive clusterHidden = (resting ? data.composer.restingControlsHidden : data.composer.controlsHidden)
  view
    row width=(resting ? `calc(100% - ${2.5 * rem}px)` : "100%") height=(resting ? "2rem" : "3rem") padding-left=(resting ? "0.875rem" : "1rem") padding-right=(resting ? "0.875rem" : "1rem") padding-bottom=(resting ? "0px" : "1rem") box-sizing="border-box" align-items="center" gap="0.5rem" position=(resting ? "absolute" : "relative") left=(resting ? "1.25rem" : "0px") top=(resting ? "3.125rem" : "0px") border-radius=(resting ? "1rem" : "0px") background-color=(resting ? "light-dark(#fafafa, #101010)" : "#00000000") animation=(not restMotion ? "none" : resting ? `ccRestIn ${data.look.panelMs}ms cubic-bezier(0.32, 0.72, 0, 1)` : `ccExpandIn ${data.look.panelMs / 2}ms ${data.look.panelMs / 2}ms cubic-bezier(0.32, 0.72, 0, 1) backwards`) id="frame-toolbar" resize=frameMoved testId="composer-toolbar"
      // The labels' natural widths (composer-label-probes.contract), read by footerLayout.
      TextProbes(probes=data.composer.menuProbes)
      ComposerLabelProbes(model=(data.composer.fanout ? data.composer.fanoutLabel : data.modelShortLabel == "" ? "Choose model" : data.modelShortLabel), traits=data.composer.traitsLabel, runtime=data.composer.runtimeLabel, plan=(data.composer.planVisible ? (data.composer.planActive ? "Plan" : "Build") : ""))
      // The model picker sits 8pt left of this row (-ms-2; resting 10pt); main's macOS hit test reaches a
      // child's visible overflow (652a6c865), so the part outside the row takes its press.
      row flex=1 min-width=0 gap="0px" align-items="center" height="2rem" box-sizing="border-box" hatch="t3-anchor" data-anchor="controls"
        if data.composer.noProvider != ""
          ProviderUnavailable(label=data.composer.noProvider, xs=resting, disabled=(data.composer.providerSetupId == ""), press=openProviders(data.composer.providerSetupId))
        else
          if not clusterHidden
            ModelTrigger(data=data, xs=resting, open=modelsOpen, label=(not resting or not narrow), keyModels=keyModels, disabled=locked, press=openModels)
            if data.composer.traitsLabel != "" and not traitsOut
              TraitsTrigger(label=data.composer.traitsLabel, iconOnly=traitsIcon, xs=resting, open=(optionsOpen == "effort"), disabled=locked, keyEffort=data.composer.keyEffort, press=openOptions("effort"))
            if not modeOut
              RuntimeTrigger(label=data.composer.runtimeLabel, tip=data.composer.runtimeDescription, icon=data.composer.runtimeIcon, iconOnly=runtimeIcon, xs=resting, open=(optionsOpen == "runtime"), disabled=locked, keyMode=data.composer.keyMode, press=openOptions("runtime"))
              if data.composer.planVisible
                PlanToggle(active=data.composer.planActive, xs=resting, iconOnly=runtimeIcon, disabled=locked, press=interaction(data.composer.planActive ? "default" : "plan"))
            if modeOut or traitsOut
              OverflowTrigger(xs=resting, open=(optionsOpen == "more"), disabled=locked, keys=(traitsOut ? `${data.composer.keyMode} ${data.composer.keyEffort}` : data.composer.keyMode), press=openOptions("more"))
      if not resting
        PrimaryActions(data=data, sendable=sendable, hasText=(text != ""), busy=busy, tipShift=tipShift, send=send, stop=stop, command=command, openOptions=openOptions)
    if resting
      // The Compact chip rides beside the resting send (the card reserves its width, composer.contract).
      if data.composer.compactTokens != "" and not (data.composer.canResume and not sendable) and data.composer.queueEditing == ""
        box position="absolute" right="3rem" top="0.5625rem" display="flex"
          CompactChip(data=data, busy=busy, command=command)
      box position="absolute" right="0.5rem" top="0.4375rem" width="2rem" height="2rem" display="flex" hover=sendHover
        button press=sendPress id="send-message" testId="send-message" aria-label=(data.composer.sendStatus != "" ? data.composer.sendStatus : data.composer.compactSend ? (composerSendHeld ? data.composer.sendHeldLabel : data.composer.sendLabel) : "Submit message") disabled=(busy or not sendable or data.running) opacity=(data.look.artwork and (busy or not sendable or data.running) ? 0.64 : 1) position="relative" width="2rem" height="2rem" border-radius="1rem" overflow="hidden" border-width=0 padding=0 display="flex" align-items="center" justify-content="center" background-color=sendFace(data.look.artwork, busy or not sendable or data.running, sendOver) box-shadow=sendShadow(data.look.artwork, busy or not sendable or data.running) title=""
          if data.look.artwork
            SendArt()
          SendGlyph(icon="arrow", spinner=data.composer.sendSpinner, ink=sendInk(data.look.artwork, busy or not sendable or data.running))
        TipBubble(label=data.composer.sendTooltip, side="top", align=(tipShift > 0 ? "end" : "center"), offset=36, inset=(tipShift > 0 ? data.composer.sendTipWidth / 2 - rem - tipShift : 0), shown=(sendOver and sendThread == data.threadId))

// The traits menu (MenuRadioItem rows: checked keep the foreground/8% wash,
// the highlighted row takes accent) and the runtime-mode select (SelectItem,
// selected wash wins), anchored above their trigger (side top, align start;
// end-aligned when start would overflow). Arrows move focus between rows and
// Enter/Space press the focused row; Escape is the dismiss layer's command.
// The opener focuses the menu (traits) or the selected option (runtime), as
// base-ui's Menu and Select do. Rows are inline so their key handler is this
// component's own action (a lifted action does not receive the key's name).
component ComposerMenus
  inject
    optionsAnchorX: number
    optionsAnchorWidth: number
    dialogMenuEntered: action
    rem: number
  props
    data: Snapshot
    session: number
    which: string
    left: number
    viewport: Viewport
    resting: bool
    close: action
    chooseTrait: action
    chooseRuntime: action
    command: action
    branches: ComposerBranches
    branchQuery: string
    searchBranches: action
    // chatLocal, for the Start from remote switch (it keeps the picker open).
    local: action
    // The root's command, for Copy branch name: `command` (menuCommand) closes the picker, which the reference's
    // context menu leaves open (BranchToolbarBranchSelector handleBranchContextMenu).
    rootCommand: action
  // Child state outlives the menu (it is the root's slots), so each opening
  // is a session: focus and hover from an earlier one never highlight a row.
  state focusIndex = -1
  state focusSession = -1
  state hoverIndex = -1
  state hoverSession = -1
  // The opener focuses the ref search, so a fresh session starts focused until it blurs.
  state searchFocused = false
  state searchSession = -1
  state workspaceFocus = ""
  state workspaceSession = -1
  // The ref a right-click is on, for BranchNameMenu's Copy branch name.
  state menuRef = ""
  action refMenu(name: string)
    menuRef = name
  derive workspaceCurrent = workspaceSession == session ? workspaceFocus : ""
  derive workspaceItems = branches.envOptions.map((option) => KmItem(id=`run-on-${option.id}`, label=option.label)).concat(branches.envAdd.length > 0 and branches.envOptions.length > 0 ? [KmItem(id="run-on-add", label="Add to another machine")] : []).concat(branches.gitless or branches.forceWorktree ? [] : [KmItem(id="workspace-local", label=(branches.envIcon == "folder-git-1" ? "Current worktree" : "Current checkout"))]).concat(branches.gitless ? [] : [KmItem(id="workspace-worktree", label="New worktree")]).concat(not branches.gitless and branches.previous ? [KmItem(id="workspace-previous", label="Previous worktree")] : [])
  derive searchActive = (searchSession == session ? searchFocused : true)
  derive active = (focusSession == session ? focusIndex : -1)
  derive hovered = (hoverSession == session ? hoverIndex : -1)
  derive count = (which == "more" ? (resting ? data.composer.restingMoreCount : data.composer.moreCount) : which == "effort" ? data.composer.traitsCount : which == "implement" ? 1 : which == "context" ? (data.composer.contextCompact ? 1 : 0) : which == "workspace" ? workspaceItems.length : which == "branch" ? branches.refs.length + (branches.creatable != "" ? 1 : 0) : data.composer.runtimeCount)
  // Content-sized menus take their measured widths (composer-menus.ts), within the window
  // (max-w calc(100vw - 2rem)); a previous worktree fixes the workspace menu at min(21rem, 100vw - 2rem).
  derive width = (which == "more" ? min(resting ? data.composer.restingMoreMenuWidth : data.composer.moreMenuWidth, viewport.width - 32) : which == "effort" ? min(data.composer.effortMenuWidth, viewport.width - 32) : which == "implement" ? 200 : which == "context" ? 256 : which == "workspace" ? (branches.previous ? min(336, viewport.width - 32) : branches.envOptions.length > 0 ? min(branches.envMenuWidth, viewport.width - 32) : (wideWorkspace ? 154 : 160)) : which == "branch" ? 320 : min(data.composer.runtimeMenuWidth, viewport.width - 32))
  derive strip = which == "workspace" or which == "branch"
  // A composer at least 768pt wide (its strip 44pt narrower) shows the workspace as the desktop
  // Select (BranchToolbarEnvModeSelector): a listbox 4pt below its trigger, as wide as its rows.
  // The non-Git strip's "Run on" is that Select at every width (SelectPopup side bottom, 4pt).
  derive wideWorkspace = which == "workspace" and (branches.gitless or data.composer.stripRight - data.composer.stripLeft >= 724)
  // Above the trigger (the flip, and the strip menus): 4pt over the toolbar's measured
  // window position, else the bottom-docked layout's fixed offsets.
  // MenuPopup / SelectPopup default to side="bottom" and flip above only when the window has no
  // room below: the draft hero's composer opens its traits, runtime and overflow menus 4pt under
  // the trigger (28pt, 2pt into the 32pt toolbar; resting 24pt at 4pt), a docked composer above.
  derive menuHeight = (which == "effort" ? data.composer.effortMenuHeight : which == "runtime" ? data.composer.runtimeMenuHeight : which == "more" ? (resting ? data.composer.restingMoreMenuHeight : data.composer.moreMenuHeight) : 0)
  derive belowTop = data.composer.toolbarTop + (resting ? 28 : 30) + 4
  derive below = menuHeight > 0 and data.composer.toolbarTop > 0 and belowTop + menuHeight + 5 <= viewport.height
  derive menuBottom = (strip ? viewport.height - (data.composer.stripTop + 4) + 4 : data.composer.toolbarTop > 0 ? viewport.height - data.composer.toolbarTop - (resting ? 4 : 2) + 4 : (resting ? 75 : 71))
  // The trigger's frame as the menu opened (app.contract openOptions): the implement menu and the meter's details
  // align to its end, the others to its start. Unmeasured, they open at the card's inner edge.
  derive actionsEnd = (optionsAnchorX >= 0 ? optionsAnchorX + optionsAnchorWidth : left + 1)
  derive anchor = (optionsAnchorX >= 0 ? optionsAnchorX : left + 17)
  derive anchorEnd = anchor + (optionsAnchorX >= 0 ? optionsAnchorWidth : 0)
  // The overflow menu's rows; an open menu goes when its trigger hides (CompactComposerControlsMenu hidden).
  derive moreRows = (resting ? data.composer.restingMore : data.composer.more)
  derive gone = which == "more" and count == 0
  action pickMore(descriptor: string, value: string)
    if descriptor == "__mode"
      command("interaction", "", value, 0)
    else
      if descriptor == "__runtime"
        chooseRuntime(value)
      else
        chooseTrait(descriptor, value)
  // The implementation menu and the meter's details align to their trigger's end (align end).
  derive x = (which == "workspace" ? data.composer.stripLeft + 5 : which == "branch" ? max(5, data.composer.stripRight - 9 - width) : which == "implement" or which == "context" ? max(5, actionsEnd - width) : anchor + width <= viewport.width - 5 ? anchor : max(5, anchorEnd - width))
  action mark(index: number, focused: bool)
    focusIndex = focused ? index : (active == index ? -1 : active)
    focusSession = session
  action searchFocus(value: bool)
    searchFocused = value
    searchSession = session
  action hover(index: number, over: bool)
    hoverIndex = over ? index : (hovered == index ? -1 : hovered)
    hoverSession = session
  // A row's key also bubbles to the menu (origin -1): only the menu's own
  // focus (no focused row) moves from there.
  action move(origin: number, name: string, e: KeyboardEvent)
    if which == "workspace"
      // Return presses the focused row (kmReturn), as its press does.
      if kmReturn(name, e) and workspaceItems.map((item) => item.id).includes(workspaceCurrent)
        preventDefault()
        stopPropagation()
        if not e.repeat
          if workspaceCurrent == "run-on-add"
            command("shelllocal:add-machine-open", "", "", 0)
          else if workspaceCurrent.startsWith("run-on-")
            command("environment-run-on", "", workspaceCurrent.slice(7), 0)
          else
            command("cclocal:env-mode", "", workspaceCurrent.slice(10), 0)
      else if not e.metaKey and not e.ctrlKey and not e.altKey
        match kmTarget(workspaceItems, workspaceCurrent, name)
          case some(item)
            preventDefault()
            stopPropagation()
            focus(item.id)
          case none
    else if count > 0 and (origin >= 0 or active < 0)
      if name == "ArrowDown"
        focus(`composer-menu-item-${(origin < 0 or origin + 1 >= count) ? 0 : origin + 1}`)
      if name == "ArrowUp"
        focus(`composer-menu-item-${origin <= 0 ? count - 1 : origin - 1}`)
      if name == "Home"
        focus("composer-menu-item-0")
      if name == "End"
        focus(`composer-menu-item-${count - 1}`)
  action workspaceHover(id: string, over: bool)
    // Another row takes the pointer from "Add to another machine": its submenu closes, as Base UI's does.
    if over and id != "run-on-add" and branches.envAdd.length > 0
      hidePopover("run-on-add-menu")
    if over and workspaceItems.map((item) => item.id).includes(id)
      focus(id)
    else if not over and workspaceCurrent == id
      focus("composer-menu")
  action menuEntered(e: FocusEvent)
    if which == "workspace"
      if workspaceItems.map((item) => item.id).includes(e.target) or e.target == "composer-menu"
        workspaceFocus = e.target == "composer-menu" ? "" : e.target
        workspaceSession = session
    else if which == "branch"
      dialogMenuEntered("composer-menu", "branch-selector", e)
  view
    if not gone
      // A button, so Escape binds as its command (a box with a shortcut is not one).
      button position="absolute" left=0 right=0 top=0 bottom=0 z-index=19 padding=0 border-width=0 border-radius=0 background-color="#00000000" press=close aria-label="Close options" aria-keyshortcuts="Escape" testId="dismiss-composer-options" title=""
      column position="absolute" left=x top=(wideWorkspace ? data.composer.stripTop + 33 * rem / 16 : (below ? belowTop : "auto")) bottom=(wideWorkspace or below ? "auto" : menuBottom) width=width border-radius="0.5rem" box-shadow="0 16px 40px -18px #0000008c" z-index=30
        // The meter's details are ContextWindowMeter's PopoverPopup, a dialog with no name
        // of its own ("Context Window, and 4 more items, dialog" under VoiceOver). As a `menu` the column was no element, so
        // AppKit ordered its items with the composer by position and VoiceOver read "Message" between the note and the bar.
        column id="composer-menu" data-dialog-return=(which == "branch" ? "menu" : "") focusin=menuEntered key=move(-1) width="100%" padding=(which == "branch" ? "0px" : "0.25rem") gap=0 border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#18181b1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-sizing="border-box" role=(which == "context" ? "dialog" : which == "runtime" or which == "branch" or wideWorkspace ? "listbox" : "menu") aria-label=(which == "context" ? "" : which == "more" ? "More composer controls" : which == "effort" ? data.composer.traitsLabel : which == "implement" ? "Implementation actions" : which == "workspace" ? "Workspace" : which == "branch" ? "Refs" : "Runtime mode") testId="composer-options"
          if which == "workspace"
            // MobileRunContextSelector's "Run on" group, then a separator, when a draft can move machines.
            if branches.envOptions.length > 0
              text "Run on" font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" color="light-dark(#71717a, #a1a1a1)"
              for option in branches.envOptions key=option.id
                button id=`run-on-${option.id}` press=command("environment-run-on", "", option.id, 0) hover=workspaceHover(`run-on-${option.id}`) role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=option.selected aria-selected=option.selected testId=`run-on-${option.id}` class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.375rem" border-radius="0.25rem" background-color=(workspaceCurrent == `run-on-${option.id}` ? "light-dark(#f4f4f5, #ffffff0a)" : option.selected ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
                  box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
                    CnMachineIcon(kind=option.machine, size=12, color="light-dark(#18181b, #f5f5f5)")
                  text option.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
              if branches.envAdd.length > 0
                RunOnAddRow(branches=branches, select=wideWorkspace, current=(workspaceCurrent == "run-on-add"), hover=workspaceHover("run-on-add"), command=command)
              if not branches.gitless
                box height=1 margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)"
            if not branches.gitless
              text "Workspace" font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom=(wideWorkspace ? "0.375rem" : "0.25rem") color="light-dark(#71717a, #a1a1a1)"
              button press=command("cclocal:env-mode", "", "local", 0) disabled=branches.forceWorktree opacity=(branches.forceWorktree ? 0.64 : 1) hover=workspaceHover("workspace-local") id="workspace-local" role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=(branches.envMode == "local") aria-selected=(branches.envMode == "local") testId="workspace-local" class=Control justify-content="flex-start" width="100%" min-height=(wideWorkspace ? "1.8125rem" : "1.75rem") padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.375rem" border-radius="0.25rem" background-color=(workspaceCurrent == "workspace-local" ? "light-dark(#f4f4f5, #ffffff0a)" : branches.envMode == "local" ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
                box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
                  CcIcon(name=(branches.envIcon == "folder-git-1" ? "folder-git-1" : "folder"), size=12, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
                text (branches.envIcon == "folder-git-1" ? "Current worktree" : "Current checkout") font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
              button press=command("cclocal:env-mode", "", "worktree", 0) hover=workspaceHover("workspace-worktree") id="workspace-worktree" role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=(branches.envMode == "worktree") aria-selected=(branches.envMode == "worktree") testId="workspace-worktree" class=Control justify-content="flex-start" width="100%" min-height=(wideWorkspace ? "1.8125rem" : "1.75rem") padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.375rem" border-radius="0.25rem" background-color=(workspaceCurrent == "workspace-worktree" ? "light-dark(#f4f4f5, #ffffff0a)" : branches.envMode == "worktree" ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
                box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
                  CcIcon(name="folder-git", size=12, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
                text "New worktree" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
              if branches.previous
                button press=command("cclocal:env-mode", "", "previous", 0) hover=workspaceHover("workspace-previous") id="workspace-previous" role=(wideWorkspace ? "option" : "menuitemradio") aria-checked=false aria-selected=false testId="workspace-previous" class=Control justify-content="flex-start" align-items="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.375rem" border-radius="0.25rem" background-color=(workspaceCurrent == "workspace-previous" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                  box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem" margin-top="0.25rem"
                    CcIcon(name="history", size=12, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
                  column min-width=0 flex=1 align-items="flex-start"
                    text "Previous worktree" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
                    if branches.previousBranch != ""
                      text branches.previousBranch font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" line-clamp=1 min-width=0 max-width="100%"
          if which == "branch"
            // BranchPicker: ComboboxSearchInput (px-3 pt-2.5, underline that turns
            // primary on focus), the virtualized list (max-h-56, ps-1 py-2 inside the list's p-1,
            // stable gutter) whose first item is auto-highlighted, then the status.
            column width="100%" gap=0 testId="branch-picker"
              BranchNameMenu(menuId="branch-ref-menu", name=menuRef, command=rootCommand)
              column width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.625rem" box-sizing="border-box" flex-shrink=0
                row height="2.0625rem" padding-bottom="0.375rem" box-sizing="border-box" position="relative" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color=(searchActive ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#e4e4e7b3, #ffffff0e)")
                  box position="absolute" left=0 top="0.375rem" display="flex"
                    CcIcon(name="search", size=16, color="light-dark(#71717a8c, #a1a1a18c)", weight=1.75)
                  if branchQuery == ""
                    text "Search refs..." position="absolute" left="1.25rem" top=0 font-size="0.875rem" line-height="1.625rem" color="light-dark(#71717a, #a1a1a1)" aria-hidden=true
                  input id="branch-search" value=branchQuery input=searchBranches submit=command(branches.enterOp, "", branches.enterValue, 0) focus=searchFocus(true) blur=searchFocus(false) aria-label="Search refs" testId="branch-search" flex=1 min-width=0 height="1.625rem" padding-left="1.25rem" padding-right="0.5625rem" padding-top=0 padding-bottom=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color="light-dark(#18181b, #f5f5f5)" autocorrect="off" spellcheck="false" data-editable="yes"
              RefPageScroll(name="strip-refs")
                column width="100%" gap=0 padding-left="0.5rem" padding-right="0.625rem" padding-top="0.75rem" padding-bottom="0.75rem" box-sizing="border-box"
                  // A local draft's pull request reference leads (pr-checkout.ts).
                  for item in branches.checkout key=item.reference
                    button press=command("chatlocal:git-pr-open", "", item.reference, 0) hover=hover(0) testId="branch-checkout-pr" role="option" aria-selected=false class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.25rem" background-color=(hovered <= 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") id="branch-checkout-pr"
                      row min-width=0 gap="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" align-items="center"
                        ExtraGlyph(name=item.mark, size=14, color="light-dark(#71717b, #a1a1a1)")
                        column min-width=0 align-items="flex-start"
                          text item.title font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)" line-clamp=1 text-align="left"
                          text item.reference font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" line-clamp=1 text-align="left"
                  for ref in branches.refs key=ref.name
                    button press=command("cc:branch", "", ref.name, 0) contextmenu=refMenu(ref.name) contextPopover="branch-ref-menu" hover=hover(ref.index) testId=`branch-${ref.name}` role="option" aria-selected=ref.selected class=Control justify-content="space-between" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.5rem" border-radius="0.25rem" background-color=(hovered == ref.index or (hovered < 0 and ref.index == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                      text ref.name font-size="0.875rem" line-height="1.25rem" color=(hovered == ref.index or (hovered < 0 and ref.index == 0) ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181b, #f5f5f5)") line-clamp=1 min-width=0 flex=1 text-align="left"
                      if ref.badge != ""
                        text ref.badge font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717a73, #a1a1a173)" flex-shrink=0
                  if branches.creatable != ""
                    button press=command("cc:branch-create", "", branches.creatable, 0) hover=hover(branches.refs.length + branches.checkout.length) testId="branch-create" class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.25rem" background-color=(hovered == branches.refs.length + branches.checkout.length or (hovered < 0 and branches.refs.length + branches.checkout.length == 0) ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                      text `Create new ref "${branches.creatable}"` font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1
                  if branches.refs.length == 0 and branches.creatable == "" and branches.checkout.length == 0
                    text (branches.loading ? "Loading refs..." : "No refs found.") font-size="0.875rem" line-height="1.25rem" padding="0.5rem" text-align="center" color="light-dark(#71717a, #a1a1a1)"
              // BranchPicker's originControl while choosing a new worktree's base.
              if branches.originShown
                button press=local("git-origin", "", "") role="switch" aria-checked=branches.originOn aria-label="Start worktree from remote" testId="branch-origin" width="100%" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.75rem" border-width=0 border-top-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="space-between"
                  row min-width=0 gap="0.375rem" align-items="center"
                    ExtraGlyph(name="refresh-cw", size=12, color="light-dark(#71717a, #a1a1a1)")
                    text "Start from remote" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #a1a1a1)" white-space="nowrap"
                  row width="1.625rem" height="1rem" padding="0.125rem" box-sizing="border-box" border-radius="0.5rem" flex-shrink=0 align-items="center" justify-content=(branches.originOn ? "flex-end" : "flex-start") background-color=(branches.originOn ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff1c)") aria-hidden=true
                    box width="0.75rem" height="0.75rem" border-radius="0.25rem" background-color="light-dark(#ffffff, #000000)" box-shadow="0 1px 2px #0000000d"
              if branches.status != ""
                text branches.status font-size="0.75rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717a, #a1a1a1)" role="status"
          if which == "context"
            // ContextWindowMeter's PopoverPopup is tooltipStyle: its `text-balance` reaches every line.
            column width="100%" padding="0.5rem" gap="0.5rem" box-sizing="border-box" text-wrap="balance" testId="context-window-details"
              row width="100%" gap="0.75rem" align-items="center" justify-content="space-between"
                text "Context Window" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #a1a1a1)"
                text (data.composer.contextPercent != "" ? `${data.composer.contextPercent} · ${data.composer.contextUsed}/${data.composer.contextMax}` : data.composer.contextUsed) font-size="0.6875rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
              if data.composer.contextMax != ""
                // ContextWindowMeter's bar: a drawn `role="progressbar"` with ARIA's range values (LLP 1116 D8), on macOS one
                // progress indicator element saying its value, minimum and maximum; the fill inside is presentational.
                box width="100%" height="0.375rem" border-radius="0.1875rem" overflow="hidden" background-color="light-dark(#f4f4f599, #ffffff0f)" role="progressbar" aria-valuemin=0 aria-valuemax=100 aria-valuenow=data.composer.contextValueNow aria-label="Context window usage" testId="context-window-bar"
                  box height="0.375rem" border-radius="0.1875rem" width=`${data.composer.contextPercent == "" ? "0%" : data.composer.contextPercent}` background-color=(data.composer.contextOver ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717ab8, #a1a1a1b8)")
              if data.composer.contextTotal != ""
                row width="100%" justify-content="space-between"
                  text "Total processed" font-size="0.6875rem" line-height="1rem" color="light-dark(#52525b, #a1a1aa)"
                  text data.composer.contextTotal font-size="0.6875rem" font-weight=500 line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
              if data.composer.contextCost != ""
                row width="100%" justify-content="space-between"
                  text "Cost" font-size="0.6875rem" line-height="1rem" color="light-dark(#52525b, #a1a1aa)"
                  text data.composer.contextCost font-size="0.6875rem" font-weight=500 line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#52525b, #a1a1aa)"
              if data.composer.contextNote != ""
                text data.composer.contextNote font-size="0.6875rem" font-weight=500 line-height="1rem" margin-top="0.25rem" color="light-dark(#52525b, #a1a1aa)"
              if data.composer.contextCompact
                button press=command("cc:compact", "", "", 0) hover=hover(0) focus=mark(0, true) blur=mark(0, false) key=move(0) id="composer-menu-item-0" testId="compact-context" margin-top="0.25rem" width="100%" height="1.5rem" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color=(hovered == 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "light-dark(#ffffff, #ffffff08)") display="flex" flex-direction="row" align-items="center" justify-content="center"
                  CcIcon(name="minimize", size=14, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
                  text "Compact context" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
          if which == "implement"
            button press=command("cc:implement-new", "", "", 0) hover=hover(0) focus=mark(0, true) blur=mark(0, false) key=move(0) id="composer-menu-item-0" role="menuitem" testId="implement-new-thread" class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap=0 border-radius="0.25rem" background-color=(active == 0 or hovered == 0 ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              text "Implement in a new thread" font-size="0.875rem" line-height="1.25rem" font-weight=400 color=(active == 0 or hovered == 0 ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181b, #f5f5f5)") white-space="nowrap"
          if which == "more"
            for item in moreRows key=item.key
              if item.kind == "header"
                text item.label font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" color="light-dark(#71717a, #a1a1a1)"
              if item.kind == "divider"
                box height=1 margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)"
              if item.kind == "note"
                text item.label font-size="0.75rem" line-height="1rem" max-width="14rem" padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.375rem" color="light-dark(#71717acc, #a1a1a1cc)"
              if item.kind == "option"
                button press=pickMore(item.descriptor, item.value) disabled=item.disabled opacity=(item.disabled ? 0.64 : 1) hover=hover(item.index) focus=mark(item.index, true) blur=mark(item.index, false) key=move(item.index) id=`composer-menu-item-${item.index}` role="menuitemradio" aria-checked=item.selected testId=`more-${item.descriptor}-${item.value}` class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap=0 border-radius="0.25rem" background-color=(active == item.index or hovered == item.index ? "light-dark(#f4f4f5, #ffffff0a)" : item.selected ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
                  text item.label font-size="0.875rem" line-height="1.25rem" font-weight=400 color=(active == item.index or hovered == item.index ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181b, #f5f5f5)") line-clamp=1 min-width=0
          if which == "effort"
            for item in data.composer.traits key=item.key
              if item.kind == "header"
                text item.label font-size="0.75rem" font-weight=500 line-height="1rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.25rem" color="light-dark(#71717a, #a1a1a1)"
              if item.kind == "divider"
                box height=1 margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff14)"
              // "ultrathink" in the prompt's body keeps the primary effort's rows visible but inert.
              if item.kind == "note"
                text item.label font-size="0.75rem" line-height="1rem" max-width="14rem" padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.375rem" color="light-dark(#71717acc, #a1a1a1cc)" testId="effort-ultrathink-note"
              if item.kind == "option"
                button press=chooseTrait(item.descriptor, item.value) disabled=item.disabled opacity=(item.disabled ? 0.64 : 1) hover=hover(item.index) focus=mark(item.index, true) blur=mark(item.index, false) key=move(item.index) id=`composer-menu-item-${item.index}` role="menuitemradio" aria-checked=item.selected testId=`effort-${item.value}` class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap=0 border-radius="0.25rem" background-color=(active == item.index or hovered == item.index ? "light-dark(#f4f4f5, #ffffff0a)" : item.selected ? "light-dark(#18181b14, #f5f5f514)" : "#00000000")
                  column flex=1 min-width=0 align-items="flex-start"
                    row min-width=0 max-width="100%" align-items="center"
                      text item.label font-size="0.875rem" line-height="1.25rem" font-weight=400 color=(active == item.index or hovered == item.index ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181b, #f5f5f5)") line-clamp=1 min-width=0
                      if item.isDefault
                        box width="0.25rem" flex-shrink=0
                        text "Default" font-size="0.625rem" font-weight=500 line-height="0.875rem" padding-left="0.1875rem" padding-right="0.1875rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff1c)" border-radius="0.25rem" background-color="light-dark(#fcfcfc, #ffffff07)" color="light-dark(#18181b, #f5f5f5)" flex-shrink=0
                    if item.description != ""
                      text item.description font-size="0.75rem" line-height="1rem" max-width="14rem" color="light-dark(#71717acc, #a1a1a1cc)" text-align="left"
          if which == "runtime"
            for option in data.composer.runtimes key=option.mode
              button press=chooseRuntime(option.mode) hover=hover(option.index) focus=mark(option.index, true) blur=mark(option.index, false) key=move(option.index) id=`composer-menu-item-${option.index}` role="option" aria-selected=option.selected testId=`mode-${option.mode}` class=Control width="100%" min-height="2.875rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.25rem" justify-content="flex-start" align-items="flex-start" background-color=(option.selected ? "light-dark(#18181b14, #f5f5f514)" : active == option.index or hovered == option.index ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                column gap="0.125rem" min-width=0 flex=1 align-items="flex-start"
                  row gap="0.375rem" align-items="center"
                    CcIcon(name=option.icon, size=14, color="light-dark(#71717a, #a1a1a1)", weight=1.75)
                    text option.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
                  text option.description font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #a1a1a1)" white-space="nowrap"

// ── The context strip under the draft composer ──────────────────────────────

// BranchToolbar: the workspace mode at the start, the branch at the end, on
// the drawer that hangs 32pt under the card (px-2 py-1, rounded-b-2xl).
component StripControl
  props
    icon: string
    label: string
    testId: string
    aria: string
    open: bool
    disabled: bool
    press: action
    context: action
    // The context popover a right-click opens ("" for none).
    menu: string
    // The workspace label's tooltip, on the folder glyph in the compact strip
    // (MobileRunContextSelector) and on the whole Select trigger in the wide one (@3xl),
    // which names the control's shortcut too.
    tip: string
    tipIcon: bool
    // The machine the draft runs on, beside the workspace glyph ("" for none).
    machine: string
    // The strip's labels gave way to icons (useLabelsOverflow); `anchor` names the control and its label
    // for that measurement (`sc:` and `sl:`, context-strip.ts).
    compact: bool
    anchor: string
  state over = false
  state iconOver = false
  action hover(value: bool)
    over = value
  action hoverIcon(value: bool)
    iconOver = value
  view
    // A 1pt transparent border inside px-1.75; glyphs take -0.5 inline margins ([&_svg]:-mx-0.5).
    button press=press contextmenu=context contextPopover=menu hover=hover disabled=disabled testId=testId aria-label=aria aria-expanded=open hatch="t3-anchor" data-anchor=`sc:${anchor}` title="" min-width=0 max-width="17.5rem" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=1 position="relative"
      if machine != ""
        // showEnvironmentIndicator: the machine and the workspace glyphs 2pt apart, without the -mx-0.5.
        row gap="0.125rem" flex-shrink=0 align-items="center"
          CnMachineIcon(kind=machine, size=12, color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bb3, #a1a1a1)"))
          if icon != ""
            CcIcon(name=icon, size=12, color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bb3, #a1a1a1)"), weight=1.75)
      else
        box hover=hoverIcon display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem" position="relative"
          CcIcon(name=icon, size=12, color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bb3, #a1a1a1)"), weight=1.75)
          if tip != "" and tipIcon
            TipBubble(label=tip, side="top", align="center", offset=16, inset=0, shown=(iconOver and not open))
      if tip != "" and not tipIcon
        TipBubble(label=tip, side="top", align="center", offset=28, inset=0, shown=(over and not open))
      if not compact
        text label font-size="0.75rem" line-height="1rem" color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bb3, #a1a1a1)") line-clamp=1 min-width=0 max-width="15rem" hatch="t3-anchor" data-anchor=`sl:${anchor}`
      box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
        CcIcon(name="chevron-down", size=12, color=(over or open ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#18181bb3, #a1a1a1)"), weight=1.75)

// "Add to another machine" under the Run on rows, muted until highlighted (ADD_TO_MACHINE_LABEL_CLASS). In the
// menu (MobileRunContextSelector) it is a MenuSubTrigger whose MenuSubPopup lists the machines
// (add-project-machine.contract AddMachineSubmenu); in the Select (BranchToolbarEnvironmentSelector, the wide and
// non-Git strips) one item that opens the dialog on the first machine.
component RunOnAddRow
  props
    branches: ComposerBranches
    select: bool
    current: bool
    hover: action
    command: action
  action addTo(id: string)
    command("shelllocal:add-machine-open", "", id, 0)
  view
    if select
      button id="run-on-add" press=command("shelllocal:add-machine-open", "", "", 0) hover=hover role="option" aria-selected=false testId="run-on-add" class=Control justify-content="flex-start" width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.375rem" border-radius="0.25rem" background-color=(current ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
        row flex=1 min-width=0 gap="0.375rem" align-items="center" opacity=(current ? 1 : 0.55)
          box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
            CcIcon(name="plus", size=12, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
          text "Add to another machine" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap" min-width=0
    else
      AddMachineSubmenu(rowId="run-on-add", targets=branches.envAdd, width=branches.envAddMenuWidth, choose=addTo)

component ComposerStrip
  inject
    frameMoved: action
  props
    strip: ComposerBranches
    open: string
    busy: bool
    openOptions: action
    command: action
    // The composer is at least 768pt wide (@3xl/composer-surface): the workspace
    // control is the desktop Select (BranchToolbarEnvModeSelector) instead of the compact menu.
    wide: bool
    // The labels do not fit: the controls show their icons only (data-compact).
    compact: bool
  view
    // px-2 inside the drawer's pseudo-element border, even at both edges: the drawn 1pt border eats a point of each.
    // It carries the card's surface (ContextStrip's glass surface; dark, the seam's 10pt shade under the card).
    row margin-left="1.375rem" margin-right="1.375rem" padding-left="0.4375rem" padding-right="0.4375rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.25rem" box-sizing="border-box" align-items="center" border-bottom-left-radius="1rem" border-bottom-right-radius="1rem" border-style="solid" border-top-width=0 border-left-width=1 border-right-width=1 border-bottom-width=1 border-color="light-dark(#00000014, #ffffff12)" background-color="light-dark(#ffffff, #111111)" background-image="linear-gradient(to bottom, light-dark(#00000000, #0000002e), #00000000 10px)" id="frame-strip" resize=frameMoved testId="composer-context-strip"
      if strip.gitless
        // A non-Git project offers only where it runs (BranchToolbarEnvironmentSelector): the
        // "Run on" Select for a draft, the static machine row (h-6 px-1.75 gap-1, text-xs /70) for a started thread.
        if strip.envLocked
          row height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" align-items="center" min-width=0 max-width="100%" testId="run-on-locked" aria-label=strip.envMachineLabel hatch="t3-anchor" data-anchor="sc:locked"
            CnMachineIcon(kind=strip.envMachine, size=12, color="light-dark(#18181bb3, #a1a1a1)")
            if not compact
              text strip.envMachineLabel font-size="0.75rem" line-height="1rem" color="light-dark(#18181bb3, #a1a1a1)" line-clamp=1 hatch="t3-anchor" data-anchor="sl:locked"
        else
          StripControl(icon="", label=strip.envMachineLabel, testId="workspace-mode", aria="Run on", open=(open == "workspace"), disabled=busy, press=openOptions("workspace"), context=command("cclocal:noop", "", "", 0), menu="", tip=(strip.keyHost == "" ? strip.envMachineLabel : `${strip.envMachineLabel} · ${strip.keyHost}`), tipIcon=false, machine=strip.envMachine, compact=compact, anchor="workspace")
        box flex=1 min-width=0
      else
        if strip.envLocked
          row height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" align-items="center" min-width=0 max-width="48%" testId="workspace-locked" hatch="t3-anchor" data-anchor="sc:locked"
            box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
              CcIcon(name=strip.envIcon, size=12, color="light-dark(#18181bb3, #a1a1a1)", weight=1.75)
            if not compact
              text strip.envLabel font-size="0.75rem" line-height="1rem" color="light-dark(#18181bb3, #a1a1a1)" line-clamp=1 hatch="t3-anchor" data-anchor="sl:locked"
        else
          StripControl(icon=strip.envIcon, label=(strip.envShow ? strip.envMachineLabel : strip.envLabel), testId="workspace-mode", aria=(wide ? "Workspace" : `Workspace: ${strip.envLabel}`), open=(open == "workspace"), disabled=busy, press=openOptions("workspace"), context=command("cclocal:noop", "", "", 0), menu="", tip=(wide and strip.keyWorkspace != "" ? `${strip.envLabel} · ${strip.keyWorkspace}` : strip.envLabel), tipIcon=(not wide), machine=(strip.envShow ? strip.envMachine : ""), compact=compact, anchor="workspace")
        box flex=1 min-width=0
        if strip.prShow
          StripPrBadge(text=strip.prText, icon=strip.prIcon, tone=strip.prState, label=strip.prLabel, list=strip.prList, url=strip.prUrl, target=strip.prTarget, tips=strip.prTips, disabled=busy, command=command)
        BranchNameMenu(menuId="branch-name-menu", name=strip.branch, command=command)
        StripControl(icon="git-branch", label=strip.branchLabel, testId="branch-selector", aria=`Branch: ${strip.branchLabel}`, open=(open == "branch"), disabled=busy, press=openOptions("branch"), context=command("cclocal:noop", "", "", 0), menu=(strip.branch == "" ? "" : "branch-name-menu"), tip="", tipIcon=false, machine="", compact=compact, anchor="branch")

// BranchToolbarBranchSelector handleBranchContextMenu (74541bab17): right-clicking the branch trigger or a ref offers
// "Copy branch name" (api.contextMenu.show, a native menu at the pointer), copied with a toast (composer-controls-branch.ts
// copyBranchName). The trigger and the open picker's rows name it as their `contextPopover`, which macOS presents as an
// NSMenu at the pointer; a row's menu opens over the picker, which stays open.
component BranchNameMenu
  props
    menuId: string
    name: string
    command: action
  view
    box position="absolute" left=0 top=0 width=0 height=0
      column id=menuId popover="auto" position-try-fallbacks="none" role="menu" width="12rem" padding="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 16px 40px -18px #0000008c" testId=menuId
        button press=command("cclocal:branch-copy", "", name, 0) popovertarget=menuId popovertargetaction="hide" role="menuitem" disabled=(name == "") testId=`${menuId}-copy` display="flex" flex-direction="row" align-items="center" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.25rem" background-color="#00000000"
          text "Copy branch name" flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)"

// ── The dock above the card ─────────────────────────────────────────────────

// ComposerBanner.Root "comfortable", attached: its last 17pt tucks under the next surface, and a card after another
// joins it (`stacked`: no top border or corners). It fades in over 150 ms and, dismissed, goes at once. Only an
// error or a warning is an alert.
// The title row (ComposerBanner.Row "wrap-actions"): the actions share it while the title fits and wrap
// below it otherwise; the content keeps beside the icon, so a long title truncates instead of wrapping.
// The last action's outer corner follows the banner's curve (2xl less the 1 spacing inset).
component NoticeRow
  inject
    rem: number
  props
    notice: ComposerNotice
    attached: bool
    stacked: bool
    busy: bool
    command: action
    still: bool
    dismiss: action
  state over = ""
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
  derive last = (notice.dismiss != "" ? "dismiss" : notice.action2 != "" ? "action2" : "action")
  derive lowerCorner = (not attached and notice.lines.length == 0 and notice.usage.length == 0 ? "0.75rem" : "0.5rem")
  view
    column animation=(still ? "none" : "ccFadeIn 150ms ease-out") margin-left=(attached ? "1.375rem" : "0px") margin-right=(attached ? "1.375rem" : "0px") margin-bottom=(attached ? "-1.0625rem" : "0px") padding-left="0.1875rem" padding-right="0.1875rem" padding-top="0.3125rem" padding-bottom=(attached ? "1.375rem" : "0.3125rem") box-sizing="border-box" border-top-left-radius=(stacked ? "0px" : "1rem") border-top-right-radius=(stacked ? "0px" : "1rem") border-bottom-left-radius=(attached ? "0px" : "1rem") border-bottom-right-radius=(attached ? "0px" : "1rem") border-style="solid" border-top-width=(stacked ? 0 : 1) border-left-width=1 border-right-width=1 border-bottom-width=(attached ? 0 : 1) border-color=(notice.variant == "warning" ? "light-dark(#fe9a0047, #fe9a0047)" : notice.variant == "error" ? "light-dark(#fb2c3652, #fb414a52)" : "light-dark(#00000014, #ffffff0d)") background-color=(notice.variant == "warning" ? "light-dark(#fef6eacc, #231b0fcc)" : notice.variant == "error" ? "light-dark(#feededcc, #231415cc)" : "light-dark(#ffffffcc, #121212cc)") box-shadow="0 1px 2px #0000000d" role=(notice.variant == "error" or notice.variant == "warning" ? "alert" : "") testId=`notice-${notice.id}`
      row width="100%" column-gap="0.25rem" align-items="center" flex-wrap="wrap" testId=`notice-row-${notice.id}`
        row width="1.5rem" height="1.5rem" align-items="center" justify-content="center" flex-shrink=0 align-self="flex-start"
          // ComposerServerUpdateIcon: static, since the title says an update runs and a spinner repaints every frame.
          CcIcon(name=(notice.icon == "spinner" ? "download" : notice.icon), size=12, color=(notice.iconTone == "error" ? "light-dark(#e7000b, #ff6467)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)
        // Hooked so the app can tell when the title is cut off (`titleDetails`, composer-presentation.ts).
        row flex-grow=1 flex-shrink=1 min-width=0 max-width=`calc(100% - ${1.75 * rem}px)` gap="0.25rem" align-items="center" testId=`notice-content-${notice.id}` hatch="t3-anchor" data-anchor=`notice-content:${notice.id}`
          if notice.machines.length > 0
            // The multi-machine banner's title opens its machine list (auto-balance.contract).
            NoticeMachines(notice=notice, busy=busy, command=command)
          else
            if notice.code != ""
              // The branch mismatch: a muted lead-in, then the branch (a medium `code` that truncates) with its tooltip.
              row min-width=0 flex-shrink=1 gap="0.375rem" align-items="baseline" testId=`notice-title-${notice.id}`
                text notice.title font-size="0.75rem" line-height="1.5rem" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap" flex-shrink=0
                box position="relative" display="flex" min-width=0 flex-shrink=1 hover=hover("title")
                  text notice.code aria-label=notice.tip font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" font-weight=500 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" min-width=0 line-clamp=1
                  TipBubble(label=notice.tip, side="top", align="start", offset=28, inset=0, shown=(over == "title"))
            else if notice.tip != ""
              box position="relative" display="flex" min-width=0 flex-shrink=1 hover=hover("title")
                text notice.title aria-label=notice.tip font-size="0.75rem" font-weight=500 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" min-width=0 line-clamp=1 testId=`notice-title-${notice.id}`
                TipBubble(label=notice.tip, side="top", align="start", offset=28, inset=0, shown=(over == "title"))
            else
              text notice.title font-size="0.75rem" font-weight=500 line-height="1.5rem" color="light-dark(#18181b, #f5f5f5)" min-width=0 line-clamp=1 testId=`notice-title-${notice.id}`
              // NoticeText: a cut-off title shows in full from its own details button.
              if notice.titleDetails
                NoticeDetails(id=`${notice.id}-title`, label=`Show full title: ${notice.title}`, text=notice.title, segments=[], busy=busy, command=command)
          if notice.segments.length > 0
            // The background-work roster: a subagent with its own thread is an InlineButton (tone muted).
            row width=0 flex-grow=1 min-width=0 align-items="center" overflow="hidden" hatch="t3-anchor" data-anchor=`nd:${notice.id}` testId=`notice-segments-${notice.id}`
              for seg in notice.segments key=seg.key
                if seg.threadId != ""
                  button press=command("select-thread", seg.threadId, "", 0) disabled=busy aria-label=seg.aria testId=`notice-open-${seg.threadId}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" flex-shrink=0
                    text seg.label font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap"
                else
                  text seg.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="nowrap" flex-shrink=0
                if not seg.last
                  text ", " font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" white-space="pre" flex-shrink=0
            if notice.details
              NoticeDetails(id=notice.id, label=(notice.code == "" ? `Show details: ${notice.title}` : "Show notice details"), text=notice.description, segments=notice.segments, busy=busy, command=command)
          else
            if notice.redact != ""
              // An account address stays blurred until clicked (AccountSummary).
              row width=0 flex-grow=1 min-width=0 align-items="center"
                UsageAccountLabel(label="", redact=notice.redact, redactMask=notice.redactMask, plan=notice.redactAfter, testId=`notice-label-${notice.id}`)
            else if notice.description != ""
              // NoticeDescription: its laid-out width (the `nd:` anchor) against its natural width decides `details`.
              text notice.description font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" width=0 flex-grow=1 min-width=0 line-clamp=1 hatch="t3-anchor" data-anchor=`nd:${notice.id}` testId=`notice-description-${notice.id}`
              if notice.details
                NoticeDetails(id=notice.id, label=(notice.code == "" ? `Show details: ${notice.title}` : "Show notice details"), text=notice.description, segments=[], busy=busy, command=command)
        if notice.action != "" or notice.action2 != "" or notice.dismiss != ""
          row margin-left="auto" gap="0.25rem" align-items="center" justify-content="flex-end" flex-shrink=0 testId=`notice-actions-${notice.id}`
            if notice.action != ""
              Tip(label=(notice.actionReason != "" ? notice.actionReason : notice.actionTip), side="top", align="center", offset=28)
                button press=command(notice.action, notice.actionId, "", 0) hover=hover("action") disabled=(busy or notice.actionReason != "") testId=`notice-action-${notice.id}` aria-label=notice.actionLabel height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-top-right-radius=(last == "action" ? "0.75rem" : "0.5rem") border-bottom-right-radius=(last == "action" ? lowerCorner : "0.5rem") border-width=0 background-color=(over == "action" and not busy and notice.actionReason == "" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0 opacity=(busy or notice.actionReason != "" ? 0.64 : 1) id=`notice-action-${notice.id}`
                  text notice.actionLabel font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
            if notice.action2 != ""
              Tip(label=notice.action2Tip, side="top", align="center", offset=28)
                button press=command(notice.action2, "", "", 0) hover=hover("action2") disabled=(busy or notice.action2Disabled) testId=`notice-action2-${notice.id}` aria-label=notice.action2Label height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" border-radius="0.5rem" border-top-right-radius=(last == "action2" ? "0.75rem" : "0.5rem") border-bottom-right-radius=(last == "action2" ? lowerCorner : "0.5rem") border-width=0 background-color=(over == "action2" and not busy and not notice.action2Disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0 opacity=(busy or notice.action2Disabled ? 0.64 : 1)
                  text notice.action2Label font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
            if notice.dismiss != ""
              button press=dismiss(notice.id, notice.dismiss, notice.dismissId) hover=hover("dismiss") disabled=busy testId=`notice-dismiss-${notice.id}` aria-label=notice.dismissLabel width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-top-right-radius="0.75rem" border-bottom-right-radius=lowerCorner border-width=0 background-color=(over == "dismiss" and not busy ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
                CcIcon(name="x", size=14, color="light-dark(#71717b, #a1a1a1)", weight=1.75)
      if notice.usage.length > 0
        UsageLimitsBody(accounts=notice.usage, notices=notice.lines, busy=busy, command=command, testId=`notice-body-${notice.id}`)
      else if notice.lines.length > 0
        column width="100%" padding-left="1.75rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.375rem" gap="0.5rem" box-sizing="border-box" testId=`notice-body-${notice.id}`
          for line in notice.lines key=line
            text line font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"

// NoticeDescription's details: an info button, shown only while the description is
// clipped, opens the whole description above it (Popover openOnHover, tooltipStyle,
// side="top"). Hovering the button or the card shows it; a press keeps it open until
// Escape, a press outside or another press. It wraps anywhere within min(30rem,
// 100vw - 2rem) and scrolls past min(24rem, 40vh). A roster's subagent links stay
// links inside it.
component NoticeDetails
  inject
    rem: number
  props
    id: string
    label: string
    text: string
    segments: NoticeSegment[]
    busy: bool
    command: action
  state pinned = false
  state shown = false
  action hover(value: bool)
    if value
      showPopover(`notice-details-card-${id}`, source=`notice-details-${id}`)
    else if not pinned
      hidePopover(`notice-details-card-${id}`)
  action pressed
    if pinned and shown
      hidePopover(`notice-details-card-${id}`)
    else
      pinned = true
      showPopover(`notice-details-card-${id}`, source=`notice-details-${id}`)
  action toggled(e: ToggleEvent)
    shown = e.newState == "open"
    if not shown
      pinned = false
  view
    box position="relative" display="flex" flex-shrink=0 hover=hover
      button id=`notice-details-${id}` press=pressed aria-label=label aria-expanded=shown aria-haspopup="dialog" testId=`notice-details-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(shown ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
        CcIcon(name="info", size=14, color="light-dark(#71717b, #a1a1a1)", weight=1.75)
      // The 4pt between the card and the button is the card's own padding, so the pointer crossing it stays on the card.
      column id=`notice-details-card-${id}` popover="auto" toggle=toggled role="dialog" aria-label="Notice details" position="absolute" position-area="top" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" padding-bottom="0.25rem" max-width=`min(${30 * rem}px, calc(100vw - ${2 * rem}px))` background-color="#00000000" testId=`notice-details-card-${id}`
        scroll max-height=`min(${24 * rem}px, 40vh)` padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d"
          if segments.length > 0
            row flex-wrap="wrap" align-items="baseline"
              for seg in segments key=seg.key
                if seg.threadId != ""
                  button press=command("select-thread", seg.threadId, "", 0) disabled=busy aria-label=seg.aria padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" title=""
                    text seg.label font-size="0.75rem" font-weight=500 line-height="1.03125rem" overflow-wrap="anywhere" text-align="left" color="light-dark(#71717b, #a1a1a1)"
                else
                  text seg.label font-size="0.75rem" line-height="1.03125rem" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
                if not seg.last
                  text ", " font-size="0.75rem" line-height="1.03125rem" white-space="pre" color="light-dark(#18181b, #f5f5f5)"
          else
            text text font-size="0.75rem" line-height="1.03125rem" white-space="normal" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)" testId=`notice-details-text-${id}`

// ComposerBannerStack: notices about sending from this composer, each its own attached card; consecutive cards join
// edge to edge, and the last joins the plan-ready drawer, the request or the card below it. Then the plan-ready
// drawer (ComposerPlanFollowUpBanner). What the thread is doing and its queue are at the end of the timeline
// (thread-end.contract). `keyed`, `drop`, `urls` and `exiting` are the root's and go unread here.
component ComposerDock
  props
    data: Snapshot
    busy: bool
    command: action
    keyed: action
    drop: action
    urls: AttachmentUrl[]
    exiting: string
    still: bool
    dismiss: action
  derive notices = data.composer.notices.length
  view
    column width="100%" testId="composer-dock"
      for n in data.composer.notices key=n.id
        NoticeRow(notice=n, attached=true, stacked=n.stacked, busy=busy, command=command, still=still, dismiss=dismiss)
      if data.composer.planReady and data.requestMode == ""
        row margin-left="1.375rem" margin-right="1.375rem" margin-bottom="-1.0625rem" padding-left="0.1875rem" padding-right="0.1875rem" padding-top="0.25rem" padding-bottom="1.3125rem" box-sizing="border-box" gap="0.25rem" align-items="center" border-top-left-radius=(notices > 0 ? "0px" : "1rem") border-top-right-radius=(notices > 0 ? "0px" : "1rem") border-style="solid" border-top-width=(notices > 0 ? 0 : 1) border-left-width=1 border-right-width=1 border-bottom-width=0 border-color="light-dark(#00000014, #ffffff0d)" background-color="light-dark(#ffffffcc, #121212cc)" box-shadow="0 1px 2px #0000000d" testId="plan-ready"
          box width="1.5rem" height="1.5rem" flex-shrink=0
          text "Plan ready" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
          if data.composer.planTitle != ""
            text data.composer.planTitle font-size="0.75rem" line-height="1rem" color="light-dark(#18181bd9, #f5f5f5d9)" flex=1 min-width=0 line-clamp=1

// ProviderSubagentBar: a provider-native subagent thread takes no messages, so
// this bar replaces the composer: who is working, for how long, and the way
// back to the parent. Sized by its own width, not the window's (a docked panel
// narrows the column): under 560pt the status drops to its own 12pt line, under
// 640pt "Runs on its own" is for VoiceOver only, under 320pt "Open parent" is its icon.
component SubagentBar
  inject
    frameMoved: action
  props
    data: Snapshot
    busy: bool
    openParent: action
  state over = false
  action hover(value: bool)
    over = value
  derive narrow = data.composer.subagentWidth > 0 and data.composer.subagentWidth < 560
  view
    row width="100%" min-height="3rem" gap="0.75rem" align-items="center" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="1.25rem" padding-right="0.5rem" box-sizing="border-box" border-radius="1rem" border-style="solid" border-width=1 border-color=(data.look.themed ? data.look.border : "light-dark(#00000014, #ffffff0d)") background-color=(data.look.themed ? data.look.popover : "light-dark(#fefefe, #101010)") box-shadow="0 1px 2px light-dark(#0000000d, #00000000), inset 0 1px 0 0 light-dark(#00000000, #ffffff08)" testId="provider-subagent-bar" id="provider-subagent-bar" resize=frameMoved data-paint=`${(data.look.themed ? "border" : "")} ${(data.look.themed ? "surfaceOverlay" : "")}` data-pick=((data.look.themed ? "surfaceOverlay" : "") != "" ? (data.look.themed ? "surfaceOverlay" : "") : ((data.look.themed ? "border" : "") != "" ? (data.look.themed ? "border" : "") : ""))
      box flex=1 min-width=0 display="flex" flex-direction=(narrow ? "column" : "row") align-items=(narrow ? "flex-start" : "center") gap=(narrow ? "0.125rem" : "0.75rem")
        row min-width=0 max-width="100%" gap="0.5rem" align-items="center"
          if data.providerDriver != ""
            ComposerInstanceMark(driver=data.providerDriver, icon=data.composer.providerIcon, size=16, color="light-dark(#18181b, #f5f5f5)", badge=data.providerBadge, accent=data.providerBadgeColor)
          text data.composer.subagentModel font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" line-clamp=1 min-width=0
          if data.composer.subagentEffort != ""
            text data.composer.subagentEffort font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717a, #a1a1a1)" flex-shrink=0 white-space="nowrap"
        text data.composer.subagentStatus font-size=(narrow ? "0.75rem" : "0.875rem") line-height=(narrow ? "1rem" : "1.25rem") font-variant-numeric="tabular-nums" color="light-dark(#71717a, #a1a1a1)" line-clamp=1 min-width=0 max-width="100%" aria-hidden=true testId="subagent-status"
      text data.composer.subagentAnnounce position="absolute" width=1 height=1 overflow="hidden" opacity=0 font-size=1 role="status"
      if data.composer.subagentWidth > 0 and data.composer.subagentWidth < 640
        text "Runs on its own" position="absolute" width=1 height=1 overflow="hidden" opacity=0 font-size=1
      else
        text "Runs on its own" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717a, #a1a1a1)" flex-shrink=0 white-space="nowrap"
      if data.composer.subagentParent != ""
        button press=openParent(data.composer.subagentParent) hover=hover disabled=busy testId="subagent-open-parent" aria-label="Open parent" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" gap="0.375rem" border-radius="0.5rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
          CcIcon(name="arrow-up-left", size=16, color="light-dark(#18181b, #f5f5f5)", weight=1.75)
          if not (data.composer.subagentWidth > 0 and data.composer.subagentWidth < 320)
            text "Open parent" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
