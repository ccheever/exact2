// The composer footer and its docked banners: the
// toolbar controls (ComposerControl.tsx "sm"/"xs"), the primary actions
// (ComposerPrimaryActions.tsx), the traits and runtime-mode menus
// (TraitsPicker.tsx, ChatComposer.tsx footer) and the dock above the card
// (ComposerBannerStack.tsx, ComposerPlanFollowUpBanner.tsx). Colours are the served build's tokens:
// foreground #18181b/#f5f5f5, muted #71717a/#a1a1a1, border #e4e4e7/white 8%,
// accent #f4f4f5/white 4%, message action #1b4ed8/#346bf1.

keyframes ccSpin
  from rotate=0
  to rotate=360
keyframes ccFadeIn
  from opacity=0
// The controls arriving as the composer rests (from 4pt above) or expands (from 4pt below):
// useComposerRestingTransition's COMPOSER_RESTING_CONTROLS_ARRIVAL_DRIFT_PX.
keyframes ccRestIn
  from opacity=0 translate="0px -4px"
keyframes ccExpandIn
  from opacity=0 translate="0px 4px"

// Lucide geometry (24px grid) for the composer's own glyphs.
component CcIcon
  props
    name: string
    size: number
    color: string
    weight: number
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=weight stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
