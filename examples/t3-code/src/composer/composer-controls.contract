// The send circle's face: the Nightly sky (StageBackdropButtonArt) while the environment is identified by artwork, at
// 64% when disabled; else bg-message-action (hover 90% over the background) with a white glyph, and, disabled,
// foreground/12 with a muted glyph and no shadow.
fn sendFace(artwork: bool, disabled: bool, over: bool): string = artwork ? "#00000000" : disabled ? "light-dark(#18181b1f, #f5f5f51f)" : over ? "light-dark(#315fdc, #2f60d9)" : "light-dark(#1b4ed8, #346bf1)"
fn sendInk(artwork: bool, disabled: bool): string = artwork or not disabled ? "#ffffff" : "light-dark(#71717b, #a1a1a1)"
fn sendShadow(artwork: bool, disabled: bool): string = disabled ? "none" : artwork ? "0 1px 2px 0 #0000003d, inset 0 1px 0 0 #ffffff29" : "0 1px 2px 0 light-dark(#1b4ed83d, #346bf13d), inset 0 1px 0 0 #ffffff29"

// StageBackdropButtonArt: the Nightly sky behind the send button, the slice a
// 32px circle shows of the 96px-tall artwork (x 96–192).
component SendArt
  view
    svg width="2rem" height="2rem" viewBox="96 0 96 96" fill="none" position="absolute" left=0 top=0 aria-hidden=true
      defs
        linearGradient id="send-sky" x1=24 y1=0 x2=264 y2=96 gradientUnits="userSpaceOnUse" spreadMethod="reflect"
          stop stop-color="#07152f"
          stop offset=0.5 stop-color="#151443"
          stop offset=1 stop-color="#32155b"
        radialGradient id="send-glow" cx=0 cy=0 r=1 gradientTransform="translate(216 18) rotate(137) scale(120 84)" gradientUnits="userSpaceOnUse"
          stop stop-color="#5165d8" stop-opacity=0.4
          stop offset=0.5 stop-color="#283075" stop-opacity=0.16
          stop offset=1 stop-color="#07152f" stop-opacity=0
        linearGradient id="send-cloud" x1=0 y1=60 x2=288 y2=96 gradientUnits="userSpaceOnUse"
          stop stop-color="#4ea4ff" stop-opacity=0.5
          stop offset=0.52 stop-color="#696fea" stop-opacity=0.62
          stop offset=1 stop-color="#a85bea" stop-opacity=0.5
        filter id="send-soft" x=-24 y=-24 width=336 height=144 filterUnits="userSpaceOnUse"
          feGaussianBlur stdDeviation=4
      rect x=96 width=96 height=96 fill="url(#send-sky)"
      rect x=96 width=96 height=96 fill="url(#send-glow)"
      g fill="#e4eaff"
        circle cx=104 cy=7 r=0.6 opacity=0.8
        circle cx=126 cy=20 r=0.4 opacity=0.55
        circle cx=148 cy=11 r=0.5 opacity=0.7
        circle cx=170 cy=24 r=0.4 opacity=0.5
        circle cx=118 cy=34 r=0.4 opacity=0.45
      path d="M158.5 36h3M160 34.5v3" stroke="#c8d7ff" stroke-opacity=0.7 stroke-width=0.6 stroke-linecap="round"
      g filter="url(#send-soft)"
        path d="M-12 88C-12 74 0 63 14 63C18 50 30 41 44 41C58 41 70 49 74 62C79 57 86 54 94 54C110 54 123 66 124 82C132 83 138 88 141 96H-12V88Z" fill="url(#send-cloud)"
        path d="M150 96C151 84 161 75 173 75C176 64 186 57 198 57C210 57 220 64 223 75C231 75 238 80 241 87C250 87 257 91 260 96H150Z" fill="url(#send-cloud)" opacity=0.8

// ComposerControl size "sm" (h-7 px-2 gap-1.5 text-sm font-medium, foreground/80) or the resting "xs"
// (font-normal, foreground/70, dark muted-foreground; its icons and chevron take that ink).
component ModelTrigger
  props
    data: Snapshot
    xs: bool
    open: bool
    label: bool
    keyModels: string
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    // Named by its model names (allModelNames, or the label it shows), as ProviderModelPicker is.
    button -exact-menu="none" press=press hover=hover class=Control aria-label=(data.composer.fanout ? data.composer.fanoutAria : data.modelLabel == "" ? "Choose model" : data.modelLabel) aria-expanded=open aria-keyshortcuts=keyModels testId="model-picker" disabled=disabled opacity=(disabled ? 0.64 : 1) min-width=(xs ? "2.5rem" : "3rem") max-width=(xs ? "10.5rem" : "624.9375rem") flex-shrink=1 height=(xs ? "1.5rem" : "1.75rem") padding-left=(xs ? "0.4375rem" : "0.5625rem") padding-right=(xs ? "0.4375rem" : "0.5625rem") padding-top=0 padding-bottom=0 margin-left=(xs ? "-0.625rem" : "-0.5rem") gap=(xs ? "0.25rem" : "0.375rem") border-radius="0.5rem" background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
      // Several models (a multi-model draft): up to three overlapping marks, then "+N".
      if data.composer.fanout
        row flex-shrink=0 align-items="center" aria-hidden=true
          for mark in data.composer.fanoutMarks key=mark.key
            box display="flex" margin-right="-0.25rem" border-radius="0.5rem" border-width=2 border-style="solid" border-color="light-dark(#ffffff, #161616)" background-color="light-dark(#ffffff, #161616)"
              ComposerInstanceMark(driver=mark.driver, icon=mark.icon, size=16, color="light-dark(#71717a, #a1a1a1)", badge="", accent="#00000000")
          if data.composer.fanoutMore > 0
            text `+${data.composer.fanoutMore}` font-size="0.5625rem" line-height="1rem" min-width="1rem" height="1rem" border-radius="0.5rem" text-align="center" border-width=2 border-style="solid" border-color="light-dark(#ffffff, #161616)" background-color="light-dark(#ffffff, #161616)" color="light-dark(#71717a, #a1a1a1)"
          box width="0.25rem"
      else
        // ultrathink-chroma (saturate 1.2) on the model mark.
        box display="flex" flex-shrink=0 filter=(data.composer.ultrathink ? "saturate(1.2)" : "none") testId=(data.composer.ultrathink ? "model-picker-ultrathink" : "model-picker-mark")
          ComposerInstanceMark(driver=data.providerDriver, icon=data.composer.providerIcon, size=(xs ? 14 : 16), color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)"), badge=data.providerBadge, accent=data.providerBadgeColor)
      // The tooltip (label · ⇧⌘M) belongs to the label, 4pt above it (ProviderModelPicker TooltipTrigger).
      if label
        box position="relative" display="flex" flex-direction="row" min-width=0 flex-shrink=1
          text (data.composer.fanout ? data.composer.fanoutLabel : data.modelShortLabel == "" ? "Choose model" : data.modelShortLabel) font-size=(xs ? "0.75rem" : "0.875rem") font-weight=(xs ? 400 : 500) line-height=(xs ? "1rem" : "1.25rem") color=(over ? "light-dark(#18181b, #f5f5f5)" : xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#18181bcc, #f5f5f5cc)") line-clamp=1 min-width=0 flex-shrink=1 testId="model-picker-label"
          TipBubble(label=data.composer.modelTip, side="top", align="center", offset=(xs ? 20 : 24), inset=0, shown=over)
        // An unavailable model's Badge (variant outline, size sm) after its name, as ProviderModelPicker draws it.
        if data.modelUnavailable and not data.composer.fanout
          row height="1rem" min-width="1rem" padding-left="0.1875rem" padding-right="0.1875rem" box-sizing="border-box" align-items="center" justify-content="center" flex-shrink=0 border-radius="0.25rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff1c)" background-color="light-dark(#ffffff, #ffffff0a)" testId="model-picker-unavailable"
            text "Unavailable" font-size="0.625rem" line-height="0.625rem" font-weight=500 white-space="nowrap" color="light-dark(#18181b, #f5f5f5)"
      box margin-left="-0.125rem" margin-right="-0.125rem" display="flex" flex-shrink=0
        CcIcon(name="chevron-down", size=(xs ? 12 : 14), color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)"), weight=2.25)

// ChatComposer's provider-unavailable control in place of the model picker.
component ProviderUnavailable
  props
    label: string
    xs: bool
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover class=Control aria-label=label testId="provider-unavailable" disabled=disabled opacity=(disabled ? 0.64 : 1) flex-shrink=0 height=(xs ? "1.5rem" : "1.75rem") padding-left=(xs ? "0.4375rem" : "0.5625rem") padding-right=(xs ? "0.4375rem" : "0.5625rem") padding-top=0 padding-bottom=0 gap=(xs ? "0.25rem" : "0.375rem") border-radius="0.5rem" background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
      CcIcon(name="circle-alert", size=(xs ? 12 : 16), color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)"), weight=1.75)
      text label font-size=(xs ? "0.75rem" : "0.875rem") font-weight=(xs ? 400 : 500) line-height=(xs ? "1rem" : "1.25rem") color=(over and not disabled ? "light-dark(#18181b, #f5f5f5)" : xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#18181bcc, #f5f5f5cc)") white-space="nowrap"

// The traits trigger: the gauge glyph (TraitsPicker GaugeIcon since 3816296021), then the label ("High Fast · 1M"),
// which icon-only compact layouts leave out.
component TraitsTrigger
  props
    label: string
    iconOnly: bool
    xs: bool
    open: bool
    disabled: bool
    keyEffort: string
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex" flex-direction="row" align-items="center" min-width=0 max-width="12rem" flex-shrink=(iconOnly ? 0 : 1) id="composer-traits-trigger"
      button -exact-menu="none" press=press hover=hover class=Control aria-label=label aria-expanded=open aria-keyshortcuts=keyEffort testId="reasoning-effort" disabled=disabled opacity=(disabled ? 0.64 : 1) min-width=0 max-width="12rem" flex-shrink=(iconOnly ? 0 : 1) height=(xs ? "1.5rem" : "1.75rem") padding-left=(xs ? "0.4375rem" : "0.5625rem") padding-right=(xs ? "0.4375rem" : "0.5625rem") padding-top=0 padding-bottom=0 gap=(xs ? "0.25rem" : "0.375rem") border-radius="0.5rem" background-color=(open or over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
        CcIcon(name="gauge", size=(xs ? 12 : 16), color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)"), weight=1.75)
        if not iconOnly and label != ""
          text label font-size=(xs ? "0.75rem" : "0.875rem") font-weight=(xs ? 400 : 500) line-height=(xs ? "1rem" : "1.25rem") color=(over ? "light-dark(#18181b, #f5f5f5)" : xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#18181bcc, #f5f5f5cc)") line-clamp=1 min-width=0
        box margin-left="-0.125rem" margin-right="-0.125rem" display="flex" flex-shrink=0
          CcIcon(name="chevron-down", size=(xs ? 12 : 14), color=(xs ? "light-dark(#18181bb3, #a1a1a1)" : "light-dark(#71717a, #a1a1a1)"), weight=2.25)
      TipBubble(label=label, side="top", align="center", offset=(xs ? 28 : 32), inset=0, shown=over)

