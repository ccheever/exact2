use Message from "../shared/shapes.contract"
use Activity from "../shared/shapes.contract"
use AttachmentUrl from "../timeline/timeline-attachments.contract"
use CcIcon from "./composer-controls.contract"
use TimelineTip from "../shell/shell-tip.contract"
use TimelineIcon from "../timeline/timeline-icons-kit.contract"

// The end of the timeline, after the last message (thread-end.ts builds the rows, whose fields it documents):
// ThreadNow's lines and QueuedRunsControl's dashed, unsent bubbles. Colours are the served build's tokens: muted
// #71717b/#a1a1a1, foreground #18181b/#f5f5f5, info #1447e6/#50a2ff, accent #f4f4f5/white 4%, border #e4e4e7/white 8%.

// `transition-opacity duration-150 ease-out starting:opacity-0`: a line or bubble fades in as it appears.
keyframes teFadeIn
  from opacity=0

// ThreadNowLine (text-xs muted, 14pt glyph, gap-1.5, px-1 pb-2, as ThreadStatusLine): the icon (info or warning
// toned on a line that needs you), then the title, its
// name (`body`, in the code font when `meta`) and the detail (2pt further, fainter: muted/80, dark /60) as one line that
// gives way before the actions, so Stop stays reachable; the actions follow 6pt on, 10pt apart, with the one task's
// elapsed time first (tickTextContent). A cut line offers its whole text from a details button (NoticeText).
// formatDuration (orchestrationTiming.ts) from a second up: tenths below 10 s, then whole units, rounded first.
fn threadNowDuration(ms: number): string = ms < 10000 ? (round(ms / 100) >= 100 ? "10s" : `${floor(round(ms / 100) / 10)}.${round(ms / 100) % 10}s`) : round(ms / 1000) < 60 ? `${round(ms / 1000)}s` : `${floor(round(ms / 1000) / 3600) > 0 ? floor(round(ms / 1000) / 3600).toString() + "h " : ""}${floor(round(ms / 1000) % 3600 / 60) > 0 ? floor(round(ms / 1000) % 3600 / 60).toString() + "m " : ""}${round(ms / 1000) % 60 > 0 ? (round(ms / 1000) % 60).toString() + "s" : ""}`.trim()
component ThreadNowLine
  inject
    still: bool
  props
    message: Message
    busy: bool
    now: number
    command: action
  state over = ""
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
  derive segments = message.activities.filter((entry) => entry.status != "action")
  derive actions = message.activities.filter((entry) => entry.status == "action")
  derive faint = "light-dark(#71717bcc, #a1a1a199)"
  view
    row width="100%" min-width=0 align-items="center" gap="0.375rem" padding-left="0.25rem" padding-right="0.25rem" padding-bottom="0.5rem" box-sizing="border-box" role=(message.status == "alert" ? "alert" : message.status == "status" ? "status" : "") animation=(still ? "none" : "teFadeIn 150ms ease-out") testId=`thread-now-${message.id}`
      row width="0.875rem" height="0.875rem" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
        CcIcon(name=message.icon, size=14, color=(message.tone == "info" ? "light-dark(#1447e6, #50a2ff)" : message.tone == "warning" ? "light-dark(#bb4d00, #ffb900)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)
      // Hooked so the app can tell when the line is cut (thread-end.ts `collapsible`).
      row flex-shrink=1 min-width=0 overflow="hidden" align-items="center" hatch="t3-anchor" data-anchor=`tn:${message.id}` testId=`thread-now-text-${message.id}`
        if segments.length == 0 and message.body == "" and message.detail == ""
          text message.title font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)" min-width=0 line-clamp=1
        else
          text (message.body != "" ? `${message.title} ` : message.title) font-size="0.75rem" line-height="1rem" white-space="pre" color="light-dark(#71717b, #a1a1a1)" flex-shrink=0
          if message.body != ""
            text message.body font-family=(message.meta ? "Menlo, Consolas, \"Liberation Mono\", monospace" : "system-ui") font-size="0.75rem" line-height="1rem" white-space="pre" color="light-dark(#71717b, #a1a1a1)" min-width=0 overflow="hidden" text-overflow="ellipsis" flex-shrink=(message.detail == "" ? 1 : 0) testId=`thread-now-name-${message.id}`
          if message.detail != ""
            text message.detail font-family=(message.meta and message.body == "" ? "Menlo, Consolas, \"Liberation Mono\", monospace" : "system-ui") font-size="0.75rem" line-height="1rem" color=faint margin-left="0.375rem" min-width=0 line-clamp=1
          else if segments.length > 0
            row margin-left="0.375rem" min-width=0 flex-shrink=1 overflow="hidden" align-items="center"
              for seg, index in segments key=seg.id
                if seg.status == "link"
                  // InlineButton tone muted: the foreground and an underline while hovered.
                  button press=command(seg.detail != "" ? seg.detail : "select-thread", seg.targetId, "", 0) hover=hover(`seg:${seg.id}`) disabled=busy aria-label=(seg.body != "" ? seg.body : seg.label) testId=`thread-now-open-${seg.targetId}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" flex-shrink=0 title=""
                    text seg.label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(over == `seg:${seg.id}` ? "light-dark(#18181b, #f5f5f5)" : faint) text-decoration-line=(over == `seg:${seg.id}` ? "underline" : "none")
                else
                  text seg.label font-size="0.75rem" line-height="1rem" white-space="nowrap" color=faint flex-shrink=0
                if index < segments.length - 1
                  text ", " font-size="0.75rem" line-height="1rem" white-space="pre" color=faint flex-shrink=0
      if message.collapsible
        LineDetails(message=message, segments=segments, busy=busy, command=command)
      if actions.length > 0 or message.startedMs > 0
        row margin-left="0.375rem" gap="0.625rem" align-items="center" flex-shrink=0
          if message.startedMs > 0
            text threadNowDuration(max(1000, now - message.startedMs)) font-size="0.75rem" line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)" testId=`thread-now-elapsed-${message.id}`
          for act, index in actions key=act.id
            // InlineButton: medium, an underline while hovered; disabled at 64%.
            button press=command(act.detail, act.targetId, "", 0) hover=hover(act.id) disabled=(busy or not act.ok) opacity=(busy or not act.ok ? 0.64 : 1) testId=`thread-now-action-${act.id}` padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
              text act.label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(act.tone == "muted" and over != act.id ? "light-dark(#71717b, #a1a1a1)" : "light-dark(#18181b, #f5f5f5)") text-decoration-line=(over == act.id and act.ok and not busy ? "underline" : "none")

// NoticeText's details: an info button (icon-xs ghost-muted), shown only while the line is cut, opens the whole
// title and detail above it (Popover openOnHover, tooltipStyle, side="top"). Hovering shows it; a press keeps it open
// until Escape, a press outside or another press. It wraps anywhere within min(30rem, 100vw - 2rem) and scrolls past
// min(24rem, 40vh); a roster's subagent links stay links inside it.
component LineDetails
  inject
    rem: number
  props
    message: Message
    segments: Activity[]
    busy: bool
    command: action
  state pinned = false
  state shown = false
  action hover(value: bool)
    if value
      showPopover(`thread-now-details-card-${message.id}`, source=`thread-now-details-${message.id}`)
    else if not pinned
      hidePopover(`thread-now-details-card-${message.id}`)
  action pressed
    if pinned and shown
      hidePopover(`thread-now-details-card-${message.id}`)
    else
      pinned = true
      showPopover(`thread-now-details-card-${message.id}`, source=`thread-now-details-${message.id}`)
  action toggled(e: ToggleEvent)
    shown = e.newState == "open"
    if not shown
      pinned = false
  view
    box position="relative" display="flex" flex-shrink=0 margin-top="-0.375rem" margin-bottom="-0.375rem" hover=hover
      button id=`thread-now-details-${message.id}` press=pressed aria-label=`Show details: ${message.title}` aria-expanded=shown aria-haspopup="dialog" testId=`thread-now-details-${message.id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(shown ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
        CcIcon(name="info", size=14, color="light-dark(#71717b, #a1a1a1)", weight=1.75)
      // The 4pt between the card and the button is the card's own padding, so the pointer crossing it stays on the card.
      column id=`thread-now-details-card-${message.id}` popover="auto" toggle=toggled role="dialog" aria-label="Notice details" position="absolute" position-area="top" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" padding-bottom="0.25rem" max-width=`min(${30 * rem}px, calc(100vw - ${2 * rem}px))` background-color="#00000000" testId=`thread-now-details-card-${message.id}`
        scroll max-height=`min(${24 * rem}px, 40vh)` padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d"
          if segments.length > 0
            row flex-wrap="wrap" align-items="baseline"
              text `${message.title} ` font-size="0.75rem" line-height="1.03125rem" white-space="pre-wrap" color="light-dark(#18181b, #f5f5f5)"
              for seg, index in segments key=seg.id
                if seg.status == "link"
                  button press=command(seg.detail != "" ? seg.detail : "select-thread", seg.targetId, "", 0) disabled=busy aria-label=(seg.body != "" ? seg.body : seg.label) padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" title=""
                    text seg.label font-size="0.75rem" font-weight=500 line-height="1.03125rem" overflow-wrap="anywhere" text-align="left" color="light-dark(#71717b, #a1a1a1)"
                else
                  text seg.label font-size="0.75rem" line-height="1.03125rem" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
                if index < segments.length - 1
                  text ", " font-size="0.75rem" line-height="1.03125rem" white-space="pre" color="light-dark(#18181b, #f5f5f5)"
          else
            text [message.title, message.body, message.detail].filter((part) => part != "").join(" ") font-size="0.75rem" line-height="1.03125rem" white-space="normal" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)" testId=`thread-now-details-text-${message.id}`

// QueuedRunsControl's row: a dashed, unfilled bubble (a turn not sent yet, read in full as a sent turn is), wearing its
// sent form's attribution, then its actions under it: Send now (Button xs ghost-muted) while it can be sent, "Saving" while the send
// is in flight, the pencil (its reason as its tooltip while disabled) and remove; while it is edited, "Editing in the
// composer" and Cancel. Bubbles are 12pt apart (gap-3), the "Show all" row 8pt below, and the queue ends with 16pt.
component QueuedTurn
  inject
    still: bool
  props
    message: Message
    busy: bool
    command: action
    urls: AttachmentUrl[]
  state over = ""
  state rowOver = false
  state expanded = false
  action hover(name: string, value: bool)
    over = value ? name : (over == name ? "" : over)
  action hoverRow(value: bool)
    rowOver = value
  action toggle
    expanded = not expanded
  derive editing = message.status == "editing"
  derive pending = message.status == "pending"
  // QueuedMessage: an automation's or another agent's message folds to one line, as its sent form does.
  derive folded = message.intent == "automation" or message.intent == "agent"
  derive bodyShown = not folded or expanded
  view
    column width="100%" align-items="flex-end" gap="0.25rem" padding-bottom=(message.continues ? "0.75rem" : message.collapsible ? "0.5rem" : "1rem") box-sizing="border-box" position="relative" hover=hoverRow aria-label=message.title aria-current=(editing ? "true" : "") animation=(still ? "none" : "teFadeIn 150ms ease-out") testId=(message.runId != "" ? `queued-${message.runId}` : "queued-pending")
      if message.attribution != ""
        // The queue's live count (QueuedRunsControl's sr-only aria-live region).
        text message.attribution role="status" position="absolute" width=1 height=1 overflow="hidden" opacity=0 font-size=1
      if message.intent == "t3code"
        text "Sent by T3 Code" margin-right="0.25rem" font-size="0.6875rem" line-height="0.9375rem" color="light-dark(#71717bb3, #a1a1a1b3)" testId="queued-sent-by"
      column width=(folded and expanded ? "100%" : "auto") min-width=0 max-width="80%" gap="0.5rem" padding-left=(folded ? "0px" : "0.75rem") padding-right=(folded ? "0px" : "0.75rem") padding-top=(folded ? "0px" : "0.5rem") padding-bottom=(folded ? "0px" : "0.5rem") box-sizing="border-box" border-radius="1rem" border-width=1 border-style="dashed" border-color=(editing ? "light-dark(#1b4ed899, #346bf199)" : "light-dark(#71717b66, #a1a1a166)") testId="queued-bubble"
        if folded
          // FoldedMessageHeader: the sender's glyph and name, the line, and a chevron that turns while open.
          button press=toggle aria-expanded=expanded aria-label=`${message.sender} ${message.summary}` testId=`queued-fold-${message.runId}` width="100%" min-width=0 padding-left="0.75rem" padding-right="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" border-radius="1rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.375rem" title=""
            TimelineIcon(name=(message.intent == "automation" ? "calendar-clock" : "messages-square"), size=16, color="light-dark(#71717b, #a1a1a1)")
            text message.sender max-width="50%" flex-shrink=0 line-clamp=1 font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
            text message.summary flex=1 min-width=0 line-clamp=1 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)"
            box width="0.875rem" height="0.875rem" flex-shrink=0 rotate=(expanded ? 180 : 0)
              TimelineIcon(name="chevron-down", size=14, color="light-dark(#71717b, #a1a1a1)")
        // A folded message's body, thumbnails included, scrolls inside the fold's padding (QueuedMessage's max-h-96 px-3 pb-2).
        if bodyShown and (message.images.length > 0 or message.body != "")
          scroll width="100%" max-height=(folded ? "24rem" : "62500rem") padding-left=(folded ? "0.75rem" : "0px") padding-right=(folded ? "0.75rem" : "0px") padding-bottom=(folded ? "0.5rem" : "0px") box-sizing="border-box"
            column width="100%" gap="0.5rem"
              if message.images.length > 0
                row flex-wrap="wrap" align-items="center" gap="0.25rem"
                  for thumb in message.images key=thumb.id
                    box width="2rem" height="2rem" overflow="hidden" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0e)" background-color="light-dark(#fcfcfc, #000000)" box-sizing="border-box" testId=`queued-thumb-${thumb.id}`
                      if urls.filter((entry) => entry.id == thumb.id).length > 0
                        for entry in urls.filter((entry) => entry.id == thumb.id) key=entry.id
                          image entry.url aria-label=thumb.name width="100%" height="100%" object-fit="cover"
                      else
                        box width="100%" height="100%" background-color="light-dark(#fafafa99, #ffffff05)" aria-label=thumb.name
              if message.body != ""
                text message.body font-size="0.875rem" line-height="1.25rem" white-space="pre-wrap" overflow-wrap="anywhere" color=(editing ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")
      row align-items="center" gap="0.125rem" padding-right="0.25rem" box-sizing="border-box"
        // The sent form's links and time, shown while the row is hovered (group-hover/queued).
        if message.createdAt != ""
          row margin-right="0.25rem" padding-left="0.25rem" padding-right="0.25rem" gap="0.5rem" align-items="center" opacity=(rowOver ? 1 : 0) testId=`queued-meta-${message.runId}`
            if message.intent == "agent" and message.sourceThreadId != ""
              QueuedLink(label="Open thread", press=command("open-related-thread", message.sourceThreadId, "", 0), testId=`queued-open-thread-${message.runId}`)
            if message.groupId != ""
              QueuedLink(label="Open automation", press=command("open-scheduled-task", message.groupId, "", 0), testId=`queued-open-automation-${message.runId}`)
            TimelineTip(label=message.timeTip, side="top", align="center", offset=24)
              text message.timestamp font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #a1a1a1)"
        if message.actionLabel != ""
          TimelineTip(label=message.intentTip, side="top", align="center", offset=28)
            button press=command("cc:queued-steer", message.runId, "", 0) hover=hover("send") disabled=(message.runId == "" or busy) opacity=(message.runId == "" or busy ? 0.64 : 1) testId=`queued-send-${message.runId}` height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color=(over == "send" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
              box display="flex" flex-shrink=0 margin-left="-0.125rem" margin-right="-0.125rem"
                CcIcon(name="arrow-up", size=14, color=(over == "send" ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)
              text message.actionLabel font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(over == "send" ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)")
        if pending
          row gap="0.25rem" align-items="center" padding-left="0.25rem" padding-right="0.25rem" testId="queued-saving"
            CcIcon(name="clock", size=12, color="light-dark(#71717b, #a1a1a1)", weight=1.75)
            text "Saving" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #a1a1a1)"
        if editing
          text "Editing in the composer" font-size="0.75rem" line-height="1rem" padding-left="0.25rem" padding-right="0.25rem" color="light-dark(#18181b, #f5f5f5)"
          button press=command("cclocal:queued-cancel", "", "", 0) hover=hover("cancel") testId="queued-cancel-edit" aria-label="Cancel editing queued message" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" border-radius="0.5rem" border-width=0 background-color=(over == "cancel" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" flex-shrink=0
            text "Cancel" font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)"
        else
          TimelineTip(label=message.detail, side="top", align="center", offset=28)
            button press=command("cclocal:queued-edit", message.runId, "", 0) hover=hover("edit") disabled=(message.runId == "" or message.failed or busy) opacity=(message.runId == "" or message.failed or busy ? 0.64 : 1) testId=`queued-edit-${message.runId}` aria-label="Edit queued message" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over == "edit" and not message.failed ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
              CcIcon(name="pencil", size=14, color=(over == "edit" and not message.failed ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)
          TimelineTip(label="Remove from queue", side="top", align="center", offset=28)
            button press=command("cc:queued-remove", message.runId, "", 0) hover=hover("remove") disabled=(message.runId == "" or busy) opacity=(message.runId == "" or busy ? 0.64 : 1) testId=`queued-remove-${message.runId}` aria-label="Remove queued message" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(over == "remove" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
              CcIcon(name="x", size=14, color=(over == "remove" ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)

// InlineButton tone muted: muted, the foreground and an underline while hovered.
component QueuedLink
  props
    label: string
    press: action
    testId: string
  state hovered = false
  action hover(value: bool)
    hovered = value
  view
    button press=press hover=hover testId=testId padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
      text label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(hovered ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)") text-decoration-line=(hovered ? "underline" : "none")

// "Show all N queued" / "Show fewer" (InlineButton tone muted, 12pt, a 14pt chevron that turns while the queue shows
// in full), at the queue's end; then the queue's 16pt.
component QueuedMore
  props
    message: Message
    command: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row width="100%" justify-content="flex-end" padding-right="0.25rem" padding-bottom="1rem" box-sizing="border-box"
      button press=command("cclocal:queued-show-all", "", "", 0) hover=hover aria-expanded=message.expanded testId="queued-show-all" padding=0 gap="0.125rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" flex-shrink=0 title=""
        text message.title font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)") text-decoration-line=(over ? "underline" : "none")
        box display="flex" flex-shrink=0 rotate=(message.expanded ? 180 : 0)
          CcIcon(name="chevron-down", size=14, color=(over ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#71717b, #a1a1a1)"), weight=1.75)
