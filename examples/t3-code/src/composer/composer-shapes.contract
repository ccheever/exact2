use TextProbe from "./composer-label-probes.contract"
use RunOnOption from "../details/git-shapes.contract"
use StripPrTip from "./strip-pr-badge.contract"
use CheckoutItem from "./pr-checkout-shapes.contract"
use UsageAccount from "../usage/usage-bars.contract" // the /usage-limits body
// The composer's projected toolbar/menu rows (composer-presentation.ts) and the
// model picker catalog (model-catalog.ts).
shape ComposerTrait
  key: string
  kind: string
  descriptor: string
  value: string
  label: string
  description: string
  selected: bool
  isDefault: bool
  index: number
  // The primary effort's rows while "ultrathink" is in the prompt's body.
  disabled: bool
shape ComposerRuntime
  mode: string
  label: string
  description: string
  icon: string
  selected: bool
  index: number
// A docked composer notice (ComposerBannerStack item) and a todo step (ComposerTasksBadge).
// A description part: plain text, or (threadId set) an inline link that opens that thread.
shape NoticeSegment
  key: string
  label: string
  threadId: string
  last: bool
shape ComposerNotice
  id: string
  variant: string
  icon: string
  title: string
  description: string
  action: string
  actionLabel: string
  dismiss: string
  dismissLabel: string
  priority: number
  front: bool
  action2: string
  action2Label: string
  lines: string[]
  actionReason: string
  // The id the action's command receives (the child-input banner's thread).
  actionId: string
  dismissId: string
  segments: NoticeSegment[]
  // The title's and actions' tooltips, a red icon, a "·" before the description, the title's live role.
  tip: string
  actionTip: string
  action2Tip: string
  iconTone: string
  sep: bool
  liveRole: string
  // The multi-machine update banner's popover rows, and its title's accessible name.
  machines: NoticeMachine[]
  menuLabel: string
  // An account address as the description (redacted until clicked, then `redactAfter`) and the /usage-limits body.
  redact: string
  redactMask: string
  redactAfter: string
  usage: UsageAccount[]
// One machine of the banner's popover (status idle, running or failed; a manual copy action or note).
shape NoticeMachine
  id: string
  label: string
  status: string
  line: string
  copyLabel: string
  note: string
shape ComposerTask
  key: string
  text: string
  status: string
  duration: string
// A queued row's image thumbnail, and an attachment the queued edit keeps.
shape QueuedThumb
  id: string
  name: string
shape QueueEditAttachment
  id: string
  name: string
  image: bool
shape ComposerQueued
  runId: string
  text: string
  images: number
  index: number
  editing: bool
  last: bool
  thumbnails: QueuedThumb[]
  pending: bool
// The workspace / branch strip under the draft composer (composer-controls-branch.ts).
shape BranchRef
  name: string
  badge: string
  selected: bool
  index: number
shape ComposerBranches
  show: bool
  envMode: string
  forceWorktree: bool
  envLabel: string
  envLocked: bool
  envIcon: string
  previous: bool
  previousBranch: string
  branchLabel: string
  branch: string
  loading: bool
  refs: BranchRef[]
  status: string
  creatable: string
  enterOp: string
  enterValue: string
  // "Checkout pull request" before the refs (0 or 1).
  checkout: CheckoutItem[]
  // "Run on" (git-env.ts stripRunOn).
  envShow: bool
  // A non-Git project (a No project draft, say) shows only the machine selector
  // (BranchToolbarEnvironmentSelector); envLocked then means a started thread's static machine row.
  gitless: bool
  envMachine: string
  envMachineLabel: string
  envOptions: RunOnOption[]
  envMenuWidth: number
  // The host-resource load the root's balanceLoad task sends ("" when none is due).
  balanceFetch: string
  originShown: bool
  originOn: bool
  // The pull request badge before the branch trigger (strip-pr-badge.ts).
  prShow: bool
  prText: string
  prIcon: string
  prState: string
  prLabel: string
  prList: bool
  prUrl: string
  prTarget: string
  prTips: StripPrTip[]
// One provider mark of a multi-model draft's trigger (composer-controls-fanout.ts).
shape FanoutMark
  key: string
  driver: string
shape ComposerView
  placeholder: string
  modelTip: string
  fanout: bool
  fanoutLabel: string
  fanoutAria: string
  fanoutMarks: FanoutMark[]
  fanoutMore: number
  fanoutKeys: string[]
  traitsLabel: string
  traitsSpeed: string
  traitsAria: string
  runtimeIconOnly: bool
  traitsIconOnly: bool
  restingRuntimeIconOnly: bool
  restingTraitsIconOnly: bool
  sendRunning: bool
  sendLabel: string
  sendIcon: string
  sendStatus: string
  sendSpinner: bool
  sendTooltip: string
  sendChords: string
  // The Compact chip ('' tokens when it is not offered): off keeps full history; on, the send compacts first.
  compactTokens: string
  compactKeepFull: bool
  compactSend: bool
  compactTip: string
  compactWidth: number
  canResume: bool
  planReady: bool
  planTitle: string
  noProvider: string
  providerSetupId: string
  tasksTotal: number
  tasksDone: number
  tasksCurrent: string
  tasks: ComposerTask[]
  syncStatus: string
  activity: string
  notices: ComposerNotice[]
  // The account whose reset credit confirm is open ('' when none).
  resetConfirm: string
  implementX: number
  implementWidth: number
  queued: ComposerQueued[]
  contextShow: bool
  contextAria: string
  contextPercent: string
  contextOffset: number
  contextOver: bool
  contextUsed: string
  contextMax: string
  contextTotal: string
  contextCost: string
  contextNote: string
  contextCompact: bool
  contextValueNow: number
  meterX: number
  meterWidth: number
  actionsX: number
  toolbarTop: number
  toolbarRight: number
  sendTipWidth: number
  stripTop: number
  stripLeft: number
  stripRight: number
  queueReorder: bool
  queueSteer: bool
  queueSteerReason: string
  queueEditing: string
  // The edit's kept attachments and whether its save is in flight.
  queueEditAttachments: QueueEditAttachment[]
  queueEditSaving: bool
  queueDropSeq: number
  traitsCount: number
  traitsSelected: number
  traits: ComposerTrait[]
  runtimeMode: string
  runtimeLabel: string
  runtimeIcon: string
  runtimeDescription: string
  runtimeSelected: number
  runtimeCount: number
  runtimes: ComposerRuntime[]
  // Menu texts to measure, and the menus' widths from the measurements (composer-menus.ts).
  menuProbes: TextProbe[]
  effortMenuWidth: number
  runtimeMenuWidth: number
  effortMenuHeight: number
  runtimeMenuHeight: number
  planVisible: bool
  planActive: bool
  // The prompt drives the ultrathink frame (composer-ultrathink.ts).
  ultrathink: bool
  // Blocks moved into "More composer controls", the cluster hidden below the
  // picker's minimum, and the menu's rows and widths, for the expanded and the resting footer.
  modeOverflow: bool
  traitsOverflow: bool
  restingModeOverflow: bool
  restingTraitsOverflow: bool
  controlsHidden: bool
  restingControlsHidden: bool
  more: ComposerTrait[]
  moreCount: number
  restingMore: ComposerTrait[]
  restingMoreCount: number
  moreMenuWidth: number
  restingMoreMenuWidth: number
  moreMenuHeight: number
  restingMoreMenuHeight: number
  moreX: number
  moreWidth: number
  traitsX: number
  traitsWidth: number
  runtimeX: number
  runtimeWidth: number
  keyEffort: string
  keyMode: string
  attach: bool
  subagent: bool
  subagentModel: string
  subagentEffort: string
  subagentStatus: string
  subagentAnnounce: string
  subagentParent: string

shape PickerRow
  key: string
  kind: string
  id: string
  providerId: string
  name: string
  label: string
  driver: string
  favorite: bool
  selected: bool
  isNew: bool
  index: number
  highlighted: bool
  expanded: bool
  checked: bool
  // getModelDisabledReason: a disabled row cannot be chosen or favorited.
  reason: string
  // modelPicker.jump.N's shortcut ("⌘1") and chord ("Meta+1") on the first nine choosable rows.
  jump: string
  jumpKey: string
shape PickerRail
  id: string
  index: number
  name: string
  driver: string
  ready: bool
  // An instance that needs setup is selectable though not ready.
  selectable: bool
  // The tooltip, and the accessible name of a button that is not ready or locked out.
  label: string
  selected: bool
  providerBadge: string
  providerBadgeColor: string
// ModelPickerContent's setup footer entry: the status message and "Set up X" / "Open provider setup".
shape PickerSetup
  id: string
  message: string
  label: string
shape PickerUpdateNotice
  id: string
  message: string
shape PickerCatalog
  updateRequired: PickerUpdateNotice[]
  environmentId: string
  searching: bool
  provider: string
  favoritesSelected: bool
  count: number
  legacyCount: number
  restCount: number
  restLegacyCount: number
  highlight: number
  highlightKind: string
  highlightId: string
  highlightProvider: string
  models: PickerRow[]
  providers: PickerRail[]
  railIndex: number
  setup: PickerSetup[]
  chatgptSharing: bool
  // The active model is a legacy one: its section starts expanded (expandedLegacyInstances).
  legacyDefault: bool
  // The first row a search highlights (autoHighlight), -1 when none can be chosen.
  firstEnabled: number
  // Shift adds a model to a new thread's draft and keeps the picker open (onToggleModel).
  multiple: bool
// The row the open picker chooses for ("" for the composer) and its trigger's window-space edges.
shape PickerTarget
  id: string
  top: number
  bottom: number
  left: number
