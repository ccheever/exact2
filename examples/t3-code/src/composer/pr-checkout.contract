// PullRequestThreadDialog (T3 Code, MIT; see LICENSE-T3), opened
// from the branch pickers' "Checkout pull request" item (drawn in each picker:
// composer-controls.contract, git.contract). pr-checkout.ts serves it: the item
// opens the dialog (`chatlocal:git-pr-open`), each edit of the field resolves its
// reference (`chatlocal:git-pr-text`), Local and Worktree prepare the checkout
// (`shell:git-pr-checkout`), Cancel, Escape and the backdrop close it.
use PrCheckout from "./pr-checkout-shapes.contract"
use FieldPlaceholder from "../shared/field-placeholder.contract"
use ExtraGlyph from "../details/git.contract"
use ShellIcon from "../shell/shell-icons.contract"
use FocusGuard from "../shared/dialog-trap.contract"
use FieldOpenSelect from "../shared/dialog-trap.contract"

keyframes checkoutSpin
  from rotate=0
  to rotate=360

fn checkoutStateTone(pr: string): string = pr == "Merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : pr == "Closed" ? "light-dark(#71717b, #9f9fa9cc)" : pr == "Open" ? "light-dark(#009966, #5ee9b5e6)" : "light-dark(#71717b, #818181)"

// PullRequestThreadDialog: DialogPopup max-w-xl. The field keeps its own text
// (bound to the reference the dialog opened with); every edit goes to the app.
component CheckoutDialog
  inject
    dialogEntered: action
    dialogFallback: action
  props
    checkout: PrCheckout
    viewportWidth: number
    viewportHeight: number
    dark: bool
    local: action
    command: action
  state focused = true
  action focusField(value: bool)
    focused = value
  derive width = min(576, viewportWidth - 32)
  derive pending = checkout.preparing != ""
  derive dialogTargets = ["pr-checkout-input", "pr-checkout-close"]
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=80 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="pr-checkout-overlay"
      button press=local("git-pr-close", "", "") aria-label="Close" aria-keyshortcuts="Escape" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="pr-checkout-backdrop" title=""
      column width=width max-height="100%" position="relative" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfc, #0b0b0b)" box-shadow=(dark ? "inset 0 1px 0 #ffffff0a, 0 24px 72px -20px #000000e6" : "0 24px 64px -24px #000000a6") overflow="hidden" role="dialog" aria-label=checkout.title testId="pr-checkout-dialog" id="pr-checkout-dialog" tabindex=-1 data-dialog-focus="open" focusin=dialogEntered("pr-checkout-dialog") key=dialogFallback("pr-checkout-dialog", dialogTargets)
        // The focus trap (dialog-trap.contract): the reference field, Cancel, Local, Worktree, then the X.
        FocusGuard(guardId="pr-checkout-guard-start", targets=dialogTargets, popup="pr-checkout-dialog")
        // The field takes the focus with its reference selected as the dialog opens (PullRequestThreadDialog).
        FieldOpenSelect(target="pr-checkout-input", length=checkout.reference.length)
        column gap="0.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="0.75rem" box-sizing="border-box"
          row align-items="center" padding-right="1.5rem"
            box margin-right="0.5rem" display="flex"
              ExtraGlyph(name=checkout.mark, size=16, color="light-dark(#27272a, #f5f5f5)")
            text checkout.title font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text checkout.description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" testId="pr-checkout-description"
        column gap="1rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="0.25rem" padding-bottom="1.5rem" box-sizing="border-box"
          column gap="0.375rem"
            text checkout.label font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            box position="relative" width="100%" height="2rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color=(focused ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow=(focused ? (dark ? "0 0 0 2px #346bf13d" : "0 0 0 2px #1b4ed83d") : "none") box-sizing="border-box"
              input id="pr-checkout-input" testId="pr-checkout-input" value=checkout.reference input=local("git-pr-text", "") submit=command("shell:git-pr-checkout", "worktree", "", 0) focus=focusField(true) blur=focusField(false) autofocus=true placeholder=checkout.placeholder class=FieldPlaceholder aria-label=checkout.label autocorrect="off" spellcheck="false" width="100%" height="1.875rem" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.375rem" padding-bottom="0.25rem" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" box-sizing="border-box" data-focus-stop="enabled" data-editable="yes"
          if checkout.prTitle != ""
            row gap="0.75rem" align-items="flex-start" justify-content="space-between" padding="0.75rem" box-sizing="border-box" border-radius="0.75rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0b)" background-color="light-dark(#f4f4f53d, #ffffff04)" testId="pr-checkout-resolved"
              column min-width=0 flex=1
                text checkout.prTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="pr-checkout-title"
                text checkout.prMeta font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="pr-checkout-meta"
              text checkout.prState font-size="0.75rem" line-height="1rem" flex-shrink=0 color=checkoutStateTone(checkout.prState) testId="pr-checkout-state"
          if checkout.resolving
            row gap="0.5rem" align-items="center" testId="pr-checkout-resolving"
              box width="0.875rem" height="0.875rem" display="flex" animation="checkoutSpin 1s linear infinite"
                ExtraGlyph(name="loader-circle", size=14, color="light-dark(#71717b, #818181)")
              text checkout.resolvingLabel font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          if checkout.error != ""
            text checkout.error font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)" role="alert" testId="pr-checkout-error"
        row gap="0.5rem" justify-content="flex-end" align-items="center" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#f9f9f9b8, #ffffff06)"
          CheckoutButton(label="Cancel", primary=false, disabled=pending, press=local("git-pr-close", "", ""), testId="pr-checkout-cancel")
          CheckoutButton(label=(checkout.preparing == "local" ? "Preparing local..." : "Local"), primary=false, disabled=(not checkout.canConfirm), press=command("shell:git-pr-checkout", "local", "", 0), testId="pr-checkout-local")
          CheckoutButton(label=(checkout.preparing == "worktree" ? "Preparing worktree..." : "Worktree"), primary=true, disabled=(not checkout.canConfirm), press=command("shell:git-pr-checkout", "worktree", "", 0), testId="pr-checkout-worktree")
        button id="pr-checkout-close" press=local("git-pr-close", "", "") aria-label="Close" testId="pr-checkout-close" position="absolute" top="0.5rem" right="0.5rem" width="2rem" height="2rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" title="" data-focus-stop="enabled"
          ShellIcon(name="x", size=16, color="light-dark(#71717b, #818181)")
        FocusGuard(guardId="pr-checkout-guard-end", targets=dialogTargets, popup="pr-checkout-dialog")

// Button size="sm" (outline or default).
component CheckoutButton
  props
    label: string
    primary: bool
    disabled: bool
    press: action
    testId: string
  view
    button press=press disabled=disabled testId=testId display="flex" flex-direction="row" align-items="center" justify-content="center" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 opacity=(disabled ? 0.64 : 1) border-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") background-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#ffffff, #ffffff07)")
      text label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=(primary ? "#ffffff" : "light-dark(#27272a, #f5f5f5)") white-space="nowrap"
