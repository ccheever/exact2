  action promptPreviewMounted
    let serial = promptPreviewSerial + 1
    promptPreviewSerial = serial
    observePromptPreview(promptPreviewText, promptPreviewStart, promptPreviewEnd, promptPreviewComposing, serial)
  action observePromptPreview(value: string, start: number, end: number, composing: bool, serial: number)
    send chipObserved = composerChipObserved(ComposerFieldObservation(generation=richPromptPreview.generation, snapshotOwner=data.snapshotOwner, owner=promptPreviewOwner, value=value, start=min(value.length, start), end=min(value.length, end), composing=composing, live=(promptPreviewVisible and frame("prompt-font-preview").width > 0), focused=false, inputSerial=serial))
  task promptPreviewHidden when not promptPreviewVisible
    after(1, promptPreviewReset)
  action promptPreviewReset
    let value = promptPreviewSample()
    let serial = promptPreviewSerial + 1
    promptPreviewText = value
    promptPreviewInputType = ""
    promptPreviewComposing = false
    promptPreviewStart = 0
    promptPreviewEnd = 0
    promptPreviewSerial = serial
    observePromptPreview(value, 0, 0, false, serial)
  action closeOptions
    optionsOpen = ""
    focus("composer")
  // The trigger a composer menu opens from, measured as it opens and again with the layout frames while it is open:
  // ComposerMenus aligns the menu to its start, or its end (the implement pill, the meter). -1 while the trigger is not
  // laid out (a shortcut for a control in the overflow).
  state optionsAnchorX = -1
  state optionsAnchorWidth = 0
  // The window-space boxes the TypeScript layouts read, by name (src/shell/layout-frames.ts): the composer's drawer
  // and overlay, its menus' rows, the chat canvas and the thread details card, the device tools. Each box's `resize`
  // measures them all again, so a box that only moves is measured with the box whose change of size moved it.
  state layoutFrames = ""
  action frameMoved(w: number, h: number)
    layoutFrames = [layoutFrame("chat", frame("frame-chat")), layoutFrame("overlay", frame("frame-overlay")), layoutFrame("shoulder", frame("frame-shoulder")), layoutFrame("dock", frame("frame-dock")), layoutFrame("stack", frame("frame-stack")), layoutFrame("card", frame("composer-surface")), layoutFrame("subagent", frame("provider-subagent-bar")), layoutFrame("toolbar", frame("frame-toolbar")), layoutFrame("strip", frame("frame-strip")), layoutFrame("details-content", frame("frame-details-content")), layoutFrame("details-density-compact", frame("frame-details-density-compact")), layoutFrame("details-full-top", frame("frame-details-full-top")), layoutFrame("details-vcs", frame("frame-details-vcs")), layoutFrame("details-full-tail", frame("frame-details-full-tail")), layoutFrame("details-lineage", frame("frame-details-lineage")), layoutFrame("details-full-git", frame("frame-details-full-git")), layoutFrame("details-pr-list", frame("frame-details-pr-list")), layoutFrame("device-area", frame("frame-device-area"))].filter((row) => row != "").join(";")
    if optionsOpen != ""
      measureOptionsTrigger(optionsOpen)
  action measureOptionsTrigger(name: string)
    let trigger = frame(optionsTriggerId(name))
    optionsAnchorX = trigger.unavailable or trigger.width <= 0 ? -1 : trigger.x
    optionsAnchorWidth = trigger.unavailable ? 0 : trigger.width
  action openOptions(name: string)
    measureOptionsTrigger(name)
    focus(optionsOpen == name ? "composer" : name == "effort" ? "composer-menu" : name == "runtime" ? `composer-menu-item-${data.composer.runtimeSelected}` : name == "branch" ? "branch-search" : name == "workspace" ? "composer-menu" : "composer-menu-item-0")
    optionsOpen = optionsOpen == name ? "" : name
    branchQuery = ""
    modelsOpen = false
    popoverSession = popoverSession + 1
  action menuCommand(op: string, id: string, value: string, n: number)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, n)
  action searchBranches(value: string)
    branchQuery = value
  action composerKey(op: string, id: string, value: string) // A composer control's key name (composer-controls-commands.ts).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, value, 0)
  action composerDrop(op: string, id: string, vx: number, vy: number) // A queued row's grip released (pan release).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, "", 0)
  action menuPick(op: string, id: string, value: string)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, 0)
