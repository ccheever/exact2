        )
        // A skill chip's details (composer-chip-popover.contract), above every page, the Settings prompt sample's chip included.
        if chipShown and chip.kind != "citation"
          ChipPopoverLayer(
            chip=chip,
            viewportWidth=viewport.width,
            viewportHeight=viewport.height,
            instructions=chipClose(true)
          )
        // Cite at the selection in an answer (diff-cite.contract), above the timeline's rows.
        if citeShows
          CiteAction(
            offer=citeOffer,
            viewportWidth=viewport.width,
            viewportHeight=viewport.height,
            press=citePress,
            dismiss=citeWithdraw(citeOffer.source)
          )
        // A citation chip's comment, under the cited text after Cite or above the chip's button.
        if citeShown
          CitationCommentLayer(
            chip=chip,
            draft=citeText,
            viewportWidth=viewport.width,
            viewportHeight=viewport.height,
            edit=citeEdit,
            save=citeSave,
            cancel=citeCancel,
            settle=citeSettle
          )
        // The window's hover layer (hover-layer.contract), above every page and panel, below the SSH prompt.
        // The Usage page draws its own segment card in its scroll content (pages-usage.contract).
        if hoverShown and rootUi.hoverState.tip.kind != "usage"
          HoverLayer(
            tip=rootUi.hoverState.tip,
            viewportWidth=viewport.width,
            viewportHeight=viewport.height,
            hoverAt=actHoverTipAt
          )
            if rootUi.hoverState.tip.kind == "freshness"
              PaFreshnessCard(
                actions=prDetail.actions,
                scheme=scheme,
                act=prAct,
                keep=actHoverTipAt(rootUi.hoverState.tip, "card"),
                testId=rootUi.hoverState.tip.testId
              )
            else if rootUi.hoverState.tip.kind == "pr-preview"
              PrLinkPreviewCard(preview=prDetail.preview, href=rootUi.hoverState.tip.text)
            else if rootUi.hoverState.tip.kind == "pr-badge"
              // Held to the larger room the layer can flip into, less its 4 pt offset.
              StripPrTipCard(
                tips=branches.prTips,
                maxHeight=(max(rootUi.hoverState.tip.y - 61, viewport.height - rootUi.hoverState.tip.y - rootUi.hoverState.tip.height - 9) - 4),
                testId=rootUi.hoverState.tip.testId,
                command=actCommand
              )
            else if rootUi.hoverState.tip.kind == "workflow-member"
              WorkflowMemberCard(tip=rootUi.hoverState.tip)
            else if rootUi.hoverState.tip.kind == "scopes"
              HoverScopes(tip=rootUi.hoverState.tip)
            else if rootUi.hoverState.tip.kind == "code"
              HoverCode(tip=rootUi.hoverState.tip)
            else
              HoverText(tip=rootUi.hoverState.tip)
      // Separate close/open layouts preserve replacement focus lineage without a child-owned timer.
      box aria-hidden=true
        resize=syncDocumentPermissionFocus
        position="absolute"
        left=0
        top=0
        width=documentPermissionFocusWidth
        height=1
        opacity=0
        pointer-events="none"
      SshPasswordPrompt(
        prompt=sshPrompt,
        responding=rootUi.sshResponse.responding,
        answer=actSshAnswer
      )
      for document in activeDocumentPermissions key = `${document.key}:${document.permissionSerial}`
        AppConfirm(
          title=document.permission.split("\n").slice(0, 1).join(""),
          body=document.permission.split("\n").slice(1).join("\n"),
          destructive=false,
          busy=false,
          confirmId=documentPermissionOwner,
          confirmLabel="Confirm",
          cancel=actChatLocal("inline-doc-permission", document.key, `${document.permissionSerial}:deny`),
          confirm=actChatLocal("inline-doc-permission", document.key, `${document.permissionSerial}:allow`)
        )
