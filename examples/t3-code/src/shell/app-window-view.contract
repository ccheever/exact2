  view
    main navigationKey="t3-code"
      navigationBack=""
      navigate=promptLinkNavigate
      testId="t3-code"
      -exact-menu-remove="show-tab-bar show-all-tabs"
      focusin=windowFocused
      focusout=windowBlurred
      keycapture=modifierDown
      keyup=modifierUp
      paste=modifiersPasted
      tabindex=-1
      pointerdown=outsidePressDown
      pointerup=outsidePressUp
      viewport-fit="cover"
      width="100%"
      height="100%"
      position="relative"
      display="flex"
      flex-direction="row"
      overflow="hidden"
      class=Canvas
      background-color=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas)
      font-family=settingsCore.interfaceFont
      color=(settingsCore.palette.text == "" ? "light-dark(#27272a, #f5f5f5)" : settingsCore.palette.text)
      id="t3-code"
      data-paint="canvas text"
      data-pick=(("canvas" == "" ? "" : "canvas") != "" ? ("canvas" == "" ? "" : "canvas") : (("text" == "" ? "" : "text") != "" ? ("text" == "" ? "" : "text") : ""))
      // Save file's target (app.contract saveNow): the Save panel's chosen name or dismissal lands here.
      input id="save-file"
        testId="save-file"
        display="none"
        change=saveChosen
        cancel=saveDismissed
        autocorrect="off"
      // The skill chip details' Escape, the window's first node so it is the oldest shortcut that declares Escape
      // (composer-chip-popover.contract ChipPopoverEscape); outside the SSH prompt's inert
      // background, so it gives the key up while the prompt shows, as the details under it did.
      ChipPopoverEscape(
        held=(chipShown and not (sshPrompt.open or activeDocumentPermissions.length > 0 or rootUi.paletteSession.open or rootUi.composerMenu.modelsOpen or rootUi.composerMenu.optionsOpen != "" or projectsOpen or rootUi.confirmationState.op != "")),
        dismiss=chipEscape
      )
      // View › Reload and Force Reload, outside the inert background: the reference's work under any dialog.
      ViewReload(items=shortcuts)
      row width="100%"
        height="100%"
        min-width=0
        position="relative"
        inert=(sshPrompt.open or activeDocumentPermissions.length > 0)
        testId="ssh-background"
        // Inert under the composer's file and image previews too: their trap passes over buttons with Keyboard
        // Navigation off (dialog-trap.contract ControlGuard), so nothing behind them may be a Tab stop.
        row width="100%"
          height="100%"
          min-width=0
          inert=(modal or shell.panel.deviceSetup or shell.composerFile.open or data.composerImagePreview.length > 0)
          if data.sidebarOpen
            if data.legacy.enabled
              LegacySidebar(
                data=data,
                shell=shell,
                reduced=viewport.prefersReducedMotion,
                now=(wallTime.epochAtZero + max(liveNow, elapsed)),
                width=sidebarWidth,
                busy=commandPending,
                keySidebar=settings.keySidebar,
                page=utilityPage,
                pullRequests=home.pullRequests,
                toggle=toggleSidebar,
                addProject=actPaletteShow("command", "add-project"),
                openPalette=actPaletteShow("command", ""),
                open=actOpenThread,
                local=actSidebarLocal,
                run=actSidebarRun,
                openSettings=actOpenSettings,
                navigate=actOpenPage,
                openProviders=actOpenProviderSettings,
                hoverCard=sidebarHover,
                hoverId=sidebarHoverId,
                focusWithin=sidebarFocusWithin
              )
            else
              Sidebar(
                data=data,
                shell=shell,
                reduced=viewport.prefersReducedMotion,
                now=(wallTime.epochAtZero + max(liveNow, elapsed)),
                width=sidebarWidth,
                busy=commandPending,
                keySidebar=settings.keySidebar,
                keyNewThread=settings.keyNewThread,
                toggle=toggleSidebar,
                search=search,
                openProjects=actOpenProjects,
                addProject=actPaletteShow("command", "add-project"),
                newThread=actSidebarNewThread,
                select=actSelectThread,
                openSettings=actOpenSettings,
                openConnection=openConnection,
                reconnect=actCommand("reconnect", "", "", 0),
                resize=actResizeSidebar,
                finishResize=finishResize,
                command=actCommand,
                page=utilityPage,
                pullRequests=home.pullRequests,
                navigate=actOpenPage,
                local=actSidebarLocal,
                run=actSidebarRun,
                open=actOpenThread,
                resetWidth=actResetSidebarWidth,
                hoverCard=sidebarHover,
                pressDown=sidebarPressDown,
                hoverId=sidebarHoverId,
                hoverSeq=sidebarHoverSeq,
                openProviders=actOpenProviderSettings,
                scrolled=sidebarScrolled,
                drag=sidebarDrag,
                dragEnd=sidebarDragEnd,
                dragId=shelfDragId,
                dragTarget=dragTarget,
                dragVerb=dragVerb,
                dragOffset=dragOffset,
                scrollY=sidebarScrollY,
                focusWithin=sidebarFocusWithin
              )
          column flex=1 min-width=0 height="100%" // the drawer sits below the chat column, the composer above it
            ChatColumn(
              noticeExit=rootUi.noticeExitState.notice,
              noticeDismiss=actNoticeDismiss,
              pageCover=(pageCover or promptLinkPage.show),
              sidebarWidth=sidebarWidth,
              canvas=canvas,
              canvasGesture=actCanvasGesture,
              detailsOutside=detailsPlayerPointer,
              viewport=viewport,
              scheme=scheme,
              data=data,
              shell=shell,
              settings=settings,
              rightPanel=(rightPanel or shell.panel.open),
              narrowDiff=narrowDiff,
              detailsOpen=detailsOpen,
              details=details,
              titleMenuOpen=titleMenuOpen,
              renaming=renaming,
              renameText=renameText,
              panelUi=panelUi,
              detailsAct=detailsAct,
              titleUi=titleUi,
              home=home,
              commandPending=commandPending,
              lineageStopping=lineageStopping,
              command=actCommand,
              paletteShow=actPaletteShow,
              foldHold=foldHold,
              releaseFold=actReleaseFold,
              jumpRequest=jumpRequest,
              composerOwner=composerOwner,
              canRest=canRest,
              chatLocal=actChatLocal,
              markdown=markdown,
              earlier=actEarlier,
              attachmentUrls=attachmentUrls,
              settingsCore=settingsCore,
              conversationWidth=conversationWidth,
              resting=resting,
              scrollToEnd=actScrollToEnd,
              editor=editor,
              composerKey=actComposerKey,
              composerDrop=actComposerDrop,
              editorOp=editorOp,
              selectThread=actSelectThread,
              openModels=actOpenModels,
              composerText=composerText,
              modelsOpen=rootUi.composerMenu.modelsOpen,
              optionsOpen=rootUi.composerMenu.optionsOpen,
              write=actWrite,
              send=actSend,
              stop=actCommand("stop", "", "", 0),
              composerFocus=actComposerFocus,
              composerBlur=actComposerBlur,
              openOptions=actOpenOptions,
              removeSnapshot=actRemoveSnapshot,
              askRemove=titleMenuPick,
              interaction=menuPick("interaction", ""),
              openProviderSettings=actOpenProviderSettings,
              branches=branches,
              timelineNow=(wallTime.epochAtZero + max(liveNow, elapsed)),
              contextOver=(dragTarget == "context" and editor.drawer.cardWidth > 0 and dragCX >= editor.drawer.cardX and dragCX <= editor.drawer.cardX + editor.drawer.cardWidth and dragCY >= editor.drawer.cardY and dragCY <= editor.drawer.cardY + editor.drawer.cardHeight)
            )
            TerminalDrawer(
              view=terminalDrawer,
              look=data.look,
              dark=(scheme == "dark"),
              viewportHeight=viewport.height,
              composerHeight=data.composerReserved,
              reduced=viewport.prefersReducedMotion,
              closePending=(rootUi.confirmationState.op != ""),
              command=actCommand,
              confirm=titleMenuPick
            )
          RightPanels(
            data=data,
            narrowDiff=narrowDiff,
            rightMaximized=rightMaximized,
            viewport=viewport,
            scheme=scheme,
            sidebarWidth=sidebarWidth,
            diffWidth=diffWidth,
            shell=shell,
            command=actCommand,
            panelUi=panelUi,
            resizeDiff=resizeDiff,
            finishDiffResize=finishDiffResize,
            rightPanel=(rightPanel or shell.panel.open),
            detailsOpen=detailsOpen,
            detailsAct=detailsAct,
            chatLocal=actChatLocal,
            paletteShow=actPaletteShow,
            prDetail=prDetail,
            prDocuments=prMarkdown.documents,
            filesDocuments=filesMarkdown.documents,
            prTab=prTab,
            prSetTab=prSetTab,
            prReload=prReload,
            prAct=prAct,
            prCopy=actPrCopy,
            confirm=titleMenuPick,
            closePending=(rootUi.confirmationState.op != "")
          )
        PagesCover(
          pageCover=pageCover,
          outside=outsidePresses,
          data=data,
          sidebarWidth=sidebarWidth,
          modal=modal,
          utilityPage=utilityPage,
          viewport=viewport,
          scheme=scheme,
          usage=usage,
          usageShortcuts=usageShortcuts,
          settings=settings,
          usageMetricSet=actUsageMetricSet,
          usageWindowSet=actUsageWindowSet,
          usageBreakdownSet=usageBreakdownSet,
          usageRefreshNow=usageRefreshNow,
          pageBack=actPageBack,
          prList=prList,
          prTyped=prTyped,
          prQuery=prQuery,
          prSelected=prSelected,
          prPanelOpen=prPanelOpen,
          prTogglePanel=actPrTogglePanel,
          prType=actPrType,
          prControl=actPrControl,
          prSelect=prSelect,
          prReload=prReload,
          paletteShow=actPaletteShow,
          prDetail=prDetail,
          prMarkdown=prMarkdown,
          prTab=prTab,
          prSetTab=prSetTab,
          prClose=actPrClose,
          prAct=prAct,
          prCopy=actPrCopy,
          chatLocal=actChatLocal,
          home=home,
          commandPending=commandPending,
          command=actCommand,
          openConnectionsPage=actOpenConnectionsPage,
          pagesOp=actWelcomeImport,
          toggleInert=(modal or shell.panel.deviceSetup or shell.composerFile.open or data.composerImagePreview.length > 0),
          toggleSidebar=toggleSidebar
        )
        if not rootUi.settingsPageState.open and utilityPage == "" and not welcome.show
          PromptLinkPage(
            link=promptLinkPage,
            left=(data.sidebarOpen ? sidebarWidth : 0),
            canvas=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas),
            run=actPromptLinkAct
          )
        RightSheets(
          data=data,
          narrowDiff=narrowDiff,
          modal=(modal or promptLinkPage.show),
          panelUi=panelUi,
          viewport=viewport,
          scheme=scheme,
          diffWidth=diffWidth,
          shell=shell,
          command=actCommand,
          resizeDiff=resizeDiff,
          finishDiffResize=finishDiffResize,
          rightPanel=(rightPanel or shell.panel.open),
          detailsOpen=detailsOpen,
          detailsAct=detailsAct,
          chatLocal=actChatLocal,
          paletteShow=actPaletteShow,
          prDetail=prDetail,
          prDocuments=prMarkdown.documents,
          filesDocuments=filesMarkdown.documents,
          prTab=prTab,
          prSetTab=prSetTab,
          prReload=prReload,
          prAct=prAct,
          prCopy=actPrCopy,
          confirm=titleMenuPick,
          closePending=(rootUi.confirmationState.op != "")
        )
        if rootUi.composerMenu.optionsOpen != ""
          ComposerMenus(
            data=data,
            session=rootUi.composerMenu.popoverSession,
            which=rootUi.composerMenu.optionsOpen,
            left=composerLeft,
            viewport=viewport,
            resting=resting,
            close=actCloseOptions,
            chooseTrait=menuPick("model-option"),
            chooseRuntime=menuPick("runtime", ""),
            command=menuCommand,
            branches=branches,
            branchQuery=branchQuery,
            searchBranches=actSearchBranches,
            local=actChatLocal
