// A thread's pull request surface remembers its tab (rightPanelStore setPullRequestDetailTab):
// a choice there is kept with the surface, and showing that surface again, in its thread, shows it.
fn stepPrSetTab(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = transitionPrSetTabGuard2(
  transitionPrSetTabWrites1(
    d,
    s,
    value
  ),
  s,
  value
)

fn transitionPrSetTabWrites1(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writePrTab=true,
    prTab=value
  )
)

fn transitionPrSetTabWrites3(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendPrTabSaved=true,
    tabSave=CommandArgs(
      p0="shelllocal:surface-pr-tab",
      p1=s.shell.panel.pr.surface,
      p2=value,
      p3=0
    )
  )
)

fn transitionPrSetTabGuard2(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = (
  s.utilityPage == "" and s.shell.panel.kind == "pull-request" and s.shell.panel.pr.surface != ""
  ? transitionPrSetTabWrites3(
    d,
    s,
    value
  )
  : d
)

