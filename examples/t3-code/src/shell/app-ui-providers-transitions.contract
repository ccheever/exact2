// the window's half: the dialog label, the row menu
fn stepRestOpen(
  d: UiDecision,
  s: UiStart,
  editor: string,
  subject: string
): UiDecision = transitionRestOpenWrites1(
  d,
  s,
  editor,
  subject
)

fn transitionRestOpenWrites1(
  d: UiDecision,
  s: UiStart,
  editor: string,
  subject: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSbQuery=true,
    sbQuery="",
    writeSbLettersEdited=true,
    sbLettersEdited=false,
    writeSbEmoji=true,
    sbEmoji="",
    writeRestEditor=true,
    restEditor=editor,
    writeRestSubject=true,
    restSubject=subject,
    writeModalError=true,
    modalError="",
    writeTaskBase=true,
    taskBase=""
  ),
  writeTaskModelPick=true,
  taskModelPick=""
)

// a settings editor's command, also as rest and restInput (T3Window)
fn stepRestRaw(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionRestRawGuard1(
  d,
  s,
  op,
  id,
  value
)

fn transitionRestRawWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    writePendingModal=true,
    pendingModal="rest",
    writeModalError=true,
    modalError="",
    changedKind="command",
    command=CommandArgs(
      p0=op,
      p1=id,
      p2=value,
      p3=0
    ),
    writeKeybindingEditor=true,
    keybindingEditor=KeybindingEditorState(
      d.root.keybindingEditor,
      saving=""
    )
  )
)

fn transitionRestRawGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  not s.commandPending
  ? transitionRestRawWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

