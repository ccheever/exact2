): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writePrSearch=true,
    prQuery=value,
    writePrApplied=true,
    prApplied=value,
    prTyped=true
  )
)

fn transitionPrControlGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  value: string
): UiDecision = (
  op == "query"
  ? transitionPrControlWrites2(
    d,
    s,
    op,
    value
  )
  : d
)

fn transitionPrControlWrites3(
  d: UiDecision,
  s: UiStart,
  op: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendLocalChanged=true,
    local=CommandArgs(
      p0=`pageslocal:pr-${op}`,
      p1="",
      p2=value,
      p3=0
    )
  )
)

