// a route reached without a provider link names no instance
fn stepCoreNavigate(
  d: UiDecision,
  s: UiStart,
  route: string
): UiDecision = transitionCoreNavigateWrites4(
  transitionCoreNavigateGuard2(
    transitionCoreNavigateWrites1(
      d,
      s,
      route
    ),
    s,
    route
  ),
  s,
  route
)

fn transitionCoreNavigateWrites1(
  d: UiDecision,
  s: UiStart,
  route: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderLinkTarget=true,
    providerLinkTarget="",
    writeSettingsPageState=true,
    settingsPageState=SettingsPageState(
      d.root.settingsPageState,
      route=route
    )
  )
)

fn transitionCoreNavigateWrites3(
  d: UiDecision,
  s: UiStart,
  route: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSettingsMachine=true,
    settingsMachine=s.settings.environmentId,
    writeSettingsWorkspace=true,
    settingsProjectKey="",
    settingsCheckout="",
    writeSettingsProjectId=true,
    settingsProjectId=""
  )
)

fn transitionCoreNavigateGuard2(
  d: UiDecision,
  s: UiStart,
  route: string
): UiDecision = (
  route == "diagnostics" and s.settings.environmentId != ""
  ? transitionCoreNavigateWrites3(
    d,
    s,
    route
  )
  : d
)

fn transitionCoreNavigateWrites4(
  d: UiDecision,
  s: UiStart,
  route: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSettingsMenu=true,
    settingsMenu="",
    writeModalError=true,
    modalError="",
    writeSettingsPageState=true,
    settingsPageState=SettingsPageState(
      d.root.settingsPageState,
      query=""
    )
  )
)

