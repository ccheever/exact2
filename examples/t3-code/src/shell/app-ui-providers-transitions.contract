use AppDecision, CommandArgs, TextArgs from "./app-decisions.contract"
use KeybindingEditorState, ProviderWizardState, SettingsPageState from "./app-protocols.contract"
use UiDecision from "./app-ui-decisions.contract"
use UiStart from "./app-ui-start.contract"

// the window's half: whether the wizard tried to go on
// the window's half marks the attempt
fn stepProviderUi(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = transitionProviderUiGuard16(
  transitionProviderUiGuard14(
    transitionProviderUiGuard12(
      transitionProviderUiGuard10(
        transitionProviderUiGuard8(
          transitionProviderUiGuard6(
            transitionProviderUiGuard4(
              transitionProviderUiGuard2(
                transitionProviderUiWrites1(
                  d,
                  s,
                  what,
                  value
                ),
                s,
                what,
                value
              ),
              s,
              what,
              value
            ),
            s,
            what,
            value
          ),
          s,
          what,
          value
        ),
        s,
        what,
        value
      ),
      s,
      what,
      value
    ),
    s,
    what,
    value
  ),
  s,
  what,
  value
)

fn transitionProviderUiWrites1(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeModalError=true,
    modalError="",
    writeProviderSelected=true,
    providerSelected=what == "select" ? value : s.providerSelected
  )
)

fn transitionProviderUiWrites3(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      dialog=value,
      serial=s.providerWizardState.serial + 1,
      driver="codex",
      label="",
      labelSet=false,
      id="",
      idSet=false,
      step=0,
      manual=false,
      acpQuery=""
    )
  )
)

fn transitionProviderUiGuard2(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "open"
  ? transitionProviderUiWrites3(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites5(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      dialog=""
    )
  )
)

fn transitionProviderUiGuard4(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "close"
  ? transitionProviderUiWrites5(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites7(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      dialog=what,
      target=value
    )
  )
)

fn transitionProviderUiGuard6(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "hub-remove" or what == "setup-logout" or what == "setup-remove"
    or what == "codex-picker" or what == "acp-delete" or what == "acp-disable"
  ? transitionProviderUiWrites7(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites9(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      driver=what == "driver" ? value : s.providerWizardState.driver,
      manual=what == "manual" and value == "true",
      labelSet=false,
      idSet=false
    )
  )
)

fn transitionProviderUiGuard8(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "driver" or what == "manual"
  ? transitionProviderUiWrites9(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites11(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      label=value,
      labelSet=true
    )
  )
)

fn transitionProviderUiGuard10(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "label"
  ? transitionProviderUiWrites11(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites13(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      id=value,
      idSet=true
    )
  )
)

fn transitionProviderUiGuard12(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "id"
  ? transitionProviderUiWrites13(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites15(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      acpQuery=value
    )
  )
)

fn transitionProviderUiGuard14(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "acp"
  ? transitionProviderUiWrites15(
    d,
    s,
    what,
    value
  )
  : d
)

fn transitionProviderUiWrites17(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      step=s.providerWizardState.step <= 1 and (value == "back" ? max(0,
        s.providerWizardState.step - 1) : min(s.providerWizardState.manual ? 1 : 2,
        value == "next" ? s.providerWizardState.step + 1 : (value == "2" ? 2 : (value == "1" ? 1
        : 0)))) > 1 and s.providerWizard.idError != "" ? 1 : (value == "back" ? max(0,
        s.providerWizardState.step - 1) : min(s.providerWizardState.manual ? 1 : 2,
        value == "next" ? s.providerWizardState.step + 1 : (value == "2" ? 2 : (value == "1" ? 1
        : 0))))
    )
  )
)

fn transitionProviderUiGuard16(
  d: UiDecision,
  s: UiStart,
  what: string,
  value: string
): UiDecision = (
  what == "step"
  ? transitionProviderUiWrites17(
    d,
    s,
    what,
    value
  )
  : d
)

