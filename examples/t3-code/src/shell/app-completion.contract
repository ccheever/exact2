fn decideAnnotationSendNow(
  commandPending: bool,
  composerDraft: ComposerDraftState,
  composerText: string,
  data: Snapshot,
  jumpRequest: number,
  richComposer: ComposerRichView,
  richComposerOwner: string,
  shell: ShellView
): AppDecision =
  completeAnnotationSendNow(
    AppDecision(initialAppDecision(),
      composerDraft=composerDraft
    ),
    commandPending,
    composerDraft.composing,
    composerText,
    data,
    jumpRequest,
    richComposer,
    richComposerOwner,
    shell
  )

fn decideAutomationRecordingNow(
  shell: ShellView
): AppDecision =
  completeAutomationRecordingNow(
    initialAppDecision(),
    shell
  )

fn decideChipActRun(
  chip: ChipPopover,
  wallTime: Time
): AppDecision =
  completeChipActRun(
    initialAppDecision(),
    chip,
    wallTime
  )

fn decideCiteBegin(
  citationPlacement: CitationPlacementState,
  data: Snapshot
): AppDecision =
  completeCiteBegin(
    AppDecision(initialAppDecision(),
      citationPlacement=citationPlacement
    ),
    data
  )

fn decideCodeRevealOpen(
  prDetail: PrDetailView,
