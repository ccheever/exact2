fn decideCommandCompleted(
  bindings: KeybindingPage,
  changed: option<Change>,
  confirmationState: ConfirmationState,
  data: Snapshot,
  jumpRequest: number,
  noticeExitState: NoticeExitState,
  pageTrail: string[],
  paletteSession: PaletteSessionState,
  pendingModal: string,
  providerWizardState: ProviderWizardState,
  renameAfterId: string,
  renameAfterOp: string,
  restEditor: string,
  restSubject: string,
  routeKeyboard: RouteKeyboard,
  routeKeyboardOwned: bool,
  settings: Settings,
  settingsPageState: SettingsPageState,
  utilityPage: string,
  welcomePaired: number,
  keybindingEditor: KeybindingEditorState,
  composerMenu: ComposerMenuState,
  composerDraft: ComposerDraftState
): AppDecision =
  completeCommandCompleted(
    AppDecision(initialAppDecision(),
      confirmationState=confirmationState,
      noticeExitState=noticeExitState,
      paletteSession=paletteSession,
      providerWizardState=providerWizardState,
      keybindingEditor=keybindingEditor,
      composerMenu=composerMenu,
      composerDraft=composerDraft,
      settingsPageState=settingsPageState
    ),
    bindings,
    changed,
    data,
    jumpRequest,
    keybindingEditor.drafts,
    keybindingEditor.open,
    keybindingEditor.previous,
    keybindingEditor.recording,
    keybindingEditor.saving,
    pageTrail,
    pendingModal,
    providerWizardState,
    renameAfterId,
    renameAfterOp,
    restEditor,
    restSubject,
    routeKeyboard,
    routeKeyboardOwned,
    settings,
    settingsPageState.refresh,
    utilityPage,
    welcomePaired
  )

fn decideComposerEditDone(
  commandPending: bool,
  composerEdited: option<ComposerIntentReply>,
  composerIntentBaseCurrent: bool,
  composerRichCurrent: bool,
  composerText: string,
  data: Snapshot,
  editor: ComposerEditorView,
  intentState: ComposerIntentState,
  jumpRequest: number,
  richComposer: ComposerRichView,
  richComposerOwner: string,
  composerDraft: ComposerDraftState
): AppDecision =
  completeComposerEditDone(
    AppDecision(initialAppDecision(),
      intentState=intentState,
      composerDraft=composerDraft
    ),
    commandPending,
    composerEdited,
    composerIntentBaseCurrent,
    composerRichCurrent,
    composerText,
    data,
    editor,
    intentState,
    jumpRequest,
    richComposer,
    richComposerOwner
  )

fn decideComposerFieldAckDone(
  commandPending: bool,
  composerDraft: ComposerDraftState,
  composerFieldAck: option<ComposerFieldAcknowledgement>,
  composerSelection: ComposerSelectionState,
  composerSelectionCurrent: bool,
  composerText: string,
  data: Snapshot,
  editor: ComposerEditorView,
  fieldProtocol: ComposerFieldProtocol,
  jumpRequest: number,
  richComposer: ComposerRichView,
  richComposerOwner: string,
  composerMenu: ComposerMenuState
): AppDecision =
  completeComposerFieldAckDone(
    AppDecision(initialAppDecision(),
      fieldProtocol=fieldProtocol,
      composerMenu=composerMenu,
      composerDraft=composerDraft
    ),
    commandPending,
    composerDraft.composing,
    composerFieldAck,
    composerSelection,
    composerSelectionCurrent,
    composerText,
    data,
    editor,
    fieldProtocol,
    jumpRequest,
    composerMenu.modelsOpen,
    composerMenu.popoverSession,
    richComposer,
    richComposerOwner
  )

