use ThreadFindView, ThreadFindBar from "../timeline/thread-find.contract"
use SettingsCore from "../settings/settings-core.contract"
use Settings from "../shared/shapes.contract"
use Snapshot from "../shared/shapes.contract"
use ComposerCard from "../composer/composer.contract"
use ComposerEditorDock from "../composer/composer-editor.contract"
use ComposerDrawerLayer from "../composer/composer-editor.contract"
use StashBadge from "../composer/composer-editor.contract"
use ComposerEditorView from "../composer/composer-editor.contract"
use ComposerDock from "../composer/composer-controls.contract"
use ComposerStrip from "../composer/composer-controls.contract"
use SubagentBar from "../composer/composer-controls.contract"
use ComposerBranches from "../composer/composer-shapes.contract"
use Viewport from "../shared/shapes.contract"
use ChatHeader from "../timeline/chat.contract"
use AlertStack from "../timeline/chat.contract"
use EmptyThread from "../pages/pages-hero.contract"
use HeroWidthProbe from "../pages/pages-hero.contract"
use PagesLanding from "../pages/pages-hero.contract"
use PagesHome from "../pages/pages-hero.contract"
use UsagePage from "../usage/pages-usage.contract"
use AppRouteModal, routeModalWidth from "./app-route-modal.contract"
use UsageView from "../usage/pages-usage.contract"
use UsageKey from "../usage/pages-usage.contract"
use UsagePricesLayer from "../usage/pages-usage-dialogs.contract"
use UsageModelLayer from "../usage/pages-usage-dialogs.contract"
use ResetCreditDialog from "../usage/usage-bars.contract"
use SidebarToggle from "../sidebar/sidebar-toggle.contract"
use PrList from "../pull-requests/pages-prs.contract"
use PgIcon from "../shared/pages-icons.contract"
use PrListView from "../pull-requests/pages-prs.contract"
use PrPanel from "../pull-requests/pages-pr-detail.contract"
use PrDetailView from "../pull-requests/pages-pr-detail.contract"
use ScrollToEnd from "../timeline/chat.contract"
use TranscriptMarkdown, ChatDocument from "../timeline/markdown.contract"
use TimelineRow from "../timeline/timeline.contract"
use TimelineFade from "../timeline/timeline.contract"
use TimelineMinimap, turnRunStart, turnRunEnd, turnBefore from "../timeline/timeline-minimap.contract"
use TimelineAnchor, anchorOf, anchorKept, anchorKey from "../timeline/timeline-anchor.contract"
use TimelineAttachmentUrls from "../timeline/timeline-attachments.contract"
use RequestBanner from "../composer/requests.contract"
use RequestActions from "../composer/requests.contract"
use DiffPanel from "../diff/diff.contract"
use ShellView from "./shell-shapes.contract"
use SurfacePanel from "./shell-panels.contract"
use DeviceMiniPlayer from "../device/device-workspace.contract"
use BrowserMiniPlayer from "../browser/browser-capture.contract"
use ChatCanvasView from "./chat-canvas.contract"
use ShellDetails from "./shell-shapes.contract"
use ThreadDetailsInline from "../details/shell-details.contract"
use ThreadDetailsPanel from "../details/shell-details.contract"
use DialogFinalFocus from "../shared/dialog-trap.contract"

// The T3Code window's main view, moved out of app.contract, which keeps the state, resources and
// actions: each component takes the root names it reads as props of the same names.

// The conversation column: header, transcript (or the empty thread), composer stack and alerts.
component ChatColumn
  inject
    frameMoved: action
    workspaceEntered: action // the workspace areas F6 moves between (shell-members.contract)
    threadFind: ThreadFindView
    rem: number
    // Ends a citation's placement (app.contract citePlace): the reader's wheel or a minimap jump moves the transcript.
    citeEnd: action
    // The transcript's viewport for the composer (app.contract restScrolled, restGesture).
    restScrolled: action
    restGesture: action
    // The timeline's scroll hides the window's Cite (observeSelectionActions' scroll); its end brings it back.
    citeScrolled: action
    citeSettled: action
    // Files dropped here or picked with Attach files (app.contract attachFiles, composer-controls-attach.ts).
    attachFiles: action
  props
    pageCover: bool
    viewport: Viewport
    scheme: string
    data: Snapshot
    shell: ShellView
    settings: Settings
    rightPanel: bool
    narrowDiff: bool
    detailsOpen: bool
    details: ShellDetails
    titleMenuOpen: bool
    renaming: bool
    renameText: string
    panelUi: action
    detailsAct: action
    titleUi: action
    home: PagesHome
    commandPending: bool
    lineageStopping: string
    command: action
    paletteShow: action
    foldHold: bool
    releaseFold: action
    jumpRequest: number
    composerOwner: string
    canRest: bool
    chatLocal: action
    markdown: TranscriptMarkdown
    earlier: action
    attachmentUrls: TimelineAttachmentUrls
    settingsCore: SettingsCore
    conversationWidth: number
    scrollToEnd: action
    editor: ComposerEditorView
    composerKey: action
    composerDrop: action
    editorOp: action
    selectThread: action
    openModels: action
    composerText: string
    modelsOpen: bool
    optionsOpen: string
    write: action
    send: action
    stop: action
    composerFocus: action
    composerBlur: action
    openOptions: action
    removeSnapshot: action
    askRemove: action
    interaction: action
    openProviderSettings: action
    branches: ComposerBranches
    timelineNow: number
    contextOver: bool
    // The chat column's right edge in the window is (sidebar) + conversationWidth; the Send tooltip
    // shifts to stay inside it, since a right panel (a later section) paints over anything reaching past it.
    sidebarWidth: number
    // The chat canvas (chat-canvas-view.ts): the lane, the card's fold and the floating player's frame; `canvasGesture`
    // reports a player gesture to it.
    canvas: ChatCanvasView
    canvasGesture: action
    // A primary press on the floating player: outside the thread details popover (app-window.contract detailsPlayerPointer).
    detailsOutside: action
    // The composer notice sliding out and its delayed dismissal (app.contract noticeDismiss).
    noticeExit: string
    noticeDismiss: action
  // The transcript's tooltips (shell-tip.contract TimelineTip): a scroll after one was hovered or moved over moves the
  // epoch, which closes every open one until the pointer moves again (TooltipScrollDismissArea).
  state tipEpoch = 0
  state tipArmed = false
  action tipArm
    tipArmed = true
  provide
    tipEpoch
    tipArm
  // ChatView's makeWorkspaceFileDropHandlers (workspaceFileDrop.ts) on the area under the header: a drag of files there
  // shows the drop overlay; a drop hides it and adds the files to the composer (addDroppedFiles, addDroppedFolders). A
  // drag over the prompt is the column's, so the field inserts no path text (exact2 #845). The column holds the header,
  // whose box hears its own drag: over it the overlay hides and a drop there adds nothing, as the reference's header
  // takes none.
  state fileDrag = false
  state overHeader = false
  action fileDragEntered
    fileDrag = true
  action fileDragLeft
    fileDrag = false
    overHeader = false
  action headerDragged(over: bool)
    overHeader = over
  action filesDropped(e: DragEvent)
    let header = overHeader
    fileDrag = false
    overHeader = false
    if not header
      attachFiles("drop", e.files, [], false, "")
  // ChatComposer's hidden file input for Attach files (AttachButton's press opens its picker).
  action filesPicked(files: Picked[])
    attachFiles("pick", [], files, false, "")
  // The transcript's hovered row (message.hoverKey) and its hovered tooltip part.
  state dismissedProviderBanner = "" // moved from app.contract: only the chat column reads or writes it
  action dismissProviderBanner
    dismissedProviderBanner = data.providerBannerKey
  state rowHover = ""
  state partHover = ""
  action hoverPart(row: string, part: string, over: bool)
    rowHover = over ? row : (rowHover == row ? "" : rowHover)
    partHover = over ? part : (partHover == part ? "" : partHover)
  // The user turns reported intersecting the transcript (UserRow's `intersect=`), for
  // the owner they were reported under, and the list's first visible row from its last ScrollEvent (timeline-minimap.contract).
  state turnsSeen: string[] = []
  state turnsOwner = ""
  state firstKey = ""
  derive turnIds = data.messages.map((message) => message.id)
  derive turnFirst = firstKey == "" ? -1 : turnIds.indexOf(firstKey)
  derive turnSeenNow = turnsOwner == composerOwner ? turnsSeen : []
  derive turnStart = turnRunStart(data.minimap, turnSeenNow, turnFirst)
  derive turnEnd = turnRunEnd(data.minimap, turnSeenNow, turnStart)
  derive turnsShown = data.minimap.filter((item) => item.index >= turnStart and item.index < turnEnd).map((item) => item.id)
  derive turnCurrent = turnEnd > turnStart ? turnStart : turnBefore(data.minimap, turnFirst)
  action turnSeen(id: string, entry: IntersectionObserverEntry)
    let kept = turnsOwner == composerOwner ? turnsSeen.filter((seen) => seen != id and turnIds.includes(seen)) : []
    turnsSeen = entry.isIntersecting ? kept.concat([id]) : kept
    turnsOwner = composerOwner
  // The open thread's last position (`anchor`, kept only from the reader's own scrolling: not while a command
  // such as a thread switch runs, nor before the thread's restoration) and the other threads' (`anchors`, at most 100).
  state anchor = TimelineAnchor(owner="", key="", offset=0, top=0, end=true)
  state anchors: TimelineAnchor[] = []
  // A restoration whose row is gone lands on its saved offset through the list's scrollTop (MessagesTimeline's
  // scrollToOffset fallback), until the next jump to the end.
  state fallbackTop = 0
  state fallbackJump = -1
  // A wheel over the minimap moves the transcript through the same binding (minimapWheel), until the next jump to the
  // end or restoration; `scrolled` is the list's last report: its offset, its travel and its height.
  state wheelTop = 0
  state wheelJump = -1
  state wheelPending = false
  state scrolledTop = 0
  state scrolledMax = 0
  state scrolledPort = 0
  derive listTop = wheelJump == jumpRequest ? wheelTop : (fallbackJump == jumpRequest ? fallbackTop : 1000000 + jumpRequest)
  action transcriptScrolled(left: number, top: number, e: ScrollEvent)
    citeScrolled(left, top)
    scrolledTop = e.scrollTop
    scrolledMax = e.scrollHeight - e.clientHeight
    scrolledPort = e.clientHeight
    wheelPending = false
    restScrolled(composerOwner, e)
    if tipArmed
      tipEpoch = tipEpoch + 1
      tipArmed = false
    // A turn whose row the virtual window let go sends no leave: its box is gone.
    turnsSeen = turnsSeen.filter((seen) => not frame(`turn-${seen}`).unavailable)
    let key = anchorKey(e.firstVisibleKey)
    let end = e.scrollHeight - e.scrollTop - e.clientHeight <= 2
    firstKey = key
    if anchor.owner == composerOwner and not commandPending and (end or turnIds.includes(key))
      anchor = TimelineAnchor(owner=composerOwner, key=key, offset=e.firstVisibleOffset, top=e.scrollTop, end=end)
  // The transcript of `owner` is laid out (the keyed marker beside the list mounted; intersect= reports on mount):
  // the thread left keeps its position, and this one returns to its own unless it was left at the end or a citation
  // places it (citation-source.ts).
  action transcriptOpened(owner: string, entry: IntersectionObserverEntry)
    if owner == composerOwner
      let kept = anchorKept(anchors, anchor)
      let saved = anchorOf(kept, owner)
      anchors = kept
      anchor = saved
      let restore = not saved.end and not data.citing
      fallbackTop = saved.top
      fallbackJump = restore and not turnIds.includes(saved.key) ? jumpRequest : -1
      if restore and not turnIds.includes(saved.key)
        wheelJump = -1
      if restore and turnIds.includes(saved.key)
        scrollIntoView("transcript", saved.key, offset=saved.offset, behavior="instant")
  // The minimap's strip or chevron: the turn's row 24pt under the top edge (scrollToIndex viewOffset 24; offset is the
  // port's start into the row wrapper), smooth unless reduced motion asks otherwise. It ends a citation's placement
  // first, so one writer moves the transcript.
  action turnJump(id: string, index: number)
    let target = id != "" ? id : data.minimap.filter((item) => item.index == index).map((item) => item.id).join("")
    if target != ""
      citeEnd()
    if target != "" and viewport.prefersReducedMotion
      scrollIntoView("transcript", target, offset=-24, behavior="instant")
    else if target != ""
      scrollIntoView("transcript", target, offset=-24, behavior="smooth")
  // The reader's wheel ends a citation's placement (the root's citePlace) and is the composer's resting gesture.
  action transcriptWheel(e: WheelEvent)
    citeEnd()
    restGesture(e.deltaY > 0)
  // TimelineMinimap's wheel scrolls the transcript beside it (forwardWheelToTimeline): the transcript hears it as its own
  // wheel, then moves by it (a line is 16pt, a page its height) from the offset it last reported, or from the last such
  // move it has not reported yet. A target equal to the binding's value would not write, so it differs by 0.01.
  action minimapWheel(e: WheelEvent)
    let base = wheelPending and wheelJump == jumpRequest ? wheelTop : scrolledTop
    let target = max(0, min(scrolledMax, base + e.deltaY * (e.deltaMode == 1 ? 16 : (e.deltaMode == 2 ? scrolledPort : 1))))
    if not e.ctrlKey and e.deltaY != 0
      preventDefault()
      citeEnd()
      restGesture(e.deltaY > 0)
      wheelTop = target == listTop ? target + 0.01 : target
      wheelJump = jumpRequest
      wheelPending = true
  // A scroll key with the focus in the transcript is a resting gesture too (End, Page Down, ↓ and Space toward the end).
  action transcriptKeys(k: string)
    if k == "Home" or k == "End" or k == "PageUp" or k == "PageDown" or k == "ArrowUp" or k == "ArrowDown" or k == " "
      restGesture(k == "End" or k == "PageDown" or k == "ArrowDown" or k == " ")
  // resolveChatCanvasLayout (chat-canvas-view.ts) places the lane: centred, moved left and then narrowed for the docked
  // workspace card (32pt clear of it) and for the floating player. Every lane container keeps its own 3rem padding and
  // adds the canvas's insetEnd (`--chat-lane-inset-end`) on its end side; the composer stack is the lane itself. Until
  // the canvas first answers, chat is centred.
  derive laneInset = canvas.ready ? canvas.insetEnd : 0
  // ChatView isDraftHeroState: only a draft with an empty timeline centres the composer under the hero; a server thread
  // with no messages docks it at the foot over the timeline's placeholder.
  derive hero = data.messages.length == 0 and data.threadId == ""
  derive overlaid = not hero
  derive stackWidth = canvas.ready ? canvas.width : max(0, min(data.look.chatMax, conversationWidth - 6 * rem))
  derive stackLeft = canvas.ready ? canvas.left : 3 * rem + max(0, conversationWidth - 6 * rem - stackWidth) / 2
  // `z-index` 1: the column paints over the terminal drawer under it (z-index orders siblings only, LLP 1001), so the thread
  // details popover (below), and any other popup that overflows the column's foot, runs over an open drawer as the
  // reference's portaled popups do.
  view
    column flex=1 min-width=0 min-height=0 height="100%" position="relative" z-index=1 inert=pageCover pointerdown=chatLocal("find-focus", "", "") dragenter=fileDragEntered dragleave=fileDragLeft drop=filesDropped id="frame-chat" resize=frameMoved
      input type="file" id="composer-attach-input" multiple=true display="none" change=filesPicked
      HeroWidthProbe(name=home.projectName)
      // z-index 20 here as on the header inside: z-index orders siblings only (LLP 1001), and the header's menus overhang the transcript.
      box width="100%" flex-shrink=0 position="relative" z-index=20 dragenter=headerDragged(true) dragleave=headerDragged(false)
        ChatHeader(data=data, shell=shell, rightOpen=((rightPanel or data.diffOpen) and not narrowDiff), detailsOpen=(detailsOpen or (details.inline and canvas.cardShown)), menuOpen=titleMenuOpen, renaming=renaming, renameText=renameText, local=chatLocal, panel=panelUi, details=detailsAct, title=titleUi, command=command)
      if threadFind.open
        box position="absolute" top=64 right=12 width=min(280, max(0, conversationWidth - 24)) z-index=39
          for focus in [threadFind.focus] key=focus
            ThreadFindBar(find=threadFind, local=chatLocal)
      if hero
        // The hero's lane is the chat width setting's (46rem, 72rem or full), at most 64rem, inside EmptyThread's 1.25rem
        // gutters; its project heading sits on one line on an lg window when the probe fits it, and until the probe is laid out.
        column flex=1 min-height=0 width="100%" padding-right=laneInset box-sizing="border-box"
          EmptyThread(data=data, home=home, scheme=scheme, shoulder=(editor.stash.count > 0), busy=commandPending, inline=(viewport.width >= 1024 and data.heroInlineWidth <= min(min(data.look.chatMax, 64 * rem), conversationWidth - laneInset - 2.5 * rem)), cap=min(data.look.chatMax, 64 * rem), command=command, addProject=paletteShow("command", "add-project"))
      if data.messages.length == 0 and data.threadId != ""
        // MessagesTimeline's empty state (no rows, not working): centred in the lane above the composer, which overlays the
        // timeline (emptyPlaceholderInset: the composer's reserved height, held while it rests); while the thread's detail
        // loads the pane stays blank (hideEmptyPlaceholder: threadDetailLoading).
        column flex=1 min-height=0 width="100%" padding-right=laneInset padding-bottom=(overlaid ? data.composerReserved : 0) box-sizing="border-box" align-items="center" justify-content="center" testId="empty-timeline"
          if not data.threadLoading and not data.running
            text "Send a message to start the conversation." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #a1a1a1)" testId="empty-timeline-hint"
      if data.messages.length > 0
        // The history control is the list's first row; the top 24pt fades under the header (topbar-scroll-fade).
        // The conversation is a workspace area (ChatView workspaceAreaProps("conversation", 1, "Conversation")).
        column flex=1 min-height=0 width="100%" position="relative" id="workspace-conversation" tabindex=-1 role="region" aria-label="Conversation" focusin=workspaceEntered("conversation")
          // appearance="none": the reference draws these rows as divs, not a platform table (LLP 1115.002 D5's opt-out).
          // `keep-mounted`: the rows the window keeps wherever it is (timeline-kept-rows.ts), so a screen reader wraps
          // from the first message to the last.
          list appearance="none" virtualized=true keep-mounted=data.transcriptKeep scrollFollowEnd=(not foldHold and not threadFind.open) reachend=releaseFold scroll=transcriptScrolled scrollend=citeSettled wheel=transcriptWheel keycapture=transcriptKeys scrollTop=listTop id="transcript" testId="transcript" flex=1 min-height=0 width="100%" padding-right=laneInset box-sizing="border-box" overflow-x="hidden"
            for message in data.messages key=message.id
              TimelineRow(message=message, hovered=(rowHover == message.hoverKey), part=(rowHover == message.hoverKey ? partHover : ""), hoverPart=hoverPart, command=command, local=chatLocal, documents=markdown.documents, lane=data.look.chatMax, bubble=data.look.message, ink=(data.look.themed ? data.look.text : "light-dark(#18181b, #f5f5f5)"), now=timelineNow, hasMore=data.hasMore, historyLoading=data.historyLoading, historyError=data.historyError, busy=commandPending, earlier=earlier, attachments=attachmentUrls.items, diffScheme=data.look.diff, tail=data.transcriptTail, lead=(((data.providerBannerKey != "" and data.providerBannerKey != dismissedProviderBanner) or data.error != "" ? 16 : 24) * rem / 16), scheme=scheme, seen=turnSeen)
          if not ((data.providerBannerKey != "" and data.providerBannerKey != dismissedProviderBanner) or data.error != "")
            TimelineFade(canvas=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #000000)" : settingsCore.palette.canvas))
          TimelineMinimap(items=data.minimap, current=turnCurrent, visible=turnsShown, wheel=minimapWheel, gutter=((conversationWidth - min(data.look.chatMax, conversationWidth - 6 * rem)) / 2), windowHeight=viewport.height, jump=turnJump)
          // The spot comes back once the thread's rows are in (MessagesTimeline restoreReady: rows.length > 0): while its
          // detail loads the list holds only the footer (the status line, "Loading messages..."), with no row to return to.
          for owner in (data.threadLoading ? [] : [composerOwner]) key=owner
            box intersect=transcriptOpened(owner) position="absolute" top=0 left=0 width=0 height=0 pointer-events="none"
          // composer-editor: over the transcript, so leaving the end (a fold opening there) moves nothing. It hides while
          // find is open, as the reference's does.
          if data.transcriptAway and not threadFind.open
            ScrollToEnd(jump=scrollToEnd, inset=laneInset, lift=data.scrollLift, summary=data.composer.endSummary)
      // The composer overlays the transcript (ChatView's data-chat-composer-overlay; composer-overlay.ts
      // measures it for the transcript's end reservation): absolute at the chat's foot over the lane alone, so the
      // transcript beside it still takes the pointer and the wheel; an empty thread keeps it in flow under the hero.
      // The banners sit above the card; the drawer layer paints after both, over the banners, clipped at the card.
      column position=(overlaid ? "absolute" : "relative") left=(overlaid ? stackLeft : 0) bottom=0 width=(overlaid ? stackWidth : "100%") padding-left=(overlaid ? "0px" : "3rem") padding-right=(overlaid ? 0 : 3 * rem + laneInset) flex-shrink=0 align-items="center" box-sizing="border-box" id="frame-overlay" resize=frameMoved role="region" aria-label="Message input" focusin=workspaceEntered("composer") testId="composer-overlay"
        column padding-top=(overlaid ? "0px" : "0.75rem") width="100%" max-width=data.look.chatMax position="relative" box-sizing="border-box"
          // The banners share a row with the stash's shoulder tab.
          row width="100%" align-items="flex-end" id="frame-shoulder" resize=frameMoved
            column flex=1 min-width=0 margin-right=(editor.stash.count > 0 and (editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)) ? "-1.125rem" : "0px") id="frame-dock" resize=frameMoved
              if editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)
                ComposerDock(data=data, busy=commandPending, command=command, keyed=composerKey, drop=composerDrop, urls=attachmentUrls.items, exiting=noticeExit, still=viewport.prefersReducedMotion, dismiss=noticeDismiss)
            if editor.stash.count > 0 and (editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)) and not data.composer.subagent
              StashBadge(stash=editor.stash, op=editorOp)
          RequestBanner(data=data, command=command, busy=commandPending, scheme=scheme, compact=(min(data.look.chatMax, conversationWidth - 6 * rem) - 4.25 * rem <= 35 * rem), maximumHeight=min(384, viewport.height * 0.4))
        column padding-bottom="1.25rem" justify-content="flex-end" flex-shrink=0 align-items="center" width="100%" box-sizing="border-box" id="frame-stack" resize=frameMoved
          column width="100%" max-width=data.look.chatMax position="relative"
            // A pending approval leaves the composer usable: a send declines it and redirects the agent.
            if data.composer.subagent
              SubagentBar(data=data, busy=commandPending, openParent=selectThread)
            else
              ComposerEditorDock(editor=editor, dark=(scheme == "dark"), op=editorOp)
              ComposerCard(editor=editor, data=data, viewportWidth=((data.sidebarOpen ? sidebarWidth : 0) + conversationWidth), text=composerText, busy=commandPending, keyModels=settings.keyModels, modelsOpen=modelsOpen, optionsOpen=optionsOpen, write=write, send=send, stop=stop, onFocus=composerFocus, onBlur=composerBlur, openModels=openModels, openOptions=openOptions, removeSnapshot=removeSnapshot, askRemove=askRemove, interaction=interaction, command=command, openProviders=openProviderSettings, contextOver=contextOver, urls=attachmentUrls.items)
              if branches.show
                ComposerStrip(strip=branches, open=optionsOpen, busy=commandPending, openOptions=openOptions, command=command, wide=(stackWidth >= 768), compact=data.composer.stripCompact, composer=data.composer)
            if data.requestMode == "question"
              RequestActions(data=data, command=command, busy=commandPending, scheme=scheme)
      ComposerDrawerLayer(editor=editor, dark=(scheme == "dark"), op=editorOp)
      // The header's thread details popover (app.contract detailsShown: chat is narrow, or the floating player left the
      // docked card no placement), 13pt in from the chat column's right edge and under the floating player, as the
      // reference's popover sits below the player (z-index orders siblings here, LLP 1001); taller than the column, it runs
      // over an open terminal drawer (the column's z-index). Its backdrop covers the chat column and, `below` it, the drawer
      // down to the window's foot; a press on the floating player closes it (`detailsOutside`), one beside the column too
      // (app-window.contract outsidePressDown): Base UI's outside press. Over a right panel sheet
      // (a narrow window) it is the window's (app-overlays.contract WindowOverlays), above the sheet.
      if detailsOpen and not (narrowDiff and (rightPanel or data.diffOpen))
        ThreadDetailsPanel(details=details, density=canvas.density, right=13, below=(canvas.ready ? max(0, viewport.height - 52 - canvas.containerHeight) : 0), maxHeight=(viewport.height - 104), act=detailsAct, local=chatLocal, still=viewport.prefersReducedMotion, busy=commandPending, stopping=lineageStopping)
      // A device floated over the chat (device-workspace.contract), in the canvas's frame.
      if shell.panel.deviceMini.show and canvas.mini.show and canvas.mini.key == shell.panel.deviceMini.key
        DeviceMiniPlayer(mini=shell.panel.deviceMini, frame=canvas.mini, still=viewport.prefersReducedMotion, local=chatLocal, gesture=canvasGesture, outside=detailsOutside)
      // A server Browser tab floated over the chat (browser-capture.contract); a tab with a frame floats in the page layer
      // (browser-frames.contract BrowserFrameLayer).
      if shell.panel.browserMini.show and shell.panel.browserMini.server and canvas.mini.show and canvas.mini.key == shell.panel.browserMini.key
        BrowserMiniPlayer(mini=shell.panel.browserMini, frame=canvas.mini, canvasWidth=canvas.containerWidth, local=chatLocal, gesture=canvasGesture, outside=detailsOutside, framed=false)
      if hero and data.connected and data.projectId != ""
        // Reference stack: the composer plus a 52pt strip zone under it, centred in the column.
        // Until the branch strip renders under the draft composer, this spacer reserves its 32pt.
        box flex=1 min-height=0 padding-top=(branches.show ? "0.75rem" : "2.75rem")
      AlertStack(data=data, dismissed=dismissedProviderBanner, busy=commandPending, dismissProvider=dismissProviderBanner, command=command, openSetup=openProviderSettings, inset=laneInset)
      // resolveThreadDetailsCardLayout: the card folds to the height above a player resized into it, and becomes the header's
      // popover when no readable height (160pt) is left; its rows fold to the canvas's density (ThreadDetailsCard).
      if details.inline and canvas.cardShown
        // The card is a workspace area (ThreadDetailsCard workspaceAreaProps("details", 3, "Thread details")); it is placed
        // out of this holder's flow.
        box id="workspace-details" tabindex=-1 role="region" aria-label="Thread details" focusin=workspaceEntered("details")
          ThreadDetailsInline(details=details, density=canvas.density, maxHeight=max(0, (canvas.ready ? canvas.cardHeight : viewport.height - 76) - (threadFind.open ? 48 : 0)), act=detailsAct, local=chatLocal, still=viewport.prefersReducedMotion, busy=commandPending, stopping=lineageStopping)
      // data-chat-workspace-drop-overlay: inset 8pt in the area under the 52pt header, over the transcript and the composer
      // (z-40), border-2 border-dashed border-primary/60 bg-primary/[0.035], its pill bg-background/95 with border-primary/25.
      if fileDrag and not overHeader
        column position="absolute" top=60 left=8 right=8 bottom=8 z-index=40 pointer-events="none" border-radius="1rem" border-width=2 border-style="dashed" border-color="light-dark(#1b4ed899, #346bf199)" background-color="light-dark(#1b4ed809, #346bf109)" align-items="center" justify-content="center" box-sizing="border-box" testId="chat-drop-overlay"
          row role="status" gap="0.5rem" align-items="center" padding-top="0.625rem" padding-bottom="0.625rem" padding-left="1rem" padding-right="1rem" border-radius="9999px" border-width=1 border-style="solid" border-color="light-dark(#1b4ed840, #346bf140)" background-color="light-dark(#fcfcfcf2, #000000f2)" box-shadow="0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a"
            svg width="1rem" height="1rem" viewBox="0 0 24 24" color="light-dark(#1b4ed8, #346bf1)" fill="none" stroke="currentColor" stroke-width=1.75 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
              path d="m16 6-8.414 8.586a2 2 0 0 0 2.829 2.829l8.414-8.586a4 4 0 1 0-5.657-5.657l-8.379 8.551a6 6 0 1 0 8.485 8.485l8.379-8.551"
            text "Drop files to attach" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#18181b, #f5f5f5)"

// The right panel beside the chat on a wide window: the diff, or the surface chooser.
component RightPanels
  inject
    workspaceEntered: action // the workspace areas F6 moves between (shell-members.contract)
  props
    data: Snapshot
    narrowDiff: bool
    rightMaximized: bool
    viewport: Viewport
    scheme: string
    sidebarWidth: number
    diffWidth: number
    shell: ShellView
    command: action
    panelUi: action
    resizeDiff: action
    finishDiffResize: action
    rightPanel: bool
    detailsOpen: bool
    detailsAct: action
    chatLocal: action
    paletteShow: action
    prDetail: PrDetailView
    prDocuments: ChatDocument[]
    filesDocuments: ChatDocument[]
    prTab: string
    prSetTab: action
    prReload: action
    prAct: action
    prCopy: action
    confirm: action
    closePending: bool
  // PreviewPanelShell: a panel that closes with the keyboard focus in it hands the focus to the header's Toggle right
  // panel, where the panel's own toggle was, so the keyboard is not left on nothing. A focus that left for another
  // element clears `focused`; one that left for nowhere (the window going inactive, the panel's removal) keeps it.
  state focused = false
  state shown = false
  action entered(e: FocusEvent)
    focused = true
    workspaceEntered("panel", e)
  action left(e: FocusEvent)
    match e.relatedTarget
      case some(other)
        focused = false
      case none
  action laidOut(width: number, height: number)
    if width >= 2
      shown = true
    else if shown
      if focused
        focus("toggle-right-panel")
      shown = false
      focused = false
  view
    box aria-hidden=true resize=laidOut position="absolute" left=0 top=0 width=((data.diffOpen or rightPanel) and not narrowDiff ? 2 : 1) height=1 opacity=0 pointer-events="none"
    if data.diffOpen and not narrowDiff
      box width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth) height="100%" flex-shrink=0 focusin=entered focusout=left id="workspace-panel" tabindex=-1 role="region" aria-label="Workspace panel"
        DiffPanel(data=data, shell=shell, command=command, close=panelUi("close", ""), ui=panelUi, maximized=rightMaximized, resize=resizeDiff, finishResize=finishDiffResize, scheme=scheme, sheet=false, detailsOpen=detailsOpen, details=detailsAct, local=chatLocal)
    if rightPanel and not data.diffOpen and not narrowDiff
      box width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth) height="100%" flex-shrink=0 focusin=entered focusout=left id="workspace-panel" tabindex=-1 role="region" aria-label="Workspace panel"
        SurfacePanel(shell=shell, sheet=false, maximized=rightMaximized, detailsOpen=detailsOpen, still=viewport.prefersReducedMotion, ui=panelUi, details=detailsAct, local=chatLocal, command=command, paletteShow=paletteShow, scheme=scheme, prDetail=prDetail, prDocuments=prDocuments, filesDocuments=filesDocuments, prTab=prTab, prSetTab=prSetTab, prReload=prReload, prAct=prAct, prCopy=prCopy, look=data.look, confirm=confirm, closePending=closePending, width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth))

// The utility pages (Usage, Pull Requests) and the no-environment/no-projects landing over the main view.
component PagesCover
  props
    pageCover: bool
    // The window's count of presses outside the page (T3Window), for the Usage page's light dismiss.
    outside: number
    data: Snapshot
    sidebarWidth: number
    modal: bool
    utilityPage: string
    viewport: Viewport
    scheme: string
    usage: UsageView
    usageShortcuts: UsageKey[]
    settings: Settings
    usageMetricSet: action
    usageWindowSet: action
    usageBreakdownSet: action
    usageRefreshNow: action
    // A page's Back (Escape): the page before it, else the thread (useNavigateBack).
    pageBack: action
    prList: PrListView
    prTyped: bool
    prQuery: string
    prSelected: string
    prPanelOpen: bool
    prTogglePanel: action
    prType: action
    prControl: action
    prSelect: action
    prReload: action
    paletteShow: action
    prDetail: PrDetailView
    prMarkdown: TranscriptMarkdown
    prTab: string
    prSetTab: action
    prClose: action
    prAct: action
    prCopy: action
    chatLocal: action
    home: PagesHome
    commandPending: bool
    command: action
    openConnectionsPage: action
    pagesOp: action
    // The window's inert for the main sidebar trigger (SidebarToggle), which the page's own dialogs add to.
    toggleInert: bool
    toggleSidebar: action
  // The pooled reset confirm closes for the page as its Cancel, Escape or Use credit is
  // pressed, so the page is no longer inert when the command's answer gives the segment the focus back (the
  // usage answer that drops the confirm comes later; Base UI's AlertDialog returns the focus as it closes).
  // A new ask from the page opens it again.
  // The pull request page's list and panel widths (moved from app.contract: only this page reads them).
  state prMaximized = false
  action maximizePr(on: bool)
    prMaximized = on
  derive prPanelWidth = prMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : min(floor(viewport.width / 2), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 224)
  derive prListWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - (prSelected != "" and prPanelOpen ? prPanelWidth : 0)
  state usageClosing = ""
  derive usageConfirmOpen = usage.pooled.confirm != "" and usageClosing != usage.pooled.confirm
  action usageCommand(op: string, id: string, value: string, n: number)
    usageClosing = ""
    command(op, id, value, n)
  action usageConfirm(op: string, id: string, value: string, n: number)
    usageClosing = id
    command(op, id, value, n)
  view
    if pageCover
      box position="absolute" left=(data.sidebarOpen ? sidebarWidth : 0) top=0 right=0 bottom=0 inert=(modal or utilityPage == "usage") testId="pages-cover"
        if utilityPage == "pull-requests"
          row position="absolute" left=0 top=0 right=0 bottom=0
            PrGuideMaximize(opened=(prSelected != "" and prPanelOpen), ready=(prTab == "guide" and prDetail.guide.enabled and prDetail.guide.hasGuide), change=maximizePr)
            column flex=1 min-width=0 height="100%" display=(prMaximized ? "none" : "flex")
              PrList(controlsLeft=data.controlsLeft, page=prList, scheme=scheme, query=(prTyped ? prQuery : prList.query), sidebarOpen=data.sidebarOpen, narrow=(prListWidth < 512), compact=(prListWidth < 428), panelOpen=(prSelected != "" and prPanelOpen), togglePanel=prTogglePanel, search=prType, control=prControl, select=prSelect, reload=prReload, addProject=paletteShow("command", "add-project"), act=prAct, back=pageBack)
            if prSelected != "" and prPanelOpen
              PrPanel(detail=prDetail, documents=prMarkdown.documents, scheme=scheme, width=prPanelWidth, tab=prTab, setTab=prSetTab, close=prClose, reload=prReload, act=prAct, copy=prCopy, still=viewport.prefersReducedMotion, select=prSelect, compact=(prPanelWidth < 480), back=pageBack, local=chatLocal)
            if prSelected != "" and prPanelOpen
              button press=maximizePr(not prMaximized) position="absolute" right="3rem" top="0.75rem" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" aria-label=(prMaximized ? "Restore panel" : "Maximize panel") title="" testId="pull-requests-maximize-panel"
                PgIcon(name=(prMaximized ? "minimize-2" : "maximize-2"), size=16, color="light-dark(#71717b, #a1a1a1)")
            button press=prTogglePanel disabled=(prSelected == "") position="absolute" right="0.8125rem" top="0.75rem" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(prSelected != "" and prPanelOpen ? "light-dark(#27272a0d, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Toggle right panel" testId="pull-requests-toggle-panel" title=""
              PgIcon(name="panel-right", size=16, color="light-dark(#71717b, #a1a1a1)")
        // A landing stays drawn under the Usage modal opened from it.
        if utilityPage == "" or (utilityPage == "usage" and (home.landing == "no-environment" or home.landing == "no-projects" or home.landing == "start-error" or home.landing == "no-thread"))
          PagesLanding(controlsLeft=data.controlsLeft, home=home, scheme=scheme, sidebarOpen=data.sidebarOpen, busy=commandPending, command=command, addProject=paletteShow("command", "add-project"), openConnections=openConnectionsPage)
    // The main sidebar trigger is drawn here, whatever the page: after the chat and the page in paint and Tab order,
    // under the dialogs below, which cover the whole window as the reference's portaled dialogs cover SidebarControl.
    SidebarToggle(open=data.sidebarOpen, controlsLeft=data.controlsLeft, keySidebar=settings.keySidebar, inert=(toggleInert or (pageCover and utilityPage == "usage") or prDetail.actions.stack.dialogOpen), toggle=toggleSidebar)
    // Usage opens as the large modal over the page that opened it (AppRouteModal label "Usage", 3faeb9e6f9 #24847).
    if pageCover and utilityPage == "usage"
      AppRouteModal(label="Usage", modalId="usage-modal", viewportWidth=viewport.width, canvas="light-dark(#fcfcfc, #000000)", border="light-dark(#e4e4e7, #ffffff14)", backdrop="light-dark(#fcfcfc99, #000000a3)", inert=modal, first="usage-environment", last="close-usage", close=pageBack)
        UsagePage(page=usage, keys=usageShortcuts, scheme=scheme, wide=(routeModalWidth(viewport.width) - 30 >= 896), lg=(viewport.width >= 1024), md=(viewport.width >= 768), sm=(viewport.width >= 640), op=pagesOp, setMetric=usageMetricSet, setWindow=usageWindowSet, setBreakdown=usageBreakdownSet, reload=usageRefreshNow, back=pageBack, command=usageCommand, confirmOpen=usageConfirmOpen, reduced=viewport.prefersReducedMotion, outside=outside)
    // Usage's model and Model prices dialogs cover the whole window, sidebar included (pages-usage-dialogs).
    // A pooled segment's reset credit confirm, outside its popover (UsageLimitsPooled RedeemableSegmentPopup).
    if pageCover and utilityPage == "usage" and usageConfirmOpen
      ResetCreditDialog(prefix="pageslocal:usage-pool", target=usage.pooled.confirm, busy=commandPending, command=usageConfirm)
    // Model prices and a model's dialog (which opens Model prices from its Set price) give the focus back to what opened
    // the first of them as the last closes (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=(pageCover and utilityPage == "usage" and usage.prices.open), owner="usage-prices-dialog")
    DialogFinalFocus(open=(pageCover and utilityPage == "usage" and usage.detail.open), owner="usage-model-dialog")
    if pageCover and utilityPage == "usage" and usage.prices.open
      UsagePricesLayer(page=usage, scheme=scheme, viewportHeight=viewport.height, busy=commandPending, op=pagesOp)
    if pageCover and utilityPage == "usage" and usage.detail.open and not usage.prices.open
      UsageModelLayer(page=usage, scheme=scheme, viewportHeight=viewport.height, sm=(viewport.width >= 640), op=pagesOp)

// The right panel as a sheet over a narrow window, with its click-away backdrop.
component RightSheets
  props
    data: Snapshot
    narrowDiff: bool
    modal: bool
    panelUi: action
    viewport: Viewport
    scheme: string
    diffWidth: number
    shell: ShellView
    command: action
    resizeDiff: action
    finishDiffResize: action
    rightPanel: bool
    detailsOpen: bool
    detailsAct: action
    chatLocal: action
    paletteShow: action
    prDetail: PrDetailView
    prDocuments: ChatDocument[]
    filesDocuments: ChatDocument[]
    prTab: string
    prSetTab: action
    prReload: action
    prAct: action
    prCopy: action
    confirm: action
    closePending: bool
  view
    if data.diffOpen and narrowDiff and not modal
      box position="absolute" top=0 bottom=0 left=0 right=0 background-color="#00000000" z-index=10 press=panelUi("close", "") aria-label="Close changes"
      box position="absolute" top=0 bottom=0 right=0 width=min(viewport.width, diffWidth) z-index=11
        DiffPanel(data=data, shell=shell, command=command, close=panelUi("close", ""), ui=panelUi, maximized=false, resize=resizeDiff, finishResize=finishDiffResize, scheme=scheme, sheet=true, detailsOpen=detailsOpen, details=detailsAct, local=chatLocal)
    if rightPanel and not data.diffOpen and narrowDiff and not modal
      box position="absolute" top=0 bottom=0 left=0 right=0 background-color="#00000000" z-index=10 press=panelUi("toggle", "") aria-label="Close right panel"
      box position="absolute" top=0 bottom=0 right=0 width=min(viewport.width, diffWidth) z-index=11
        SurfacePanel(shell=shell, sheet=true, maximized=false, detailsOpen=detailsOpen, still=viewport.prefersReducedMotion, ui=panelUi, details=detailsAct, local=chatLocal, command=command, paletteShow=paletteShow, scheme=scheme, prDetail=prDetail, prDocuments=prDocuments, filesDocuments=filesDocuments, prTab=prTab, prSetTab=prSetTab, prReload=prReload, prAct=prAct, prCopy=prCopy, look=data.look, confirm=confirm, closePending=closePending, width=min(viewport.width, diffWidth))


// Observe the first ready tour once per open panel; a manual restore survives tab changes.
component PrGuideMaximize
  props
    opened: bool
    ready: bool
    change: action
  state reported = false
  action observe(width: number, height: number)
    if width == 1
      reported = false
      change(false)
    else if width == 3 and not reported
      reported = true
      change(true)
  view
    box resize=observe aria-hidden=true position="absolute" left=0 top=0 width=(not opened ? 1 : ready ? 3 : 2) height=1 opacity=0 pointer-events="none"
