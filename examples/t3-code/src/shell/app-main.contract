use SettingsCore from "../settings/settings-core.contract"
use Settings from "../shared/shapes.contract"
use Snapshot from "../shared/shapes.contract"
use ComposerCard from "../composer/composer.contract"
use ComposerEditorDock from "../composer/composer-editor.contract"
use ComposerDrawerLayer from "../composer/composer-editor.contract"
use StashBadge from "../composer/composer-editor.contract"
use ComposerEditorView from "../composer/composer-editor.contract"
use ComposerDock from "../composer/composer-controls.contract"
use ComposerStrip from "../composer/composer-controls.contract"
use SubagentBar from "../composer/composer-controls.contract"
use ComposerBranches from "../composer/composer-shapes.contract"
use Viewport from "../shared/shapes.contract"
use ChatHeader from "../timeline/chat.contract"
use AlertStack from "../timeline/chat.contract"
use EmptyThread from "../pages/pages-hero.contract"
use PagesLanding from "../pages/pages-hero.contract"
use PagesHome from "../pages/pages-hero.contract"
use UsagePage from "../usage/pages-usage.contract"
use UsageView from "../usage/pages-usage.contract"
use UsageKey from "../usage/pages-usage.contract"
use UsagePricesLayer from "../usage/pages-usage-dialogs.contract"
use UsageModelLayer from "../usage/pages-usage-dialogs.contract"
use ResetCreditDialog from "../usage/usage-bars.contract"
use SidebarToggle from "../sidebar/sidebar-toggle.contract"
use PrList from "../pull-requests/pages-prs.contract"
use PgIcon from "../shared/pages-icons.contract"
use PrListView from "../pull-requests/pages-prs.contract"
use PrPanel from "../pull-requests/pages-pr-detail.contract"
use PrDetailView from "../pull-requests/pages-pr-detail.contract"
use ScrollToEnd from "../timeline/chat.contract"
use TranscriptMarkdown, ChatDocument from "../timeline/markdown.contract"
use TimelineRow from "../timeline/timeline.contract"
use TimelineFade from "../timeline/timeline.contract"
use TimelineMinimap, turnRunStart, turnRunEnd, turnBefore from "../timeline/timeline-minimap.contract"
use TimelineAnchor, anchorOf, anchorKept, anchorKey from "../timeline/timeline-anchor.contract"
use TimelineAttachmentUrls from "../timeline/timeline-attachments.contract"
use RequestBanner from "../composer/requests.contract"
use RequestActions from "../composer/requests.contract"
use ApprovalComposer from "../composer/requests.contract"
use DiffPanel from "../diff/diff.contract"
use ShellView from "./shell-shapes.contract"
use SurfacePanel from "./shell-panels.contract"
use DeviceMiniPlayer from "../device/device-workspace.contract"
use BrowserMiniPlayer from "../browser/browser-capture.contract"
use ChatCanvasView from "./chat-canvas.contract"
use ShellDetails from "./shell-shapes.contract"
use ThreadDetailsInline from "../details/shell-details.contract"
use ThreadDetailsPanel from "../details/shell-details.contract"
use DialogFinalFocus from "../shared/dialog-trap.contract"

// The T3Code window's main view, moved out of app.contract, which keeps the state, resources and
// actions: each component takes the root names it reads as props of the same names.

// The conversation column: header, transcript (or the empty thread), composer stack and alerts.
component ChatColumn
  inject
    rem: number
    // The timeline's scroll hides the window's Cite (observeSelectionActions' scroll).
    citeScrolled: action
  props
    pageCover: bool
    viewport: Viewport
    scheme: string
    data: Snapshot
    shell: ShellView
    settings: Settings
    rightPanel: bool
    narrowDiff: bool
    detailsOpen: bool
    details: ShellDetails
    titleMenuOpen: bool
    renaming: bool
    renameText: string
    panelUi: action
    detailsAct: action
    titleUi: action
    home: PagesHome
    commandPending: bool
    command: action
    paletteShow: action
    foldHold: bool
    releaseFold: action
    jumpRequest: number
    composerOwner: string
    canRest: bool
    chatLocal: action
    markdown: TranscriptMarkdown
    earlier: action
    attachmentUrls: TimelineAttachmentUrls
    settingsCore: SettingsCore
    conversationWidth: number
    resting: bool
    scrollToEnd: action
    editor: ComposerEditorView
    composerKey: action
    composerDrop: action
    editorOp: action
    selectThread: action
    openModels: action
    composerText: string
    modelsOpen: bool
    optionsOpen: string
    write: action
    send: action
    stop: action
    composerFocus: action
    composerBlur: action
    openOptions: action
    removeSnapshot: action
    askRemove: action
    interaction: action
    openProviderSettings: action
    branches: ComposerBranches
    timelineNow: number
    contextOver: bool
    // The chat column's right edge in the window is (sidebar) + conversationWidth; the Send tooltip
    // shifts to stay inside it, since a right panel (a later section) paints over anything reaching past it.
    sidebarWidth: number
    // The chat canvas (chat-canvas-view.ts): the lane, the card's fold and the floating player's frame; `canvasGesture`
    // reports a player gesture to it.
    canvas: ChatCanvasView
    canvasGesture: action
    // A primary press on the floating player: outside the thread details popover (app-window.contract detailsPlayerPointer).
    detailsOutside: action
    // The composer notice sliding out and its delayed dismissal (app.contract noticeDismiss).
    noticeExit: string
    noticeDismiss: action
  // The transcript's tooltips (shell-tip.contract TimelineTip): a scroll after one was hovered or moved over moves the
  // epoch, which closes every open one until the pointer moves again (TooltipScrollDismissArea).
  state tipEpoch = 0
  state tipArmed = false
  action tipArm
    tipArmed = true
  provide
    tipEpoch
    tipArm
  // The transcript's hovered row (message.hoverKey) and its hovered tooltip part.
  state dismissedProviderBanner = "" // moved from app.contract: only the chat column reads or writes it
  action dismissProviderBanner
    dismissedProviderBanner = data.providerBannerKey
  state rowHover = ""
  state partHover = ""
  action hoverPart(row: string, part: string, over: bool)
    rowHover = over ? row : (rowHover == row ? "" : rowHover)
    partHover = over ? part : (partHover == part ? "" : partHover)
  // The user turns reported intersecting the transcript (UserRow's `intersect=`), for
  // the owner they were reported under, and the list's first visible row from its last ScrollEvent (timeline-minimap.contract).
  state turnsSeen: string[] = []
  state turnsOwner = ""
  state firstKey = ""
  derive turnIds = data.messages.map((message) => message.id)
  derive turnFirst = firstKey == "" ? -1 : turnIds.indexOf(firstKey)
  derive turnSeenNow = turnsOwner == composerOwner ? turnsSeen : []
  derive turnStart = turnRunStart(data.minimap, turnSeenNow, turnFirst)
  derive turnEnd = turnRunEnd(data.minimap, turnSeenNow, turnStart)
  derive turnsShown = data.minimap.filter((item) => item.index >= turnStart and item.index < turnEnd).map((item) => item.id)
  derive turnCurrent = turnEnd > turnStart ? turnStart : turnBefore(data.minimap, turnFirst)
  action turnSeen(id: string, entry: IntersectionObserverEntry)
    let kept = turnsOwner == composerOwner ? turnsSeen.filter((seen) => seen != id and turnIds.includes(seen)) : []
    turnsSeen = entry.isIntersecting ? kept.concat([id]) : kept
    turnsOwner = composerOwner
  // The open thread's last position (`anchor`, kept only from the reader's own scrolling: not while a command
  // such as a thread switch runs, nor before the thread's restoration) and the other threads' (`anchors`, at most 100).
  state anchor = TimelineAnchor(owner="", key="", offset=0, top=0, end=true)
  state anchors: TimelineAnchor[] = []
  // A restoration whose row is gone lands on its saved offset through the list's scrollTop (MessagesTimeline's
  // scrollToOffset fallback), until the next jump to the end.
  state fallbackTop = 0
  state fallbackJump = -1
  action transcriptScrolled(left: number, top: number, e: ScrollEvent)
    citeScrolled(left, top)
    if tipArmed
      tipEpoch = tipEpoch + 1
      tipArmed = false
    // A turn whose row the virtual window let go sends no leave: its box is gone.
    turnsSeen = turnsSeen.filter((seen) => not frame(`turn-${seen}`).unavailable)
    let key = anchorKey(e.firstVisibleKey)
    let end = e.scrollHeight - e.scrollTop - e.clientHeight <= 2
    firstKey = key
    if anchor.owner == composerOwner and not commandPending and (end or turnIds.includes(key))
      anchor = TimelineAnchor(owner=composerOwner, key=key, offset=e.firstVisibleOffset, top=e.scrollTop, end=end)
  // The transcript of `owner` is laid out (the keyed marker beside the list mounted; intersect= reports on mount):
  // the thread left keeps its position, and this one returns to its own unless it was left at the end or a citation
  // places it (citation-source.ts).
  action transcriptOpened(owner: string, entry: IntersectionObserverEntry)
    if owner == composerOwner
      let kept = anchorKept(anchors, anchor)
      let saved = anchorOf(kept, owner)
      anchors = kept
      anchor = saved
      let restore = not saved.end and not data.citing
      fallbackTop = saved.top
      fallbackJump = restore and not turnIds.includes(saved.key) ? jumpRequest : -1
      if restore and turnIds.includes(saved.key)
        scrollIntoView("transcript", saved.key, offset=saved.offset, behavior="instant")
  // The minimap's strip or chevron: the turn's row 24pt under the top edge (scrollToIndex viewOffset 24; offset is the
  // port's start into the row wrapper), smooth unless reduced motion asks otherwise. It ends a citation's native hold
  // first (T3TimelineTurns.swift), so one writer moves the transcript.
  action turnJump(id: string, index: number)
    let target = id != "" ? id : data.minimap.filter((item) => item.index == index).map((item) => item.id).join("")
    if target != ""
      chatLocal("timeline-release", "", "")
    if target != "" and viewport.prefersReducedMotion
      scrollIntoView("transcript", target, offset=-24, behavior="instant")
    else if target != ""
      scrollIntoView("transcript", target, offset=-24, behavior="smooth")
  // resolveChatCanvasLayout (chat-canvas-view.ts) places the lane: centred, moved left and then narrowed for the docked
  // workspace card (32pt clear of it) and for the floating player. Every lane container keeps its own 20pt padding and
  // adds the canvas's insetEnd (`--chat-lane-inset-end`) on its end side; the composer stack is the lane itself. Until
  // the canvas first answers, chat is centred.
  derive laneInset = canvas.ready ? canvas.insetEnd : 0
  // ChatView isDraftHeroState: only a draft with an empty timeline centres the composer under the hero; a server thread
  // with no messages docks it at the foot over the timeline's placeholder.
  derive hero = data.messages.length == 0 and data.threadId == ""
  derive overlaid = not hero
  derive stackWidth = canvas.ready ? canvas.width : max(0, min(data.look.chatMax, conversationWidth - 2.5 * rem))
  derive stackLeft = canvas.ready ? canvas.left : 1.25 * rem + max(0, conversationWidth - 2.5 * rem - stackWidth) / 2
  // `z-index` 1: the column paints over the terminal drawer under it (z-index orders siblings only, LLP 1001), so the thread
  // details popover (below), and any other popup that overflows the column's foot, runs over an open drawer as the
  // reference's portaled popups do.
  view
    column flex=1 min-width=0 min-height=0 height="100%" position="relative" z-index=1 inert=pageCover hatch="t3-frame" data-frame="chat"
      ChatHeader(data=data, shell=shell, rightOpen=((rightPanel or data.diffOpen) and not narrowDiff), detailsOpen=(detailsOpen or (details.inline and canvas.cardShown)), menuOpen=titleMenuOpen, renaming=renaming, renameText=renameText, panel=panelUi, details=detailsAct, title=titleUi)
      if hero
        column flex=1 min-height=0 width="100%" padding-right=laneInset box-sizing="border-box"
          EmptyThread(data=data, home=home, scheme=scheme, shoulder=(editor.stash.count > 0 and data.requestMode != "approval"), busy=commandPending, command=command, addProject=paletteShow("command", "add-project"))
      if data.messages.length == 0 and data.threadId != ""
        // MessagesTimeline's empty state (no rows, not working): centred in the timeline under the docked composer; while
        // the thread's detail loads the pane stays blank (hideEmptyPlaceholder: threadDetailLoading).
        column flex=1 min-height=0 width="100%" padding-right=laneInset box-sizing="border-box" align-items="center" justify-content="center" testId="empty-timeline"
          if not data.threadLoading and not data.running
            text "Send a message to start the conversation." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b4d, #8181814d)" testId="empty-timeline-hint"
      if data.messages.length > 0
        // The history control is the list's first row; the top 24pt fades under the header (topbar-scroll-fade).
        column flex=1 min-height=0 width="100%" position="relative"
          // appearance="none": the reference draws these rows as divs, not a platform table (LLP 1115.002 D5's opt-out).
          list appearance="none" virtualized=true scrollFollowEnd=(not foldHold) reachend=releaseFold scroll=transcriptScrolled scrollTop=(fallbackJump == jumpRequest ? fallbackTop : 1000000 + jumpRequest) id="transcript" testId="transcript" hatch="t3-transcript" data-timeline-owner=composerOwner data-timeline-rest=(canRest ? "yes" : "no") flex=1 min-height=0 width="100%" padding-right=laneInset box-sizing="border-box" overflow-x="hidden"
            for message in data.messages key=message.id
              TimelineRow(message=message, hovered=(rowHover == message.hoverKey), part=(rowHover == message.hoverKey ? partHover : ""), hoverPart=hoverPart, command=command, local=chatLocal, documents=markdown.documents, lane=data.look.chatMax, bubble=data.look.message, ink=(data.look.themed ? data.look.text : "light-dark(#27272a, #f5f5f5)"), now=timelineNow, hasMore=data.hasMore, historyLoading=data.historyLoading, historyError=data.historyError, busy=commandPending, earlier=earlier, attachments=attachmentUrls.items, diffScheme=data.look.diff, tail=data.transcriptTail, lead=(((data.providerBannerKey != "" and data.providerBannerKey != dismissedProviderBanner) or data.error != "" ? 16 : 24) * rem / 16), scheme=scheme, seen=turnSeen)
          if not ((data.providerBannerKey != "" and data.providerBannerKey != dismissedProviderBanner) or data.error != "")
            TimelineFade(canvas=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas))
          TimelineMinimap(items=data.minimap, current=turnCurrent, visible=turnsShown, gutter=((conversationWidth - min(data.look.chatMax, conversationWidth - 2.5 * rem)) / 2), windowHeight=viewport.height, jump=turnJump)
          for owner in [composerOwner] key=owner
            box intersect=transcriptOpened(owner) position="absolute" top=0 left=0 width=0 height=0 pointer-events="none"
          // composer-editor: over the transcript, so leaving the end (a fold opening there) moves nothing.
          if data.transcriptAway
            ScrollToEnd(jump=scrollToEnd, inset=laneInset, lift=data.scrollLift)
      // The composer overlays the transcript (ChatView's data-chat-composer-overlay; composer-overlay.ts
      // measures it for the transcript's end reservation): absolute at the chat's foot over the lane alone, so the
      // transcript beside it still takes the pointer and the wheel; an empty thread keeps it in flow under the hero.
      // The banners sit above the card; the drawer layer paints after both, over the banners, clipped at the card.
      column position=(overlaid ? "absolute" : "relative") left=(overlaid ? stackLeft : 0) bottom=0 width=(overlaid ? stackWidth : "100%") padding-left=(overlaid ? "0px" : "1.25rem") padding-right=(overlaid ? 0 : 1.25 * rem + laneInset) flex-shrink=0 align-items="center" box-sizing="border-box" hatch="t3-frame" data-frame="overlay" testId="composer-overlay"
        column padding-top=(overlaid ? "0px" : "0.75rem") width="100%" max-width=data.look.chatMax position="relative" box-sizing="border-box"
          // The banners share a row with the stash's shoulder tab.
          row width="100%" align-items="flex-end" hatch="t3-frame" data-frame="shoulder"
            column flex=1 min-width=0 margin-right=(editor.stash.count > 0 and (editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)) ? "-1.125rem" : "0px") hatch="t3-frame" data-frame="dock"
              if editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)
                ComposerDock(data=data, busy=commandPending, command=command, keyed=composerKey, drop=composerDrop, urls=attachmentUrls.items, exiting=noticeExit, still=viewport.prefersReducedMotion, dismiss=noticeDismiss)
            if editor.stash.count > 0 and (editor.drawer.placed or not (editor.menu.open or editor.stash.menuOpen)) and data.requestMode != "approval" and not data.composer.subagent
              StashBadge(stash=editor.stash, op=editorOp)
          RequestBanner(data=data, command=command, busy=commandPending, scheme=scheme, compact=(min(data.look.chatMax, conversationWidth - 2.5 * rem) - 4.25 * rem <= 35 * rem), maximumHeight=min(384, viewport.height * 0.4))
        // A resting card keeps the transcript's reservation instead of the stack's height (resolveComposerTimelineInset).
        column padding-bottom=(resting ? "3.25rem" : "1.25rem") justify-content="flex-end" flex-shrink=0 align-items="center" width="100%" box-sizing="border-box" hatch="t3-frame" data-frame="stack"
          column width="100%" max-width=data.look.chatMax position="relative"
            if data.requestMode == "approval" or data.composer.subagent
              if data.composer.subagent
                SubagentBar(data=data, busy=commandPending, openParent=selectThread)
              else
                ApprovalComposer(placeholder=data.composer.placeholder)
            else
              ComposerEditorDock(editor=editor, dark=(scheme == "dark"), op=editorOp, openModels=openModels)
              ComposerCard(editor=editor, data=data, viewportWidth=((data.sidebarOpen ? sidebarWidth : 0) + conversationWidth), text=composerText, resting=resting, busy=commandPending, narrow=(conversationWidth < 620), keyModels=settings.keyModels, modelsOpen=modelsOpen, optionsOpen=optionsOpen, write=write, send=send, stop=stop, onFocus=composerFocus, onBlur=composerBlur, openModels=openModels, openOptions=openOptions, removeSnapshot=removeSnapshot, askRemove=askRemove, interaction=interaction, command=command, openProviders=openProviderSettings, contextOver=contextOver, urls=attachmentUrls.items)
              if branches.show and not resting
                ComposerStrip(strip=branches, open=optionsOpen, busy=commandPending, openOptions=openOptions, command=command, wide=(stackWidth >= 768))
            if data.requestMode == "question" and not resting
              RequestActions(data=data, command=command, busy=commandPending, scheme=scheme)
      ComposerDrawerLayer(editor=editor, dark=(scheme == "dark"), op=editorOp)
      // The header's thread details popover (app.contract detailsShown: chat is narrow, or the floating player left the
      // docked card no placement), 13pt in from the chat column's right edge and under the floating player, as the
      // reference's popover sits below the player (z-index orders siblings here, LLP 1001); taller than the column, it runs
      // over an open terminal drawer (the column's z-index). Its backdrop covers the chat column and, `below` it, the drawer
      // down to the window's foot; a press on the floating player closes it (`detailsOutside`), one beside the column too
      // (app-window.contract outsidePressDown): Base UI's outside press. Over a right panel sheet
      // (a narrow window) it is the window's (app-overlays.contract WindowOverlays), above the sheet.
      if detailsOpen and not (narrowDiff and (rightPanel or data.diffOpen))
        ThreadDetailsPanel(details=details, density=canvas.density, right=13, below=(canvas.ready ? max(0, viewport.height - 52 - canvas.containerHeight) : 0), maxHeight=(viewport.height - 104), act=detailsAct, local=chatLocal, still=viewport.prefersReducedMotion)
      // A device floated over the chat (device-workspace.contract), in the canvas's frame.
      if shell.panel.deviceMini.show and canvas.mini.show and canvas.mini.key == shell.panel.deviceMini.key
        DeviceMiniPlayer(mini=shell.panel.deviceMini, frame=canvas.mini, still=viewport.prefersReducedMotion, local=chatLocal, gesture=canvasGesture, outside=detailsOutside)
      // A Browser tab floated over the chat (browser-capture.contract).
      if shell.panel.browserMini.show and canvas.mini.show and canvas.mini.key == shell.panel.browserMini.key
        BrowserMiniPlayer(mini=shell.panel.browserMini, frame=canvas.mini, canvasWidth=canvas.containerWidth, local=chatLocal, gesture=canvasGesture, outside=detailsOutside)
      if hero and data.connected and data.projectId != ""
        // Reference stack: the composer plus a 52pt strip zone under it, centred in the column.
        // Until the branch strip renders under the draft composer, this spacer reserves its 32pt.
        box flex=1 min-height=0 padding-top=(branches.show ? "0.75rem" : "2.75rem")
      AlertStack(data=data, dismissed=dismissedProviderBanner, busy=commandPending, dismissProvider=dismissProviderBanner, command=command, openSetup=openProviderSettings)
      // resolveThreadDetailsCardLayout: the card folds to the height above a player resized into it, and becomes the header's
      // popover when no readable height (160pt) is left; its rows fold to the canvas's density (ThreadDetailsCard).
      if details.inline and canvas.cardShown
        ThreadDetailsInline(details=details, density=canvas.density, maxHeight=(canvas.ready ? canvas.cardHeight : viewport.height - 76), act=detailsAct, local=chatLocal, still=viewport.prefersReducedMotion)

// The right panel beside the chat on a wide window: the diff, or the surface chooser.
component RightPanels
  props
    data: Snapshot
    narrowDiff: bool
    rightMaximized: bool
    viewport: Viewport
    scheme: string
    sidebarWidth: number
    diffWidth: number
    shell: ShellView
    command: action
    panelUi: action
    resizeDiff: action
    finishDiffResize: action
    rightPanel: bool
    detailsOpen: bool
    detailsAct: action
    chatLocal: action
    paletteShow: action
    prDetail: PrDetailView
    prDocuments: ChatDocument[]
    filesDocuments: ChatDocument[]
    prTab: string
    prSetTab: action
    prReload: action
    prAct: action
    prCopy: action
    confirm: action
    closePending: bool
  view
    if data.diffOpen and not narrowDiff
      box width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth) height="100%" flex-shrink=0
        DiffPanel(data=data, shell=shell, command=command, close=panelUi("close", ""), ui=panelUi, maximized=rightMaximized, resize=resizeDiff, finishResize=finishDiffResize, scheme=scheme, sheet=false, detailsOpen=detailsOpen, details=detailsAct, local=chatLocal)
    if rightPanel and not data.diffOpen and not narrowDiff
      box width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth) height="100%" flex-shrink=0
        SurfacePanel(shell=shell, sheet=false, maximized=rightMaximized, detailsOpen=detailsOpen, still=viewport.prefersReducedMotion, ui=panelUi, details=detailsAct, local=chatLocal, command=command, paletteShow=paletteShow, scheme=scheme, prDetail=prDetail, prDocuments=prDocuments, filesDocuments=filesDocuments, prTab=prTab, prSetTab=prSetTab, prReload=prReload, prAct=prAct, prCopy=prCopy, look=data.look, confirm=confirm, closePending=closePending, width=(rightMaximized ? viewport.width - (data.sidebarOpen ? sidebarWidth : 0) : diffWidth))

// The utility pages (Usage, Pull Requests) and the no-environment/no-projects landing over the main view.
component PagesCover
  props
    pageCover: bool
    // The window's count of presses outside the page (T3Window), for the Usage page's light dismiss.
    outside: number
    data: Snapshot
    sidebarWidth: number
    modal: bool
    utilityPage: string
    viewport: Viewport
    scheme: string
    usage: UsageView
    usageShortcuts: UsageKey[]
    settings: Settings
    usageMetricSet: action
    usageWindowSet: action
    usageBreakdownSet: action
    usageRefreshNow: action
    // A page's Back (Escape): the page before it, else the thread (useNavigateBack).
    pageBack: action
    prList: PrListView
    prTyped: bool
    prQuery: string
    prSelected: string
    prPanelOpen: bool
    prTogglePanel: action
    prType: action
    prControl: action
    prSelect: action
    prReload: action
    paletteShow: action
    prDetail: PrDetailView
    prMarkdown: TranscriptMarkdown
    prTab: string
    prSetTab: action
    prClose: action
    prAct: action
    prCopy: action
    chatLocal: action
    home: PagesHome
    commandPending: bool
    command: action
    openConnectionsPage: action
    pagesOp: action
    // The window's inert for the main sidebar trigger (SidebarToggle), which the page's own dialogs add to.
    toggleInert: bool
    toggleSidebar: action
  // The pooled reset confirm closes for the page as its Cancel, Escape or Use credit is
  // pressed, so the page is no longer inert when the command's answer gives the segment the focus back (the
  // usage answer that drops the confirm comes later; Base UI's AlertDialog returns the focus as it closes).
  // A new ask from the page opens it again.
  // The pull request page's list and panel widths (moved from app.contract: only this page reads them).
  derive prPanelWidth = min(floor(viewport.width / 2), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 224)
  derive prListWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - (prSelected != "" and prPanelOpen ? prPanelWidth : 0)
  state usageClosing = ""
  derive usageConfirmOpen = usage.pooled.confirm != "" and usageClosing != usage.pooled.confirm
  action usageCommand(op: string, id: string, value: string, n: number)
    usageClosing = ""
    command(op, id, value, n)
  action usageConfirm(op: string, id: string, value: string, n: number)
    usageClosing = id
    command(op, id, value, n)
  view
    if pageCover
      box position="absolute" left=(data.sidebarOpen ? sidebarWidth : 0) top=0 right=0 bottom=0 inert=modal testId="pages-cover"
        if utilityPage == "usage"
          UsagePage(controlsLeft=data.controlsLeft, page=usage, keys=usageShortcuts, scheme=scheme, wide=(viewport.width >= 1280), lg=(viewport.width >= 1024), md=(viewport.width >= 768), sm=(viewport.width >= 640), sidebarOpen=data.sidebarOpen, op=pagesOp, setMetric=usageMetricSet, setWindow=usageWindowSet, setBreakdown=usageBreakdownSet, reload=usageRefreshNow, back=pageBack, command=usageCommand, confirmOpen=usageConfirmOpen, reduced=viewport.prefersReducedMotion, outside=outside)
        if utilityPage == "pull-requests"
          row position="absolute" left=0 top=0 right=0 bottom=0
            PrList(controlsLeft=data.controlsLeft, page=prList, scheme=scheme, query=(prTyped ? prQuery : prList.query), sidebarOpen=data.sidebarOpen, narrow=(prListWidth < 512), compact=(prListWidth < 428), panelOpen=(prSelected != "" and prPanelOpen), togglePanel=prTogglePanel, search=prType, control=prControl, select=prSelect, reload=prReload, addProject=paletteShow("command", "add-project"), act=prAct, back=pageBack)
            if prSelected != "" and prPanelOpen
              PrPanel(detail=prDetail, documents=prMarkdown.documents, scheme=scheme, width=prPanelWidth, tab=prTab, setTab=prSetTab, close=prClose, reload=prReload, act=prAct, copy=prCopy, still=viewport.prefersReducedMotion, select=prSelect, compact=(prPanelWidth < 480), back=pageBack, local=chatLocal)
            button press=prTogglePanel disabled=(prSelected == "") position="absolute" right="0.8125rem" top="0.75rem" width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 background-color=(prSelected != "" and prPanelOpen ? "light-dark(#27272a0d, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Toggle right panel" testId="pull-requests-toggle-panel" title=""
              PgIcon(name="panel-right", size=16, color="light-dark(#71717b, #818181)")
        if utilityPage == ""
          PagesLanding(controlsLeft=data.controlsLeft, home=home, scheme=scheme, sidebarOpen=data.sidebarOpen, busy=commandPending, command=command, addProject=paletteShow("command", "add-project"), openConnections=openConnectionsPage)
    // The main sidebar trigger is drawn here, whatever the page: after the chat and the page in paint and Tab order,
    // under the dialogs below, which cover the whole window as the reference's portaled dialogs cover SidebarControl.
    SidebarToggle(open=data.sidebarOpen, controlsLeft=data.controlsLeft, keySidebar=settings.keySidebar, artwork=data.look.artwork, inert=(toggleInert or (pageCover and utilityPage == "usage" and (usageConfirmOpen or usage.detail.open or usage.prices.open)) or prDetail.actions.dialogOpen or prDetail.actions.stack.dialogOpen), toggle=toggleSidebar)
    // Usage's model and Model prices dialogs cover the whole window, sidebar included (pages-usage-dialogs).
    // A pooled segment's reset credit confirm, outside its popover (UsageLimitsPooled RedeemableSegmentPopup).
    if pageCover and utilityPage == "usage" and usageConfirmOpen
      ResetCreditDialog(prefix="pageslocal:usage-pool", target=usage.pooled.confirm, busy=commandPending, command=usageConfirm)
    // Model prices and a model's dialog (which opens Model prices from its Set price) give the focus back to what opened
    // the first of them as the last closes (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=(pageCover and utilityPage == "usage" and usage.prices.open), owner="usage-prices-dialog")
    DialogFinalFocus(open=(pageCover and utilityPage == "usage" and usage.detail.open), owner="usage-model-dialog")
    if pageCover and utilityPage == "usage" and usage.prices.open
      UsagePricesLayer(page=usage, scheme=scheme, viewportHeight=viewport.height, busy=commandPending, op=pagesOp)
    if pageCover and utilityPage == "usage" and usage.detail.open and not usage.prices.open
      UsageModelLayer(page=usage, scheme=scheme, viewportHeight=viewport.height, sm=(viewport.width >= 640), op=pagesOp)

// The right panel as a sheet over a narrow window, with its click-away backdrop.
component RightSheets
  props
    data: Snapshot
    narrowDiff: bool
    modal: bool
    panelUi: action
    viewport: Viewport
    scheme: string
    diffWidth: number
    shell: ShellView
    command: action
    resizeDiff: action
    finishDiffResize: action
    rightPanel: bool
    detailsOpen: bool
    detailsAct: action
    chatLocal: action
    paletteShow: action
    prDetail: PrDetailView
    prDocuments: ChatDocument[]
    filesDocuments: ChatDocument[]
    prTab: string
    prSetTab: action
    prReload: action
    prAct: action
    prCopy: action
    confirm: action
    closePending: bool
  view
    if data.diffOpen and narrowDiff and not modal
      box position="absolute" top=0 bottom=0 left=0 right=0 background-color="#00000000" z-index=10 press=panelUi("close", "") aria-label="Close changes"
      box position="absolute" top=0 bottom=0 right=0 width=min(viewport.width, diffWidth) z-index=11
        DiffPanel(data=data, shell=shell, command=command, close=panelUi("close", ""), ui=panelUi, maximized=false, resize=resizeDiff, finishResize=finishDiffResize, scheme=scheme, sheet=true, detailsOpen=detailsOpen, details=detailsAct, local=chatLocal)
    if rightPanel and not data.diffOpen and narrowDiff and not modal
      box position="absolute" top=0 bottom=0 left=0 right=0 background-color="#00000000" z-index=10 press=panelUi("toggle", "") aria-label="Close right panel"
      box position="absolute" top=0 bottom=0 right=0 width=min(viewport.width, diffWidth) z-index=11
        SurfacePanel(shell=shell, sheet=true, maximized=false, detailsOpen=detailsOpen, still=viewport.prefersReducedMotion, ui=panelUi, details=detailsAct, local=chatLocal, command=command, paletteShow=paletteShow, scheme=scheme, prDetail=prDetail, prDocuments=prDocuments, filesDocuments=filesDocuments, prTab=prTab, prSetTab=prSetTab, prReload=prReload, prAct=prAct, prCopy=prCopy, look=data.look, confirm=confirm, closePending=closePending, width=min(viewport.width, diffWidth))
