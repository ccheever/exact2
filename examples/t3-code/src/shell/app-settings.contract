// The T3Code window's Settings view and dialogs, moved out of app.contract, which keeps the state,
// resources and actions: each component takes the root names it reads as props of the same names.

// A root-level provider link while Settings stays open. The reference keys
// ProviderSettingsPanelContent by the link's environment and instance (ProviderSettingsPanel.tsx), so a link to another
// target (A → B → A too) remounts the page and an open "Add custom model" field (ProviderModelsSection isAdding)
// closes; a link to the Providers page's own target keeps it. The target is the route's (the root's
// `providerLinkTarget`: the last link's instance, none after any other way onto the page), not the provider chosen on
// the page, which is the content's local state (`selectedInstanceId`). `providerVisit` counts those remounts, and the
// field counts only on the visit it was opened on.
fn providerLinkVisit(visit: number, onPage: bool, machine: string, target: string, nextMachine: string, nextTarget: string): number = (onPage and machine == nextMachine and target == nextTarget) ? visit : visit + 1
fn modelAddingOn(adding: string, openedOn: number, visit: number): string = openedOn == visit ? adding : ""

// Settings: the navigation, top bar and each route's panel, then the theme and restore dialogs.
component SettingsWindow
  inject
    rem: number
    routeKeyboard: RouteKeyboard
  props
    themeInspecting: bool
    settingsOpen: bool
    settingsCore: SettingsCore
    connecting: bool
    // The Connections confirmation asked for (connectionAskRemove), which "Remove from this device…" names by its environment.
    connectionRemove: string
    settingsThemeDialog: string
    data: Snapshot
    settingsNavigation: CoreNav
    settingsRoute: string
    settingsQuery: string
    sidebarWidth: number
    viewport: Viewport
    scheme: string
    settingsMenu: string
    modelsOpen: bool // Escape closes a General model picker, not Settings
    providerVisit: number // counts the root's provider links that changed the page's target
    paletteOpen: bool // the command palette over Settings owns Escape (its Dialog prevents it)
    chipOpen: bool // a skill chip's details over Settings own Escape (Base UI's Popover dismisses on it)
    editSettingsQueryRoot: action
    coreSearchKeyRoot: action
    corePickRoot: action
    coreClearSearch: action
    closeModal: action
    toggleSidebar: action
    navFocusWithin: action
    keySidebar: string
    commandPending: bool
    settingsScrollTop: number
    settingsPage: string // route, scope and restore count (app.contract)
    coreMenuClose: action
    coreMenu: action
    coreChange: action
    coreNavigateRoot: action
    coreScope: action
    coreNoticeScope: action
    coreThemeDialog: action
    sourceControl: SourceControlPage
    modalError: string
    rest: action
    restInput: action
    restLocal: action
    importWizardFocusMoved: action
    integrations: IntegrationsPage
    snapshotSettings: SnapshotSettings
    snapshotSetupOpen: bool
    toggleSnapshots: action
    showSnapshotSetup: action
    changeSnapshot: action
    previewSnapshotSound: action
    recordSnapshotShortcut: action
    saveSnapshotShortcut: action
    bindings: KeybindingPage
    keybindingQuery: string
    keybindingOpen: bool
    keybindingPrevious: string
    keybindingCommand: string
    keybindingKey: string
    keybindingWhen: string
    keybindingRecording: bool
    editKeybindingQuery: action
    newKeybinding: action
    cancelKeybinding: action
    chooseKeybindingCommand: action
    editKeybinding: action
    editKeybindingKey: action
    editKeybindingWhen: action
    recordKeybinding: action
    captureKeybinding: action
    keybindingDrafts: KeybindingDraft[]
    keybindingRest: action
    keybindingHeld: action // a keybinding field took or lost the focus (T3Window outsidePressDown)
    scheduled: ScheduledPage
    restEditor: string
    restOpen: action
    storageSettings: StoragePage
    archives: ArchivePage
    restMenu: string
    restRaw: action
    restMenuOpen: action
    restClose: action
    licenses: LicenseSettings
    licenseQuery: string
    editLicenseQuery: action
    toggleLicense: action
    retryLicenses: action
    diagnostics: DiagnosticsPage
    selectDiagnosticPeriod: action
    refreshSettings: action
    copyDiagnostic: action
    connectionsPage: ConnectionsPage
    pendingModal: string
    openConnection: action
    connectionOp: action
    connectionAskRemove: action
    connectionMenu: string
    connectionToggleMenu: action
    openRoute: action
    providerPage: ProviderPage
    providerDialog: string
    providerUi: action
    providerOp: action
    providerAccent: action
    setupBusy: bool
    projectsSettings: ProjectsPage
    settingsThemeSubject: string
    coreThemeChange: action
    settingsCommand: action
    // The app sidebar's width and its rail's drag (AppSidebarLayout: Settings renders inside
    // the app Sidebar, whose SidebarRail resizes the one width both navs share).
    resizeSidebar: action
    finishResize: action
    resetSidebarWidth: action
  // Settings' view-only state lives here, not in app.contract, so the root keeps its lines for what resources read:
  // the search's held Escape, the legacy rows, the restore dialog and the keybinding and licence searches. A
  // wrapper sets it, then calls the root's half (`…Root`), which keeps what a resource reads.
  state settingsEscapeHeld = false
  state settingsLegacyOpen = false
  state settingsRestoreOpen = false
  state licenseSearchOpen = false
  // The "Models" block whose "Add custom model" field is open (ProviderModelsSection
  // isAdding, by the block's key: a successful add gives the block a new one), the field whose onKeyDown would take
  // Escape and that has the focus ("keybindings-filter", "license-search", "custom-model-slug"), and whether the
  // pointer is over the sidebar rail ("Drag to resize sidebar"). T3Window mounts this view only while Settings is
  // open, so all of it starts over each time, as the reference's settings route remounts.
  state modelAdding = ""
  // The provider link visit the field was opened on (providerLinkVisit above).
  state modelAddingVisit = 0
  derive modelAddingLive = modelAddingOn(modelAdding, modelAddingVisit, providerVisit)
  state escapeFocus = ""
  state railHover = false
  state updateTipHover = false // the Settings nav's SidebarUpdatePill (its tooltip is drawn below, past the nav)
  derive modelAddingShown = modelAddingLive != "" and providerPage.editors.filter((shown) => shown.modelBlocks.map((models) => models.key).includes(modelAddingLive)).length > 0
  // Escape belongs to the innermost thing that owns it (useEscapeToGoBack runs only for an
  // Escape nothing prevented): a popup or menu, an inline editor, a recording shortcut, or a field whose onKeyDown
  // takes it, which hears it only while it has the focus. The command palette opened over Settings is a Dialog whose
  // Escape closes only itself. While one owns it, Back gives up its Escape shortcut; with
  // none (a search left open with a query, the focus elsewhere), Escape leaves Settings. The When editor's and the
  // font list's popovers and the recorder are `aria-modal` too, and the dialogs make this view inert (below).
  derive escapeOwned = routeKeyboard.phase != "" or settingsMenu != "" or modelsOpen or paletteOpen or chipOpen or themeInspecting or settingsRestoreOpen or settingsEscapeHeld or snapshotSetupOpen or (settingsRoute == "keybindings" and (keybindingRecording or escapeFocus == "keybindings-filter")) or (settingsRoute == "open-source-licenses" and licenseSearchOpen and escapeFocus == "license-search") or (settingsRoute == "providers" and (providerPage.escapeOwned or (modelAddingShown and escapeFocus == "custom-model-slug")))
  // A Settings dialog is modal (Base UI Dialog): the page behind it is inert, so Back's Escape is the dialog's.
  // "Remove from this device…" (EnvironmentRemoveDialog) counts here; Network access's confirmation does not, as it stays
  // asked for after its serial moves on, when no dialog shows. Both are `aria-modal` too.
  derive dialogShown = restEditor != "" or settingsCore.saOpen or settingsCore.archiveConfirm.id != "" or connectionsPage.environments.filter(environment => environment.key == connectionRemove).length > 0
  action editSettingsQuery(value: string)
    settingsEscapeHeld = false
    editSettingsQueryRoot(value)
  action coreSearchKey(k: string)
    if k == "Escape"
      settingsEscapeHeld = settingsQuery != ""
    if k == "Enter" and settingsNavigation.firstRoute != "" and settingsNavigation.firstId.startsWith("search-result-legacy-")
      settingsLegacyOpen = true
    coreSearchKeyRoot(k)
  action coreNavigate(route: string)
    settingsEscapeHeld = false
    modelAdding = ""
    coreNavigateRoot(route)
  action corePick(route: string, target: string, scope: string, id: string)
    if id.startsWith("search-result-legacy-")
      settingsLegacyOpen = true
    modelAdding = ""
    corePickRoot(route, target, scope, id)
  // The Providers page's `ui`: "model-adding" opens (the block's key) or closes ("") an "Add custom model" field;
  // "slug-focus" is its slug field taking ("true") or losing ("") the focus. A provider chosen in the list unmounts
  // the open field, as the reference's section does. The rest is the root's.
  action providerUiWindow(what: string, value: string)
    if what == "model-adding" or what == "slug-focus"
      modelAddingUi(what, value)
    else
      if what == "select"
        modelAdding = ""
      providerUi(what, value)
  action modelAddingUi(what: string, value: string)
    if what == "model-adding"
      modelAdding = value
      modelAddingVisit = providerVisit
    escapeFocusSet("custom-model-slug", what == "slug-focus" and value == "true")
  // A field that takes Escape gains or loses the focus. A field that closes on its own Escape is gone before its
  // blur could say so, so its Escape clears it here too.
  action escapeFocusSet(field: string, focused: bool)
    escapeFocus = focused ? field : (escapeFocus == field ? "" : escapeFocus)
  action hoverRail(id: string, over: bool)
    railHover = over
  action hoverUpdateTip(id: string, over: bool)
    updateTipHover = over
  action coreLegacy
    settingsLegacyOpen = not settingsLegacyOpen
  action coreRestoreOpen
    settingsRestoreOpen = true
  action coreRestoreClose
    settingsRestoreOpen = false
  action coreRestoreConfirm
    settingsRestoreOpen = false
    settingsCommand("settings-core", `restore-device-defaults:|${settingsCore.scopeKey}`, "")
  action coreSlide(row: string, part: string, value: number)
    settingsCommand("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, `${value}`)
  // KeybindingsSearchInput: Escape clears the filter, then leaves the field; Settings' Back takes neither.
  action keybindingSearchKey(name: string)
    if name == "Escape"
      preventDefault()
      if keybindingQuery != ""
        editKeybindingQuery("")
      else
        escapeFocusSet("keybindings-filter", false)
        blur("keybindings-filter")
  action openLicenseSearch
    licenseSearchOpen = true
  action closeLicenseSearch
    if licenseQuery == ""
      licenseSearchOpen = false
    escapeFocusSet("license-search", false)
  action licenseSearchKey(name: string)
    if name == "Escape"
      preventDefault()
      licenseSearchOpen = false
      escapeFocusSet("license-search", false)
      editLicenseQuery("")
  view
    if settingsOpen
      // Settings is a route in the reference (its sidebar is navigation "Settings"), no dialog: the row writes no
      // `role="dialog"`, which the Mac exposes as AXApplicationDialog since main #457.
      row position="absolute" left=0 top=0 width="100%" height="100%" background-color=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas) inert=(connecting or dialogShown or (settingsThemeDialog != "" and settingsThemeDialog != "create" and settingsThemeDialog != "edit" and settingsThemeDialog != "duplicate") or settingsRestoreOpen or providerDialog != "") testId="settings-dialog" id="settings-dialog" data-paint="canvas" data-pick=(("canvas" == "" ? "" : "canvas") != "" ? ("canvas" == "" ? "" : "canvas") : "")
        if data.sidebarOpen
          SettingsNav(controlsLeft=data.controlsLeft, nav=settingsNavigation, route=settingsRoute, query=settingsQuery, width=sidebarWidth, pal=settingsCore.palette, active=0, artwork=data.look.artwork, menuOpen=escapeOwned, edit=editSettingsQuery, onKey=coreSearchKey, pick=corePick, clear=coreClearSearch, back=closeModal, updateTip=hoverUpdateTip, focusWithin=navFocusWithin)
        column flex=1 min-width=0 height="100%" box-sizing="border-box"
          SettingsTopBar(controlsLeft=data.controlsLeft, route=settingsRoute, crumb=settingsCore.breadcrumb, pal=settingsCore.palette, busy=commandPending, restorable=(settingsCore.restoreCount > 0), navOpen=data.sidebarOpen, restore=coreRestoreOpen)
          // Each page owns its scroller (SettingsPageContainer's `data-settings-page-scroll`): a new page opens at its top.
          for page in [settingsPage] key=page
            scroll flex=1 min-height=0 width="100%" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" id="settings-content-scroll" scrollTop=settingsScrollTop scroll-behavior="smooth" testId="settings-content-scroll"
              column gap="1.125rem" width="100%" max-width=(settingsRoute == "diagnostics" ? "72rem" : "56rem") min-width=0 margin-left="auto" margin-right="auto" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="3rem" box-sizing="border-box" position="relative" id="settings-content-column"
                if settingsMenu != ""
                  button press=coreMenuClose position="absolute" left=0 top=0 width="100%" height="100%" z-index=40 background-color="#00000000" aria-label="Close menu" aria-keyshortcuts="Escape" testId="settings-menu-backdrop" title=""
                if settingsCore.showScope or settingsRoute == "general" or settingsRoute == "appearance"
                  SettingsCoreBody(reduced=viewport.prefersReducedMotion, core=settingsCore, route=settingsRoute, busy=commandPending, menu=settingsMenu, legacyOpen=settingsLegacyOpen, toggleLegacy=coreLegacy, openMenu=coreMenu, closeMenu=coreMenuClose, change=coreChange, slide=coreSlide, navigate=coreNavigate, choose=coreScope, noticeChoose=coreNoticeScope, dialog=coreThemeDialog)
                if settingsRoute == "source-control"
                  SourceControlPanel(data=sourceControl, busy=commandPending, error=modalError, rest=rest, restInput=restInput, restLocal=restLocal)
                if settingsRoute == "integrations"
                  IntegrationsPanel(data=integrations, busy=commandPending, error=modalError, rest=rest, restInput=restInput, local=restLocal)
                if settingsRoute == "snap-shot"
                  SnapshotPanel(data=snapshotSettings, busy=commandPending, setupOpen=snapshotSetupOpen, toggle=toggleSnapshots, setup=showSnapshotSetup(true), change=changeSnapshot, preview=previewSnapshotSound, record=recordSnapshotShortcut, saveShortcut=saveSnapshotShortcut)
                if settingsRoute == "keybindings"
                  KeybindingsPanel(data=bindings, query=keybindingQuery, adding=keybindingOpen, draftRow=keybindingPrevious, draftCommand=keybindingCommand, draftKey=keybindingKey, draftWhen=keybindingWhen, drafts=keybindingDrafts, recording=keybindingRecording, busy=commandPending, error=modalError, search=editKeybindingQuery, searchKey=keybindingSearchKey, searchFocus=escapeFocusSet("keybindings-filter", true), searchBlur=escapeFocusSet("keybindings-filter", false), add=newKeybinding, cancelAdd=cancelKeybinding, chooseCommand=chooseKeybindingCommand, edit=editKeybinding, setKey=editKeybindingKey, setWhen=editKeybindingWhen, record=recordKeybinding, capture=captureKeybinding, held=keybindingHeld, save=keybindingRest, openFile=rest("keybinding-open", ""))
                if settingsRoute == "scheduled-tasks"
                  ScheduledPanel(data=scheduled, busy=commandPending, error=(restEditor == "" ? modalError : ""), open=restOpen, rest=rest)
                if settingsRoute == "storage"
                  StoragePanel(data=storageSettings, busy=commandPending, error=modalError, rest=rest, restInput=restInput)
                if settingsRoute == "archived"
                  ArchivedPanel(data=archives, busy=commandPending, error=(restEditor == "" ? modalError : ""), menu=restMenu, raw=restRaw, open=restOpen, showMenu=restMenuOpen, close=restClose)
                if settingsRoute == "open-source-licenses"
                  NoticesPanel(data=licenses, query=licenseQuery, searchOpen=licenseSearchOpen, edit=editLicenseQuery, openSearch=openLicenseSearch, closeSearch=closeLicenseSearch, searchKey=licenseSearchKey, focusSearch=escapeFocusSet("license-search", true), toggle=toggleLicense, retry=retryLicenses)
                if settingsRoute == "diagnostics"
                  DiagnosticsPanel(data=diagnostics, busy=commandPending, selectPeriod=selectDiagnosticPeriod, reload=refreshSettings, copy=copyDiagnostic, rest=rest, local=restLocal)
                // Both panels get the content column's width: its 56rem cap less its 1.5rem sides (readable SettingsPageContainer).
                if settingsRoute == "connections"
                  ConnectionsPanel(page=connectionsPage, width=min(896, viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 12) - 48, busy=commandPending, error=(connecting or pendingModal != "" ? "" : modalError), add=openConnection, op=connectionOp, remove=connectionAskRemove, menu=connectionMenu, toggleMenu=connectionToggleMenu, addRoute=openRoute, still=viewport.prefersReducedMotion)
                if settingsRoute == "providers"
                  ProvidersPanel(page=providerPage, scheme=scheme, width=min(896, viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 12) - 48, height=viewport.height, busy=commandPending, setupBusy=setupBusy, error=(providerDialog == "" ? modalError : ""), select=providerUiWindow("select"), op=providerOp, accent=providerAccent, ui=providerUiWindow, addingUi=modelAddingUi, modelAdding=modelAddingLive)
                if settingsRoute == "projects"
                  ProjectsPanel(data=projectsSettings, busy=commandPending, error=(restEditor == "" ? modalError : ""), choose=coreNoticeScope, rest=rest, restInput=restInput, raw=restRaw, open=restOpen)
                    for row in settingsCore.projectModel key=row.id
                      CoreRowView(reduced=viewport.prefersReducedMotion, row=row, section="project-defaults", pal=settingsCore.palette, codePreview=settingsCore.codePreview, busy=commandPending, menu=settingsMenu, openMenu=coreMenu, closeMenu=coreMenuClose, change=coreChange, slide=coreSlide, navigate=coreNavigate)
                if modalError != "" and settingsRoute != "projects" and settingsRoute != "scheduled-tasks" and settingsRoute != "source-control" and settingsRoute != "integrations" and settingsRoute != "keybindings" and settingsRoute != "storage" and settingsRoute != "archived" and not snapshotSetupOpen
                  text modalError font-size="0.75rem" color="light-dark(#b91c1c, #fca5a5)" role="alert" testId="settings-error"
        SettingsSidebarToggle(controlsLeft=data.controlsLeft, route=settingsRoute, pal=settingsCore.palette, artwork=data.look.artwork, open=data.sidebarOpen, keySidebar=keySidebar, toggle=toggleSidebar)
        // The app Sidebar's SidebarRail over the settings nav's edge (sidebar-rail.contract), and
        // its "Drag to resize sidebar" (side right, as SidebarEdgeTips draws the thread sidebar's).
        if data.sidebarOpen
          SidebarWindowRail(width=sidebarWidth, hovered=railHover, line=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #262626)"), fill=(data.look.themed ? data.look.sidebarBorder : "light-dark(#e4e4e7, #1d1d1d)"), resize=resizeSidebar, finishResize=finishResize, resetWidth=resetSidebarWidth, hoverCard=hoverRail)
          row position="absolute" left=(sidebarWidth + 0.6875 * rem) top=0 bottom=0 align-items="center" pointer-events="none" z-index=140
            TipCard(label="Drag to resize sidebar", shown=railHover)
          // SidebarUpdatePill's "Check for updates" (side top), centred on the pill 24pt in from the nav's edge.
          row position="absolute" left=(sidebarWidth - 14 * rem) width="25rem" bottom="2.5rem" justify-content="center" pointer-events="none" z-index=140
            TipCard(label="Check for updates", shown=updateTipHover)
    // Each dialog gives the focus back to the control that opened it as it closes (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=(settingsOpen and settingsThemeDialog == "background-activity"), owner="background-activity-dialog")
    DialogFinalFocus(open=(settingsOpen and settingsThemeDialog == "import"), owner="add-theme-dialog")
    DialogFinalFocus(open=(settingsOpen and settingsThemeDialog == "remove" and settingsCore.themes.filter(card => card.id == settingsThemeSubject and card.collection).length > 0), owner="theme-remove-collection")
    DialogFinalFocus(open=(settingsOpen and settingsThemeDialog == "remove" and settingsCore.themes.filter(card => card.id == settingsThemeSubject and not card.collection).length > 0), owner="theme-remove")
    DialogFinalFocus(open=(settingsOpen and settingsCore.hostEditor.open), owner="device-host-dialog")
    DialogFinalFocus(open=(settingsOpen and settingsCore.easEditor.open), owner="eas-host-dialog")
    DialogFinalFocus(open=(settingsOpen and settingsRestoreOpen), owner="restore-defaults-dialog")
    DialogFinalFocus(open=(settingsOpen and settingsCore.updateConfirm), owner="update-install")
    DialogFinalFocus(open=(settingsOpen and settingsCore.killConfirm.pid != ""), owner="signal-kill")
    DialogFinalFocus(open=(settingsOpen and settingsCore.archiveConfirm.id != ""), owner="archive-context-delete")
    if settingsOpen and (settingsThemeDialog != "" or settingsCore.archiveConfirm.id != "" or settingsCore.saOpen)
      SettingsADialogs(core=settingsCore, kind=settingsThemeDialog, subject=settingsThemeSubject, viewportHeight=viewport.height, busy=commandPending, error=modalError, menu=settingsMenu, openMenu=coreMenu, close=coreThemeDialog("", ""), commit=coreChange, change=coreThemeChange, raw=restRaw, rest=rest, local=restLocal)
    if settingsOpen and settingsRestoreOpen
      SettingsRestoreDialog(core=settingsCore, busy=commandPending, cancel=coreRestoreClose, confirm=coreRestoreConfirm)
    // "Remove “<name>”?" and the cookie import wizard (browser-profiles.contract), over the window.
    if settingsOpen and settingsRoute == "integrations"
      BrowserProfileDialogs(view=integrations.browserProfiles, local=restLocal, track=importWizardFocusMoved, still=viewport.prefersReducedMotion)

// Settings editors: the scheduled-task and project dialogs (settings-rest/settings-b).
component ProjectDialogs
  props
    restEditor: string
    restSubject: string
    restLabel: string
    scheduled: ScheduledPage
    projectsSettings: ProjectsPage
    commandPending: bool
    modalError: string
    rest: action
    restRaw: action
    restClose: action
    // The scheduled task editor's Runs on reopens it on another environment (settings-scheduled.contract ScheduledEditor).
    restOpen: action
    sbPicker: SbPicker
    sbQuery: string
    sbLettersEdited: bool
    sbLetters: string
    sbEmoji: string
    viewport: Viewport
    scheme: string
    sbSet: action
    taskBase: action
    // The thread details card's scripts: its Add project script button, or the scripts menu's toggle once it has one.
    cardScripts: bool
  view
    // Each editor gives the focus back to the control that opened it as it closes (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=(restEditor == "task-deliveries"), owner="webhook-deliveries-dialog")
    DialogFinalFocus(open=(restEditor == "task"), owner="scheduled-task-dialog")
    DialogFinalFocus(open=(restEditor == "project-remove"), owner="project-remove")
    DialogFinalFocus(open=(restEditor == "project-remove-member"), owner="project-remove-member")
    DialogFinalFocus(open=(restEditor == "archive-delete"), owner="archive-delete")
    DialogFinalFocus(open=(restEditor == "project-action" or restEditor == "card-action"), owner="project-action-dialog")
    DialogFinalFocus(open=(restEditor == "project-icon"), owner="project-icon-dialog")
    DialogFinalFocus(open=(restEditor == "project-favicon"), owner="project-favicon-picker")
    SettingsRestDialogs(editor=restEditor, subject=restSubject, label=restLabel, scheduled=scheduled, projects=projectsSettings, busy=commandPending, error=modalError, rest=rest, raw=restRaw, close=restClose, open=restOpen, taskBase=taskBase)
    if restEditor == "project-action"
      ProjectActionDialog(data=projectsSettings, subject=restSubject, busy=commandPending, error=modalError, raw=restRaw, close=restClose)
    // The thread details card's Add project script (ProjectScriptsControl openAddDialog): a new action for `restSubject`, the thread's project.
    if restEditor == "card-action"
      for blank in projectsSettings.blankActions key=blank.id
        ProjectActionEditor(item=blank, scope=restSubject, editing=false, busy=commandPending, error=modalError, raw=restRaw, close=restClose)
    if restEditor == "project-icon"
      ProjectIconDialog(data=projectsSettings, picker=sbPicker, query=sbQuery, letters=(sbLettersEdited ? sbLetters : projectsSettings.iconLetters), custom=sbEmoji, dark=(scheme == "dark"), busy=commandPending, error=modalError, raw=restRaw, set=sbSet, close=restClose)
    if restEditor == "project-favicon"
      ProjectFaviconDialog(data=projectsSettings, picker=sbPicker, query=sbQuery, vw=viewport.width, vh=viewport.height, dark=(scheme == "dark"), busy=commandPending, raw=restRaw, set=sbSet, close=restClose)

// Settings dialogs: snapshot setup, Add environment, the provider wizards and removal confirms.
component SettingsModals
  props
    snapshotSetupOpen: bool
    snapshotSettings: SnapshotSettings
    commandPending: bool
    modalError: string
    snapshotSetupWasEnabled: bool
    snapshotSetupFrom: string
    showSnapshotSetup: action
    toggleSnapshots: action
    changeSnapshot: action
    recordSnapshotShortcut: action
    saveSnapshotShortcut: action
    connecting: bool
    origin: string
    pairFields: PairFields
    credential: string
    data: Snapshot
    viewport: Viewport
    scheme: string
    sbSshHosts: SbSshHosts
    sbSshHost: string
    editOrigin: action
    editCredential: action
    connectionOp: action
    sbSet: action
    closeConnection: action
    providerDialog: string
    providerWizard: ProviderWizard
    acpAgents: AcpRegistry
    wizardStep: number
    wizardAttempted: bool
    wizardLabelSet: bool
    wizardLabel: string
    wizardIdSet: bool
    wizardId: string
    acpQuery: string
    wizardManual: bool
    providerUi: action
    providerAdd: action
    providerOp: action
    providerPage: ProviderPage
    providerTarget: string
    setupBusy: bool
    connectionRemove: string
    connectionsPage: ConnectionsPage
    connectionAskRemove: action
    routeTarget: string
    routeLabel: string
    // The Local environment switch's command (settingsCommand: the dialog stays open while it runs).
    localCommand: action
  view
    // Each dialog gives the focus back to the control that opened it as it closes (dialog-trap.contract DialogFinalFocus).
    DialogFinalFocus(open=snapshotSetupOpen, owner="snapshot-setup-dialog")
    DialogFinalFocus(open=(providerDialog == "add"), owner="add-provider-dialog")
    DialogFinalFocus(open=(providerDialog == "chatgpt"), owner="chatgpt-account-dialog")
    DialogFinalFocus(open=(providerDialog == "hub"), owner="usage-hub-dialog")
    DialogFinalFocus(open=(providerDialog == "hub-remove"), owner="usage-hub-remove-dialog")
    if snapshotSetupOpen
      SnapshotSetup(data=snapshotSettings, busy=commandPending, error=modalError, wasEnabled=snapshotSetupWasEnabled, close=showSnapshotSetup(false), toggle=toggleSnapshots, change=changeSnapshot, record=recordSnapshotShortcut, saveShortcut=saveSnapshotShortcut)
    if connecting
      AddEnvironmentDialog(origin=origin, credential=credential, pairFields=pairFields, connected=data.connected, available=data.available, viewportHeight=viewport.height, busy=commandPending, error=modalError, sshHosts=sbSshHosts, sshHost=sbSshHost, editOrigin=editOrigin, editCredential=editCredential, submit=connectionOp("environment-add", origin, credential), set=sbSet, ssh=connectionOp, closeDialog=closeConnection, routeTarget=routeTarget, routeLabel=routeLabel)
    if providerDialog == "add"
      for session in providerWizard.sessions key=session.key
        AddProviderDialog(wizard=providerWizard, acp=acpAgents, step=wizardStep, attempted=wizardAttempted, labelSet=wizardLabelSet, label=wizardLabel, idSet=wizardIdSet, id=wizardId, query=acpQuery, manual=wizardManual, viewportHeight=viewport.height, scheme=scheme, busy=commandPending, setupBusy=setupBusy, error=modalError, ui=providerUi, add=providerAdd, op=providerOp)
    if providerDialog == "chatgpt"
      for session in providerWizard.sessions key=session.key
        ChatGptAccountDialog(wizard=providerWizard, busy=commandPending, setupBusy=setupBusy, error=modalError, close=providerUi("close", ""), create=providerOp("provider-chatgpt", ""), op=providerOp, ui=providerUi)
    // Reconnect ChatGPT (ChatGptAccountPicker) for the instance that opened it.
    if providerDialog == "codex-picker"
      for picker in providerWizard.codexPicker key=picker.key
        ChatGptAccountPicker(picker=picker, busy=setupBusy, op=providerOp, ui=providerUi)
    if providerDialog == "hub"
      for session in providerWizard.sessions key=session.key
        UsageHubDialog(environment=providerWizard.environment, busy=commandPending, error=modalError, close=providerUi("close", ""), save=providerOp("provider-hub-add"))
    if providerDialog == "hub-remove"
      for hub in providerPage.hubs key=hub.id
        if hub.id == providerTarget
          HubRemoveDialog(hub=hub, busy=commandPending, cancel=providerUi("close", ""), confirm=providerOp("provider-hub-remove", "", hub.id, "", true))
    // Sign out (the Account row) and Remove (the Antigravity runtime) ask first.
    if providerDialog == "setup-logout" or providerDialog == "setup-remove"
      for editor in providerPage.editors key=editor.key
        if editor.id == providerTarget
          for account in (providerDialog == "setup-logout" ? editor.setup.account : []) key=account.key
            ProviderSetupConfirm(what=providerDialog, instanceId=editor.id, title=account.signOutTitle, body=account.signOutBody, busy=setupBusy, op=providerOp, ui=providerUi)
          for runtime in (providerDialog == "setup-remove" ? editor.setup.runtime : []) key=runtime.key
            ProviderSetupConfirm(what=providerDialog, instanceId=editor.id, title=runtime.removeTitle, body=runtime.removeBody, busy=setupBusy, op=providerOp, ui=providerUi)
    // An ACP session's Delete and an ACP provider's Disable ask first (dialogs.confirm, destructive).
    if providerDialog == "acp-delete" or providerDialog == "acp-disable"
      for editor in providerPage.editors key=editor.key
        for acp in editor.upkeep.acp key=acp.key
          for session in (providerDialog == "acp-delete" ? acp.sessions : []) key=session.key
            if session.confirmKey == providerTarget
              AcpConfirm(title=session.deleteTitle, instanceId=acp.instanceId, what=providerDialog, target=session.sessionId, busy=setupBusy, op=providerOp, ui=providerUi)
          for provider in (providerDialog == "acp-disable" ? acp.providers : []) key=provider.key
            if provider.confirmKey == providerTarget
              AcpConfirm(title=provider.disableTitle, instanceId=acp.instanceId, what=providerDialog, target=provider.providerId, busy=setupBusy, op=providerOp, ui=providerUi)
    // "Turn off/on local environment?" (this-machine.contract): open until the switch reads the new value.
    if (connectionRemove == "local-environment:off" and connectionsPage.thisMachine.enabled) or (connectionRemove == "local-environment:on" and not connectionsPage.thisMachine.enabled)
      LocalEnvironmentDialog(title=connectionsPage.thisMachine.dialogTitle, body=connectionsPage.thisMachine.dialogBody, confirmLabel=connectionsPage.thisMachine.dialogConfirm, destructive=connectionsPage.thisMachine.enabled, busy=commandPending, error=connectionsPage.thisMachine.error, still=viewport.prefersReducedMotion, cancel=connectionAskRemove(""), confirm=localCommand("local-environment", "", connectionsPage.thisMachine.enabled ? "off" : "on"))
    // Network access, Tailscale HTTPS, Create pairing link and the reveal dialog (connections-network-dialogs.contract).
    NetworkDialogs(net=connectionsPage.network, remove=connectionRemove, ask=connectionAskRemove, command=localCommand, busy=commandPending, still=viewport.prefersReducedMotion)
    DialogFinalFocus(open=(connectionsPage.environments.filter(environment => connectionRemove == environment.key).length > 0), owner="environment-remove-dialog")
    DialogFinalFocus(open=(connectionRemove != "" and connectionsPage.environments.filter(environment => environment.routes.filter(route => route.target == connectionRemove).length > 0).length > 0), owner="route-remove-dialog")
    if connectionRemove != ""
      for environment in connectionsPage.environments key=environment.key
        if environment.key == connectionRemove
          EnvironmentRemoveDialog(environment=environment, busy=commandPending, cancel=connectionAskRemove(""), confirm=connectionOp("environment-forget", environment.origin, environment.environmentId))
        // "Remove <label> route?" for one of its routes.
        for route in environment.routes key=route.id
          if route.target == connectionRemove
            RouteRemoveDialog(route=route, busy=commandPending, cancel=connectionAskRemove(""), confirm=connectionOp("environment-route-remove", environment.key, route.id))
    // ChatGptWelcomeCoordinator's "Your ChatGPT plan is connected", once per profile.
    DialogFinalFocus(open=(data.chatgptPlan.length > 0), owner="chatgpt-plan-dialog")
    for notice in data.chatgptPlan key=notice.key
      ChatGptPlanDialog(notice=notice, busy=setupBusy, op=providerOp)
