// also the Usage page's pages:usage-* ops
fn stepWelcomeImport(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionWelcomeImportGuard1(
  d,
  s,
  op,
  id,
  value
)

fn transitionWelcomeImportWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendLocalChanged=true,
    local=CommandArgs(
      p0=op.startsWith("usage-") ? `pageslocal:${op}` : `pageslocal:welcome-${op}`,
      p1=id,
      p2=value,
      p3=0
    )
  )
)

fn transitionWelcomeImportWrites3(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0=op == "import" ? "pageslocal:welcome-import" : "pageslocal:usage-prices-save",
      p1="",
      p2=`${s.wallTime.epochAtZero + performanceNow()}`,
      p3=0
    )
  )
)

fn transitionWelcomeImportGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  op != "import" and op != "usage-prices-save"
  ? transitionWelcomeImportWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : not s.commandPending
  ? transitionWelcomeImportWrites3(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

fn stepWelcomePair(
  d: UiDecision,
