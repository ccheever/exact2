  s
)

fn transitionWelcomePairWrites2(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    writePendingModal=true,
    pendingModal="welcome-pair",
    writeModalError=true,
    modalError="",
    changedKind="command",
    command=CommandArgs(
      p0="welcome-pair",
      p1="",
      p2=s.welcomeLink,
      p3=0
    ),
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionWelcomePairGuard1(
  d: UiDecision,
  s: UiStart
): UiDecision = (
  not s.commandPending and s.welcomeLink.trim() != ""
  ? transitionWelcomePairWrites2(
    d,
    s
  )
  : d
)

