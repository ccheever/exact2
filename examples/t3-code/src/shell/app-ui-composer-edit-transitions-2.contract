    )
  )
)

fn stepWelcomeTogglePair(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionWelcomeTogglePairWrites1(
  d,
  s
)

fn transitionWelcomeTogglePairWrites1(
  d: UiDecision,
