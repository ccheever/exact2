use ComposerFieldObservation, ComposerIntentMetadata from "../composer/composer-rich.contract"
use composerChipEdge, composerChipInside from "../composer/composer-rich.contract"
use AppDecision, CommandArgs, SelectionDirectionArgs, TextArgs from "./app-decisions.contract"
use ComposerDraftState, ComposerIntentState, KeybindingEditorState from "./app-protocols.contract"
use SettingsPageState from "./app-protocols.contract"
use stepComposerIntentClear from "./app-ui-composer-edit-transitions.contract"
use stepComposerSelectionObserved from "./app-ui-composer-edit-transitions.contract"
use UiDecision from "./app-ui-decisions.contract"
use stepEditKeybinding from "./app-ui-dispatch-transitions.contract"
use stepOpenSettings from "./app-ui-navigation-transitions.contract"
use stepRestRaw from "./app-ui-providers-transitions.contract"
use UiStart from "./app-ui-start.contract"

fn stepSidebarRun(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionSidebarRunGuard3(
  transitionSidebarRunGuard1(
    d,
    s,
    op,
    id,
    value
  ),
  s,
  op,
  id,
  value
)

fn transitionSidebarRunWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    hostBlur=true
  )
)

fn transitionSidebarRunGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  s.composerDraft.focused and (op == "menu-choice" or op == "draft-choice"
    or op == "legacy-thread-menu")
  ? transitionSidebarRunWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

fn transitionSidebarRunWrites4(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0=`sidebar:${op}`,
      p1=id,
      p2=value,
      p3=s.wallTime.epochAtZero + performanceNow()
    )
  )
)

fn transitionSidebarRunGuard3(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  not s.commandPending
  ? transitionSidebarRunWrites4(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

// the title's rename commit or New thread (T3Window titleUi)
fn stepTitleSend(
  d: UiDecision,
  s: UiStart,
  what: string,
  text: string
): UiDecision = transitionTitleSendGuard1(
  d,
  s,
  what,
  text
)

fn transitionTitleSendWrites2(
  d: UiDecision,
  s: UiStart,
  what: string,
  text: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0=what == "commit" ? "shell:rename" : "new-thread",
      p1=what == "commit" ? s.data.threadId : s.data.projectId,
      p2=text,
      p3=0
    )
  )
)

fn transitionTitleSendWrites4(
  d: UiDecision,
  s: UiStart,
  what: string,
  text: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeJumpRequest=true,
    jumpRequest=s.jumpRequest + 1,
    hostFocus=true,
    focus=TextArgs(
      p0="composer"
    ),
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionTitleSendGuard3(
  d: UiDecision,
  s: UiStart,
  what: string,
  text: string
): UiDecision = (
  what == "new-thread"
  ? transitionTitleSendWrites4(
    d,
    s,
    what,
    text
  )
  : d
)

fn transitionTitleSendGuard1(
  d: UiDecision,
  s: UiStart,
  what: string,
  text: string
): UiDecision = (
  not s.commandPending
  ? transitionTitleSendGuard3(
    transitionTitleSendWrites2(
      d,
      s,
      what,
      text
    ),
    s,
    what,
    text
  )
  : d
)

