fn stepImportWizardFocusMoved(
  d: UiDecision,
  s: UiStart,
  id: string,
  on: bool
): UiDecision = transitionImportWizardFocusMovedGuard1(
  d,
  s,
  id,
  on
)

fn transitionImportWizardFocusMovedWrites2(
  d: UiDecision,
  s: UiStart,
  id: string,
  on: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeImportWizardFocused=true,
    importWizardFocused=id
  )
)

fn transitionImportWizardFocusMovedWrites3(
  d: UiDecision,
  s: UiStart,
  id: string,
  on: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeImportWizardFocused=true,
    importWizardFocused=""
  )
)

fn transitionImportWizardFocusMovedGuard1(
  d: UiDecision,
  s: UiStart,
  id: string,
  on: bool
): UiDecision = (
  on
  ? transitionImportWizardFocusMovedWrites2(
    d,
    s,
    id,
    on
  )
  : s.importWizardFocused == id
  ? transitionImportWizardFocusMovedWrites3(
    d,
    s,
    id,
    on
  )
  : d
)

fn stepNoticeDismiss(
  d: UiDecision,
  s: UiStart,
  notice: string,
  op: string,
  target: string
): UiDecision = transitionNoticeDismissGuard1(
  d,
  s,
  notice,
  op,
  target
)

fn transitionNoticeDismissWrites2(
  d: UiDecision,
  s: UiStart,
  notice: string,
  op: string,
  target: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeNoticeExitState=true,
    noticeExitState=NoticeExitState(
      d.root.noticeExitState,
      notice=notice,
      op=op,
      target=target,
      serial=s.noticeExitState.serial + 1
    )
  )
)

fn transitionNoticeDismissGuard1(
  d: UiDecision,
  s: UiStart,
  notice: string,
  op: string,
  target: string
): UiDecision = (
  s.noticeExitState.op == "" and not s.commandPending
  ? transitionNoticeDismissWrites2(
    d,
    s,
    notice,
    op,
    target
  )
  : d
)

