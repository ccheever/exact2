  )
)

fn stepRouteKeyboardInput(
  d: UiDecision,
  s: UiStart,
  environmentId: string,
  rowKey: string,
  routeId: string,
  k: string,
  repeat: bool
): UiDecision = transitionRouteKeyboardInputWrites3(
  transitionRouteKeyboardInputGuard1(
    d,
    s,
    environmentId,
    rowKey,
    routeId,
    k,
    repeat
  ),
  s,
  environmentId,
  rowKey,
  routeId,
  k,
  repeat
)

fn transitionRouteKeyboardInputWrites2(
  d: UiDecision,
  s: UiStart,
  environmentId: string,
  rowKey: string,
  routeId: string,
  k: string,
  repeat: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    writePendingModal=true,
    pendingModal="connection",
    writeModalError=true,
    modalError="",
    changedKind="command",
    command=CommandArgs(
      p0="environment-route-move",
      p1=(routeKeyboardNext(s.routeKeyboard, environmentId, rowKey, routeId, k, repeat,
        routeKeyboardSource(s.connectionsPage, environmentId, rowKey), s.routeKeyboardReady,
        s.commandPending)).rowKey,
      p2=routeKeyboardValue((routeKeyboardNext(s.routeKeyboard, environmentId, rowKey, routeId, k,
        repeat, routeKeyboardSource(s.connectionsPage, environmentId, rowKey),
        s.routeKeyboardReady, s.commandPending))),
      p3=(routeKeyboardNext(s.routeKeyboard, environmentId, rowKey, routeId, k, repeat,
        routeKeyboardSource(s.connectionsPage, environmentId, rowKey), s.routeKeyboardReady,
        s.commandPending)).serial
    )
  )
)

fn transitionRouteKeyboardInputGuard1(
  d: UiDecision,
  s: UiStart,
  environmentId: string,
  rowKey: string,
  routeId: string,
  k: string,
  repeat: bool
): UiDecision = (
  s.routeKeyboard.phase == "lifted" and (routeKeyboardNext(s.routeKeyboard, environmentId, rowKey,
    routeId, k, repeat, routeKeyboardSource(s.connectionsPage, environmentId, rowKey),
    s.routeKeyboardReady, s.commandPending)).phase == "saving" and not s.commandPending
  ? transitionRouteKeyboardInputWrites2(
    d,
    s,
    environmentId,
    rowKey,
    routeId,
    k,
    repeat
  )
  : d
)

fn transitionRouteKeyboardInputWrites3(
  d: UiDecision,
  s: UiStart,
  environmentId: string,
  rowKey: string,
  routeId: string,
  k: string,
  repeat: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeRouteKeyboard=true,
    routeKeyboard=(routeKeyboardNext(s.routeKeyboard, environmentId, rowKey, routeId, k, repeat,
      routeKeyboardSource(s.connectionsPage, environmentId, rowKey), s.routeKeyboardReady,
      s.commandPending))
  )
)

fn stepSbSet(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = transitionSbSetGuard7(
  transitionSbSetGuard5(
    transitionSbSetGuard3(
      transitionSbSetGuard1(
        d,
        s,
        which,
        value
      ),
      s,
      which,
      value
    ),
    s,
    which,
    value
  ),
  s,
  which,
  value
)

fn transitionSbSetWrites2(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSbQuery=true,
    sbQuery=value
  )
)

fn transitionSbSetGuard1(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = (
  which == "query"
  ? transitionSbSetWrites2(
    d,
    s,
    which,
    value
  )
  : d
)

fn transitionSbSetWrites4(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSbLetters=true,
    sbLetters=value,
    writeSbLettersEdited=true,
    sbLettersEdited=true
  )
)

fn transitionSbSetGuard3(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = (
  which == "letters"
  ? transitionSbSetWrites4(
    d,
    s,
    which,
    value
  )
  : d
)

fn transitionSbSetWrites6(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSbEmoji=true,
    sbEmoji=value
  )
)

fn transitionSbSetGuard5(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = (
  which == "emoji"
  ? transitionSbSetWrites6(
    d,
    s,
    which,
    value
  )
  : d
)

fn transitionSbSetWrites8(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeSbSshHost=true,
    sbSshHost=value
  )
)

fn transitionSbSetGuard7(
  d: UiDecision,
  s: UiStart,
  which: string,
  value: string
): UiDecision = (
  which == "ssh-host"
  ? transitionSbSetWrites8(
    d,
    s,
    which,
    value
  )
  : d
)
