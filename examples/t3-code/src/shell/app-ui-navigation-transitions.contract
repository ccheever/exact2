fn transitionOpenModelsWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    hostFocus=true,
    focus=TextArgs(
      p0=s.composerMenu.modelsOpen ? "composer" : "model-search"
    ),
    writeComposerMenu=true,
    composerMenu=ComposerMenuState(
      d.root.composerMenu,
      modelsOpen=not s.composerMenu.modelsOpen,
      popoverSession=s.composerMenu.popoverSession + 1,
      browseProvider="",
      modelQuery="",
      optionsOpen="",
      modelTarget=PickerTarget(id="", top=0, bottom=0, left=0)
    )
  )
)

fn stepOpenOptions(
  d: UiDecision,
  s: UiStart,
  name: string
): UiDecision = transitionOpenOptionsWrites1(
  d,
  s,
  name
)

fn transitionOpenOptionsWrites1(
  d: UiDecision,
  s: UiStart,
  name: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    hostFocus=true,
    focus=TextArgs(
      p0=s.composerMenu.optionsOpen == name ? "composer" : name == "effort" ? "composer-menu"
        : name == "runtime" ? `composer-menu-item-${s.data.composer.runtimeSelected}`
        : name == "branch" ? "branch-search" : name == "workspace" ? "composer-menu"
        : "composer-menu-item-0"
    ),
    writeBranchQuery=true,
    branchQuery="",
    writeComposerMenu=true,
    composerMenu=ComposerMenuState(
      d.root.composerMenu,
      optionsOpen=s.composerMenu.optionsOpen == name ? "" : name,
      modelsOpen=false,
      popoverSession=s.composerMenu.popoverSession + 1
    )
  )
)

