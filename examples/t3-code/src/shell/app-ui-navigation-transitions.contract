    settingsEnvironmentId=s.settings.environmentId,
    writeSettingsMenu=true,
    settingsMenu="",
    writeSettingsMachine=true,
    settingsMachine="",
    writeSettingsWorkspace=true,
    settingsProjectKey="",
    settingsCheckout="",
    writeSettingsProjectId=true,
    settingsProjectId="",
    writeModalError=true,
    modalError="",
    writeSettingsPageState=true,
    settingsPageState=SettingsPageState(
      d.root.settingsPageState,
      open=true,
      route="general"
    )
  )
)

// Sidebar (sidebar-commands.ts): a row press says how it opened ("click", "click:meta" and "click:shift" multi-select, "search" clears it).
fn stepOpenThread(
  d: UiDecision,
  s: UiStart,
  id: string,
  how: string
): UiDecision = transitionOpenThreadGuard1(
  d,
  s,
  id,
  how
)

fn transitionOpenThreadWrites2(
  d: UiDecision,
  s: UiStart,
  id: string,
  how: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0="select-thread",
      p1=id,
      p2=how,
      p3=0
    ),
    writeJumpRequest=true,
    jumpRequest=s.jumpRequest + 1,
    writeUtilityPage=true,
    utilityPage="",
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionOpenThreadGuard1(
  d: UiDecision,
  s: UiStart,
  id: string,
  how: string
): UiDecision = (
  not s.commandPending and id != ""
  ? transitionOpenThreadWrites2(
    d,
    s,
    id,
    how
  )
  : d
)

