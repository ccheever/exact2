)

fn transitionResizeSidebarWrites1(
  d: UiDecision,
  s: UiStart,
  dx: number,
  dy: number
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeDraggedWidth=true,
