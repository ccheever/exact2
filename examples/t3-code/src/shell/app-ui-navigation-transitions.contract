use PickerTarget from "../composer/composer-shapes.contract"
use routeKeyboardNext, routeKeyboardValue from "../connections/connections-routes.contract"
use routeKeyboardSource from "../connections/connections.contract"
use pageTrailNext from "../pages/pages-hero.contract"
use AppDecision, CommandArgs, TextArgs from "./app-decisions.contract"
use ComposerDraftState, ComposerMenuState, ConfirmationState from "./app-protocols.contract"
use HoverState, NoticeExitState, SettingsPageState from "./app-protocols.contract"
use UiDecision from "./app-ui-decisions.contract"
use UiStart from "./app-ui-start.contract"

// a terminal close asked while it was open is dropped, as the reference refuses it
// the title menu's confirms give the focus back to its trigger (Base UI's finalFocus)
fn stepConfirmClose(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = transitionConfirmCloseGuard6(
  transitionConfirmCloseGuard4(
    transitionConfirmCloseGuard2(
      transitionConfirmCloseWrites1(
        d,
        s,
        accept
      ),
      s,
      accept
    ),
    s,
    accept
  ),
  s,
  accept
)

fn transitionConfirmCloseWrites1(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeConfirmationState=true,
    confirmationState=ConfirmationState(
      d.root.confirmationState,
      op=""
    )
  )
)

fn transitionConfirmCloseWrites3(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeTerminalCloseHandled=true,
    terminalCloseHandled=s.shell.panel.terminalClose.serial
  )
)

fn transitionConfirmCloseGuard2(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = (
  s.confirmationState.op == "terminallocal:close"
    or s.confirmationState.op == "terminalpanellocal:close"
    or s.confirmationState.op == "shelllocal:surface-close-confirmed"
  ? transitionConfirmCloseWrites3(
    d,
    s,
    accept
  )
  : d
)

fn transitionConfirmCloseWrites5(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    hostFocus=true,
    focus=TextArgs(
      p0="thread-title"
    )
  )
)

fn transitionConfirmCloseGuard4(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = (
  s.confirmationState.op.startsWith("shell:")
  ? transitionConfirmCloseWrites5(
    d,
    s,
    accept
  )
  : d
)

fn transitionConfirmCloseWrites7(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendTerminalChanged=true,
    terminal=CommandArgs(
      p0=s.confirmationState.op,
      p1=s.confirmationState.target,
      p2=s.confirmationState.value,
      p3=0
    )
  )
)

fn transitionConfirmCloseWrites8(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0=s.confirmationState.op,
      p1=s.confirmationState.target,
      p2=s.confirmationState.value,
      p3=0
    )
  )
)

fn transitionConfirmCloseWrites9(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    hostFocus=true,
    focus=TextArgs(
      p0=s.confirmationState.returnTo
    )
  )
)

fn transitionConfirmCloseWrites10(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendTerminalChanged=true,
    terminal=CommandArgs(
      p0=s.confirmationState.op == "terminallocal:close" ? "terminallocal:focus"
        : "terminalpanellocal:focus",
      p1=s.confirmationState.target,
      p2="",
      p3=0
    )
  )
)

fn transitionConfirmCloseWrites11(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendTerminalChanged=true,
    terminal=CommandArgs(
      p0="terminalpanellocal:focus",
      p1=`${s.shell.panel.terminal.threadKey}|${s.shell.panel.terminal.terminalId}`,
      p2="",
      p3=0
    )
  )
)

fn transitionConfirmCloseGuard6(
  d: UiDecision,
  s: UiStart,
  accept: bool
): UiDecision = (
  accept and (s.confirmationState.op == "terminallocal:close"
    or s.confirmationState.op == "terminalpanellocal:close")
  ? transitionConfirmCloseWrites7(
    d,
    s,
    accept
  )
  : accept and not s.commandPending
  ? transitionConfirmCloseWrites8(
    d,
    s,
    accept
  )
  : not accept and (s.confirmationState.op == "terminallocal:close"
    or s.confirmationState.op == "terminalpanellocal:close") and s.confirmationState.returnTo != ""
  ? transitionConfirmCloseWrites9(
    d,
    s,
    accept
  )
  : not accept and (s.confirmationState.op == "terminallocal:close"
    or s.confirmationState.op == "terminalpanellocal:close")
  ? transitionConfirmCloseWrites10(
    d,
    s,
    accept
  )
  : not accept and s.confirmationState.op == "shelllocal:surface-close-confirmed"
    and s.shell.panel.terminal.open
  ? transitionConfirmCloseWrites11(
    d,
    s,
    accept
  )
  : d
)

// The fresh draft may send while the launch's own send is still answering.
// The new-thread shortcut while the draft's launch (its worktree setup among it) is in flight: a fresh draft in the
// same project, beside the launch (ChatView onSend markPromotedDraftThreadByRef).
fn stepDraftBeside(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionDraftBesideWrites1(
  d,
  s
)

fn transitionDraftBesideWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=false,
    sendDraftLeft=true,
    draftLeave=CommandArgs(
      p0="new-thread",
      p1="",
      p2="",
      p3=0
    ),
    writeJumpRequest=true,
    jumpRequest=s.jumpRequest + 1,
    hostFocus=true,
    focus=TextArgs(
      p0="composer"
    ),
    writeUtilityPage=true,
    utilityPage="",
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn stepEarlier(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionEarlierGuard1(
  d,
  s
)

fn transitionEarlierWrites3(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0="chatlocal:history",
      p1="",
      p2="",
      p3=0
    )
  )
)

fn transitionEarlierGuard2(
  d: UiDecision,
  s: UiStart
): UiDecision = (
  s.data.hasMore and not s.data.historyLoading
  ? transitionEarlierWrites3(
    d,
    s
  )
  : d
)

fn transitionEarlierGuard1(
  d: UiDecision,
  s: UiStart
): UiDecision = (
  not s.commandPending
  ? transitionEarlierGuard2(
    d,
    s
  )
  : d
)

