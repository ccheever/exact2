use clearSiteData, ClearedSiteData from "@exact/browser"
use handleUserPrompt, EmptyResult from "@exact/browser-automation"
use Page from "./app-shapes.contract"
use TranscriptMarkdown from "../timeline/markdown.contract"
use ShellView, ShellDetails, WorkspaceTarget, workspaceContainer, workspaceShown from "./shell-shapes.contract"
use ChatCanvasView from "./chat-canvas.contract"
use TerminalDrawerView from "../terminal/terminal.contract"
use navActiveRoute from "../settings/settings-core.contract"
use Change from "../shared/shapes.contract"

members T3Code
  state shellClock = 0
  state toastDismissed = ""
  state toastHover = false
  state shellOpenHandled = ""
  resource page = exactPage() as shape Page // the window's focus and visibility (document.hasFocus(), exact2 #219): thread notifications and activity reports
  resource shell = shellView(data.revision, wallTime.epochAtZero + shellClock, toastDismissed, toastHover, viewport.width <= 980, page.hasFocus, page.visibilityState, not settingsOpen and not pageCover and not welcome.show, notificationPermission.state) as shape ShellView // then: the chat view is shown (proactive panels); the notification permission (app.contract notificationPermission)
  resource filesMarkdown = renderFileMarkdown(shell.panel.files.markdownSource.concat(shell.panel.attachment.markdownSource).concat(shell.composerFile.file.markdownSource), data.look.math) as shape TranscriptMarkdown
  state rightPanelAt = ""
  derive rightPanel = (rightPanelAt != "" and rightPanelAt == shell.panel.key) or shell.panel.launcher
  state detailsOpen = false
  // The card's pull request row reads its checks on a timer of its own (usePullRequestChecksRefresh): every 45 s while runs
  // are pending and 60 s once they settle (details.prRows.checksPoll), again from the start for another pull request.
  state prRowChecksNow = 0
  action prRowChecksTick
    prRowChecksNow = performanceNow()
  task prRowChecksPending when details.prRows.checksPoll == "pending" key=details.prRows.checksKey
    every(45000, prRowChecksTick)
  task prRowChecksSettled when details.prRows.checksPoll == "settled" key=details.prRows.checksKey
    every(60000, prRowChecksTick)
  resource details = shellDetails(detailsShown, data.threadId, data.revision, conversationWidth >= 1012, wallTime.epochAtZero + max(shellClock, prRowChecksNow), floor(viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - conversationWidth), page.hasFocus and page.visibilityState == "visible", lineageWorkflows, lineagePhasesOpen, lineagePhasesClosed, page.visibilityState == "visible") as shape ShellDetails
  state canvasGestureValue = ""
  action canvasGesture(value: string)
    canvasGestureValue = value
    detailsOpen = detailsOpen and value == "" // a drag on the player is outside the details popover (Base UI's outside press; a press: T3Window outsidePressDown)
  resource canvas = chatCanvas(data.revision, conversationWidth, viewport.height, conversationWidth >= 1012 and data.projectId != "", data.look.chatMax, data.messages.length > 0 or data.threadId != "", canvasGestureValue, `${shell.panel.deviceMini.key}|${shell.panel.browserMini.key}`, shell.panel.deviceMini.show or shell.panel.browserMini.show, conversationWidth >= 1012, detailsOpen, layoutFrames) as shape ChatCanvasView
  state detailsEpoch = 0
  derive detailsPopover = canvas.ready ? canvas.popover : conversationWidth < 1012
  derive detailsShown = detailsOpen and detailsPopover and detailsEpoch == canvas.popoverEpoch
  resource terminalDrawer = terminalDrawer(data.revision, viewport.height, wallTime.epochAtZero + elapsed) as shape TerminalDrawerView // terminal-drawer-view.ts
  state titleDialog = false
  state confirmTitle = ""
  state confirmBody = ""
  state confirmDestructive = false
  state confirmOp = ""
  state confirmTarget = ""
  state confirmReturn = "" // the element a terminal close confirm opened from gives the focus back on Cancel (Base UI's finalFocus)
  state confirmValue = ""
  state terminalCloseHandled = 0
  task shellTicks mount
    every(500, shellTick)
  action shellTick
    if shell.toastCount > 0 or shell.ticking or commandPending
      shellClock = performanceNow()
  task sidebarDialogFocus when data.sidebar.dialog != "" and not paletteOpen key=data.sidebar.dialog // and again as the palette over it closes (its finalFocus); a dialog the sidebar opens takes the focus at its first stop, however it opened (Base UI's initialFocus)
    after(1, focusSidebarDialog)
  action focusSidebarDialog
    focus(data.sidebar.dialog == "snooze" ? "snooze-mode-date" : `sidebar-${data.sidebar.dialog}-cancel`)
    titleDialog = data.sidebar.dialogReturn == "thread-title"
  task snoozeCalendarFocus when data.sidebar.calendar.focusSeq > 0 key=data.sidebar.calendar.focusSeq // a key moved the date popover's focus (snooze-calendar.ts)
    after(1, focusSnoozeDay)
  action focusSnoozeDay
    focus(`snooze-day-${data.sidebar.calendar.focus}`)
  task titleDialogClosed when titleDialog and data.sidebar.dialog == "" // however it closes (Snooze too), the title menu's dialog gives the focus back to the title (Base UI's finalFocus)
    after(1, returnTitleFocus)
  action returnTitleFocus
    titleDialog = false
    focus("thread-title")
  // revealSettingsSearchTarget, from Settings search and from TypographySection's effect alike: a jump to a row that
  // exists only with Separate fonts on (Prompt font, Terminal font; settings-core-view.ts) turns the setting on, and the
  // terminal reads it too. The jump waits until the page reads it on. The write has its own mutation, so a command in
  // flight cannot drop it, and only one is out until the page reads the setting on.
  state separateFontsSaving = false
  mutation separateFontsSaved as shape Change queue refreshes data then separateFontsLanded
  task separateFontsJump when settingsOpen and settingsCore.separateFontsWanted and not separateFontsSaving
    after(1, separateFontsOn)
  action separateFontsOn
    if settingsOpen and settingsCore.separateFontsWanted and not separateFontsSaving
      separateFontsSaving = true
      send separateFontsSaved = command("device-setting", "typographyAdvanced", "true", 0)
  action separateFontsLanded
    settingsRefresh = settingsRefresh + 1
  task separateFontsRead when separateFontsSaving and not settingsCore.separateFontsWanted
    after(1, separateFontsDone)
  action separateFontsDone
    separateFontsSaving = false
  state annotationSendHandled = 0
  task annotationSend when shell.panel.annotationSend > annotationSendHandled key=shell.panel.annotationSend
    after(1, annotationSendNow)
  action annotationSendNow
    annotationSendHandled = shell.panel.annotationSend
    if commandPending or not data.canSend or data.requestMode == "question"
      chatLocal("surface-browser-annotation-held", "", "")
    else if shell.panel.annotationOwner == richComposerOwner and shell.panel.annotationSnapshot == data.snapshotOwner and shell.panel.annotationGeneration == richComposer.generation and shell.panel.annotationValue == composerText and not composerComposing
      commandPending = true
      send changed = command("send-annotation", `${shell.panel.annotationSend}`, "", 0)
      composerTyping = false
      draftOwner = "__unset__"
      jumpRequest = jumpRequest + 1
  // A Browser tab frame's next command (browser-frames.ts), one at a time, or a View chord no page took (`window`). The two
  // sends name the packages' calls, which data code makes itself (LLP 1133.002 D14): clearing a profile, answering a dialog.
  mutation siteCleared as shape ClearedSiteData
  mutation promptAnswered as shape EmptyResult
  task frameCommand when shell.panel.frames.command.serial > 0 key=shell.panel.frames.command.serial
    after(1, frameCommandNow)
  action frameCommandNow
    let c = shell.panel.frames.command
    if c.kind == "navigate"
      navigate(c.id, c.url)
    else if c.kind == "traverse"
      traverseHistory(c.id, c.delta)
    else if c.kind == "reload"
      reload(c.id, ignoreCache=c.flag)
    else if c.kind == "stop"
      stopLoading(c.id)
    else if c.kind == "clear"
      send siteCleared = clearSiteData(partition=c.url, types=["cookies", "storage"])
    else if c.kind == "prompt"
      send promptAnswered = handleUserPrompt(id=c.id, accept=c.flag)
    else if c.kind == "window" and c.flag
      reload()
    else if c.kind == "window"
      zoomTo(c.delta)
    chatLocal("surface-browser-frame-done", c.id, `${c.serial}`)
  state automationRecordingHandled = 0
  task automationRecording when shell.panel.automationRecording.serial > automationRecordingHandled key=shell.panel.automationRecording.serial
    after(1, automationRecordingNow)
  action automationRecordingNow
    automationRecordingHandled = shell.panel.automationRecording.serial
    if shell.panel.automationRecording.slot == 1
      send automationRecordingServed1 = command("shelllocal:surface-browser-automation-recording", "1", "", 0)
    else if shell.panel.automationRecording.slot == 2
      send automationRecordingServed2 = command("shelllocal:surface-browser-automation-recording", "2", "", 0)
    else if shell.panel.automationRecording.slot == 3
      send automationRecordingServed3 = command("shelllocal:surface-browser-automation-recording", "3", "", 0)
    else
      send automationRecordingServed0 = command("shelllocal:surface-browser-automation-recording", "0", "", 0)
  task terminalCloseAsk when shell.panel.terminalClose.serial > terminalCloseHandled and confirmOp == "" key=shell.panel.terminalClose.serial // Gated tasks (exact2 #192), not a 500 ms poll: a terminal close asks, and a thread the module opened is selected, at once.
    after(1, terminalCloseConfirm)
  action terminalCloseConfirm
    terminalCloseHandled = shell.panel.terminalClose.serial
    confirmTitle = shell.panel.terminalClose.title
    confirmBody = shell.panel.terminalClose.body
    confirmDestructive = true
    confirmOp = shell.panel.terminalClose.op
    confirmTarget = shell.panel.terminalClose.target
    confirmReturn = ""
    confirmValue = ""
    focus("app-confirm-cancel") // the confirm takes the focus from the terminal (Base UI's initialFocus); Cancel gives it back
  task shellOpenGuide when shell.openGuideSelected != "" and shell.openRequest != shellOpenHandled key=shell.openRequest
    after(1, shellGuideOpen)
  action shellGuideOpen
    shellOpenHandled = shell.openRequest
    prOpenGuide(shell.openGuideSelected)
  task shellOpen when shell.openGuideSelected == "" and shell.openRequest != "" and shell.openRequest != shellOpenHandled and shell.openThreadId != "" and not commandPending key=shell.openRequest
    after(1, shellOpenThread)
  action shellOpenThread // a clicked notification's thread, or a `t3 app` request's draft (desktop-activation.ts), which leaves Settings and the utility pages as the reference's route change does
    shellOpenHandled = shell.openRequest
    draftOwner = "__unset__"
    commandPending = true
    send changed = command(shell.openThreadId.startsWith("activation:") ? "activation:open" : "select-thread", shell.openThreadId, "", 0)
    jumpRequest = jumpRequest + 1
    settingsOpen = settingsOpen and not shell.openThreadId.startsWith("activation:")
    utilityPage = shell.openThreadId.startsWith("activation:") ? "" : utilityPage
  // The reopen after ⌘W (keepRunning hid the window): DesktopLifecycle's `activate` makes a new window, which loads
  // `/` (IndexDraftLanding): Settings, the utility pages and the palette are gone, and the most recent project's
  // draft opens. The closed thread keeps its draft. A minimize or a covering window is no return (exactPage().restores).
  task windowReopen when page.restores > 0 key=page.restores
    after(1, windowReopened)
  action windowReopened
    settingsOpen = false
    utilityPage = ""
    paletteOpen = false
    send fragmentChanged = command("shelllocal:reopen", "", "", 0) // fragmentOpened: the draft's composer
  action toastHovering(over: bool)
    toastHover = over
  action toastAct(id: number, op: string, target: string, value: string)
    toastDismissed = op == "copy" or op.startsWith("shelllocal:surface-browser-artifact-") ? toastDismissed : `${toastDismissed} ${op == "dismiss" ? "x" : "a"}${id}` // a screenshot's Copy and Reveal keep their toast
    if op == "copy"
      send localChanged = command("shelllocal:copy-error", `${id}`, value, 0)
    if op == "ui:settings" and not settingsOpen
      openSettings() // retainSettingsScope: from outside Settings the scope starts over; inside, the category link keeps it
    if op == "ui:settings"
      settingsRoute = target
      providerLinkTarget = ""
      settingsMenu = ""
      settingsQuery = ""
      settingsFocusTarget = value
      settingsJumpOpened = "" // a new jump starts with its first pass (settings-members.contract focusSettingsTarget)
      modalError = ""
    if op.startsWith("upkeep:")
      send providerUpdateRun = providerChange(op, target, "", value, "", "") // a toast's update: the launch prompt's own environments, never the page's
    if op != "guide-open" and op != "copy" and op != "dismiss" and op != "ui:settings" and not op.startsWith("upkeep:") and not commandPending
      commandPending = true
      send changed = command(op, target, value, 0)
      if op == "select-thread" or op == "new-thread"
        settingsOpen = false
        settingsThemeDialog = ""
        utilityPage = ""
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
    if op == "guide-open"
      prOpenGuide(target)
  action panelUi(what: string, id: string) // tabs and surfaces live in the client (panel-surfaces.ts, shell.panel)
    let closingTerminal = what == "tab-close" and shell.panel.tabs.filter((tab) => tab.id == id and tab.closeTitle != "").length > 0
    rightPanelAt = closingTerminal ? rightPanelAt : (what == "toggle" or what == "close" or what == "tab-close" ? ((what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open) or (what == "tab-close" and shell.panel.count > 1)) : (rightPanel or what == "choose")) ? shell.panel.key : ""
    if what == "toggle" or what == "close" or what == "tab-close"
      send localChanged = command(what == "tab-close" ? "shelllocal:surface-close" : (what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open ? "shelllocal:surface-show" : "shelllocal:surface-hide"), id, "", 0)
      if what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open
        focus("surface-chooser")
    if what == "maximize"
      send localChanged = command("shelllocal:surface-maximize", "", "", 0)
    if what == "new"
      if data.diffOpen or rightPanel or shell.panel.open
        showPopover("add-surface-menu", source="panel-add-surface")
        let availableSurfaces = shell.surfaces.filter((surface) => surface.available)
        match availableSurfaces.at(0)
          case some(surface)
            focus(`add-surface-${surface.id}`)
          case none
            focus("panel-add-surface")
      else
        rightPanelAt = shell.panel.key
        send localChanged = command("shelllocal:surface-show", "", "", 0)
        focus("surface-chooser")
    if what == "terminal" // the layout controls' toggle (toggleTerminalVisibility); closing returns to the composer
      send terminalChanged = command("terminallocal:toggle", "", "", 0)
    // ⇧⌘T waits for the command in flight, as the panel's other sends on `changed` do: a newer send there would let go
    // an answer that holds state across a wait.
    if what == "reopen" and not commandPending
      settingsOpen = false
      utilityPage = ""
      draftOwner = "__unset__"
      jumpRequest = jumpRequest + 1
      commandPending = true
      send changed = command("shell:surface-reopen", "", "", 0)
    else if (what == "choose" or (what == "key" and (id == "b" or id == "B" or id == "d" or id == "D" or id == "f" or id == "F" or id == "m" or id == "M" or id == "l" or id == "L" or id == "p" or id == "P" or id == "t" or id == "T"))) and (data.threadId != "" or id == "browser" or id == "b" or id == "B" or id == "files" or id == "f" or id == "F" or (shell.terminalAvailable and (id == "terminal" or id == "t" or id == "T")) or (data.projectId != "" and (id == "device" or id == "m" or id == "M"))) and not commandPending
      commandPending = true
      send changed = command((id == "diff" or id == "d" or id == "D") ? "diff" : "shelllocal:surface-open", "", id, 0)
  action detailsAct(op: string, target: string, value: string) // the window's half: the editors list, the title menu
    if op == "ui:workflow-toggle"
      lineageWorkflows = lineageWorkflows.includes(target) ? lineageWorkflows.filter((id) => id != target) : lineageWorkflows.concat([target])
    if op == "ui:workflow-phase"
      lineagePhasesOpen = value == "open" ? lineagePhasesOpen.concat([target]) : lineagePhasesOpen.filter((id) => id != target)
      lineagePhasesClosed = value == "open" ? lineagePhasesClosed.filter((id) => id != target) : lineagePhasesClosed.concat([target])
    if (op == "shell:stop-subagent" or op == "shell:stop-workflow") and not commandPending
      lineageStopping = target
    detailsOpen = op == "toggle" ? (not detailsShown and detailsPopover) : (detailsOpen and op != "ui:project-settings" and op != "ui:scheduled-tasks" and op != "select-thread" and op != "ui:changes" and op != "dismiss") // inline: toggle remembers the thread's docked card
    detailsEpoch = op == "toggle" ? canvas.popoverEpoch : detailsEpoch
    if op == "ui:project-settings"
      openSettings() // a project link replaces the whole scope (retainSettingsScope)
      settingsProjectId = target == "" ? data.projectId : target
      settingsRoute = "projects"
    if op == "ui:add-script" // ProjectScriptsControl's Add project script: the Add Action dialog in place, for this project
      restEditor = "card-action"
      restSubject = target == "" ? data.projectId : target
      modalError = ""
    if op == "ui:scheduled-tasks" // ThreadAutomationsPanel: Manage scheduled tasks, or Edit as the page's taskId deep link (scheduled-view.ts)
      settingsEnvironmentId = settings.environmentId
      settingsMachine = ""
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = ""
      settingsRoute = "scheduled-tasks"
      settingsOpen = true
      settingsFocusTarget = "" // a jump left open when Settings closed is no longer this visit's (openSettings)
      settingsJumpOpened = ""
      restEditor = target == "" ? "" : "task"
      restSubject = target == "" ? "" : `link|${value}|${target}`
      modalError = ""
      taskModelPick = ""
    if (op != "toggle" or not detailsPopover) and op != "dismiss" and op != "ui:project-settings" and op != "ui:add-script" and op != "ui:scheduled-tasks" and op != "ui:workflow-toggle" and op != "ui:workflow-phase" and not commandPending
      commandPending = true
      send changed = command(op == "toggle" ? "shelllocal:details-inline" : op == "ui:changes" ? "diff" : op == "ui:editor" ? "shell:select-editor" : op, target, value, 0)
      if op == "select-thread" or op == "shell:merge-back"
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action titleSend(what: string, text: string) // the title's rename commit or New thread (T3Window titleUi)
    if not commandPending
      commandPending = true
      send changed = command(what == "commit" ? "shell:rename" : "new-thread", what == "commit" ? data.threadId : data.projectId, text, 0)
      if what == "new-thread"
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
        focus("composer")
  action titleMenuPick(op: string, target: string, value: string, askTitle: string, askBody: string, destructive: bool) // the window's half: the menu, Rename
    if op == "ui:project-settings"
      openSettings() // a project link replaces the whole scope (retainSettingsScope)
      settingsProjectId = target
      settingsRoute = "projects"
    if op == "ui:confirm" or op.startsWith("ui:confirm:") // `ui:confirm:<id>`: Cancel gives the focus back to element <id>
      confirmReturn = op == "ui:confirm" ? "" : op.slice(11)
      confirmTitle = askTitle
      confirmBody = askBody
      confirmDestructive = destructive
      confirmOp = value
      confirmTarget = target
      confirmValue = value == "remove-snapshot" ? op.slice(11) : "" // a focused Remove's next element, focused once the removal lands (`focus:`)
    if op.startsWith("shelllocal:")
      send localChanged = command(op, target, value, 0)
    if (op == "ui:new-thread" or not op.startsWith("ui:")) and not op.startsWith("shelllocal:") and not commandPending
      commandPending = true
      send changed = command(op == "ui:new-thread" ? "new-thread" : op, target, value, 0)
    else if op == "ui:custom-snooze" // Snooze › Custom… opens the sidebar's Custom snooze for this thread (useThreadActionMenu's requestCustomSnooze)
      sidebarRun("snooze:custom", target, "title")
  // A removal asked from a focused Remove gives the focus away first, to that Remove on Cancel or to where the
  // removal leaves it on Confirm, and the dialog goes after the 200 ms its popup takes to leave (Base UI's finalFocus
  // runs as the dialog closes; dialog-styles.ts' duration-200 exit keeps it mounted meanwhile). VoiceOver, after a
  // VO-Space destroyed the button its cursor was on with the focus still there, took the cursor and the focus to the
  // window's first element instead of following the focus given back after the dialog had gone.
  state confirmHanding = ""
  task confirmHand when confirmHanding != "" key=confirmHanding
    after(200, confirmHanded)
  action confirmHanded
    let accept = confirmHanding == "accept"
    confirmHanding = ""
    confirmClose(accept)
  action confirmUi(accept: bool)
    if confirmOp == "remove-snapshot" and confirmValue != ""
      if confirmHanding == ""
        confirmHanding = accept ? "accept" : "cancel"
        focus(accept ? confirmValue : `remove-snapshot-${confirmTarget}`)
    else
      confirmClose(accept)
  action confirmClose(accept: bool)
    confirmOp = ""
    if confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close" or confirmOp == "shelllocal:surface-close-confirmed"
      terminalCloseHandled = shell.panel.terminalClose.serial // a terminal close asked while it was open is dropped, as the reference refuses it
    if confirmOp.startsWith("shell:") // the title menu's confirms give the focus back to its trigger (Base UI's finalFocus)
      focus("thread-title")
    if accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close")
      send terminalChanged = command(confirmOp, confirmTarget, confirmValue, 0)
    else if accept and not commandPending
      commandPending = true
      send changed = command(confirmOp, confirmTarget, confirmValue, 0)
    else if not accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close") and confirmReturn != ""
      focus(confirmReturn)
    else if not accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close")
      send terminalChanged = command(confirmOp == "terminallocal:close" ? "terminallocal:focus" : "terminalpanellocal:focus", confirmTarget, "", 0)
    else if not accept and confirmOp == "shelllocal:surface-close-confirmed" and shell.panel.terminal.open
      send terminalChanged = command("terminalpanellocal:focus", `${shell.panel.terminal.threadKey}|${shell.panel.terminal.terminalId}`, "", 0)
  // Workspace areas (lib/workspaceFocus.ts): F6 and ⇧F6 move the focus to the next or previous shown area, in the
  // order sidebar, conversation, composer, thread details, right panel and terminal; in Settings, its sections and its
  // page. An area takes back the control it last held while that control is still shown (the conversation's only while
  // it is in view, so the timeline keeps following a running turn), else its own stop: the open thread's row or the
  // sidebar's search, the conversation itself, the composer, the card's first control, the panel itself, the terminal's
  // page. A modal keeps the key, as only its own shortcut buttons hear chords while it shows.
  state workspaceArea = ""
  state workspaceTargets: WorkspaceTarget[] = []
  action workspaceEntered(area: string, e: FocusEvent)
    workspaceArea = area
    if e.target != ""
      workspaceTargets = workspaceTargets.filter((entry) => entry.area != area).concat([WorkspaceTarget(area=area, target=e.target)])
  // `from` names the area the key came from when the focus is in a page the window cannot see into (the terminal's).
  action workspaceMove(direction: number, from: string)
    let order = settingsOpen ? ["settings-nav", "settings"] : ["sidebar", "conversation", "composer", "details", "panel", "terminal"]
    let shown = order.filter((area) => workspaceShown(area, frame(workspaceContainer(area)).width, frame(workspaceContainer(area)).height, frame(workspaceContainer(area)).unavailable, details.inline and canvas.cardShown and not settingsOpen, terminalDrawer.open))
    let at = shown.indexOf(from != "" ? from : workspaceArea)
    let index = at < 0 ? (direction > 0 ? 0 : shown.length - 1) : (at + direction + shown.length) % shown.length
    match shown.at(index)
      case some(area)
        workspaceFocusArea(area)
      case none
  action workspaceFocusArea(area: string)
    let remembered = workspaceTargets.filter((entry) => entry.area == area).map((entry) => entry.target).join("")
    let held = frame(remembered)
    let lane = frame(workspaceContainer(area))
    let usable = remembered != "" and not held.unavailable and held.width > 0 and (area != "conversation" or (held.y + held.height > lane.y and held.y < lane.y + lane.height))
    workspaceArea = area
    if area == "terminal"
      send terminalChanged = command("terminallocal:focus", "", "", 0)
    else if usable
      focus(remembered)
    else if area == "sidebar"
      focus(data.threadId != "" and frame(`row-${data.threadId}`).width > 0 ? `row-${data.threadId}` : "search-threads")
    else if area == "composer"
      focus("composer")
    else if area == "settings-nav"
      focus(`settings-${navActiveRoute(settingsRoute)}`)
    else if area == "details"
      // The card's first enabled control in tree order: its holder is placed out of flow and has no height.
      let editorOff = details.cwd == "" or details.editorId == "" or details.editorUnavailable != ""
      let first = ["details-workspace", editorOff ? "" : "details-open-editor", "details-choose-editor", "details-run-script", "details-script-actions", "details-add-script"].filter((id) => id != "" and frame(id).width > 0)
      match first.at(0)
        case some(id)
          focus(id)
        case none
          focus(workspaceContainer(area))
    else
      focus(workspaceContainer(area))
  // TriageDraftHero's "or run npx t3 triage": the command is copied and the button reads "Copied" for 1.5 s.
  state triageCopied = 0
  task triageCopiedShown when triageCopied > 0 key=triageCopied
    after(1500, triageCopyDone)
  action triageCopy
    triageCopied = triageCopied + 1
    send localChanged = command("pageslocal:copy", "", "npx t3 triage", 0)
  action triageCopyDone
    triageCopied = 0
