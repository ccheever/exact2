use ComposerIntentMetadata, ComposerFieldObservation, ComposerFieldAcknowledgement, ComposerFieldCommand from "../composer/composer-rich.contract"
use HoverTip, noHoverTip from "./hover-layer.contract"
use promptPreviewSample from "../appearance/settings-prompt-preview.contract"
use ShortcutModifierState from "./shortcut-modifiers.contract"
use KeybindingDraft from "../settings/settings-keybindings.contract"
use PickerTarget from "../composer/composer-shapes.contract"

shape ComposerIntentState
  serial: number
  queue: ComposerIntentMetadata[]
  active: number
  phase: string
  mode: string
  notice: string
  observed: ComposerFieldObservation
  expected: string
  start: number
  end: number
  inputStart: number
  inputEnd: number
  preserves: bool
  caretSeen: bool

fn initialComposerIntentState(): ComposerIntentState = ComposerIntentState(
  serial=0,
  queue=[],
  active=0,
  phase="",
  mode="",
  notice="",
  observed=ComposerFieldObservation(generation=-1, snapshotOwner="", owner="", value="", start=0, end=0, composing=false, live=false, focused=false, inputSerial=0),
  expected="",
  start=0,
  end=0,
  inputStart=0,
  inputEnd=0,
  preserves=false,
  caretSeen=false
)

shape ComposerFieldProtocol
  inputSerial: number
  after: number
  acked: number
  effects: number
  focusDone: number
  focus: ComposerFieldAcknowledgement
  admitted: bool
  target: ComposerFieldCommand

fn initialComposerFieldProtocol(): ComposerFieldProtocol = ComposerFieldProtocol(
  inputSerial=0,
  after=0,
  acked=0,
  effects=0,
  focusDone=0,
  focus=ComposerFieldAcknowledgement(applied=false, reason="", value="", start=0, end=0, generation=-1, snapshotOwner="", owner="", seq=0, then="", send=false, focus="", removedImage="", inputSerial=-1),
  admitted=false,
  target=ComposerFieldCommand(generation=-1, snapshotOwner="", owner="", value="", start=0, end=0, text="", selectionStart=0, selectionEnd=0, focus=false, then="", seq=0, ready=false, history=0, citation=0, completion=0)
)

shape ComposerSelectionState
  owner: string
  value: string
  start: number
  end: number

fn initialComposerSelectionState(): ComposerSelectionState = ComposerSelectionState(
  owner="",
  value="",
  start=0,
  end=0
)

shape PromptPreviewState
  text: string
  inputType: string
