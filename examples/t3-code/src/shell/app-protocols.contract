  rightPanelAt: string
  routeKeyboardReady: bool
  settingsCheckout: string
  settingsMachine: string
  settingsProjectKey: string
  settingsPageState: SettingsPageState
  sshResponse: SshResponseState
  streamGeometry: StreamGeometryState
  toastDismissed: string
  transcriptViewport: TranscriptViewportState

fn resetPromptPreviewState(before: PromptPreviewState, text: string): PromptPreviewState = (
  PromptPreviewState(
    before,
    text=text,
    inputType="",
    composing=false,
    start=0,
    end=0,
    serial=before.serial + 1
  )
)

fn recordComposerFieldAdmission(
  before: ComposerFieldProtocol,
  item: ComposerFieldCommand,
  admitted: bool
): ComposerFieldProtocol = ComposerFieldProtocol(
  before,
  after=item.seq,
  target=item,
  admitted=admitted
)

fn advanceCitationPlacement(
  before: CitationPlacementState,
  miss: number,
  smooth: bool
): CitationPlacementState = CitationPlacementState(
  smooth ? CitationPlacementState(before, smooth=true) : before,
  miss=miss,
  tries=before.tries + 1
)

fn advanceFindPlacement(
  before: FindPlacementState,
  miss: number
): FindPlacementState = FindPlacementState(
  before,
  miss=miss,
  tries=before.tries + 1
)
