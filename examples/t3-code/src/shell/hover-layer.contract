// The window's hover layer: a hover tooltip or hover card drawn at the window level,
// as T3 Code 9c161462c9 (MIT, see LICENSE-T3) portals every TooltipPopup and PopoverPopup to the body
// (apps/web/src/components/ui/tooltip.tsx, popover.tsx). A trigger inside a scroll area or a clipping
// card hands its frame and words to the root's `hoverTipAt` (provided by T3Window); this layer draws
// them above the window's content, so nothing around the trigger cuts them: the provider update icon's
// tooltip in the list and the editor (#251), "N scopes" in the Authorized clients list (#248).
//
// A hover card (PopoverTrigger openOnHover: the scopes, the base branch's freshness card) takes the
// pointer as Base UI's does (safePolygon, then the popup's own hover): it stays while the pointer is on
// it, and for the reference's closeDelay after the pointer leaves it or its trigger, so the pointer can
// cross into it (the root's hover grace). Drawn here, at the window level, it hears the pointer on macOS:
// a hover card drawn beside its trigger lies outside the trigger's box, where the host gives it no
// tracking and gives the trigger a leave as the pointer moves in (#322, issues/closed/20261009-macos-subtree-hover.md),
// which closed #262's card. Main #327 fixed
// that (hover is the hit's ancestor path, overflowing children included); the layer stays for the
// clipping (#251, #248) and as the reference's portal.
//
// Placement: Base UI's side, align and sideOffset 4 from the trigger's frame; a side that leaves no
// room in the window flips (Base UI's collision flip; #112, issues/20261009-popover-css-flip-fallbacks.md:
// no position-try, so the layer works it
// out from the content's estimated height).

shape HoverTip
  key: string
  // "tip" (TooltipPopup: words, takes no pointer, closes with its trigger; "policy" is one after a 200 ms delay, "tooltip" one
  // after Base UI's default 600 ms), "scopes" (AccessScopeSummary's
  // card), "freshness" (PullRequestBaseFreshnessWarning's card, drawn by T3Window from the open PR), "pr-badge" (the
  // composer badge's ThreadPullRequestsMiniList, a tooltip whose rows take the pointer: 600 ms open, 100 ms close),
  // "breakdown" (a +/- split, PullRequestChangeBreakdownStat: a 600 ms tooltip; `text` is the split's key, drawn by T3Window
  // from the view that holds it), "pr-card" (the details card's pull request row tooltip, ThreadDetailsPrRow's glass
  // TooltipPopup: 600 ms; `text` is the row's key).
  kind: string
  text: string
  lines: string[]
  side: string
  align: string
  x: number
  y: number
  width: number
  height: number
  // The content's height, for the flip.
  estimate: number
  // The content's width, when known: a centred popup is then kept 5pt inside the window (Base UI's collision shift).
  wide: number
  testId: string

// Base UI's closeDelay after the pointer leaves a hover card or its trigger, on the root's 10 ms hover clock: the
// scopes' 100, the freshness card's 120; the Usage segment's popover has none, but safePolygon lets the pointer
// cross the 6 pt gap into it, so it gets 50. A TooltipPopup closes with its trigger.
fn hoverDelay(kind: string): number = kind == "scopes" or kind == "pr-badge" ? 100 : (kind == "freshness" or kind == "pr-preview" ? 120 : (kind == "usage" ? 50 : 0))

// Base UI's open delay before a hover popover shows: AccessScopeSummary's delay={250}, the Usage segment's default 300;
// the freshness card's delay={0}; PolicyTooltip's delay={200} (kind "policy", settings-kit.contract PolicyTip, drawn as a
// tip); a Tooltip with no provider Base UI's 600 (kind "tooltip": ThreadAutomationsPanel's, thread-automations.contract); a
// tooltip here at once (CnTooltip's, the picker's TooltipProvider delay={0}).
fn hoverOpenDelay(kind: string): number = kind == "pr-preview" ? 350 : kind == "scopes" ? 250 : (kind == "usage" ? 300 : (kind == "policy" or kind == "workflow-member" ? 200 : (kind == "tooltip" or kind == "model-name" or kind == "code" or kind == "pr-badge" or kind == "breakdown" or kind == "pr-card" ? 600 : 0)))

fn noHoverTip(): HoverTip = HoverTip(key="", kind="", text="", lines=[], side="top", align="center", x=0, y=0, width=0, height=0, estimate=0, wide=0, testId="")

// The tip for a trigger at `frame`: placement from Base UI's props, the content from the trigger.
fn hoverTipAtFrame(key: string, kind: string, text: string, lines: string[], side: string, align: string, frame: Geometry, estimate: number, testId: string): HoverTip = HoverTip(key=key, kind=kind, text=text, lines=lines, side=side, align=align, x=frame.x, y=frame.y, width=frame.width, height=frame.height, estimate=estimate, wide=0, testId=testId)

// The same tip with its content's width, so the layer keeps a centred one inside the window.
fn hoverTipWide(tip: HoverTip, wide: number): HoverTip = HoverTip(key=tip.key, kind=tip.kind, text=tip.text, lines=tip.lines, side=tip.side, align=tip.align, x=tip.x, y=tip.y, width=tip.width, height=tip.height, estimate=tip.estimate, wide=wide, testId=tip.testId)

// The positioned layer, on the trigger's side (`place`): top and bottom in a row as wide as the widest
// popup (20rem) plus room, left and right in a column as tall; only the popup takes the pointer, and a
// hover card's 4 pt sideOffset is part of it (no gap to cross). A side the window leaves no room on
// flips to the other one, unless that has less room still (Base UI's flip, fallback best fit); `estimate`
// is the popup's height for top and bottom and its width for left and right.
component HoverLayer
  inject
    rem: number
  props
    tip: HoverTip
    viewportWidth: number
    viewportHeight: number
    hoverAt: action
  slot
  derive titlebar = 52
  derive topRoom = tip.y - titlebar - 9
  derive bottomRoom = viewportHeight - tip.y - tip.height - 9
  derive leftRoom = tip.x - 9
  derive rightRoom = viewportWidth - tip.x - tip.width - 9
  derive place = tip.side == "left" ? hoverFlip("left", "right", leftRoom, rightRoom, tip.estimate) : (tip.side == "right" ? hoverFlip("right", "left", rightRoom, leftRoom, tip.estimate) : (tip.side == "bottom" ? hoverFlip("bottom", "top", bottomRoom, topRoom, tip.estimate) : hoverFlip("top", "bottom", topRoom, bottomRoom, tip.estimate)))
  // A "code" tip (TooltipPopup variant code, a media's path) is up to 30rem wide.
  derive span = tip.kind == "code" ? 32.5 : 22.5
  // A popup of known width above or below its trigger starts where it stays 5pt inside the window (Base UI's collision
  // shift), and the row holds it at its start.
  derive shifted = tip.wide > 0 and (tip.side == "top" or tip.side == "bottom")
  derive aligned = tip.align == "start" ? tip.x : (tip.align == "end" ? tip.x + tip.width - tip.wide : tip.x + tip.width / 2 - tip.wide / 2)
  derive left = shifted ? max(5, min(viewportWidth - 5 - tip.wide, aligned)) : (tip.align == "start" ? tip.x : (tip.align == "end" ? tip.x + tip.width - span * rem : tip.x + tip.width / 2 - span / 2 * rem))
  derive top = max(titlebar + 5, tip.align == "start" ? tip.y : (tip.align == "end" ? tip.y + tip.height - 22.5 * rem : tip.y + tip.height / 2 - 11.25 * rem))
  derive justify = shifted or tip.align == "start" ? "flex-start" : (tip.align == "end" ? "flex-end" : "center")
  derive card = tip.kind != "tip" and tip.kind != "policy" and tip.kind != "tooltip" and tip.kind != "model-name" and tip.kind != "code" and tip.kind != "breakdown" and tip.kind != "pr-card"
  view
    if place == "bottom"
      row position="absolute" left=left top=(tip.y + tip.height) width=(span * rem) justify-content=justify align-items="flex-start" pointer-events="none" z-index=140 testId="hover-layer"
        if card
          column hover=hoverAt(tip, "card") padding-top=4 max-width="20rem" pointer-events="auto"
            children
        else
          column padding-top=4 max-width=((span - 2.5) * rem) pointer-events="none"
            children
    else if place == "top"
      row position="absolute" left=left bottom=(viewportHeight - tip.y) width=(span * rem) justify-content=justify align-items="flex-end" pointer-events="none" z-index=140 testId="hover-layer"
        if card
          column hover=hoverAt(tip, "card") padding-bottom=4 max-width="20rem" pointer-events="auto"
            children
        else
          column padding-bottom=4 max-width=((span - 2.5) * rem) pointer-events="none"
            children
    else if place == "left"
      column position="absolute" right=(viewportWidth - tip.x) top=top height=(22.5 * rem) justify-content=justify align-items="flex-end" pointer-events="none" z-index=140 testId="hover-layer"
        if card
          column hover=hoverAt(tip, "card") padding-right=4 max-width="20.25rem" pointer-events="auto"
            children
        else
          column padding-right=4 max-width="20.25rem" pointer-events="none"
            children
    else
      column position="absolute" left=(tip.x + tip.width) top=top height=(22.5 * rem) justify-content=justify align-items="flex-start" pointer-events="none" z-index=140 testId="hover-layer"
        if card
          column hover=hoverAt(tip, "card") padding-left=4 max-width="20.25rem" pointer-events="auto"
            children
        else
          column padding-left=4 max-width="20.25rem" pointer-events="none"
            children

// Base UI's flip: the side asked for while the popup fits there, else the other side unless it has less room.
// It stands in for CSS anchor positioning on hover-opened popups
// (issues/20261009-popover-css-flip-fallbacks.md): #112, picked on 2026-10-08 as the next core
// investment, starts with `position-area` and flip fallbacks for invoker popovers, which a hover-opened popup is not.
// Its fallback is Base UI's best fit (floating-ui's flip: the side with more room); CSS's `position-try-fallbacks`
// keeps the original placement when no fallback fits.
fn hoverFlip(side: string, other: string, room: number, otherRoom: number, need: number): string = need <= room or (need > otherRoom and room >= otherRoom) ? side : other

// TooltipPopup (CnTooltip's look): the words, max-w-80 wrap-anywhere, taking no pointer. A word wider than the bubble (a
// commit link's URL) breaks inside the bubble, as the reference's does, instead of running past it and the window.
// TooltipPopup's base `text-balance` balances the words. With `lines`, the text is a medium title over them in muted
// ink (ThreadAutomationsPanel's task title and schedule).
component HoverText
  props
    tip: HoverTip
  view
    column max-width="20rem" text-wrap="balance" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" pointer-events="none" role="tooltip" testId=tip.testId
      text tip.text font-size="0.75rem" line-height="1rem" font-weight=(tip.lines.length > 0 ? 500 : 400) white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
      for line in tip.lines key=line
        text line font-size="0.75rem" line-height="1rem" white-space="pre-wrap" overflow-wrap="anywhere" color="light-dark(#71717b, #a1a1a1)"

// ProviderModelsSection's model name TooltipPopup (kind "model-name", Base UI's 600 ms): the name, then the slug in
// muted 2xs monospace when it differs.
component HoverModelName
  props
    tip: HoverTip
  view
    column max-width="20rem" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" role="tooltip" testId=tip.testId
      text tip.text font-size="0.75rem" line-height="1rem" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"
      for line in tip.lines key=line
        text line font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.625rem" line-height="0.875rem" overflow-wrap="anywhere" color="light-dark(#71717b, #a1a1a1)"

// MediaActions' TooltipPopup (variant code: monospace 11px with relaxed leading, up to
// 30rem, breaking anywhere), the media's full path, URL or name. The code variant keeps the base `text-balance`.
component HoverCode
  props
    tip: HoverTip
  view
    column max-width="30rem" text-wrap="balance" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" pointer-events="none" role="tooltip" testId=tip.testId
      text tip.text font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.6875rem" line-height="1.1171875rem" text-align="left" overflow-wrap="anywhere" color="light-dark(#18181b, #f5f5f5)"

// AccessScopeSummary's PopoverPopup (side top, align start, tooltipStyle, w-max max-w-80): "Granted
// scopes", then each scope in mono, after the trigger's 250 ms delay. tooltipStyle's `text-balance`.
component HoverScopes
  props
    tip: HoverTip
  view
    column max-width="20rem" text-wrap="balance" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" role="tooltip" testId=tip.testId
      text tip.text font-size="0.75rem" line-height="1rem" font-weight=500 margin-bottom="0.25rem" color="light-dark(#18181b, #f5f5f5)"
      for line in tip.lines key=line
        text line font-family="Menlo, Consolas, \"Liberation Mono\", monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#18181bd9, #f5f5f5d9)"


// A `Tip` (shell-tip.contract) drawn by this layer, kind "tip", for a trigger inside a scroll area or a clipping card (the
// pull request Code tab's diff list, its file header and off-diff list, and its thread cards;
// #308's row after #307): the wrapped content is the trigger, named by `tipId`; the estimate is the words' lines at 12/16
// in the 20rem bubble, for the flip. The trigger's test id is `tipId` (agent mode hovers it: `tap <tipId> hover`); the
// bubble's is `<tipId>-bubble`.
component LayerTip
  inject
    rem: number
    hoverTipAt: action
  props
    label: string
    side: string
    align: string
    tipId: string
  slot
  action hover(inside: bool)
    if label != ""
      hoverTipAt(hoverTipAtFrame(tipId, "tip", label, [], side, align, frame(tipId), (floor(label.length / 48) + 1) * rem + 0.625 * rem, `${tipId}-bubble`), "trigger", inside)
  view
    box id=tipId testId=tipId position="relative" hover=hover flex-shrink=0 display="flex" flex-direction="row" align-items="center" min-width=0
      children
