    actSidebarHover(back ? row : id, over or back)
  action sidebarPressDown
    sidebarHoverSeq = sidebarHoverSeq + 1
    sidebarHoverY = -10000
  action sidebarDrag(id: string, section: string, dx: number, dy: number)
    if data.sidebar.dragEnabled and not commandPending
      if dragId != id
        dragId = id
        dragSection = section
        dragDx = 0
        dragDy = 0
