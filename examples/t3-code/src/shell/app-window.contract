  state dragDy = 0
  state dragX0 = 0
  state dragY0 = 0
  state dragW = 0
  state dragH = 0
  state dragTopY = 0
  state dragDividerY = 0
  state dragWorkingY = 0
  state dragSnoozedY = 0
  state dragSettledY = 0
