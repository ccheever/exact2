    hoverTip: HoverTip
    hoverShown: bool
    hoverTipAt: action
    composerFocused: bool
    // The held modifiers (app.contract modifierKey): Shift's speed mode on pull request rows, ⌘'s thread-jump hints.
    modifierKey: action
    // The quit shortcut's hint (app.contract quitHoldKey), "" while none shows.
    quitHintMode: string
    // View's zoom (settings-shortcuts.contract ViewZoom): the step and the root's action that sets it.
    zoomStep: number
    zoomTo: action
    modifierEditableFocus: action
    modifiersPasted: action
    speedModeHeld: bool
    threadJumpHints: bool
