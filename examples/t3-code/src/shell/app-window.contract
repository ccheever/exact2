use ComposerEditorView from "../composer/composer-editor.contract"
use ShellView, ShellDetails from "./shell-shapes.contract"
use Sidebar, sidebarTipRow from "../sidebar/sidebar.contract"
use LegacySidebar from "../sidebar/legacy-sidebar.contract"
use ChatColumn, RightPanels, PagesCover, RightSheets from "./app-main.contract"
use ComposerMenus from "../composer/composer-controls.contract"
use heldModifiers from "../shared/press-modifiers.contract"
use ProjectPicker, WelcomeLayer, WindowOverlays from "./app-overlays.contract"
use SettingsWindow, ProjectDialogs, SettingsModals from "./app-settings.contract"
