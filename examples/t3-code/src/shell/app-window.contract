use WindowInputs from "./app-window-inputs.contract"
use ThemeRoleUsage from "../appearance/settings-appearance-editor-shapes.contract"
// The window owns view interaction state for the session. UI transition functions consume
// the event's initial inputs and return sparse decisions. The window applies its local
// fields before invoking T3Code's state, command or UI application action.
// T3Code retains resources, tasks, mutations and their callbacks. WindowInputs carries the
// window's current read-only inputs; action props apply its decisions in T3Code. The use lines
// retain the view-file order: the plan orders shapes by first use.
use Time from "./app-shapes.contract"
use Snapshot, Viewport, LicenseSettings, SnapshotSettings, Settings, Canvas from "../shared/shapes.contract"
use PairFields from "../connections/pairing-shapes.contract"
