      actResizeSidebar=actResizeSidebar,
      actRestLocal=actRestLocal,
      actRestTaskBase=actRestTaskBase,
      actSbSet=actSbSet,
      actScrollToEnd=actScrollToEnd,
      actSearchBranches=actSearchBranches,
      actSearchModels=actSearchModels,
      actSelectModel=actSelectModel,
      actSelectProject=actSelectProject,
      actSelectProvider=actSelectProvider,
      actSelectThread=actSelectThread,
      actSend=actSend,
      actSettingsCommand=actSettingsCommand,
      actSidebarLocal=actSidebarLocal,
      actSidebarNewThread=actSidebarNewThread,
      actSidebarRun=actSidebarRun,
      actSshAnswer=actSshAnswer,
      actThemeRevealRequest=actThemeRevealRequest,
      actToastAct=actToastAct,
      actUsageMetricSet=actUsageMetricSet,
      actUsageWindowSet=actUsageWindowSet,
      actWelcomeEditLink=actWelcomeEditLink,
      actWelcomeFinish=actWelcomeFinish,
      actWelcomeGo=actWelcomeGo,
      actWelcomeImport=actWelcomeImport,
      actWelcomePair=actWelcomePair,
      actWelcomeSetup=actWelcomeSetup,
