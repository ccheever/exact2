      dragDy = dragDy + dy
  action sidebarDragEnd(id: string, vx: number, vy: number) // a row-action sweep's release (`sweep|…`, sidebar.contract ThreadSection) is a drop too; sidebarRun sends `sidebar:drop` while no command is pending
    if dragId == id or id.startsWith("sweep|")
      if dragTarget == "context"
        actSidebarRun("drop", id, `context|${dragCY}|${dragTopY}|${dragDividerY}|${dragCX >= frame("composer").x - 16 and dragCX <= frame("composer").x + frame("composer").width + 16 and dragCY >= frame("composer").y - 24 and dragCY <= frame("composer").y + frame("composer").height + 64}`)
      else if dragTarget != "" or id.startsWith("sweep|")
