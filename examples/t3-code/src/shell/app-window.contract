      sidebarHoverY = frame(`row-${id}`).y - sidebarScrollY
      sidebarHoverH = frame(`row-${id}`).height
    else if back
      sidebarHoverLast = row
      sidebarHoverY = sidebarHoverY == -10000 ? -10000 : frame(`row-${row}`).y - sidebarScrollY
      sidebarHoverH = frame(`row-${row}`).height
    else if id == ""
      sidebarHoverY = -10000
    if over and row == ""
      sidebarHoverHeld = id
    else if not over and id == sidebarHoverHeld
