  // Dialogs snapshot the actual focus before their first focusin. A pointer-opened Mac button does not take focus.
  // The frames outlive popup subtrees; a nested confirm returns into its parent, and a replacement inherits its return.
  state dialogFocusId = ""
  state dialogFocusOwner = ""
  state dialogFocusPopup = ""
  state dialogFocusInvoker = ""
  derive documentPermissions = sortBy(data.messages.map(message => message.inlineDocuments).flat().filter(document => document.permission != ""), document => document.permissionSerial)
  derive activeDocumentPermissions = (sshPrompt.open or rootUi.confirmationState.op != "" or data.serverUpdate.confirmTitle != "" or data.updateEverything.confirm) ? documentPermissions.slice(0, 0) : documentPermissions.slice(0, 1)
  derive documentPermissionOwner = activeDocumentPermissions.map(document => `inline-permission-${document.key}-${document.permissionSerial}`).join("")
  state documentPermissionFocusOwner = ""
  state documentPermissionReturnKey = ""
  state documentPermissionReturnSource = ""
  derive documentPermissionFocusWidth = documentPermissionFocusOwner == documentPermissionOwner ? 1 : (documentPermissionFocusOwner == "" ? 2 : 3)
  action syncDocumentPermissionFocus(width: number, height: number)
    if documentPermissionFocusOwner != documentPermissionOwner
      if documentPermissionFocusOwner != ""
        dialogClosed(documentPermissionFocusOwner)
        documentPermissionFocusOwner = ""
      else if documentPermissionOwner != ""
        documentPermissionOpened(documentPermissionOwner)
        documentPermissionFocusOwner = documentPermissionOwner
  action documentPermissionOpened(owner: string)
    if owner == documentPermissionOwner
      let previous = dialogLineage(dialogFrames, dialogFocusOwner)
      let known = frame(dialogFocusId)
      let hasFocus = dialogFocusOwner != owner and dialogFocusId != "" and not known.unavailable and known.width > 0 and known.height > 0
      let key = activeDocumentPermissions.map(document => document.key).join("")
      let target = `inline-frame-${key}`
      let guest = frame(target)
      // WK's internal field focus is private. Use this document only when no app focus or lineage is known.
      if previous.filter(item => item.target != "").length == 0 and (not hasFocus or dialogFocusId == target) and key != "" and not guest.unavailable and guest.width > 0 and guest.height > 0
        dialogFrames = dialogFrames.filter(item => item.owner != owner and not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0).concat([dialogFrame(owner, [dialogReturn("", target, "", "")])])
        documentPermissionReturnKey = key
        documentPermissionReturnSource = activeDocumentPermissions.map(document => document.src).join("")
      else
        dialogOpened(owner)
  state dialogFrames: DialogFocusFrame[] = []
  state dialogSeated: string[] = []
  // The window's root hears every key below the focus, as the reference's window listeners do: it takes a click on
  // blank ground's focus, as Chromium's body does. A thread that opens gives the composer the focus (app.contract).
  // Whether the focus is at a field (isEditableFocused): every text `input`, `textarea` and `select` has an `id` and
  // is `data-editable`. A focus entering one empties the Pull Requests route's state (shortcutModifierState onFocus).
  state focusEditable = false
  action modifierDown(k: string, e: KeyboardEvent)
    actModifierKey(true, e, focusEditable)
  action modifierUp(k: string, e: KeyboardEvent)
    actModifierKey(false, e, focusEditable)
  action windowFocused(e: FocusEvent)
    let editable = querySelectorAll("[data-editable~=\"yes\"]").includes(e.target)
    focusEditable = editable
    if editable
      actModifierEditableFocus()
    chipFocusChanged(e.target)
    dialogFocusId = e.target
    dialogFocusOwner = ""
    dialogFocusPopup = ""
    dialogFocusInvoker = ""
  // Capture the owning popup and its actual invoker before a menu command removes the popup.
  // A menu within a live dialog retains that parent; a previously closed dialog is not its owner.
  action dialogMenuEntered(popup: string, invoker: string, e: FocusEvent)
    stopPropagation()
    let editable = querySelectorAll("[data-editable~=\"yes\"]").includes(e.target)
    focusEditable = editable
    if editable
      actModifierEditableFocus()
    chipFocusChanged(e.target)
    dialogFocusId = e.target
    dialogFocusOwner = (frame(dialogFocusOwner).unavailable or frame(dialogFocusOwner).width == 0 or frame(dialogFocusOwner).height == 0) ? "" : dialogFocusOwner
    dialogFocusPopup = popup
    dialogFocusInvoker = invoker
  action windowBlurred(e: FocusEvent)
    if e.relatedTarget == none
      focusEditable = false
    if e.relatedTarget == none and querySelectorAll("[data-dialog-focus~=\"open\"]").length == 0
      chipFocusChanged("")
      dialogFocusId = ""
  action dialogOpened(owner: string)
    if dialogFrames.filter(item => item.owner == owner).length == 0
      let previous = dialogLineage(dialogFrames, dialogFocusOwner)
      let previousBox = frame(dialogFocusOwner)
      let mounted = dialogFocusOwner != "" and not previousBox.unavailable and previousBox.width > 0 and previousBox.height > 0
      let returns = dialogFocusOwner == "" ? [dialogReturn("", dialogFocusId, dialogFocusPopup, dialogFocusInvoker)] : (mounted ? previous.concat([dialogReturn(dialogFocusOwner, dialogFocusId, dialogFocusPopup, dialogFocusInvoker)]) : previous)
      dialogFrames = dialogFrames.filter(item => not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0).concat([dialogFrame(owner, returns)])
  action dialogEntered(owner: string, e: FocusEvent)
    stopPropagation()
    let editable = querySelectorAll("[data-editable~=\"yes\"]").includes(e.target)
    focusEditable = editable
    if editable
      actModifierEditableFocus()
    chipFocusChanged(e.target)
    if dialogFrames.filter(item => item.owner == owner).length == 0
      let previous = dialogLineage(dialogFrames, dialogFocusOwner)
      let previousBox = frame(dialogFocusOwner)
      let mounted = dialogFocusOwner != "" and not previousBox.unavailable and previousBox.width > 0 and previousBox.height > 0
      let returns = dialogFocusOwner == "" ? [dialogReturn("", dialogFocusId, dialogFocusPopup, dialogFocusInvoker)] : (mounted ? previous.concat([dialogReturn(dialogFocusOwner, dialogFocusId, dialogFocusPopup, dialogFocusInvoker)]) : previous)
      dialogFrames = dialogFrames.filter(item => not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0).concat([dialogFrame(owner, returns)])
    dialogFocusId = e.target
    dialogFocusOwner = owner
    dialogFocusPopup = ""
    dialogFocusInvoker = ""
    dialogSeated = dialogSeated.filter((item) => item != owner and not frame(item).unavailable and frame(item).width > 0 and frame(item).height > 0).concat([owner])
  action dialogClosed(owner: string)
    let live = querySelectorAll("[data-dialog-focus~=\"open\"]")
    dialogSeated = dialogSeated.filter((item) => item != owner)
    // A frame carries its entire lineage, so child/parent removal order cannot discard the outside return.
    let current = dialogLineage(dialogFrames, dialogFocusOwner)
    let owns = dialogFocusOwner == owner or ((frame(dialogFocusOwner).unavailable or frame(dialogFocusOwner).width == 0 or frame(dialogFocusOwner).height == 0) and current.filter(item => item.owner == owner).length > 0)
    let returns = (owns ? current : dialogLineage(dialogFrames, owner)).filter(item => item.owner == "" or (not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0)).slice(-1)
    let back = returns.map(item => item.target).join("")
    let parent = returns.map(item => item.owner).join("")
    let unknown = live.filter(id => dialogFrames.filter(item => item.owner == id).length == 0)
    let top = dialogFrames.filter(item => not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0).slice(-1).map(item => item.owner).join("")
    // Keep a departing frame until an as-yet unfocused replacement can inherit it.
    if unknown.length == 0 or not owns
      dialogFrames = dialogFrames.filter(item => item.owner != owner and (not owns or (not frame(item.owner).unavailable and frame(item.owner).width > 0 and frame(item.owner).height > 0)))
    let guestTarget = `inline-frame-${documentPermissionReturnKey}`
    let currentGuest = back == guestTarget ? data.messages.map(message => message.inlineDocuments).flat().filter(document => document.key == documentPermissionReturnKey and document.src == documentPermissionReturnSource) : []
    let guestBox = frame(guestTarget)
    // Nested dialogs can inherit this return too; a reused id must never focus a replacement document.
    let guestStillOwned = back != guestTarget or (currentGuest.length > 0 and not guestBox.unavailable and guestBox.width > 0 and guestBox.height > 0)
    if owns and unknown.length == 0 and top == parent and back != "" and guestStillOwned
      let popup = returns.map(item => item.popup).join("")
      let invoker = returns.map(item => item.invoker).join("")
      let shown = querySelectorAll("[data-dialog-return~=\"menu\"]")
      focus(popup != "" and not shown.includes(popup) ? invoker : back)
  // Forget the owners' frames without moving the focus: a popup that closed while something else took the focus.
  action dialogForget(owners: string[])
    dialogFrames = dialogFrames.filter(item => not owners.includes(item.owner))
    dialogSeated = dialogSeated.filter(item => not owners.includes(item))
  // A popup is a programmatic fallback, not a Tab stop. Its own Tab must still retry the eligible controls.
  action dialogFallback(popup: string, targets: string[], k: string, e: KeyboardEvent)
    if dialogFocusId == popup and k == "Tab" and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      stopPropagation()
      let mounted = querySelectorAll("[data-focus-stop~=\"enabled\"]")
      let available = targets.filter(id => mounted.includes(id))
      let target = (e.shiftKey ? available.slice(-1) : available.slice(0, 1)).join("")
      focus(target == "" ? popup : target)
  // A link that follows "Open links in" (browser-links.ts `openLinkFromUi`): a Markdown link
  // ("link": ⌘ or Ctrl held opens the default browser), a check's details or the published repository ("button"). The
  // click's modifiers are its press's own (`kind|meta+shift`; no native gesture read).
  // Complete this Save request before presenting the next file in an app download.
  action saveChosen(name: string)
    actChatLocal("save-complete", `${data.saveRequest.nonce}`, name)
  action saveDismissed
    actChatLocal("save-complete", `${data.saveRequest.nonce}`, "")
  // A ref list scrolled toward its end (ref-paging.contract RefPageScroll): ref-paging.ts loads its next page.
  action refScrollEnd(name: string)
    actChatLocal("ref-scroll-end", name, "")
  action linkOpen(kind: string, href: string, e: MouseEvent)
    actChatLocal("link-open", `${kind}|${heldModifiers(e.metaKey, e.ctrlKey, e.altKey, e.shiftKey)}`, href)
  // A Markdown web link's own menu (ChatMarkdown's anchor onContextMenu, external-link-menu.ts). A page
  // over the thread (the pull request page's detail) has no thread: its ChatMarkdown gets threadRef null ("page").
  action linkMenu(href: string)
    actChatLocal("link-menu", pageCover ? "page" : "", href)
  // Primary presses anywhere in the window outside the Usage page (which takes its
  // own, pages-usage.contract pressDown), counted as they end; a pinned usage popover closes on one, as
  // Base UI's outside press does (the sidebar, the theme editor, a toast all count).
  state outsideDown = false
  state outsidePresses = 0
  // The Settings keybinding field that has the focus (settings-keybindings.contract CaptureField), "" for none.
  state keybindingField = ""
  action holdKeybindingField(id: string, on: bool)
    keybindingField = on ? id : (keybindingField == id ? "" : keybindingField)
  derive prConfirmTarget = prDetail.actions.armedControl == "primary" ? "pull-request-primary" : prDetail.actions.armedControl == "approve" ? "pull-request-approve-workflows" : prDetail.actions.armedControl == "comment" ? "pull-request-comment-close" : prDetail.actions.armedAction == "merge" ? "pr-more-merge-now" : `pr-more-${prDetail.actions.armedAction}`
  action outsidePressDown(e: PointerEvent)
    outsideDown = e.buttons == 1
    // useInlineActionConfirm also disarms on a press outside the armed control, including non-focusable text.
    if prDetail.actions.armedAction != "" and not (e.clientX >= frame(prConfirmTarget).x and e.clientX < frame(prConfirmTarget).x + frame(prConfirmTarget).width and e.clientY >= frame(prConfirmTarget).y and e.clientY < frame(prConfirmTarget).y + frame(prConfirmTarget).height)
      prConfirmDisarm(prDetail.ref, `serial:${prDetail.actions.armedSerial}`)
    // A press outside the keybinding field ends its recording: a browser blurs the reference's focused input on a
    // press that lands outside it, where an AppKit text field keeps the focus.
    if keybindingField != "" and e.buttons == 1 and not (e.clientX >= frame(keybindingField).x and e.clientX < frame(keybindingField).x + frame(keybindingField).width and e.clientY >= frame(keybindingField).y and e.clientY < frame(keybindingField).y + frame(keybindingField).height)
      blur(keybindingField)
      keybindingField = ""
    // A press anywhere but on Cite hides it (observeSelectionActions' capture-phase pointerdown), one a scroll hid
    // included; the selection stays where the press leaves it.
    citeParked = ""
    if citeFor != "" and not (e.clientX >= frame("cite-action").x and e.clientX < frame("cite-action").x + frame("cite-action").width and e.clientY >= frame("cite-action").y and e.clientY < frame("cite-action").y + frame("cite-action").height)
      citeFor = ""
    // A skill chip's details close on a primary press outside them (Base UI's outside press); a press in
    // the chip's own text is the native editor's (T3ComposerChipPress.swift), which never reaches here.
    if chipShown and e.buttons == 1 and not (e.clientX >= frame("chip-popover").x and e.clientX < frame("chip-popover").x + frame("chip-popover").width and e.clientY >= frame("chip-popover").y and e.clientY < frame("chip-popover").y + frame("chip-popover").height)
      if chip.kind == "citation"
        citeSettle()
      else
        chipClose(false)
    // The thread details popover in the chat column closes on a primary press
    // outside it, as Base UI's outside press. Its backdrop takes the column's presses and the terminal drawer's under it,
    // the floating player its own (detailsPlayerPointer); a press beside the column (the sidebar, the right panel) closes
    // it here. Over a right panel sheet the popover is the window's, whose backdrop takes every press.
    if detailsOpen and not detailsSheet and e.buttons == 1 and (e.clientX < (data.sidebarOpen ? sidebarWidth : 0) or e.clientX >= (data.sidebarOpen ? sidebarWidth : 0) + conversationWidth)
      titleMenuOpen = false
      applyStateRoot(uiDetailsAct(uiStart, "dismiss", "", "").root)
  // The floating player lies above the popover's backdrop: a primary press on it (its pill buttons, its screen, its resize
  // edges) is outside the popover and closes it (ChatColumn's players' pointerdown and pointerup). It closes as the press
  // ends, so the press lands where it went down: a popover leaving between the button's down and up lost a pill button's
  // press in the agent drive.
  state detailsPlayerArmed = false
  action detailsPlayerPointer(e: PointerEvent)
    if e.buttons == 1
      detailsPlayerArmed = true
    else
      if detailsPlayerArmed and detailsOpen
        titleMenuOpen = false
        applyStateRoot(uiDetailsAct(uiStart, "dismiss", "", "").root)
      detailsPlayerArmed = false
  // Over a right panel sheet (a narrow window) the thread details popover is the window's, above the sheet (WindowOverlays).
  derive detailsSheet = detailsOpen and narrowDiff and (rightPanel or shell.panel.open or data.diffOpen)
  action outsidePressUp
    outsidePresses = outsideDown ? outsidePresses + 1 : outsidePresses
    outsideDown = false
  // AssistantSelectionToolbar.tsx: the Cite an answer offers, drawn by the window above the timeline
  // as the reference portals it to the body; shown on the thread it was offered on, under no page, Settings or dialog.
  // It hides as the timeline scrolls or the window is resized (observeSelectionActions' scroll and resize), and the press
  // sends the quote with the window frame of the selection's last line, measured again, then clears the selection
  // (`removeAllRanges()` after `onCite`). A scroll only parks it (`citeParked`, restoreAfterScroll at 74541bab17): once the
  // timeline stops (`scrollend`) it comes back at the selection's last line, measured again, while that line is still in the
  // timeline, and shows after the root's 50 ms more (`citeSettles`); a press, a withdrawal or a new offer forgets it.
  state citeOffer = CiteOffer(source="", ranges="", stream="", size=0, x=0, y=0, end="", lx=0, ly=0, lw=-1, lh=0)
  state citeFor = ""
  state citeParked = ""
  state citeSettles = 0
  state citeThread = ""
  state citeViewport = ""
  // A double-click's wait (`citeWaits` asked, the root's `citeWaitDone` over) and the dismissal count at the offer.
  state citeWaits = 0
  state citeDismissedAt = 0
  derive citeShows = citeFor != "" and citeThread == data.threadId and citeViewport == `${viewport.width}x${viewport.height}` and citeWaits <= citeWaitDone and citeDismissedAt == citeDismissals and not pageCover and not rootUi.settingsPageState.open and not modal and citeSettles <= citeSettleDone
  action citeOfferSet(offer: CiteOffer)
    citeOffer = offer
    citeFor = offer.source
    citeParked = ""
    citeThread = data.threadId
    citeViewport = `${viewport.width}x${viewport.height}`
    citeDismissedAt = citeDismissals
  // A double-click, or a click while its wait runs (a third): Cite waits 500 ms more.
  action citeHold
    let next = citeWaits + 1
    citeWaits = next
    citeWaitAsk(next)
  action citeWithdraw(source: string)
    if citeFor == source
      citeFor = ""
    if citeParked == source
      citeParked = ""
  action citeScrolled(left: number, top: number)
    if citeFor != ""
      citeParked = citeFor
      citeFor = ""
  action citeSettled
    let box = frame(citeOffer.end)
    let bounds = frame("transcript")
    let next = citeSettles + 1
    if citeParked != "" and citeParked == citeOffer.source and citeLineShown(citeOffer, box, bounds)
      citeOffer = citeRestored(citeOffer, box, bounds)
      citeFor = citeParked
      citeSettles = next
      citeSettleAsk(next)
    citeParked = ""
  action citePress
    let end = frame(citeOffer.end)
    actCommand("diffreview", `cite:${citeOffer.source}`, `${citeOffer.ranges}|${citeLineFrame(citeOffer, end)}|${citeOffer.stream}`, 0)
    removeAllRanges()
    citeFor = ""
    citeParked = ""
  // The newest skill chip press (composer-chip-popover.ts), hidden at
  // once when the window closes it or Settings or a page covers it; `instructions` opens the skill's file first (View instructions).
  state chipClosed = 0
  derive chipShown = chip.open and chip.seq != chipClosed and not chipCovered
  action chipClose(instructions: bool)
    chipClosed = chip.seq
    editorOp(instructions ? "chip-instructions" : "chip-close", `${chip.seq}`, instructions ? chip.path : "")
  // The window's Escape (ChipPopoverEscape): a citation's comment cancels when its textarea has the focus, as its editor's
  // Escape does; elsewhere it keeps the chip. Existing focus events identify
  // the field; shared completion metadata lets the root restore its selection.
  action chipEscape
    if chip.kind == "citation" and dialogFocusId == "citation-comment-text"
      citeCancel()
    else
      chipClosed = chip.seq
      editorOp("chip-close", `${chip.seq}`, "escape")
  // A citation's comment (citation-comment.contract, citation-comment.ts). The draft is the
  // window's, so every way the popover closes can settle it: Base UI's onOpenChange with resolveAssistantCitationCommentDismissal
  // (AssistantCitationChip settleDraftOnClose). An untouched draft (`citeDraftSeq` another press's) is the reference's null.
  state citeDraft = ""
  state citeDraftSeq = -1
  derive citeText = citeDraftSeq == chip.seq ? citeDraft : chip.comment
  action citeEdit(value: string)
    citeDraft = value
    citeDraftSeq = chip.seq
    editorOp("chip-cite-draft", `${chip.seq}`, value)
  // Save, Enter, and Command/Ctrl+Enter (`send`: then Send, submitCitationAndSend); the editor takes the focus after the chip.
  action citeSave(actSend: bool)
    if citeText.length <= 8000
      chipClosed = chip.seq
      editorOp(actSend ? "chip-cite-send" : "chip-cite-save", `${chip.seq}`, citeText)
  // Cancel and Escape: closes, and after Cite takes the chip away again (`removeOnCancel`).
  action citeCancel
    chipClosed = chip.seq
    editorOp("chip-cite-cancel", `${chip.seq}`, "")
  // An outside press here, or the focus leaving the textarea (a press in the composer's text or on the chip's button again,
  // which the native editor answers by taking the focus: T3ComposerChipPress.swift): a changed draft is committed, one past
  // the limit keeps the popover open, anything else closes it. A press that left the focus nowhere (the timeline's ground)
  // then gives the prompt the focus after the chip (PopoverPopup's `finalFocus`, in the native editor).
  derive citeShown = chipShown and chip.kind == "citation"
  action citeSettle
    if citeShown and (citeDraftSeq != chip.seq or citeDraft.trim() == chip.comment.trim())
      chipClose(false)
    else if citeShown and citeDraft.length <= 8000
      chipClosed = chip.seq
      editorOp("chip-cite-commit", `${chip.seq}`, citeDraft)
  // A press in a text field reaches no node's pointerdown on macOS (the field editor takes it), so the
  // floating theme editor's fields count the focus a press gives them instead.
  action outsideFocus
    outsidePresses = outsidePresses + 1
  // View-only state: the sidebar's hover card geometry, its list's scroll
  // offset and a row drag, moved from app.contract. The sidebars are drawn in `when` arms (legacy, dark, light),
  // so the window keeps their state. sidebarHoverId stays in the root: openSettings and openPage close the card.
  state sidebarHoverLast = ""
  state sidebarHoverY = 0 // the hovered row's frame in the window (less the list's scroll)
  state sidebarHoverH = 0
  // How many hover events the sidebar has had, so a cancelled row-action
  // sweep's resting hover (sidebar.contract ThreadSection) holds only until the window's hover moves on.
  state sidebarHoverSeq = 0
  // The row the host hovers (a row's own key, no `#`). Since main #327 the hover is
  // the hit's ancestor path, so a row stays hovered under its controls and hears no new enter when the pointer leaves one
  // for the row itself: the control's tip ending while its row is still hovered gives the row its hover and its card back,
  // as the reference's card closes for a frame and reopens. A tip a press closed (`sidebarHover("", false)` moves
  // the card and tips away) gives the row back with them still away, until the pointer enters again.
  state sidebarHoverHeld = ""
  state sidebarScrollY = 0
  state dragId = ""
  state dragSection = ""
  state dragDx = 0
  state dragDy = 0
  state dragX0 = 0
  state dragY0 = 0
  state dragW = 0
  state dragH = 0
  state dragTopY = 0
  state dragDividerY = 0
  state dragWorkingY = 0
  state dragSnoozedY = 0
  state dragSettledY = 0
  derive dragCX = dragX0 + dragW / 2 + dragDx
  derive dragCY = dragY0 + dragH / 2 + dragDy
  derive dragTarget = dragId == "" ? "" : (dragCX > sidebarWidth ? "context" : dragSection == "working" ? "" : (dragSettledY > 0 and dragCY >= dragSettledY ? "settled" : (dragSnoozedY > 0 and dragCY >= dragSnoozedY ? "snoozed" : (dragWorkingY > 0 and dragCY >= dragWorkingY ? "working" : (dragCY < dragDividerY + 36 ? "pinned" : "active")))))
  derive dragVerb = (dragTarget == "" or dragTarget == dragSection or dragTarget == "working" or dragTarget == "snoozed" or dragTarget == "context") ? "" : (dragTarget == "pinned" ? "pin" : (dragTarget == "settled" ? "settle" : (dragSection == "pinned" ? "unpin" : (dragSection == "settled" ? "unsettle" : "wake"))))
  // A Working row follows live status: it drags out only as chat context, never between shelves, so the list
  // neither lifts it nor opens the drop labels (Sidebar.tsx isContextDrag).
  derive shelfDragId = dragSection == "working" ? "" : dragId
  derive overlayDragId = dragSection == "working" and dragTarget != "context" ? "" : dragId
  derive dragOffset = dragDy - (dragSection == "pinned" ? 24 : (dragSection == "active" ? 48 : 0))
  // The root rewrite: the sidebar's own local ops, through the root's command dispatch (`sidebar` and `search`
  // send localChanged there), moved from app.contract.
  // ui/sidebar.tsx: a sidebar that collapses with the focus inside hands it to the window's trigger first; the closed
  // sidebar is unmounted, so none of its controls stays in the keyboard order. The thread sidebar and Settings'
  // navigation keep a flag each, so one left set by a sidebar Settings replaced never moves the focus.
  state sidebarFocused = false
  state settingsNavFocused = false
  action sidebarFocusWithin(inside: bool)
    sidebarFocused = inside
  action settingsNavFocusWithin(inside: bool)
    settingsNavFocused = inside
  action toggleSidebar
    releaseUndoClaim() // ⌘B is another key: ⌘Z goes back to the fields (ThreadUndoShortcut)
    if data.sidebarOpen and rootUi.settingsPageState.open and settingsNavFocused
      settingsNavFocused = false
      focus("settings-sidebar-trigger")
    else if data.sidebarOpen and not rootUi.settingsPageState.open and sidebarFocused
      sidebarFocused = false
      focus("sidebar-trigger")
    actCommand("sidebar", "", data.sidebarOpen ? "closed" : "open", 0)
  action finishResize(vx: number, vy: number)
    actCommand("sidebar", "", "open", sidebarWidth)
  action search(value: string)
    releaseUndoClaim() // the sidebar search's edit hands ⌘Z back to the fields (ThreadUndoShortcut's input listener)
    actCommand("search", "", value, 0)
  // The root rewrite: the composer's resting state and left edge, which only the view reads (moved from app.contract).
  derive resting = data.composerResting and canRest
  derive composerLeft = (data.sidebarOpen ? sidebarWidth : 0) + (canvas.ready ? canvas.left : (conversationWidth - min(data.look.chatMax, conversationWidth - 2.5 * data.look.fontSize)) / 2) // the chat lane (chat-canvas-view.ts)
  // The root rewrite: whether Add provider has tried to go past an invalid id (AddProviderDialog shows its error),
  // moved from app.contract. The wizard's fields stay in the root: providerWizard reads them.
  state wizardAttempted = false
  action providerUi(what: string, value: string)
    let target = value == "back" ? max(0, rootUi.providerWizardState.step - 1) : min(rootUi.providerWizardState.manual ? 1 : 2, value == "next" ? rootUi.providerWizardState.step + 1 : (value == "2" ? 2 : (value == "1" ? 1 : 0)))
    if what == "open" or what == "driver" or what == "manual"
      wizardAttempted = false
    if what == "step" and rootUi.providerWizardState.step <= 1 and target > 1 and providerWizard.idError != ""
      wizardAttempted = true
    actProviderUi(what, value)
  action providerAdd(driver: string, label: string, id: string, accent: string, fields: string[], commandArgs: string[])
    wizardAttempted = true
    actProviderAdd(driver, label, id, accent, fields, commandArgs)
  // The root rewrite: the settings editors' row menu and dialog label (Settings' panels and ProjectDialogs), moved
  // from app.contract. A settings editor's command is the root's restRaw; rest and restInput name its op and scope.
  state restLabel = ""
  state restMenu = ""
  action restOpen(editor: string, subject: string, label: string)
    restLabel = label
    restMenu = ""
    actRestOpen(editor, subject)
  action restMenuOpen(id: string)
    restMenu = id
  action restClose
    restMenu = ""
    actRestClose()
  action restRaw(op: string, id: string, value: string)
    restMenu = ""
    actRestRaw(op, id, value)
  action rest(op: string, value: string)
    restRaw(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, value)
  action restInput(op: string, value: string, input: string)
    actRestRaw(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, `${value}${encodeURIComponent(input)}`)
  // The root rewrite: SnapShot's setup dialog (Settings' SnapShot panel and SettingsModals), moved from app.contract.
  state snapshotSetupOpen = false
  state snapshotSetupWasEnabled = false
  state snapshotSetupFrom = "" // the control that opened the setup dialog, which it gives the focus back to (DialogFinalFocus)
  action toggleSnapshots
    if snapshotSettings.enabled and not commandPending
      snapshotSetupOpen = false
      actSettingsCommand("setting-snapshot", "snapShotEnabled", "false")
    else
      snapshotSetupOpen = true
      snapshotSetupWasEnabled = false
      snapshotSetupFrom = snapshotSetupOpen ? snapshotSetupFrom : "snapshot-enabled"
      actClearModalError()
  action showSnapshotSetup(open: bool)
    snapshotSetupOpen = open
    snapshotSetupFrom = open and not snapshotSetupOpen ? "snapshot-setup" : snapshotSetupFrom
    snapshotSetupWasEnabled = snapshotSettings.enabled
    actClearModalError()
  // The root rewrite: Add environment's credential and route target (SettingsModals draws the dialog; Settings ›
  // Connections and the sidebar open it), moved from app.contract. Each wrapper sets the window's half, then calls
  // the root's (`…Root`). The connections' row menu and remove confirm stay in the root: as a window action,
  // connectionAskRemove makes the compiler refuse its captured argument in connections-network.contract
  // (type-cannot-infer, @capture parameter of NetworkAccessRows' `ask`).
  state routeTarget = "" // Add environment as "Add a route to <routeLabel>"
  state routeLabel = ""
  state credential = ""
  action openConnection
    credential = ""
    routeTarget = ""
    actOpenConnection()
  action openRoute(target: string, label: string)
    credential = ""
    routeTarget = target
    routeLabel = label
    actOpenConnection()
  action closeConnection
    routeTarget = ""
    credential = ""
    actCloseConnection()
  action editOrigin(value: string)
    credential = pairFields.host != "" and pairFields.source == origin and credential == "" ? pairFields.code : credential
    actEditOrigin(value)
  action editCredential(value: string)
    credential = value
    actEditCredential()
  action closeModal
    snapshotSetupOpen = false
    routeTarget = ""
    credential = ""
    actCloseModal()
  // The root rewrite: the thread title's menu and rename field, the right panel's maximize and the details card's
  // editors list, moved from app.contract. Each wrapper sets the window's half, then calls the root's (`…Root`),
  // which keeps what resources read and the sends. The fold hold stays in the root: chatLocal is called inside the
  // timeline's and the panels' repeated rows, where a window wrapper would be inlined at every call (+5.5 MB of plan).
  state titleMenuOpen = false
  state titleMenuFromTitle = false
  state titleMenuSerial = 0
  state titleMenuX = 0
  state titleMenuY = 0
  state renaming = false
  state renameText = ""
  derive rightMaximized = shell.panel.maximized and (rightPanel or shell.panel.open) and not narrowDiff
  action titleUi(what: string, value: string)
    let typed = renameText // the commit sends the field's text as the action found it
    if what == "open" or what == "context"
      titleMenuX = frame("thread-title").x
      titleMenuY = frame("thread-title").y + frame("thread-title").height + 4
      titleMenuOpen = (what == "context" or not titleMenuOpen) and not renaming
      titleMenuSerial = titleMenuSerial + 1
      titleMenuFromTitle = what == "open"
    if what == "close" // Escape or a press outside: the fallback menu's cleanup gives the focus back to what held it, the title when the title opened it (a right-click leaves it where it was)
      titleMenuOpen = false
      if titleMenuFromTitle
        focus("thread-title")
    if what == "rename" and shell.serverThread
      titleMenuOpen = false
      renaming = true
      renameText = data.threadTitle
      focus("header-rename")
    if what == "edit"
      renameText = value
    if what == "key" and value == "Escape"
      renaming = false
    if (what == "commit" and renaming) or (what == "new-thread" and data.projectId != "")
      renaming = false
      actTitleSend(what, typed)
  action titleMenuPick(op: string, target: string, value: string, askTitle: string, askBody: string, destructive: bool)
    titleMenuOpen = op == "ui:submenu" and titleMenuOpen
    if op == "ui:rename"
      renaming = true
      renameText = data.threadTitle
      focus("header-rename")
    actTitleMenuPick(op, target, value, askTitle, askBody, destructive)
  action panelUi(what: string, id: string)
    let closingTerminal = what == "tab-close" and shell.panel.tabs.filter((tab) => tab.id == id and tab.closeTitle != "").length > 0
    titleMenuOpen = false
    actPanelUi(what, id)
  action detailsAct(op: string, target: string, value: string)
    titleMenuOpen = false
    actDetailsAct(op, target, value)
  action sidebarScrolled(x: number, y: number)
    sidebarScrollY = y
  action sidebarHover(id: string, over: bool)
    sidebarHoverSeq = sidebarHoverSeq + 1
    let row = sidebarTipRow(id)
