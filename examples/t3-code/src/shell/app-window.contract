// A key event as `aria-keyshortcuts` spells its chord: the key's own character where it types a Latin one (AZERTY's
// W key is Z), else its physical key (composer-keys.contract composerChordKey).
fn windowChord(k: string, e: KeyboardEvent): string = [(e.metaKey ? "Meta" : ""), (e.ctrlKey ? "Control" : ""), (e.altKey ? "Alt" : ""), (e.shiftKey ? "Shift" : ""), (k.length == 1 and quitTypesLatin(k) ? k.toLowerCase() : composerChordKey(k, e.code))].filter((part) => part != "").join("+")

component T3Window
  inject
    interacted: action // the reader pointed, typed or scrolled (app.contract)
  props
    releaseUndoClaim: action // ⌘B and the sidebar search release the undo notice's claim (app.contract)
    promptLinkPage: PromptLinkView
    promptLinkNavigate: action
    promptLinkAct: action
    // The root's double-click wait for Cite (done to `citeWaitDone`; `citeWaitAsk(n)` asks wait n)
    // and its count of dismissals on focus loss or a changed transcript context.
    citeWaitDone: number
    citeWaitAsk: action
    // The root's 50 ms after a scroll's end before a parked Cite shows again (done to `citeSettleDone`).
    citeSettleDone: number
    citeSettleAsk: action
    citeDismissals: number
    themeInspecting: bool
    setThemeInspecting: action
    themeUsage: ThemeRoleUsage[]
    themeRevealRequest: action
