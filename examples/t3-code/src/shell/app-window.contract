      ViewZoom(items=shortcuts, step=zoomStep, zoom=zoomTo, page=shownPage, local=chatLocal)
      UpdateMenuItems(check=command("shelllocal:check-for-updates", "", "", 0))
      row width="100%" height="100%" min-width=0 position="relative" inert=(sshPrompt.open or activeDocumentPermissions.length > 0) testId="ssh-background"
