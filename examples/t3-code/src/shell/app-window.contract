use PrLinkPreviewCard from "../pull-requests/pages-pr-links.contract"
use ChipPopover, ChipPopoverLayer, ChipPopoverEscape from "../composer/composer-chip-popover.contract" // a skill chip's details
use CitationCommentLayer from "../timeline/citation-comment.contract" // a citation chip's comment
use CiteAction, CiteOffer, citeLineFrame, citeLineShown, citeRestored from "../timeline/diff-cite.contract" // Cite over the timeline
use AppConfirm from "./shell-panels.contract"
use DialogFocusFrame, dialogFrame, dialogReturn, dialogLineage from "../shared/dialog-trap.contract"
use PromptLinkPage, PromptLinkView from "../prompt-links/prompt-links.contract"
use uiAnswerRevert, uiCancelKeybinding, uiCanvasGesture from "./app-ui-entry.contract"
use uiCaptureKeybinding, uiChatLocal, uiChooseKeybindingCommand from "./app-ui-entry.contract"
use uiClearModalError, uiCloseConnection, uiCloseModal, uiCloseModels from "./app-ui-entry.contract"
use uiCloseOptions, uiCommand, uiComposerBeforeInput, uiComposerBlur from "./app-ui-entry.contract"
use uiComposerChipPress, uiComposerDrop, uiComposerFocus from "./app-ui-entry.contract"
use uiComposerKey, uiComposerKeyEvent, uiComposerKeyReleased from "./app-ui-entry.contract"
use uiComposerLanguage, uiComposerMoved, uiConfirmUi, uiConnectionOp from "./app-ui-entry.contract"
use uiConnectionToggleMenu, uiCopyDiagnostic, uiCoreChange from "./app-ui-entry.contract"
use uiCoreClearSearch, uiCoreMenu, uiCoreNavigate, uiCorePick from "./app-ui-entry.contract"
use uiCoreScope, uiCoreSearchKey, uiCoreThemeChange from "./app-ui-entry.contract"
use uiCoreThemeDialog, uiDetailsAct, uiDeviceSetting, uiEarlier from "./app-ui-entry.contract"
use uiEditCredential, uiEditKeybinding, uiEditKeybindingKey from "./app-ui-entry.contract"
use uiEditOrigin, uiEditSettingsQuery, uiHoverTipAt from "./app-ui-entry.contract"
use uiImportWizardFocusMoved, uiInlineDocumentShortcut from "./app-ui-entry.contract"
use uiKeybindingRest, uiManageProject, uiModifierEditableFocus from "./app-ui-entry.contract"
use uiModifierKey, uiNewKeybinding, uiNewThread, uiNoticeDismiss from "./app-ui-entry.contract"
use uiOpenConnection, uiOpenConnectionsPage, uiOpenModels from "./app-ui-entry.contract"
use uiOpenOptions, uiOpenPage, uiOpenProjects, uiOpenProviderSettings from "./app-ui-entry.contract"
use uiOpenSettings, uiOpenThread, uiPageBack, uiPaletteClose from "./app-ui-entry.contract"
use uiPaletteEdit, uiPaletteFlag, uiPaletteHover, uiPaletteKey from "./app-ui-entry.contract"
use uiPaletteRun, uiPaletteShow, uiPanelUi, uiPickModel from "./app-ui-entry.contract"
use uiPrClose, uiPrControl, uiPrCopy, uiPrTogglePanel from "./app-ui-entry.contract"
use uiPrType, uiPreviewSnapshotSound, uiPromptLinkAct from "./app-ui-entry.contract"
use uiPromptPreviewWrite, uiProviderAccent, uiProviderAdd from "./app-ui-entry.contract"
use uiProviderOp, uiProviderUi, uiRecordKeybinding, uiRefreshSettings from "./app-ui-entry.contract"
use uiReleaseFold, uiRemoveSnapshot, uiResetSidebarWidth from "./app-ui-entry.contract"
use uiResizeSidebar, uiRestClose, uiRestGesture, uiRestLocal from "./app-ui-entry.contract"
use uiRestOpen, uiRestRaw, uiRestScrolled, uiRestTaskBase from "./app-ui-entry.contract"
use uiRouteKeyboardInput, uiSbSet, uiScrollToEnd, uiSearchBranches from "./app-ui-entry.contract"
use uiSearchModels, uiSelectModel, uiSelectProject, uiSelectProvider from "./app-ui-entry.contract"
use uiSelectThread, uiSend, uiSettingsCommand, uiSidebarHover from "./app-ui-entry.contract"
use uiSidebarLocal, uiSidebarNewThread, uiSidebarRun, uiSshAnswer from "./app-ui-entry.contract"
use uiStreamMeasured, uiThemeRevealRequest, uiTitleMenuPick from "./app-ui-entry.contract"
use uiTitleSend, uiToastAct, uiUsageMetricSet, uiUsageWindowSet from "./app-ui-entry.contract"
use uiWelcomeEditLink, uiWelcomeFinish, uiWelcomeGo, uiWelcomeImport from "./app-ui-entry.contract"
use uiWelcomePair, uiWelcomeSetup, uiWelcomeTogglePair, uiWrite from "./app-ui-entry.contract"
use UiStart from "./app-ui-start.contract"
use UiDecision from "./app-ui-decisions.contract"
use UiRootInputs from "./app-protocols.contract"
use PickerAnchor from "./app-ui-query-inputs.contract"
use ComposerRichView from "../composer/composer-rich.contract"
use RouteKeyboard from "../connections/connections-routes.contract"
use needsComposerChipFrame, needsComposerHistoryFrames from "./app-ui-queries.contract"
use needsPaletteCloseFrame, needsPaletteShowFrame from "./app-ui-queries.contract"
use needsInlinePaletteFrame from "./app-ui-queries.contract"
use speedModifiers from "./shortcut-modifiers.contract"
component T3Window
  props
    windowInputs: WindowInputs
    applyRoot: action
    applyStateRoot: action
    applyCommandRoot: action
    applyChatRoot: action
    applyPanelRoot: action
    applyHoverRoot: action
    releaseUndoClaim: action // ⌘B and the sidebar search release the undo notice's claim (app.contract)
    promptLinkNavigate: action
    citeWaitAsk: action
    citeSettleAsk: action
    setThemeInspecting: action
    prConfirmDisarm: action
    chipFocusChanged: action
    editorOp: action
    menuPick: action
    resizeDiff: action
    finishDiffResize: action
    prSetTab: action
    prReload: action
    prAct: action
    usageBreakdownSet: action
    usageRefreshNow: action
    prSelect: action
    menuCommand: action
    coreMenuClose: action
    coreNoticeScope: action
    editKeybindingQuery: action
    editKeybindingWhen: action
    editLicenseQuery: action
    toggleLicense: action
    retryLicenses: action
    selectDiagnosticPeriod: action
    connectionAskRemove: action
    coreThemeLive: action
    toastHovering: action
    modifiersPasted: action
  inject
    richComposer: ComposerRichView
    richComposerOwner: string
    richPromptPreview: ComposerRichView
    routeKeyboard: RouteKeyboard
    promptPreviewOwner: string
  derive rootUi = windowInputs.rootUi
  derive threadJumpHintsShown = windowInputs.threadJumpHintsShown
  derive promptLinkPage = windowInputs.promptLinkPage
  // The root's double-click wait for Cite (done to `citeWaitDone`; `citeWaitAsk(n)` asks wait n)
  // and its count of dismissals on focus loss or a changed transcript context.
  derive citeWaitDone = windowInputs.citeWaitDone
  // The root's 50 ms after a scroll's end before a parked Cite shows again (done to `citeSettleDone`).
  derive citeSettleDone = windowInputs.citeSettleDone
  derive citeDismissals = windowInputs.citeDismissals
  derive themeInspecting = windowInputs.themeInspecting
  derive themeUsage = windowInputs.themeUsage
  derive data = windowInputs.data
  derive viewport = windowInputs.viewport
  derive scheme = windowInputs.scheme
  derive settingsCore = windowInputs.settingsCore
  derive sshPrompt = windowInputs.sshPrompt
  derive modal = windowInputs.modal
  derive shell = windowInputs.shell
  derive wallTime = windowInputs.wallTime
  derive liveNow = windowInputs.liveNow
  derive elapsed = windowInputs.elapsed
  derive sidebarWidth = windowInputs.sidebarWidth
  derive commandPending = windowInputs.commandPending
  derive lineageStopping = windowInputs.lineageStopping
  derive settings = windowInputs.settings
  derive utilityPage = windowInputs.utilityPage
  derive home = windowInputs.home
  derive sidebarHoverId = windowInputs.sidebarHoverId
  derive pageCover = windowInputs.pageCover
  derive canvas = windowInputs.canvas
  derive rightPanel = windowInputs.rightPanel
  derive narrowDiff = windowInputs.narrowDiff
  derive detailsOpen = windowInputs.detailsOpen
  derive details = windowInputs.details
  derive foldHold = windowInputs.foldHold
  derive jumpRequest = windowInputs.jumpRequest
  derive composerOwner = windowInputs.composerOwner
  derive markdown = windowInputs.markdown
  derive attachmentUrls = windowInputs.attachmentUrls
  derive conversationWidth = windowInputs.conversationWidth
  derive editor = windowInputs.editor
  derive chip = windowInputs.chip
  // Settings or a page covers the composer's chip (app.contract chipCover closes it).
  derive chipCovered = windowInputs.chipCovered
  derive composerText = windowInputs.composerText
  derive branches = windowInputs.branches
  derive terminalDrawer = windowInputs.terminalDrawer
  derive diffWidth = windowInputs.diffWidth
  derive prDetail = windowInputs.prDetail
  derive prMarkdown = windowInputs.prMarkdown
  derive filesMarkdown = windowInputs.filesMarkdown
  derive prTab = windowInputs.prTab
  derive usage = windowInputs.usage
  derive usageShortcuts = windowInputs.usageShortcuts
  derive prList = windowInputs.prList
  derive prTyped = windowInputs.prTyped
  derive prQuery = windowInputs.prQuery
  derive prSelected = windowInputs.prSelected
  derive prPanelOpen = windowInputs.prPanelOpen
  derive branchQuery = windowInputs.branchQuery
  derive projectsOpen = windowInputs.projectsOpen
  derive connecting = windowInputs.connecting
  derive settingsThemeDialog = windowInputs.settingsThemeDialog
  derive settingsNavigation = windowInputs.settingsNavigation
  derive settingsMenu = windowInputs.settingsMenu
  derive settingsScrollTop = windowInputs.settingsScrollTop
  derive settingsPage = windowInputs.settingsPage
  derive sourceControl = windowInputs.sourceControl
  derive modalError = windowInputs.modalError
  derive integrations = windowInputs.integrations
  derive snapshotSettings = windowInputs.snapshotSettings
  derive bindings = windowInputs.bindings
  derive keybindingQuery = windowInputs.keybindingQuery
  derive keybindingWhen = windowInputs.keybindingWhen
  derive scheduled = windowInputs.scheduled
  derive restEditor = windowInputs.restEditor
  derive storageSettings = windowInputs.storageSettings
  derive archives = windowInputs.archives
  derive licenses = windowInputs.licenses
  derive licenseQuery = windowInputs.licenseQuery
  derive diagnostics = windowInputs.diagnostics
  derive connectionsPage = windowInputs.connectionsPage
  derive pendingModal = windowInputs.pendingModal
  derive connectionRemove = windowInputs.connectionRemove
  derive connectionMenu = windowInputs.connectionMenu
  derive providerPage = windowInputs.providerPage
  derive projectsSettings = windowInputs.projectsSettings
  derive settingsThemeSubject = windowInputs.settingsThemeSubject
  derive welcome = windowInputs.welcome
  derive welcomeStep = windowInputs.welcomeStep
  derive welcomeLink = windowInputs.welcomeLink
  derive welcomePairOpen = windowInputs.welcomePairOpen
  derive shortcuts = windowInputs.shortcuts
  derive restSubject = windowInputs.restSubject
  derive sbPicker = windowInputs.sbPicker
  derive sbQuery = windowInputs.sbQuery
  derive sbLettersEdited = windowInputs.sbLettersEdited
  derive sbLetters = windowInputs.sbLetters
  derive sbEmoji = windowInputs.sbEmoji
  derive origin = windowInputs.origin
  derive pairFields = windowInputs.pairFields
  derive sbSshHosts = windowInputs.sbSshHosts
  derive sbSshHost = windowInputs.sbSshHost
  derive providerWizard = windowInputs.providerWizard
  derive acpAgents = windowInputs.acpAgents
  derive catalog = windowInputs.catalog
  derive palette = windowInputs.palette
  derive toastHover = windowInputs.toastHover
  derive providerAuthPending = windowInputs.providerAuthPending
  derive hoverShown = windowInputs.hoverShown
  // Whether the composer may rest while the reader scrolls the transcript (app.contract canRest).
  derive canRest = windowInputs.canRest
  derive settingsEnvironmentId = windowInputs.settingsEnvironmentId
  derive settingsProjectId = windowInputs.settingsProjectId
  provide
    inlineDocumentShortcut = actInlineDocumentShortcut
    promptPreviewWrite = actPromptPreviewWrite
    composerChipPress = actComposerChipPress
    composerMoved = actComposerMoved
    composerBeforeInput = actComposerBeforeInput
    composerLanguage = actComposerLanguage
    composerKeyEvent = actComposerKeyEvent
    composerKeyReleased = actComposerKeyReleased
    streamMeasured = actStreamMeasured
    routeKeyboardInput = actRouteKeyboardInput
    restScrolled = actRestScrolled
    restGesture = actRestGesture
    guideKeysBlocked = rootUi.paletteSession.open or modal or rootUi.settingsPageState.open
    dialogFocusId
    dialogMenuEntered
    dialogOpened
    dialogEntered
    dialogClosed
    dialogForget
    dialogFallback
    rem = data.look.fontSize
    wizardSteps = data.look.wizardSteps // the setup wizards' step list and panel follow the theme (ui/wizard.tsx)
    wizardPanel = data.look.wizardPanel
    still = viewport.prefersReducedMotion
    corePal = settingsCore.palette // Settings' palette, for rows drawn outside the General route (the writer model's TraitsPicker)
    // T3Code owns the hover state and clock; the window provides them and draws the layer.
    hoverTipAt = actHoverTipAt
    hoverTip = rootUi.hoverState.tip
    hoverShown
    linkOpen
    linkMenu
    refScrollEnd
    scheme // the chrome row and the annotation overlay take the resolved appearance (browser-capture.contract)
    pickModel = actPickModel
    taskModelPick
    // The answer whose quote an open citation comment highlights (markdown.contract AnswerMarkdown).
    citeMessage = (citeShown ? chip.message : "")
    citeQuote = (citeShown ? chip.quote : "")
    citeAt = (citeShown ? chip.at : -1)
    citeOpen = citeShown
    // The answer whose Cite shows (markdown.contract AnswerMarkdown), its offer, its withdrawal, and the
    // timeline's scroll (ChatColumn).
    citeOffered = (citeShows ? citeFor : "")
    citeOfferSet
    citeWithdraw
    citeHold
    citeHolding = (citeWaits > citeWaitDone)
    citeScrolled
    citeSettled
    // The dialogs the focus has entered since they opened: each is `aria-modal` only from then (dialog-trap.contract).
    dialogSeated
    prSpeedMode = speedModeHeld
    threadJumpHints
  state composerCommand = false
  state composerShift = false
  state taskModelPick = "" // the open scheduled task editor's picked `instance:model`, until it closes
  state providerVisit = 0 // the provider links that changed the Providers page's target
  state settingsThemeRequest = 0
  state restGestureUntil = -1
  state restLastPull = -1000000
  state restTop = -1
  state restHeight = -1
  state restContent = -1
  state restWidth = -1
  state restMovement = 0
  derive paletteHighlight = palette.count == 0 ? -1 : (rootUi.paletteSession.cursor >= 0 ? min(rootUi.paletteSession.cursor, palette.count - 1) : (palette.autoHighlight and (rootUi.paletteSession.cursor == -1 or palette.panel == "picker") ? 0 : -1))
  derive paletteListHeight = min(330, min(448, viewport.height * 0.7))
  derive composerInCode = rootUi.composerRichCurrent and richComposer.blocks.filter((b) => b.kind == "code" and rootUi.composerSelection.start >= b.bodyStart and rootUi.composerSelection.end <= b.bodyEnd).length > 0
  derive composerInList = rootUi.composerRichCurrent and rootUi.composerSelection.start == rootUi.composerSelection.end and richComposer.blocks.filter((b) => b.kind == "list" and rootUi.composerSelection.start >= b.contentStart and rootUi.composerSelection.end <= b.end).length > 0
  derive composerCodeStart = rootUi.composerRichCurrent and rootUi.composerSelection.start == rootUi.composerSelection.end and richComposer.blocks.filter((b) => b.kind == "code" and rootUi.composerSelection.start == b.bodyStart).length > 0
  derive composerRequiresModifier = settings.sendShortcut == "mod-enter" or (settings.sendShortcut == "mod-enter-multiline" and (composerText.includes("\n") or composerText.includes("\u{d}")))
  derive speedModeHeld = speedModifiers(rootUi.modifierOwnership.speed)
  derive threadJumpsHeld = (data.legacy.enabled ? data.legacy.jumpModifiers : data.sidebar.jumpModifiers).includes(heldModifiers(rootUi.modifierOwnership.shortcut.metaKey, rootUi.modifierOwnership.shortcut.ctrlKey, rootUi.modifierOwnership.shortcut.altKey, rootUi.modifierOwnership.shortcut.shiftKey))
  derive threadJumpHints = threadJumpHintsShown and threadJumpsHeld
  derive inlineDocumentKeysBlocked = sshPrompt.open or rootUi.confirmationState.op != "" or data.serverUpdate.confirmTitle != "" or data.updateEverything.confirm or shell.panel.deviceSetup or shell.composerFile.open or data.composerImagePreview.length > 0 or data.messages.map(message => message.inlineDocuments).flat().filter(document => document.permission != "").length > 0
  derive uiStart = UiStart(
    bindings=bindings,
    canRest=canRest,
    canvas=canvas,
    catalog=catalog,
    chip=chip,
    chipFrame=none,
    commandPending=commandPending,
    composerCodeStart=composerCodeStart,
    composerCommand=composerCommand,
    composerDraft=rootUi.composerDraft,
    composerFieldLive=rootUi.composerFieldLive,
    composerInCode=composerInCode,
    composerInList=composerInList,
    composerIntentBaseCurrent=rootUi.composerIntentBaseCurrent,
    composerIntentContextCurrent=rootUi.composerIntentContextCurrent,
    composerIntentReceiptCurrent=rootUi.composerIntentReceiptCurrent,
    composerMenu=rootUi.composerMenu,
    composerOwner=composerOwner,
    composerRequiresModifier=composerRequiresModifier,
    composerRichCurrent=rootUi.composerRichCurrent,
    composerSelection=rootUi.composerSelection,
    composerSelectionCurrent=rootUi.composerSelectionCurrent,
    composerShift=composerShift,
    composerText=composerText,
    confirmationState=rootUi.confirmationState,
    connectionMenu=connectionMenu,
    connectionsPage=connectionsPage,
    data=data,
    details=details,
    detailsEpoch=rootUi.detailsEpoch,
    detailsOpen=rootUi.detailsOpen,
    detailsPopover=rootUi.detailsPopover,
    detailsShown=detailsOpen,
    editor=editor,
    fieldProtocol=rootUi.fieldProtocol,
    foldHold=foldHold,
    historyCaret=none,
    historyEdge=none,
    hoverShown=hoverShown,
    hoverState=rootUi.hoverState,
    importWizardFocused=rootUi.importWizardFocused,
    inlineDocumentKeysBlocked=inlineDocumentKeysBlocked,
    intentState=rootUi.intentState,
    jumpRequest=jumpRequest,
    keybindingEditor=rootUi.keybindingEditor,
    keybindingWhen=keybindingWhen,
    lineagePhasesClosed=rootUi.lineagePhasesClosed,
    lineagePhasesOpen=rootUi.lineagePhasesOpen,
    lineageWorkflows=rootUi.lineageWorkflows,
    modal=modal,
    modifierOwnership=rootUi.modifierOwnership,
    noticeExitState=rootUi.noticeExitState,
    origin=origin,
    pageCover=pageCover,
    pageTrail=rootUi.pageTrail,
    pairFields=pairFields,
    palette=palette,
    paletteFrame=none,
    paletteHighlight=paletteHighlight,
    paletteListHeight=paletteListHeight,
    paletteSession=rootUi.paletteSession,
    pickerAnchor=none,
    prDetail=prDetail,
    prPanelOpen=prPanelOpen,
    prSelected=prSelected,
    previewFrame=none,
    previewState=rootUi.previewState,
    promptLinkPage=promptLinkPage,
    promptPreviewOwner=promptPreviewOwner,
    promptPreviewVisible=rootUi.promptPreviewVisible,
    providerLinkTarget=rootUi.providerLinkTarget,
    providerPage=providerPage,
    providerSelected=rootUi.providerSelected,
    providerVisit=providerVisit,
    providerWizard=providerWizard,
    providerWizardState=rootUi.providerWizardState,
    restContent=restContent,
    restGestureUntil=restGestureUntil,
    restHeight=restHeight,
    restLastPull=restLastPull,
    restMovement=restMovement,
    restTop=restTop,
    restWidth=restWidth,
    richComposer=richComposer,
    richComposerOwner=richComposerOwner,
    richPromptPreview=richPromptPreview,
    rightPanel=rightPanel,
    rightPanelAt=rootUi.rightPanelAt,
    routeKeyboard=routeKeyboard,
    routeKeyboardReady=rootUi.routeKeyboardReady,
    scheduled=scheduled,
    settings=settings,
    settingsCheckout=rootUi.settingsCheckout,
    settingsCore=settingsCore,
    settingsEnvironmentId=settingsEnvironmentId,
    settingsMachine=rootUi.settingsMachine,
    settingsMenu=settingsMenu,
    settingsNavigation=settingsNavigation,
    settingsPageState=rootUi.settingsPageState,
    settingsProjectId=settingsProjectId,
    settingsProjectKey=rootUi.settingsProjectKey,
    settingsThemeDialog=settingsThemeDialog,
    settingsThemeRequest=settingsThemeRequest,
    settingsThemeSubject=settingsThemeSubject,
    shell=shell,
    shortcuts=shortcuts,
    sidebarHoverId=sidebarHoverId,
    sidebarWidth=sidebarWidth,
    sshPrompt=sshPrompt,
    sshResponse=rootUi.sshResponse,
    streamGeometry=rootUi.streamGeometry,
    toastDismissed=rootUi.toastDismissed,
    transcriptViewport=rootUi.transcriptViewport,
    usage=usage,
    utilityPage=utilityPage,
    viewport=viewport,
    wallTime=wallTime,
    welcome=welcome,
    welcomeLink=welcomeLink,
    welcomePairOpen=welcomePairOpen
  )
  action applyPrivateDecision(d: UiDecision)
    if d.writeComposerModifiers
      composerCommand = d.composerCommand
      composerShift = d.composerShift
    if d.writeTaskModelPick
      taskModelPick = d.taskModelPick
    if d.writeProviderVisit
      providerVisit = d.providerVisit
    if d.writeSettingsThemeRequest
      settingsThemeRequest = d.settingsThemeRequest
    if d.writeRestContent
      restContent = d.restContent
    if d.writeRestGestureUntil
      restGestureUntil = d.restGestureUntil
    if d.writeRestHeight
      restHeight = d.restHeight
    if d.writeRestLastPull
      restLastPull = d.restLastPull
    if d.writeRestMovement
      restMovement = d.restMovement
    if d.writeRestTop
      restTop = d.restTop
    if d.writeRestWidth
      restWidth = d.restWidth
  action actAnswerRevert(choice: string)
    applyRoot(uiAnswerRevert(uiStart, choice).root)
  action actCancelKeybinding
    applyStateRoot(uiCancelKeybinding(uiStart).root)
  action actCanvasGesture(value: string)
    applyStateRoot(uiCanvasGesture(uiStart, value).root)
  action actCaptureKeybinding(original: string, value: string)
    applyStateRoot(uiCaptureKeybinding(uiStart, original, value).root)
  action actChatLocal(op: string, id: string, value: string)
    let before = uiStart
    let tableX = op == "table-menu" ? frame(`table-copy-${id}`).x : 0
    let tableY = op == "table-menu" ? frame(`table-copy-${id}`).y : 0
    let tableWidth = op == "table-menu" ? frame(`table-copy-${id}`).width : 0
    let tableHeight = op == "table-menu" ? frame(`table-copy-${id}`).height : 0
    let sentValue = (
      op == "table-menu"
        ? `${tableX}|${tableY}|${tableWidth}|${tableHeight}|${before.viewport.width}|${before.viewport.height}|${value}`
        : value
    )
    applyChatRoot(uiChatLocal(before, op, id, sentValue).root)
  action actChooseKeybindingCommand(value: string)
    applyStateRoot(uiChooseKeybindingCommand(uiStart, value).root)
  action actClearModalError
    applyStateRoot(uiClearModalError(uiStart).root)
  action actCloseConnection
    applyStateRoot(uiCloseConnection(uiStart).root)
  action actCloseModal
    applyStateRoot(uiCloseModal(uiStart).root)
  action actCloseModels
    applyRoot(uiCloseModels(uiStart).root)
  action actCloseOptions
