                PrCardView(card=row.extra.card, testId=hoverTip.testId)
            else if hoverTip.kind == "breakdown"
              // The split under the pointer, from the view that holds it: the detail, a Pull Requests row or a linked row.
              for split in [prDetail.breakdown].concat(prList.groups.map((group) => group.rows.map((row) => row.breakdown)).flat()).concat(shell.panel.prs.rows.map((row) => row.breakdown)).filter((entry) => entry.ref == hoverTip.text).slice(0, 1) key=split.ref
                PrBreakdownCard(breakdown=split, diff=prDetail.diffScheme, testId=hoverTip.testId)
            else if hoverTip.kind == "workflow-member"
