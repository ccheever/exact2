use ComposerChipRequest from "../composer/composer-chip-controls.contract"
use ComposerFieldObservation from "../composer/composer-rich.contract"
use AppDecision, CommandArgs, ComposerFieldArgs, TwoTextArgs from "./app-decisions.contract"
use ComposerDraftState, ComposerIntentState, ComposerMenuState from "./app-protocols.contract"
use ComposerSelectionState, KeybindingEditorState from "./app-protocols.contract"
use PaletteSessionState, ProviderWizardState, SettingsPageState from "./app-protocols.contract"
use SshResponseState from "./app-protocols.contract"
use UiDecision from "./app-ui-decisions.contract"
use UiStart from "./app-ui-start.contract"

fn stepComposerBlur(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionComposerBlurWrites1(
  d,
  s
)

fn transitionComposerBlurWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      focused=false,
      typing=false,
      composing=false
    )
  ),
  writeComposerModifiers=true,
  composerShift=false,
  composerCommand=false
)

fn stepComposerChipPress(
  d: UiDecision,
  s: UiStart,
  surface: string,
  owner: string,
  value: string,
  serial: number,
  start: number,
  end: number,
  source: string,
  comment: bool,
  anchorId: string
): UiDecision = transitionComposerChipPressGuard1(
  d,
  s,
  surface,
  owner,
  value,
  serial,
  start,
  end,
  source,
  comment,
  anchorId
)

fn transitionComposerChipPressWrites4(
  d: UiDecision,
  s: UiStart,
  surface: string,
  owner: string,
  value: string,
  serial: number,
  start: number,
  end: number,
  source: string,
  comment: bool,
  anchorId: string,
  bounds: Geometry
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    chip=some(ComposerChipRequest(generation=((surface == "preview") ? s.richPromptPreview
      : s.richComposer).generation, snapshotOwner=s.data.snapshotOwner, owner=owner, value=value,
      inputSerial=serial, start=start, end=end, source=source, surface=surface, comment=comment,
      frame=bounds))
  )
)

fn transitionComposerChipPressGuard3(
  d: UiDecision,
  s: UiStart,
  surface: string,
  owner: string,
  value: string,
  serial: number,
  start: number,
  end: number,
  source: string,
  comment: bool,
  anchorId: string,
  bounds: Geometry
): UiDecision = (
  not bounds.unavailable and bounds.width > 0 and bounds.height > 0
  ? transitionComposerChipPressWrites4(
    d,
    s,
    surface,
    owner,
    value,
    serial,
    start,
    end,
    source,
    comment,
    anchorId,
    bounds
  )
  : d
)

fn transitionComposerChipPressMatch2(
  d: UiDecision,
  s: UiStart,
  surface: string,
  owner: string,
  value: string,
  serial: number,
  start: number,
  end: number,
  source: string,
  comment: bool,
  anchorId: string
): UiDecision = match s.chipFrame {
  case some(bounds) => transitionComposerChipPressGuard3(
    d,
    s,
    surface,
    owner,
    value,
    serial,
    start,
    end,
    source,
    comment,
    anchorId,
    bounds
  ),
  case none => d
}

fn transitionComposerChipPressGuard1(
  d: UiDecision,
  s: UiStart,
  surface: string,
  owner: string,
  value: string,
  serial: number,
  start: number,
  end: number,
  source: string,
  comment: bool,
  anchorId: string
): UiDecision = (
  ((surface == "preview") ? s.promptPreviewVisible and serial == s.previewState.serial
    and owner == s.promptPreviewOwner and value == s.previewState.text : s.composerFieldLive
    and serial == s.fieldProtocol.inputSerial and owner == s.richComposerOwner
    and value == s.composerText and not s.composerDraft.composing) and ((surface == "preview")
    ? s.richPromptPreview : s.richComposer).owner == owner and ((surface == "preview")
    ? s.richPromptPreview : s.richComposer).value == value and ((surface == "preview")
    ? s.richPromptPreview : s.richComposer).chips.filter((chip) => chip.start == start
    and chip.end == end and chip.source == source).length == 1
  ? transitionComposerChipPressMatch2(
    d,
    s,
    surface,
    owner,
    value,
    serial,
    start,
    end,
    source,
    comment,
    anchorId
  )
  : d
)

// A queued row's grip released (pan release).
fn stepComposerDrop(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  vx: number,
  vy: number
): UiDecision = transitionComposerDropGuard1(
  d,
  s,
  op,
  id,
  vx,
  vy
)

fn transitionComposerDropWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  vx: number,
  vy: number
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0=`cc:${op}`,
      p1=id,
      p2="",
      p3=0
    )
  )
)

fn transitionComposerDropGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  vx: number,
  vy: number
): UiDecision = (
  not s.commandPending
  ? transitionComposerDropWrites2(
    d,
    s,
    op,
    id,
    vx,
    vy
  )
  : d
)

