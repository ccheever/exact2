    writeConnecting=true,
    connecting=false,
    writeProjectsOpen=true,
    projectsOpen=false,
    writeConnectionRemove=true,
    connectionRemove="",
    writeOrigin=true,
    origin="",
    writeOriginEdited=true,
    originEdited=false,
