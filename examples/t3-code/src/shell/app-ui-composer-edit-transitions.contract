fn transitionChatLocalWrites11(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendLocalChanged=true,
    local=CommandArgs(
      p0=`chatlocal:${op}`,
      p1=id,
      p2=value,
      p3=0
    )
  )
)

fn transitionChatLocalGuard5(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  op.startsWith("inline-doc-")
  ? transitionChatLocalWrites6(
    d,
    s,
    op,
    id,
    value
  )
  : op == "surface-pr-quick"
  ? transitionChatLocalWrites7(
    d,
    s,
    op,
    id,
    value
  )
  : op.startsWith("surface-files-comment-")
  ? transitionChatLocalWrites8(
    d,
    s,
    op,
    id,
    value
  )
  : op == "pr-code-drag" or op == "pr-code-begin"
  ? transitionChatLocalWrites9(
    d,
    s,
    op,
    id,
    value
  )
  : op == "link-open" and value.startsWith("#")
  ? transitionChatLocalWrites10(
    d,
    s,
    op,
    id,
    value
  )
  : transitionChatLocalWrites11(
  d,
  s,
  op,
  id,
  value
)
)
