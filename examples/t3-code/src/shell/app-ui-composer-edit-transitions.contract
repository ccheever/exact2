)

fn transitionCloseConnectionWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeModalError=true,
    modalError="",
    writePendingModal=true,
    pendingModal="",
    writeConnecting=true,
    connecting=false,
    writeOrigin=true,
    origin="",
    writeOriginEdited=true,
    originEdited=false
  )
)

fn stepCloseModal(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionCloseModalWrites1(
  d,
  s
)

fn transitionCloseModalWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writePendingModal=true,
    pendingModal="",
    writeConnecting=true,
    connecting=false,
    writeProjectsOpen=true,
    projectsOpen=false,
    writeConnectionRemove=true,
    connectionRemove="",
    writeOrigin=true,
    origin="",
    writeOriginEdited=true,
    originEdited=false,
    writePaletteSession=true,
    paletteSession=PaletteSessionState(
      d.root.paletteSession,
      open=false
    ),
    writeSettingsPageState=true,
    settingsPageState=SettingsPageState(
      d.root.settingsPageState,
      open=false
    ),
    writeKeybindingEditor=true,
    keybindingEditor=KeybindingEditorState(
      d.root.keybindingEditor,
      open=false,
      previous="",
      recording=false,
      drafts=[]
    ),
    writeProviderWizardState=true,
    providerWizardState=ProviderWizardState(
      d.root.providerWizardState,
      dialog=""
    ),
    writeComposerMenu=true,
    composerMenu=ComposerMenuState(
      d.root.composerMenu,
      modelsOpen=false
    )
  )
)

fn stepConnectionOp(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionConnectionOpGuard1(
  d,
  s,
  op,
  id,
  value
)

fn transitionConnectionOpWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    writePendingModal=true,
    pendingModal=(op == "environment-add" or op == "environment-route-add"
      or op == "environment-ssh-add" or op == "environment-ssh-pick") ? (s.data.connected
      ? "connect" : "connect-first") : "connection",
    writeModalError=true,
    modalError="",
    writeConnectionRemove=true,
    connectionRemove="",
    changedKind="command",
    command=CommandArgs(
      p0=op,
      p1=id,
      p2=value,
      p3=0
    ),
    writeSshResponse=true,
    sshResponse=SshResponseState(
      d.root.sshResponse,
      returnToConnect=op == "environment-ssh-add" or op == "environment-ssh-pick"
    ),
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionConnectionOpGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  not s.commandPending
  ? transitionConnectionOpWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

