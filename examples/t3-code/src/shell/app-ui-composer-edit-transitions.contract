fn stepConnectionOp(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionConnectionOpGuard1(
  d,
  s,
  op,
  id,
  value
)

fn transitionConnectionOpWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    writePendingModal=true,
    pendingModal=(op == "environment-add" or op == "environment-route-add"
      or op == "environment-ssh-add" or op == "environment-ssh-pick") ? (s.data.connected
      ? "connect" : "connect-first") : "connection",
    writeModalError=true,
    modalError="",
    writeConnectionRemove=true,
    connectionRemove="",
    changedKind="command",
    command=CommandArgs(
      p0=op,
      p1=id,
      p2=value,
      p3=0
    ),
    writeSshResponse=true,
    sshResponse=SshResponseState(
      d.root.sshResponse,
      returnToConnect=op == "environment-ssh-add" or op == "environment-ssh-pick"
    ),
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionConnectionOpGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  not s.commandPending
  ? transitionConnectionOpWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

