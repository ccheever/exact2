fn stepSshAnswer(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = transitionSshAnswerGuard1(
  d,
  s,
  kind
)

fn transitionSshAnswerWrites2(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendSshAnswered=true,
    ssh=TwoTextArgs(
      p0=s.sshPrompt.requestId,
      p1=kind
    ),
    writeSshResponse=true,
    sshResponse=SshResponseState(
      d.root.sshResponse,
      responding=kind == "submit"
    )
  )
)

fn transitionSshAnswerGuard1(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = (
  not s.sshResponse.responding and s.sshPrompt.requestId != ""
  ? transitionSshAnswerWrites2(
    d,
    s,
    kind
  )
  : d
)

// A disclosure toggled with the transcript at its end keeps the end in view while the rows re-measure (the list goes
// on following it); anywhere else the toggled row holds its place (MessagesTimeline's disclosurePinsEnd).
// the Code tab's gutter drags and "+", in turn
// fragmentOpened
// a table popup's trigger frame
// Keep the guard chain narrow; only the final adapter copies the incoming decision.
fn stepChatLocal(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = finishChatLocal(
  d,
  decideChatLocal(
    ChatLocalResult(
      writeFoldHold=d.root.writeFoldHold,
      foldHold=d.root.foldHold,
      writeRightPanelAt=d.root.writeRightPanelAt,
      rightPanelAt=d.root.rightPanelAt,
      sendKind="",
      args=CommandArgs(p0="", p1="", p2="", p3=0)
    ),
    s.transcriptViewport,
    s.composerOwner,
    s.shell.panel,
    op,
    id,
    value
  )
)

fn decideChatLocal(
  before: ChatLocalResult,
  viewport: TranscriptViewportState,
  composerOwner: string,
  panel: PanelView,
  op: string,
  id: string,
  value: string
): ChatLocalResult = chatLocalSend(
  chatLocalPanel(
    chatLocalFold(before, viewport, composerOwner, op),
    panel,
    op,
    id,
    value
  ),
  op,
  id,
  value
)

fn chatLocalFold(
  before: ChatLocalResult,
  viewport: TranscriptViewportState,
  composerOwner: string,
  op: string
): ChatLocalResult = (
  (op == "fold" or op == "group" or op == "attempt" or op == "tree-all" or op == "tree-dir")
  and not (viewport.atEnd and viewport.owner == composerOwner)
  ? ChatLocalResult(before, writeFoldHold=true, foldHold=true)
  : before
)

fn chatLocalPanel(
  before: ChatLocalResult,
  panel: PanelView,
  op: string,
  id: string,
  value: string
): ChatLocalResult = (
  op == "surface-close-others" or op == "surface-close-to-right" or op == "surface-close-all"
  or (op == "surface-close" and panel.tabs.filter((tab) => tab.id == id
      and tab.closeTitle != "").length == 0) or (op == "surface-browser-float"
    and not panel.browser.capture.floating) or op == "surface-session-float"
  or (op == "surface-files-search-key" and id == "sheet" and value == "Escape")
  ? ChatLocalResult(before, writeRightPanelAt=true, rightPanelAt="")
  : before
)

fn chatLocalSend(
  before: ChatLocalResult,
  op: string,
  id: string,
  value: string
): ChatLocalResult = ChatLocalResult(
  before,
  sendKind=(
    op.startsWith("inline-doc-") ? "inlineDocument"
    : op == "surface-pr-quick" ? "prQuick"
    : op.startsWith("surface-files-comment-") ? "fileComment"
    : op == "pr-code-drag" or op == "pr-code-begin" ? "lineDrag"
    : op == "link-open" and value.startsWith("#") ? "fragment"
    : "local"
  ),
  args=CommandArgs(p0=`chatlocal:${op}`, p1=id, p2=value, p3=0)
)

fn finishChatLocal(d: UiDecision, result: ChatLocalResult): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeFoldHold=result.writeFoldHold,
    foldHold=result.foldHold,
    writeRightPanelAt=result.writeRightPanelAt,
    rightPanelAt=result.rightPanelAt,
    sendInlineDocumentChanged=d.root.sendInlineDocumentChanged or result.sendKind == "inlineDocument",
    inlineDocument=result.sendKind == "inlineDocument" ? result.args : d.root.inlineDocument,
    sendPrQuickChanged=d.root.sendPrQuickChanged or result.sendKind == "prQuick",
    prQuick=result.sendKind == "prQuick" ? result.args : d.root.prQuick,
    sendFileCommentChanged=d.root.sendFileCommentChanged or result.sendKind == "fileComment",
    fileComment=result.sendKind == "fileComment" ? result.args : d.root.fileComment,
    sendLineDragChanged=d.root.sendLineDragChanged or result.sendKind == "lineDrag",
    lineDrag=result.sendKind == "lineDrag" ? result.args : d.root.lineDrag,
    sendFragmentChanged=d.root.sendFragmentChanged or result.sendKind == "fragment",
    fragment=result.sendKind == "fragment" ? result.args : d.root.fragment,
    sendLocalChanged=d.root.sendLocalChanged or result.sendKind == "local",
    local=result.sendKind == "local" ? result.args : d.root.local
  )
)
