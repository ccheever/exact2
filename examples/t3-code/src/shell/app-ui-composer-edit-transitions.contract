fn stepSshAnswer(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = transitionSshAnswerGuard1(
  d,
  s,
  kind
)

fn transitionSshAnswerWrites2(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendSshAnswered=true,
    ssh=TwoTextArgs(
      p0=s.sshPrompt.requestId,
      p1=kind
    ),
    writeSshResponse=true,
    sshResponse=SshResponseState(
      d.root.sshResponse,
      responding=kind == "submit"
    )
  )
)

fn transitionSshAnswerGuard1(
  d: UiDecision,
  s: UiStart,
  kind: string
): UiDecision = (
  not s.sshResponse.responding and s.sshPrompt.requestId != ""
  ? transitionSshAnswerWrites2(
    d,
    s,
    kind
  )
  : d
)

// A disclosure toggled with the transcript at its end keeps the end in view while the rows re-measure (the list goes
// on following it); anywhere else the toggled row holds its place (MessagesTimeline's disclosurePinsEnd).
// the Code tab's gutter drags and "+", in turn
// fragmentOpened
// a table popup's trigger frame
fn stepChatLocal(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = transitionChatLocalGuard5(
  transitionChatLocalGuard3(
    transitionChatLocalGuard1(
      d,
      s,
      op,
      id,
      value
    ),
    s,
    op,
    id,
    value
  ),
  s,
  op,
  id,
  value
)

fn transitionChatLocalWrites2(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeFoldHold=true,
    foldHold=true
  )
)

fn transitionChatLocalGuard1(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  (op == "fold" or op == "group" or op == "attempt" or op == "tree-all" or op == "tree-dir")
    and not (s.transcriptViewport.atEnd and s.transcriptViewport.owner == s.composerOwner)
  ? transitionChatLocalWrites2(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

fn transitionChatLocalWrites4(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeRightPanelAt=true,
    rightPanelAt=""
  )
)

fn transitionChatLocalGuard3(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = (
  op == "surface-close-others" or op == "surface-close-to-right" or op == "surface-close-all"
    or (op == "surface-close" and s.shell.panel.tabs.filter((tab) => tab.id == id
    and tab.closeTitle != "").length == 0) or (op == "surface-browser-float"
    and not s.shell.panel.browser.capture.floating) or op == "surface-session-float"
    or (op == "surface-files-search-key" and id == "sheet" and value == "Escape")
  ? transitionChatLocalWrites4(
    d,
    s,
    op,
    id,
    value
  )
  : d
)

fn transitionChatLocalWrites6(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendInlineDocumentChanged=true,
    inlineDocument=CommandArgs(
      p0=`chatlocal:${op}`,
      p1=id,
      p2=value,
      p3=0
    )
  )
)

fn transitionChatLocalWrites7(
  d: UiDecision,
  s: UiStart,
  op: string,
  id: string,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendPrQuickChanged=true,
    prQuick=CommandArgs(
      p0=`chatlocal:${op}`,
      p1=id,
      p2=value,
      p3=0
    )
  )
)

