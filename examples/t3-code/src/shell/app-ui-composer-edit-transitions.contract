fn stepComposerSelectionObserved(
  d: UiDecision,
  s: UiStart,
  e: InputEvent,
  composing: bool
): UiDecision = transitionComposerSelectionObservedGuard1(
  d,
  s,
  e,
  composing
)

fn transitionComposerSelectionObservedWrites2(
  d: UiDecision,
  s: UiStart,
  e: InputEvent,
  composing: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    sendComposerFieldChanged=true,
    field=ComposerFieldArgs(
      p0=ComposerFieldObservation(generation=s.richComposer.generation,
        snapshotOwner=s.data.snapshotOwner, owner=s.richComposerOwner, value=e.value,
        start=e.selectionStart, end=e.selectionEnd, composing=composing, live=s.composerFieldLive,
        focused=s.composerDraft.focused, inputSerial=s.fieldProtocol.inputSerial),
      p1=false
    ),
    writeComposerSelection=true,
    composerSelection=ComposerSelectionState(
      d.root.composerSelection,
      owner=s.richComposerOwner,
      value=e.value,
      start=e.selectionStart,
      end=e.selectionEnd
    )
  )
)

fn transitionComposerSelectionObservedGuard1(
  d: UiDecision,
  s: UiStart,
  e: InputEvent,
  composing: bool
): UiDecision = (
  e.value == s.composerText
  ? transitionComposerSelectionObservedWrites2(
    d,
    s,
    e,
    composing
  )
  : d
)

