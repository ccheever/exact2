// ui/tooltip.tsx TooltipPopup (Base UI Tooltip, 600 ms open delay): a 1px
// popover-bordered 8pt card, 12/16.5 text inset 4×8, max 320 wide, offset 4
// from its trigger. The wrapper owns hover; the bubble is mounted with the
// trigger (opacity 0) so its delayed fade has a starting value, sits after the
// trigger in paint order and never takes hits. `side` is where the reference
// lands after collision flipping; `align` where it lands after shifting.
component Tip
  props
    label: string
    side: string
    align: string
    offset: number
  slot
  state over = false
  action setOver(value: bool)
    over = value
  view
    box position="relative" hover=setOver flex-shrink=0 display="flex" flex-direction="row" align-items="center" min-width=0
      children
      if label != ""
        TipBubble(label=label, side=side, align=align, offset=offset, inset=0, shown=over)

// TooltipScrollDismissArea (ui/tooltip.tsx; T3 Code 1e2ecbd975, MIT, see LICENSE-T3): a tooltip in the transcript
// closes when the transcript scrolls, unless its trigger holds the focus, and stays closed until the pointer moves.
// The transcript (app-main.contract ChatColumn) moves `tipEpoch` on a scroll after a tip was hovered or moved over
// (`tipArm`); a tip whose `seen` epoch is older is dismissed. The host's hover of a still pointer after a scroll
// (exact2 #139) sends `hover`, never `pointermove`, so it cannot reopen it.
component TimelineTip
  inject
    tipEpoch: number
    tipArm: action
  props
    label: string
    side: string
    align: string
    offset: number
  slot
  state over = false
  state seen = tipEpoch
  state focused = false
  action setOver(value: bool)
    over = value
    if value
      tipArm()
      seen = tipEpoch
  action moved
    tipArm()
    seen = tipEpoch
  action focusEntered(e: FocusEvent)
    focused = true
  action focusLeft(e: FocusEvent)
    focused = false
    seen = tipEpoch
  view
    box position="relative" hover=setOver pointermove=moved focusin=focusEntered focusout=focusLeft flex-shrink=0 display="flex" flex-direction="row" align-items="center" min-width=0
      children
      if label != ""
        TipBubble(label=label, side=side, align=align, offset=offset, inset=0, shown=(over and (focused or seen == tipEpoch)))

// TimelineRowTimestamp: a plain span trigger (Base UI's trigger adds no
// tabIndex), shown while its row is hovered, focused or open. It is never a
// Tab stop; keyboard focus on the row reveals it. The transcript's scroll closes its tooltip as TimelineTip's.
component TimelineTimestamp
  inject
    tipEpoch: number
    tipArm: action
  props
    id: string
    label: string
    timestamp: string
    visible: bool
  state over = false
  state seen = tipEpoch
  action hoverTimestamp(value: bool)
    over = value
    if value
      tipArm()
      seen = tipEpoch
  action moved
    tipArm()
    seen = tipEpoch
  view
    box position=(visible ? "relative" : "absolute") opacity=(visible ? 1 : 0) pointer-events=(visible ? "auto" : "none") margin-right="0.25rem" hover=hoverTimestamp pointermove=moved testId=`work-timestamp-${id}` aria-label=label flex-shrink=0 display="flex" flex-direction="row" align-items="center" border-radius="0.25rem"
      text timestamp font-size="0.75rem" line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      if label != ""
        TipBubble(label=label, side="top", align="center", offset=20, inset=0, shown=(over and seen == tipEpoch))

// The bubble alone, for triggers that already track their own hover. `inset`
// moves an end- (or start-) aligned bubble past the trigger's edge, as Base
// UI's 5pt collision shift lands it against the window edge. An aligned
// bubble's row reaches 360pt the other way, so a 320pt card shifted far in
// (the Send tooltip beside a right panel) never wraps early.
component TipBubble
  inject
    rem: number
  props
    label: string
    side: string
    align: string
    offset: number
    inset: number
    shown: bool
  view
    if side == "top"
      row position="absolute" bottom=offset left=(align == "start" ? 0 - inset : (align == "end" ? -22.5 * rem : -10 * rem)) right=(align == "end" ? 0 - inset : (align == "start" ? -22.5 * rem : -10 * rem)) justify-content=(align == "start" ? "flex-start" : align == "end" ? "flex-end" : "center") pointer-events="none" z-index=140
        TipCard(label=label, shown=shown)
    else
      row position="absolute" top=offset left=(align == "start" ? 0 - inset : (align == "end" ? -22.5 * rem : -10 * rem)) right=(align == "end" ? 0 - inset : (align == "start" ? -22.5 * rem : -10 * rem)) justify-content=(align == "start" ? "flex-start" : align == "end" ? "flex-end" : "center") pointer-events="none" z-index=140
        TipCard(label=label, shown=shown)

// TooltipPopup's base `text-balance`: the words inherit balanced breaks from the card.
component TipCard
  props
    label: string
    shown: bool
  view
    column max-width="20rem" text-wrap="balance" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(shown ? 1 : 0) transition=(shown ? "opacity 150ms ease 600ms" : "opacity 0ms") pointer-events="none" role="tooltip" aria-hidden=(not shown) testId="tooltip"
      text label font-size="0.75rem" line-height="1.03125rem" white-space="pre-line" color="light-dark(#27272a, #f5f5f5)"
