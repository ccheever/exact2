  d: UiDecision,
  s: UiStart,
  id: string,
  width: number,
  height: number,
  follow: bool
): UiDecision = transitionStreamMeasuredGuard1(
  d,
  s,
  id,
  width,
  height,
  follow
)

fn transitionStreamMeasuredWrites2(
  d: UiDecision,
  s: UiStart,
  id: string,
  width: number,
  height: number,
  follow: bool
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeStreamGeometry=true,
    streamGeometry=StreamGeometryState(
      d.root.streamGeometry,
      width=width,
      height=height,
      followSize=follow
    )
  )
)

fn transitionStreamMeasuredGuard1(
  d: UiDecision,
  s: UiStart,
  id: string,
  width: number,
  height: number,
  follow: bool
): UiDecision = (
  id == s.shell.panel.browser.runtimeId
  ? transitionStreamMeasuredWrites2(
    d,
    s,
    id,
    width,
    height,
    follow
  )
  : d
)

