): UiDecision = transitionSearchBranchesWrites1(
  d,
  s,
  value
)

fn transitionSearchBranchesWrites1(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeBranchQuery=true,
    branchQuery=value
  )
)

fn stepSearchModels(
  d: UiDecision,
  s: UiStart,
  value: string
): UiDecision = transitionSearchModelsWrites1(
