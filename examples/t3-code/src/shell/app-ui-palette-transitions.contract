  )
)

fn stepSelectProject(
  d: UiDecision,
  s: UiStart,
  id: string
): UiDecision = transitionSelectProjectGuard1(
  d,
  s,
  id
)

fn transitionSelectProjectWrites2(
  d: UiDecision,
  s: UiStart,
  id: string
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeCommandPending=true,
    commandPending=true,
    changedKind="command",
    command=CommandArgs(
      p0="select-project",
      p1=id,
      p2="",
      p3=0
    ),
    writeProjectsOpen=true,
    projectsOpen=false,
    writeComposerDraft=true,
    composerDraft=ComposerDraftState(
      d.root.composerDraft,
      owner="__unset__"
    )
  )
)

fn transitionSelectProjectGuard1(
  d: UiDecision,
  s: UiStart,
  id: string
): UiDecision = (
  not s.commandPending
  ? transitionSelectProjectWrites2(
    d,
    s,
    id
  )
  : d
)

