use AppDecision, CommandArgs, ProviderAddArgs, ProviderChangeArgs from "./app-decisions.contract"
use TextArgs from "./app-decisions.contract"
use ComposerDraftState, ComposerMenuState, PaletteSessionState from "./app-protocols.contract"
use ProviderWizardState, StreamGeometryState from "./app-protocols.contract"
use UiDecision, PaletteResult from "./app-ui-decisions.contract"
use projectPaletteResult, applyPaletteResult from "./app-ui-decisions.contract"
use paletteFrameVisible from "./app-ui-queries.contract"
use UiStart from "./app-ui-start.contract"

fn stepScrollToEnd(
  d: UiDecision,
  s: UiStart
): UiDecision = transitionScrollToEndWrites1(
  d,
  s
)

fn transitionScrollToEndWrites1(
  d: UiDecision,
  s: UiStart
): UiDecision = UiDecision(
  d,
  root=AppDecision(
    d.root,
    writeJumpRequest=true,
    jumpRequest=s.jumpRequest + 1,
    writeFoldHold=true,
    foldHold=false
  )
)

