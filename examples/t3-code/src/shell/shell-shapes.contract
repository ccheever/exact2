use GitCard from "../details/git-shapes.contract"
// The window shell's projection (shell.ts): the toast stack, the header's
// panel controls and labels, the right panel's surface chooser, the thread
// details panel and the thread title's action menu.
use AutomationsView from "../details/thread-automations.contract"
use PanelView from "../panel/panel-shapes.contract"
use DetailsPrRowList from "../panel/pr-attachment-shapes.contract"
use ComposerFilePreview from "../panel/pr-attachment-shapes.contract"
use PrCheckout from "../composer/pr-checkout-shapes.contract"
use AddMachine from "./add-project-machine-shapes.contract"

shape ShellToast
  id: number
  kind: string
  title: string
  description: string
  icon: string
  iconColor: string
  provider: string
  actionLabel: string
  actionOp: string
  actionId: string
  actionValue: string
  actionOutline: bool
  actionDestructive: bool
  secondaryLabel: string
  secondaryOp: string
  secondaryId: string
  secondaryValue: string
  secondaryGhost: bool
  stacked: bool
  copyText: string
  copied: bool
  index: number
  details: ShellToastDetail[]
  expandLabel: string
  collapseLabel: string
  extraLabel: string // ThreadToastData.additionalActions (one), and each button's "Copied!" state
  extraOp: string
  extraId: string
  extraValue: string
  actionDone: bool
  secondaryDone: bool
  extraDone: bool
shape ShellToastDetail
  id: string
  title: string
  subtitle: string
  last: bool
shape ShellSurface
  id: string
  label: string
  icon: string
  shortcut: string
  letter: string
  available: bool
  reason: string
shape ShellMenuItem
  id: string
  label: string
  icon: string
  destructive: bool
  disabled: bool
  separated: bool
  submenu: string
  checked: bool
  op: string
  target: string
  value: string
  confirmTitle: string
  confirmBody: string
  offset: number
shape ShellLineage
  id: string
  title: string
  icon: string
  driver: string
  status: string
  dot: string
  group: string
  index: number
  mergeTarget: bool
  elapsed: string
  agent: bool
  missing: bool
  hint: string
  failed: bool
  canStop: bool
  kind: string
  workflowId: string
  expanded: bool
  phaseId: string
  phaseOpen: bool
  stopOp: string
  stopTarget: string
  count: string
  modelLine: string
  preview: string
shape ShellEditor
  id: string
  label: string
  selected: bool
shape NotifySound
  completion: number
  input: number
shape ShellView
  openGuideSelected: string
  toasts: ShellToast[]
  toastCount: number
  ticking: bool
  openRequest: string
  openThreadId: string
  keyRightPanel: string
  keyThreadPanel: string
  keyTerminal: string
  terminalAvailable: bool // an active server thread with a project
  terminalOpen: bool
  keyNewThread: string
  keyNewThreadLocal: string
  keySidebar: string
  serverThread: bool
  projectPath: string
  surfaces: ShellSurface[]
  titleMenu: ShellMenuItem[]
  titleSubmenu: ShellMenuItem[]
  notifications: string
  // The notification sounds the window plays (shell-notify.ts notificationSound): each kind's count of requests.
  notifySound: NotifySound
  // panel-surfaces.ts: the right panel's tabs and its Files / Linked pull requests / Device surfaces.
  panel: PanelView
  // The branch picker's PullRequestThreadDialog (pr-checkout.ts).
  prCheckout: PrCheckout
  // AddProjectToMachineDialog (add-project-dialog.ts).
  addMachine: AddMachine
  // A composer file chip's AttachmentFilePreview over the draft's bytes (composer-chip-file.ts).
  composerFile: ComposerFilePreview
  highlightPending: bool // a Files / attachment code text waits for its tokens (highlights.ts)
  // The screen reader's live regions (announce.ts, live-regions.contract).
  announce: AnnounceView
shape AnnounceView
  thread: string
  background: string
  first: string
  second: string
shape CardScript
  id: string
  label: string
  icon: string
shape ShellDetails
  ready: bool
  // The version-differ card (ThreadDetailsPanel versionMismatch), "" when hidden.
  versionClient: string
  versionServer: string
  versionLabel: string
  // The project script row (project-scripts.ts): the primary script and every script for its menu.
  scriptName: string
  scriptIcon: string
  scripts: CardScript[]
  inline: bool
  error: string
  folderName: string
  folderLabel: string
  cwd: string
  editorId: string
  editorLabel: string
  editors: ShellEditor[]
  editorShortcut: string
  // OpenInPicker's remote states (remote-open.ts): the row shows, the hint until the first remote
  // open, "No SSH route to <label>" and "No installed editors found".
  editorShow: bool
  editorHint: string
  editorUnavailable: string
  editorEmpty: bool
  isGit: bool
  branch: string
  actionLabel: string
  actionKind: string
  actionDisabled: bool
  actionHint: string
  insertions: number
  deletions: number
  // Appearance → Diff colors (red-green or blue-orange) for the Changes counts.
  diffScheme: string
  envModeSelect: bool
  envMode: string
  envIcon: string
  previousLabel: string
  actionIcon: string
  changesEnabled: bool
  envShow: bool
  envLabel: string
  envKind: string
  lineageTitle: string
  lineage: ShellLineage[]
  showLineage: bool
  previousCount: number
  previousFailed: number
  mergeRunId: string
  mergeTargetId: string
  mergeSourceId: string
  mergeLabel: string
  mergeHint: string
  // The pull request rows under the branch (pr-surface.ts).
  prRows: DetailsPrRowList
  // ThreadAutomationsPanel (thread-automations.ts): the thread's bound scheduled tasks.
  automations: AutomationsView
  // The branch picker, Git actions and their dialogs (git-card.ts).
  git: GitCard
