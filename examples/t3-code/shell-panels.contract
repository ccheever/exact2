// The right panel's launcher, the thread title's action menu and the app's
// confirm dialog (MIT reference, see LICENSE-T3: RightPanelTabs.tsx
// RightPanelEmptyState, PanelLayoutControls.tsx, threadActionMenu.logic.ts
// through ContextMenu's DOM fallback, ConfirmDialogHost.tsx), measured on
// the served reference.
use ShellView from "./shell-shapes.contract"
use ShellSurface from "./shell-shapes.contract"
use ShellMenuItem from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use MorphPair from "./shell-morph.contract"
use R4PanelHeader from "./r4-surfaces.contract"
use R4SurfaceBody from "./r4-surfaces.contract"
use R5PrSurfaceBody from "./r5-panels.contract"
use R5AttachmentBody from "./r5-panels.contract"
use PrDetailView from "./pages-pr-detail.contract"
use ChatDocument from "./markdown.contract"
use Look from "./settings-appearance-look.contract"

// RightPanelEmptyState in a 540pt panel (1px left border): its own top bar
// (maximize, terminal drawer, right panel pressed) and the centred launcher,
// 320pt wide, 32pt rows with a 20pt key cap. A row's letter opens it while
// the launcher has focus; unavailable rows stay listed at 50% with a reason.
component SurfacePanel
  props
    shell: ShellView
    sheet: bool
    maximized: bool
    detailsOpen: bool
    still: bool
    ui: action
    details: action
    local: action
    command: action
    paletteShow: action
    scheme: string
    prDetail: PrDetailView
    prDocuments: list<ChatDocument>
    prTab: string
    prSetTab: action
    prReload: action
    prAct: action
    prCopy: action
    look: Look
    confirm: action
    closePending: bool
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    column height="100%" width="100%" min-width=0 position="relative" box-sizing="border-box" background-color=(sheet ? "light-dark(#ffffff, #0a0a0a)" : "light-dark(#fcfcfc, #0a0a0a)") border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" box-shadow=(sheet ? "0 10px 15px -3px #0000000d, 0 4px 6px -4px #0000000d" : "none") role=(sheet ? "dialog" : "region") aria-label="Right panel" testId="right-panel"
      // r4-surfaces: an open surface draws the tab bar and its body (r4-surfaces.contract); otherwise the launcher.
      when shell.panel.open
        R4PanelHeader(panel=shell.panel, surfaces=shell.surfaces, sheet=sheet, maximized=maximized, detailsOpen=detailsOpen, keyThreadPanel=shell.keyThreadPanel, keyRightPanel=shell.keyRightPanel, terminalAvailable=shell.terminalAvailable, terminalOpen=shell.terminalOpen, keyTerminal=shell.keyTerminal, still=still, ui=ui, details=details, local=local, scheme=scheme)
        R4SurfaceBody(panel=shell.panel, scheme=scheme, sheet=sheet, local=local, command=command, paletteShow=paletteShow, look=look, confirm=confirm, closePending=closePending)
        // lane r5-panels: the pull request beside the thread and a sent attachment (r5-panels.contract).
        when shell.panel.kind == "pull-request"
          R5PrSurfaceBody(pr=shell.panel.pr, detail=prDetail, documents=prDocuments, scheme=scheme, tab=prTab, setTab=prSetTab, reload=prReload, act=prAct, copy=prCopy, local=local)
        when shell.panel.kind == "attachment"
          R5AttachmentBody(att=shell.panel.attachment, scheme=scheme, sheet=sheet, local=local)
      else
        row height=52 flex-shrink=0 padding-right=13 box-sizing="border-box" align-items="center" justify-content="flex-end" gap=4 position="relative" z-index=20
          when sheet
            box position="relative" flex-shrink=0
              button press=details("toggle", "", "") hover=hover("details") aria-label="Toggle thread details panel" aria-expanded=detailsOpen testId="panel-toggle-details" width=28 height=28 padding=0 border-radius=10 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(detailsOpen or hovered == "details" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
                ShellIcon(name="square-menu", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
              TipBubble(label=(shell.keyThreadPanel == "" ? "Toggle thread details" : `Toggle thread details (${shell.keyThreadPanel})`), side="bottom", align="center", offset=32, inset=0, shown=(hovered == "details"))
          box position="relative" flex-shrink=0 display=(sheet ? "none" : "flex")
            button press=ui("maximize", "") hover=hover("maximize") aria-label=(maximized ? "Restore panel size" : "Maximize panel") testId="maximize-right-panel" width=28 height=28 padding=0 border-radius=10 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(maximized or hovered == "maximize" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              MorphPair(first="maximize", second="minimize", on=maximized, size=16, color="light-dark(#27272acc, #f5f5f5cc)", onColor="light-dark(#27272acc, #f5f5f5cc)", still=still)
            TipBubble(label=(maximized ? "Restore panel size" : "Maximize panel"), side="bottom", align="center", offset=32, inset=0, shown=(hovered == "maximize"))
          box position="relative" flex-shrink=0 hover=hover("terminal")
            button press=ui("terminal", "") disabled=(not shell.terminalAvailable) aria-label="Toggle terminal drawer" aria-pressed=shell.terminalOpen testId="panel-toggle-terminal" width=28 height=28 padding=0 border-radius=10 border-width=0 opacity=(shell.terminalAvailable ? 1 : 0.64) display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(shell.terminalAvailable and (shell.terminalOpen or hovered == "terminal") ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              ShellIcon(name="panel-bottom", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
            TipBubble(label=(shell.terminalAvailable ? (shell.keyTerminal == "" ? "Toggle terminal drawer" : `Toggle terminal drawer (${shell.keyTerminal})`) : "Terminal drawer is unavailable"), side="bottom", align="end", offset=32, inset=40, shown=(hovered == "terminal"))
          box position="relative" flex-shrink=0
            button press=ui("toggle", "") hover=hover("toggle") aria-label="Toggle right panel" testId="panel-toggle-right" width=28 height=28 padding=0 border-radius=10 border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color="light-dark(#f4f4f5, #ffffff0a)"
              ShellIcon(name="panel-right", size=16, color="light-dark(#27272acc, #f5f5f5cc)")
            TipBubble(label=(shell.keyRightPanel == "" ? "Toggle right panel" : `Toggle right panel (${shell.keyRightPanel})`), side="bottom", align="end", offset=32, inset=8, shown=(hovered == "toggle"))
        column flex=1 min-height=0 align-items="center" justify-content="center" padding-left=24 padding-right=24 padding-bottom=52 box-sizing="border-box" id="surface-chooser" key=ui("key") hook="t3-launcher" data-surface-launcher-keys=join(map(filter(shell.surfaces, (entry) => entry.available), (entry) => entry.shortcut), "") aria-label="Open a surface" testId="surface-chooser"
          column width="100%" max-width=320 padding-top=24 padding-bottom=24 box-sizing="border-box"
            text "Open a surface" margin-bottom=12 text-align="center" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            column width="100%" gap=2
              each surface in shell.surfaces key=surface.id
                SurfaceRow(surface=surface, highlighted=(hovered == surface.id), hover=hover, choose=ui("choose"))

component SurfaceRow
  props
    surface: ShellSurface
    highlighted: bool
    hover: action
    choose: action
  view
    box position="relative" width="100%" hover=hover(surface.id)
      when surface.available
        button press=choose(surface.id) testId=`surface-${surface.id}` aria-label=`${surface.label} ${surface.shortcut}` width="100%" height=32 padding-left=10 padding-right=10 box-sizing="border-box" gap=10 border-radius=8 border-width=0 display="flex" flex-direction="row" align-items="center" background-color=(highlighted ? "light-dark(#f4f4f599, #ffffff06)" : "#00000000")
          ShellIcon(name=surface.icon, size=16, color="light-dark(#262626, #f5f5f5)")
          // A button centers its text (text-align: center, as on the web); the reference's row is start-aligned.
          text surface.label flex=1 min-width=0 line-clamp=1 text-align="left" font-size=14 line-height="20px" color="light-dark(#262626, #f5f5f5)"
          SurfaceKey(shortcut=surface.shortcut)
      else
        row width="100%" height=32 padding-left=10 padding-right=10 box-sizing="border-box" gap=10 border-radius=8 align-items="center" opacity=0.5 aria-label=`${surface.label} ${surface.shortcut}` testId=`surface-${surface.id}`
          ShellIcon(name=surface.icon, size=16, color="light-dark(#262626, #f5f5f5)")
          text surface.label flex=1 min-width=0 line-clamp=1 font-size=14 line-height="20px" color="light-dark(#262626, #f5f5f5)"
          SurfaceKey(shortcut=surface.shortcut)
        TipBubble(label=surface.reason, side="top", align="center", offset=36, inset=0, shown=highlighted)

// ui/kbd: 20pt cap, 4pt radius, muted fill, 12/16 medium.
component SurfaceKey
  props
    shortcut: string
  view
    row min-width=20 height=20 padding-left=4 padding-right=4 box-sizing="border-box" border-radius=4 align-items="center" justify-content="center" flex-shrink=0 background-color="light-dark(#fafafa, #ffffff08)" pointer-events="none"
      text shortcut font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"

// The thread action menu as ContextMenu's DOM fallback draws it at the title
// (left edge, 4pt below): dropdown glass, 4pt inset, 28pt rows (16pt muted
// glyph, 8pt gap, 14/20 label), 1pt separators inset 8pt, a submenu flown out
// to the right level with its row when that row is hovered. A transparent
// backdrop closes it; a second click there (a double-click on the title)
// renames instead. Submenu state is keyed to this opening's serial.
component TitleMenu
  props
    items: list<ShellMenuItem>
    children: list<ShellMenuItem>
    x: number
    y: number
    serial: number
    pick: action
    ui: action
  state sub = ""
  state subTop = 0
  state subSerial = -1
  state hoveredId = ""
  derive open = subSerial == serial ? sub : ""
  action hover(id: string, op: string, parent: string, offset: number, over: bool)
    if over
      hoveredId = id
      if op == "ui:submenu"
        sub = id
        subTop = offset
        subSerial = serial
      else
        if parent == ""
          sub = ""
    else
      if hoveredId == id
        hoveredId = ""
  view
    box position="absolute" left=0 top=0 right=0 bottom=0 z-index=60 testId="title-menu-layer"
      button press=ui("close", "") dblclick=ui("rename", "") aria-label="Close menu" aria-keyshortcuts="Escape" testId="title-menu-backdrop" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000"
      row position="absolute" left=x top=y align-items="flex-start"
        column min-width=128 max-width=384 padding=4 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" role="menu" aria-label="Thread actions" testId="title-menu"
          each entry in items key=entry.id
            when entry.separated
              box height=1 margin-top=4 margin-bottom=4 margin-left=8 margin-right=8 background-color="light-dark(#e4e4e7, #ffffff0f)"
            MenuRow(entry=entry, highlighted=(hoveredId == entry.id or open == entry.id), pick=pick, hover=hover)
        when open != ""
          column min-width=128 max-width=384 margin-left=-1 margin-top=subTop padding=4 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" role="menu" aria-label=open testId="title-submenu"
            each entry in filter(children, (c) => c.submenu == open) key=entry.id
              when entry.separated
                box height=1 margin-top=4 margin-bottom=4 margin-left=8 margin-right=8 background-color="light-dark(#e4e4e7, #ffffff0f)"
              MenuRow(entry=entry, highlighted=(hoveredId == entry.id), pick=pick, hover=hover)

component MenuRow
  props
    entry: ShellMenuItem
    highlighted: bool
    pick: action
    hover: action
  view
    button press=pick(entry.op, entry.target, entry.value, entry.confirmTitle, entry.confirmBody, entry.destructive) hover=hover(entry.id, entry.op, entry.submenu, entry.offset) disabled=entry.disabled role=(entry.id == "auto-settle:enabled" or entry.id == "auto-settle:disabled" ? "menuitemradio" : "menuitem") aria-checked=entry.checked aria-expanded=(entry.op == "ui:submenu" and highlighted) testId=`title-menu-${entry.id}` width="100%" min-height=28 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 box-sizing="border-box" gap=8 border-radius=6 border-width=0 display="flex" flex-direction="row" align-items="center" opacity=(entry.disabled ? 0.64 : 1) background-color=(highlighted ? (entry.destructive ? "light-dark(#fb2c3614, #fb414a1f)" : "light-dark(#f4f4f5, #ffffff0a)") : "#00000000")
      when entry.icon != ""
        ShellIcon(name=entry.icon, size=16, color=(entry.destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#71717b, #818181)"))
      when entry.checked
        ShellIcon(name="check", size=16, color="light-dark(#27272a, #f5f5f5)")
      when entry.icon == "" and not entry.checked and (entry.id == "auto-settle:enabled" or entry.id == "auto-settle:disabled")
        box width=16 height=16 flex-shrink=0
      text entry.label flex=1 min-width=0 line-clamp=1 white-space="nowrap" font-size=14 line-height="20px" color=(entry.destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")
      when entry.op == "ui:submenu"
        box opacity=0.8 margin-right=-2 flex-shrink=0 display="flex"
          ShellIcon(name="chevron-right", size=16, color="light-dark(#71717b, #818181)")

// ConfirmDialogHost (ui/alert-dialog.tsx), measured on the served reference:
// a 4pt-blurred 60% canvas backdrop (64% dark), a 512pt dialog-glass popup
// (18pt radius, foreground/10 edge, 0 24 64 -24 black/65 shadow) with a 24pt
// header (20/20 semibold title, 14/20 muted description, 8pt apart) and a
// muted footer (16×24, top rule) holding Cancel (outline, Escape) and Confirm
// (default, or destructive), both 32pt with 11pt sides. The popup's own glass
// is flattened to the colour it shows over that backdrop.
component AppConfirm
  props
    title: string
    body: string
    destructive: bool
    busy: bool
    cancel: action
    confirm: action
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding=16 box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="app-confirm-overlay"
      column width="100%" max-width=512 box-sizing="border-box" border-radius=18 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="alertdialog" aria-label=title testId="app-confirm"
        column gap=8 padding=24 box-sizing="border-box"
          text title font-size=20 font-weight=600 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          when body != ""
            text body font-size=14 line-height="20px" white-space="pre-line" color="light-dark(#71717b, #8f8f8f)"
        row gap=8 justify-content="flex-end" padding-left=24 padding-right=24 padding-top=16 padding-bottom=16 box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button press=cancel disabled=busy aria-keyshortcuts="Escape" testId="app-confirm-cancel" display="flex" flex-direction="row" align-items="center" justify-content="center" height=32 padding-left=11 padding-right=11 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d"
            text "Cancel" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
          button press=confirm disabled=busy testId="app-confirm-confirm" display="flex" flex-direction="row" align-items="center" justify-content="center" height=32 padding-left=11 padding-right=11 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 opacity=(busy ? 0.64 : 1) border-color=(destructive ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#1b4ed8, #346bf1)") background-color=(destructive ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#1b4ed8, #346bf1)") box-shadow="0 1px 2px #0000000d"
            text "Confirm" font-size=14 font-weight=500 line-height="20px" color="#ffffff"
