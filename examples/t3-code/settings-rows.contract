// Setting sections, rows and their controls (lane settings-core): SettingsSection,
// SettingsGroup, SettingsRow, ui/switch, ui/select (trigger + popup), DraftInput,
// NumberField, the composer model/traits pickers and the scope sentence menus.
use CoreIcon from "./settings-core.contract"
use CoreMark from "./settings-core.contract"
use CoreRow from "./settings-core.contract"
use CoreSection from "./settings-core.contract"
use CoreOption from "./settings-core.contract"
use ScopeChoice from "./settings-core.contract"
use CorePalette from "./settings-core.contract"
use SettingsGhost from "./settings-core.contract"
use ProviderInstanceMark from "./icons.contract"
use CcIcon from "./composer-controls.contract"
use CnMachineIcon from "./settings-b-kit.contract"
use PolicyTip from "./settings-kit.contract"
use AboutUpdateButton from "./settings-a-about.contract"
use MobileBetaControl from "./settings-mobile-beta.contract"
use ScopedSwitch from "./settings-scoped-switch.contract"
use FontFamilyPicker from "./settings-a-fonts.contract"
use PromptFontPreview from "./settings-prompt-preview.contract"
use FontCodePreview from "./settings-font-previews.contract"
use FontDiffPreview from "./shapes.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"

// "Applying settings for <project> across <environment>" with its two radio menus.
component ScopeSentence
  props
    pal: CorePalette
    projectLabel: string
    projectMark: string
    projectInk: string
    projectSurface: string
    environmentLabel: string
    environmentIcon: string
    connective: string
    projects: list<ScopeChoice>
    environments: list<ScopeChoice>
    projectKeyed: list<ScopeChoice>
    environmentKeyed: list<ScopeChoice>
    menu: string
    openMenu: action
    closeMenu: action
    choose: action
  // fix-keyboard-focus: the scope menus' keyboard (menu-keys.contract): Enter or Space on a trigger.
  state projectOpens = 0
  state projectArmed = false
  action projectArm(on: bool)
    projectArmed = on
  action projectOpened(last: bool)
    projectOpens = kmBump(projectOpens, last)
  state environmentOpens = 0
  state environmentArmed = false
  action environmentArm(on: bool)
    environmentArmed = on
  action environmentOpened(last: bool)
    environmentOpens = kmBump(environmentOpens, last)
  action projectKey(k: string)
    if kmOpenKey(k)
      projectOpens = kmBump(projectOpens, false)
  action environmentKey(k: string)
    if kmOpenKey(k)
      environmentOpens = kmBump(environmentOpens, false)
  view
    row flex-wrap="wrap" align-items="center" column-gap="0.375rem" row-gap="0.25rem" padding-left="1rem" padding-right="1rem" width="100%" box-sizing="border-box" position="relative" z-index=(startsWith(menu, "scope/") ? 50 : 1) testId="settings-scope-sentence"
      row align-items="center" gap="0.375rem" min-width=0
        text "Applying settings for" font-size="1rem" line-height="1.5rem" color=pal.muted flex-shrink=0
        box position="relative"
          button popovertarget="settings-scope-project-menu" key=projectKey focus=projectArm(true) blur=projectArm(false) class=SettingsGhost gap="0.375rem" padding=0 height="1.5rem" aria-label=`Project scope: ${projectLabel}` testId="settings-scope-project" title=""
            when projectMark != ""
              CoreMark(label=projectMark, ink=projectInk, surface=projectSurface)
            // Keyed by its label: a reused one-line text kept drawing the old string clipped to the new width.
            each keyed in projectKeyed key=keyed.id
              column position="relative"
                text keyed.label font-size="1rem" font-weight=500 line-height="1.5rem" color=pal.text line-clamp=1 max-width="18rem"
                svg position="absolute" left=0 right=0 bottom=1 height=2 width="100%" viewBox="0 0 400 2" preserveAspectRatio="none" aria-hidden=true
                  path d="M0 1H400" stroke=pal.text stroke-opacity=0.3 stroke-width=1.5 stroke-dasharray="1.5 2.5"
            CoreIcon(name="chevron-down", size=14, color=pal.muted)
          KeyMenuOpen(menuId="settings-scope-project-menu", armed=projectArmed, opened=projectOpened)
          ScopeMenu(pal=pal, choices=projects, project=true, menuId="settings-scope-project-menu", keyed=projectOpens, choose=choose)
      row align-items="center" gap="0.375rem" min-width=0
        text connective font-size="1rem" line-height="1.5rem" color=pal.muted flex-shrink=0
        box position="relative"
          button popovertarget="settings-scope-environment-menu" key=environmentKey focus=environmentArm(true) blur=environmentArm(false) class=SettingsGhost gap="0.375rem" padding=0 height="1.5rem" aria-label=`Environment scope: ${environmentLabel}` testId="settings-scope-environment" title=""
            when environmentIcon != ""
              CnMachineIcon(kind=environmentIcon, size=14, color=pal.text)
            each keyed in environmentKeyed key=keyed.id
              column position="relative"
                text keyed.label font-size="1rem" font-weight=500 line-height="1.5rem" color=pal.text line-clamp=1 max-width="18rem"
                svg position="absolute" left=0 right=0 bottom=1 height=2 width="100%" viewBox="0 0 400 2" preserveAspectRatio="none" aria-hidden=true
                  path d="M0 1H400" stroke=pal.text stroke-opacity=0.3 stroke-width=1.5 stroke-dasharray="1.5 2.5"
            CoreIcon(name="chevron-down", size=14, color=pal.muted)
          KeyMenuOpen(menuId="settings-scope-environment-menu", armed=environmentArmed, opened=environmentOpened)
          ScopeMenu(pal=pal, choices=environments, project=false, menuId="settings-scope-environment-menu", keyed=environmentOpens, choose=choose)

component ScopeMenu
  props
    pal: CorePalette
    choices: list<ScopeChoice>
    project: bool
    menuId: string
    keyed: number
    choose: action
  state lit = ""
  derive scope = project ? "project" : "environment"
  // audit-wave-followups-4 FX-2 (menu-keys.contract): the pointer entering a row focuses it; leaving the row that holds the
  // focus hands it to the popup. A row is highlighted by its focus alone; the chosen one keeps its wash beside the highlight
  // (MenuRadioItem data-checked, SelectItem data-selected: bg-foreground/8).
  action hover(id: string, rowId: string, over: bool)
    if over
      focus(`${rowId}-km`)
    else if lit == id
      focus(`${menuId}-keys`)
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    column id=menuId popover="auto" position="absolute" margin-top="0.25rem" min-width="11rem"
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="menu" testId=(project ? "settings-scope-project-menu" : "settings-scope-environment-menu")
        KeyMenu(menuId=`${menuId}-keys`, items=map(choices, (choice) => KmItem(id=`settings-scope-choice-${scope}-${choice.id == "" ? "all" : choice.id}`, label=choice.label)), keyed=keyed, gap="0px", modal=true)
          each choice in choices key=choice.id
            column width="100%"
              button id=`settings-scope-choice-${scope}-${choice.id == "" ? "all" : choice.id}` press=choose(project, choice.id, choice.member) popovertarget=menuId popovertargetaction="hide" hover=hover(choice.id, `settings-scope-choice-${scope}-${choice.id == "" ? "all" : choice.id}`) focus=focused(choice.id, true) blur=focused(choice.id, false) role="menuitemradio" aria-checked=choice.selected class=SettingsGhost justify-content="flex-start" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" border-radius="0.375rem" background-color=(lit == choice.id or choice.selected ? pal.highlight : "#00000000") testId=`settings-scope-choice-${project ? "project" : "environment"}-${choice.id == "" ? "all" : choice.id}`
                when project and choice.mark != ""
                  CoreMark(label=choice.mark, ink=choice.ink, surface=choice.surface)
                when not project and choice.mark != ""
                  CnMachineIcon(kind=choice.mark, size=14, color=pal.text)
                when not project and choice.id == ""
                  CoreIcon(name="layers", size=14, color=pal.text)
                text choice.label font-size="0.875rem" line-height="1.25rem" color=pal.text flex=1 min-width=0 line-clamp=1 white-space="nowrap"
                when choice.offline
                  text "Offline" font-size="0.75rem" color=pal.muted flex-shrink=0
                box width="0.875rem" height="0.875rem" flex-shrink=0
                  when choice.selected
                    CoreIcon(name="check", size=14, color=pal.text)
              when choice.id == ""
                box height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" background-color=pal.divider flex-shrink=0

// SettingsSection list. Each section header, its card (rounded-xl border bg-card/40 shadow-xs/5)
// and divided rows; Legacy features folds behind its trigger.
component CoreSections
  props
    reduced: bool
    sections: list<CoreSection>
    pal: CorePalette
    // The Typography code sample (settings-font-previews.ts).
    codePreview: FontDiffPreview
    busy: bool
    menu: string
    legacyOpen: bool
    toggleLegacy: action
    openMenu: action
    closeMenu: action
    change: action
    slide: action
    navigate: action
  view
    column gap="2rem" width="100%"
      each section in sections key=section.id
        column gap="0.625rem" width="100%" position="relative" z-index=(startsWith(menu, `${section.id}/`) ? 50 : 1) id=section.id testId=`settings-section-${section.id}`
          when section.collapsible
            button press=toggleLegacy class=SettingsGhost justify-content="flex-start" gap="0.5rem" min-height="2rem" padding-left="1rem" padding-right="1rem" width="100%" aria-expanded=legacyOpen testId=`settings-section-toggle-${section.id}`
              text section.title font-size="0.875rem" line-height="1.25rem" color=pal.heading
              box rotate=(legacyOpen ? "90deg" : "0deg")
                CoreIcon(name="chevron-right", size=16, color=pal.muted)
          else
            row min-height="1.75rem" align-items="center" justify-content="space-between" padding-left="1rem" padding-right="1rem"
              text section.title font-size="0.875rem" line-height="1.25rem" color=pal.heading
              when section.id == "typography"
                row gap="0.5rem" align-items="center"
                  text "Advanced" font-size="0.875rem" line-height="1.25rem" color=pal.muted
                  button press=change("typography-advanced", "typographyAdvanced", section.toggle ? "false" : "true") role="switch" aria-checked=section.toggle aria-label="Advanced Show advanced typography settings" disabled=busy class=SettingsGhost justify-content="flex-start" width="1.875rem" height="1.125rem" padding="0.125rem" border-radius="0.5625rem" background-color=(section.toggle ? pal.accent : pal.switchOff) testId="setting-typography-advanced" title=""
                    box width="0.875rem" height="0.875rem" border-radius="0.4375rem" background-color=pal.thumb margin-left=(section.toggle ? "0.75rem" : "0px") box-shadow="0 1px 3px #0000000d"
          when not section.collapsible or legacyOpen
            column width="100%" border-radius="0.75rem" border-width=1 border-style="solid" border-color=pal.cardBorder background-color=pal.card box-shadow="0 1px 2px #0000000d" box-sizing="border-box"
              each row in section.rows key=row.id
                CoreRowView(reduced=reduced, row=row, section=section.id, pal=pal, codePreview=codePreview, busy=busy, menu=menu, openMenu=openMenu, closeMenu=closeMenu, change=change, slide=slide, navigate=navigate)

component CoreRowView
  props
    reduced: bool
    row: CoreRow
    section: string
    pal: CorePalette
    codePreview: FontDiffPreview
    busy: bool
    menu: string
    openMenu: action
    closeMenu: action
    change: action
    slide: action
    navigate: action
  // fix-keyboard-focus: the traits menu's keyboard (menu-keys.contract).
  state traitsOpens = 0
  state traitsArmed = false
  action traitsArm(on: bool)
    traitsArmed = on
  action traitsOpened(last: bool)
    traitsOpens = kmBump(traitsOpens, last)
  action traitsKey(k: string)
    if kmOpenKey(k)
      traitsOpens = kmBump(traitsOpens, false)
  view
    column width="100%" padding-top="0.75rem" padding-bottom=(startsWith(row.info, "preview-") ? "0.25rem" : "0.75rem") padding-left="1rem" padding-right="1rem" gap="0.75rem" box-sizing="border-box" border-top-width=(row.divider ? 1 : 0) border-top-style="solid" border-color=pal.divider position="relative" z-index=(startsWith(menu, `${section}/${row.id}`) ? 50 : 1) id=row.id testId=`setting-row-${row.id}`
      row width="100%" gap="2rem" align-items="center"
        column flex=1 min-width=0 gap="0.25rem"
          row min-height="1.25rem" align-items="center" gap="0.375rem"
            when row.kind == "version"
              text "Version" font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text
              text row.value font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color=pal.text
            else
              text row.title font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text
            when row.info != "" and not startsWith(row.info, "preview")
              PolicyTip(tip=row.info, tipId=`setting-info-${row.id}`)
                CoreIcon(name="info", size=14, color=pal.muted)
            when row.inheritance != ""
              box position="relative"
                button popovertarget=`inherit-${section}-${row.id}` class=SettingsGhost width="1.25rem" height="1.25rem" border-radius="0.375rem" aria-label=`${row.inheritanceSummary}. Show where this value comes from` testId=`setting-inheritance-${row.id}` title=""
                  // SettingInheritance: LayersIcon size-3, text-primary only when overridden, text-warning when mixed.
                  CoreIcon(name="layers", size=12, color=(row.inheritance == "overridden" ? pal.accent : (row.inheritance == "mixed" ? "#fe9a00" : pal.muted)))
                column id=`inherit-${section}-${row.id}` popover="auto" position="absolute" margin-top="0.25rem" width="19.375rem"
                  column width="100%" padding="0.5rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="dialog" testId=`setting-inheritance-${row.id}-popover`
                    row gap="0.375rem" align-items="center" padding-left="0.25rem" padding-bottom="0.25rem"
                      CoreIcon(name="laptop", size=14, color=pal.muted)
                      text row.layerTitle font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.muted
                    each layer in row.layers key=layer.id
                      row height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" align-items="center" border-radius="0.375rem" background-color=(layer.selected ? pal.highlight : "#00000000") testId=`setting-inheritance-${row.id}-${layer.id}`
                        text layer.label font-size="0.875rem" line-height="1.25rem" color=pal.text flex=1
                        text layer.detail font-size="0.875rem" line-height="1.25rem" color=(layer.selected ? pal.text : pal.muted)
                        when layer.selected
                          CoreIcon(name="check", size=14, color=pal.accent)
            when row.resettable
              button press=change(row.id, "reset", row.target) class=SettingsGhost width="1.25rem" height="1.25rem" border-radius="0.375rem" disabled=busy aria-label=`Reset ${row.resetLabel} to default` testId=`setting-reset-${row.id}` title=""
                CoreIcon(name="undo-2", size=12, color=pal.muted)
          when row.description != ""
            text row.description font-size="0.75rem" line-height="1.125rem" color=pal.description max-width="36rem" testId=`setting-description-${row.id}`
          when row.status != ""
            text row.status font-size="0.75rem" line-height="1rem" color=pal.muted padding-top="0.125rem" testId=`setting-status-${row.id}`
        when row.kind == "version"
          row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end"
            AboutUpdateButton(row=row, pal=pal, busy=busy, change=change)
        when row.kind != "version" and row.kind != "none"
          row flex-shrink=0 min-width="10rem" align-items="center" justify-content="flex-end" gap="0.5rem" opacity=(row.inert ? 0.5 : 1) position="relative"
            when row.kind == "switch"
              // D15: a mixed switch turns the setting on for every selected target.
              ScopedSwitch(checked=row.checked, mixed=row.mixed, label=row.title, disabled=(busy or row.inert or row.disabled), faded=row.disabled, on=pal.accent, off=pal.switchOff, thumb=pal.thumb, reduced=reduced, switchId=`setting-${row.id}`, press=change(row.id, row.target, row.mixed or not row.checked ? "true" : "false"))
            when row.kind == "select"
              CoreSelect(rowId=row.id, section=section, value=row.label, icon=row.icon, width=row.width, menuWidth=row.menuWidth, options=row.options, pal=pal, disabled=(busy or row.inert or row.disabled), dim=(row.inert or row.disabled), menu=menu, openMenu=openMenu, choose=change(row.id, row.target))
              when row.value2 == "configure"
                button press=change(row.id, row.target, "advanced") disabled=(busy or row.inert) aria-label="Configure advanced background activity" class=SettingsGhost width="1.75rem" height="1.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" testId=`setting-${row.id}-configure` title=""
                  CoreIcon(name="settings", size=16, color=pal.text)
            when row.kind == "model"
              // ProviderModelPicker: the composer's picker (model-picker.contract) opens under this trigger (settings-model-picker);
              // a Mixed value shows its neutral label without a provider mark.
              box position="relative"
                button press=change(row.id, "picker", "") class=SettingsGhost gap="0.375rem" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" disabled=(busy or row.inert) aria-label=row.label aria-haspopup="dialog" id=`setting-${row.id}` testId=`setting-${row.id}-model`
                  when not row.mixed
                    ProviderInstanceMark(driver=row.driver, size=16, color=pal.muted, badge=row.badge, accent=row.badgeColor)
                  text row.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.muted line-clamp=1
                  CoreIcon(name="chevron-down", size=14, color=pal.muted)
              when row.label2 != ""
                box position="relative"
                  button popovertarget=`effort-${section}-${row.id}` key=traitsKey focus=traitsArm(true) blur=traitsArm(false) class=SettingsGhost gap="0.375rem" height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" disabled=(busy or row.inert) aria-label=row.label2 testId=`setting-${row.id}-effort`
                    // TraitsPicker's trigger: a Fast or Ultrafast service tier draws the bolt before the label.
                    when row.icon != ""
                      CcIcon(name=(row.icon == "ultrafast" ? "ultrafast" : "zap"), size=16, color=pal.text, weight=2)
                    text row.label2 font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.muted
                    CoreIcon(name="chevron-down", size=14, color=pal.muted)
                  KeyMenuOpen(menuId=`effort-${section}-${row.id}`, armed=traitsArmed, opened=traitsOpened)
                  TraitsMenu(options=row.options2, pal=pal, menuId=`effort-${section}-${row.id}`, keyed=traitsOpens, choose=change(row.id, "effort"), testId=`setting-${row.id}-effort-menu`)
            when row.kind == "text-only"
              text row.label font-size="0.875rem" line-height="1.25rem" color=pal.muted
            when row.kind == "mobile-beta"
              MobileBetaControl(row=row, pal=pal, busy=busy, change=change)
            when row.kind == "number" or row.kind == "text"
              CoreField(value=row.value, rowId=row.id, width=row.width, placeholder=row.placeholder, numeric=(row.kind == "number"), label=row.title, pal=pal, disabled=(busy or row.inert), commit=change(row.id, row.target))
            when row.kind == "link"
              button press=navigate(row.target) class=SettingsGhost height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" id=`setting-${row.id}` testId=`setting-${row.id}-link`
                text row.label font-size="0.875rem" font-weight=500 line-height="1.25rem" color=pal.text
            when row.kind == "slider"
              when row.info == "preview"
                PanelPreview(duration=row.amount, pal=pal)
              CoreSlider(row=row, pal=pal, disabled=busy, commit=slide(row.id, row.target))
            when row.kind == "font"
              FontFamilyPicker(rowId=row.id, label=`${row.title} family`, value=row.label, families=row.options, pal=pal, disabled=busy, choose=change(row.id, row.target))
              CoreSelect(rowId=`${row.id}-size`, section=section, value=row.label2, icon="", width=144, menuWidth=0, options=row.options2, pal=pal, disabled=busy, dim=false, menu=menu, openMenu=openMenu, choose=change(row.id, row.suffix))
      when row.info == "preview-prompt"
        PromptFontPreview(family=row.driver, size=row.previewSize, pal=pal)
      when row.info == "preview-code" or row.info == "preview-code-terminal"
        FontCodePreview(preview=codePreview, family=row.driver, size=row.amount, pal=pal)
      when row.info == "preview-code-terminal" or row.info == "preview-terminal"
        FontTerminalPreview(family=row.driver, size=row.amount, pal=pal)

// SelectTrigger size sm + SelectPopup align end (alignItemWithTrigger=false).
// The select's widths are px at the root size 16 and lay out in rem (w-36, min-w-40), as the reference's.
component CoreSelect
  props
    rowId: string
    section: string
    value: string
    icon: string
    width: number
    menuWidth: number
    options: list<CoreOption>
    pal: CorePalette
    disabled: bool
    dim: bool
    menu: string
    openMenu: action
    choose: action
  // fix-keyboard-focus: the menu's keyboard (menu-keys.contract).
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    box position="relative" flex-shrink=0
      button popovertarget=`select-${section}-${rowId}` key=triggerKey focus=keyArm(true) blur=keyArm(false) disabled=disabled role="combobox" aria-label=value id=`setting-${rowId}` testId=`setting-${rowId}` border-width=0 padding=0 background-color="#00000000"
        SelectFace(value=value, icon=icon, width=width, pal=pal, dim=dim)
      KeyMenuOpen(menuId=`select-${section}-${rowId}`, armed=keyArmed, opened=keyOpened)
      CoreMenu(options=options, pal=pal, width=(menuWidth > 0 ? menuWidth : width), checks=(icon == "checks"), menuId=`select-${section}-${rowId}`, keyed=keyed, choose=choose, testId=`setting-${rowId}-menu`)

component SelectFace
  props
    value: string
    icon: string
    width: number
    pal: CorePalette
    dim: bool
  view
    row justify-content="space-between" align-items="center" gap="0.5rem" min-width=(width > 0 ? `${width / 16}rem` : "0px") max-width=(width > 0 ? `${width / 16}rem` : "25rem") height="1.75rem" padding-left="0.5625rem" padding-right="0.3125rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow=(dim ? "none" : "0 1px 2px #0000000d") box-sizing="border-box" opacity=(dim ? 0.64 : 1)
      row gap="0.375rem" align-items="center" min-width=0 flex=1
        when icon == "dots-red-green" or icon == "dots-blue-orange"
          row gap="0.25rem" flex-shrink=0
            box width="0.5rem" height="0.5rem" border-radius="0.25rem" background-color=(icon == "dots-red-green" ? "light-dark(#ef4444, #f87171)" : "light-dark(#3b82f6, #60a5fa)")
            box width="0.5rem" height="0.5rem" border-radius="0.25rem" background-color=(icon == "dots-red-green" ? "light-dark(#22c55e, #4ade80)" : "light-dark(#f97316, #fb923c)")
        when icon != "" and icon != "dots-red-green" and icon != "dots-blue-orange" and icon != "checks"
          CoreIcon(name=icon, size=14, color=pal.muted)
        text value font-size="0.875rem" line-height="1.25rem" color=pal.text line-clamp=1 white-space="nowrap" text-overflow="ellipsis" flex-shrink=1 min-width=0
      box opacity=0.5 flex-shrink=0
        CoreIcon(name="chevron-down", size=12, color=pal.text)

component CoreMenu
  props
    options: list<CoreOption>
    pal: CorePalette
    width: number
    checks: bool
    menuId: string
    keyed: number
    choose: action
    testId: string
  state lit = ""
  // audit-wave-followups-4 FX-2 (menu-keys.contract): the pointer entering a row focuses it; leaving the row that holds the
  // focus hands it to the popup. A row is highlighted by its focus alone; the chosen one keeps its wash beside the highlight
  // (MenuRadioItem data-checked, SelectItem data-selected: bg-foreground/8).
  action hover(id: string, rowId: string, over: bool)
    if over
      focus(`${rowId}-km`)
    else if lit == id
      focus(`${menuId}-keys`)
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    column id=menuId popover="auto" position="absolute" margin-top="0.25rem" min-width=(width > 0 ? `${width / 16}rem` : "10rem") width=(width > 200 ? `${width / 16}rem` : "auto")
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="listbox" testId=testId
        KeyMenu(menuId=`${menuId}-keys`, items=map(filter(options, (option) => not option.disabled), (option) => KmItem(id=`${testId}-${option.id}`, label=option.label)), keyed=keyed, gap="0px", modal=true)
          each option in options key=option.id
            button id=`${testId}-${option.id}` press=choose(option.value) popovertarget=menuId popovertargetaction="hide" hover=hover(option.id, `${testId}-${option.id}`) focus=focused(option.id, true) blur=focused(option.id, false) role="option" aria-selected=option.selected disabled=option.disabled class=SettingsGhost justify-content="flex-start" align-items=(option.detail != "" ? "flex-start" : "center") width="100%" min-height="1.75rem" padding-top="0.25rem" padding-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" border-radius="0.375rem" opacity=(option.disabled ? 0.64 : 1) background-color=(lit == option.id or option.selected ? pal.highlight : "#00000000") testId=`${testId}-${option.id}`
              column flex=1 min-width=0 gap="0.125rem" align-items="flex-start"
                row gap="0.375rem" align-items="center"
                  when option.icon != "" and option.icon != "codex" and option.icon != "claudeAgent"
                    CoreIcon(name=option.icon, size=14, color=pal.muted)
                  text option.label font-size="0.875rem" font-weight=(option.detail != "" and option.icon != "codex" ? 500 : 400) line-height="1.25rem" color=pal.text white-space="nowrap"
                when option.detail != ""
                  text option.detail font-size="0.75rem" line-height="1rem" color=pal.muted
              when checks and option.selected
                CoreIcon(name="check", size=14, color=pal.text)

// TraitsPicker's menu: a labelled group per trait (Reasoning, Service Tier) split by a rule, radio
// rows whose checked row is filled, a "Default" badge and the option's description under its label.
component TraitsMenu
  props
    options: list<CoreOption>
    pal: CorePalette
    menuId: string
    keyed: number
    choose: action
    testId: string
  state lit = ""
  // audit-wave-followups-4 FX-2 (menu-keys.contract): the pointer entering a row focuses it; leaving the row that holds the
  // focus hands it to the popup. A row is highlighted by its focus alone; the chosen one keeps its wash beside the highlight
  // (MenuRadioItem data-checked, SelectItem data-selected: bg-foreground/8).
  action hover(id: string, rowId: string, over: bool)
    if over
      focus(`${rowId}-km`)
    else if lit == id
      focus(`${menuId}-keys`)
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    column id=menuId popover="auto" position="absolute" margin-top="0.25rem" min-width="11rem"
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="menu" testId=testId
        KeyMenu(menuId=`${menuId}-keys`, items=map(filter(options, (option) => option.icon != "section" and option.icon != "section-rule"), (option) => KmItem(id=`${testId}-${option.id}`, label=option.label)), keyed=keyed, gap="0px", modal=true)
          each option in options key=option.id
            when option.icon == "section" or option.icon == "section-rule"
              when option.icon == "section-rule"
                box height=1 margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color=pal.cardBorder role="separator"
              text option.label padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.25rem" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.muted
            else
              button id=`${testId}-${option.id}` press=choose(option.value) popovertarget=menuId popovertargetaction="hide" hover=hover(option.id, `${testId}-${option.id}`) focus=focused(option.id, true) blur=focused(option.id, false) role="menuitemradio" aria-checked=option.selected class=SettingsGhost justify-content="flex-start" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.375rem" background-color=(option.selected or lit == option.id ? pal.highlight : "#00000000") testId=`${testId}-${option.id}`
                column flex=1 min-width=0 gap="0.125rem" align-items="flex-start"
                  row gap="0.375rem" align-items="center"
                    text option.label font-size="0.875rem" line-height="1.25rem" color=pal.text white-space="nowrap"
                    when option.icon == "default"
                      text "Default" padding-left="0.25rem" padding-right="0.25rem" border-radius="0.25rem" border-width=1 border-style="solid" border-color=pal.input font-size="0.625rem" font-weight=500 line-height="0.875rem" color=pal.text
                  when option.detail != ""
                    text option.detail font-size="0.75rem" line-height="1rem" white-space="nowrap" color=pal.muted

// DraftInput / NumberField: edits stay local until Enter or the field is left.
component CoreField
  props
    value: string
    rowId: string
    width: number
    placeholder: string
    numeric: bool
    label: string
    pal: CorePalette
    disabled: bool
    commit: action
  state draft = value
  action edit(next: string)
    draft = next
  view
    input value=draft input=edit change=commit placeholder=placeholder aria-label=label disabled=disabled inputmode=(numeric ? "numeric" : "text") spellcheck="false" width=`${width / 16}rem` height="1.75rem" box-sizing="border-box" padding-left="0.5625rem" padding-right="0.5625rem" padding-top="0.1875rem" padding-bottom="0.1875rem" line-height="1.25rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field font-size="0.875rem" color=pal.text box-shadow="0 1px 2px #0000000d" id=`setting-${rowId}` testId=`setting-${rowId}`

// The .settings-slider track is drawn here (NSSlider ignores accent-color): a 6-point rounded
// track in muted 22% with a 55% border ring, the primary fill to the thumb's centre
// (progress · (width − 16) + 8) and a 16-point thumb ringed in primary. The NSSlider stays
// on top, transparent, for the pointer and keys; `input` moves the drawing while it drags
// and `change` snaps to the setting's increment and commits on release.
fn sliderSnap(value: number, low: number, high: number, step: number): number = max(low, min(high, low + floor((value - low) / step + 0.5) * step))
component CoreSlider
  inject
    rem: number
  props
    row: CoreRow
    pal: CorePalette
    disabled: bool
    commit: action
  state live = 0
  state liveFrom = ""
  action track(value: number)
    live = value
    liveFrom = row.value
  action release(value: number)
    let snapped = sliderSnap(value, row.min, row.max, row.step)
    live = snapped
    liveFrom = row.value
    commit(snapped)
  action navigate(key: string)
    if not disabled
      if key == "ArrowRight" or key == "ArrowUp" or key == "ArrowLeft" or key == "ArrowDown" or key == "Home" or key == "End" or key == "PageUp" or key == "PageDown"
        release(key == "Home" ? row.min : key == "End" ? row.max : shown + (key == "ArrowLeft" or key == "ArrowDown" or key == "PageDown" ? -1 : 1) * row.step * (key == "PageUp" or key == "PageDown" ? 10 : 1))
        preventDefault()
  derive shown = liveFrom != "" and liveFrom == row.value ? live : row.amount
  derive label = sliderSnap(shown, row.min, row.max, row.step)
  derive trackWidth = (row.width - 12 - (row.suffix == " ms" ? 64 : 48)) * rem / 16
  derive ratio = row.max > row.min ? max(0, min(1, (shown - row.min) / (row.max - row.min))) : 0
  view
    row width=`${row.width / 16}rem` gap="0.75rem" align-items="center"
      text `${label}${row.suffix}` font-family="ui-monospace" font-size="0.75rem" font-weight=500 line-height="1rem" color=pal.text font-variant-numeric="tabular-nums" text-align="center" min-width=(row.suffix == " ms" ? "4rem" : "3rem") padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.375rem" background-color=pal.output box-sizing="border-box" role="status" testId=`setting-${row.id}-value`
      box position="relative" width=trackWidth height="1.5rem" flex-shrink=0 opacity=(disabled ? 0.64 : 1)
        box position="absolute" left=0 top="0.5625rem" width=trackWidth height="0.375rem" border-radius="0.1875rem" background-color="light-dark(#71717b38, #81818138)"
        box position="absolute" left=0 top="0.5625rem" width=(ratio * (trackWidth - rem) + 0.5 * rem) height="0.375rem" border-radius="0.1875rem" background-color=pal.accent testId=`setting-${row.id}-fill`
        box position="absolute" left=0 top="0.5625rem" width=trackWidth height="0.375rem" border-radius="0.1875rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e78c, #ffffff0d)" box-sizing="border-box"
        box position="absolute" left=(ratio * (trackWidth - rem)) top="0.25rem" width="1rem" height="1rem" border-radius="0.5rem" border-width=2 border-style="solid" border-color=pal.accent background-color=pal.canvas box-sizing="border-box" box-shadow="0 1px 2px #0000001f"
        input type="range" min=row.min max=row.max step="any" value=`${shown}` input=track change=release key=navigate disabled=disabled aria-label=row.title position="absolute" left=0 top=0 width=trackWidth height="1.5rem" margin=0 opacity=0 id=`setting-${row.id}` testId=`setting-${row.id}`

// TerminalFontPreview: the dev-server transcript, kept to its last lines as the terminal is.
component FontTerminalPreview
  props
    family: string
    size: number
    pal: CorePalette
  view
    column width="100%" height="13rem" margin-top="0.25rem" margin-bottom="0.5rem" overflow="hidden" justify-content="flex-end" padding-top=1 padding-bottom=1 padding-left="0.25rem" padding-right="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.cardBorder background-color=pal.canvas box-sizing="border-box" font-family=(family == "system-ui" ? "system-ui" : family == "ui-sans-serif" ? "ui-sans-serif" : family == "sans-serif" ? "sans-serif" : family == "ui-serif" ? "ui-serif" : family == "serif" ? "serif" : family == "ui-monospace" ? "ui-monospace" : family == "monospace" ? "monospace" : "ui-rounded") aria-label="Terminal font preview" testId="terminal-font-preview"
      column width="100%" height=(floor(204 / (size * 1.38)) * size * 1.38) flex-shrink=0 overflow="hidden" justify-content="flex-end"
        TermPrompt(tail="vpr dev", size=size, pal=pal)
        TermLine(a="", b="", c="", d="", size=size, pal=pal)
        TermLine(a="  VITE", b=" v7.1.1", c="  ready in", d=" 1.24s", size=size, pal=pal)
        TermLine(a="", b="", c="", d="", size=size, pal=pal)
        TermLink(label="  Local:    ", url="http://127.0.0.1:5173/", size=size, pal=pal)
        TermLink(label="  Network:  ", url="http://192.168.1.24:5173/", size=size, pal=pal)
        TermLine(a="", b="", c="", d="", size=size, pal=pal)
        row height=(size * 1.38) flex-shrink=0 align-items="center"
          text "  ✓ 85 passed   " font-size=size white-space="pre" color="#b5bd68"
          text "△ 2 warnings   " font-size=size white-space="pre" color="#f0c674"
          text "✗ 0 failed" font-size=size white-space="pre" color="#cc6666"
        TermLine(a="", b="", c="", d="", size=size, pal=pal)
        row height=(size * 1.38) flex-shrink=0 align-items="center"
          text "  " font-size=size white-space="pre"
          text " READY " font-size=size white-space="pre" color="#1d1f21" background-color="#b5bd68"
          text " watching for changes — press " font-size=size white-space="pre" color=pal.muted
          text "q" font-size=size font-weight=700 color=pal.text
          text " to quit" font-size=size white-space="pre" color=pal.muted
        TermLine(a="", b="", c="", d="", size=size, pal=pal)
        TermPrompt(tail="", size=size, pal=pal)
component TermLine
  props
    a: string
    b: string
    c: string
    d: string
    size: number
    pal: CorePalette
  view
    row height=(size * 1.38) flex-shrink=0 align-items="center"
      text a font-size=size font-weight=700 white-space="pre" color="#b5bd68"
      text b font-size=size white-space="pre" color="#b5bd68"
      text c font-size=size white-space="pre" color=pal.muted
      text d font-size=size font-weight=700 white-space="pre" color=pal.text
component TermLink
  props
    label: string
    url: string
    size: number
    pal: CorePalette
  view
    row height=(size * 1.38) flex-shrink=0 align-items="center"
      text "  →" font-size=size white-space="pre" color="#b5bd68"
      text label font-size=size white-space="pre" color=pal.muted
      text url font-size=size white-space="pre" color="#8abeb7" text-decoration-line="underline"
component TermPrompt
  props
    tail: string
    size: number
    pal: CorePalette
  view
    row height=(size * 1.38) flex-shrink=0 align-items="center"
      text "→ " font-size=size font-weight=700 white-space="pre" color="#b5bd68"
      text "t3code " font-size=size font-weight=700 white-space="pre" color="#8abeb7"
      text "git:(" font-size=size font-weight=700 color="#81a2be"
      text "main" font-size=size font-weight=700 color="#cc6666"
      text ") " font-size=size font-weight=700 white-space="pre" color="#81a2be"
      text "✗ " font-size=size font-weight=700 white-space="pre" color="#f0c674"
      when tail != ""
        text tail font-size=size white-space="pre" color=pal.text
      else
        box width=(size * 0.6) height=(size * 1.25) border-width=1 border-style="solid" border-color=pal.text box-sizing="border-box"

// PanelAnimationsPreview: replays the side panels opening and closing at the chosen duration.
component PanelPreview
  props
    duration: number
    pal: CorePalette
  state open = true
  action replay
    open = not open
  view
    button press=replay aria-label="Replay panel animation preview" class=SettingsGhost justify-content="flex-start" align-items="stretch" width="7rem" height="2.5rem" padding="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.cardBorder background-color=pal.canvas overflow="hidden" box-shadow="0 1px 2px #0000000d" testId="panel-animation-preview" title=""
      box height="100%" width=(open ? "1rem" : "0px") border-radius="0.375rem" background-color=pal.sidebar flex-shrink=0 transition=`width ${duration}ms ease-out`
      column flex=1 min-width=0 padding-left="0.25rem" padding-right="0.25rem"
        column flex=1 gap="0.25rem" padding-top="0.25rem"
          box height=2 width="100%" border-radius=1 background-color=pal.line
          box height=2 width="80%" border-radius=1 background-color=pal.line opacity=0.8
          box height=2 width="60%" border-radius=1 background-color=pal.line opacity=0.6
        row height=(open ? "0.5rem" : "0px") align-items="center" padding-left="0.5rem" padding-right="0.5rem" border-top-width=(open ? 1 : 0) border-top-style="solid" border-color=pal.cardBorder background-color=pal.highlight overflow="hidden" transition=`height ${duration}ms ease-out`
          box height=1 width="66%" background-color=pal.line
      box height="100%" width=(open ? "1.25rem" : "0px") border-radius="0.375rem" background-color=pal.output flex-shrink=0 transition=`width ${duration}ms ease-out`
