# The embedded server runtime that stage-runtime.mjs puts beside its pin (the
# release archive and its manifest), and its download cache. Only the pin is committed.
/server-runtime/*
!/server-runtime/runtime-pin.json
/.runtime-cache/
# Declarations the dev producer writes beside app.ts.
/app.contract.d.ts
# The terminal page, built by terminal-host/build.mjs.
/assets/terminal-host.html
/assets/terminal-host.js
/assets/terminal-ghostty-vt.wasm
/assets/terminal-ghostty-write-pty.wasm
/assets/terminal-symbols-nerd-font-mono.woff2
# Task records, evidence and diaries: local state, never committed (docs/diary.md).
/.exact/
# Generated sources (tools/generate/generate.mjs writes them; the app build runs it): built, not
# committed (rules/RULES.md).
/r12-render-grammar.ts
/r12-render-grammar-*.ts
/r7-polish-css-words.ts
/settings-b-lucide.ts
/pages-icons.contract
/timeline-files.contract
/timeline-files-tables.ts
/shell-morph.contract
/assets/composer-icons.json
/macos/pierre-icons.tsv
/macos/tests/terminal/vectors.json
# The app's own Cargo workspace builds here (Cargo.toml).
/target/
