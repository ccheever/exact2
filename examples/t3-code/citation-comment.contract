// An assistant citation's comment, measured against T3 Code 1e2ecbd975 (MIT, see LICENSE-T3):
// AssistantCitationChip.tsx's PopoverPopup (aria-label "Edit citation comment", width "md": w-80 capped at the viewport less
// 2rem, padding "compact": py-2 px-3, dropdown-glass drawn opaque as there is no backdrop blur here) placed `align="end"`
// under the cited text after Cite (`side="bottom"`) or above its chip's comment button (`side="top"`), 4 pt off its anchor,
// and AssistantCitationCommentEditor.tsx: the textarea "Comment on selected text" (field-sizing content, 64 to 160 pt,
// px-1 py-1.5, 14/20, transparent, "Add an optional comment..."), past 8,000 characters the status line "Comments can
// contain up to 8,000 characters." (pt-1, text-xs, destructive) and "Shorten comment", then Cancel (outline xs) and Save
// (default xs) at the end, mt-2 gap-2; both keep the focus in the textarea (`onPointerDown preventDefault`). Enter saves,
// Command/Ctrl+Enter saves and sends, Shift+Enter breaks the line (the textarea's own), Escape cancels. Base UI's
// collision avoidance as composer-chip-popover.contract's: the side flips when the window leaves no room, and the popup
// stays 5 pt inside it. The window keeps the draft (app-window.contract `citeDraft`), so an outside press, or the focus
// leaving the textarea (a press in the composer's text: Base UI's focus-out), can settle it.
use ChipPopover from "./composer-chip-popover.contract"

// The popup's height for the flip: its border, py-2, the textarea at its 64 pt, mt-2 and the 24 pt buttons, and the
// limit's 20 pt line past 8,000 characters (114 pt in the reference's popup with an empty comment).
fn citationPopoverHeight(tooLong: bool): number = 114 + (tooLong ? 20 : 0)

// `align="end"`: the popup's right edge on the anchor's, within the window less 5 pt.
fn citationPopoverLeft(chip: ChipPopover, width: number, viewportWidth: number): number = max(5, min(viewportWidth - width - 5, chip.ax + chip.aw - width))

// Below the anchor: after Cite while the room under the cited text holds it (or there is more room there than above);
// above the chip's button unless the room above is short and there is more below.
fn citationPopoverBelow(chip: ChipPopover, height: number, viewportHeight: number): bool = chip.anchor == "source" ? (chip.ay + chip.ah + 4 + height <= viewportHeight - 5 or viewportHeight - chip.ay - chip.ah >= chip.ay) : (chip.ay - 4 - height < 5 and viewportHeight - chip.ay - chip.ah > chip.ay)

component CitationCommentLayer
  inject
    rem: number
  props
    chip: ChipPopover
    draft: string
    viewportWidth: number
    viewportHeight: number
    // The textarea's input; Save (true: and send); Cancel and Escape; the focus leaving the textarea (Base UI's focus-out).
    edit: action
    save: action
    cancel: action
    settle: action
  derive width = min(20 * rem, viewportWidth - 2 * rem)
  derive tooLong = draft.length > 8000
  derive below = citationPopoverBelow(chip, citationPopoverHeight(tooLong), viewportHeight)
  action keys(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      cancel()
    else if k == "Enter" and not e.shiftKey
      preventDefault()
      if not tooLong
        save(e.metaKey or e.ctrlKey)
  view
    column id="chip-popover" position="absolute" left=citationPopoverLeft(chip, width, viewportWidth) top=(below ? chip.ay + chip.ah + 4 : "auto") bottom=(below ? "auto" : viewportHeight - chip.ay + 4) width=width padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 16px 40px -18px #0000008c" z-index=130 role="dialog" aria-label="Edit citation comment" testId="citation-comment"
      // The reference's `field-sizing-content min-h-16 max-h-40` textarea, straight in the popover: since main #496
      // a column's automatic height takes it clamped by its max-height, so an 8,000-character comment keeps the
      // popover at the reference's 114 to 230 pt and scrolls inside the textarea.
      textarea id="citation-comment-text" value=draft input=edit key=keys blur=settle autofocus=true rows=2 placeholder="Add an optional comment..." aria-label="Comment on selected text" aria-description="Enter to save the citation comment; Command/Ctrl+Enter to save and send; Shift+Enter for a new line." aria-invalid=tooLong field-sizing="content" outline="none" width="100%" min-height="4rem" max-height="10rem" padding-left="0.25rem" padding-right="0.25rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" testId="citation-comment-text"
        // AssistantCitationCommentEditor's placeholder:text-muted-foreground.
        ::placeholder
          color="light-dark(#71717b, #818181)"
      if tooLong
        text "Comments can contain up to 8,000 characters." role="status" padding-top="0.25rem" font-size="0.75rem" line-height="1rem" color="light-dark(#e7000b, #ff6467)" testId="citation-comment-limit"
      row margin-top="0.5rem" align-items="center" justify-content="flex-end" gap="0.5rem"
        CitationCommentButton(label="Cancel", primary=false, enabled=true, choose=cancel, testId="citation-comment-cancel")
        CitationCommentButton(label=(tooLong ? "Shorten comment" : "Save"), primary=true, enabled=(not tooLong), choose=save(false), testId="citation-comment-save")

// Button size "xs" (h-6, px 7, rounded-lg, text-xs medium): "outline" (a 1 pt border, the background's white, a 1 pt
// shadow) and "default" (the primary, an inset highlight and its 24% shadow); disabled at 64%.
component CitationCommentButton
  props
    label: string
    primary: bool
    enabled: bool
    choose: action
    testId: string
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    button press=choose hover=hover retainFocus=true disabled=(not enabled) testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(primary ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") opacity=(enabled ? 1 : 0.64) background-color=(primary ? (hovering and enabled ? "light-dark(#1d4ed8, #3b76f6)" : "light-dark(#1b4ed8, #346bf1)") : hovering ? "light-dark(#f4f4f5, #ffffff0f)" : "light-dark(#ffffff, #ffffff07)") box-shadow=(primary ? "inset 0 1px 0 #ffffff29, 0 1px 2px #1b4ed83d" : "0 1px 2px #0000000d") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      text label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(primary ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")
