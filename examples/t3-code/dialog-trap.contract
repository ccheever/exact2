// Base UI's modal focus trap (reference ui/dialog.tsx and ui/alert-dialog.tsx): guards before and after
// the popup's controls wrap to the last and first enabled stop. Candidates are in traversal order;
// their declared data-focus-stop marks track the same disabled expression as the control.
//
// Main's modal `dialog` (`showModal(id)`, `close(id)`; issues/closed/20261009-gui-dialog-action-commands.md)
// does not draw or key these as the reference does on macOS. There a `dialog` is an AppKit sheet, a window of its
// own that AppKit centres on the window and dims it under (LLP 1115.002 D7.2, host/apple SheetsMac.swift), and an
// `alertdialog` in the alert's shape is `NSAlert`, with the system's look and button order (LLP 1115.000 D7.6,
// AlertsMac.swift); a dialog painted in the page is only the driver's own chrome (`--chrome agent`). Base UI's popup
// is in the page over a blurred backdrop. In the sheet Tab stops only at fields while Keyboard Navigation is off,
// where Base UI's trap stops at every button, and a dialog opened by a click gives the focus back to nothing, as a
// Mac button takes no focus from a click. A `dialog` also opens only from an action, not while state holds it open
// (`contract vocab dialog`), and several of these open from the data module's state (settings-a-dialogs.contract's
// confirmations). So the dialogs stay boxes with this trap.
shape DialogFocusReturn
  owner: string
  target: string
  popup: string
  invoker: string
shape DialogFocusFrame
  owner: string
  returns: DialogFocusReturn[]
fn dialogReturn(owner: string, target: string, popup: string, invoker: string): DialogFocusReturn = DialogFocusReturn(owner=owner, target=target, popup=popup, invoker=invoker)
fn dialogFrame(owner: string, returns: DialogFocusReturn[]): DialogFocusFrame = DialogFocusFrame(owner=owner, returns=returns)
fn dialogLineage(frames: DialogFocusFrame[], owner: string): DialogFocusReturn[] = match frames.filter(item => item.owner == owner).at(0) { case some(item) => item.returns, case none => [] }


component FocusGuard
  props
    guardId: string
    targets: string[]
    popup: string
  derive start = guardId.includes("-guard-start")
  action enter
    stopPropagation()
    let mounted = querySelectorAll("[data-focus-stop~=\"enabled\"]")
    let available = targets.filter(id => mounted.includes(id))
    let target = (start ? available.slice(-1) : available.slice(0, 1)).join("")
    if querySelectorAll("[data-dialog-focus~=\"open\"]").includes(popup)
      focus(target == "" ? popup : target)
  // All-disabled dialogs focus their popup. Both directions retry eligible controls when busy ends.
  action hold(k: string, e: KeyboardEvent)
    if k == "Tab" and not e.metaKey and not e.ctrlKey and not e.altKey
      preventDefault()
      stopPropagation()
      let mounted = querySelectorAll("[data-focus-stop~=\"enabled\"]")
      let available = targets.filter(id => mounted.includes(id))
      let target = (e.shiftKey ? available.slice(-1) : available.slice(0, 1)).join("")
      focus(target == "" ? popup : target)
  view
    box id=guardId tabindex=0 aria-hidden=true focusin=enter key=hold position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" testId=guardId

// Base UI's Dialog moves the focus into the popup as it opens (FloatingFocusManager's `initialFocus`: the popup's first
// Tab stop, unless the dialog names another or an element inside took the focus with `autoFocus` as it mounted), whether
// a pointer or a key opened it, so the first Tab and Shift+Tab already start inside the trap. An `autofocus` takes the
// focus only when nothing holds it (HTML's rule): a dialog with none opens with nothing focused, where a real Tab reaches
// no stop at all, and one opened from a key leaves the focus on its opener behind the
// popup. Each modal dialog carries one DialogOpenFocus naming that element (`dialog-trap.test.ts` lists them): it moves
// the focus there once, when the popup is first laid out (this box's first `resize` event, ResizeObserver's first entry:
// the layout that drew the popup, as Base UI focuses from a layout effect). A popup hidden under `display: none` lays it
// out 0 by 0, which is no opening; it opens again when it shows.
component DialogOpenFocus
  props
    target: string
  state opened = false
  action laidOut(width: number, height: number)
    if width == 0 or height == 0
      opened = false
    else if not opened
      opened = true
      if target != ""
        focus(target)
  view
    box aria-hidden=true resize=laidOut position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none"

// A field that opens with its text selected (PullRequestThreadDialog's open effect, `requestAnimationFrame(() => { focus();
// select(); })`; RightPanelTabs' rename input, `focus(); select()` as it mounts): DialogOpenFocus's first layout, which
// then selects the field's whole text with `setSelectionRange` (main 48755525c), so the first key typed replaces it.
// `length` is the text's length as it opened. It stands where a dialog's DialogOpenFocus would (dialog-trap.test.ts).
component FieldOpenSelect
  props
    target: string
    length: number
  state opened = false
  action laidOut(width: number, height: number)
    if width == 0 or height == 0
      opened = false
    else if not opened
      opened = true
      focus(target)
      setSelectionRange(target, 0, length)
  view
    box aria-hidden=true resize=laidOut position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none"

// This observer stands outside the conditional popup. The window snapshots the actual prior focus on
// opening or first focusin, whichever arrives first, and restores it after the closing layout. Holding
// the owner here handles a subject reset on close; the window retains ancestry for nested/replaced dialogs.
component DialogFinalFocus
  inject
    dialogOpened: action
    dialogClosed: action
  props
    open: bool
    owner: string
  state shown = false
  state heldOwner = ""
  action laidOut(width: number, height: number)
    if width >= 2 and not shown
      shown = true
      heldOwner = owner
      dialogOpened(owner)
    else if width == 1 and shown
      shown = false
      dialogClosed(heldOwner)
  view
    box aria-hidden=true resize=laidOut position="absolute" left=0 top=0 width=(open ? 2 : 1) height=1 opacity=0 pointer-events="none"
