// Base UI's focus trap, as its FloatingFocusManager builds one for every modal Dialog and AlertDialog (T3 Code
// 1e2ecbd975, ui/dialog.tsx and ui/alert-dialog.tsx over @base-ui/react): an invisible, `aria-hidden` Tab stop just
// inside the popup before its content, and one after it (the X, DialogPopup's last child, included). Tab past the last
// stop lands on the guard after it, which sends the focus to the first stop; Shift+Tab before the first lands on the
// guard before it, which sends it to the last. Exact keeps no Tab inside an `aria-modal` box on macOS (EXACT2-GAPS.md
// X53, #282), so each dialog carries its own pair and names its first and last Tab stops for the screen it shows (a
// disabled control is no stop). `dialog-trap.test.ts` lists every dialog and its pair; a pair's ids end in
// `-guard-start` and `-guard-end`.
component FocusGuard
  props
    guardId: string
    target: string
  derive start = includes(guardId, "-guard-start")
  action enter
    if target != ""
      focus(target)
  // A guard keeps the focus only when its target cannot take it: disabled or not drawn while the dialog is busy, or
  // none named. Base UI then holds the focus in the popup, so the key that would leave the dialog from here (Shift+Tab
  // at the start guard, Tab at the end guard) tries the target again and otherwise leaves the focus on the guard;
  // the other way, the key goes on into the dialog.
  action hold(k: string, e: KeyboardEvent)
    if k == "Tab" and e.shiftKey == start
      preventDefault()
      stopPropagation()
      if target != ""
        focus(target)
  view
    box id=guardId tabindex=0 aria-hidden=true focus=enter key=hold position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none" testId=guardId

// Base UI's Dialog moves the focus into the popup as it opens (FloatingFocusManager's `initialFocus`: the popup's first
// Tab stop, unless the dialog names another or an element inside took the focus with `autoFocus` as it mounted), whether
// a pointer or a key opened it, so the first Tab and Shift+Tab already start inside the trap. An `autofocus` takes the
// focus only when nothing holds it (HTML's rule): a dialog with none opens with nothing focused, where a real Tab reaches
// no stop at all (realinput-1011a DT-5, DT-6, DT-8), and one opened from a key leaves the focus on its opener behind the
// popup. Each modal dialog carries one DialogOpenFocus naming that element (`dialog-trap.test.ts` lists them): it moves
// the focus there once, when the popup is first laid out (this box's first `resize` event, ResizeObserver's first entry:
// the layout that drew the popup, as Base UI focuses from a layout effect). A popup hidden under `display: none` lays it
// out 0 by 0, which is no opening; it opens again when it shows.
component DialogOpenFocus
  props
    target: string
  state opened = false
  action laidOut(width: number, height: number)
    if width == 0 or height == 0
      opened = false
    else if not opened
      opened = true
      if target != ""
        focus(target)
  view
    box aria-hidden=true resize=laidOut position="absolute" left=0 top=0 width=1 height=1 opacity=0 pointer-events="none"
