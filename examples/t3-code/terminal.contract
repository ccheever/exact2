use Look from "./settings-appearance-look.contract"
// The terminal surface spike's development harness (task 20261005-terminal-surface): a
// `t3-terminal` view (T3TerminalView.swift: T3 Code's Ghostty surface in a web view) fed by the
// native fixtures, so the agent and a person can check rendering, keys and the bridge without a
// server session. ⌃⌥⇧T (or the 1-point button near the window's bottom edge, away from the
// rounded corners, which take no click) opens and closes it. The drawer task replaces it with ThreadTerminalDrawer.
component TerminalHarness
  props
    dark: bool
    look: Look
  state open = false
  state fixture = "render"
  state lastMessage = ""
  state messages = 0
  state focused = false
  action toggle
    open = not open
  action pick(name: string)
    fixture = name
  action heard(message: string)
    lastMessage = message
    messages = messages + 1
  action focusIn
    focused = true
  action focusOut
    focused = false
  view
    button press=toggle aria-label="Terminal harness" aria-keyshortcuts="Control+Alt+Shift+T" testId="terminal-harness-toggle" position="absolute" left=240 bottom=6 z-index=70 width=1 height=1 padding=0 border-width=0 background-color="#00000000" opacity=0
    when open
      column position="absolute" left=0 right=0 bottom=0 height=340 z-index=70 background-color="light-dark(#ffffff, #0e1218)" border-top-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #252525)" testId="terminal-harness"
        row align-items="center" gap=8 height=32 padding-left=12 padding-right=8 flex-shrink=0
          text "Terminal harness (development)" font-size=12 font-weight=600 color="light-dark(#1c2129, #edf1f7)" flex=1 min-width=0
          each name in ["render", "loopback", "flood"] key=name
            button press=pick(name) aria-pressed=(fixture == name) testId=`terminal-harness-${name}` height=24 padding-left=8 padding-right=8 border-radius=6 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff1a)" background-color=(fixture == name ? "light-dark(#f4f4f5, #ffffff14)" : "#00000000")
              text name font-size=12 color="light-dark(#1c2129, #edf1f7)"
          button press=toggle aria-label="Close terminal harness" testId="terminal-harness-close" height=24 padding-left=8 padding-right=8 border-radius=6 border-width=0 background-color="#00000000"
            text "×" font-size=16 color="light-dark(#1c2129, #edf1f7)"
        t3-terminal terminal="harness" fixture=fixture scheme=(dark ? "dark" : "light") terminal-theme=(dark ? look.terminalDark : look.terminalLight) terminal-font=look.terminalFont terminal-font-size=look.terminalSize chords="Meta+K Meta+J Control+Alt+Shift+T" message=heard focus=focusIn blur=focusOut aria-label="Terminal" testId="terminal-harness-view" flex=1 min-height=0
        row align-items="center" height=22 padding-left=12 padding-right=12 flex-shrink=0
          text `${focused ? "focused" : "unfocused"} · ${messages} messages · ${lastMessage}` font-size=11 color="light-dark(#71717a, #9ca3af)" testId="terminal-harness-status" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" flex=1 min-width=0
