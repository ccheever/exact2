use Look from "./settings-appearance-look.contract"
use ShellIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
// The thread terminal drawer (task terminal-drawer): T3 Code 1e2ecbd975's ThreadTerminalDrawer in its
// drawer mode (MIT reference, see LICENSE-T3: apps/web/src/components/ThreadTerminalDrawer.tsx), below
// the chat column so the composer stays above it. The toolbar opens, splits and closes sessions;
// the empty state offers New Terminal. The `t3-terminal` view (T3TerminalView.swift) shows the server session named by
// its props; the session itself is native (T3TerminalSessions.swift), the drawer's state is the client's
// (terminal-drawer-view.ts, saved per thread).

// terminal-drawer-view.ts TerminalDrawerView: the active thread's drawer.
shape TerminalDrawerView
  available: bool // an active server thread with a project (PanelLayoutControls terminalAvailable)
  open: bool
  threadKey: string // `${environmentId}:${threadId}`
  environmentId: string
  threadId: string
  terminalId: string // the active terminal; "" shows the empty state
  label: string
  cwd: string
  worktree: string
  env: string // JSON: T3CODE_PROJECT_ROOT, T3CODE_WORKTREE_PATH
  height: number // clamped: 180 to floor(75% of the window), 280 by default
  focusRequest: number
  closeTitle: string // `Close terminal "Terminal 1"?`
  closeBody: string
  closeLabel: string
  newLabel: string
  toggleLabel: string
  sessionKey: string // JSON.stringify([environmentId, threadId, terminalId]): one view per session
  mounted: number // mounted threads (reconcileMountedTerminalThreadIds)
  metadata: string
  failure: string
  commandPrefix: string
  surface: string
  keybindings: string
  panes: list<TerminalPaneView>
  tabs: list<TerminalTabView>
  direction: string
  showTabs: bool
  splitDisabled: bool
  splitLabel: string
  splitVerticalLabel: string
shape TerminalPaneView
  terminalId: string
  label: string
  sessionKey: string
  active: bool
  focusRequest: number
  target: string
shape TerminalTabView
  id: string
  label: string
  heading: string // the group header on the group's first row ("" for the other rows)
  groupIcon: string // square, split-vertical, split-horizontal
  groupActive: bool
  groupTarget: string // the group's active terminal, else its first
  count: number
  active: bool
  target: string
  closeLabel: string // `Close Terminal 1 (⌘W)` on the active row
  closeTitle: string
  closeBody: string

// The drawer: `border-t border-border/80 bg-background`, a 6 pt `cursor-row-resize` separator on its top
// edge (a `pan` gives deltas; the height commits at release and refits the grid), the toolbar 8 pt from the
// right and top (`right-2 top-2`, the pinned source; 13 pt icons, `p-1`, `border border-border/80`,
// `shadow-xs`, tooltips below with a 6 pt offset) and the terminal. Height and opening animate only when the
// panel animation setting is above zero and motion is not reduced; a thread switch is a new drawer (no motion).
component TerminalDrawer
  props
    view: TerminalDrawerView
    look: Look
    dark: bool
    viewportHeight: number
    reduced: bool
    closePending: bool
    command: action // the root command(op, id, value, n)
    confirm: action // titleMenuPick(op, target, value, askTitle, askBody, destructive): the app's confirm dialog
  state dragKey = ""
  state dragHeight = 0
  state dragging = false
  state hovered = ""
  derive maxHeight = max(180, floor(viewportHeight * 0.75))
  derive height = min(max(floor((dragKey == view.threadKey and dragHeight > 0 ? dragHeight : view.height) + 0.5), 180), maxHeight)
  derive motion = look.panelMs > 0 and not reduced and not dragging
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  // handleResizePointerMove: the height follows the pointer, clamped at every step.
  action resize(dx: number, dy: number)
    let current = height
    dragging = true
    dragKey = view.threadKey
    dragHeight = min(max(current - dy, 180), maxHeight)
  // handleResizePointerEnd → syncHeight: the store keeps the clamped height (saved per thread).
  action release(vx: number, vy: number)
    let committed = height
    dragging = false
    command("terminallocal:height", view.threadKey, `${committed}`, 0)
  // onSessionExited: the view printed "[terminal] Process exited"; the tab closes without a confirmation.
  action exited(message: string)
    command("terminallocal:exited", view.threadKey, message, 0)
  view
    each key in (view.available ? [view.threadKey] : []) key=key
      column flex-shrink=0 box-sizing="border-box" interpolate-size="allow-keywords" height=(view.open ? height : 0) min-height=0 min-width=0 overflow="hidden" transition=(motion ? `height ${look.panelMs}ms ease-out` : "none") testId="terminal-drawer" aria-label="Terminal drawer"
        // The clipping parent animates; the terminal keeps its full grid through opening and closing.
        column height=height flex-shrink=0 min-width=0 position="relative" box-sizing="border-box" border-width=0 border-top-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffffcc)" background-color="light-dark(#fcfcfc, #0a0a0a)" inert=(not view.open) testId="terminal-drawer-inner"
          box position="absolute" left=0 right=0 top=0 height=6 z-index=20 cursor="row-resize" touch-action="none" pan=resize panrelease=release role="separator" aria-orientation="horizontal" aria-label="Resize terminal drawer" testId="terminal-drawer-resize"
          TerminalContent(view=view, look=look, dark=dark, closePending=closePending, command=command, confirm=confirm)

// ThreadTerminalDrawer's shared content, used by the bottom drawer and right-panel surfaces.
component TerminalContent
  props
    view: TerminalDrawerView
    look: Look
    dark: bool
    closePending: bool
    command: action
    confirm: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action message(target: string, value: string)
    command(`${view.commandPrefix}:message`, target, value, 0)
  action focused(target: string, active: bool)
    command(`${view.commandPrefix}:${active ? "focus-in" : "focus-out"}`, target, view.surface, 0)
  view
    row flex=1 min-width=0 min-height=0 overflow="hidden" position="relative" testId=(view.surface == "drawer" ? "terminal-drawer-content" : "terminal-panel-content")
      when length(view.panes) == 0
        column flex=1 min-height=0 align-items="center" justify-content="center" gap=12 padding-left=16 padding-right=16 padding-top=24 padding-bottom=24 testId="terminal-drawer-empty"
          text "No terminal sessions for this thread yet." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)" text-align="center"
          button press=command(`${view.commandPrefix}:new`, view.threadKey, "", 0) aria-label=view.newLabel testId="terminal-drawer-new" height=24 padding-left=8 padding-right=8 border-radius=6 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff1a)" background-color="light-dark(#ffffff, #ffffff05)"
            text view.newLabel font-size=12 line-height="16px"
      else
        box flex=1 min-height=0 min-width=0 display="flex" flex-direction=view.direction testId="terminal-drawer-surface"
          each pane in view.panes key=pane.sessionKey
            // ThreadTerminalDrawer.tsx:1511-1530: no pane header; a pane activates when it takes focus (focus-in).
            column flex=1 min-width=0 min-height=0 border-width=0 border-right-width=(view.direction == "row" and length(view.panes) > 1 ? 1 : 0) border-bottom-width=(view.direction == "column" and length(view.panes) > 1 ? 1 : 0) border-style="solid" border-color=(pane.active ? "light-dark(#e4e4e7, #ffffff1a)" : "light-dark(#e4e4e7b3, #ffffff12)") testId=`terminal-pane-${pane.terminalId}`
              t3-terminal terminal=pane.terminalId environment=view.environmentId thread=view.threadId cwd=view.cwd worktree=view.worktree env=view.env active=view.open terminal-surface=view.surface focus-request=pane.focusRequest keybindings=view.keybindings close-pending=closePending can-add-to-chat=true terminal-label=pane.label scheme=(dark ? "dark" : "light") terminal-theme=(dark ? look.terminalDark : look.terminalLight) terminal-font=look.terminalFont terminal-font-size=look.terminalSize message=message(pane.target) focus=focused(pane.target, true) blur=focused(pane.target, false) aria-label=pane.label testId=(pane.active and view.surface == "drawer" ? "terminal-view" : `terminal-view-${pane.terminalId}`) flex=1 min-width=0 min-height=0
        when not view.showTabs
          box position="absolute" right=8 top=8 z-index=20
            TerminalToolbar(view=view, command=command, confirm=confirm, strip=false)
        else
          // ThreadTerminalDrawer.tsx:1588-1710: the 144 pt tab list, its 22 pt edge-to-edge toolbar, group headers and rows.
          column width=144 flex-shrink=0 min-height=0 margin-left=6 box-sizing="border-box" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#f4f4f51a, #ffffff03)" testId="terminal-tabs"
            row height=22 flex-shrink=0 box-sizing="border-box" align-items="stretch" justify-content="end" border-width=0 border-bottom-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)"
              TerminalToolbar(view=view, command=command, confirm=confirm, strip=true)
            column flex=1 min-height=0 overflow-y="auto" padding=4 gap=2
              each tab in view.tabs key=tab.id
                when tab.heading != ""
                  button press=command(`${view.commandPrefix}:activate`, tab.groupTarget, "", 0) display="flex" flex-direction="row" align-items="center" gap=4 height=22 padding-left=6 padding-right=6 border-width=0 border-radius=4 background-color=(tab.groupActive ? "light-dark(#f4f4f580, #ffffff0a)" : (hovered == `group-${tab.id}` ? "light-dark(#f4f4f566, #ffffff08)" : "#00000000")) hover=hover(`group-${tab.id}`) aria-label=`${tab.heading}, ${tab.count} terminals` testId=`terminal-group-${tab.id}`
                    svg width=12 height=12 flex-shrink=0 viewBox="0 0 24 24" fill="none" stroke=(tab.groupActive ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
                      path d=(tab.groupIcon == "split-horizontal" ? "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM12 3v18" : (tab.groupIcon == "split-vertical" ? "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2zM3 12h18" : "M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"))
                    text tab.heading flex=1 min-width=0 font-size=10 line-height="14px" color=(tab.groupActive ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") text-overflow="ellipsis" white-space="nowrap"
                    text `${tab.count}` font-size=9 line-height="12px" color="light-dark(#71717bb3, #818181b3)"
                row align-items="center" gap=2 height=24 padding-left=6 padding-right=8 border-radius=6 background-color=(tab.active ? "light-dark(#f4f4f5, #ffffff14)" : (hovered == tab.id ? "light-dark(#f4f4f599, #ffffff0f)" : "#00000000")) hover=hover(tab.id) testId=`terminal-tab-${tab.id}`
                  button press=confirm("ui:confirm", tab.target, `${view.commandPrefix}:close`, tab.closeTitle, tab.closeBody, true) aria-label=tab.closeLabel testId=`terminal-tab-close-${tab.id}` width=16 height=16 flex-shrink=0 padding=2 border-width=0 border-radius=2 background-color="#00000000"
                    ShellIcon(name=(hovered == tab.id ? "x" : "square-terminal"), size=12, color=(tab.active ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))
                  button press=command(`${view.commandPrefix}:activate`, tab.target, "", 0) aria-label=tab.label aria-pressed=tab.active testId=`terminal-tab-select-${tab.id}` flex=1 min-width=0 height=24 padding=0 border-width=0 background-color="#00000000"
                    text tab.label font-size=12 line-height="16px" color=(tab.active or hovered == tab.id ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") text-overflow="ellipsis" white-space="nowrap"

// ThreadTerminalDrawer.tsx:1440-1490 (floating, one divider between each action) and :1590-1630 (strip:
// the tab list's edge-to-edge buttons separated by a left border).
component TerminalToolbar
  props
    view: TerminalDrawerView
    command: action
    confirm: action
    strip: bool
  view
    row align-items=(strip ? "stretch" : "center") align-self=(strip ? "stretch" : "auto") border-radius=(strip ? 0 : 6) border-width=(strip ? 0 : 1) border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffffcc)" background-color=(strip ? "#00000000" : "light-dark(#fcfcfc, #0a0a0a)") box-shadow=(strip ? "none" : "0 1px 2px #0000000d") testId="terminal-drawer-toolbar"
      TerminalAction(icon="split-horizontal", label=view.splitLabel, disabled=view.splitDisabled, id="terminal-split", strip=strip, edge=false, press=command(`${view.commandPrefix}:split`, `${view.threadKey}|${view.terminalId}`, "", 0))
      when not strip
        box width=1 height=16 background-color="light-dark(#e4e4e7, #ffffff1a)"
      TerminalAction(icon="split-vertical", label=view.splitVerticalLabel, disabled=view.splitDisabled, id="terminal-split-vertical", strip=strip, edge=true, press=command(`${view.commandPrefix}:split-vertical`, `${view.threadKey}|${view.terminalId}`, "", 0))
      when not strip
        box width=1 height=16 background-color="light-dark(#e4e4e7, #ffffff1a)"
      TerminalAction(icon="plus", label=view.newLabel, disabled=false, id="terminal-new", strip=strip, edge=true, press=command(`${view.commandPrefix}:new`, view.threadKey, "", 0))
      when not strip
        box width=1 height=16 background-color="light-dark(#e4e4e7, #ffffff1a)"
      TerminalAction(icon="trash", label=view.closeLabel, disabled=false, id="terminal-close", strip=strip, edge=true, press=confirm("ui:confirm", `${view.threadKey}|${view.terminalId}`, `${view.commandPrefix}:close`, view.closeTitle, view.closeBody, true))

component TerminalAction
  props
    icon: string
    label: string
    disabled: bool
    id: string
    strip: bool // in the tab list's toolbar: full height, square, a left border after the first
    edge: bool
    press: action
  state hovered = false
  state clicked = false
  action hover(over: bool)
    hovered = over
  action activate
    clicked = not clicked
    press()
  action blurred
    hovered = false
    clicked = false
  view
    box position="relative" display="flex"
      button press=activate hover=hover focus=hover(true) blur=blurred aria-label=label testId=id padding-top=(strip ? 0 : 4) padding-bottom=(strip ? 0 : 4) padding-left=4 padding-right=4 border-width=0 border-left-width=(strip and edge ? 1 : 0) border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff12)" border-radius=(strip ? 0 : 5) display="flex" align-items="center" justify-content="center" opacity=(disabled ? 0.64 : 1) background-color=(hovered and not disabled ? "light-dark(#f4f4f5, #ffffff14)" : "#00000000")
        when icon == "split-horizontal" or icon == "split-vertical"
          svg width=13 height=13 viewBox="0 0 24 24" fill="none" stroke="light-dark(#27272ae6, #f5f5f5e6)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
            path d=(icon == "split-horizontal" ? "M3 3h18v18H3zM12 3v18" : "M3 3h18v18H3zM3 12h18")
        else
          ShellIcon(name=icon, size=13, color="light-dark(#27272ae6, #f5f5f5e6)")
      TipBubble(label=label, side="bottom", align="end", offset=27, inset=0, shown=(hovered or clicked))
