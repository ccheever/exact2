use assembleWindowInputs from "./src/shell/app-window-inputs.contract"
use ThreadFindView from "./src/timeline/thread-find.contract"
use ServerBrowserFrame from "./src/browser/server-browser.contract"
use PromptLinkView from "./src/prompt-links/prompt-links.contract"
use ThemeUse, ThemeRoleUsage from "./src/appearance/settings-appearance-editor-shapes.contract"
use WorkspaceDiscovery, WorkspaceRefresh, TimelineReadsResult, Time, Page from "./src/shell/app-shapes.contract" // first: the plan orders shapes by first use
use HighlightStep from "./src/highlight/highlight.contract"
use Snapshot, Viewport, Change, LicenseSettings, SnapshotSettings, Settings, Canvas from "./src/shared/shapes.contract"
use PairFields from "./src/connections/pairing-shapes.contract"
use SshPromptView, SshPromptAnswer from "./src/connections/ssh-prompt.contract" // the SSH password dialog (ssh-auth.ts)
use TranscriptMarkdown, MarkdownLabels, MarkdownSource from "./src/timeline/markdown.contract"
use TimelineAttachmentUrls from "./src/timeline/timeline-attachments.contract"
use PagesHome, pageTrailNext from "./src/pages/pages-hero.contract"
use UsageView, UsageKey from "./src/usage/pages-usage.contract"
use PrListView from "./src/pull-requests/pages-prs.contract"
use PrDetailView from "./src/pull-requests/pages-pr-detail.contract"
use WelcomeView from "./src/pages/pages-welcome.contract"
use PaletteView, PaletteResult from "./src/palette/palette.contract"
use ProviderPage from "./src/providers/providers.contract"
use ProviderWizard, AcpRegistry from "./src/providers/providers-wizard.contract"
use ConnectionsPage, SbSshHosts, routeKeyboardSource from "./src/connections/connections.contract"
use routeKeyboardIdle, routeKeyboardLive, routeKeyboardNext, routeKeyboardCancel, routeKeyboardValue, routeKeyboardComplete from "./src/connections/connections-routes.contract"
use KeybindingPage, KeybindingDraft from "./src/settings/settings-keybindings.contract"
use ScheduledPage from "./src/settings/settings-scheduled.contract"
use KeyDispatch from "./src/settings/settings-shortcuts.contract"
use SourceControlPage, IntegrationsPage from "./src/settings/settings-source-control.contract"
use StoragePage from "./src/settings/settings-storage.contract"
use ArchivePage from "./src/settings/settings-archive.contract"
use DiagnosticsPage from "./src/settings/settings-diagnostics.contract"
use CoreNav, SettingsCore from "./src/settings/settings-core.contract"
use AboutDelivery from "./src/settings/settings-a-about.contract"
use ProjectsPage from "./src/settings/settings-projects.contract"
use SbPicker from "./src/settings/settings-b-icons.contract"
use PickerCatalog, PickerTarget, ComposerBranches from "./src/composer/composer-shapes.contract"
use ComposerEditorView from "./src/composer/composer-editor.contract"
use ComposerRichView, ComposerIntentReply, ComposerIntentMetadata, ComposerFieldObservation, ComposerFieldCommand, ComposerFieldResult, ComposerFieldAcknowledgement, composerChipEdge, composerChipInside, composerChipDeletes, composerChipWordDeletes, composerChipStep, composerChipOverlaps from "./src/composer/composer-rich.contract"
use promptPreviewSample from "./src/appearance/settings-prompt-preview.contract"
use ChipPopover, ComposerChipFinish from "./src/composer/composer-chip-popover.contract"
use ShellView, ShellDetails from "./src/shell/shell-shapes.contract"
use T3Window from "./src/shell/app-window.contract" // the window's view; its uses load the view's files here, in this order
use ChatCanvasView from "./src/shell/chat-canvas.contract"
use TerminalDrawerView from "./src/terminal/terminal.contract"
use TransportTable, TransportSlot, TransportUpdateSlot, TransportConnect, TransportUpdateStep, TransportSocket, TransportInbox from "./src/transport/transport.contract"
use legacyTipOwner from "./src/sidebar/legacy-sidebar.contract"
use ShortcutModifierState, emptyShortcutModifierState, areShortcutModifierStatesEqual, shortcutModifierStateAfterKeyboardEvent, anyShortcutModifier, speedModifiers from "./src/shell/shortcut-modifiers.contract"
use heldModifiers from "./src/shared/press-modifiers.contract"
routes promptLinks
  home "/"
  incoming "/open"

use AppDecision, ChatLocalResult, ChatSends, CommandArgs from "./src/shell/app-decisions.contract"
use projectAppChatSends, projectChatLocalSends from "./src/shell/app-decisions.contract"
use initialComposerIntentState, initialComposerFieldProtocol, initialComposerSelectionState from "./src/shell/app-protocols.contract"
use initialPromptPreviewState, initialPaletteSessionState, initialProviderWizardState from "./src/shell/app-protocols.contract"
use initialConfirmationState, initialCitationPlacementState, initialFindPlacementState from "./src/shell/app-protocols.contract"
use initialHoverState, initialWorkspaceRetryState, initialStreamGeometryState from "./src/shell/app-protocols.contract"
use initialModifierOwnershipState, initialSshResponseState, initialNoticeExitState from "./src/shell/app-protocols.contract"
use initialTranscriptViewportState, initialKeybindingEditorState, initialComposerMenuState from "./src/shell/app-protocols.contract"
use UiRootInputs, CitationPlacementState, TranscriptViewportState from "./src/shell/app-protocols.contract"
use SshResponseState, ComposerFieldProtocol from "./src/shell/app-protocols.contract"
use PromptPreviewState, ComposerMenuState, ModifierOwnershipState from "./src/shell/app-protocols.contract"
use decideAnnotationSendNow, decideAutomationRecordingNow, decideChipActRun, decideCiteBegin, decideCodeRevealOpen, decideCommandCompleted from "./src/shell/app-completion.contract"
use decideComposerEditDone, decideComposerFieldAckDone, decideComposerIntentCancelStale, decideComposerIntentConfirmed, decideComposerIntentFormatSettled, decideComposerIntentOwnerChanged from "./src/shell/app-completion.contract"
use decideComposerIntentPump, decideConfirmHanded, decideDiffFindFocusField, decideDispatchTimelineReads, decideFilesAddedDone, decideFindBegin from "./src/shell/app-completion.contract"
use decideFocusSidebarDialog, decideFragmentOpened, decideGuideFinishOpen, decideHighlightStep, decideHighlightStepped, decideHoverTicked from "./src/shell/app-completion.contract"
use decideImportWizardFlip, decideImportWizardStep, decideLiveTick, decideMaintainThreadFindTick, decideModifiersForget, decideNoticeExited from "./src/shell/app-completion.contract"
use decidePaletteDone, decidePrFindFocusField, decidePrSettle, decideProviderTick, decideRemovalFlip, decideReturnTitleFocus from "./src/shell/app-completion.contract"
use decideSaveNow, decideShellGuideOpen, decideShellOpenThread, decideShellTick, decideSshTick, decideStreamMaintain from "./src/shell/app-completion.contract"
use decideTerminalCloseConfirm, decideTerminalCompleted, decideThemeRevealed, decideThreadFindFocusField, decideTransportNetworkChanged, decideTransportPump from "./src/shell/app-completion.contract"
use decideTransportPumpDone, decideWindowReopened, decideWindowReturned, decideWorkspaceRefreshFinished from "./src/shell/app-completion.contract"
use resetPromptPreviewState, recordComposerFieldAdmission from "./src/shell/app-protocols.contract"
use decideCitePlace, decideFindPlace from "./src/shell/app-completion-timeline.contract"
use ComposerDraftState, initialComposerDraftState from "./src/shell/app-protocols.contract"
use SettingsPageState, initialSettingsPageState from "./src/shell/app-protocols.contract"
component T3Code
  action promptLinkNavigate(location: string)
    promptLinks = open(promptLinks, location)
  resource promptLinkPage = promptLinkView(data.revision) as shape PromptLinkView
  resource promptLinksReady = promptLinksReady(data.revision, transportSeen) as shape bool
  task incomingPromptLink when top(promptLinks).name == "incoming" and promptLinksReady and not welcome.show and not commandPending
    after(1, promptLinkReceived)
  action promptLinkReceived
    let value = searchParam(top(promptLinks), "u")
    promptLinks = open(promptLinks, path("home"))
    settingsPageState = SettingsPageState(settingsPageState, open=false)
    utilityPage = ""
    send fragmentChanged = command("shelllocal:prompt-link-open", "", value, 0)
  state themeInspecting = false // Color inspection owns Escape while its floating editor remains open.
  action setThemeInspecting(value: bool)
    themeInspecting = value
  action clearThemeInspecting
    themeInspecting = false
  task themeInspectionEnded when themeInspecting and not settingsCore.editor.open
    after(1, clearThemeInspecting)
  state elapsed = 0
  resource wallTime = exactTime() as shape Time
  resource data = snapshot(wallTime.epochAtZero + elapsed, reconnectGraceKey, disconnectDelayKey, viewport.displayMode, transcriptViewport.owner, transcriptViewport.resting, transcriptViewport.atEnd, transcriptViewport.pulls, transportSeen, composerDraft.typing) as shape Snapshot // full screen drops the traffic lights' inset (presentation.ts); the transcript's viewport (transcript-facts.ts); the connections' news (transport.ts); the typing guard (composer-typing-guard.ts)
  state reconnectGraceKey = ""
  state disconnectDelayKey = ""
  task reconnectGrace when data.serverUpdate.reconnecting != "" key = data.serverUpdate.reconnecting
    after(2000, reconnectGraceElapsed)
  action reconnectGraceElapsed
    reconnectGraceKey = data.serverUpdate.reconnecting
  task disconnectDelay when data.serverUpdate.unavailable != "" key = data.serverUpdate.unavailable
    after(20000, disconnectDelayElapsed)
  action disconnectDelayElapsed
    disconnectDelayKey = data.serverUpdate.unavailable
  // The server connections (src/transport/transport.ts). Each session slot (0: the focused environment, 1 to 8: the
  // background ones) has an answer for the attempts no other answer runs (the ladder's) and its better-route checks,
  // and a socket resource for the URL the tick publishes; each update slot (an outdated host's self-update) has a step and a bare
  // socket. transportInbox resolves the replies whenever any of them, or the tick, has news. An answer sends its own
  // requests (LLP 1016.000 D7, amended 2026-10-18). The tick is a mutation: every 250 ms while a backoff, a stream retry, a
  // debounced activity report or an update is near, every second while connected (deadlines and Pings), and once to
  // publish a changed table (below).
  state transportTable = TransportTable(deliver=0, rev=0, soon=false, live=false, s0=TransportSlot(key="", attempt=0, check=0, url=""), s1=TransportSlot(key="", attempt=0, check=0, url=""), s2=TransportSlot(key="", attempt=0, check=0, url=""), s3=TransportSlot(key="", attempt=0, check=0, url=""), s4=TransportSlot(key="", attempt=0, check=0, url=""), s5=TransportSlot(key="", attempt=0, check=0, url=""), s6=TransportSlot(key="", attempt=0, check=0, url=""), s7=TransportSlot(key="", attempt=0, check=0, url=""), s8=TransportSlot(key="", attempt=0, check=0, url=""), u0=TransportUpdateSlot(key="", step=0), u1=TransportUpdateSlot(key="", step=0), u2=TransportUpdateSlot(key="", step=0), u3=TransportUpdateSlot(key="", step=0))
  resource transportConnect0 = transportConnect(0, transportTable.s0.key, transportTable.s0.attempt, transportTable.s0.check) as shape TransportConnect
  resource transportSocket0 = transportSocket(0, transportTable.s0.url) as shape TransportSocket
  resource transportConnect1 = transportConnect(1, transportTable.s1.key, transportTable.s1.attempt, transportTable.s1.check) as shape TransportConnect
  resource transportSocket1 = transportSocket(1, transportTable.s1.url) as shape TransportSocket
  resource transportConnect2 = transportConnect(2, transportTable.s2.key, transportTable.s2.attempt, transportTable.s2.check) as shape TransportConnect
  resource transportSocket2 = transportSocket(2, transportTable.s2.url) as shape TransportSocket
  resource transportConnect3 = transportConnect(3, transportTable.s3.key, transportTable.s3.attempt, transportTable.s3.check) as shape TransportConnect
  resource transportSocket3 = transportSocket(3, transportTable.s3.url) as shape TransportSocket
  resource transportConnect4 = transportConnect(4, transportTable.s4.key, transportTable.s4.attempt, transportTable.s4.check) as shape TransportConnect
  resource transportSocket4 = transportSocket(4, transportTable.s4.url) as shape TransportSocket
  resource transportConnect5 = transportConnect(5, transportTable.s5.key, transportTable.s5.attempt, transportTable.s5.check) as shape TransportConnect
  resource transportSocket5 = transportSocket(5, transportTable.s5.url) as shape TransportSocket
  resource transportConnect6 = transportConnect(6, transportTable.s6.key, transportTable.s6.attempt, transportTable.s6.check) as shape TransportConnect
  resource transportSocket6 = transportSocket(6, transportTable.s6.url) as shape TransportSocket
  resource transportConnect7 = transportConnect(7, transportTable.s7.key, transportTable.s7.attempt, transportTable.s7.check) as shape TransportConnect
  resource transportSocket7 = transportSocket(7, transportTable.s7.url) as shape TransportSocket
  resource transportConnect8 = transportConnect(8, transportTable.s8.key, transportTable.s8.attempt, transportTable.s8.check) as shape TransportConnect
  resource transportSocket8 = transportSocket(8, transportTable.s8.url) as shape TransportSocket
  resource transportUpdateStep0 = transportUpdateStep(0, transportTable.u0.key, transportTable.u0.step) as shape TransportUpdateStep
  resource transportUpdateSocket0 = transportUpdateSocket(0, transportUpdateStep0.step == transportTable.u0.step ? transportUpdateStep0.url : "") as shape TransportSocket
  resource transportUpdateStep1 = transportUpdateStep(1, transportTable.u1.key, transportTable.u1.step) as shape TransportUpdateStep
  resource transportUpdateSocket1 = transportUpdateSocket(1, transportUpdateStep1.step == transportTable.u1.step ? transportUpdateStep1.url : "") as shape TransportSocket
  resource transportUpdateStep2 = transportUpdateStep(2, transportTable.u2.key, transportTable.u2.step) as shape TransportUpdateStep
  resource transportUpdateSocket2 = transportUpdateSocket(2, transportUpdateStep2.step == transportTable.u2.step ? transportUpdateStep2.url : "") as shape TransportSocket
  resource transportUpdateStep3 = transportUpdateStep(3, transportTable.u3.key, transportTable.u3.step) as shape TransportUpdateStep
  resource transportUpdateSocket3 = transportUpdateSocket(3, transportUpdateStep3.step == transportTable.u3.step ? transportUpdateStep3.url : "") as shape TransportSocket
  resource transportInbox = transportDeliver(transportSocket0.seq + transportConnect0.seq + transportSocket1.seq + transportConnect1.seq + transportSocket2.seq + transportConnect2.seq + transportSocket3.seq + transportConnect3.seq + transportSocket4.seq + transportConnect4.seq + transportSocket5.seq + transportConnect5.seq + transportSocket6.seq + transportConnect6.seq + transportSocket7.seq + transportConnect7.seq + transportSocket8.seq + transportConnect8.seq + transportUpdateSocket0.seq + transportUpdateStep0.seq + transportUpdateSocket1.seq + transportUpdateStep1.seq + transportUpdateSocket2.seq + transportUpdateStep2.seq + transportUpdateSocket3.seq + transportUpdateStep3.seq + transportTable.deliver) as shape TransportInbox
  mutation transportPumped as shape TransportTable queue then transportPumpDone
  action transportPump
    applyUi(decideTransportPump(pending(transportPumped), wallTime))
  action transportPumpDone
    applyState(decideTransportPumpDone(transportPumped, transportTable))
  // Each answer that may wait on a server reply, pending or not. The tick publishes the table once whenever one starts
  // or ends (a connect, a retry or a disconnect changes it inside an answer, which nothing else reads), and once
  // whenever the delivering answer reports a table the tick has not published (a socket closed, a slot's attempt got
  // its URL).
  derive transportAnswering = `${pending(threadFind)}${pending(threadFindMaintained)}${pending(serverBrowserUploaded)}${pending(data)}${pending(balanceLoaded)}${pending(attachmentUrls)}${pending(home)}${pending(usage)}${pending(usageShortcuts)}${pending(prList)}${pending(prDetail)}${pending(welcome)}${pending(timelineDisclosureChanged)}${pending(timelineReadsRefreshed)}${pending(timelineReadsRefreshedNext)}${pending(workspaceDiscovery)}${pending(workspaceRefreshed)}${pending(palette)}${pending(paletteChanged)}${pending(providerAuthChanged)}${pending(providerUpdateRun)}${pending(changed)}${pending(localChanged)}${pending(filesAdded)}${pending(inlineDocumentChanged)}${pending(prQuickChanged)}${pending(prConfirmChanged)}${pending(secretAnswered)}${pending(prHandoffChanged)}${pending(draftLeft)}${pending(terminalFocusChanged)}${pending(fileCommentChanged)}${pending(lineDragChanged)}${pending(terminalChanged)}${pending(fragmentChanged)}${pending(providerPage)}${pending(providerWizard)}${pending(connectionsPage)}${pending(acpAgents)}${pending(bindings)}${pending(scheduled)}${pending(shortcuts)}${pending(sourceControl)}${pending(integrations)}${pending(storageSettings)}${pending(archives)}${pending(licenses)}${pending(diagnostics)}${pending(snapshotSettings)}${pending(settingsNavigation)}${pending(settingsCore)}${pending(settings)}${pending(projectsSettings)}${pending(sbSshHosts)}${pending(sshPrompt)}${pending(sshAnswered)}${pending(pairFields)}${pending(sbPicker)}${pending(catalog)}${pending(editor)}${pending(chip)}${pending(branches)}${pending(sidebarLaunch)}${pending(automationRecordingServed0)}${pending(automationRecordingServed1)}${pending(automationRecordingServed2)}${pending(automationRecordingServed3)}${pending(themeLive)}${pending(shell)}${pending(details)}${pending(canvas)}${pending(terminalDrawer)}`
  task transportAnswered key = transportAnswering
    after(1, transportPump)
  task transportRepublish when transportInbox.table > transportTable.rev key = transportInbox.table
    after(1, transportPump)
  task transportSoon when transportTable.soon
    every(250, transportPump)
  task transportLive when transportTable.live
    every(1000, transportPump)
  state transportOnline = true
  task transportNetwork key = page.onLine
    after(1, transportNetworkChanged)
  action transportNetworkChanged
    applyUi(decideTransportNetworkChanged(page, transportOnline, wallTime))
  // The snapshot is asked again for the connections' news once its read in flight lands, as a watched topic would (exact2
  // #183): replacing it for each frame, a launch's slow snapshot answer would never land. Settings › Connections likewise.
  state transportSeen = 0
  task transportNews when transportInbox.news != transportSeen and not pending(data) key = transportInbox.news
    after(1, transportNewsSeen)
  action transportNewsSeen
    transportSeen = transportInbox.news
  state transportFleetSeen = 0
  task transportFleetNews when transportInbox.fleet != transportFleetSeen and not pending(connectionsPage) key = transportInbox.fleet
    after(1, transportFleetNewsSeen)
  action transportFleetNewsSeen
    transportFleetSeen = transportInbox.fleet
  task rootFont key = data.look.fontSize // Interface font size (appearanceFonts.ts applyAppearanceFontVariables): the root font size every rem follows, set at launch and on every change; `rem` is provided for lengths computed in px at 16.
    after(1, rootFontApply)
  action rootFontApply // the reference's 16 before the data's first answer (the Mac host's own size is 13 since LLP 1115)
    setRootFontSize(data.look.fontSize > 0 ? data.look.fontSize : 16)
  state codeCopyDone = 0 // #123: the copy whose check has run its time (MarkdownCodeBlock and MarkdownTable 1.2 s, CommandBlock 1.5 s); its button morphs back (MorphCopyCheck)
  state welcomeCopyDone = 0
  task codeCopyHold when data.codeCopyNonce > 0 key = data.codeCopyNonce
    after(1200, codeCopyRelease)
  action codeCopyRelease
    codeCopyDone = data.codeCopyNonce
  task welcomeCopyHold when welcome.commandCopied > 0 key = welcome.commandCopied
    after(1500, welcomeCopyRelease)
  action welcomeCopyRelease
    welcomeCopyDone = welcome.commandCopied
  resource serverBrowserLive = serverBrowserFrame(shell.panel.browser.runtimeId, shell.panel.browser.streamUrl) as shape ServerBrowserFrame
  resource serverBrowserMiniLive = serverBrowserFrame(shell.panel.browserMini.runtimeId, shell.panel.browserMini.streamUrl) as shape ServerBrowserFrame
  mutation serverBrowserChanged as shape ServerBrowserFrame queue
  mutation serverBrowserMaintained as shape ServerBrowserFrame queue
  mutation serverBrowserMiniMaintained as shape ServerBrowserFrame queue
  mutation serverBrowserUploaded as shape ServerBrowserFrame queue refreshes data
  derive serverFrame0 = match serverBrowserChanged { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverBrowserLive.seq ? value : serverBrowserLive, case none => serverBrowserLive }
  derive serverFrame1 = match serverBrowserMaintained { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverFrame0.seq ? value : serverFrame0, case none => serverFrame0 }
  derive serverFrame = match serverBrowserUploaded { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverFrame1.seq ? value : serverFrame1, case none => serverFrame1 }
  derive serverMiniFrame0 = match serverBrowserChanged { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverBrowserMiniLive.seq ? value : serverBrowserMiniLive, case none => serverBrowserMiniLive }
  derive serverMiniFrame1 = match serverBrowserMiniMaintained { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverMiniFrame0.seq ? value : serverMiniFrame0, case none => serverMiniFrame0 }
  derive serverMiniFrame = match serverBrowserUploaded { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverMiniFrame1.seq ? value : serverMiniFrame1, case none => serverMiniFrame1 }
  task streamMaintenance when serverFrame.attention or serverMiniFrame.attention key = `${serverFrame.runtimeId}:${serverMiniFrame.runtimeId}`
    every(250, streamMaintain)
  action streamMaintain
    applyUi(decideStreamMaintain(shell, wallTime))
  task streamDecode when serverFrame.decoding key = `${serverFrame.runtimeId}:${serverFrame.decodeSequence}`
    after(1, streamDecodeFrame)
  action streamDecodeFrame
    send serverBrowserChanged = serverBrowserDecode(serverFrame.runtimeId)
  task streamMiniDecode when serverMiniFrame.decoding key = `${serverMiniFrame.runtimeId}:${serverMiniFrame.decodeSequence}`
    after(1, streamDecodeMiniFrame)
  action streamDecodeMiniFrame
    send serverBrowserChanged = serverBrowserDecode(serverMiniFrame.runtimeId)
  state streamGeometry = initialStreamGeometryState()
  task streamResized when serverFrame.controlled and streamGeometry.followSize and streamGeometry.width > 0 and streamGeometry.height > 0 key = `${streamGeometry.width}x${streamGeometry.height}:${serverFrame.controlled}`
    after(150, streamResize)
  action streamResize
    send serverBrowserChanged = serverBrowserResize(shell.panel.browser.runtimeId, streamGeometry.width, streamGeometry.height, wallTime.epochAtZero + performanceNow())
  action streamPainted(id: string, image: string)
    send serverBrowserChanged = serverBrowserPainted(id, image)
  action streamControl(id: string, kind: string)
    send serverBrowserChanged = serverBrowserControl(id, kind, wallTime.epochAtZero + performanceNow())
  action streamMouse(id: string, event: PointerEvent, phase: string, width: number, height: number)
    send serverBrowserChanged = serverBrowserMouse(id, event, phase, width, height, wallTime.epochAtZero + performanceNow())
  action streamWheel(id: string, event: WheelEvent, phase: string, width: number, height: number)
    send serverBrowserChanged = serverBrowserWheel(id, event, phase, width, height, wallTime.epochAtZero + performanceNow())
  action streamKey(id: string, event: KeyboardEvent, phase: string)
    send serverBrowserChanged = serverBrowserKey(id, event, phase, wallTime.epochAtZero + performanceNow())
  action streamText(id: string, text: string)
    send serverBrowserChanged = serverBrowserText(id, text, wallTime.epochAtZero + performanceNow())
  action streamDialog(id: string, accept: bool, prompt: string)
    send serverBrowserChanged = serverBrowserDialog(id, accept, prompt, wallTime.epochAtZero + performanceNow())
  action streamUpload(id: string, chooser: string, files: Picked[])
    send serverBrowserUploaded = serverBrowserUpload(id, chooser, files)
  task streamClipboard when serverFrame.clipboardSequence > 0 key = `${serverFrame.runtimeId}:${serverFrame.clipboardSequence}`
    after(1, streamCopyClipboard)
  action streamCopyClipboard
    copyText(serverFrame.clipboard)
  task streamOpenedDialog when serverFrame.dialogType != "" key = serverFrame.dialogMessage
    after(1, streamOpenDialog)
  action streamOpenDialog
    showModal(`server-browser-dialog-${serverFrame.runtimeId}`)
  task streamClosedDialog when serverFrame.dialogType == ""
    after(1, streamCloseDialog)
  action streamCloseDialog
    close(`server-browser-dialog-${serverFrame.runtimeId}`)
  task streamMiniClipboard when serverMiniFrame.clipboardSequence > 0 key = `${serverMiniFrame.runtimeId}:${serverMiniFrame.clipboardSequence}`
    after(1, streamCopyMiniClipboard)
  action streamCopyMiniClipboard
    copyText(serverMiniFrame.clipboard)
  task streamOpenedMiniDialog when serverMiniFrame.dialogType != "" key = serverMiniFrame.dialogMessage
    after(1, streamOpenMiniDialog)
  action streamOpenMiniDialog
    showModal(`server-browser-dialog-${serverMiniFrame.runtimeId}`)
  task streamClosedMiniDialog when serverMiniFrame.dialogType == ""
    after(1, streamCloseMiniDialog)
  action streamCloseMiniDialog
    close(`server-browser-dialog-${serverMiniFrame.runtimeId}`)
  provide
    inlineDocumentViewportWidth = viewport.width
    inlineDocumentViewportHeight = viewport.height
    richPromptPreview
    promptPreviewText = previewState.text
    promptPreviewOwner
    promptPreviewSnapshotOwner = data.snapshotOwner
    promptPreviewSerial = previewState.serial
    composerFieldInputSerial = fieldProtocol.inputSerial
    richComposer
    richComposerOwner
    composerIntentNotice = intentState.notice
    attachFiles
    chooseAttachments
    threadFind
    serverMiniFrame
    serverFrame
    streamPainted
    streamControl
    streamMouse
    streamWheel
    streamKey
    streamText
    streamDialog
    streamUpload
    codeCopyDone
    questionDocuments = questionMarkdown.documents
    traceDocuments = traceMarkdown.documents
    welcomeCopyDone
    routeKeyboard
    citeEnd
    releaseUndoClaim
  state citationPlacement = initialCitationPlacementState()
  task citeRequested when data.citeJump.nonce > citationPlacement.nonce key = data.citeJump.nonce
    after(1, citeBegin)
  action citeBegin
    applyState(decideCiteBegin(citationPlacement, data))
  task citePass when citationPlacement.nonce > citationPlacement.done and not citationPlacement.smooth and citationPlacement.tries < 40 key = `${citationPlacement.nonce}|${citationPlacement.tries}|${citationPlacement.smooth}`
    after(50, citePlace)
  task citeSmoothPass when citationPlacement.nonce > citationPlacement.done and citationPlacement.smooth key = `${citationPlacement.nonce}|${citationPlacement.tries}`
    after(400, citeAfterSmooth)
  action citeAfterSmooth
    citationPlacement = CitationPlacementState(citationPlacement, smooth=false)
  action citeEnd
    citationPlacement = CitationPlacementState(citationPlacement, done=citationPlacement.nonce)
  derive canRest = data.composerCollapseOnScroll and data.threadId != "" and not composerDraft.focused and not composerText.includes("\n") and data.approvals.length == 0 and data.questions.length == 0 and not data.settled
  state transcriptViewport = initialTranscriptViewportState()
  task restLapsed when transcriptViewport.resting and not canRest key = transcriptViewport.resting
    after(1, restLapse)
  action restLapse
    transcriptViewport = TranscriptViewportState(transcriptViewport, resting=false)
  // Save file and the media menu's Save (save-file.ts): the host's Save panel, a sheet on the window, copies the app
  // file out under its name (the hidden `save-file` field, app-window.contract, hears its change and cancel).
  state saveNonce = 0
  task saveRequested when data.saveRequest.nonce > saveNonce key = data.saveRequest.nonce
    after(1, saveNow)
  action saveNow
    applyUi(decideSaveNow(data))
  action citePlace
    let target = frame(`cite-${citationPlacement.key}`)
    let row = frame(`row-${citationPlacement.key}`)
    let port = frame("transcript")
    applyPlacement(decideCitePlace(citationPlacement, target, row, port, viewport.prefersReducedMotion))
  mutation balanceLoaded as shape Change refreshes data // auto-balance.ts (issues/closed/20261009-typescript-failure-parity.md, issues/20261009-runner-owned-bidirectional-streams.md): an unresolved Auto draft asks its machines' host resources, at the window's time.
  task balanceLoad when branches.balanceFetch != "" key = branches.balanceFetch
    after(1, balanceLoadNow)
  action balanceLoadNow
    send balanceLoaded = command("cclocal:balance-load", branches.balanceFetch, `${wallTime.epochAtZero + performanceNow()}`, 0)
  state noticeExitState = initialNoticeExitState()
  task noticeExiting when noticeExitState.op != "" key = noticeExitState.serial
    after(220, noticeExited)
  action noticeExited
    applyUi(decideNoticeExited(commandPending, noticeExitState))
  state hoverState = initialHoverState()
  task hoverTick when hoverState.wait < hoverState.end key = hoverState.end
    every(10, hoverTicked)
  task hoverSurface key = `${settingsPageState.open}|${settingsPageState.route}|${utilityPage}|${modal}|${prSelected}|${data.threadId}|${hoverOwnerValid}` // also close a legacy tip whose row vanished without leave
    after(1, hoverTicked)
  action hoverTicked
    applyState(decideHoverTicked(hoverOwnerValid, hoverShown, hoverState))
  derive hoverOwnerValid = hoverState.tip.key != "legacy-tip" or (data.legacy.enabled and data.sidebarOpen and legacyTipOwner(hoverState.tip.testId, data.legacy.projects))
  derive hoverShown = hoverOwnerValid and hoverState.tip.key != "" and (hoverState.on != "" ? hoverState.wait == hoverState.open : hoverState.wait < hoverState.until)
  resource threadFind = threadFind(data.revision, wallTime.epochAtZero + elapsed, data.markdownSkills, transcriptViewport.findViewport) as shape ThreadFindView
  mutation threadFindMaintained as shape ThreadFindView refreshes threadFind, data
  task maintainThreadFind when threadFind.attention
    every(100, maintainThreadFindTick)
  action maintainThreadFindTick
    applyUi(decideMaintainThreadFindTick(data, pending(threadFindMaintained), transcriptViewport,
        wallTime))
  state findPlacement = initialFindPlacementState()
  task findRequested when threadFind.open and threadFind.entry != "" key = `${data.serverUrl}|${data.threadId}|${threadFind.navigation}|${threadFind.entry}`
    after(1, findBegin)
  action findBegin
    applyUi(decideFindBegin(citationPlacement, findPlacement, threadFind))
  task findPlacement when threadFind.open and findPlacement.placing and findPlacement.tries < 30 key = findPlacement.tries
    after(32, findPlace)
  action findPlace
    let target = frame("thread-find-active")
    let row = frame(`row-${threadFind.entry}`)
    let port = frame("transcript")
    applyPlacement(decideFindPlace(findPlacement, threadFind.entry, target, row, port))
  task threadFindFocus when threadFind.open key = threadFind.focus
    after(1, threadFindFocusField)
  action threadFindFocusField
    applyUi(decideThreadFindFocusField())
  task diffFindFocus when data.diffFind.open key = data.diffFind.focus
    after(1, diffFindFocusField)
  action diffFindFocusField
    applyUi(decideDiffFindFocusField())
  task prFindFocus when prDetail.codeTab.find.open key = prDetail.codeTab.find.focus
    after(1, prFindFocusField)
  action prFindFocusField
    applyUi(decidePrFindFocusField())
  resource markdown = renderMarkdown(data.messages, data.markdownSkills, threadFind.highlight, threadFind.entry, threadFind.occurrence, data.messages.map((message) => MarkdownLabels(id=message.id, chips=message.md.chips))) as shape TranscriptMarkdown
  resource questionMarkdown = renderQuestionMarkdown(data.questions) as shape TranscriptMarkdown
  // ReasoningTraceContent: an open thought's trace is Markdown, its single newlines kept as UserMessageBody keeps them.
  resource traceMarkdown = renderFileMarkdown(data.messages.map((message) => message.activities.filter((a) => a.reasoning and a.detailOpen).map((a) => MarkdownSource(id=`trace:${a.id}`, kind="user", title="", body=a.output))).flat()) as shape TranscriptMarkdown
  resource attachmentUrls = timelineAttachments(data.threadId, wallTime.epochAtZero + elapsed, data.revision, scheme) as shape TimelineAttachmentUrls // Signed preview URLs for the thread's sent images (timeline-attachments.ts).
  // Its read also brings the open documents up to date (a theme change); what it queues for them reaches them with the
  // next snapshot, so a new post asks for one now instead of at the next minute tick.
  task inlineDocumentsPosted when attachmentUrls.posted > 0 key = attachmentUrls.posted
    after(1, deliverInlinePosts)
  action deliverInlinePosts
    send inlineDocumentChanged = command("chatlocal:inline-doc-posted", "", "", 0)
  resource home = pagesHome(data.revision) as shape PagesHome // Lane pages: the empty main view, the utility pages and the sidebar footer route.
  state utilityPage = ""
  derive pageCover = utilityPage != "" or home.landing == "no-environment" or home.landing == "no-projects" or home.landing == "start-error" or home.landing == "no-thread"
  state pageTrail = [] // Utility-page Escape follows its page trail; opening from a thread starts a new trail, empty means Home.
  state usageMetric = ""
  state usageDays = 0
  state usageBreakdown = "model"
  state usageRefresh = 0
  resource usage = usagePage(utilityPage == "usage", usageMetric, usageDays, usageBreakdown, usageRefresh, viewport.width, data.sidebarOpen ? sidebarWidth : 0, wallTime.epochAtZero + elapsed, data.revision) as shape UsageView
  resource usageShortcuts = usageKeys(data.revision) as shape UsageKey[]
  action usageBreakdownSet(value: string)
    usageBreakdown = value
  action usageRefreshNow
    usageRefresh = usageRefresh + 1
  state prQuery = ""
  state prApplied = ""
  state prTyped = false
  state prSelected = ""
  state prPanelOpen = true
  state prRefresh = 0
  action prSetTab(value: string)
    prTab = value
    if utilityPage == "" and shell.panel.kind == "pull-request" and shell.panel.pr.surface != ""
      send prTabSaved = command("shelllocal:surface-pr-tab", shell.panel.pr.surface, value, 0)
  state prTab = "summary"
  resource prList = prList(utilityPage == "pull-requests", prRefresh, wallTime.epochAtZero + elapsed, prSelected, prApplied, prTyped, data.revision, page.visibilityState == "visible", windowReturns) as shape PrListView
  resource prDetail = prDetail(utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, prRefresh, wallTime.epochAtZero + elapsed, data.revision, page.visibilityState == "visible", windowReturns, prTab, utilityPage == "pull-requests", floor(liveNow / 5000), page.visibilityState == "visible" and not settingsPageState.open and ((utilityPage == "pull-requests" and prPanelOpen) or (utilityPage == "" and shell.panel.open and shell.panel.kind == "pull-request"))) as shape PrDetailView // the page, the linked threads' 10 s tick
  task guideDisabled when prDetail.phase == "content" and prTab == "guide" and not prDetail.guide.enabled
    after(1, guideFallback)
  // An unavailable tab falls back to the Summary without becoming the surface's remembered tab.
  action guideFallback
    prTab = "summary"
  state guideFinishHandled = ""
  task guideFinishRequested when prDetail.guide.finishNonce > 0 and guideFinishHandled != `${prDetail.guide.key}:${prDetail.guide.finishNonce}` key = `${prDetail.guide.key}:${prDetail.guide.finishNonce}`
    after(1, guideFinishOpen)
  action guideFinishOpen
    applyUi(decideGuideFinishOpen(prDetail, utilityPage))
  state codeRevealHandled = ""
  task codeRevealRequested when prTab == "code" and prDetail.codeTab.revealPath != "" and prDetail.codeTab.revealNonce > 0 and codeRevealHandled != `${prDetail.guide.key}:${prDetail.codeTab.revealNonce}` key = `${prDetail.guide.key}:${prDetail.codeTab.revealNonce}`
    after(1, codeRevealOpen)
  action codeRevealOpen
    applyUi(decideCodeRevealOpen(prDetail, utilityPage))
  resource prMarkdown = renderPullRequestMarkdown(prDetail.bodies) as shape TranscriptMarkdown
  task prSearchSettle when utilityPage == "pull-requests" and prTyped and prApplied != prQuery key = prQuery // SEARCH_DEBOUNCE_MS: 250 ms after the last keystroke (exact2 #192)
    after(250, prSettle)
  action prSettle
    applyUi(decidePrSettle(prQuery))
  action prSelect(ref: string)
    prSelected = ref
    prPanelOpen = true
    prTab = "summary"
  action prAct(op: string, value: string)
    if op == "guide-write" and not prDetail.guide.hasGuide
      prSetTab("guide")
    if op == "quick" or op == "close-batch"
      send prQuickChanged = command(`pageslocal:pr-act-${op == "quick" ? "queue" : op}`, "", value, 0)
    else if not commandPending
      commandPending = true
      send changed = command(`pageslocal:pr-act-${op}`, utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, value, 0)
  action prReload
    prRefresh = prRefresh + 1
  task prSurfaceTab when utilityPage == "" and shell.panel.open and shell.panel.kind == "pull-request" and shell.panel.pr.surface != "" key = `${shell.panel.key}|${shell.panel.pr.surface}`
    after(1, prSurfaceTabShown)
  action prSurfaceTabShown
    prTab = shell.panel.pr.tab
  task prConfirmLapse when prDetail.actions.armedSerial > 0 key = prDetail.actions.armedSerial // useInlineActionConfirm: an armed confirmation lapses after 3 s, or as the window loses the focus
    after(3000, prConfirmLapsed)
  task prConfirmBlur when prDetail.actions.armedSerial > 0 and not page.hasFocus key = prDetail.actions.armedSerial
    after(1, prConfirmLapsed)
  action prConfirmLapsed
    send localChanged = command("chatlocal:pr-ui-disarm", prDetail.ref, `serial:${prDetail.actions.armedSerial}`, 0)
  state welcomeStep = "connect"
  state welcomeLink = ""
  // "Add a computer" as the person left it; "" is as the Connect step starts it (ConnectionStep's expandPairingInitially).
  state welcomePairFold = ""
  derive welcomePairOpen = welcomePairFold == "" ? welcome.pairStartsOpen : welcomePairFold == "open"
  state welcomePaired = 0
  resource welcome = welcome(welcomeStep, wallTime.epochAtZero + elapsed, data.revision) as shape WelcomeView
  // ConnectionStep's onPaired and its `ready` effect: Continue takes the focus once it can.
  task welcomePairedFocus when welcomePaired > 0 and welcomeStep == "connect" and welcome.ready and not commandPending key = welcomePaired
    after(1, welcomeFocusContinue)
  action welcomeFocusContinue
    focus("welcome-continue")
  action tick
    elapsed = performanceNow()
  task clock mount
    every(60000, tick)
  state windowReturns = 0 // the window focused again, the clock read then (useLiveRefresh's `focus` at Date.now(), not at the last minute tick), for the list and the detail
  task windowBack when page.hasFocus and page.visibilityState == "visible"
    after(1, windowReturned)
  action windowReturned
    applyUi(decideWindowReturned(wallTime, windowReturns))
  mutation timelineDisclosureChanged as shape Change refreshes data then dispatchTimelineReads
  mutation timelineReadsRefreshed as shape TimelineReadsResult refreshes data
  mutation timelineReadsRefreshedNext as shape TimelineReadsResult refreshes data
  action dispatchTimelineReads
    applyCompletion(decideDispatchTimelineReads(pending(timelineReadsRefreshed),
        pending(timelineReadsRefreshedNext), wallTime))
  state liveNow = 0 // The timeline's "Working for 12s" ticks each second while a run is live.
  state workspaceNow = 0 // The mounted composer checks its five-minute workspace snapshot TTL.
  resource workspaceDiscovery = composerWorkspace(data.revision, not settingsPageState.open and not pageCover and not welcome.show, wallTime.epochAtZero + max(workspaceNow, elapsed)) as shape WorkspaceDiscovery // ChatComposer is mounted on the chat view only
  mutation workspaceRefreshed as shape WorkspaceRefresh refreshes workspaceDiscovery, data then workspaceRefreshFinished
  state workspaceRetry = initialWorkspaceRetryState()
  action workspaceRefreshFinished
    applyState(decideWorkspaceRefreshFinished(workspaceRefreshed, workspaceRetry))
  action liveTick
    applyUi(decideLiveTick(data, liveNow, pageCover, pending(data), pending(timelineReadsRefreshed),
        pending(timelineReadsRefreshedNext), pending(workspaceRefreshed), prDetail,
        settingsPageState.open, wallTime, welcome, workspaceDiscovery, workspaceRetry))
  task liveClock mount
    every(1000, liveTick)
  mutation highlightSliced as shape HighlightStep then highlightStepped
  action highlightStep
    applyUi(decideHighlightStep(pending(highlightSliced), wallTime))
  action highlightStepped
    applyCompletion(decideHighlightStepped(data, highlightSliced, pending(data), pending(shell),
        shell))
  task highlightPump when data.highlightPending or shell.highlightPending
    every(16, highlightStep)
  resource viewport = exactViewport() as shape Viewport
  derive scheme = (data.look.mode == "light" or data.look.mode == "dark") ? data.look.mode : (viewport.prefersColorScheme == "dark" ? "dark" : "light") // Palettes use the resolved Appearance scheme; viewport.prefersColorScheme is only the underlying system preference.
  state paletteSession = initialPaletteSessionState()
  resource palette = paletteView(paletteSession.open, paletteSession.mode, paletteSession.page, paletteSession.query, `${paletteSession.caseSensitive ? "case " : ""}${paletteSession.wholeWord ? "word " : ""}${paletteSession.regex ? "regex" : ""}`, paletteSession.cursor >= 0, wallTime.epochAtZero + elapsed, scheme, data.revision) as shape PaletteView
  mutation paletteChanged as shape PaletteResult refreshes data then paletteDone
  action paletteDone
    applyCompletion(decidePaletteDone(commandPending, jumpRequest, paletteChanged, paletteSession,
        composerDraft))
  mutation providerAuthChanged as shape Change queue refreshes data, providerPage, providerWizard
  mutation providerUpdateRun as shape Change queue refreshes providerPage
  mutation changed as shape Change refreshes data then commandCompleted
  mutation prQuickChanged as shape Change queue refreshes data
  mutation prConfirmChanged as shape Change refreshes data
  mutation inlineDocumentChanged as shape Change queue refreshes data
  mutation secretAnswered as shape Change queue refreshes data then dispatchTimelineReads
  mutation localChanged as shape Change refreshes data
  // A pull request surface's remembered tab (prSetTab); queued, so quick tab presses land in order.
  mutation prTabSaved as shape Change queue
  // A drop on the chat column or a legacy row, a paste into the composer, or Attach files' picks (composer-controls-attach.ts
  // attachIncoming, legacy-sidebar-drop.ts queueRowDrop). Queued: a second drop waits for the first.
  mutation filesAdded as shape Change queue refreshes data then filesAddedDone
  mutation prHandoffChanged as shape Change refreshes data // a checkout hand-off's second half, its own send
  // A new thread opened while the draft's launch is in flight: its own send, so the launch's reply is not let go (draft-launch.ts).
  mutation draftLeft as shape Change refreshes data
  mutation terminalFocusChanged as shape Change refreshes data
  mutation fileCommentChanged as shape Change queue refreshes data // the Files preview's line comments (chatLocal)
  mutation lineDragChanged as shape Change queue refreshes data // a diff gutter drag's press, moves and release, each in turn
  mutation terminalChanged as shape Change refreshes data then terminalCompleted
  action terminalCompleted
    applyCompletion(decideTerminalCompleted(terminalChanged))
  mutation fragmentChanged as shape Change refreshes data then fragmentOpened
  action fragmentOpened
    applyCompletion(decideFragmentOpened(fragmentChanged, jumpRequest, pageTrail, utilityPage,
        composerDraft))
  state commandPending = false
  state lineageStopping = ""
  state lineageWorkflows: string [] = []
  state lineagePhasesOpen: string [] = []
  state lineagePhasesClosed: string [] = []
  // A row's double-click while its first click's open runs: the rename (its op and row) starts once the open lands,
  // on the environment it focused, as Sidebar.tsx's onDoubleClick renames after that click navigated.
  state renameAfterOp = ""
  state renameAfterId = ""
  state pendingModal = ""
  state modalError = ""
  state connecting = false
  state projectsOpen = false
  state providerSelected = ""
  state providerLinkTarget = "" // the instance the route names (the last link's), apart from the page's own pick (providerSelected)
  state providerWizardState = initialProviderWizardState()
  state providerNow = 0
  action providerTick
    applyState(decideProviderTick(connectionsPage, providerPage, providerWizard,
        providerWizardState, settingsPageState.open, settingsPageState.route))
  task providerClock mount
    every(1000, providerTick)
  resource providerPage = providerPage(providerSelected, settingsPageState.open and settingsPageState.route == "providers", data.revision, wallTime.epochAtZero + max(elapsed, providerNow), settingsMachine, settingsProjectKey, settingsCheckout, settingsProjectId) as shape ProviderPage // the scope's environment (providers-scope.ts): its page and its actions name `providerPage.environment`
  resource providerWizard = providerWizard(providerWizardState.dialog != "", providerWizardState.serial, providerWizardState.manual ? "acpRegistry" : providerWizardState.driver, providerWizardState.labelSet, providerWizardState.label, providerWizardState.idSet, providerWizardState.id, data.revision, providerWizardState.dialog, providerWizardState.target, providerPage.environment) as shape ProviderWizard
  state connectionRemove = ""
  state connectionMenu = ""
  resource connectionsPage = connectionsPage(settingsPageState.open and settingsPageState.route == "connections", data.revision, data.status, data.connected, data.connecting, wallTime.epochAtZero + max(elapsed, providerNow), transportFleetSeen) as shape ConnectionsPage
  state routeKeyboard = routeKeyboardIdle()
  derive routeKeyboardReady = settingsPageState.open and settingsPageState.route == "connections" and page.hasFocus and page.visibilityState == "visible" and not connecting and not projectsOpen and not paletteSession.open and not welcome.show and providerWizardState.dialog == "" and restEditor == "" and connectionRemove == ""
  derive routeKeyboardOwned = routeKeyboardReady and routeKeyboardLive(routeKeyboard, routeKeyboardSource(connectionsPage, routeKeyboard.environmentId, routeKeyboard.rowKey))
  task routeKeyboardLost when routeKeyboard.phase != "" and (not routeKeyboardOwned or (commandPending and routeKeyboard.phase == "lifted") or (routeKeyboard.phase == "saving" and not commandPending and not pending(changed)))
    after(1, cancelRouteKeyboard)
  action cancelRouteKeyboard
    routeKeyboard = routeKeyboardCancel(routeKeyboard)
  resource acpAgents = acpRegistry(providerWizardState.acpQuery, providerWizardState.dialog == "add" and providerWizardState.step == 0, data.revision, providerPage.environment) as shape AcpRegistry
  state settingsPageState = initialSettingsPageState()
  state keybindingQuery = ""
  state keybindingEditor = initialKeybindingEditorState()
  state keybindingWhen = ""
  resource bindings = keybindingSettings(settingsEnvironmentId, keybindingQuery, settingsPageState.open and settingsPageState.route == "keybindings", keybindingEditor.previous, keybindingEditor.key, keybindingWhen, keybindingEditor.command, settingsPageState.refresh, data.revision, keybindingEditor.drafts) as shape KeybindingPage
  resource scheduled = scheduledSettings(settingsEnvironmentId, settingsProjectId, restEditor, restSubject, settingsPageState.open and settingsPageState.route == "scheduled-tasks", wallTime.epochAtZero + elapsed, settingsPageState.refresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, taskBase, shellClock) as shape ScheduledPage // shellClock: the base-branch picker's next page (ref-loading.ts)
  state licenseQuery = ""
  state licenseExpanded = ""
  state licenseRetry = 0
  state diagnosticPeriod = "15m"
  resource shortcuts = keyboardDispatch(data.threads, composerMenu.browseProvider, composerMenu.modelQuery, composerDraft.focused, data.running, composerMenu.modelsOpen, data.threadId == "", modal, settingsPageState.open, data.diffOpen or shell.panel.open, data.revision, paletteSession.open, paletteSession.mode, utilityPage == "pull-requests" and prSelected != "" and prPanelOpen ? prDetail.numberLabel : "", data.sidebar.undoUntil > wallTime.epochAtZero + max(liveNow, elapsed), settingsPageState.route, utilityPage, composerMenu.modelTarget.id, confirmationState.op, shell.panel.kind, prTab == "code", data.sidebarOpen and data.sidebar.undoUntil > modifierOwnership.undoReleasedUntil, shell.panel.open and shell.panel.kind == "file", shell.panel.files.editorShow and shell.panel.files.editorUnavailable == "" and shell.panel.files.editorId != "" ? shell.panel.files.absolutePath : "") as shape KeyDispatch[]
  resource sourceControl = sourceControlPage(settingsEnvironmentId, settingsProjectId, settingsPageState.open and settingsPageState.route == "source-control", settingsPageState.refresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout) as shape SourceControlPage
  resource integrations = integrationsPage(settingsEnvironmentId, settingsProjectId, settingsPageState.open and settingsPageState.route == "integrations", settingsPageState.refresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, fdaPoll) as shape IntegrationsPage
  state fdaPoll = 0 // Poll Full Disk Access every 1.5 s and on window focus, only while visible; fdaPoll refreshes the wizard.
  task fdaPolling when integrations.browserProfiles.wizard.step == "fullDiskAccess" and page.visibilityState == "visible"
    every(1500, fdaTick)
  task fdaFocused when integrations.browserProfiles.wizard.step == "fullDiskAccess" and page.hasFocus and page.visibilityState == "visible"
    after(1, fdaTick)
  action fdaTick
    fdaPoll = fdaPoll + 1
  // However the import wizard closes (Cancel, Escape, Close, its X), Base UI's Dialog gives
  // the focus back to Add profile, whose menu opened it (the reference over CDP: Cancel by mouse leaves BUTTON "Add profile").
  state importWizardShown = false
  task importWizardFocus when integrations.browserProfiles.wizard.open != importWizardShown
    after(1, importWizardFlip)
  action importWizardFlip
    applyUi(decideImportWizardFlip(importWizardShown, integrations))
  state importWizardAt = -1 // Wizard step/grant changes keep surviving focus or fall back to the popup. Removal returns to row options, then Add profile if deleted.
  state importWizardFocused = ""
  task importWizardStepFocus when integrations.browserProfiles.wizard.focusAt != importWizardAt
    after(1, importWizardStep)
  action importWizardStep
    applyUi(decideImportWizardStep(importWizardAt, importWizardFocused, integrations))
  state removalAt = ""
  task removalFocus when integrations.browserProfiles.removalId != removalAt
    after(1, removalFlip)
  action removalFlip
    applyUi(decideRemovalFlip(integrations, removalAt))
  resource storageSettings = storageSettings(settingsEnvironmentId, settingsProjectId, settingsPageState.open and settingsPageState.route == "storage", settingsPageState.refresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, wallTime.epochAtZero + elapsed) as shape StoragePage
  resource archives = archivedSettings(settingsEnvironmentId, settingsProjectId, settingsPageState.open and settingsPageState.route == "archived", wallTime.epochAtZero + elapsed, settingsPageState.refresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout) as shape ArchivePage
  resource licenses = licenseSettings(licenseQuery, licenseExpanded, licenseRetry, settingsPageState.open and settingsPageState.route == "open-source-licenses", data.revision) as shape LicenseSettings
  resource diagnostics = diagnosticsSettings(settingsEnvironmentId, diagnosticPeriod, settingsPageState.open and settingsPageState.route == "diagnostics", wallTime.epochAtZero + elapsed, settingsPageState.refresh, data.revision, data.telemetry) as shape DiagnosticsPage // a telemetry sample asks only this page again (data.telemetry); its reads are shared, so one asked again before a reply joins it (diagnostics-view.ts)
  resource snapshotSettings = snapshotSettings(settingsPageState.open and settingsPageState.route == "snap-shot", settingsPageState.refresh, data.revision, page.hasFocus) as shape SnapshotSettings // SnapShotSettings refreshState on window focus (exact2 #219): back from System Settings, the permissions read again
  resource settingsNavigation = settingsNavigation(settingsPageState.query, settingsCore.kind, settingsPageState.resultIndex, data.revision) as shape CoreNav
  state settingsProjectId = ""
  state settingsEnvironmentId = ""
  state settingsMachine = ""
  state settingsProjectKey = ""
  state settingsCheckout = ""
  state settingsMenu = ""
  // A page is its route, scope and restore count, as routes/settings.tsx keys its Outlet on the scope search and
  // restoreSignal: a new page mounts a new scroller at its top, and the jump's offset belongs to the page it revealed on.
  derive settingsPage = `${settingsPageState.route}|${settingsMachine}|${settingsProjectKey}|${settingsCheckout}|${settingsPageState.restores}`
  task settingsPageLeft key = `${settingsPageState.open}|${settingsPage}`
    after(1, settingsPageForget)
  action settingsPageForget
    let scrollPage = (settingsPageState.open and
      settingsPageState.scrollPage == settingsPage ? settingsPageState.scrollPage : "")
    settingsPageState = SettingsPageState(settingsPageState, scrollPage=scrollPage)
  state themeReveal = ""
  task themeInspectRevealed when themeReveal != "" and settingsCore.editor.open and settingsCore.editor.filter == "" and (settingsCore.editor.advanced or themeReveal == "canvas" or themeReveal == "accent") key = themeReveal
    after(1, themeRevealed)
  action themeRevealed
    applyUi(decideThemeRevealed(themeReveal, viewport))
  state themeUsage = []
  task themeUsageRefresh when settingsCore.editor.open key = settingsCore.editor.session
    every(100, themeUsageRead)
  action themeUsageRead
    themeUsage = settingsCore.editor.allRows.map((row) => ThemeRoleUsage(role=row.role, label=row.label, primaryIds=querySelectorAll(`[data-pick~="${row.role}"]`), nodes=querySelectorAll(`[data-paint~="${row.role}"]`).map((id) => ThemeUse(id=id, frame=frame(id))).filter((node) => node.frame.width > 0 and node.frame.height > 0)))
  state settingsThemeDialog = ""
  state settingsThemeSubject = ""
  resource delivery = exactDelivery() as shape AboutDelivery // the binary's own update facts (settings-a-about)
  resource settingsCore = settingsCore(settingsMachine, settingsProjectKey, settingsCheckout, settingsProjectId, settingsPageState.route, settingsPageState.focusTarget, settingsPageState.open, settingsPageState.refresh, data.revision, settingsThemeDialog, settingsThemeSubject, delivery.stream, delivery.staged, scheme) as shape SettingsCore
  resource settings = settings(settingsEnvironmentId, settingsProjectId, data.revision, composerDraft.focused, modal, data.running, data.threadId != "", composerMenu.modelsOpen) as shape Settings
  resource projectsSettings = projectsView(settingsProjectKey, settingsCheckout, settingsProjectId, settingsPageState.open and settingsPageState.route == "projects", settingsPageState.refresh, data.revision) as shape ProjectsPage
  state sbQuery = ""
  state sbLetters = ""
  state sbLettersEdited = false
  state sbEmoji = ""
  state sbSshHost = ""
  resource sbSshHosts = settingsBSshHosts(connecting, sbSshHost, data.revision) as shape SbSshHosts
  state sshResponse = initialSshResponseState()
  resource sshPrompt = sshPrompt(wallTime.epochAtZero + sshResponse.now) as shape SshPromptView
  mutation sshAnswered as shape SshPromptAnswer refreshes sshPrompt then sshAnswerDone
  task sshClock mount
    every(1000, sshTick)
  action sshTick
    applyUi(decideSshTick(commandPending, connecting, sshPrompt, sshResponse))
  action sshAnswerDone
    sshResponse = SshResponseState(sshResponse, responding=false)
  resource pairFields = pairingFields(connecting ? origin : "") as shape PairFields // a pasted pairing URL fills Host and Pairing code
  resource sbPicker = settingsBPicker(restEditor, sbQuery, (sbLettersEdited ? sbLetters : projectsSettings.iconLetters), sbEmoji, projectsSettings.iconCwd, projectsSettings.name, data.revision) as shape SbPicker
  state composerMenu = initialComposerMenuState()
  resource catalog = modelCatalog(composerMenu.browseProvider, composerMenu.modelQuery, data.revision, composerMenu.modelTarget.id) as shape PickerCatalog
  resource editor = composerEditor(data.revision, wallTime.epochAtZero + elapsed) as shape ComposerEditorView // composer-editor.ts
  resource chip = composerChip(data.revision) as shape ChipPopover // a skill chip's details popover (composer-chip-popover.ts)
  mutation chipObserved as shape ChipPopover queue refreshes chip
  mutation chipPressed as shape ChipPopover queue refreshes chip
  state chipFocusedId = ""
  state chipFinished = 0
  action chipFocusChanged(target: string)
    chipFocusedId = target
  task chipFinish when chip.finish.seq > chipFinished key = chip.finish.seq
    after(1, chipFinishRun)
  action chipFinishRun
    let item = chip.finish
    let focused = chipFocusedId
    chipFinished = item.seq
    chipComplete(item, focused)
  action chipComplete(item: ComposerChipFinish, focused: string)
    let preview = item.surface == "preview"
    let target = preview ? "prompt-font-preview" : "composer"
    let covered = preview ? connecting or projectsOpen or paletteSession.open or providerWizardState.dialog != "" or restEditor != "" or welcome.show or querySelectorAll("[data-dialog-focus~=\"open\"]").length > 0 : modal
    if not covered and item.seq == chip.finish.seq and item.generation == (preview ? richPromptPreview.generation : richComposer.generation) and item.snapshotOwner == data.snapshotOwner and (preview ? promptPreviewVisible and item.owner == promptPreviewOwner and item.value == previewState.text and item.inputSerial == previewState.serial and not previewState.composing : composerFieldLive and item.owner == richComposerOwner and item.value == composerText and item.inputSerial == fieldProtocol.inputSerial and not composerDraft.composing) and frame(target).width > 0
      if item.focus == "after" or item.focus == "select" or (item.focus == "outside" and (focused == "" or focused == "chip-popover" or focused == "citation-comment-text"))
        focus(target)
        setSelectionRange(target, item.focus == "select" ? item.start : item.end, item.end)
      if item.send and not preview and not commandPending and data.canSend and data.requestMode != "question"
        commandPending = true
        send changed = command("send-citation", `${item.seq}`, "", 0)
        composerDraft = ComposerDraftState(composerDraft, typing=false, owner="__unset__")
        jumpRequest = jumpRequest + 1
  derive chipCovered = chip.open and chip.surface == "composer" and (settingsPageState.open or pageCover) // Close chip details when Settings/pages cover our mounted composer; palette/dialog overlays preserve them, as the reference does.
  task chipCover when chipCovered key = chip.seq
    after(1, chipCoverClose)
  action chipCoverClose
    editorOp("chip-close", `${chip.seq}`, "")
  // A chip press that is an action (a mention, thread, citation source, pull request or attachment; composer-chip-details.ts)
  // is sent once, in its own turn.
  state chipActed = 0
  task chipAct when chip.act != "" and chip.seq > chipActed key = chip.seq
    after(1, chipActRun)
  action chipActRun
    applyUi(decideChipActRun(chip, wallTime))
  state branchQuery = ""
  resource branches = composerBranches(composerMenu.optionsOpen == "branch", branchQuery, data.revision, shellClock) as shape ComposerBranches
  state origin = ""
  state originEdited = false
  state composerDraft = initialComposerDraftState()
  state draggedWidth = 0
  state sidebarHoverId = ""
  state jumpRequest = 0
  state composerSelection = initialComposerSelectionState()
  state intentState = initialComposerIntentState()
  mutation composerEdited as shape ComposerIntentReply queue then composerEditDone
  state fieldProtocol = initialComposerFieldProtocol()
  derive composerFieldLive = not modal and data.requestMode != "approval" and not data.composer.subagent
  derive composerFieldSnapshot = ComposerFieldObservation(generation=richComposer.generation, snapshotOwner=data.snapshotOwner, owner=richComposerOwner, value=composerText, start=(composerSelectionCurrent ? composerSelection.start : 0), end=(composerSelectionCurrent ? composerSelection.end : 0), composing=composerDraft.composing, live=composerFieldLive, focused=composerDraft.focused, inputSerial=fieldProtocol.inputSerial)
  resource composerFieldNext = composerField(composerFieldSnapshot, fieldProtocol.after, data.revision) as shape ComposerFieldCommand
  mutation composerFieldChanged as shape ComposerFieldResult queue refreshes editor
  mutation composerFieldAck as shape ComposerFieldAcknowledgement queue refreshes richComposer, chip, shell, composerFieldNext, data, editor then composerFieldAckDone
  task composerFieldDeliver when composerFieldNext.ready and composerFieldNext.seq > fieldProtocol.after key = composerFieldNext.seq
    after(1, composerFieldApply)
  action composerFieldApply
    let item = composerFieldNext
    let admitted = (item.ready and composerFieldLive and frame("composer").width > 0 and
      item.generation == richComposer.generation and item.snapshotOwner == data.snapshotOwner and
      item.owner == richComposerOwner and item.value == composerText and not composerDraft.composing)
    fieldProtocol = recordComposerFieldAdmission(fieldProtocol, item, admitted)
    if admitted
      if item.focus
        focus("composer")
      setRangeText("composer", item.text, item.start, item.end, "preserve")
      setSelectionRange("composer", item.selectionStart, item.selectionEnd)
  task composerFieldConfirm when fieldProtocol.after > fieldProtocol.acked key = fieldProtocol.after
    after(1, composerFieldConfirmRun)
  action composerFieldConfirmRun
    fieldProtocol = ComposerFieldProtocol(fieldProtocol, acked=fieldProtocol.after)
    send composerFieldAck = composerFieldAcknowledged(ComposerFieldObservation(generation=richComposer.generation, snapshotOwner=data.snapshotOwner, owner=richComposerOwner, value=composerText, start=(composerSelectionCurrent ? composerSelection.start : 0), end=(composerSelectionCurrent ? composerSelection.end : 0), composing=composerDraft.composing, live=(composerFieldLive and frame("composer").width > 0), focused=composerDraft.focused, inputSerial=fieldProtocol.inputSerial), fieldProtocol.target.seq, fieldProtocol.admitted)
  action composerFieldAckDone
    applyCompletion(decideComposerFieldAckDone(commandPending, composerDraft, composerFieldAck,
        composerSelection, composerSelectionCurrent, composerText, data, editor, fieldProtocol,
        jumpRequest, richComposer, richComposerOwner, composerMenu))
  derive composerFieldFocusCurrent = composerFieldLive and fieldProtocol.focus.generation == richComposer.generation and fieldProtocol.focus.snapshotOwner == data.snapshotOwner and fieldProtocol.focus.owner == richComposerOwner and fieldProtocol.focus.value == composerText and not composerDraft.composing and fieldProtocol.focus.seq == fieldProtocol.effects and fieldProtocol.focus.inputSerial == fieldProtocol.inputSerial and composerSelectionCurrent and fieldProtocol.focus.start == composerSelection.start and fieldProtocol.focus.end == composerSelection.end
  task composerFieldRestoreFocus when fieldProtocol.focus.seq > fieldProtocol.focusDone and (not composerFieldFocusCurrent or data.snapshotDrafts.filter((image) => image.id == fieldProtocol.focus.removedImage).length == 0) key = fieldProtocol.focus.seq
    after(1, composerFieldFocusRun)
  action composerFieldFocusRun
    fieldProtocol = ComposerFieldProtocol(fieldProtocol, focusDone=fieldProtocol.focus.seq)
    if composerFieldFocusCurrent and data.snapshotDrafts.filter((image) => image.id == fieldProtocol.focus.removedImage).length == 0 and frame(fieldProtocol.focus.focus).width > 0
      focus(fieldProtocol.focus.focus)
  derive composerRichCurrent = richComposer.owner == richComposerOwner and richComposer.value == composerText
  derive composerSelectionCurrent = composerSelection.owner == richComposerOwner and composerSelection.value == composerText
  derive composerIntentContextCurrent = intentState.observed.owner == richComposerOwner and intentState.observed.snapshotOwner == data.snapshotOwner and intentState.observed.generation == richComposer.generation and intentState.mode == richComposer.mode and composerFieldLive and not composerDraft.composing
  derive composerIntentBaseCurrent = composerIntentContextCurrent and intentState.observed.value == composerText and intentState.observed.inputSerial == fieldProtocol.inputSerial and composerSelectionCurrent and intentState.observed.start == composerSelection.start and intentState.observed.end == composerSelection.end
  derive composerIntentReceiptCurrent = composerIntentContextCurrent and composerText == intentState.expected and fieldProtocol.inputSerial == intentState.observed.inputSerial + 1 and composerSelectionCurrent and composerSelection.start == intentState.start and composerSelection.end == intentState.end
  task composerIntentReady when intentState.queue.length > 0 and intentState.phase == "" key = `${intentState.serial}|${fieldProtocol.inputSerial}`
    after(1, composerIntentPump)
  task composerIntentReceipt when intentState.phase == "projection" and composerIntentReceiptCurrent and composerRichCurrent key = `${intentState.active}|${fieldProtocol.inputSerial}|${richComposer.value}|${composerSelection.start}:${composerSelection.end}`
    after(1, composerIntentConfirmed)
  // A format command that changed nothing reports no input: its turn ends here.
  task composerIntentFormatQuiet when intentState.phase == "format" key = intentState.active
    after(250, composerIntentFormatSettled)
  action composerIntentFormatSettled
    applyState(decideComposerIntentFormatSettled(composerIntentBaseCurrent, intentState))
  task composerIntentInvalidated when intentState.queue.length > 0 and not composerIntentContextCurrent key = `${data.snapshotOwner}|${richComposerOwner}|${richComposer.generation}|${richComposer.mode}|${composerDraft.composing}|${composerFieldLive}`
    after(1, composerIntentCancelStale)
  task composerIntentOwnerNotice key = `${data.snapshotOwner}|${richComposerOwner}|${richComposer.generation}`
    after(1, composerIntentOwnerChanged)
  action composerIntentOwnerChanged
    applyState(decideComposerIntentOwnerChanged(data, intentState, richComposer, richComposerOwner))
  action composerIntentCancelStale
    applyState(decideComposerIntentCancelStale(composerIntentContextCurrent, intentState))
  action composerIntentPump
    applyUi(decideComposerIntentPump(composerIntentBaseCurrent, composerRichCurrent,
        composerSelection, composerText, data, fieldProtocol, intentState, richComposer,
        richComposerOwner))
  action composerEditDone
    applyCompletion(decideComposerEditDone(commandPending, composerEdited,
        composerIntentBaseCurrent, composerRichCurrent, composerText, data, editor, intentState,
        jumpRequest, richComposer, richComposerOwner, composerDraft))
  action composerIntentConfirmed
    applyState(decideComposerIntentConfirmed(composerFieldSnapshot, composerIntentReceiptCurrent,
        composerRichCurrent, intentState))
  // COMPOSER_TYPING_IDLE_MS: the draft's last edit in the focused composer, until 1.5 s pass without another.
  task composerTypingIdle when composerDraft.typing key = composerDraft.typingSerial
    after(1500, composerTypingIdled)
  action composerTypingIdled
    composerDraft = ComposerDraftState(composerDraft, typing=false)
  state modifierOwnership = initialModifierOwnershipState()
  action releaseUndoClaim
    let until = data.sidebar.undoUntil
    if until > modifierOwnership.undoReleasedUntil
      modifierOwnership = ModifierOwnershipState(modifierOwnership, undoReleasedUntil=until)
  action modifiersForget
    applyState(decideModifiersForget(modifierOwnership))
  task modifiersBlur when not page.hasFocus and (anyShortcutModifier(modifierOwnership.shortcut) or anyShortcutModifier(modifierOwnership.speed))
    after(1, modifiersForget)
  // useThreadJumpHintVisibility: the hints show THREAD_JUMP_HINT_SHOW_DELAY_MS after a thread.jump.N shortcut's
  // modifiers are held alone and hide at once when they are not (shouldShowThreadJumpHintsForModifiers; the
  // sidebar's view lists those modifiers, none while the terminal has the focus or a search is open).
  derive threadJumpsHeld = (data.legacy.enabled ? data.legacy.jumpModifiers : data.sidebar.jumpModifiers).includes(heldModifiers(modifierOwnership.shortcut.metaKey, modifierOwnership.shortcut.ctrlKey, modifierOwnership.shortcut.altKey, modifierOwnership.shortcut.shiftKey))
  state threadJumpHintsShown = false
  task threadJumpHintDelay when threadJumpsHeld and not threadJumpHintsShown
    after(200, threadJumpHintsShow)
  task threadJumpHintReset when threadJumpHintsShown and not threadJumpsHeld
    after(1, threadJumpHintsHide)
  action threadJumpHintsShow
    threadJumpHintsShown = true
  action threadJumpHintsHide
    threadJumpHintsShown = false
  // ChatView's thread effect: the composer takes the focus a frame after a thread opens while the terminal is closed.
  task composerOnThread when data.threadId != "" and not terminalDrawer.open key = data.threadId
    after(1, composerOnThreadFocus)
  action composerOnThreadFocus
    focus("composer")
  derive modal = connecting or projectsOpen or paletteSession.open or settingsPageState.open or providerWizardState.dialog != "" or restEditor != "" or welcome.show
  resource sidebarLaunch = sidebarLaunchWidth(viewport.width, data.revision) as shape number // threadSidebarWidth.ts (sidebar-width.ts): no stored width sizes the sidebar once at load
  derive sidebarWidth = draggedWidth == 0 and sidebarLaunch > 0 ? sidebarLaunch : min(max(max(208, data.sidebarMinWidth), draggedWidth > 0 ? draggedWidth : data.sidebarWidth), max(max(208, data.sidebarMinWidth), viewport.width - 640)) // a stored width: at least the minimum (13rem, or the brand at the Interface font size: sidebar-min-width.ts), leaving 40rem of main content
  derive narrowDiff = viewport.width <= 980
  state diffUserWidth = 540
  derive diffWidth = narrowDiff ? (viewport.width <= 760 ? min(viewport.width * 0.88, 384) : min(448, max(320, viewport.width * 0.42))) : max(360, min(diffUserWidth, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action resizeDiff(dx: number, dy: number)
    diffUserWidth = max(360, min(diffWidth - dx, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action finishDiffResize(vx: number, vy: number)
    diffUserWidth = diffWidth
  derive conversationWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - ((data.diffOpen or rightPanel or shell.panel.open) and not narrowDiff ? diffWidth : 0)
  derive composerText = composerDraft.owner == `${data.composerOwner}${data.requestKey}` ? composerDraft.value : data.draft
  derive richComposerOwner = `${data.composerOwner}${data.requestKey}`
  resource richComposer = composerRich(data.snapshotOwner, richComposerOwner, composerText, data.revision, composerDraft.inputType, "composer") as shape ComposerRichView
  state previewState = initialPromptPreviewState()
  derive promptPreviewOwner = `${data.snapshotOwner}:prompt-preview`
  derive promptPreviewVisible = settingsPageState.open and settingsPageState.route == "appearance" and settingsCore.sections.filter((section) => section.rows.filter((row) => row.info == "preview-prompt").length > 0).length > 0
  resource richPromptPreview = composerRich(data.snapshotOwner, promptPreviewOwner, previewState.text, data.revision, previewState.inputType, "preview") as shape ComposerRichView
  task promptPreviewLifecycle key = `${promptPreviewOwner}|${promptPreviewVisible}|${richPromptPreview.generation}`
    after(1, promptPreviewMounted)
  action promptPreviewMounted
    let before = previewState
    let serial = before.serial + 1
    previewState = PromptPreviewState(before, serial=serial)
    observePromptPreview(before.text, before.start, before.end, before.composing, serial)
  action observePromptPreview(value: string, start: number, end: number, composing: bool, serial: number)
    send chipObserved = composerChipObserved(ComposerFieldObservation(generation=richPromptPreview.generation, snapshotOwner=data.snapshotOwner, owner=promptPreviewOwner, value=value, start=min(value.length, start), end=min(value.length, end), composing=composing, live=(promptPreviewVisible and frame("prompt-font-preview").width > 0), focused=false, inputSerial=serial))
  task promptPreviewHidden when not promptPreviewVisible
    after(1, promptPreviewReset)
  action promptPreviewReset
    let value = promptPreviewSample()
    let next = resetPromptPreviewState(previewState, value)
    previewState = next
    observePromptPreview(value, 0, 0, false, next.serial)
  action menuCommand(op: string, id: string, value: string, n: number)
    composerMenu = ComposerMenuState(composerMenu, optionsOpen="")
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, n)
  action menuPick(op: string, id: string, value: string)
    composerMenu = ComposerMenuState(composerMenu, optionsOpen="")
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, 0)
  action commandCompleted
    applyCommandCompletion(decideCommandCompleted(bindings, changed, confirmationState, data,
        jumpRequest, noticeExitState, pageTrail, paletteSession, pendingModal, providerWizardState,
        renameAfterId, renameAfterOp, restEditor, restSubject, routeKeyboard, routeKeyboardOwned,
        settings, settingsPageState, utilityPage, welcomePaired, keybindingEditor, composerMenu,
        composerDraft))
  action attachFiles(origin: string, files: string[], picked: Picked[], asText: bool, target: string)
    send filesAdded = composerAttach(origin, files, picked, asText, target)
  action filesAddedDone
    applyCompletion(decideFilesAddedDone(commandPending, filesAdded, jumpRequest, composerDraft))
  action chooseAttachments
    showPicker("composer-attach-input")
  action editKeybindingQuery(value: string)
    keybindingQuery = value
  action editKeybindingWhen(value: string)
    keybindingWhen = value
  // The search jump's target page has its data: the jump scrolls once that page is laid out.
  derive settingsJumpReady = settingsPageState.open and settingsPageState.focusTarget != "" and (settingsPageState.route != "storage" or storageSettings.available) and (settingsPageState.route != "archived" or archives.available) and (settingsPageState.route != "diagnostics" or diagnostics.available) and (settingsPageState.route != "keybindings" or bindings.available) and (settingsPageState.route != "scheduled-tasks" or scheduled.available) and (settingsPageState.route != "source-control" or sourceControl.available) and (settingsPageState.route != "integrations" or integrations.available) and ((settingsPageState.route != "general" and settingsPageState.route != "appearance") or (settingsCore.ready and settingsCore.route == settingsPageState.route and settingsCore.sections.length > 0))
  action focusSettingsTarget
    if settingsJumpReady
      let before = settingsPageState
      let targetPage = settingsPage
      let top = (
        max(0, frame(before.focusTarget).y - frame("settings-content-column").y +
          frame(before.focusTarget).height / 2 - frame("settings-content-scroll").height / 2) +
        (before.scrollTop == floor(before.scrollTop) ? 0.25 : 0)
      )
      settingsPageState = SettingsPageState(before, scrollPage=targetPage, scrollTop=top, focusTarget="")
      focus(before.focusTarget)
  // As scrollToSettingsTarget runs once the hash target mounts: a native `after(1, …)` runs after the layout the
  // change made. The poll below is a backstop.
  task settingsJump when settingsJumpReady key = `${settingsPageState.focusTarget}|${settingsPage}`
    after(1, focusSettingsTarget)
  task settingsSearchFocus mount
    every(1000, focusSettingsTarget)
  action coreMenuClose
    settingsMenu = ""
  action coreNoticeScope(project: string, machine: string, member: string)
    settingsMenu = ""
    modalError = ""
    providerSelected = ""
    providerLinkTarget = ""
    settingsProjectKey = project
    settingsCheckout = ""
    settingsProjectId = member
    settingsMachine = machine
  mutation automationRecordingServed0 as shape Change queue refreshes data // the agent's recordings: four sends, each queued (automationRecording)
  mutation automationRecordingServed1 as shape Change queue refreshes data
  mutation automationRecordingServed2 as shape Change queue refreshes data
  mutation automationRecordingServed3 as shape Change queue refreshes data
  mutation themeLive as shape Change refreshes data // the colour picker's own, so no other local op forgets its reply (the picker waits for it)
  action coreThemeLive(part: string, id: string, value: string, n: number) // the colour picker's draft ops (theme-color-picker.contract), never behind another command
    send themeLive = command(`themelocal:${part}`, id, value, n)
  state restEditor = ""
  state restSubject = ""
  state taskBase = "" // the scheduled editor's picker: its project, base and search (settings-scheduled.contract taskPicker), new with each editor
  action editLicenseQuery(value: string)
    licenseQuery = value
  action toggleLicense(id: string)
    licenseExpanded = licenseExpanded == id ? "" : id
  action retryLicenses
    licenseRetry = licenseRetry + 1
  action selectDiagnosticPeriod(value: string)
    diagnosticPeriod = value
  action connectionAskRemove(target: string)
    connectionRemove = target
    connectionMenu = ""
  action editorOp(op: string, id: string, value: string) // composer-editor.ts: menu picks, the stash
    send localChanged = command(`editorlocal:${op}`, id, value, wallTime.epochAtZero + performanceNow())
  action prConfirmDisarm(ref: string, serial: string)
    send prConfirmChanged = command("chatlocal:pr-ui-disarm", ref, serial, 0)
  state foldHold = false
  state shellClock = 0
  state toastDismissed = ""
  state toastHover = false
  state shellOpenHandled = ""
  resource page = exactPage() as shape Page // the window's focus and visibility (document.hasFocus(), exact2 #219): thread notifications and activity reports
  resource shell = shellView(data.revision, wallTime.epochAtZero + shellClock, toastDismissed, toastHover, viewport.width <= 980, page.hasFocus, page.visibilityState, not settingsPageState.open and not pageCover and not welcome.show) as shape ShellView // the last: the chat view is shown (proactive panels)
  resource filesMarkdown = renderFileMarkdown(shell.panel.files.markdownSource.concat(shell.panel.attachment.markdownSource).concat(shell.composerFile.file.markdownSource)) as shape TranscriptMarkdown
  state rightPanelAt = ""
  derive rightPanel = (rightPanelAt != "" and rightPanelAt == shell.panel.key) or shell.panel.launcher
  state detailsOpen = false
  resource details = shellDetails(detailsShown, data.threadId, data.revision, conversationWidth >= 1012, wallTime.epochAtZero + shellClock, floor(viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - conversationWidth), page.hasFocus and page.visibilityState == "visible", lineageWorkflows, lineagePhasesOpen, lineagePhasesClosed) as shape ShellDetails
  state canvasGestureValue = ""
  resource canvas = chatCanvas(data.revision, conversationWidth, viewport.height, conversationWidth >= 1012 and data.projectId != "", data.look.chatMax, data.messages.length > 0 or data.threadId != "", canvasGestureValue, `${shell.panel.deviceMini.key}|${shell.panel.browserMini.key}`, shell.panel.deviceMini.show or shell.panel.browserMini.show, conversationWidth >= 1012, detailsOpen) as shape ChatCanvasView
  state detailsEpoch = 0
  derive detailsPopover = canvas.ready ? canvas.popover : conversationWidth < 1012
  derive detailsShown = detailsOpen and detailsPopover and detailsEpoch == canvas.popoverEpoch
  resource terminalDrawer = terminalDrawer(data.revision, viewport.height, wallTime.epochAtZero + elapsed) as shape TerminalDrawerView // terminal-drawer-view.ts
  state titleDialog = false
  state confirmationState = initialConfirmationState()
  state terminalCloseHandled = 0
  task shellTicks mount
    every(500, shellTick)
  action shellTick
    applyState(decideShellTick(commandPending, shell))
  task sidebarDialogFocus when data.sidebar.dialog != "" and not paletteSession.open key = data.sidebar.dialog // and again as the palette over it closes (its finalFocus); a dialog the sidebar opens takes the focus at its first stop, however it opened (Base UI's initialFocus)
    after(1, focusSidebarDialog)
  action focusSidebarDialog
    applyUi(decideFocusSidebarDialog(data))
  task snoozeCalendarFocus when data.sidebar.calendar.focusSeq > 0 key = data.sidebar.calendar.focusSeq // a key moved the date popover's focus (snooze-calendar.ts)
    after(1, focusSnoozeDay)
  action focusSnoozeDay
    focus(`snooze-day-${data.sidebar.calendar.focus}`)
  task titleDialogClosed when titleDialog and data.sidebar.dialog == "" // however it closes (Snooze too), the title menu's dialog gives the focus back to the title (Base UI's finalFocus)
    after(1, returnTitleFocus)
  action returnTitleFocus
    applyUi(decideReturnTitleFocus())
  state annotationSendHandled = 0
  task annotationSend when shell.panel.annotationSend > annotationSendHandled key = shell.panel.annotationSend
    after(1, annotationSendNow)
  action annotationSendNow
    applyUi(decideAnnotationSendNow(commandPending, composerDraft, composerText, data, jumpRequest,
        richComposer, richComposerOwner, shell))
  state automationRecordingHandled = 0
  task automationRecording when shell.panel.automationRecording.serial > automationRecordingHandled key = shell.panel.automationRecording.serial
    after(1, automationRecordingNow)
  action automationRecordingNow
    applyUi(decideAutomationRecordingNow(shell))
  task terminalCloseAsk when shell.panel.terminalClose.serial > terminalCloseHandled and confirmationState.op == "" key = shell.panel.terminalClose.serial // Gated tasks (exact2 #192), not a 500 ms poll: a terminal close asks, and a thread the module opened is selected, at once.
    after(1, terminalCloseConfirm)
  action terminalCloseConfirm
    applyUi(decideTerminalCloseConfirm(confirmationState, shell))
  task shellOpenGuide when shell.openGuideSelected != "" and shell.openRequest != shellOpenHandled key = shell.openRequest
    after(1, shellGuideOpen)
  action shellGuideOpen
    applyState(decideShellGuideOpen(pageTrail, shell, utilityPage, settingsPageState))
  task shellOpen when shell.openGuideSelected == "" and shell.openRequest != "" and shell.openRequest != shellOpenHandled and shell.openThreadId != "" and not commandPending key = shell.openRequest
    after(1, shellOpenThread)
  action shellOpenThread // a clicked notification's thread, or a `t3 app` request's draft (desktop-activation.ts), which leaves Settings and the utility pages as the reference's route change does
    applyUi(decideShellOpenThread(jumpRequest, settingsPageState, shell, utilityPage,
        composerDraft))
  // The reopen after ⌘W (keepRunning hid the window): DesktopLifecycle's `activate` makes a new window, which loads
  // `/` (IndexDraftLanding): Settings, the utility pages and the palette are gone, and the most recent project's
  // draft opens. The closed thread keeps its draft. A minimize or a covering window is no return (exactPage().restores).
  task windowReopen when page.restores > 0 key = page.restores
    after(1, windowReopened)
  action windowReopened
    applyUi(decideWindowReopened(paletteSession, settingsPageState))
  action toastHovering(over: bool)
    toastHover = over
  task confirmHand when confirmationState.handing != "" key = confirmationState.handing
    after(200, confirmHanded)
  action confirmHanded
    applyUi(decideConfirmHanded(commandPending, confirmationState, shell))
  state citeWaitAsked = 0
  state citeWaitDone = 0
  state citeDismissals = 0
  task citeWait when citeWaitAsked > citeWaitDone key = citeWaitAsked
    after(500, citeWaitOver)
  action citeWaitOver
    citeWaitDone = citeWaitAsked
  action citeWaitAsk(seq: number)
    citeWaitAsked = seq
  task citeBlur when not page.hasFocus
    after(1, citeDismissed)
  task citeContext key = `${viewport.width}x${viewport.height}|${data.threadId}|${pageCover}|${settingsPageState.open}|${modal}`
    after(1, citeDismissed)
  action citeDismissed
    citeDismissals = citeDismissals + 1
  // Cite back after a scroll: the transcript's scrollend (the offset still for 100 ms) and 50 ms more make the reference's
  // 150 ms after the last scroll (observeSelectionActions' SELECTION_SCROLL_SETTLE_MS).
  state citeSettleAsked = 0
  state citeSettleDone = 0
  task citeSettle when citeSettleAsked > citeSettleDone key = citeSettleAsked
    after(50, citeSettleOver)
  action citeSettleOver
    citeSettleDone = citeSettleAsked
  action citeSettleAsk(seq: number)
    citeSettleAsked = seq
  action applyPlacement(d: AppDecision)
    if d.scrollKind == "transcript-smooth"
      scrollIntoView("transcript", d.scrollRow, offset=d.scrollOffset, behavior="smooth")
    else if d.scrollKind == "transcript"
      scrollIntoView("transcript", d.scrollRow, offset=d.scrollOffset, behavior="instant")
    applyState(d)
  action applyState(d: AppDecision)
    if d.writeAnnotationSendHandled
      annotationSendHandled = d.annotationSendHandled
    if d.writeAutomationRecordingHandled
      automationRecordingHandled = d.automationRecordingHandled
    if d.writeBranchQuery
      branchQuery = d.branchQuery
    if d.writeCanvasGestureValue
      canvasGestureValue = d.canvasGestureValue
    if d.writeChipActed
      chipActed = d.chipActed
    if d.writeCitationPlacement
      citationPlacement = d.citationPlacement
    if d.writeCodeRevealHandled
      codeRevealHandled = d.codeRevealHandled
    applyPanelState(d)
    if d.writeComposerMenu
      composerMenu = d.composerMenu
    if d.writeComposerSelection
      composerSelection = d.composerSelection
    if d.writeConfirmationState
      confirmationState = d.confirmationState
    if d.writeConnecting
      connecting = d.connecting
    if d.writeConnectionMenu
      connectionMenu = d.connectionMenu
    if d.writeConnectionRemove
      connectionRemove = d.connectionRemove
    if d.writeDetailsEpoch
      detailsEpoch = d.detailsEpoch
    if d.writeDetailsOpen
      detailsOpen = d.detailsOpen
    if d.writeDraggedWidth
      draggedWidth = d.draggedWidth
    if d.writeWindowClock
      elapsed = d.elapsed
      windowReturns = d.windowReturns
    if d.writeFieldProtocol
      fieldProtocol = d.fieldProtocol
    if d.writeFindPlacement
      findPlacement = d.findPlacement
    if d.writeFoldHold
      foldHold = d.foldHold
    if d.writeGuideFinishHandled
      guideFinishHandled = d.guideFinishHandled
    applyHover(d)
    if d.writeImportWizardAt
      importWizardAt = d.importWizardAt
    if d.writeImportWizardFocused
      importWizardFocused = d.importWizardFocused
    if d.writeImportWizardShown
      importWizardShown = d.importWizardShown
    if d.writeIntentState
      intentState = d.intentState
    if d.writeKeybindingEditor
      keybindingEditor = d.keybindingEditor
    if d.writeKeybindingWhen
      keybindingWhen = d.keybindingWhen
    if d.writeLineagePhases
      lineagePhasesClosed = d.lineagePhasesClosed
      lineagePhasesOpen = d.lineagePhasesOpen
    if d.writeLineageStopping
      lineageStopping = d.lineageStopping
    if d.writeLineageWorkflows
      lineageWorkflows = d.lineageWorkflows
    if d.writeLiveNow
      liveNow = d.liveNow
    if d.writeModalError
      modalError = d.modalError
    if d.writeModifierOwnership
      modifierOwnership = d.modifierOwnership
    if d.writeNoticeExitState
      noticeExitState = d.noticeExitState
    if d.writeOrigin
      origin = d.origin
    if d.writeOriginEdited
      originEdited = d.originEdited
    if d.writePageTrail
      pageTrail = d.pageTrail
    if d.writePaletteSession
      paletteSession = d.paletteSession
    if d.writePendingModal
      pendingModal = d.pendingModal
    if d.writePrApplied
      prApplied = d.prApplied
    if d.writePrPanelOpen
      prPanelOpen = d.prPanelOpen
    if d.writePrSearch
      prQuery = d.prQuery
      prTyped = d.prTyped
    if d.writePrSelected
      prSelected = d.prSelected
    if d.writePrTab
      prTab = d.prTab
    if d.writePreviewState
      previewState = d.previewState
    if d.writeProjectsOpen
      projectsOpen = d.projectsOpen
    if d.writeProviderLinkTarget
      providerLinkTarget = d.providerLinkTarget
    if d.writeProviderNow
      providerNow = d.providerNow
    if d.writeProviderSelected
      providerSelected = d.providerSelected
    if d.writeProviderWizardState
      providerWizardState = d.providerWizardState
    if d.writeRemovalAt
      removalAt = d.removalAt
    if d.writeRenameAfterId
      renameAfterId = d.renameAfterId
    if d.writeRenameAfterOp
      renameAfterOp = d.renameAfterOp
    if d.writeRestEditor
      restEditor = d.restEditor
    if d.writeRestSubject
      restSubject = d.restSubject
    if d.writeRouteKeyboard
      routeKeyboard = d.routeKeyboard
    if d.writeSaveNonce
      saveNonce = d.saveNonce
    if d.writeSbEmoji
      sbEmoji = d.sbEmoji
    if d.writeSbLetters
      sbLetters = d.sbLetters
    if d.writeSbLettersEdited
      sbLettersEdited = d.sbLettersEdited
    if d.writeSbQuery
      sbQuery = d.sbQuery
    if d.writeSbSshHost
      sbSshHost = d.sbSshHost
    if d.writeSettingsWorkspace
      settingsCheckout = d.settingsCheckout
      settingsProjectKey = d.settingsProjectKey
    if d.writeSettingsEnvironmentId
      settingsEnvironmentId = d.settingsEnvironmentId
    if d.writeSettingsMachine
      settingsMachine = d.settingsMachine
    if d.writeSettingsMenu
      settingsMenu = d.settingsMenu
    if d.writeSettingsProjectId
      settingsProjectId = d.settingsProjectId
    if d.writeSettingsThemeDialog
      settingsThemeDialog = d.settingsThemeDialog
    if d.writeSettingsThemeSubject
      settingsThemeSubject = d.settingsThemeSubject
    if d.writeShellClock
      shellClock = d.shellClock
    if d.writeShellOpenHandled
      shellOpenHandled = d.shellOpenHandled
    if d.writeSidebarHoverId
      sidebarHoverId = d.sidebarHoverId
    if d.writeSshResponse
      sshResponse = d.sshResponse
    if d.writeStreamGeometry
      streamGeometry = d.streamGeometry
    if d.writeTaskBase
      taskBase = d.taskBase
    if d.writeTerminalCloseHandled
      terminalCloseHandled = d.terminalCloseHandled
    if d.writeThemeReveal
      themeReveal = d.themeReveal
    if d.writeTitleDialog
      titleDialog = d.titleDialog
    if d.writeToastDismissed
      toastDismissed = d.toastDismissed
    if d.writeTranscriptViewport
      transcriptViewport = d.transcriptViewport
    if d.writeTransportOnline
      transportOnline = d.transportOnline
    if d.writeTransportTable
      transportTable = d.transportTable
    if d.writeUsageDays
      usageDays = d.usageDays
    if d.writeUsageMetric
      usageMetric = d.usageMetric
    if d.writeWelcomeLink
      welcomeLink = d.welcomeLink
    if d.writeWelcomePairFold
      welcomePairFold = d.welcomePairFold
    if d.writeWelcomePaired
      welcomePaired = d.welcomePaired
    if d.writeWelcomeStep
      welcomeStep = d.welcomeStep
    if d.writeWorkspaceNow
      workspaceNow = d.workspaceNow
    if d.writeWorkspaceRetry
      workspaceRetry = d.workspaceRetry

  action applyUi(d: AppDecision)
    applyState(d)
    if d.sendAutomationRecordingServed0
      send automationRecordingServed0 = command(d.record0.p0, d.record0.p1, d.record0.p2,
        d.record0.p3)
    if d.sendAutomationRecordingServed1
      send automationRecordingServed1 = command(d.record1.p0, d.record1.p1, d.record1.p2,
        d.record1.p3)
    if d.sendAutomationRecordingServed2
      send automationRecordingServed2 = command(d.record2.p0, d.record2.p1, d.record2.p2,
        d.record2.p3)
    if d.sendAutomationRecordingServed3
      send automationRecordingServed3 = command(d.record3.p0, d.record3.p1, d.record3.p2,
        d.record3.p3)
    match d.chip
      case some(request)
        send chipPressed = composerChipPressed(request)
      case none
    if d.sendComposerEdited
      send composerEdited = composerIntent(d.intent.p0, d.intent.p1, d.intent.p2, d.intent.p3,
        d.intent.p4, d.intent.p5, d.intent.p6, d.intent.p7, d.intent.p8, d.intent.p9, d.intent.p10,
        d.intent.p11, d.intent.p12)
    if d.sendComposerFieldChanged
      send composerFieldChanged = composerFieldObserved(d.field.p0, d.field.p1)
    if d.sendDraftLeft
      send draftLeft = command(d.draftLeave.p0, d.draftLeave.p1, d.draftLeave.p2, d.draftLeave.p3)
    applyChatSends(projectAppChatSends(d))
    if d.sendHighlightSliced
      send highlightSliced = highlightSlice(d.highlight.p0)
    if d.sendPaletteChanged
      send paletteChanged = paletteCommand(d.palette.p0, d.palette.p1, d.palette.p2)
    if d.changedKind == "command"
      send changed = command(d.command.p0, d.command.p1, d.command.p2, d.command.p3)
    else if d.changedKind == "providerChange"
      send changed = providerChange(d.providerChange.p0, d.providerChange.p1, d.providerChange.p2,
        d.providerChange.p3, d.providerChange.p4, d.providerChange.p5)
    else if d.changedKind == "providerAdd"
      send changed = providerAdd(d.providerAdd.p0, d.providerAdd.p1, d.providerAdd.p2,
        d.providerAdd.p3, d.providerAdd.p4, d.providerAdd.p5, d.providerAdd.p6)
    if d.sendProviderAuthChanged
      send providerAuthChanged = providerChange(d.auth.p0, d.auth.p1, d.auth.p2, d.auth.p3,
        d.auth.p4, d.auth.p5)
    if d.sendProviderUpdateRun
      send providerUpdateRun = providerChange(d.providerUpdate.p0, d.providerUpdate.p1,
        d.providerUpdate.p2, d.providerUpdate.p3, d.providerUpdate.p4, d.providerUpdate.p5)
    if d.sendSecretAnswered
      send secretAnswered = command(d.secret.p0, d.secret.p1, d.secret.p2, d.secret.p3)
    if d.sendServerBrowserMaintained
      send serverBrowserMaintained = serverBrowserStatus(d.browser.p0, d.browser.p1)
    if d.sendServerBrowserMiniMaintained
      send serverBrowserMiniMaintained = serverBrowserStatus(d.miniBrowser.p0, d.miniBrowser.p1)
    if d.sendSshAnswered
      send sshAnswered = sshPromptAnswer(d.ssh.p0, d.ssh.p1)
    if d.sendTerminalChanged
      send terminalChanged = command(d.terminal.p0, d.terminal.p1, d.terminal.p2, d.terminal.p3)
    if d.sendTerminalFocusChanged
      send terminalFocusChanged = command(d.terminalFocus.p0, d.terminalFocus.p1,
        d.terminalFocus.p2, d.terminalFocus.p3)
    if d.sendThreadFindMaintained
      send threadFindMaintained = threadFind(d.find.p0, d.find.p1, d.find.p2, d.find.p3)
    if d.sendTimelineDisclosureChanged
      send timelineDisclosureChanged = command(d.disclosure.p0, d.disclosure.p1, d.disclosure.p2,
        d.disclosure.p3)
    if d.sendTransportPumped
      send transportPumped = transportPump(d.transport.p0, d.transport.p1)
    if d.hostShowPopoverSource
      showPopover(d.showPopoverSource.p0, source=d.showPopoverSource.p1)
    if d.hostPreventDefault
      preventDefault()
    if d.hostStopPropagation
      stopPropagation()
    if d.hostFormat
      format(d.format.p0, d.format.p1)
    applySharedCompletionEffects(d)
    if d.sendWorkspaceRefreshed
      send workspaceRefreshed = refreshComposerWorkspace(d.workspace.p0)
    if d.hostSelectText
      selectText(d.selectText.p0)
    if d.hostSelectionDirection
      setSelectionRange(d.selectionDirection.p0, d.selectionDirection.p1, d.selectionDirection.p2,
        d.selectionDirection.p3)
    if d.scrollKind == "element-instant"
      scrollIntoView(d.scrollTarget, block="nearest", behavior="instant")
    if d.scrollKind == "element-smooth"
      scrollIntoView(d.scrollTarget, block="nearest", behavior="smooth")
    if d.scrollKind == "pr-page"
      scrollIntoView("pr-page-scroll-code", d.scrollRow, block="start")
    if d.scrollKind == "pr-surface"
      scrollIntoView("pr-surface-scroll-code", d.scrollRow, block="start")
    if d.scrollKind == "transcript"
      scrollIntoView("transcript", d.scrollRow, offset=d.scrollOffset, behavior="instant")
    if d.hostSaveFile
      saveFile(d.saveFile.p0, d.saveFile.p1, d.saveFile.p2)
    if d.hostShowPopover
      showPopover(d.showPopover.p0)
    if d.sendChipObserved
      send chipObserved = composerChipObserved(d.previewObservation)

  action applyCompletion(d: AppDecision)
    applyState(d)
    if d.changedKind == "command"
      send changed = command(d.command.p0, d.command.p1, d.command.p2, d.command.p3)
    applySharedCompletionEffects(d)

  action applySharedCompletionEffects(d: AppDecision)
    applyLocalChange(d.sendLocalChanged, d.local)
    if d.sendTimelineReadsRefreshed
      send timelineReadsRefreshed = refreshTimelineReads(d.timeline.p0)
    if d.sendTimelineReadsRefreshedNext
      send timelineReadsRefreshedNext = refreshTimelineReads(d.timelineNext.p0)
    if d.hostFocus
      focus(d.focus.p0)
    if d.hostRangeText
      setRangeText(d.rangeText.p0, d.rangeText.p1, d.rangeText.p2, d.rangeText.p3, d.rangeText.p4)
    if d.hostSelection
      setSelectionRange(d.selection.p0, d.selection.p1, d.selection.p2)
    if d.refreshData
      refresh data
    if d.refreshShell
      refresh shell

  action applyCommandCompletion(d: AppDecision)
    applyState(d)
    if d.sendPrHandoffChanged
      send prHandoffChanged = command(d.prHandoff.p0, d.prHandoff.p1, d.prHandoff.p2,
        d.prHandoff.p3)
    applyLocalChange(d.sendLocalChanged, d.local)
    if d.hostRelaunch
      relaunch()
    if d.hostFocus
      focus(d.focus.p0)

  action applyCommand(d: AppDecision)
    if d.writeModifierOwnership
      modifierOwnership = d.modifierOwnership
    if d.writeCommandPending
      commandPending = d.commandPending
    if d.sendSecretAnswered
      send secretAnswered = command(d.secret.p0, d.secret.p1, d.secret.p2, d.secret.p3)
    if d.sendTimelineDisclosureChanged
      send timelineDisclosureChanged = command(
        d.disclosure.p0, d.disclosure.p1, d.disclosure.p2, d.disclosure.p3
      )
    if d.sendLineDragChanged
      send lineDragChanged = command(d.lineDrag.p0, d.lineDrag.p1, d.lineDrag.p2, d.lineDrag.p3)
    if d.sendTerminalFocusChanged
      send terminalFocusChanged = command(
        d.terminalFocus.p0, d.terminalFocus.p1, d.terminalFocus.p2, d.terminalFocus.p3
      )
    if d.sendTerminalChanged
      send terminalChanged = command(d.terminal.p0, d.terminal.p1, d.terminal.p2, d.terminal.p3)
    applyLocalChange(d.sendLocalChanged, d.local)
    if d.changedKind == "command"
      send changed = command(d.command.p0, d.command.p1, d.command.p2, d.command.p3)

  action applyHover(d: AppDecision)
    if d.writeHoverState
      hoverState = d.hoverState

  action applyChatSends(d: ChatSends)
    if d.sendFileCommentChanged
      send fileCommentChanged = command(d.fileComment.p0, d.fileComment.p1, d.fileComment.p2,
        d.fileComment.p3)
    if d.sendFragmentChanged
      send fragmentChanged = command(d.fragment.p0, d.fragment.p1, d.fragment.p2, d.fragment.p3)
    if d.sendInlineDocumentChanged
      send inlineDocumentChanged = command(d.inlineDocument.p0, d.inlineDocument.p1,
        d.inlineDocument.p2, d.inlineDocument.p3)
    if d.sendLineDragChanged
      send lineDragChanged = command(d.lineDrag.p0, d.lineDrag.p1, d.lineDrag.p2, d.lineDrag.p3)
    if d.sendPrQuickChanged
      send prQuickChanged = command(d.prQuick.p0, d.prQuick.p1, d.prQuick.p2, d.prQuick.p3)
  action applyLocalChange(shouldSend: bool, args: CommandArgs)
    if shouldSend
      send localChanged = command(args.p0, args.p1, args.p2, args.p3)
  action applyChat(d: ChatLocalResult)
    if d.writeFoldHold
      foldHold = d.foldHold
    if d.writeRightPanelAt
      rightPanelAt = d.rightPanelAt
    applyChatSends(projectChatLocalSends(d))
    applyLocalChange(d.sendKind == "local", d.args)
  action applyPanelState(d: AppDecision)
    if d.writeCommandPending
      commandPending = d.commandPending
    if d.writeComposerDraft
      composerDraft = d.composerDraft
    if d.writeJumpRequest
      jumpRequest = d.jumpRequest
    if d.writeRightPanelAt
      rightPanelAt = d.rightPanelAt
    if d.writeSettingsPageState
      settingsPageState = d.settingsPageState
    if d.writeUtilityPage
      utilityPage = d.utilityPage

  action applyPanel(d: AppDecision)
    applyPanelState(d)
    applyLocalChange(d.sendLocalChanged, d.local)
    if d.sendTerminalChanged
      send terminalChanged = command(d.terminal.p0, d.terminal.p1, d.terminal.p2, d.terminal.p3)
    if d.changedKind == "command"
      send changed = command(d.command.p0, d.command.p1, d.command.p2, d.command.p3)
    if d.hostShowPopoverSource
      showPopover(d.showPopoverSource.p0, source=d.showPopoverSource.p1)
    if d.hostFocus
      focus(d.focus.p0)
  view
    T3Window(
      promptLinkNavigate=promptLinkNavigate,
      setThemeInspecting=setThemeInspecting,
      editorOp=editorOp,
      chipFocusChanged=chipFocusChanged,
      menuPick=menuPick,
      resizeDiff=resizeDiff,
      finishDiffResize=finishDiffResize,
      prSetTab=prSetTab,
      prReload=prReload,
      prAct=prAct,
      usageBreakdownSet=usageBreakdownSet,
      usageRefreshNow=usageRefreshNow,
      prSelect=prSelect,
      menuCommand=menuCommand,
      coreMenuClose=coreMenuClose,
      coreNoticeScope=coreNoticeScope,
      editKeybindingQuery=editKeybindingQuery,
      editKeybindingWhen=editKeybindingWhen,
      editLicenseQuery=editLicenseQuery,
      toggleLicense=toggleLicense,
      retryLicenses=retryLicenses,
      selectDiagnosticPeriod=selectDiagnosticPeriod,
      coreThemeLive=coreThemeLive,
      toastHovering=toastHovering,
      prConfirmDisarm=prConfirmDisarm,
      connectionAskRemove=connectionAskRemove,
      releaseUndoClaim=releaseUndoClaim,
      modifiersPasted=modifiersForget,
      citeSettleAsk=citeSettleAsk,
      citeWaitAsk=citeWaitAsk,
      applyRoot=applyUi,
      applyStateRoot=applyState,
      applyCommandRoot=applyCommand,
      applyChatRoot=applyChat,
      applyPanelRoot=applyPanel,
      applyHoverRoot=applyHover,
      windowInputs=assembleWindowInputs(
        promptLinkPage, data, viewport, scheme, hoverShown, themeInspecting, themeUsage, settingsCore,
        sshPrompt, modal, shell, wallTime, liveNow, elapsed, sidebarWidth, commandPending,
        lineageStopping, settings, utilityPage, home, sidebarHoverId, pageCover, canvas, rightPanel,
        narrowDiff, detailsShown, details, jumpRequest, data.composerOwner, markdown, attachmentUrls,
        conversationWidth, editor, chip, chipCovered, composerText, branches, terminalDrawer,
        diffWidth, prDetail, prMarkdown, filesMarkdown, prTab, usage, usageShortcuts, prList, prTyped,
        prQuery, prSelected, prPanelOpen, branchQuery, projectsOpen, connecting, settingsThemeDialog,
        settingsNavigation, settingsMenu, settingsPage, sourceControl, modalError, integrations,
        snapshotSettings, bindings, keybindingQuery, keybindingWhen, scheduled, restEditor,
        storageSettings, archives, licenses, licenseQuery, diagnostics, connectionsPage, pendingModal,
        providerPage, projectsSettings, settingsThemeSubject, welcome, welcomeStep, welcomeLink,
        welcomePairOpen, shortcuts, restSubject, sbPicker, sbQuery, sbLettersEdited, sbLetters,
        sbEmoji, origin, pairFields, sbSshHosts, sbSshHost, providerWizard, acpAgents, catalog,
        palette, toastHover, pending(providerAuthChanged), foldHold, connectionRemove, connectionMenu,
        settingsEnvironmentId, settingsProjectId, threadJumpHintsShown, canRest, citeSettleDone,
        citeWaitDone, citeDismissals, composerDraft, composerFieldLive, composerMenu,
        composerIntentBaseCurrent, composerIntentContextCurrent, composerIntentReceiptCurrent,
        composerRichCurrent, composerSelection, composerSelectionCurrent, confirmationState,
        detailsEpoch, detailsOpen, detailsPopover, fieldProtocol, hoverState, importWizardFocused,
        intentState, keybindingEditor, lineagePhasesClosed, lineagePhasesOpen, lineageWorkflows,
        modifierOwnership, noticeExitState, pageTrail, paletteSession, previewState,
        promptPreviewVisible, providerLinkTarget, providerSelected, providerWizardState, rightPanelAt,
        routeKeyboardReady, settingsCheckout, settingsMachine, settingsProjectKey, settingsPageState,
        sshResponse, streamGeometry, toastDismissed, transcriptViewport
      )
