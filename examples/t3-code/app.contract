use ThreadFindView from "./src/timeline/thread-find.contract"
use ServerBrowserFrame from "./src/browser/server-browser.contract"
use PromptLinkView from "./src/prompt-links/prompt-links.contract"
use ThemeUse, ThemeRoleUsage from "./src/appearance/settings-appearance-editor-shapes.contract"
use WorkspaceDiscovery, WorkspaceRefresh, TimelineReadsResult, Time, Page from "./src/shell/app-shapes.contract" // first: the plan orders shapes by first use
use HighlightStep from "./src/highlight/highlight.contract"
use Snapshot, Viewport, Change, LicenseSettings, SnapshotSettings, Settings, Canvas from "./src/shared/shapes.contract"
use PairFields from "./src/connections/pairing-shapes.contract"
use providerLinkVisit from "./src/shell/app-settings.contract"
use SshPromptView, SshPromptAnswer from "./src/connections/ssh-prompt.contract" // the SSH password dialog (ssh-auth.ts)
use TranscriptMarkdown, MarkdownLabels from "./src/timeline/markdown.contract"
use TimelineAttachmentUrls from "./src/timeline/timeline-attachments.contract"
use PagesHome, pageTrailNext from "./src/pages/pages-hero.contract"
use UsageView, UsageKey from "./src/usage/pages-usage.contract"
use PrListView from "./src/pull-requests/pages-prs.contract"
use PrDetailView from "./src/pull-requests/pages-pr-detail.contract"
use WelcomeView from "./src/pages/pages-welcome.contract"
use PaletteView, PaletteResult from "./src/palette/palette.contract"
use ProviderPage from "./src/providers/providers.contract"
use ProviderWizard, AcpRegistry from "./src/providers/providers-wizard.contract"
use ConnectionsPage, SbSshHosts, routeKeyboardSource from "./src/connections/connections.contract"
use routeKeyboardIdle, routeKeyboardLive, routeKeyboardNext, routeKeyboardCancel, routeKeyboardValue, routeKeyboardComplete from "./src/connections/connections-routes.contract"
use KeybindingPage from "./src/settings/settings-keybindings.contract"
use ScheduledPage from "./src/settings/settings-scheduled.contract"
use KeyDispatch from "./src/settings/settings-shortcuts.contract"
use SourceControlPage, IntegrationsPage from "./src/settings/settings-source-control.contract"
use StoragePage from "./src/settings/settings-storage.contract"
use ArchivePage from "./src/settings/settings-archive.contract"
use DiagnosticsPage from "./src/settings/settings-diagnostics.contract"
use CoreNav, SettingsCore from "./src/settings/settings-core.contract"
use AboutDelivery from "./src/settings/settings-a-about.contract"
use ProjectsPage from "./src/settings/settings-projects.contract"
use SbPicker from "./src/settings/settings-b-icons.contract"
use PickerCatalog, PickerTarget, ComposerBranches from "./src/composer/composer-shapes.contract"
use ComposerEditorView from "./src/composer/composer-editor.contract"
use ChipPopover from "./src/composer/composer-chip-popover.contract"
use ShellView, ShellDetails from "./src/shell/shell-shapes.contract"
use T3Window from "./src/shell/app-window.contract" // the window's view; its uses load the view's files here, in this order
use ChatCanvasView from "./src/shell/chat-canvas.contract"
use TerminalDrawerView from "./src/terminal/terminal.contract"
use HoverTip, noHoverTip, hoverDelay, hoverOpenDelay from "./src/shell/hover-layer.contract"
use TransportTable, TransportSlot, TransportUpdateSlot, TransportConnect, TransportUpdateStep, TransportSocket, TransportInbox from "./src/transport/transport.contract"
use legacyTipOwner from "./src/sidebar/legacy-sidebar.contract"
routes promptLinks
  home "/"
  incoming "/open"

component T3Code
  action promptLinkNavigate(location: string)
    promptLinks = open(promptLinks, location)
  resource promptLinkPage = promptLinkView(data.revision) as shape PromptLinkView
  resource promptLinksReady = promptLinksReady(data.revision, transportSeen) as shape bool
  task incomingPromptLink when top(promptLinks).name == "incoming" and promptLinksReady and not welcome.show and not commandPending
    after(1, promptLinkReceived)
  action promptLinkReceived
    let value = searchParam(top(promptLinks), "u")
    promptLinks = open(promptLinks, path("home"))
    settingsOpen = false
    utilityPage = ""
    send fragmentChanged = command("shelllocal:prompt-link-open", "", value, 0)
  action promptLinkAct(which: string)
    send fragmentChanged = command("shelllocal:prompt-link-action", which, "", 0)
  state themeInspecting = false // Color inspection owns Escape while its floating editor remains open.
  action setThemeInspecting(value: bool)
    themeInspecting = value
  action clearThemeInspecting
    themeInspecting = false
  task themeInspectionEnded when themeInspecting and not settingsCore.editor.open
    after(1, clearThemeInspecting)
  state elapsed = 0
  resource wallTime = exactTime() as shape Time
  resource data = snapshot(wallTime.epochAtZero + elapsed, reconnectGraceKey, disconnectDelayKey, viewport.displayMode, restOwner, restResting, restAtEnd, restPulls, transportSeen, composerTyping) as shape Snapshot // full screen drops the traffic lights' inset (presentation.ts); the transcript's viewport (transcript-facts.ts); the connections' news (transport.ts); the typing guard (composer-typing-guard.ts)
  state reconnectGraceKey = ""
  state disconnectDelayKey = ""
  task reconnectGrace when data.serverUpdate.reconnecting != "" key=data.serverUpdate.reconnecting
    after(2000, reconnectGraceElapsed)
  action reconnectGraceElapsed
    reconnectGraceKey = data.serverUpdate.reconnecting
  task disconnectDelay when data.serverUpdate.unavailable != "" key=data.serverUpdate.unavailable
    after(20000, disconnectDelayElapsed)
  action disconnectDelayElapsed
    disconnectDelayKey = data.serverUpdate.unavailable
  // The server connections (src/transport/transport.ts). Each session slot (0: the focused environment, 1 to 8: the
  // background ones) has an answer for the attempts no other answer runs (the ladder's) and its better-route checks,
  // and a socket resource for the URL the tick publishes; each update slot (an outdated host's self-update) has a step and a bare
  // socket. transportInbox resolves the replies whenever any of them, or the tick, has news. An answer sends its own
  // requests (LLP 1016.000 D7, amended 2026-10-18). The tick is a mutation: every 250 ms while a backoff, a stream retry, a
  // debounced activity report or an update is near, every second while connected (deadlines and Pings), and once to
  // publish a changed table (below).
  state transportTable = TransportTable(deliver=0, rev=0, soon=false, live=false, s0=TransportSlot(key="", attempt=0, check=0, url=""), s1=TransportSlot(key="", attempt=0, check=0, url=""), s2=TransportSlot(key="", attempt=0, check=0, url=""), s3=TransportSlot(key="", attempt=0, check=0, url=""), s4=TransportSlot(key="", attempt=0, check=0, url=""), s5=TransportSlot(key="", attempt=0, check=0, url=""), s6=TransportSlot(key="", attempt=0, check=0, url=""), s7=TransportSlot(key="", attempt=0, check=0, url=""), s8=TransportSlot(key="", attempt=0, check=0, url=""), u0=TransportUpdateSlot(key="", step=0), u1=TransportUpdateSlot(key="", step=0), u2=TransportUpdateSlot(key="", step=0), u3=TransportUpdateSlot(key="", step=0))
  resource transportConnect0 = transportConnect(0, transportTable.s0.key, transportTable.s0.attempt, transportTable.s0.check) as shape TransportConnect
  resource transportSocket0 = transportSocket(0, transportTable.s0.url) as shape TransportSocket
  resource transportConnect1 = transportConnect(1, transportTable.s1.key, transportTable.s1.attempt, transportTable.s1.check) as shape TransportConnect
  resource transportSocket1 = transportSocket(1, transportTable.s1.url) as shape TransportSocket
  resource transportConnect2 = transportConnect(2, transportTable.s2.key, transportTable.s2.attempt, transportTable.s2.check) as shape TransportConnect
  resource transportSocket2 = transportSocket(2, transportTable.s2.url) as shape TransportSocket
  resource transportConnect3 = transportConnect(3, transportTable.s3.key, transportTable.s3.attempt, transportTable.s3.check) as shape TransportConnect
  resource transportSocket3 = transportSocket(3, transportTable.s3.url) as shape TransportSocket
  resource transportConnect4 = transportConnect(4, transportTable.s4.key, transportTable.s4.attempt, transportTable.s4.check) as shape TransportConnect
  resource transportSocket4 = transportSocket(4, transportTable.s4.url) as shape TransportSocket
  resource transportConnect5 = transportConnect(5, transportTable.s5.key, transportTable.s5.attempt, transportTable.s5.check) as shape TransportConnect
  resource transportSocket5 = transportSocket(5, transportTable.s5.url) as shape TransportSocket
  resource transportConnect6 = transportConnect(6, transportTable.s6.key, transportTable.s6.attempt, transportTable.s6.check) as shape TransportConnect
  resource transportSocket6 = transportSocket(6, transportTable.s6.url) as shape TransportSocket
  resource transportConnect7 = transportConnect(7, transportTable.s7.key, transportTable.s7.attempt, transportTable.s7.check) as shape TransportConnect
  resource transportSocket7 = transportSocket(7, transportTable.s7.url) as shape TransportSocket
  resource transportConnect8 = transportConnect(8, transportTable.s8.key, transportTable.s8.attempt, transportTable.s8.check) as shape TransportConnect
  resource transportSocket8 = transportSocket(8, transportTable.s8.url) as shape TransportSocket
  resource transportUpdateStep0 = transportUpdateStep(0, transportTable.u0.key, transportTable.u0.step) as shape TransportUpdateStep
  resource transportUpdateSocket0 = transportUpdateSocket(0, transportUpdateStep0.step == transportTable.u0.step ? transportUpdateStep0.url : "") as shape TransportSocket
  resource transportUpdateStep1 = transportUpdateStep(1, transportTable.u1.key, transportTable.u1.step) as shape TransportUpdateStep
  resource transportUpdateSocket1 = transportUpdateSocket(1, transportUpdateStep1.step == transportTable.u1.step ? transportUpdateStep1.url : "") as shape TransportSocket
  resource transportUpdateStep2 = transportUpdateStep(2, transportTable.u2.key, transportTable.u2.step) as shape TransportUpdateStep
  resource transportUpdateSocket2 = transportUpdateSocket(2, transportUpdateStep2.step == transportTable.u2.step ? transportUpdateStep2.url : "") as shape TransportSocket
  resource transportUpdateStep3 = transportUpdateStep(3, transportTable.u3.key, transportTable.u3.step) as shape TransportUpdateStep
  resource transportUpdateSocket3 = transportUpdateSocket(3, transportUpdateStep3.step == transportTable.u3.step ? transportUpdateStep3.url : "") as shape TransportSocket
  resource transportInbox = transportDeliver(transportSocket0.seq + transportConnect0.seq + transportSocket1.seq + transportConnect1.seq + transportSocket2.seq + transportConnect2.seq + transportSocket3.seq + transportConnect3.seq + transportSocket4.seq + transportConnect4.seq + transportSocket5.seq + transportConnect5.seq + transportSocket6.seq + transportConnect6.seq + transportSocket7.seq + transportConnect7.seq + transportSocket8.seq + transportConnect8.seq + transportUpdateSocket0.seq + transportUpdateStep0.seq + transportUpdateSocket1.seq + transportUpdateStep1.seq + transportUpdateSocket2.seq + transportUpdateStep2.seq + transportUpdateSocket3.seq + transportUpdateStep3.seq + transportTable.deliver) as shape TransportInbox
  mutation transportPumped as shape TransportTable queue then transportPumpDone
  action transportPump
    if not pending(transportPumped)
      send transportPumped = transportPump(wallTime.epochAtZero + performanceNow(), "")
  action transportSignal(reason: string)
    send transportPumped = transportPump(wallTime.epochAtZero + performanceNow(), reason)
  action transportPumpDone
    match transportPumped
      case some(table)
        transportTable = table
      case none
        transportTable = transportTable
  // Each answer that may wait on a server reply, pending or not. The tick publishes the table once whenever one starts
  // or ends (a connect, a retry or a disconnect changes it inside an answer, which nothing else reads), and once
  // whenever the delivering answer reports a table the tick has not published (a socket closed, a slot's attempt got
  // its URL).
  derive transportAnswering = `${pending(threadFind)}${pending(threadFindMaintained)}${pending(serverBrowserUploaded)}${pending(data)}${pending(balanceLoaded)}${pending(attachmentUrls)}${pending(home)}${pending(usage)}${pending(usageShortcuts)}${pending(prList)}${pending(prDetail)}${pending(welcome)}${pending(timelineDisclosureChanged)}${pending(timelineReadsRefreshed)}${pending(timelineReadsRefreshedNext)}${pending(workspaceDiscovery)}${pending(workspaceRefreshed)}${pending(palette)}${pending(paletteChanged)}${pending(providerAuthChanged)}${pending(providerUpdateRun)}${pending(changed)}${pending(localChanged)}${pending(prQuickChanged)}${pending(prConfirmChanged)}${pending(prHandoffChanged)}${pending(terminalFocusChanged)}${pending(fileCommentChanged)}${pending(lineDragChanged)}${pending(terminalChanged)}${pending(fragmentChanged)}${pending(providerPage)}${pending(providerWizard)}${pending(connectionsPage)}${pending(acpAgents)}${pending(bindings)}${pending(scheduled)}${pending(shortcuts)}${pending(sourceControl)}${pending(integrations)}${pending(storageSettings)}${pending(archives)}${pending(licenses)}${pending(diagnostics)}${pending(snapshotSettings)}${pending(settingsNavigation)}${pending(settingsCore)}${pending(settings)}${pending(projectsSettings)}${pending(sbSshHosts)}${pending(sshPrompt)}${pending(sshAnswered)}${pending(pairFields)}${pending(sbPicker)}${pending(catalog)}${pending(editor)}${pending(chip)}${pending(branches)}${pending(sidebarLaunch)}${pending(automationRecordingServed0)}${pending(automationRecordingServed1)}${pending(automationRecordingServed2)}${pending(automationRecordingServed3)}${pending(themeLive)}${pending(shell)}${pending(details)}${pending(canvas)}${pending(terminalDrawer)}`
  task transportAnswered key=transportAnswering
    after(1, transportPump)
  task transportRepublish when transportInbox.table > transportTable.rev key=transportInbox.table
    after(1, transportPump)
  task transportSoon when transportTable.soon
    every(250, transportPump)
  task transportLive when transportTable.live
    every(1000, transportPump)
  // The reachability signals (wakeups.ts): offline questions a live socket, back online wakes a waiting retry; the first
  // reading is the baseline, not a change. Returning to the app is windowReturned's.
  state transportOnline = true
  task transportNetwork key=page.onLine
    after(1, transportNetworkChanged)
  action transportNetworkChanged
    if page.onLine != transportOnline
      transportOnline = page.onLine
      transportSignal(page.onLine ? "online" : "offline")
  // The snapshot is asked again for the connections' news once its read in flight lands, as a watched topic would (exact2
  // #183): replacing it for each frame, a launch's slow snapshot answer would never land. Settings › Connections likewise.
  state transportSeen = 0
  task transportNews when transportInbox.news != transportSeen and not pending(data) key=transportInbox.news
    after(1, transportNewsSeen)
  action transportNewsSeen
    transportSeen = transportInbox.news
  state transportFleetSeen = 0
  task transportFleetNews when transportInbox.fleet != transportFleetSeen and not pending(connectionsPage) key=transportInbox.fleet
    after(1, transportFleetNewsSeen)
  action transportFleetNewsSeen
    transportFleetSeen = transportInbox.fleet
  task rootFont key=data.look.fontSize // Interface font size (appearanceFonts.ts applyAppearanceFontVariables): the root font size every rem follows, set at launch and on every change; `rem` is provided for lengths computed in px at 16.
    after(1, rootFontApply)
  action rootFontApply // the reference's 16 before the data's first answer (the Mac host's own size is 13 since LLP 1115)
    setRootFontSize(data.look.fontSize > 0 ? data.look.fontSize : 16)
  state codeCopyDone = 0 // #123: the copy whose check has run its time (MarkdownCodeBlock and MarkdownTable 1.2 s, CommandBlock 1.5 s); its button morphs back (MorphCopyCheck)
  state welcomeCopyDone = 0
  task codeCopyHold when data.codeCopyNonce > 0 key=data.codeCopyNonce
    after(1200, codeCopyRelease)
  action codeCopyRelease
    codeCopyDone = data.codeCopyNonce
  task welcomeCopyHold when welcome.commandCopied > 0 key=welcome.commandCopied
    after(1500, welcomeCopyRelease)
  action welcomeCopyRelease
    welcomeCopyDone = welcome.commandCopied
  resource serverBrowserLive = serverBrowserFrame(shell.panel.browser.runtimeId, shell.panel.browser.streamUrl) as shape ServerBrowserFrame
  resource serverBrowserMiniLive = serverBrowserFrame(shell.panel.browserMini.runtimeId, shell.panel.browserMini.streamUrl) as shape ServerBrowserFrame
  mutation serverBrowserChanged as shape ServerBrowserFrame queue
  mutation serverBrowserMaintained as shape ServerBrowserFrame queue
  mutation serverBrowserMiniMaintained as shape ServerBrowserFrame queue
  mutation serverBrowserUploaded as shape ServerBrowserFrame queue refreshes data
  derive serverFrame0 = match serverBrowserChanged { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverBrowserLive.seq ? value : serverBrowserLive, case none => serverBrowserLive }
  derive serverFrame1 = match serverBrowserMaintained { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverFrame0.seq ? value : serverFrame0, case none => serverFrame0 }
  derive serverFrame = match serverBrowserUploaded { case some(value) => value.runtimeId == shell.panel.browser.runtimeId and value.seq > serverFrame1.seq ? value : serverFrame1, case none => serverFrame1 }
  derive serverMiniFrame0 = match serverBrowserChanged { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverBrowserMiniLive.seq ? value : serverBrowserMiniLive, case none => serverBrowserMiniLive }
  derive serverMiniFrame1 = match serverBrowserMiniMaintained { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverMiniFrame0.seq ? value : serverMiniFrame0, case none => serverMiniFrame0 }
  derive serverMiniFrame = match serverBrowserUploaded { case some(value) => value.runtimeId == shell.panel.browserMini.runtimeId and value.seq > serverMiniFrame1.seq ? value : serverMiniFrame1, case none => serverMiniFrame1 }
  task streamMaintenance when serverFrame.attention or serverMiniFrame.attention key=`${serverFrame.runtimeId}:${serverMiniFrame.runtimeId}`
    every(250, streamMaintain)
  action streamMaintain
    shellClock = performanceNow()
    send serverBrowserMaintained = serverBrowserStatus(shell.panel.browser.runtimeId, wallTime.epochAtZero + performanceNow())
    send serverBrowserMiniMaintained = serverBrowserStatus(shell.panel.browserMini.runtimeId, wallTime.epochAtZero + performanceNow())
    refresh shell
  task streamDecode when serverFrame.decoding key=`${serverFrame.runtimeId}:${serverFrame.decodeSequence}`
    after(1, streamDecodeFrame)
  action streamDecodeFrame
    send serverBrowserChanged = serverBrowserDecode(serverFrame.runtimeId)
  task streamMiniDecode when serverMiniFrame.decoding key=`${serverMiniFrame.runtimeId}:${serverMiniFrame.decodeSequence}`
    after(1, streamDecodeMiniFrame)
  action streamDecodeMiniFrame
    send serverBrowserChanged = serverBrowserDecode(serverMiniFrame.runtimeId)
  state streamWidth = 0
  state streamHeight = 0
  state streamFollowSize = false
  action streamMeasured(id: string, width: number, height: number, follow: bool)
    if id == shell.panel.browser.runtimeId
      streamWidth = width
      streamHeight = height
      streamFollowSize = follow
  task streamResized when serverFrame.controlled and streamFollowSize and streamWidth > 0 and streamHeight > 0 key=`${streamWidth}x${streamHeight}:${serverFrame.controlled}`
    after(150, streamResize)
  action streamResize
    send serverBrowserChanged = serverBrowserResize(shell.panel.browser.runtimeId, streamWidth, streamHeight, wallTime.epochAtZero + performanceNow())
  action streamPainted(id: string, image: string)
    send serverBrowserChanged = serverBrowserPainted(id, image)
  action streamControl(id: string, kind: string)
    send serverBrowserChanged = serverBrowserControl(id, kind, wallTime.epochAtZero + performanceNow())
  action streamMouse(id: string, event: PointerEvent, phase: string, width: number, height: number)
    send serverBrowserChanged = serverBrowserMouse(id, event, phase, width, height, wallTime.epochAtZero + performanceNow())
  action streamWheel(id: string, event: WheelEvent, phase: string, width: number, height: number)
    send serverBrowserChanged = serverBrowserWheel(id, event, phase, width, height, wallTime.epochAtZero + performanceNow())
  action streamKey(id: string, event: KeyboardEvent, phase: string)
    send serverBrowserChanged = serverBrowserKey(id, event, phase, wallTime.epochAtZero + performanceNow())
  action streamText(id: string, text: string)
    send serverBrowserChanged = serverBrowserText(id, text, wallTime.epochAtZero + performanceNow())
  action streamDialog(id: string, accept: bool, prompt: string)
    send serverBrowserChanged = serverBrowserDialog(id, accept, prompt, wallTime.epochAtZero + performanceNow())
  action streamUpload(id: string, chooser: string, files: Picked[])
    send serverBrowserUploaded = serverBrowserUpload(id, chooser, files)
  task streamClipboard when serverFrame.clipboardSequence > 0 key=`${serverFrame.runtimeId}:${serverFrame.clipboardSequence}`
    after(1, streamCopyClipboard)
  action streamCopyClipboard
    copyText(serverFrame.clipboard)
  task streamOpenedDialog when serverFrame.dialogType != "" key=serverFrame.dialogMessage
    after(1, streamOpenDialog)
  action streamOpenDialog
    showModal(`server-browser-dialog-${serverFrame.runtimeId}`)
  task streamClosedDialog when serverFrame.dialogType == ""
    after(1, streamCloseDialog)
  action streamCloseDialog
    close(`server-browser-dialog-${serverFrame.runtimeId}`)
  task streamMiniClipboard when serverMiniFrame.clipboardSequence > 0 key=`${serverMiniFrame.runtimeId}:${serverMiniFrame.clipboardSequence}`
    after(1, streamCopyMiniClipboard)
  action streamCopyMiniClipboard
    copyText(serverMiniFrame.clipboard)
  task streamOpenedMiniDialog when serverMiniFrame.dialogType != "" key=serverMiniFrame.dialogMessage
    after(1, streamOpenMiniDialog)
  action streamOpenMiniDialog
    showModal(`server-browser-dialog-${serverMiniFrame.runtimeId}`)
  task streamClosedMiniDialog when serverMiniFrame.dialogType == ""
    after(1, streamCloseMiniDialog)
  action streamCloseMiniDialog
    close(`server-browser-dialog-${serverMiniFrame.runtimeId}`)
  provide
    threadFind
    serverMiniFrame
    serverFrame
    streamPainted
    streamControl
    streamMouse
    streamWheel
    streamKey
    streamText
    streamDialog
    streamUpload
    streamMeasured
    codeCopyDone
    welcomeCopyDone
    routeKeyboard
    routeKeyboardInput
    citeEnd
    restScrolled
    restGesture
  // AssistantCitationSource: View source brings the cited answer's text to min(120pt, a third of the transcript) under
  // its top (the answer's column, `cite-<row>`, has 2pt of padding above it). A row the list has not built is approached
  // by its key first; each later pass places the built answer again until it holds (rows measured as they mount move
  // it), the scroll cannot take it further, or 40 passes have run. The first placement is smooth unless reduced motion
  // asks otherwise, and the next pass waits for it. The reader's wheel or a minimap jump ends it.
  state citeKey = ""
  state citeNonce = 0
  state citeDone = 0
  state citeTries = 0
  state citeSmooth = false
  state citeMiss = 0
  task citeRequested when data.citeJump.nonce > citeNonce key=data.citeJump.nonce
    after(1, citeBegin)
  action citeBegin
    citeKey = data.citeJump.key
    citeNonce = data.citeJump.nonce
    citeTries = 0
    citeSmooth = false
    citeMiss = 1000000
  task citePass when citeNonce > citeDone and not citeSmooth and citeTries < 40 key=`${citeNonce}|${citeTries}|${citeSmooth}`
    after(50, citePlace)
  task citeSmoothPass when citeNonce > citeDone and citeSmooth key=`${citeNonce}|${citeTries}`
    after(400, citeAfterSmooth)
  action citeAfterSmooth
    citeSmooth = false
  action citeEnd
    citeDone = citeNonce
  // The transcript's viewport, read from its own scroll, wheel and keys, never estimated from message lengths: whether
  // it is at its end, whether the composer rests (Settings' "Collapse composer on scroll": only a reader's movement of
  // 24pt away from the end within 0.8 s of their wheel or key, with the geometry still, rests it; layout changes,
  // history arriving and the follow of the end do not), and the pulls toward the end made while already there, which
  // let a grown composer's reservation through (composer-overlay.ts). The snapshot reads them (transcript-facts.ts).
  derive canRest = data.composerCollapseOnScroll and data.threadId != "" and not composerFocused and not composerText.includes("\n") and data.approvals.length == 0 and data.questions.length == 0 and not data.settled
  state restOwner = ""
  state restResting = false
  state restAtEnd = true
  state restPulls = 0
  state restGestureUntil = -1
  state restLastPull = -1000000
  state findViewport = ""
  state restTop = -1
  state restHeight = -1
  state restContent = -1
  state restWidth = -1
  state restMovement = 0
  task restLapsed when restResting and not canRest key=restResting
    after(1, restLapse)
  action restLapse
    restResting = false
  action restScrolled(owner: string, e: ScrollEvent)
    match e.firstVisibleKey
      case some(key)
        findViewport = key
      case none
        findViewport = ""
    let fresh = owner != restOwner
    let end = e.scrollHeight <= e.clientHeight + 2 or e.scrollTop >= e.scrollHeight - e.clientHeight - 2
    let still = not fresh and restHeight >= 0 and max(restHeight - e.clientHeight, e.clientHeight - restHeight) < 0.5 and max(restContent - e.scrollHeight, e.scrollHeight - restContent) < 0.5 and max(restWidth - e.clientWidth, e.clientWidth - restWidth) < 0.5
    let moved = restMovement + max(e.scrollTop - restTop, restTop - e.scrollTop)
    if end
      restResting = false
      restMovement = 0
    else if canRest and still and performanceNow() <= restGestureUntil
      restMovement = moved
      if moved >= 24
        restResting = true
    else
      restMovement = 0
      restGestureUntil = -1
      if fresh
        restResting = false
    restOwner = owner
    restTop = e.scrollTop
    restHeight = e.clientHeight
    restContent = e.scrollHeight
    restWidth = e.clientWidth
    restAtEnd = end
  // A wheel over the transcript or a scroll key inside it: toward the end, while there, is a pull (one each 0.5 s);
  // either way it opens the 0.8 s in which movement may rest the composer.
  action restGesture(towardEnd: bool)
    let now = performanceNow()
    if towardEnd and restAtEnd and now - restLastPull > 500
      restLastPull = now
      restPulls = restPulls + 1
    if canRest
      restGestureUntil = now + 800
  // Save file and the media menu's Save (save-file.ts): the host's Save panel, a sheet on the window, copies the app
  // file out under its name (the hidden `save-file` field, app-window.contract, hears its change and cancel).
  state saveNonce = 0
  task saveRequested when data.saveRequest.nonce > saveNonce key=data.saveRequest.nonce
    after(1, saveNow)
  action saveNow
    saveNonce = data.saveRequest.nonce
    saveFile("save-file", data.saveRequest.from, data.saveRequest.name)
  action citePlace
    let target = frame(`cite-${citeKey}`)
    let row = frame(`row-${citeKey}`)
    let port = frame("transcript")
    let lead = min(120, port.height / 3)
    if target.unavailable or row.unavailable
      scrollIntoView("transcript", citeKey, offset=0 - lead, behavior="instant")
      citeTries = citeTries + 1
    else
      let miss = target.y + 2 - port.y - lead
      if (miss > 1 or miss < -1) and (citeMiss - miss > 0.5 or miss - citeMiss > 0.5)
        if citeTries == 0 and not viewport.prefersReducedMotion
          scrollIntoView("transcript", citeKey, offset=target.y - row.y + 2 - lead, behavior="smooth")
          citeSmooth = true
        else
          scrollIntoView("transcript", citeKey, offset=target.y - row.y + 2 - lead, behavior="instant")
        citeMiss = miss
        citeTries = citeTries + 1
      else
        citeDone = citeNonce
  mutation balanceLoaded as shape Change refreshes data // auto-balance.ts (issues/closed/20261009-typescript-failure-parity.md, issues/20261009-runner-owned-bidirectional-streams.md): an unresolved Auto draft asks its machines' host resources, at the window's time.
  task balanceLoad when branches.balanceFetch != "" key=branches.balanceFetch
    after(1, balanceLoadNow)
  action balanceLoadNow
    send balanceLoaded = command("cclocal:balance-load", branches.balanceFetch, `${wallTime.epochAtZero + performanceNow()}`, 0)
  state noticeExit = ""
  state noticeExitOp = ""
  state noticeExitTarget = ""
  state noticeExitSerial = 0
  action noticeDismiss(notice: string, op: string, target: string)
    if noticeExitOp == "" and not commandPending
      noticeExit = notice
      noticeExitOp = op
      noticeExitTarget = target
      noticeExitSerial = noticeExitSerial + 1
  task noticeExiting when noticeExitOp != "" key=noticeExitSerial
    after(220, noticeExited)
  action noticeExited
    if not commandPending
      commandPending = true
      send changed = command(noticeExitOp, noticeExitTarget, "", 0)
    else
      noticeExit = ""
    noticeExitOp = ""
  state hoverWait = 0 // the hover clock (hover-layer.contract): +10 each 10 ms while a hover card's close delay runs (to hoverEnd), and on a surface change, which ends a tooltip or card whose trigger went with no leave
  state hoverEnd = 0
  task hoverTick when hoverWait < hoverEnd key=hoverEnd
    every(10, hoverTicked)
  task hoverSurface key=`${settingsOpen}|${settingsRoute}|${utilityPage}|${modal}|${prSelected}|${data.threadId}|${hoverOwnerValid}` // also close a legacy tip whose row vanished without leave
    after(1, hoverTicked)
  action hoverTicked
    if not hoverOwnerValid
      hoverTipAt(noHoverTip(), "", true)
    hoverWait = hoverWait + 10
  action hoverHold(end: number)
    hoverEnd = end
  state hoverTip = noHoverTip() // Root ownership avoids T3Window captures; surface changes and removed owners dismiss.
  state hoverOn = ""
  state hoverOpen = 0
  state hoverUntil = 0
  derive hoverOwnerValid = hoverTip.key != "legacy-tip" or (data.legacy.enabled and data.sidebarOpen and legacyTipOwner(hoverTip.testId, data.legacy.projects))
  derive hoverShown = hoverOwnerValid and hoverTip.key != "" and (hoverOn != "" ? hoverWait == hoverOpen : hoverWait < hoverUntil)
  action hoverTipAt(tip: HoverTip, part: string, inside: bool)
    if inside
      let at = tip.key == hoverTip.key and hoverShown ? hoverWait : hoverWait + hoverOpenDelay(tip.kind)
      hoverTip = tip
      hoverOn = part
      hoverOpen = at
      hoverHold(at)
    else if tip.key == hoverTip.key and hoverOn == part
      let until = hoverShown ? hoverWait + hoverDelay(tip.kind) : hoverWait
      hoverOn = ""
      hoverUntil = until
      hoverHold(until)
  resource threadFind = threadFind(data.revision, wallTime.epochAtZero + elapsed, data.markdownSkills, findViewport) as shape ThreadFindView
  mutation threadFindMaintained as shape ThreadFindView refreshes threadFind, data
  task maintainThreadFind when threadFind.attention
    every(100, maintainThreadFindTick)
  action maintainThreadFindTick
    if not pending(threadFindMaintained)
      send threadFindMaintained = threadFind(data.revision, wallTime.epochAtZero + performanceNow(), data.markdownSkills, findViewport)
  state findTries = 0
  state findPlacing = false
  state findMiss = 1000000
  task findRequested when threadFind.open and threadFind.entry != "" key=`${data.serverUrl}|${data.threadId}|${threadFind.navigation}|${threadFind.entry}`
    after(1, findBegin)
  action findBegin
    citeEnd()
    findTries = 0
    findMiss = 1000000
    findPlacing = true
    scrollIntoView("transcript", threadFind.entry, offset=-96, behavior="instant")
  task findPlacement when threadFind.open and findPlacing and findTries < 30 key=findTries
    after(32, findPlace)
  action findPlace
    let target = frame("thread-find-active")
    let row = frame(`row-${threadFind.entry}`)
    let port = frame("transcript")
    if target.unavailable or row.unavailable
      findTries = findTries + 1
    else
      let miss = target.y - port.y - 96
      if (miss > 1 or miss < -1) and (findMiss - miss > 0.5 or miss - findMiss > 0.5)
        scrollIntoView("transcript", threadFind.entry, offset=target.y - row.y - 96, behavior="instant")
        findMiss = miss
        findTries = findTries + 1
      else
        findPlacing = false
  task threadFindFocus when threadFind.open key=threadFind.focus
    after(1, threadFindFocusField)
  action threadFindFocusField
    focus("thread-find-query")
    selectText("thread-find-query")
  task diffFindFocus when data.diffFind.open key=data.diffFind.focus
    after(1, diffFindFocusField)
  action diffFindFocusField
    focus("diff-find-query")
    selectText("diff-find-query")
  task prFindFocus when prDetail.codeTab.find.open key=prDetail.codeTab.find.focus
    after(1, prFindFocusField)
  action prFindFocusField
    focus("pr-code-find-query")
    selectText("pr-code-find-query")
  resource markdown = renderMarkdown(data.messages, data.markdownSkills, threadFind.highlight, threadFind.entry, threadFind.occurrence, data.messages.map((message) => MarkdownLabels(id=message.id, chips=message.md.chips))) as shape TranscriptMarkdown
  resource attachmentUrls = timelineAttachments(data.threadId, wallTime.epochAtZero + elapsed, data.revision) as shape TimelineAttachmentUrls // Signed preview URLs for the thread's sent images (timeline-attachments.ts).
  resource home = pagesHome(data.revision) as shape PagesHome // Lane pages: the empty main view, the utility pages and the sidebar footer route.
  state utilityPage = ""
  derive pageCover = utilityPage != "" or home.landing == "no-environment" or home.landing == "no-projects" or home.landing == "start-error" or home.landing == "no-thread"
  action openPage(name: string)
    pageTrailNote(name)
    utilityPage = name
    sidebarHoverId = "" // a press closes its tooltip (Base UI); the pressed footer button unmounts without a hover-out
  state pageTrail = [] // Utility-page Escape follows its page trail; opening from a thread starts a new trail, empty means Home.
  action pageTrailNote(name: string)
    pageTrail = pageTrailNext(pageTrail, utilityPage, name)
  action pageBack
    utilityPage = match pageTrail.at(-1) { case some(page) => page, case none => "" }
    pageTrail = pageTrail.slice(0, -1)
    sidebarHoverId = ""
  state usageMetric = ""
  state usageDays = 0
  state usageBreakdown = "model"
  state usageRefresh = 0
  resource usage = usagePage(utilityPage == "usage", usageMetric, usageDays, usageBreakdown, usageRefresh, viewport.width, data.sidebarOpen ? sidebarWidth : 0, wallTime.epochAtZero + elapsed, data.revision) as shape UsageView
  resource usageShortcuts = usageKeys(data.revision) as shape UsageKey[]
  action usageMetricSet(value: string)
    usageMetric = value
    send localChanged = command("pageslocal:usage-metric", "", value, 0)
  action usageWindowSet(days: number)
    usageDays = days
    send localChanged = command("pageslocal:usage-window", "", `${days}`, 0)
  action usageBreakdownSet(value: string)
    usageBreakdown = value
  action usageRefreshNow
    usageRefresh = usageRefresh + 1
  state prQuery = ""
  state prApplied = ""
  state prTyped = false
  state prSelected = ""
  state prPanelOpen = true
  state prRefresh = 0
  state prTab = "summary"
  resource prList = prList(utilityPage == "pull-requests", prRefresh, wallTime.epochAtZero + elapsed, prSelected, prApplied, prTyped, data.revision, page.visibilityState == "visible", windowReturns) as shape PrListView
  resource prDetail = prDetail(utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, prRefresh, wallTime.epochAtZero + elapsed, data.revision, page.visibilityState == "visible", windowReturns, prTab, utilityPage == "pull-requests", floor(liveNow / 10000)) as shape PrDetailView // the page, the linked threads' 10 s tick
  resource prMarkdown = renderPullRequestMarkdown(prDetail.bodies) as shape TranscriptMarkdown
  action prType(value: string)
    prQuery = value
    prTyped = true
  task prSearchSettle when utilityPage == "pull-requests" and prTyped and prApplied != prQuery key=prQuery // SEARCH_DEBOUNCE_MS: 250 ms after the last keystroke (exact2 #192)
    after(250, prSettle)
  action prSettle
    prApplied = prQuery
    send localChanged = command("pageslocal:pr-query", "", prQuery, 0)
  action prControl(op: string, value: string)
    if op == "query"
      prQuery = value
      prApplied = value
      prTyped = true
    send localChanged = command(`pageslocal:pr-${op}`, "", value, 0)
  action prSelect(ref: string)
    prSelected = ref
    prPanelOpen = true
    prTab = "summary"
  action prTogglePanel
    prPanelOpen = not prPanelOpen
  action prReload
    prRefresh = prRefresh + 1
  action prSetTab(value: string)
    prTab = value
  action prAct(op: string, value: string)
    if op == "quick" or op == "close-batch"
      send prQuickChanged = command(`pageslocal:pr-act-${op == "quick" ? "queue" : op}`, "", value, 0)
    else if not commandPending
      commandPending = true
      send changed = command(`pageslocal:pr-act-${op}`, utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, value, 0)
  action prCopy(label: string, text: string)
    send localChanged = command("pageslocal:copy", label, text, 0)
  task prConfirmLapse when prDetail.actions.armedSerial > 0 key=prDetail.actions.armedSerial // useInlineActionConfirm: an armed confirmation lapses after 3 s, or as the window loses the focus
    after(3000, prConfirmLapsed)
  task prConfirmBlur when prDetail.actions.armedSerial > 0 and not page.hasFocus key=prDetail.actions.armedSerial
    after(1, prConfirmLapsed)
  action prConfirmLapsed
    chatLocal("pr-ui-disarm", prDetail.ref, `serial:${prDetail.actions.armedSerial}`)
  state welcomeStep = "connect"
  state welcomeLink = ""
  state welcomePairOpen = true
  resource welcome = welcome(welcomeStep, wallTime.epochAtZero + elapsed, data.revision) as shape WelcomeView
  action welcomeGo(step: string)
    welcomeStep = step
  action welcomeSetup
    welcomeStep = "agents"
    send localChanged = command("pageslocal:welcome-setup", "", "", 0)
  action welcomeEditLink(value: string)
    welcomeLink = value
  action welcomePair
    if not commandPending and welcomeLink.trim() != ""
      draftOwner = "__unset__"
      commandPending = true
      pendingModal = "welcome-pair"
      modalError = ""
      send changed = command("welcome-pair", "", welcomeLink, 0)
  action welcomeTogglePair
    welcomePairOpen = not welcomePairOpen
  action welcomeFinish
    if not commandPending
      commandPending = true
      send changed = command("pageslocal:welcome-finish", "", `${wallTime.epochAtZero + performanceNow()}`, 0)
  action welcomeImport(op: string, id: string, value: string) // also the Usage page's pages:usage-* ops
    if op != "import" and op != "usage-prices-save"
      send localChanged = command(op.startsWith("usage-") ? `pageslocal:${op}` : `pageslocal:welcome-${op}`, id, value, 0)
    else if not commandPending
      commandPending = true
      send changed = command(op == "import" ? "pageslocal:welcome-import" : "pageslocal:usage-prices-save", "", `${wallTime.epochAtZero + performanceNow()}`, 0)
  action openConnectionsPage
    openSettings() // retainSettingsScope: a link from outside Settings starts with no scope
    settingsRoute = "connections"
  action tick
    elapsed = performanceNow()
  task clock mount
    every(60000, tick)
  state windowReturns = 0 // the window focused again, the clock read then (useLiveRefresh's `focus` at Date.now(), not at the last minute tick), for the list and the detail
  task windowBack when page.hasFocus and page.visibilityState == "visible"
    after(1, windowReturned)
  action windowReturned
    elapsed = performanceNow()
    windowReturns = windowReturns + 1
    transportSignal("foreground") // returning to the app: probe a live socket, look for a better route, wake a waiting retry
  mutation timelineDisclosureChanged as shape Change refreshes data then dispatchTimelineReads
  mutation timelineReadsRefreshed as shape TimelineReadsResult refreshes data
  mutation timelineReadsRefreshedNext as shape TimelineReadsResult refreshes data
  action dispatchTimelineReads
    if not pending(timelineReadsRefreshed)
      send timelineReadsRefreshed = refreshTimelineReads(wallTime.epochAtZero + performanceNow())
    if not pending(timelineReadsRefreshedNext)
      send timelineReadsRefreshedNext = refreshTimelineReads(wallTime.epochAtZero + performanceNow())
  state liveNow = 0 // The timeline's "Working for 12s" ticks each second while a run is live.
  state workspaceNow = 0 // The mounted composer checks its five-minute workspace snapshot TTL.
  resource workspaceDiscovery = composerWorkspace(data.revision, not settingsOpen and not pageCover and not welcome.show, wallTime.epochAtZero + max(workspaceNow, elapsed)) as shape WorkspaceDiscovery // ChatComposer is mounted on the chat view only
  mutation workspaceRefreshed as shape WorkspaceRefresh refreshes workspaceDiscovery, data then workspaceRefreshFinished
  state workspaceRetryKey = ""
  state workspaceRetryAt = 0
  state workspaceRetryWake = 0 // ChatComposer: without a pending snapshot, only a change after the cooldown retries.
  action workspaceRefreshFinished
    match workspaceRefreshed
      case some(result)
        workspaceRetryKey = result.key
        workspaceRetryAt = result.retry ? performanceNow() + 10000 : 0
        workspaceRetryWake = result.wake
      case none
        workspaceRetryAt = performanceNow() + 10000
  // A timeline read's mutation refreshes data as it lands, and a refresh replaces an answer in flight, so the tick
  // leaves a pending data answer alone, as the highlight pump does (highlightStepped): asked again each second, a
  // launch's slow snapshot answer could never land.
  action liveTick
    if not settingsOpen and not pageCover and not welcome.show
      workspaceNow = performanceNow()
    if data.timelineReadsNeeded and not pending(data)
      dispatchTimelineReads()
    if workspaceDiscovery.needed and not pending(workspaceRefreshed)
      if workspaceRetryKey != workspaceDiscovery.key or (performanceNow() >= workspaceRetryAt and (workspaceDiscovery.timer or workspaceDiscovery.wake != workspaceRetryWake))
        send workspaceRefreshed = refreshComposerWorkspace(workspaceDiscovery.key)
      if workspaceRetryKey == workspaceDiscovery.key and performanceNow() < workspaceRetryAt
        workspaceRetryWake = workspaceDiscovery.wake
    if data.running or data.subagentsLive or data.sidebar.ticking or data.sidebar.undoUntil > wallTime.epochAtZero + liveNow or prDetail.links.polling
      liveNow = performanceNow()
  task liveClock mount
    every(1000, liveTick)
  mutation highlightSliced as shape HighlightStep then highlightStepped
  action highlightStep
    if not pending(highlightSliced)
      send highlightSliced = highlightSlice(wallTime.epochAtZero + performanceNow())
  // A refresh replaces an answer in flight, so the pump leaves one alone; one that lands with a text
  // still without its tokens reports highlightPending and is asked again. Replaced every 16 ms, a
  // launch's snapshot answer (seconds) never landed to clear highlightPending, and its forgotten
  // native calls filled the executor's admission limit. With nothing finished, only an answer still
  // reporting highlightPending is asked again.
  action highlightStepped
    match highlightSliced
      case some(step)
        if step.finished or not step.pending
          if not pending(data) and (step.finished or data.highlightPending)
            refresh data
          if not pending(shell) and (step.finished or shell.highlightPending)
            refresh shell
      case none
        if not pending(data)
          refresh data
  task highlightPump when data.highlightPending or shell.highlightPending
    every(16, highlightStep)
  resource viewport = exactViewport() as shape Viewport
  derive scheme = (data.look.mode == "light" or data.look.mode == "dark") ? data.look.mode : (viewport.prefersColorScheme == "dark" ? "dark" : "light") // Palettes use the resolved Appearance scheme; viewport.prefersColorScheme is only the underlying system preference.
  state paletteOpen = false
  state paletteMode = "command"
  state palettePage = ""
  state paletteQuery = ""
  state paletteCursor = -1
  state paletteScroll = 0
  state paletteCase = false
  state paletteWord = false
  state paletteRegex = false
  state paletteBusy = false
  resource palette = paletteView(paletteOpen, paletteMode, palettePage, paletteQuery, `${paletteCase ? "case " : ""}${paletteWord ? "word " : ""}${paletteRegex ? "regex" : ""}`, paletteCursor >= 0, wallTime.epochAtZero + elapsed, scheme, data.revision) as shape PaletteView
  mutation paletteChanged as shape PaletteResult refreshes data then paletteDone
  derive paletteHighlight = palette.count == 0 ? -1 : (paletteCursor >= 0 ? min(paletteCursor, palette.count - 1) : (palette.autoHighlight and (paletteCursor == -1 or palette.panel == "picker") ? 0 : -1))
  derive paletteListHeight = min(330, min(448, viewport.height * 0.7))
  action paletteShow(mode: string, page: string)
    let show = page != "" or not (paletteOpen and paletteMode == mode)
    paletteOpen = show
    paletteMode = mode
    palettePage = page
    paletteQuery = ""
    paletteCursor = mode == "files" or page != "" ? -2 : -1
    paletteScroll = 0
    modelsOpen = false
    optionsOpen = ""
    projectsOpen = false
    modalError = ""
    if show
      focus("palette-input")
  action paletteClose
    if paletteMode != "command"
      paletteMode = "command"
      palettePage = ""
      paletteQuery = ""
      paletteCursor = -1
      paletteScroll = 0
      focus("palette-input")
    else
      paletteOpen = false
      focus(palettePage == "pr-link-thread" ? "pull-request-more" : (palettePage.startsWith("pr-linked|") ? "pull-request-linked-threads" : "composer")) // back to the trigger
  action paletteEdit(value: string)
    paletteQuery = value
    paletteCursor = paletteMode == "content" ? -1 : -2
    paletteScroll = 0
    if value == "" and palette.popOnEmpty
      palettePage = palette.parent
  action paletteKey(name: string)
    if name == "ArrowDown" and palette.count > 0
      let next = (paletteHighlight < 0 or paletteHighlight + 1 >= palette.count) ? 0 : paletteHighlight + 1
      paletteCursor = next
      match first(palette.rows.filter((r) => r.index == next))
        case some(r)
          paletteScroll = next == 0 ? 0 : max(paletteScroll, r.top + r.height + 24 - paletteListHeight)
        case none
    if name == "ArrowUp" and palette.count > 0
      let previous = paletteHighlight <= 0 ? palette.count - 1 : paletteHighlight - 1
      paletteCursor = previous
      match first(palette.rows.filter((r) => r.index == previous))
        case some(r)
          paletteScroll = paletteHighlight <= 0 ? max(0, r.top + r.height + 24 - paletteListHeight) : min(paletteScroll, max(0, r.top - 24))
        case none
    if (name == "Back" or (name == "Backspace" and paletteQuery == "")) and palette.back
      palettePage = palette.parent
      paletteQuery = ""
      paletteCursor = paletteCursor >= 0 ? -1 : -2
      paletteScroll = 0
      focus("palette-input")
  action paletteHover(index: number, over: bool)
    paletteCursor = over and index >= 0 ? index : paletteCursor
  action paletteFlag(name: string)
    paletteCursor = -1
    paletteScroll = 0
    paletteCase = name == "case" ? not paletteCase : paletteCase
    paletteWord = name == "word" ? not paletteWord : paletteWord
    paletteRegex = name == "regex" ? not paletteRegex : paletteRegex
  action paletteRun(op: string, arg: string, arg2: string)
    if op == "page" or op == "browse" or op == "browse-to" or op == "mode"
      palettePage = op == "browse-to" ? palettePage : (op == "mode" ? "" : arg)
      paletteMode = op == "mode" ? arg : paletteMode
      paletteQuery = op == "browse" ? arg2 : (op == "browse-to" ? arg : "")
      paletteCursor = op == "mode" and arg == "content" ? -1 : -2
      paletteScroll = 0
      focus("palette-input") // a clicked row takes the focus on its mouse down (NSWindow), so the field takes it back
    if op == "device"
      paletteOpen = false
      send localChanged = command("device-setting", arg, arg2, 0)
    if op == "copy-thread"
      paletteOpen = false
      send localChanged = command("restlocal:copy-thread", ":", "", 0)
    let editing = settingsThemeDialog == "create" or settingsThemeDialog == "edit" or settingsThemeDialog == "duplicate"
    if op == "theme-editor"
      paletteOpen = false
      settingsThemeDialog = editing ? "" : "create"
      settingsThemeSubject = ""
      modalError = ""
    if op == "settings" or op == "project-settings"
      paletteOpen = false
      providerLinkTarget = ""
      settingsEnvironmentId = settings.environmentId
      settingsOpen = true
      settingsRoute = op == "project-settings" ? "projects" : arg
      settingsFocusTarget = op == "settings" ? arg2 : ""
      settingsThemeDialog = editing ? settingsThemeDialog : ""
      settingsThemeSubject = editing ? settingsThemeSubject : ""
      settingsQuery = ""
      settingsMenu = ""
      settingsMachine = ""
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = op == "project-settings" ? arg : ""
      modalError = ""
    if op == "usage" or op == "pull-requests" or op == "thread-pull-requests"
      paletteOpen = false
      settingsOpen = op == "thread-pull-requests" and settingsOpen // ⌘U from Settings leaves it, as the /usage route does
      if op != "thread-pull-requests"
        pageTrailNote(op)
      utilityPage = op == "thread-pull-requests" ? utilityPage : op
      rightPanelAt = op == "thread-pull-requests" ? shell.panel.key : rightPanelAt
    if (op == "flow" or op == "open-project" or op == "finder" or op == "open-file" or op == "thread" or op == "new-thread" or op == "thread-pull-requests") and not paletteBusy
      paletteBusy = true
      send paletteChanged = paletteCommand(op == "flow" ? arg : (op == "finder" ? "pick-folder" : op), op == "flow" ? arg2 : arg, op == "open-file" ? arg2 : palettePage)
  action paletteDone
    paletteBusy = false
    match paletteChanged
      case some(result)
        if result.close
          paletteOpen = false
        if result.page != "-"
          palettePage = result.page
          paletteQuery = result.query
          paletteCursor = -2
          paletteScroll = 0
        if (result.thread != "" or result.project != "") and not commandPending
          draftOwner = "__unset__"
          commandPending = true
          send changed = command(result.thread != "" ? "select-thread" : "new-thread", result.thread != "" ? result.thread : result.project, "", 0)
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
      case none
  mutation providerAuthChanged as shape Change queue refreshes data, providerPage, providerWizard
  mutation providerUpdateRun as shape Change queue refreshes providerPage
  mutation changed as shape Change refreshes data then commandCompleted
  mutation prQuickChanged as shape Change queue refreshes data
  mutation prConfirmChanged as shape Change refreshes data
  mutation localChanged as shape Change refreshes data
  mutation prHandoffChanged as shape Change refreshes data // a checkout hand-off's second half, its own send
  mutation terminalFocusChanged as shape Change refreshes data
  mutation fileCommentChanged as shape Change queue refreshes data // the Files preview's line comments (chatLocal)
  mutation lineDragChanged as shape Change queue refreshes data // a diff gutter drag's press, moves and release, each in turn
  mutation terminalChanged as shape Change refreshes data then terminalCompleted
  action terminalCompleted
    match terminalChanged
      case some(result)
        if result.message == "terminal:focus-composer"
          focus("composer")
      case none
  mutation fragmentChanged as shape Change refreshes data then fragmentOpened
  action fragmentOpened
    match fragmentChanged
      case some(result)
        if result.message == "sidebar:new-thread"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
      case none
  state commandPending = false
  state lineageStopping = ""
  // A row's double-click while its first click's open runs: the rename (its op and row) starts once the open lands,
  // on the environment it focused, as Sidebar.tsx's onDoubleClick renames after that click navigated.
  state renameAfterOp = ""
  state renameAfterId = ""
  state pendingModal = ""
  state modalError = ""
  state connecting = false
  state projectsOpen = false
  state providerSelected = ""
  state providerVisit = 0 // the provider links that changed the Providers page's target
  state providerLinkTarget = "" // the instance the route names (the last link's), apart from the page's own pick (providerSelected)
  state providerDialog = ""
  state providerSerial = 0
  state providerCreated = ""
  state providerTarget = ""
  state wizardDriver = "codex"
  state wizardLabel = ""
  state wizardLabelSet = false
  state wizardId = ""
  state wizardIdSet = false
  state wizardStep = 0
  state wizardManual = false
  state acpQuery = ""
  state providerNow = 0
  action providerTick
    if settingsOpen and (settingsRoute == "providers" or (settingsRoute == "connections" and connectionsPage.network.ticking))
      providerNow = performanceNow()
    providerDialog = (providerDialog == "chatgpt" and providerWizard.chatgptConnected) or providerPage.environment == "-" ? "" : providerDialog // AddCodexAccountDialog closes once the plan is shared; the page's dialogs close when its environment drops (they unmount with EnvironmentProviderSettings, ProviderSettingsPanel.tsx:551-586, 1377-1385)
  task providerClock mount
    every(1000, providerTick)
  resource providerPage = providerPage(providerSelected, settingsOpen and settingsRoute == "providers", data.revision, wallTime.epochAtZero + max(elapsed, providerNow), settingsMachine, settingsProjectKey, settingsCheckout, settingsProjectId) as shape ProviderPage // the scope's environment (providers-scope.ts): its page and its actions name `providerPage.environment`
  resource providerWizard = providerWizard(providerDialog != "", providerSerial, wizardManual ? "acpRegistry" : wizardDriver, wizardLabelSet, wizardLabel, wizardIdSet, wizardId, data.revision, providerDialog, providerTarget, providerPage.environment) as shape ProviderWizard
  state connectionRemove = ""
  state connectionMenu = ""
  resource connectionsPage = connectionsPage(settingsOpen and settingsRoute == "connections", data.revision, data.status, data.connected, data.connecting, wallTime.epochAtZero + max(elapsed, providerNow), transportFleetSeen) as shape ConnectionsPage
  state routeKeyboard = routeKeyboardIdle()
  derive routeKeyboardReady = settingsOpen and settingsRoute == "connections" and page.hasFocus and page.visibilityState == "visible" and not connecting and not projectsOpen and not paletteOpen and not welcome.show and providerDialog == "" and restEditor == "" and connectionRemove == ""
  derive routeKeyboardOwned = routeKeyboardReady and routeKeyboardLive(routeKeyboard, routeKeyboardSource(connectionsPage, routeKeyboard.environmentId, routeKeyboard.rowKey))
  task routeKeyboardLost when routeKeyboard.phase != "" and (not routeKeyboardOwned or (commandPending and routeKeyboard.phase == "lifted") or (routeKeyboard.phase == "saving" and not commandPending and not pending(changed)))
    after(1, cancelRouteKeyboard)
  action cancelRouteKeyboard
    routeKeyboard = routeKeyboardCancel(routeKeyboard)
  action routeKeyboardInput(environmentId: string, rowKey: string, routeId: string, k: string, repeat: bool)
    let next = routeKeyboardNext(routeKeyboard, environmentId, rowKey, routeId, k, repeat, routeKeyboardSource(connectionsPage, environmentId, rowKey), routeKeyboardReady, commandPending)
    if routeKeyboard.phase == "lifted" and next.phase == "saving" and not commandPending
      commandPending = true
      pendingModal = "connection"
      modalError = ""
      send changed = command("environment-route-move", next.rowKey, routeKeyboardValue(next), next.serial)
    routeKeyboard = next
  resource acpAgents = acpRegistry(acpQuery, providerDialog == "add" and wizardStep == 0, data.revision, providerPage.environment) as shape AcpRegistry
  state settingsOpen = false
  state settingsRoute = "general"
  state settingsRefresh = 0
  state keybindingQuery = ""
  state keybindingOpen = false
  state keybindingPrevious = ""
  state keybindingCommand = ""
  state keybindingKey = ""
  state keybindingWhen = ""
  state keybindingRecording = false
  resource bindings = keybindingSettings(settingsEnvironmentId, keybindingQuery, settingsOpen and settingsRoute == "keybindings", keybindingPrevious, keybindingKey, keybindingWhen, keybindingCommand, settingsRefresh, data.revision) as shape KeybindingPage
  resource scheduled = scheduledSettings(settingsEnvironmentId, settingsProjectId, restEditor, restSubject, settingsOpen and settingsRoute == "scheduled-tasks", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, taskBase, shellClock) as shape ScheduledPage // shellClock: the base-branch picker's next page (ref-loading.ts)
  state licenseQuery = ""
  state licenseExpanded = ""
  state licenseRetry = 0
  state diagnosticPeriod = "15m"
  resource shortcuts = keyboardDispatch(data.threads, browseProvider, modelQuery, composerFocused, data.running, modelsOpen, data.threadId == "", modal, settingsOpen, data.diffOpen or shell.panel.open, data.revision, paletteOpen, paletteMode, utilityPage == "pull-requests" and prSelected != "" and prPanelOpen ? prDetail.numberLabel : "", data.sidebar.undoUntil > wallTime.epochAtZero + max(liveNow, elapsed), settingsRoute, utilityPage, modelTarget.id, confirmOp, shell.panel.kind, prTab == "code") as shape KeyDispatch[]
  resource sourceControl = sourceControlPage(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "source-control", settingsRefresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout) as shape SourceControlPage
  resource integrations = integrationsPage(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "integrations", settingsRefresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, fdaPoll) as shape IntegrationsPage
  state fdaPoll = 0 // Poll Full Disk Access every 1.5 s and on window focus, only while visible; fdaPoll refreshes the wizard.
  task fdaPolling when integrations.browserProfiles.wizard.step == "fullDiskAccess" and page.visibilityState == "visible"
    every(1500, fdaTick)
  task fdaFocused when integrations.browserProfiles.wizard.step == "fullDiskAccess" and page.hasFocus and page.visibilityState == "visible"
    after(1, fdaTick)
  action fdaTick
    fdaPoll = fdaPoll + 1
  // However the import wizard closes (Cancel, Escape, Close, its X), Base UI's Dialog gives
  // the focus back to Add profile, whose menu opened it (the reference over CDP: Cancel by mouse leaves BUTTON "Add profile").
  state importWizardShown = false
  task importWizardFocus when integrations.browserProfiles.wizard.open != importWizardShown
    after(1, importWizardFlip)
  action importWizardFlip
    if importWizardShown and not integrations.browserProfiles.wizard.open
      focus("browser-profiles-add")
    importWizardShown = integrations.browserProfiles.wizard.open
  state importWizardAt = -1 // Wizard step/grant changes keep surviving focus or fall back to the popup. Removal returns to row options, then Add profile if deleted.
  state importWizardFocused = ""
  action importWizardFocusMoved(id: string, on: bool)
    if on
      importWizardFocused = id
    else if importWizardFocused == id
      importWizardFocused = ""
  task importWizardStepFocus when integrations.browserProfiles.wizard.focusAt != importWizardAt
    after(1, importWizardStep)
  action importWizardStep
    let wizard = integrations.browserProfiles.wizard
    if wizard.openedAt > importWizardAt
      focus(wizard.openFocus)
    else if wizard.focusAt >= 0 and importWizardFocused != "browser-import-popup" and not wizard.mounted.filter((element) => element.since <= importWizardAt).map((element) => element.id).includes(importWizardFocused)
      focus("browser-import-popup")
    importWizardAt = wizard.focusAt
  state removalAt = ""
  task removalFocus when integrations.browserProfiles.removalId != removalAt
    after(1, removalFlip)
  action removalFlip
    if removalAt == ""
      focus("browser-profile-remove-cancel")
    else if integrations.browserProfiles.rows.map((row) => row.id).includes(removalAt)
      focus(`browser-profile-options-${removalAt}`)
    else
      focus("browser-profiles-add")
    removalAt = integrations.browserProfiles.removalId
  resource storageSettings = storageSettings(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "storage", settingsRefresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout, wallTime.epochAtZero + elapsed) as shape StoragePage
  resource archives = archivedSettings(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "archived", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision, settingsMachine, settingsProjectKey, settingsCheckout) as shape ArchivePage
  resource licenses = licenseSettings(licenseQuery, licenseExpanded, licenseRetry, settingsOpen and settingsRoute == "open-source-licenses", data.revision) as shape LicenseSettings
  resource diagnostics = diagnosticsSettings(settingsEnvironmentId, diagnosticPeriod, settingsOpen and settingsRoute == "diagnostics", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision, data.telemetry) as shape DiagnosticsPage // a telemetry sample asks only this page again (data.telemetry); its reads are shared, so one asked again before a reply joins it (diagnostics-view.ts)
  state settingsFocusTarget = ""
  resource snapshotSettings = snapshotSettings(settingsOpen and settingsRoute == "snap-shot", settingsRefresh, data.revision, page.hasFocus) as shape SnapshotSettings // SnapShotSettings refreshState on window focus (exact2 #219): back from System Settings, the permissions read again
  state settingsQuery = ""
  resource settingsNavigation = settingsNavigation(settingsQuery, settingsCore.kind, settingsResultIndex, data.revision) as shape CoreNav
  state settingsProjectId = ""
  state settingsEnvironmentId = ""
  state settingsMachine = ""
  state settingsProjectKey = ""
  state settingsCheckout = ""
  state settingsMenu = ""
  state settingsResultIndex = 0
  state settingsScrollTop = 0 // settings search jump: the reveal offset (settings-a)
  // A page is its route, scope and restore count, as routes/settings.tsx keys its Outlet on the scope search and
  // restoreSignal: a new page mounts a new scroller at its top, and the jump's offset belongs to the page it revealed on.
  state settingsRestores = 0
  derive settingsPage = `${settingsRoute}|${settingsMachine}|${settingsProjectKey}|${settingsCheckout}|${settingsRestores}`
  state settingsScrollPage = ""
  derive settingsPageScrollTop = settingsScrollPage == settingsPage ? settingsScrollTop : 0
  task settingsPageLeft key=`${settingsOpen}|${settingsPage}`
    after(1, settingsPageForget)
  action settingsPageForget
    settingsScrollPage = settingsOpen and settingsScrollPage == settingsPage ? settingsScrollPage : ""
  state themeReveal = ""
  action themeRevealRequest(role: string)
    themeReveal = role
  task themeInspectRevealed when themeReveal != "" and settingsCore.editor.open and settingsCore.editor.filter == "" and (settingsCore.editor.advanced or themeReveal == "canvas" or themeReveal == "accent") key=themeReveal
    after(1, themeRevealed)
  action themeRevealed
    scrollIntoView(`theme-editor-row-${themeReveal}`, block="nearest", behavior="smooth")
    themeReveal = ""
  state themeUsage = []
  task themeUsageRefresh when settingsCore.editor.open key=settingsCore.editor.session
    every(100, themeUsageRead)
  action themeUsageRead
    themeUsage = settingsCore.editor.allRows.map((row) => ThemeRoleUsage(role=row.role, label=row.label, primaryIds=querySelectorAll(`[data-pick~="${row.role}"]`), nodes=querySelectorAll(`[data-paint~="${row.role}"]`).map((id) => ThemeUse(id=id, frame=frame(id))).filter((node) => node.frame.width > 0 and node.frame.height > 0)))
  state settingsThemeDialog = ""
  state settingsThemeSubject = ""
  state settingsThemeRequest = 0
  resource delivery = exactDelivery() as shape AboutDelivery // the binary's own update facts (settings-a-about)
  resource settingsCore = settingsCore(settingsMachine, settingsProjectKey, settingsCheckout, settingsProjectId, settingsRoute, settingsFocusTarget, settingsOpen, settingsRefresh, data.revision, settingsThemeDialog, settingsThemeSubject, delivery.stream, delivery.staged, scheme) as shape SettingsCore
  resource settings = settings(settingsEnvironmentId, settingsProjectId, data.revision, composerFocused, modal, data.running, data.threadId != "", modelsOpen) as shape Settings
  resource projectsSettings = projectsView(settingsProjectKey, settingsCheckout, settingsProjectId, settingsOpen and settingsRoute == "projects", settingsRefresh, data.revision) as shape ProjectsPage
  state sbQuery = ""
  state sbLetters = ""
  state sbLettersEdited = false
  state sbEmoji = ""
  state sbSshHost = ""
  resource sbSshHosts = settingsBSshHosts(connecting, sbSshHost, data.revision) as shape SbSshHosts
  state sshNow = 0
  state sshResponding = false
  state sshReturnToConnect = false
  resource sshPrompt = sshPrompt(wallTime.epochAtZero + sshNow) as shape SshPromptView
  mutation sshAnswered as shape SshPromptAnswer refreshes sshPrompt then sshAnswerDone
  task sshClock mount
    every(1000, sshTick)
  action sshTick
    if sshPrompt.open
      sshNow = performanceNow()
    if sshReturnToConnect and not sshPrompt.open and not commandPending
      sshReturnToConnect = false
      if connecting
        focus("ssh-connect")
  action sshAnswer(kind: string)
    if not sshResponding and sshPrompt.requestId != ""
      sshResponding = kind == "submit"
      send sshAnswered = sshPromptAnswer(sshPrompt.requestId, kind)
  action sshAnswerDone
    sshResponding = false
  resource pairFields = pairingFields(connecting ? origin : "") as shape PairFields // a pasted pairing URL fills Host and Pairing code
  action sbSet(which: string, value: string)
    if which == "query"
      sbQuery = value
    if which == "letters"
      sbLetters = value
      sbLettersEdited = true
    if which == "emoji"
      sbEmoji = value
    if which == "ssh-host"
      sbSshHost = value
  resource sbPicker = settingsBPicker(restEditor, sbQuery, (sbLettersEdited ? sbLetters : projectsSettings.iconLetters), sbEmoji, projectsSettings.iconCwd, projectsSettings.name, data.revision) as shape SbPicker
  state modelsOpen = false
  state browseProvider = ""
  state modelQuery = ""
  state modelTarget = PickerTarget(id="", top=0, bottom=0, left=0) // a General model row's picker
  resource catalog = modelCatalog(browseProvider, modelQuery, data.revision, modelTarget.id) as shape PickerCatalog
  resource editor = composerEditor(data.revision, wallTime.epochAtZero + elapsed) as shape ComposerEditorView // composer-editor.ts
  resource chip = composerChip(data.revision) as shape ChipPopover // a skill chip's details popover (composer-chip-popover.ts)
  derive chipCovered = chip.open and chip.surface == "composer" and (settingsOpen or pageCover) // Close chip details when Settings/pages cover our mounted composer; palette/dialog overlays preserve them, as the reference does.
  task chipCover when chipCovered key=chip.seq
    after(1, chipCoverClose)
  action chipCoverClose
    editorOp("chip-close", `${chip.seq}`, "")
  // A chip press that is an action (a mention, thread, citation source, pull request or attachment; composer-chip-details.ts)
  // is sent once, in its own turn.
  state chipActed = 0
  task chipAct when chip.act != "" and chip.seq > chipActed key=chip.seq
    after(1, chipActRun)
  action chipActRun
    chipActed = chip.seq
    editorOp("chip-act", `${chip.seq}`, "")
  state optionsOpen = ""
  state branchQuery = ""
  resource branches = composerBranches(optionsOpen == "branch", branchQuery, data.revision, shellClock) as shape ComposerBranches
  state popoverSession = 0
  state origin = ""
  state originEdited = false
  state draft = ""
  state draftOwner = "__unset__"
  state draggedWidth = 0
  state sidebarHoverId = ""
  state jumpRequest = 0
  state composerFocused = false
  action composerFocus
    composerFocused = true
  action composerBlur
    composerFocused = false
    composerTyping = false
  // COMPOSER_TYPING_IDLE_MS: the draft's last edit in the focused composer, until 1.5 s pass without another.
  state composerTyping = false
  state typingSerial = 0
  task composerTypingIdle when composerTyping key=typingSerial
    after(1500, composerTypingIdled)
  action composerTypingIdled
    composerTyping = false
  action scrollToEnd
    jumpRequest = jumpRequest + 1
    foldHold = false
  derive modal = connecting or projectsOpen or paletteOpen or settingsOpen or providerDialog != "" or restEditor != "" or welcome.show
  resource sidebarLaunch = sidebarLaunchWidth(viewport.width, data.revision) as shape number // threadSidebarWidth.ts (sidebar-width.ts): no stored width sizes the sidebar once at load
  derive sidebarWidth = draggedWidth == 0 and sidebarLaunch > 0 ? sidebarLaunch : min(max(max(208, data.sidebarMinWidth), draggedWidth > 0 ? draggedWidth : data.sidebarWidth), max(max(208, data.sidebarMinWidth), viewport.width - 640)) // a stored width: at least the minimum (13rem, or the brand at the Interface font size: sidebar-min-width.ts), leaving 40rem of main content
  derive narrowDiff = viewport.width <= 980
  state diffUserWidth = 540
  derive diffWidth = narrowDiff ? (viewport.width <= 760 ? min(viewport.width * 0.88, 384) : min(448, max(320, viewport.width * 0.42))) : max(360, min(diffUserWidth, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action resizeDiff(dx: number, dy: number)
    diffUserWidth = max(360, min(diffWidth - dx, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action finishDiffResize(vx: number, vy: number)
    diffUserWidth = diffWidth
  derive conversationWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - ((data.diffOpen or rightPanel or shell.panel.open) and not narrowDiff ? diffWidth : 0)
  derive composerOwner = data.composerOwner // `${serverUrl}:${projectId}:${threadId}`; a draft Auto balance moved keeps its own (auto-balance-owner.ts)
  derive composerText = draftOwner == `${composerOwner}${data.requestKey}` ? draft : data.draft
  action closeOptions
    optionsOpen = ""
    focus("composer")
  action openOptions(name: string)
    focus(optionsOpen == name ? "composer" : name == "effort" ? "composer-menu" : name == "runtime" ? `composer-menu-item-${data.composer.runtimeSelected}` : name == "branch" ? "branch-search" : name == "workspace" ? "composer-menu" : "composer-menu-item-0")
    optionsOpen = optionsOpen == name ? "" : name
    branchQuery = ""
    modelsOpen = false
    popoverSession = popoverSession + 1
  action menuCommand(op: string, id: string, value: string, n: number)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, n)
  action searchBranches(value: string)
    branchQuery = value
  action composerKey(op: string, id: string, value: string) // A composer control's key name (composer-controls-commands.ts).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, value, 0)
  action composerDrop(op: string, id: string, vx: number, vy: number) // A queued row's grip released (pan release).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, "", 0)
  action menuPick(op: string, id: string, value: string)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, 0)
  action commandCompleted
    noticeExit = ""
    match changed
      case some(result)
        routeKeyboard = routeKeyboardComplete(routeKeyboard, result.routeReorder, result.message, routeKeyboardOwned)
        if result.relaunch
          relaunch()
        if pendingModal != ""
          modalError = result.message == "task-webhook-keep" or result.message.startsWith("toasted:") ? "" : result.message
        if result.message == "" or result.message == "task-webhook-keep"
          if pendingModal == "connect-first" or pendingModal == "connect"
            connecting = false
            origin = ""
            originEdited = false
          if pendingModal == "welcome-pair"
            welcomeLink = ""
            welcomePairOpen = false
          if pendingModal == "provider-add" or pendingModal == "provider-add-local"
            providerDialog = pendingModal == "provider-add-local" ? "" : wizardManual or wizardDriver == "acpRegistry" ? providerDialog : ""
            providerSelected = providerCreated
          if pendingModal == "provider-close"
            providerDialog = ""
          if pendingModal == "provider-acp"
            wizardManual = false
            wizardDriver = "acpRegistry"
            wizardStep = 1
          if pendingModal == "rest"
            keybindingOpen = false
            keybindingPrevious = ""
            keybindingRecording = false
            if restEditor == "project-remove" and restSubject == ""
              settingsOpen = false
              settingsProjectKey = ""
              settingsProjectId = ""
              settingsCheckout = ""
            if result.message != "task-webhook-keep"
              restEditor = ""
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "settings"
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "theme-dialog"
            settingsThemeDialog = ""
        if result.message.startsWith("branch-restore-confirm:")
          confirmTitle = `Switch to ${result.message.slice(23)}?`
          confirmBody = "You have uncommitted changes. They'll carry over to the other branch, or block the switch if they conflict."
          confirmDestructive = false
          confirmOp = "cc:branch-restore-confirmed"
          confirmTarget = ""
          confirmValue = ""
          focus("app-confirm-cancel")
        if result.message == "terminal:focus-composer"
          focus("composer")
        if result.message.startsWith("focus:") and (result.message != "focus:composer" or (data.sidebar.renameId == "" and renameAfterOp == "" and not data.sidebar.renameHeld)) // an opening rename owns focus over its row's late thread-open result
          focus(result.message.slice(6))
        if result.message.startsWith("sidebar:pr-page:") // with no thread open, the pull request on the Pull Requests page (before any branch below sets utilityPage: openPage reads it)
          openPage("pull-requests")
          prSelect(result.message.slice(16))
        if result.message == "sidebar:new-thread" or result.message == "pr-handoff-next"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
        if result.message.startsWith("sidebar:opened") // a row's pull request or port went to its thread first (openThread's own effects); `:focus`, ChatView's composer focus on a thread change
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          if result.message == "sidebar:opened:focus"
            focus("composer")
        if result.message == "pr-handoff-next" // the thread shows first, then its checkout runs (pages-pr-handoffs.ts)
          send prHandoffChanged = command("pageslocal:pr-act-handoff-run", "", "", 0)
        if result.message == "sidebar:palette-new-thread" or result.message.startsWith("palette:") // `palette:<page>` (the linked threads, on the pull request's URL; the thread picker)
          paletteOpen = true
          paletteMode = "command"
          palettePage = result.message == "sidebar:palette-new-thread" ? "new-thread-in" : result.message.slice(8)
          paletteQuery = result.message.startsWith("palette:pr-linked|") ? result.message.slice(18) : ""
          paletteCursor = -1
          paletteScroll = 0
          modelsOpen = false
          optionsOpen = ""
          focus("palette-input")
        if result.message.startsWith("pr-select:") // a pull request link opens on the page
          prSelect(result.message.slice(10))
        if result.message.startsWith("sidebar:project-settings:")
          openSettings() // a project link replaces the whole scope (retainSettingsScope)
          settingsProjectId = result.message.slice(25)
          settingsRoute = "projects"
      case none
    pendingModal = ""
    commandPending = false
    lineageStopping = ""
    if renameAfterOp != ""
      send localChanged = command(`sidebarlocal:${renameAfterOp}`, renameAfterId, "", 0)
      renameAfterOp = ""
  action command(op: string, id: string, value: string, n: number)
    if op == "chatlocal:item-detail"
      send timelineDisclosureChanged = command(op, id, value, n)
    else if op == "diffreview" and (id.startsWith("drag:") or id.startsWith("gutter:") or id.startsWith("comment:") or id == "to" or id == "end")
      // A gutter drag sends at its press, on each line and at its release; a click's press and
      // release come within a few ms, so they queue on their own send (a later send on one mutation would replace the
      // press before it ran, and `changed` takes one command at a time). The "+"'s press queues behind its drag.
      send lineDragChanged = command(op, id, value, n)
    else
      if op.endsWith(":focus-in") or op.endsWith(":focus-out")
        send terminalFocusChanged = command(op, id, value, n)
      else if op.startsWith("terminallocal:") or op.startsWith("terminalpanellocal:")
        send terminalChanged = command(op, id, value, n)
      else if op == "draft" or op == "search" or op == "sidebar" or op == "answer" or op == "choice" or op == "dismiss-error" or op == "close-diff" or op == "diff-view" or op == "favorite-model"
        send localChanged = command(op, id, value, n)
      else
        if not commandPending
          commandPending = true
          send changed = command(op, id, value, (n == 0 and op.startsWith("chat:")) ? wallTime.epochAtZero + performanceNow() : n)
  action editKeybindingQuery(value: string)
    keybindingQuery = value
  action newKeybinding
    keybindingPrevious = "new"
    keybindingCommand = ""
    keybindingKey = ""
    keybindingWhen = ""
    keybindingRecording = false
    keybindingOpen = true
    modalError = ""
  action editKeybinding(previous: string, commandName: string, shortcut: string, condition: string)
    if keybindingPrevious != previous
      keybindingPrevious = previous
      keybindingCommand = commandName
      keybindingKey = shortcut
      keybindingWhen = condition
      keybindingRecording = false
  action recordKeybinding(previous: string, commandName: string, shortcut: string, condition: string)
    if keybindingPrevious != previous
      keybindingPrevious = previous
      keybindingCommand = commandName
      keybindingKey = shortcut
      keybindingWhen = condition
    keybindingRecording = true
  action chooseKeybindingCommand(value: string)
    keybindingCommand = value
  action editKeybindingKey(value: string)
    keybindingKey = value
    keybindingRecording = false
  action editKeybindingWhen(value: string)
    keybindingWhen = value
  action captureKeybinding(original: string, value: string) // the recorder's chord; "escape" restores, "blur" keeps the draft
    keybindingKey = value == "escape" ? original : (value == "blur" ? keybindingKey : value)
    keybindingRecording = false
  action cancelKeybinding
    keybindingOpen = false
    keybindingPrevious = ""
    keybindingRecording = false
    modalError = ""
  action settingsCommand(op: string, id: string, value: string)
    if not commandPending
      commandPending = true
      pendingModal = "settings"
      modalError = ""
      settingsRestores = settingsRestores + (op == "settings-core" and id == `restore-device-defaults:|${settingsCore.scopeKey}` ? 1 : 0)
      send changed = command(op, id, value, 0)
  action previewSnapshotSound(sound: string)
    if not commandPending
      commandPending = true
      pendingModal = ""
      send changed = command("snapshot-preview-sound", "", sound, 0)
  action removeSnapshot(imageId: string)
    send changed = command("remove-snapshot", imageId, "", 0)
  action clearModalError // SnapShot's setup dialog (T3Window toggleSnapshots, showSnapshotSetup)
    modalError = ""
  action openProviderSettings(id: string)
    let machine = settingsOpen ? settingsCore.scopeEnvironment : settings.environmentId // a setup link names its environment: Settings' own the scope's representative (ProjectDefaultsSettings.tsx:168-173), none without one; the chat's its thread's (ChatView.tsx:5217-5223)
    if not settingsOpen or machine != ""
      providerVisit = providerLinkVisit(providerVisit, settingsOpen and settingsRoute == "providers", settingsMachine, providerLinkTarget, id == "" ? "" : machine, id == "" ? "" : `target:${id}`)
      openSettings() // retainSettingsScope: a link from outside Settings starts with no scope
      settingsRoute = "providers"
      settingsMachine = id == "" ? "" : machine
      providerSelected = id == "" ? "" : `target:${id}`
      providerLinkTarget = id == "" ? "" : `target:${id}`
  action openSettings
    sidebarHoverId = "" // the Settings button's tooltip closes on its press
    settingsEnvironmentId = settings.environmentId
    settingsOpen = true
    settingsRoute = "general"
    settingsMenu = ""
    settingsMachine = ""
    settingsProjectKey = ""
    settingsCheckout = ""
    settingsProjectId = ""
    modalError = ""
  // The search jump's target page has its data: the jump scrolls once that page is laid out.
  derive settingsJumpReady = settingsOpen and settingsFocusTarget != "" and (settingsRoute != "storage" or storageSettings.available) and (settingsRoute != "archived" or archives.available) and (settingsRoute != "diagnostics" or diagnostics.available) and (settingsRoute != "keybindings" or bindings.available) and (settingsRoute != "scheduled-tasks" or scheduled.available) and (settingsRoute != "source-control" or sourceControl.available) and (settingsRoute != "integrations" or integrations.available) and ((settingsRoute != "general" and settingsRoute != "appearance") or (settingsCore.ready and settingsCore.route == settingsRoute and settingsCore.sections.length > 0))
  action focusSettingsTarget
    if settingsJumpReady
      settingsScrollPage = settingsPage
      settingsScrollTop = max(0, frame(settingsFocusTarget).y - frame("settings-content-column").y + frame(settingsFocusTarget).height / 2 - frame("settings-content-scroll").height / 2) + (settingsScrollTop == floor(settingsScrollTop) ? 0.25 : 0)
      focus(settingsFocusTarget)
      settingsFocusTarget = ""
  // As scrollToSettingsTarget runs once the hash target mounts: a native `after(1, …)` runs after the layout the
  // change made. The poll below is a backstop.
  task settingsJump when settingsJumpReady key=`${settingsFocusTarget}|${settingsPage}`
    after(1, focusSettingsTarget)
  task settingsSearchFocus mount
    every(1000, focusSettingsTarget)
  action editSettingsQuery(value: string)
    settingsFocusTarget = ""
    settingsQuery = value
    settingsResultIndex = 0
  action deviceSetting(id: string, value: string)
    send localChanged = command("device-setting", id, value, 0)
  action coreChange(row: string, part: string, value: string)
    settingsMenu = ""
    if part == "picker"
      openModels()
      modelTarget = PickerTarget(id=`${row}:|${settingsCore.scopeKey}`, top=frame(`setting-${row}`).y, bottom=frame(`setting-${row}`).y + frame(`setting-${row}`).height, left=frame(`setting-${row}`).x)
    else if row == "background-activity" and value == "advanced"
      settingsThemeDialog = "background-activity"
      modalError = ""
    else
      settingsCommand("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, value)
  action coreMenu(section: string, id: string)
    settingsMenu = (id == "" or settingsMenu == id) ? "" : id
  action coreMenuClose
    settingsMenu = ""
  action coreScope(project: bool, id: string, member: string)
    settingsMenu = ""
    modalError = ""
    providerSelected = "" // routes/settings.tsx keys the page on its scope: Providers starts over on the new environment's first row
    providerLinkTarget = ""
    settingsProjectKey = project ? id : settingsProjectKey
    settingsCheckout = project ? "" : settingsCheckout
    settingsProjectId = project ? member : settingsProjectId
    settingsMachine = project ? settingsMachine : id
  action coreNoticeScope(project: string, machine: string, member: string)
    settingsMenu = ""
    modalError = ""
    providerSelected = ""
    providerLinkTarget = ""
    settingsProjectKey = project
    settingsCheckout = ""
    settingsProjectId = member
    settingsMachine = machine
  action coreNavigate(route: string)
    settingsRoute = route
    providerLinkTarget = "" // a route reached without a provider link names no instance
    if route == "diagnostics" and settings.environmentId != ""
      settingsMachine = settings.environmentId
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = ""
    settingsMenu = ""
    settingsQuery = ""
    modalError = ""
  action corePick(route: string, target: string, scope: string, id: string)
    settingsRoute = route
    providerLinkTarget = ""
    settingsFocusTarget = target
    settingsQuery = ""
    settingsMenu = ""
    modalError = ""
  action coreSearchKey(k: string)
    if k == "/"
      focus("settings-search")
    if k == "Escape"
      settingsQuery = ""
      settingsResultIndex = 0
    if k == "ArrowDown"
      settingsResultIndex = settingsResultIndex + 1
    if k == "ArrowUp"
      settingsResultIndex = settingsResultIndex + settingsNavigation.count - 1
    if k == "Enter" and settingsNavigation.firstRoute != ""
      settingsRoute = settingsNavigation.firstRoute
      providerLinkTarget = ""
      settingsFocusTarget = settingsNavigation.firstTarget
      settingsQuery = ""
      settingsMenu = ""
      modalError = ""
  action coreClearSearch
    settingsQuery = ""
    focus("settings-search")
  action coreThemeDialog(kind: string, theme: string)
    settingsThemeDialog = kind
    settingsThemeRequest = settingsThemeRequest + 1
    settingsThemeSubject = kind == "create" or kind == "edit" or kind == "duplicate" ? `${theme}#${settingsThemeRequest + 1}` : theme
    modalError = ""
  action coreThemeChange(row: string, part: string, value: string)
    if not commandPending
      commandPending = true
      pendingModal = "theme-dialog"
      modalError = ""
      send changed = command("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, value, 0)
  mutation automationRecordingServed0 as shape Change queue refreshes data // the agent's recordings: four sends, each queued (automationRecording)
  mutation automationRecordingServed1 as shape Change queue refreshes data
  mutation automationRecordingServed2 as shape Change queue refreshes data
  mutation automationRecordingServed3 as shape Change queue refreshes data
  mutation themeLive as shape Change refreshes data // the colour picker's own, so no other local op forgets its reply (the picker waits for it)
  action coreThemeLive(part: string, id: string, value: string, n: number) // the colour picker's draft ops (theme-color-picker.contract), never behind another command
    send themeLive = command(`themelocal:${part}`, id, value, n)
  state restEditor = ""
  state restSubject = ""
  state taskBase = "" // the scheduled editor's picker: its project, base and search (settings-scheduled.contract taskPicker), new with each editor
  action restTaskBase(value: string)
    taskBase = value
  action restOpen(editor: string, subject: string) // the window's half: the dialog label, the row menu
    sbQuery = ""
    sbLettersEdited = false
    sbEmoji = ""
    restEditor = editor
    restSubject = subject
    modalError = ""
    taskModelPick = ""
    taskBase = ""
  action restClose
    restEditor = ""
    modalError = ""
    taskModelPick = ""
    taskBase = ""
  action restLocal(op: string, value: string)
    send localChanged = command(`restlocal:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, value, 0)
  action restRaw(op: string, id: string, value: string) // a settings editor's command, also as rest and restInput (T3Window)
    if not commandPending
      commandPending = true
      pendingModal = "rest"
      modalError = ""
      send changed = command(op, id, value, 0)
  action refreshSettings
    settingsRefresh = settingsRefresh + 1
  action editLicenseQuery(value: string)
    licenseQuery = value
  action toggleLicense(id: string)
    licenseExpanded = licenseExpanded == id ? "" : id
  action retryLicenses
    licenseRetry = licenseRetry + 1
  action selectDiagnosticPeriod(value: string)
    diagnosticPeriod = value
  action copyDiagnostic(value: string)
    send localChanged = command("copy-diagnostic", "", value, 0)
  action providerUi(what: string, value: string) // the window's half: whether the wizard tried to go on
    modalError = ""
    providerSelected = what == "select" ? value : providerSelected
    if what == "open"
      providerDialog = value
      providerSerial = providerSerial + 1
      wizardDriver = "codex"
      wizardLabel = ""
      wizardLabelSet = false
      wizardId = ""
      wizardIdSet = false
      wizardStep = 0
      wizardManual = false
      acpQuery = ""
    if what == "close"
      providerDialog = ""
    if what == "hub-remove" or what == "setup-logout" or what == "setup-remove" or what == "codex-picker" or what == "acp-delete" or what == "acp-disable"
      providerDialog = what
      providerTarget = value
    if what == "driver" or what == "manual"
      wizardDriver = what == "driver" ? value : wizardDriver
      wizardManual = what == "manual" and value == "true"
      wizardLabelSet = false
      wizardIdSet = false
    if what == "label"
      wizardLabel = value
      wizardLabelSet = true
    if what == "id"
      wizardId = value
      wizardIdSet = true
    if what == "acp"
      acpQuery = value
    if what == "step"
      let target = value == "back" ? max(0, wizardStep - 1) : min(wizardManual ? 1 : 2, value == "next" ? wizardStep + 1 : (value == "2" ? 2 : (value == "1" ? 1 : 0)))
      wizardStep = wizardStep <= 1 and target > 1 and providerWizard.idError != "" ? 1 : target // the window's half marks the attempt
  action providerOp(op: string, id: string, field: string, value: string, apply: bool)
    if op.startsWith("upkeep:update") and apply
      send providerUpdateRun = providerChange(op, id, field, value, providerPage.environment, providerPage.projectIds)
    else if (op.startsWith("setup:") or op.startsWith("upkeep:")) and apply
      send providerAuthChanged = providerChange(op, id, field, value, providerPage.environment, providerPage.projectIds)
    else if apply and not commandPending
      commandPending = true
      pendingModal = op == "acp-prepare" ? "provider-acp" : (op == "provider-hub-add" or op == "provider-hub-remove" or (op == "provider-chatgpt" and welcome.show) ? "provider-close" : "provider")
      modalError = ""
      send changed = providerChange(op, id, field, value, providerPage.environment, providerPage.projectIds)
  action providerAccent(id: string, hex: string, vx: number, vy: number)
    if not commandPending
      commandPending = true
      pendingModal = "provider"
      modalError = ""
      send changed = providerChange("provider-accent", id, "", hex, providerPage.environment, "")
  action providerAdd(driver: string, label: string, id: string, accent: string, fields: string[], commandArgs: string[]) // the window's half marks the attempt
    if not commandPending
      commandPending = true
      pendingModal = driver == "acpRegistry" and fields.slice(0, 1).join("") == "local" ? "provider-add-local" : "provider-add"
      providerCreated = id
      modalError = ""
      send changed = providerAdd(driver, label, id, accent, fields, providerPage.environment, commandArgs)
  action connectionOp(op: string, id: string, value: string)
    if not commandPending
      sshReturnToConnect = op == "environment-ssh-add" or op == "environment-ssh-pick"
      draftOwner = "__unset__"
      commandPending = true
      pendingModal = (op == "environment-add" or op == "environment-route-add" or op == "environment-ssh-add" or op == "environment-ssh-pick") ? (data.connected ? "connect" : "connect-first") : "connection"
      modalError = ""
      connectionRemove = ""
      send changed = command(op, id, value, 0)
  action connectionAskRemove(target: string)
    connectionRemove = target
    connectionMenu = ""
  action connectionToggleMenu(target: string)
    connectionMenu = connectionMenu == target ? "" : target
  action openConnection // and Add a route (T3Window openRoute); the window's half: the credential, the route target
    modalError = ""
    connecting = true
    sbSshHost = ""
  action closeConnection
    modalError = "" // closing Add Environment clears its error (setSavedBackendError(null))
    pendingModal = ""
    connecting = false
    origin = ""
    originEdited = false
  action closeModal
    pendingModal = ""
    connecting = false
    projectsOpen = false
    paletteOpen = false
    settingsOpen = false
    keybindingOpen = false
    providerDialog = ""
    connectionRemove = ""
    modelsOpen = false
    origin = ""
    originEdited = false
  action editOrigin(value: string) // the window's half fills the credential from a pasted pairing URL
    origin = value
    originEdited = true
  action editCredential // the window's half keeps the typed credential
    origin = pairFields.host != "" and pairFields.source == origin ? pairFields.host : origin
  action resizeSidebar(dx: number, dy: number)
    draggedWidth = min(max(max(208, data.sidebarMinWidth), viewport.width - 640), max(max(208, data.sidebarMinWidth), sidebarWidth + dx))
  action openProjects
    projectsOpen = true
  action selectProject(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-project", id, "", 0)
      projectsOpen = false
  action manageProject(id: string, name: string, path: string)
    projectsOpen = false
    openSettings() // a project link replaces the whole scope (retainSettingsScope)
    settingsProjectId = id
    settingsRoute = "projects"
  action selectThread(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, "", 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action openThread(id: string, how: string) // Sidebar (sidebar-commands.ts): a row press says how it opened ("click", "click:meta" and "click:shift" multi-select, "search" clears it).
    if not commandPending and id != ""
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, how, 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action sidebarLocal(op: string, id: string, value: string)
    if (op == "rename-start" or op == "legacy-rename-start") and commandPending
      renameAfterOp = op
      renameAfterId = id
    else
      send localChanged = command(`sidebarlocal:${op}`, id, value, 0)
  action sidebarRun(op: string, id: string, value: string)
    if composerFocused and (op == "menu-choice" or op == "draft-choice" or op == "legacy-thread-menu")
      blur()
    if not commandPending
      commandPending = true
      send changed = command(`sidebar:${op}`, id, value, wallTime.epochAtZero + performanceNow())
  action sidebarHover(id: string, over: bool) // the window's half sets the card's geometry (app-window.contract)
    if over
      sidebarHoverId = id
      if data.sidebar.searching
        send localChanged = command("sidebarlocal:search-hover", id, "", 0)
    else if sidebarHoverId == id
      sidebarHoverId = ""
  action resetSidebarWidth
    draggedWidth = 0
    send localChanged = command("sidebarlocal:width-reset", "", "", 0)
  action sidebarNewThread(e: MouseEvent) // ⇧-click creates at once (the press's own modifiers; a chord's press has none)
    if not commandPending
      if data.sidebar.projectGroupCount > 1
        commandPending = true
        send changed = command("sidebar:new-thread-click", "", e.shiftKey ? "shift" : "", 0)
      else
        if data.projectId != ""
          draftOwner = "__unset__"
          commandPending = true
          send changed = command("new-thread", "", "", 0)
          jumpRequest = jumpRequest + 1
          focus("composer")
          utilityPage = ""
  action newThread
    if not commandPending
      if data.projectId != ""
        draftOwner = "__unset__"
        commandPending = true
        send changed = command("new-thread", "", "", 0)
        jumpRequest = jumpRequest + 1
        focus("composer")
        utilityPage = ""
      else
        projectsOpen = true
  action write(value: string)
    draft = value
    draftOwner = `${composerOwner}${data.requestKey}`
    // Typing the thread draft (not an answer) holds a request that arrives meanwhile (composer-typing-guard.ts).
    if composerFocused and data.requestMode == ""
      composerTyping = true
      typingSerial = typingSerial + 1
    send localChanged = command("draft", "", value, 0)
  action send(held: string) // held: a pointer press's own modifiers (press-modifiers.contract), "" from a key or a call
    if not commandPending and editor.overLimit and data.requestMode != "question"
      send localChanged = command("editorlocal:arm-limit", "", "", 0)
    if not commandPending and (not editor.overLimit or data.requestMode == "question")
      if data.requestMode == "question" or (data.canSend and (composerText != "" or data.snapshotDrafts.length > 0))
        commandPending = true
        send changed = command("send", held == "" ? "" : `pointer:${held}`, composerText, 0)
        composerTyping = false
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action editorOp(op: string, id: string, value: string) // composer-editor.ts: menu picks, the stash
    send localChanged = command(`editorlocal:${op}`, id, value, wallTime.epochAtZero + performanceNow())
  action openModels
    focus(modelsOpen ? "composer" : "model-search")
    modelsOpen = not modelsOpen
    popoverSession = popoverSession + 1
    browseProvider = ""
    modelQuery = ""
    optionsOpen = ""
    modelTarget = PickerTarget(id="", top=0, bottom=0, left=0)
  action closeModels
    modelsOpen = false
    focus(modelTarget.id == "" ? "composer" : `setting-${modelTarget.id.slice(0, modelTarget.id.indexOf(":"))}`)
  action searchModels(value: string)
    modelQuery = value
  action selectProvider(id: string)
    browseProvider = id
    modelQuery = ""
    focus("model-search")
  action selectModel(id: string, provider: string, additive: bool)
    if id != "" and modelTarget.id.startsWith("task-model:")
      taskModelPick = `${provider}:${id}`
      modelsOpen = false
      focus("setting-task-model")
    else if id != "" and (modelTarget.id.startsWith("source-control-writer-model:") or modelTarget.id.startsWith("review-guide-model:"))
      modelsOpen = false
      focus(modelTarget.id.startsWith("review-guide-model:") ? "setting-review-guide-model" : "setting-source-control-writer-model")
      restRaw("rest:scoped", modelTarget.id.slice(modelTarget.id.indexOf(":|") + 2, modelTarget.id.length), `key=${modelTarget.id.startsWith("review-guide-model:") ? "reviewGuideModelSelection" : "sourceControlWriterModelSelection"}&value=${encodeURIComponent(`${provider}:${id}`)}`)
    else if not commandPending and id != ""
      commandPending = true
      pendingModal = modelTarget.id == "" ? "" : "settings" // a General row's pick is that setting's write, never the thread's model
      send changed = command(modelTarget.id == "" ? "model" : "settings-core", modelTarget.id == "" ? id : modelTarget.id, modelTarget.id == "" ? provider : `${provider}|${id}`, additive and modelTarget.id == "" ? 1 : 0)
      modelsOpen = additive and modelTarget.id == "" and catalog.multiple
      focus(additive and modelTarget.id == "" and catalog.multiple ? "model-search" : (modelTarget.id == "" ? "composer" : `setting-${modelTarget.id.slice(0, modelTarget.id.indexOf(":"))}`))
  state taskModelPick = "" // the open scheduled task editor's picked `instance:model`, until it closes
  action pickModel(row: string, context: string)
    openModels()
    modelTarget = PickerTarget(id=`${row}:|${context}`, top=frame(`setting-${row}`).y, bottom=frame(`setting-${row}`).y + frame(`setting-${row}`).height, left=frame(`setting-${row}`).x)
  action prConfirmDisarm(ref: string, serial: string)
    send prConfirmChanged = command("chatlocal:pr-ui-disarm", ref, serial, 0)
  action chatLocal(op: string, id: string, value: string)
    // A disclosure toggled with the transcript at its end keeps the end in view while the rows re-measure (the list goes
    // on following it); anywhere else the toggled row holds its place (MessagesTimeline's disclosurePinsEnd).
    if (op == "fold" or op == "group" or op == "attempt" or op == "tree-all" or op == "tree-dir") and not (restAtEnd and restOwner == composerOwner)
      foldHold = true
    if op == "surface-close-others" or op == "surface-close-to-right" or op == "surface-close-all" or (op == "surface-close" and shell.panel.tabs.filter((tab) => tab.id == id and tab.closeTitle != "").length == 0) or (op == "surface-browser-float" and not shell.panel.browser.capture.floating) or op == "surface-session-float" or (op == "surface-files-search-key" and id == "sheet" and value == "Escape")
      rightPanelAt = ""
    if op == "surface-pr-quick"
      send prQuickChanged = command(`chatlocal:${op}`, id, value, 0)
    else if op.startsWith("surface-files-comment-")
      send fileCommentChanged = command(`chatlocal:${op}`, id, value, 0)
    else if op == "pr-code-drag" or op == "pr-code-begin"
      send lineDragChanged = command(`chatlocal:${op}`, id, value, 0) // the Code tab's gutter drags and "+", in turn
    else if op == "link-open" and value.startsWith("#")
      send fragmentChanged = command(`chatlocal:${op}`, id, value, 0) // fragmentOpened
    else
      send localChanged = command(`chatlocal:${op}`, id, op == "table-menu" ? `${frame(`table-copy-${id}`).x}|${frame(`table-copy-${id}`).y}|${frame(`table-copy-${id}`).width}|${frame(`table-copy-${id}`).height}|${viewport.width}|${viewport.height}|${value}` : value, 0) // a table popup's trigger frame
  state foldHold = false
  action releaseFold
    if foldHold
      foldHold = false
  action answerRevert(choice: string)
    if choice != "cancel"
      draftOwner = "__unset__"
    send localChanged = command("chatlocal:revert-answer", "", choice, 0)
  action earlier
    if not commandPending
      if data.hasMore and not data.historyLoading
        commandPending = true
        send changed = command("chatlocal:history", "", "", 0)
  state shellClock = 0
  state toastDismissed = ""
  state toastHover = false
  state shellOpenHandled = ""
  resource page = exactPage() as shape Page // the window's focus and visibility (document.hasFocus(), exact2 #219): thread notifications and activity reports
  resource shell = shellView(data.revision, wallTime.epochAtZero + shellClock, toastDismissed, toastHover, viewport.width <= 980, page.hasFocus, page.visibilityState) as shape ShellView
  resource filesMarkdown = renderFileMarkdown(shell.panel.files.markdownSource.concat(shell.panel.attachment.markdownSource).concat(shell.composerFile.file.markdownSource)) as shape TranscriptMarkdown
  state rightPanelAt = ""
  derive rightPanel = (rightPanelAt != "" and rightPanelAt == shell.panel.key) or shell.panel.launcher
  state detailsOpen = false
  resource details = shellDetails(detailsShown, data.threadId, data.revision, conversationWidth >= 1012, wallTime.epochAtZero + shellClock, floor(viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - conversationWidth), page.hasFocus and page.visibilityState == "visible") as shape ShellDetails
  state canvasGestureValue = ""
  action canvasGesture(value: string)
    canvasGestureValue = value
    detailsOpen = detailsOpen and value == "" // a drag on the player is outside the details popover (Base UI's outside press; a press: T3Window outsidePressDown)
  resource canvas = chatCanvas(data.revision, conversationWidth, viewport.height, conversationWidth >= 1012 and data.projectId != "", data.look.chatMax, data.messages.length > 0 or data.threadId != "", canvasGestureValue, `${shell.panel.deviceMini.key}|${shell.panel.browserMini.key}`, shell.panel.deviceMini.show or shell.panel.browserMini.show, conversationWidth >= 1012, detailsOpen) as shape ChatCanvasView
  state detailsEpoch = 0
  derive detailsPopover = canvas.ready ? canvas.popover : conversationWidth < 1012
  derive detailsShown = detailsOpen and detailsPopover and detailsEpoch == canvas.popoverEpoch
  resource terminalDrawer = terminalDrawer(data.revision, viewport.height, wallTime.epochAtZero + elapsed) as shape TerminalDrawerView // terminal-drawer-view.ts
  state titleDialog = false
  state confirmTitle = ""
  state confirmBody = ""
  state confirmDestructive = false
  state confirmOp = ""
  state confirmTarget = ""
  state confirmReturn = "" // the element a terminal close confirm opened from gives the focus back on Cancel (Base UI's finalFocus)
  state confirmValue = ""
  state terminalCloseHandled = 0
  task shellTicks mount
    every(500, shellTick)
  action shellTick
    if shell.toastCount > 0 or shell.ticking or commandPending
      shellClock = performanceNow()
  task sidebarDialogFocus when data.sidebar.dialog != "" and not paletteOpen key=data.sidebar.dialog // and again as the palette over it closes (its finalFocus); a dialog the sidebar opens takes the focus at its first stop, however it opened (Base UI's initialFocus)
    after(1, focusSidebarDialog)
  action focusSidebarDialog
    focus(data.sidebar.dialog == "snooze" ? "snooze-mode-date" : `sidebar-${data.sidebar.dialog}-cancel`)
    titleDialog = data.sidebar.dialogReturn == "thread-title"
  task snoozeCalendarFocus when data.sidebar.calendar.focusSeq > 0 key=data.sidebar.calendar.focusSeq // a key moved the date popover's focus (snooze-calendar.ts)
    after(1, focusSnoozeDay)
  action focusSnoozeDay
    focus(`snooze-day-${data.sidebar.calendar.focus}`)
  task titleDialogClosed when titleDialog and data.sidebar.dialog == "" // however it closes (Snooze too), the title menu's dialog gives the focus back to the title (Base UI's finalFocus)
    after(1, returnTitleFocus)
  action returnTitleFocus
    titleDialog = false
    focus("thread-title")
  state annotationSendHandled = 0
  task annotationSend when shell.panel.annotationSend > annotationSendHandled key=shell.panel.annotationSend
    after(1, annotationSendNow)
  action annotationSendNow
    annotationSendHandled = shell.panel.annotationSend
    if commandPending or not data.canSend or data.requestMode == "question"
      chatLocal("surface-browser-annotation-held", "", "")
    else
      send("")
  state automationRecordingHandled = 0
  task automationRecording when shell.panel.automationRecording.serial > automationRecordingHandled key=shell.panel.automationRecording.serial
    after(1, automationRecordingNow)
  action automationRecordingNow
    automationRecordingHandled = shell.panel.automationRecording.serial
    if shell.panel.automationRecording.slot == 1
      send automationRecordingServed1 = command("shelllocal:surface-browser-automation-recording", "1", "", 0)
    else if shell.panel.automationRecording.slot == 2
      send automationRecordingServed2 = command("shelllocal:surface-browser-automation-recording", "2", "", 0)
    else if shell.panel.automationRecording.slot == 3
      send automationRecordingServed3 = command("shelllocal:surface-browser-automation-recording", "3", "", 0)
    else
      send automationRecordingServed0 = command("shelllocal:surface-browser-automation-recording", "0", "", 0)
  task terminalCloseAsk when shell.panel.terminalClose.serial > terminalCloseHandled and confirmOp == "" key=shell.panel.terminalClose.serial // Gated tasks (exact2 #192), not a 500 ms poll: a terminal close asks, and a thread the module opened is selected, at once.
    after(1, terminalCloseConfirm)
  action terminalCloseConfirm
    terminalCloseHandled = shell.panel.terminalClose.serial
    confirmTitle = shell.panel.terminalClose.title
    confirmBody = shell.panel.terminalClose.body
    confirmDestructive = true
    confirmOp = shell.panel.terminalClose.op
    confirmTarget = shell.panel.terminalClose.target
    confirmReturn = ""
    confirmValue = ""
    focus("app-confirm-cancel") // the confirm takes the focus from the terminal (Base UI's initialFocus); Cancel gives it back
  task shellOpen when shell.openRequest != "" and shell.openRequest != shellOpenHandled and shell.openThreadId != "" and not commandPending key=shell.openRequest
    after(1, shellOpenThread)
  action shellOpenThread // a clicked notification's thread, or a `t3 app` request's draft (desktop-activation.ts), which leaves Settings and the utility pages as the reference's route change does
    shellOpenHandled = shell.openRequest
    draftOwner = "__unset__"
    commandPending = true
    send changed = command(shell.openThreadId.startsWith("activation:") ? "activation:open" : "select-thread", shell.openThreadId, "", 0)
    jumpRequest = jumpRequest + 1
    settingsOpen = settingsOpen and not shell.openThreadId.startsWith("activation:")
    utilityPage = shell.openThreadId.startsWith("activation:") ? "" : utilityPage
  action toastHovering(over: bool)
    toastHover = over
  action toastAct(id: number, op: string, target: string, value: string)
    toastDismissed = op == "copy" or op.startsWith("shelllocal:surface-browser-artifact-") ? toastDismissed : `${toastDismissed} ${op == "dismiss" ? "x" : "a"}${id}` // a screenshot's Copy and Reveal keep their toast
    if op == "copy"
      send localChanged = command("shelllocal:copy-error", `${id}`, value, 0)
    if op == "ui:settings" and not settingsOpen
      openSettings() // retainSettingsScope: from outside Settings the scope starts over; inside, the category link keeps it
    if op == "ui:settings"
      settingsRoute = target
      providerLinkTarget = ""
      settingsMenu = ""
      settingsQuery = ""
      settingsFocusTarget = value
      modalError = ""
    if op.startsWith("upkeep:")
      send providerUpdateRun = providerChange(op, target, "", value, "", "") // a toast's update: the launch prompt's own environments, never the page's
    if op != "copy" and op != "dismiss" and op != "ui:settings" and not op.startsWith("upkeep:") and not commandPending
      commandPending = true
      send changed = command(op, target, value, 0)
      if op == "select-thread" or op == "new-thread"
        settingsOpen = false
        settingsThemeDialog = ""
        utilityPage = ""
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action panelUi(what: string, id: string) // tabs and surfaces live in the client (panel-surfaces.ts, shell.panel)
    let closingTerminal = what == "tab-close" and shell.panel.tabs.filter((tab) => tab.id == id and tab.closeTitle != "").length > 0
    rightPanelAt = closingTerminal ? rightPanelAt : (what == "toggle" or what == "close" or what == "tab-close" ? ((what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open) or (what == "tab-close" and shell.panel.count > 1)) : (rightPanel or what == "choose")) ? shell.panel.key : ""
    if what == "toggle" or what == "close" or what == "tab-close"
      send localChanged = command(what == "tab-close" ? "shelllocal:surface-close" : (what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open ? "shelllocal:surface-show" : "shelllocal:surface-hide"), id, "", 0)
      if what == "toggle" and not data.diffOpen and not rightPanel and not shell.panel.open
        focus("surface-chooser")
    if what == "terminal" // the layout controls' toggle (toggleTerminalVisibility); closing returns to the composer
      send terminalChanged = command("terminallocal:toggle", "", "", 0)
    if (what == "choose" or (what == "key" and (id == "b" or id == "B" or id == "d" or id == "D" or id == "f" or id == "F" or id == "m" or id == "M" or id == "l" or id == "L" or id == "p" or id == "P" or id == "t" or id == "T"))) and (data.threadId != "" or id == "browser" or id == "b" or id == "B" or id == "files" or id == "f" or id == "F" or (shell.terminalAvailable and (id == "terminal" or id == "t" or id == "T")) or (data.projectId != "" and (id == "device" or id == "m" or id == "M"))) and not commandPending
      commandPending = true
      send changed = command((id == "diff" or id == "d" or id == "D") ? "diff" : "shelllocal:surface-open", "", id, 0)
  action detailsAct(op: string, target: string, value: string) // the window's half: the editors list, the title menu
    if op == "shell:stop-subagent" and not commandPending
      lineageStopping = target
    detailsOpen = op == "toggle" ? (not detailsShown and detailsPopover) : (detailsOpen and op != "ui:project-settings" and op != "ui:scheduled-tasks" and op != "select-thread" and op != "ui:changes" and op != "dismiss") // inline: toggle remembers the thread's docked card
    detailsEpoch = op == "toggle" ? canvas.popoverEpoch : detailsEpoch
    if op == "ui:project-settings"
      openSettings() // a project link replaces the whole scope (retainSettingsScope)
      settingsProjectId = target == "" ? data.projectId : target
      settingsRoute = "projects"
    if op == "ui:add-script" // ProjectScriptsControl's Add project script: the Add Action dialog in place, for this project
      restEditor = "card-action"
      restSubject = target == "" ? data.projectId : target
      modalError = ""
    if op == "ui:scheduled-tasks" // ThreadAutomationsPanel: Manage scheduled tasks, or Edit as the page's taskId deep link (scheduled-view.ts)
      settingsEnvironmentId = settings.environmentId
      settingsMachine = ""
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = ""
      settingsRoute = "scheduled-tasks"
      settingsOpen = true
      restEditor = target == "" ? "" : "task"
      restSubject = target == "" ? "" : `link|${value}|${target}`
      modalError = ""
      taskModelPick = ""
    if (op != "toggle" or not detailsPopover) and op != "dismiss" and op != "ui:project-settings" and op != "ui:add-script" and op != "ui:scheduled-tasks" and not commandPending
      commandPending = true
      send changed = command(op == "toggle" ? "shelllocal:details-inline" : op == "ui:changes" ? "diff" : op == "ui:editor" ? "shell:select-editor" : op, target, value, 0)
      if op == "select-thread" or op == "shell:merge-back"
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action titleSend(what: string, text: string) // the title's rename commit or New thread (T3Window titleUi)
    if not commandPending
      commandPending = true
      send changed = command(what == "commit" ? "shell:rename" : "new-thread", what == "commit" ? data.threadId : data.projectId, text, 0)
      if what == "new-thread"
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
        focus("composer")
  action titleMenuPick(op: string, target: string, value: string, askTitle: string, askBody: string, destructive: bool) // the window's half: the menu, Rename
    if op == "ui:project-settings"
      openSettings() // a project link replaces the whole scope (retainSettingsScope)
      settingsProjectId = target
      settingsRoute = "projects"
    if op == "ui:confirm" or op.startsWith("ui:confirm:") // `ui:confirm:<id>`: Cancel gives the focus back to element <id>
      confirmReturn = op == "ui:confirm" ? "" : op.slice(11)
      confirmTitle = askTitle
      confirmBody = askBody
      confirmDestructive = destructive
      confirmOp = value
      confirmTarget = target
      confirmValue = value == "remove-snapshot" ? op.slice(11) : "" // a focused Remove's next element, focused once the removal lands (`focus:`)
    if op.startsWith("shelllocal:")
      send localChanged = command(op, target, value, 0)
    if (op == "ui:new-thread" or not op.startsWith("ui:")) and not op.startsWith("shelllocal:") and not commandPending
      commandPending = true
      send changed = command(op == "ui:new-thread" ? "new-thread" : op, target, value, 0)
    else if op == "ui:custom-snooze" // Snooze › Custom… opens the sidebar's Custom snooze for this thread (useThreadActionMenu's requestCustomSnooze)
      sidebarRun("snooze:custom", target, "title")
  // A removal asked from a focused Remove gives the focus away first, to that Remove on Cancel or to where the
  // removal leaves it on Confirm, and the dialog goes after the 200 ms its popup takes to leave (Base UI's finalFocus
  // runs as the dialog closes; dialog-styles.ts' duration-200 exit keeps it mounted meanwhile). VoiceOver, after a
  // VO-Space destroyed the button its cursor was on with the focus still there, took the cursor and the focus to the
  // window's first element instead of following the focus given back after the dialog had gone.
  state confirmHanding = ""
  task confirmHand when confirmHanding != "" key=confirmHanding
    after(200, confirmHanded)
  action confirmHanded
    let accept = confirmHanding == "accept"
    confirmHanding = ""
    confirmClose(accept)
  action confirmUi(accept: bool)
    if confirmOp == "remove-snapshot" and confirmValue != ""
      if confirmHanding == ""
        confirmHanding = accept ? "accept" : "cancel"
        focus(accept ? confirmValue : `remove-snapshot-${confirmTarget}`)
    else
      confirmClose(accept)
  action confirmClose(accept: bool)
    confirmOp = ""
    if confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close" or confirmOp == "shelllocal:surface-close-confirmed"
      terminalCloseHandled = shell.panel.terminalClose.serial // a terminal close asked while it was open is dropped, as the reference refuses it
    if confirmOp.startsWith("shell:") // the title menu's confirms give the focus back to its trigger (Base UI's finalFocus)
      focus("thread-title")
    if accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close")
      send terminalChanged = command(confirmOp, confirmTarget, confirmValue, 0)
    else if accept and not commandPending
      commandPending = true
      send changed = command(confirmOp, confirmTarget, confirmValue, 0)
    else if not accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close") and confirmReturn != ""
      focus(confirmReturn)
    else if not accept and (confirmOp == "terminallocal:close" or confirmOp == "terminalpanellocal:close")
      send terminalChanged = command(confirmOp == "terminallocal:close" ? "terminallocal:focus" : "terminalpanellocal:focus", confirmTarget, "", 0)
    else if not accept and confirmOp == "shelllocal:surface-close-confirmed" and shell.panel.terminal.open
      send terminalChanged = command("terminalpanellocal:focus", `${shell.panel.terminal.threadKey}|${shell.panel.terminal.terminalId}`, "", 0)
  state citeWaitAsked = 0
  state citeWaitDone = 0
  state citeDismissals = 0
  task citeWait when citeWaitAsked > citeWaitDone key=citeWaitAsked
    after(500, citeWaitOver)
  action citeWaitOver
    citeWaitDone = citeWaitAsked
  action citeWaitAsk(seq: number)
    citeWaitAsked = seq
  task citeBlur when not page.hasFocus
    after(1, citeDismissed)
  task citeContext key=`${viewport.width}x${viewport.height}|${data.threadId}|${pageCover}|${settingsOpen}|${modal}`
    after(1, citeDismissed)
  action citeDismissed
    citeDismissals = citeDismissals + 1
  view
    T3Window(promptLinkPage=promptLinkPage, promptLinkNavigate=promptLinkNavigate, promptLinkAct=promptLinkAct, data=data, viewport=viewport, scheme=scheme, hoverTip=hoverTip, hoverShown=hoverShown, hoverTipAt=hoverTipAt, themeInspecting=themeInspecting, setThemeInspecting=setThemeInspecting, themeRevealRequest=themeRevealRequest, themeUsage=themeUsage, settingsCore=settingsCore, sshPrompt=sshPrompt, modal=modal, shell=shell, wallTime=wallTime, liveNow=liveNow, elapsed=elapsed, sidebarWidth=sidebarWidth, commandPending=commandPending, lineageStopping=lineageStopping, settings=settings, utilityPage=utilityPage, home=home, paletteShow=paletteShow, openThread=openThread, sidebarLocal=sidebarLocal, sidebarRun=sidebarRun, openSettings=openSettings, openPage=openPage, pageBack=pageBack, openProviderSettings=openProviderSettings, sidebarHoverId=sidebarHoverId, openProjects=openProjects, sidebarNewThread=sidebarNewThread, selectThread=selectThread, command=command, resizeSidebar=resizeSidebar, resetSidebarWidth=resetSidebarWidth, noticeExit=noticeExit, noticeDismiss=noticeDismiss, pageCover=pageCover, canvas=canvas, canvasGesture=canvasGesture, rightPanel=rightPanel, narrowDiff=narrowDiff, detailsOpen=detailsShown, details=details, jumpRequest=jumpRequest, composerOwner=composerOwner, markdown=markdown, earlier=earlier, attachmentUrls=attachmentUrls, conversationWidth=conversationWidth, editor=editor, chip=chip, chipCovered=chipCovered, composerKey=composerKey, composerDrop=composerDrop, editorOp=editorOp, openModels=openModels, composerText=composerText, modelsOpen=modelsOpen, optionsOpen=optionsOpen, write=write, send=send, composerFocus=composerFocus, composerBlur=composerBlur, openOptions=openOptions, removeSnapshot=removeSnapshot, menuPick=menuPick, branches=branches, terminalDrawer=terminalDrawer, confirmOp=confirmOp, diffWidth=diffWidth, resizeDiff=resizeDiff, finishDiffResize=finishDiffResize, prDetail=prDetail, prMarkdown=prMarkdown, filesMarkdown=filesMarkdown, prTab=prTab, prSetTab=prSetTab, prReload=prReload, prAct=prAct, prCopy=prCopy, usage=usage, usageShortcuts=usageShortcuts, usageMetricSet=usageMetricSet, usageWindowSet=usageWindowSet, usageBreakdownSet=usageBreakdownSet, usageRefreshNow=usageRefreshNow, prList=prList, prTyped=prTyped, prQuery=prQuery, prSelected=prSelected, prPanelOpen=prPanelOpen, prTogglePanel=prTogglePanel, prType=prType, prControl=prControl, prSelect=prSelect, prClose=prSelect(""), openConnectionsPage=openConnectionsPage, welcomeImport=welcomeImport, popoverSession=popoverSession, closeOptions=closeOptions, menuCommand=menuCommand, branchQuery=branchQuery, searchBranches=searchBranches, projectsOpen=projectsOpen, manageProject=manageProject, selectProject=selectProject, settingsOpen=settingsOpen, connecting=connecting, settingsThemeDialog=settingsThemeDialog, settingsNavigation=settingsNavigation, settingsRoute=settingsRoute, settingsQuery=settingsQuery, settingsMenu=settingsMenu, editSettingsQuery=editSettingsQuery, coreSearchKey=coreSearchKey, corePick=corePick, coreClearSearch=coreClearSearch, settingsScrollTop=settingsPageScrollTop, settingsPage=settingsPage, coreMenuClose=coreMenuClose, coreMenu=coreMenu, coreChange=coreChange, coreNavigate=coreNavigate, coreScope=coreScope, coreNoticeScope=coreNoticeScope, coreThemeDialog=coreThemeDialog, sourceControl=sourceControl, modalError=modalError, restLocal=restLocal, importWizardFocusMoved=importWizardFocusMoved, integrations=integrations, snapshotSettings=snapshotSettings, settingsCommand=settingsCommand, previewSnapshotSound=previewSnapshotSound, bindings=bindings, keybindingQuery=keybindingQuery, keybindingOpen=keybindingOpen, keybindingPrevious=keybindingPrevious, keybindingCommand=keybindingCommand, keybindingKey=keybindingKey, keybindingWhen=keybindingWhen, keybindingRecording=keybindingRecording, editKeybindingQuery=editKeybindingQuery, newKeybinding=newKeybinding, cancelKeybinding=cancelKeybinding, chooseKeybindingCommand=chooseKeybindingC