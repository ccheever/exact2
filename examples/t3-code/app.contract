use WorkspaceDiscovery, WorkspaceRefresh, TimelineReadsResult, Time from "./app-shapes.contract" // first: the plan orders shapes by first use
use Snapshot from "./shapes.contract"
use R10PairFields from "./r10-connect-shapes.contract" // lane r10-connect
use SshPromptView, SshPromptAnswer, SshPasswordPrompt from "./ssh-prompt.contract" // the SSH password dialog (ssh-auth.ts)
use TranscriptMarkdown from "./markdown.contract"
use TimelineAttachmentUrls from "./timeline-attachments.contract"
use PagesHome from "./pages-hero.contract"
use UsageView from "./pages-usage.contract"
use UsageKey from "./pages-usage.contract"
use PrListView from "./pages-prs.contract"
use PrDetailView from "./pages-pr-detail.contract"
use WelcomeView from "./pages-welcome.contract"
use Viewport from "./shapes.contract"
use PaletteView from "./palette.contract"
use PaletteResult from "./palette.contract"
use Change from "./shapes.contract"
use ProviderPage from "./providers.contract"
use ProviderWizard from "./providers-wizard.contract"
use ConnectionsPage from "./connections.contract"
use AcpRegistry from "./providers-wizard.contract"
use KeybindingPage from "./settings-keybindings.contract"
use ScheduledPage from "./settings-scheduled.contract"
use KeyDispatch from "./settings-shortcuts.contract"
use SourceControlPage from "./settings-source-control.contract"
use IntegrationsPage from "./settings-source-control.contract"
use StoragePage from "./settings-storage.contract"
use ArchivePage from "./settings-archive.contract"
use LicenseSettings from "./shapes.contract"
use DiagnosticsPage from "./settings-diagnostics.contract"
use SnapshotSettings from "./shapes.contract"
use CoreNav from "./settings-core.contract"
use AboutDelivery from "./settings-a-about.contract"
use SettingsCore from "./settings-core.contract"
use Settings from "./shapes.contract"
use ProjectsPage from "./settings-projects.contract"
use SbSshHosts from "./connections.contract"
use SbPicker from "./settings-b-icons.contract"
use PickerCatalog from "./composer-shapes.contract"
use ComposerEditorView from "./composer-editor.contract"
use ComposerBranches from "./composer-shapes.contract"
use ShellView from "./shell-shapes.contract"
use ShellDetails from "./shell-shapes.contract"
use Canvas from "./shapes.contract"
use Sidebar from "./sidebar.contract"
use LegacySidebar from "./legacy-sidebar.contract" // legacy-sidebar
use ChatColumn from "./app-main.contract"
use RightPanels from "./app-main.contract"
use PagesCover from "./app-main.contract"
use RightSheets from "./app-main.contract"
use ComposerMenus from "./composer-controls.contract"
use ProjectPicker from "./app-overlays.contract"
use SettingsWindow from "./app-settings.contract"
use WelcomeLayer from "./app-overlays.contract"
use ShortcutDispatch from "./settings-shortcuts.contract"
use ProjectDialogs from "./app-settings.contract"
use SidebarOverlays from "./sidebar-overlays.contract"
use SettingsModals from "./app-settings.contract"
use WindowOverlays from "./app-overlays.contract"
use ChatCanvasView from "./chat-canvas.contract" // floating-device-player

component T3Code
  state elapsed = 0
  resource wallTime = exactTime() as shape Time
  resource data = snapshot(wallTime.epochAtZero + elapsed) as shape Snapshot
  resource markdown = renderMarkdown(data.messages, data.markdownSkills) as shape TranscriptMarkdown
  resource attachmentUrls = timelineAttachments(data.threadId, wallTime.epochAtZero + elapsed, data.revision) as shape TimelineAttachmentUrls // Signed preview URLs for the thread's sent images (timeline-attachments.ts).
  resource home = pagesHome(data.revision) as shape PagesHome // Lane pages: the empty main view, the utility pages and the sidebar footer route.
  state utilityPage = ""
  derive pageCover = utilityPage != "" or home.landing == "no-environment" or home.landing == "no-projects" or home.landing == "start-error"
  action openPage(name: string)
    utilityPage = name
    sidebarHoverId = "" // r8-pointer D11: a press closes its tooltip (Base UI); the pressed footer button unmounts without a hover-out
  state usageMetric = ""
  state usageDays = 0
  state usageBreakdown = "model"
  state usageRefresh = 0
  state usageEnvOff = false
  resource usage = usagePage(utilityPage == "usage", usageMetric, usageDays, usageBreakdown, usageRefresh, viewport.width, data.sidebarOpen ? sidebarWidth : 0, wallTime.epochAtZero + elapsed, usageEnvOff, data.revision) as shape UsageView
  resource usageShortcuts = usageKeys(data.revision) as shape list<UsageKey>
  action usageMetricSet(value: string)
    usageMetric = value
    send localChanged = command("pageslocal:usage-metric", "", value, 0)
  action usageWindowSet(days: number)
    usageDays = days
    send localChanged = command("pageslocal:usage-window", "", `${days}`, 0)
  action usageBreakdownSet(value: string)
    usageBreakdown = value
  action usageRefreshNow
    usageRefresh = usageRefresh + 1
  action usageEnvironmentToggle
    usageEnvOff = not usageEnvOff
  // Pull Requests (pages-prs*.contract): the list controls persist; the search applies 250ms after typing stops.
  state prQuery = ""
  state prApplied = ""
  state prTyped = false
  state prTypedAt = 0
  state prSelected = ""
  state prPanelOpen = true
  state prRefresh = 0
  state prTab = "summary"
  resource prList = prList(utilityPage == "pull-requests", prRefresh, wallTime.epochAtZero + elapsed, prSelected, prApplied, prTyped, data.revision) as shape PrListView
  resource prDetail = prDetail(utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, prRefresh, wallTime.epochAtZero + elapsed, data.revision) as shape PrDetailView
  resource prMarkdown = renderPullRequestMarkdown(prDetail.bodies) as shape TranscriptMarkdown
  // RightPanelTabs: half the window by default, leaving the list at least 224pt.
  derive prPanelWidth = min(floor(viewport.width / 2), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 224)
  derive prListWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - (prSelected != "" and prPanelOpen ? prPanelWidth : 0)
  action prType(value: string)
    prQuery = value
    prTyped = true
    prTypedAt = now()
  action prSettle
    if utilityPage == "pull-requests" and prTyped and prApplied != prQuery and now() - prTypedAt >= 250
      prApplied = prQuery
      send localChanged = command("pageslocal:pr-query", "", prQuery, 0)
  task prSearchClock mount
    every(250, prSettle)
  action prControl(op: string, value: string)
    if op == "query"
      prQuery = value
      prApplied = value
      prTyped = true
    send localChanged = command(`pageslocal:pr-${op}`, "", value, 0)
  action prSelect(ref: string)
    prSelected = ref
    prPanelOpen = true
    prTab = "summary"
  action prClose
    prSelected = ""
  action prTogglePanel
    prPanelOpen = not prPanelOpen
  action prReload
    prRefresh = prRefresh + 1
  action prSetTab(value: string)
    prTab = value
  action prAct(op: string, value: string)
    if not commandPending
      commandPending = true
      send changed = command(`pageslocal:pr-act-${op}`, utilityPage == "pull-requests" ? prSelected : shell.panel.pr.selected, value, 0)
  action prCopy(label: string, text: string)
    send localChanged = command("pageslocal:copy", label, text, 0)
  // First run (pages-welcome*): with no saved environment, "Set up T3 Code" covers the app until it finishes.
  state welcomeStep = "connect"
  state welcomeLink = ""
  state welcomePairOpen = true
  state welcomeHelpOpen = false
  resource welcome = welcome(welcomeStep, wallTime.epochAtZero + elapsed, data.revision) as shape WelcomeView
  action welcomeGo(step: string)
    welcomeStep = step
  action welcomeSetup
    welcomeStep = "agents"
    send localChanged = command("pageslocal:welcome-setup", "", "", 0)
  action welcomeEditLink(value: string)
    welcomeLink = value
  action welcomePair
    if not commandPending and welcomeLink != ""
      draftOwner = "__unset__"
      commandPending = true
      pendingModal = "welcome-pair"
      modalError = ""
      send changed = command(data.connected ? "environment-add" : "connect", "", welcomeLink, 0)
  action welcomeTogglePair
    welcomePairOpen = not welcomePairOpen
  action welcomeToggleHelp
    welcomeHelpOpen = not welcomeHelpOpen
  action welcomeFinish
    if not commandPending
      commandPending = true
      send changed = command("pageslocal:welcome-finish", "", `${wallTime.epochAtZero + now()}`, 0)
  action welcomeImport(op: string, id: string, value: string) // also the Usage page's pages:usage-* ops
    if op != "import" and op != "usage-prices-save"
      send localChanged = command(startsWith(op, "usage-") ? `pageslocal:${op}` : `pageslocal:welcome-${op}`, id, value, 0)
    else
      if not commandPending
        commandPending = true
        send changed = command(op == "import" ? "pageslocal:welcome-import" : "pageslocal:usage-prices-save", "", `${wallTime.epochAtZero + now()}`, 0)
  action openConnectionsPage
    settingsEnvironmentId = settings.environmentId
    settingsOpen = true
    settingsRoute = "connections"
    settingsMenu = ""
    modalError = ""
  action tick
    elapsed = now()
  task clock mount
    every(60000, tick)
  mutation timelineDisclosureChanged as shape Change refreshes data then dispatchTimelineReads
  mutation timelineReadsRefreshed as shape TimelineReadsResult refreshes data
  mutation timelineReadsRefreshedNext as shape TimelineReadsResult refreshes data
  action dispatchTimelineReads
    if not pending(timelineReadsRefreshed)
      send timelineReadsRefreshed = refreshTimelineReads(wallTime.epochAtZero + now())
    if not pending(timelineReadsRefreshedNext)
      send timelineReadsRefreshedNext = refreshTimelineReads(wallTime.epochAtZero + now())
  state liveNow = 0 // The timeline's "Working for 12s" ticks each second while a run is live.
  resource workspaceDiscovery = composerWorkspace(data.revision) as shape WorkspaceDiscovery
  mutation workspaceRefreshed as shape WorkspaceRefresh refreshes workspaceDiscovery, data then workspaceRefreshFinished
  state workspaceRetryKey = ""
  state workspaceRetryAt = 0
  action workspaceRefreshFinished
    match workspaceRefreshed
      case some(result)
        workspaceRetryKey = result.key
        workspaceRetryAt = result.retry ? now() + 10000 : 0
      case none
        workspaceRetryAt = now() + 10000
  action liveTick
    if data.timelineReadsNeeded
      if not pending(timelineReadsRefreshed)
        send timelineReadsRefreshed = refreshTimelineReads(wallTime.epochAtZero + now())
      if not pending(timelineReadsRefreshedNext)
        send timelineReadsRefreshedNext = refreshTimelineReads(wallTime.epochAtZero + now())
    if workspaceDiscovery.needed and not pending(workspaceRefreshed) and (workspaceRetryKey != workspaceDiscovery.key or now() >= workspaceRetryAt)
      send workspaceRefreshed = refreshComposerWorkspace(workspaceDiscovery.key)
    if data.running or data.sidebar.ticking or data.sidebar.undoUntil > wallTime.epochAtZero + liveNow
      liveNow = now()
  task liveClock mount
    every(1000, liveTick)
  resource viewport = exactViewport() as shape Viewport
  // Command palette (⌘K), file picker (⌘P), content search (⇧⌘F), Add project: palette.contract draws, palette*.ts serves.
  state paletteOpen = false
  state paletteMode = "command"
  state palettePage = ""
  state paletteQuery = ""
  state paletteCursor = -1
  state paletteScroll = 0
  state paletteCase = false
  state paletteWord = false
  state paletteRegex = false
  state paletteBusy = false
  resource palette = paletteView(paletteOpen, paletteMode, palettePage, paletteQuery, `${paletteCase ? "case " : ""}${paletteWord ? "word " : ""}${paletteRegex ? "regex" : ""}`, paletteCursor >= 0, wallTime.epochAtZero + elapsed, viewport.prefersColorScheme, data.revision) as shape PaletteView
  mutation paletteChanged as shape PaletteResult refreshes data then paletteDone
  // Cursor -1 shows the first row highlighted (a fresh open); -2 hides it after typing or a submenu, Enter still runs it.
  derive paletteHighlight = palette.count == 0 ? -1 : (paletteCursor >= 0 ? min(paletteCursor, palette.count - 1) : (palette.autoHighlight and paletteCursor == -1 ? 0 : -1))
  derive paletteListHeight = min(330, min(448, viewport.height * 0.7))
  // ⌘K, ⌘P and ⇧⌘F toggle their mode; a page (Add project, New thread in..., Change theme) opens on it.
  action paletteShow(mode: string, page: string)
    let show = page != "" or not (paletteOpen and paletteMode == mode)
    paletteOpen = show
    paletteMode = mode
    palettePage = page
    paletteQuery = ""
    paletteCursor = mode == "files" or page != "" ? -2 : -1
    paletteScroll = 0
    modelsOpen = false
    optionsOpen = ""
    projectsOpen = false
    modalError = ""
    if show
      focus("palette-input")
  action paletteClose
    if paletteMode != "command"
      paletteMode = "command"
      palettePage = ""
      paletteQuery = ""
      paletteCursor = -1
      paletteScroll = 0
      focus("palette-input")
    else
      paletteOpen = false
      focus("composer")
  action paletteEdit(value: string)
    paletteQuery = value
    paletteCursor = paletteMode == "content" ? -1 : -2
    paletteScroll = 0
    if value == "" and palette.popOnEmpty
      palettePage = palette.parent
  action paletteKey(name: string)
    if name == "ArrowDown" and palette.count > 0
      let next = (paletteHighlight < 0 or paletteHighlight + 1 >= palette.count) ? 0 : paletteHighlight + 1
      paletteCursor = next
      match first(filter(palette.rows, (r) => r.index == next))
        case some(r)
          paletteScroll = next == 0 ? 0 : max(paletteScroll, r.top + r.height + 24 - paletteListHeight)
        case none
    if name == "ArrowUp" and palette.count > 0
      let previous = paletteHighlight <= 0 ? palette.count - 1 : paletteHighlight - 1
      paletteCursor = previous
      match first(filter(palette.rows, (r) => r.index == previous))
        case some(r)
          paletteScroll = paletteHighlight <= 0 ? max(0, r.top + r.height + 24 - paletteListHeight) : min(paletteScroll, max(0, r.top - 24))
        case none
    // Backspace on an empty query and the Back button pop one page.
    if (name == "Back" or (name == "Backspace" and paletteQuery == "")) and palette.back
      palettePage = palette.parent
      paletteQuery = ""
      paletteCursor = paletteCursor >= 0 ? -1 : -2
      paletteScroll = 0
      focus("palette-input")
  action paletteHover(index: number, over: bool)
    if over and index >= 0
      paletteCursor = index
  action paletteFlag(name: string)
    paletteCursor = -1
    paletteScroll = 0
    paletteCase = name == "case" ? not paletteCase : paletteCase
    paletteWord = name == "word" ? not paletteWord : paletteWord
    paletteRegex = name == "regex" ? not paletteRegex : paletteRegex
  action paletteRun(op: string, arg: string, arg2: string)
    if op == "page" or op == "browse" or op == "browse-to" or op == "mode"
      palettePage = op == "browse-to" ? palettePage : (op == "mode" ? "" : arg)
      paletteMode = op == "mode" ? arg : paletteMode
      paletteQuery = op == "browse" ? arg2 : (op == "browse-to" ? arg : "")
      paletteCursor = op == "mode" and arg == "content" ? -1 : -2
      paletteScroll = 0
      focus("palette-input") // lane r8-keys: a clicked row takes the focus on its mouse down (NSWindow), so the field takes it back
    if op == "device"
      paletteOpen = false
      send localChanged = command("device-setting", arg, arg2, 0)
    if op == "copy-thread"
      paletteOpen = false
      send localChanged = command("restlocal:copy-thread", ":", "", 0)
    if op == "settings" or op == "theme-editor" or op == "project-settings"
      // Toggle theme editor: the Appearance editor seeded from the active theme (toggleThemeEditorForTheme).
      let editing = settingsOpen and (settingsThemeDialog == "create" or settingsThemeDialog == "edit" or settingsThemeDialog == "duplicate")
      paletteOpen = false
      settingsEnvironmentId = settings.environmentId
      settingsOpen = true
      settingsRoute = op == "theme-editor" ? "appearance" : (op == "project-settings" ? "projects" : arg)
      settingsFocusTarget = op == "settings" ? arg2 : ""
      settingsThemeDialog = op == "theme-editor" and not editing ? "create" : ""
      settingsThemeSubject = ""
      settingsQuery = ""
      settingsMenu = ""
      settingsMachine = ""
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = op == "project-settings" ? arg : ""
      modalError = ""
    if op == "usage" or op == "pull-requests" or op == "thread-pull-requests"
      // Show linked pull requests opens the right panel (rightPanelStore.open(thread, "pull-requests")).
      paletteOpen = false
      utilityPage = op == "thread-pull-requests" ? utilityPage : op
      rightPanel = op == "thread-pull-requests" or rightPanel
    if (op == "flow" or op == "open-project" or op == "finder" or op == "open-file" or op == "thread" or op == "new-thread" or op == "thread-pull-requests") and not paletteBusy
      paletteBusy = true
      send paletteChanged = paletteCommand(op == "flow" ? arg : (op == "finder" ? "pick-folder" : op), op == "flow" ? arg2 : arg, op == "open-file" ? arg2 : palettePage)
  action paletteDone
    paletteBusy = false
    match paletteChanged
      case some(result)
        if result.close
          paletteOpen = false
        if result.page != "-"
          palettePage = result.page
          paletteQuery = result.query
          paletteCursor = -2
          paletteScroll = 0
        if (result.thread != "" or result.project != "") and not commandPending
          draftOwner = "__unset__"
          commandPending = true
          send changed = command(result.thread != "" ? "select-thread" : "new-thread", result.thread != "" ? result.thread : result.project, "", 0)
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
      case none
  mutation changed as shape Change refreshes data then commandCompleted
  mutation localChanged as shape Change refreshes data
  state commandPending = false
  state pendingModal = ""
  state modalError = ""
  state connecting = false
  state projectsOpen = false
  // Settings → Providers (providers.contract): selection, Add provider wizard inputs.
  state providerSelected = ""
  state providerDialog = ""
  state providerSerial = 0
  state providerCreated = ""
  state providerTarget = ""
  state wizardDriver = "codex"
  state wizardLabel = ""
  state wizardLabelSet = false
  state wizardId = ""
  state wizardIdSet = false
  state wizardStep = 0
  state wizardAttempted = false
  state wizardManual = false
  state acpQuery = ""
  // ProviderLastChecked re-renders every second while Providers is open (useRelativeTimeTick).
  state providerNow = 0
  action providerTick
    if settingsOpen and settingsRoute == "providers"
      providerNow = now()
  task providerClock mount
    every(1000, providerTick)
  resource providerPage = providerPage(providerSelected, settingsOpen and settingsRoute == "providers", data.revision, wallTime.epochAtZero + max(elapsed, providerNow)) as shape ProviderPage
  resource providerWizard = providerWizard(providerDialog != "", providerSerial, wizardManual ? "acpRegistry" : wizardDriver, wizardLabelSet, wizardLabel, wizardIdSet, wizardId, data.revision) as shape ProviderWizard
  state connectionRemove = ""
  state connectionMenu = ""
  resource connectionsPage = connectionsPage(settingsOpen and settingsRoute == "connections", data.revision, data.status, data.connected, data.connecting) as shape ConnectionsPage
  resource acpAgents = acpRegistry(acpQuery, providerDialog == "add" and wizardStep == 0, data.revision) as shape AcpRegistry
  state settingsOpen = false
  state settingsRoute = "general"
  state settingsRefresh = 0
  state keybindingQuery = ""
  state keybindingOpen = false
  state keybindingPrevious = ""
  state keybindingCommand = ""
  state keybindingKey = ""
  state keybindingWhen = ""
  state keybindingSearch = false
  state keybindingRecording = false
  resource bindings = keybindingSettings(settingsEnvironmentId, keybindingQuery, settingsOpen and settingsRoute == "keybindings", keybindingPrevious, keybindingKey, keybindingWhen, keybindingCommand, settingsRefresh, data.revision) as shape KeybindingPage
  resource scheduled = scheduledSettings(settingsEnvironmentId, settingsProjectId, restEditor, restSubject, settingsOpen and settingsRoute == "scheduled-tasks", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision) as shape ScheduledPage
  state licenseQuery = ""
  state licenseExpanded = ""
  state licenseSearchOpen = false
  state licenseRetry = 0
  state diagnosticPeriod = "15m"
  resource shortcuts = keyboardDispatch(data.threads, browseProvider, modelQuery, composerFocused, data.running, modelsOpen, data.threadId == "", modal, settingsOpen, data.diffOpen or shell.panel.open, data.revision, paletteOpen, paletteMode, utilityPage == "pull-requests" and prSelected != "" and prPanelOpen ? prDetail.numberLabel : "", data.sidebar.undoUntil > wallTime.epochAtZero + max(liveNow, elapsed), settingsRoute) as shape list<KeyDispatch>
  resource sourceControl = sourceControlPage(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "source-control", settingsRefresh, data.revision) as shape SourceControlPage
  resource integrations = integrationsPage(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "integrations", settingsRefresh, data.revision) as shape IntegrationsPage
  resource storageSettings = storageSettings(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "storage", settingsRefresh, data.revision) as shape StoragePage
  resource archives = archivedSettings(settingsEnvironmentId, settingsProjectId, settingsOpen and settingsRoute == "archived", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision) as shape ArchivePage
  resource licenses = licenseSettings(licenseQuery, licenseExpanded, licenseRetry, settingsOpen and settingsRoute == "open-source-licenses", data.revision) as shape LicenseSettings
  resource diagnostics = diagnosticsSettings(settingsEnvironmentId, diagnosticPeriod, settingsOpen and settingsRoute == "diagnostics", wallTime.epochAtZero + elapsed, settingsRefresh, data.revision) as shape DiagnosticsPage
  state settingsFocusTarget = ""
  state snapshotSetupOpen = false
  state snapshotSetupWasEnabled = false
  resource snapshotSettings = snapshotSettings(settingsOpen and settingsRoute == "snap-shot", settingsRefresh, data.revision) as shape SnapshotSettings
  state settingsQuery = ""
  resource settingsNavigation = settingsNavigation(settingsQuery, settingsCore.kind, settingsResultIndex, data.revision) as shape CoreNav
  state settingsProjectId = ""
  state settingsEnvironmentId = ""
  state settingsMachine = ""
  state settingsProjectKey = ""
  state settingsCheckout = ""
  state settingsMenu = ""
  state settingsResultIndex = 0
  state settingsEscapeHeld = false
  state settingsLegacyOpen = false
  state settingsScrollTop = 0 // settings search jump: the reveal offset (settings-a)
  state settingsRestoreOpen = false
  state settingsThemeDialog = ""
  state settingsThemeSubject = ""
  resource delivery = exactDelivery() as shape AboutDelivery // the binary's own update facts (settings-a-about)
  resource settingsCore = settingsCore(settingsMachine, settingsProjectKey, settingsCheckout, settingsProjectId, settingsRoute, settingsFocusTarget, settingsOpen, settingsRefresh, data.revision, settingsThemeDialog, settingsThemeSubject, delivery.stream, delivery.staged) as shape SettingsCore
  resource settings = settings(settingsEnvironmentId, settingsProjectId, data.revision, composerFocused, modal, data.running, data.threadId != "", modelsOpen) as shape Settings
  resource projectsSettings = projectsView(settingsProjectKey, settingsCheckout, settingsProjectId, settingsOpen and settingsRoute == "projects", settingsRefresh, data.revision) as shape ProjectsPage
  // Lane settings-b: the project icon pickers' search, letters and pasted emoji (settings-b-icons.ts).
  state sbQuery = ""
  state sbLetters = ""
  state sbLettersEdited = false
  state sbEmoji = ""
  state sbSshHost = ""
  resource sbSshHosts = settingsBSshHosts(connecting, sbSshHost, data.revision) as shape SbSshHosts
  // The SSH password dialog's queue (ssh-auth.ts, T3SshAuth.swift); its countdown ticks while it shows.
  state sshNow = 0
  state sshResponding = false
  resource sshPrompt = sshPrompt(wallTime.epochAtZero + sshNow) as shape SshPromptView
  mutation sshAnswered as shape SshPromptAnswer refreshes sshPrompt then sshAnswerDone
  task sshClock mount
    every(1000, sshTick)
  action sshTick
    if sshPrompt.open
      sshNow = now()
  action sshAnswer(kind: string)
    if not sshResponding and sshPrompt.requestId != ""
      sshResponding = kind == "submit"
      send sshAnswered = sshPromptAnswer(sshPrompt.requestId, kind)
  action sshAnswerDone
    sshResponding = false
  resource pairFields = pairingFields(connecting ? origin : "") as shape R10PairFields // lane r10-connect: a pasted pairing URL fills Host and Pairing code
  action sbSet(which: string, value: string)
    if which == "query"
      sbQuery = value
    if which == "letters"
      sbLetters = value
      sbLettersEdited = true
    if which == "emoji"
      sbEmoji = value
    if which == "ssh-host"
      sbSshHost = value
  resource sbPicker = settingsBPicker(restEditor, sbQuery, (sbLettersEdited ? sbLetters : projectsSettings.iconLetters), sbEmoji, projectsSettings.iconCwd, projectsSettings.name, data.revision) as shape SbPicker
  state modelsOpen = false
  state browseProvider = ""
  state modelQuery = ""
  state dismissedProviderBanner = ""
  action dismissProviderBanner
    dismissedProviderBanner = data.providerBannerKey
  resource catalog = modelCatalog(browseProvider, modelQuery, data.revision) as shape PickerCatalog
  resource editor = composerEditor(data.revision, wallTime.epochAtZero + elapsed) as shape ComposerEditorView // composer-editor.ts
  state optionsOpen = ""
  // The draft's workspace / branch strip (composer-controls-branch.ts); refs load while its picker is open.
  state branchQuery = ""
  resource branches = composerBranches(optionsOpen == "branch", branchQuery, data.revision, shellClock) as shape ComposerBranches
  state popoverSession = 0
  state origin = ""
  state originEdited = false
  state credential = ""
  state draft = ""
  state draftOwner = "__unset__"
  state draggedWidth = 0
  state sidebarHoverId = ""
  state sidebarHoverLast = ""
  state sidebarHoverY = 0 // the hovered row's frame in the window (r5-shell: less the list's scroll)
  state sidebarHoverH = 0
  state sidebarScrollY = 0
  // Sidebar drag (sidebar-drop.ts): the lifted row, its pan and the list's boundaries when it lifted.
  state dragId = ""
  state dragSection = ""
  state dragDx = 0
  state dragDy = 0
  state dragX0 = 0
  state dragY0 = 0
  state dragW = 0
  state dragH = 0
  state dragTopY = 0
  state dragDividerY = 0
  state dragWorkingY = 0
  state dragSnoozedY = 0
  state dragSettledY = 0
  derive dragCX = dragX0 + dragW / 2 + dragDx
  derive dragCY = dragY0 + dragH / 2 + dragDy
  derive dragTarget = dragId == "" ? "" : (dragCX > sidebarWidth ? "context" : (dragSettledY > 0 and dragCY >= dragSettledY ? "settled" : (dragSnoozedY > 0 and dragCY >= dragSnoozedY ? "snoozed" : (dragWorkingY > 0 and dragCY >= dragWorkingY ? "working" : (dragCY < dragDividerY + 36 ? "pinned" : "active")))))
  derive dragVerb = (dragTarget == "" or dragTarget == dragSection or dragTarget == "working" or dragTarget == "snoozed" or dragTarget == "context") ? "" : (dragTarget == "pinned" ? "pin" : (dragTarget == "settled" ? "settle" : (dragSection == "pinned" ? "unpin" : (dragSection == "settled" ? "unsettle" : "wake"))))
  derive dragOffset = dragDy - (dragSection == "pinned" ? 24 : (dragSection == "active" ? 48 : 0))
  state jumpRequest = 0
  state composerFocused = false
  action composerFocus
    composerFocused = true
  action composerBlur
    composerFocused = false
  action scrollToEnd
    jumpRequest = jumpRequest + 1
    foldHold = false
  derive canRest = data.composerCollapseOnScroll and data.threadId != "" and not composerFocused and not includes(composerText, "\n") and length(data.approvals) == 0 and length(data.questions) == 0 and not data.settled
  derive resting = data.composerResting and canRest
  derive modal = connecting or projectsOpen or paletteOpen or settingsOpen or providerDialog != "" or restEditor != "" or welcome.show
  resource sidebarLaunch = sidebarLaunchWidth(viewport.width, data.revision) as shape number // threadSidebarWidth.ts (r4-polish-sidebar-width.ts): no stored width sizes the sidebar once at load
  derive sidebarWidth = draggedWidth == 0 and sidebarLaunch > 0 ? sidebarLaunch : min(max(max(208, data.sidebarMinWidth), draggedWidth > 0 ? draggedWidth : data.sidebarWidth), max(max(208, data.sidebarMinWidth), viewport.width - 640)) // a stored width: at least the minimum (13rem, or the brand at the Interface font size: r12-sidebar-width.ts), leaving 40rem of main content
  derive narrowDiff = viewport.width <= 980
  // usePreviewPanelInlineSize: 540pt by default, dragged between 360pt and min(70% of the window, room leaving the chat 360pt).
  state diffUserWidth = 540
  derive diffWidth = narrowDiff ? (viewport.width <= 760 ? min(viewport.width * 0.88, 384) : min(448, max(320, viewport.width * 0.42))) : max(360, min(diffUserWidth, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action resizeDiff(dx: number, dy: number)
    diffUserWidth = max(360, min(diffWidth - dx, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action finishDiffResize(vx: number, vy: number)
    diffUserWidth = diffWidth
  derive conversationWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - ((data.diffOpen or rightPanel or shell.panel.open) and not narrowDiff ? diffWidth : 0)
  derive composerLeft = (data.sidebarOpen ? sidebarWidth : 0) + (canvas.ready ? canvas.left : (conversationWidth - min(data.look.chatMax, conversationWidth - 40)) / 2) // the chat lane (chat-canvas-view.ts)
  derive composerOwner = `${data.serverUrl}:${data.projectId}:${data.threadId}`
  derive composerText = draftOwner == `${composerOwner}${data.requestKey}` ? draft : data.draft
  action closeOptions
    optionsOpen = ""
    focus("composer")
  action openOptions(name: string)
    focus(optionsOpen == name ? "composer" : name == "effort" ? "composer-menu" : name == "runtime" ? `composer-menu-item-${data.composer.runtimeSelected}` : name == "branch" ? "branch-search" : name == "workspace" ? "composer-menu" : "composer-menu-item-0")
    optionsOpen = optionsOpen == name ? "" : name
    branchQuery = ""
    modelsOpen = false
    popoverSession = popoverSession + 1
  // A composer menu row that runs a command closes its menu (closeOnClick).
  action menuCommand(op: string, id: string, value: string, n: number)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, n)
  action searchBranches(value: string)
    branchQuery = value
  action composerKey(op: string, id: string, value: string) // A composer control's key name (composer-controls-commands.ts).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, value, 0)
  action composerDrop(op: string, id: string, vx: number, vy: number) // A queued row's grip released (pan release).
    if not commandPending
      commandPending = true
      send changed = command(`cc:${op}`, id, "", 0)
  action menuPick(op: string, id: string, value: string)
    optionsOpen = ""
    focus("composer")
    if not commandPending
      commandPending = true
      send changed = command(op, id, value, 0)
  action commandCompleted
    match changed
      case some(result)
        if pendingModal != ""
          modalError = startsWith(result.message, "toasted:") ? "" : result.message
        if result.message == ""
          if pendingModal == "connect-first" or pendingModal == "connect"
            connecting = false
            origin = ""
            originEdited = false
          if pendingModal == "welcome-pair"
            welcomeLink = ""
            welcomePairOpen = false
          if pendingModal == "provider-add"
            providerDialog = ""
            providerSelected = providerCreated
          if pendingModal == "provider-close"
            providerDialog = ""
          if pendingModal == "provider-acp"
            wizardManual = false
            wizardDriver = "acpRegistry"
            wizardStep = 1
          if pendingModal == "rest"
            keybindingOpen = false
            keybindingPrevious = ""
            keybindingRecording = false
            if restEditor == "project-remove" and restSubject == ""
              settingsOpen = false
              settingsProjectKey = ""
              settingsProjectId = ""
              settingsCheckout = ""
            restEditor = ""
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "settings"
            settingsRefresh = settingsRefresh + 1
          if pendingModal == "theme-dialog"
            settingsThemeDialog = ""
        // The sidebar's thread menu and New thread ask the window for a place.
        if result.message == "sidebar:new-thread"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
        if result.message == "sidebar:palette-new-thread"
          paletteOpen = true
          paletteMode = "command"
          palettePage = "new-thread-in"
          paletteQuery = ""
          paletteCursor = -1
          paletteScroll = 0
          modelsOpen = false
          optionsOpen = ""
          focus("palette-input")
        if result.message == "sidebar:navigate" and data.sidebar.navigateKind == "project-settings"
          settingsEnvironmentId = settings.environmentId
          settingsProjectId = data.sidebar.navigateProject
          settingsProjectKey = ""
          settingsCheckout = ""
          settingsRoute = "projects"
          settingsOpen = true
          modalError = ""
      case none
    pendingModal = ""
    commandPending = false
  action command(op: string, id: string, value: string, n: number)
    if op == "chatlocal:item-detail"
      send timelineDisclosureChanged = command(op, id, value, n)
    else
      if op == "draft" or op == "search" or op == "sidebar" or op == "answer" or op == "choice" or op == "dismiss-error" or op == "close-diff" or op == "diff-view" or op == "favorite-model"
        send localChanged = command(op, id, value, n)
      else
        if not commandPending
          commandPending = true
          send changed = command(op, id, value, n)
  action editKeybindingQuery(value: string)
    keybindingQuery = value
  action newKeybinding
    keybindingPrevious = "new"
    keybindingCommand = ""
    keybindingKey = ""
    keybindingWhen = ""
    keybindingRecording = false
    keybindingOpen = true
    modalError = ""
  action editKeybinding(previous: string, commandName: string, shortcut: string, condition: string)
    if keybindingPrevious != previous
      keybindingPrevious = previous
      keybindingCommand = commandName
      keybindingKey = shortcut
      keybindingWhen = condition
      keybindingRecording = false
  action recordKeybinding(previous: string, commandName: string, shortcut: string, condition: string)
    if keybindingPrevious != previous
      keybindingPrevious = previous
      keybindingCommand = commandName
      keybindingKey = shortcut
      keybindingWhen = condition
    keybindingRecording = true
  action chooseKeybindingCommand(value: string)
    keybindingCommand = value
  action editKeybindingKey(value: string)
    keybindingKey = value
    keybindingRecording = false
  action editKeybindingWhen(value: string)
    keybindingWhen = value
  action captureKeybinding(original: string, value: string)
    keybindingKey = value == "escape" ? original : value
    keybindingRecording = false
  action cancelKeybinding
    keybindingOpen = false
    keybindingPrevious = ""
    keybindingRecording = false
    modalError = ""
  action searchKeybindings(open: bool)
    if open or keybindingQuery == ""
      keybindingSearch = open
  action keybindingSearchKey(name: string)
    if name == "Escape"
      keybindingQuery = ""
      keybindingSearch = false
  action settingsCommand(op: string, id: string, value: string)
    if not commandPending
      commandPending = true
      pendingModal = "settings"
      modalError = ""
      send changed = command(op, id, value, 0)
  action previewSnapshotSound(sound: string)
    if not commandPending
      commandPending = true
      pendingModal = ""
      send changed = command("snapshot-preview-sound", "", sound, 0)
  action removeSnapshot(imageId: string)
    send changed = command("remove-snapshot", imageId, "", 0)
  action toggleSnapshots
    if snapshotSettings.enabled and not commandPending
      commandPending = true
      pendingModal = "settings"
      modalError = ""
      send changed = command("setting-snapshot", "snapShotEnabled", "false", 0)
      snapshotSetupOpen = false
    else
      snapshotSetupOpen = true
      snapshotSetupWasEnabled = false
      modalError = ""
  action showSnapshotSetup(open: bool)
    snapshotSetupOpen = open
    snapshotSetupWasEnabled = snapshotSettings.enabled
    modalError = ""
  // The composer's "Open provider settings" (ChatComposer onOpenProviderSetup).
  action openProviderSettings(id: string)
    settingsEnvironmentId = settings.environmentId
    settingsOpen = true
    settingsRoute = "providers"
    settingsMenu = ""
    providerSelected = id
    modalError = ""
  action openSettings
    sidebarHoverId = "" // r8-pointer D11: the Settings button's tooltip closes on its press
    settingsEnvironmentId = settings.environmentId
    settingsOpen = true
    settingsRoute = "general"
    settingsMenu = ""
    settingsMachine = ""
    settingsProjectKey = ""
    settingsCheckout = ""
    settingsProjectId = ""
    modalError = ""
  action focusSettingsTarget
    if settingsOpen and settingsFocusTarget != ""
      if settingsRoute != "storage" or storageSettings.available
        if settingsRoute != "archived" or archives.available
          if settingsRoute != "diagnostics" or diagnostics.available
            if settingsRoute != "keybindings" or bindings.available
              if settingsRoute != "scheduled-tasks" or scheduled.available
                if (settingsRoute != "source-control" or sourceControl.available) and (settingsRoute != "integrations" or integrations.available)
                  if (settingsRoute != "general" and settingsRoute != "appearance") or (settingsCore.ready and settingsCore.route == settingsRoute and length(settingsCore.sections) > 0)
                    // scrollIntoView({ block: "center" }): the target's middle at the viewport's middle.
                    settingsScrollTop = max(0, frame(settingsFocusTarget).y - frame("settings-content-column").y + frame(settingsFocusTarget).height / 2 - frame("settings-content-scroll").height / 2) + (settingsScrollTop == floor(settingsScrollTop) ? 0.25 : 0)
                    focus(settingsFocusTarget)
                    settingsFocusTarget = ""
  task settingsSearchFocus mount
    every(1000, focusSettingsTarget)
  action editSettingsQuery(value: string)
    settingsFocusTarget = ""
    settingsQuery = value
    settingsResultIndex = 0
    settingsEscapeHeld = false
  action deviceSetting(id: string, value: string)
    send localChanged = command("device-setting", id, value, 0)
  action coreChange(row: string, part: string, value: string)
    settingsMenu = ""
    if row == "background-activity" and value == "advanced"
      settingsThemeDialog = "background-activity"
      modalError = ""
    else
      if not commandPending
        commandPending = true
        pendingModal = "settings"
        modalError = ""
        send changed = command("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, value, 0)
  action coreSlide(row: string, part: string, value: number)
    if not commandPending
      commandPending = true
      pendingModal = "settings"
      modalError = ""
      send changed = command("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, `${value}`, 0)
  action coreMenu(section: string, id: string)
    settingsMenu = (id == "" or settingsMenu == id) ? "" : id
  action coreMenuClose
    settingsMenu = ""
  action coreScope(project: bool, id: string, member: string)
    settingsMenu = ""
    modalError = ""
    if project
      settingsProjectKey = id
      settingsCheckout = ""
      settingsProjectId = member
    else
      settingsMachine = id
  action coreLegacy
    settingsLegacyOpen = not settingsLegacyOpen
  action coreNavigate(route: string)
    settingsEscapeHeld = false
    settingsRoute = route
    if route == "diagnostics" and settings.environmentId != ""
      settingsMachine = settings.environmentId
      settingsProjectKey = ""
      settingsCheckout = ""
      settingsProjectId = ""
    settingsMenu = ""
    settingsQuery = ""
    modalError = ""
  action corePick(route: string, target: string, scope: string, id: string)
    settingsRoute = route
    settingsFocusTarget = target
    settingsQuery = ""
    settingsMenu = ""
    modalError = ""
    if startsWith(id, "search-result-legacy-")
      settingsLegacyOpen = true
  action coreSearchKey(k: string)
    if k == "/"
      focus("settings-search")
    if k == "Escape"
      settingsEscapeHeld = settingsQuery != ""
      settingsQuery = ""
      settingsResultIndex = 0
    if k == "ArrowDown"
      settingsResultIndex = settingsResultIndex + 1
    if k == "ArrowUp"
      settingsResultIndex = settingsResultIndex + settingsNavigation.count - 1
    if k == "Enter" and settingsNavigation.firstRoute != ""
      settingsRoute = settingsNavigation.firstRoute
      settingsFocusTarget = settingsNavigation.firstTarget
      settingsQuery = ""
      settingsMenu = ""
      modalError = ""
      if startsWith(settingsNavigation.firstId, "legacy-")
        settingsLegacyOpen = true
  action coreClearSearch
    settingsQuery = ""
    focus("settings-search")
  action coreRestoreOpen
    settingsRestoreOpen = true
  action coreRestoreClose
    settingsRestoreOpen = false
  action coreRestoreConfirm
    settingsRestoreOpen = false
    if not commandPending
      commandPending = true
      pendingModal = "settings"
      modalError = ""
      send changed = command("settings-core", `restore-device-defaults:|${settingsCore.scopeKey}`, "", 0)
  action coreThemeDialog(kind: string, theme: string)
    settingsThemeDialog = kind
    settingsThemeSubject = theme
    modalError = ""
  action coreThemeChange(row: string, part: string, value: string)
    if not commandPending
      commandPending = true
      pendingModal = "theme-dialog"
      modalError = ""
      send changed = command("settings-core", `${row}:${part}|${settingsCore.scopeKey}`, value, 0)
  state restEditor = ""
  state restSubject = ""
  state restLabel = ""
  state restMenu = ""
  action restOpen(editor: string, subject: string, label: string)
    sbQuery = ""
    sbLettersEdited = false
    sbEmoji = ""
    restEditor = editor
    restSubject = subject
    restLabel = label
    restMenu = ""
    modalError = ""
  action restMenuOpen(id: string)
    restMenu = id
  action restClose
    restEditor = ""
    restMenu = ""
    modalError = ""
  action rest(op: string, value: string)
    restMenu = ""
    if not commandPending
      commandPending = true
      pendingModal = "rest"
      modalError = ""
      send changed = command(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, value, 0)
  action restLocal(op: string, value: string)
    send localChanged = command(`restlocal:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, value, 0)
  action restRaw(op: string, id: string, value: string)
    restMenu = ""
    if not commandPending
      commandPending = true
      pendingModal = "rest"
      modalError = ""
      send changed = command(op, id, value, 0)
  action restInput(op: string, value: string, input: string)
    if not commandPending
      commandPending = true
      pendingModal = "rest"
      modalError = ""
      send changed = command(`rest:${op}`, `${settingsEnvironmentId}:${settingsProjectId}`, `${value}${encodeURIComponent(input)}`, 0)
  action refreshSettings
    settingsRefresh = settingsRefresh + 1
  action openLicenseSearch
    licenseSearchOpen = true
  action closeLicenseSearch
    if licenseQuery == ""
      licenseSearchOpen = false
  action licenseSearchKey(name: string)
    if name == "Escape"
      licenseQuery = ""
      licenseSearchOpen = false
  action editLicenseQuery(value: string)
    licenseQuery = value
  action toggleLicense(id: string)
    licenseExpanded = licenseExpanded == id ? "" : id
  action retryLicenses
    licenseRetry = licenseRetry + 1
  action selectDiagnosticPeriod(value: string)
    diagnosticPeriod = value
  action copyDiagnostic(value: string)
    send localChanged = command("copy-diagnostic", "", value, 0)
  action providerUi(what: string, value: string)
    modalError = ""
    if what == "select"
      providerSelected = value
    if what == "open"
      providerDialog = value
      providerSerial = providerSerial + 1
      wizardDriver = "codex"
      wizardLabel = ""
      wizardLabelSet = false
      wizardId = ""
      wizardIdSet = false
      wizardStep = 0
      wizardAttempted = false
      wizardManual = false
      acpQuery = ""
    if what == "close"
      providerDialog = ""
    if what == "hub-remove"
      providerDialog = what
      providerTarget = value
    if what == "driver" or what == "manual"
      wizardDriver = what == "driver" ? value : wizardDriver
      wizardManual = what == "manual" and value == "true"
      wizardLabelSet = false
      wizardIdSet = false
      wizardAttempted = false
    if what == "label"
      wizardLabel = value
      wizardLabelSet = true
    if what == "id"
      wizardId = value
      wizardIdSet = true
    if what == "acp"
      acpQuery = value
    if what == "step"
      let target = value == "back" ? max(0, wizardStep - 1) : min(wizardManual ? 1 : 2, value == "next" ? wizardStep + 1 : (value == "2" ? 2 : (value == "1" ? 1 : 0)))
      if wizardStep <= 1 and target > 1 and providerWizard.idError != ""
        wizardAttempted = true
        wizardStep = 1
      else
        wizardStep = target
  action providerOp(op: string, id: string, field: string, value: string, apply: bool)
    if apply and not commandPending
      commandPending = true
      pendingModal = op == "acp-prepare" ? "provider-acp" : (op == "provider-hub-add" or op == "provider-hub-remove" or op == "provider-chatgpt" ? "provider-close" : "provider")
      modalError = ""
      send changed = providerChange(op, id, field, value)
  // Lane settings-b: the accent picker commits when a drag ends (pan release supplies its velocity).
  action providerAccent(id: string, hex: string, vx: number, vy: number)
    if not commandPending
      commandPending = true
      pendingModal = "provider"
      modalError = ""
      send changed = providerChange("provider-accent", id, "", hex)
  action providerAdd(driver: string, label: string, id: string, accent: string, f0: string, f1: string, f2: string, f3: string, f4: string)
    wizardAttempted = true
    if not commandPending
      commandPending = true
      pendingModal = "provider-add"
      providerCreated = id == "" ? providerWizard.instanceId : id
      modalError = ""
      send changed = providerAdd(driver, label, id, accent, f0, f1, f2, f3, f4)
  action connectionOp(op: string, id: string, value: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      pendingModal = (op == "environment-add" or op == "environment-ssh-add" or op == "environment-ssh-pick") ? (data.connected ? "connect" : "connect-first") : "connection"
      modalError = ""
      connectionRemove = ""
      send changed = command(op, id, value, 0)
  action connectionAskRemove(target: string)
    connectionRemove = target
    connectionMenu = ""
  action connectionToggleMenu(target: string)
    connectionMenu = connectionMenu == target ? "" : target
  action openConnection
    modalError = ""
    connecting = true
    credential = ""
    sbSshHost = ""
  action closeConnection
    modalError = "" // lane r9-connect: closing Add Environment clears its error (setSavedBackendError(null))
    pendingModal = ""
    connecting = false
    credential = ""
    origin = ""
    originEdited = false
  action closeModal
    pendingModal = ""
    connecting = false
    projectsOpen = false
    paletteOpen = false
    settingsOpen = false
    snapshotSetupOpen = false
    keybindingOpen = false
    providerDialog = ""
    connectionRemove = ""
    modelsOpen = false
    credential = ""
    origin = ""
    originEdited = false
  action editOrigin(value: string)
    credential = pairFields.host != "" and pairFields.source == origin and credential == "" ? pairFields.code : credential
    origin = value
    originEdited = true
  action editCredential(value: string)
    origin = pairFields.host != "" and pairFields.source == origin ? pairFields.host : origin
    credential = value
  action toggleSidebar
    send localChanged = command("sidebar", "", data.sidebarOpen ? "closed" : "open", 0)
  action resizeSidebar(dx: number, dy: number)
    // Exact's pan delivers incremental viewport deltas, not total translation.
    draggedWidth = min(max(max(208, data.sidebarMinWidth), viewport.width - 640), max(max(208, data.sidebarMinWidth), sidebarWidth + dx))
  action finishResize(vx: number, vy: number)
    send localChanged = command("sidebar", "", "open", sidebarWidth)
  action search(value: string)
    send localChanged = command("search", "", value, 0)
  action openProjects
    projectsOpen = true
  action selectProject(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-project", id, "", 0)
      projectsOpen = false
  action manageProject(id: string, name: string, path: string)
    projectsOpen = false
    settingsEnvironmentId = settings.environmentId
    settingsProjectId = id
    settingsProjectKey = ""
    settingsCheckout = ""
    settingsRoute = "projects"
    settingsOpen = true
    modalError = ""
  action selectThread(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, "", 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action openThread(id: string, how: string) // Sidebar (sidebar-commands.ts): a row press says how it opened ("click" reads ⌘/⇧ to multi-select, "search" clears it).
    if not commandPending and id != ""
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, how, 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action sidebarLocal(op: string, id: string, value: string)
    send localChanged = command(`sidebarlocal:${op}`, id, value, 0)
  action sidebarRun(op: string, id: string, value: string)
    if not commandPending and (op != "row-key" or (value != "Enter" and value != " ")) // r12-sidebar: a focused row's keys look for its menu key; Enter and Space stay its press
      commandPending = true
      send changed = command(`sidebar:${op}`, id, value, wallTime.epochAtZero + now())
  action sidebarScrolled(x: number, y: number)
    sidebarScrollY = y
  // SidebarThreadTooltip: the hovered row's card opens to its right (SidebarPlacedHoverCard). A search result under the pointer becomes the highlighted one (onMouseMove); an open row menu (the hover Snooze) puts the card away until the next hover.
  action sidebarHover(id: string, over: bool)
    if over
      sidebarHoverId = id
      sidebarHoverLast = id
      sidebarHoverY = frame(`row-${id}`).y - sidebarScrollY
      sidebarHoverH = frame(`row-${id}`).height
      if data.sidebar.searching
        send localChanged = command("sidebarlocal:search-hover", id, "", 0)
    else
      if sidebarHoverId == id
        sidebarHoverId = ""
      if id == ""
        sidebarHoverY = -10000
  action sidebarDrag(id: string, section: string, dx: number, dy: number)
    if section != "working" and data.sidebar.dragEnabled and not commandPending
      if dragId != id
        dragId = id
        dragSection = section
        dragDx = 0
        dragDy = 0
        sidebarHoverId = ""
        dragX0 = frame(`row-${id}`).x
        dragY0 = frame(`row-${id}`).y
        dragW = frame(`row-${id}`).width
        dragH = frame(`row-${id}`).height
        dragTopY = frame("sidebar-list-top").y
        dragDividerY = frame("sidebar-pinned-divider").y
        dragWorkingY = data.sidebar.workingCount > 0 ? frame("shelf-working").y : 0
        dragSnoozedY = data.sidebar.snoozedCount > 0 ? frame("shelf-snoozed").y : 0
        dragSettledY = frame("shelf-settled").y
      dragDx = dragDx + dx
      dragDy = dragDy + dy
  action sidebarDragEnd(id: string, vx: number, vy: number) // r11-upstream: a row-action sweep's release (`sweep|…`, sidebar.contract ThreadSection) is a drop too
    if dragId == id or startsWith(id, "sweep|")
      if dragTarget == "context"
        if not commandPending
          commandPending = true
          send changed = command("sidebar:drop", id, `context|${dragCY}|${dragTopY}|${dragDividerY}|${dragCX >= frame("composer").x - 16 and dragCX <= frame("composer").x + frame("composer").width + 16 and dragCY >= frame("composer").y - 24 and dragCY <= frame("composer").y + frame("composer").height + 64}`, wallTime.epochAtZero + now())
      else
        if not commandPending and (dragTarget != "" or startsWith(id, "sweep|"))
          commandPending = true
          send changed = command("sidebar:drop", id, `${dragTarget}|${dragCY}|${dragTopY}|${dragDividerY}|false`, wallTime.epochAtZero + now())
      dragId = ""
      dragSection = ""
