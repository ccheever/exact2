      dragDy = 0
  action resetSidebarWidth
    draggedWidth = 0
    send localChanged = command("sidebarlocal:width-reset", "", "", 0)
  // handleNewThreadClick: one project creates at once; several open "New thread in…" unless ⇧ is held (the client reads it).
  action sidebarNewThread
    if not commandPending
      if data.sidebar.projectGroupCount > 1
        commandPending = true
        send changed = command("sidebar:new-thread-click", "", "", 0)
      else
        if data.projectId != ""
          draftOwner = "__unset__"
          commandPending = true
          send changed = command("new-thread", "", "", 0)
          jumpRequest = jumpRequest + 1
          focus("composer")
          utilityPage = ""
  action newThread
    if not commandPending
      if data.projectId != ""
        draftOwner = "__unset__"
        commandPending = true
        send changed = command("new-thread", "", "", 0)
        jumpRequest = jumpRequest + 1
        focus("composer")
        utilityPage = ""
      else
        projectsOpen = true
  action write(value: string)
    draft = value
    draftOwner = `${composerOwner}${data.requestKey}`
    send localChanged = command("draft", "", value, 0)
  action send
    if not commandPending and editor.overLimit and data.requestMode != "question"
      send localChanged = command("editorlocal:arm-limit", "", "", 0)
    if not commandPending and (not editor.overLimit or data.requestMode == "question")
      if data.requestMode == "question" or (data.canSend and (composerText != "" or length(data.snapshotDrafts) > 0))
        commandPending = true
        send changed = command("send", "", composerText, 0)
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action editorOp(op: string, id: string, value: string) // composer-editor.ts: menu picks, the stash
    send localChanged = command(`editorlocal:${op}`, id, value, wallTime.epochAtZero + now())
  action openModels
    focus(modelsOpen ? "composer" : "model-search")
    modelsOpen = not modelsOpen
    popoverSession = popoverSession + 1
    browseProvider = ""
    modelQuery = ""
    optionsOpen = ""
  action closeModels
    modelsOpen = false
    focus("composer")
  action searchModels(value: string)
    modelQuery = value
  action selectProvider(id: string)
    browseProvider = id
    modelQuery = ""
    focus("model-search")
  action selectModel(id: string, provider: string)
    if not commandPending and id != ""
      commandPending = true
      send changed = command("model", id, provider, 0)
      modelsOpen = false
      focus("composer")
  action chatLocal(op: string, id: string, value: string)
    if op == "fold" or op == "group" or op == "attempt" or op == "tree-all" or op == "tree-dir"
      foldHold = true
    if op == "surface-menu" or op == "surface-close" or op == "surface-close-others" or op == "surface-close-to-right" or op == "surface-close-all"
      rightPanel = false
    send localChanged = command(`chatlocal:${op}`, id, op == "table-menu" ? `${frame(`table-copy-${id}`).x}|${frame(`table-copy-${id}`).y}|${frame(`table-copy-${id}`).width}|${frame(`table-copy-${id}`).height}|${viewport.width}|${viewport.height}|${value}` : value, 0) // lane r8-keys: a table popup's trigger frame
  // Opening a fold keeps the reading position (T3 pauses follow-end while it settles); reaching the end resumes following.
  state foldHold = false
  action releaseFold
    if foldHold
      foldHold = false
  // Edit from here: the dialog's answer rolls back, then the prompt returns to the composer.
  action answerRevert(choice: string)
    if choice != "cancel"
      draftOwner = "__unset__"
    send localChanged = command("chatlocal:revert-answer", "", choice, 0)
  action earlier
    if not commandPending
      if data.hasMore and not data.historyLoading
        commandPending = true
        send changed = command("chatlocal:history", "", "", 0)
  // Window shell (shell*.contract, shell*.ts): toasts, header panel controls, title menu, right panel, thread details, confirm.
  state shellClock = 0
  state toastDismissed = ""
  state toastHover = false
  state shellOpenHandled = ""
  resource shell = shellView(data.revision, wallTime.epochAtZero + shellClock, toastDismissed, toastHover, viewport.width <= 980) as shape ShellView
  state rightPanel = false
  state rightMaximized = false
  state detailsOpen = false
  state detailsEditors = false
  resource details = shellDetails(detailsOpen, data.threadId, data.revision, conversationWidth >= 984, wallTime.epochAtZero + shellClock, floor(viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - conversationWidth)) as shape ShellDetails
