  resource sbPicker = settingsBPicker(restEditor, sbQuery, (sbLettersEdited ? sbLetters : projectsSettings.iconLetters), sbEmoji, projectsSettings.iconCwd, projectsSettings.name, data.revision, sbThumbs) as shape SbPicker
  members "./src/composer/composer-members.contract"
  // useShortcutModifierState(): the modifiers held, for the sidebar's thread-jump hints; and
  // useShortcutModifierState(true): the Pull Requests route's, which a key or a focus at a field empties
  // (shortcut-modifiers.contract). T3Window's
  // `keycapture` and `keyup` hear every key. Losing the window's focus forgets both, since a key let go while
  // another app has the focus sends no keyup.
  state shortcutModifiers = ShortcutModifierState(metaKey=false, ctrlKey=false, altKey=false, shiftKey=false)
  state speedModifierState = ShortcutModifierState(metaKey=false, ctrlKey=false, altKey=false, shiftKey=false)
  derive speedModeHeld = speedModifiers(speedModifierState)
  action modifierKey(down: bool, e: KeyboardEvent, editable: bool)
    quitHoldKey(down, e)
    // DesktopWindow.ts: a held ⌘W closes one tab or terminal, not each one behind it, so its repeats are dropped. W by
    // its key, or by its physical key where the source types no Latin character there (Korean 2-Set's ㅈ); AZERTY's W
    // key types Z.
    if down and e.repeat and e.metaKey and not e.altKey and not e.shiftKey and (e.key.toLowerCase() == "w" or (e.code == "KeyW" and e.key.length == 1 and not quitTypesLatin(e.key)))
      preventDefault()
    // ThreadUndoShortcut: a held undo chord undoes once, so its repeats are cancelled even after the notice is gone,
    // where they would reach the composer's own undo; any other key but a modifier hands the chord back to fields.
    if down and e.repeat and undoHeldKey != "" and (e.metaKey or e.ctrlKey) and e.key.toLowerCase() == undoHeldKey
      preventDefault()
      stopPropagation()
    else if down and not e.repeat and e.key != "Alt" and e.key != "Control" and e.key != "Meta" and e.key != "Shift"
      undoHeldKey = ""
      releaseUndoClaim()
    let held = shortcutModifierStateAfterKeyboardEvent(shortcutModifiers, down, e)
    if not areShortcutModifierStatesEqual(held, shortcutModifiers)
      shortcutModifiers = held
    // isEditableFocused: the window's field focus (T3Window's focusin), or the composer's own `focus`, which a launch
    // that seats the focus in the composer fires even when the window's focusin is not heard.
    let speed = (editable or composerFocused) ? emptyShortcutModifierState() : shortcutModifierStateAfterKeyboardEvent(speedModifierState, down, e)
    if not areShortcutModifierStatesEqual(speed, speedModifierState)
      speedModifierState = speed
  // showThreadUndoNotice's claim: each new notice owns the undo chord even in the composer, until another key or an
  // edit releases it (modifierKey, write); a collapsed sidebar shows no notice, so the composer keeps its own undo.
  state undoReleasedUntil = 0
  state undoHeldKey = ""
  derive undoClaimed = data.sidebarOpen and data.sidebar.undoUntil > undoReleasedUntil
  action releaseUndoClaim
    if data.sidebar.undoUntil > undoReleasedUntil
      undoReleasedUntil = data.sidebar.undoUntil
  action modifierEditableFocus
    if anyShortcutModifier(speedModifierState)
      speedModifierState = emptyShortcutModifierState()
  // Also a paste's: a dictation tool's synthetic ⌘V can send no Meta keyup, which would keep the hints up.
  action modifiersForget
    shortcutModifiers = emptyShortcutModifierState()
    speedModifierState = emptyShortcutModifierState()
  task modifiersBlur when not page.hasFocus and (anyShortcutModifier(shortcutModifiers) or anyShortcutModifier(speedModifierState))
    after(1, modifiersForget)
  // The quit shortcut's hold (quit-hold.contract): each key event and each watchdog tick is one step of its
  // record, applied by `quitApply`. QuitHoldOverlay shows `quitHintMode`; a released hold's hint lingers
  // HOLD_HINT_LINGER_MS (1.2 s), a double press's goes at once.
  state quitHold = quitHoldIdle()
  state quitHintMode = ""
  state quitHintPressed = "hold"
  state quitHintLingers = false
  state quitHintSerial = 0
  task quitWatchdog when quitHold.watchUntil > 0
    every(20, quitWatchTick)
  task quitHintLinger when quitHintLingers key=quitHintSerial
    after(1200, quitHintHide)
  action quitHoldKey(down: bool, e: KeyboardEvent)
    let next = down ? quitKeyDown(quitHold, e, performanceNow(), settingsCore.quitMode) : quitKeyUp(quitHold, e, performanceNow())
    if next.consumed
      preventDefault()
    quitApply(next)
  action quitWatchTick
    if quitHold.watchUntil > 0 and performanceNow() >= quitHold.watchUntil
      quitApply(quitWatchFired(quitHold))
  action quitHintHide
    quitHintLingers = false
    quitHintMode = ""
  // notify(): the overlay's QUIT_SHORTCUT_CHANNEL listener. concealPendingQuitWindow turns the window transparent until
  // the keys are let go; Contract has no window opacity, so only the hint goes. `close()` ends the one-window app.
  action quitApply(next: QuitHoldState)
    quitHold = next
    if next.signal == "down"
      quitHintPressed = next.mode
      quitHintMode = next.mode
      quitHintLingers = false
    else if next.signal == "conceal" or (next.signal == "up" and quitHintPressed == "double-click")
      quitHintMode = ""
      quitHintLingers = false
    else if next.signal == "up"
      quitHintSerial = quitHintSerial + 1
      quitHintLingers = true
    if next.quit
      close()
  // useThreadJumpHintVisibility: the hints show THREAD_JUMP_HINT_SHOW_DELAY_MS after a thread.jump.N shortcut's
  // modifiers are held alone and hide at once when they are not (shouldShowThreadJumpHintsForModifiers; the
  // sidebar's view lists those modifiers, none while the terminal has the focus or a search is open).
  // useShortcutModifierState's ⌘ or Control: Send shows the follow-up alternate (queue or steer) while one is held.
  derive composerSendHeld = shortcutModifiers.metaKey or shortcutModifiers.ctrlKey
  derive threadJumpsHeld = (data.legacy.enabled ? data.legacy.jumpModifiers : data.sidebar.jumpModifiers).includes(heldModifiers(shortcutModifiers.metaKey, shortcutModifiers.ctrlKey, shortcutModifiers.altKey, shortcutModifiers.shiftKey))
  state threadJumpHintsShown = false
  derive threadJumpHints = threadJumpHintsShown and threadJumpsHeld
  task threadJumpHintDelay when threadJumpsHeld and not threadJumpHintsShown
    after(200, threadJumpHintsShow)
  task threadJumpHintReset when threadJumpHintsShown and not threadJumpsHeld
    after(1, threadJumpHintsHide)
  // The sidebar's Working shelf on the window's clock (thread-inbox.ts): a grace's start or a return owed its time
  // reads it at once, and the soonest grace ends 2 s after it started. Root timers, so they run with the sidebar closed.
  task workingGraceOwed when data.sidebar.graceOwed > 0 key=data.sidebar.graceOwed
    after(1, workingGraceClock)
  task workingGraceEnds when data.sidebar.graceUntil > 0 key=data.sidebar.graceUntil
    after(2000, workingGraceClock)
  action workingGraceClock
    send localChanged = command("sidebarlocal:working-grace", "", `${wallTime.epochAtZero + performanceNow()}`, 0)
  action threadJumpHintsShow
    threadJumpHintsShown = true
  action threadJumpHintsHide
    threadJumpHintsShown = false
  // ChatView's thread effect: the composer takes the focus a frame after a thread opens while the terminal is closed.
  task composerOnThread when data.threadId != "" and not terminalDrawer.open key=data.threadId
    after(1, composerOnThreadFocus)
  action composerOnThreadFocus
    focus("composer")
  action scrollToEnd
    jumpRequest = jumpRequest + 1
    foldHold = false
  derive modal = connecting or projectsOpen or paletteOpen or settingsOpen or providerDialog != "" or restEditor != "" or welcome.show
  resource sidebarLaunch = sidebarLaunchWidth(viewport.width, data.revision) as shape number // threadSidebarWidth.ts (sidebar-width.ts): no stored width sizes the sidebar once at load
  derive sidebarWidth = draggedWidth == 0 and sidebarLaunch > 0 ? sidebarLaunch : min(max(max(208, data.sidebarMinWidth), draggedWidth > 0 ? draggedWidth : data.sidebarWidth), max(max(208, data.sidebarMinWidth), viewport.width - 640)) // a stored width: at least the minimum (13rem, or the brand at the Interface font size: sidebar-min-width.ts), leaving 40rem of main content
  derive narrowDiff = viewport.width <= 980
  state diffUserWidth = 540
  derive diffWidth = narrowDiff ? (viewport.width <= 760 ? min(viewport.width * 0.88, 384) : min(448, max(320, viewport.width * 0.42))) : max(360, min(diffUserWidth, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action resizeDiff(dx: number, dy: number)
    diffUserWidth = max(360, min(diffWidth - dx, min(floor(viewport.width * 0.7), viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - 360)))
  action finishDiffResize(vx: number, vy: number)
    diffUserWidth = diffWidth
  derive conversationWidth = viewport.width - (data.sidebarOpen ? sidebarWidth : 0) - ((data.diffOpen or rightPanel or shell.panel.open) and not narrowDiff ? diffWidth : 0)
  members "./src/composer/composer-controls-members.contract"
  members "./src/settings/settings-members.contract"
  action editOrigin(value: string) // the window's half fills the credential from a pasted pairing URL
    origin = value
    originEdited = true
  action editCredential // the window's half keeps the typed credential
    origin = pairFields.host != "" and pairFields.source == origin ? pairFields.host : origin
  action resizeSidebar(dx: number, dy: number)
    draggedWidth = min(max(max(208, data.sidebarMinWidth), viewport.width - 640), max(max(208, data.sidebarMinWidth), sidebarWidth + dx))
  action openProjects
    projectsOpen = true
  action selectProject(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-project", id, "", 0)
      projectsOpen = false
  action manageProject(id: string, name: string, path: string)
    projectsOpen = false
    openSettings() // a project link replaces the whole scope (retainSettingsScope)
    settingsProjectId = id
    settingsRoute = "projects"
  action selectThread(id: string)
    if not commandPending
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, "", 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action openThread(id: string, how: string) // Sidebar (sidebar-commands.ts): a row press says how it opened ("click", "click:meta" and "click:shift" multi-select, "search" clears it).
    if not commandPending and id != ""
      draftOwner = "__unset__"
      commandPending = true
      send changed = command("select-thread", id, how, 0)
      jumpRequest = jumpRequest + 1
      utilityPage = ""
  action sidebarLocal(op: string, id: string, value: string)
    if (op == "rename-start" or op == "legacy-rename-start") and commandPending
      renameAfterOp = op
      renameAfterId = id
    else
      send localChanged = command(`sidebarlocal:${op}`, id, value, 0)
  action sidebarRun(op: string, id: string, value: string)
    if composerFocused and (op == "menu-choice" or op == "draft-choice" or op == "legacy-thread-menu")
      blur()
    if not commandPending
      commandPending = true
      send changed = command(`sidebar:${op}`, id, value, wallTime.epochAtZero + performanceNow())
  action sidebarHover(id: string, over: bool) // the window's half sets the card's geometry (app-window.contract)
    if over
      sidebarHoverId = id
      if data.sidebar.searching
        send localChanged = command("sidebarlocal:search-hover", id, "", 0)
    else if sidebarHoverId == id
      sidebarHoverId = ""
  action resetSidebarWidth
    draggedWidth = 0
    send localChanged = command("sidebarlocal:width-reset", "", "", 0)
  action sidebarNewThread(e: MouseEvent) // ⇧-click creates at once (the press's own modifiers; a chord's press has none)
    if commandPending and data.draftLaunching and (data.sidebar.projectGroupCount <= 1 or e.shiftKey)
      draftBeside()
    else if not commandPending
      if data.sidebar.projectGroupCount > 1
        commandPending = true
        send changed = command("sidebar:new-thread-click", "", e.shiftKey ? "shift" : "", 0)
      else
        if data.projectId != ""
          draftOwner = "__unset__"
          commandPending = true
          send changed = command("new-thread", "", "", 0)
          jumpRequest = jumpRequest + 1
          focus("composer")
          utilityPage = ""
  // The new-thread shortcut while the draft's launch (its worktree setup among it) is in flight: a fresh draft in the
  // same project, beside the launch (ChatView onSend markPromotedDraftThreadByRef).
  action draftBeside
    // The fresh draft may send while the launch's own send is still answering.
    commandPending = false
    draftOwner = "__unset__"
    send draftLeft = command("new-thread", "", "", 0)
    jumpRequest = jumpRequest + 1
    focus("composer")
    utilityPage = ""
  action newThread
    if commandPending and data.draftLaunching
      draftBeside()
    else if not commandPending
      if data.projectId != ""
        draftOwner = "__unset__"
        commandPending = true
        send changed = command("new-thread", "", "", 0)
        jumpRequest = jumpRequest + 1
        focus("composer")
        utilityPage = ""
      else
        projectsOpen = true
  action write(value: string, e: InputEvent)
    composerIntentInput(value, e)
    releaseUndoClaim() // a paste from a menu, dictation or a drop edits without a key
    let inputSerial = composerFieldInputSerial + 1
    composerFieldInputSerial = inputSerial
    send composerFieldChanged = composerFieldObserved(ComposerFieldObservation(generation=richComposer.generation, snapshotOwner=data.snapshotOwner, owner=richComposerOwner, value=value, start=e.selectionStart, end=e.selectionEnd, composing=e.isComposing, live=composerFieldLive, focused=composerFocused, inputSerial=inputSerial), true)
    draft = value
    draftOwner = `${composerOwner}${data.requestKey}`
    composerInputType = e.inputType
    composerComposing = e.isComposing
    composerSelectionOwner = richComposerOwner
    composerSelectionValue = value
    composerSelectionStart = e.selectionStart
    composerSelectionEnd = e.selectionEnd
    // Typing the thread draft (not an answer) holds a request that arrives meanwhile (composer-typing-guard.ts).
    if composerFocused and data.requestMode == ""
      composerTyping = true
      typingSerial = typingSerial + 1
    send localChanged = command("draft", "", value, 0)
  action send(held: string) // held: a pointer press's own modifiers (press-modifiers.contract), "" from a key or a call
    submit(held == "" ? "" : `pointer:${held}`)
  // gesture: what pressed Send, as composer-editor-intent.ts pressGesture reads it: `pointer:<modifiers>`,
  // `key:<modifiers>` (a send chord in the composer), or "" (a plain press, a key with no chord, a call).
  action submit(gesture: string)
    if not commandPending and editor.overLimit and data.requestMode != "question"
      send localChanged = command("editorlocal:arm-limit", "", "", 0)
    if not commandPending and (not editor.overLimit or data.requestMode == "question")
      if data.requestMode == "question" or (data.canSend and (composerText != "" or data.snapshotDrafts.length > 0))
        commandPending = true
        send changed = command("send", gesture, composerText, 0)
        composerTyping = false
        draftOwner = "__unset__"
        jumpRequest = jumpRequest + 1
  action editorOp(op: string, id: string, value: string) // composer-editor.ts: menu picks, the stash
    if op == "chip-act" and chip.act == "citation"
      send citationShown = command(`editorlocal:${op}`, id, value, wallTime.epochAtZero + performanceNow()) // a chip's View source
    else
      send localChanged = command(`editorlocal:${op}`, id, value, wallTime.epochAtZero + performanceNow())
  action openModels
    focus(modelsOpen ? "composer" : "model-search")
    modelsOpen = not modelsOpen
    popoverSession = popoverSession + 1
    browseProvider = ""
    modelQuery = ""
    optionsOpen = ""
    modelTarget = PickerTarget(id="", top=0, bottom=0, left=0)
  action closeModels
    modelsOpen = false
    focus(modelTarget.id == "" ? "composer" : `setting-${modelTarget.id.slice(0, modelTarget.id.indexOf(":"))}`)
  action searchModels(value: string)
    modelQuery = value
  action selectProvider(id: string)
    browseProvider = id
    modelQuery = ""
    focus("model-search")
  // Whether selectModel takes a pick now: a scheduled task's or a source control row's at once, any other only while no
  // command is in flight (its last branch drops it then).
  derive modelPickTaken = modelTarget.id.startsWith("task-model:") or modelTarget.id.startsWith("source-control-writer-model:") or modelTarget.id.startsWith("review-guide-model:") or not commandPending
  action selectModel(id: string, provider: string, additive: bool)
    if id != "" and modelTarget.id.startsWith("task-model:")
      taskModelPick = `${provider}:${id}`
      modelsOpen = false
      focus("setting-task-model")
    else if id != "" and (modelTarget.id.startsWith("source-control-writer-model:") or modelTarget.id.startsWith("review-guide-model:"))
      modelsOpen = false
      focus(modelTarget.id.startsWith("review-guide-model:") ? "setting-review-guide-model" : "setting-source-control-writer-model")
      restRaw("rest:scoped", modelTarget.id.slice(modelTarget.id.indexOf(":|") + 2, modelTarget.id.length), `key=${modelTarget.id.startsWith("review-guide-model:") ? "reviewGuideModelSelection" : "sourceControlWriterModelSelection"}&value=${encodeURIComponent(`${provider}:${id}`)}`)
    else if not commandPending and id != ""
      commandPending = true
      pendingModal = modelTarget.id == "" ? "" : "settings" // a General row's pick is that setting's write, never the thread's model
      send changed = command(modelTarget.id == "" ? "model" : "settings-core", modelTarget.id == "" ? id : modelTarget.id, modelTarget.id == "" ? provider : `${provider}|${id}`, additive and modelTarget.id == "" ? 1 : 0)
      modelsOpen = additive and modelTarget.id == "" and catalog.multiple
      focus(additive and modelTarget.id == "" and catalog.multiple ? "model-search" : (modelTarget.id == "" ? "composer" : `setting-${modelTarget.id.slice(0, modelTarget.id.indexOf(":"))}`))
  // ModelPickerContent announces the tab or model its shortcut picked (composer-controls-commands.ts
  // announcePickerShortcut), and its announce blocks nothing: the announcement waits for no command in flight and
  // refreshes only the shell, whose live regions speak it, so a quick second press is announced too and a pick right
  // after is not refused. Each send runs in turn (`queue`). settings-shortcuts.contract calls it after a tab, and after
  // a model only when selectModel took it (modelPickTaken), as handleModelSelect's slug gates the announcement.
  action pickerAnnounce(op: string, id: string, value: string)
    send pickerAnnounced = command(op, id, value, 0)
  state taskModelPick = "" // the open scheduled task editor's picked `instance:model`, until it closes
  action pickModel(row: string, context: string)
    openModels()
    modelTarget = PickerTarget(id=`${row}:|${context}`, top=frame(`setting-${row}`).y, bottom=frame(`setting-${row}`).y + frame(`setting-${row}`).height, left=frame(`setting-${row}`).x)
  action prConfirmDisarm(ref: string, serial: string)
    send prConfirmChanged = command("chatlocal:pr-ui-disarm", ref, serial, 0)
  derive inlineDocumentKeysBlocked = sshPrompt.open or confirmOp != "" or data.serverUpdate.confirmTitle != "" or data.updateEverything.confirm or shell.panel.deviceSetup or shell.composerFile.open or data.composerImagePreview.length > 0 or data.messages.map(message => message.inlineDocuments).flat().filter(document => document.permission != "").length > 0
  action inlineDocumentShortcut(name: string)
    // A guest can forge keys while its background is inert; retain the current modal context.
    if not inlineDocumentKeysBlocked
      if name == "sidebar.toggle"
        // The sidebar owns its button chord, so keyboardDispatch has no row for it.
        if not modal and not paletteOpen and not settingsOpen
          command("sidebar", "", data.sidebarOpen ? "closed" : "open", 0)
      else
        let candidates = shortcuts.filter((item) => item.command == name)
        match candidates.at(0)
          case some(item)
            if item.command == "commandPalette.toggle" or item.command == "filePicker.toggle" or item.command == "projectSearch.toggle" or item.command == "chat.find"
              paletteShow(item.target, item.extra)
            else if item.command == "rightPanel.toggle" or item.command == "rightPanel.toggleMaximized" or item.command == "preview.toggle"
              if item.kind == "diff"
                panelUi("toggle", "")
              else if item.kind == "command"
                command(item.target, item.extra, "", 0)
              else if item.kind == "panel-close"
                panelUi("close", "")
            else if item.command == "threadPanel.toggle"
              detailsAct("toggle", "", "")
            else if item.command == "terminal.toggle"
              command(item.target, item.extra, "", 0)
            else if item.command == "thread.previous" or item.command == "thread.next" or item.command.startsWith("thread.jump.")
              selectThread(item.target)
            else if item.command.startsWith("modelPicker.jump.") and item.kind == "model"
              selectModel(item.target, item.extra, false)
            else if item.command == "navigation.back" or item.command == "navigation.forward"
              if item.kind == "thread"
                selectThread(item.target)
              else if item.kind == "back"
                closeModal()
              else if item.kind == "palette-run"
                paletteRun(item.target, item.extra, "")
              else if item.kind == "new-thread-in"
                paletteRun("new-thread", item.target, "")
          case none
  action chatLocal(op: string, id: string, value: string)
    // A disclosure toggled with the transcript at its end keeps the end in view while the rows re-measure (the list goes
    // on following it); anywhere else the toggled row holds its place (MessagesTimeline's disclosurePinsEnd).
    if (op == "fold" or op == "group" or op == "attempt" or op == "tree-all" or op == "tree-dir") and not (restAtEnd and restOwner == composerOwner)
      foldHold = true
    if op == "surface-close-others" or op == "surface-close-to-right" or op == "surface-close-all" or (op == "surface-close" and shell.panel.tabs.filter((tab) => tab.id == id and tab.closeTitle != "").length == 0) or (op == "surface-browser-float" and not shell.panel.browser.capture.floating) or op == "surface-session-float" or (op == "surface-files-search-key" and id == "sheet" and value == "Escape")
      rightPanelAt = ""
    if op.startsWith("inline-doc-")
      send inlineDocumentChanged = command(`chatlocal:${op}`, id, value, 0)
    else if op == "surface-pr-quick"
      send prQuickChanged = command(`chatlocal:${op}`, id, value, 0)
    else if op.startsWith("surface-files-comment-")
      send fileCommentChanged = command(`chatlocal:${op}`, id, value, 0)
    else if op == "pr-code-drag" or op == "pr-code-begin"
      send lineDragChanged = command(`chatlocal:${op}`, id, value, 0) // the Code tab's gutter drags and "+", in turn
    else if op == "diagram-frame" or op == "math-frame" or op == "audio-playing"
      send frameReported = command(`chatlocal:${op}`, id, value, 0)
    else if op == "link-open" and value.startsWith("#")
      send fragmentChanged = command(`chatlocal:${op}`, id, value, 0) // fragmentOpened
    else if op == "chip-citation"
      send citationShown = command(`chatlocal:${op}`, id, value, 0)
    else if op == "surface-browser-capture"
      send capturePressed = command(`chatlocal:${op}`, id, value, 0)
    else if op == "git-pr-text"
      send prCheckoutTyped = command(`chatlocal:${op}`, id, value, 0)
    else
      send localChanged = command(`chatlocal:${op}`, id, op == "table-menu" ? `${frame(`table-copy-${id}`).x}|${frame(`table-copy-${id}`).y}|${frame(`table-copy-${id}`).width}|${frame(`table-copy-${id}`).height}|${viewport.width}|${viewport.height}|${value}` : value, 0) // a table popup's trigger frame
  state foldHold = false
  action releaseFold
    if foldHold
      foldHold = false
  action answerRevert(choice: string)
    if choice != "cancel"
      draftOwner = "__unset__"
    send localChanged = command("chatlocal:revert-answer", "", choice, 0)
  action earlier
    if not commandPending
      if data.hasMore and not data.historyLoading
        commandPending = true
        send changed = command("chatlocal:history", "", "", 0)
  members "./src/shell/shell-members.contract"
  state citeWaitAsked = 0
  state citeWaitDone = 0
  state citeDismissals = 0
  task citeWait when citeWaitAsked > citeWaitDone key=citeWaitAsked
    after(500, citeWaitOver)
  action citeWaitOver
    citeWaitDone = citeWaitAsked
  action citeWaitAsk(seq: number)
    citeWaitAsked = seq
  task citeBlur when not page.hasFocus
    after(1, citeDismissed)
  task citeContext key=`${viewport.width}x${viewport.height}|${data.threadId}|${pageCover}|${settingsOpen}|${modal}`
    after(1, citeDismissed)
  action citeDismissed
    citeDismissals = citeDismissals + 1
  // Cite back after a scroll: the transcript's scrollend (the offset still for 100 ms) and 50 ms more make the reference's
  // 150 ms after the last scroll (observeSelectionActions' SELECTION_SCROLL_SETTLE_MS).
  state citeSettleAsked = 0
  state citeSettleDone = 0
  task citeSettle when citeSettleAsked > citeSettleDone key=citeSettleAsked
    after(50, citeSettleOver)
  action citeSettleOver
    citeSettleDone = citeSettleAsked
  action citeSettleAsk(seq: number)
    citeSettleAsked = seq
  view
