  mutation providerAuthChanged as shape Change queue refreshes data, providerPage, providerWizard
  mutation providerUpdateRun as shape Change queue refreshes providerPage
  mutation changed as shape Change refreshes data then commandCompleted
  mutation prQuickChanged as shape Change queue refreshes data
  mutation prConfirmChanged as shape Change refreshes data
  mutation inlineDocumentChanged as shape Change queue refreshes data
  mutation secretAnswered as shape Change queue refreshes data then dispatchTimelineReads
  mutation localChanged as shape Change refreshes data
  mutation pickerAnnounced as shape Change queue refreshes shell // the model picker's shortcut announcements (pickerAnnounce)
  // A pull request surface's remembered tab (prSetTab); queued, so quick tab presses land in order.
  mutation prTabSaved as shape Change queue
  // A drop on the chat column or a legacy row, a paste into the composer, or Attach files' picks (composer-controls-attach.ts
  // attachIncoming, legacy-sidebar-drop.ts queueRowDrop). Queued: a second drop waits for the first.
  mutation filesAdded as shape Change queue refreshes data then filesAddedDone
  mutation prHandoffChanged as shape Change refreshes data // a checkout hand-off's second half, its own send
  // A new thread opened while the draft's launch is in flight: its own send, so the launch's reply is not let go (draft-launch.ts).
  mutation draftLeft as shape Change refreshes data
  mutation terminalTicketChanged as shape Change queue refreshes data // a terminal page's socket ticket (terminal-frames.ts)
  mutation fileCommentChanged as shape Change queue refreshes data // the Files preview's line comments (chatLocal)
  mutation lineDragChanged as shape Change queue refreshes data // a diff gutter drag's press, moves and release, each in turn
  mutation frameReported as shape Change queue refreshes data // each Mermaid and math page's report and each sound's start and stop, in turn (chatLocal)
  mutation terminalChanged as shape Change queue refreshes data then terminalCompleted // the drawer's ops, its pages' messages in turn
  action terminalCompleted
    match terminalChanged
      case some(result)
        if result.message == "terminal:focus-composer"
          focus("composer")
      case none
  // A fragment link's press and the prompt links' sends, each in turn: a prompt link's switch to another machine's Scratch
  // project waits on its own timers (scratch-machine.ts), and a queued send is never let go.
  mutation fragmentChanged as shape Change queue refreshes data then fragmentOpened
  // View source, a transcript chip's or the composer's: it waits on its own timers, so only a newer one may let it go.
  mutation citationShown as shape Change refreshes data
  mutation capturePressed as shape Change queue refreshes data // the Browser's Capture: a Record start waits on its own timers (browser-recording.ts waitForPaint)
  mutation prCheckoutTyped as shape Change refreshes data // the checkout dialog's edits: only the next one lets one go mid-debounce, and it takes `waiting` over (pr-checkout.ts)
  action fragmentOpened
    match fragmentChanged
      case some(result)
        // A pull request link the system handed over: the Pull Requests page on that pull request.
        if result.message.startsWith("sidebar:pr-page:")
          openPage("pull-requests")
          prSelect(result.message.slice(16))
        if result.message == "sidebar:new-thread"
          draftOwner = "__unset__"
          jumpRequest = jumpRequest + 1
          utilityPage = ""
          focus("composer")
      case none
