// Lane r6-polish: texts the app places things by, measured from laid-out text
// instead of estimated (as r5-composer.contract's probes): each probe is drawn
// once, invisible and passing the pointer through (`pointer-events="none"`,
// which the macOS host honours on boxes since 652a6c865), and reports [x, width] through the t3-anchor hook
// (T3Composer.swift); r5-composer-menus.ts `measured` reads it back.
use R5Probe from "./r5-composer.contract"
use ShellDetails from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use CnScriptIcon from "./settings-b-kit.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"

component R6TextProbes
  props
    probes: list<R5Probe>
  view
    column position="absolute" left=0 top=0 opacity=0 pointer-events="none" aria-hidden=true align-items="flex-start" testId="r6-text-probes"
      each probe in probes key=probe.key
        box hatch="t3-anchor" data-anchor=probe.key display="flex" flex-direction="row" flex-shrink=0
          text probe.text font-size=probe.size font-weight=probe.weight line-height=`${probe.size + 4}px` white-space="nowrap" flex-shrink=0

// ProjectScriptsControl displayMode="panel" (r6-polish-scripts.ts): the primary
// script's icon and name, a hairline and the chevron, as the card's Open in row.
// Running a script needs the terminal (EX01), so the run part is disabled; the
// chevron's menu lists the scripts (also disabled) and "Add project script".
component R6ScriptRow
  props
    details: ShellDetails
    open: bool
    toggle: action
    toggleKey: action
    run: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    row height="2rem" align-items="center" border-radius="0.625rem" role="group" aria-label="Project scripts" testId="details-scripts" background-color=(hovered == "menu" or open ? "light-dark(#0000000e, #ffffff13)" : "#00000000")
      box position="relative" flex=1 min-width=0 hover=hover("run")
        button press=run aria-label=`Run ${details.scriptName}` testId="details-run-script" width="100%" min-width=0 height="2rem" padding-left="0.6875rem" padding-right="0.625rem" box-sizing="border-box" gap="0.625rem" border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          box display="flex" flex-shrink=0
            CnScriptIcon(icon=details.scriptIcon, size=16, color="light-dark(#71717b, #818181)")
          text details.scriptName flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.8125rem" font-weight=500 line-height="1.21875rem" color="light-dark(#27272acc, #f5f5f5cc)"
        TipBubble(label=`Run ${details.scriptName}`, side="top", align="center", offset=36, inset=0, shown=(hovered == "run"))
      box width=1 height="1rem" flex-shrink=0 background-color="light-dark(#e4e4e7a6, #ffffff10)"
      button press=toggle key=toggleKey hover=hover("menu") aria-label="Script actions" aria-expanded=open testId="details-script-actions" width="2rem" height="2rem" padding=0 border-width=0 border-radius="0.625rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        ShellIcon(name="chevron-down", size=16, color="light-dark(#71717b, #818181)")

// The scripts menu, 4pt under the row and as wide (w-(--anchor-width)), over a click-away layer.
component R6ScriptMenu
  props
    details: ShellDetails
    top: number
    act: action
    close: action
  state over = ""
  state lit = ""
  action hover(id: string, value: bool)
    over = value ? id : (over == id ? "" : over)
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  view
    button press=close aria-label="Close script menu" position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 background-color="#00000000" testId="details-scripts-backdrop"
    column position="absolute" left="0.5rem" right="0.5rem" top=top padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Project scripts" testId="details-scripts-menu"
      KeyMenu(menuId="details-scripts-keys", items=concat(map(details.scripts, (script) => KmItem(id=`details-script-${script.id}`, label=script.label)), [KmItem(id="details-scripts-add", label="Add project script")]), keyed=0, gap="0px", modal=false)
        each script in details.scripts key=script.id
          button id=`details-script-${script.id}` press=act("terminallocal:run-script", script.id, "") hover=hover(script.id) focus=focused(script.id, true) blur=focused(script.id, false) role="menuitem" testId=`details-script-${script.id}` width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
            CnScriptIcon(icon=script.icon, size=16, color="light-dark(#71717b, #818181)")
            text script.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        button id="details-scripts-add" press=act("ui:add-script", "", "") hover=hover("add") focus=focused("add", true) blur=focused("add", false) role="menuitem" testId="details-scripts-add" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(over == "add" or lit == "add" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") display="flex" flex-direction="row" align-items="center"
          ShellIcon(name="plus", size=16, color="light-dark(#71717b, #818181)")
          text "Add project script" flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
