// Lane r6-media (MIT reference, see LICENSE-T3): sent videos in the transcript
// (MessagesTimeline UserVideoAttachment, ExpandedImageDialog ExpandedVideo). It imports only
// media-actions.contract (which imports only icons), so the timeline's attachment view can use it
// without a cycle.
use MediaActions from "./media-actions.contract"

// UserVideoAttachment → MediaVideoPlayer with onOpen: a 4:3 cell of the message's media grid
// (101 × 75.75 at the grid's 210pt), the first frame muted and without controls ("aspect-auto
// size-full rounded-lg border border-border/80 bg-black object-contain"), the whole face the
// "Play {name}" button with a 32pt black/50 disc and a 16pt filled Play glyph. Before its
// signed URL arrives the cell is the black loading panel.
component R6VideoTile
  props
    id: string
    name: string
    url: string
    messageId: string
    local: action
  // media-actions: UserVideoAttachment passes its signed attachment as actionsSource (Save video; no Copy image).
  view
    MediaActions(source=`attachment:${id}`, tip=name, local=local, testId=`attachment-video-actions-${id}`)
      R6VideoFace(id=id, name=name, url=url, messageId=messageId, local=local)

component R6VideoFace
  props
    id: string
    name: string
    url: string
    messageId: string
    local: action
  view
    box position="relative" width=101 height=75.75 flex-shrink=0 testId=`attachment-video-${id}`
      when url != ""
        video url muted=true playsinline=true preload="metadata" aria-hidden=true width="100%" height="100%" box-sizing="border-box" overflow="hidden" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="#000000" object-fit="contain" testId=`attachment-video-frame-${id}`
      else
        box width="100%" height="100%" box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="#000000" role="status" aria-label="Loading video"
      button press=local("image-open", id, messageId) aria-label=`Play ${name}` testId=`play-attachment-${id}` position="absolute" left=0 top=0 right=0 bottom=0 padding=0 border-width=0 border-radius=8 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
        column width=32 height=32 border-radius=16 align-items="center" justify-content="center" background-color="#00000080"
          svg width=16 height=16 viewBox="0 0 24 24" color="#ffffff" fill="currentColor" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"

// ExpandedVideo: MediaVideoPlayer with controls, autoplay and playsInline at its natural size up
// to the dialog's media box ("aspect-auto max-h-[var(--media-height)] w-auto
// max-w-[var(--media-width)] rounded-lg border border-border/70 shadow-2xl").
component R6ExpandedVideo
  props
    url: string
    name: string
    maxWidth: number
    maxHeight: number
    // media-actions: the player's onError (MediaVideoPlayer failedSrc).
    broke: action
  view
    video url controls=true autoplay=true playsinline=true preload="metadata" aria-label=name error=broke max-width=maxWidth max-height=maxHeight box-sizing="border-box" overflow="hidden" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7b3, #ffffff0d)" box-shadow="0 25px 50px -12px #00000040" background-color="#000000" object-fit="contain" testId="image-preview-video"
