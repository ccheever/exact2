// ui/toast.tsx Toasts (MIT, see LICENSE-T3), measured on the served reference:
// a top-right region 32pt in (16pt under 640pt) below the 52pt top bar, 360pt
// wide; dropdown glass cards (popover 83.6% over a 12pt blur, flattened to
// the colour it shows over the canvas because AppKit's backdrop sees no
// further than a node's parent; 1px foreground/10 edge, 10pt radius,
// shadow-xl black/25) with a 24pt corner orb that overhangs the card by 6pt. Collapsed, the newest card is in front and the next two peek 12pt
// below it at 90% and 80% width; hovering the region expands the stack with
// 12pt gaps. The orb is laid out inside a 6pt gutter so AppKit hit-tests all
// of it. Toasts beyond the third are limited (hidden) as Base UI limits them.
use ShellToast from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use ShellBadgedIcon from "./shell-icons.contract"
use ProviderMark from "./icons.contract"
use ShellToastDetail from "./shell-shapes.contract"
use MorphPair from "./shell-morph.contract"
use MorphChevron from "./shell-morph.contract"

component ToastStack
  props
    toasts: list<ShellToast>
    width: number
    top: number
    right: number
    expanded: bool
    still: bool
    hover: action
    act: action
  view
    column position="absolute" top=(top - 6) right=(right - 6) width=(width + 6) z-index=100 role="region" aria-label="Notifications" testId="toast-region" hover=hover
      when expanded
        column width="100%" gap="0.375rem"
          each toast in toasts key=toast.id
            when toast.index < 3
              ToastCard(toast=toast, still=still, act=act)
      else
        column position="relative" width="100%"
          each toast in toasts key=toast.id
            when toast.index == 2 or toast.index == 1
              column position="absolute" top=(6 + 12 * toast.index) bottom=(-12 * toast.index) left=(18 * toast.index) right=(6 + 18 * toast.index) border-radius=(10 - toast.index) border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" pointer-events="none" testId=`toast-peek-${toast.index}`
          each toast in toasts key=toast.id
            when toast.index == 0
              ToastCard(toast=toast, still=still, act=act)

component ToastCard
  props
    toast: ShellToast
    still: bool
    act: action
  derive trailing = toast.actionLabel != "" or toast.secondaryLabel != "" or toast.copyText != ""
  view
    column position="relative" width="100%" padding-top="0.375rem" padding-right="0.375rem" box-sizing="border-box" flex-shrink=0 testId=`toast-${toast.id}`
      column width="100%" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#fefefe, #101010)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" role="dialog" aria-label=toast.title
        when toast.stacked
          column width="100%" padding-left="0.875rem" padding-right="0.875rem" padding-top="0.625rem" padding-bottom="0.625rem" gap="0.5rem" box-sizing="border-box"
            column gap="0.125rem" padding-right="1.25rem" min-width=0
              ToastHeading(toast=toast)
              when toast.description != ""
                ToastDescription(toast=toast, still=still)
            row width="100%" justify-content="flex-end" align-items="center" gap="0.375rem"
              ToastButtons(toast=toast, still=still, act=act)
        else
          row width="100%" padding-left="0.875rem" padding-right=(trailing ? "1.5rem" : "2.5rem") padding-top="0.75rem" padding-bottom="0.75rem" gap="0.375rem" align-items="center" justify-content="space-between" box-sizing="border-box"
            column flex=1 min-width=0 gap="0.125rem"
              ToastHeading(toast=toast)
              when toast.description != ""
                ToastDescription(toast=toast, still=still)
            when trailing
              row flex-shrink=0 align-items="center" gap="0.375rem"
                ToastButtons(toast=toast, still=still, act=act)
      button press=act(toast.id, "dismiss", "", "") position="absolute" top=0 right=0 width="1.5rem" height="1.5rem" padding=0 border-radius="0.75rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e799, #ffffff09)" background-color="light-dark(#ffffffeb, #171717eb)" box-shadow="0 1px 3px #0000001a, 0 1px 2px -1px #0000001a" display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Dismiss notification" testId=`toast-dismiss-${toast.id}`
        svg width="0.75rem" height="0.75rem" viewBox="0 0 24 24" color="light-dark(#71717b, #818181)" fill="none" stroke="currentColor" stroke-width=2.25 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M18 6 6 18M6 6l12 12"

component ToastHeading
  props
    toast: ShellToast
  view
    row min-width=0 gap="0.5rem" align-items="flex-start"
      when toast.provider != ""
        row width="1rem" height="1.25rem" align-items="center" justify-content="center" flex-shrink=0
          ShellBadgedIcon(size=16, badge="download", badgeColor="#00bc7d", plate="light-dark(#ffffff, #111111)")
            ProviderMark(driver=toast.provider, size=16, color="light-dark(#27272a, #f5f5f5)")
      else
        when toast.icon != ""
          row width="1rem" height="1.25rem" align-items="center" justify-content="center" flex-shrink=0 opacity=(toast.kind == "loading" ? 0.8 : 1)
            ShellIcon(name=toast.icon, size=16, color=toast.iconColor)
      text toast.title flex-shrink=1 min-width=0 font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId=`toast-title-${toast.id}`

component ToastButtons
  props
    toast: ShellToast
    still: bool
    act: action
  view
    when toast.copyText != ""
      // CopyErrorButton: Copy morphs to a success-toned Check for 2 s (upstream f2cc80a7a4).
      button press=act(toast.id, "copy", "", toast.copyText) width="1.25rem" height="1.25rem" padding=0 border-radius="0.375rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label=(toast.copied ? "Copied error" : "Copy error") testId=`toast-copy-${toast.id}`
        MorphPair(first="copy", second="check", on=toast.copied, size=12, color="light-dark(#71717bcc, #818181cc)", onColor="#00bc7d", still=still)
    // secondaryActionVariant "ghost": no border, fill or shadow (button variant=ghost size=xs).
    when toast.secondaryLabel != ""
      button press=act(toast.id, toast.secondaryOp, toast.secondaryId, toast.secondaryValue) height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color=(toast.secondaryGhost ? "#00000000" : "light-dark(#d4d4d8, #ffffff14)") background-color=(toast.secondaryGhost ? "#00000000" : "light-dark(#ffffff, #ffffff07)") box-shadow=(toast.secondaryGhost ? "none" : "0 1px 2px #0000000d") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 testId=`toast-secondary-${toast.id}`
        text toast.secondaryLabel font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
    when toast.actionLabel != ""
      when toast.actionOutline
        button press=act(toast.id, toast.actionOp, toast.actionId, toast.actionValue) height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 testId=`toast-action-${toast.id}`
          text toast.actionLabel font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
      else
        button press=act(toast.id, toast.actionOp, toast.actionId, toast.actionValue) height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 testId=`toast-action-${toast.id}`
          text toast.actionLabel font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="#ffffff"

// Toast.Description; with expandable rows (SlowRpcRequestToastCoordinator's
// expandableDescriptionTrigger) the description itself discloses them:
// underlined on hover, a 14pt chevron, and a scrolling list capped at 160pt.
component ToastDescription
  props
    toast: ShellToast
    still: bool
  state open = false
  state over = false
  action toggle
    open = not open
  action hover(value: bool)
    over = value
  view
    when length(toast.details) == 0
      text toast.description font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" line-clamp=(toast.kind == "error" and length(toast.description) >= 180 ? 4 : 0) testId=`toast-description-${toast.id}`
    else
      column min-width=0 width="100%"
        button press=toggle hover=hover aria-label=(open ? toast.collapseLabel : toast.expandLabel) aria-expanded=open width="100%" min-width=0 padding=0 gap="0.375rem" border-width=0 border-radius="0.25rem" background-color=(over ? "light-dark(#f4f4f566, #ffffff04)" : "#00000000") display="flex" flex-direction="row" align-items="flex-start" testId=`toast-expand-${toast.id}`
          text toast.description flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" text-decoration-line=(over ? "underline" : "none") testId=`toast-description-${toast.id}`
          box margin-top="0.125rem" opacity=0.8 flex-shrink=0 display="flex"
            MorphChevron(open=open, quarter=false, size=14, color="light-dark(#71717b, #818181)", still=still)
        when open
          scroll max-height="10rem" margin-top="0.5rem" min-height=0 padding-right="0.125rem" testId=`toast-details-${toast.id}`
            column gap="0.625rem"
              each detail in toast.details key=detail.id
                ToastDetailRow(detail=detail)

component ToastDetailRow
  props
    detail: ShellToastDetail
  view
    column min-width=0 padding-bottom=(detail.last ? "0px" : "0.5rem") border-bottom-style="solid" border-bottom-width=(detail.last ? 0 : 1) border-color="light-dark(#e4e4e780, #ffffff08)"
      text detail.title font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
      text detail.subtitle margin-top="0.125rem" font-size="0.625rem" line-height="0.875rem" opacity=0.75 color="light-dark(#71717b, #818181)"
