// The changes side panel (wide) and sheet (narrow), measured against T3's served
// right panel: DiffPanel header/toolbar, @pierre/diffs file headers and rows.
// Every patch comes from the server's diff APIs; nothing here invents content.
use Snapshot from "./shapes.contract"
use DiffItem from "./shapes.contract"
use DiffSegment from "./shapes.contract"
use DiffFile from "./shapes.contract"
use ReqIcon from "./requests.contract"
use diffInk from "./settings-appearance-look.contract"
use synColor from "./markdown.contract"
use synSlant from "./markdown.contract"
use ShellView from "./shell-shapes.contract"
use ShellSurface from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use R4PanelHeader from "./r4-surfaces.contract"
use DiffGlyph from "./diff-glyphs.contract"
use DiffTree from "./diff-tree.contract"
use DiffCommentCard, DiffDraftCard from "./diff-comments.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmKeyEnd from "./menu-keys.contract"
use kmArrow from "./menu-keys.contract"
use kmEndKeyed from "./menu-keys.contract"

// Rebuilt on a scheme change so native SVG glyphs resolve the new light-dark() side.
component DiffPanel
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    scheme: string
    detailsOpen: bool
    details: action
    local: action
  view
    when scheme == "dark"
      DiffPanelBody(data=data, shell=shell, command=command, close=close, ui=ui, maximized=maximized, resize=resize, finishResize=finishResize, sheet=sheet, detailsOpen=detailsOpen, details=details, local=local)
    else
      DiffPanelBody(data=data, shell=shell, command=command, close=close, ui=ui, maximized=maximized, resize=resize, finishResize=finishResize, sheet=sheet, detailsOpen=detailsOpen, details=details, local=local)

// DiffPanelShell's header: the Diff tab and "Add panel surface", then
// Maximize panel, the terminal drawer and the right panel toggle; an inline
// panel resizes from an 8pt handle over its left edge (RightPanelResizeHandle).
component DiffPanelBody
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    detailsOpen: bool
    details: action
    local: action
  state hovered = ""
  // diff-review: the open comment draft's text (AnnotatableCodeView draftText), kept here so a scrolled-away row keeps it.
  state draftText = ""
  action closeScope
    command("diff-view", "menu", "", 0)
    focus("diff-scope")
  // fix-keyboard-focus: the end of the scope menu a key on its trigger asked for (menu-keys.contract).
  state scopeEnd = ""
  action setScopeEnd(end: string)
    scopeEnd = end
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  action editDraft(text: string)
    draftText = text
  action beginComment(path: string, side: string, line: number)
    draftText = ""
    command("diffreview", `comment:${side}`, path, line)
  action cancelComment
    draftText = ""
    command("diffreview", "cancel", "", 0)
  action saveComment
    command("diffreview", "save", draftText, 0)
    draftText = ""
  view
    column height="100%" width="100%" min-width=0 position="relative" box-sizing="border-box" background-color=(sheet ? "light-dark(#ffffff, #0a0a0a)" : "light-dark(#fcfcfc, #0a0a0a)") border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #191919)" box-shadow=(sheet ? "0 10px 15px -3px #0000000d, 0 4px 6px -4px #0000000d" : "none") testId="diff-panel" role=(sheet ? "dialog" : "region") aria-label="Diff"
      // r4-surfaces: the shared tab bar (every open surface, "+", the layout controls; the details toggle in a sheet); DiffPanel already rebuilds per scheme.
      R4PanelHeader(panel=shell.panel, surfaces=shell.surfaces, sheet=sheet, maximized=maximized, detailsOpen=detailsOpen, keyThreadPanel=shell.keyThreadPanel, keyRightPanel=shell.keyRightPanel, terminalAvailable=shell.terminalAvailable, terminalOpen=shell.terminalOpen, keyTerminal=shell.keyTerminal, still=false, ui=ui, details=details, local=local, scheme="")
      // A sheet's toolbar sits 6pt lower over the same content top (served reference at 840).
      column margin-top=(sheet ? "0.375rem" : "0px")
        DiffToolbar(data=data, command=command, scopeEnd=setScopeEnd)
      row flex=1 min-height=0 width="100%" margin-top=(sheet ? "0.375rem" : "0.75rem")
        column flex=1 min-width=0 min-height=0
          when data.diffError != ""
            text data.diffError font-size="0.6875rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-bottom="0.5rem" color="light-dark(#fb2c36cc, #fb414acc)" testId="diff-error"
          when data.diffTruncated
            text "This preview exceeds the size limit. Changes shown are incomplete." font-size="0.6875rem" line-height="1rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" flex-shrink=0 background-color="light-dark(#f4f4f566, #1c1c1c66)" color="light-dark(#71717a, #818181)"
          when data.diffLoading and length(data.diffItems) == 0
            column flex=1 padding-top="0.25rem" gap="0.5rem" role="status" aria-label=data.diffLoadingLabel testId="diff-loading"
              row height="2rem" padding-left="0.5rem" padding-right="0.75rem" gap="0.5rem" align-items="center"
                box width="0.625rem" height="0.625rem" border-radius="0.1875rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width="1.25rem" height="1.25rem" border-radius="0.375rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width="45%" height="0.75rem" border-radius="0.375rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
              column padding-left="0.75rem" padding-right="0.75rem" gap="0.5rem"
                box width="66%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
                box width="80%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
                box width="60%" height="0.625rem" border-radius="0.3125rem" background-color="light-dark(#f0f0f1, #161616)"
          else
            when data.diffEmpty and data.diffError == ""
              column flex=1 align-items="center" justify-content="center" padding-left="0.75rem" padding-right="0.75rem"
                text data.diffEmptyLabel font-size="0.75rem" line-height="1rem" text-align="center" color="light-dark(#71717ab3, #818181b3)" testId="diff-empty"
            else
              // DiffFileLoadingBoundary: nearing the end of a large diff asks for four more files (diff-review.ts).
              list virtualized=true id="diff-list" reachend=command("diffreview", "next", "", 0) flex=1 min-height=0 width="100%" testId="diff-content"
                each item in data.diffItems key=item.id
                  DiffRow(item=item, wrap=data.diffWrap, command=command, scheme=data.look.diff, size=data.look.codeSize, commentOpen=data.diffCommentOpen, draftText=draftText, editDraft=editDraft, beginComment=beginComment, cancelComment=cancelComment, saveComment=saveComment)
        when data.diffTree and length(data.diffFiles) > 0
          DiffTree(data=data, command=command, scheme=data.look.diff)
      // The rail sits inside the panel and above its body: an overflowing child is not hit-testable natively.
      when not sheet and not maximized
        box position="absolute" top=0 bottom=0 left=0 width="0.375rem" z-index=28 cursor="col-resize" touch-action="none" pan=resize panrelease=finishResize hover=hover("resize") role="separator" aria-orientation="vertical" aria-label="Resize diff panel" testId="diff-resize"
          box position="absolute" top=0 bottom=0 left=0 width=1 pointer-events="none" background-color=(hovered == "resize" ? "light-dark(#e4e4e7, #ffffff1a)" : "#00000000")
      when data.diffMenu != ""
        box position="absolute" left="-187.5rem" right="-187.5rem" top="-187.5rem" bottom="-187.5rem" z-index=29 press=closeScope aria-label="Close diff scope menu" aria-keyshortcuts="Escape"
        DiffScopeMenu(data=data, command=command, keyed=kmEndKeyed(scopeEnd))

// One "Add panel surface" row: 28pt, 16pt glyph at 80%, label, letter key.
component AddSurfaceItem
  props
    surface: ShellSurface
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose popovertarget="diff-add-surface" popovertargetaction="hide" hover=hover disabled=(not surface.available) role="menuitem" aria-label=`${surface.label} ${surface.shortcut}` testId=`add-surface-${surface.id}` display="flex" flex-direction="row" align-items="center" gap="0.5rem" width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" opacity=(surface.available ? 1 : 0.64) background-color=(hovered and surface.available ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      box width="1rem" height="1rem" flex-shrink=0 opacity=0.8
        ShellIcon(name=surface.icon, size=16, color="light-dark(#71717b, #818181)")
      text surface.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      text surface.shortcut flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" letter-spacing="0.075rem" color="light-dark(#71717b, #818181)"

component DiffToolbar
  props
    data: Snapshot
    command: action
    scopeEnd: action
  // fix-keyboard-focus: the scope menu opens from the data module, so the trigger lets go of the focus and
  // the menu's popup takes it as it mounts (`autofocus`, menu-keys.contract), on ↓ and ↑ too.
  action openScope
    blur()
    command("diff-view", "menu", "scope", 0)
  action scopeKey(k: string, e: KeyboardEvent)
    scopeEnd(kmKeyEnd(k))
    if kmArrow(k) and not e.metaKey and not e.ctrlKey and not e.altKey and data.diffMenu == ""
      preventDefault()
      blur()
      command("diff-view", "menu", "scope", 0)
  view
    row height="1.75rem" flex-shrink=0 padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" gap="0.25rem"
      button id="diff-scope" press=openScope key=scopeKey focus=scopeEnd("") aria-label=`Diff scope: ${data.diffScopeLabel}` aria-expanded=(data.diffMenu != "") testId="diff-scope" height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color="light-dark(#fafafa, #111111)" display="flex" flex-direction="row" align-items="center" min-width=0 flex-shrink=1
        text data.diffScopeLabel font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
        ReqIcon(name="chevron-down", size=14, color="light-dark(#27272a, #f5f5f5)")
      box flex=1
      // DiffPanel header: the stat shows with files to count, refresh with a git workspace, expand-all and the tree with files.
      when length(data.diffFiles) > 0 or data.diffAdditions + data.diffDeletions > 0
        row gap="0.25rem" align-items="center" flex-shrink=0 margin-right="0.25rem" role="group" aria-label=`${data.diffAdditions} additions, ${data.diffDeletions} deletions`
          text `+${data.diffAdditions}` font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="1rem" color=diffInk(data.look.diff, "add-count")
          text `-${data.diffDeletions}` font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="1rem" color=diffInk(data.look.diff, "del-count")
      when data.diffCanRefresh
        DiffTool(icon="refresh", label=(data.diffLoading ? "Refreshing diff" : "Refresh diff"), pressed=false, toggle=false, radius=8, testId="diff-refresh", choose=command("diff-refresh", "", "", 0))
      when length(data.diffFiles) > 0
        DiffTool(icon=(data.diffAllCollapsed ? "unfold" : "fold"), label=(data.diffAllCollapsed ? "Expand all files" : "Collapse all files"), pressed=false, toggle=false, radius=8, testId="diff-expand-all", choose=command("diff-view", (data.diffAllCollapsed ? "expand-all" : "collapse-all"), "", 0))
      row padding="0.125rem" gap="0.125rem" border-radius="0.625rem" background-color="light-dark(#e6e6e8, #121212)" role="group" aria-label="Diff layout" flex-shrink=0
        button press=command("diff-view", "layout", "stacked", 0) aria-label="Stacked diff view" testId="diff-stacked" width="2rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(data.diffLayout == "stacked" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
          when data.diffLayout == "stacked"
            DiffGlyph(name="stacked", size=14, color="light-dark(#27272a, #f5f5f5)")
          else
            DiffGlyph(name="stacked", size=14, color="light-dark(#71717a, #818181)")
        button press=command("diff-view", "layout", "split", 0) aria-label="Split diff view" testId="diff-split" width="2rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 background-color=(data.diffLayout == "split" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
          when data.diffLayout == "split"
            DiffGlyph(name="split", size=14, color="light-dark(#27272a, #f5f5f5)")
          else
            DiffGlyph(name="split", size=14, color="light-dark(#71717a, #818181)")
      DiffTool(icon="wrap", label=(data.diffWrap ? "Disable diff line wrapping" : "Enable diff line wrapping"), pressed=data.diffWrap, toggle=true, radius=10, testId="diff-wrap", choose=command("diff-view", "wrap", "", 0))
      DiffTool(icon="pilcrow", label=(data.diffIgnoreWhitespace ? "Show whitespace changes" : "Hide whitespace changes"), pressed=data.diffIgnoreWhitespace, toggle=true, radius=10, testId="diff-whitespace", choose=command("diff-whitespace", "", "", 0))
      when length(data.diffFiles) > 0
        DiffTool(icon="tree", label=(data.diffTree ? "Hide file tree" : "Show file tree"), pressed=data.diffTree, toggle=true, radius=10, testId="diff-tree-toggle", choose=command("diff-view", "tree", "", 0))

component DiffTool
  props
    icon: string
    label: string
    pressed: bool
    toggle: bool
    radius: number
    testId: string
    choose: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    button press=choose hover=setHover aria-label=label testId=testId width="1.75rem" height="1.75rem" padding=0 flex-shrink=0 border-radius=radius border-width=0 background-color=(pressed or hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      when toggle
        DiffGlyph(name=icon, size=14, color="light-dark(#27272a, #f5f5f5)")
      else
        DiffGlyph(name=icon, size=14, color="light-dark(#71717a, #818181)")

component DiffScopeMenu
  props
    data: Snapshot
    command: action
    keyed: number
  // The turn submenu mounts from the data module too: its row lets go of the focus for the submenu's.
  action openTurns
    blur()
    command("diff-view", "menu", "turns", 0)
  // fix-keyboard-focus: Escape belongs to the open menu (Base UI Menu), not to the right panel. The menu scopes
  // the window's shortcuts while it shows (`aria-modal`), so the panel toggle's Escape shortcut stays out; an
  // Escape from either menu reaches this box, which closes the menus and gives the focus back to the trigger.
  action menuKey(k: string, e: KeyboardEvent)
    if k == "Escape"
      preventDefault()
      stopPropagation()
      command("diff-view", "menu", "", 0)
      focus("diff-scope")
  view
    column aria-modal=true key=menuKey position="absolute" left="0.5rem" top="5.09375rem" width="10rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" z-index=30 role="menu" aria-label=`Diff scope: ${data.diffScopeLabel}` testId="diff-scope-menu"
      KeyMenu(menuId="diff-scope-keys", items=concat([KmItem(id="diff-scope-branch", label="Changes"), KmItem(id="diff-scope-unstaged", label="Uncommitted")], (length(data.diffTurns) > 0 ? [KmItem(id="diff-scope-latest", label="Latest turn"), KmItem(id="diff-scope-turns", label="Turn")] : [])), keyed=keyed, gap="0px", modal=false)
        DiffMenuItem(label="Changes", time="", selected=(data.diffScope == "branch"), submenu=false, testId="diff-scope-branch", choose=command("diff-scope", "", "branch", 0))
        DiffMenuItem(label="Uncommitted", time="", selected=(data.diffScope == "unstaged"), submenu=false, testId="diff-scope-unstaged", choose=command("diff-scope", "", "unstaged", 0))
        when length(data.diffTurns) > 0
          DiffMenuItem(label="Latest turn", time="", selected=data.diffLatestSelected, submenu=false, testId="diff-scope-latest", choose=command("diff-scope", "", "latest", 0))
          DiffMenuItem(label="Turn", time="", selected=(data.diffMenu == "turns"), submenu=true, testId="diff-scope-turns", choose=openTurns)
      when data.diffMenu == "turns"
        column position="absolute" left="9.6875rem" top="5.25rem" width="10rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Turn" testId="diff-turn-menu"
          KeyMenu(menuId="diff-turns-keys", items=map(data.diffTurns, (turn) => KmItem(id=`diff-${turn.id}`, label=turn.label)), keyed=1, gap="0px", modal=false)
            each turn in data.diffTurns key=turn.id
              DiffMenuItem(label=turn.label, time=turn.time, selected=turn.selected, submenu=false, testId=`diff-${turn.id}`, choose=command("diff-scope", "", turn.id, 0))

component DiffMenuItem
  props
    label: string
    time: string
    selected: bool
    submenu: bool
    testId: string
    choose: action
  state hovering = false
  state lit = false
  action setHover(over: bool)
    hovering = over
  action focused(on: bool)
    lit = on
  view
    button id=testId press=choose hover=setHover focus=focused(true) blur=focused(false) role="menuitemradio" aria-checked=selected testId=testId aria-label=label width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=0 background-color=(selected ? "light-dark(#27272a14, #f5f5f514)" : hovering or lit ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
      when time != ""
        text time font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)" flex-shrink=0
      when submenu
        ReqIcon(name="chevron-right", size=14, color="light-dark(#71717a, #818181)")

// One virtualized item: a file header, a stacked or split line, a hidden-range separator, a
// comment (saved or draft) under its line, or a header skeleton while a large diff loads.
component DiffRow
  props
    item: DiffItem
    wrap: bool
    command: action
    scheme: string
    // r4-timeline: Settings → Appearance code size (--diffs-font-size; lines stay 20pt).
    size: number
    commentOpen: bool
    draftText: string
    editDraft: action
    beginComment: action
    cancelComment: action
    saveComment: action
  view
    column width="100%"
      when item.kind == "file"
        DiffFileHeader(item=item, command=command, scheme=scheme)
      when item.kind == "pad"
        box width="100%" height="0.5rem"
      when item.kind == "ghost"
        // DiffFileHeaderSkeleton under DiffFileLoadingBoundary.
        row width="100%" height="2rem" padding-left="0.5rem" padding-right="0.75rem" gap="0.5rem" box-sizing="border-box" align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e766, #19191966)" role="status" aria-label="Loading diff…" testId=`diff-ghost-${item.id}`
          box width="1rem" height="1rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
          box width="45%" height="0.75rem" border-radius="0.375rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
      when item.kind == "gap"
        DiffGap(item=item, command=command)
      when item.kind == "note"
        DiffCommentCard(text=item.text, remove=command("diffreview", "delete", item.entry, 0))
      when item.kind == "draft"
        DiffDraftCard(rangeLabel=item.label, text=draftText, edit=editDraft, cancel=cancelComment, save=saveComment)
      when item.kind == "split"
        row width="100%" align-items="stretch"
          DiffCell(tone=item.leftTone, number=item.leftNumber, segments=item.leftSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side="deletions", line=item.leftLine, selected=item.leftSelected, open=commentOpen, command=command, begin=beginComment)
          DiffCell(tone=item.rightTone, number=item.rightNumber, segments=item.rightSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side="additions", line=item.rightLine, selected=item.rightSelected, open=commentOpen, command=command, begin=beginComment)
      when item.kind == "line"
        row width="100%" align-items="stretch"
          DiffCell(tone=item.tone, number=item.number, segments=item.segments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side=item.side, line=item.line, selected=item.selected, open=commentOpen, command=command, begin=beginComment)

// "N unmodified lines": a press opens them from the file's contents (git sources; Pierre's hunk expansion).
component DiffGap
  props
    item: DiffItem
    command: action
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    when item.expandable
      button press=command("diffreview", "expand", item.path, item.line) hover=hover aria-label=`Expand ${item.label}` testId=`diff-gap-${item.path}-${item.line}` width="100%" height="2rem" padding-left="0.75rem" padding-right="0.75rem" gap="0.375rem" box-sizing="border-box" border-width=0 background-color=(hovering ? "light-dark(#e9e9ea, #1c1c1c)" : "light-dark(#f0f0f0, #161616)") display="flex" flex-direction="row" align-items="center"
        DiffGlyph(name="unfold", size=14, color="light-dark(#71717a, #818181)")
        text item.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)"
    else
      row width="100%" height="2rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" align-items="center" background-color="light-dark(#f0f0f0, #161616)" testId=`diff-gap-${item.path}-${item.line}`
        text item.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)"

component DiffFileHeader
  props
    item: DiffItem
    command: action
    scheme: string
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    row width="100%" min-height="2rem" padding-top="0.375rem" padding-bottom="0.375rem" padding-left="0.5rem" padding-right="0.75rem" box-sizing="border-box" align-items="center" gap="0.5rem" hover=setHover position="relative" background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`diff-file-${item.path}`
      when hovering
        box position="absolute" left=0 top=0 bottom=0 width="0.1875rem" background-color="light-dark(#0a0a0a3d, #fafafa3d)"
      // A header whose patch has not arrived keeps the collapsed geometry, its chevron off (DiffPanel renderHeaderPrefix).
      button press=command("diff-view", "file", item.path, 0) disabled=item.unavailable aria-label=`${item.expanded ? "Collapse" : "Expand"} ${item.path}` aria-expanded=item.expanded testId=`diff-toggle-${item.path}` width="1.25rem" height="1.25rem" margin-left="-0.125rem" padding=0 border-radius="0.25rem" border-width=0 opacity=(item.unavailable ? 0.5 : 1) background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        ReqIcon(name=(item.expanded ? "chevron-down" : "chevron-right"), size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      DiffGlyph(name=item.status, size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      button press=command("diff-view", "file", item.path, 0) disabled=item.unavailable aria-label=item.path flex-shrink=1 min-width=0 padding=0 border-width=0 background-color="#00000000"
        text item.name font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1
      button press=command("diff-view", "copy", item.path, 0) aria-label="Copy file path" testId=`diff-copy-${item.path}` width="1.25rem" height="1.25rem" padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        DiffGlyph(name="copy", size=12, color="light-dark(#71717a, #818181)")
      // DiffFileStatus: Retry after a failed read; "Partial diff preview" for a file past the per-file cap.
      when item.error or item.partial
        button press=command("diffreview", (item.error ? "retry" : "partial"), item.path, 0) aria-label=(item.error ? "Retry loading diff" : "Partial diff preview") title=(item.error ? "Retry loading diff" : "This file is too large to show in full. Counts include all changes.") testId=`diff-status-${item.path}` width="1rem" height="1rem" padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          DiffGlyph(name=(item.error ? "rotate-cw" : "info"), size=12, color="light-dark(#71717a, #818181)")
      box flex=1
      row gap="0.5rem" align-items="center" flex-shrink=0
        when item.deletions > 0
          text `-${item.deletions}` font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="0.6875rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "del")
        when item.additions > 0
          text `+${item.additions}` font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="0.6875rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "add")

// The gutter carries the old (deletion) or new line number and a 4pt change bar. A press on the
// number selects the line (Shift extends the selection); the gutter's "+" opens a comment on the
// selection or the line (Pierre's line selection and gutter utility, off while a draft is open).
component DiffCell
  props
    tone: string
    number: string
    segments: list<DiffSegment>
    gutter: number
    size: number
    wrap: bool
    scheme: string
    path: string
    side: string
    line: number
    selected: bool
    open: bool
    command: action
    begin: action
  state hovering = false
  action hover(over: bool)
    hovering = over
  action pick(e: MouseEvent)
    if not open and line > 0
      command("diffreview", (e.shiftKey ? `line:${side}:shift` : `line:${side}`), path, line)
  action comment
    if not open and line > 0
      begin(path, side, line)
  view
    row flex=1 min-width=0 align-items="stretch" hover=hover position="relative" background-color=(selected ? "light-dark(#fef3c7, #3a3112)" : tone == "deletion" ? diffInk(scheme, "del-row") : tone == "addition" ? diffInk(scheme, "add-row") : tone == "empty" ? "light-dark(#e4e4e4, #222222)" : "light-dark(#fcfcfc, #0a0a0a)")
      box width=((gutter - 2) * size / 13 + 2) flex-shrink=0 position="relative" padding-right=(7.83 * size / 13 + 2) box-sizing="border-box" press=pick testId=`diff-line-${path}-${side}-${line}` aria-label=(line > 0 ? `Select line ${line}` : "") background-color=(selected ? "light-dark(#fde68a, #4a3d14)" : tone == "deletion" ? diffInk(scheme, "del-gutter") : tone == "addition" ? diffInk(scheme, "add-gutter") : "#00000000")
        // Additions carry a solid bar; deletions a 1pt-striped one (@pierre/diffs bars).
        when tone == "addition"
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" background-color=diffInk(scheme, "add")
        when tone == "deletion"
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" overflow="hidden" background-color=diffInk(scheme, "del-bar")
            svg width="0.25rem" height="25rem" aria-hidden=true
              defs
                pattern id="diff-deletion-stripes" patternUnits="userSpaceOnUse" width=4 height=2
                  rect x=0 y=0 width=4 height=1 fill=diffInk(scheme, "del")
              rect x=0 y=0 width=4 height=400 fill="url(#diff-deletion-stripes)"
        text number width="100%" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" text-align="right" font-variant-numeric="tabular-nums" color=(tone == "deletion" ? diffInk(scheme, "del") : tone == "addition" ? diffInk(scheme, "add") : "light-dark(#565656, #9d9d9d)")
      text flex=1 min-width=0 padding-left=(7.83 * size / 13) padding-right=(7.83 * size / 13) box-sizing="border-box" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" white-space=(wrap ? "pre-wrap" : "pre") overflow-wrap=(wrap ? "anywhere" : "normal") color="light-dark(#0a0a0a, #fafafa)"
        each segment in segments key=segment.id
          text segment.text color=synColor(segment.syntax) font-style=synSlant(segment.syntax)
      when line > 0 and not open
        button press=comment aria-label=`Comment on line ${line}` testId=`diff-comment-${path}-${side}-${line}` position="absolute" left="0.25rem" top="0.125rem" width="1rem" height="1rem" padding=0 border-radius="0.25rem" border-width=0 opacity=(hovering ? 1 : 0) background-color="light-dark(#1b4ed8, #346bf1)" display="flex" flex-direction="row" align-items="center" justify-content="center"
          DiffGlyph(name="plus", size=12, color="#ffffff")
