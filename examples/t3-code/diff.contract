// The changes side panel (wide) and sheet (narrow), measured against T3's served
// right panel: DiffPanel header/toolbar, @pierre/diffs file headers and rows.
// Every patch comes from the server's diff APIs; nothing here invents content.
use Snapshot from "./shapes.contract"
use DiffItem from "./shapes.contract"
use DiffSegment from "./shapes.contract"
use DiffFile from "./shapes.contract"
use ReqIcon from "./requests.contract"
use diffInk from "./settings-appearance-look.contract"
use synColor from "./markdown.contract"
use ShellView from "./shell-shapes.contract"
use ShellSurface from "./shell-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use R4PanelHeader from "./r4-surfaces.contract"

// Toolbar and file glyphs not in ReqIcon: lucide (24 grid) and @pierre/diffs (16 grid).
component DiffGlyph
  props
    name: string
    size: number
    color: string
  view
    when name == "file-diff" or name == "panel-right" or name == "fold" or name == "unfold" or name == "wrap" or name == "pilcrow" or name == "tree" or name == "copy" or name == "refresh" or name == "stacked" or name == "split"
      svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
        when name == "file-diff"
          path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z"
          path d="M9 10h6M12 13V7M9 17h6"
        when name == "stacked"
          rect width=18 height=18 x=3 y=3 rx=2
          path d="M21 9H3M21 15H3"
        when name == "split"
          rect width=18 height=18 x=3 y=3 rx=2
          path d="M12 3v18"
        when name == "panel-right"
          rect width=18 height=18 x=3 y=3 rx=2
          path d="M15 3v18"
        when name == "fold"
          path d="m7 20 5-5 5 5M7 4l5 5 5-5"
        when name == "unfold"
          path d="m7 15 5 5 5-5M7 9l5-5 5 5"
        when name == "wrap"
          path d="m16 16-3 3 3 3M3 12h14.5a1 1 0 0 1 0 7H13M3 19h6M3 5h18"
        when name == "pilcrow"
          path d="M13 4v16M17 4v16M19 4H9.5a4.5 4.5 0 0 0 0 9H13"
        when name == "tree"
          path d="M20 10a1 1 0 0 0 1-1V6a1 1 0 0 0-1-1h-2.5a1 1 0 0 1-.8-.4l-.9-1.2A1 1 0 0 0 15 3h-2a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"
          path d="M20 21a1 1 0 0 0 1-1v-3a1 1 0 0 0-1-1h-2.9a1 1 0 0 1-.88-.55l-.42-.85a1 1 0 0 0-.92-.6H13a1 1 0 0 0-1 1v5a1 1 0 0 0 1 1Z"
          path d="M3 5a2 2 0 0 0 2 2h3M3 3v13a2 2 0 0 0 2 2h3"
        when name == "copy"
          rect width=14 height=14 x=8 y=8 rx=2 ry=2
          path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
        when name == "refresh"
          path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8M21 3v5h-5M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16M8 16H3v5"
    else
      svg width=size height=size viewBox="0 0 16 16" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
        when name == "modified"
          path d="M1.5 8c0 1.613.088 2.806.288 3.704.196.88.478 1.381.802 1.706s.826.607 1.706.802c.898.2 2.091.288 3.704.288s2.806-.088 3.704-.288c.88-.195 1.381-.478 1.706-.802s.607-.826.802-1.706c.2-.898.288-2.091.288-3.704s-.088-2.806-.288-3.704c-.195-.88-.478-1.381-.802-1.706s-.826-.606-1.706-.802C10.806 1.588 9.613 1.5 8 1.5s-2.806.088-3.704.288c-.88.196-1.381.478-1.706.802s-.606.826-.802 1.706C1.588 5.194 1.5 6.387 1.5 8M0 8c0-6.588 1.412-8 8-8s8 1.412 8 8-1.412 8-8 8-8-1.412-8-8m8 3a3 3 0 1 0 0-6 3 3 0 0 0 0 6"
        when name == "deleted" or name == "added" or name == "renamed"
          path d="M1.788 4.296c.196-.88.478-1.381.802-1.706s.826-.606 1.706-.802C5.194 1.588 6.387 1.5 8 1.5s2.806.088 3.704.288c.88.196 1.381.478 1.706.802s.607.826.802 1.706c.2.898.288 2.091.288 3.704s-.088 2.806-.288 3.704c-.195.88-.478 1.381-.802 1.706s-.826.607-1.706.802c-.898.2-2.091.288-3.704.288s-2.806-.088-3.704-.288c-.88-.195-1.381-.478-1.706-.802s-.606-.826-.802-1.706C1.588 10.806 1.5 9.613 1.5 8s.088-2.806.288-3.704M8 0C1.412 0 0 1.412 0 8s1.412 8 8 8 8-1.412 8-8-1.412-8-8-8"
          when name == "deleted"
            path d="M4 8a.75.75 0 0 1 .75-.75h6.5a.75.75 0 0 1 0 1.5h-6.5A.75.75 0 0 1 4 8"
          when name == "added"
            path d="M8 4a.75.75 0 0 1 .75.75v2.5h2.5a.75.75 0 0 1 0 1.5h-2.5v2.5a.75.75 0 0 1-1.5 0v-2.5h-2.5a.75.75 0 0 1 0-1.5h2.5v-2.5A.75.75 0 0 1 8 4"
          when name == "renamed"
            path d="M8.47 4.22a.75.75 0 0 0 0 1.06l1.97 1.97H3.75a.75.75 0 0 0 0 1.5h6.69l-1.97 1.97a.75.75 0 1 0 1.06 1.06l3.25-3.25a.75.75 0 0 0 0-1.06L9.53 4.22a.75.75 0 0 0-1.06 0"
        when name == "markdown"
          path d="M1 12V4h2l2 2.5L7 4h2v8H7V7.5l-2 2-2-2V12zm9-3 3 3.5L16 9h-2V4h-2v5z"
        when name == "file"
          path d="M8 1v3a3 3 0 0 0 3 3h3v5.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 12.5v-9A2.5 2.5 0 0 1 4.5 1z" opacity=0.4
          path d="M9.5 1a.5.5 0 0 1 .354.146l4 4A.5.5 0 0 1 14 5.5V6h-3a2 2 0 0 1-2-2V1z"

// Rebuilt on a scheme change so native SVG glyphs resolve the new light-dark() side.
component DiffPanel
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    scheme: string
    detailsOpen: bool
    details: action
    local: action
  view
    when scheme == "dark"
      DiffPanelBody(data=data, shell=shell, command=command, close=close, ui=ui, maximized=maximized, resize=resize, finishResize=finishResize, sheet=sheet, detailsOpen=detailsOpen, details=details, local=local)
    else
      DiffPanelBody(data=data, shell=shell, command=command, close=close, ui=ui, maximized=maximized, resize=resize, finishResize=finishResize, sheet=sheet, detailsOpen=detailsOpen, details=details, local=local)

// DiffPanelShell's header: the Diff tab and "Add panel surface", then
// Maximize panel, the terminal drawer and the right panel toggle; an inline
// panel resizes from an 8pt handle over its left edge (RightPanelResizeHandle).
component DiffPanelBody
  props
    data: Snapshot
    shell: ShellView
    command: action
    close: action
    ui: action
    maximized: bool
    resize: action
    finishResize: action
    sheet: bool
    detailsOpen: bool
    details: action
    local: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  view
    column height="100%" width="100%" min-width=0 position="relative" box-sizing="border-box" background-color=(sheet ? "light-dark(#ffffff, #0a0a0a)" : "light-dark(#fcfcfc, #0a0a0a)") border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #191919)" box-shadow=(sheet ? "0 10px 15px -3px #0000000d, 0 4px 6px -4px #0000000d" : "none") testId="diff-panel" role=(sheet ? "dialog" : "region") aria-label="Diff"
      // r4-surfaces: the shared tab bar (every open surface, "+", the layout controls; the details toggle in a sheet); DiffPanel already rebuilds per scheme.
      R4PanelHeader(panel=shell.panel, surfaces=shell.surfaces, sheet=sheet, maximized=maximized, detailsOpen=detailsOpen, keyThreadPanel=shell.keyThreadPanel, keyRightPanel=shell.keyRightPanel, still=false, ui=ui, details=details, local=local, scheme="")
      // A sheet's toolbar sits 6pt lower over the same content top (served reference at 840).
      column margin-top=(sheet ? 6 : 0)
        DiffToolbar(data=data, command=command)
      row flex=1 min-height=0 width="100%" margin-top=(sheet ? 6 : 12)
        column flex=1 min-width=0 min-height=0
          when data.diffError != ""
            text data.diffError font-size=11 line-height="16px" padding-left=12 padding-right=12 padding-bottom=8 color="light-dark(#fb2c36cc, #fb414acc)" testId="diff-error"
          when data.diffTruncated
            text "This preview exceeds the size limit. Changes shown are incomplete." font-size=11 line-height="16px" padding-left=12 padding-right=12 padding-top=6 padding-bottom=6 flex-shrink=0 background-color="light-dark(#f4f4f566, #1c1c1c66)" color="light-dark(#71717a, #818181)"
          when data.diffLoading and length(data.diffItems) == 0
            column flex=1 padding-top=4 gap=8 role="status" aria-label=data.diffLoadingLabel testId="diff-loading"
              row height=32 padding-left=8 padding-right=12 gap=8 align-items="center"
                box width=10 height=10 border-radius=3 background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width=20 height=20 border-radius=6 background-color="light-dark(#e4e4e7, #1c1c1c)"
                box width="45%" height=12 border-radius=6 background-color="light-dark(#e4e4e7, #1c1c1c)"
              column padding-left=12 padding-right=12 gap=8
                box width="66%" height=10 border-radius=5 background-color="light-dark(#f0f0f1, #161616)"
                box width="80%" height=10 border-radius=5 background-color="light-dark(#f0f0f1, #161616)"
                box width="60%" height=10 border-radius=5 background-color="light-dark(#f0f0f1, #161616)"
          else
            when data.diffEmpty and data.diffError == ""
              column flex=1 align-items="center" justify-content="center" padding-left=12 padding-right=12
                text data.diffEmptyLabel font-size=12 line-height="16px" text-align="center" color="light-dark(#71717ab3, #818181b3)" testId="diff-empty"
            else
              list virtualized=true flex=1 min-height=0 width="100%" testId="diff-content"
                each item in data.diffItems key=item.id
                  DiffRow(item=item, wrap=data.diffWrap, command=command, scheme=data.look.diff, size=data.look.codeSize)
        when data.diffTree and length(data.diffFiles) > 0
          column width=216 flex-shrink=0 height="100%" padding-left=12 padding-right=8 box-sizing="border-box" border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #191919)" role="complementary" aria-label="Files" testId="diff-tree"
            row height=24 align-items="center" margin-bottom=16 padding-right=0
              text "Files" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" flex=1
              text `${length(data.diffFiles)}` font-size=12 line-height="16px" color="light-dark(#71717a, #818181)"
            each file in data.diffFiles key=file.id
              DiffTreeRow(file=file, command=command, scheme=data.look.diff)
      // The rail sits inside the panel and above its body: an overflowing child is not hit-testable natively.
      when not sheet and not maximized
        box position="absolute" top=0 bottom=0 left=0 width=6 z-index=28 cursor="col-resize" touch-action="none" pan=resize panrelease=finishResize hover=hover("resize") role="separator" aria-orientation="vertical" aria-label="Resize diff panel" testId="diff-resize"
          box position="absolute" top=0 bottom=0 left=0 width=1 pointer-events="none" background-color=(hovered == "resize" ? "light-dark(#e4e4e7, #ffffff1a)" : "#00000000")
      when data.diffMenu != ""
        box position="absolute" left=-3000 right=-3000 top=-3000 bottom=-3000 z-index=29 press=command("diff-view", "menu", "", 0) aria-label="Close diff scope menu" aria-keyshortcuts="Escape"
        DiffScopeMenu(data=data, command=command)

// One "Add panel surface" row: 28pt, 16pt glyph at 80%, label, letter key.
component AddSurfaceItem
  props
    surface: ShellSurface
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose popovertarget="diff-add-surface" popovertargetaction="hide" hover=hover disabled=(not surface.available) role="menuitem" aria-label=`${surface.label} ${surface.shortcut}` testId=`add-surface-${surface.id}` display="flex" flex-direction="row" align-items="center" gap=8 width="100%" height=28 padding-left=8 padding-right=8 box-sizing="border-box" border-width=0 border-radius=6 opacity=(surface.available ? 1 : 0.64) background-color=(hovered and surface.available ? "light-dark(#27272914, #f5f5f514)" : "#00000000")
      box width=16 height=16 flex-shrink=0 opacity=0.8
        ShellIcon(name=surface.icon, size=16, color="light-dark(#71717b, #818181)")
      text surface.label flex=1 min-width=0 white-space="nowrap" text-align="left" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
      text surface.shortcut flex-shrink=0 font-size=12 font-weight=500 line-height="16px" letter-spacing=1.2 color="light-dark(#71717b, #818181)"

component DiffToolbar
  props
    data: Snapshot
    command: action
  view
    row height=28 flex-shrink=0 padding-left=8 padding-right=8 box-sizing="border-box" align-items="center" gap=4
      button press=command("diff-view", "menu", "scope", 0) aria-label=`Diff scope: ${data.diffScopeLabel}` aria-expanded=(data.diffMenu != "") testId="diff-scope" height=24 padding-left=7 padding-right=7 gap=4 border-radius=8 border-width=0 background-color="light-dark(#fafafa, #111111)" display="flex" flex-direction="row" align-items="center" min-width=0 flex-shrink=1
        text data.diffScopeLabel font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0
        ReqIcon(name="chevron-down", size=14, color="light-dark(#27272a, #f5f5f5)")
      box flex=1
      row gap=4 align-items="center" flex-shrink=0 margin-right=4 role="group" aria-label=`${data.diffAdditions} additions, ${data.diffDeletions} deletions`
        text `+${data.diffAdditions}` font-family="ui-monospace" font-size=11 letter-spacing=-0.17 line-height="16px" color=diffInk(data.look.diff, "add-count")
        text `-${data.diffDeletions}` font-family="ui-monospace" font-size=11 letter-spacing=-0.17 line-height="16px" color=diffInk(data.look.diff, "del-count")
      when data.diffCanRefresh
        DiffTool(icon="refresh", label=(data.diffLoading ? "Refreshing diff" : "Refresh diff"), pressed=false, toggle=false, radius=8, testId="diff-refresh", choose=command("diff-refresh", "", "", 0))
      DiffTool(icon=(data.diffAllCollapsed ? "unfold" : "fold"), label=(data.diffAllCollapsed ? "Expand all files" : "Collapse all files"), pressed=false, toggle=false, radius=8, testId="diff-expand-all", choose=command("diff-view", (data.diffAllCollapsed ? "expand-all" : "collapse-all"), "", 0))
      row padding=2 gap=2 border-radius=10 background-color="light-dark(#e6e6e8, #121212)" role="group" aria-label="Diff layout" flex-shrink=0
        button press=command("diff-view", "layout", "stacked", 0) aria-label="Stacked diff view" testId="diff-stacked" width=32 height=24 padding=0 border-radius=8 border-width=0 background-color=(data.diffLayout == "stacked" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
          when data.diffLayout == "stacked"
            DiffGlyph(name="stacked", size=14, color="light-dark(#27272a, #f5f5f5)")
          else
            DiffGlyph(name="stacked", size=14, color="light-dark(#71717a, #818181)")
        button press=command("diff-view", "layout", "split", 0) aria-label="Split diff view" testId="diff-split" width=32 height=24 padding=0 border-radius=8 border-width=0 background-color=(data.diffLayout == "split" ? "light-dark(#fcfcfc, #202020)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
          when data.diffLayout == "split"
            DiffGlyph(name="split", size=14, color="light-dark(#27272a, #f5f5f5)")
          else
            DiffGlyph(name="split", size=14, color="light-dark(#71717a, #818181)")
      DiffTool(icon="wrap", label=(data.diffWrap ? "Disable diff line wrapping" : "Enable diff line wrapping"), pressed=data.diffWrap, toggle=true, radius=10, testId="diff-wrap", choose=command("diff-view", "wrap", "", 0))
      DiffTool(icon="pilcrow", label=(data.diffIgnoreWhitespace ? "Show whitespace changes" : "Hide whitespace changes"), pressed=data.diffIgnoreWhitespace, toggle=true, radius=10, testId="diff-whitespace", choose=command("diff-whitespace", "", "", 0))
      DiffTool(icon="tree", label=(data.diffTree ? "Hide file tree" : "Show file tree"), pressed=data.diffTree, toggle=true, radius=10, testId="diff-tree-toggle", choose=command("diff-view", "tree", "", 0))

component DiffTool
  props
    icon: string
    label: string
    pressed: bool
    toggle: bool
    radius: number
    testId: string
    choose: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    button press=choose hover=setHover aria-label=label testId=testId width=28 height=28 padding=0 flex-shrink=0 border-radius=radius border-width=0 background-color=(pressed or hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
      when toggle
        DiffGlyph(name=icon, size=14, color="light-dark(#27272a, #f5f5f5)")
      else
        DiffGlyph(name=icon, size=14, color="light-dark(#71717a, #818181)")

component DiffScopeMenu
  props
    data: Snapshot
    command: action
  view
    column position="absolute" left=8 top=81.5 width=160 padding=4 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" z-index=30 role="menu" aria-label=`Diff scope: ${data.diffScopeLabel}` testId="diff-scope-menu"
      DiffMenuItem(label="Changes", time="", selected=(data.diffScope == "branch"), submenu=false, testId="diff-scope-branch", choose=command("diff-scope", "", "branch", 0))
      DiffMenuItem(label="Uncommitted", time="", selected=(data.diffScope == "unstaged"), submenu=false, testId="diff-scope-unstaged", choose=command("diff-scope", "", "unstaged", 0))
      when length(data.diffTurns) > 0
        DiffMenuItem(label="Latest turn", time="", selected=data.diffLatestSelected, submenu=false, testId="diff-scope-latest", choose=command("diff-scope", "", "latest", 0))
        DiffMenuItem(label="Turn", time="", selected=(data.diffMenu == "turns"), submenu=true, testId="diff-scope-turns", choose=command("diff-view", "menu", "turns", 0))
      when data.diffMenu == "turns"
        column position="absolute" left=155 top=84 width=160 padding=4 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e9e9ea, #292929)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Turn" testId="diff-turn-menu"
          each turn in data.diffTurns key=turn.id
            DiffMenuItem(label=turn.label, time=turn.time, selected=turn.selected, submenu=false, testId=`diff-${turn.id}`, choose=command("diff-scope", "", turn.id, 0))

component DiffMenuItem
  props
    label: string
    time: string
    selected: bool
    submenu: bool
    testId: string
    choose: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    button press=choose hover=setHover role="menuitemradio" aria-checked=selected testId=testId aria-label=label width="100%" height=28 padding-left=8 padding-right=8 gap=8 box-sizing="border-box" border-radius=6 border-width=0 background-color=(selected ? "light-dark(#27272a14, #f5f5f514)" : hovering ? "light-dark(#f4f4f5, #1c1c1c)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 text-align="left" line-clamp=1
      when time != ""
        text time font-size=12 line-height="16px" color="light-dark(#71717a, #818181)" flex-shrink=0
      when submenu
        ReqIcon(name="chevron-right", size=14, color="light-dark(#71717a, #818181)")

// One virtualized item: a file header, a stacked or split line, or a hidden-range note.
component DiffRow
  props
    item: DiffItem
    wrap: bool
    command: action
    scheme: string
    // r4-timeline: Settings → Appearance code size (--diffs-font-size; lines stay 20pt).
    size: number
  view
    column width="100%"
      when item.kind == "file"
        DiffFileHeader(item=item, command=command, scheme=scheme)
      when item.kind == "pad"
        box width="100%" height=8
      when item.kind != "file" and item.kind != "pad"
        when item.kind == "gap"
          row width="100%" height=32 padding-left=12 padding-right=12 box-sizing="border-box" align-items="center" background-color="light-dark(#f0f0f0, #161616)"
            text item.label font-size=12 line-height="16px" color="light-dark(#71717a, #818181)"
        else
          when item.kind == "split"
            row width="100%" align-items="stretch"
              DiffCell(tone=item.leftTone, number=item.leftNumber, segments=item.leftSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size)
              DiffCell(tone=item.rightTone, number=item.rightNumber, segments=item.rightSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size)
          else
            row width="100%" align-items="stretch"
              DiffCell(tone=item.tone, number=item.number, segments=item.segments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size)

component DiffFileHeader
  props
    item: DiffItem
    command: action
    scheme: string
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    row width="100%" min-height=32 padding-top=6 padding-bottom=6 padding-left=8 padding-right=12 box-sizing="border-box" align-items="center" gap=8 hover=setHover position="relative" background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`diff-file-${item.path}`
      when hovering
        box position="absolute" left=0 top=0 bottom=0 width=3 background-color="light-dark(#0a0a0a3d, #fafafa3d)"
      button press=command("diff-view", "file", item.path, 0) aria-label=`${item.expanded ? "Collapse" : "Expand"} ${item.path}` aria-expanded=item.expanded testId=`diff-toggle-${item.path}` width=20 height=20 margin-left=-2 padding=0 border-radius=4 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        ReqIcon(name=(item.expanded ? "chevron-down" : "chevron-right"), size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      DiffGlyph(name=item.status, size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      button press=command("diff-view", "file", item.path, 0) aria-label=item.path flex-shrink=1 min-width=0 padding=0 border-width=0 background-color="#00000000"
        text item.name font-size=12 line-height="16px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1
      button press=command("diff-view", "copy", item.path, 0) aria-label="Copy file path" testId=`diff-copy-${item.path}` width=20 height=20 padding=0 border-radius=4 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
        DiffGlyph(name="copy", size=12, color="light-dark(#71717a, #818181)")
      box flex=1
      row gap=8 align-items="center" flex-shrink=0
        when item.deletions > 0
          text `-${item.deletions}` font-family="ui-monospace" font-size=11 letter-spacing=-0.17 line-height="11px" font-variant-numeric="tabular-nums" color=diffInk(scheme, "del")
        when item.additions > 0
          text `+${item.additions}` font-family="ui-monospace" font-size=11 letter-spacing=-0.17 line-height="11px" font-variant-numeric="tabular-nums" color=diffInk(scheme, "add")

// The gutter carries the old (deletion) or new line number and a 4pt change bar.
component DiffCell
  props
    tone: string
    number: string
    segments: list<DiffSegment>
    gutter: number
    size: number
    wrap: bool
    scheme: string
  view
    row flex=1 min-width=0 align-items="stretch" background-color=(tone == "deletion" ? diffInk(scheme, "del-row") : tone == "addition" ? diffInk(scheme, "add-row") : tone == "empty" ? "light-dark(#e4e4e4, #222222)" : "light-dark(#fcfcfc, #0a0a0a)")
      box width=((gutter - 2) * size / 13 + 2) flex-shrink=0 position="relative" padding-right=(7.83 * size / 13 + 2) box-sizing="border-box" background-color=(tone == "deletion" ? diffInk(scheme, "del-gutter") : tone == "addition" ? diffInk(scheme, "add-gutter") : "#00000000")
        // Additions carry a solid bar; deletions a 1pt-striped one (@pierre/diffs bars).
        when tone == "addition"
          box position="absolute" left=0 top=0 bottom=0 width=4 background-color=diffInk(scheme, "add")
        when tone == "deletion"
          box position="absolute" left=0 top=0 bottom=0 width=4 overflow="hidden" background-color=diffInk(scheme, "del-bar")
            svg width=4 height=400 aria-hidden=true
              defs
                pattern id="diff-deletion-stripes" patternUnits="userSpaceOnUse" width=4 height=2
                  rect x=0 y=0 width=4 height=1 fill=diffInk(scheme, "del")
              rect x=0 y=0 width=4 height=400 fill="url(#diff-deletion-stripes)"
        text number width="100%" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" text-align="right" font-variant-numeric="tabular-nums" color=(tone == "deletion" ? diffInk(scheme, "del") : tone == "addition" ? diffInk(scheme, "add") : "light-dark(#565656, #9d9d9d)")
      text flex=1 min-width=0 padding-left=(7.83 * size / 13) padding-right=(7.83 * size / 13) box-sizing="border-box" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" white-space=(wrap ? "pre-wrap" : "pre") overflow-wrap=(wrap ? "anywhere" : "normal") color="light-dark(#0a0a0a, #fafafa)"
        each segment in segments key=segment.id
          text segment.text color=synColor(segment.syntax) background-color=(segment.mark ? (tone == "deletion" ? diffInk(scheme, "del-mark") : diffInk(scheme, "add-mark")) : "#00000000")

component DiffTreeRow
  props
    file: DiffFile
    command: action
    scheme: string
  view
    button press=command("diff-view", "reveal", file.path, 0) aria-label=file.path testId=`diff-tree-${file.path}` width="100%" height=24 padding-left=10 padding-right=12 gap=6 box-sizing="border-box" border-radius=6 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
      DiffGlyph(name=(file.markdown ? "markdown" : "file"), size=16, color=(file.markdown ? "light-dark(#16a34a, #4ade80)" : "light-dark(#71717a, #818181)"))
      text file.name font-size=12 line-height="16px" flex=1 min-width=0 line-clamp=1 text-align="left" color=(file.status == "deleted" ? diffInk(scheme, "del-text") : file.status == "added" ? diffInk(scheme, "add-text") : "light-dark(#27272a, #f5f5f5)")
      text file.letter font-size=12 font-weight=600 line-height="16px" color=(file.status == "deleted" ? diffInk(scheme, "del-text") : file.status == "added" ? diffInk(scheme, "add-text") : "light-dark(#d08700, #fdc700)")
