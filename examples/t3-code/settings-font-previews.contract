// Settings › Appearance › Typography samples, adapted from T3 Code (MIT, see LICENSE-T3):
// SettingsFontPreviews.tsx. The prompt sample draws the composer's own chips (ContextChip:
// the skill's cube and a file mention's Pierre icon, in em of the prompt size, with the
// palettes T3ComposerStyler paints) and wraps word by word as the editor does. The code
// sample is the diff panel's file diff for the sample patch (settings-font-previews.ts):
// @pierre/diffs' default header (change icon, path, counts) and unified rows with their
// gutter bars, syntax colours and word-alt emphasis.
use CorePalette from "./settings-core.contract"
use FontDiffLine, FontDiffPreview from "./shapes.contract"
use DiffGlyph from "./diff-glyphs.contract"
use diffInk from "./settings-appearance-look.contract"
use synColor from "./markdown.contract"
use synSlant from "./markdown.contract"
use TimelineIcon from "./timeline-icons.contract"
use FileTypeIcon from "./timeline-files.contract"

// PromptFontPreview: the composer sample in the prompt family and size (leading-relaxed),
// in its rounded-lg bordered bg-background box (px-3 py-2, min-h-14).
component FontPromptPreview
  props
    family: string
    size: number
    pal: CorePalette
  view
    column width="100%" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=pal.border background-color=pal.thumb box-sizing="border-box" aria-label="Prompt font preview" testId="prompt-font-preview"
      row width="100%" min-height="3.5rem" flex-wrap="wrap" align-items="center" align-content="flex-start" column-gap=(size * 0.28) font-family=(family == "system-ui" ? "system-ui" : family == "ui-sans-serif" ? "ui-sans-serif" : family == "sans-serif" ? "sans-serif" : family == "ui-serif" ? "ui-serif" : family == "serif" ? "serif" : family == "ui-monospace" ? "ui-monospace" : family == "monospace" ? "monospace" : "ui-rounded")
        PromptWord(word="Use", size=size, pal=pal)
        PromptChip(kind="skill", icon="", label="Frontend Design", tip="Skill Frontend Design", chipId="skill", size=size)
        each word in split("to fix the flaky test in", " ") key=word
          PromptWord(word=word, size=size, pal=pal)
        PromptChip(kind="mention", icon="typescript", label="surface.test.ts", tip="Preview apps/web/src/terminal/ghostty/surface.test.ts", chipId="file-1", size=size)
        each word in split("and align the header with", " ") key=word
          PromptWord(word=word, size=size, pal=pal)
        PromptChip(kind="mention", icon="react", label="SettingsPanels.tsx", tip="Preview apps/web/src/components/settings/SettingsPanels.tsx", chipId="file-2", size=size)
        each word in split("before shipping.", " ") key=word
          PromptWord(word=word, size=size, pal=pal)
component PromptWord
  props
    word: string
    size: number
    pal: CorePalette
  view
    text word font-size=size line-height=1.625 white-space="nowrap" color=pal.text
// ContextChip (h 1.41em, px 0.5em, gap 0.33em, rounded 0.5em, 0.86em medium, 1.17em icon) at
// the prompt size, middle-aligned on the prompt's line: kind "skill" (oklch hue 322) or
// "mention" (hue 215), coloured as the composer's underlay paints them.
component PromptChip
  props
    kind: string
    icon: string
    label: string
    tip: string
    chipId: string
    size: number
  derive font = size * 0.86
  derive ink = kind == "skill" ? "light-dark(#433448, #e7d4ea)" : "light-dark(#2c3e45, #cbe0e6)"
  view
    row height=(size * 1.625) flex-shrink=0 align-items="center"
      row height=(font * 1.41) padding-left=(font * 0.5) padding-right=(font * 0.5) gap=(font * 0.33) box-sizing="border-box" align-items="center" border-radius=(font * 0.5) border-width=1 border-style="solid" border-color=(kind == "skill" ? "light-dark(#d4b8db, #ba72c661)" : "light-dark(#a9cad5, #39a1b861)") background-color=(kind == "skill" ? "#b261be1c" : "#0096af1c") aria-label=tip testId=`prompt-font-preview-chip-${chipId}`
        when kind == "skill"
          TimelineIcon(name="skill", size=(font * 1.17), color=ink)
        else
          FileTypeIcon(token=icon, size=(font * 1.17))
        text label font-size=font font-weight=500 line-height=1.25 white-space="nowrap" color=ink

// CodeFontPreview: the sample patch's file diff. The header is @pierre/diffs' default
// (16pt side padding, 1lh + 3 gaps tall, the change icon, the path in the interface font,
// the counts in the code font); the rows are the Diff panel's (diff.contract DiffCell):
// 20pt lines, a 4ch gutter with its bar, and emphasis behind the changed words.
component FontCodePreview
  props
    preview: FontDiffPreview
    family: string
    size: number
    pal: CorePalette
  view
    column width="100%" margin-top="0.25rem" margin-bottom="0.5rem" background-color="light-dark(#fcfcfc, #0a0a0a)" aria-label="Code font preview" testId="code-font-preview"
      row width="100%" min-height="44px" padding-left="16px" padding-right="16px" gap="8px" box-sizing="border-box" align-items="center" justify-content="space-between" testId="code-font-preview-header"
        row gap="8px" align-items="center" min-width=0
          DiffGlyph(name=preview.status, size=16, color=(preview.status == "deleted" ? diffInk(preview.scheme, "del") : preview.status == "added" ? diffInk(preview.scheme, "add") : "#009fff"))
          text preview.path font-size=size line-height="20px" color="light-dark(#0a0a0a, #fafafa)" white-space="nowrap" min-width=0 line-clamp=1
        row gap=(7.83 * size / 13) align-items="center" flex-shrink=0 font-family=(family == "system-ui" ? "system-ui" : family == "ui-sans-serif" ? "ui-sans-serif" : family == "sans-serif" ? "sans-serif" : family == "ui-serif" ? "ui-serif" : family == "serif" ? "serif" : family == "ui-monospace" ? "ui-monospace" : family == "monospace" ? "monospace" : "ui-rounded")
          when preview.deletions > 0
            text `-${preview.deletions}` font-size=size line-height="20px" color=diffInk(preview.scheme, "del")
          when preview.additions > 0
            text `+${preview.additions}` font-size=size line-height="20px" color=diffInk(preview.scheme, "add")
      column width="100%" padding-bottom="8px" box-sizing="border-box" font-family=(family == "system-ui" ? "system-ui" : family == "ui-sans-serif" ? "ui-sans-serif" : family == "sans-serif" ? "sans-serif" : family == "ui-serif" ? "ui-serif" : family == "serif" ? "serif" : family == "ui-monospace" ? "ui-monospace" : family == "monospace" ? "monospace" : "ui-rounded")
        each line in preview.lines key=line.id
          FontDiffRow(line=line, scheme=preview.scheme, size=size)
component FontDiffRow
  props
    line: FontDiffLine
    scheme: string
    size: number
  view
    row width="100%" align-items="stretch" background-color=(line.tone == "deletion" ? diffInk(scheme, "del-row") : line.tone == "addition" ? diffInk(scheme, "add-row") : "light-dark(#fcfcfc, #0a0a0a)") testId=`code-font-preview-${line.tone}-${line.number}`
      box width=(4 * 7.83 * size / 13 + 2) flex-shrink=0 position="relative" padding-right=(7.83 * size / 13 + 2) box-sizing="border-box" background-color=(line.tone == "deletion" ? diffInk(scheme, "del-gutter") : line.tone == "addition" ? diffInk(scheme, "add-gutter") : "#00000000")
        // Additions carry a solid bar; deletions a 1pt-striped one (@pierre/diffs bars).
        when line.tone == "addition"
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" background-color=diffInk(scheme, "add")
        when line.tone == "deletion"
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" overflow="hidden" background-color=diffInk(scheme, "del-bar")
            svg width="0.25rem" height="20px" aria-hidden=true
              defs
                pattern id="font-preview-deletion-stripes" patternUnits="userSpaceOnUse" width=4 height=2
                  rect x=0 y=0 width=4 height=1 fill=diffInk(scheme, "del")
              rect x=0 y=0 width=4 height=20 fill="url(#font-preview-deletion-stripes)"
        text line.number width="100%" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" text-align="right" font-variant-numeric="tabular-nums" color=(line.tone == "deletion" ? diffInk(scheme, "del") : line.tone == "addition" ? diffInk(scheme, "add") : "light-dark(#565656, #9d9d9d)")
      text flex=1 min-width=0 padding-left=(7.83 * size / 13) padding-right=(7.83 * size / 13) box-sizing="border-box" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" white-space="pre" color="light-dark(#0a0a0a, #fafafa)"
        each segment in line.segments key=segment.id
          text segment.text color=synColor(segment.syntax) font-style=synSlant(segment.syntax) background-color=(segment.mark ? diffInk(scheme, line.tone == "deletion" ? "del-mark" : "add-mark") : "#00000000")
