use SnapshotPanel from "./snapshot.contract"
use SnapshotSetup from "./snapshot.contract"
use SnapshotSettings from "./shapes.contract"
use R10PairFields from "./r10-connect-shapes.contract" // lane r10-connect
use KeybindingsPanel from "./settings-keybindings.contract"
use KeybindingPage from "./settings-keybindings.contract"
use ScheduledPanel from "./settings-scheduled.contract"
use ScheduledPage from "./settings-scheduled.contract"
use SourceControlPanel from "./settings-source-control.contract"
use IntegrationsPanel from "./settings-source-control.contract"
use SourceControlPage from "./settings-source-control.contract"
use IntegrationsPage from "./settings-source-control.contract"
use StoragePanel from "./settings-storage.contract"
use StoragePage from "./settings-storage.contract"
use ArchivedPanel from "./settings-archive.contract"
use SettingsRestDialogs from "./settings-rest-dialogs.contract"
use NoticesPanel from "./settings-licenses.contract"
use DiagnosticsPanel from "./settings-diagnostics.contract"
use ArchivePage from "./settings-archive.contract"
use LicenseSettings from "./shapes.contract"
use DiagnosticsPage from "./settings-diagnostics.contract"
use SettingsNav from "./settings-core.contract"
use SettingsTopBar from "./settings-core.contract"
use SettingsCore from "./settings-core.contract"
use CoreNav from "./settings-core.contract"
use SettingsCoreBody from "./settings-core-body.contract"
use SettingsRestoreDialog from "./settings-core-body.contract"
use SettingsADialogs from "./settings-a-dialogs.contract"
use ProvidersPanel from "./providers.contract"
use ProviderPage from "./providers.contract"
use ProviderSetupConfirm from "./providers-setup.contract"
use AddProviderDialog from "./providers-wizard.contract"
use ProviderWizard from "./providers-wizard.contract"
use AcpRegistry from "./providers-wizard.contract"
use UsageHubDialog from "./providers-wizard.contract"
use HubRemoveDialog from "./providers-wizard.contract"
use ChatGptAccountDialog from "./providers-wizard.contract"
use ChatGptAccountPicker from "./codex-setup.contract"
use ChatGptPlanDialog from "./codex-setup.contract"
use ConnectionsPanel from "./connections.contract"
use ConnectionsPage from "./connections.contract"
use AddEnvironmentDialog from "./connections.contract"
use EnvironmentRemoveDialog from "./connections.contract"
use LocalEnvironmentDialog from "./this-machine.contract" // local-primary-environment
use NetworkDialogs from "./connections-network-dialogs.contract" // this-machine-network-access
use RouteRemoveDialog from "./connections-routes.contract"
use ProjectsPanel from "./settings-projects.contract"
use ProjectsPage from "./settings-projects.contract"
use ProjectActionDialog from "./settings-b-actions.contract"
use ProjectIconDialog from "./settings-b-icons.contract"
use ProjectFaviconDialog from "./settings-b-icons.contract"
use SbPicker from "./settings-b-icons.contract"
use SbSshHosts from "./connections.contract"
use Snapshot from "./shapes.contract"
use Viewport from "./shapes.contract"

// The T3Code window's Settings view and dialogs, moved out of app.contract, which keeps the state,
// resources and actions: each component takes the root names it reads as props of the same names.

// Settings: the navigation, top bar and each route's panel, then the theme and restore dialogs.
component SettingsWindow
  props
    settingsOpen: bool
    settingsCore: SettingsCore
    connecting: bool
    settingsThemeDialog: string
    settingsRestoreOpen: bool
    data: Snapshot
    settingsNavigation: CoreNav
    settingsRoute: string
    settingsQuery: string
    sidebarWidth: number
    viewport: Viewport
    settingsMenu: string
    settingsEscapeHeld: bool
    editSettingsQuery: action
    coreSearchKey: action
    corePick: action
    coreClearSearch: action
    closeModal: action
    toggleSidebar: action
    commandPending: bool
    coreRestoreOpen: action
    settingsScrollTop: number
    coreMenuClose: action
    settingsLegacyOpen: bool
    coreLegacy: action
    coreMenu: action
    coreChange: action
    coreSlide: action
    coreNavigate: action
    coreScope: action
    coreThemeDialog: action
    sourceControl: SourceControlPage
    modalError: string
    rest: action
    restInput: action
    restLocal: action
    integrations: IntegrationsPage
    snapshotSettings: SnapshotSettings
    snapshotSetupOpen: bool
    toggleSnapshots: action
    showSnapshotSetup: action
    changeSnapshot: action
    previewSnapshotSound: action
    recordSnapshotShortcut: action
    saveSnapshotShortcut: action
    bindings: KeybindingPage
    keybindingQuery: string
    keybindingSearch: bool
    keybindingOpen: bool
    keybindingPrevious: string
    keybindingCommand: string
    keybindingKey: string
    keybindingWhen: string
    keybindingRecording: bool
    editKeybindingQuery: action
    searchKeybindings: action
    keybindingSearchKey: action
    newKeybinding: action
    cancelKeybinding: action
    chooseKeybindingCommand: action
    editKeybinding: action
    editKeybindingKey: action
    editKeybindingWhen: action
    recordKeybinding: action
    captureKeybinding: action
    scheduled: ScheduledPage
    restEditor: string
    restOpen: action
    storageSettings: StoragePage
    archives: ArchivePage
    restMenu: string
    restRaw: action
    restMenuOpen: action
    restClose: action
    licenses: LicenseSettings
    licenseQuery: string
    licenseSearchOpen: bool
    editLicenseQuery: action
    openLicenseSearch: action
    closeLicenseSearch: action
    licenseSearchKey: action
    toggleLicense: action
    retryLicenses: action
    diagnostics: DiagnosticsPage
    selectDiagnosticPeriod: action
    refreshSettings: action
    copyDiagnostic: action
    connectionsPage: ConnectionsPage
    pendingModal: string
    openConnection: action
    connectionOp: action
    connectionAskRemove: action
    connectionMenu: string
    connectionToggleMenu: action
    openRoute: action
    providerPage: ProviderPage
    providerDialog: string
    providerUi: action
    providerOp: action
    providerAccent: action
    setupBusy: bool
    projectsSettings: ProjectsPage
    settingsThemeSubject: string
    coreThemeChange: action
    coreRestoreClose: action
    coreRestoreConfirm: action
  view
    when settingsOpen
      row position="absolute" left=0 top=0 width="100%" height="100%" background-color=(settingsCore.palette.canvas == "" ? "light-dark(#fcfcfc, #0a0a0a)" : settingsCore.palette.canvas) inert=(connecting or (settingsThemeDialog != "" and settingsThemeDialog != "create" and settingsThemeDialog != "edit" and settingsThemeDialog != "duplicate") or settingsRestoreOpen or providerDialog != "") role="dialog" aria-label="Settings" testId="settings-dialog"
        when data.sidebarOpen
          SettingsNav(controlsLeft=data.controlsLeft, nav=settingsNavigation, route=settingsRoute, query=settingsQuery, width=max(max(208, data.sidebarMinWidth), min(sidebarWidth, viewport.width / 5)), pal=settingsCore.palette, active=0, artwork=data.look.artwork, menuOpen=(settingsMenu != "" or settingsRestoreOpen or settingsEscapeHeld or snapshotSetupOpen), edit=editSettingsQuery, onKey=coreSearchKey, pick=corePick, clear=coreClearSearch, back=closeModal, toggle=toggleSidebar)
        column flex=1 min-width=0 height="100%" box-sizing="border-box"
          SettingsTopBar(controlsLeft=data.controlsLeft, route=settingsRoute, crumb=settingsCore.breadcrumb, pal=settingsCore.palette, busy=commandPending, restorable=(settingsCore.restoreCount > 0), navOpen=data.sidebarOpen, toggle=toggleSidebar, restore=coreRestoreOpen)
          scroll flex=1 min-height=0 width="100%" padding-left="0.375rem" padding-right="0.375rem" box-sizing="border-box" id="settings-content-scroll" scrollTop=settingsScrollTop scroll-behavior="smooth" testId="settings-content-scroll"
            column gap="1.125rem" width="100%" max-width=(settingsRoute == "diagnostics" ? "72rem" : (settingsRoute == "providers" or settingsRoute == "connections" ? "64rem" : "56rem")) min-width=0 margin-left="auto" margin-right="auto" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="3rem" box-sizing="border-box" position="relative" id="settings-content-column"
              when settingsMenu != ""
                button press=coreMenuClose position="absolute" left=0 top=0 width="100%" height="100%" z-index=40 background-color="#00000000" aria-label="Close menu" aria-keyshortcuts="Escape" testId="settings-menu-backdrop"
              when settingsCore.showScope or settingsRoute == "general" or settingsRoute == "appearance"
                SettingsCoreBody(reduced=viewport.prefersReducedMotion, core=settingsCore, route=settingsRoute, busy=commandPending, menu=settingsMenu, legacyOpen=settingsLegacyOpen, toggleLegacy=coreLegacy, openMenu=coreMenu, closeMenu=coreMenuClose, change=coreChange, slide=coreSlide, navigate=coreNavigate, choose=coreScope, dialog=coreThemeDialog)
              when settingsRoute == "source-control"
                SourceControlPanel(data=sourceControl, busy=commandPending, error=modalError, rest=rest, restInput=restInput, restLocal=restLocal)
              when settingsRoute == "integrations"
                IntegrationsPanel(data=integrations, busy=commandPending, error=modalError, rest=rest, restInput=restInput)
              when settingsRoute == "snap-shot"
                SnapshotPanel(data=snapshotSettings, busy=commandPending, setupOpen=snapshotSetupOpen, toggle=toggleSnapshots, setup=showSnapshotSetup(true), change=changeSnapshot, preview=previewSnapshotSound, record=recordSnapshotShortcut, saveShortcut=saveSnapshotShortcut)
              when settingsRoute == "keybindings"
                KeybindingsPanel(data=bindings, query=keybindingQuery, searchOpen=keybindingSearch, adding=keybindingOpen, draftRow=keybindingPrevious, draftCommand=keybindingCommand, draftKey=keybindingKey, draftWhen=keybindingWhen, recording=keybindingRecording, busy=commandPending, error=modalError, search=editKeybindingQuery, searchToggle=searchKeybindings, searchKey=keybindingSearchKey, add=newKeybinding, cancelAdd=cancelKeybinding, chooseCommand=chooseKeybindingCommand, edit=editKeybinding, setKey=editKeybindingKey, setWhen=editKeybindingWhen, record=recordKeybinding, capture=captureKeybinding, rest=rest, openFile=rest("keybinding-open", ""))
              when settingsRoute == "scheduled-tasks"
                ScheduledPanel(data=scheduled, busy=commandPending, error=(restEditor == "" ? modalError : ""), open=restOpen, rest=rest)
              when settingsRoute == "storage"
                StoragePanel(data=storageSettings, busy=commandPending, error=modalError, rest=rest, restInput=restInput)
              when settingsRoute == "archived"
                ArchivedPanel(data=archives, busy=commandPending, error=(restEditor == "" ? modalError : ""), menu=restMenu, raw=restRaw, open=restOpen, showMenu=restMenuOpen, close=restClose)
              when settingsRoute == "open-source-licenses"
                NoticesPanel(data=licenses, query=licenseQuery, searchOpen=licenseSearchOpen, edit=editLicenseQuery, openSearch=openLicenseSearch, closeSearch=closeLicenseSearch, searchKey=licenseSearchKey, toggle=toggleLicense, retry=retryLicenses)
              when settingsRoute == "diagnostics"
                DiagnosticsPanel(data=diagnostics, busy=commandPending, selectPeriod=selectDiagnosticPeriod, reload=refreshSettings, copy=copyDiagnostic, rest=rest, local=restLocal)
              when settingsRoute == "connections"
                ConnectionsPanel(page=connectionsPage, width=min(1024, viewport.width - (data.sidebarOpen ? max(208, min(sidebarWidth, viewport.width / 5)) : 0) - 12) - 48, busy=commandPending, error=(connecting or pendingModal != "" ? "" : modalError), add=openConnection, op=connectionOp, remove=connectionAskRemove, menu=connectionMenu, toggleMenu=connectionToggleMenu, addRoute=openRoute, still=viewport.prefersReducedMotion)
              when settingsRoute == "providers"
                ProvidersPanel(page=providerPage, scheme=(data.look.mode == "dark" or (data.look.mode == "system" and viewport.prefersColorScheme == "dark") ? "dark" : "light"), width=min(1024, viewport.width - (data.sidebarOpen ? max(208, min(sidebarWidth, viewport.width / 5)) : 0) - 12) - 48, height=viewport.height, busy=commandPending, setupBusy=setupBusy, error=(providerDialog == "" ? modalError : ""), select=providerUi("select"), op=providerOp, accent=providerAccent, ui=providerUi)
              when settingsRoute == "projects"
                ProjectsPanel(data=projectsSettings, busy=commandPending, error=(restEditor == "" ? modalError : ""), choose=coreScope, rest=rest, restInput=restInput, raw=restRaw, open=restOpen)
              when modalError != "" and settingsRoute != "projects" and settingsRoute != "scheduled-tasks" and settingsRoute != "source-control" and settingsRoute != "integrations" and settingsRoute != "keybindings" and settingsRoute != "storage" and settingsRoute != "archived" and not snapshotSetupOpen
                text modalError font-size="0.75rem" color="light-dark(#b91c1c, #fca5a5)" role="alert" testId="settings-error"
    when settingsOpen and (settingsThemeDialog != "" or settingsCore.archiveConfirm.id != "" or settingsCore.saOpen)
      SettingsADialogs(core=settingsCore, kind=settingsThemeDialog, subject=settingsThemeSubject, viewportHeight=viewport.height, busy=commandPending, error=modalError, menu=settingsMenu, openMenu=coreMenu, close=coreThemeDialog("", ""), commit=coreChange, change=coreThemeChange, raw=restRaw, rest=rest, local=restLocal)
    when settingsOpen and settingsRestoreOpen
      SettingsRestoreDialog(core=settingsCore, busy=commandPending, cancel=coreRestoreClose, confirm=coreRestoreConfirm)

// Settings editors: the scheduled-task and project dialogs (settings-rest/settings-b).
component ProjectDialogs
  props
    restEditor: string
    restSubject: string
    restLabel: string
    scheduled: ScheduledPage
    projectsSettings: ProjectsPage
    commandPending: bool
    modalError: string
    rest: action
    restRaw: action
    restClose: action
    sbPicker: SbPicker
    sbQuery: string
    sbLettersEdited: bool
    sbLetters: string
    sbEmoji: string
    viewport: Viewport
    sbSet: action
  view
    SettingsRestDialogs(editor=restEditor, subject=restSubject, label=restLabel, scheduled=scheduled, projects=projectsSettings, busy=commandPending, error=modalError, rest=rest, raw=restRaw, close=restClose)
    when restEditor == "project-action"
      ProjectActionDialog(data=projectsSettings, subject=restSubject, busy=commandPending, error=modalError, raw=restRaw, close=restClose)
    when restEditor == "project-icon"
      ProjectIconDialog(data=projectsSettings, picker=sbPicker, query=sbQuery, letters=(sbLettersEdited ? sbLetters : projectsSettings.iconLetters), custom=sbEmoji, dark=(viewport.prefersColorScheme == "dark"), busy=commandPending, error=modalError, raw=restRaw, set=sbSet, close=restClose)
    when restEditor == "project-favicon"
      ProjectFaviconDialog(data=projectsSettings, picker=sbPicker, query=sbQuery, vw=viewport.width, vh=viewport.height, dark=(viewport.prefersColorScheme == "dark"), busy=commandPending, raw=restRaw, set=sbSet, close=restClose)

// Settings dialogs: snapshot setup, Add environment, the provider wizards and removal confirms.
component SettingsModals
  props
    snapshotSetupOpen: bool
    snapshotSettings: SnapshotSettings
    commandPending: bool
    modalError: string
    snapshotSetupWasEnabled: bool
    showSnapshotSetup: action
    toggleSnapshots: action
    changeSnapshot: action
    recordSnapshotShortcut: action
    saveSnapshotShortcut: action
    connecting: bool
    origin: string
    pairFields: R10PairFields
    credential: string
    data: Snapshot
    viewport: Viewport
    sbSshHosts: SbSshHosts
    sbSshHost: string
    editOrigin: action
    editCredential: action
    connectionOp: action
    sbSet: action
    closeConnection: action
    providerDialog: string
    providerWizard: ProviderWizard
    acpAgents: AcpRegistry
    wizardStep: number
    wizardAttempted: bool
    wizardLabelSet: bool
    wizardLabel: string
    wizardIdSet: bool
    wizardId: string
    acpQuery: string
    wizardManual: bool
    providerUi: action
    providerAdd: action
    providerOp: action
    providerPage: ProviderPage
    providerTarget: string
    setupBusy: bool
    connectionRemove: string
    connectionsPage: ConnectionsPage
    connectionAskRemove: action
    routeTarget: string
    routeLabel: string
    // local-primary-environment: the Local environment switch's command (settingsCommand: the dialog stays open while it runs).
    localCommand: action
  view
    when snapshotSetupOpen
      SnapshotSetup(data=snapshotSettings, busy=commandPending, error=modalError, wasEnabled=snapshotSetupWasEnabled, close=showSnapshotSetup(false), toggle=toggleSnapshots, change=changeSnapshot, record=recordSnapshotShortcut, saveShortcut=saveSnapshotShortcut)
    when connecting
      AddEnvironmentDialog(origin=origin, credential=credential, pairFields=pairFields, connected=data.connected, available=data.available, viewportHeight=viewport.height, busy=commandPending, error=modalError, sshHosts=sbSshHosts, sshHost=sbSshHost, editOrigin=editOrigin, editCredential=editCredential, submit=connectionOp("environment-add", origin, credential), set=sbSet, ssh=connectionOp, closeDialog=closeConnection, routeTarget=routeTarget, routeLabel=routeLabel)
    when providerDialog == "add"
      each session in providerWizard.sessions key=session.key
        AddProviderDialog(wizard=providerWizard, acp=acpAgents, step=wizardStep, attempted=wizardAttempted, labelSet=wizardLabelSet, label=wizardLabel, idSet=wizardIdSet, id=wizardId, query=acpQuery, manual=wizardManual, viewportHeight=viewport.height, scheme=(data.look.mode == "dark" or (data.look.mode == "system" and viewport.prefersColorScheme == "dark") ? "dark" : "light"), busy=commandPending, setupBusy=setupBusy, error=modalError, ui=providerUi, add=providerAdd, op=providerOp)
    when providerDialog == "chatgpt"
      each session in providerWizard.sessions key=session.key
        ChatGptAccountDialog(wizard=providerWizard, busy=commandPending, setupBusy=setupBusy, error=modalError, close=providerUi("close", ""), create=providerOp("provider-chatgpt", ""), op=providerOp, ui=providerUi)
    // managed-codex-chatgpt: Reconnect ChatGPT (ChatGptAccountPicker) for the instance that opened it.
    when providerDialog == "codex-picker"
      each picker in providerWizard.codexPicker key=picker.key
        ChatGptAccountPicker(picker=picker, busy=setupBusy, op=providerOp, ui=providerUi)
    when providerDialog == "hub"
      each session in providerWizard.sessions key=session.key
        UsageHubDialog(environment=providerWizard.environment, busy=commandPending, error=modalError, close=providerUi("close", ""), save=providerOp("provider-hub-add"))
    when providerDialog == "hub-remove"
      each hub in providerPage.hubs key=hub.id
        when hub.id == providerTarget
          HubRemoveDialog(hub=hub, busy=commandPending, cancel=providerUi("close", ""), confirm=providerOp("provider-hub-remove", "", hub.id, "", true))
    // provider-sign-in-and-install: Sign out (the Account row) and Remove (the Antigravity runtime) ask first.
    when providerDialog == "setup-logout" or providerDialog == "setup-remove"
      each editor in providerPage.editors key=editor.key
        when editor.id == providerTarget
          each account in (providerDialog == "setup-logout" ? editor.setup.account : []) key=account.key
            ProviderSetupConfirm(what=providerDialog, instanceId=editor.id, title=account.signOutTitle, body=account.signOutBody, busy=setupBusy, op=providerOp, ui=providerUi)
          each runtime in (providerDialog == "setup-remove" ? editor.setup.runtime : []) key=runtime.key
            ProviderSetupConfirm(what=providerDialog, instanceId=editor.id, title=runtime.removeTitle, body=runtime.removeBody, busy=setupBusy, op=providerOp, ui=providerUi)
    // "Turn off/on local environment?" (this-machine.contract): open until the switch reads the new value.
    when (connectionRemove == "local-environment:off" and connectionsPage.thisMachine.enabled) or (connectionRemove == "local-environment:on" and not connectionsPage.thisMachine.enabled)
      LocalEnvironmentDialog(title=connectionsPage.thisMachine.dialogTitle, body=connectionsPage.thisMachine.dialogBody, confirmLabel=connectionsPage.thisMachine.dialogConfirm, destructive=connectionsPage.thisMachine.enabled, busy=commandPending, error=connectionsPage.thisMachine.error, still=viewport.prefersReducedMotion, cancel=connectionAskRemove(""), confirm=localCommand("local-environment", "", connectionsPage.thisMachine.enabled ? "off" : "on"))
    // Network access, Tailscale HTTPS, Create pairing link and the reveal dialog (connections-network-dialogs.contract).
    NetworkDialogs(net=connectionsPage.network, remove=connectionRemove, ask=connectionAskRemove, command=localCommand, busy=commandPending, still=viewport.prefersReducedMotion)
    when connectionRemove != ""
      each environment in connectionsPage.environments key=environment.key
        when environment.key == connectionRemove
          EnvironmentRemoveDialog(environment=environment, busy=commandPending, cancel=connectionAskRemove(""), confirm=connectionOp("environment-forget", environment.origin, environment.environmentId))
        // Lane environment-routes: "Remove <label> route?" for one of its routes.
        each route in environment.routes key=route.id
          when route.target == connectionRemove
            RouteRemoveDialog(route=route, busy=commandPending, cancel=connectionAskRemove(""), confirm=connectionOp("environment-route-remove", environment.key, route.id))
    // managed-codex-chatgpt: ChatGptWelcomeCoordinator's "Your ChatGPT plan is connected", once per profile.
    each notice in data.chatgptPlan key=notice.key
      ChatGptPlanDialog(notice=notice, busy=setupBusy, op=providerOp)
