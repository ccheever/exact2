// Lane r5-shell: the Pull Requests list's states with no rows (routes/
// _chat.pull-requests.tsx listBody; MIT, see LICENSE-T3), as the HEAD oracle
// draws them:
// - PullRequestsUnavailableState: a failed list read ("Could not load pull
//   requests", the server's message, Retry) and a server without the
//   capability ("Pull requests unavailable", no button). EmptyMedia variant
//   icon: the 36pt pull request card over two fanned copies, 24pt above the
//   header (its mb-6 plus the Empty's gap). The fanned copies turn about their
//   bottom corners (-translate-x-0.5 -rotate-10 scale-84 origin-bottom-left and
//   its mirror); natively a box takes the individual translate/rotate/scale
//   properties about its centre, so they carry the same matrix (translate ±7.74, 0.48).
// - PullRequestListEmptyState: the BranchMark drawing (128x80, an unjoined
//   branch over a base line), then "No projects in this workspace" with the
//   primary Add project button, "Nothing matches “…”" with Clear search and
//   Check again, or "No pull requests" / "Nothing under these filters" with
//   Check again.
// Empty: flex-1, centred, p-12 and gap-6; the header is max-w-sm with a 20/28
// semibold title and the 14/20 muted description 4pt below it. Buttons are
// size sm (28pt; the 14pt glyph pulled in 2pt, 4pt from the label).
use PgIcon from "./pages-icons.contract"

component PrEmptyState
  props
    available: bool
    error: string
    title: string
    detail: string
    action: string
    loading: bool
    scheme: string
    reload: action
    control: action
    addProject: action
  derive muted = scheme == "dark" ? "#818181" : "#71717b"
  derive failed = not available or error != ""
  view
    column flex=1 width="100%" min-height=0 padding=48 box-sizing="border-box" align-items="center" justify-content="center" gap=24 testId="pull-requests-empty"
      when failed
        box width=36 height=36 position="relative" margin-bottom=24 flex-shrink=0
          box position="absolute" left=0 bottom=1 width=36 height=36 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="-7.74px 0.48px" rotate=-10 scale=0.84
          box position="absolute" left=0 bottom=1 width=36 height=36 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" translate="7.74px 0.48px" rotate=10 scale=0.84
          box position="absolute" left=0 top=0 width=36 height=36 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 1px 2px #0000000d" display="flex" align-items="center" justify-content="center"
            PgIcon(name="git-pull-request-arrow", size=18, color="light-dark(#27272a, #f5f5f5)")
      else
        svg width=128 height=80 viewBox="0 0 120 72" fill="none" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d="M10 58h100" stroke=`${muted}4d`
          circle cx=10 cy=58 r=5 stroke=`${muted}99` fill=`${muted}99` fill-opacity=0.25
          circle cx=110 cy=58 r=5 stroke=`${muted}99` fill=`${muted}99` fill-opacity=0.25
          path d="M30 58c0-18 8-26 24-26h4" stroke=`${muted}99`
          path d="M90 58c0-18-8-26-24-26h-4" stroke=`${muted}80` stroke-dasharray="2 7"
          circle cx=60 cy=32 r=4 stroke=`${muted}73` fill="none"
      column max-width=384 align-items="center" flex-shrink=0
        text title font-size=20 line-height="28px" font-weight=600 text-align="center" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 testId="pull-requests-empty-title"
        text detail margin-top=4 font-size=14 line-height="20px" text-align="center" color="light-dark(#71717b, #818181)" testId="pull-requests-empty-text"
      when available and error != ""
        row flex-wrap="wrap" justify-content="center" gap=8 flex-shrink=0
          R5OutlineSm(icon="refresh-cw", label="Retry", press=reload, testId="pull-requests-empty-action")
      when not failed and action == "add-project"
        R5PrimarySm(icon="plus", label="Add project", press=addProject, testId="pull-requests-empty-action")
      when not failed and action != "add-project"
        row flex-wrap="wrap" justify-content="center" gap=8 flex-shrink=0
          when action == "clear"
            R5OutlineSm(icon="search", label="Clear search", press=control("query", ""), testId="pull-requests-empty-clear")
          R5OutlineSm(icon="refresh-cw", label=(loading ? "Checking..." : "Check again"), press=reload, testId="pull-requests-empty-action")

// Button size="sm" (default variant): the primary fill, a leading 14pt glyph.
component R5PrimarySm
  props
    icon: string
    label: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height=28 padding-left=7 padding-right=9 box-sizing="border-box" gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color=(over ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") box-shadow="inset 0 1px 0 #ffffff29" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color="#ffffff")
      text label font-size=14 line-height="20px" font-weight=500 white-space="nowrap" color="#ffffff"

// Button size="sm" variant="outline" (pages-pr-detail.contract's PrdOutline).
component R5OutlineSm
  props
    icon: string
    label: string
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover testId=testId height=28 padding-left=7 padding-right=9 box-sizing="border-box" gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff0d)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" display="flex" flex-direction="row" align-items="center" flex-shrink=0
      PgIcon(name=icon, size=14, color="light-dark(#71717b, #818181)")
      text label font-size=14 line-height="20px" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
