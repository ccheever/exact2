{
 "about": "Shared terminal output buffer vectors (terminal-output.ts, T3TerminalOutput.swift). Generated from the reference terminalOutput.ts port; strings longer than 256 UTF-16 units are {length, head, tail}. An op's `parts` ([text, count] pairs, joined) replace its empty `data`. Each step applies `op` (`max` bytes, default 524288) `repeat` times; `readEach` reads after every repeat and joins the appended data, false skips the read, else one read follows. `staleRead` reads from the initial cursor.",
 "cases": [
  {
   "name": "caps retained output by UTF-8 byte length",
   "steps": [
    {
     "op": "append",
     "data": "🙂🙂",
     "max": 4,
     "expect": {
      "text": "🙂",
      "retainedBytes": 4,
      "chunks": 1,
      "nextOffset": 4,
      "resetVersion": 0,
      "read": {
       "type": "reset",
       "data": "🙂"
      }
     }
    }
   ]
  },
  {
   "name": "reduces a snapshot then output under an 8 byte budget",
   "steps": [
    {
     "op": "reset",
     "data": "hello",
     "expect": {
      "text": "hello",
      "retainedBytes": 5,
      "chunks": 1,
      "nextOffset": 5,
      "resetVersion": 1,
      "read": {
       "type": "reset",
       "data": "hello"
      }
     }
    },
    {
     "op": "append",
     "data": " world",
     "max": 8,
     "stale": true,
     "expect": {
      "text": "lo world",
      "retainedBytes": 8,
      "chunks": 2,
      "nextOffset": 11,
      "resetVersion": 1,
      "read": {
       "type": "append",
       "data": " world"
      },
      "staleRead": {
       "type": "reset",
       "data": "lo world"
      }
     }
    }
   ]
  },
  {
   "name": "preserves a BOM code point at a new output chunk boundary",
   "steps": [
    {
     "op": "reset",
     "data": "",
     "expect": {
      "text": "",
      "retainedBytes": 0,
      "chunks": 0,
      "nextOffset": 0,
      "resetVersion": 1,
      "read": {
       "type": "reset",
       "data": ""
      }
     }
    },
    {
     "op": "append",
     "data": "﻿yyyyyyyyyyyyyyyyyyyy",
     "expect": {
      "text": {
       "length": 16405,
       "head": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
       "tail": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx﻿yyyyyyyyyyyyyyyyyyyy"
      },
      "retainedBytes": 16407,
      "chunks": 2,
      "nextOffset": 16405,
      "resetVersion": 1,
      "read": {
       "type": "append",
       "data": {
        "length": 16405,
        "head": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx",
        "tail": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx﻿yyyyyyyyyyyyyyyyyyyy"
       }
      }
     }
    }
   ]
  },
  {
   "name": "preserves a leading BOM in the retained snapshot tail",
   "steps": [
    {
     "op": "reset",
     "data": "discard﻿tail",
     "max": 7,
     "expect": {
      "text": "﻿tail",
      "retainedBytes": 7,
      "chunks": 1,
      "nextOffset": 5,
      "resetVersion": 1,
      "read": {
       "type": "reset",
       "data": "﻿tail"
      }
     }
    }
   ]
  },
  {
