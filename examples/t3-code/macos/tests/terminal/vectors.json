     "expect": {
      "text": "hello one two three",
      "retainedBytes": 19,
      "chunks": 4,
      "nextOffset": 19,
      "resetVersion": 1,
      "read": {
       "type": "append",
       "data": " one two three"
      }
     }
    }
   ]
  },
