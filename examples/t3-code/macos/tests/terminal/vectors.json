     "expect": {
      "text": "hello one",
      "retainedBytes": 9,
      "chunks": 2,
      "nextOffset": 9,
      "resetVersion": 1,
      "read": {
       "type": "skipped",
       "data": ""
      }
     }
    },
    {
     "op": "append",
     "data": " two",
     "readEach": false,
     "expect": {
      "text": "hello one two",
