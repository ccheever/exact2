// The diff rows the thread's Diff panel (diff.contract) and the pull request Code tab
// (pages-pr-code.contract) both draw, measured against T3's served @pierre/diffs rendering: a file
// header, a stacked or split line, a hidden-range separator, a comment under its line, and the
// toolbar's icon button. Kept apart from diff.contract so the pull request panel can draw them
// without reaching the window's shapes (the panel is reachable from those).
use DiffItem from "./shapes.contract"
use DiffSegment from "./shapes.contract"
use diffInk from "./settings-appearance-look.contract"
use synColor from "./markdown.contract"
use synSlant from "./markdown.contract"
use PgIcon from "./pages-icons.contract"
use DiffGlyph from "./diff-glyphs.contract"
use DiffCommentCard, DiffDraftCard from "./diff-comments.contract"

// A selected line's paint, read from T3's StyledDiffCodeView over @pierre/diffs (CDP, 1e2ecbd975; the same in the
// Code tab and the Diff panel, stacked and split): the row and the number's cell mixed from the code surface and
// Pierre's modified blue, the number in that blue, and a 4pt bar of it at the gutter's left in place of the change bar
// (diff-gutter-visuals). The comment cards under a selected line take the row's colour and the bar (Pierre's
// renderSelection marks the annotation that follows a selected line).
fn diffSel(role: string): string = role == "row" ? "light-dark(#eff7fd, #0f151a)" : role == "gutter" ? "light-dark(#f0f7fd, #10151a)" : role == "number" ? "light-dark(#20649e, #72b6ff)" : "#009fff"

component DiffTool
  props
    icon: string
    label: string
    pressed: bool
    toggle: bool
    radius: number
    testId: string
    choose: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    button press=choose hover=setHover aria-label=label testId=testId width="1.75rem" height="1.75rem" padding=0 flex-shrink=0 border-radius=radius border-width=0 background-color=(pressed or hovering ? "light-dark(#f4f4f5, #141414)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
      when toggle
        DiffGlyph(name=icon, size=14, color="light-dark(#27272a, #f5f5f5)")
      else
        DiffGlyph(name=icon, size=14, color="light-dark(#71717a, #818181)")

// One virtualized item: a file header, a stacked or split line, a hidden-range separator, a
// comment (saved or draft) under its line, or a header skeleton while a large diff loads.
component DiffRow
  props
    item: DiffItem
    wrap: bool
    command: action
    scheme: string
    // r4-timeline: Settings → Appearance code size (--diffs-font-size; lines stay 20pt).
    size: number
    commentOpen: bool
    draftText: string
    editDraft: action
    beginComment: action
    cancelComment: action
    saveComment: action
  view
    column width="100%"
      when item.kind == "file"
        DiffFileHeader(item=item, command=command, scheme=scheme)
      when item.kind == "pad"
        box width="100%" height="0.5rem"
      when item.kind == "ghost"
        // DiffFileHeaderSkeleton under DiffFileLoadingBoundary.
        row width="100%" height="2rem" padding-left="0.5rem" padding-right="0.75rem" gap="0.5rem" box-sizing="border-box" align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e766, #19191966)" role="status" aria-label="Loading diff…" testId=`diff-ghost-${item.id}`
          box width="1rem" height="1rem" border-radius="0.25rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
          box width="45%" height="0.75rem" border-radius="0.375rem" background-color="light-dark(#e4e4e7, #1c1c1c)"
      when item.kind == "gap"
        DiffGap(item=item, command=command)
      when item.kind == "note" or item.kind == "draft"
        // A comment under a selected line takes the line's colour and the selection's bar.
        column width="100%" position="relative" background-color=(item.selected ? diffSel("row") : "#00000000")
          when item.kind == "note"
            DiffCommentCard(text=item.text, remove=command("diffreview", "delete", item.entry, 0))
          else
            DiffDraftCard(rangeLabel=item.label, text=draftText, selected=item.selected, edit=editDraft, cancel=cancelComment, save=saveComment, focusIn=command("diffreview", "focus", "", 0), focusOut=command("diffreview", "blur", "", 0))
          when item.selected
            box position="absolute" left=0 top=0 bottom=0 width="0.25rem" background-color=diffSel("bar")
      when item.kind == "split"
        row width="100%" align-items="stretch"
          DiffCell(tone=item.leftTone, number=item.leftNumber, segments=item.leftSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side="deletions", line=item.leftLine, selected=item.leftSelected, pinned=item.pinned, pin=item.leftPin, open=commentOpen, command=command, begin=beginComment)
          DiffCell(tone=item.rightTone, number=item.rightNumber, segments=item.rightSegments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side="additions", line=item.rightLine, selected=item.rightSelected, pinned=item.pinned, pin=item.rightPin, open=commentOpen, command=command, begin=beginComment)
      when item.kind == "line"
        row width="100%" align-items="stretch"
          DiffCell(tone=item.tone, number=item.number, segments=item.segments, gutter=item.gutter, wrap=wrap, scheme=scheme, size=size, path=item.path, side=item.side, line=item.line, selected=item.selected, pinned=item.pinned, pin=item.pin, open=commentOpen, command=command, begin=beginComment)

// "N unmodified lines": a press opens them from the file's contents (git sources; Pierre's hunk expansion).
component DiffGap
  props
    item: DiffItem
    command: action
  state hovering = false
  action hover(over: bool)
    hovering = over
  view
    when item.expandable
      button press=command("diffreview", "expand", item.path, item.line) hover=hover aria-label=`Expand ${item.label}` testId=`diff-gap-${item.path}-${item.line}` width="100%" height="2rem" padding-left="0.75rem" padding-right="0.75rem" gap="0.375rem" box-sizing="border-box" border-width=0 background-color=(hovering ? "light-dark(#e9e9ea, #1c1c1c)" : "light-dark(#f0f0f0, #161616)") display="flex" flex-direction="row" align-items="center"
        DiffGlyph(name="unfold", size=14, color="light-dark(#71717a, #818181)")
        text item.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)"
    else
      row width="100%" height="2rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" align-items="center" background-color="light-dark(#f0f0f0, #161616)" testId=`diff-gap-${item.path}-${item.line}`
        text item.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)"

component DiffFileHeader
  props
    item: DiffItem
    command: action
    scheme: string
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    row width="100%" min-height="2rem" padding-top="0.375rem" padding-bottom="0.375rem" padding-left="0.5rem" padding-right="0.75rem" box-sizing="border-box" align-items="center" gap="0.5rem" hover=setHover position="relative" background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`diff-file-${item.path}`
      when hovering
        box position="absolute" left=0 top=0 bottom=0 width="0.1875rem" background-color="light-dark(#0a0a0a3d, #fafafa3d)"
      // A header whose patch has not arrived keeps the collapsed geometry, its chevron off (DiffPanel renderHeaderPrefix).
      button press=command("diff-view", "file", item.path, 0) disabled=item.unavailable aria-label=`${item.expanded ? "Collapse" : "Expand"} ${item.path}` aria-expanded=item.expanded testId=`diff-toggle-${item.path}` width="1.25rem" height="1.25rem" margin-left="-0.125rem" padding=0 border-radius="0.25rem" border-width=0 opacity=(item.unavailable ? 0.5 : 1) background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
        PgIcon(name=(item.expanded ? "chevron-down" : "chevron-right"), size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      DiffGlyph(name=item.status, size=16, color=(item.status == "deleted" ? diffInk(scheme, "del") : item.status == "added" ? diffInk(scheme, "add") : "#009fff"))
      button press=command("diff-view", "file", item.path, 0) disabled=item.unavailable aria-label=item.path flex-shrink=1 min-width=0 padding=0 border-width=0 background-color="#00000000"
        text item.name font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1
      button press=command("diff-view", "copy", item.path, 0) aria-label="Copy file path" testId=`diff-copy-${item.path}` width="1.25rem" height="1.25rem" padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0 title=""
        DiffGlyph(name="copy", size=12, color="light-dark(#71717a, #818181)")
      // DiffFileStatus: Retry after a failed read; "Partial diff preview" for a file past the per-file cap.
      when item.error or item.partial
        button press=command("diffreview", (item.error ? "retry" : "partial"), item.path, 0) aria-label=(item.error ? "Retry loading diff" : "Partial diff preview") title=(item.error ? "Retry loading diff" : "This file is too large to show in full. Counts include all changes.") testId=`diff-status-${item.path}` width="1rem" height="1rem" padding=0 border-radius="0.25rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
          DiffGlyph(name=(item.error ? "rotate-cw" : "info"), size=12, color="light-dark(#71717a, #818181)")
      box flex=1
      // A large source read file by file draws DiffPanel's DiffStatLabel (additions first, both counts, compact,
      // right-aligned 4ch columns); any other file Pierre's own counts ("-d" then "+a"; diff.ts headerStat).
      when item.statAligned
        row gap="0.5rem" align-items="center" flex-shrink=0 role="group" aria-label=`${item.additions} additions, ${item.deletions} deletions` testId=`diff-stat-${item.path}`
          text item.addText min-width="1.8rem" text-align="right" white-space="nowrap" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "add")
          text item.delText min-width="1.8rem" text-align="right" white-space="nowrap" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "del")
      else
        row gap="0.5rem" align-items="center" flex-shrink=0 testId=`diff-stat-${item.path}`
          when item.delText != ""
            text item.delText font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="0.6875rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "del")
          when item.addText != ""
            text item.addText font-family="ui-monospace" font-size="0.6875rem" letter-spacing=-0.17 line-height="0.6875rem" font-variant-numeric="tabular-nums" color=diffInk(scheme, "add")

// The gutter carries the old (deletion) or new line number and a 4pt change bar. A press on the
// number starts a selection that follows the pointer over the file's lines (Shift extends the
// selection); a press on the gutter's "+" starts a range from the selection's top whose end follows
// the pointer (Pierre's line selection and gutter utility, off while a draft is open; realinput-1010f
// RF-3, diff-line-drag.ts). The pressed node holds the pointer, so its moves name the line under it
// by the cell's `id` (`elementFromPoint`); the release ends the drag. While the file has a selection
// the "+" sits on its bottom line only (`pin`; Pierre's placeUtilityFromSelection), so during a drag it
// follows the selection; otherwise on the hovered line. A cell whose own drag is in flight keeps its
// "+" mounted (hidden when the selection moved it), as the pressed node holds the pointer. The "+" is Pierre's
// [data-utility-button]: a 1lh (20pt) square in the modified blue with its 16pt plus in the code surface's colour,
// from the number's right edge (the slot at the cell's right, `margin-right: calc(-1lh + 1ch)`), over the code's
// first column (diff-gutter-visuals; CDP: the number cell's right minus 1ch + 2pt).
component DiffCell
  props
    tone: string
    number: string
    segments: list<DiffSegment>
    gutter: number
    size: number
    wrap: bool
    scheme: string
    path: string
    side: string
    line: number
    selected: bool
    pinned: bool
    pin: bool
    open: bool
    command: action
    begin: action
  state hovering = false
  state dragging = false
  state overId = ""
  action hover(over: bool)
    hovering = over
  action down(gutter: bool, e: PointerEvent)
    if not open and line > 0 and e.buttons == 1
      dragging = true
      overId = `dl:${side}:${line}:${path}`
      command("diffreview", (gutter ? `gutter:${side}` : e.shiftKey ? `drag:${side}:shift` : `drag:${side}`), path, line)
  action move(e: PointerEvent)
    // A held pointer's moves carry its button; a hover after an up this node never heard ends the drag.
    if dragging and e.buttons == 0
      dragging = false
      command("diffreview", "end", path, line)
    else if dragging
      let hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
      if hit != "" and hit != overId
        overId = hit
        command("diffreview", "to", hit, 0)
  action up(e: PointerEvent)
    if dragging
      dragging = false
      command("diffreview", "end", path, line)
  action comment
    if not open and line > 0
      begin(path, side, line)
  view
    row id=`dl:${side}:${line}:${path}` flex=1 min-width=0 align-items="stretch" hover=hover position="relative" background-color=(selected ? diffSel("row") : tone == "deletion" ? diffInk(scheme, "del-row") : tone == "addition" ? diffInk(scheme, "add-row") : tone == "empty" ? "light-dark(#e4e4e4, #222222)" : "light-dark(#fcfcfc, #0a0a0a)")
      box width=((gutter - 2) * size / 13 + 2) flex-shrink=0 position="relative" padding-right=(7.83 * size / 13 + 2) box-sizing="border-box" pointerdown=down(false) pointermove=move pointerup=up testId=`diff-line-${path}-${side}-${line}` aria-label=(line > 0 ? `Select line ${line}` : "") background-color=(selected ? diffSel("gutter") : tone == "deletion" ? diffInk(scheme, "del-gutter") : tone == "addition" ? diffInk(scheme, "add-gutter") : "#00000000")
        // Additions carry a solid bar; deletions a 1pt-striped one (@pierre/diffs bars); a selected line the selection's.
        when selected
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" background-color=diffSel("bar")
        when tone == "addition" and not selected
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" background-color=diffInk(scheme, "add")
        when tone == "deletion" and not selected
          box position="absolute" left=0 top=0 bottom=0 width="0.25rem" overflow="hidden" background-color=diffInk(scheme, "del-bar")
            svg width="0.25rem" height="25rem" aria-hidden=true
              defs
                pattern id="diff-deletion-stripes" patternUnits="userSpaceOnUse" width=4 height=2
                  rect x=0 y=0 width=4 height=1 fill=diffInk(scheme, "del")
              rect x=0 y=0 width=4 height=400 fill="url(#diff-deletion-stripes)"
        text number width="100%" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" text-align="right" font-variant-numeric="tabular-nums" color=(selected ? diffSel("number") : tone == "deletion" ? diffInk(scheme, "del") : tone == "addition" ? diffInk(scheme, "add") : "light-dark(#565656, #9d9d9d)")
      text flex=1 min-width=0 padding-left=(7.83 * size / 13) padding-right=(7.83 * size / 13) box-sizing="border-box" font-family="ui-monospace" font-size=size letter-spacing=(-0.21 * size / 13) line-height="20px" white-space=(wrap ? "pre-wrap" : "pre") overflow-wrap=(wrap ? "anywhere" : "normal") color="light-dark(#0a0a0a, #fafafa)"
        each segment in segments key=segment.id
          text segment.text color=synColor(segment.syntax) font-style=synSlant(segment.syntax)
      when line > 0 and not open and (pin or not pinned or dragging)
        button press=comment pointerdown=down(true) pointermove=move pointerup=up aria-label=`Comment on line ${line}` testId=`diff-comment-${path}-${side}-${line}` position="absolute" left=((gutter - 2) * size / 13 - 7.83 * size / 13) top=0 width=20 height=20 padding=0 border-radius=4 border-width=0 opacity=(pin or (hovering and not pinned) ? 1 : 0) background-color=diffSel("bar") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          svg width=16 height=16 viewBox="0 0 16 16" color="light-dark(#fcfcfc, #0a0a0a)" flex-shrink=0 aria-hidden=true
            path d="M8 3a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 8 3" fill="currentColor"
