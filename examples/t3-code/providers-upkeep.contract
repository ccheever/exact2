// Provider settings upkeep (T3 Code 1e2ecbd975, MIT; see LICENSE-T3): the version advisory
// popover of ProviderInstanceCard.tsx:772-870 (one component for the list row and the editor),
// ProviderUpdatesAction ("Update all"), the "Continue authentication" link
// (ProviderInstanceCard.tsx:994-1011), AcpSessionManagementSection and CustomModelEditor.
// The view models are providers-upkeep.ts, acp-sessions.ts and custom-model-editor.ts; every
// command is `op("upkeep:<what>", instance, field, value)`. Updates go through the root's
// `providerUpdateRun` queue mutation, the rest through `providerAuthChanged`.
use PvRow from "./providers-kit.contract"
use PvField from "./providers-kit.contract"
use PvOutline from "./providers-kit.contract"
use PvGhost from "./providers-kit.contract"
use PvIconButton from "./providers-kit.contract"
use PvMicro from "./providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use CnTooltip from "./settings-b-kit.contract"
use hoverTipAtFrame from "./hover-layer.contract" // fix-hover-cards
use CnGlyph from "./settings-b-kit.contract"
use AppConfirm from "./shell-panels.contract"

shape ProviderAdvisory
  show: bool
  mode: string
  popId: string
  instanceId: string
  label: string
  title: string
  detail: string
  strong: bool
  warning: bool
  action: string
  target: string
  updating: bool
  command: string
  divider: bool
shape ProviderUpdateAll
  show: bool
  pending: bool
  label: string
  tip: string
shape UpkeepOption
  value: string
  label: string
  note: string
  selected: bool
shape UpkeepUrlAuth
  key: string
  elicitationId: string
  url: string
  message: string
shape AcpSessionRow
  key: string
  first: bool
  sessionId: string
  title: string
  importLabel: string
  importDisabled: bool
  canDelete: bool
  deleteLabel: string
  deleteDisabled: bool
  confirmKey: string
  deleteTitle: string
shape AcpProviderRow
  key: string
  first: bool
  providerId: string
  status: string
  saveLabel: string
  saveDisabled: bool
  showDisable: bool
  disableDisabled: bool
  fieldsDisabled: bool
  apiType: string
  protocols: list<UpkeepOption>
  baseUrl: string
  headers: string
  confirmKey: string
  disableTitle: string
shape AcpSection
  key: string
  instanceId: string
  readOnly: bool
  canList: bool
  canLogout: bool
  canConfigure: bool
  status: string
  showPicker: bool
  projects: list<UpkeepOption>
  projectTitle: string
  pickerDisabled: bool
  listLabel: string
  listDisabled: bool
  logoutLabel: string
  logoutDisabled: bool
  showList: bool
  sessions: list<AcpSessionRow>
  showMore: bool
  moreLabel: string
  moreDisabled: bool
  providersLabel: string
  providersDisabled: bool
  showProviderPicker: bool
  providers: list<AcpProviderRow>
shape CmChoice
  key: string
  ref: string
  id: string
  label: string
  isDefault: bool
shape CmDescriptor
  key: string
  ref: string
  index: number
  position: string
  idSelect: string
  idSelectLabel: string
  customId: bool
  idOptions: list<UpkeepOption>
  id: string
  label: string
  type: string
  typeLabel: string
  typeOptions: list<UpkeepOption>
  isSelect: bool
  choices: list<CmChoice>
shape CmPreset
  id: string
  label: string
shape CmEditor
  key: string
  instanceId: string
  slug: string
  name: string
  error: string
  empty: bool
  hasPresets: bool
  copyFrom: list<UpkeepOption>
  addPresets: list<CmPreset>
  descriptors: list<CmDescriptor>
shape ProviderUpkeep
  urlAuth: list<UpkeepUrlAuth>
  acp: list<AcpSection>
  modelEditor: list<CmEditor>

keyframes upkeepSpin
  from rotate=0
  to rotate=360

// Spinner (LoaderCircle, motion-safe:animate-spin): still under reduced motion (the root's
// `still` = prefers-reduced-motion).
component UpkeepSpinner
  inject
    still: bool
  props
    size: number
    color: string
  view
    box width=`${size / 16}rem` height=`${size / 16}rem` display="flex" flex-shrink=0 animation=(still ? "none" : "upkeepSpin 1s linear infinite") aria-hidden=true
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
        path d="M21 12a9 9 0 1 1-6.219-8.56"

// Button xs, variant outline or ghost-muted: 24pt, text-xs medium.
component UpkeepButton
  props
    label: string
    outline: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(inside: bool)
    over = inside
  view
    button press=press hover=hover disabled=disabled id=testId testId=testId height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(outline ? "light-dark(#d4d4d8, #ffffff14)" : "#00000000") flex-shrink=0 opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.25rem" background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0f)" : outline ? "light-dark(#ffffff, #ffffff08)" : "#00000000")
      text label font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color=(outline ? "light-dark(#27272a, #f5f5f5)" : (over and not disabled ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)"))

// ui/select: a trigger (`height` sm 28pt, xs/compact 24pt) and its listbox popup, each option checked when selected.
component UpkeepSelect
  props
    selectId: string
    label: string
    valueLabel: string
    width: string
    small: bool
    disabled: bool
    options: list<UpkeepOption>
    choose: action
  action dismiss
    focus(selectId)
  view
    box position="relative" flex-shrink=0
      button popovertarget=`${selectId}-menu` role="combobox" aria-label=label aria-haspopup="listbox" disabled=disabled id=selectId testId=selectId display="flex" flex-direction="row" align-items="center" gap="0.25rem" width=width height=(small ? "1.5rem" : "1.75rem") padding-left=(small ? "0.4375rem" : "0.5625rem") padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" opacity=(disabled ? 0.64 : 1)
        text valueLabel font-size=(small ? "0.75rem" : "0.875rem") line-height="1rem" flex=1 min-width=0 line-clamp=1 text-align="left" color="light-dark(#27272a, #f5f5f5)"
        CnGlyph(name="chevron-down", size=12, color="light-dark(#71717b, #818181)")
      column id=`${selectId}-menu` popover="auto" position="absolute" top="100%" left=0 margin-top="0.25rem" min-width=width
        column padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff2, #171717f2)" backdrop-filter="blur(12px)" box-shadow="0 16px 40px -18px #0000008c" role="listbox" aria-modal=true aria-label=label testId=`${selectId}-menu`
          button press=dismiss popovertarget=`${selectId}-menu` popovertargetaction="hide" aria-keyshortcuts="Escape" aria-label="Close" tabindex=-1 position="absolute" left=0 top=0 width=0 height=0 padding=0 border-width=0 overflow="hidden" background-color="#00000000" title=""
          each option in options key=option.value
            UpkeepSelectOption(option=option, menuId=`${selectId}-menu`, testId=`${selectId}-option-${option.value}`, choose=choose(option.value))

component UpkeepSelectOption
  props
    option: UpkeepOption
    menuId: string
    testId: string
    choose: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    button press=choose popovertarget=menuId popovertargetaction="hide" hover=hover role="option" aria-selected=option.selected testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      row flex=1 min-width=0 gap="0.5rem" align-items="baseline"
        text option.label font-family=(option.note != "" ? "ui-monospace" : "system-ui") font-size=(option.note != "" ? "0.75rem" : "0.875rem") line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
        when option.note != ""
          text option.note font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" white-space="nowrap"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
        when option.selected
          CnGlyph(name="check", size=14, color="light-dark(#27272a, #f5f5f5)")

// versionAdvisoryNode: the advisory icon (icon-micro in a list row, icon-xs in the editor) with
// its tooltip, and the details popover below it, end-aligned (side="bottom" align="end", w-80).
// The tooltip (TooltipPopup side="top") is the window's hover layer's (hover-layer.contract): drawn
// here it opened above the icon inside the list's or the editor's scroll area and was cut off (#251).
component ProviderVersionAdvisory
  inject
    rem: number
    hoverTipAt: action
  props
    advisory: ProviderAdvisory
    op: action
  state over = false
  state copyOver = false
  action hover(inside: bool)
    over = inside
    tip(inside)
  action copyHover(inside: bool)
    copyOver = inside
  action dismiss
    focus(`${advisory.popId}-trigger`)
  // Base UI's tooltip closes when its trigger is pressed (closeOnClick).
  action pressed
    over = false
    tip(false)
  action tip(inside: bool)
    hoverTipAt(hoverTipAtFrame(`${advisory.popId}-tip`, "tip", advisory.title, [], "top", "center", frame(`${advisory.popId}-trigger`), 1.625 * rem, `${advisory.popId}-tip`), "trigger", inside)
  derive list = advisory.mode == "list"
  view
    box position="relative" flex-shrink=0 pointer-events="auto" hover=hover
      button press=pressed popovertarget=advisory.popId aria-label=advisory.label aria-haspopup="dialog" id=`${advisory.popId}-trigger` testId=`provider-advisory-${advisory.mode}-${advisory.instanceId}` class=(list ? PvMicro : PvIconButton) background-color=(over ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") title=""
        PvIcon(name=(advisory.warning ? "warning" : "update"), size=(list ? 14 : 16), color=(advisory.warning ? "#fe9a00" : (over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")))
      // side="bottom" align="end": the popup's right edge meets the trigger's (X17: no end-aligned area, so offset by the widths;
      // the Apple host applies a popover's margins only when it names an area, and `bottom span-right` is D2's own placement).
      column id=advisory.popId popover="auto" position="absolute" position-area="bottom span-right" margin-top="0.25rem" margin-left=(list ? "-18.75rem" : "-18.5rem") width="20rem"
        // Modal while open, so Escape closes it (and returns to the icon) instead of reaching Settings' Back.
        column width="100%" padding="1rem" gap="0.75rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff2, #171717f2)" backdrop-filter="blur(12px)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-modal=true aria-label=advisory.title testId=`${advisory.popId}-popover`
          button press=dismiss popovertarget=advisory.popId popovertargetaction="hide" aria-keyshortcuts="Escape" aria-label="Close" tabindex=-1 position="absolute" left=0 top=0 width=0 height=0 padding=0 border-width=0 overflow="hidden" background-color="#00000000" testId=`${advisory.popId}-escape` title=""
          column gap="0.125rem" min-width=0
            text advisory.title font-size="0.875rem" line-height="1.09375rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" testId=`${advisory.popId}-title`
            text advisory.detail font-size="0.75rem" line-height="1.03125rem" color=(advisory.strong ? "light-dark(#e17100, #fdb022)" : "light-dark(#71717b, #818181)") testId=`${advisory.popId}-detail`
          when advisory.action != ""
            button press=op("upkeep:update", advisory.instanceId, "", advisory.target, true) class=PvOutline width="100%" height="1.5rem" font-size="0.75rem" disabled=advisory.updating opacity=(advisory.updating ? 0.64 : 1) testId=`${advisory.popId}-action`
              when advisory.updating
                UpkeepSpinner(size=14, color="light-dark(#27272a, #f5f5f5)")
              else
                PvIcon(name="download", size=14, color="light-dark(#27272a, #f5f5f5)")
              text advisory.action font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          when advisory.divider
            row width="100%" gap="0.5rem" align-items="center"
              box flex=1 height=1 background-color="light-dark(#e4e4e7, #ffffff14)" aria-hidden=true
              text "or, update manually using" text-transform="uppercase" letter-spacing=0.05 font-size="0.5625rem" line-height="0.75rem" font-weight=500 color="light-dark(#71717b, #818181)"
              box flex=1 height=1 background-color="light-dark(#e4e4e7, #ffffff14)" aria-hidden=true
          when advisory.command != ""
            row width="100%" min-width=0 gap="0.25rem" align-items="center" padding-top="0.125rem" padding-bottom="0.125rem" padding-right="0.125rem" padding-left="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#f4f4f566, #ffffff0a)"
              text advisory.command font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" flex=1 min-width=0 line-clamp=1 color="light-dark(#27272a, #f5f5f5)" testId=`${advisory.popId}-command`
              box position="relative" flex-shrink=0 hover=copyHover
                button press=op("upkeep:copy-command", advisory.instanceId, "", "", true) class=PvIconButton aria-label="Copy update command" testId=`${advisory.popId}-copy` title=""
                  PvIcon(name="copy", size=12, color="light-dark(#71717b, #818181)")
                when copyOver
                  CnTooltip(tip="Copy command", tipId=`${advisory.popId}-copy-tip`, above=28)

// ProviderUpdatesAction: "Update all" (ghost-muted xs) with the machines it would update.
component ProviderUpdatesAllButton
  props
    updateAll: ProviderUpdateAll
    op: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    box position="relative" flex-shrink=0 hover=hover
      button press=op("upkeep:update-all", "", "", "", true) class=PvGhost disabled=updateAll.pending opacity=(updateAll.pending ? 0.64 : 1) background-color=(over and not updateAll.pending ? "light-dark(#f4f4f5, #ffffff0f)" : "#00000000") testId="providers-update-all"
        text updateAll.label font-size="0.75rem" line-height="1rem" font-weight=500 color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
      when over and updateAll.tip != ""
        CnTooltip(tip=updateAll.tip, tipId="providers-update-all-tip", above=28)

// The URL authentication action under the editor's status line: message, URL, the link.
component ProviderUrlAuth
  props
    auth: UpkeepUrlAuth
    instanceId: string
    op: action
  view
    column max-width="36rem" gap="0.375rem" padding-top="0.25rem" testId=`provider-url-auth-${instanceId}`
      text auth.message font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      text auth.url font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" overflow-wrap="anywhere" color="light-dark(#71717b, #818181)" testId=`provider-url-auth-url-${instanceId}`
      button press=op("upkeep:acp-url-auth", instanceId, auth.elicitationId, auth.url, true) role="link" class=PvOutline height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" align-self="flex-start" testId=`provider-url-auth-continue-${instanceId}`
        PvIcon(name="external", size=14, color="light-dark(#27272a, #f5f5f5)")
        text "Continue authentication" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"

// AcpSessionManagementSection: Native sessions (Log out, the project, List sessions, the
// sessions with Import and Delete, Load more) and Agent providers (protocol, base URL,
// write-only headers, Save, Disable). Delete and Disable ask first (`ui`).
component AcpManagement
  props
    acp: AcpSection
    wide: bool
    op: action
    ui: action
  action pickProject(value: string)
    op("upkeep:acp-project", acp.instanceId, "", value, true)
  view
    column width="100%" border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)" testId=`acp-management-${acp.instanceId}`
      PvRow(title="Native sessions", description="Resume agent-owned conversations as T3 threads.", status=acp.status, policy="", wide=wide, divided=false)
        row gap="0.5rem" align-items="center" flex-wrap="wrap" justify-content=(wide ? "flex-end" : "flex-start")
          when acp.canLogout
            button press=op("upkeep:acp-logout", acp.instanceId, "", "", true) class=PvOutline disabled=acp.logoutDisabled opacity=(acp.logoutDisabled ? 0.64 : 1) testId=`acp-logout-${acp.instanceId}`
              text acp.logoutLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          when acp.showPicker
            UpkeepSelect(selectId=`acp-project-${acp.instanceId}`, label="Project for ACP sessions", valueLabel=acp.projectTitle, width="10rem", small=false, disabled=acp.pickerDisabled, options=acp.projects, choose=pickProject)
            button press=op("upkeep:acp-list", acp.instanceId, "", "", true) class=PvOutline disabled=acp.listDisabled opacity=(acp.listDisabled ? 0.64 : 1) testId=`acp-list-${acp.instanceId}`
              text acp.listLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
      when acp.showList
        column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-bottom="0.75rem" gap="0.75rem"
          when length(acp.sessions) > 0
            column width="100%" border-top-style="solid" border-bottom-style="solid" border-top-width=1 border-bottom-width=1 border-color="light-dark(#e4e4e799, #ffffff0f)" testId=`acp-sessions-${acp.instanceId}`
              each session in acp.sessions key=session.key
                row width="100%" min-width=0 gap="0.75rem" padding-top="0.5rem" padding-bottom="0.5rem" align-items="center" justify-content="space-between" border-top-style="solid" border-top-width=(session.first ? 0 : 1) border-color="light-dark(#e4e4e799, #ffffff0f)" testId=`acp-session-${session.sessionId}`
                  column min-width=0 flex-shrink=1
                    text session.title font-size="0.75rem" line-height="1rem" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
                    text session.sessionId font-family="ui-monospace" font-size="0.625rem" line-height="0.875rem" line-clamp=1 color="light-dark(#71717b, #818181)"
                  row flex-shrink=0 gap="0.25rem" align-items="center"
                    UpkeepButton(label=session.importLabel, outline=false, disabled=session.importDisabled, press=op("upkeep:acp-import", acp.instanceId, session.sessionId, "", true), testId=`acp-import-${session.sessionId}`)
                    when session.canDelete
                      UpkeepButton(label=session.deleteLabel, outline=false, disabled=session.deleteDisabled, press=ui("acp-delete", session.confirmKey), testId=`acp-delete-${session.sessionId}`)
          when acp.showMore
            row width="100%"
              UpkeepButton(label=acp.moreLabel, outline=false, disabled=acp.moreDisabled, press=op("upkeep:acp-more", acp.instanceId, "", "", true), testId=`acp-more-${acp.instanceId}`)
      when acp.canConfigure
        column width="100%" box-sizing="border-box" padding="0.75rem" padding-left="1rem" padding-right="1rem" gap="0.75rem" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e799, #ffffff0f)" testId=`acp-providers-${acp.instanceId}`
          row width="100%" gap="0.5rem" align-items="center" justify-content="space-between" flex-wrap="wrap"
            column min-width=0
              text "Agent providers" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=4
              text "Configure non-secret routing. Headers are write-only." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
            UpkeepButton(label=acp.providersLabel, outline=true, disabled=acp.providersDisabled, press=op("upkeep:acp-providers", acp.instanceId, "", "", true), testId=`acp-list-providers-${acp.instanceId}`)
          when acp.showProviderPicker
            UpkeepSelect(selectId=`acp-provider-project-${acp.instanceId}`, label="Project for ACP providers", valueLabel=acp.projectTitle, width="12rem", small=true, disabled=acp.pickerDisabled, options=acp.projects, choose=pickProject)
          when length(acp.providers) > 0
            column width="100%" border-top-style="solid" border-bottom-style="solid" border-top-width=1 border-bottom-width=1 border-color="light-dark(#e4e4e799, #ffffff0f)"
              each provider in acp.providers key=provider.key
                AcpProviderEditor(provider=provider, instanceId=acp.instanceId, wide=wide, op=op, ui=ui)

// One configurable ACP provider: its drafts arrive as ops on each change (acp-sessions.ts).
component AcpProviderEditor
  props
    provider: AcpProviderRow
    instanceId: string
    wide: bool
    op: action
    ui: action
  state url = ""
  state urlEdited = false
  state headers = ""
  state headersEdited = false
  action editUrl(value: string)
    url = value
    urlEdited = true
    op("upkeep:acp-draft-url", instanceId, provider.providerId, value, true)
  action editHeaders(value: string)
    headers = value
    headersEdited = true
    op("upkeep:acp-draft-headers", instanceId, provider.providerId, value, true)
  action pickProtocol(value: string)
    op("upkeep:acp-draft-api", instanceId, provider.providerId, value, true)
  view
    column width="100%" gap="0.5rem" padding-top="0.75rem" padding-bottom="0.75rem" border-top-style="solid" border-top-width=(provider.first ? 0 : 1) border-color="light-dark(#e4e4e799, #ffffff0f)" testId=`acp-provider-${provider.providerId}`
      row width="100%" gap="0.5rem" align-items="center" justify-content="space-between"
        column min-width=0
          text provider.providerId font-size="0.75rem" line-height="1rem" font-weight=500 line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
          text provider.status font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717b, #818181)"
        row gap="0.25rem" align-items="center"
          UpkeepButton(label=provider.saveLabel, outline=true, disabled=provider.saveDisabled, press=op("upkeep:acp-save", instanceId, provider.providerId, "", true), testId=`acp-provider-save-${provider.providerId}`)
          when provider.showDisable
            UpkeepButton(label="Disable", outline=false, disabled=provider.disableDisabled, press=ui("acp-disable", provider.confirmKey), testId=`acp-provider-disable-${provider.providerId}`)
      row width="100%" gap="0.5rem" flex-direction=(wide ? "row" : "column") align-items=(wide ? "center" : "stretch")
        UpkeepSelect(selectId=`acp-provider-protocol-${provider.providerId}`, label=`${provider.providerId} protocol`, valueLabel=provider.apiType, width="9rem", small=false, disabled=provider.fieldsDisabled, options=provider.protocols, choose=pickProtocol)
        input value=(urlEdited ? url : provider.baseUrl) input=editUrl type="url" placeholder="https://api.example.com" aria-label=`${provider.providerId} base URL` autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 disabled=provider.fieldsDisabled testId=`acp-provider-url-${provider.providerId}`
      input value=(headersEdited ? headers : provider.headers) input=editHeaders type="password" autocomplete="off" placeholder="Write-only headers JSON, e.g. {\"Authorization\":\"Bearer …\"}" aria-label=`${provider.providerId} write-only headers JSON` class=PvField width="100%" min-width=0 disabled=provider.fieldsDisabled testId=`acp-provider-headers-${provider.providerId}`

// The ACP Delete and Disable confirmations (dialogs.confirm, variant destructive): the
// question is the title; Cancel and Escape send nothing and return focus to the button.
component AcpConfirm
  props
    title: string
    instanceId: string
    what: string
    target: string
    busy: bool
    op: action
    ui: action
  action accept
    ui("close", "")
    op(what == "acp-delete" ? "upkeep:acp-delete" : "upkeep:acp-disable", instanceId, target, "", true)
  action cancel
    ui("close", "")
    focus(what == "acp-delete" ? `acp-delete-${target}` : `acp-provider-disable-${target}`)
  view
    AppConfirm(title=title, body="", destructive=true, busy=busy, confirmId="acp-confirm", cancel=cancel, confirm=accept)

// CustomModelEditor: Display name, the options shown in the composer (each an id, a label, a
// type and, for choices, value/label/default rows), Copy from…, presets, Save and Cancel.
component CustomModelEditor
  props
    editor: CmEditor
    op: action
  state name = ""
  state nameEdited = false
  action editName(value: string)
    name = value
    nameEdited = true
    op("upkeep:cm-text", editor.instanceId, "name", value, true)
  action copyFrom(slug: string)
    op("upkeep:cm-copy-from", editor.instanceId, slug, "", true)
  view
    column margin-left="0.5rem" margin-right="0.5rem" margin-top="0.25rem" margin-bottom="0.5rem" gap="0.75rem" padding="0.75rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#f4f4f533, #ffffff05)" testId=`custom-model-editor-${editor.slug}`
      column gap="0.25rem"
        text "Display name" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        input value=(nameEdited ? name : editor.name) input=editName placeholder=editor.slug aria-label="Display name" autofocus=true spellcheck="false" autocorrect="off" class=PvField width="18rem" max-width="100%" testId=`custom-model-name-${editor.slug}`
      column gap="0.5rem"
        row width="100%" gap="0.5rem" align-items="center" justify-content="space-between" flex-wrap="wrap"
          text "Options shown in the composer" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          when length(editor.copyFrom) > 0
            UpkeepSelect(selectId=`custom-model-copy-${editor.slug}`, label="Copy options from a built-in model", valueLabel="Copy from…", width="11rem", small=true, disabled=false, options=editor.copyFrom, choose=copyFrom)
        when editor.empty
          text "No custom options. The composer uses the provider's default options." font-size="0.75rem" line-height="1rem" color="light-dark(#71717bb3, #818181b3)" testId=`custom-model-empty-${editor.slug}`
        each descriptor in editor.descriptors key=descriptor.key
          CustomModelOption(descriptor=descriptor, instanceId=editor.instanceId, hasPresets=editor.hasPresets, op=op)
        row gap="0.25rem" flex-wrap="wrap"
          each preset in editor.addPresets key=preset.id
            button press=op("upkeep:cm-add-option", editor.instanceId, preset.id, "", true) class=PvGhost testId=`custom-model-add-${preset.id}`
              PvIcon(name="plus", size=12, color="light-dark(#71717b, #818181)")
              text preset.label font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
          button press=op("upkeep:cm-add-option", editor.instanceId, "", "", true) class=PvGhost testId="custom-model-add-custom"
            PvIcon(name="plus", size=12, color="light-dark(#71717b, #818181)")
            text "Custom option" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
      when editor.error != ""
        text editor.error font-size="0.75rem" line-height="1rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="custom-model-error"
      row gap="0.5rem"
        button press=op("upkeep:cm-save", editor.instanceId, "", "", true) class=PvOutline testId="custom-model-save"
          text "Save" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        button press=op("upkeep:cm-cancel", editor.instanceId, "", "", true) class=PvGhost height="1.75rem" aria-keyshortcuts="Escape" testId="custom-model-cancel-edit"
          text "Cancel" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"

// One option of the editor: `Option N`, the id (a preset or Custom…), the label, the type, remove;
// a choices option lists its values. Typing keeps this row; a preset or type change redraws it.
component CustomModelOption
  props
    descriptor: CmDescriptor
    instanceId: string
    hasPresets: bool
    op: action
  state id = ""
  state idEdited = false
  state label = ""
  state labelEdited = false
  action editId(value: string)
    id = value
    idEdited = true
    op("upkeep:cm-text", instanceId, `d:${descriptor.ref}:id`, value, true)
  action editLabel(value: string)
    label = value
    labelEdited = true
    op("upkeep:cm-text", instanceId, `d:${descriptor.ref}:label`, value, true)
  action pickId(value: string)
    op("upkeep:cm-preset-id", instanceId, descriptor.ref, value, true)
  action pickType(value: string)
    op("upkeep:cm-type", instanceId, descriptor.ref, value, true)
  view
    column gap="0.5rem" padding="0.625rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e799, #ffffff0f)" background-color="light-dark(#fcfcfc66, #0a0a0a66)" testId=`custom-model-option-${descriptor.index}`
      row gap="0.5rem" align-items="center" flex-wrap="wrap"
        text descriptor.position width="3.5rem" flex-shrink=0 font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        when hasPresets
          UpkeepSelect(selectId=`custom-model-option-id-${descriptor.ref}`, label="Option id", valueLabel=descriptor.idSelectLabel, width="10rem", small=true, disabled=false, options=descriptor.idOptions, choose=pickId)
        when descriptor.customId
          input value=(idEdited ? id : descriptor.id) input=editId placeholder="optionId" aria-label="Option id" spellcheck="false" autocorrect="off" class=PvField width="9rem" height="1.75rem" font-family="ui-monospace" font-size="0.75rem" testId=`custom-model-option-id-input-${descriptor.index}`
        input value=(labelEdited ? label : descriptor.label) input=editLabel placeholder="Label" aria-label="Option label" class=PvField flex=1 min-width="6rem" font-size="0.75rem" testId=`custom-model-option-label-${descriptor.index}`
        UpkeepSelect(selectId=`custom-model-option-type-${descriptor.ref}`, label="Option type", valueLabel=descriptor.typeLabel, width="6rem", small=true, disabled=false, options=descriptor.typeOptions, choose=pickType)
        button press=op("upkeep:cm-remove-option", instanceId, descriptor.ref, "", true) class=PvMicro aria-label=`Remove option ${descriptor.index + 1}` testId=`custom-model-remove-option-${descriptor.index}` title=""
          PvIcon(name="x", size=12, color="light-dark(#71717b, #818181)")
      when descriptor.isSelect
        column gap="0.375rem" padding-left="4rem"
          each choice in descriptor.choices key=choice.key
            CustomModelChoice(choice=choice, instanceId=instanceId, op=op)
          button press=op("upkeep:cm-add-choice", instanceId, descriptor.ref, "", true) class=PvGhost align-self="flex-start" margin-left="-0.5rem" testId=`custom-model-add-choice-${descriptor.index}`
            PvIcon(name="plus", size=12, color="light-dark(#71717b, #818181)")
            text "Add choice" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"

component CustomModelChoice
  props
    choice: CmChoice
    instanceId: string
    op: action
  state id = ""
  state idEdited = false
  state label = ""
  state labelEdited = false
  action editId(value: string)
    id = value
    idEdited = true
    op("upkeep:cm-text", instanceId, `c:${choice.ref}:id`, value, true)
  action editLabel(value: string)
    label = value
    labelEdited = true
    op("upkeep:cm-text", instanceId, `c:${choice.ref}:label`, value, true)
  view
    row gap="0.5rem" align-items="center" testId=`custom-model-choice-${choice.ref}`
      input value=(idEdited ? id : choice.id) input=editId placeholder="value" aria-label="Choice value" spellcheck="false" autocorrect="off" class=PvField width="7rem" font-family="ui-monospace" font-size="0.75rem"
      input value=(labelEdited ? label : choice.label) input=editLabel placeholder="Label" aria-label="Choice label" class=PvField flex=1 min-width=0 font-size="0.75rem"
      row gap="0.375rem" align-items="center" flex-shrink=0
        button press=op("upkeep:cm-default", instanceId, choice.ref, (choice.isDefault ? "false" : "true"), true) role="switch" aria-checked=choice.isDefault aria-label="Default choice" width="1.625rem" height="1rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(choice.isDefault ? "flex-end" : "flex-start") flex-shrink=0 background-color=(choice.isDefault ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") title=""
          box width="0.75rem" height="0.75rem" border-radius="624.9375rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
        text "Default" font-size="0.625rem" line-height="0.875rem" color="light-dark(#71717b, #818181)"
      button press=op("upkeep:cm-remove-choice", instanceId, choice.ref, "", true) class=PvMicro aria-label="Remove choice" title=""
        PvIcon(name="x", size=12, color="light-dark(#71717b, #818181)")
