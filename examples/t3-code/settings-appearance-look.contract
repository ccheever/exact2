// The snapshot's `look` (settings-appearance-look.ts): device appearance and
// behaviour settings every surface reads — theme palette tokens, chat width,
// diff colours, environment identification, fonts and confirmations.
shape Look
  themed: bool
  mode: string
  canvas: string
  sidebar: string
  sidebarBorder: string
  sidebarText: string
  sidebarMuted: string
  rowActive: string
  surface: string
  popover: string
  border: string
  input: string
  text: string
  muted: string
  accent: string
  accentText: string
  message: string
  chatMax: number
  artwork: bool
  pill: string
  diff: string
  diffAdd: string
  diffDel: string
  diffAddSurface: string
  diffDelSurface: string
  diffAddLine: string
  diffDelLine: string
  terminalLight: string
  terminalDark: string
  terminalFont: string
  terminalSize: number
  fontSans: string
  fontSize: number
  // The Prompt font size in px (--font-size-prompt): the composer's text does not follow the root size.
  promptSize: number
  codeFont: string
  codeSize: number
  wordWrap: bool
  smoothing: bool
  panelMs: number
  contextStrip: bool
  contextMeter: bool
  richText: bool
  skillsInSlash: bool
  followUp: string
  legacySidebar: bool
  confirmUnpin: bool
  confirmArchive: bool
  confirmDelete: bool

// The sidebar wordmark off the stage artwork (SidebarBrand: text-foreground,
// "Code" muted), for the Version pill and None identification modes.
component LookWordmark
  props
    ink: string
    muted: string
  view
    row gap="0.25rem" align-items="center" height="1.75rem"
      svg width="1.019375rem" height="0.61875rem" viewBox="15.5309 37 94.3941 56.96" aria-hidden=true
        path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z" fill=ink
      text "Code" font-size="0.875rem" font-weight=500 letter-spacing=-0.35 color=muted

// Badge size sm variant secondary: the environment's stage, beside the brand
// (sm: h-4, px 3 inside a transparent 1pt border, 10pt medium leading-none,
// rounded .25rem; bg-secondary; measured on the f870c41 reference). The row's
// 11pt gap plus this 1pt margin is the reference's gap-x-2 + ml-1.
component LookPill
  props
    label: string
  view
    text label font-size="0.625rem" font-weight=500 line-height="0.625rem" margin-left=1 height="1rem" box-sizing="border-box" padding-top="0.125rem" padding-bottom="0.125rem" padding-left="0.1875rem" padding-right="0.1875rem" border-width=1 border-style="solid" border-color="#00000000" border-radius="0.25rem" background-color="light-dark(#fafafa, #ffffff08)" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" flex-shrink=0 testId="environment-identification-pill"

// index.css diff tokens per Diff colors: red & green (@pierre/diffs' measured
// stock colours) or blue & orange (:root[data-diff-color-scheme="blue-orange"],
// blue-600/400 and orange-600/400 over the same surfaces).
fn diffInk(scheme: string, role: string): string = role == "add" ? (scheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#18a46c, #07c480)") : role == "del" ? (scheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#d52c36, #ff2e3f)") : role == "add-row" ? (scheme == "blue-orange" ? "light-dark(#eff6ff, #0f151c)" : "light-dark(#ecf9f4, #0c1713)") : role == "del-row" ? (scheme == "blue-orange" ? "light-dark(#fff7ed, #1c140c)" : "light-dark(#fef0f0, #1c100f)") : role == "add-gutter" ? (scheme == "blue-orange" ? "light-dark(#eff6ff, #0f151c)" : "light-dark(#eef9f5, #0e1713)") : role == "del-gutter" ? (scheme == "blue-orange" ? "light-dark(#fff7ed, #1c140c)" : "light-dark(#fef1f0, #1c110f)") : role == "del-bar" ? (scheme == "blue-orange" ? "light-dark(#ffedd4, #3a240c)" : "light-dark(#fce5e2, #381916)") : role == "add-mark" ? (scheme == "blue-orange" ? "light-dark(#bedbff, #1c324a)" : "light-dark(#ccece0, #0b3a29)") : role == "del-mark" ? (scheme == "blue-orange" ? "light-dark(#ffd6a7, #4a2a0c)" : "light-dark(#f8d3d4, #491619)") : role == "add-text" ? (scheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#00a63e, #05df72)") : role == "del-text" ? (scheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#e7000b, #ff6467)") : role == "add-count" ? (scheme == "blue-orange" ? "light-dark(#155dfc, #51a2ff)" : "light-dark(#00bc7d, #00d492)") : role == "del-count" ? (scheme == "blue-orange" ? "light-dark(#f54900, #ff8904)" : "light-dark(#fb2c36, #ff6467)") : "#00000000"
