// The Usage page (lane "pages"), measured against the served reference at
// 1280×840 and 840×620: UsagePage's header (breadcrumb, metric and period
// toggles or selects, refresh), the cost/tokens summary with the provider
// chart, Totals, Breakdown, and the Limits view. T3 Code, MIT (LICENSE-T3).
use Icon from "./icons.contract"
use R5Probe from "./r5-composer.contract"
use R5TextProbes from "./r5-composer.contract"
use ProviderMark from "./icons.contract"
use DriverMark from "./provider-icons.contract"
use PgIcon from "./pages-icons.contract"
use UsageChart from "./pages-usage-shapes.contract"
use UsageShare from "./pages-usage-shapes.contract"
use UsageModelDetail from "./pages-usage-shapes.contract"
use UsagePrices from "./pages-usage-shapes.contract"
use UsageShareBar from "./pages-usage-shapes.contract"
use ChatGptUsageButton from "./codex-setup.contract"
use UsagePooled, PooledView from "./usage-pooled.contract" // usage-pooled-view
use CnTooltip from "./settings-b-kit.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"
use KeyMenuOpen from "./menu-keys.contract"
use kmBump from "./menu-keys.contract"

keyframes usageSpin
  from rotate=0
  to rotate=360

shape UsageText
  key: string
  text: string
shape UsageProviderRow
  key: string
  driver: string
  label: string
  light: string
  dark: string
  sessions: string
  value: string
  detail: string
  // usage-pooled-view: a CursorEnableRow (its environment id) in place of a provider's figures.
  enable: string
  enableLabel: string
  busy: bool
shape UsageTotal
  key: string
  label: string
  value: string
shape UsageModelRow
  key: string
  rank: string
  row: number
  driver: string
  model: string
  cost: string
  share: string
  tokens: string
  unpriced: bool
  bar: number
  light: string
  dark: string
shape UsageColumn
  key: string
  label: string
shape UsagePeriodRow
  key: string
  label: string
  cells: list<UsageText>
  total: string
  tokens: string
// One environment of the filter (usage-pooled-view: every connected one, and those that are not, disabled).
shape UsageEnvRow
  key: string
  label: string
  checked: bool
  disabled: bool
  status: string
shape UsageView
  // managed-codex-chatgpt: a selected environment shares a ChatGPT plan (UsagePage.tsx:543-548).
  chatgptShared: bool
  metric: string
  windowDays: number
  breakdown: string
  plotWidth: number
  menuWidth: number
  // r5-composer: the menus' texts to measure (r5-composer-menus.ts checkMenu).
  menuProbes: list<R5Probe>
  empty: string
  error: string
  environmentLabel: string
  allSelected: bool
  environments: list<UsageEnvRow>
  // UsageEnvironmentFilter's glyph: "pending" while selected environments scan, "issue" when one failed.
  environmentIcon: string
  environmentPending: string
  partial: string
  refreshing: bool
  windowLabel: string
  total: string
  sessions: string
  unpriced: string
  notices: list<UsageText>
  providers: list<UsageProviderRow>
  chartTitle: string
  chart: UsageChart
  totals: list<UsageTotal>
  models: list<UsageModelRow>
  shares: list<UsageShare>
  detail: UsageModelDetail
  prices: UsagePrices
  periodLabel: string
  columns: list<UsageColumn>
  periods: list<UsagePeriodRow>
  pooled: PooledView
  coverage: list<UsageText>
shape UsageKey
  id: string
  chord: string
  kind: string
  value: string
  days: number
  label: string

// Whether a viewport point lies in a box `frame()` read (a missing box is 0 by 0 and holds none).
fn usageHit(g: Geometry, x: number, y: number): bool = x >= g.x and x < g.x + g.width and y >= g.y and y < g.y + g.height

component UsagePage
  inject
    rem: number
  props
    // desktop-shell-details: --workspace-controls-left (90 beside the traffic lights; 0.75rem in full screen).
    controlsLeft: number
    page: UsageView
    keys: list<UsageKey>
    scheme: string
    wide: bool
    lg: bool
    md: bool
    sm: bool
    sidebarOpen: bool
    keySidebar: string
    toggleSidebar: action
    op: action
    setMetric: action
    setWindow: action
    setBreakdown: action
    reload: action
    back: action
    // usage-pooled-view: the reset credit confirm's commands report the focus back (app.contract commandCompleted).
    command: action
    // popover-escape-parity: the confirm shows (PagesCover closes it for the page as it is answered).
    confirmOpen: bool
    reduced: bool
    // popover-escape-parity: the window's count of presses outside this page (app-window.contract T3Window).
    outside: number
  // The pooled segments' popovers (usage-pooled.contract): hovered segment, popover or email, and the pressed one.
  // A pinned popover holds until a press outside it (`pinnedAt` is `outside` when it was pinned).
  state overSeg = ""
  state overPop = ""
  state overMail = ""
  state pinned = ""
  state pinnedAt = 0
  state downOutside = false
  derive held = pinnedAt == outside ? pinned : ""
  derive shown = overPop != "" ? overPop : overMail != "" ? overMail : overSeg != "" ? overSeg : held
  action enterSeg(id: string, inside: bool)
    overSeg = inside ? id : (overSeg == id ? "" : overSeg)
  action enterPop(id: string, inside: bool)
    overPop = inside ? id : (overPop == id ? "" : overPop)
  action enterMail(id: string, inside: bool)
    overMail = inside ? id : (overMail == id ? "" : overMail)
  // A press on the popover's own trigger toggles the pin (Base UI's useClick). The pin and the light dismiss
  // below touch only the pin, never the hover states, which the hover helper owns (fix-hover-cards).
  action pin(id: string)
    pinned = held == id ? "" : id
    pinnedAt = outside
  // Light dismiss (Base UI Popover's useDismiss, outsidePressEvent "intentional" for a mouse): a primary
  // press that starts outside the pinned popover's card and both its triggers (the segment, the legend
  // row), and does not end in the card, closes it as the press ends, before that press's own action; a
  // press on another segment then pins that one. Presses on the page come here; the window counts the rest
  // (`outside`).
  action pressDown(e: PointerEvent)
    let seg = frame(`usage-seg-${held}`)
    let pop = frame(`usage-seg-pop-${held}`)
    let leg = frame(`usage-legend-${held}`)
    downOutside = held != "" and e.buttons == 1 and not (usageHit(seg, e.clientX, e.clientY) or usageHit(pop, e.clientX, e.clientY) or usageHit(leg, e.clientX, e.clientY))
  action pressUp(e: PointerEvent)
    let id = held
    let pop = frame(`usage-seg-pop-${id}`)
    if downOutside and not usageHit(pop, e.clientX, e.clientY)
      pinned = ""
    downOutside = false
  // Escape (UsageKeys' one shortcut): a showing popover closes and its segment takes the focus; else the page goes
  // back, blurring the focus first as useEscapeToGoBack does (a field of the floating theme editor keeps none).
  action escape
    if shown != ""
      focus(`usage-seg-${shown}`)
      pinned = ""
      overSeg = ""
      overPop = ""
      overMail = ""
    else
      blur()
      back()
  action redeem(id: string)
    pinned = ""
    overSeg = ""
    overPop = ""
    overMail = ""
    command("pageslocal:usage-pool-reset-ask", id, "", 0)
  view
    column position="absolute" left=0 top=0 right=0 bottom=0 background-color="light-dark(#fcfcfc, #0a0a0a)" inert=(page.detail.open or page.prices.open or confirmOpen) pointerdown=pressDown pointerup=pressUp testId="usage-page"
      UsageKeys(keys=keys, limits=(page.metric == "limits"), dialog=(page.detail.open or page.prices.open or confirmOpen), setMetric=setMetric, setWindow=setWindow, back=escape)
      when wide
        row width="100%" height=52 flex-shrink=0 padding-left=(sidebarOpen ? 1.25 * rem : controlsLeft + 2.5 * rem) padding-right="1.25rem" box-sizing="border-box" align-items="center" gap="0.75rem" position="relative"
          UsageSidebarToggle(sidebarOpen=sidebarOpen, controlsLeft=controlsLeft, keySidebar=keySidebar, toggle=toggleSidebar)
          UsageBreadcrumb(page=page, scheme=scheme, op=op)
          row margin-left="auto" align-items="center" gap="0.5rem" flex-shrink=0
            row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="group" aria-label="Usage metric"
              Segment(label="Cost", pressed=(page.metric == "cost"), disabled=false, press=setMetric("cost"), testId="usage-metric-cost")
              Segment(label="Tokens", pressed=(page.metric == "tokens"), disabled=false, press=setMetric("tokens"), testId="usage-metric-tokens")
              Segment(label="Limits", pressed=(page.metric == "limits"), disabled=false, press=setMetric("limits"), testId="usage-metric-limits")
            row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="group" aria-label="Usage period"
              Segment(label="Past 24h", pressed=(page.windowDays == 1), disabled=(page.metric == "limits"), press=setWindow(1), testId="usage-period-1")
              Segment(label="7 days", pressed=(page.windowDays == 7), disabled=(page.metric == "limits"), press=setWindow(7), testId="usage-period-7")
              Segment(label="30 days", pressed=(page.windowDays == 30), disabled=(page.metric == "limits"), press=setWindow(30), testId="usage-period-30")
              Segment(label="90 days", pressed=(page.windowDays == 90), disabled=(page.metric == "limits"), press=setWindow(90), testId="usage-period-90")
            UsageRefresh(limits=(page.metric == "limits"), busy=page.refreshing, reduced=reduced, reload=reload)
      else
        column width="100%" flex-shrink=0 padding-left=(sidebarOpen ? 1.25 * rem : controlsLeft + 2.5 * rem) padding-right="1.25rem" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" gap="0.5rem" position="relative"
          UsageSidebarToggle(sidebarOpen=sidebarOpen, controlsLeft=controlsLeft, keySidebar=keySidebar, toggle=toggleSidebar)
          row height="1.25rem" align-items="center" gap="0.75rem"
            UsageBreadcrumb(page=page, scheme=scheme, op=op)
          row height="1.75rem" justify-content="flex-end" align-items="center" gap="0.25rem"
            UsageSelect(menuId="usage-metric-select", label=(page.metric == "cost" ? "Cost" : page.metric == "tokens" ? "Tokens" : "Limits"), ariaLabel="Usage metric", disabled=false, scheme=scheme)
              UsageOption(menuId="usage-metric-select", label="Cost", selected=(page.metric == "cost"), press=setMetric("cost"))
              UsageOption(menuId="usage-metric-select", label="Tokens", selected=(page.metric == "tokens"), press=setMetric("tokens"))
              UsageOption(menuId="usage-metric-select", label="Limits", selected=(page.metric == "limits"), press=setMetric("limits"))
            UsageSelect(menuId="usage-period-select", label=(page.windowDays == 1 ? "Past 24h" : page.windowDays == 7 ? "7 days" : page.windowDays == 90 ? "90 days" : "30 days"), ariaLabel="Usage period", disabled=(page.metric == "limits"), scheme=scheme)
              UsageOption(menuId="usage-period-select", label="Past 24h", selected=(page.windowDays == 1), press=setWindow(1))
              UsageOption(menuId="usage-period-select", label="7 days", selected=(page.windowDays == 7), press=setWindow(7))
              UsageOption(menuId="usage-period-select", label="30 days", selected=(page.windowDays == 30), press=setWindow(30))
              UsageOption(menuId="usage-period-select", label="90 days", selected=(page.windowDays == 90), press=setWindow(90))
            UsageRefresh(limits=(page.metric == "limits"), busy=page.refreshing, reduced=reduced, reload=reload)
      scroll flex=1 min-height=0 width="100%" testId="usage-scroll"
        // The ground under and beside the content is the page's too: a press there reaches the page's
        // pointerdown (light dismiss) on macOS, where a press on a scroll view's empty area below or beside
        // its content reaches no node (popover-escape-parity).
        column width="100%" min-height="100%" testId="usage-ground"
          column width="100%" max-width="64rem" margin-left="auto" margin-right="auto" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.5rem" padding-bottom="3rem" box-sizing="border-box" gap="1.5rem"
            when page.empty != ""
              text page.empty font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" testId="usage-empty"
            else
              when page.metric == "limits"
                UsagePooled(view=page.pooled, scheme=scheme, md=md, reduced=reduced, shown=shown, pinned=held, enterSeg=enterSeg, enterPop=enterPop, enterMail=enterMail, pin=pin, redeem=redeem, op=op)
              else
                when page.total == ""
                  UsageSkeleton(lg=lg, md=md)
                else
                  UsageSummary(page=page, scheme=scheme, lg=lg, md=md, sm=sm, setBreakdown=setBreakdown, op=op)

// SidebarControl: the global sidebar toggle sits at the window controls when the sidebar is closed.
component UsageSidebarToggle
  props
    sidebarOpen: bool
    controlsLeft: number
    keySidebar: string
    toggle: action
  view
    when not sidebarOpen
      button press=toggle position="absolute" left=(controlsLeft + 1) top="0.75rem" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" aria-label="Toggle sidebar" aria-keyshortcuts=keySidebar testId="toggle-sidebar"
        Icon(name="panel-left", size=16, color="light-dark(#27272acc, #f5f5f5cc)")

// WorkspaceBreadcrumb: "Usage / All environments", the environment filter menu.
component UsageBreadcrumb
  props
    page: UsageView
    scheme: string
    op: action
  state over = false
  action hover(value: bool)
    over = value
  // fix-keyboard-focus: Enter or Space opens the menu from the keyboard (menu-keys.contract).
  state keyed = 0
  state keyArmed = false
  action keyArm(on: bool)
    keyArmed = on
  action keyOpened(last: bool)
    keyed = kmBump(keyed, last)
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = kmBump(keyed, false)
  view
    row align-items="center" gap="0.75rem" min-width=0 role="navigation" aria-label="Usage breadcrumb"
      text "Usage" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#71717b, #818181)" role="heading" aria-level=1 flex-shrink=0
      text "/" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" flex-shrink=0
      column position="relative" min-width="2.5rem"
        R5TextProbes(probes=page.menuProbes)
        button popovertarget="usage-environment-menu" key=triggerKey focus=keyArm(true) blur=keyArm(false) hover=hover testId="usage-environment" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap="0.125rem" min-width=0
          text page.environmentLabel font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" text-decoration-line=(over ? "underline" : "none") line-clamp=1
          // A dashed circle while selected environments scan, an alert when one failed, else the chevron on hover.
          box width="0.875rem" height="0.875rem" opacity=(over or page.environmentIcon != "" ? 1 : 0) display="flex" role=(page.environmentIcon != "" ? "img" : "none") aria-label=(page.environmentIcon == "pending" ? `${page.environmentPending}${page.partial != "" ? "; totals are partial" : ""}` : page.environmentIcon == "issue" ? "Some environments could not report usage" : "") testId="usage-environment-glyph"
            when page.environmentIcon == "pending"
              PgIcon(name="circle-dashed", size=14, color="light-dark(#71717b, #818181)")
            else when page.environmentIcon == "issue"
              svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" color="light-dark(#bb4d00, #ffb900)" aria-hidden=true
                path d="M22 12a10 10 0 1 1-20 0a10 10 0 1 1 20 0"
                path d="M12 8v4"
                path d="M12 16h.01"
            else
              PgIcon(name="chevron-down", size=14, color="light-dark(#71717b, #818181)")
        KeyMenuOpen(menuId="usage-environment-menu", armed=keyArmed, opened=keyOpened)
        column id="usage-environment-menu" popover="auto" position="absolute" left=0 top=0 padding-top="0.25rem" testId="usage-environment-layer"
          column width=`${page.menuWidth / 16}rem` padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" testId="usage-environment-menu"
            KeyMenu(menuId="usage-environment-keys", items=concat(concat([KmItem(id="usage-environment-all", label="All environments")], map(filter(page.environments, (env) => not env.disabled), (env) => KmItem(id=`usage-environment-${env.key}`, label=env.label))), [KmItem(id="usage-model-prices", label="Model prices")]), keyed=keyed, gap="0px", modal=true)
              CheckRow(label="All environments", status="", checked=page.allSelected, disabled=false, press=op("usage-pool-env", "", ""), testId="usage-environment-all")
              box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff0f)" role="separator"
              each env in page.environments key=env.key
                CheckRow(label=env.label, status=env.status, checked=env.checked, disabled=env.disabled, press=op("usage-pool-env", env.key, ""), testId=`usage-environment-${env.key}`)
              when length(page.environments) == 0
                text "No environments connected." padding="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              when page.partial != "" and page.metric != "limits"
                text page.partial padding="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              when length(page.coverage) > 0 and page.metric != "limits"
                column width="100%" padding="0.5rem" gap="0.25rem" border-top-width=1 border-top-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" box-sizing="border-box"
                  each line in page.coverage key=line.key
                    text line.text font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              box width="calc(100% - 16px)" height=1 margin-left="0.5rem" margin-top="0.25rem" margin-bottom="0.25rem" background-color="light-dark(#e4e4e7, #ffffff0f)" role="separator"
              UsageMenuItem(label="Model prices", icon="sliders-horizontal", press=op("usage-prices-open", "", ""), menuId="usage-environment-menu", testId="usage-model-prices")

// MenuCheckboxItem: a 16pt check column, then the label (and scan status).
component CheckRow
  props
    label: string
    status: string
    checked: bool
    // usage-pooled-view: an environment that is not connected is listed with its phase and cannot be chosen.
    disabled: bool
    press: action
    testId: string
  state over = false
  state lit = false
  action hover(value: bool)
    over = value
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press hover=hover focus=focused(true) blur=focused(false) disabled=disabled opacity=(disabled ? 0.64 : 1) role="menuitemcheckbox" aria-checked=checked testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="1rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(over or lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
        when checked
          PgIcon(name="check", size=14, color="light-dark(#27272a, #f5f5f5)")
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 line-clamp=1 text-align="left"
      when status != ""
        text status margin-left="0.25rem" font-size="0.75rem" line-height="1rem" color=(status == "Unavailable" ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717b, #818181)") flex-shrink=0

// MenuItem: a 16pt muted glyph at 80% (pulled in 2pt), then the label; closes the menu.
component UsageMenuItem
  props
    label: string
    icon: string
    press: action
    menuId: string
    testId: string
  state over = false
  state lit = false
  action hover(value: bool)
    over = value
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press popovertarget=menuId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=testId width="100%" min-height="1.75rem" padding-left="0.375rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.375rem" border-radius="0.375rem" border-width=0 background-color=(over or lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      box opacity=0.8 display="flex"
        PgIcon(name=icon, size=16, color="light-dark(#71717b, #818181)")
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"

// ToggleGroup variant="segmented": a 24pt toggle, raised when pressed.
component Segment
  props
    label: string
    pressed: bool
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled role="radio" aria-checked=pressed testId=testId height="1.5rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color=(pressed ? "light-dark(#fcfcfc, #ffffff0f)" : "#00000000") box-shadow=(pressed ? "0 1px 2px #0000001a" : "none") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" color=(pressed or (over and not disabled) ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// RefreshIcon: busy and disabled while the refresh runs, the glyph turning unless motion is reduced.
component UsageRefresh
  props
    limits: bool
    busy: bool
    reduced: bool
    reload: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=reload hover=hover disabled=busy aria-busy=busy aria-label=(limits ? "Refresh limits" : "Refresh usage") testId="usage-refresh" width="1.75rem" height="1.75rem" padding=0 border-radius="0.5rem" border-width=0 opacity=(busy ? 0.64 : 1) background-color=(over and not busy ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
      box display="flex" animation=(busy and not reduced ? "usageSpin 1s linear infinite" : "none")
        PgIcon(name="refresh-cw", size=14, color="light-dark(#71717b, #818181)")

// The narrow header's SelectTrigger (size compact, ghost) and its popup.
component UsageSelect
  props
    menuId: string
    label: string
    ariaLabel: string
    disabled: bool
    scheme: string
  slot
  state over = false
  action hover(value: bool)
    over = value
  view
    column position="relative"
      button popovertarget=menuId hover=hover disabled=disabled role="combobox" aria-label=ariaLabel testId=menuId height="1.75rem" padding-left="0.6875rem" padding-right="0.1875rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
        text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)" white-space="nowrap"
        PgIcon(name="chevron-down", size=12, color="light-dark(#71717b, #818181)")
      column id=menuId popover="auto" position="absolute" left=0 top=0 padding-top="0.25rem"
        column min-width="8rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="listbox" aria-label=ariaLabel
          children

component UsageOption
  props
    menuId: string
    label: string
    selected: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press popovertarget=menuId popovertargetaction="hide" hover=hover role="option" aria-selected=selected width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(over ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" flex=1 text-align="left" white-space="nowrap"
      box width="1rem" height="1rem" display="flex" align-items="center" justify-content="center"
        when selected
          PgIcon(name="check", size=14, color="light-dark(#27272a, #f5f5f5)")

// usageShortcuts: c / t / l and ⇧⌘1–4 while the page is open, Escape to go back.
component UsageKeys
  props
    keys: list<UsageKey>
    limits: bool
    dialog: bool
    setMetric: action
    setWindow: action
    back: action
  view
    box position="absolute" left=0 top=0 width=0 height=0 overflow="hidden" testId="usage-keys"
      when not dialog
        button press=back aria-keyshortcuts="Escape" aria-label="Back" tabindex=-1 testId="usage-key-back" width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
          text "Back" font-size=1
      each entry in keys key=entry.id
        when entry.kind == "metric"
          button press=setMetric(entry.value) aria-keyshortcuts=entry.chord aria-label=entry.label tabindex=-1 testId=`usage-key-${entry.id}` width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
            text entry.label font-size=1
        when entry.kind == "window" and not limits
          button press=setWindow(entry.days) aria-keyshortcuts=entry.chord aria-label=entry.label tabindex=-1 testId=`usage-key-${entry.id}` width=1 height=1 overflow="hidden" padding=0 border-width=0 background-color="#00000000"
            text entry.label font-size=1

component UsageSummary
  inject
    rem: number
  props
    page: UsageView
    scheme: string
    lg: bool
    md: bool
    sm: bool
    setBreakdown: action
    op: action
  view
    column width="100%" gap="1.5rem"
      each notice in page.notices key=notice.key
        text notice.text font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
      when lg
        row width="100%" gap="1.5rem" align-items="flex-start"
          column width="18rem" flex-shrink=0 gap="1.25rem"
            UsageHeadline(page=page, scheme=scheme, op=op)
          column flex=1 min-width=0 gap="0.75rem"
            text page.chartTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
            UsageChartView(chart=page.chart, width=page.plotWidth, title=page.chartTitle, scheme=scheme)
      else
        column width="100%" gap="1.5rem"
          column width="100%" gap="1.25rem"
            UsageHeadline(page=page, scheme=scheme, op=op)
          column width="100%" gap="0.75rem"
            text page.chartTitle font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
            UsageChartView(chart=page.chart, width=page.plotWidth, title=page.chartTitle, scheme=scheme)
      column width="100%" gap="0.5rem"
        text "Totals" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        row width="100%" flex-wrap=(md ? "nowrap" : "wrap") column-gap="1.5rem" row-gap="1rem" padding-top="0.25rem" padding-bottom="0.25rem"
          each metric in page.totals key=metric.key
            column flex=(md ? 1 : 0) flex-basis=(md ? "0px" : "auto") width=(md ? "auto" : `calc(50% - ${0.75 * rem}px)`) min-width=0 gap="0.125rem"
              text metric.label font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              text metric.value font-size="1rem" line-height="1.5rem" font-weight=500 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
      // Cost (or tokens) by type, and by speed when fast requests ran: grid gap-x-12 gap-y-8 lg:grid-cols-2.
      when length(page.shares) > 0
        box width="100%" display="grid" grid-template-columns=(lg ? "repeat(2, minmax(0, 1fr))" : "minmax(0, 1fr)") column-gap="3rem" row-gap="2rem" testId="usage-shares"
          each bar in page.shares key=bar.key
            UsageShareBar(bar=bar, scheme=scheme)
      column width="100%" gap="0.75rem"
        row width="100%" align-items="center" justify-content="space-between" gap="0.75rem"
          text "Breakdown" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          row height="1.75rem" padding="0.125rem" gap="0.125rem" box-sizing="border-box" border-radius="0.625rem" background-color="light-dark(#d4d4d766, #ffffff08)" align-items="center" role="group" aria-label="Usage breakdown"
            Segment(label="Model", pressed=(page.breakdown == "model"), disabled=false, press=setBreakdown("model"), testId="usage-breakdown-model")
            Segment(label=page.periodLabel, pressed=(page.breakdown == "time"), disabled=false, press=setBreakdown("time"), testId="usage-breakdown-time")
        when page.breakdown == "model"
          ModelTable(page=page, scheme=scheme, sm=sm, op=op)
        else
          PeriodTable(page=page)

component UsageHeadline
  props
    page: UsageView
    scheme: string
    op: action
  view
    column width="100%" gap="0.25rem"
      text page.total font-size="2.25rem" line-height="2.5rem" font-weight=600 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)" testId="usage-total"
      row align-items="center" gap=0
        text (page.metric == "cost" ? `${page.sessions} · API estimate` : page.sessions) font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="pre"
        when page.unpriced != ""
          UnpricedInfo(text=page.unpriced, scheme=scheme)
    when page.chatgptShared
      row width="100%" align-items="center" justify-content="space-between" gap="0.5rem" testId="usage-chatgpt-shared"
        text "ChatGPT shared usage" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
        ChatGptUsageButton(small=true, testId="usage-manage-usage", press=op("usage-chatgpt", "", ""), first=false)
    each provider in page.providers key=provider.key
      when provider.enable != ""
        CursorEnableRow(row=provider, scheme=scheme, op=op)
      else
        column width="100%" gap="0.25rem"
          row width="100%" justify-content="space-between" align-items="flex-end" gap="1rem"
            row min-width=0 align-items="center" gap="0.5rem"
              box width="0.5rem" height="0.5rem" border-radius="624.9375rem" flex-shrink=0 background-color=(scheme == "dark" ? provider.dark : provider.light)
              when provider.driver == "codex"
                ProviderMark(driver="codex", size=16, color="light-dark(#27272a, #f5f5f5)")
              else
                DriverMark(driver=provider.driver, size=16, initials="", icon="")
              row min-width=0 align-items="baseline" gap="0.375rem"
                text provider.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
                text provider.sessions font-size="0.6875rem" line-height="1rem" color="light-dark(#71717b, #818181)" white-space="nowrap" flex-shrink=0 font-variant-numeric="tabular-nums"
            text provider.value font-size="0.875rem" line-height="1.25rem" font-weight=500 flex-shrink=0 font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
          text provider.detail font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// CursorEnableRow (usage-pooled-view): Cursor's dot and mark, then "Enable" (InlineButton) with the
// Keychain copy as its tooltip; it turns on Cursor account usage on that environment.
component CursorEnableRow
  props
    row: UsageProviderRow
    scheme: string
    op: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    row width="100%" min-width=0 justify-content="space-between" align-items="center" gap="1rem" testId=`usage-cursor-row-${row.enable}`
      row min-width=0 align-items="center" gap="0.5rem"
        box width="0.5rem" height="0.5rem" border-radius="624.9375rem" flex-shrink=0 background-color=(scheme == "dark" ? row.dark : row.light)
        DriverMark(driver="cursor", size=16, initials="", icon="")
        text row.label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
      box position="relative" flex-shrink=0 hover=hover
        button press=op("usage-pool-cursor", row.enable, "") disabled=row.busy aria-busy=row.busy aria-label=row.enableLabel testId=`usage-cursor-enable-${row.enable}` padding=0 border-width=0 background-color="#00000000" opacity=(row.busy ? 0.64 : 1) display="flex"
          text "Enable" font-size="0.875rem" line-height="1.25rem" font-weight=500 white-space="nowrap" text-decoration-line=(over ? "underline" : "none") color="light-dark(#27272a, #f5f5f5)"
        when over
          CnTooltip(tip="Requires access to your Cursor login in macOS Keychain.", tipId=`usage-cursor-tip-${row.enable}`, above=24)

// The "Unpriced usage details" info glyph; its hover popover explains the excluded share.
component UnpricedInfo
  props
    text: string
    scheme: string
  view
    column position="relative" margin-left="0.25rem"
      button popovertarget="usage-unpriced" aria-label="Unpriced usage details" testId="usage-unpriced" width="0.75rem" height="0.75rem" padding=0 border-width=0 background-color="#00000000" display="flex"
        PgIcon(name="info", size=12, color="light-dark(#71717b, #818181)")
      // PopoverPopup side="top" (align center, sideOffset 4), placed by position-area (exact2 2c6b551ba).
      column id="usage-unpriced" popover="auto" position="absolute" position-area="top" padding-bottom="0.25rem"
        text text max-width="15rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" border-radius="0.375rem" font-size="0.75rem" line-height="1rem" color="light-dark(#fafafa, #27272a)" background-color="light-dark(#27272a, #f5f5f5)"

// UsageProviderChart: a 56pt axis, the 224pt plot (layered areas at 12%, then
// 2pt lines), and three period labels under it.
component UsageChartView
  props
    chart: UsageChart
    width: number
    title: string
    scheme: string
  view
    column width="100%" gap="0.25rem"
      row width="100%" gap="0.5rem"
        column width="3.5rem" height="14rem" position="relative" flex-shrink=0
          each tick in chart.ticks key=tick.key
            text tick.label position="absolute" right=0 top=(tick.top - 7) font-size="0.625rem" line-height="0.875rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
        box flex=1 min-width=0 height="14rem" overflow="hidden"
          svg width=width height="14rem" viewBox=`0 0 ${width} 224` role="img" aria-label=`${title} by provider` testId="usage-chart"
            each tick in chart.ticks key=tick.key
              path d=`M0 ${tick.top}H${width}` stroke=(scheme == "dark" ? "#ffffff0f" : "#e4e4e7") stroke-width=1 fill="none"
            each series in chart.series key=series.key
              path d=series.area fill=(scheme == "dark" ? series.dark : series.light) fill-opacity=0.12 stroke="none"
            each series in chart.series key=series.key
              path d=series.line fill="none" stroke=(scheme == "dark" ? series.dark : series.light) stroke-width=2
      row width="100%" padding-left="4rem" box-sizing="border-box" justify-content="space-between"
        text chart.start font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #818181)"
        text chart.middle font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #818181)"
        text chart.end font-size="0.625rem" line-height="0.875rem" text-transform="uppercase" color="light-dark(#71717b, #818181)"

// Breakdown → Model (UsagePage, e8545b293b): a table laid out as a grid so the
// rank and number columns take their content and the model column the rest.
// Each row is a button over the whole row (the reference's after:inset-0
// overlay); focus or hover shows as the row's bg-muted/50 fill.
component ModelTable
  props
    page: UsageView
    scheme: string
    sm: bool
    op: action
  state hovered = ""
  action hover(rowKey: string, over: bool)
    hovered = over ? rowKey : (hovered == rowKey ? "" : hovered)
  view
    box width="100%" display="grid" grid-template-columns=(sm ? "auto minmax(0, 1fr) auto auto auto" : "auto minmax(0, 1fr) auto auto") role="table" testId="usage-model-table"
      box grid-row=1 grid-column="1 / -1" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)"
      text "#" grid-row=1 grid-column=1 padding-top="0.5rem" padding-bottom="0.5625rem" padding-right="0.75rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      text "Model" grid-row=1 grid-column=2 padding-top="0.5rem" padding-bottom="0.5625rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      text "Cost" grid-row=1 grid-column=3 padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      when sm
        text "Share" grid-row=1 grid-column=4 padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      text "Tokens" grid-row=1 grid-column=(sm ? 5 : 4) padding-top="0.5rem" padding-bottom="0.5625rem" padding-left="1.5rem" text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      when length(page.models) == 0
        text "No activity in this window." grid-row=2 grid-column="1 / -1" padding-top="1.5rem" padding-bottom="1.5rem" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
      each model in page.models key=model.key
        box grid-row=model.row grid-column="1 / -1" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e780, #ffffff08)" background-color=(hovered == model.key ? "light-dark(#fafafa80, #ffffff04)" : "#00000000")
        text model.rank grid-row=model.row grid-column=1 align-self="center" padding-right="0.75rem" font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)" white-space="nowrap"
        column grid-row=model.row grid-column=2 min-width=0 padding-top="0.625rem" padding-bottom="0.6875rem"
          row align-items="center" gap="0.5rem" min-width=0
            when model.driver == "codex"
              ProviderMark(driver="codex", size=14, color="light-dark(#27272a, #f5f5f5)")
            else
              DriverMark(driver=model.driver, size=14, initials="", icon="")
            text model.model font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" min-width=0
          box margin-top="0.375rem" height=2 width="100%" max-width="12rem" aria-hidden=true
            when model.bar > 0
              box height=2 width=`${model.bar}%` min-width="0.5rem" border-radius="624.9375rem" background-color=(scheme == "dark" ? model.dark : model.light)
        text model.cost grid-row=model.row grid-column=3 align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color=(model.unpriced ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
        when sm
          text model.share grid-row=model.row grid-column=4 align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
        text model.tokens grid-row=model.row grid-column=(sm ? 5 : 4) align-self="center" padding-left="1.5rem" text-align="right" white-space="nowrap" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
        button press=op("usage-model-open", "", model.key) hover=hover(model.key) grid-row=model.row grid-column="1 / -1" aria-label=model.model testId=`usage-model-${model.key}` padding=0 border-width=0 background-color="#00000000"

component PeriodTable
  props
    page: UsageView
  derive share = `${60 / (length(page.columns) + 2)}%`
  view
    column width="100%" role="table" testId="usage-period-table"
      row width="100%" height="2rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" align-items="center" role="row"
        text page.periodLabel width="40%" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
        each column in page.columns key=column.key
          text column.label width=share text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader" line-clamp=1
        text "Total" width=share text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
        text "Tokens" width=share text-align="right" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" role="columnheader"
      when length(page.periods) == 0
        text "No activity in this window." width="100%" padding-top="1.5rem" padding-bottom="1.5rem" text-align="center" font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
      each period in page.periods key=period.key
        TableRow()
          text period.label width="40%" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          each cell in period.cells key=cell.key
            text cell.text width=share text-align="right" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
          text period.total width=share text-align="right" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
          text period.tokens width=share text-align="right" font-size="0.875rem" line-height="1.25rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"

// A body row: 8pt cell padding, a half-strength rule, hover:bg-muted/50.
component TableRow
  slot
  state over = false
  action hover(value: bool)
    over = value
  view
    row hover=hover width="100%" height="2.3125rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(over ? "light-dark(#fafafa80, #ffffff04)" : "#00000000") align-items="center" role="row"
      children

// UsageSkeleton: the loaded page's shape while the first summary arrives
// (Skeleton: bg-muted-foreground/15, rounded-sm; pills and the card toggle).
component UsageSkeleton
  props
    lg: bool
    md: bool
  view
    column width="100%" gap="1.5rem" testId="usage-skeleton"
      box width="100%" display="grid" grid-template-columns=(lg ? "minmax(0, 288px) minmax(0, 1fr)" : "minmax(0, 1fr)") gap="1.5rem"
        column gap="1.25rem"
          column gap="0.25rem"
            box width="9rem" height="2.5rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
            box width="8rem" height="1rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
          UsageSkeletonProvider()
          UsageSkeletonProvider()
          UsageSkeletonProvider()
          UsageSkeletonProvider()
          UsageSkeletonProvider()
          UsageSkeletonProvider()
        column gap="0.75rem" min-width=0
          box width="6rem" height="1.25rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
          column gap="0.25rem"
            box margin-left="4rem" height="14rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
            box margin-left="4rem" height="1rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
      column gap="0.5rem"
        text "Totals" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        box width="100%" display="grid" grid-template-columns=(md ? "repeat(5, minmax(0, 1fr))" : "repeat(2, minmax(0, 1fr))") column-gap="1.5rem" row-gap="1rem" padding-top="0.25rem" padding-bottom="0.25rem"
          UsageSkeletonMetric(label="Processed tokens")
          UsageSkeletonMetric(label="Cached input")
          UsageSkeletonMetric(label="Uncached input")
          UsageSkeletonMetric(label="Output")
          UsageSkeletonMetric(label="Cache savings")
      box width="100%" display="grid" grid-template-columns=(lg ? "repeat(2, minmax(0, 1fr))" : "minmax(0, 1fr)") column-gap="3rem" row-gap="2rem"
        column gap="0.625rem"
          box width="7rem" height="1.25rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
          box height="0.5rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
          box width="18rem" max-width="100%" height="1rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"
      column gap="0.75rem"
        row align-items="center" justify-content="space-between" gap="0.75rem"
          text "Breakdown" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          box width="7rem" height="1.75rem" border-radius="0.625rem" background-color="light-dark(#71717b26, #81818126)"
        box width="100%" height="11rem" border-radius="0.25rem" background-color="light-dark(#71717b26, #81818126)"

component UsageSkeletonProvider
  view
    column gap="0.25rem"
      row min-height="1.25rem" align-items="center" justify-content="space-between" gap="1rem"
