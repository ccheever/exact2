// The Files surface (r4-surfaces-files.ts), measured on the
// served reference (MIT, see LICENSE-T3: components/files/FilePreviewPanel.tsx,
// FileBrowserPanel.tsx, FileBreadcrumbs.tsx, fileSurfaceChrome.tsx and the
// compact @pierre/trees tree): the explorer alone, or a file's subheader
// (breadcrumbs, Open in editor, rendered/wrap/explorer toggles), its numbered
// lines and the explorer beside them. `local` is the window's chatLocal: a
// `surface-*` op reaches r4-surfaces-panel.ts without the command gate.
use R4Files from "./r4-surfaces-shapes.contract"
use FieldPlaceholder from "./field-placeholder.contract"
use R4TreeRow from "./r4-surfaces-shapes.contract"
use R4Crumb from "./r4-surfaces-shapes.contract"
use R4CrumbMenu from "./r4-surfaces-shapes.contract"
use R4CodeLine from "./r4-surfaces-shapes.contract"
use ShellIcon from "./shell-icons.contract"
use ShellEditorIcon from "./shell-icons.contract"
use TipBubble from "./shell-tip.contract"
use FileTypeIcon from "./timeline-files.contract"
use synColor from "./markdown.contract"
use synSlant from "./markdown.contract"
use DiffCommentCard, DiffDraftCard from "./diff-comments.contract"
use diffSel from "./diff-rows.contract"
use DiagramBlocks, ChatDocument from "./markdown.contract"
use FilesMedia from "./media-actions.contract"
use R4Icon from "./r4-surfaces-icons.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmKeyEnd from "./menu-keys.contract"
use kmEndKeyed from "./menu-keys.contract"
use kmTriggerKey from "./menu-keys.contract"
use kmTriggerTarget from "./menu-keys.contract"

// The surface body under the panel's tab bar; one subtree serves both schemes: an svg's light-dark() paint follows an appearance change (main 9223aad88) (file icons, chevrons).
component R4FilesBody
  props
    family: string
    files: R4Files
    // app.contract's filesMarkdown, the rendered file as ChatMarkdown parses it.
    documents: ChatDocument[]
    scheme: string
    sheet: bool
    local: action
    searchFocus: action
  view
    R4FilesSurface(family=family, files=files, documents=documents, scheme=scheme, sheet=sheet, local=local, searchFocus=searchFocus)

component R4FilesSurface
  props
    family: string
    files: R4Files
    documents: ChatDocument[]
    scheme: string
    sheet: bool
    local: action
    searchFocus: action
  view
    column flex=1 min-height=0 width="100%" position="relative" overflow="hidden" testId="files-surface"
      if files.path != ""
        R4FileHeader(files=files, sheet=sheet, local=local)
      if files.truncatedNote != ""
        text files.truncatedNote flex-shrink=0 padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#fe9a0033, #fe9a0033)" background-color="light-dark(#fffbeb, #fe9a0014)" font-size="0.6875rem" line-height="1rem" color="light-dark(#bb4d00, #ffb900)" role="status"
      row flex=1 min-height=0 width="100%" overflow="hidden" align-items="stretch"
        if files.path != "" and files.preview != ""
          column flex=1 min-width=0 min-height=0 overflow="hidden"
            R4FilePreview(family=family, files=files, documents=documents, scheme=scheme, local=local)
        if files.showExplorer
          column min-height=0 flex-shrink=(files.path != "" and files.preview != "" ? 0 : 1) flex-grow=(files.path != "" and files.preview != "" ? 0 : 1) width=(files.path != "" and files.preview != "" ? "46%" : "100%") max-width=(files.path != "" and files.preview != "" ? "22rem" : "6250rem") min-width=(files.path != "" and files.preview != "" ? "16rem" : "0px") box-sizing="border-box" border-left-width=(files.path != "" and files.preview != "" ? 1 : 0) border-left-style="solid" border-color="light-dark(#e4e4e799, #ffffff0a)" testId="files-explorer"
            R4Explorer(files=files, sheet=sheet, local=local, searchFocus=searchFocus)

// FILE_SURFACE_SUBHEADER_CLASS: 28pt with 12pt below in the inline panel, 40pt over a hairline in a sheet; 12pt sides, 8pt gaps.
component R4FileHeader
  props
    files: R4Files
    sheet: bool
    local: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  state editorsOpen = false
  derive editorItems = files.editorUnavailable != "" ? [] : files.editors.map((editor) => KmItem(id=`file-editor-${editor.id}`, label=editor.label))
  // Base UI's MenuTrigger: Enter, Space, ↓ open the "Open in" menu at its first item, ↑ at its last.
  action editorsKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        showPopover("file-editors-menu", source="file-choose-editor")
        let target = kmTriggerTarget(editorItems, k)
        if target != ""
          focus(target)
  action editorsToggled(e: ToggleEvent)
    editorsOpen = e.newState == "open"
  view
    row height=(sheet ? "2.5rem" : "1.75rem") flex-shrink=0 margin-bottom=(sheet ? "0px" : "0.75rem") padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" gap="0.5rem" align-items="center" position="relative" z-index=5 border-bottom-width=(sheet ? 1 : 0) border-bottom-style="solid" border-color="light-dark(#0000001b, #ffffff1f)" background-color=(sheet ? "light-dark(#ffffff, #0a0a0a)" : "#00000000") testId="file-subheader"
      // A clip whose `w-max min-w-full` trail is end-justified (r7-polish-crumbs.ts), faded on its left while it overflows.
      row hatch="t3-anchor" data-anchor="crumbs-clip" flex=1 min-width=0 align-items="center" justify-content=(files.crumbsOffset >= 0 ? "flex-start" : "flex-end") overflow="hidden" mask-image=files.crumbsMask aria-label="Breadcrumbs" testId="file-breadcrumbs"
        row hatch="t3-anchor" data-anchor="crumbs" flex-shrink=0 min-width="100%" margin-left=(files.crumbsOffset > 0 ? 0 - files.crumbsOffset : 0) align-items="center"
          for crumb in files.crumbs key=crumb.id
            R4CrumbView(crumb=crumb, menu=files.crumbMenu, open=(files.crumbMenu.open and files.crumbMenu.root == crumb.id), local=local)
      if files.absolutePath != "" and files.editorShow
        row flex-shrink=0 height="1.5rem" align-items="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" role="group" aria-label="Open in editor"
          box position="relative"
            button disabled=(files.editorUnavailable != "" or files.editorId == "") press=local("surface-files-open-editor", files.absolutePath, files.editorId) hover=hover("editor") aria-label="Open file in preferred editor" testId="file-open-editor" width="1.5rem" height="1.375rem" padding=0 border-width=0 border-radius="0.4375rem" background-color=(hovered == "editor" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              ShellEditorIcon(editor=files.editorId, size=14)
            TipBubble(label=(files.editorUnavailable != "" ? files.editorUnavailable : files.editorLabel), side="bottom", align="center", offset=28, inset=0, shown=(hovered == "editor"))
          box width=1 height="1.375rem" background-color="light-dark(#d4d4d8, #ffffff14)"
          box position="relative" flex-shrink=0
            button id="file-choose-editor" popovertarget="file-editors-menu" key=editorsKey hover=hover("editors") aria-label="Choose editor" aria-haspopup="menu" aria-expanded=editorsOpen testId="file-choose-editor" width="1.4375rem" height="1.375rem" padding=0 border-width=0 border-radius="0.4375rem" background-color=(editorsOpen or hovered == "editors" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
              ShellIcon(name="chevron-down", size=14, color="light-dark(#27272a, #f5f5f5)")
            R4FileEditorsMenu(files=files, items=editorItems, toggled=editorsToggled, local=local)
      if files.canRender
        R4Toggle(id="render", label=files.renderLabel, icon=files.renderIcon, pressed=files.rendered, hovered=hovered, hover=hover, press=local("surface-files-render", files.path, ""))
      // Word wrap reaches only the text bodies: an image, a video, a rendered document or page has none (showsRawText).
      if files.rawText
        R4Toggle(id="wrap", label=(files.wrap ? "Disable word wrap" : "Enable word wrap"), icon="wrap-text", pressed=files.wrap, hovered=hovered, hover=hover, press=local("surface-files-wrap", "", ""))
      if files.openInBrowser
        R4Toggle(id="open-browser", label="Open file in preview browser", icon="earth", pressed=false, hovered=hovered, hover=hover, press=local("surface-files-open-browser", files.path, ""))
      if files.preview != ""
        R4Toggle(id="explorer", label=(files.explorer ? "Hide file explorer" : "Show file explorer"), icon="folder-tree", pressed=files.explorer, hovered=hovered, hover=hover, press=local("surface-files-explorer", "", ""))

// One row of a folder crumb's menu: its Pierre glyph, label and a chevron for a folder; the open file is the checked
// radio item (MenuRadioItem: `data-checked:bg-foreground/[0.08]`, no indicator; icons `-mx-0.5`).
component R4CrumbItem
  props
    // The KeyMenu popup the row hands the focus to as the pointer leaves it holding the focus (menu-keys.contract).
    keysId: string
    label: string
    icon: string
    token: string
    trailing: bool
    current: bool
    ignored: bool
    test: string
    press: action
  state lit = false
  action hover(over: bool)
    if over
      focus(test)
    else if lit
      focus(keysId)
  action focused(on: bool)
    lit = on
  view
    button id=test press=press hover=hover focus=focused(true) blur=focused(false) role="menuitem" testId=test width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" display="flex" flex-direction="row" align-items="center" background-color=(lit ? "light-dark(#f4f4f5, #ffffff0a)" : current ? "light-dark(#0a0a0a14, #fafafa14)" : "#00000000")
      box margin-left="-0.125rem" margin-right="-0.125rem" flex-shrink=0 display="flex"
        if token != ""
          FileTypeIcon(token=token, size=16)
        else
          if icon == "arrow-left"
            R4Icon(name="arrow-left", size=16, color="light-dark(#71717b, #818181)")
          else
            ShellIcon(name=icon, size=16, color="light-dark(#71717b, #818181)")
      text label flex=1 min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.875rem" line-height="1.25rem" color=(ignored ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
      if trailing
        box margin-left="-0.125rem" margin-right="-0.125rem" flex-shrink=0 display="flex"
          ShellIcon(name="chevron-right", size=16, color="light-dark(#71717b, #818181)")

// FileSurfaceAction as a Toggle (ghost sm): 28pt, 10pt radius, the accent fill when pressed.
component R4Toggle
  props
    id: string
    label: string
    icon: string
    pressed: bool
    hovered: string
    hover: action
    press: action
  view
    box position="relative" flex-shrink=0
      button press=press hover=hover(id) aria-label=label testId=`file-toggle-${id}` width="1.75rem" height="1.75rem" padding=0 border-radius="0.625rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(pressed ? "light-dark(#f4f4f5, #ffffff0f)" : hovered == id ? "light-dark(#f4f4f599, #ffffff0a)" : "#00000000") title=""
        R4Icon(name=icon, size=14, color=(pressed ? "light-dark(#18181b, #fafafa)" : "light-dark(#71717b, #a1a1aa)"))
      TipBubble(label=label, side="bottom", align="end", offset=32, inset=0, shown=(hovered == id))

// FileBreadcrumbs: 12pt muted crumbs (2pt sides, 4pt radius) between 14pt chevrons; the file is medium foreground.
component R4CrumbView
  inject
    dialogMenuEntered: action
  props
    crumb: R4Crumb
    menu: R4CrumbMenu
    // This crumb's folder is the one the data module lists.
    open: bool
    local: action
  state over = false
  action hover(value: bool)
    over = value
  // The end of the menu a key on the crumb asked for (Enter, Space or ↓ the first item, ↑ the last; a pointer press
  // none), read by the menu's rows as they mount once the data module has listed the folder (menu-keys.contract).
  state menuEnd = ""
  action crumbKey(k: string, e: KeyboardEvent)
    if not e.metaKey and not e.ctrlKey and not e.altKey and not e.shiftKey and kmTriggerKey(k)
      preventDefault()
      stopPropagation()
      if not e.repeat
        menuEnd = kmKeyEnd(k)
        showPopover(`crumb-menu-${crumb.id}`, source=`crumb-${crumb.id}`)
  // The popover opens and closes the listing: Base UI's Menu opens on the crumb's press, and any press outside it,
  // Escape or a file picked closes it.
  action toggled(e: ToggleEvent)
    if e.newState == "open"
      local("surface-files-crumb", crumb.path, "open")
    else
      menuEnd = ""
      local("surface-files-crumb-close", crumb.path, "")
  // A file opens and closes the menu; a folder or Back lists inside it (FileBreadcrumbs' closeOnClick={false}).
  action pick(path: string, directory: bool)
    if not directory
      hidePopover(`crumb-menu-${crumb.id}`)
    local(directory ? "surface-files-crumb-dir" : "surface-file", path, "")
  view
    // Hooked so the folder menu opens under the crumb as laid out (r4-surfaces-files.ts crumbMenu).
    box hatch="t3-anchor" data-anchor=`crumb:${crumb.id}` display="flex" flex-direction="row" flex-shrink=0 min-width=0 align-items="center"
      if crumb.id != "."
        box margin-left="0.25rem" margin-right="0.25rem" flex-shrink=0 display="flex"
          ShellIcon(name="chevron-right", size=14, color="light-dark(#71717b99, #81818199)")
      if crumb.current
        text crumb.label max-width="10rem" padding-left="0.125rem" padding-right="0.125rem" font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)"
      else
        box position="relative" min-width=0 display="flex"
          button id=`crumb-${crumb.id}` popovertarget=`crumb-menu-${crumb.id}` key=crumbKey hover=hover aria-label=`Browse ${crumb.label}` aria-haspopup="menu" aria-expanded=open testId=`crumb-${crumb.id}` max-width="10rem" padding-left="0.125rem" padding-right="0.125rem" border-radius="0.25rem" border-width=0 background-color=(over or open ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
            text crumb.label font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color=(over or open ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
          // FileBreadcrumbs' MenuPopup (align start): 4pt under the crumb, flipping near an edge.
          column id=`crumb-menu-${crumb.id}` data-dialog-return="menu" focusin=dialogMenuEntered(`crumb-menu-${crumb.id}`, `crumb-${crumb.id}`) toggle=toggled popover="auto" position-area="bottom span-right" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" min-width="10rem" max-width="20rem" testId=`crumb-menu-layer-${crumb.id}`
            column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label=crumb.label testId="crumb-menu"
              // Mounted once the data module lists this folder, so the rows a key asked for are there to take the focus.
              if open
                KeyMenu(menuId="crumb-menu-keys", items=(menu.back != "" ? [KmItem(id="crumb-back", label=menu.back)] : []).concat(menu.entries.map((entry) => KmItem(id=`crumb-entry-${entry.path}`, label=entry.label))), keyed=kmEndKeyed(menuEnd), gap="0px", modal=true)
                  if menu.back != ""
                    R4CrumbItem(keysId="crumb-menu-keys", label=menu.back, icon="arrow-left", token="", trailing=false, current=false, ignored=false, test="crumb-back", press=pick(menu.backPath, true))
                    box height=1 margin-top="0.25rem" margin-bottom="0.25rem" margin-left="0.5rem" margin-right="0.5rem" background-color="light-dark(#e4e4e7, #ffffff0f)"
                  if menu.status != ""
                    text menu.status height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" font-size="0.875rem" line-height="1.75rem" opacity=0.64 color="light-dark(#27272a, #f5f5f5)"
                  for entry in menu.entries key=entry.id
                    R4CrumbItem(keysId="crumb-menu-keys", label=entry.label, icon=(entry.directory ? "folder" : ""), token=entry.token, trailing=entry.directory, current=entry.current, ignored=entry.ignored, test=`crumb-entry-${entry.path}`, press=pick(entry.path, entry.directory))

// OpenInPicker (compact, in the file's subheader): its MenuPopup (align="end") 4pt under the chevron, its right edge on
// the chevron's. A popover, so a press anywhere outside it or Escape closes it, as Base UI's Menu does; it is modal
// while it shows, so its Escape is not the right panel sheet's toggle's.
component R4FileEditorsMenu
  inject
    dialogMenuEntered: action
  props
    files: R4Files
    items: KmItem[]
    toggled: action
    local: action
  // The "Open in" rows are MenuItems (menu-keys.contract), highlighted by their focus alone; the
  // pointer entering one focuses it, and leaving the one that holds the focus hands it to the popup.
  state lit = ""
  action focused(id: string, on: bool)
    lit = on ? id : (lit == id ? "" : lit)
  action hover(id: string, over: bool)
    if over
      focus(`file-editor-${id}`)
    else if lit == id
      focus("file-editors-keys")
  view
    column id="file-editors-menu" data-dialog-return="menu" focusin=dialogMenuEntered("file-editors-menu", "file-choose-editor") toggle=toggled popover="auto" position-area="bottom span-left" position-try-fallbacks="flip-block, flip-inline, flip-block flip-inline" position="absolute" margin-top="0.25rem" min-width="10rem" testId="file-editors-layer"
      column width="100%" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fefefe, #171717)" box-shadow="0 16px 40px -18px #0000008c" role="menu" aria-label="Open in" testId="file-editors"
        KeyMenu(menuId="file-editors-keys", items=items, keyed=0, gap="0px", modal=true)
          if files.editorUnavailable != "" or files.editors.length == 0
            text (files.editorUnavailable != "" ? files.editorUnavailable : "No installed editors found") padding="0.5rem" font-size="0.75rem" color="light-dark(#71717b, #a1a1aa)" testId="file-editor-unavailable"
          if files.editorHint != "" and files.editorUnavailable == ""
            text files.editorHint padding="0.5rem" font-size="0.75rem" color="light-dark(#71717b, #a1a1aa)" testId="file-editor-remote-hint"
          for editor in files.editors key=editor.id
            button id=`file-editor-${editor.id}` press=local("surface-files-open-editor", files.absolutePath, editor.id) popovertarget="file-editors-menu" popovertargetaction="hide" hover=hover(editor.id) focus=focused(editor.id, true) blur=focused(editor.id, false) role="menuitem" testId=`file-editor-${editor.id}` width="100%" height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" gap="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color=(lit == editor.id ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
              ShellEditorIcon(editor=editor.id, size=16)
              text editor.label flex=1 min-width=0 text-align="left" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"

// The file body: a spinner while it reads, its error, the rendered Markdown or
// table, or Pierre's numbered lines (13/20 mono on the code background). A click
// on an editable file opens the editor over the same text (r4-surfaces-files.ts
// keeps its starting text fixed for the session); each change is written back.
component R4FilePreview
  props
    family: string
    files: R4Files
    documents: ChatDocument[]
    scheme: string
    local: action
  action noCite(blockId: string, runId: string, s: Selection)
    let ignored = blockId
  // diff-review: the open comment draft's text (FilePreviewPanel's annotation draft).
  state draftText = ""
  action editDraft(text: string)
    draftText = text
  action beginComment(line: number)
    draftText = ""
    local("surface-files-comment-begin", files.path, `${line}`)
  action cancelComment
    draftText = ""
    local("surface-files-comment-cancel", files.path, "")
  action saveComment
    local("surface-files-comment-save", files.path, draftText)
    draftText = ""
  // Escape leaves the editor and keeps the panel (installFileEditorDismissal blurs it); the blur ends the
  // editing. It had no Escape of its own while the panel toggle took the key.
  action editorKey(k: string)
    if k == "Escape"
      preventDefault()
      blur()
  view
    if files.preview == "loading"
      column flex=1 align-items="center" justify-content="center" testId="file-loading"
        R4Icon(name="loader", size=24, color="light-dark(#71717b, #818181)")
    if files.preview == "error"
      column flex=1 align-items="center" justify-content="center" padding-left="1.5rem" padding-right="1.5rem"
        text files.previewError text-align="center" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#e40014, #ff6467)" testId="file-error"
    if files.preview == "markdown"
      scroll flex=1 min-height=0 width="100%" testId="file-markdown"
        column width="100%" max-width="56rem" padding-left="1.5rem" padding-right="1.5rem" padding-top="1.25rem" padding-bottom="1.25rem" box-sizing="border-box" align-self="center"
          // FileMarkdownPreview: ChatMarkdown with the file's own folder for its links and images (r4-surfaces-files.ts renderedMarkdown).
          for document in documents.filter((entry) => entry.id == `file:${files.path}`) key=document.id
            DiagramBlocks(document=document, local=local, code=files.code, diagrams=files.diagrams, prose="light-dark(#27272acc, #f5f5f5cc)", fit=false, scheme=scheme, copiedText=files.codeCopied, copiedNonce=files.codeCopyNonce, env=files.md, urls=files.mdUrls, source="", cite=noCite, markStart=-1, markEnd=-1)
    if files.preview == "table"
      scroll flex=1 min-height=0 width="100%" testId="file-table"
        column min-width="100%"
          for row in files.table key=row.id
            row min-width="100%" background-color=(row.header ? "light-dark(#f4f4f599, #ffffff0a)" : "#00000000")
              for cell in row.cells key=cell.id
                text cell.text flex=1 max-width="20rem" min-width="4rem" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color=(row.header ? "light-dark(#e4e4e7, #ffffff0f)" : "light-dark(#e4e4e799, #ffffff0a)") white-space="pre-wrap" font-size="0.75rem" line-height="1rem" font-weight=(row.header ? 500 : 400) font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
    // An image or video file with its menu, tooltip and failure states (FilesMedia).
    if files.preview == "media"
      FilesMedia(media=files.media, local=local)
    // A rendered HTML page in the app module's sandboxed, network-less web view (BrowserDocumentFrame);
    // a PDF, always rendered, in the module's PDFView (issues/closed/20261009-app-file-iframe-loading.md), as an attachment's.
    if files.preview == "html" or files.preview == "pdf"
      box hatch="t3-media" data-media-url=files.url data-media-kind=files.preview data-media-name=files.path flex=1 min-height=0 width="100%" background-color="#ffffff" aria-label=files.path testId=`file-${files.preview}`
    if files.preview == "code"
      scroll flex=1 min-height=0 width="100%" testId="file-code"
        // The editor fills the pane, so a click below the last line lands in it (focus, caret at the end).
        column position="relative" width=(files.wrap ? "100%" : "auto") min-width="100%" min-height="100%" padding-top="0.5rem" padding-bottom="0.5rem" box-sizing="border-box" background-color="light-dark(#ffffff, #111111)" press=local("surface-files-begin-edit", files.path, "") role="code" aria-label=files.path testId="file-lines"
          for line in files.lines key=line.id
            if line.kind == "line"
              R4CodeRow(family=family, line=line, gutter=files.gutter, wrap=files.wrap, path=files.path, open=(files.commentOpen or files.editing), local=local, begin=beginComment)
            if line.kind == "note"
              DiffCommentCard(text=line.text, remove=local("surface-files-comment-delete", files.path, line.entry))
            if line.kind == "draft"
              // The focus ops are the Diff panel's ⌘↩ hand-off (diff-review.ts): while the draft holds the focus the composer's Send
              // declares no chord, so ⌘↩ reaches DiffDraftCard's `keys` (diff-file-comments.ts).
              DiffDraftCard(rangeLabel=line.label, text=draftText, selected=false, edit=editDraft, cancel=cancelComment, save=saveComment, focusIn=local("surface-files-comment-focus", files.path, ""), focusOut=local("surface-files-comment-blur", files.path, ""))
          // Editing keeps the coloured, numbered lines: the editor's own text is clear over them, its caret and selection visible.
          if files.editing
            textarea id="file-editor" hatch="t3-file-editor" value=files.editorText input=local("surface-files-edit", files.path) key=editorKey blur=local("surface-files-end-edit", files.path, "") autofocus=true aria-label=files.path testId="file-editor" position="absolute" left=files.gutter top="0.4375rem" right=0 bottom="0.5625rem" padding-left=7.8 padding-right=7.8 padding-top=0 padding-bottom=0 box-sizing="border-box" border-width=0 background-color="#00000000" font-family=family font-size=13 line-height="20px" color="#00000000" caret-color="light-dark(#0a0a0a, #fafafa)" white-space=(files.wrap ? "pre-wrap" : "pre") overflow-wrap=(files.wrap ? "break-word" : "normal") autocorrect="off" spellcheck="false"

// FilePreviewPanel's File over @pierre/diffs (CDP, 1e2ecbd975). A press on the number starts
// a selection that follows the pointer over the file's lines (Shift extends it), a press on the gutter's "+" a range from the
// selection's top, as the diff's gutter (DiffCell, diff-line-drag.ts); the release opens the draft on what it ended on
// (onLineSelectionEnd → beginComment), so a click on a number opens one too (diff-file-comments.ts). The gutter cell holds
// the pointer and names the line under it by the row's id (`elementFromPoint`); its press, after the gesture's release
// found the draft open, is a keyboard's or accessibility's (the draft on the line, or the selection holding it), and keeps
// the press from the preview's begin-edit. The "+" is Pierre's [data-utility-button]: a 20pt square in the modified blue at
// the number's right edge (the cell less 1ch + 2pt: x 23.5 of a one-digit gutter), its 16pt plus in the surface's colour;
// while a selection is held it sits on the selection's bottom line only (placeUtilityFromSelection), else on the hovered
// line. The number is [data-column-number], `user-select: none`: drawn over the cell after the code, it takes no pointer,
// so a press on it is the cell's and a gutter drag selects no text. A selected line paints its number's cell and its
// number only (#d5e6ff / #254566, the number #20649e / #72b6ff, which is the diff's; the code row and the comment card
// under it stay the surface's, and there is no bar).
component R4CodeRow
  props
    family: string
    line: R4CodeLine
    gutter: number
    wrap: bool
    path: string
    open: bool
    local: action
    begin: action
  state hovering = false
  state dragging = false
  state overId = ""
  action hover(over: bool)
    hovering = over
  // Any primary press is an outside press for a skill chip's details, which the window's root never hears
  // (issues/20261010-pointer-events-reach-ancestors.md): one that starts no drag reports itself as `press`.
  action down(plus: bool, e: PointerEvent)
    if not open and e.buttons == 1
      dragging = true
      overId = `fl:${line.line}:${path}`
      local((plus ? "surface-files-comment-gutter" : e.shiftKey ? "surface-files-comment-drag-shift" : "surface-files-comment-drag"), path, `${line.line}`)
    else if e.buttons == 1
      local("surface-files-comment-press", path, "")
  // The release lets go of the focus the press gave the gutter cell (a pressable node takes it on macOS), so the draft
  // that opens takes it (DiffDraftCard's autofocus), as FilePreviewPanel's beginComment blurs and focuses the draft.
  action move(e: PointerEvent)
    // A held pointer's moves carry its button; a hover after an up this node never heard ends the drag.
    if dragging and e.buttons == 0
      dragging = false
      blur()
      local("surface-files-comment-end", path, "")
    else if dragging
      let hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "" }
      if hit != "" and hit != overId
        overId = hit
        local("surface-files-comment-to", path, hit)
  action up(e: PointerEvent)
    if dragging
      dragging = false
      blur()
      local("surface-files-comment-end", path, "")
  action comment
    if not open
      blur()
      begin(line.line)
  view
    row id=`fl:${line.line}:${path}` width="100%" align-items="flex-start" hover=hover position="relative"
      box width=gutter flex-shrink=0 align-self="stretch" min-height="20px" press=comment pointerdown=down(false) pointermove=move pointerup=up aria-label=`Select line ${line.number}` testId=`file-line-${line.number}` background-color=(line.selected ? "light-dark(#d5e6ff, #254566)" : "#00000000")
      text flex=1 min-width=0 padding-left=7.8 padding-right=7.8 box-sizing="border-box" font-family=family font-size=13 line-height="20px" white-space=(wrap ? "pre-wrap" : "pre") overflow-wrap=(wrap ? "break-word" : "normal") color="light-dark(#0a0a0a, #fafafa)"
        for run in line.runs key=run.id
          text run.text color=synColor(run.syntax) font-style=synSlant(run.syntax)
      if not open and (line.pin or not line.pinned or dragging)
        button press=comment pointerdown=down(true) pointermove=move pointerup=up aria-label=`Comment on line ${line.number}` testId=`file-comment-${line.number}` position="absolute" left=(gutter - 9.83) top=0 width=20 height=20 padding=0 border-radius=4 border-width=0 opacity=(line.pin or (hovering and not line.pinned) ? 1 : 0) background-color="#009fff" display="flex" flex-direction="row" align-items="center" justify-content="center" title=""
          svg width=16 height=16 viewBox="0 0 16 16" color="light-dark(#ffffff, #111111)" flex-shrink=0 aria-hidden=true
            path d="M8 3a.75.75 0 0 1 .75.75v3.5h3.5a.75.75 0 0 1 0 1.5h-3.5v3.5a.75.75 0 0 1-1.5 0v-3.5h-3.5a.75.75 0 0 1 0-1.5h3.5v-3.5A.75.75 0 0 1 8 3" fill="currentColor"
      text line.number position="absolute" left=0 top=0 width=gutter padding-right=9.83 box-sizing="border-box" pointer-events="none" user-select="none" aria-hidden=true text-align="right" font-family=family font-size=13 line-height="20px" font-variant-numeric="tabular-nums" color=(line.selected ? diffSel("number") : "light-dark(#565656, #9d9d9d)")

// FileBrowserPanel: refresh, "Search files" and expand/collapse all (36pt, 4pt
// below in the inline panel), status lines, then the compact tree (24pt rows,
// 16pt inset, 18.7pt per level with 1pt guides).
component R4Explorer
  props
    files: R4Files
    sheet: bool
    local: action
    searchFocus: action
  state hovered = ""
  action hover(id: string, over: bool)
    hovered = over ? id : (hovered == id ? "" : hovered)
  // FileSearchField's Escape runs closeSearch (the query and the tree's search) and blurs the field;
  // inline the panel stays. In a sheet the key then reaches the Base UI dialog, which closes, so the sheet's toggle
  // leaves Escape to the field while it has the focus (SurfacePanel filesSearchAt) and the field's "sheet" closes it
  // too (r4-surfaces-panel.ts, app.contract chatLocal). The focus is kept in the window, not sent: a second send on
  // `localChanged` in one turn forgets the first (the blur's would forget the Escape's).
  action searchKey(k: string)
    if k == "Escape"
      local("surface-files-search-key", sheet ? "sheet" : "", k)
      preventDefault()
      blur()
  view
    column flex=1 min-height=0 width="100%"
      row height="2.25rem" flex-shrink=0 margin-bottom="0.25rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" gap="0.25rem" align-items="center"
        box position="relative" flex-shrink=0
          button press=local("surface-files-refresh", "", "") hover=hover("refresh") aria-label="Refresh workspace files" testId="files-refresh" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(hovered == "refresh" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
            R4Icon(name="refresh-cw", size=14, color="light-dark(#71717b, #a1a1aa)")
          TipBubble(label=(files.loading ? "Refreshing…" : "Refresh files"), side="bottom", align="start", offset=28, inset=0, shown=(hovered == "refresh"))
        row flex=1 min-width=0 height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center"
          input value=files.query input=local("surface-files-search", "") key=searchKey focus=searchFocus(true) blur=searchFocus(false) placeholder="Search files" class=FieldPlaceholder aria-label=`Search ${files.project} files` testId="files-search" autocorrect="off" spellcheck="false" flex=1 min-width=0 height="1.25rem" padding=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
        if files.hasDirectories
          box position="relative" flex-shrink=0
            button press=local("surface-files-expand-all", "", "") hover=hover("expand") aria-label=(files.allExpanded ? "Collapse all folders" : "Expand all folders") testId="files-expand-all" width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 display="flex" flex-direction="row" align-items="center" justify-content="center" background-color=(hovered == "expand" ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") title=""
              R4Icon(name=(files.allExpanded ? "chevrons-down-up" : "chevrons-up-down"), size=14, color="light-dark(#71717b, #a1a1aa)")
            TipBubble(label=(files.allExpanded ? "Collapse all folders" : "Expand all folders"), side="bottom", align="end", offset=28, inset=0, shown=(hovered == "expand"))
      if files.error != ""
        button press=local("surface-files-refresh", "", "") padding="1rem" border-width=0 background-color="#00000000" testId="files-error"
          text `${files.error} Click to retry.` text-align="left" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#e40014, #ff6467)"
      if files.truncated
        text "More matches available. Refine your search." padding-left="0.75rem" padding-right="0.75rem" padding-top="0.25rem" padding-bottom="0.25rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      if files.loading or not files.ready
        text "Loading files…" role="status" padding-left="0.75rem" padding-right="0.75rem" padding-top="0.25rem" padding-bottom="0.25rem" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      scroll flex=1 min-height=0 width="100%" role="tree" aria-label=`${files.project} files` testId="files-tree"
        column width="100%" padding-left="1rem" padding-right="1rem" box-sizing="border-box"
          for row in files.rows key=row.id
            R4TreeRowView(row=row, local=local)

component R4TreeRowView
  props
    row: R4TreeRow
    local: action
  state over = false
  action hover(value: bool)
    over = value
  view
    // FileBrowserPanel's right-click menu (Open, reveal, Open with ▸, Copy mention, Add to chat).
    button press=local(row.directory ? "surface-files-toggle" : "surface-file", row.path, "tree") contextmenu=local("surface-files-row-menu", row.path, "") hover=hover role="treeitem" aria-label=row.name aria-expanded=row.expanded aria-selected=row.selected testId=`tree-${row.path}` width="100%" height=24 padding-left=(6.8 + row.depth * 18.7) padding-right=6 box-sizing="border-box" gap=4.4 border-radius=5 border-width=0 position="relative" display="flex" flex-direction="row" align-items="center" background-color=(row.selected ? "light-dark(#27272a1f, #f5f5f51f)" : over ? "light-dark(#27272a0d, #f5f5f50d)" : "#00000000") opacity=(row.ignored ? 0.5 : 1)
      for guide in row.guides key=guide.id
        box position="absolute" left=guide.left top=0 bottom=0 width=1 background-color="light-dark(#71717b40, #81818140)"
      if row.directory
        ShellIcon(name=(row.expanded ? "chevron-down" : "chevron-right"), size=16, color="light-dark(#84848a, #8b8b92)")
      else
        FileTypeIcon(token=row.token, size=16)
      text row.name flex=1 min-width=0 text-align="left" font-size=12 line-height="24px" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#27272a, #f5f5f5)"
