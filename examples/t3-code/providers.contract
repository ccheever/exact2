use MorphLock from "./shell-morph.contract"
use PvSectionTitle from "./providers-kit.contract"
use PvGroup from "./providers-kit.contract"
use PvRow from "./providers-kit.contract"
use PvField from "./providers-kit.contract"
use PvOutline from "./providers-kit.contract"
use PvGhost from "./providers-kit.contract"
use PvIconButton from "./providers-kit.contract"
use PvMicro from "./providers-kit.contract"
use PvIcon from "./provider-icons.contract"
use CnTooltip from "./settings-b-kit.contract"
use ProviderAccentPicker from "./settings-b-accent.contract"
use DriverMark from "./provider-icons.contract"
use ProviderSetupView from "./providers-setup.contract"
use ProviderAccountRow from "./providers-setup.contract"
use ProviderAntigravitySetup from "./providers-setup.contract"
use RedactedText from "./redacted-text.contract"
use ProviderAdvisory, ProviderUpdateAll, ProviderUpkeep from "./providers-upkeep.contract" // provider-settings-upkeep
use ProviderVersionAdvisory, ProviderUpdatesAllButton, ProviderUrlAuth, AcpManagement, CustomModelEditor from "./providers-upkeep.contract"
use CodexRuntimeFields from "./codex-setup.contract"
use CodexSetupRow from "./codex-setup.contract"
use CodexRuntimeSection from "./codex-setup.contract"

shape ProviderOption
  value: string
  label: string
  selected: bool
shape ProviderFieldRow
  rowKey: string
  key: string
  first: bool
  label: string
  description: string
  placeholder: string
  control: string
  value: string
  redacted: bool
  clearable: bool
  options: list<ProviderOption>
shape ProviderVariable
  rowKey: string
  index: number
  name: string
  value: string
  sensitive: bool
  redacted: bool
  label: string
shape ProviderModelRow
  rowKey: string
  slug: string
  name: string
  showSlug: bool
  custom: bool
  favorite: bool
  capabilities: string
  groupLabel: string
  firstGroup: bool
  hidden: bool
  moves: bool
  canUp: bool
  canDown: bool
  pickerTip: string
  editing: bool
shape ProviderBlockKey
  key: string
shape ProviderEditorData
  id: string
  key: string
  setup: ProviderSetupView
  nameRows: list<ProviderBlockKey>
  modelBlocks: list<ProviderBlockKey>
  driver: string
  title: string
  displayName: string
  placeholder: string
  accent: string
  accentH: number
  accentS: number
  accentV: number
  version: string
  enabled: bool
  icon: string
  update: ProviderAdvisory
  upkeep: ProviderUpkeep
  statusLead: string
  statusEmail: string
  statusEmailPlaceholder: string
  statusLabel: string
  statusDetail: string
  dot: string
  canDelete: bool
  canReset: bool
  known: bool
  showSetup: bool
  envFields: list<ProviderFieldRow>
  fields: list<ProviderFieldRow>
  codexRuntime: list<CodexRuntimeFields>
  variables: list<ProviderVariable>
  hasVariables: bool
  models: list<ProviderModelRow>
  modelSummary: string
  bulkLabel: string
  modelPlaceholder: string
  canAddModel: bool
shape ProviderRow
  id: string
  first: bool
  name: string
  driver: string
  enabled: bool
  selected: bool
  version: string
  update: ProviderAdvisory
  status: string
  dot: string
  accent: string
  badge: string
  icon: string
shape ProviderHub
  id: string
  first: bool
  label: string
  description: string
shape ProviderPage
  available: bool
  writable: bool
  message: string
  checked: string
  selectedId: string
  rows: list<ProviderRow>
  editors: list<ProviderEditorData>
  emptyEditor: string
  healthSeconds: string
  healthDown: string
  healthUp: string
  healthCustom: bool
  cursorUsage: bool
  macos: bool
  hubs: list<ProviderHub>
  updateAll: ProviderUpdateAll
  escapeOwned: bool

// Settings → Providers (ProviderSettingsPanel.tsx). `width` is the page's
// content width; T3 switches to the two-pane card at a 48rem container.
component ProvidersPanel
  props
    scheme: string
    page: ProviderPage
    width: number
    height: number
    busy: bool
    setupBusy: bool
    error: string
    select: action
    op: action
    accent: action
    ui: action
  state healthDraft = ""
  state healthEdited = false
  state policyOpen = false
  action togglePolicy
    policyOpen = not policyOpen
  action editHealth(value: string)
    healthDraft = value
    healthEdited = true
  derive wide = width >= 768
  derive cardHeight = max(512, min(704, height - 176))
  derive health = healthEdited ? healthDraft : page.healthSeconds
  view
    column width="100%" gap="2rem" testId="providers-settings"
      when not page.available
        text page.message font-size="0.875rem" line-height="1.25rem" padding="2rem" color="light-dark(#71717b, #818181)" testId="providers-unavailable"
      else
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Providers")
            when page.updateAll.show
              ProviderUpdatesAllButton(updateAll=page.updateAll, op=op)
            button press=op("provider-refresh", "", "", "", true) class=PvGhost disabled=busy aria-label="Refresh provider status" testId="refresh-providers"
              PvIcon(name="refresh", size=14, color="light-dark(#71717b, #818181)")
              text (busy ? "Refreshing providers" : page.checked) font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
            button press=ui("open", "add") class=PvIconButton aria-label="Add provider" disabled=(busy or not page.writable) testId="add-provider" id="add-provider"
              PvIcon(name="plus", size=14, color="light-dark(#71717b, #818181)")
          when not page.writable
            PvGroup()
              PvRow(title="Limited permissions", description=page.message, status="", wide=(width - 34 >= 512), divided=false)
          PvGroup()
            row width="100%" flex-direction=(wide ? "row" : "column") height=(wide ? cardHeight : "auto") testId="providers-card"
              scroll flex-shrink=0 width=(wide ? "17rem" : "100%") height=(wide ? "100%" : "auto") box-sizing="border-box" border-style="solid" border-color="light-dark(#e4e4e899, #ffffff0a)" border-top-width=0 border-left-width=0 border-right-width=(wide ? 1 : 0) border-bottom-width=(wide ? 0 : 1) background-color="light-dark(#f5f5f51a, #ffffff00)" testId="provider-list"
                column width="100%"
                  each row in page.rows key=row.id
                    row width="100%" min-height="4.5rem" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem" gap="0.75rem" align-items="center" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)" background-color=(row.selected ? "light-dark(#fbfbfb73, #ffffff03)" : "#00000000") testId=`provider-list-row-${row.id}`
                      // The row is one select button under its content; the advisory icon takes its own presses (pointer-events-auto).
                      box position="relative" flex=1 min-width=0 display="flex" flex-direction="row" align-items="flex-start" justify-content="flex-start" gap="0.75rem" border-radius="0.5rem" pointer-events="none" opacity=(not row.enabled and not row.selected ? 0.6 : 1)
                        button press=select(row.id) aria-label=`Select ${row.name}` aria-selected=row.selected testId=`settings-provider-${row.id}` position="absolute" left=0 top=0 right=0 bottom=0 pointer-events="auto" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000"
                        box width="1.25rem" height="1.25rem" position="relative" display="flex" align-items="center" justify-content="center" flex-shrink=0
                          DriverMark(driver=row.driver, size=16, initials=row.badge, icon=row.icon)
                          when row.accent != ""
                            box position="absolute" right="-0.125rem" bottom="-0.125rem" min-width="0.75rem" height="0.75rem" padding-left="0.125rem" padding-right="0.125rem" box-sizing="border-box" border-radius="624.9375rem" background-color=row.accent display="flex" align-items="center" justify-content="center"
                              text row.badge font-size="0.4375rem" font-weight=600 line-height=1 color="#ffffff"
                        column flex=1 min-width=0 align-items="flex-start"
                          row width="100%" min-width=0 gap="0.5rem" align-items="center"
                            text row.name font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 flex-shrink=1
                            when row.version != ""
                              text row.version font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" max-width="6rem" line-clamp=1 flex-shrink=0
                            when row.update.show
                              ProviderVersionAdvisory(advisory=row.update, op=op)
                          row margin-top="0.125rem" gap="0.375rem" align-items="flex-start" width="100%"
                            when row.dot != ""
                              box height="1.0625rem" display="flex" align-items="center" flex-shrink=0
                                box width="0.375rem" height="0.375rem" border-radius="624.9375rem" background-color=(row.dot == "error" ? "light-dark(#e7000b, #ff6467)" : "#fe9a00")
                            text row.status font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)" line-clamp=2 text-align="left"
                      box height="1.25rem" display="flex" align-items="center" flex-shrink=0
                        button press=op("provider-enabled", row.id, "", (row.enabled ? "false" : "true"), true) role="switch" aria-checked=row.enabled aria-label=`Enable ${row.name}` disabled=(busy or not page.writable) testId=`provider-enable-${row.id}` width="1.875rem" height="1.125rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(row.enabled ? "flex-end" : "flex-start") flex-shrink=0 background-color=(row.enabled ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
                          box width="0.875rem" height="0.875rem" border-radius="624.9375rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
              scroll flex-grow=1 flex-shrink=1 flex-basis=(wide ? "0%" : "auto") min-width=0 width=(wide ? "auto" : "100%") height=(wide ? "100%" : "auto") testId="provider-editor-scroll"
                column width="100%" padding="1rem" gap="1.5rem" box-sizing="border-box"
                  each editor in page.editors key=editor.key
                    ProviderEditor(editor=editor, scheme=scheme, rowWide=((wide ? width - 275 : width - 2) - 66 >= 512), busy=busy, setupBusy=setupBusy, writable=page.writable, error=error, op=op, accent=accent, ui=ui)
                  when length(page.editors) == 0
                    text page.emptyEditor font-size="0.875rem" line-height="1.25rem" padding="0.5rem" color="light-dark(#71717b, #818181)"
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Usage providers")
            when page.writable
              button press=ui("open", "hub") class=PvOutline height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" gap="0.25rem" disabled=busy testId="add-usage-hub"
                PvIcon(name="plus", size=12, color="light-dark(#27272a, #f5f5f5)")
                text "Add hub" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          PvGroup()
            when page.macos
              PvRow(title="Cursor account usage", description="Read your existing Cursor CLI login from macOS Keychain to show account history and monthly limits. macOS may ask you to allow access.", status="", wide=(width - 34 >= 512), divided=false)
                button press=op("provider-cursor-usage", "", "", (page.cursorUsage ? "false" : "true"), true) role="switch" aria-checked=page.cursorUsage aria-label="Cursor account usage" disabled=(busy or not page.writable) testId="cursor-account-usage" width="1.875rem" height="1.125rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(page.cursorUsage ? "flex-end" : "flex-start") background-color=(page.cursorUsage ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
                  box width="0.875rem" height="0.875rem" border-radius="624.9375rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
            when length(page.hubs) == 0
              PvRow(title="No hubs configured.", description="", status="", wide=(width - 34 >= 512), divided=page.macos)
            each hub in page.hubs key=hub.id
              PvRow(title=hub.label, description=hub.description, status="", wide=(width - 34 >= 512), divided=(page.macos or not hub.first))
                when page.writable
                  button press=ui("hub-remove", hub.id) class=PvGhost height="1.5rem" disabled=busy testId=`remove-usage-hub-${hub.id}`
                    text "Remove" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Advanced")
          PvGroup()
            PvRow(title="Health check interval", description="Refresh provider status, versions, and models in the background. Set to 0 to disable.", status=(policyOpen ? "This interval is configured here, then the shared Background activity policy decides whether provider probes may run when the timer fires. Custom intervals appear as Advanced in General settings." : ""), wide=(width - 34 >= 512), divided=false)
              button press=togglePolicy class=PvMicro aria-label="Background policy details" aria-expanded=policyOpen testId="provider-health-policy"
                PvIcon(name="info", size=14, color="light-dark(#71717b, #818181)")
              when page.healthCustom
                button press=op("provider-health", "", "", "reset", true) class=PvMicro aria-label="Reset provider health check interval to default" disabled=(busy or not page.writable) testId="reset-provider-health"
                  PvIcon(name="undo", size=12, color="light-dark(#71717b, #818181)")
              row gap="0.5rem" align-items="center" flex-shrink=0 opacity=(page.writable ? 1 : 0.5)
                row width="8rem" height="1.75rem" box-sizing="border-box" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" align-items="center" role="group"
                  button press=op("provider-health", "", "", page.healthDown, true) class=PvMicro width="2.125rem" height="1.625rem" aria-label="Decrease provider health check interval" disabled=(busy or not page.writable) testId="health-decrease"
                    PvIcon(name="minus", size=14, color="light-dark(#71717b, #818181)")
                  input value=health input=editHealth submit=op("provider-health", "", "", health, healthEdited) blur=op("provider-health", "", "", health, healthEdited) aria-label="Provider health check interval in seconds" disabled=(busy or not page.writable) testId="health-interval" flex=1 min-width=0 height="1.125rem" padding=0 border-width=0 background-color="#00000000" text-align="center" font-size="0.875rem" color="light-dark(#27272a, #f5f5f5)"
                  button press=op("provider-health", "", "", page.healthUp, true) class=PvMicro width="2.125rem" height="1.625rem" aria-label="Increase provider health check interval" disabled=(busy or not page.writable) testId="health-increase"
                    PvIcon(name="plus", size=14, color="light-dark(#71717b, #818181)")
                text "seconds" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// The selected instance's editor (ProviderInstanceCard mode="editor"). Its
// drafts are row state: they reset whenever the instance's saved value changes.
component ProviderEditor
  props
    scheme: string
    editor: ProviderEditorData
    rowWide: bool
    busy: bool
    setupBusy: bool
    writable: bool
    error: string
    op: action
    accent: action
    ui: action
  view
    column width="100%" gap="1.5rem" testId=`provider-editor-${editor.id}`
      column width="100%" gap="0.625rem"
        row min-height="1.75rem" padding-left="1rem" padding-right="1rem" gap="1rem" align-items="flex-start" justify-content="space-between" box-sizing="border-box" width="100%"
          row min-height="1.75rem" gap="0.5rem" align-items="center" min-width=0
            box width="1.25rem" height="1.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              DriverMark(driver=editor.driver, size=16, initials=editor.title, icon=editor.icon)
            text editor.title font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272ab3, #f5f5f5b3)" role="heading" aria-level=2 line-clamp=1
          row min-height="1.75rem" gap="0.375rem" align-items="center" justify-content="flex-end" flex-shrink=0
            when editor.version != ""
              text editor.version font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="provider-editor-version"
            when editor.update.show
              ProviderVersionAdvisory(advisory=editor.update, op=op)
            row gap="0.25rem" align-items="center" opacity=(writable ? 1 : 0.5)
              when editor.canReset
                button press=op("provider-reset", editor.id, "", "", true) class=PvMicro aria-label=`Reset ${editor.placeholder} provider settings to default` disabled=(busy or not writable) testId="reset-provider"
                  PvIcon(name="undo", size=12, color="light-dark(#71717b, #818181)")
              when editor.canDelete
                button press=op("provider-remove", editor.id, "", "", true) class=PvIconButton aria-label=`Delete instance ${editor.id}` disabled=(busy or not writable) testId="delete-provider-instance"
                  PvIcon(name="trash", size=14, color="light-dark(#71717b, #818181)")
        PvGroup()
          each nameRow in editor.nameRows key=nameRow.key
            ProviderNameRow(editor=editor, rowWide=rowWide, busy=busy, writable=writable, op=op, accent=accent)
        when error != ""
          text error font-size="0.75rem" line-height="1rem" role="alert" padding-left="1rem" color="light-dark(#e7000b, #ff6467)" testId="provider-editor-error"
      // ProviderInstanceCard's Setup section: the `setup` slot (ProviderSettingsPanel.tsx:1066-1118), then the env fields.
      when editor.showSetup
        column width="100%" gap="0.625rem"
          PvSectionTitle(title="Setup")
          PvGroup()
            when editor.setup.kind == "antigravity"
              ProviderAntigravitySetup(setup=editor.setup, instanceId=editor.id, scheme=scheme, wide=rowWide, busy=setupBusy, op=op, ui=ui)
            each codex in editor.setup.codex key=codex.key
              CodexSetupRow(setup=codex, wide=rowWide, busy=setupBusy, op=op, ui=ui, cancelled=ui("none", ""))
            when editor.setup.kind == "account"
              each account in editor.setup.account key=account.key
                ProviderAccountRow(account=account, scheme=scheme, wide=rowWide, divided=false, busy=setupBusy, op=op, askSignOut=ui("setup-logout", editor.id))
            when editor.setup.cursorNote != ""
              PvRow(title="Cursor account", description=editor.setup.cursorNote, status="", wide=rowWide, divided=false)
            each field in editor.envFields key=field.rowKey
              ProviderSecretField(field=field, instance=editor.id, wide=rowWide, divided=(editor.setup.kind != ""), writable=writable, op=op)
      each runtime in editor.codexRuntime key=runtime.key
        column width="100%" opacity=(writable ? 1 : 0.5) inert=(not writable)
          CodexRuntimeSection(runtime=runtime, wide=rowWide)
      when length(editor.fields) > 0 or not editor.known
        column width="100%" gap="0.625rem" opacity=(writable ? 1 : 0.5)
          PvSectionTitle(title="Runtime")
          PvGroup()
            when not editor.known
              PvRow(title="Driver", description=`This instance uses ${editor.driver}, which is not available in this build. Its configuration is preserved.`, status="", wide=rowWide, divided=false)
            each field in editor.fields key=field.rowKey
              ProviderConfigField(field=field, instance=editor.id, first=field.first, wide=rowWide, writable=writable, op=op)
      column width="100%" gap="0.625rem" opacity=(writable ? 1 : 0.5)
        PvSectionTitle(title="Environment")
        PvGroup()
          column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom=(editor.hasVariables ? "0.25rem" : "0.75rem")
            row width="100%" flex-direction=(rowWide ? "row" : "column") gap=(rowWide ? "2rem" : "0.75rem") align-items=(rowWide ? "center" : "stretch")
              column flex-grow=(rowWide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
                row min-height="1.25rem" align-items="center"
                  text "Variables" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
                text "API keys, base URLs, and other per-instance CLI settings." font-size="0.75rem" line-height="1.125rem" color="light-dark(#70707acc, #818181cc)"
              row justify-content="flex-end"
                button press=op("provider-env-add", editor.id, "", "", true) class=PvOutline disabled=(busy or not writable) testId="add-provider-variable"
                  PvIcon(name="plus", size=12, color="light-dark(#71717b, #818181)")
                  text "Add variable" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
            when editor.hasVariables
              column width="100%" gap="0.5rem" margin-top="0.75rem" padding-bottom="0.5rem"
                each variable in editor.variables key=variable.rowKey
                  ProviderVariableRow(variable=variable, instance=editor.id, writable=writable, op=op)
                text "Sensitive values are stored separately and never returned to the app." font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
          // provider-settings-upkeep: AcpSessionManagementSection, inside the Environment section.
          each acp in editor.upkeep.acp key=acp.key
            AcpManagement(acp=acp, wide=rowWide, op=op, ui=ui)
      when editor.known
        each block in editor.modelBlocks key=block.key
          ProviderModels(editor=editor, busy=busy, writable=writable, op=op)

// The Display name row: name draft and accent color, reset whenever either saves.
component ProviderNameRow
  props
    editor: ProviderEditorData
    rowWide: bool
    busy: bool
    writable: bool
    op: action
    accent: action
  state nameDraft = ""
  state nameEdited = false
  action editName(value: string)
    nameDraft = value
    nameEdited = true
  derive name = nameEdited ? nameDraft : editor.displayName
  view
    column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem"
      column width="100%" gap=(rowWide ? "0px" : "0.75rem")
        row width="100%" flex-direction=(rowWide ? "row" : "column") gap=(rowWide ? "2rem" : "0.75rem") align-items=(rowWide ? "center" : "stretch")
          column flex-grow=(rowWide ? 1 : 0) flex-shrink=1 min-width=0 gap="0.25rem"
            row min-height="1.25rem" align-items="center"
              text "Display name" font-size="0.875rem" line-height="1.25rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            row width="100%" min-width=0 padding-top="0.125rem" gap="0.375rem" flex-wrap="wrap" align-items="baseline" testId="provider-editor-status"
              when editor.dot != ""
                box width="0.375rem" height="0.375rem" border-radius="624.9375rem" background-color=(editor.dot == "error" ? "light-dark(#e7000b, #ff6467)" : "#fe9a00")
              text editor.statusLead font-size="0.75rem" line-height="1rem" min-width=0 color="light-dark(#71717b, #818181)"
              when editor.statusEmail != ""
                RedactedText(value=editor.statusEmail, placeholder=editor.statusEmailPlaceholder, label="Toggle account email visibility", revealTip="Click to reveal email", hideTip="Click to hide email", testId=`provider-status-email-${editor.id}`)
              when editor.statusLabel != ""
                text editor.statusLabel font-size="0.75rem" line-height="1rem" min-width=0 color="light-dark(#71717b, #818181)"
              when editor.statusDetail != ""
                text editor.statusDetail font-size="0.75rem" line-height="1rem" min-width=0 flex-shrink=1 color="light-dark(#71717b, #818181)"
            // provider-settings-upkeep: an ACP agent's browser authentication request (ProviderInstanceCard.tsx:994-1011).
            each auth in editor.upkeep.urlAuth key=auth.key
              ProviderUrlAuth(auth=auth, instanceId=editor.id, op=op)
          row gap="0.5rem" align-items="center" justify-content="flex-end" width=(rowWide ? "auto" : "100%") opacity=(writable ? 1 : 0.5)
            ProviderAccentPicker(editorId=editor.id, title=editor.title, accent=editor.accent, h0=editor.accentH, s0=editor.accentS, v0=editor.accentV, writable=writable, busy=busy, op=op, release=accent)
            input value=name input=editName blur=op("provider-display", editor.id, "", name, nameEdited) submit=op("provider-display", editor.id, "", name, nameEdited) placeholder=editor.placeholder aria-label="Display name" class=PvField width=(rowWide ? "14rem" : "auto") flex-grow=(rowWide ? 0 : 1) flex-shrink=(rowWide ? 0 : 1) min-width=0 disabled=(not writable) testId="provider-display-name"

// One driver setting (ProviderSettingsForm): commits on blur or Return.
component ProviderConfigField
  props
    field: ProviderFieldRow
    instance: string
    first: bool
    wide: bool
    writable: bool
    op: action
  state draft = ""
  state edited = false
  action edit(value: string)
    draft = value
    edited = true
  derive value = edited ? draft : field.value
  view
    PvRow(title=field.label, description=field.description, status="", wide=wide, divided=(not first))
      when field.control == "select"
        row gap="0.25rem" flex-wrap="wrap" justify-content="flex-end" role="radiogroup" aria-label=field.label
          each option in field.options key=option.value
            button press=op("provider-field", instance, field.key, option.value, true) role="radio" aria-checked=option.selected class=PvOutline height="1.75rem" disabled=(not writable) background-color=(option.selected ? "light-dark(#1b4ed814, #346bf126)" : "light-dark(#ffffff, #ffffff08)") testId=`provider-field-${field.key}-${option.value}`
              text option.label font-size="0.8125rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
      else
        input value=value input=edit blur=op("provider-field", instance, field.key, value, edited) submit=op("provider-field", instance, field.key, value, edited) placeholder=field.placeholder aria-label=field.label type=(field.control == "password" ? "password" : "text") autocorrect="off" spellcheck="false" class=PvField width=(wide ? "14rem" : "auto") flex-grow=(wide ? 0 : 1) flex-shrink=(wide ? 0 : 1) min-width=0 disabled=(not writable) testId=`provider-field-${field.key}`

// A dedicated environment secret (Cursor API key).
component ProviderSecretField
  props
    field: ProviderFieldRow
    instance: string
    wide: bool
    divided: bool
    writable: bool
    op: action
  state draft = ""
  state edited = false
  action edit(value: string)
    draft = value
    edited = true
  derive value = edited ? draft : field.value
  view
    PvRow(title=field.label, description=field.description, status="", wide=wide, divided=divided)
      row gap="0.5rem" align-items="center" width=(wide ? "14rem" : "100%")
        input value=value input=edit blur=op("provider-env-field", instance, field.key, value, edited) submit=op("provider-env-field", instance, field.key, value, edited) placeholder=field.placeholder aria-label=field.label type="password" class=PvField flex=1 min-width=0 disabled=(not writable) testId=`provider-env-${field.key}`
        when field.clearable
          button press=op("provider-env-field", instance, field.key, "", true) class=PvIconButton width="1.75rem" height="1.75rem" aria-label=`Clear ${field.label}` disabled=(not writable) testId=`clear-provider-env-${field.key}`
            PvIcon(name="x", size=14, color="light-dark(#e7000b, #ff6467)")

// One environment variable row: NAME = value, sensitivity lock, remove.
component ProviderVariableRow
  props
    variable: ProviderVariable
    instance: string
    writable: bool
    op: action
  state nameDraft = ""
  state nameEdited = false
  state valueDraft = ""
  state valueEdited = false
  action editName(value: string)
    nameDraft = value
    nameEdited = true
  action editValue(value: string)
    valueDraft = value
    valueEdited = true
  derive name = nameEdited ? nameDraft : variable.name
  derive value = valueEdited ? valueDraft : variable.value
  view
    row width="100%" min-width=0 gap="0.375rem" align-items="center" flex-wrap="wrap" testId=`provider-variable-${variable.index}`
      input value=name input=editName blur=op("provider-env-name", instance, `${variable.index}`, name, nameEdited) submit=op("provider-env-name", instance, `${variable.index}`, name, nameEdited) placeholder="VARIABLE_NAME" aria-label=`Environment variable name ${variable.index + 1}` autocorrect="off" spellcheck="false" class=PvField width="11rem" flex-shrink=0 font-family="ui-monospace" font-size="0.8125rem" disabled=(not writable) testId=`provider-variable-name-${variable.index}`
      text "=" font-size="0.75rem" color="light-dark(#71717b, #818181)" aria-hidden=true
      input value=value input=editValue blur=op("provider-env-value", instance, `${variable.index}`, value, valueEdited) submit=op("provider-env-value", instance, `${variable.index}`, value, valueEdited) placeholder=(variable.redacted ? "Stored secret, enter a new value to replace" : "value") type=(variable.sensitive ? "password" : "text") aria-label=`Environment variable value ${variable.index + 1}` autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 font-family="ui-monospace" font-size="0.8125rem" disabled=(not writable) testId=`provider-variable-value-${variable.index}`
      button press=op("provider-env-sensitive", instance, `${variable.index}`, (variable.sensitive ? "false" : "true"), true) class=PvMicro aria-selected=variable.sensitive aria-label=`Mark environment variable ${variable.label} as sensitive` disabled=(not writable) testId=`provider-variable-sensitive-${variable.index}`
        // f2cc80a7 MorphIcon LockOpen↔Lock: the shackle closes (morphicons' morph, shell-morph.contract).
        MorphLock(on=variable.sensitive, size=12, color="light-dark(#71717b, #818181)", weight=2, still=false)
      button press=op("provider-env-remove", instance, `${variable.index}`, "", true) class=PvMicro aria-label=`Remove environment variable ${variable.label}` disabled=(not writable) testId=`provider-variable-remove-${variable.index}`
        PvIcon(name="x", size=12, color="light-dark(#e7000b, #ff6467)")

// ProviderModelsSection: count, favorites, custom-model add/remove, and the custom model
// editor (providers-upkeep.contract) under the row its pencil opened.
component ProviderModels
  props
    editor: ProviderEditorData
    busy: bool
    writable: bool
    op: action
  state adding = false
  state slug = ""
  action startAdd
    adding = true
    slug = ""
  action cancelAdd
    adding = false
    slug = ""
  action editSlug(value: string)
    slug = value
  view
    column width="100%" gap="0.625rem" opacity=(writable ? 1 : 0.5)
      PvSectionTitle(title="Models")
      PvGroup()
        column width="100%" box-sizing="border-box" padding-left="1rem" padding-right="1rem" padding-top="0.75rem" padding-bottom="0.75rem"
          text "Favorites, visibility, and ordering are saved on this device. Custom models are saved on the selected environment." font-size="0.75rem" line-height="1rem" margin-bottom="0.75rem" color="light-dark(#71717b, #818181)"
          row width="100%" gap="0.5rem" align-items="center" justify-content="space-between" flex-wrap="wrap"
            row gap="0.5rem" align-items="center"
              when editor.bulkLabel != ""
                button press=op("provider-model-bulk", editor.id, "", "", true) class=PvGhost disabled=busy testId="provider-model-bulk"
                  text editor.bulkLabel font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
              text editor.modelSummary font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)" testId="provider-model-count"
            when editor.canAddModel and not adding
              button press=startAdd class=PvGhost disabled=(busy or not writable) testId="add-custom-model"
                PvIcon(name="plus", size=12, color="light-dark(#71717b, #818181)")
                text "Add custom model" font-size="0.75rem" line-height="1rem" font-weight=500 color="light-dark(#71717b, #818181)"
          column width="100%" margin-top="0.5rem" gap=0 testId="provider-model-list"
            when length(editor.models) == 0
              text "No models reported for this provider yet." font-size="0.75rem" line-height="1rem" padding-top="0.5rem" padding-bottom="0.5rem" color="light-dark(#71717b, #818181)"
            each model in editor.models key=model.rowKey
              column width="100%"
                when model.groupLabel != ""
                  text model.groupLabel font-size="0.6875rem" line-height="1rem" padding-bottom="0.375rem" padding-top=(model.firstGroup ? "0.25rem" : "1.25rem") color="light-dark(#71717b, #818181)"
                ProviderModelLine(model=model, instanceId=editor.id, busy=busy, writable=writable, op=op)
                when model.editing
                  each custom in editor.upkeep.modelEditor key=custom.key
                    CustomModelEditor(editor=custom, op=op)
          when adding
            row width="100%" margin-top="0.75rem" gap="0.5rem" align-items="center"
              input value=slug input=editSlug submit=op("provider-model-add", editor.id, slug, "", true) placeholder=editor.modelPlaceholder aria-label="Custom model slug" autocorrect="off" spellcheck="false" class=PvField flex=1 min-width=0 testId="custom-model-slug"
              button press=op("provider-model-add", editor.id, slug, "", true) class=PvOutline disabled=busy testId="custom-model-add"
                text "Add" font-size="0.875rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
              button press=cancelAdd class=PvGhost height="1.75rem" aria-keyshortcuts="Escape" testId="custom-model-cancel"
                text "Cancel" font-size="0.875rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"

// One ProviderModelsSection row: star, name/slug/custom, capabilities, the
// move arrows (not for hidden rows), custom edit/remove, and the picker switch.
component ProviderModelLine
  props
    model: ProviderModelRow
    instanceId: string
    busy: bool
    writable: bool
    op: action
  state tip = ""
  state over = false
  action hover(which: string, inside: bool)
    tip = inside ? which : (tip == which ? "" : tip)
  action hoverRow(inside: bool)
    over = inside
  view
    row width="100%" height="1.75rem" gap="0.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" align-items="center" border-radius="0.5rem" opacity=(model.hidden ? 0.5 : 1) background-color=(over ? "light-dark(#f4f4f54d, #ffffff08)" : "#00000000") hover=hoverRow testId=`provider-model-${model.slug}`
      box position="relative" hover=hover("star")
        button press=op("favorite-model", instanceId, model.slug, "", true) class=PvMicro aria-label=`${model.favorite ? "Remove" : "Add"} ${model.name} ${model.favorite ? "from" : "to"} favorites` testId=`provider-model-favorite-${model.slug}`
          PvIcon(name=(model.favorite ? "star-filled" : "star"), size=12, color=(model.favorite ? "#fe9a00" : "light-dark(#71717b, #818181)"))
        when tip == "star"
          CnTooltip(tip=(model.favorite ? "Remove from favorites" : "Add to favorites"), tipId=`provider-model-star-tip-${model.slug}`, above=24)
      row flex=1 min-width=0 gap="0.5rem" align-items="baseline"
        text model.name font-size="0.75rem" line-height="1rem" color=(model.hidden ? "light-dark(#71717b, #818181)" : "light-dark(#27272ae6, #f5f5f5e6)") line-clamp=1 min-width=0
        when model.showSlug
          text model.slug font-family="ui-monospace" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)" line-clamp=1 min-width=0
        when model.custom
          text "custom" font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)"
      text model.capabilities font-size="0.6875rem" line-height="1rem" color="light-dark(#71717bb3, #828282b3)"
      row gap="0.125rem" align-items="center" justify-content="flex-end" flex-shrink=0 min-width="5.5rem"
        when model.moves
          box position="relative" hover=hover("up")
            button press=op("provider-model-move", instanceId, model.slug, "up", true) class=PvMicro disabled=(busy or not model.canUp) opacity=(model.canUp ? 1 : 0.64) aria-label=`Move ${model.name} up` testId=`provider-model-up-${model.slug}`
              PvIcon(name="arrow-up", size=12, color="light-dark(#71717b, #818181)")
            when tip == "up"
              CnTooltip(tip="Move up", tipId=`provider-model-up-tip-${model.slug}`, above=24)
          box position="relative" hover=hover("down")
            button press=op("provider-model-move", instanceId, model.slug, "down", true) class=PvMicro disabled=(busy or not model.canDown) opacity=(model.canDown ? 1 : 0.64) aria-label=`Move ${model.name} down` testId=`provider-model-down-${model.slug}`
              PvIcon(name="arrow-down", size=12, color="light-dark(#71717b, #818181)")
            when tip == "down"
              CnTooltip(tip="Move down", tipId=`provider-model-down-tip-${model.slug}`, above=24)
        when model.custom
          box position="relative" hover=hover("edit")
            button press=op("upkeep:cm-open", instanceId, model.slug, "", true) class=PvMicro aria-label=`Edit ${model.slug}` aria-expanded=model.editing disabled=(not writable) testId=`provider-model-edit-${model.slug}`
              PvIcon(name="pencil", size=12, color="light-dark(#71717b, #818181)")
            when tip == "edit"
              CnTooltip(tip="Edit name and options", tipId=`provider-model-edit-tip-${model.slug}`, above=24)
          box position="relative" hover=hover("remove")
            button press=op("provider-model-remove", instanceId, model.slug, "", true) class=PvMicro aria-label=`Remove ${model.slug}` disabled=(busy or not writable) testId=`provider-model-remove-${model.slug}`
              PvIcon(name="x", size=12, color="light-dark(#71717b, #818181)")
            when tip == "remove"
              CnTooltip(tip="Remove custom model", tipId=`provider-model-remove-tip-${model.slug}`, above=24)
      box position="relative" hover=hover("switch")
        button press=op("provider-model-hide", instanceId, model.slug, (model.hidden ? "false" : "true"), true) role="switch" aria-checked=(not model.hidden) aria-label=`Show ${model.name} in the model picker` disabled=(busy or model.custom) testId=`provider-model-visible-${model.slug}` width="1.625rem" height="1rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(model.hidden ? "flex-start" : "flex-end") flex-shrink=0 opacity=(model.custom ? 0.64 : 1) background-color=(model.hidden ? "light-dark(#d4d4d8, #ffffff14)" : "light-dark(#1b4ed8, #346bf1)")
          box width="0.75rem" height="0.75rem" border-radius="624.9375rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
        when tip == "switch"
          CnTooltip(tip=model.pickerTip, tipId=`provider-model-switch-tip-${model.slug}`, above=20)
