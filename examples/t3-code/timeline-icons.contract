  view
    // T3Wordmark and the timeline's BrowserAppIcon draw filled marks of their own.
    when name == "t3-code"
      svg width=size height=size viewBox="15.5309 37 94.3941 56.96" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
        path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z"
    else
      when name == "browser"
        svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=1.9 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d="M8.5 19H7.2C4.4 19 3 17.5 3 14.6V7.4C3 4.5 4.5 3 7.4 3h8.2C18.5 3 20 4.5 20 7.4v2.4M11.2 7.2h4.3"
          path d="M7.4 6.45a.75.75 0 1 0 0 1.5a.75.75 0 1 0 0-1.5ZM12.4 11.4l7.5 2.6-3.4 1.6-1.5 3.6z" fill="currentColor" stroke="none"
      else
        when geometry == ""
          Icon(name=(name == "pull-request" ? "pull-requests" : name), size=size, color=color)
        else
          svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
            path d=geometry

// Native image lifecycle owns only the overlay; the fallback stays Contract-owned.
// T3 Code ToolActivityImageIcon (MIT, LICENSE-T3), app hook adaptation.
component ToolActivityIcon
  props
    light: string
    dark: string
    label: string
  slot
  state loaded = false
  action settled
    loaded = not loaded
  view
    box width=16 height=16 position="relative" flex-shrink=0 aria-label=label
      when not loaded
        children
      box position="absolute" left=0 top=0 width=16 height=16 padding=0 border-width=0 background-color="#00000000" pointer-events="none" aria-hidden=true tabindex=-1 hook="t3-tool-icon" data-tool-icon-light=light data-tool-icon-dark=dark press=settled
