// The project action editor (projectScriptEditor.tsx ProjectScriptEditorDialog)
// and its delete confirmation, mounted at the window root so the overlay takes
// hits above the settings scroll view.
use ProjectsPage from "./settings-projects.contract"
use ProjectAction from "./settings-projects.contract"
use CnScriptIcon from "./settings-b-kit.contract"
use CnGlyph from "./settings-b-kit.contract"

style AeLabel
  font-size="0.875rem" font-weight=500 line-height="1rem" color="light-dark(#27272a, #f5f5f5)"
style AeHint
  font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
style AeField
  box-sizing="border-box" width="100%" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.625rem" border-style="solid" border-width=1
  border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
style AeOutline
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap="0.5rem" box-sizing="border-box" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem"
  border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
style AeOverlay
  position="absolute" left=0 right=0 top=0 bottom=0 display="flex" align-items="center" justify-content="center"
  background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" padding="1rem" box-sizing="border-box" z-index=40

// The editor for one action (`subject` is its id) or a new one (subject "").
component ProjectActionDialog
  props
    data: ProjectsPage
    subject: string
    busy: bool
    error: string
    raw: action
    close: action
  view
    when subject == ""
      each blank in data.blankActions key=blank.id
        ProjectActionEditor(item=blank, scope=data.actionScope, editing=false, busy=busy, error=error, raw=raw, close=close)
    each entry in data.actions key=entry.id
      when entry.id == subject
        ProjectActionEditor(item=entry, scope=data.actionScope, editing=true, busy=busy, error=error, raw=raw, close=close)

component ProjectActionEditor
  props
    item: ProjectAction
    scope: string
    editing: bool
    busy: bool
    error: string
    raw: action
    close: action
  state name = item.name
  state command = item.command
  state icon = item.icon
  state keybinding = item.keybinding
  state recording = false
  state previewUrl = item.previewUrl
  state setup = item.setup
  state wait = item.wait
  state autoOpen = item.autoOpen
  state confirming = false
  action editName(value: string)
    name = value
  action editCommand(value: string)
    command = value
  action editPreview(value: string)
    previewUrl = value
  action chooseIcon(value: string)
    icon = value
  action record
    recording = true
  action capture(value: string)
    recording = false
    if value == "backspace" or value == "delete"
      keybinding = ""
    if value != "backspace" and value != "delete" and value != "esc" and value != "tab"
      keybinding = value
  action flipSetup
    setup = not setup
  action flipWait
    wait = setup ? not wait : wait
  action flipAuto
    autoOpen = previewUrl != "" ? not autoOpen : autoOpen
  action askDelete(on: bool)
    confirming = on
  derive payload = `id=${encodeURIComponent(item.id)}&name=${encodeURIComponent(name)}&command=${encodeURIComponent(command)}&icon=${icon}&setup=${setup ? "true" : "false"}&wait=${wait ? "true" : "false"}&keybinding=${encodeURIComponent(keybinding)}&preview=${encodeURIComponent(previewUrl)}&auto=${autoOpen ? "true" : "false"}`
  view
    column class=AeOverlay testId="project-action-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" position="relative" role="dialog" aria-label=(editing ? "Edit Action" : "Add Action") testId="project-action-dialog"
        column padding-top="1.5rem" padding-left="1.5rem" padding-right="1.5rem" padding-bottom="0.75rem" gap="0.5rem"
          text (editing ? "Edit Action" : "Add Action") font-size="1.25rem" line-height="1.25rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "Actions are project-scoped commands you can run from the top bar or keybindings." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
        column padding-left="1.5rem" padding-right="1.5rem" padding-top="0.25rem" gap="1rem"
          column gap="0.5rem"
            text "Name" class=AeLabel
            row gap="0.5rem" align-items="center" position="relative"
              box position="relative"
                button popovertarget="action-icon-picker" aria-label="Choose icon" disabled=busy testId="action-choose-icon" class=AeOutline width="2.25rem" padding-left=0 padding-right=0
                  CnScriptIcon(icon=icon, size=18, color="light-dark(#27272a, #f5f5f5)")
                column id="action-icon-picker" popover="auto" position="absolute" margin-top="0.5rem" width="17rem"
                  row flex-wrap="wrap" gap="0.5rem" padding="1rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#ffffff, #171717)" box-shadow="0 16px 40px -18px #0000008c" testId="action-icon-grid"
                    ScriptIconChoice(id="play", label="Play", selected=(icon == "play"), choose=chooseIcon)
                    ScriptIconChoice(id="test", label="Test", selected=(icon == "test"), choose=chooseIcon)
                    ScriptIconChoice(id="lint", label="Lint", selected=(icon == "lint"), choose=chooseIcon)
                    ScriptIconChoice(id="configure", label="Configure", selected=(icon == "configure"), choose=chooseIcon)
                    ScriptIconChoice(id="build", label="Build", selected=(icon == "build"), choose=chooseIcon)
                    ScriptIconChoice(id="debug", label="Debug", selected=(icon == "debug"), choose=chooseIcon)
              input value=name input=editName submit=raw((editing ? "sb:action-save" : "sb:action-add"), scope, payload) placeholder="Test" aria-label="Name" disabled=busy class=AeField flex=1 min-width=0 testId="action-name"
          column gap="0.5rem"
            text "Keybinding" class=AeLabel
            when recording
              row class=AeField align-items="center" testId="action-keybinding-recording"
                t3-key-recorder prompt="Press shortcut" change=capture aria-label="Keybinding" testId="action-keybinding-recorder" flex=1 min-width=0 height="1.5rem"
            else
              button press=record aria-label="Keybinding" disabled=busy class=AeField display="flex" flex-direction="row" align-items="center" testId="action-keybinding"
                text (keybinding == "" ? "Press shortcut" : keybinding) font-size="0.875rem" line-height="1.25rem" line-clamp=1 color=(keybinding == "" ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
            row flex-wrap="wrap" align-items="baseline"
              text "Press a shortcut. Use " class=AeHint
              text "Backspace" font-family="ui-monospace" font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
              text " to clear. Shortcuts are environment-wide. Projects using the same action share its shortcut." class=AeHint
          column gap="0.5rem"
            text "Command" class=AeLabel
            // r6-polish: a shell command is typed verbatim: `autocorrect="off"` keeps every typed byte (exact2 #111).
            textarea value=command input=editCommand placeholder="bun test" aria-label="Command" disabled=busy box-sizing="border-box" width="100%" height="4.5rem" padding-left="0.6875rem" padding-right="0.6875rem" padding-top="0.3125rem" padding-bottom="0.3125rem" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff08)" font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false" testId="action-command"
          column gap="0.5rem"
            text "Preview URL (optional)" class=AeLabel
            input value=previewUrl input=editPreview placeholder="http://localhost:5173" aria-label="Preview URL (optional)" disabled=busy class=AeField autocorrect="off" spellcheck="false" testId="action-preview-url"
            text "Open this URL in the in-app preview when this action runs." class=AeHint
          ActionSwitchRow(label="Run automatically on worktree creation", checked=setup, enabled=true, busy=busy, rowId="action-setup", flip=flipSetup)
          ActionSwitchRow(label="Wait for it to finish before the agent starts", checked=wait, enabled=setup, busy=busy, rowId="action-wait", flip=flipWait)
          ActionSwitchRow(label="Open preview automatically when this action runs", checked=autoOpen, enabled=(previewUrl != ""), busy=busy, rowId="action-auto-preview", flip=flipAuto)
          when error != ""
            text error font-size="0.875rem" line-height="1.25rem" role="alert" color="light-dark(#e7000b, #ff6467)" testId="action-error"
        row padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" gap="0.5rem" align-items="center" justify-content="flex-end"
          when editing
            button press=askDelete(true) disabled=busy class=AeOutline border-color="light-dark(#e7000b40, #ff646740)" testId="action-delete"
              text "Delete" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#c10007, #ff6467)"
          box flex=1
          button press=close aria-keyshortcuts="Escape" class=AeOutline testId="action-cancel"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button press=raw((editing ? "sb:action-save" : "sb:action-add"), scope, payload) disabled=busy display="flex" flex-direction="row" align-items="center" justify-content="center" box-sizing="border-box" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" testId="action-save"
            text (busy ? "Saving…" : (editing ? "Save changes" : "Save action")) font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
        button press=close class=AeOutline width="2rem" height="2rem" padding-left=0 padding-right=0 border-width=0 box-shadow="none" background-color="#00000000" position="absolute" top="0.5rem" right="0.5rem" aria-label="Close" testId="action-close"
          CnGlyph(name="x", size=16, color="light-dark(#71717b, #818181)")
      when confirming
        column class=AeOverlay testId="action-delete-overlay"
          column width="100%" max-width="28rem" box-sizing="border-box" padding="1.5rem" gap="1rem" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(12px)" box-shadow="0 24px 64px -24px #000000a6" role="alertdialog" aria-label=`Delete action "${name}"?` testId="action-delete-dialog"
            column gap="0.5rem"
              text `Delete action "${name}"?` font-size="1.125rem" line-height="1.5rem" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
              text "This action cannot be undone." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #818181)"
            row gap="0.5rem" justify-content="flex-end"
              button press=askDelete(false) class=AeOutline aria-keyshortcuts="Escape" testId="action-delete-cancel"
                text "Cancel" font-size="0.875rem" font-weight=500 color="light-dark(#27272a, #f5f5f5)"
              button press=raw("sb:action-delete", scope, payload) disabled=busy display="flex" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" border-radius="0.5rem" border-width=0 background-color="#e7000b" testId="action-delete-confirm"
                text "Delete action" font-size="0.875rem" font-weight=500 color="#ffffff"

// One tile of the icon grid (popover grid-cols-3).
component ScriptIconChoice
  props
    id: string
    label: string
    selected: bool
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose(id) popovertarget="action-icon-picker" popovertargetaction="hide" hover=hover aria-label=label aria-checked=selected role="menuitemradio" testId=`action-icon-${id}` display="flex" flex-direction="column" align-items="center" gap="0.5rem" width="4.5rem" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-radius="0.375rem" border-width=1 border-style="solid" border-color=(selected ? "light-dark(#1b4ed8b3, #346bf1b3)" : "light-dark(#e4e4e7b3, #00000000)") background-color=(selected ? "light-dark(#1b4ed81a, #346bf11a)" : (hovered ? "light-dark(#f4f4f599, #ffffff0f)" : "light-dark(#00000000, #ffffff09)"))
      CnScriptIcon(icon=id, size=16, color="light-dark(#27272a, #f5f5f5)")
      text label font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)"

// The editor's bordered switch rows (labels with a Switch, dimmed when unavailable).
component ActionSwitchRow
  props
    label: string
    checked: bool
    enabled: bool
    busy: bool
    rowId: string
    flip: action
  view
    row width="100%" box-sizing="border-box" padding-top="0.5rem" padding-bottom="0.5rem" padding-left="0.75rem" padding-right="0.75rem" gap="0.75rem" align-items="center" justify-content="space-between" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #00000000)" background-color="light-dark(#00000000, #ffffff09)" opacity=(enabled ? 1 : 0.6) testId=rowId
      text label font-size="0.875rem" line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
      button press=flip role="switch" aria-checked=checked aria-label=label disabled=(busy or not enabled) testId=`${rowId}-switch` width="1.875rem" height="1.125rem" padding="0.125rem" border-width=0 border-radius="624.9375rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") flex-shrink=0 background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
        box width="0.875rem" height="0.875rem" border-radius="624.9375rem" background-color="light-dark(#fcfcfc, #0a0a0a)"
