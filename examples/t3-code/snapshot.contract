// T3 SnapShots (MIT, see LICENSE-T3): the settings route (SnapShotSettings.tsx,
// macOS direct mode), the composer's SnapShot attachment frames
// (SnapShotAttachmentDetails.tsx) and the macOS setup dialog. Sizes and colors
// are the built reference's computed values at 1x: CSS px are points.
use SnapshotSettings from "./shapes.contract"
use SnapshotDraft from "./shapes.contract"
use Overlay from "./shapes.contract"
use Surface from "./shapes.contract"
use Ink from "./shapes.contract"
use Control from "./shapes.contract"
use Primary from "./shapes.contract"
use ImageDraftTile from "./composer-editor.contract"
use ComposerVideo from "./r4-composer.contract"
use VideoDraftTile from "./r4-composer.contract"

style SnapSectionTitle
  font-size=14 font-weight=400 line-height="20px" color="light-dark(#262629b3, #f5f5f5b3)"
style SnapCard
  display="flex" flex-direction="column" width="100%" box-sizing="border-box"
  border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)"
  background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
style SnapRowTitle
  font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
style SnapRowText
  font-size=12 font-weight=400 line-height="18px" color="light-dark(#70707acc, #818181cc)"
style SnapStatus
  font-size=12 font-weight=400 line-height="16px" color="light-dark(#71717b, #818181)"
style SnapInk
  color="light-dark(#27272a, #f5f5f5)"
style SnapOutlineXs
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=4
  box-sizing="border-box" height=24 padding-left=7 padding-right=7 border-radius=8
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
style SnapLabelXs
  font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"
style SnapMenu
  display="flex" flex-direction="column" box-sizing="border-box" width=168 padding=4 margin-top=4
  border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #f5f5f51a)"
  background-color="light-dark(#fffffff2, #111111f2)" backdrop-filter="blur(12px)" box-shadow="0 16px 40px -18px #0000008c"
style SnapGhost
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=32 padding-left=11 padding-right=11
  box-sizing="border-box" border-radius=8 border-width=0 background-color="#00000000" flex-shrink=0
style SnapPrimary
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=32 padding-left=11 padding-right=11
  box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" flex-shrink=0
style SnapButtonText
  font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
style SnapMenuItem
  cursor="pointer"
  display="flex" flex-direction="row" align-items="center" box-sizing="border-box" height=28
  padding-left=8 padding-right=8 border-radius=6 border-width=0 font-size=14 line-height="20px"

// Lucide geometry as the reference renders it (24px grid, stroke 2).
component SnapIcon
  props
    name: string
    size: number
    color: string
  view
    svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      when name == "play"
        path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
      when name == "chevron-down"
        path d="m6 9 6 6 6-6"
      when name == "check"
        path d="M20 6 9 17l-5-5"
      when name == "check-circle"
        circle cx=12 cy=12 r=10
        path d="m9 12 2 2 4-4"
      when name == "x"
        path d="M18 6 6 18"
        path d="m6 6 12 12"
      when name == "image"
        rect width=18 height=18 x=3 y=3 rx=2 ry=2
        circle cx=9 cy=9 r=2
        path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"
      when name == "text"
        path d="M15 18H3"
        path d="M17 6H3"
        path d="M21 12H3"

// ui/switch.tsx: 30x18 track, 14px thumb, primary when checked.
component SnapSwitch
  props
    checked: bool
    label: string
    disabled: bool
    switchId: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled id=switchId testId=switchId display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") width=30 height=18 padding=2 box-sizing="border-box" border-width=0 border-radius=9 flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
      box width=14 height=14 border-radius=7 flex-shrink=0 background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 1px 3px #0000000d"

// settingsLayout.tsx SettingsRow: title, description and status beside a
// right-aligned control column (minmax(10rem, auto), gap 32).
component SnapRow
  props
    title: string
    description: string
    status: string
    first: bool
    rowId: string
  slot
  view
    row id=rowId testId=rowId width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=32 align-items="center" border-top-style="solid" border-top-width=(first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)"
      column flex=1 min-width=0 gap=4
        row min-height=20 align-items="center" gap=6
          text title class=SnapRowTitle role="heading" aria-level=3
        when description != ""
          text description class=SnapRowText max-width=576
        when status != ""
          text status class=SnapStatus padding-top=2 role="status" testId=`${rowId}-status`
      row flex-shrink=0 min-width=160 align-items="center" justify-content="flex-end" gap=8
        children

// SnapShotShortcutKeys: one Kbd per key (⌃ ⌥ ⇧ ⌘, then the key).
component SnapKeys
  props
    data: SnapshotSettings
  view
    row gap=4 align-items="center"
      each chip in data.keys key=chip.id
        row height=20 min-width=20 padding-left=4 padding-right=4 box-sizing="border-box" border-radius=4 align-items="center" justify-content="center" background-color="light-dark(#fafafa, #ffffff08)"
          text chip.label font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)" aria-hidden=true

component SnapshotPanel
  props
    data: SnapshotSettings
    busy: bool
    setupOpen: bool
    toggle: action
    setup: action
    change: action
    preview: action
    record: action
    saveShortcut: action
  view
    column id="snap-shot" gap=10 width="100%" testId="snapshot-settings"
      row min-height=28 padding-left=16 padding-right=16 align-items="center" box-sizing="border-box"
        text "SnapShots" class=SnapSectionTitle role="heading" aria-level=2
      when data.error != ""
        text data.error font-size=12 line-height="16px" color="light-dark(#dc2626, #f87171)" role="alert" padding-left=16 padding-right=16 testId="snapshot-state-error"
      column class=SnapCard
        SnapRow(title="SnapShots", description="Capture a window and attach it to your current draft.", status=(busy ? "Updating capture settings…" : data.statusText), first=true, rowId="snap-shot-enabled")
          when data.setupLabel != ""
            button press=setup class=SnapOutlineXs disabled=busy testId="snapshot-setup" opacity=(busy ? 0.64 : 1)
              text data.setupLabel class=SnapLabelXs
          SnapSwitch(checked=(data.enabled or setupOpen), label="Enable snapshots", disabled=(busy or not data.captureAvailable), switchId="snapshot-enabled", toggle=toggle)
        when data.enabled and data.captureAvailable
          SnapRow(title="Include app text", description="Include text and controls when the app makes them available.", status="", first=false, rowId="snap-shot-accessibility")
            SnapSwitch(checked=data.includeAccessibility, label="Include app text in snapshots", disabled=(busy or not data.captureAvailable), switchId="snapshot-include-text", toggle=change("snapShotIncludeAccessibility", data.includeAccessibility ? "false" : "true"))
          SnapRow(title="Capture shortcut", description="Capture the window you're using without switching apps.", status=data.shortcutStatus, first=false, rowId="snap-shot-shortcut")
            button press=record("true") class=SnapOutlineXs disabled=busy aria-label=data.shortcutAria testId="snapshot-record-shortcut" background-color=(data.recording ? "light-dark(#fafafae6, #ffffff14)" : "light-dark(#ffffff, #ffffff07)") border-color=(data.recording ? "#00000000" : "light-dark(#d4d4d8, #ffffff14)") opacity=(busy ? 0.64 : 1)
              when data.recording
                text "Press shortcut…" class=SnapLabelXs
              else
                SnapKeys(data=data)
            when data.changed
              button press=saveShortcut(data.candidate) disabled=(busy or not data.canSave) testId="snapshot-save-shortcut" display="flex" align-items="center" height=24 padding-left=7 padding-right=7 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" opacity=(busy or not data.canSave ? 0.64 : 1) flex-shrink=0
                text (busy ? "Saving…" : "Save") font-size=12 font-weight=500 line-height="16px" color="#ffffff"
              button press=record("false") disabled=busy testId="snapshot-cancel-shortcut" display="flex" align-items="center" height=24 padding-left=7 padding-right=7 box-sizing="border-box" border-radius=8 border-width=0 background-color="#00000000" opacity=(busy ? 0.64 : 1) flex-shrink=0
                text "Cancel" class=SnapLabelXs
          SnapRow(title="Capture sound", description="Choose the sound played when capture starts.", status="", first=false, rowId="snap-shot-sound")
            box position="relative" flex-shrink=0
              button popovertarget="snapshot-sound-menu" aria-label=`Snapshot sound: ${data.soundLabel}${data.soundSelection == "soft-pop" ? " (Default)" : ""}` disabled=(not data.captureAvailable) testId="snapshot-sound" display="flex" flex-direction="row" align-items="center" gap=6 height=28 padding-left=9 padding-right=9 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" flex-shrink=0
                row gap=4 align-items="center"
                  text data.soundLabel font-size=14 line-height="20px" class=SnapInk white-space="nowrap"
                  when data.soundSelection == "soft-pop"
                    text "(Default)" font-size=14 line-height="20px" color="light-dark(#71717b, #818181)" white-space="nowrap"
                SnapIcon(name="chevron-down", size=12, color="light-dark(#27272a80, #f5f5f580)")
              column id="snapshot-sound-menu" popover="auto" role="menu" aria-label="Snapshot sound" class=SnapMenu position="absolute" top="100%" right=0 testId="snapshot-sound-menu"
                button press=change("snapShotPlaySound", "false") popovertarget="snapshot-sound-menu" popovertargetaction="hide" role="menuitemradio" aria-checked=(data.soundSelection == "off") class=SnapMenuItem width="100%" background-color=(data.soundSelection == "off" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") testId="snapshot-sound-off"
                  text "Off" class=SnapInk
                row width="100%" align-items="center"
                  button press=change("snapShotSound", "soft-pop") popovertarget="snapshot-sound-menu" popovertargetaction="hide" role="menuitemradio" aria-checked=(data.soundSelection == "soft-pop") class=SnapMenuItem flex=1 min-width=0 gap=4 background-color=(data.soundSelection == "soft-pop" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") testId="snapshot-sound-whoosh"
                    text "Whoosh" class=SnapInk white-space="nowrap"
                    text "(Default)" color="light-dark(#71717b, #818181)" white-space="nowrap"
                  button press=preview("soft-pop") role="menuitem" aria-label="Play Whoosh" class=SnapMenuItem width=28 padding-left=0 padding-right=0 justify-content="center" background-color="#00000000" testId="snapshot-play-whoosh"
                    SnapIcon(name="play", size=16, color="light-dark(#27272a, #f5f5f5)")
                row width="100%" align-items="center"
                  button press=change("snapShotSound", "camera-shutter") popovertarget="snapshot-sound-menu" popovertargetaction="hide" role="menuitemradio" aria-checked=(data.soundSelection == "camera-shutter") class=SnapMenuItem flex=1 min-width=0 background-color=(data.soundSelection == "camera-shutter" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000") testId="snapshot-sound-click"
                    text "Click" class=SnapInk
                  button press=preview("camera-shutter") role="menuitem" aria-label="Play Click" class=SnapMenuItem width=28 padding-left=0 padding-right=0 justify-content="center" background-color="#00000000" testId="snapshot-play-click"
                    SnapIcon(name="play", size=16, color="light-dark(#27272a, #f5f5f5)")
          SnapRow(title="Capture flash", description="Show a gentle cue on the captured window.", status="", first=false, rowId="snap-shot-flash")
            SnapSwitch(checked=data.flash, label="Flash captured window", disabled=(busy or not data.captureAvailable), switchId="snapshot-flash", toggle=change("snapShotFlash", data.flash ? "false" : "true"))
          SnapRow(title="Capture animations", description="Animate captured windows into your draft.", status="", first=false, rowId="snap-shot-animations")
            SnapSwitch(checked=data.animations, label="Animate snapshots", disabled=(busy or not data.captureAvailable), switchId="snapshot-animations", toggle=change("snapShotAnimations", data.animations ? "false" : "true"))

// ChatComposer SnapShot attachment frames: 208x112, object-cover image (the
// native hook paints it), app/title band, remove on hover or focus.
component SnapshotTile
  props
    image: SnapshotDraft
    disabled: bool
    remove: action
    // r4-composer: removing an image whose chip is in the prompt asks first (app.contract titleMenuPick's "ui:confirm").
    ask: action
  state hovering = false
  action setHover(over: bool)
    hovering = over
  view
    column hover=setHover position="relative" width=208 max-width="100%" height=112 flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff0d)" background-color="light-dark(#fcfcfc, #0a0a0a)" testId=`snapshot-draft-${image.id}`
      box hook="t3-snapshot-tile" data-snapshot-id=image.id position="absolute" top=0 left=0 right=0 bottom=0 testId=`snapshot-thumbnail-${image.id}`
      row position="absolute" left=0 right=0 bottom=0 gap=6 align-items="center" padding-left=10 padding-right=10 padding-top=24 padding-bottom=8 box-sizing="border-box" min-width=0 background-image="linear-gradient(to top, #000000d9, #0000008c, #00000000)"
        row width=28 height=28 border-radius=8 flex-shrink=0 align-items="center" justify-content="center" background-color="#ffffff33"
          text image.letter font-size=10 font-weight=500 line-height="14px" color="#ffffff"
        column flex=1 min-width=0
          row min-width=0 min-height=20 gap=6 align-items="center"
            text image.app font-size=11 font-weight=500 line-height="14px" color="#ffffff" line-clamp=1 min-width=0
            box position="relative" flex-shrink=0
              button popovertarget=`snapshot-contents-${image.id}` aria-label=(image.included ? "View accessibility data" : "No accessibility data") testId=`snapshot-contents-${image.id}` width=20 height=20 padding=0 border-width=0 border-radius=6 display="flex" align-items="center" justify-content="center" background-color="#000000b3" flex-shrink=0
                SnapIcon(name=(image.included ? "text" : "image"), size=12, color="#ffffffa6")
              column id=`snapshot-contents-${image.id}` popover="auto" role="dialog" aria-label="Accessibility data" position="absolute" bottom="100%" left=-134 margin-bottom=8 width=288 max-height=448 padding=12 gap=8 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#ffffff, #1a1a1a)" box-shadow="0 10px 15px -3px #0000001a" testId=`snapshot-contents-popup-${image.id}`
                text "Accessibility data" font-size=14 font-weight=600 line-height="20px" class=SnapInk
                scroll max-height=256 width="100%" border-radius=6 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7b3, #ffffff12)" background-color="light-dark(#f4f4f573, #ffffff0a)"
                  text (image.contents != "" ? image.contents : image.included ? "Structured accessibility elements were included, but they have no readable names or values." : "The app or capture backend did not provide verified accessibility data.") font-size=11 line-height="16px" font-family=(image.contents != "" ? "monospace" : "system-ui") white-space="pre-wrap" overflow-wrap="anywhere" padding=10 color=(image.contents != "" ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
          text image.title font-size=10 line-height="14px" color="#ffffffb3" line-clamp=1
      row position="absolute" top=4 right=4 opacity=(hovering ? 1 : 0)
        when image.referenced
          button press=ask("ui:confirm", image.id, "remove-snapshot", `Remove ${image.name} from the message?`, "It is referenced in your text; removing it also removes every reference.", true) focus=setHover(true) blur=setHover(false) disabled=disabled aria-label=`Remove ${image.name}` testId=`remove-snapshot-${image.id}` width=24 height=24 padding=0 border-radius=8 border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center"
            SnapIcon(name="x", size=14, color="#ffffff")
        else
          button press=remove(image.id) focus=setHover(true) blur=setHover(false) disabled=disabled aria-label=`Remove ${image.name}` testId=`remove-snapshot-${image.id}` width=24 height=24 padding=0 border-radius=8 border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center"
            SnapIcon(name="x", size=14, color="#ffffff")

component SnapshotDrafts
  props
    images: list<SnapshotDraft>
    disabled: bool
    remove: action
    ask: action
    // r4-composer: the draft's attached videos follow the images (composerVideos, r4-composer.contract).
    videos: list<ComposerVideo>
    command: action
  view
    when length(images) > 0 or length(videos) > 0
      row width="100%" gap=8 overflow-x="scroll" padding-bottom=4 box-sizing="border-box" testId="snapshot-drafts"
        each image in images key=image.id
          when image.snapshot
            SnapshotTile(image=image, disabled=disabled, remove=remove, ask=ask)
          else
            ImageDraftTile(id=image.id, name=image.name, referenced=image.referenced, disabled=disabled, remove=remove, ask=ask)
        each video in videos key=video.id
          VideoDraftTile(video=video, disabled=disabled, command=command)

// SnapShotSetupDialog (macOS direct): Access, then Shortcut. The Shortcut step
// opens once the saved choice is On, access is ready and the shortcut is
// registered; Back returns to Access without changing anything.
component SnapPermission
  props
    title: string
    description: string
    granted: bool
    busy: bool
    allow: action
    rowId: string
  view
    row gap=12 align-items="center" padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" box-sizing="border-box" width="100%" testId=rowId
      box width=32 height=32 border-radius=7 flex-shrink=0 box-sizing="border-box" border-style="solid" border-width=1 border-color="#ffffff40" box-shadow="0 1px 1px #0000000d" background-image=(title == "Accessibility" ? "linear-gradient(to bottom, #48b6ff, #0085ff)" : "linear-gradient(to bottom, #ff6972, #ff2938)")
        svg width=30 height=30 viewBox="1 1 30 30" fill="none" stroke="#ffffff" stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          when title == "Accessibility"
            circle cx=16 cy=16 r=10 stroke-width=1.75
            circle cx=16 cy=10 r=1.6 fill="#ffffff" stroke-width=0
            path d="m10 13 6 1 6-1M16 14v4m0 0-2.5 6m2.5-6 2.5 6" stroke-width=1.6
          else
            circle cx=16 cy=16 r=10 stroke-width=2
            circle cx=16 cy=16 r=4.5 fill="#ffffff" stroke-width=0
      column flex=1 min-width=0
        text title font-size=14 font-weight=500 line-height="20px" class=SnapInk
        text description font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
      when granted
        row gap=4 align-items="center" role="status" testId=`${rowId}-allowed`
          SnapIcon(name="check-circle", size=16, color="light-dark(#16a34a, #4ade80)")
          text "Allowed" font-size=12 line-height="16px" color="light-dark(#16a34a, #4ade80)"
      else
        button press=allow class=SnapOutlineXs disabled=busy testId=`${rowId}-allow` opacity=(busy ? 0.64 : 1)
          text "Allow" class=SnapLabelXs

component SnapshotSetup
  props
    data: SnapshotSettings
    busy: bool
    error: string
    wasEnabled: bool
    close: action
    toggle: action
    change: action
    record: action
    saveShortcut: action
  state back = false
  state advanced = false
  action goBack(value: bool)
    back = value
  action toggleAdvanced
    advanced = not advanced
  view
    // Reference dialog-backdrop: the page at 60% (64% dark) behind a 4px blur.
    column position="absolute" left=0 right=0 top=0 bottom=0 display="flex" align-items="center" justify-content="center" padding=16 box-sizing="border-box" z-index=20 background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)"
      column position="relative" width="100%" max-width=576 border-radius=18 box-sizing="border-box" overflow="hidden" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfccc, #0a0a0acc)" backdrop-filter="blur(24px)" box-shadow="0 24px 64px -24px light-dark(#000000a6, #000000e6)" role="dialog" aria-label="Set up snapshots" testId="snapshot-setup-dialog"
        column padding-top=24 padding-left=24 padding-right=24 padding-bottom=12 gap=8 box-sizing="border-box"
          text "Set up snapshots" font-size=20 font-weight=600 line-height="20px" class=SnapInk role="heading" aria-level=2
          row gap=4 padding=4 border-radius=14 background-color="light-dark(#fcfcfc, #ffffff0a)" box-shadow="0 0 0 1px light-dark(#0000000d, #ffffff0d)" role="list" aria-label="Setup progress"
            row flex=1 min-width=0 gap=8 align-items="center" padding-left=10 padding-right=10 padding-top=8 padding-bottom=8 border-radius=10 background-color=(data.setupReady and not back ? "#00000000" : "light-dark(#ffffff, #111111)") box-shadow=(data.setupReady and not back ? "none" : "0 1px 2px #0000000d, 0 0 0 1px light-dark(#0000000d, #ffffff0d)") testId="snapshot-setup-step-access"
              row width=20 height=20 border-radius=10 align-items="center" justify-content="center" flex-shrink=0 background-color=(data.setupReady and not back ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#1b4ed81a, #346bf11a)") box-shadow=(data.setupReady and not back ? "0 0 0 1px light-dark(#1b4ed8, #346bf1)" : "0 0 0 1px light-dark(#1b4ed84d, #346bf14d)")
                when data.setupReady and not back
                  SnapIcon(name="check", size=14, color="#ffffff")
                else
                  text "1" font-size=14 font-weight=500 line-height="20px" color="light-dark(#1b4ed8, #346bf1)"
              text "Access" font-size=14 font-weight=500 line-height="20px" color=(data.setupReady and not back ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)")
            row flex=1 min-width=0 gap=8 align-items="center" padding-left=10 padding-right=10 padding-top=8 padding-bottom=8 border-radius=10 background-color=(data.setupReady and not back ? "light-dark(#ffffff, #111111)" : "#00000000") box-shadow=(data.setupReady and not back ? "0 1px 2px #0000000d, 0 0 0 1px light-dark(#0000000d, #ffffff0d)" : "none") testId="snapshot-setup-step-shortcut"
              row width=20 height=20 border-radius=10 align-items="center" justify-content="center" flex-shrink=0 background-color=(data.setupReady and not back ? "light-dark(#1b4ed81a, #346bf11a)" : "light-dark(#ffffff, #ffffff0d)") box-shadow=(data.setupReady and not back ? "0 0 0 1px light-dark(#1b4ed84d, #346bf14d)" : "0 0 0 1px light-dark(#0000001a, #ffffff1a)")
                text "2" font-size=14 font-weight=500 line-height="20px" color=(data.setupReady and not back ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#71717b, #818181)")
              text "Shortcut" font-size=14 font-weight=500 line-height="20px" color=(data.setupReady and not back ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")
        column padding-left=24 padding-right=24 padding-top=20 padding-bottom=20 gap=16 box-sizing="border-box" background-color="light-dark(#fcfcfccc, #ffffff05)" box-shadow="0 0 0 1px light-dark(#0000000d, #ffffff0d)"
          when data.setupReady and not back
            column gap=8
              text "Choose your shortcut" font-size=14 font-weight=500 line-height="20px" class=SnapInk role="heading" aria-level=3
              text "Use both Shift keys, or record a different shortcut." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
            column gap=12 align-items="flex-start"
              row gap=8 align-items="center"
                button press=record("true") class=SnapOutlineXs disabled=busy aria-label=data.shortcutAria testId="snapshot-setup-record" background-color=(data.recording ? "light-dark(#fafafae6, #ffffff14)" : "light-dark(#ffffff, #ffffff07)")
                  when data.recording
                    text "Press shortcut…" class=SnapLabelXs
                  else
                    SnapKeys(data=data)
                when data.changed
                  button press=record("false") disabled=busy testId="snapshot-setup-cancel-shortcut" display="flex" align-items="center" height=24 padding-left=7 padding-right=7 box-sizing="border-box" border-radius=8 border-width=0 background-color="#00000000"
                    text "Cancel" class=SnapLabelXs
              when data.shortcutStatus != ""
                text data.shortcutStatus font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" role="status" testId="snapshot-setup-shortcut-status"
          else
            column gap=8
              text "Allow snapshots" font-size=14 font-weight=500 line-height="20px" class=SnapInk role="heading" aria-level=3
              text ((data.screenRecording and (data.accessibility or not data.includeAccessibility)) ? "Test a snapshot of the current window. If macOS asks to bypass its window picker, choose Allow. The test image is discarded." : "Allow each permission, then continue.") font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
            column gap=8 width="100%"
              SnapPermission(title="Screen Recording", description="Capture the window you're using.", granted=data.screenRecording, busy=busy, allow=change("setup", "allow-screen-recording"), rowId="snapshot-permission-screen")
              SnapPermission(title="Accessibility", description=(data.includeAccessibility ? "Include text and controls from the captured app." : "Optional. Include text and controls from the captured app."), granted=data.accessibility, busy=busy, allow=change("setup", "allow-accessibility"), rowId="snapshot-permission-accessibility")
          when error != ""
            text "Couldn't finish this step. Try again or check Advanced for help." font-size=14 line-height="20px" color="light-dark(#dc2626, #f87171)" role="alert" testId="snapshot-setup-error"
            // Reference <details><summary>Advanced</summary>: the error detail, collapsed.
            column gap=12
              button press=toggleAdvanced aria-expanded=advanced testId="snapshot-setup-advanced" display="flex" flex-direction="row" align-items="center" gap=4 padding=0 border-width=0 background-color="#00000000" align-self="flex-start"
                svg width=10 height=10 viewBox="0 0 10 10" color="light-dark(#71717b, #818181)" aria-hidden=true flex-shrink=0
                  path d=(advanced ? "M1 3h8L5 8z" : "M3 1v8l5-4z") fill="currentColor"
                text "Advanced" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
              when advanced
                text error font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" overflow-wrap="anywhere" testId="snapshot-setup-error-detail"
        row padding-top=16 padding-bottom=16 padding-left=24 padding-right=24 gap=8 justify-content="flex-end" box-sizing="border-box"
          when busy
            box width=0 height=0
          else
            when wasEnabled or not data.enabled
              button press=close aria-label="Close" testId="snapshot-setup-close" position="absolute" top=8 right=8 width=32 height=32 padding=0 border-radius=8 border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center"
                SnapIcon(name="x", size=16, color="light-dark(#27272a, #f5f5f5)")
            else
              button press=toggle aria-label="Close" testId="snapshot-setup-close" position="absolute" top=8 right=8 width=32 height=32 padding=0 border-radius=8 border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center"
                SnapIcon(name="x", size=16, color="light-dark(#27272a, #f5f5f5)")
          when data.setupReady and not back
            button press=goBack(true) disabled=busy class=SnapGhost testId="snapshot-setup-back"
              text "Back" class=SnapButtonText
          when wasEnabled or not data.enabled
            button press=close disabled=busy class=SnapGhost testId="snapshot-setup-cancel" aria-keyshortcuts="Escape"
              text (wasEnabled ? "Close" : "Finish later") class=SnapButtonText
          else
            button press=toggle disabled=busy class=SnapGhost testId="snapshot-setup-cancel" aria-keyshortcuts="Escape"
              text "Finish later" class=SnapButtonText
          when data.setupReady and not back
            when data.changed
              button press=saveShortcut(data.candidate) disabled=(busy or not data.canSave) class=SnapPrimary opacity=(busy or not data.canSave ? 0.64 : 1) testId="snapshot-setup-done"
                text (busy ? "Saving…" : "Save and finish") font-size=14 font-weight=500 line-height="20px" color="#ffffff"
            else
              button press=close disabled=busy class=SnapPrimary opacity=(busy ? 0.64 : 1) testId="snapshot-setup-done"
                text "Done" font-size=14 font-weight=500 line-height="20px" color="#ffffff"
          else
            button press=change("setup", "continue") disabled=(busy or not data.screenRecording or (data.includeAccessibility and not data.accessibility)) class=SnapPrimary opacity=((busy or not data.screenRecording or (data.includeAccessibility and not data.accessibility)) ? 0.64 : 1) testId="snapshot-setup-enable"
              text (busy ? "Working…" : "Test capture and continue") font-size=14 font-weight=500 line-height="20px" color="#ffffff"
