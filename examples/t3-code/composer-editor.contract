// T3's prompt editor surfaces (composer-editor.ts): the command menu drawer
// above the composer (ComposerCommandMenu.tsx in a ComposerBanner.Surface),
// the prompt-length line (ComposerPromptLengthValidation.tsx) and the hidden
// key buttons the native editor (T3ComposerEditor.swift) presses for ↑ ↓ ↩ ⇥
// while the menu is open, and for ⇧⇥ (the plan toggle).

shape ComposerMenuRow
  id: string
  index: number
  type: string
  label: string
  prefix: string
  description: string
  icon: string
  iconLight: string
  iconDark: string
  badge: string
  badgeIcon: string
shape ComposerMenu
  open: bool
  kind: string
  listLabel: string
  searchKey: string
  loading: bool
  emptyText: string
  count: number
  rows: list<ComposerMenuRow>
shape ComposerStashRow
  id: string
  index: number
  snippet: string
  age: string
  label: string
shape ComposerStash
  count: number
  pulse: number
  rows: list<ComposerStashRow>
  menuOpen: bool
  keyStash: string
// ComposerCommandMenuLayer: the drawers' place over the chat column (composer-editor-drawer.ts).
shape ComposerDrawer
  placed: bool
  left: number
  width: number
  bottom: number
  listMax: number
  // The card's window frame (a sidebar thread held over it rings it).
  cardX: number
  cardY: number
  cardWidth: number
  cardHeight: number
  // The expanded stack's height, kept while the composer rests (composerStackHold).
  hold: number
shape ComposerEditorView
  owner: string
  menu: ComposerMenu
  promptLimit: string
  overLimit: bool
  usageLimits: number
  stash: ComposerStash
  drawer: ComposerDrawer

// The stash badge's count lifts to the primary ink for 1.2s after a save;
// two names let a later save restart it (ComposerStashBadge pulseKey).
keyframes cePulseA
  from opacity=1
  99% opacity=1
  to opacity=0
keyframes cePulseB
  from opacity=1
  99% opacity=1
  to opacity=0

// Row glyphs: lucide strokes, Pierre file-type icons (16px grid, filled).
component EditorMenuIcon
  props
    name: string
    color: string
    size: number
  view
    when name == "messages-square" or name == "folder" or name == "blocks" or name == "user-round" or name == "settings" or name == "package" or name == "git-pull-request" or name == "git-pull-request-draft" or name == "git-merge" or name == "git-pull-request-closed"
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
        when name == "messages-square"
          path d="M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"
          path d="M20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1"
        when name == "folder"
          path d="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
        when name == "blocks"
          path d="M10 22V7a1 1 0 0 0-1-1H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-5a1 1 0 0 0-1-1H2"
          rect x=14 y=2 width=8 height=8 rx=1
        when name == "user-round"
          circle cx=12 cy=8 r=5
          path d="M20 21a8 8 0 0 0-16 0"
        when name == "settings"
          path d="M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915"
          circle cx=12 cy=12 r=3
        when name == "package"
          path d="M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73zM12 22V12M3.29 7 12 12l8.71-5M7.5 4.27l9 5.15"
        when name == "git-pull-request" or name == "git-pull-request-draft" or name == "git-merge" or name == "git-pull-request-closed"
          circle cx=6 cy=6 r=3
          circle cx=18 cy=18 r=3
          when name == "git-pull-request"
            path d="M13 6h3a2 2 0 0 1 2 2v7M6 9v12"
          when name == "git-pull-request-draft"
            path d="M18 6V5M18 11v-1M6 9v12"
          when name == "git-merge"
            path d="M6 21V9a9 9 0 0 0 9 9"
          when name == "git-pull-request-closed"
            path d="M6 9v12m15-18-6 6m6 0-6-6m3 8.5V15"
    else
      svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 16 16" color=color fill="currentColor" flex-shrink=0 aria-hidden=true
        when name == "pierre-markdown"
          path d="M1 12V4h2l2 2.5L7 4h2v8H7V7.5l-2 2-2-2V12zm9-3 3 3.5L16 9h-2V4h-2v5z"
        when name == "pierre-typescript" or name == "pierre-javascript" or name == "pierre-bash" or name == "pierre-python" or name == "pierre-go" or name == "pierre-react"
          path d="M8 1C2.24 1 1 2.24 1 8s1.24 7 7 7 7-1.24 7-7-1.24-7-7-7" opacity=0.2
          when name == "pierre-typescript"
            path d="M8.1 9.64h.95c.04.62.28.76 1.28.76s1.2-.14 1.2-.85c0-.66-.2-.85-1.2-1.07-1.79-.38-2.18-.7-2.18-1.86C8.15 5.3 8.54 5 10.31 5c1.67 0 2.04.26 2.07 1.42h-.95c-.02-.43-.23-.53-1.1-.53-1 0-1.22.14-1.22.74 0 .52.22.7 1.24.92 1.76.38 2.15.73 2.15 2 0 1.44-.4 1.75-2.24 1.75-1.8 0-2.18-.3-2.15-1.66m-3 1.57V5.99H3.5v-.9h4.21v.9H6.1v5.22z"
        when name == "pierre-image"
          path d="M12.5 2A2.5 2.5 0 0 1 15 4.5v4.67l-4.05-3.54-4.08 4.08-3-2L1 10.6V4.5A2.5 2.5 0 0 1 3.5 2z" opacity=0.3
          path d="M15 10.5v1a2.5 2.5 0 0 1-2.5 2.5h-9a2.5 2.5 0 0 1-2.46-2.04L4 9l3 2 4-4zm-7-5a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"
        when name == "pierre-text"
          path d="M8 4a3 3 0 0 0 3 3h3v5.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 12.5v-9A2.5 2.5 0 0 1 4.5 1H8z" fill-rule="evenodd" opacity=0.4
          path d="M8.5 11a.5.5 0 0 1 0 1h-3a.5.5 0 0 1 0-1zm2-2a.5.5 0 0 1 0 1h-5a.5.5 0 0 1 0-1zm-1-8a.5.5 0 0 1 .354.146l4 4A.5.5 0 0 1 14 5.5V6h-3a2 2 0 0 1-2-2V1z"
        when name != "pierre-markdown" and name != "pierre-typescript" and name != "pierre-javascript" and name != "pierre-bash" and name != "pierre-python" and name != "pierre-go" and name != "pierre-react" and name != "pierre-image" and name != "pierre-text"
          path d="M8 1v3a3 3 0 0 0 3 3h3v5.5a2.5 2.5 0 0 1-2.5 2.5h-7A2.5 2.5 0 0 1 2 12.5v-9A2.5 2.5 0 0 1 4.5 1z" opacity=0.4
          path d="M9.5 1a.5.5 0 0 1 .354.146l4 4A.5.5 0 0 1 14 5.5V6h-3a2 2 0 0 1-2-2V1z"

// The drawer: a ComposerBanner surface attached above the composer card,
// 22pt inside its edges, whose last 17pt the card covers (the seam).
component ComposerCommandMenu
  props
    menu: ComposerMenu
    dark: bool
    listMax: number
    layered: bool
    op: action
  // Child state outlives the menu; the search key scopes the highlight to the
  // query it was made under (resolveComposerMenuActiveItemId).
  state highlight = 0
  state highlightKey = ""
  derive active = (highlightKey == menu.searchKey and highlight < menu.count ? highlight : 0)
  action move(delta: number)
    highlight = (active + delta + menu.count) % max(1, menu.count)
    highlightKey = menu.searchKey
  action hovered(index: number, over: bool)
    if over
      highlight = index
      highlightKey = menu.searchKey
  view
    column width=(layered ? "100%" : "calc(100% - 44px)") margin-left=(layered ? "0px" : "1.375rem") margin-right=(layered ? "0px" : "1.375rem") margin-bottom=(layered ? "0px" : "-1.0625rem") padding-bottom="1.0625rem" box-sizing="border-box" position="relative" border-top-left-radius="1.125rem" border-top-right-radius="1.125rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#27272a14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" backdrop-filter=(layered ? "none" : (dark ? "blur(16px)" : "blur(12px)")) box-shadow="0 12px 28px -18px light-dark(#00000066, #000000bf)" testId="composer-command-menu"
      // Dark surfaces shade the 10pt above the seam (bg-composer-seam-above).
      when dark
        box position="absolute" left=0 right=0 bottom="1.0625rem" height="0.625rem" pointer-events="none" background-image="linear-gradient(to top, #0000002e, #00000000)" aria-hidden=true
      when menu.count > 0
        column max-height=listMax overflow-y="scroll" padding="0.5rem" box-sizing="border-box" width="100%" role="listbox" aria-label=menu.listLabel testId="composer-command-list"
          button hook="t3-composer-key" data-anchor="ArrowDown" press=move(1) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-menu-down"
            text "composer-menu-down" font-size=1
          button hook="t3-composer-key" data-anchor="ArrowUp" press=move(-1) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-menu-up"
            text "composer-menu-up" font-size=1
          each row in menu.rows key=row.id
            when row.index == active
              button hook="t3-composer-key" data-anchor="Enter" press=op("pick", row.id, "") position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-menu-enter"
                text "composer-menu-enter" font-size=1
            button press=op("pick", row.id, "") hover=hovered(row.index) role="option" aria-selected=(row.index == active) aria-label=`${row.prefix}${row.label} ${row.description}` testId=`composer-suggestion-${row.index}` width="100%" height="1.75rem" flex-shrink=0 padding-top="0.375rem" padding-bottom="0.375rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap="0.5rem" border-width=0 border-radius="0.375rem" background-color=(row.index == active ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000")
              when row.icon != "" and dark
                EditorMenuIcon(name=row.icon, color=row.iconDark, size=16)
              when row.icon != "" and not dark
                EditorMenuIcon(name=row.icon, color=row.iconLight, size=16)
              row flex=1 min-width=0 gap="0.5rem" align-items="center"
                row max-width="45%" min-width=0 flex-shrink=0
                  when row.prefix != ""
                    text row.prefix font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #818181)" white-space="nowrap" flex-shrink=0
                  text row.label font-size="0.75rem" font-weight=500 line-height="1rem" color=(row.index == active ? "light-dark(#18181b, #f5f5f5)" : "light-dark(#262626, #f5f5f5)") line-clamp=1 min-width=0
                text row.description flex=1 min-width=0 font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)" line-clamp=1 text-align="left"
                when row.badge != ""
                  row height="1.125rem" min-width="1.125rem" padding-left="0.1875rem" padding-right="0.1875rem" gap="0.25rem" margin-left="auto" align-items="center" justify-content="center" border-radius="0.25rem" background-color="light-dark(#f4f4f5, #ffffff0f)" flex-shrink=0
                    box opacity=0.8 display="flex"
                      EditorMenuIcon(name=row.badgeIcon, color="light-dark(#18181b, #f5f5f5)", size=12)
                    text row.badge font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #f5f5f5)" white-space="nowrap"
      else
        column padding-top="0.875rem" padding-bottom="1.75rem" padding-left="1.25rem" padding-right="1.25rem" box-sizing="border-box" width="100%" role="status" testId="composer-command-empty"
          text menu.emptyText font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)"

// ComposerPromptLengthValidation: px-4 pb-2 text-xs destructive (#fb2c36 / #fb414a served), role=alert.
component PromptLengthValidation
  props
    message: string
  view
    text message role="alert" padding-left="1rem" padding-right="1rem" padding-bottom="0.5rem" font-size="0.75rem" line-height="1rem" color="light-dark(#fb2c36, #fb414a)" testId="composer-prompt-length"

component StashGlyph
  props
    name: string
    size: number
    color: string
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      when name == "bookmark"
        path d="M17 3a2 2 0 0 1 2 2v15a1 1 0 0 1-1.496.868l-4.512-2.578a2 2 0 0 0-1.984 0l-4.512 2.578A1 1 0 0 1 5 20V5a2 2 0 0 1 2-2z"
      when name == "file-text"
        path d="M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2zM14 2v5a1 1 0 0 0 1 1h5M10 9H8M16 13H8M16 17H8"
      when name == "x"
        path d="M18 6 6 18M6 6l12 12"
      when name == "chevron-down"
        path d="m6 9 6 6 6-6"

// ComposerStashBadge: a shoulder tab at the composer's top-right (22pt in),
// whose last 17pt the card covers, beside the banners (app.contract puts it
// at the end of their row). ⌘S's chord is its key binding.
component StashKey
  props
    stash: ComposerStash
    op: action
  view
    button press=op("stash", "", "") aria-keyshortcuts=stash.keyStash aria-label="Stash prompt" position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-stash-key"
      text "composer-stash-key" font-size=1

component StashBadge
  props
    stash: ComposerStash
    op: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row flex-shrink=0 padding-right="1.375rem" box-sizing="border-box" margin-bottom=(stash.count > 0 ? "-1.0625rem" : "0px") position="relative"
      when stash.count > 0
        column padding-top="0.3125rem" padding-bottom="1.375rem" padding-left="0.25rem" padding-right="0.25rem" box-sizing="border-box" border-top-left-radius="1.125rem" border-top-right-radius="1.125rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#27272a14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" box-shadow="0 12px 28px -18px light-dark(#00000066, #000000bf)"
          button press=op("stash-menu", "", "toggle") hover=hover aria-label=`Stashed prompts: ${stash.count}. Open stash.` aria-expanded=false testId="composer-stash-badge" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap=0
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              StashGlyph(name="bookmark", size=12, color=(over ? "light-dark(#262626, #f5f5f5)" : "light-dark(#71717a, #818181)"))
            text "Stash" font-size="0.75rem" line-height="1rem" color=(over ? "light-dark(#262626, #f5f5f5)" : "light-dark(#71717a, #818181)") padding-right="0.25rem"
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" position="relative" flex-shrink=0
              text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #818181)"
              when stash.pulse > 0
                box position="absolute" left=0 top=0 width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" opacity=0 animation=(stash.pulse % 2 == 0 ? "cePulseA 1.2s linear forwards" : "cePulseB 1.2s linear forwards") aria-hidden=true
                  text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#18181b, #fafafa)"

// ComposerStashMenu: the attached drawer listing stashed prompts. ↑ ↓ ↩ and
// ⌘⌫ are key buttons the native editor presses; Escape closes.
component StashMenu
  props
    stash: ComposerStash
    layered: bool
    op: action
  state highlight = 0
  derive active = (highlight < stash.count ? highlight : 0)
  action move(delta: number)
    highlight = (active + delta + stash.count) % max(1, stash.count)
  action hovered(index: number, over: bool)
    if over
      highlight = index
  view
    column width=(layered ? "100%" : "calc(100% - 44px)") margin-left=(layered ? "0px" : "1.375rem") margin-right=(layered ? "0px" : "1.375rem") margin-bottom=(layered ? "0px" : "-1.0625rem") padding-top="0.25rem" padding-left="0.25rem" padding-right="0.25rem" padding-bottom="1.3125rem" box-sizing="border-box" border-top-left-radius="1.125rem" border-top-right-radius="1.125rem" border-style="solid" border-width=1 border-bottom-width=0 border-color="light-dark(#27272a14, #ffffff0d)" background-color="light-dark(#ffffffcc, #111111cc)" box-shadow="0 12px 28px -18px light-dark(#00000066, #000000bf)" testId="composer-stash-menu"
      button press=op("stash-menu", "", "close") aria-label="Close stash" aria-expanded=true aria-keyshortcuts="Escape" testId="composer-stash-close" width="100%" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap=0
        box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          StashGlyph(name="bookmark", size=12, color="light-dark(#71717a, #818181)")
        text "Stash" flex=1 font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)" text-align="left"
        box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          text `${stash.count}` font-size="0.75rem" font-weight=500 line-height="1rem" color="light-dark(#71717a, #818181)"
        box width="1.5rem" height="1.5rem" margin-left="0.25rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
          StashGlyph(name="chevron-down", size=14, color="light-dark(#71717a, #818181)")
      column width="100%" gap=1 max-height="12.5rem" overflow-y="scroll" role="list" aria-label="Stashed prompts" testId="composer-stash-list"
        button hook="t3-composer-key" data-anchor="stash-ArrowDown" press=move(1) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-stash-down"
          text "composer-stash-down" font-size=1
        button hook="t3-composer-key" data-anchor="stash-ArrowUp" press=move(-1) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-stash-up"
          text "composer-stash-up" font-size=1
        each entry in stash.rows key=entry.id
          when entry.index == active
            button hook="t3-composer-key" data-anchor="stash-Enter" press=op("stash-restore", entry.id, "") position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-stash-enter"
              text "composer-stash-enter" font-size=1
            button hook="t3-composer-key" data-anchor="stash-Delete" press=op("stash-delete", entry.id, "") position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-stash-delete-key"
              text "composer-stash-delete-key" font-size=1
          row width="100%" height="1.5rem" flex-shrink=0 align-items="center" border-radius="0.375rem" background-color=(entry.index == active ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") role="listitem" hover=hovered(entry.index)
            box width="1.5rem" height="1.5rem" display="flex" align-items="center" justify-content="center" flex-shrink=0
              StashGlyph(name="file-text", size=12, color="light-dark(#71717a, #818181)")
            button press=op("stash-restore", entry.id, "") aria-label=entry.label testId=`composer-stash-restore-${entry.index}` flex=1 min-width=0 height="1.5rem" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="flex-start"
              text entry.snippet font-size="0.75rem" line-height="1rem" color="light-dark(#27272acc, #f5f5f5cc)" line-clamp=1 min-width=0 text-align="left"
            row gap="0.25rem" align-items="center" flex-shrink=0 padding-left="0.25rem"
              text entry.age font-size="0.75rem" line-height="1rem" color="light-dark(#71717a, #818181)" white-space="nowrap"
              button press=op("stash-delete", entry.id, "") aria-label="Delete stashed prompt" testId=`composer-stash-delete-${entry.index}` width="1.5rem" height="1.5rem" padding=0 border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" align-items="center" justify-content="center"
                StashGlyph(name="x", size=14, color="light-dark(#71717a, #818181)")

// Everything the prompt editor attaches above the composer card: ⌘S; the key
// button a picked `/model` presses to open the picker; and, until the layer
// below is placed, the command or stash menu in the composer's flow. (The
// stash badge rides the banners' row, app.contract.)
component ComposerEditorDock
  props
    editor: ComposerEditorView
    dark: bool
    op: action
    openModels: action
  view
    column width="100%" position="relative"
      StashKey(stash=editor.stash, op=op)
      button hook="t3-composer-key" data-anchor="models" press=openModels position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-models-key"
        text "composer-models-key" font-size=1
      when not editor.drawer.placed
        when editor.menu.open
          ComposerCommandMenu(menu=editor.menu, dark=dark, listMax=288, layered=false, op=op)
        else
          when editor.stash.menuOpen
            StashMenu(stash=editor.stash, layered=false, op=op)

// ComposerCommandMenuLayer: the open drawer over the chat column, 22pt inside
// the card's edges, its last 17pt (the seam) under the card. Nothing in the
// transcript or the composer moves when it opens, and the banners stay under it.
// r4-composer: app-main.contract paints it after the composer overlay (banners
// and card together), so the layer ends at the card's top and clips its seam
// (margin-bottom -17 inside overflow hidden), which the card covered before.
// The layer carries the surface's backdrop blur: a blur sees its parent's
// subtree, here the chat column with the transcript and the overlay.
component ComposerDrawerLayer
  props
    editor: ComposerEditorView
    dark: bool
    op: action
  view
    when editor.drawer.placed and (editor.menu.open or editor.stash.menuOpen)
      column position="absolute" left=(editor.drawer.left + 22) width=(editor.drawer.width - 44) bottom=editor.drawer.bottom overflow="hidden" border-top-left-radius="1.125rem" border-top-right-radius="1.125rem" backdrop-filter=(dark ? "blur(16px)" : "blur(12px)") testId="composer-drawer-layer"
        column width="100%" margin-bottom="-1.0625rem" flex-shrink=0
          when editor.menu.open
            ComposerCommandMenu(menu=editor.menu, dark=dark, listMax=editor.drawer.listMax, layered=true, op=op)
          else
            StashMenu(stash=editor.stash, layered=true, op=op)

// An image picked with Attach files on the shelf (ChatComposer's non-snap-shot
// frame): a 64pt square thumbnail (object-cover, the SnapShot tile hook draws
// the draft PNG) with its media-close Remove always shown, no capture details.
component ImageDraftTile
  props
    id: string
    name: string
    // r4-composer: its chip is in the prompt, so Remove asks first (removeComposerImage).
    referenced: bool
    disabled: bool
    remove: action
    ask: action
  view
    column position="relative" width="4rem" height="4rem" flex-shrink=0 box-sizing="border-box" overflow="hidden" border-radius="0.625rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7cc, #ffffff0d)" background-color="light-dark(#fcfcfc, #0a0a0a)" aria-label=name testId=`image-draft-${id}`
      box hook="t3-snapshot-tile" data-snapshot-id=id position="absolute" top=0 left=0 right=0 bottom=0 testId=`snapshot-thumbnail-${id}`
      row position="absolute" top="0.25rem" right="0.25rem"
        when referenced
          button press=ask("ui:confirm", id, "remove-snapshot", `Remove ${name} from the message?`, "It is referenced in your text; removing it also removes every reference.", true) disabled=disabled aria-label=`Remove ${name}` testId=`remove-snapshot-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center"
            StashGlyph(name="x", size=14, color="#ffffff")
        else
          button press=remove(id) disabled=disabled aria-label=`Remove ${name}` testId=`remove-snapshot-${id}` width="1.5rem" height="1.5rem" padding=0 border-radius="0.5rem" border-width=0 box-shadow="0 1px 2px #0000000d, 0 0 0 1px #ffffff33" background-color="#000000a6" display="flex" align-items="center" justify-content="center"
            StashGlyph(name="x", size=14, color="#ffffff")
