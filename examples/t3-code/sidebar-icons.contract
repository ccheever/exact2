use ProjectGlyph from "./sidebar-shapes.contract"
use ProjectMark from "./icons.contract"

// Lucide geometry for the sidebar's own glyphs (24px grid, stroke 2), flattened
// to one path each, as the built T3 reference renders them (lucide 0.56x).
component SidebarIcon
  props
    name: string
    size: number
    color: string
