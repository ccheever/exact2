me == "clock" ? "M12 6v6l4 2M2 12a10 10 0 1 0 20 0a10 10 0 1 0 -20 0" : name == "x" ? "M18 6 6 18M6 6l12 12" : name == "folder" ? "M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z" : name == "settings" ? "M9.671 4.136a2.34 2.34 0 0 1 4.659 0 2.34 2.34 0 0 0 3.319 1.915 2.34 2.34 0 0 1 2.33 4.033 2.34 2.34 0 0 0 0 3.831 2.34 2.34 0 0 1-2.33 4.033 2.34 2.34 0 0 0-3.319 1.915 2.34 2.34 0 0 1-4.659 0 2.34 2.34 0 0 0-3.32-1.915 2.34 2.34 0 0 1-2.33-4.033 2.34 2.34 0 0 0 0-3.831A2.34 2.34 0 0 1 6.35 6.051a2.34 2.34 0 0 0 3.319-1.915M9 12a3 3 0 1 0 6 0a3 3 0 1 0 -6 0" : name == "search" ? "M21 21l-4.34-4.34M3 11a8 8 0 1 0 16 0a8 8 0 1 0 -16 0" : name == "chevron-down" ? "M6 9l6 6 6-6" : name == "chevron-up" ? "M18 15l-6-6-6 6" : name == "folder-git-2" ? "M9 20H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h3.9a2 2 0 0 1 1.69.9l.81 1.2a2 2 0 0 0 1.67.9H20a2 2 0 0 1 2 2v5M11 12a2 2 0 1 0 4 0a2 2 0 1 0 -4 0M18 19c-2.8 0-5-2.2-5-5v8M18 19a2 2 0 1 0 4 0a2 2 0 1 0 -4 0" : name == "git-branch" ? "M6 3L6 15M15 6a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M3 18a3 3 0 1 0 6 0a3 3 0 1 0 -6 0M18 9a9 9 0 0 1-9 9" : name == "layers" ? "M12 2l10 6-10 6L2 8l10-6Zm-10 11 10 6 10-6M2 18l10 6 10-6" : name == "calendar" ? "M8 2v4M16 2v4M5 4h14a2 2 0 0 1 2 2v14a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-14a2 2 0 0 1 2 -2ZM3 10h18" : name == "laptop" ? "M18 5a2 2 0 0 1 2 2v8.526a2 2 0 0 0 .212.897l1.068 2.127a1 1 0 0 1-.9 1.45H3.62a1 1 0 0 1-.9-1.45l1.068-2.127A2 2 0 0 0 4 15.526V7a2 2 0 0 1 2-2zM20.054 15.987H3.946" : name == "monitor" ? "M4 3h16a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2ZM8 21L16 21M12 17L12 21" : name == "server" ? "M4 2h16a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-4a2 2 0 0 1 2 -2ZM4 14h16a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-4a2 2 0 0 1 2 -2ZM6 6L6.01 6M6 18L6.01 18" : name == "cloud" ? "M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" : name == "mac-mini" ? "M4 8h16a2 2 0 0 1 2 2v4a2 2 0 0 1 -2 2h-16a2 2 0 0 1 -2 -2v-4a2 2 0 0 1 2 -2ZM6 12h.01" : name == "mac-studio" ? "M5 5h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10a2 2 0 0 1 2 -2ZM7 15h.01M11 15h.01M15 15h.01" : name == "messages-square" ? "M16 10a2 2 0 0 1-2 2H6.828a2 2 0 0 0-1.414.586l-2.202 2.202A.71.71 0 0 1 2 14.286V4a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2zM20 9a2 2 0 0 1 2 2v10.286a.71.71 0 0 1-1.212.502l-2.202-2.202A2 2 0 0 0 17.172 19H10a2 2 0 0 1-2-2v-1" : name == "arrow-right-left" ? "M16 3l4 4-4 4M20 7H4M8 21l-4-4 4-4M4 17h16" : name == "loader" ? "M21 12a9 9 0 1 1-6.219-8.56" : name == "download" ? "M12 15V3M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5" : name == "triangle-alert" ? "m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3M12 9v4M12 17h.01" : ""
  view
    svg width=size height=size viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      path d=geometry

// ProjectFavicon on sidebar surfaces (r3-sidebar-glyph.ts): a Lucide override
// in its color, an emoji at 80% of the tile, the favicon image (25% rounded),
// else the monogram tile. `dim` is a receding slim row's grayscale.
component SidebarProjectGlyph
  props
    g: ProjectGlyph
    size: number
    dim: bool
  view
    when g.kind == "lucide"
      svg width=size height=size viewBox="0 0 24 24" color=(dim ? g.gray : g.ink) fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
        path d=g.d
    else
      when g.kind == "emoji"
        box width=size height=size display="flex" align-items="center" justify-content="center" flex-shrink=0 aria-hidden=true
          text g.emoji font-size=(size * 0.8) line-height=`${size * 0.8}px`
      else
        when g.kind == "image"
          image g.src width=size height=size border-radius=(size / 4) object-fit="contain" flex-shrink=0 aria-hidden=true
        else
          ProjectMark(label=g.text, muted=false, ink=(dim ? g.gray : g.ink), surface=(dim ? g.graySurface : g.surface), size=size)
