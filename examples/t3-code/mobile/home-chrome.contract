// @ref examples/t3-code/mobile/docs/1130.002-design-system-parity.spec.md#semantic-colors
// Home chrome occupies only its toolbar band. A native view returning no hit
// does not make its full authored wrapper transparent to pointer input.
component HomeChrome
  props
    routeKey: string
    configuration: string
    event: action
    height: number
  view
    t3-home-chrome configuration=configuration route-key=routeKey
      change=event
      position="absolute"
      height=height
      right=0
      bottom=0
      left=0
      testId="home-chrome"
