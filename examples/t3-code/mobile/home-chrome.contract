// @ref examples/t3-code/mobile/docs/1130.002-design-system-parity.spec.md#semantic-colors
component HomeChrome
  props
    routeKey: string
    configuration: string
    event: action
    height: number
  view
    if configuration != "" and routeKey != ""
      t3-home-chrome configuration=configuration route-key=routeKey
        change=event
        position="absolute"
        height=height
        right=0
        bottom=0
        left=0
        testId="home-chrome"
