// Strict response shapes for mobile/thread.ts; root resources may import them directly.
// @ref llp/1109.000-mobile-app-layout.decision.md#shared-typescript
shape ThreadCodeToken
  id: string
  text: string
  color: string
  weight: number
  slant: string
shape ThreadBlock
  id: string
  kind: string
  text: string
  language: string
  tokens: list<ThreadCodeToken>
shape ThreadMedia
  id: string
  name: string
  kind: string
  url: string
shape ThreadAnswerFile
  id: string
  name: string
  image: bool
  url: string
shape ThreadAnswerHistory
  id: string
  question: string
  answer: string
  files: list<ThreadAnswerFile>
shape ThreadActivity
  id: string
  label: string
  body: string
  output: string
  result: string
  detail: string
  failed: bool
  expandable: bool
  expanded: bool
  reasoning: bool
  loading: bool
  symbol: string
  timestamp: string
  prominentError: bool
  warning: bool
  call: bool
  retryRunId: string
  retryDisabled: bool
  iconURL: string
  reasoningBlocks: list<ThreadBlock>
  answerPreview: string
  hasAnswer: bool
  answerHistory: list<ThreadAnswerHistory>
  nativeWorkRow: string
  nativeWorkDetail: bool
shape ThreadRow
  id: string
  kind: string
  title: string
  body: string
  blocks: list<ThreadBlock>
  user: bool
  timestamp: string
  showMeta: bool
  streaming: bool
  attribution: string
  intent: string
  copied: bool
  expanded: bool
  toggleOp: string
  toggleId: string
  failed: bool
  live: bool
  activities: list<ThreadActivity>
  media: list<ThreadMedia>
  first: bool
  last: bool
  canFork: bool
  forkKey: string
  forkBusy: bool
shape ThreadApprovalOption
  id: string
  label: string
  tone: string
  warning: string
shape ThreadApproval
  id: string
  title: string
  detail: string
  disabled: bool
  reason: string
  options: list<ThreadApprovalOption>
shape ThreadComposerState
  editing: bool
  saving: bool
  canCancel: bool
  editNotice: string
  editPendingId: string
  canRetryEdit: bool
  contentOwner: string
  draft: string
  placeholder: string
  canSend: bool
  canStop: bool
  showStop: bool
  canOperate: bool
  showReadOnlyNotice: bool
  sendLabel: string
  sendSymbol: string
  blockedReason: string
  modelLabel: string
  providerDriver: string
  providerIconURL: string
  modelUnavailable: bool
  running: bool
  queueCount: number
shape ThreadSnapshot
  queuedCanSelect: bool
  queued: bool
  queuedOwner: string
  queuedStatus: string
  queuedReason: string
  queuedCanRetry: bool
  queuedFailed: bool
  queuedCanEdit: bool
  revision: number
  environmentId: string
  threadId: string
  title: string
  loaded: bool
  loading: bool
  rows: list<ThreadRow>
  emptyTitle: string
  emptyDetail: string
  error: string
  uncertain: bool
  hasMore: bool
  historyLoading: bool
  historyError: string
  readsNeeded: bool
  answerFilesOwner: string
  answerFilesRequest: string
  approvals: list<ThreadApproval>
  composer: ThreadComposerState
shape ThreadPreparation
  revision: number
  pending: bool
shape ThreadColors
  glassFallback: string
  screen: string
  foreground: string
  secondary: string
  muted: string
  iconSubtle: string
  iconMuted: string
  border: string
  borderSubtle: string
  subtle: string
  userBubble: string
  userForeground: string
  primary: string
  primaryForeground: string
  danger: string
  dangerForeground: string
  warningForeground: string
  composerSurface: string
  composerBorder: string
  placeholder: string
  codeBackground: string
  codeForeground: string
  userCodeBackground: string
  userCodeForeground: string
  composerBackdrop: string
