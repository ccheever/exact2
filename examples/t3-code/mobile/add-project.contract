// T3 Code 365aa87982 AddProjectScreen, AppTextInput, ErrorBanner and SourceControlIcon.
// @ref llp/1107.005-composer-and-transcript.decision.md#new-task-ownership
// Presentation only. The root owns retained screens, requests, navigation and alerts.
shape AddProjectColors
  sheet: string
  groupedCard: string
  foreground: string
  muted: string
  icon: string
  iconMuted: string
  chevron: string
  borderSubtle: string
  primary: string
  primaryForeground: string
  danger: string
  dangerBorder: string
  dangerForeground: string
  input: string
  inputBorder: string
  switchOn: string
  switchOff: string
shape AddProjectFolder
  id: string
  name: string
  directory: string
  separated: bool
shape AddProjectEnvironment
  id: string
  label: string
  symbol: string
  selected: bool
  disabled: bool
shape AddProjectSource
  id: string
  title: string
  hint: string
  ready: bool
shape AddProjectAlert
  id: string
  title: string
  message: string
shape AddProjectScreen
  id: string
  name: string
  title: string
  available: bool
  environmentId: string
  environmentLabel: string
  error: string
  busy: bool
  uncertain: bool
  loading: bool
  permissionPending: bool
  canCreate: bool
  canClone: bool
  canRead: bool
  hasNewProject: bool
  input: string
  placeholder: string
  primaryLabel: string
  primaryDisabled: bool
  pathPreview: string
  repositoryTitle: string
  remoteUrl: string
  source: string
  publish: bool
  showPublish: bool
  publishLabel: string
  publishSubtitle: string
  showMachines: bool
  browsing: bool
  browseLoading: bool
  browseError: string
  browseDirectory: string
  parentPath: string
  folders: list<AddProjectFolder>
  environments: list<AddProjectEnvironment>
  sources: list<AddProjectSource>
  alerts: list<AddProjectAlert>
shape AddProjectNavigation
  query: string
  token: string
  kind: string
  routeId: string
  environmentId: string
  projectId: string
  title: string
  cloning: bool
  source: string
  remoteUrl: string
  repositoryName: string
shape AddProjectSnapshot
  owner: string
  activeId: string
  revision: number
  screens: list<AddProjectScreen>
  navigation: AddProjectNavigation
  waitOperation: string
  waitRoute: string
  needsPrepare: bool

component MobileAddProject
  props
    owner: string
    data: AddProjectScreen
    colors: AddProjectColors
    safeBottom: number
    edit: action
    browse: action
    action: action
  action editInput(value: string)
    edit(owner, data.id, "input", value)
  action submitInput
    if not data.primaryDisabled
      action(owner, data.id, "submit", "")
  action publish(value: bool)
    edit(owner, data.id, "publish", value ? "true" : "false")
  view
    scroll id=`add-project-scroll-${data.id}` flex=1 min-height=0 background-color=colors.sheet
      column padding-left=20 padding-right=20 padding-top=16 padding-bottom=(max(safeBottom, 18) + 18) gap=10 font-family="DM Sans" testId=`add-project-${data.name}`
        when data.error != ""
          AddProjectError(message=data.error, colors=colors)
        when data.name == "addProjectDestination" and data.repositoryTitle != ""
          column border-radius=24 background-color=colors.groupedCard padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5
            text data.repositoryTitle font-size=16 font-weight=700 color=colors.foreground line-height="23px"
            text data.remoteUrl margin-top=1.75 font-size=13 line-height="17px" color=colors.muted line-clamp=2
        when not data.available and not (data.name == "addProjectNew" and length(data.environments) > 0)
          column align-items="center" gap=10.5 border-radius=14 background-color=colors.groupedCard padding-left=17.5 padding-right=17.5 padding-top=28 padding-bottom=28
            text "Environment unavailable" font-size=18 line-height="23px" font-weight=700 color=colors.foreground text-align="center"
            text "Start or reconnect an environment before adding a project." font-size=14 line-height="21px" color=colors.muted text-align="center"
            button retainFocus=true press=action(owner, data.id, "connections", "") border-radius=999 background-color=colors.primary margin-top=3.5 padding-left=14 padding-right=14 padding-top=8.75 padding-bottom=8.75 aria-label="Add environment" testId="add-project-environment"
              text "Add environment" font-size=14 line-height="19px" font-weight=700 color=colors.primaryForeground
        when data.name == "addProject" and data.showMachines
          AddProjectSectionTitle(title="ENVIRONMENTS", colors=colors)
          AddProjectMachines(owner=owner, data=data, colors=colors, edit=edit)
        when data.name == "addProject" and data.available
          column border-radius=24 overflow="hidden" background-color=colors.groupedCard
            when data.hasNewProject
              AddProjectRow(title="New project", subtitle="Start a new Git repository from a name", symbol="plus", source="", selected=false, check=false, chevron=true, separated=false, disabled=data.busy, colors=colors, press=action(owner, data.id, "new", ""), target="add-project-new")
            AddProjectRow(title="Local folder", subtitle=(data.canCreate ? "Browse a folder on disk" : "This connection cannot add projects."), symbol="folder.badge.plus", source="", selected=false, check=false, chevron=true, separated=data.hasNewProject, disabled=(not data.canCreate or data.busy), colors=colors, press=action(owner, data.id, "local", ""), target="add-project-local")
            each source in data.sources key=source.id
              AddProjectRow(title=source.title, subtitle=source.hint, symbol="link", source=(source.id == "url" ? "" : source.id), selected=false, check=false, chevron=true, separated=true, disabled=(not source.ready or data.busy), colors=colors, press=action(owner, data.id, "repository", source.id), target=`add-project-source-${source.id}`)
          when data.loading
            column align-items="center"
              t3-archive-spinner spinner-tint=colors.iconMuted width=20 height=20
        when data.name != "addProject" and data.available
          when data.name == "addProjectLocal" and not data.canCreate
            AddProjectError(message="This connection cannot add projects.", colors=colors)
          input value=data.input input=editInput submit=submitInput disabled=(data.busy or data.uncertain) autofocus=(data.name == "addProjectNew") placeholder=data.placeholder aria-label=data.placeholder testId=`add-project-input-${data.id}` enterkeyhint=(data.name == "addProjectRepository" ? "next" : "done") autocapitalize=(data.name == "addProjectNew" ? "sentences" : "none") spellcheck=false autocomplete="off" height=42 min-height=42 box-sizing="border-box" border-radius=24 border-width=1 border-style="solid" border-color=colors.inputBorder background-color=colors.input color=colors.foreground padding-left=14 padding-right=14 padding-top=0 padding-bottom=0 font-family="DM Sans" font-size=16 line-height="22px"
          when data.name == "addProjectNew"
            when data.pathPreview != ""
              text data.pathPreview padding-left=3.5 padding-right=3.5 font-size=14 line-height="19.25px" color=colors.muted line-clamp=2 testId="add-project-path-preview"
            when data.showMachines
              AddProjectMachines(owner=owner, data=data, colors=colors, edit=edit)
            when data.showPublish
              column border-radius=24 overflow="hidden" background-color=colors.groupedCard
                button retainFocus=true press=publish(not data.publish) disabled=(data.busy or data.uncertain) text-align="left" padding=0 aria-label=data.publishLabel testId="add-project-publish-row"
                  row padding-left=12.25 padding-right=12.25 padding-top=8.75 padding-bottom=8.75 align-items="center" gap=10.5
                    column width=24.5 height=24.5 flex-shrink=0 align-items="center" justify-content="center"
                      AddProjectProviderIcon(source="github", color=colors.icon)
                    column flex=1 min-width=0 gap=1.75
                      text data.publishLabel font-size=16 line-height="22px" font-weight=700 color=colors.foreground
                      text data.publishSubtitle font-size=14 line-height="19.25px" color=colors.muted line-clamp=2
                    input type="checkbox" switch checked=data.publish change=publish disabled=(data.busy or data.uncertain) aria-label=data.publishLabel accent-color=colors.switchOn background-color=colors.switchOff margin=0 testId="add-project-publish"
          button retainFocus=true press=action(owner, data.id, "submit", "") disabled=data.primaryDisabled aria-label=data.primaryLabel testId="add-project-submit" height=42 box-sizing="border-box" padding=0 border-radius=999 background-color=colors.primary opacity=(data.primaryDisabled ? 0.45 : 1)
            when data.busy
              t3-archive-spinner spinner-tint=colors.primaryForeground width=20 height=20
            when not data.busy
              text data.primaryLabel font-size=16 line-height="23px" font-weight=700 color=colors.primaryForeground
          when data.name == "addProjectNew"
            column border-radius=24 overflow="hidden" background-color=colors.groupedCard
              AddProjectRow(title="Add existing project", subtitle="Open a folder or clone a repository", symbol="folder.badge.plus", source="", selected=false, check=false, chevron=true, separated=false, disabled=(data.busy or data.uncertain), colors=colors, press=action(owner, data.id, "existing", ""), target="add-project-existing")
          when data.name == "addProjectDestination" and not data.canClone
            text "This connection cannot clone projects." font-size=14 line-height="19px" color=colors.muted
          when data.name == "addProjectLocal" or data.name == "addProjectDestination"
            AddProjectSectionTitle(title="BROWSE FOLDERS", colors=colors)
            when data.browseError != ""
              AddProjectError(message=data.browseError, colors=colors)
            column border-radius=24 overflow="hidden" background-color=colors.groupedCard
              when data.browseLoading
                column align-items="center" padding-top=17.5 padding-bottom=17.5
                  t3-archive-spinner spinner-tint=colors.iconMuted width=20 height=20
              when data.parentPath != ""
                AddProjectRow(title="..", subtitle="", symbol="arrow.turn.left.up", source="", selected=false, check=false, chevron=false, separated=false, disabled=(data.busy or data.browsing or data.uncertain or not data.canRead), colors=colors, press=browse(owner, data.id, data.parentPath, ""), target="add-project-folder-up")
              each folder in data.folders key=folder.id
                AddProjectRow(title=folder.name, subtitle="", symbol="folder", source="", selected=false, check=false, chevron=false, separated=folder.separated, disabled=(data.busy or data.browsing or data.uncertain), colors=colors, press=browse(owner, data.id, folder.directory, folder.name), target=`add-project-folder-${folder.id}`)
        when data.name == "addProjectNew" and not data.available and data.showMachines
          AddProjectMachines(owner=owner, data=data, colors=colors, edit=edit)

component AddProjectSectionTitle
  props
    title: string
    colors: AddProjectColors
  view
    text title padding-left=3.5 padding-right=3.5 font-size=12 line-height="16px" font-weight=700 letter-spacing=0.7 color=colors.muted

component AddProjectError
  props
    message: string
    colors: AddProjectColors
  view
    column border-radius=14 border-width=1 border-style="solid" border-color=colors.dangerBorder background-color=colors.danger padding-left=12.25 padding-right=12.25 padding-top=10.5 padding-bottom=10.5 role="alert"
      text message font-size=14 line-height="19px" font-weight=500 color=colors.dangerForeground

component AddProjectMachines
  props
    owner: string
    data: AddProjectScreen
    colors: AddProjectColors
    edit: action
  derive firstId = match first(data.environments) { case some(item) => item.id, case none => "" }
  view
    column border-radius=24 overflow="hidden" background-color=colors.groupedCard
      each environment in data.environments key=environment.id
        AddProjectRow(title=environment.label, subtitle="", symbol=environment.symbol, source="", selected=environment.selected, check=true, chevron=false, separated=(environment.id != firstId), disabled=environment.disabled, colors=colors, press=edit(owner, data.id, "environment", environment.id), target=`add-project-machine-${environment.id}`)

component AddProjectRow
  props
    title: string
    subtitle: string
    symbol: string
    source: string
    selected: bool
    check: bool
    chevron: bool
    separated: bool
    disabled: bool
    colors: AddProjectColors
    press: action
    target: string
  view
    button retainFocus=true press=press disabled=disabled aria-label=title testId=target text-align="left" padding=0 background-color=colors.groupedCard border-top-width=(separated ? 1 : 0) border-top-style="solid" border-top-color=colors.borderSubtle opacity=(disabled ? 0.45 : 1)
      row padding-left=12.25 padding-right=12.25 padding-top=8.75 padding-bottom=8.75 gap=10.5 align-items="center"
        column width=24.5 height=24.5 flex-shrink=0 align-items="center" justify-content="center" border-radius=999 background-color=(selected ? colors.primary : "transparent")
          when source == ""
            t3-symbol symbol-name=symbol point-size=17 symbol-weight="regular" symbol-tint=(symbol == "folder" or symbol == "arrow.turn.left.up" ? colors.iconMuted : colors.icon) width=17 height=17
          when source != ""
            AddProjectProviderIcon(source=source, color=colors.icon)
        column flex=1 min-width=0 gap=1.75
          text title font-size=16 line-height="22px" font-weight=700 color=colors.foreground
          when subtitle != ""
            text subtitle font-size=14 line-height="19.25px" color=colors.muted line-clamp=2
        when check and selected
          t3-symbol symbol-name="checkmark" point-size=14 symbol-weight="regular" symbol-tint=colors.icon width=14 height=14
        when chevron and not disabled
          t3-symbol symbol-name="chevron.right" point-size=13 symbol-weight="regular" symbol-tint=colors.chevron width=13 height=13

