// @ref examples/t3-code/mobile/docs/1130.003-pairing-and-transport.decision.md#mobile-adaptations
// T3 Code 365aa87982 SettingsEnvironmentDetailRouteScreen and EnvironmentRoutesSection.
use ConnectionColors from "./connect.contract"
use EnvironmentRow, EnvironmentItem from "./environments.contract"
use ProviderIcon from "./provider-icon.contract"
use SettingsTextRoles, settingsRootTextBoxHeight from "./settings.contract"

shape EnvironmentDetailRoute
  id: string
  label: string
  address: string
  icon: string
  active: bool
  removable: bool
  learned: bool
  position: number
  count: number
  moveUp: string
  moveDown: string

shape EnvironmentDetailProvider
  id: string
  driver: string
  label: string
  version: string
  updateMessage: string
  updateFailed: bool
  compatibility: string
  message: string
  manualUpdate: bool
  canUpdate: bool
  disabled: bool

shape EnvironmentDetailData
  loaded: bool
  found: bool
  key: string
  environmentId: string
  title: string
  connected: bool
  configPresent: bool
  version: string
  busy: bool
  disabled: bool
  refreshDisabled: bool
  permissionNote: string
  error: string
  notice: string
  updateMessage: string
  updateFailed: bool
  releaseMessage: string
  updateConfirmation: string
  targetVersion: string
  showUpdate: bool
  manualUpdate: string
  routes: EnvironmentDetailRoute[]
  providers: EnvironmentDetailProvider[]

component EnvironmentDetail
  props
    data: EnvironmentDetailData
    connection: EnvironmentRow
    colors: ConnectionColors
    roles: SettingsTextRoles
    displayScale: number
    dark: bool
    pending: bool
    toggleConnection: action
    setEnabled: action
    reconnect: action
    remove: action
    save: action
    action: action
  state connectionExpanded = false
  state editingRoutes = false
  // The list viewport is the sum of its single-line rows, including the icon and compact badge.
  derive routeLabelHeight = settingsRootTextBoxHeight(roles.headline.line, displayScale)
  derive routeBadgeHeight = settingsRootTextBoxHeight(roles.caption.line, displayScale) + 7
  derive routeAddressHeight = settingsRootTextBoxHeight(roles.footnote.line, displayScale)
  derive routePlainHeight = 28 + max(22, routeLabelHeight)
  derive routeActiveHeight = 28 + max(22, max(routeLabelHeight, routeBadgeHeight))
  derive routeAddressedHeight = 28 + max(22, routeLabelHeight + 1.75 + routeAddressHeight)
  derive routeActiveAddressedHeight = 28 + max(22, max(routeLabelHeight, routeBadgeHeight) + 1.75 + routeAddressHeight)
  derive routesHeight = data.routes.filter(route => not route.active and route.address.length == 0).length * routePlainHeight + data.routes.filter(route => route.active and route.address.length == 0).length * routeActiveHeight + data.routes.filter(route => not route.active and route.address.length > 0).length * routeAddressedHeight + data.routes.filter(route => route.active and route.address.length > 0).length * routeActiveAddressedHeight
  action expandConnection(id: string)
    connectionExpanded = not connectionExpanded
  action reorderRoute(id: string, before: option<string>)
    match before
      case some(next)
        action("route-move", data.key, `${id}>${next}`)
      case none
        action("route-move", data.key, `${id}>`)
  action editRoutes
    editingRoutes = not editingRoutes
  view
    column gap=21
      padding-left=17.5
      padding-right=17.5
      padding-top=14
      font-family="DM Sans"
      testId="environment-detail"
      if not data.found
        text "This environment is no longer saved on this device." font-size=roles.body.size line-height=`${roles.body.line}px` color=colors.muted
      else
        column gap=7
          DetailSectionTitle(label="Connection", colors=colors, roles=roles)
          column border-radius=24 corner-shape="-exact-continuous" background-color=colors.groupedCard overflow="hidden"
            EnvironmentItem(
              environment=connection,
              expanded=connectionExpanded,
              opensDetails=false,
              toggle=expandConnection,
              setEnabled=setEnabled,
              reconnect=reconnect,
              remove=remove,
              save=save,
              colors=colors,
              roles=roles,
              displayScale=displayScale
            )
        column gap=7
          row align-items="center" justify-content="space-between"
            DetailSectionTitle(label="Routes", colors=colors, roles=roles)
            if data.routes.length > 1
              button press=editRoutes
                padding-left=7
                padding-right=7
                padding-top=3.5
                padding-bottom=3.5
                testId="environment-routes-edit"
                text (editingRoutes ? "Done" : "Edit") font-size=roles.footnote.size
                  line-height=`${roles.footnote.line}px`
                  font-weight=500
                  color=colors.foreground
          column border-radius=24 corner-shape="-exact-continuous" background-color=colors.groupedCard overflow="hidden"
            list id="mobile-environment-routes" appearance="none"
              reorderdrop=reorderRoute
              virtualized=true
              height=routesHeight
              estimated-item-height=71.75
              width="100%"
              overflow-x="hidden"
              for route in data.routes key = route.id
                row gap=14
                  padding-left=14
                  align-items="center"
                  testId=`environment-route-${route.id}`
                  if editingRoutes
                    if route.removable
                      button press=action("route-remove", data.key, route.id)
                        disabled=pending
                        padding=0
                        aria-label=`Remove ${route.label}`
                        t3-symbol symbol-name="xmark.circle.fill"
                          symbol-weight="regular"
                          symbol-tint=colors.dangerForeground
                          width=20
                          height=20
                    else
                      view width=20 height=20
                  row flex=1
                    min-width=0
                    gap=14
                    padding-top=14
                    padding-bottom=14
                    padding-right=(editingRoutes ? 0 : 14)
                    align-items="center"
                    t3-symbol symbol-name=route.icon
                      symbol-weight="regular"
                      symbol-tint=colors.foreground
                      width=22
                      height=22
                      flex-shrink=0
                    column flex=1 min-width=0 gap=1.75
                      row gap=7 align-items="center"
                        text route.label font-size=roles.headline.size
                          line-height=`${roles.headline.line}px`
                          min-height=routeLabelHeight
                          min-width=0
                          color=colors.foreground
                          white-space="nowrap"
                          line-clamp=1
                          text-overflow="ellipsis"
                          flex-shrink=1
                        if route.active
                          text "In use" font-size=roles.caption.size
                            line-height=`${roles.caption.line}px`
                            min-height=settingsRootTextBoxHeight(roles.caption.line, displayScale)
                            flex-shrink=0
                            font-weight=700
                            color="light-dark(oklch(50.8% 0.118 165.612), oklch(84.5% 0.143 164.978))"
                            background-color="light-dark(oklch(69.6% 0.17 162.48 / 12%), oklch(69.6% 0.17 162.48 / 16%))"
                            border-radius=999
                            padding-left=8.75
                            padding-right=8.75
                            padding-top=3.5
                            padding-bottom=3.5
                      if route.address.length > 0
                        text (route.learned ? `${route.address} · found automatically` : route.address) font-size=roles.footnote.size
                          line-height=`${roles.footnote.line}px`
                          min-height=routeAddressHeight
                          color=colors.muted
                          white-space="nowrap"
                          line-clamp=1
                          text-overflow="ellipsis"
                  if editingRoutes
                    box reorderFor="mobile-environment-routes"
                      disabled=pending
                      touch-action="none"
                      aria-label=`Reorder ${route.label}, position ${route.position}`
                      width=48
                      align-self="stretch"
                      display="flex"
                      align-items="center"
                      justify-content="center"
                      t3-symbol symbol-name="line.3.horizontal"
                        symbol-weight="regular"
                        symbol-tint=colors.muted
                        width=20
                        height=20
            DetailActionRow(
              label="Add route",
              icon="plus",
              disabled=pending,
              press=action("route-add", data.key, data.environmentId),
              colors=colors,
              roles=roles,
              rowId="environment-route-add"
            )
        if data.permissionNote.length > 0
          DetailMessage(message=data.permissionNote, error=false, colors=colors, roles=roles)
        if data.error.length > 0
          DetailMessage(message=data.error, error=true, colors=colors, roles=roles)
        if data.notice.length > 0
          DetailMessage(message=data.notice, error=false, colors=colors, roles=roles)
        if data.configPresent
          column gap=7
            DetailSectionTitle(label="T3 Code", colors=colors, roles=roles)
            column border-radius=24 corner-shape="-exact-continuous" background-color=colors.groupedCard overflow="hidden"
              column padding=14 gap=3.5
                text `Version ${data.version}` font-size=roles.body.size
                  line-height=`${roles.body.line}px`
                  color=colors.foreground
                if data.updateMessage.length > 0
                  text data.updateMessage font-size=roles.footnote.size
                    line-height=`${roles.footnote.line}px`
                    color=(data.updateFailed ? colors.dangerForeground : colors.muted)
                if data.releaseMessage.length > 0
                  text data.releaseMessage font-size=roles.footnote.size line-height=`${roles.footnote.line}px` color=colors.muted
                if data.manualUpdate.length > 0
                  text data.manualUpdate font-size=roles.footnote.size line-height=`${roles.footnote.line}px` color=colors.muted
              DetailActionRow(
                label="Check for updates",
                icon="arrow.clockwise",
                disabled=data.disabled or pending,
                press=action("check-updates", data.key, ""),
                colors=colors,
                roles=roles,
                rowId="environment-check-updates"
              )
              if data.showUpdate
                DetailActionRow(
                  label=`Update to ${data.targetVersion}`,
                  icon="arrow.up.circle",
                  disabled=data.disabled or pending,
                  press=action("update-server", data.key, ""),
                  colors=colors,
                  roles=roles,
                  rowId="environment-update"
                )
          column gap=7
            DetailSectionTitle(label="Providers", colors=colors, roles=roles)
            column border-radius=24 corner-shape="-exact-continuous" background-color=colors.groupedCard overflow="hidden"
              DetailActionRow(
                label="Refresh providers",
                icon="arrow.clockwise",
                disabled=data.refreshDisabled or pending,
                press=action("refresh-providers", data.key, ""),
                colors=colors,
                roles=roles,
                rowId="environment-refresh-providers"
              )
              for provider in data.providers key = provider.id
                column
                  column padding=14 gap=3.5
                    row align-items="center" gap=7
                      ProviderIcon(driver=provider.driver, size=18, dark=dark, iconUrl="")
                      text provider.label font-size=roles.body.size
                        line-height=`${roles.body.line}px`
                        min-width=0
                        flex=1
                        font-weight=500
                        color=colors.foreground
                    text provider.version font-size=roles.footnote.size line-height=`${roles.footnote.line}px` color=colors.muted
                    if provider.updateMessage.length > 0
                      text provider.updateMessage font-size=roles.footnote.size
                        line-height=`${roles.footnote.line}px`
                        color=(provider.updateFailed ? colors.dangerForeground : colors.muted)
                    if provider.compatibility.length > 0
                      text provider.compatibility font-size=roles.footnote.size line-height=`${roles.footnote.line}px` color=colors.muted
                    if provider.message.length > 0
                      text provider.message font-size=roles.footnote.size line-height=`${roles.footnote.line}px` color=colors.muted
                    if provider.manualUpdate
                      text "Update this provider on the environment's machine." font-size=roles.footnote.size
                        line-height=`${roles.footnote.line}px`
                        color=colors.muted
                  if provider.canUpdate
                    DetailActionRow(
                      label=`Update ${provider.label}`,
                      icon="arrow.up.circle",
                      disabled=provider.disabled or pending,
                      press=action("update-provider", data.key, provider.id),
                      colors=colors,
                      roles=roles,
                      rowId=`environment-update-provider-${provider.id}`
                    )

component DetailSectionTitle
  props
    label: string
    colors: ConnectionColors
    roles: SettingsTextRoles
  view
    text label padding-left=7
      padding-right=7
      font-size=roles.footnote.size
      line-height=`${roles.footnote.line}px`
      font-weight=500
      color=colors.muted

component DetailMessage
  props
    message: string
    error: bool
    colors: ConnectionColors
    roles: SettingsTextRoles
  view
    text message padding-left=7
      padding-right=7
      font-size=roles.footnote.size
      line-height=`${roles.footnote.line}px`
      color=(error ? colors.dangerForeground : colors.muted)

component DetailActionRow
  props
    label: string
    icon: string
    disabled: bool
    press: action
    colors: ConnectionColors
    rowId: string
    roles: SettingsTextRoles
  view
    button press=press
      disabled=disabled
      opacity=(disabled ? 0.4 : 1)
      padding=14
      text-align="left"
      testId=rowId
      row align-items="center" gap=14
        t3-symbol symbol-name=icon
          symbol-weight="regular"
          symbol-tint=colors.foreground
          width=22
          height=22
        text label font-size=roles.headline.size line-height=`${roles.headline.line}px` color=colors.foreground flex=1
