// iOS ThreadSettingsRows + ThreadSettingsSheet365aa87982; native header is owned by root.
// @ref llp/1107.005-composer-and-transcript.decision.md#settings-ownership
use ComposerSettingsSnapshot, ComposerChoice, ComposerColors from "./composer-shapes.contract"
use ProviderIcon from "./provider-icon.contract"
component ComposerSettings
  props
    data: ComposerSettingsSnapshot
    dark: bool
    action: action
    openOptions: action
    openRuntime: action
    colors: ComposerColors
  view
    list flex=1 min-height=0 background-color=colors.sheet
      column padding-top=7 padding-bottom=7
        each option in data.options key=option.id
          button press=openOptions(option.id) disabled=(not data.canEdit) margin-left=14 margin-right=14 min-height=38.5
            padding-left=14 padding-right=14 padding-top=7 padding-bottom=7 border-bottom-width=1 border-bottom-style="solid" border-bottom-color=colors.borderSubtle background-color=colors.groupedCard
            row align-items="center" gap=7
              text option.label flex=1 font-size=14 line-height="19px" font-weight=500 color=colors.foreground
              text option.value font-size=14 line-height="19px" color=colors.muted
              t3-symbol symbol-name="chevron.right" point-size=12 symbol-weight="regular" symbol-tint=colors.iconSubtle width=12 height=12
        button press=openRuntime disabled=(not data.canEdit) margin-left=14 margin-right=14 min-height=38.5 padding-left=14 padding-right=14 padding-top=7 padding-bottom=7 background-color=colors.groupedCard
          row align-items="center" gap=7
            text "Runtime" flex=1 font-size=14 line-height="19px" font-weight=500 color=colors.foreground
            text data.runtimeLabel font-size=14 line-height="19px" color=colors.muted
            t3-symbol symbol-name="chevron.right" point-size=12 symbol-weight="regular" symbol-tint=colors.iconSubtle width=12 height=12
      when length(data.error) > 0
        text data.error margin=14 font-size=14 line-height="19px" color=colors.danger
      when length(data.empty) > 0
        text data.empty padding=28 text-align="center" font-size=14 line-height="19px" color=colors.muted
      each item in data.models key=item.key
        when item.kind == "provider"
          button press=action("toggle-provider", item.id, "") margin-left=14 margin-right=14 margin-top=3.5 min-height=38.5 padding-left=3.5 padding-right=3.5 padding-top=7
            aria-expanded=(not item.collapsed) aria-label=`${item.label}, ${item.count} models`
            row align-items="center" gap=7
              ProviderIcon(driver=item.driver, size=15, dark=dark, iconUrl=item.iconUrl)
              text item.label flex=1 font-size=14 line-height="19px" font-weight=500 color=colors.muted
              when item.collapsed
                text toString(item.count) font-size=12 line-height="16px" font-weight=500 color=colors.muted
              t3-symbol symbol-name=(item.collapsed ? "chevron.down" : "chevron.up") point-size=12 symbol-weight="regular" symbol-tint=colors.iconSubtle width=12 height=12
        else
          row margin-left=14 margin-right=14 min-height=38.5 align-items="center" gap=7 padding-left=14 padding-right=14 background-color=colors.groupedCard
            border-top-left-radius=(item.first ? 14 : 0) border-top-right-radius=(item.first ? 14 : 0)
            border-bottom-left-radius=(item.last ? 14 : 0) border-bottom-right-radius=(item.last ? 14 : 0)
            border-bottom-width=(item.last ? 0 : 1) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
            button press=action("pick", item.providerId, item.id) disabled=item.disabled flex=1 min-width=0 min-height=38.5 padding=0 text-align="left" role="radio" aria-checked=item.selected
              row align-items="center" gap=7
                column flex=1 min-width=0
                  row gap=7 align-items="center"
                    text item.label min-width=0 flex-shrink=1 line-clamp=1 text-overflow="ellipsis" font-size=16 line-height="23px" font-weight=500 color=colors.foreground
                    when item.isDefault
                      text "Default" padding-left=5.25 padding-right=5.25 padding-top=1.75 padding-bottom=1.75 border-radius=5.25 background-color=colors.subtle font-size=11 line-height="14px" font-weight=700 color=colors.muted
                    when item.legacy
                      text "Legacy" font-size=11 line-height="14px" font-weight=700 color=colors.muted
                  when length(item.subtitle) > 0
                    text item.subtitle line-clamp=1 font-size=13 line-height="17px" color=colors.muted
                  when length(item.reason) > 0
                    text "Unavailable" font-size=13 line-height="17px" color=colors.foreground
                when item.selected
                  t3-symbol symbol-name="checkmark" point-size=16 symbol-weight="semibold" symbol-tint=colors.icon width=16 height=16
            button press=action("favorite", item.providerId, item.id) min-width=38.5 min-height=38.5 padding=0 aria-label=`${item.favorite ? "Remove from" : "Add to"} favorites: ${item.label}`
              column align-items="center" justify-content="center" width=38.5 height=38.5
                t3-symbol symbol-name=(item.favorite ? "star.fill" : "star") point-size=18 symbol-weight="regular" symbol-tint=(item.favorite ? colors.icon : colors.iconSubtle) width=18 height=18

component ComposerChoices
  props
    rows: list<ComposerChoice>
    choose: action
    colors: ComposerColors
  view
    list flex=1 min-height=0 padding-left=14 padding-right=14 background-color=colors.sheet
      each choice in rows key=choice.id
        button press=choose(choice.id) disabled=choice.disabled text-align="left" role="radio" aria-checked=choice.selected
          min-height=49 padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5 background-color=colors.groupedCard
          border-bottom-width=(choice.last ? 0 : 1) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
          row align-items="center" gap=10.5
            column flex=1 min-width=0 gap=3.5
              text choice.label font-size=16 line-height="23px" font-weight=500 color=colors.foreground
              when length(choice.description) > 0
                text choice.description font-size=13 line-height="17px" color=colors.muted
            when choice.selected
              t3-symbol symbol-name="checkmark" point-size=16 symbol-weight="semibold" symbol-tint=colors.icon width=16 height=16
