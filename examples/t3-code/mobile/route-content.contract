    else if routeName == "archive"
      Archive(data=archiveData, colors=archiveLook, roles=settingsData.root.roles, pending=archivedPending, loading=archiveDataPending, width=viewport.width, reduced=viewport.prefersReducedMotion, refresh=refreshArchive, action=archiveAction)
      ArchiveChrome(data=archiveChrome, routeKey=routeId, focused=focused, event=archiveChromeEvent)
    else if routeName == "threadAgents"
      AgentActivity(data=agents, colors=agentLook, dark=appearance.scheme == "dark", bottomInset=layout.safeBottom, open=openAgent)
    else if routeName.startsWith("addProject")
      for screen in addProjectData.screens.filter(screen => screen.id == routeId) key=screen.id
        MobileAddProject(owner=addProjectData.owner, data=screen, colors=addProjectLook, safeBottom=layout.safeBottom, edit=editAddProject, browse=browseAddProject, action=actAddProject)
    else if routeName == "newTaskDraft" and newTaskData.draft and (newTaskFlow.ready or (not focused and newTaskFlow.draftOwner != "" and newTaskFlow.draftOwner == newTaskData.composer.contentOwner))
      NewTaskDraft(routeId=routeId, editorId=`thread-composer-${routeId}`, data=newTaskData, recovery=newTaskFlow.recovery, clone=newTaskClone, cloneColors=newTaskCloneLook, colors=composerLook, threadColors=threadLook, attachments=composerAttachments, safeBottom=layout.safeBottom, keyboardDocked=layout.keyboardDocked, underHeader=layout.liquidGlass, dark=(appearance.scheme == "dark"), enterBehavior=appearance.enterBehavior, voice=voiceData, voiceOwner=(focused ? voiceFocus.owner : ""), voiceColors=voiceLook, voiceDisabled=(data.busy or changedPending or taskChangedPending), voiceAction=voiceAction, chooseProject=chooseNewProject, chooseEnvironment=chooseNewEnvironment, chooseBranch=chooseNewBranch, editDraft=editNewDraft, focusChanged=composerFocus, action=taskAction, pickAttachments=pickAttachments, openModelSettings=openModelSettings, openAttachment=openDraftMedia, removeAttachment=removeAttachment)
    else if routeName.startsWith("newTask") and routeName != "newTask" and not newTaskFlow.ready
      column flex=1 align-items="center" justify-content="center" padding=28 gap=14
        text (newTaskFlow.message != "" ? newTaskFlow.message : newTaskFlow.title) color=composerLook.muted text-align="center"
        if newTaskFlow.pendingEditor
          button press=taskAction("pending-refresh", "", "") disabled=newTaskFlow.busy
            text "Reopen saved edits"
          button press=taskAction("pending-recover", "", "") disabled=newTaskFlow.busy
            text "Recover draft"
        else if newTaskFlow.status == "error"
          button press=chooseNewProject
            text "Choose project"
    else if routeName == "threadModel" or routeName == "newTaskModel"
      if layout.liquidGlass
