// @ref llp/1109.011-responsive-workspace.decision.md#sidebar-integration-checkpoint
// Presentation only. The root supplies all state, resource values and actions.
component MobileRouteContent
  props
    threadSubmission: ThreadSubmission
    richComposer: ComposerRootView
    richComposerAction: action
    richComposerEvent: action
    richComposerMessage: action
    threadLocalLook: ThreadLocalColors
