        column padding-left=(routeName == "environmentDetail" ? 0 : routeName == "environments" ? 17.5 : 20)
          padding-right=(routeName == "environmentDetail" ? 0 : routeName == "environments" ? 17.5 : 20)
          padding-top=(routeName == "environmentDetail" ? 0 : routeName == "environments" ? 14 : 16)
          padding-bottom=36
          gap=(routeName == "connections" or routeName == "environments" ? 0 : 14)
