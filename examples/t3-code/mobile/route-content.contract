    archiveDataPending: bool
    archivedPending: bool
    automationChangedPending: bool
    changedPending: bool
    detailChangedPending: bool
    modelChangedPending: bool
    projectRenamedPending: bool
    taskChangedPending: bool
    threadPreferencesChangedPending: bool
    toggleSidebar: action
