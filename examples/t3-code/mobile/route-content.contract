    changePreference: action
    settingsHeaderEvent: action
    openSetting: action
    homeEvent: action
    editDraft: action
    composerFocus: action
    threadAction: action
    browserAction: action
    devicesAction: action
    browserMenu: action
    devicesMenu: action
    openBrowser: action
    openDevices: action
    terminalAction: action
    terminalMenuConfiguration: string
    terminalMenuEvent: action
    terminalEvent: action
    selectTerminalLine: action
    attachTerminalOutput: action
    openReview: action
    reviewAction: action
    refreshReview: action
    loadReviewFiles: action
    editReviewComment: action
    submitReviewComment: action
    openFiles: action
    editFilesQuery: action
    toggleDirectory: action
