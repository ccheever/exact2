    documentAction: action
    documentNativeEvent: action
    retryDocument: action
    mediaComplete: action
    openDraftMedia: action
    openMedia: action
    removeAttachment: action
    pickAttachments: action
    openModelSettings: action
    modelAction: action
    editModelQuery: action
    toggleLegacy: action
    modelFilterOwner: string
    chooseModelFilter: action
    openModelOption: action
    chooseModelOption: action
    openRuntime: action
    chooseRuntime: action
    taskAction: action
    editNewDraft: action
    editNewQuery: action
    editBranchQuery: action
    chooseNewProject: action
    chooseNewEnvironment: action
    chooseNewBranch: action
    openAgents: action
    openAgent: action
    archiveChromeEvent: action
    refreshArchive: action
    archiveAction: action
    toggleHomeShelf: action
    showMore: action
    chooseThread: action
    homeMenuAction: action
    homeArrangeDrop: action
    editHost: action
    editCode: action
    connect: action
    scan: action
    permissionChanged: action
    receiveScan: action
    addEnvironment: action
    back: action
    returnHome: action
    closeNewTask: action
    toggle: action
    detailAction: action
    setEnabled: action
    changeRouting: action
    reconnect: action
    remove: action
    save: action
  // LLP 1109.005: route-local layout facts; a new content owner starts from source estimates.
  state threadGeometryOwner = ""
  state threadMeasuredBottom = 0
  state threadMeasuredDock = 0
  state pendingInputCoverage = 0
  state pendingInputCoverageOwner = ""
  derive threadGeometryKey = `${routeId}:${threadData.environmentId}:${threadData.threadId}:${threadData.composer.contentOwner}`
  derive threadBottomInset = composerExpanded or composerFocused ? 0 : max(layout.safeBottom, 12)
  derive threadCoveredBottom = threadGeometryOwner == threadGeometryKey ? threadMeasuredBottom : 0
  derive threadDockClearance = ((threadData.queued and not threadData.queuedFailed) ? max(layout.safeBottom, 12) : (threadGeometryOwner == threadGeometryKey and threadMeasuredDock > 0 ? threadMeasuredDock : (threadData.queuedFailed ? 190 : composerExpanded ? 156 : 60) + threadBottomInset) + (workingControl.visible ? 48.5 : 0)) + (threadData.pendingInput.active and pendingInputCoverageOwner == threadData.pendingInput.cardId ? pendingInputCoverage : 0)
  action pendingInputAct(owner: string, op: string, question: string, value: string)
    threadAction(`pending-input:${op}:${question}`, owner, value)
  action pendingInputMeasured(owner: string, height: number)
    if owner == threadData.pendingInput.cardId
      pendingInputCoverageOwner = owner
      pendingInputCoverage = max(0, height)
  action threadGeometryChanged(owner: string, width: number, height: number)
    if owner == threadGeometryKey
      let routeFrame = frame(`thread-route-bounds-${routeId}`)
      let flowFrame = frame(`thread-flow-bounds-${routeId}`)
      let dockFrame = frame(`thread-dock-bounds-${routeId}`)
      if not routeFrame.unavailable and not routeFrame.provisional and not flowFrame.unavailable and not flowFrame.provisional and not dockFrame.unavailable and not dockFrame.provisional
        threadGeometryOwner = owner
        threadMeasuredBottom = max(0, routeFrame.y + routeFrame.height - flowFrame.y - flowFrame.height)
        threadMeasuredDock = dockFrame.height
  action workingAgents(owner: string)
    if focused and owner == workingControl.owner
      blur()
      openAgents()
  action workingBrowser(owner: string)
    if focused and owner == workingControl.owner
      blur()
      openBrowser()
  action workingDevices(owner: string)
    if focused and owner == workingControl.owner
      blur()
      openDevices()
  action workingQueue(owner: string)
    if focused and owner == workingControl.owner
      threadAction("queue-open", "", "")
  action workingReconnect(owner: string)
    if focused and owner == workingControl.owner
      threadAction("reconnect", "", "")
  action editGitMessage(value: string)
    gitField("message", value)
  action editGitBranch(value: string)
    gitField("branch", value)
  action editGitBase(value: string)
    gitField("base", value)
  action editGitWorktree(value: string)
    gitField("worktree", value)
  view
    if routeName == "home" and workspace.emptyWorkspaceDetail
      header id="workspace-home-header"
        button press=openNewTask aria-label="New task"
          t3-symbol symbol-name="square.and.pencil" symbol-tint=homeLook.foreground width=20 height=20
        text "" role="heading" aria-level=2
    else if routeName == "newTask"
      header height=44 flex-shrink=0 align-items="center" justify-content="space-between"
        button id="back" press=back aria-label="Back" testId="back-newTask"
          image "symbol:back" width=20 height=20
        text newTaskFlow.title id="route-title" role="heading" aria-level=2 font-size=18 font-weight=800
        input id="new-task-project-search" type="search" value=newTaskQuery input=editNewQuery placeholder="Search projects" aria-label="Search projects" testId="new-task-project-search"
        if newTaskData.canAddProject
          button press=openAddProject aria-label="Add project" testId="new-task-add-project"
            image "symbol:add" width=20 height=20
    else if routeName == "threadModel" or routeName == "newTaskModel"
      header height=44 flex-shrink=0 display="flex" align-items="center" justify-content="space-between"
        button id="model-settings-cancel" press=modelAction("cancel", "", "") disabled=modelChangedPending aria-label="Cancel thread settings"
          text "Cancel"
        text "Thread settings" id="model-settings-title" role="heading" aria-level=2 font-size=17 font-weight=700
        button id="model-settings-save" press=modelAction("save", "", "") disabled=(not modelData.canSave or modelChangedPending) aria-label=(modelData.pending ? "Save thread settings" : "Done")
          text modelData.saveLabel
    else if routeName != "notfound" and routeName != "homeArrange" and routeName != "threadModel" and routeName != "newTaskModel" and routeName != "threadDevices" and routeName != "settingsAuth" and routeName != "settingsWaitlist" and routeName != "connectOnboarding"
      MobileRootHeader(routeName=(routeName == "threadFiles" and workspace.fileInspectorSupported and filesData.error == "" ? "thread" : routeName), title=(routeName.startsWith("addProject") ? (match first(addProjectData.screens.filter(screen => screen.id == routeId)) { case some(screen) => screen.title, case none => "Add project" }) : routeName == "threadQueue" ? "Queued" : routeName == "gitOverview" ? gitData.branchLabel : routeName == "gitCommit" ? "Commit changes" : routeName == "gitConfirm" ? "Confirm Git action" : routeName == "gitBranches" ? "Branches & worktrees" : routeName == "settingsThreads" ? "Thread behavior" : routeName == "settingsProjectOverview" ? "Project overview" : routeName == "settingsNotifications" ? "Notifications" : routeName == "settingsAbout" ? "About T3 Code" : routeName == "settingsClientStorage" ? "Client Storage" : routeName == "settingsDiagnostics" ? "Diagnostics" : routeName == "settingsOpenSourceLicenses" ? "Open source licenses" : routeName == "settingsOpenSourceLicense" ? "License notice" : routeName == "settingsLegal" ? "Legal" : routeName == "threadMedia" or routeName == "threadDraftMedia" or routeName == "newTaskMedia" ? mediaData.name : routeName == "connect" ? "Add environment" : routeName == "home" ? "T3 Code" : routeName == "environmentDetail" ? detail.title : routeName == "threadBrowser" ? browserData.title : routeName == "threadDevices" ? devicesData.title : routeName == "threadTerminal" ? "Terminal" : routeName == "threadTerminalCapture" ? "Visible terminal output" : routeName == "threadReview" ? "Review changes" : routeName == "threadReviewComment" ? "Leave a comment" : routeName == "threadFiles" ? (workspace.fileInspectorSupported and filesData.error == "" ? threadData.title : filesData.title) : (routeName == "threadFile" or routeName == "newTaskFile") ? fileData.title : routeName == "thread" ? threadData.title : routeName == "settingsScheduledTasks" ? "Scheduled Tasks" : routeName == "settingsScheduledNew" ? "New scheduled task" : routeName == "settingsScheduledEdit" ? "Edit scheduled task" : routeName == "settingsScheduledModel" ? "Model" : routeName == "settingsScheduledBranch" ? "Base branch" : routeName == "settingsUsage" ? "Usage" : routeName == "settingsUsageAccount" ? "Account" : routeName == "settings" ? "Settings" : routeName == "settingsServer" ? serverSettings.title : routeName == "settingsProviders" ? "Provider accounts" : routeName == "settingsAppearance" ? "Appearance" : routeName == "settingsChoice" ? (settingsChoice.key == "composerEnterBehavior" ? "Keyboard" : settingsChoice.key == "followUpBehavior" ? "Follow-ups" : settingsChoice.key == "projectGroupingMode" ? "Organization" : settingsChoice.title) : routeName == "archive" ? "Archived threads" : routeName == "threadAgents" ? "Agents" : routeName == "newTaskEnvironments" ? "Environment" : routeName == "newTaskBranches" ? "Branch" : routeName == "threadModel" or routeName == "newTaskModel" ? "Model" : routeName == "threadRuntime" or routeName == "newTaskRuntime" ? "Runtime" : routeName == "threadModelOption" or routeName == "newTaskModelOption" ? modelOptionTitle : routeName == "newTaskDraft" ? "" : "Environments"), subtitle=(routeName == "threadMedia" or routeName == "threadDraftMedia" or routeName == "newTaskMedia" ? documentData.subtitle : ""), scannerOpen=scannerOpen, automationBusy=automationChangedPending, scheduledCanCreate=automationData.scheduled.canCreate, browserMenuConfiguration=browserMenus.selection, iconColor=threadLook.foreground, sidebarAvailable=workspace.usesSplitView, sidebarVisible=workspace.sidebarVisible, back=back, closeNewTask=closeNewTask, scan=scan, addEnvironment=addEnvironment, automationAction=automationAction, browserMenu=browserMenu, toggleSidebar=toggleSidebar, inspectorAvailable=workspace.fileInspectorSupported, inspectorVisible=workspace.inspectorVisible, toggleInspector=toggleInspector)
    if focused and (routeName == "threadMedia" or routeName == "threadDraftMedia" or routeName == "newTaskMedia")
      t3-document-menu document-menu=documentMenu.configuration route-key=routeId document-tint=threadLook.foreground change=documentAction width=0 height=0 aria-hidden=true
    if focused and routeName == "threadTerminal"
      t3-terminal-menu terminal-source=terminalMenuConfiguration route-key=routeId menu-tint=threadLook.foreground change=terminalMenuEvent width=0 height=0 aria-hidden=true
    if focused and not threadData.queued and threadHeaderConfiguration != "" and (routeName == "thread" or routeName == "threadReview" or (routeName == "threadFiles" and workspace.fileInspectorSupported and filesData.error == ""))
      t3-thread-header configuration=threadHeaderConfiguration change=threadHeaderAction width=0 height=0 aria-hidden=true
    if routeName == "home" and workspace.emptyWorkspaceDetail
      column position=(layout.liquidGlass ? "absolute" : "relative") top=0 left=0 right=0 height=(layout.liquidGlass ? (layout.windowHeight > 0 ? layout.windowHeight : viewport.height) : "auto") flex=1 align-items="center" justify-content="center" padding-left=35 padding-right=35 box-sizing="border-box"
        column flex="none" max-width=360 align-items="center" gap=10.5
          image "symbol:sf/sidebar.left" font-size=17 font-weight=400 object-fit="contain" -exact-symbol-rendering="hierarchical" -exact-tint-color=homeLook.iconSubtle width=34 height=34 aria-hidden=true
          text "Select a thread" text-align="center" font-size=21 line-height="28px" font-weight=700
          text "Choose a thread from the sidebar or start a new task." text-align="center" color=homeLook.muted font-size=16 line-height="23px"
          button press=openNewTask border-radius=9999 margin-top=7 padding-left=17.5 padding-right=17.5 padding-top=10.5 padding-bottom=10.5 background-color=homeLook.primary
            text "New Task" color=homeLook.primaryForeground font-size=16 line-height="23px" font-weight=700
    else if routeName == "notfound"
      scroll id=`scroll-${routeId}` flex=1 min-height=0 background-color=look.screen
        column min-height="100%" box-sizing="border-box" align-items="center" justify-content="center" gap=16 padding-left=24 padding-right=24 padding-top=32 padding-bottom=32
          text "Route not found" font-size=30 line-height="36px" font-weight=700 color=look.foreground
          button id="not-found-return-home" press=returnHome border-radius=999 padding-left=20 padding-right=20 padding-top=14 padding-bottom=14 background-color=look.colors.primary
            text "Return home" font-size=16 line-height="23px" font-weight=700 color=look.colors.primaryForeground
    else if routeName == "homeArrange"
      HomeArrangement(requestRoute=routeId, data=home.arrangement, colors=HomeArrangementColors(screen=look.screen, foreground=homeLook.foreground, muted=homeLook.muted, primaryText=homeLook.primaryText, borderSubtle=homeLook.borderSubtle), safeTop=0, safeBottom=0, drop=homeArrangeDrop, close=back)
    else if routeName == "home"
      Home(routeId=routeId, active=focused, refreshAt=home.nextSwipeRefreshAt, epochAtZero=homeEpochAtZero, refreshClock=refreshHomeClock, reducedMotion=viewport.prefersReducedMotion, listId="home-list", items=home.items, emptyTitle=home.emptyTitle, emptyDetail=home.emptyDetail, loading=home.loading, addEnvironment=home.addEnvironment, bottomClearance=chrome.bottomClearance, emptyClearance=chrome.emptyClearance, selectThread=chooseThread, menuAction=homeMenuAction, toggleShelf=toggleHomeShelf, showMore=showMore, addConnection=addEnvironment, colors=homeLook)
      HomeChrome(routeKey=routeId, configuration=chrome.configuration, event=homeEvent, height=(layout.liquidGlass ? chrome.toolbarContentInset + layout.safeBottom : 0))
    else if routeName == "thread" or (routeName == "threadFiles" and workspace.fileInspectorSupported and filesData.error == "")
      // Childless bounds stay settled while unrelated images load; the route probe also hears equal-flow viewport changes.
      for geometryOwner in [threadGeometryKey] key=geometryOwner
        view id=`thread-route-bounds-${routeId}` position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=threadGeometryChanged(geometryOwner)
      column id=`thread-flow-${routeId}` flex=1 min-height=0 width="100%" position="relative" pointer-events="none"
        view id=`thread-flow-bounds-${routeId}` position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=threadGeometryChanged(threadGeometryKey)
        column position="absolute" top=0 left=0 right=0 bottom=(-threadCoveredBottom) pointer-events="auto"
          ThreadFeed(data=threadData, active=focused, workWidth=(workspace.contentSettledWidth - workspace.chatHorizontalPadding * 2), horizontalPadding=workspace.chatHorizontalPadding, userBubbleMaxWidth=workspace.userBubbleMaxWidth, bottomClearance=threadDockClearance, action=threadAction, openMedia=openMedia, colors=threadLook)
      if threadData.queuedFailed
        column id=`thread-dock-${routeId}` position="absolute" left=0 right=0 bottom=0 padding-left=14 padding-right=14 padding-bottom=threadBottomInset pointer-events="none"
          view id=`thread-dock-bounds-${routeId}` position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=threadGeometryChanged(threadGeometryKey)
          column width="100%" max-width=workspace.chatContentMaxWidth align-self="center" pointer-events="auto"
            ThreadCreationFailedCard(data=threadData, action=threadAction, colors=threadLook)
      else if not threadData.queued
        column id=`thread-dock-${routeId}` position="absolute" left=0 right=0 bottom=0 pointer-events="none"
          view id=`thread-dock-bounds-${routeId}` position="absolute" inset=0 pointer-events="none" aria-hidden=true resize=threadGeometryChanged(threadGeometryKey)
          MobileWorkingControl(data=workingControl, colors=threadLook, maxWidth=min(workspace.contentSettledWidth, workspace.chatContentMaxWidth), openAgents=workingAgents, openBrowser=workingBrowser, openDevices=workingDevices, openQueue=workingQueue, reconnect=workingReconnect)
          column pointer-events="auto"
            column width="100%" max-width=workspace.chatContentMaxWidth align-self="center"
              ThreadApprovals(data=threadData, action=threadAction, colors=threadLook)
            column width="100%" max-width=workspace.chatContentMaxWidth align-self="center"
              ThreadLocalFeedback(data=threadSubmission.dock, colors=threadLook, card=threadLocalLook.card, command=threadLocalCommand)
              ThreadSubmissionRecoveryNotice(data=threadSubmission.recovery, colors=threadLook, card=threadLocalLook.card, busy=threadSubmission.busy or changedPending, command=threadLocalCommand)
              ThreadLocalUsage(data=threadSubmission.dock, colors=threadLook, card=threadLocalLook.card, tertiary=threadLocalLook.tertiary, subtleStrong=threadLocalLook.subtleStrong, dark=appearance.scheme == "dark", command=threadLocalCommand)
            if threadData.pendingInput.active
              for requestOwner in [threadData.pendingInput.cardId] key=requestOwner
                column width="100%" max-width=workspace.chatContentMaxWidth align-self="center" padding-left=14 padding-right=14 padding-bottom=threadBottomInset box-sizing="border-box"
                  PendingInputCard(data=threadData.pendingInput, colors=threadData.pendingInput.colors, maxHeight=max(160, min(560, viewport.height - 336 - 44 - threadBottomInset - 12)), act=pendingInputAct, coverage=pendingInputMeasured)
            column display=(threadData.pendingInput.active ? "none" : "flex")
              ComposerAttachmentStrip(data=composerAttachments, open=openDraftMedia, remove=removeAttachment, colors=threadLook)
              ThreadComposer(attachments=composerAttachments, attachmentBusy=(data.busy or changedPending or taskChangedPending), liquidGlass=layout.liquidGlass, displayScale=layout.displayScale, submission=threadSubmission, rich=richComposer, richAction=richComposerAction, richEvent=richComposerEvent, richMessage=richComposerMessage, editorId=`thread-composer-${routeId}`, showQueue=false, showBackdrop=true, voiceDisabled=(data.busy or changedPending or taskChangedPending or (threadData.composer.editing and not threadData.composer.canCancel)), voice=voiceData, voiceOwner=(focused ? voiceFocus.owner : ""), voiceColors=voiceLook, voiceAction=voiceAction, enterBehavior=appearance.enterBehavior, data=threadData.composer, expanded=composerExpanded, dark=appearance.scheme == "dark", bottomInset=threadBottomInset, contentMaxWidth=min(workspace.contentSettledWidth, workspace.chatContentMaxWidth), focusChanged=composerFocus, editDraft=editDraft, action=threadAction, pickAttachments=pickAttachments, openModelSettings=openModelSettings, colors=threadLook)
    else if routeName == "threadQueue"
