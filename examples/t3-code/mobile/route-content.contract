              case some(connection)
                EnvironmentDetail(data=detail, connection=connection, colors=look.colors, dark=appearance.scheme == "dark", pending=detailChangedPending, toggleConnection=toggle, setEnabled=setEnabled, reconnect=reconnect, remove=remove, save=save, action=detailAction)
              case none
                text "This environment is no longer saved on this device." color=look.colors.muted padding=17.5
