// ThreadComposer compact/expanded geometry and ComposerActionButton, upstream365aa87982.
// @ref llp/1106.002-design-system-parity.spec.md#typography-and-font-assets
use ThreadComposerState, ThreadColors from "./thread-shapes.contract"
use ProviderIcon from "./provider-icon.contract"
component ThreadComposer
  props
    data: ThreadComposerState
    expanded: bool
    dark: bool
    bottomInset: number
    contentMaxWidth: number
    editDraft: action
    focusChanged: action
    action: action
    pickAttachments: action
    openModelSettings: action
    colors: ThreadColors
  view
    column padding-left=12 padding-right=12 padding-top=(expanded ? 8 : 6) padding-bottom=(bottomInset + (expanded ? 8 : 6)) font-family="DM Sans"
      column width="100%" max-width=contentMaxWidth align-self="center"
        when data.modelUnavailable
          button press=openModelSettings padding-left=10.5 padding-right=10.5 padding-top=7 padding-bottom=7 text-align="left"
            text "Model unavailable. Open model settings." font-size=13 line-height="17px" color=colors.foreground
        column border-radius=(expanded ? 26 : 27) min-height=(expanded ? 140 : 48)
          overflow="hidden" box-sizing="border-box" padding-top=(expanded ? 14 : 2) padding-bottom=(expanded ? 6 : 2)
          background-color=colors.composerSurface border-width=1 border-style="solid" border-color=colors.composerBorder
          row flex-direction=(expanded ? "column" : "row") align-items=(expanded ? "stretch" : "center")
            when not expanded
              button press=pickAttachments width=44 height=44 padding=0 aria-label="Add attachment"
                column width=44 height=44 align-items="center" justify-content="center"
                  t3-symbol symbol-name="plus" point-size=20 symbol-weight="regular" symbol-tint=colors.iconSubtle width=20 height=20
            // Keep one editor plan site while focus changes compact geometry.
            textarea value=data.draft input=editDraft focus=focusChanged(true) blur=focusChanged(false) placeholder=data.placeholder
              height=(expanded ? 72 : 36) max-height=160 flex=(expanded ? 0 : 1) min-width=0
              padding-left=(expanded ? 14 : 4) padding-right=(expanded ? 14 : 4) padding-top=(expanded ? 4 : 6) padding-bottom=(expanded ? 4 : 6)
              box-sizing="border-box" font-family="DM Sans" font-size=16 line-height="23px" color=colors.foreground
              border-width=0 background-color="transparent" testId="thread-composer"
            when expanded
              view height=3.5
              row align-items="center" gap=0
                button press=pickAttachments width=44 height=44 padding=0 aria-label="Add attachment"
                  column width=44 height=44 align-items="center" justify-content="center"
                    t3-symbol symbol-name="plus" point-size=20 symbol-weight="regular" symbol-tint=colors.iconSubtle width=20 height=20
                button press=openModelSettings flex=1 min-width=0 height=38.5 padding-left=7 padding-right=7 aria-label="Model and reasoning settings"
                  row min-width=0 align-items="center" gap=7 justify-content="flex-end"
                    ProviderIcon(driver=data.providerDriver, size=14, dark=dark, iconUrl=data.providerIconURL)
                    text data.modelLabel min-width=0 flex-shrink=1 line-clamp=1 text-overflow="ellipsis" font-size=14 line-height="19px" font-weight=500 color=colors.foreground
                    t3-symbol symbol-name="chevron.down" point-size=10 symbol-weight="regular" symbol-tint=colors.iconSubtle width=10 height=10
                ThreadSendButton(data=data, action=action, colors=colors)
            else
              ThreadSendButton(data=data, action=action, colors=colors)
        when data.showReadOnlyNotice
          text "This connection cannot control this task. You can still edit your draft." padding-top=7 font-size=13 line-height="17px" color=colors.muted

component ThreadSendButton
  props
    data: ThreadComposerState
    action: action
    colors: ThreadColors
  derive disabled = data.showStop ? not data.canStop : not data.canSend
  view
    button press=action((data.showStop ? "stop" : "send"), "", "")
      disabled=disabled width=44 height=44 padding=0 flex-shrink=0
      aria-label=(data.showStop ? "Stop agent" : length(data.blockedReason) > 0 ? data.blockedReason : data.sendLabel)
      testId="thread-send"
      column width=44 height=44 align-items="center" justify-content="center"
        column width=30 height=30 border-radius=15 align-items="center" justify-content="center"
          background-color=(data.showStop ? colors.danger : colors.primary) opacity=(disabled ? 0.15 : 1)
          t3-symbol symbol-name=(data.showStop ? "stop.fill" : data.sendSymbol) point-size=14 symbol-weight="semibold"
            symbol-tint=(data.showStop ? colors.dangerForeground : colors.primaryForeground) width=14 height=14
