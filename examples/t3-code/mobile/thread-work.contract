// @ref llp/1109.005-composer-and-transcript.decision.md#work-log-detail-rows
// Pinned thread-work-log.tsx and work-log-layout.tsx; mobile rem is 14px.
use ThreadActivity, ThreadColors from "./thread-shapes.contract"
use ThreadMarkdown from "./thread-markdown.contract"
component ThreadToolRow
  props
    activity: ThreadActivity
    workWidth: number
    action: action
    colors: ThreadColors
  action toggleDetail
    if activity.expandable
      haptic("selection")
      action("chatlocal:item-detail", activity.id, (activity.expanded ? "closed" : "open"))
  action retryPreparation
    if not activity.retryDisabled
      haptic("selection")
      action("chat:retry-preparation", "", activity.retryRunId)
  view
    column
      if activity.prominentError
        t3-work-failure configuration=activity.nativeWorkRow preferred-width=workWidth failure-message=activity.detail failure-time=activity.timestamp failure-warning=activity.warning
          failure-icon=(activity.warning ? colors.warningForeground : colors.dangerForeground) failure-foreground=colors.foreground failure-subtle=colors.subtle failure-border=colors.border
          retry-run=activity.retryRunId retry-disabled=activity.retryDisabled press=retryPreparation width="100%" min-width=0 testId=`thread-work-${activity.id}`
      else
        if activity.nativeWorkRow != ""
          if activity.nativeWorkImage
            column position="relative" height=28 min-width=0
              t3-work-row configuration=activity.nativeWorkRow row-has-image=true row-muted=colors.muted row-icon=colors.iconSubtle row-subtle=colors.subtle press=toggleDetail
                height=28 width="100%" min-width=0 aria-label=activity.label aria-expanded=activity.expanded testId=`thread-work-${activity.id}`
              image activity.iconURL position="absolute" left=5.25 top=7 width=14 height=14 object-fit="contain" pointer-events="none" aria-hidden=true
          else
            t3-work-row configuration=activity.nativeWorkRow row-muted=colors.muted row-icon=colors.iconSubtle row-subtle=colors.subtle press=toggleDetail
              height=28 min-width=0 aria-label=activity.label aria-expanded=activity.expanded testId=`thread-work-${activity.id}`
        else
          button press=toggleDetail
            disabled=(not activity.expandable) padding-left=1.75 padding-right=1.75 padding-top=0 padding-bottom=0 text-align="left" border-radius=7
            aria-expanded=activity.expanded aria-label=(activity.answerPreview != "" ? `${activity.label}: ${activity.answerPreview}` : activity.label)
            row align-items="center" gap=5.25 min-height=28
              column width=21 height=21 flex-shrink=0 align-items="center" justify-content="center"
                if activity.iconURL.length > 0
                  image activity.iconURL width=14 height=14 object-fit="contain"
                else
                  t3-symbol symbol-name=activity.symbol point-size=14 symbol-weight="medium" symbol-tint=colors.iconSubtle width=14 height=14
              text flex=1 min-width=0 font-family="DM Sans" font-size=14 line-height="19px" color=colors.muted line-clamp=1 text-overflow="ellipsis"
                text activity.label
                if activity.answerPreview != ""
                  text `  ${activity.answerPreview}` color=(not activity.expanded and activity.hasAnswer ? colors.foreground : colors.iconSubtle)
              column width=14 height=14 align-items="center" justify-content="center"
                if activity.expandable
                  t3-symbol symbol-name=(activity.expanded ? "chevron.up" : "chevron.down") point-size=11 symbol-weight="regular" symbol-tint=colors.iconSubtle width=11 height=11
        if activity.expanded
          column padding-top=(activity.reasoning ? 3.5 : 1.75) padding-bottom=3.5 margin-left=(activity.reasoning ? 24.5 : 0)
            if activity.answerHistory.length > 0
              column gap=7
                for entry in activity.answerHistory key=entry.id
                  column gap=3.5
                    if entry.question != ""
                      text entry.question font-family="DM Sans" font-size=14 line-height="19px" color=colors.muted
                    if entry.answer != ""
                      text entry.answer margin-left=10.5 font-family="DM Sans" font-size=14 line-height="19px" color=colors.muted
                    for file in entry.files key=file.id
                      button role="link" press=action("thread-answer-file", file.id, "") disabled=(file.url == "") padding=0 text-align="left" aria-label=file.name
                        column gap=3.5
                          if file.image and file.url != ""
                            image file.url width=160 height=96 object-fit="contain" aria-label=file.name
                          text file.name font-family="DM Sans" font-size=14 line-height="19px" color=colors.foreground text-decoration-line="underline"
            if activity.nativeWorkDetail
              t3-work-detail configuration=activity.nativeWorkRow detail-text=activity.body detail-muted=colors.muted height=210 min-width=0 testId=`thread-work-detail-${activity.id}`
            else if activity.nativeCommandDetail
              t3-work-detail configuration=activity.nativeWorkRow detail-kind="command" preferred-width=workWidth
                detail-text=activity.body detail-output=activity.output detail-result=activity.result detail-foreground=colors.foreground detail-muted=colors.muted
                detail-result-foreground=colors.dangerForeground max-height=210 min-width=0 testId=`thread-work-detail-${activity.id}`
            else
              scroll max-height=210 overflow-y="auto"
                column padding-right=8
                  if activity.reasoning
                    ThreadMarkdown(blocks=activity.reasoningBlocks, user=false, action=action, colors=colors)
                  else if activity.body.length > 0
                    text activity.body font-family="Menlo" font-size=12 line-height="18px" white-space="pre-wrap" color=(activity.call ? colors.foreground : colors.muted)
                  if not activity.reasoning and activity.output.length > 0
                    text activity.output margin-top=5.25 font-family="Menlo" font-size=12 line-height="18px" white-space="pre-wrap" color=colors.muted
                  if activity.result.length > 0
                    text activity.result margin-top=5.25 font-family="Menlo" font-size=12 line-height="18px" color=(activity.failed ? colors.dangerForeground : colors.muted)
