// Pinned365aa87982 ComposerFeedback / ComposerUsageLimits / dense AccountLimits.
// @ref llp/1109.005-composer-and-transcript.decision.md#ordinary-send-handoff-and-pending-feed
use ThreadColors from "./thread-shapes.contract"
use ProviderIcon from "./provider-icon.contract"
shape ThreadLocalFeedbackRow
  id: string
  status: string
  title: string
  description: string
  feedbackId: string
  dismissible: bool
  createdAt: string
shape ThreadLocalLimitWindow
  id: string
  label: string
  remaining: number
  color: string
  hasTime: bool
  timeLeft: number
  pace: string
  resets: string
shape ThreadLocalLimitAccount
  id: string
  key: string
  first: bool
  driver: string
  label: string
  instanceLabel: string
  detail: string
  notice: string
  externalURL: string
  windows: list<ThreadLocalLimitWindow>
  creditsVisible: bool
  creditsSummary: string
  resetKey: string
  resetInput: string
  resetVisible: bool
  resetDisabled: bool
  resetLabel: string
  permissionMessage: string
  resetStatus: string
shape ThreadLocalLimitNotice
  id: string
  text: string
  border: bool
shape MobileThreadLocalDockData
  hasUsage: bool
  usageKey: string
  maxHeight: number
  feedback: list<ThreadLocalFeedbackRow>
  accounts: list<ThreadLocalLimitAccount>
  notices: list<ThreadLocalLimitNotice>
component ThreadLocalDock
  props
    data: MobileThreadLocalDockData
    colors: ThreadColors
    card: string
    tertiary: string
    subtleStrong: string
    dark: bool
    command: action
  view
    ThreadLocalFeedback(data=data, colors=colors, card=card, command=command)
    ThreadLocalUsage(data=data, colors=colors, card=card, tertiary=tertiary, subtleStrong=subtleStrong, dark=dark, command=command)
component ThreadLocalFeedback
  props
    data: MobileThreadLocalDockData
    colors: ThreadColors
    card: string
    command: action
  view
    each item in data.feedback key=item.id
      column padding-left=14 padding-right=14 padding-bottom=10.5 flex-shrink=0 font-family="DM Sans"
        column gap=7 border-radius=20 corner-shape="-exact-continuous" background-color=card padding=14
          row align-items="center" gap=10.5
            text item.title flex=1 min-width=0 font-size=14 line-height="19px" color=colors.foreground aria-live="polite"
            when item.dismissible
              button press=command("feedback-dismiss", item.id, "") padding=3.5 aria-label="Dismiss feedback notice" retainFocus=true
                t3-symbol symbol-name="xmark" point-size=14 symbol-tint=colors.iconMuted width=14 height=14
          when length(item.description) > 0
            text item.description font-size=13 line-height="17px" color=colors.muted
          when item.status == "sent"
            button press=command("feedback-copy", item.id, item.feedbackId) align-self="flex-start" padding-top=3.5 padding-bottom=3.5 retainFocus=true
              text "Copy ID" font-size=14 line-height="19px" color=colors.foreground
component ThreadLocalUsage
  props
    data: MobileThreadLocalDockData
    colors: ThreadColors
    card: string
    tertiary: string
    subtleStrong: string
    dark: bool
    command: action
  view
    when data.hasUsage
      column padding-left=14 padding-right=14 padding-bottom=10.5 flex-shrink=0 font-family="DM Sans"
        column border-radius=20 corner-shape="-exact-continuous" overflow="hidden" background-color=card
          scroll max-height=data.maxHeight min-height=0 scrollbar-width="none" overscroll-behavior="none" retainFocus=true
            each account in data.accounts key=account.key
              ThreadLocalAccount(account=account, usageKey=data.usageKey, colors=colors, tertiary=tertiary, subtleStrong=subtleStrong, dark=dark, command=command)
            when length(data.accounts) == 0
              row align-items="center" gap=10.5 padding-left=14 padding-right=14 padding-top=10.5
                text "Usage limits" flex=1 min-width=0 font-size=16 line-height="23px" color=colors.foreground
                ThreadLocalClose(usageKey=data.usageKey, color=colors.iconMuted, command=command)
            each notice in data.notices key=notice.id
              text notice.text padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5
                font-size=13 line-height="17px" color=colors.muted border-width=0 border-top-width=(notice.border ? 1 : 0) border-style="solid" border-color=colors.borderSubtle
component ThreadLocalClose
  props
    usageKey: string
    color: string
    command: action
  view
    button press=command("usage-close", usageKey, "") margin-right=-3.5 padding=3.5 aria-label="Dismiss usage limits" retainFocus=true
      t3-symbol symbol-name="xmark" point-size=14 symbol-tint=color width=14 height=14
component ThreadLocalAccount
  props
    account: ThreadLocalLimitAccount
    usageKey: string
    colors: ThreadColors
    tertiary: string
    subtleStrong: string
    dark: bool
    command: action
  state revealed = false
  action toggleAccount
    revealed = not revealed
  view
    column gap=10.5 padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5
      border-width=0 border-top-width=(account.first ? 0 : 1) border-style="solid" border-color=colors.borderSubtle
      row align-items="center" gap=7
        ProviderIcon(driver=account.driver, size=16, dark=dark, iconUrl="")
        row flex=1 min-width=0 align-items="baseline" gap=7
          text account.label font-size=16 line-height="23px" font-weight=500 color=colors.foreground
          when length(account.instanceLabel) > 0
            when includes(account.instanceLabel, "@")
              button press=toggleAccount min-width=0 flex-shrink=1 padding=0 retainFocus=true aria-label=(revealed ? "Hide account label" : "Reveal account label")
                text `· ${revealed ? account.instanceLabel : "••••••@••••••"}` font-size=13 line-height="17px" color=tertiary line-clamp=1
            else
              text `· ${account.instanceLabel}` min-width=0 flex-shrink=1 font-size=13 line-height="17px" color=tertiary line-clamp=1
          when length(account.detail) > 0
            text `· ${account.detail}` min-width=0 flex-shrink=1 font-size=14 line-height="19px" color=colors.muted line-clamp=1
        when account.first
          ThreadLocalClose(usageKey=usageKey, color=colors.iconMuted, command=command)
      when length(account.notice) > 0
        text account.notice font-size=14 line-height="19px" color=colors.muted
      else
        column gap=10.5
          each window in account.windows key=window.id
            column gap=3.5
              row align-items="baseline" justify-content="space-between" gap=10.5
                text window.label font-size=14 line-height="19px" color=colors.foreground
                text `${window.remaining}% left` font-variant-numeric="tabular-nums" font-size=14 line-height="19px" font-weight=500 color=colors.foreground
              column height=10.5 justify-content="center" position="relative"
                row height=5.25 overflow="hidden" border-radius=999 background-color=colors.subtle
                  view height="100%" width=`${window.remaining}%` border-radius=999 background-color=(length(window.color) > 0 ? window.color : colors.foreground)
                when window.hasTime
                  view position="absolute" top=0 bottom=0 width=1 left=`${window.timeLeft}%` background-color=colors.foreground opacity=0.6
              when length(window.pace) > 0 or length(window.resets) > 0
                row justify-content="space-between" gap=10.5
                  text window.pace font-size=13 line-height="17px" color=tertiary
                  text window.resets font-variant-numeric="tabular-nums" font-size=13 line-height="17px" color=tertiary
      when length(account.externalURL) > 0
        button press=command("open-link", account.key, account.externalURL) min-height=38.5 justify-content="center" align-items="flex-start" role="link" retainFocus=true
          text "Manage usage" font-size=14 line-height="19px" font-weight=500 color=colors.primary
      when account.creditsVisible
        row flex-wrap="wrap" align-items="center" column-gap=10.5 row-gap=3.5
          text account.creditsSummary font-variant-numeric="tabular-nums" font-size=13 line-height="17px" color=tertiary
          when account.resetVisible
            button press=command("reset-credit", account.resetKey, account.resetInput) disabled=account.resetDisabled opacity=(account.resetDisabled ? 0.45 : 1)
              border-radius=999 background-color=subtleStrong padding-left=8.75 padding-right=8.75 padding-top=3.5 padding-bottom=3.5 retainFocus=true
              text account.resetLabel font-size=13 line-height="17px" font-weight=500 color=colors.foreground
          when length(account.permissionMessage) > 0
            text account.permissionMessage font-size=13 line-height="17px" color=tertiary
          when length(account.resetStatus) > 0
            text account.resetStatus font-size=14 line-height="19px" color=colors.foreground
