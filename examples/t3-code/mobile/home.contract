use ProviderIcon from "./provider-icon.contract"
use ContentGeometry from "./content-geometry.contract"
use ProjectFavicon, ProjectFaviconTarget from "./project-favicon.contract"
use SettingsTextRole from "./settings.contract"
// @ref examples/t3-code/mobile/docs/1130.004-home-projection.decision.md#decision
// Upstream 365aa87982 HomeScreen, thread-list-v2-items, EmptyState (screen pane).
// @ref examples/t3-code/mobile/docs/1130.002-design-system-parity.spec.md#typography-and-font-assets
use HomeMenu, HomeMenuItem from "./home-menu.contract"
use HomeSwipeControls, HomeSwipeMenu, homeSwipeField, homeSwipeNumber, homeSwipeFinite, homeSwipeInteger from "./home-swipe.contract"

fn homeMeasuredHeight(geometry: ContentGeometry, fallback: number): number = geometry.state == "ready" and geometry.bounds.height > 0 ? geometry.bounds.height : fallback
fn homeMeasuredSafeTop(geometry: ContentGeometry, fallback: number): number = geometry.state == "ready" ? geometry.safeArea.top : fallback
fn homeTrailingReservation(geometry: ContentGeometry): number = geometry.state != "ready" ? 0 : match first(geometry.reservedRegions.filter(region => region.kind == "occlusion" and region.x > geometry.bounds.x + geometry.bounds.width * 0.5)) { case some(region) => max(0, geometry.bounds.x + geometry.bounds.width - region.x), case none => 0 }

shape HomeColors
  foreground: string
  muted: string
  secondary: string
  secondaryFill: string
  secondaryForeground: string
  screen: string
  drawer: string
  drawerForeground: string
  drawerMuted: string
  selectedBackground: string
  selectedForeground: string
  selectedMuted: string
  selectedQueued: string
  tertiary: string
  border: string
  borderSubtle: string
  primary: string
  primaryText: string
  primaryForeground: string
  iconSubtle: string
  warning: string
  inputStatus: string
  workingStatus: string
  dangerForeground: string
  done: string
  menuBackground: string
  card: string
  draft: string

shape HomeSwipeData
  primary: string
  primaryLabel: string
  primarySymbol: string
  primaryAccessibilityLabel: string
  secondary: string
  secondaryAccessibilityLabel: string
  resetKey: string
  token: string
  snoozable: bool
  gateExpiry: number
  snoozeItems: HomeMenuItem[]

shape HomeProviderPrevious
  key: string
  driver: string

shape HomeProvider
  visible: bool
  driver: string
  iconUrl: string
  previous: HomeProviderPrevious[]
  showBadge: bool
  badge: string
  badgeColor: string

shape HomeItem
  key: string
  kind: string
  draftKey: string
  queuedOwner: string
  showPendingDivider: bool
  id: string
  environmentId: string
  threadId: string
  projectId: string
  section: string
  title: string
  projectTitle: string
  projectPresent: bool
  branch: string
  environmentLabel: string
  machineSymbol: string
  status: string
  statusTone: string
  time: string
  error: string
  card: bool
  pinned: bool
  queued: bool
  expanded: bool
  disabled: bool
  count: number
  last: bool
  trailingDivider: bool
  selected: bool
  favicon: string
  faviconTarget: ProjectFaviconTarget
  iconKind: string
  iconText: string
  iconColor: string
  iconSurface: string
  iconSize: number
  provider: HomeProvider
  searchExcerpt: string
  menuItems: HomeMenuItem[]
  nativeMenu: string
  dismissalIdentity: string
  swipe: HomeSwipeData

component Home
  props
    contentGeometry: ContentGeometry
    listId: string
    routeId: string
    active: bool
    refreshAt: number
    epochAtZero: number
    refreshClock: action
    reducedMotion: bool
    items: HomeItem[]
    emptyTitle: string
    emptyDetail: string
    emptyTitleRole: SettingsTextRole
    emptyDetailRole: SettingsTextRole
    plainTitleRole: SettingsTextRole
    plainDetailRole: SettingsTextRole
    plainActionRole: SettingsTextRole
    loading: bool
    addEnvironment: bool
    fullPageEmpty: bool
    liquidGlass: bool
    windowHeight: number
    safeTop: number
    bottomClearance: number
    emptyClearance: number
    menuAction: action
    selectThread: action
    toggleShelf: action
    showMore: action
    addConnection: action
    colors: HomeColors
  provide
    projectFaviconSurface = listId
  derive swipeOwner = `${routeId}:${listId}`
  derive fullPageFrame = fullPageEmpty and liquidGlass
  derive measuredHeight = homeMeasuredHeight(contentGeometry, windowHeight)
  derive measuredSafeTop = homeMeasuredSafeTop(contentGeometry, safeTop)
  derive trailingReservation = homeTrailingReservation(contentGeometry)
  state stateOwner = ""
  state openToken = ""
  state dragToken = ""
  state dragOffset = 0
  state dragBase = 0
  state gestureSerial = 0
  state gestureSequence = -1
  state surfaceOwner = ""
  state surfaceSequence = -1
  state scrollGated = false
  state tickOwner = ""
  state tickDeadline = 0
  action chooseThread(id: string)
    openToken = ""
    dragToken = ""
    dragOffset = 0
    selectThread(id)
  action chooseMenu(environmentId: string, threadId: string, kind: string, value: string)
    openToken = ""
    dragToken = ""
    dragOffset = 0
    menuAction(environmentId, threadId, kind, value)
  action chooseSwipe(token: string, environmentId: string, threadId: string, kind: string, value: string)
    if active and stateOwner == swipeOwner and openToken == token and items.filter(item => item.swipe.token == token and item.environmentId == environmentId and item.threadId == threadId and item.swipe.snoozable).length == 1
      openToken = ""
      dragToken = ""
      dragOffset = 0
      menuAction(environmentId, threadId, kind, value)
  action swipeEvent(message: string)
    let parts = message.split("|")
    if homeSwipeField(parts, 0) == "1" and homeSwipeField(parts, 1) == swipeOwner
      if parts.length == 4
        let phase = homeSwipeField(parts, 3)
        let serial = homeSwipeNumber(parts, 2)
        if homeSwipeInteger(parts, 2) and serial >= 0
          if phase == "tick"
            if active and serial > 0 and serial == refreshAt and (tickOwner != swipeOwner or tickDeadline != serial)
              tickOwner = swipeOwner
              tickDeadline = serial
              refreshClock()
          else if ["scroll-begin", "scroll-gated", "scroll-clear"].includes(phase) and (surfaceOwner != swipeOwner or serial > surfaceSequence) and (stateOwner != swipeOwner or serial > gestureSerial)
            surfaceOwner = swipeOwner
            surfaceSequence = serial
            scrollGated = phase == "scroll-gated" ? true : phase == "scroll-clear" ? false : scrollGated
            if phase == "scroll-begin" or phase == "scroll-gated"
              openToken = ""
            if phase == "scroll-gated"
              dragToken = ""
              dragOffset = 0
      else if parts.length == 5 and homeSwipeField(parts, 3) == "retired" and homeSwipeInteger(parts, 2)
        let serial = homeSwipeNumber(parts, 2)
        let token = homeSwipeField(parts, 4)
        if serial > 0 and (surfaceOwner != swipeOwner or serial > surfaceSequence) and (stateOwner != swipeOwner or serial > gestureSerial)
          surfaceOwner = swipeOwner
          surfaceSequence = serial
          if stateOwner == swipeOwner and (openToken == token or dragToken == token)
            openToken = ""
            dragToken = ""
            dragOffset = 0
      else if parts.length == 12
        let token = homeSwipeField(parts, 2)
        let gesture = homeSwipeNumber(parts, 3)
        let sequence = homeSwipeNumber(parts, 4)
        let phase = homeSwipeField(parts, 5)
        if homeSwipeInteger(parts, 3) and gesture > 0 and homeSwipeInteger(parts, 4) and sequence >= 0 and ["begin", "change", "end", "cancel"].includes(phase) and homeSwipeFinite(parts, 6) and homeSwipeFinite(parts, 7) and homeSwipeFinite(parts, 8) and homeSwipeFinite(parts, 9) and homeSwipeFinite(parts, 10) and homeSwipeNumber(parts, 10) > 0 and homeSwipeFinite(parts, 11) and homeSwipeNumber(parts, 11) > 0
          if phase == "cancel" and stateOwner == swipeOwner and gesture == gestureSerial and sequence > gestureSequence and (dragToken == token or openToken == token)
            gestureSequence = sequence
            openToken = ""
            dragToken = ""
            dragOffset = 0
          else
            match first(items.filter(item => item.kind == "thread" and item.swipe.token == token and item.swipe.primary != ""))
              case some(item)
                let strip = item.swipe.secondary == "" ? 58 : 116
                let x = homeSwipeNumber(parts, 6)
                if phase == "begin"
                  if active and (surfaceOwner != swipeOwner or not scrollGated) and (stateOwner != swipeOwner or gesture > gestureSerial) and (surfaceOwner != swipeOwner or gesture > surfaceSequence)
                    let base = stateOwner == swipeOwner and openToken == token ? 0 - strip : 0
                    stateOwner = swipeOwner
                    gestureSerial = gesture
                    gestureSequence = sequence
                    dragToken = token
                    dragBase = base
                    dragOffset = max(0 - strip, min(0, base + x))
                    openToken = ""
                else if stateOwner == swipeOwner and dragToken == token and gesture == gestureSerial and sequence > gestureSequence
                  gestureSequence = sequence
                  if phase == "cancel" or not active
                    openToken = ""
                    dragToken = ""
                    dragOffset = 0
                  else if phase == "end"
                    let projected = x + 0.05 * homeSwipeNumber(parts, 8)
                    let remainsOpen = dragBase < 0 ? projected < strip * 0.42 : projected < 0 - strip * 0.42
                    openToken = remainsOpen ? token : ""
                    dragToken = ""
                    dragOffset = 0
                  else
                    dragOffset = max(0 - strip, min(0, dragBase + x))
              case none
                dragToken = dragToken
  view
    t3-home-swipe-events swipe-owner=swipeOwner swipe-active=active swipe-route-key=(listId == "sidebar-list" ? "t3-workspace-sidebar" : routeId) swipe-refresh-at=`${refreshAt}` swipe-epoch-at-zero=`${epochAtZero}` width=0 height=0 change=swipeEvent testId=`home-swipe-events-${listId}`
    if items.length == 0 and listId == "sidebar-list"
      list id=listId appearance="none" flex=1 min-height=0 box-sizing="border-box" padding-left=8 padding-right=8 padding-top=6 padding-bottom=bottomClearance
        text emptyTitle padding-left=7 padding-right=7 padding-top=14 padding-bottom=14 font-size=14 line-height="19px" color=colors.drawerMuted translate="0px 0.5px" testId="sidebar-empty-title"
    else if items.length == 0 and not fullPageEmpty
      scroll id=listId flex=1 min-height=0 box-sizing="border-box" padding-bottom=bottomClearance
        column flex="none" padding=17.5
          border-radius=22
          border-width=1
          border-style="solid"
          border-color=colors.border
          background-color=colors.card
          text emptyTitle font-size=emptyTitleRole.size
            line-height=`${emptyTitleRole.line}px`
            font-weight=700
            color=colors.foreground
            testId="home-empty-title"
          text emptyDetail margin-top=7
            font-size=emptyDetailRole.size
            line-height=`${emptyDetailRole.size * 1.625}px`
            color=colors.muted
            testId="home-empty-detail"
    else if items.length == 0
      // Reference HomeScreen's unfiltered empty box spans the transparent glass window; filtered empties stay in flow.
      column flex=1
        position=(fullPageFrame ? "absolute" : "static")
        top=(fullPageFrame ? 0 : "auto")
        left=(fullPageFrame ? 0 : "auto")
        right=(fullPageFrame ? 0 : "auto")
        height=(fullPageFrame ? measuredHeight : "auto")
        box-sizing=(fullPageFrame ? "border-box" : "content-box")
        align-items="center"
        justify-content="center"
        padding-left=28
        padding-right=28
        padding-top=(fullPageFrame ? measuredSafeTop + 72 : 0)
        padding-bottom=emptyClearance
        column max-width=430 width="100%"
          align-items="center"
          box-sizing="border-box"
          padding=28
          text emptyTitle font-size=plainTitleRole.size
            line-height=`${plainTitleRole.line}px`
            font-weight=700
            color=colors.foreground
            text-align="center"
            testId="home-empty-title"
          text emptyDetail margin-top=7
            font-size=plainDetailRole.size
            line-height=`${plainDetailRole.size * 1.5}px`
            color=colors.muted
            text-align="center"
            testId="home-empty-detail"
          if addEnvironment
            button appearance="none" press=addConnection
              margin-top=17.5
              border-radius=9999
              background-color=colors.primary
              padding-left=17.5
              padding-right=17.5
              padding-top=10.5
              padding-bottom=10.5
              testId="home-add-environment"
              text "Add environment" color=colors.primaryForeground font-size=plainActionRole.size line-height=`${plainActionRole.line}px` font-weight=700
    else
      list id=listId appearance="none" flex=1 min-height=0 box-sizing="border-box" overflow-x="hidden" overscroll-behavior="contain" keyboardDismissMode="on-drag" scrollbar-width="none" hatch="mobile-home-swipe-list" data-mobile-swipe-owner=swipeOwner
        padding-left=(listId == "sidebar-list" ? 8 : 0)
        padding-right=(listId == "sidebar-list" ? 8 : trailingReservation)
        padding-top=(listId == "sidebar-list" ? 6 : 0)
        min-width=0
        virtualized=true
        estimated-item-height=88
        testId="home-thread-list"
        for item in items key=item.key
          HomeListItem(surface=listId, owner=swipeOwner, active=active, openToken=(active and stateOwner == swipeOwner ? openToken : ""), dragToken=(active and stateOwner == swipeOwner ? dragToken : ""), dragOffset=dragOffset, reducedMotion=reducedMotion, item=item, bottomClearance=bottomClearance, selectThread=chooseThread, menuAction=chooseMenu, toggleShelf=toggleShelf, showMore=showMore, colors=colors)
      for item in items key=item.key
        if item.menuItems.length > 0
          HomeMenu(menuId=`home-menu-${listId}-${item.key}`, items=item.menuItems, environmentId=item.environmentId, threadId=item.threadId, action=chooseMenu, foreground=colors.foreground, muted=colors.muted, danger=colors.dangerForeground, background=colors.menuBackground)
        if item.swipe.snoozeItems.length > 0
          HomeSwipeMenu(token=item.swipe.token, menuId=`home-snooze-${listId}-${item.key}`, items=item.swipe.snoozeItems, environmentId=item.environmentId, threadId=item.threadId, action=chooseSwipe, foreground=colors.foreground, muted=colors.muted, danger=colors.dangerForeground, background=colors.menuBackground)

component HomeListItem
  props
    surface: string
    owner: string
    active: bool
    openToken: string
    dragToken: string
    dragOffset: number
    reducedMotion: bool
    item: HomeItem
    bottomClearance: number
    selectThread: action
    menuAction: action
    toggleShelf: action
    showMore: action
    colors: HomeColors
  state exitIdentity = ""
  state exitToken = ""
  state exitRegistration = 0
  state exitPhase = "idle"
  state exitStarted = 0
  state exitWidth = 0
  state exitHeight = 0
  state exitFrom = 0
  state exitProgress = 0
  derive exiting = exitToken != "" and exitIdentity == item.dismissalIdentity
  derive collapsing = exiting and (exitPhase == "collapse" or exitPhase == "collapsed")
  derive exitEase = 1 - (1 - exitProgress) * (1 - exitProgress) * (1 - exitProgress)
  derive exitTarget = min(exitFrom, 0 - exitWidth)
  derive swipeOffset = dragToken == item.swipe.token and item.swipe.token != "" ? dragOffset : openToken == item.swipe.token and item.swipe.token != "" ? (item.swipe.secondary == "" ? -58 : -116) : 0
  derive exitOffset = exiting ? (exitPhase == "out" ? exitFrom + (exitTarget - exitFrom) * exitEase : exitTarget) : swipeOffset
  derive swipeTransition = exitToken != "" or dragToken == item.swipe.token or reducedMotion ? "none" : "translate -exact-spring(330, 26, 0.7)"
  action resetDismissal
    exitIdentity = ""
    exitToken = ""
    exitRegistration = 0
    exitPhase = "idle"
    exitStarted = 0
    exitWidth = 0
    exitHeight = 0
    exitFrom = 0
    exitProgress = 0
  action dismissalEvent(message: string)
    let parts = message.split("|")
    if parts.length == 5 and homeSwipeField(parts, 0) == "2" and homeSwipeField(parts, 1) == item.dismissalIdentity and homeSwipeInteger(parts, 2) and homeSwipeNumber(parts, 2) > 0 and homeSwipeNumber(parts, 2) == exitRegistration and homeSwipeField(parts, 3) != "" and homeSwipeField(parts, 3) == exitToken and homeSwipeField(parts, 4) == "retired"
      resetDismissal()
    else if parts.length == 8 and homeSwipeField(parts, 0) == "2" and homeSwipeField(parts, 1) == item.dismissalIdentity and homeSwipeInteger(parts, 2) and homeSwipeNumber(parts, 2) > 0 and homeSwipeField(parts, 3) != "" and homeSwipeFinite(parts, 5) and homeSwipeFinite(parts, 6) and homeSwipeNumber(parts, 6) > 0 and homeSwipeFinite(parts, 7) and homeSwipeNumber(parts, 7) > 0
      let phase = homeSwipeField(parts, 4)
      if phase == "out"
        exitIdentity = item.dismissalIdentity
        exitToken = homeSwipeField(parts, 3)
        exitRegistration = homeSwipeNumber(parts, 2)
        exitStarted = homeSwipeNumber(parts, 5)
        exitWidth = homeSwipeNumber(parts, 6)
        exitHeight = homeSwipeNumber(parts, 7)
        exitFrom = swipeOffset
        exitProgress = reducedMotion ? 1 : 0
        exitPhase = reducedMotion ? "out-done" : "out"
      else if exiting and exitToken == homeSwipeField(parts, 3) and exitRegistration == homeSwipeNumber(parts, 2)
        if phase == "collapse"
          exitStarted = homeSwipeNumber(parts, 5)
          exitProgress = reducedMotion ? 1 : 0
          exitPhase = reducedMotion ? "collapsed" : "collapse"
        else if phase == "restore"
          resetDismissal()
        else if phase == "tick" and (exitPhase == "out" or exitPhase == "collapse")
          let progress = min(1, max(0, (homeSwipeNumber(parts, 5) - exitStarted) / (exitPhase == "out" ? 220 : 180)))
          exitProgress = progress
          if progress == 1
            exitPhase = exitPhase == "out" ? "out-done" : "collapsed"
  derive menuId = `home-menu-${surface}-${item.key}`
  derive statusColor = item.statusTone == "approval" or item.statusTone == "limited" ? colors.warning : item.statusTone == "input" ? colors.inputStatus : item.statusTone == "working" ? colors.workingStatus : item.statusTone == "failed" ? colors.dangerForeground : item.statusTone == "done" ? colors.done : colors.tertiary
  derive sidebar = surface == "sidebar-list"
  derive selectedRow = sidebar and item.selected
  derive rowBackground = sidebar ? (selectedRow ? colors.selectedBackground : colors.drawer) : colors.screen
  derive idleMuted = sidebar ? colors.drawerMuted : colors.muted
  derive rowForeground = selectedRow ? colors.selectedForeground : sidebar ? colors.drawerForeground : colors.foreground
  derive rowMuted = selectedRow ? colors.selectedMuted : idleMuted
  derive rowTertiary = selectedRow ? colors.selectedMuted : sidebar ? colors.drawerMuted : colors.tertiary
  derive rowStatusColor = item.status.length > 0 ? statusColor : selectedRow ? colors.selectedForeground : rowTertiary
  derive queuedColor = selectedRow ? colors.selectedQueued : colors.muted
  view
    column min-width=0 padding-bottom=(item.last ? bottomClearance * (collapsing ? 1 - exitEase : 1) : 0)
      height=(collapsing ? exitHeight * (1 - exitEase) : "auto") min-height=0 box-sizing="border-box" overflow=(exiting ? "hidden" : "visible") pointer-events=(exiting ? "none" : "auto")
      hatch="mobile-home-dismissal" data-mobile-swipe-owner=owner data-mobile-swipe-row=item.swipe.token data-mobile-dismissal-identity=item.dismissalIdentity
      if item.kind == "thread"
        t3-home-swipe-events swipe-owner=owner swipe-row=item.swipe.token swipe-context=item.nativeMenu swipe-dismissal-identity=item.dismissalIdentity swipe-dismissal-registration=`${exitRegistration}` swipe-dismissal-token=exitToken swipe-dismissal-phase=(exiting ? exitPhase : "idle") swipe-dismissal-progress=`${exitProgress}` width=0 height=0 change=dismissalEvent
      if item.kind == "shelf"
        button appearance="none" press=toggleShelf(item.section)
          disabled=item.disabled
          margin-top=14
          margin-bottom=5.25
          padding=0
          padding-left=(sidebar ? 10.5 : 17.5)
          padding-right=(sidebar ? 10.5 : 17.5)
          aria-label=`${item.count} ${item.section} ${item.count == 1 ? "thread" : "threads"}`
          aria-expanded=item.expanded
          testId=`home-shelf-${item.section}`
          row align-items="center" gap=8.75
            text item.title font-size=13 line-height="17px" font-weight=500 color=(item.section == "snoozed" ? colors.secondary : colors.tertiary)
            view flex=1 min-width=0 height=1 background-color=(item.section == "snoozed" ? colors.primary : colors.border) opacity=(item.section == "snoozed" ? 0.2 : 1)
            t3-symbol symbol-name=(item.expanded ? "chevron.up" : "chevron.down") symbol-weight="regular" symbol-tint=colors.muted width=10 height=10
      else if item.kind == "more"
        button appearance="none" press=showMore
          position="relative"
          margin-left=14
          margin-right=14
          margin-top=7
          border-radius=7
          padding-top=8.75
          padding-bottom=8.75
          aria-label=`Show more settled threads`
          testId="home-show-more"
          svg position="absolute" top=0 left=0 width="100%" height="100%" pointer-events="none"
            rect x=0 y=0 width="100%" height="100%" rx=7 fill="none" stroke=colors.border stroke-width=1 stroke-dasharray="3 3"
          text item.title font-size=13 line-height="17px" font-weight=500 color=colors.muted
      else if item.kind == "draft" or item.kind == "pending"
        if item.showPendingDivider
          row margin-top=14 margin-bottom=5.25 padding-left=(surface == "sidebar-list" ? 10.5 : 17.5) padding-right=(surface == "sidebar-list" ? 10.5 : 17.5) align-items="center" gap=8.75
            text "Unsent" font-size=13 line-height="17px" font-weight=500 color=(surface == "sidebar-list" ? colors.muted : colors.tertiary)
            view flex=1 min-width=0 height=1 background-color=colors.border
        button appearance="none" press=menuAction(item.environmentId, item.threadId, (item.kind == "draft" ? "draft-open" : "pending-open"), (item.kind == "draft" ? item.draftKey : item.queuedOwner))
          hatch="mobile-home-row"
          data-mobile-home-menu=item.nativeMenu
          data-mobile-home-surface=surface
          data-mobile-home-foreground=colors.foreground
          data-mobile-home-primary=colors.primary
          data-mobile-home-danger=colors.dangerForeground
          data-mobile-home-background=colors.card
          data-mobile-home-menu-id=(surface == "sidebar-list" ? menuId : "")
          contextPopover=(surface != "sidebar-list" and item.menuItems.length > 0 ? menuId : "")
          padding=0
          border-radius=(surface == "sidebar-list" ? 12 : 0)
          background-color=(surface == "sidebar-list" ? colors.drawer : colors.screen)
          text-align="left"
          aria-label=item.title
          aria-description=(item.kind == "draft" ? "Opens the draft in the new task composer" : "Opens the pending task")
          testId=(item.kind == "draft" ? `home-draft-${item.draftKey}` : `home-pending-${item.threadId}`)
          column padding-left=(surface == "sidebar-list" ? 12 : 17.5) padding-right=(surface == "sidebar-list" ? 12 : 17.5) padding-top=(surface == "sidebar-list" ? 10 : 8.75) padding-bottom=(surface == "sidebar-list" ? 10 : 8.75)
            row align-items="center" gap=5.25
              if item.projectPresent
                HomeProjectIcon(item=item, colors=colors)
              text item.projectTitle flex=1 min-width=0 line-clamp=1 text-overflow="ellipsis" font-size=14 line-height="19px" font-weight=500 color=colors.muted
              row align-items="center" gap=3.5
                if item.kind == "draft"
                  t3-symbol symbol-name="square.and.pencil" symbol-weight="regular" symbol-tint=colors.draft width=10 height=10
                text item.status font-size=13 line-height="17px" color=(item.kind == "draft" ? colors.draft : colors.muted)
            text item.title margin-top=3.5 font-size=16 line-height="23px" font-weight=500 color=colors.foreground line-clamp=1 text-overflow="ellipsis"
            if item.branch.length > 0 or item.environmentLabel.length > 0
              row margin-top=3.5 align-items="center" gap=3.5
                text min-width=0 flex-shrink=1 font-size=13 line-height="17px" line-clamp=1 text-overflow="ellipsis"
                  text item.branch font-family="Menlo" color=colors.muted
                  if item.branch.length > 0 and item.environmentLabel.length > 0
                    text "  ·  " color=colors.muted
                  text item.environmentLabel color=(surface == "sidebar-list" ? colors.muted : colors.tertiary)
                if item.environmentLabel.length > 0 and item.machineSymbol.length > 0
                  t3-symbol symbol-name=item.machineSymbol symbol-weight="regular" symbol-tint=(surface == "sidebar-list" ? colors.muted : colors.tertiary) width=11 height=11 flex-shrink=0
          if item.trailingDivider and surface != "sidebar-list"
            view height=1 min-width=0 margin-left=17.5 margin-right=17.5 background-color=colors.borderSubtle
      else
        box position="relative" min-width=0 overflow="hidden" border-radius=(sidebar ? 12 : 0) background-color=(sidebar ? colors.drawer : colors.screen)
          if item.swipe.primary != ""
            HomeSwipeControls(surface=surface, owner=owner, token=item.swipe.token, menuId=`home-snooze-${surface}-${item.key}`, context=item.nativeMenu, enabled=active and item.swipe.snoozable, open=openToken == item.swipe.token, card=item.card, offset=swipeOffset, secondary=item.swipe.secondary != "", primaryLabel=item.swipe.primaryLabel, primarySymbol=item.swipe.primarySymbol, primaryAccessibilityLabel=item.swipe.primaryAccessibilityLabel, secondaryAccessibilityLabel=item.swipe.secondaryAccessibilityLabel, foreground=colors.foreground, muted=colors.muted, primary=colors.primary, primaryForeground=colors.primaryForeground, secondaryFill=colors.secondaryFill, secondaryForeground=colors.secondaryForeground, actionOpacity=(exiting ? (exitPhase == "out" ? 1 - exitEase : 0) : 1))
          column translate=`${exitOffset}px 0px` transition=swipeTransition min-width=0 background-color=rowBackground border-radius=(sidebar ? 12 : 0) overflow=(sidebar ? "hidden" : "visible") testId=`home-swipe-content-${item.key}`
            button appearance="none" press=selectThread(item.id)
              hatch="mobile-home-row"
              data-mobile-swipe-owner=owner
              data-mobile-swipe-row=item.swipe.token
              data-mobile-swipe-enabled=(active and item.swipe.primary != "")
              data-mobile-swipe-open=(openToken == item.swipe.token and item.swipe.token != "")
              data-mobile-home-menu=item.nativeMenu
              data-mobile-home-surface=surface
              data-mobile-home-foreground=colors.foreground
              data-mobile-home-primary=colors.primary
              data-mobile-home-danger=colors.dangerForeground
              data-mobile-home-background=colors.card
              data-mobile-home-menu-id=(surface == "sidebar-list" ? menuId : "")
              contextPopover=(surface != "sidebar-list" and item.menuItems.length > 0 ? menuId : "")
              padding=0
              text-align="left"
              aria-label=(item.queued ? `${item.title}, messages queued to send` : item.title)
              aria-selected=selectedRow
              testId=`home-thread-${item.key}`
              if item.card
                column padding-left=(sidebar ? 12 : 17.5) padding-right=(sidebar ? 12 : 17.5) padding-top=(sidebar ? 10 : 8.75) padding-bottom=(sidebar ? 10 : 8.75)
                  row align-items="center" gap=5.25
                    if item.projectPresent
                      HomeProjectIcon(item=item, colors=colors)
                    text item.projectTitle flex=1 min-width=0 line-clamp=1 text-overflow="ellipsis"
                      font-size=14 line-height="19px" font-weight=500 color=rowMuted
                    if item.queued
                      t3-symbol symbol-name="tray.and.arrow.up" symbol-weight="regular" symbol-tint=queuedColor width=12 height=12
                    if item.pinned
                      t3-symbol symbol-name="pin" symbol-weight="regular" symbol-tint=idleMuted width=11 height=11
                    text (item.status.length > 0 ? item.status : item.time) font-size=13 line-height="17px" color=rowStatusColor
                  text item.title margin-top=3.5 font-size=16 line-height="23px" font-weight=500 color=rowForeground line-clamp=2 text-overflow="ellipsis"
                  if item.searchExcerpt.length > 0
                    text item.searchExcerpt margin-top=3.5 font-size=13 line-height="17px" color=colors.muted line-clamp=1 text-overflow="ellipsis"
                  row margin-top=3.5 align-items="center" gap=7
                    if item.error.length > 0
                      text item.error flex=1 min-width=0 white-space="nowrap" overflow="hidden" font-size=13 line-height="17px" color=(selectedRow ? colors.selectedMuted : statusColor) text-overflow="ellipsis"
                    else if item.branch.length > 0 or item.environmentLabel.length > 0
                      row flex=1 min-width=0 align-items="center" gap=3.5
                        text min-width=0 flex-shrink=1 font-size=13 line-height="17px" line-clamp=1 text-overflow="ellipsis"
                          text item.branch font-family="Menlo" color=rowMuted
                          if item.branch.length > 0 and item.environmentLabel.length > 0
                            text "  ·  " color=rowMuted
                          text item.environmentLabel color=rowTertiary
                        if item.environmentLabel.length > 0
                          t3-symbol symbol-name=item.machineSymbol symbol-weight="regular" symbol-tint=rowTertiary width=11 height=11 flex-shrink=0
                    else
                      view flex=1 min-width=0
                    if item.provider.visible
                      HomeProviderStack(provider=item.provider, surfaceColor=rowBackground, colors=colors)
              else
                row min-height=44
                  box-sizing="border-box"
                  align-items="center"
                  gap=7
                  padding-left=(sidebar ? 10.5 : 17.5)
                  padding-right=(sidebar ? 10.5 : 17.5)
                  padding-top=7
                  padding-bottom=7
                  if item.projectPresent
                    column opacity=0.4
                      HomeProjectIcon(item=item, colors=colors)
                  column flex=1 min-width=0
                    text item.title font-size=16 line-height="23px" color=(selectedRow ? colors.selectedForeground : idleMuted) line-clamp=1 text-overflow="ellipsis"
                    if item.searchExcerpt.length > 0
                      text item.searchExcerpt font-size=13 line-height="17px" color=colors.muted line-clamp=1 text-overflow="ellipsis"
                  if item.queued
                    t3-symbol symbol-name="tray.and.arrow.up" symbol-weight="regular" symbol-tint=queuedColor width=12 height=12
                  text item.time font-family="Menlo" font-size=14 line-height="19px" color=(item.section == "snoozed" ? rowMuted : rowTertiary)
        if item.card and item.trailingDivider and not sidebar
          view height=1 min-width=0 margin-left=17.5 margin-right=17.5 background-color=colors.borderSubtle testId=`home-thread-divider-${item.key}`


component HomeProjectIcon
  inject
    projectFaviconSurface: string
  props
    item: HomeItem
    colors: HomeColors
  view
    column width=15 height=15 flex-shrink=0 align-items="center" justify-content="center"
      if item.iconKind == "emoji"
        text item.iconText font-size=12 line-height="15px" text-align="center"
      else if item.iconKind == "monogram"
        column width=15 height=15 border-radius=3.75 background-color=item.iconSurface align-items="center" justify-content="center"
          text item.iconText font-family="Menlo" font-size=item.iconSize line-height="15px" font-weight=700 color=item.iconColor text-align="center" line-clamp=1
      else
        ProjectFavicon(mountId=`${projectFaviconSurface}:${item.key}`, target=item.faviconTarget, title=item.projectTitle, size=15, tint=colors.iconSubtle)

// Pinned ProviderInstanceIcon: the brand dims; its account badge stays saturated.
component HomeProviderStack
  props
    provider: HomeProvider
    surfaceColor: string
    colors: HomeColors
  view
    row align-items="center" flex-shrink=0 aria-hidden=true
      for previous in provider.previous key=previous.key
        box margin-right=-3.5 opacity=0.3 width=12 height=12 flex-shrink=0
          ProviderIcon(driver=previous.driver, size=12, dark=false, iconUrl="")
      box position="relative" width=14 height=14 flex-shrink=0
        box opacity=0.6 width=14 height=14
          ProviderIcon(driver=provider.driver, size=14, dark=false, iconUrl=provider.iconUrl)
        if provider.showBadge
          box position="absolute" right=-3 bottom=-3 height=12 min-width=12 box-sizing="border-box"
            padding-left=2 padding-right=2 border-radius=999 border-width=1 border-style="solid" border-color=surfaceColor
            background-color=(provider.badgeColor != "" ? provider.badgeColor : colors.card)
            display="flex" align-items="center" justify-content="center"
            text provider.badge font-size=7 line-height="9px" font-weight=600 color=(provider.badgeColor != "" ? "#ffffff" : colors.muted)
