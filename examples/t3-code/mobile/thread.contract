// ThreadFeed and pending approvals at upstream365aa87982; actions delegate to the shared command seam.
// @ref examples/t3-code/mobile/docs/1130.002-design-system-parity.spec.md#typography-and-font-assets
use ThreadSnapshot, ThreadRow, ThreadMedia, ThreadColors from "./thread-shapes.contract"
use ThreadMarkdown from "./thread-markdown.contract"
use ThreadToolRow from "./thread-work.contract"
component ThreadFeed
  props
    data: ThreadSnapshot
    horizontalPadding: number
    userBubbleMaxWidth: number
    workWidth: number
    bottomClearance: number
    action: action
    openMedia: action
    active: bool
    colors: ThreadColors
  view
    if data.rows.length == 0
      column flex=1 min-height=0 align-items="center" justify-content="center" padding-left=(horizontalPadding + 24) padding-right=(horizontalPadding + 24) padding-bottom=bottomClearance
        column max-width=320 align-items="center" gap=7
          text data.emptyTitle text-align="center" font-family="DM Sans" font-size=18 line-height="23px" font-weight=700 color=colors.foreground
          text data.emptyDetail text-align="center" font-family="DM Sans" font-size=14 line-height="21px" color=colors.secondary
    else
      column flex=1 min-height=0 justify-content="flex-end"
        list id="thread-feed" max-height="100%" min-height=0 virtualized=true estimated-item-height=180 scroll-start="end" scrollFollowEnd=true
          padding-left=horizontalPadding padding-right=horizontalPadding testId="thread-feed"
          for row in data.rows key=row.id
            column padding-top=(row.first ? 12 : 0) padding-bottom=(row.last ? bottomClearance : 0) font-family="DM Sans"
              if row.first and (data.hasMore or data.historyError.length > 0)
                column align-items="center" gap=5.25 margin-bottom=10.5 padding-left=7 padding-right=7
                  if data.hasMore
                    button press=action("chatlocal:history", "", "") disabled=data.historyLoading
                      min-height=31.5 border-radius=9999 border-width=1 border-style="solid" border-color=colors.border
                      background-color=colors.subtle padding-left=14 padding-right=14 padding-top=7 padding-bottom=7
                      aria-label="Load earlier activity" testId="thread-history"
                      row align-items="center" gap=7
                        t3-symbol symbol-name="chevron.up" symbol-weight="regular" symbol-tint=colors.primary width=12 height=12
                        text (data.historyLoading ? "Loading earlier activity…" : "Load earlier activity") font-size=14 line-height="19px" font-weight=500 color=colors.foreground
                  if data.historyError.length > 0
                    text data.historyError text-align="center" font-size=13 line-height="17px" color=colors.iconSubtle
              if data.queued and not data.queuedFailed and row.first
                column gap=7 padding=12 margin-bottom=12 border-radius=14 background-color=colors.subtle testId="outbox-status"
                  text data.queuedStatus font-size=14 line-height="19px" font-weight=500 color=colors.foreground
                  if data.queuedReason.length > 0
                    text data.queuedReason font-size=13 line-height="18px" color=colors.secondary
                  if data.queuedCanRetry
                    button press=action("outbox:retry", data.queuedOwner, "") padding=7 aria-label="Retry pending task" testId="outbox-retry"
                      text "Retry" font-size=14 line-height="19px" font-weight=500 color=colors.primary
              ThreadMessage(row=row, workWidth=workWidth, userBubbleMaxWidth=userBubbleMaxWidth, action=action, openMedia=openMedia, active=active, colors=colors)

component ThreadMessage
  props
    row: ThreadRow
    userBubbleMaxWidth: number
    workWidth: number
    action: action
    openMedia: action
    active: bool
    colors: ThreadColors
  view
    column margin-bottom=(row.kind == "html-render" ? 8 : row.user or row.showMeta ? 17.5 : 3.5) testId=`thread-row-${row.id}`
      if row.kind == "html-render"
        column width=workWidth height=row.htmlRender.height min-height=80
          if active and row.htmlRender.available
            t3-document-html media-source=row.htmlRender.sourceJSON change=action("html-render", row.htmlRender.key) flex=1 min-height=0
      else if row.user
        column align-items="flex-end"
          if row.attribution.length > 0
            text row.attribution margin-bottom=3.5 padding-right=3.5 font-size=12 line-height="16px" font-weight=500 color=colors.muted opacity=0.6
          column box-sizing="border-box" min-width=0 max-width=userBubbleMaxWidth width=(row.media.length > 0 ? userBubbleMaxWidth : "auto") gap=7 border-radius=20 padding-left=12.25 padding-right=12.25 padding-top=8.75 padding-bottom=8.75 background-color=colors.userBubble
            for media in row.media key=media.id
              if row.kind == "pending"
                if media.kind == "image" and media.url != ""
                  image media.url width=180 height=140 object-fit="cover" border-radius=14 aria-label=media.name
                else
                  text media.name font-size=14 line-height="19px" color=colors.userForeground
              else
                ThreadAttachment(media=media, user=row.user, openMedia=openMedia, colors=colors)
            if row.body.trim().length > 0
              ThreadMarkdown(blocks=row.blocks, user=true, action=action, colors=colors)
          row margin-top=3.5 align-items="center" justify-content="flex-end" gap=3.5 padding-right=1.75
            if row.kind != "pending" and row.intentTone != ""
              text row.intent aria-label=row.intentDescription testId=`thread-intent-${row.id}`
                font-size=colors.intentFontSize line-height=`${colors.intentLineHeight}px` font-weight=500 letter-spacing=colors.intentLetterSpacing
                padding-left=5.25 padding-right=5.25 padding-top=1.75 padding-bottom=1.75 border-radius=9999 border-width=1 border-style="solid"
                border-color=(row.intentTone == "queued" ? colors.queuedIntentBorder : colors.steerIntentBorder)
                background-color=(row.intentTone == "queued" ? colors.queuedIntentBackground : colors.steerIntentBackground)
                color=(row.intentTone == "queued" ? colors.queuedIntentForeground : colors.steerIntentForeground)
            else if row.intent.length > 0
              text row.intent font-size=12 line-height="16px" font-weight=500 color=colors.secondary
            text row.timestamp font-size=13 line-height="17px" font-weight=500 color=colors.secondary
            if row.body.trim().length > 0 and row.kind != "pending"
              ThreadCopy(row=row, action=action, active=active, colors=colors)
            if row.kind == "pending" and row.toggleOp != ""
              button press=action(row.toggleOp, row.toggleId, "") min-height=28 padding-left=7 padding-right=7 aria-label="Retry pending message"
                text "Retry" font-size=13 line-height="17px" color=colors.primary
          if row.kind == "pending" and row.title != ""
            text row.title margin-top=3.5 font-size=13 line-height="17px" color=(row.failed ? colors.dangerForeground : colors.secondary)
      else if row.kind == "assistant" or row.kind == "plan" or row.kind == "meta"
        column padding-left=3.5 padding-right=3.5
          if row.kind == "plan"
            text row.title font-size=18 line-height="23px" font-weight=700 color=colors.foreground margin-bottom=7
          ThreadMarkdown(blocks=row.blocks, user=false, action=action, colors=colors)
          for media in row.media key=media.id
            ThreadAttachment(media=media, user=row.user, openMedia=openMedia, colors=colors)
          if row.showMeta
            row margin-top=3.5 align-items="center" gap=3.5
              if row.canFork
                button press=action("fork-response", row.id, row.forkKey) width=24.5 height=24.5 padding=0 disabled=row.forkBusy opacity=(row.forkBusy ? 0.4 : 1) aria-label="Fork from this response" testId=`thread-fork-${row.id}`
                  column width=24.5 height=24.5 align-items="center" justify-content="center"
                    if row.forkBusy
                      t3-archive-spinner spinner-tint=colors.iconSubtle width=20 height=20
                    else
                      t3-symbol symbol-name="arrow.triangle.branch" symbol-weight="regular" symbol-tint=colors.iconSubtle width=13 height=13
              ThreadCopy(row=row, action=action, active=active, colors=colors)
              text row.timestamp font-size=13 line-height="17px" font-weight=500 color=colors.secondary
      else
        column
          if row.toggleOp.length > 0
            button press=action(row.toggleOp, row.toggleId, "") box-sizing="border-box" padding-left=7 padding-right=7 padding-top=0 padding-bottom=0 min-height=(row.kind == "work" ? 38.5 : 28) text-align="left"
              border-bottom-width=(row.kind == "work" ? 1 : 0) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
              aria-expanded=row.expanded aria-label=row.title
              row align-items="center" gap=7
                text row.title flex-shrink=1 min-width=0 line-clamp=1 text-overflow="ellipsis" font-size=14 line-height="19px" font-weight=500 font-variant-numeric=(row.kind == "work" ? "tabular-nums" : "normal") color=(row.failed ? colors.dangerForeground : colors.muted)
                t3-symbol symbol-name=(row.expanded ? "chevron.down" : "chevron.right") symbol-weight="regular" symbol-tint=colors.iconSubtle width=(row.kind == "work" ? 15 : 10) height=(row.kind == "work" ? 15 : 10)
          else if row.title.length > 0
            text row.title min-height=28 padding-left=7 font-size=14 line-height="19px" color=(row.failed ? colors.dangerForeground : colors.muted)
          if row.body.length > 0
            ThreadMarkdown(blocks=row.blocks, user=false, action=action, colors=colors)
          for activity in row.activities key=activity.id
            ThreadToolRow(activity=activity, workWidth=workWidth, action=action, colors=colors)

component ThreadCopy
  props
    row: ThreadRow
    action: action
    active: bool
    colors: ThreadColors
  view
    t3-message-copy configuration=row.copyConfiguration copy-active=active row-icon=colors.iconSubtle
      message=action("chatlocal:copy", row.id) width=28 height=28 padding=0

component ThreadAttachment
  props
    media: ThreadMedia
    user: bool
    openMedia: action
    colors: ThreadColors
  view
    button press=openMedia(media.id) padding=0 text-align="left" aria-label=media.name
      if media.kind == "image" and media.url.length > 0
        image media.url width="100%" aspect-ratio=1.3 object-fit="cover" border-radius=(user ? 14 : 18) aria-label=media.name
      else
        row align-items="center" gap=7 padding=7 border-radius=14 background-color=colors.subtle
          t3-symbol symbol-name=(media.kind == "video" ? "play.rectangle" : media.kind == "image" ? "photo" : "doc") symbol-weight="regular" symbol-tint=colors.iconSubtle width=18 height=18
          text media.name flex-shrink=1 min-width=0 font-size=14 line-height="19px" color=colors.foreground line-clamp=1 text-overflow="ellipsis"

component ThreadApprovals
  props
    data: ThreadSnapshot
    action: action
    colors: ThreadColors
  view
    if data.approvals.length > 0
      column gap=8.75 padding=12
        for approval in data.approvals key=approval.id
          column gap=8.75 border-radius=20 border-width=1 border-style="solid" border-color=colors.border background-color=colors.subtle padding=14
            text "Approval needed" font-size=12 line-height="16px" font-weight=700 text-transform="uppercase" letter-spacing=1.1 color=colors.secondary
            text approval.title font-size=18 line-height="23px" font-weight=700 color=colors.foreground
            if approval.detail.length > 0
              text approval.detail font-size=14 line-height="21px" color=colors.secondary
            if approval.reason.length > 0
              text approval.reason font-size=14 line-height="19px" color=colors.secondary
            if approval.warning.length > 0
              text approval.warning font-size=13 line-height="19.5px" color=colors.warningForeground
            row flex-wrap="wrap" gap=8.75
              for option in approval.options key=option.id
                button press=action("approval", approval.id, option.id) disabled=approval.disabled
                  padding-left=14 padding-right=14 padding-top=8.75 padding-bottom=8.75 border-radius=9999
                  background-color=(option.tone == "primary" ? colors.primary : option.tone == "danger" ? colors.danger : colors.subtle)
                  text option.label font-size=14 line-height="19px" font-weight=700 color=(option.tone == "primary" ? colors.primaryForeground : option.tone == "danger" ? colors.dangerForeground : colors.foreground)


// Pinned ThreadCreationFailedCard replaces the composer after durable restoration.
component ThreadCreationFailedCard
  props
    data: ThreadSnapshot
    action: action
    colors: ThreadColors
  view
    column gap=8.75 border-radius=20 border-width=1 border-style="solid" border-color=colors.borderSubtle background-color=colors.subtle padding=14 testId="task-creation-failed"
      text "COULD NOT START TASK" font-family="DM Sans" font-size=12 line-height="16px" font-weight=700 letter-spacing=1.1 color=colors.dangerForeground
      text data.queuedReason font-size=14 line-height="20px" color=colors.secondary
      text (data.queuedCanEdit ? "Your prompt was kept in the project draft." : "The saved draft is no longer available here.") font-size=13 line-height="17px" color=colors.secondary
      if data.queuedCanEdit
        row
          button press=action("outbox:edit", data.queuedOwner, "") border-radius=14 padding-left=12.25 padding-right=12.25 padding-top=10.5 padding-bottom=10.5 background-color=colors.primary testId="task-creation-edit" aria-label="Edit task"
            text "Edit task" font-size=14 line-height="19px" font-weight=800 color=colors.primaryForeground
