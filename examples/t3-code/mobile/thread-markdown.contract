// ThreadFeed MarkdownCodeBlock, upstream365aa87982. Prose uses Exact's portable Markdown reader.
// @ref llp/1109.002-design-system-parity.spec.md#typography-and-font-assets
use ThreadBlock, ThreadColors from "./thread-shapes.contract"
component ThreadMarkdown
  props
    blocks: list<ThreadBlock>
    user: bool
    action: action
    colors: ThreadColors
  view
    column min-width=0
      each block in blocks key=block.id
        when block.kind == "code"
          column margin-top=10.5 margin-bottom=10.5
            min-width=0 max-width="100%" align-self="stretch"
            overflow="hidden" border-radius=7 border-width=1 border-style="solid"
            border-color=(user ? colors.userCodeBackground : colors.codeBackground)
            background-color=(user ? colors.userCodeBackground : colors.codeBackground)
            row align-items="center" justify-content="space-between" gap=7
              border-bottom-width=1 border-bottom-style="solid" border-bottom-color=(user ? colors.userCodeBackground : colors.codeBackground)
              padding-top=3.5 padding-bottom=3.5 padding-left=12.25 padding-right=5.25
              text block.language flex=1 min-width=0 line-clamp=1 font-family="Menlo" font-size=13 line-height="19px"
                text-transform="uppercase" opacity=0.7 color=(user ? colors.userCodeForeground : colors.codeForeground)
              button press=action("chatlocal:copy-code", block.id, block.text) width=32 height=32 padding=0 aria-label="Copy code"
                column align-items="center" justify-content="center" width=32 height=32
                  t3-symbol symbol-name="doc.on.doc" point-size=16 symbol-weight="regular" symbol-tint=colors.iconSubtle width=16 height=16
            view overflow-x="auto" overflow-y="hidden" max-width="100%"
              padding-left=12.25 padding-right=12.25 padding-top=10.5 padding-bottom=10.5
              text font-family="Menlo" font-size=13 line-height="19px" white-space="pre"
                each token in block.tokens key=token.id
                  text token.text color=token.color font-weight=token.weight font-style=token.slant
        else
          text block.text markup="markdown" font-size=16 line-height="23px"
            color=(user ? colors.userForeground : colors.foreground)
