// ThreadFeed MarkdownCodeBlock, upstream365aa87982. Prose uses Exact's portable Markdown reader.
// @ref examples/t3-code/mobile/docs/1130.002-design-system-parity.spec.md#typography-and-font-assets
use ThreadBlock, ThreadColors from "./thread-shapes.contract"
component ThreadMarkdown
  props
    blocks: ThreadBlock[]
    user: bool
    action: action
    colors: ThreadColors
  view
    column min-width=0
      for block in blocks key=block.id
        if block.kind == "code"
          column margin-top=10.5 margin-bottom=10.5
            min-width=0 max-width="100%" align-self="stretch"
            overflow="hidden" border-radius=7 border-width=1 border-style="solid"
            border-color=(user ? colors.userCodeBackground : colors.codeBackground)
            background-color=(user ? colors.userCodeBackground : colors.codeBackground)
            row align-items="center" justify-content="space-between" gap=7
              border-bottom-width=1 border-bottom-style="solid" border-bottom-color=(user ? colors.userCodeBackground : colors.codeBackground)
              padding-top=3.5 padding-bottom=3.5 padding-left=12.25 padding-right=5.25
              text (block.language == "" ? "text" : block.language) flex=1 min-width=0 line-clamp=1 font-family="Menlo" font-size=13 line-height="19px"
                text-transform="uppercase" opacity=0.7 color=(user ? colors.userCodeForeground : colors.codeForeground)
              button appearance="none" press=action("chatlocal:copy-code", block.id, block.text) width=32 height=32 padding=0 aria-label="Copy code"
                column align-items="center" justify-content="center" width=32 height=32
                  t3-symbol symbol-name="doc.on.doc" symbol-weight="regular" symbol-tint=colors.iconSubtle width=16 height=16
            view overflow-x="auto" overflow-y="hidden" overscroll-behavior="contain" scrollbar-width="none" min-width=0 max-width="100%" box-sizing="border-box"
              padding-left=12.25 padding-right=12.25 padding-top=10.5 padding-bottom=10.5
              text font-family="Menlo" font-size=13 line-height="19px" white-space="pre"
                for token in block.tokens key=token.id
                  text token.text user-select="text" color=token.color font-weight=token.weight font-style=token.slant
        else if block.kind == "table"
          view display="flex" align-items="flex-start" min-width=0 max-width="100%" overflow-x="auto" overflow-y="hidden" overscroll-behavior="contain" scrollbar-width="none" box-sizing="border-box" margin-top=4 margin-bottom=12
            view display="grid" role="table" flex="none" min-width=(block.columns * 60) grid-template-columns=`repeat(${block.columns}, fit-content(320px))`
              border-radius=8 border-width="-exact-hairline" border-style="solid" border-color=colors.borderSubtle
              for item in block.rows key=item.id
                for cell, index in item.cells key=cell.id
                  view role=(item.header ? "columnheader" : "cell") min-width=60 max-width=320 box-sizing="border-box" padding-left=10 padding-right=10 padding-top=7 padding-bottom=7
                    border-top-width=(item.header ? 0 : "-exact-hairline") border-top-style="solid" border-top-color=colors.borderSubtle
                    border-left-width=(index == 0 ? 0 : "-exact-hairline") border-left-style="solid" border-left-color=colors.borderSubtle
                    background-color=(item.header ? user ? colors.userCodeBackground : colors.codeBackground : "transparent")
                    text user-select="text" font-family="DM Sans" font-size=16 line-height="23px" font-weight=(item.header ? 700 : 400)
                      text-align=(match block.alignments.at(index) { case some(alignment) => alignment, case none => "left" }) font-variant-numeric=(cell.numeric ? "tabular-nums" : "normal")
                      color=(user ? colors.userForeground : colors.foreground)
                      for run in cell.runs key=run.id
                        text run.text font-weight=(run.kind == "strong" ? 700 : item.header ? 700 : 400) font-style=(run.kind == "emphasis" ? "italic" : "normal")
                          font-family=(run.kind == "code" ? "Menlo" : "DM Sans") font-size=(run.kind == "code" ? 14.4 : 16)
        else
          text block.text markup="markdown" user-select="text" font-size=16 line-height="23px"
            color=(user ? colors.userForeground : colors.foreground)
