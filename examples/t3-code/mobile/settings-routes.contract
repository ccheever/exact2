// @ref llp/1107.009-mobile-settings.decision.md#root-and-native-lifetime
// Checked route construction; the root owns navigation and Information search state.
fn mobileInformationPath(target: string, key: string): string = target == "settingsAbout" ? path("settingsAbout") : target == "settingsClientStorage" ? path("settingsClientStorage") : target == "settingsDiagnostics" ? path("settingsDiagnostics") : target == "settingsOpenSourceLicenses" ? path("settingsOpenSourceLicenses") : target == "settingsOpenSourceLicense" ? path("settingsOpenSourceLicense", key) : target == "settingsLegal" ? path("settingsLegal") : ""


fn mobileSettingPath(target: string): string = target == "SettingsAbout" ? path("settingsAbout") : target == "SettingsEnvironments" ? path("environments") : target == "SettingsThreads" ? path("settingsThreads") : target == "SettingsProjectOverview" ? path("settingsProjectOverview") : target == "SettingsAppearance" ? path("settingsAppearance") : target == "SettingsScheduledTasks" ? path("settingsScheduledTasks") : target == "SettingsUsage" ? path("settingsUsage") : target == "SettingsProviderAccounts" ? path("settingsProviders") : target == "SettingsArchive" ? path("archive") : target == "SettingsEnvironmentNewThreads" ? path("settingsServer", target) : target == "SettingsEnvironmentSourceControl" ? path("settingsServer", target) : target == "SettingsEnvironmentAgentBehavior" ? path("settingsServer", target) : target == "SettingsEnvironmentMaintenance" ? path("settingsServer", target) : target == "SettingsKeyboard" ? path("settingsChoice", target) : target == "SettingsFollowUp" ? path("settingsChoice", target) : target == "SettingsOrganization" ? path("settingsChoice", target) : target == "SettingsProjectGrouping" ? path("settingsChoice", target) : ""
