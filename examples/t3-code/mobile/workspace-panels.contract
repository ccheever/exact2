// @ref examples/t3-code/mobile/docs/1130.011-responsive-workspace.decision.md#composition-decision
// Presentation only; the root keeps the router, resources and all actions.
use MobileWorkspace from "./mobile-workspace.contract"
use unavailableContentGeometry from "./content-geometry.contract"
use HomeView, HomeChromeView, Theme, MobileLayout, Viewport from "./app-shapes.contract"
use Home, HomeColors from "./home.contract"
use SettingsTextRole from "./settings.contract"
use HomeChrome from "./home-chrome.contract"
use InspectorState, InspectorPresentation, MobileInspectorContent from "./workspace-inspector.contract"
use GitColors, MobileGitFeedback, MobileGitFeedbackSnapshot from "./git-overview.contract"
use ReviewColors from "./review-shapes.contract"
use MobileKeyboard, MobileKeyboardSnapshot from "./mobile-keyboard.contract"
use ThreadColors from "./thread-shapes.contract"
use VoiceGlobalPill, VoiceSnapshot, VoiceColors from "./voice-controls.contract"
component MobileSidebarPanel
  props
    workspace: MobileWorkspace
    sidebarHome: HomeView
    sidebarChrome: HomeChromeView
    homeLook: HomeColors
    homeEpochAtZero: number
    refreshHomeClock: action
    reducedMotion: bool
    chooseThread: action
    homeMenuAction: action
    toggleHomeShelf: action
    showMoreSidebar: action
    addEnvironment: action
    sidebarChromeEvent: action
  view
    column id="sidebar-panel" role="tabpanel" pointer-events="none" width=workspace.sidebarContentWidth height="100%" flex-shrink=0 position="relative" overflow="hidden" background-color=homeLook.drawer
      column navigationKey=workspace.sidebarRouteKey pointer-events=(workspace.sidebarVisible ? "auto" : "none") position="absolute" inset=0 navigationScroll="sidebar-list"
        header height=44 padding-left=16 display="flex" align-items="center"
          text "T3 Code" role="heading" aria-level=2 font="-exact-headline"
        if workspace.sidebarMounted
          Home(contentGeometry=unavailableContentGeometry(), routeId=workspace.sidebarRouteKey, active=workspace.sidebarVisible, refreshAt=sidebarHome.nextSwipeRefreshAt, epochAtZero=homeEpochAtZero, refreshClock=refreshHomeClock, reducedMotion=reducedMotion, listId="sidebar-list", items=sidebarHome.items, emptyTitle=sidebarHome.emptyTitle, emptyDetail=sidebarHome.emptyDetail, emptyTitleRole=SettingsTextRole(size=18, line=23), emptyDetailRole=SettingsTextRole(size=14, line=19), plainTitleRole=SettingsTextRole(size=21, line=28), plainDetailRole=SettingsTextRole(size=16, line=23), plainActionRole=SettingsTextRole(size=14, line=19), loading=sidebarHome.loading, addEnvironment=sidebarHome.addEnvironment, fullPageEmpty=sidebarHome.fullPageEmpty, liquidGlass=false, windowHeight=0, safeTop=0, bottomClearance=sidebarChrome.bottomClearance, emptyClearance=sidebarChrome.emptyClearance, selectThread=chooseThread, menuAction=homeMenuAction, toggleShelf=toggleHomeShelf, showMore=showMoreSidebar, addConnection=addEnvironment, colors=homeLook)
        HomeChrome(routeKey=workspace.sidebarRouteKey, configuration=sidebarChrome.configuration, event=sidebarChromeEvent, height=0, trailingReservation=0)

component MobileInspectorPanel
  props
    workspace: MobileWorkspace
    reviewLook: ReviewColors
    gitLook: GitColors
    inspectorPresentation: InspectorPresentation
    inspectorState: InspectorState
    layout: MobileLayout
    toggleDirectory: action
    openFile: action
    refreshFiles: action
    reviewFile: action
    gitAction: action
    refreshGit: action
    inspectorEvent: action
    inspectorControl: action
  view
    column id="inspector-panel" role="tabpanel" pointer-events="none" position="relative" width=workspace.inspectorContentWidth height="100%" flex-shrink=0 min-width=0
      column navigationKey=workspace.inspectorRouteKey pointer-events=(workspace.inspectorVisible ? "auto" : "none") position="absolute" inset=0 background-color=reviewLook.sheet navigationScroll=(inspectorPresentation.showFiles ? "inspector-files" : inspectorPresentation.showChanges ? "inspector-changes" : "inspector-git")
        -exact-layout-transition=workspace.inspectorMotion
        column width=workspace.inspectorContentWidth height="100%" overflow="hidden" opacity=(workspace.inspectorVisible ? 1 : 0) translate=(workspace.inspectorVisible ? "0px 0px" : "24px 0px") -exact-layout-transition=(workspace.inspectorVisible ? workspace.inspectorMotion : "none") transition=workspace.inspectorTransition
          row flex-shrink=0 min-height=44 padding-left=14 padding-right=7 gap=7 align-items="center" border-bottom-width=1 border-color=reviewLook.border
            column flex=1 min-width=0 padding-top=7 padding-bottom=7
              text inspectorPresentation.title role="heading" aria-level=2 font="-exact-headline" line-clamp=1
              if inspectorPresentation.subtitle != ""
                text inspectorPresentation.subtitle font="-exact-caption1" color=reviewLook.muted line-clamp=1
            button press=inspectorControl(inspectorPresentation.owner, "close", "") disabled=(not inspectorPresentation.interactive) aria-label="Close inspector" testId="inspector-close"
              image "symbol:close" width=16 height=16
          if inspectorPresentation.showFiles
            input type="search" value=inspectorPresentation.query input=inspectorControl(inspectorPresentation.owner, "search") disabled=(not inspectorPresentation.interactive) placeholder="Search files" aria-label="Search files" testId="inspector-search-files" margin=10
          MobileInspectorContent(gitColors=gitLook, state=inspectorState, data=inspectorPresentation, visible=workspace.inspectorVisible, gitBottomInset=(max(layout.safeBottom, 18) + 18), colors=reviewLook, toggleDirectory=toggleDirectory, openFile=openFile, refreshFiles=refreshFiles, reviewFile=reviewFile, gitAction=gitAction, refreshGit=refreshGit)
        t3-workspace-layout workspace-configuration=workspace.configuration change=inspectorEvent position="absolute" left=-22 top=0 bottom=0 width=44

component MobileWorkspaceMarkers
  view
    // Hidden panel markers let the iOS module take the three public navigation stacks.
    row role="tablist" display="none"
      view role="tab" aria-controls="sidebar-panel" aria-selected=false
        text "Sidebar"
      view role="tab" aria-controls="workspace-panel" aria-selected=true
        text "Workspace"
      view role="tab" aria-controls="inspector-panel" aria-selected=false
        text "Inspector"

component MobileWorkspaceOverlays
  props
    workspace: MobileWorkspace
    layout: MobileLayout
    keyboard: MobileKeyboardSnapshot
    threadLook: ThreadColors
    homeLook: HomeColors
    look: Theme
    gitFeedback: MobileGitFeedbackSnapshot
    gitLook: GitColors
    viewport: Viewport
    voiceData: VoiceSnapshot
    voiceLook: VoiceColors
    voicePillExpanded: bool
    keyboardEvent: action
    keyboardDismiss: action
    pressGitFeedback: action
    layoutChanged: action
    voiceAction: action
    expandVoicePill: action
  view
    MobileKeyboard(data=keyboard, colors=threadLook, card=homeLook.card, dangerBorder=look.colors.dangerBorder, top=layout.safeTop + 56, event=keyboardEvent, dismiss=keyboardDismiss)
    MobileGitFeedback(feedback=gitFeedback, press=pressGitFeedback, left=workspace.sidebarContentWidth + 10.5, right=workspace.inspectorContentWidth + 10.5, top=layout.safeTop + 56, reduced=viewport.prefersReducedMotion, colors=gitLook)
    t3-layout-facts change=layoutChanged position="absolute" inset=0 aria-hidden=true pointer-events="none"
    if voiceData.globalVisible
      column position="absolute" right=0 bottom=(max(layout.safeBottom, 12) + 64)
        VoiceGlobalPill(data=voiceData, colors=voiceLook, expanded=voicePillExpanded, width=min(320, viewport.width - 24), action=voiceAction, expand=expandVoicePill)
