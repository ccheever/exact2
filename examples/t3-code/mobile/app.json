{
  "$schema": "../../../scripts/app.schema.json",
  "name": "T3 Code",
  "short_name": "T3 Code",
  "id": "com.exact.t3code.ios",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "com.exact.t3code.ios",
    "name": "T3 Code"
  },
  "rust": "off",
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ],
      "localNetworking": true,
      "link": [
        "-lc++",
        "-lz",
        "-framework",
        "IOSurface",
        "-framework",
        "Metal",
        "-framework",
        "MetalKit",
        "-framework",
        "QuartzCore",
        "-framework",
        "UIKit"
      ]
    }
  },
  "deploy": {
    "store": {
      "ios": "0",
      "macos": "0",
      "web": "0",
      "linux": "0"
    }
  },
  "modules": [
    "t3-symbol",
    "t3-qr-scanner",
    "t3-home-chrome",
    "t3-layout-facts",
    "t3-archive-spinner",
    "t3-settings-slider",
    "t3-settings-header",
    "t3-media-presenter",
    "t3-mobile-terminal",
    "t3-document-menu",
    "t3-document-html",
    "t3-document-audio",
    "t3-information-legal",
    "t3-information-search",
    "t3-information-notice",
    "t3-mobile-browser",
    "t3-mobile-devices",
    "t3-preview-menu"
  ],
  "data": [
    "mobile-form-sheet",
    "mobile-scan-action",
    "mobile-scanner-open",
    "mobile-voice-owner",
    "mobile-voice-selection-revision",
    "mobile-scheduled-editor"
  ],
  "hooks": [
    "mobile-voice-editor"
  ]
}
