// iOS uses Quick Look and AVKit, pinned365aa87982 FilePreview.ios / VideoPreviewModal.ios.
// @ref llp/1109.005-composer-and-transcript.decision.md#media-presentation
shape MediaPreviewSnapshot
  identifier: string
  name: string
  kind: string
  sourceJSON: string
  ready: bool
  error: string
component MediaPreview
  props
    data: MediaPreviewSnapshot
    completed: action
  view
    column width=1 height=1
      when data.ready
        t3-media-presenter media-source=data.sourceJSON change=completed width=1 height=1 aria-hidden=true
