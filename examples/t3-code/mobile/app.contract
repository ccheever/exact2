// @ref llp/1106.003-pairing-and-transport.decision.md#decision
use Connect, ConnectionColors from "./connect.contract"
use EnvironmentDetail, EnvironmentDetailData from "./environment-detail.contract"
use Home, HomeItem, HomeColors from "./home.contract"
use Scanner from "./scanner.contract"
use Environments, EnvironmentRow, GitHubRoutingSettings, GitHubRoutingRow from "./environments.contract"

// @ref llp/1106.002-design-system-parity.spec.md#typography-and-font-assets
font "DM Sans"
  400 = "assets/fonts/DMSans_400Regular.ttf"
  500 = "assets/fonts/DMSans_500Medium.ttf"
  700 = "assets/fonts/DMSans_700Bold.ttf"

routes nav
  home "/"
  connections "/connections"
  connect "/connections/new"
  environments "/settings/environments"
  environmentDetail "/settings/environments/:environmentKey"
  notfound

shape HomeView
  items: list<HomeItem>
  emptyTitle: string
  emptyDetail: string
  loading: bool
  addEnvironment: bool
shape HomePreferences
  loaded: bool
  workingEnabled: bool
  workingExpanded: bool
  snoozedExpanded: bool
  settledExpanded: bool
shape Time
  epochAtZero: number
shape Viewport
  width: number
  height: number
  prefersColorScheme: string
  prefersReducedMotion: bool
shape PairingFields
  source: string
  host: string
  code: string
shape Theme
  screen: string
  sheet: string
  foreground: string
  secondary: string
  secondaryForeground: string
  colors: ConnectionColors
shape Camera
  status: string
shape Notice
  choice: string
shape Snapshot
  nativeAvailable: bool
  revision: number
  ready: bool
  busy: bool
  error: string
  environmentId: string
  environmentLabel: string
  status: string
  projectCount: number
  threadCount: number
  environments: list<EnvironmentRow>
  routing: list<GitHubRoutingRow>
shape Change
  revision: number
  message: string

component App
  resource viewport = exactViewport() as shape Viewport
  resource look = theme(viewport.prefersColorScheme, "t3-code") as shape Theme
  resource data = snapshot(viewport.prefersColorScheme) as shape Snapshot
  resource detail = environmentDetail(params(nav, "environmentKey"), data.revision) as shape EnvironmentDetailData
  mutation detailChanged as shape Change refreshes data, detail
  state targetEnvironment = ""
  state confirmKind = ""
  state confirmKey = ""
  state confirmValue = ""
  mutation detailConfirmation as shape Notice then didConfirmDetail
  resource wallTime = exactTime() as shape Time
  state elapsed = 0
  state homeQuery = ""
  state settledCount = 10
  resource shelves = homePreferences() as shape HomePreferences
  resource homeLook = homeColors(viewport.prefersColorScheme) as shape HomeColors
  resource home = homeView(data.revision, wallTime.epochAtZero + elapsed, homeQuery, settledCount, shelves.loaded, shelves.workingEnabled, shelves.workingExpanded, shelves.snoozedExpanded, shelves.settledExpanded) as shape HomeView
  mutation shelfChanged as shape Change refreshes shelves
  task clock mount
    every(60000, tick)
  action tick
    elapsed = now()
  action toggleHomeShelf(section: string)
    send shelfChanged = toggleShelf(section)
  action showMore
    settledCount = settledCount + 25
  action selectThread(id: string)
    lastOperation = "thread"
    send changed = command("select-thread", id, "", "0")
  state host = ""
  state code = ""
  state formError = ""
  state expanded = ""
  state submitted = false
  state lastOperation = ""
  state scannerOpen = false
  state cameraStatus = "undetermined"
  state pendingRemove = ""
  mutation camera as shape Camera then didRequestCamera
  mutation notice as shape Notice
  mutation removal as shape Notice then didConfirmRemove
  mutation scanned as shape PairingFields then didScan
  resource parsed = pairingFields(host) as shape PairingFields
  mutation changed as shape Change refreshes data then didChange
  task rem mount
    after(1, rootFont)
  action rootFont
    setRootFontSize(14)
  action editHost(value: string)
    host = value
    formError = ""
  action editCode(value: string)
    code = value
    formError = ""
  action connect
    lastOperation = "connect"
    submitted = true
    send changed = command(targetEnvironment == "" ? "environment-add" : "environment-add-route", host, code, targetEnvironment)
  action didChange
    match changed
      case some(result)
        formError = result.message
        if lastOperation == "save" and result.message == ""
          expanded = ""
        if submitted and result.message == ""
          host = ""
          code = ""
          nav = back(nav)
        submitted = false
      case none
        submitted = false
  action follow(url: string)
    nav = go(nav, url)
  action scan
    if scannerOpen
      scannerOpen = false
    else
      send camera = cameraPermission()
  action didRequestCamera
    match camera
      case some(result)
        cameraStatus = result.status
        if result.status == "granted"
          scannerOpen = true
        else
          send notice = alert(result.status == "denied" ? "camera-settings" : "info", "Camera access needed", result.status == "unavailable" ? "Camera capture is unavailable on this device." : result.status == "denied" ? "Camera access was denied for this app. Open Settings to enable it." : "Allow camera access to scan an environment pairing QR code.")
      case none
        cameraStatus = "undetermined"
  action permissionChanged(value: string)
    cameraStatus = value
  action receiveScan(value: string)
    if trim(value) == ""
      send notice = alert("info", "Invalid QR code", "Scanned QR code did not contain a pairing URL.")
    else
      send scanned = pairingFields(value)
  action didScan
    match scanned
      case some(result)
        host = result.host
        code = result.code
        scannerOpen = false
      case none
        scannerOpen = false
  action didConfirmRemove
    match removal
      case some(result)
        if result.choice == "remove"
          send changed = command("forget", pendingRemove, "", "0")
      case none
        pendingRemove = ""
  action openConnections
    nav = push(nav, path("connections"))
  action addEnvironment
    targetEnvironment = ""
    formError = ""
    scannerOpen = false
    nav = push(nav, path("connect"))
  action openEnvironments
    nav = push(nav, path("environments"))
  action back
    nav = back(nav)
  action toggle(id: string)
    if top(nav).name == "environments"
      nav = push(nav, path("environmentDetail", id))
    else
      expanded = expanded == id ? "" : id
  action detailAction(kind: string, key: string, value: string)
    if kind == "route-add"
      targetEnvironment = value
      formError = ""
      nav = push(nav, path("connect"))
    else if kind == "route-remove" or kind == "update-server"
      confirmKind = kind
      confirmKey = key
      confirmValue = value
      if kind == "route-remove"
        match first(filter(detail.routes, route => route.id == value))
          case some(route)
            send detailConfirmation = alert("remove", `Remove ${route.label}?`, route.address)
          case none
            confirmKind = ""
      else
        send detailConfirmation = alert("update", `Update ${detail.title}?`, detail.updateConfirmation)
    else
      send detailChanged = environmentDetailCommand(kind, key, value)
  action didConfirmDetail
    match detailConfirmation
      case some(result)
        if result.choice == "remove" or result.choice == "update"
          send detailChanged = environmentDetailCommand(confirmKind, confirmKey, confirmValue)
      case none
        confirmKind = ""

  action setEnabled(id: string, enabled: bool)
    send changed = command("environment-enabled", id, enabled ? "on" : "off", "0")
  action changeRouting(id: string, permission: string)
    send changed = command("github-routing", id, permission, "0")
  action reconnect(id: string)
    send changed = command("environment-reconnect", id, "", "0")
  action remove(id: string)
    if not pending(removal)
      pendingRemove = id
      let label = match first(filter(data.environments, item => item.id == id)) { case some(item) => item.label, case none => "this environment" }
      send removal = alert("remove", "Remove from this device?", `Forget ${label} and its cached threads on this device. Switch it off instead to keep it saved.`)
  action save(id: string, label: string, url: string)
    lastOperation = "save"
    send changed = command("save-environment", id, label, url)
  view
    main navigationKey=`${top(nav).id}`
      navigationBack="back"
      navigate=follow
      width="100%"
      height="100%"
      background-color=look.screen
      color=look.foreground
      font-family="DM Sans"
      font-size=16
      interactive-widget="resizes-content"
      testId="mobile-root"
      each entry in stack(nav) key = entry.id
        column navigationKey=`${entry.id}`
          data-mobile-form-sheet=(entry.name == "connections" or entry.name == "connect")
          data-mobile-scan-action=(entry.name == "connect" ? "scan-qr" : "")
          data-mobile-scanner-open=scannerOpen
          navigationScroll=(entry.name == "home" ? (length(home.items) > 0 ? "home-list" : "") : `scroll-${entry.id}`)
          navigationPresentation=(entry.name == "connections" or entry.name == "connect" ? "modal" : "")
          position="absolute"
          inset=0
          background-color=look.sheet
          display="flex"
          flex-direction="column"
          header height=44 flex-shrink=0 align-items="center" justify-content="space-between"
            button id="back" press=back aria-label="Back" testId=`back-${entry.name}`
              image "symbol:back" width=20 height=20
            text (entry.name == "connect" ? "Add environment" : entry.name == "home" ? "T3 Code" : entry.name == "environmentDetail" ? detail.title : "Environments")
              role="heading"
              aria-level=2
              font-size=18
              font-weight=800
            when entry.name == "connect"
              button id="scan-qr" press=scan aria-label=(scannerOpen ? "Close scanner" : "Scan QR code") testId="scan-qr"
                text (scannerOpen ? "Close scanner" : "Scan QR code")
            when entry.name == "connections" or entry.name == "environments"
              button press=addEnvironment aria-label="Add environment" testId="add-environment"
                image "symbol:add" width=20 height=20
          when entry.name == "home"
            Home(items=home.items, emptyTitle=home.emptyTitle, emptyDetail=home.emptyDetail, loading=home.loading, addEnvironment=home.addEnvironment, bottomClearance=120, selectThread=selectThread, toggleShelf=toggleHomeShelf, showMore=showMore, addConnection=addEnvironment, colors=homeLook)
            row position="absolute" bottom="env(safe-area-inset-bottom)" left=20 right=20 justify-content="space-between" padding=14 background-color=look.sheet
              button press=openConnections testId="open-connections" aria-label="Environments"
                t3-symbol symbol-name="server.rack" point-size=22 symbol-weight="regular" symbol-tint=look.foreground width=24 height=24
              button press=openEnvironments testId="open-environment-settings" aria-label="Environment settings"
                t3-symbol symbol-name="gearshape" point-size=22 symbol-weight="regular" symbol-tint=look.foreground width=24 height=24
          else
            scroll id=`scroll-${entry.id}` flex=1 min-height=0 keyboardDismissMode="interactive"
              column padding-left=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 17.5 : 20)
                padding-right=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 17.5 : 20)
                padding-top=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 14 : 16)
                padding-bottom=36
                gap=(entry.name == "connections" or entry.name == "environments" ? 0 : 14)
                when entry.name == "connect"
                  when scannerOpen
                    Scanner(permission=cameraStatus, active=scannerOpen, request=scan, received=receiveScan, permissionChanged=permissionChanged, colors=look.colors, secondary=look.secondary, secondaryForeground=look.secondaryForeground)
                  else
                    Connect(host=host, code=code, error=formError, submitting=pending(changed), changeHost=editHost, changeCode=editCode, submit=connect, colors=look.colors)
                when entry.name == "connections" or entry.name == "environments"
                  Environments(
                    items=data.environments,
                    expandedId=expanded,
                    opensDetails=(entry.name == "environments"),
                    toggle=toggle,
                    setEnabled=setEnabled,
                    reconnect=reconnect,
                    remove=remove,
                    save=save,
                    colors=look.colors
                  )
                  GitHubRoutingSettings(
                    items=data.routing,
                    saving=pending(changed),
                    change=changeRouting,
                    colors=look.colors
                  )
                  when formError != ""
                    text formError color=look.colors.dangerForeground testId="environment-error"
                when entry.name == "environmentDetail"
                  match first(filter(data.environments, item => item.id == detail.key))
                    case some(connection)
                      EnvironmentDetail(data=detail, connection=connection, colors=look.colors, dark=viewport.prefersColorScheme == "dark", pending=pending(detailChanged), toggleConnection=toggle, setEnabled=setEnabled, reconnect=reconnect, remove=remove, save=save, action=detailAction)
                    case none
                      text "This environment is no longer saved on this device." color=look.colors.muted padding=17.5
                when entry.name == "notfound"
                  text "Page not found"
