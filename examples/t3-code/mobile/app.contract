use SettingsThreadPreferences, ThreadPreferencesData from "./settings-thread-preferences.contract"
use SettingsProjectOverview, SettingsProjectData from "./settings-project.contract"
use SettingsWrite, StreamingAssistant, StreamingHapticState, AppLink, MediaCompletion, Appearance, SettingsView, SettingsScopeEvent, MobileLayout, HomeChromeView, ChromeEvent, ThreadSelection, HomeView, HomePreferences, Time, Viewport, PairingFields, Theme, Camera, Notice, Snapshot, ScheduledHeader, AutomationChange, VoiceFocus, PreviewOwner, PreviewMenus, InformationRoute, InformationRead, InformationConfiguration, InformationChange, Change from "./app-shapes.contract"
use SettingsNotifications, NotificationsData from "./settings-notifications.contract"
use MobileBrowser, MobileBrowserSnapshot, MobilePreviewColors, MobilePreviewButton from "./browser-mobile.contract"
use MobileDevices, MobileDevicesSnapshot from "./devices-mobile.contract"
use SettingsInformation, InformationData from "./settings-information.contract"
use MobileAttachmentAudio, AttachmentAudioStatus from "./attachment-audio.contract"
use SettingsAutomation, AutomationPrepared, AutomationData, AutomationResult from "./settings-scheduled-flow.contract"
use VoiceGlobalPill, VoiceSnapshot, VoiceStatus, VoiceResult, VoiceColors from "./voice-controls.contract"
use MobileAttachmentDocument, AttachmentDocumentSnapshot, AttachmentDocumentMenu, AttachmentDocumentAction from "./attachment-document.contract"
use MobileTerminal, MobileTerminalCaptureView, MobileTerminalSnapshot, MobileTerminalResult, MobileTerminalEvent, MobileTerminalCapture from "./terminal-mobile.contract"
use ReviewView, ReviewCommentComposer from "./review-view.contract"
use ReviewSnapshot, ReviewResult, ReviewColors from "./review-shapes.contract"
use MobileFileTree, FileTreeSnapshot, FileTreeResult from "./file-tree.contract"
use MobileFileView, FileSnapshot from "./file-view.contract"
use SettingsServer, ServerSettingsData from "./settings-server.contract"
use SettingsProviderAccounts, ProviderSettingsData from "./settings-provider.contract"
use MediaPreview, MediaPreviewSnapshot from "./media-preview.contract"
use ComposerAttachmentStrip from "./composer-attachments.contract"
use ComposerAttachmentsSnapshot from "./composer-attachment-shapes.contract"
use SettingsRoot, SettingsRootData, SettingsHeader, SettingsChoices, SettingsChoicesData, MobilePreferencesResource from "./settings.contract"
use SettingsAppearance, SettingsAppearanceData from "./settings-appearance.contract"
use Archive, ArchiveData, ArchiveColors from "./archive.contract"
use AgentActivity, AgentActivityData, AgentActivityColors from "./agent-activity.contract"
// @ref llp/1106.003-pairing-and-transport.decision.md#decision
use Connect, ConnectionColors from "./connect.contract"
use EnvironmentDetail, EnvironmentDetailData from "./environment-detail.contract"
use HomeChrome from "./home-chrome.contract"
use ThreadFeed, ThreadApprovals from "./thread.contract"
use ComposerSettings, ComposerChoices from "./composer-settings.contract"
use NewTaskFlowSnapshot, NewTaskFlowResult from "./new-task-flow.contract"
use NewTaskProjects, NewTaskEnvironments, NewTaskBranches, NewTaskHero, NewTaskWorkspace from "./new-task.contract"
use ComposerSettingsSnapshot, ComposerActionResult, ComposerColors, NewTaskSnapshot, NewTaskResult, NewTaskPreparation from "./composer-shapes.contract"
use ThreadComposer from "./thread-composer.contract"
use ThreadSnapshot, ThreadColors from "./thread-shapes.contract"
use Home, HomeItem, HomeColors from "./home.contract"
use Scanner from "./scanner.contract"
use Environments, EnvironmentRow, GitHubRoutingSettings, GitHubRoutingRow from "./environments.contract"

// @ref llp/1106.002-design-system-parity.spec.md#typography-and-font-assets
font "DM Sans"
  400 = "assets/fonts/DMSans_400Regular.ttf"
  500 = "assets/fonts/DMSans_500Medium.ttf"
  700 = "assets/fonts/DMSans_700Bold.ttf"

routes nav
  home "/"
    thread "/threads/:threadEnvironment/:threadId"
    threadBrowser "/threads/:threadEnvironment/:threadId/browser"
    threadDevices "/threads/:threadEnvironment/:threadId/devices"
    threadTerminal "/threads/:threadEnvironment/:threadId/terminal"
    threadTerminalCapture "/threads/:threadEnvironment/:threadId/terminal/output"
    threadReview "/threads/:threadEnvironment/:threadId/review"
    threadReviewComment "/threads/:threadEnvironment/:threadId/review/comment"
    threadFiles "/threads/:threadEnvironment/:threadId/files"
    threadFile "/threads/:threadEnvironment/:threadId/files/:filePath"
    threadMedia "/threads/:threadEnvironment/:threadId/attachments/:attachmentId"
    threadDraftMedia "/threads/:threadEnvironment/:threadId/draft-attachments/:attachmentId"
    threadModel "/threads/:threadEnvironment/:threadId/model"
    threadModelOption "/threads/:threadEnvironment/:threadId/model/options/:modelOption"
    threadRuntime "/threads/:threadEnvironment/:threadId/model/runtime"
    threadModelFilter "/threads/:threadEnvironment/:threadId/model/providers"
    threadAgents "/threads/:threadEnvironment/:threadId/agents"
    settings "/settings"
    settingsAuth "/settings/auth"
    settingsWaitlist "/settings/waitlist"
    settingsNotifications "/settings/notifications"
    settingsThreads "/settings/thread-preferences"
    settingsProjectOverview "/settings/project"
    connectOnboarding "/connect-onboarding"
    archive "/settings/archive"
    settingsServer "/settings/server/:serverPage"
    settingsProviders "/settings/provider-accounts"
    settingsAppearance "/settings/appearance"
    settingsChoice "/settings/preferences/:settingsChoice"
    settingsScheduledTasks "/settings/scheduled"
    settingsScheduledNew "/settings/scheduled/new"
    settingsScheduledEdit "/settings/scheduled/edit"
    settingsScheduledModel "/settings/scheduled/model"
    settingsScheduledBranch "/settings/scheduled/branch"
    settingsAbout "/settings/about"
    settingsClientStorage "/settings/client-storage"
    settingsDiagnostics "/settings/diagnostics"
    settingsOpenSourceLicenses "/settings/open-source-licenses"
    settingsOpenSourceLicense "/settings/open-source-licenses/:entryKey"
    settingsLegal "/settings/legal"
    settingsUsage "/settings/usage"
    settingsUsageAccount "/settings/usage/account/:usageAccount/:usageWindow/:usageKind"
    newTask "/new"
      newTaskDraft "/new/draft"
        newTaskEnvironments "/new/draft/environment"
        newTaskBranches "/new/draft/branch"
        newTaskMedia "/new/draft/attachments/:attachmentId"
        newTaskModel "/new/draft/settings"
          newTaskModelOption "/new/draft/settings/options/:modelOption"
          newTaskRuntime "/new/draft/settings/runtime"
          newTaskModelFilter "/new/draft/settings/providers"
    connections "/connections"
    connect "/connections/new"
    environments "/settings/environments"
    environmentDetail "/settings/environments/:environmentKey"
    notfound

shape AccountEntry
  kind: string
  route: string
  requestRoute: string
component App
  resource accountEntry = accountEntry(top(nav).name, depth(nav) > 1, `${top(nav).id}`) as shape AccountEntry
  resource notificationSettings = notificationSettings() as shape NotificationsData
  task enterAccount when accountEntry.kind != "" key=top(nav).id
    after(1, redirectAccount)
  action redirectAccount
    if accountEntry.requestRoute == `${top(nav).id}`
      if accountEntry.kind == "back"
        nav = back(nav)
      else if accountEntry.route == "settings"
        nav = replace(nav, path("settings"))
      else
        nav = open(nav, path("home"))
  resource viewport = exactViewport() as shape Viewport
  resource voiceFocus = voiceFocus((top(nav).name == "thread" and workspaceRouteReady) or (top(nav).name == "newTaskDraft" and newTaskFlow.ready), top(nav).name == "thread" ? threadData.title : "New task", data.revision, taskGuardOwner, taskGuardRoute) as shape VoiceFocus
  resource voiceStatus = voiceStatus(data.revision) as shape VoiceStatus
  resource voiceData = voiceSnapshot(voiceFocus.owner, max(30, viewport.width - 150), voiceStatus, data.revision, pending(voiceChanged)) as shape VoiceSnapshot
  resource voiceLook = voiceColors(appearance.scheme, appearance.themeId) as shape VoiceColors
  state voicePillExpanded = false
  mutation voiceChanged as shape VoiceResult refreshes data, voiceStatus, voiceData then didVoiceChange
  mutation voiceCancelled as shape VoiceResult refreshes data, voiceStatus, voiceData then didVoiceCancel
  mutation voiceReconciled as shape VoiceResult refreshes data, voiceStatus, voiceData
  task voiceEvent when (voiceStatus.eventKind == "finished" or voiceStatus.eventKind == "interrupted" or voiceStatus.eventKind == "background") and not pending(voiceChanged) and not pending(voiceCancelled) key=`${voiceStatus.session}:${voiceStatus.event}`
    reconcileVoice
  action reconcileVoice
    send voiceReconciled = voiceAction("reconcile", voiceFocus.label, voiceFocus.owner, taskGuardOwner, taskGuardRoute)
  action voiceAction(op: string)
    if op == "cancel"
      send voiceCancelled = voiceAction(op, voiceFocus.label, voiceFocus.owner, taskGuardOwner, taskGuardRoute)
    else if not pending(voiceChanged)
      send voiceChanged = voiceAction(op, voiceFocus.label, voiceFocus.owner, taskGuardOwner, taskGuardRoute)
  action didVoiceChange
    match voiceChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Voice input", result.message)
      case none
        voicePillExpanded = voicePillExpanded
  action didVoiceCancel
    match voiceCancelled
      case some(result)
        if result.message != ""
          send notice = alert("info", "Voice input", result.message)
      case none
        voicePillExpanded = voicePillExpanded
  action expandVoicePill(value: bool)
    voicePillExpanded = value
  resource preferences = preferences() as shape MobilePreferencesResource
  resource appearance = appearance(preferences.serialized, viewport.prefersColorScheme) as shape Appearance
  resource look = theme(appearance.scheme, appearance.themeId) as shape Theme
  resource data = snapshot(appearance.scheme, appearance.themeId) as shape Snapshot
  resource detail = environmentDetail(top(nav).params.environmentKey, data.revision) as shape EnvironmentDetailData
  mutation detailChanged as shape Change refreshes data, detail
  state informationQuery = ""
  resource informationRoute = informationRoute(top(nav).name) as shape InformationRoute
  resource informationRead = informationPrepare(top(nav).name, data.ready) as shape InformationRead
  resource informationData = informationSnapshot(informationQuery, top(nav).params.entryKey, informationRead) as shape InformationData
  resource informationLegal = informationLegal(`${top(nav).id}`, "legal-close", settingsData.root.colors) as shape InformationConfiguration
  mutation informationChanged as shape InformationChange then didInformationChange
  action informationCommand(op: string, value: string)
    send informationChanged = informationCommand(op, value, `${top(nav).id}`)
  action didInformationChange
    match informationChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.message != ""
          send notice = alert("info", "Settings", result.message)
      case none
        informationQuery = informationQuery
  action informationSearch(value: string)
    informationQuery = value
  action openInformation(target: string, key: string)
    if target == "settingsAbout"
      nav = push(nav, path("settingsAbout"))
    else if target == "settingsClientStorage"
      nav = push(nav, path("settingsClientStorage"))
    else if target == "settingsDiagnostics"
      nav = push(nav, path("settingsDiagnostics"))
    else if target == "settingsOpenSourceLicenses"
      informationQuery = ""
      nav = push(nav, path("settingsOpenSourceLicenses"))
    else if target == "settingsOpenSourceLicense"
      nav = push(nav, path("settingsOpenSourceLicense", key))
    else if target == "settingsLegal"
      nav = push(nav, path("settingsLegal"))
  state settingsSelection = ""
  derive settingsRouteKey = match first(filter(stack(nav), route => route.name == "settings")) { case some(route) => `${route.id}`, case none => "settings" }
  resource settingsData = settingsRoot(preferences.serialized, viewport.prefersColorScheme, data.environments, layout.safeBottom, settingsRouteKey, settingsSelection, data.revision) as shape SettingsView
  resource settingsAppearance = settingsAppearance(preferences.serialized, viewport.prefersColorScheme, preferences.ready, layout.safeBottom) as shape SettingsAppearanceData
  resource settingsChoice = settingsChoices(top(nav).params.settingsChoice, preferences.serialized, preferences.ready) as shape SettingsChoicesData
  resource threadPreferences = threadPreferences(top(nav).name == "settingsThreads", settingsData.serverScope, preferences.serialized, preferences.ready, data.revision) as shape ThreadPreferencesData
  resource projectOverview = projectOverview(top(nav).name == "settingsProjectOverview", settingsData.serverScope, data.revision) as shape SettingsProjectData
  state projectSavedRevision = 0
  mutation threadPreferencesChanged as shape SettingsWrite refreshes threadPreferences, data then didScopedSettingChange
  mutation projectRenamed as shape SettingsWrite refreshes projectOverview, data then didProjectRename
  action threadPreferenceChange(scope: string, key: string, value: string)
    if scope == settingsData.serverScope
      send threadPreferencesChanged = threadPreferencesChange(scope, key, value, `${top(nav).id}`)
  action renameProject(scope: string, identity: string, name: string)
    send projectRenamed = projectRename(scope, identity, name, `${top(nav).id}`)
  action didScopedSettingChange
    match threadPreferencesChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.message != ""
          send notice = alert("info", "Could not save setting", result.message)
      case none
        projectSavedRevision = projectSavedRevision
  action didProjectRename
    match projectRenamed
      case some(result)
        if result.requestRoute == `${top(nav).id}`
          if result.message != ""
            send notice = alert("info", "Could not rename project", result.message)
          else if result.saved
            projectSavedRevision = projectSavedRevision + 1
      case none
        projectSavedRevision = projectSavedRevision
  resource serverSettings = serverSettings(top(nav).params.serverPage, settingsData.serverScope, top(nav).name == "settingsServer", data.revision) as shape ServerSettingsData
  resource providerPrepared = providerAccounts(settingsData.environmentIds, top(nav).name == "settingsProviders", data.revision) as shape ProviderSettingsData
  resource providerAccounts = providerSnapshot(settingsData.environmentIds, top(nav).name == "settingsProviders", providerPrepared) as shape ProviderSettingsData
  mutation serverSettingChanged as shape Change refreshes serverSettings, data then didServerSettingChange
  mutation providerChanged as shape Change refreshes providerPrepared, providerAccounts then didProviderChange
  mutation providerFieldChanged as shape Change refreshes providerAccounts
  state automationRefresh = 0
  state automationElapsed = 0
  derive automationNow = wallTime.epochAtZero + max(elapsed, automationElapsed)
  resource automationPrepared = automationPrepare(top(nav).name, settingsData.serverScope, top(nav).params.usageAccount, top(nav).params.usageWindow, top(nav).params.usageKind, automationNow, data.revision, automationRefresh) as shape AutomationPrepared
  resource automationData = automationSnapshot(automationPrepared, pending(automationChanged)) as shape AutomationData
  resource scheduledHeader = scheduledHeader(preferences.serialized, data.environments, `${top(nav).id}`, settingsSelection, automationData.scheduled.canCreate) as shape ScheduledHeader
  mutation automationChanged as shape AutomationChange refreshes automationData then didAutomationChange
  mutation automationEdited as shape AutomationChange refreshes automationData then didAutomationEdit
  mutation automationBranchRead as shape AutomationChange refreshes automationData then didAutomationBranchRead
  task automationClock when top(nav).name == "settingsScheduledTasks"
    every(60000, tickAutomation)
  action tickAutomation
    automationElapsed = now()
  action automationAction(op: string, id: string, value: string, extra: string)
    if op == "field" or op == "branch-query" or op == "usage-local" or op == "usage-reveal"
      send automationEdited = automationCommand(op, id, value, extra, wallTime.epochAtZero + now(), `${top(nav).id}`)
    else if op == "branch-fetch" or op == "branch-more"
      if top(nav).name == "settingsScheduledBranch"
        send automationBranchRead = automationCommand(op, id, value, extra, wallTime.epochAtZero + now(), `${top(nav).id}`)
    else if not pending(automationChanged)
      send automationChanged = automationCommand(op, id, value, extra, wallTime.epochAtZero + now(), `${top(nav).id}`)
  action automationBranchFetch
    automationAction("branch-fetch", "", "", "")
  action didAutomationBranchRead
    match automationBranchRead
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.message != ""
          send notice = alert("info", "Branches", result.message)
      case none
        automationRefresh = automationRefresh
  action didAutomationEdit
    match automationEdited
      case some(result)
        if result.requestRoute == `${top(nav).id}`
          if result.message != ""
            send notice = alert("info", "T3 Code", result.message)
          if result.refresh
            automationRefresh = automationRefresh + 1
          if result.debounce
            after(150, automationBranchFetch)
      case none
        automationRefresh = automationRefresh
  action didAutomationChange
    match automationChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}`
          if result.message != ""
            send notice = alert("info", "T3 Code", result.message)
          if result.refresh
            automationRefresh = automationRefresh + 1
          if result.closed
            nav = back(nav)
          else if result.route == "settingsScheduledNew"
            nav = push(nav, path("settingsScheduledNew"))
          else if result.route == "settingsScheduledEdit"
            nav = push(nav, path("settingsScheduledEdit"))
          else if result.route == "settingsScheduledModel"
            nav = push(nav, path("settingsScheduledModel"))
          else if result.route == "settingsScheduledBranch"
            nav = push(nav, path("settingsScheduledBranch"))
          else if result.route == "settingsUsageAccount"
            nav = push(nav, path("settingsUsageAccount", result.accountKey, result.windowId, result.windowKind))
      case none
        automationRefresh = automationRefresh
  state providerLogoutKey = ""
  mutation providerLogoutConfirmation as shape Notice then didConfirmProviderLogout
  action serverSettingChange(key: string, value: string)
    send serverSettingChanged = serverSettingChange(top(nav).params.serverPage, settingsData.serverScope, key, value)
  action didServerSettingChange
    match serverSettingChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Could not save setting", result.message)
      case none
        settingsSelection = settingsSelection
  action providerAction(op: string, key: string, value: string)
    if op == "reveal" or op == "choose-cancel"
      send providerFieldChanged = providerAction(op, key, value)
    else
      send providerChanged = providerAction(op, key, value)
  action providerField(key: string, name: string, value: string)
    send providerFieldChanged = providerField(key, name, value)
  action didProviderChange
    match providerChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Provider account", result.message)
      case none
        settingsSelection = settingsSelection
  action providerSignOut(key: string, title: string, message: string)
    providerLogoutKey = key
    send providerLogoutConfirmation = alert("sign-out", title, message)
  action didConfirmProviderLogout
    match providerLogoutConfirmation
      case some(result)
        if result.choice == "sign-out"
          providerAction("logout-confirmed", providerLogoutKey, "")
      case none
        providerLogoutKey = ""
  action settingsEnvironment(key: string)
    nav = push(nav, path("environmentDetail", key))
  mutation preferenceChanged as shape Change refreshes preferences, shelves, data then didPreferenceChange
  mutation appearanceApplied as shape Change
  mutation settingsEvent as shape SettingsScopeEvent then didSettingsEvent
  task applyTheme when preferences.ready key=appearance.themeMode
    after(1, applyTheme)
  action applyTheme
    send appearanceApplied = applyAppearance(preferences.serialized)
  action changePreference(key: string, value: string)
    send preferenceChanged = preferenceChange(key, value)
  action didPreferenceChange
    match preferenceChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Could not save preference", result.message)
      case none
        settingsSelection = settingsSelection
  action settingsHeaderEvent(value: string)
    send settingsEvent = settingsScopeEvent(value, preferences.serialized, settingsSelection, data.environments)
  action didSettingsEvent
    match settingsEvent
      case some(event)
        settingsSelection = event.selection
        if event.close
          nav = back(nav)
      case none
        settingsSelection = settingsSelection
  action openSetting(target: string)
    if target == "SettingsAbout"
      openInformation("settingsAbout", "")
    else if target == "SettingsEnvironments"
      openEnvironments()
    else if target == "SettingsThreads"
      nav = push(nav, path("settingsThreads"))
    else if target == "SettingsProjectOverview"
      nav = push(nav, path("settingsProjectOverview"))
    else if target == "SettingsAppearance"
      nav = push(nav, path("settingsAppearance"))
    else if target == "SettingsScheduledTasks"
      nav = push(nav, path("settingsScheduledTasks"))
    else if target == "SettingsUsage"
      nav = push(nav, path("settingsUsage"))
    else if target == "SettingsProviderAccounts"
      nav = push(nav, path("settingsProviders"))
    else if target == "SettingsEnvironmentNewThreads" or target == "SettingsEnvironmentSourceControl" or target == "SettingsEnvironmentAgentBehavior" or target == "SettingsEnvironmentMaintenance"
      nav = push(nav, path("settingsServer", target))
    else if target == "SettingsArchive"
      nav = push(nav, path("archive"))
    else if target == "SettingsKeyboard" or target == "SettingsFollowUp" or target == "SettingsOrganization" or target == "SettingsProjectGrouping"
      nav = push(nav, path("settingsChoice", target))
  state targetEnvironment = ""
  state confirmKind = ""
  state confirmKey = ""
  state confirmValue = ""
  mutation detailConfirmation as shape Notice then didConfirmDetail
  resource wallTime = exactTime() as shape Time
  state elapsed = 0
  state layoutJSON = ""
  resource layout = layoutFacts(layoutJSON) as shape MobileLayout
  action layoutChanged(value: string)
    layoutJSON = value
  state homeQuery = ""
  state homeEnvironment = ""
  state homeProject = ""
  derive homeRouteKey = match first(filter(stack(nav), route => route.name == "home")) { case some(route) => `${route.id}`, case none => "home" }
  resource chrome = homeChrome(homeRouteKey, homeQuery, homeEnvironment, homeProject, appearance.scheme, layout.safeBottom, layout.liquidGlass, data.revision, data.environments, appearance.groupingMode) as shape HomeChromeView
  mutation chromeEvent as shape ChromeEvent then didChromeEvent
  mutation searchChanged as shape Change refreshes data
  task searchDebounce key=homeQuery
    after(250, searchHome)
  action searchHome
    send searchChanged = command("search", "", homeQuery, "0", taskGuardOwner, taskGuardRoute)
  action homeEvent(value: string)
    send chromeEvent = homeChromeEvent(value)
  action didChromeEvent
    match chromeEvent
      case some(event)
        if event.kind == "search"
          homeQuery = event.value
          settledCount = 10
        else if event.kind == "environment"
          homeEnvironment = event.value
          homeProject = ""
          settledCount = 10
        else if event.kind == "project"
          homeProject = event.value
          settledCount = 10
        else if event.kind == "settings"
          nav = push(nav, path("settings"))
        else if event.kind == "environments"
          openEnvironments()
        else if event.kind == "compose"
          nav = push(nav, path("newTask"))
      case none
        homeQuery = homeQuery
  state composerFocused = false
  derive composerExpanded = composerFocused or top(nav).name == "threadModel" or top(nav).name == "newTaskModel"
  // Source streaming feedback follows descriptor changes, never a repeating clock task.
  derive hapticEntry = at(filter(stack(nav), entry => entry.name == "thread"), -1)
  derive hapticRoute = match hapticEntry { case some(entry) => `${entry.id}`, case none => "" }
  derive hapticEnvironment = match hapticEntry { case some(entry) => entry.params.threadEnvironment, case none => "" }
  derive hapticThread = match hapticEntry { case some(entry) => entry.params.threadId, case none => "" }
  resource hapticFeed = streamingAssistant(data.revision, hapticRoute, hapticEnvironment, hapticThread) as shape StreamingAssistant
  state streamHaptics = slice([StreamingHapticState(routeId="", owner="", id="", textLength=0, lastAt=0)], 0, 0)
  task streamFeedback when hapticFeed.owner != "" key=hapticFeed.key
    after(1, updateStreamFeedback)
  task pruneStreamFeedback when true key=join(map(stack(nav), entry => `${entry.id}`), "|")
    after(1, pruneStreamOwners)
  action pruneStreamOwners
    streamHaptics = filter(streamHaptics, item => includes(map(stack(nav), entry => `${entry.id}`), item.routeId))
  action updateStreamFeedback
    if hapticFeed.routeId == hapticRoute and hapticFeed.environmentId == hapticEnvironment and hapticFeed.threadId == hapticThread and hapticEnvironment == data.environmentId and hapticThread == data.threadId
      let time = wallTime.epochAtZero + now()
      match first(filter(streamHaptics, item => item.routeId == hapticFeed.routeId))
        case some(previous)
          let pulse = previous.owner == hapticFeed.owner and hapticFeed.id != "" and (previous.id != hapticFeed.id or (hapticFeed.textLength > previous.textLength and time - previous.lastAt >= 320))
          streamHaptics = concat(filter(streamHaptics, item => item.routeId != hapticFeed.routeId), [StreamingHapticState(routeId=hapticFeed.routeId, owner=hapticFeed.owner, id=hapticFeed.id, textLength=hapticFeed.textLength, lastAt=(pulse ? time : previous.lastAt))])
          if pulse
            haptic("selection")
        case none
          streamHaptics = concat(streamHaptics, [StreamingHapticState(routeId=hapticFeed.routeId, owner=hapticFeed.owner, id=hapticFeed.id, textLength=hapticFeed.textLength, lastAt=0)])
  resource threadLook = threadColors(appearance.scheme, appearance.themeId) as shape ThreadColors
  resource threadData = threadView(data.revision, wallTime.epochAtZero + elapsed, appearance.scheme, top(nav).params.threadEnvironment, top(nav).params.threadId, startsWith(top(nav).name, "thread")) as shape ThreadSnapshot
  mutation selected as shape ThreadSelection refreshes data then didSelectThread
  mutation draftChanged as shape Change refreshes data
  task selectRouteThread when startsWith(top(nav).name, "thread") and data.ready and (top(nav).params.threadEnvironment != data.environmentId or top(nav).params.threadId != data.threadId) key=top(nav).url
    after(1, loadRouteThread)
  action loadRouteThread
    send selected = selectThread(top(nav).params.threadEnvironment == data.environmentId ? top(nav).params.threadId : `fleet:${top(nav).params.threadEnvironment}:${top(nav).params.threadId}`, `${top(nav).id}`)
  action didSelectThread
    match selected
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.message != ""
          send notice = alert("info", "Could not open thread", result.message)
        else if result.requestRoute == `${top(nav).id}` and result.threadId != "" and (top(nav).params.threadEnvironment != result.environmentId or top(nav).params.threadId != result.threadId)
          nav = push(nav, path("thread", result.environmentId, result.threadId))
      case none
        composerFocused = false
  action editDraft(value: string)
    if top(nav).params.threadEnvironment == data.environmentId and top(nav).params.threadId == data.threadId
      send draftChanged = command("draft", "", value, "0", taskGuardOwner, taskGuardRoute)
  action composerFocus(value: bool)
    composerFocused = value
  action threadAction(op: string, id: string, value: string)
    if top(nav).params.threadEnvironment == data.environmentId and top(nav).params.threadId == data.threadId
      lastOperation = "thread-action"
      send changed = command(op, id, value, `${wallTime.epochAtZero + now()}`, taskGuardOwner, taskGuardRoute)
  derive workspaceRouteReady = data.ready and top(nav).params.threadEnvironment == data.environmentId and top(nav).params.threadId == data.threadId
  resource previewOwner = previewOwner(workspaceRouteReady and startsWith(top(nav).name, "thread"), data.revision) as shape PreviewOwner
  resource previewPrepared = previewPrepare(previewOwner.owner) as shape InformationRead
  resource previewLook = previewColors(appearance.scheme, appearance.themeId) as shape MobilePreviewColors
  resource browserData = previewStatus("browser", previewOwner.owner, top(nav).name == "threadBrowser", previewPrepared, data.revision) as shape MobileBrowserSnapshot
  resource devicesData = previewStatus("devices", previewOwner.owner, top(nav).name == "threadDevices", previewPrepared, data.revision) as shape MobileDevicesSnapshot
  resource browserMenus = previewMenus("browser", browserData) as shape PreviewMenus
  resource devicesMenus = previewMenus("devices", devicesData) as shape PreviewMenus
  mutation previewChanged as shape InformationChange refreshes browserData, devicesData, data then didPreviewChange
  action browserAction(op: string, value: string)
    if not pending(previewChanged)
      send previewChanged = previewAction("browser", previewOwner.owner, op, value, `${top(nav).id}`)
  action devicesAction(op: string, value: string)
    if not pending(previewChanged)
      send previewChanged = previewAction("devices", previewOwner.owner, op, value, `${top(nav).id}`)
  action browserMenu(value: string)
    if not pending(previewChanged)
      send previewChanged = previewMenuAction("browser", value, previewOwner.owner, `${top(nav).id}`)
  action devicesMenu(value: string)
    if not pending(previewChanged)
      send previewChanged = previewMenuAction("devices", value, previewOwner.owner, `${top(nav).id}`)
  action didPreviewChange
    match previewChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.message != ""
          send notice = alert("info", "Preview", result.message)
      case none
        terminalId = terminalId
  task refreshBrowser when browserData.needsRefresh and previewOwner.owner != "" and not pending(previewChanged) key=previewOwner.owner
    browserAction("refresh", "")
  task refreshDevices when devicesData.needsRefresh and previewOwner.owner != "" and not pending(previewChanged) key=previewOwner.owner
    devicesAction("refresh", "")
  task closeEmptyPreview when (top(nav).name == "threadBrowser" and browserData.close) or (top(nav).name == "threadDevices" and devicesData.close) key=top(nav).id
    back
  action openBrowser
    if workspaceRouteReady
      nav = push(nav, path("threadBrowser", data.environmentId, data.threadId))
  action openDevices
    if workspaceRouteReady
      nav = push(nav, path("threadDevices", data.environmentId, data.threadId))
  state terminalId = ""
  state terminalCaptureText = ""
  state terminalCaptureKey = ""
  state terminalRangeStart = 0
  state terminalRangeEnd = -1
  state terminalAnchor = -1
  resource terminalData = terminalView(terminalId, appearance.scheme, appearance.themeId, appearance.terminalFontSize, wallTime.epochAtZero + elapsed, (top(nav).name == "threadTerminal" or top(nav).name == "threadTerminalCapture") and workspaceRouteReady, data.revision) as shape MobileTerminalSnapshot
  resource terminalCapture = terminalCapture(terminalCaptureText, terminalRangeStart, terminalRangeEnd) as shape MobileTerminalCapture
  mutation terminalChanged as shape MobileTerminalResult refreshes terminalData, data then didTerminalChange
  mutation terminalEvent as shape MobileTerminalEvent then didTerminalEvent
  mutation terminalAttached as shape Change refreshes data then didTerminalAttach
  action openTerminal
    terminalId = ""
    nav = push(nav, path("threadTerminal", data.environmentId, data.threadId))
  action terminalAction(op: string, value: string)
    if workspaceRouteReady
      send terminalChanged = terminalAction(op, terminalData.terminalId, value)
  action terminalMenu
    if workspaceRouteReady and terminalData.ready
      send terminalChanged = terminalMenu(terminalData.terminalId, terminalData.tabs, terminalData.readOnly, appearance.terminalFontSize)
  action didTerminalChange
    match terminalChanged
      case some(result)
        if result.environmentId == data.environmentId and result.threadId == data.threadId and top(nav).name == "threadTerminal"
          if result.message != ""
            send notice = alert("info", "Terminal", result.message)
          else if result.choice == "font-decrease"
            changePreference("terminalFontSize", `${max(6, appearance.terminalFontSize - 0.5)}`)
          else if result.choice == "font-increase"
            changePreference("terminalFontSize", `${min(14, appearance.terminalFontSize + 0.5)}`)
          else if result.choice == "new"
            terminalAction("new", "")
          else if result.choice == "select"
            terminalId = result.terminalId
          else if result.closed
            nav = back(nav)
          else
            terminalId = result.terminalId
      case none
        terminalId = terminalId
  action terminalEvent(value: string)
    send terminalEvent = terminalEvent(value, terminalData.sessionKey)
  action didTerminalEvent
    match terminalEvent
      case some(result)
        if top(nav).name == "threadTerminal" and result.key == terminalData.sessionKey
          if result.type == "capture"
            terminalCaptureText = result.text
            terminalCaptureKey = result.key
            terminalRangeStart = 0
            terminalRangeEnd = -1
            terminalAnchor = -1
            nav = push(nav, path("threadTerminalCapture", data.environmentId, data.threadId))
          else if result.message != ""
            send notice = alert("info", "Terminal", result.message)
          else if result.type == "action"
            terminalAction(result.action, "")
      case none
        terminalId = terminalId
  action selectTerminalLine(index: number)
    if terminalAnchor < 0
      terminalAnchor = index
      terminalRangeStart = index
      terminalRangeEnd = index
    else
      terminalRangeStart = min(terminalAnchor, index)
      terminalRangeEnd = max(terminalAnchor, index)
      terminalAnchor = -1
  action attachTerminalOutput
    send terminalAttached = terminalAttach(terminalCaptureKey, terminalCaptureText, terminalRangeStart, terminalRangeEnd, wallTime.epochAtZero + now())
  action didTerminalAttach
    match terminalAttached
      case some(result)
        if result.message != ""
          send notice = alert("info", "Could not attach output", result.message)
        else if top(nav).name == "threadTerminalCapture"
          terminalCaptureText = ""
          terminalCaptureKey = ""
          nav = back(back(nav))
      case none
        terminalCaptureText = terminalCaptureText
  resource reviewLook = reviewColors(appearance.scheme, appearance.themeId) as shape ReviewColors
  resource reviewData = reviewSnapshot(appearance.scheme, top(nav).name == "threadReview" or top(nav).name == "threadReviewComment", data.revision) as shape ReviewSnapshot
  mutation reviewPrepared as shape ReviewSnapshot refreshes reviewData
  mutation reviewChanged as shape ReviewResult refreshes reviewData, data then didReviewChange
  state reviewWrap = false
  state reviewComment = ""
  state reviewCommentOwner = ""
  mutation reviewDismissed as shape ReviewResult refreshes reviewData
  task dismissReviewComment when reviewCommentOwner != "" and top(nav).name != "threadReviewComment" key=reviewCommentOwner
    after(1, dismissReviewComment)
  action dismissReviewComment
    send reviewDismissed = reviewAction(reviewCommentOwner, "cancel", "", "", 0, appearance.scheme)
    reviewCommentOwner = ""
  task prepareReview when top(nav).name == "threadReview" and workspaceRouteReady key=`${top(nav).id}:${reviewData.owner}`
    after(1, prepareReview)
  action prepareReview
    send reviewPrepared = reviewPrepare("", appearance.scheme)
  action openReview
    nav = push(nav, path("threadReview", data.environmentId, data.threadId))
  action reviewAction(op: string, path: string, n: number)
    if workspaceRouteReady
      send reviewChanged = reviewAction(reviewData.owner, op, path, "", n, appearance.scheme)
  action reviewSection(value: string)
    reviewAction("section", value, 0)
  action reviewFile(value: string)
    if value != ""
      reviewAction("file", value, 0)
      scrollIntoView("review-diff", `file:${value}`, block="start")
  action refreshReview
    reviewAction("refresh", "", 0)
  action loadReviewFiles
    match first(filter(reviewData.files, file => file.pending))
      case some(file)
        reviewAction("visible", file.path, 0)
      case none
        reviewWrap = reviewWrap
  action didReviewChange
    match reviewChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Review changes", result.message)
        else if workspaceRouteReady and result.data.owner == reviewData.owner
          if result.data.commentOpen and top(nav).name == "threadReview"
            reviewComment = ""
            reviewCommentOwner = result.data.owner
            nav = push(nav, path("threadReviewComment", data.environmentId, data.threadId))
          else if not result.data.commentOpen and top(nav).name == "threadReviewComment"
            nav = back(nav)
      case none
        reviewComment = reviewComment
  action editReviewComment(value: string)
    reviewComment = value
  action submitReviewComment
    if workspaceRouteReady
      send reviewChanged = reviewAction(reviewCommentOwner, "save", "", reviewComment, 0, appearance.scheme)
  action toggleReviewWrap
    reviewWrap = not reviewWrap
  state filesQuery = ""
  state selectedFile = ""
  state fileWrap = false
  state filePreview = true
  resource filesData = filesSnapshot(selectedFile, data.revision) as shape FileTreeSnapshot
  resource fileData = fileSnapshot(top(nav).params.filePath, appearance.scheme, 0, data.revision) as shape FileSnapshot
  mutation filesPrepared as shape FileTreeSnapshot refreshes filesData
  mutation filesChanged as shape FileTreeResult refreshes filesData then didFilesChange
  mutation filePrepared as shape FileSnapshot refreshes fileData
  task prepareFiles when top(nav).name == "threadFiles" and workspaceRouteReady key=`${top(nav).id}:${filesData.owner}:${filesQuery}`
    after(200, prepareFiles)
  task prepareFile when top(nav).name == "threadFile" and workspaceRouteReady key=`${top(nav).id}:${fileData.owner}`
    after(1, prepareFile)
  action prepareFiles
    send filesPrepared = filesPrepare(filesQuery, selectedFile)
  action prepareFile
    send filePrepared = filePrepare(top(nav).params.filePath, appearance.scheme, 0, false)
  action openFiles
    filesQuery = ""
    nav = push(nav, path("threadFiles", data.environmentId, data.threadId))
  action editFilesQuery(value: string)
    filesQuery = value
  action toggleDirectory(path: string)
    send filesChanged = filesAction(filesData.owner, "toggle", path, selectedFile)
  action refreshFiles
    send filesChanged = filesAction(filesData.owner, "refresh", "", selectedFile)
  action didFilesChange
    match filesChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Files", result.message)
      case none
        selectedFile = selectedFile
  action openFile(path: string)
    selectedFile = path
    nav = push(nav, path("threadFile", data.environmentId, data.threadId, path))
  action refreshFile
    send filePrepared = filePrepare(top(nav).params.filePath, appearance.scheme, 0, true)
  action toggleFileWrap
    fileWrap = not fileWrap
  action toggleFilePreview
    filePreview = not filePreview
  derive mediaActive = top(nav).name == "threadMedia" or top(nav).name == "threadDraftMedia" or top(nav).name == "newTaskMedia"
  derive mediaScope = top(nav).name == "threadMedia" ? "transcript" : "composer"
  state mediaReadAt = 0
  state mediaReadVersion = 0
  state mediaRendered = true
  state mediaNativeOpen = false
  state audioRaw = ""
  resource audioData = audioStatus(audioRaw, documentData.identifier) as shape AttachmentAudioStatus
  mutation audioChanged as shape Change then didAudioChange
  action didAudioChange
    match audioChanged
      case some(result)
        if result.message != ""
          send notice = alert("info", "Audio", result.message)
      case none
        audioRaw = audioRaw
  action audioStatusChanged(value: string)
    audioRaw = value
  action audioControl(value: string)
    send audioChanged = audioAction(documentData.identifier, value)
  state mediaNativeError = ""
  state mediaNativeSource = ""
  resource mediaViewerData = attachmentNativePreview(mediaNativeSource) as shape MediaPreviewSnapshot
  derive mediaRouteKey = `${top(nav).id}:${mediaReadVersion}`
  resource documentData = attachmentDocument(mediaScope, top(nav).params.attachmentId, mediaRouteKey, mediaRendered, appearance.scheme, mediaActive and mediaData.kind == "file", mediaData.identifier, mediaReadAt > 0 ? mediaReadAt : wallTime.epochAtZero, taskGuardOwner, taskGuardRoute) as shape AttachmentDocumentSnapshot
  resource documentMenu = attachmentMenu(documentData, settingsAppearance.codeWordBreak) as shape AttachmentDocumentMenu
  mutation documentChanged as shape AttachmentDocumentAction refreshes data then didDocumentAction
  action documentAction(value: string)
    send documentChanged = attachmentDocumentAction(value, mediaScope, top(nav).params.attachmentId, mediaRouteKey, documentData, taskGuardOwner, taskGuardRoute)
  action documentNativeEvent(value: string)
    send documentChanged = attachmentNativeEvent(value, documentData.identifier)
  action didDocumentAction
    match documentChanged
      case some(result)
        if mediaActive and result.identifier == documentData.identifier
          if result.operation == "native-error"
            mediaNativeError = result.message
          else if result.message != ""
            send notice = alert("info", "File", result.message)
          else if result.removed
            nav = back(nav)
          else if result.operation == "preview"
            mediaNativeError = ""
            mediaReadAt = wallTime.epochAtZero + now()
            mediaRendered = true
          else if result.operation == "source"
            mediaNativeError = ""
            mediaReadAt = wallTime.epochAtZero + now()
            mediaRendered = false
          else if result.operation == "word-wrap"
            send preferenceChanged = preferenceChange("codeWordBreak", settingsAppearance.codeWordBreak ? "false" : "true")
          else if result.operation == "open-viewer"
            mediaNativeSource = result.sourceJSON
            mediaNativeOpen = true
      case none
        mediaNativeOpen = mediaNativeOpen
  action retryDocument
    mediaNativeError = ""
    mediaNativeOpen = false
    mediaReadAt = wallTime.epochAtZero + now()
    mediaReadVersion = mediaReadVersion + 1
  resource mediaData = mediaPreview(mediaScope, top(nav).params.attachmentId, mediaRouteKey, newTaskActive ? data.environmentId : top(nav).params.threadEnvironment, newTaskActive ? "" : top(nav).params.threadId, mediaActive, data.environmentId, data.threadId, data.generation, taskGuardOwner, taskGuardRoute) as shape MediaPreviewSnapshot
  mutation mediaCompleted as shape MediaCompletion then didMediaComplete
  action mediaComplete(value: string)
    send mediaCompleted = mediaCompletion(value, mediaData.identifier)
  action didMediaComplete
    match mediaCompleted
      case some(result)
        if mediaActive and result.identifier != "" and result.identifier == mediaData.identifier
          if mediaNativeOpen
            mediaNativeOpen = false
            if result.message != ""
              send notice = alert("info", "Could not open document", result.message)
          else if result.message != ""
            mediaNativeError = result.message
          else
            nav = back(nav)
      case none
        composerFocused = false
  action openDraftMedia(id: string)
    mediaReadAt = wallTime.epochAtZero + now()
    mediaRendered = true
    mediaNativeError = ""
    mediaNativeSource = ""
    mediaNativeOpen = false
    mediaReadVersion = 0
    nav = push(nav, startsWith(top(nav).name, "newTask") ? path("newTaskMedia", id) : path("threadDraftMedia", data.environmentId, data.threadId, id))
  action openMedia(id: string)
    mediaReadAt = wallTime.epochAtZero + now()
    mediaRendered = true
    mediaNativeError = ""
    mediaNativeSource = ""
    mediaNativeOpen = false
    mediaReadVersion = 0
    nav = push(nav, path("threadMedia", data.environmentId, data.threadId, id))
  resource composerAttachments = composerAttachments(data.revision, taskGuardOwner, taskGuardRoute) as shape ComposerAttachmentsSnapshot
  action removeAttachment(kind: string, id: string)
    lastOperation = "attachments"
    send changed = attachmentAction(kind, id, taskGuardOwner, taskGuardRoute)
  action pickAttachments
    lastOperation = "attachments"
    send changed = attachmentAction("menu", "", taskGuardOwner, taskGuardRoute)
  action openModelSettings
    modelQuery = ""
    modelFilter = ""
    if not newTaskActive
      send modelChanged = composerAction("open", "", "", taskGuardOwner, taskGuardRoute, `${top(nav).id}`)
    nav = push(nav, startsWith(top(nav).name, "newTask") ? path("newTaskModel") : path("threadModel", data.environmentId, data.threadId))
  state modelReturnAfterChange = false
  state modelQuery = ""
  state modelFilter = ""
  state modelLegacy = false
  state newTaskQuery = ""
  state branchQuery = ""
  state newTaskOperation = ""
  state newTaskContextRevision = 0
  resource composerLook = composerColors(appearance.scheme, appearance.themeId) as shape ComposerColors
  resource modelData = composerSettings(modelQuery, modelFilter, modelLegacy, data.revision, taskGuardOwner, taskGuardRoute) as shape ComposerSettingsSnapshot
  derive newTaskActive = startsWith(top(nav).name, "newTask")
  derive newTaskSession = match first(filter(stack(nav), route => route.name == "newTask")) { case some(route) => `${route.id}`, case none => "" }
  resource newTaskFlow = newTaskFlow(newTaskSession, `${top(nav).id}`, top(nav).url, newTaskActive, data.revision) as shape NewTaskFlowSnapshot
  derive taskGuardOwner = newTaskActive ? newTaskFlow.owner : ""
  derive taskGuardRoute = newTaskActive ? `${top(nav).id}` : ""
  task prepareNewTask when newTaskFlow.needsPrepare key=`${newTaskFlow.owner}:${top(nav).id}:${top(nav).url}`
    after(1, prepareNewTask)
  task redirectNewTask when newTaskFlow.nextLocation != "" key=`${newTaskFlow.owner}:${top(nav).id}:${newTaskFlow.nextLocation}`
    after(1, redirectNewTask)
  action prepareNewTask
    if newTaskFlow.requestRoute == `${top(nav).id}` and newTaskFlow.needsPrepare
      send taskPrepared = newTaskAction(newTaskFlow.owner, `${top(nav).id}`, "prepare", "", "")
  action redirectNewTask
    if newTaskFlow.requestRoute == `${top(nav).id}` and newTaskFlow.nextLocation != ""
      nav = open(nav, newTaskFlow.nextLocation)
  mutation taskPrepared as shape NewTaskFlowResult refreshes data, newTaskFlow then didTaskPrepare
  action didTaskPrepare
    match taskPrepared
      case some(result)
        if result.requestRoute == `${top(nav).id}` and result.nextLocation != ""
          nav = open(nav, result.nextLocation)
      case none
        newTaskOperation = ""
  resource newTaskBranchesReady = newTaskPrepare(branchQuery, newTaskActive and newTaskFlow.ready and top(nav).name != "newTask", newTaskContextRevision, data.ready, data.environmentId, data.projectId, data.threadId, data.generation, taskGuardOwner, taskGuardRoute) as shape NewTaskPreparation
  resource newTaskData = newTaskView(newTaskQuery, data.revision, newTaskBranchesReady.revision, newTaskBranchesReady.loaded, top(nav).name == "newTask", appearance.groupingMode) as shape NewTaskSnapshot
  mutation modelChanged as shape ComposerActionResult refreshes data, modelData then didModelChange
  mutation taskChanged as shape NewTaskFlowResult refreshes data, newTaskData, newTaskFlow then didTaskChange
  action modelAction(kind: string, id: string, value: string)
    if not pending(modelChanged)
      modelReturnAfterChange = top(nav).name == "newTaskModelOption" or top(nav).name == "threadModelOption" or top(nav).name == "newTaskRuntime" or top(nav).name == "threadRuntime"
      send modelChanged = composerAction(kind, id, value, taskGuardOwner, taskGuardRoute, `${top(nav).id}`)
  action didModelChange
    match modelChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}`
          if result.message != ""
            send notice = alert("info", "Could not update model", result.message)
          else if result.closed or modelReturnAfterChange
            nav = back(nav)
      case none
        modelQuery = modelQuery
  action editModelQuery(value: string)
    modelQuery = value
  action toggleLegacy(value: bool)
    modelLegacy = value
  action openModelFilter
    nav = push(nav, startsWith(top(nav).name, "newTask") ? path("newTaskModelFilter") : path("threadModelFilter", data.environmentId, data.threadId))
  action chooseModelFilter(value: string)
    modelFilter = value
    nav = back(nav)
  action openModelOption(id: string)
    match first(filter(modelData.options, option => option.id == id))
      case some(option)
        if option.boolean
          modelAction("option", id, option.on ? "false" : "true")
        else
          nav = push(nav, startsWith(top(nav).name, "newTask") ? path("newTaskModelOption", id) : path("threadModelOption", data.environmentId, data.threadId, id))
      case none
        modelQuery = modelQuery
  action chooseModelOption(value: string)
    modelAction("option", top(nav).params.modelOption, value)
  action openRuntime
    nav = push(nav, startsWith(top(nav).name, "newTask") ? path("newTaskRuntime") : path("threadRuntime", data.environmentId, data.threadId))
  action chooseRuntime(value: string)
    modelAction("runtime", "", value)
  action taskAction(kind: string, id: string, value: string)
    if not pending(taskChanged) and not pending(taskPrepared)
      newTaskOperation = kind
      send taskChanged = newTaskAction(newTaskFlow.owner, `${top(nav).id}`, kind, id, value)
  action didTaskChange
    match taskChanged
      case some(result)
        if result.requestRoute == `${top(nav).id}`
          if newTaskOperation != "draft" and newTaskOperation != "send" and newTaskOperation != "send-alternate"
            newTaskContextRevision = newTaskContextRevision + 1
          if result.message != ""
            send notice = alert("info", "Could not update task", result.message)
          else if result.submitted
            nav = open(nav, path("thread", result.environmentId, result.threadId))
          else if result.nextLocation != ""
            nav = push(nav, result.nextLocation)
          else if newTaskOperation == "environment" or newTaskOperation == "branch"
            nav = back(nav)
      case none
        newTaskOperation = ""
  action editNewDraft(value: string)
    send taskDraftChanged = newTaskAction(newTaskFlow.owner, `${top(nav).id}`, "draft", "", value)
  mutation taskDraftChanged as shape NewTaskFlowResult refreshes data, newTaskData
  action editNewQuery(value: string)
    newTaskQuery = value
  action editBranchQuery(value: string)
    branchQuery = value
  action chooseNewProject
    nav = open(nav, path("newTask"))
  action chooseNewEnvironment
    nav = push(nav, path("newTaskEnvironments"))
  action chooseNewBranch
    nav = push(nav, path("newTaskBranches"))
  state archiveQuery = ""
  state archiveEnvironment = ""
  state archiveSort = "newest"
  state archiveRefresh = 0
  state archiveDeleteEnvironment = ""
  state archiveDeleteProject = ""
  state archiveDeleteThread = ""
  resource archiveLook = archiveColors(appearance.scheme, appearance.themeId) as shape ArchiveColors
  resource archiveData = archiveView(wallTime.epochAtZero + elapsed, archiveQuery, archiveEnvironment, archiveSort, top(nav).name == "archive", data.revision, archiveRefresh) as shape ArchiveData
  resource agentLook = agentColors(appearance.scheme, appearance.themeId) as shape AgentActivityColors
  state agentsElapsed = 0
  task agentsClock when top(nav).name == "threadAgents" and agents.liveCount > 0
    every(1000, tickAgents)
  action tickAgents
    agentsElapsed = now()
  resource agents = agentActivity(data.environmentId, data.threadId, wallTime.epochAtZero + max(elapsed, agentsElapsed), data.revision) as shape AgentActivityData
  mutation archived as shape Change refreshes data, archiveData then didArchiveChange
  mutation archiveConfirmation as shape Notice then didConfirmArchive
  action openAgents
    nav = push(nav, path("threadAgents", data.environmentId, data.threadId))
  action openAgent(environmentId: string, threadId: string)
    nav = replace(nav, path("thread", environmentId, threadId))
  action editArchiveQuery(value: string)
    archiveQuery = value
  action editArchiveEnvironment(value: string)
    archiveEnvironment = value
  action toggleArchiveSort
    archiveSort = archiveSort == "newest" ? "oldest" : "newest"
  action refreshArchive
    archiveRefresh = archiveRefresh + 1
  action archiveAction(kind: string, environmentId: string, projectId: string, threadId: string)
    if kind == "delete"
      archiveDeleteEnvironment = environmentId
      archiveDeleteProject = projectId
      archiveDeleteThread = threadId
      let title = match first(filter(archiveData.items, item => item.environmentId == environmentId and item.threadId == threadId)) { case some(item) => item.title, case none => "This thread" }
      send archiveConfirmation = alert("delete", "Delete thread?", `“${title}” will be permanently deleted, including its terminal history.`)
    else
      send archived = archiveAction(kind, environmentId, projectId, threadId)
  action didConfirmArchive
    match archiveConfirmation
      case some(result)
        if result.choice == "delete"
          send archived = archiveAction("delete", archiveDeleteEnvironment, archiveDeleteProject, archiveDeleteThread)
      case none
        archiveDeleteThread = ""
  action didArchiveChange
    match archived
      case some(result)
        if result.message != ""
          send notice = alert("info", "Could not update thread", result.message)
      case none
        archiveRefresh = archiveRefresh
  state settledCount = 10
  resource shelves = homePreferences() as shape HomePreferences
  resource homeLook = homeColors(appearance.scheme, appearance.themeId) as shape HomeColors
  resource home = homeView(data.revision, wallTime.epochAtZero + elapsed, homeQuery, settledCount, shelves.loaded, shelves.workingEnabled, shelves.workingExpanded, shelves.snoozedExpanded, shelves.settledExpanded, chrome.environmentId, chrome.projectKey, "", appearance.groupingMode) as shape HomeView
  mutation shelfChanged as shape Change refreshes shelves
  task clock mount
    every(60000, tick)
  action tick
    elapsed = now()
  action toggleHomeShelf(section: string)
    send shelfChanged = toggleShelf(section)
  action showMore
    settledCount = settledCount + 25
  action chooseThread(id: string)
    send selected = selectThread(id, `${top(nav).id}`)
  state host = ""
  state code = ""
  state formError = ""
  state expanded = ""
  state submitted = false
  state lastOperation = ""
  state scannerOpen = false
  state cameraStatus = "undetermined"
  state pendingRemove = ""
  mutation camera as shape Camera then didRequestCamera
  mutation notice as shape Notice
  mutation removal as shape Notice then didConfirmRemove
  mutation scanned as shape PairingFields then didScan
  resource parsed = pairingFields(host) as shape PairingFields
  mutation changed as shape Change refreshes data then didChange
  task rem mount
    after(1, rootFont)
  action rootFont
    setRootFontSize(14)
  action editHost(value: string)
    host = value
    formError = ""
  action editCode(value: string)
    code = value
    formError = ""
  action connect
    lastOperation = "connect"
    submitted = true
    send changed = command(targetEnvironment == "" ? "environment-add" : "environment-add-route", host, code, targetEnvironment, taskGuardOwner, taskGuardRoute)
  action didChange
    match changed
      case some(result)
        formError = result.message
        if result.message != "" and (lastOperation == "thread-action" or lastOperation == "attachments")
          send notice = alert("info", "Could not complete action", result.message)
        if lastOperation == "save" and result.message == ""
          expanded = ""
        if submitted and result.message == ""
          host = ""
          code = ""
          nav = back(nav)
        submitted = false
      case none
        submitted = false
  mutation followed as shape AppLink then didFollow
  state launchRouteId = `${top(nav).id}`
  state launchLocation = top(nav).url
  resource initialLink = appLink(launchLocation, launchRouteId, true) as shape AppLink
  state linkBootResolved = false
  task resolveColdLink when not linkBootResolved key=launchRouteId
    after(1, followColdLink)
  action followColdLink
    linkBootResolved = true
    if initialLink.requestRoute == `${top(nav).id}`
      if initialLink.location != top(nav).url
        nav = open(nav, initialLink.location)
  action follow(url: string)
    send followed = appLink(url, `${top(nav).id}`, false)
  action didFollow
    match followed
      case some(result)
        if not result.ignore and result.requestRoute == `${top(nav).id}`
          nav = open(nav, result.location)
      case none
        composerFocused = composerFocused
  action scan
    if scannerOpen
      scannerOpen = false
    else
      send camera = cameraPermission()
  action didRequestCamera
    match camera
      case some(result)
        cameraStatus = result.status
        if result.status == "granted"
          scannerOpen = true
        else
          send notice = alert(result.status == "denied" ? "camera-settings" : "info", "Camera access needed", result.status == "unavailable" ? "Camera capture is unavailable on this device." : result.status == "denied" ? "Camera access was denied for this app. Open Settings to enable it." : "Allow camera access to scan an environment pairing QR code.")
      case none
        cameraStatus = "undetermined"
  action permissionChanged(value: string)
    cameraStatus = value
  action receiveScan(value: string)
    if trim(value) == ""
      send notice = alert("info", "Invalid QR code", "Scanned QR code did not contain a pairing URL.")
    else
      send scanned = pairingFields(value)
  action didScan
    match scanned
      case some(result)
        host = result.host
        code = result.code
        scannerOpen = false
      case none
        scannerOpen = false
  action didConfirmRemove
    match removal
      case some(result)
        if result.choice == "remove"
          send changed = command("forget", pendingRemove, "", "0", taskGuardOwner, taskGuardRoute)
      case none
        pendingRemove = ""
  action openConnections
    nav = push(nav, path("connections"))
  action addEnvironment
    targetEnvironment = ""
    formError = ""
    scannerOpen = false
    nav = push(nav, path("connect"))
  action openEnvironments
    nav = push(nav, path("environments"))
  action back
    if top(nav).name == "settingsScheduledNew" or top(nav).name == "settingsScheduledEdit"
      automationAction("close", "", "", "")
    else
      nav = back(nav)
  action toggle(id: string)
    if top(nav).name == "environments"
      nav = push(nav, path("environmentDetail", id))
    else
      expanded = expanded == id ? "" : id
  action detailAction(kind: string, key: string, value: string)
    if kind == "route-add"
      targetEnvironment = value
      formError = ""
      nav = push(nav, path("connect"))
    else if kind == "route-remove" or kind == "update-server"
      confirmKind = kind
      confirmKey = key
      confirmValue = value
      if kind == "route-remove"
        match first(filter(detail.routes, route => route.id == value))
          case some(route)
            send detailConfirmation = alert("remove", `Remove ${route.label}?`, route.address)
          case none
            confirmKind = ""
      else
        send detailConfirmation = alert("update", `Update ${detail.title}?`, detail.updateConfirmation)
    else
      send detailChanged = environmentDetailCommand(kind, key, value)
  action didConfirmDetail
    match detailConfirmation
      case some(result)
        if result.choice == "remove" or result.choice == "update"
          send detailChanged = environmentDetailCommand(confirmKind, confirmKey, confirmValue)
      case none
        confirmKind = ""

  action setEnabled(id: string, enabled: bool)
    send changed = command("environment-enabled", id, enabled ? "on" : "off", "0", taskGuardOwner, taskGuardRoute)
  action changeRouting(id: string, permission: string)
    send changed = command("github-routing", id, permission, "0", taskGuardOwner, taskGuardRoute)
  action reconnect(id: string)
    send changed = command("environment-reconnect", id, "", "0", taskGuardOwner, taskGuardRoute)
  action remove(id: string)
    if not pending(removal)
      pendingRemove = id
      let label = match first(filter(data.environments, item => item.id == id)) { case some(item) => item.label, case none => "this environment" }
      send removal = alert("remove", "Remove from this device?", `Forget ${label} and its cached threads on this device. Switch it off instead to keep it saved.`)
  action save(id: string, label: string, url: string)
    lastOperation = "save"
    send changed = command("save-environment", id, label, url, taskGuardOwner, taskGuardRoute)
  view
    main navigationKey=`${top(nav).id}`
      navigationBack="back"
      navigate=follow
      width="100%"
      height="100%"
      background-color=look.screen
      color=look.foreground
      font-family="DM Sans"
      font-size=16
      interactive-widget="resizes-content"
      testId="mobile-root"
      each entry in stack(nav) key = entry.id
        column navigationKey=`${entry.id}`
          data-mobile-scheduled-editor=(entry.name == "settingsScheduledNew" or entry.name == "settingsScheduledEdit")
          data-mobile-form-sheet=(entry.name == "connections" or entry.name == "connect")
          data-mobile-scan-action=(entry.name == "connect" ? "scan-qr" : "")
          data-mobile-scanner-open=scannerOpen
          navigationScroll=(entry.name == "home" ? (length(home.items) > 0 ? "home-list" : "") : entry.name == "thread" ? (length(threadData.rows) > 0 ? "thread-feed" : "") : entry.name == "threadReview" ? "review-diff" : entry.name == "threadFiles" ? "workspace-files" : entry.name == "threadFile" ? "file-source" : entry.name == "settingsScheduledTasks" ? "scheduled-tasks-scroll" : entry.name == "settingsScheduledNew" or entry.name == "settingsScheduledEdit" ? "scheduled-editor-scroll" : entry.name == "settingsThreads" ? "settings-thread-preferences-scroll" : entry.name == "settingsProjectOverview" ? "settings-project-scroll" : entry.name == "settingsNotifications" ? "settings-notifications-scroll" : entry.name == "settingsUsage" ? "settings-usage-scroll" : startsWith(entry.name, "settingsScheduled") or entry.name == "settingsUsageAccount" ? "" : entry.name == "settings" ? "settings-scroll" : entry.name == "settingsServer" ? "settings-server-scroll" : entry.name == "settingsProviders" ? "settings-provider-scroll" : entry.name == "settingsAppearance" ? "settings-appearance-scroll" : entry.name == "settingsChoice" ? "settings-choice-scroll" : entry.name == "archive" ? (length(archiveData.items) > 0 ? "archive-list" : "") : `scroll-${entry.id}`)
          navigationPresentation=(entry.name == "connections" or entry.name == "connect" or entry.name == "threadTerminalCapture" or entry.name == "settingsLegal" or entry.name == "threadBrowser" or entry.name == "threadDevices" ? "modal" : "")
          position="absolute"
          inset=0
          background-color=look.sheet
          display="flex"
          flex-direction="column"
          when entry.name != "threadDevices" and entry.name != "settingsAuth" and entry.name != "settingsWaitlist" and entry.name != "connectOnboarding"
            header height=44 flex-shrink=0 align-items="center" justify-content="space-between"
              button id="back" press=back aria-label="Back" testId=`back-${entry.name}`
                image "symbol:back" width=20 height=20
              text (entry.name == "settingsThreads" ? "Thread behavior" : entry.name == "settingsProjectOverview" ? "Project overview" : entry.name == "settingsNotifications" ? "Notifications" : entry.name == "settingsAbout" ? "About T3 Code" : entry.name == "settingsClientStorage" ? "Client Storage" : entry.name == "settingsDiagnostics" ? "Diagnostics" : entry.name == "settingsOpenSourceLicenses" ? "Open source licenses" : entry.name == "settingsOpenSourceLicense" ? "License notice" : entry.name == "settingsLegal" ? "Legal" : entry.name == "threadMedia" or entry.name == "threadDraftMedia" or entry.name == "newTaskMedia" ? mediaData.name : entry.name == "connect" ? "Add environment" : entry.name == "home" ? "T3 Code" : entry.name == "environmentDetail" ? detail.title : entry.name == "threadBrowser" ? browserData.title : entry.name == "threadDevices" ? devicesData.title : entry.name == "threadTerminal" ? "Terminal" : entry.name == "threadTerminalCapture" ? "Visible terminal output" : entry.name == "threadReview" ? "Review changes" : entry.name == "threadReviewComment" ? "Leave a comment" : entry.name == "threadFiles" ? filesData.title : entry.name == "threadFile" ? fileData.title : entry.name == "thread" ? threadData.title : entry.name == "settingsScheduledTasks" ? "Scheduled Tasks" : entry.name == "settingsScheduledNew" ? "New scheduled task" : entry.name == "settingsScheduledEdit" ? "Edit scheduled task" : entry.name == "settingsScheduledModel" ? "Model" : entry.name == "settingsScheduledBranch" ? "Base branch" : entry.name == "settingsUsage" ? "Usage" : entry.name == "settingsUsageAccount" ? automationData.account.label : entry.name == "settings" ? "Settings" : entry.name == "settingsServer" ? serverSettings.title : entry.name == "settingsProviders" ? "Provider accounts" : entry.name == "settingsAppearance" ? "Appearance" : entry.name == "settingsChoice" ? settingsChoice.title : entry.name == "archive" ? "Archived Threads" : entry.name == "threadAgents" ? "Agents" : entry.name == "newTask" ? "Choose project" : entry.name == "newTaskEnvironments" ? "Environment" : entry.name == "newTaskBranches" ? "Branch" : entry.name == "threadModel" or entry.name == "newTaskModel" ? "Model" : entry.name == "threadRuntime" or entry.name == "newTaskRuntime" ? "Runtime" : entry.name == "threadModelFilter" or entry.name == "newTaskModelFilter" ? "Providers" : entry.name == "threadModelOption" or entry.name == "newTaskModelOption" ? "Model options" : entry.name == "newTaskDraft" ? "New task" : "Environments")
                role="heading"
                aria-level=2
                font-size=18
                font-weight=800
              when entry.name == "settingsLegal"
                button id="legal-close" press=back aria-label="Close legal document"
                  text "Close"
              when entry.name == "connect"
                button id="scan-qr" press=scan aria-label=(scannerOpen ? "Close scanner" : "Scan QR code") testId="scan-qr"
                  text (scannerOpen ? "Close scanner" : "Scan QR code")
              when entry.name == "connections" or entry.name == "environments"
                button press=addEnvironment aria-label="Add environment" testId="add-environment"
                  image "symbol:add" width=20 height=20
              when entry.name == "threadMedia" or entry.name == "threadDraftMedia" or entry.name == "newTaskMedia"
                t3-document-menu document-menu=documentMenu.configuration change=documentAction width=32 height=32
              when entry.name == "settingsScheduledTasks"
                button id="scheduled-new" press=automationAction("new", "", "", "") disabled=(not automationData.scheduled.canCreate or pending(automationChanged)) aria-label="New scheduled task"
                  t3-symbol symbol-name="plus" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
              when entry.name == "settingsUsage"
                button press=automationAction("usage-environments", "", "", "") disabled=pending(automationChanged) aria-label="Filter usage environments"
                  t3-symbol symbol-name="line.3.horizontal.decrease" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
                button press=automationAction("usage-refresh", "", "", "") disabled=pending(automationChanged) aria-label="Refresh usage"
                  t3-symbol symbol-name="arrow.clockwise" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
              when entry.name == "threadBrowser"
                t3-preview-menu configuration=browserMenus.selection change=browserMenu width=38.5 height=38.5
              when entry.name == "threadTerminal"
                button press=terminalMenu aria-label="Terminal options" testId="terminal-options"
                  t3-symbol symbol-name="terminal" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
              when entry.name == "thread"
                MobilePreviewButton(count=browserData.count, devices=false, colors=previewLook, action=openBrowser)
                MobilePreviewButton(count=devicesData.count, devices=true, colors=previewLook, action=openDevices)
                button press=openTerminal aria-label="Terminal" testId="thread-terminal"
                  t3-symbol symbol-name="terminal" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
                button press=openReview aria-label="Review changes" testId="thread-review"
                  t3-symbol symbol-name="plus.forwardslash.minus" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
                button press=openFiles aria-label="Files" testId="thread-files"
                  t3-symbol symbol-name="folder" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
                button press=openAgents aria-label="Agents" testId="thread-agents"
                  t3-symbol symbol-name="person.2" point-size=20 symbol-tint=threadLook.foreground width=20 height=20
          when entry.name == "home"
            Home(items=home.items, emptyTitle=home.emptyTitle, emptyDetail=home.emptyDetail, loading=home.loading, addEnvironment=home.addEnvironment, bottomClearance=chrome.bottomClearance, emptyClearance=chrome.emptyClearance, selectThread=chooseThread, toggleShelf=toggleHomeShelf, showMore=showMore, addConnection=addEnvironment, colors=homeLook)
            HomeChrome(configuration=chrome.configuration, event=homeEvent)
          else when entry.name == "thread"
            ThreadFeed(data=threadData, horizontalPadding=16, userBubbleMaxWidth=max(0, (viewport.width - 32) * 0.85), bottomClearance=14, action=threadAction, openMedia=openMedia, colors=threadLook)
            ThreadApprovals(data=threadData, action=threadAction, colors=threadLook)
            ComposerAttachmentStrip(data=composerAttachments, open=openDraftMedia, remove=removeAttachment, colors=threadLook)
            ThreadComposer(voiceDisabled=(data.busy or pending(changed) or pending(taskChanged)), voice=voiceData, voiceOwner=(entry.id == top(nav).id ? voiceFocus.owner : ""), voiceColors=voiceLook, voiceAction=voiceAction, enterBehavior=appearance.enterBehavior, data=threadData.composer, expanded=composerExpanded, dark=appearance.scheme == "dark", bottomInset=(composerExpanded or composerFocused ? 0 : max(layout.safeBottom, 12)), contentMaxWidth=viewport.width, focusChanged=composerFocus, editDraft=editDraft, action=threadAction, pickAttachments=pickAttachments, openModelSettings=openModelSettings, colors=threadLook)
          else when entry.name == "threadBrowser" and entry.id == top(nav).id
            MobileBrowser(data=browserData, colors=previewLook, active=true, action=browserAction, menuConfiguration=browserMenus.options, menuEvent=browserMenu)
          else when entry.name == "threadDevices" and entry.id == top(nav).id
            MobileDevices(data=devicesData, colors=previewLook, active=true, safeAreaTop=layout.safeTop, action=devicesAction, close=back, menuConfiguration=devicesMenus.options, menuEvent=devicesMenu)
          else when entry.name == "threadTerminal"
            MobileTerminal(data=terminalData, event=terminalEvent, action=terminalAction)
          else when entry.name == "threadTerminalCapture"
            MobileTerminalCaptureView(data=terminalCapture, colors=terminalData.colors, select=selectTerminalLine, attach=attachTerminalOutput)
          else when entry.name == "threadReview"
            row gap=10 padding=14
              select value=reviewData.sectionId change=reviewSection aria-label="Diff section" flex=1 min-width=0
                each section in reviewData.sections key=section.id
                  option section.title value=section.id
              button press=toggleReviewWrap aria-label="Toggle line wrapping" aria-pressed=reviewWrap
                t3-symbol symbol-name="text.word.spacing" point-size=18 symbol-tint=reviewLook.icon width=20 height=20
            when length(reviewData.files) > 0
              select value=reviewData.selectedPath change=reviewFile aria-label="Changed file" margin-left=14 margin-right=14
                option "Changed files" value=""
                each file in reviewData.files key=file.id
                  option file.name value=file.path
            ReviewView(data=reviewData, colors=reviewLook, wrap=reviewWrap, action=reviewAction, refresh=refreshReview, loadMore=loadReviewFiles)
          else when entry.name == "threadReviewComment"
            ReviewCommentComposer(data=reviewData, value=reviewComment, colors=reviewLook, change=editReviewComment, submit=submitReviewComment)
          else when entry.name == "threadFiles"
            input value=filesQuery input=editFilesQuery placeholder="Search files" margin=14 aria-label="Search files"
            MobileFileTree(data=filesData, colors=reviewLook, toggle=toggleDirectory, select=openFile, refresh=refreshFiles)
          else when entry.name == "threadFile"
            row gap=14 padding=14
              text fileData.subtitle flex=1 min-width=0 line-clamp=1 color=reviewLook.muted font-size=12
              when fileData.markdown
                button press=toggleFilePreview aria-label="Toggle Markdown preview" aria-pressed=filePreview
                  t3-symbol symbol-name="eye" point-size=18 symbol-tint=reviewLook.icon width=20 height=20
              button press=toggleFileWrap aria-label="Toggle line wrapping" aria-pressed=fileWrap
                t3-symbol symbol-name="text.word.spacing" point-size=18 symbol-tint=reviewLook.icon width=20 height=20
            MobileFileView(data=fileData, colors=reviewLook, wrap=fileWrap, preview=filePreview, refresh=refreshFile)
          else when entry.name == "threadMedia" or entry.name == "threadDraftMedia" or entry.name == "newTaskMedia"
            when entry.id == top(nav).id
              when mediaData.ready
                when mediaData.kind == "file" and (documentData.error != "" or documentData.kind == "text" or documentData.kind == "markdown" or documentData.kind == "html")
                  MobileAttachmentDocument(data=documentData, colors=reviewLook, wrap=settingsAppearance.codeWordBreak, retry=retryDocument, nativeEvent=documentNativeEvent, nativeError=mediaNativeError)
                  when mediaNativeOpen
                    MediaPreview(data=mediaViewerData, completed=mediaComplete)
                else when documentData.kind == "audio"
                  MobileAttachmentAudio(data=audioData, source=documentData.sourceJSON, active=(not mediaNativeOpen), colors=reviewLook, command=audioControl, status=audioStatusChanged, retry=retryDocument)
                  when mediaNativeOpen
                    MediaPreview(data=mediaViewerData, completed=mediaComplete)
                else when mediaNativeError != ""
                  column flex=1 align-items="center" justify-content="center" padding=21 gap=7
                    text "No preview for this file" font-size=18 font-weight=700 color=threadLook.foreground
                    text mediaNativeError font-size=14 text-align="center" color=threadLook.muted
                    button press=retryDocument min-height=44
                      text "Try again" color=threadLook.foreground
                else when mediaData.kind != "file" or documentData.ready
                  MediaPreview(data=mediaData, completed=mediaComplete)
                else
                  text "Loading file..." padding=21 color=threadLook.muted
              else when mediaData.error != ""
                text mediaData.error padding=21 color=look.colors.dangerForeground
              else
                text "Loading preview…" padding=21 color=look.colors.muted
          else when entry.id == top(nav).id and informationRoute.active
            SettingsInformation(data=informationData, route=entry.name, query=informationQuery, legalConfiguration=informationLegal.configuration, colors=settingsData.root.colors, roles=settingsData.root.roles, bottom=settingsData.root.bottom, navigate=openInformation, command=informationCommand, queryChanged=informationSearch)
          else when entry.name == "settings"
            SettingsRoot(data=settingsData.root, navigate=openSetting)
            SettingsHeader(configuration=settingsData.header, event=settingsHeaderEvent)
          else when startsWith(entry.name, "settingsScheduled") or entry.name == "settingsUsage" or entry.name == "settingsUsageAccount"
            when entry.id == top(nav).id
              SettingsAutomation(data=automationData, colors=settingsData.root.colors, roles=settingsData.root.roles, danger=look.colors.dangerForeground, bottom=settingsData.root.bottom, dark=(appearance.scheme == "dark"), command=automationAction)
              when entry.name == "settingsScheduledTasks"
                SettingsHeader(configuration=scheduledHeader.configuration, event=settingsHeaderEvent)
          else when entry.name == "settingsThreads"
            SettingsThreadPreferences(data=threadPreferences, colors=settingsData.root.colors, roles=settingsData.root.roles, bottom=settingsData.root.bottom, busy=pending(threadPreferencesChanged), change=threadPreferenceChange, preference=changePreference)
          else when entry.name == "settingsProjectOverview"
            SettingsProjectOverview(data=projectOverview, colors=settingsData.root.colors, roles=settingsData.root.roles, bottom=settingsData.root.bottom, busy=pending(projectRenamed), savedRevision=projectSavedRevision, save=renameProject)
          else when entry.name == "settingsServer"
            SettingsServer(data=serverSettings, colors=settingsData.root.colors, roles=settingsData.root.roles, danger=look.colors.dangerForeground, bottom=settingsData.root.bottom, change=serverSettingChange, environment=settingsEnvironment)
          else when entry.name == "settingsProviders"
            SettingsProviderAccounts(data=providerAccounts, colors=settingsData.root.colors, roles=settingsData.root.roles, danger=look.colors.dangerForeground, bottom=settingsData.root.bottom, action=providerAction, field=providerField, signOut=providerSignOut)
          else when entry.name == "settingsAppearance"
            SettingsAppearance(data=settingsAppearance, change=changePreference)
          else when entry.name == "settingsNotifications"
            SettingsNotifications(data=notificationSettings, colors=settingsData.root.colors, roles=settingsData.root.roles, bottom=settingsData.root.bottom)
          else when entry.name == "settingsChoice"
            SettingsChoices(data=settingsChoice, colors=settingsData.root.colors, roles=settingsData.root.roles, bottom=settingsData.root.bottom, change=changePreference)
          else when entry.name == "archive"
            row padding=16 gap=14
              input value=archiveQuery input=editArchiveQuery placeholder="Search archived threads" flex=1 min-width=0 aria-label="Search archived threads"
              button press=toggleArchiveSort aria-label="Sort archived threads"
                text (archiveSort == "newest" ? "Newest" : "Oldest")
            select value=archiveEnvironment change=editArchiveEnvironment aria-label="Filter archived threads by environment" margin-left=16 margin-right=16
              option "All environments" value=""
              each environment in archiveData.environments key=environment.id
                option environment.label value=environment.id
            Archive(data=archiveData, colors=archiveLook, pending=pending(archived), loading=pending(archiveData), width=viewport.width, reduced=viewport.prefersReducedMotion, refresh=refreshArchive, action=archiveAction)
          else when entry.name == "threadAgents"
            AgentActivity(data=agents, colors=agentLook, dark=appearance.scheme == "dark", bottomInset=layout.safeBottom, open=openAgent)
          else when startsWith(entry.name, "newTask") and entry.name != "newTask" and not newTaskFlow.ready
            column flex=1 align-items="center" justify-content="center" padding=28 gap=14
              text (newTaskFlow.message != "" ? newTaskFlow.message : newTaskFlow.title) color=composerLook.muted text-align="center"
              when newTaskFlow.status == "error"
                button press=chooseNewProject
                  text "Choose project"
          else when entry.name == "threadModel" or entry.name == "newTaskModel"
            row gap=14 padding=14
              button press=modelAction("cancel", "", "") disabled=pending(modelChanged)
                text "Cancel"
              input value=modelQuery input=editModelQuery placeholder="Search models" flex=1 min-width=0 aria-label="Search models"
              button press=openModelFilter aria-label="Filter providers"
                t3-symbol symbol-name="line.3.horizontal.decrease" point-size=20 symbol-tint=composerLook.icon width=20 height=20
              button press=modelAction("save", "", "") disabled=(not modelData.canSave or pending(modelChanged))
                text modelData.saveLabel
            when modelData.hasLegacy
              row padding-left=14 padding-right=14 align-items="center"
                text "Show legacy models" flex=1 font-size=14 color=composerLook.muted
                input type="checkbox" switch checked=modelLegacy change=toggleLegacy aria-label="Show legacy models"
            ComposerSettings(data=modelData, dark=appearance.scheme == "dark", action=modelAction, openOptions=openModelOption, openRuntime=openRuntime, colors=composerLook)
          else when entry.name == "threadModelOption" or entry.name == "newTaskModelOption"
            match first(filter(modelData.options, option => option.id == entry.params.modelOption))
              case some(option)
                ComposerChoices(rows=option.choices, choose=chooseModelOption, colors=composerLook)
              case none
                text "This model option is no longer available."
          else when entry.name == "threadRuntime" or entry.name == "newTaskRuntime"
            ComposerChoices(rows=modelData.runtimes, choose=chooseRuntime, colors=composerLook)
          else when entry.name == "threadModelFilter" or entry.name == "newTaskModelFilter"
            ComposerChoices(rows=modelData.filters, choose=chooseModelFilter, colors=composerLook)
          else when entry.name == "newTaskDraft" and newTaskFlow.ready and newTaskData.draft
            NewTaskHero(data=newTaskData, chooseProject=chooseNewProject, chooseEnvironment=chooseNewEnvironment, colors=composerLook)
            NewTaskWorkspace(data=newTaskData, action=taskAction, chooseBranch=chooseNewBranch, colors=composerLook)
            ComposerAttachmentStrip(data=composerAttachments, open=openDraftMedia, remove=removeAttachment, colors=threadLook)
            ThreadComposer(voiceDisabled=(data.busy or pending(changed) or pending(taskChanged)), voice=voiceData, voiceOwner=(entry.id == top(nav).id ? voiceFocus.owner : ""), voiceColors=voiceLook, voiceAction=voiceAction, enterBehavior=appearance.enterBehavior, data=newTaskData.composer, expanded=composerExpanded, dark=appearance.scheme == "dark", bottomInset=(composerExpanded or composerFocused ? 0 : max(layout.safeBottom, 12)), contentMaxWidth=viewport.width, focusChanged=composerFocus, editDraft=editNewDraft, action=taskAction, pickAttachments=pickAttachments, openModelSettings=openModelSettings, colors=threadLook)
          else when entry.name == "newTask"
            input value=newTaskQuery input=editNewQuery placeholder="Search projects" margin=16 aria-label="Search projects"
            NewTaskProjects(data=newTaskData, action=taskAction, colors=composerLook)
          else when entry.name == "newTaskEnvironments"
            NewTaskEnvironments(data=newTaskData, action=taskAction, colors=composerLook)
          else when entry.name == "newTaskBranches"
            input value=branchQuery input=editBranchQuery placeholder="Search branches" margin=16 aria-label="Search branches"
            NewTaskBranches(data=newTaskData, action=taskAction, colors=composerLook)
          else
            scroll id=`scroll-${entry.id}` flex=1 min-height=0 keyboardDismissMode="interactive"
              column padding-left=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 17.5 : 20)
                padding-right=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 17.5 : 20)
                padding-top=(entry.name == "environmentDetail" ? 0 : entry.name == "environments" ? 14 : 16)
                padding-bottom=36
                gap=(entry.name == "connections" or entry.name == "environments" ? 0 : 14)
                when entry.name == "connect"
                  when scannerOpen
                    Scanner(permission=cameraStatus, active=scannerOpen, request=scan, received=receiveScan, permissionChanged=permissionChanged, colors=look.colors, secondary=look.secondary, secondaryForeground=look.secondaryForeground)
                  else
                    Connect(host=host, code=code, error=formError, submitting=pending(changed), changeHost=editHost, changeCode=editCode, submit=connect, colors=look.colors)
                when entry.name == "connections" or entry.name == "environments"
                  Environments(
                    items=data.environments,
                    expandedId=expanded,
                    opensDetails=(entry.name == "environments"),
                    toggle=toggle,
                    setEnabled=setEnabled,
                    reconnect=reconnect,
                    remove=remove,
                    save=save,
                    colors=look.colors
                  )
                  GitHubRoutingSettings(
                    items=data.routing,
                    saving=pending(changed),
                    change=changeRouting,
                    colors=look.colors
                  )
                  when formError != ""
                    text formError color=look.colors.dangerForeground testId="environment-error"
                when entry.name == "environmentDetail"
                  match first(filter(data.environments, item => item.id == detail.key))
                    case some(connection)
                      EnvironmentDetail(data=detail, connection=connection, colors=look.colors, dark=appearance.scheme == "dark", pending=pending(detailChanged), toggleConnection=toggle, setEnabled=setEnabled, reconnect=reconnect, remove=remove, save=save, action=detailAction)
                    case none
                      text "This environment is no longer saved on this device." color=look.colors.muted padding=17.5
                when entry.name == "notfound"
                  text "Page not found"
      t3-layout-facts change=layoutChanged position="absolute" inset=0 aria-hidden=true
      when voiceData.globalVisible
        column position="absolute" right=0 bottom=(max(layout.safeBottom, 12) + 64)
          VoiceGlobalPill(data=voiceData, colors=voiceLook, expanded=voicePillExpanded, width=min(320, viewport.width - 24), action=voiceAction, expand=expandVoicePill)
