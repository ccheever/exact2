// @ref examples/t3-code/mobile/docs/1130.011-responsive-workspace.decision.md#navigation-and-data-ownership
// Shape declarations only; share delivery and route ownership remain in App.
shape IncomingShareInbox
  ready: bool
  available: bool
  error: string
  revision: number
shape IncomingSharePresentation
  inboxRevision: number
  previousState: string
  state: string
  location: string
  requestRoute: string
