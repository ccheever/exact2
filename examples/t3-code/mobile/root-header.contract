// @ref llp/1109.011-responsive-workspace.decision.md#composition-decision
// Thread and document menus use their owned native coordinators; other routes keep authored controls.
component MobileRootHeader
  props
    routeName: string
    title: string
    subtitle: string
    scannerOpen: bool
    automationBusy: bool
    scheduledCanCreate: bool
    browserMenuConfiguration: string
    iconColor: string
    inspectorAvailable: bool
    inspectorVisible: bool
    toggleInspector: action
    sidebarAvailable: bool
    sidebarVisible: bool
    back: action
    closeNewTask: action
    scan: action
    addEnvironment: action
    automationAction: action
    browserMenu: action
    toggleSidebar: action
  derive modelChoice = routeName == "threadModelOption" or routeName == "newTaskModelOption" or routeName == "threadRuntime" or routeName == "newTaskRuntime"
  view
    header height=44 flex-shrink=0 align-items="center" justify-content="space-between"
      if sidebarAvailable and routeName != "threadBrowser" and routeName != "home" and routeName != "threadQueue" and routeName != "thread" and routeName != "newTaskDraft" and routeName != "newTask" and not routeName.startsWith("settings")
        button id="workspace-sidebar-toggle" press=toggleSidebar aria-label=(sidebarVisible ? "Hide sidebar" : "Show sidebar") aria-pressed=sidebarVisible
          t3-symbol symbol-name="sidebar.left" symbol-tint=iconColor width=20 height=20
      if routeName == "newTaskDraft"
        button id="new-task-cancel" press=closeNewTask aria-label="Cancel" testId="new-task-cancel"
          text "Cancel"
      if routeName != "home" and routeName != "threadQueue" and routeName != "newTaskDraft"
        button id="back" press=back aria-label="Back" testId=`back-${routeName}`
          image "symbol:back" width=20 height=20
      if subtitle != ""
        view flex-direction="column" align-items="center" min-width=0
          text title id="route-title" role="heading" aria-level=2 font-size=18 font-weight=800
          text subtitle id="document-subtitle" font-size=12
      else
        text title id=(routeName == "threadBrowser" ? "browser-title" : modelChoice ? "model-choice-title" : "route-title")
          role="heading"
          aria-level=2
          font-size=(routeName == "threadBrowser" or modelChoice ? 17 : 18)
          font-weight=(routeName == "threadBrowser" ? 600 : modelChoice ? 700 : 800)
      if routeName == "settingsLegal"
        button id="legal-close" press=back aria-label="Close legal document"
          text "Close"
      if routeName == "connect"
        button id="scan-qr" press=scan aria-label=(scannerOpen ? "Close scanner" : "Scan QR code") testId="scan-qr"
          text (scannerOpen ? "Close scanner" : "Scan QR code")
      if routeName == "connections" or routeName == "environments"
        button press=addEnvironment aria-label="Add environment" testId="add-environment"
          image "symbol:add" width=20 height=20
      if routeName == "settingsScheduledTasks"
        button id="scheduled-new" press=automationAction("new", "", "", "") disabled=(not scheduledCanCreate or automationBusy) aria-label="New scheduled task"
          t3-symbol symbol-name="plus" symbol-tint=iconColor width=20 height=20
      if routeName == "settingsUsage"
        button press=automationAction("usage-environments", "", "", "") disabled=automationBusy aria-label="Filter usage environments"
          t3-symbol symbol-name="line.3.horizontal.decrease" symbol-tint=iconColor width=20 height=20
      if routeName == "threadBrowser"
        t3-preview-menu configuration=browserMenuConfiguration change=browserMenu width=38.5 height=38.5
      if inspectorAvailable and (routeName == "threadFile" or routeName == "threadReview")
        button press=toggleInspector aria-label=(inspectorVisible ? "Hide inspector" : "Show inspector") aria-pressed=inspectorVisible
          t3-symbol symbol-name="sidebar.right" symbol-tint=iconColor width=20 height=20
