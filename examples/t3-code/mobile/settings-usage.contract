// @ref llp/1109.002-design-system-parity.spec.md#typography-and-font-assets
use SettingsColors, SettingsTextRoles, SettingsSectionLabel from "./settings.contract"
shape UsageEnvironment
  id: string
  label: string
  status: string
  connected: bool
shape UsageNotice
  id: string
  text: string
shape UsageLink
  label: string
  url: string
  accounts: string
  message: string
  disabled: bool
shape UsageCursor
  id: string
  label: string
  disabled: bool
shape UsageColumn
  key: string
  label: string
  present: bool
  remaining: number
  email: string
shape UsageReset
  key: string
  text: string
shape UsagePoolWindow
  id: string
  windowId: string
  kind: string
  label: string
  remaining: number
  pace: string
  columns: UsageColumn[]
  resets: UsageReset[]
shape UsagePool
  id: string
  label: string
  light: string
  dark: string
  windows: UsagePoolWindow[]
shape UsageBand
  id: string
  light: string
  dark: string
  height: number
  value: string
shape UsageBar
  id: string
  label: string
  bands: UsageBand[]
shape UsageLegend
  id: string
  label: string
  light: string
  dark: string
shape UsageProvider
  id: string
  label: string
  light: string
  dark: string
  value: string
  fraction: number
  share: string
  detail: string
shape UsageValue
  id: string
  label: string
  value: string
shape UsageCostSegment
  id: string
  label: string
  weight: number
  value: string
  light: string
  dark: string
shape UsageModel
  id: string
  label: string
  light: string
  dark: string
  value: string
  detail: string
shape MobileUsageData
  ready: bool
  error: string
  tab: string
  metric: string
  hasUsage: bool
  canRefresh: bool
  refreshing: bool
  emptyMessage: string
  environments: UsageEnvironment[]
  notices: UsageNotice[]
  duplicateMessage: string
  links: UsageLink[]
  cursor: UsageCursor[]
  pools: UsagePool[]
  limitsEmpty: string
  total: string
  chartTitle: string
  chartHasActivity: bool
  headlineLabel: string
  headlineValue: string
  headlineDetail: string
  chartStart: string
  chartEnd: string
  chartLegend: UsageLegend[]
  chart: UsageBar[]
  providers: UsageProvider[]
  totals: UsageValue[]
  hasCost: bool
  costByType: UsageCostSegment[]
  costBySpeed: UsageCostSegment[]
  costPremium: string
  models: UsageModel[]
shape MobileUsageAccountData
  present: bool
  error: string
  key: string
  label: string
  email: string
  hasEmail: bool
  revealed: bool
  plan: string
  windowLabel: string
  remaining: string
  resets: string
  restores: string
  source: string
  credits: string
  canRedeem: bool
  environmentId: string
  light: string
  dark: string
component SettingsUsage
  props
    data: MobileUsageData
    colors: SettingsColors
    roles: SettingsTextRoles
    danger: string
    bottom: number
    dark: bool
    days: number
    local: action
    command: action
    account: action
    refresh: action
  view
    UsageScroll(data=data, colors=colors, refresh=refresh)
      column padding-left=17.5 padding-right=17.5 padding-top=14 padding-bottom=bottom gap=17.5 font-family="DM Sans"
        row padding=2 border-radius=7 background-color=colors.subtle
          button press=local("tab", "limits") flex=1 min-height=32 border-radius=6 background-color=(data.tab == "limits" ? colors.grouped : "transparent")
            text "Limits" color=colors.foreground font-size=roles.footnote.size
          button press=local("tab", "usage") flex=1 min-height=32 border-radius=6 background-color=(data.tab == "usage" ? colors.grouped : "transparent")
            text "Usage" color=colors.foreground font-size=roles.footnote.size
        if data.error.length > 0
          text data.error color=danger role="alert" font-size=roles.footnote.size
        for environment in data.environments key=environment.id
          if environment.status.length > 0
            text `${environment.label}: ${environment.status}` color=colors.muted font-size=roles.footnote.size
        for notice in data.notices key=notice.id
          text notice.text color=colors.muted font-size=roles.footnote.size
        for link in data.links key=link.url
          column padding=14 gap=7 border-radius=24 background-color=colors.grouped
            button press=command("open-link", "", link.url) disabled=link.disabled min-height=44
              row align-items="center" gap=10.5
                text link.label flex=1 text-align="left" color=colors.link font-size=roles.body.size
                t3-symbol symbol-name="arrow.up.right" symbol-tint=colors.link width=16 height=16
            text link.accounts color=colors.muted font-size=roles.footnote.size
            if link.message.length > 0
              text link.message color=colors.muted font-size=roles.footnote.size
        for cursor in data.cursor key=cursor.id
          column padding=14 gap=7 border-radius=24 background-color=colors.grouped
            text `Cursor account usage · ${cursor.label}` color=colors.foreground font-size=roles.body.size
            text "Allow access to Cursor's login in macOS Keychain on this environment to read account usage." color=colors.muted font-size=roles.footnote.size
            button appearance="none" press=command("enable-cursor", cursor.id, "") disabled=cursor.disabled min-height=44
              text "Enable" color=colors.link font-size=roles.body.size
        if data.emptyMessage.length > 0
          text data.emptyMessage padding-top=56 padding-bottom=56 text-align="center" color=colors.muted font-size=roles.body.size
        if data.tab == "limits"
          if data.limitsEmpty.length > 0
            text data.limitsEmpty color=colors.muted font-size=roles.body.size
          for pool in data.pools key=pool.id
            column gap=10.5
              SettingsSectionLabel(title=pool.label, colors=colors, roles=roles)
              column background-color=colors.grouped border-radius=24 padding=14 gap=17.5
                for window in pool.windows key=window.id
                  column gap=7
                    row align-items="baseline" gap=7
                      text window.label flex=1 color=colors.foreground font-size=roles.body.size font-weight=500
                      text `${window.remaining}% remaining` color=colors.foreground font-size=roles.footnote.size
                    row gap=3.5
                      for item in window.columns key=item.key
                        button press=account(item.key, window.windowId, window.kind) disabled=(not item.present) flex=1 min-width=0 padding=0 aria-label=`${item.label}, ${item.remaining}% remaining`
                          column gap=3.5
                            view height=7 border-radius=4 background-color=colors.subtle overflow="hidden"
                              view width=`${item.remaining}%` height=7 background-color=(dark ? pool.dark : pool.light)
                            text item.label color=colors.muted font-size=roles.caption.size line-clamp=1
                    if window.pace.length > 0
                      text window.pace color=colors.muted font-size=roles.footnote.size
                    for reset in window.resets key=reset.key
                      text reset.text color=colors.muted font-size=roles.caption.size
        else
          row gap=7 align-items="center"
            row flex=1 border-radius=7 background-color=colors.subtle padding=2
              button press=local("days", "1") flex=1 min-height=32 border-radius=6 background-color=(days == 1 ? colors.grouped : "transparent")
                text "24h" color=colors.foreground font-size=roles.caption.size
              button press=local("days", "7") flex=1 min-height=32 border-radius=6 background-color=(days == 7 ? colors.grouped : "transparent")
                text "7d" color=colors.foreground font-size=roles.caption.size
              button press=local("days", "30") flex=1 min-height=32 border-radius=6 background-color=(days == 30 ? colors.grouped : "transparent")
                text "30d" color=colors.foreground font-size=roles.caption.size
              button press=local("days", "90") flex=1 min-height=32 border-radius=6 background-color=(days == 90 ? colors.grouped : "transparent")
                text "90d" color=colors.foreground font-size=roles.caption.size
            row border-radius=7 background-color=colors.subtle padding=2
              button press=local("metric", "cost") min-height=32 padding-left=7 padding-right=7 border-radius=6 background-color=(data.metric == "cost" ? colors.grouped : "transparent")
                text "Cost" color=colors.foreground font-size=roles.caption.size
              button press=local("metric", "tokens") min-height=32 padding-left=7 padding-right=7 border-radius=6 background-color=(data.metric == "tokens" ? colors.grouped : "transparent")
                text "Tokens" color=colors.foreground font-size=roles.caption.size
          if data.duplicateMessage.length > 0
            text data.duplicateMessage color=colors.muted font-size=roles.footnote.size
          if data.hasUsage
            column background-color=colors.grouped border-radius=24 padding=14 gap=14
              column gap=1.75
                text data.headlineLabel color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px` font-weight=400
                text data.headlineValue color=colors.foreground font-size=31.5 line-height="35px" font-weight=700 font-variant-numeric="tabular-nums"
                text data.headlineDetail color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px` font-weight=400
              if data.chartHasActivity
                row gap=2 height=180 align-items="flex-end" aria-label=data.chartTitle
                  for bar in data.chart key=bar.id
                    column flex=1 min-width=0 height=180 justify-content="flex-end" aria-label=bar.label
                      for band in bar.bands key=band.id
                        view height=band.height background-color=(dark ? band.dark : band.light) aria-label=`${band.id}: ${band.value}`
              else
                column height=180 align-items="center" justify-content="center"
                  text "No activity in this window." color=colors.muted font-size=roles.body.size line-height=`${roles.body.line}px`
              row justify-content="space-between" align-items="center"
                text data.chartStart flex-shrink=0 color=colors.tertiary font-size=roles.label.size line-height=`${roles.label.line}px`
                row gap=14 align-items="center" flex-shrink=0
                  for provider in data.chartLegend key=provider.id
                    row gap=5.25 align-items="center" flex-shrink=0
                      view width=7 height=7 border-radius=4 flex-shrink=0 background-color=(dark ? provider.dark : provider.light)
                      text provider.label flex-shrink=0 color=colors.muted font-size=roles.label.size line-height=`${roles.label.line}px`
                text data.chartEnd flex-shrink=0 color=colors.tertiary font-size=roles.label.size line-height=`${roles.label.line}px`
            column gap=7
              SettingsSectionLabel(title="Providers", colors=colors, roles=roles)
              column background-color=colors.grouped border-radius=24 overflow="hidden"
                for provider, index in data.providers key=provider.id
                  column padding=14 gap=7 border-top-width=(index > 0 ? 1 : 0) border-top-style="solid" border-top-color=colors.borderSubtle
                    row align-items="baseline" justify-content="space-between" gap=10.5
                      row align-items="center" gap=7 flex-shrink=0
                        view width=8.75 height=8.75 border-radius=999 flex-shrink=0 background-color=(dark ? provider.dark : provider.light)
                        text provider.label flex-shrink=0 color=colors.foreground font-size=roles.headline.size line-height=`${roles.headline.line}px`
                      text provider.value flex-shrink=0 color=colors.foreground font-size=roles.headline.size line-height=`${roles.headline.line}px` font-variant-numeric="tabular-nums"
                    row height=3.5 overflow="hidden" border-radius=999 background-color=colors.subtle
                      view height="100%" flex=provider.fraction border-radius=999 background-color=(dark ? provider.dark : provider.light)
                      view flex=(1 - provider.fraction)
                    text `${provider.share} · ${provider.detail}` color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px`
            UsageValues(title="Totals", items=data.totals, colors=colors, roles=roles)
            if data.hasCost
              column gap=7
                SettingsSectionLabel(title="Cost", colors=colors, roles=roles)
                column background-color=colors.grouped border-radius=24 overflow="hidden"
                  UsageCostBar(label="By type", segments=data.costByType, aside="", dark=dark, colors=colors, roles=roles)
                  if data.costBySpeed.length > 0
                    view border-top-width=1 border-top-style="solid" border-top-color=colors.borderSubtle
                      UsageCostBar(label="By speed", segments=data.costBySpeed, aside=data.costPremium, dark=dark, colors=colors, roles=roles)
            if data.models.length > 0
              column gap=7
                SettingsSectionLabel(title="By model", colors=colors, roles=roles)
                column background-color=colors.grouped border-radius=24 overflow="hidden"
                  for model, index in data.models key=model.id
                    row padding=14 gap=10.5 align-items="center" border-top-width=(index > 0 ? 1 : 0) border-top-style="solid" border-top-color=colors.borderSubtle
                      view width=8.75 height=8.75 border-radius=999 flex-shrink=0 background-color=(dark ? model.dark : model.light)
                      column flex=1 min-width=0 gap=1.75
                        text model.label color=colors.foreground font-size=roles.body.size line-height=`${roles.body.line}px` line-clamp=1
                        text model.detail color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px`
                      text model.value flex-shrink=0 color=colors.foreground font-size=roles.body.size line-height=`${roles.body.line}px` font-variant-numeric="tabular-nums"
component UsageCostBar
  props
    label: string
    segments: UsageCostSegment[]
    aside: string
    dark: bool
    colors: SettingsColors
    roles: SettingsTextRoles
  view
    if segments.length > 0
      column gap=10.5 padding=14
        row align-items="baseline" justify-content="space-between" gap=10.5
          text label flex-shrink=0 color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px`
          if aside.length > 0
            text aside flex-shrink=0 color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px` font-variant-numeric="tabular-nums"
        row height=7 gap=1.75
          for segment in segments key=segment.id
            view height="100%" flex=segment.weight border-radius=3.5 background-color=(dark ? segment.dark : segment.light)
        row flex-wrap="wrap" column-gap=14 row-gap=5.25
          for segment in segments key=segment.id
            row align-items="center" gap=5.25 flex-shrink=0
              view width=7 height=7 border-radius=3.5 flex-shrink=0 background-color=(dark ? segment.dark : segment.light)
              text segment.label flex-shrink=0 color=colors.muted font-size=roles.footnote.size line-height=`${roles.footnote.line}px`
              text segment.value flex-shrink=0 color=colors.foreground font-size=roles.footnote.size line-height=`${roles.footnote.line}px` font-variant-numeric="tabular-nums"
component UsageValues
  props
    title: string
    items: UsageValue[]
    colors: SettingsColors
    roles: SettingsTextRoles
  view
    column gap=7
      SettingsSectionLabel(title=title, colors=colors, roles=roles)
      column background-color=colors.grouped border-radius=24 overflow="hidden"
        for item in items key=item.id
          row padding=14 gap=14
            text item.label flex=1 color=colors.muted font-size=roles.body.size
            text item.value color=colors.foreground font-size=roles.body.size
component SettingsUsageAccount
  props
    data: MobileUsageAccountData
    colors: SettingsColors
    roles: SettingsTextRoles
    danger: string
    bottom: number
    reveal: action
    redeem: action
  view
    scroll flex=1 min-height=0 background-color=colors.sheet
      column padding=17.5 padding-bottom=bottom gap=17.5 font-family="DM Sans"
        if not data.present
          text data.error color=colors.muted font-size=roles.body.size
        else
          column background-color=colors.grouped border-radius=24 padding=14 gap=10.5
            text data.label color=colors.foreground font-size=roles.title.size font-weight=500
            if data.hasEmail
              button appearance="none" press=reveal(data.key) min-height=44 aria-label=(data.revealed ? "Hide email" : "Show email")
                text data.email color=colors.muted font-size=roles.body.size
            if data.plan.length > 0
              text data.plan color=colors.muted font-size=roles.footnote.size
            text data.windowLabel color=colors.foreground font-size=roles.body.size
            text data.remaining color=colors.foreground font-size=roles.largeTitle.size
            if data.resets.length > 0
              text `Resets ${data.resets}` color=colors.muted font-size=roles.body.size
            if data.restores.length > 0
              text data.restores color=colors.muted font-size=roles.footnote.size
            text data.source color=colors.muted font-size=roles.footnote.size
          if data.credits.length > 0
            column background-color=colors.grouped border-radius=24 padding=14 gap=7
              text data.credits color=colors.muted font-size=roles.footnote.size
              if data.canRedeem
                button press=redeem(data.environmentId, data.key) min-height=44 border-radius=22 background-color=colors.subtle
                  text "Use reset credit" color=colors.foreground font-size=roles.footnote.size font-weight=500

component UsageScroll
  props
    data: MobileUsageData
    colors: SettingsColors
    refresh: action
  slot
  view
    if data.canRefresh
      scroll flex=1 min-height=0 background-color=colors.sheet id="settings-usage-scroll" refresh=refresh refreshing=data.refreshing
        children
    else
      scroll flex=1 min-height=0 background-color=colors.sheet id="settings-usage-scroll"
        children
