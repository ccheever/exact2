// Pinned NewTaskRouteScreen/NewTaskContextPickerScreens365aa87982; root owns route headers and search.
// @ref llp/1109.005-composer-and-transcript.decision.md#new-task-ownership
use NewTaskSnapshot, ComposerColors from "./composer-shapes.contract"
component NewTaskProjects
  props
    data: NewTaskSnapshot
    action: action
    addProject: action
    addEnvironment: action
    primaryForeground: string
    colors: ComposerColors
  view
    list flex=1 min-height=0 padding-left=20 padding-right=20 padding-top=8 padding-bottom=36 background-color=colors.sheet
      when data.canStartScratch and data.hasProjects
        button press=action("scratch", data.scratchTarget, "") disabled=(not data.canSelect or data.pendingEditor) aria-label="No project" text-align="left" border-radius=24 background-color=colors.groupedCard margin-bottom=12 padding-left=14 padding-right=14 padding-top=12.25 padding-bottom=12.25
          row align-items="center" gap=10.5
            column width=24.5 height=24.5 align-items="center" justify-content="center"
              t3-symbol symbol-name="text.bubble" point-size=18 symbol-weight="regular" symbol-tint=colors.iconSubtle width=18 height=18
            column flex=1 min-width=0
              text "No project" font-size=16 line-height="20px" font-weight=700 color=colors.foreground
              text "Start a task without a project" font-size=12 line-height="15px" color=colors.muted line-clamp=1 text-overflow="ellipsis"
            t3-symbol symbol-name="chevron.right" point-size=14 symbol-weight="regular" symbol-tint=colors.iconSubtle width=14 height=14
      when length(data.projects) == 0
        column align-items="center" justify-content="center" padding=28 gap=10.5
          text data.emptyTitle font-size=18 line-height="23px" font-weight=700 color=colors.foreground text-align="center"
          text data.emptyDetail font-size=14 line-height="19px" color=colors.muted text-align="center"
          when not data.hasProjects
            when not data.canAddProject
              button press=addEnvironment testId="new-task-empty-add-environment" border-radius=999 background-color=colors.primary padding-left=14 padding-right=14 padding-top=8.75 padding-bottom=8.75
                text "Add environment" font-size=14 line-height="19px" font-weight=700 color=primaryForeground
            else
              button press=addProject testId="new-task-empty-add-project" border-radius=999 background-color=colors.primary padding-left=14 padding-right=14 padding-top=8.75 padding-bottom=8.75
                text "Add new project" font-size=14 line-height="19px" font-weight=700 color=primaryForeground
              when data.canStartScratch
                button press=action("scratch", data.scratchTarget, "") disabled=(not data.canSelect or data.pendingEditor) border-radius=999 background-color=colors.subtle padding-left=14 padding-right=14 padding-top=8.75 padding-bottom=8.75
                  text "Start without a project" font-size=14 line-height="19px" font-weight=700 color=colors.foreground
      column border-radius=24 overflow="hidden" background-color=colors.groupedCard
        each project in data.projects key=project.id
          button press=action("project", project.id, "") disabled=project.disabled text-align="left"
            padding-left=14 padding-right=14 padding-top=12.25 padding-bottom=12.25 background-color=colors.groupedCard
            border-bottom-width=(project.last ? 0 : 1) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
            row align-items="center" gap=10.5
              column width=24.5 height=24.5 align-items="center" justify-content="center"
                t3-symbol symbol-name="folder" point-size=20 symbol-weight="regular" symbol-tint=colors.iconSubtle width=20 height=20
              column flex=1 min-width=0
                text project.title font-size=16 line-height="20px" font-weight=700 color=colors.foreground
                text project.subtitle font-size=12 line-height="15px" color=colors.muted line-clamp=1 text-overflow="ellipsis"
              t3-symbol symbol-name="chevron.right" point-size=14 symbol-weight="regular" symbol-tint=colors.iconSubtle width=14 height=14

component NewTaskEnvironments
  props
    data: NewTaskSnapshot
    action: action
    colors: ComposerColors
  view
    list flex=1 min-height=0 padding-left=16 padding-right=16 background-color=colors.sheet
      each environment in data.environments key=environment.id
        button press=action("environment", environment.id, "") disabled=environment.disabled text-align="left" role="radio" aria-checked=environment.selected
          min-height=49 padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5 background-color=colors.groupedCard
          border-bottom-width=(environment.last ? 0 : 1) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
          row align-items="center" gap=10.5
            t3-symbol symbol-name=environment.machine point-size=17 symbol-weight="regular" symbol-tint=colors.iconSubtle width=17 height=17
            text environment.label flex=1 min-width=0 font-size=16 line-height="23px" font-weight=500 color=colors.foreground line-clamp=1 text-overflow="ellipsis"
            when environment.selected
              t3-symbol symbol-name="checkmark" point-size=16 symbol-weight="semibold" symbol-tint=colors.primary width=16 height=16

component NewTaskBranches
  props
    data: NewTaskSnapshot
    action: action
    colors: ComposerColors
  action changeOrigin(value: bool)
    action("origin", "", "")
  view
    list flex=1 min-height=0 padding-left=16 padding-right=16 reachend=action("branch-more", "", "") background-color=colors.sheet
      when data.workspaceMode == "worktree"
        column min-height=49 margin-bottom=10.5 padding-left=14 padding-right=14 background-color=colors.groupedCard
          row align-items="center" gap=10.5
            text "Start from origin" flex=1 font-size=16 line-height="23px" color=colors.foreground
            input type="checkbox" switch checked=data.originOn change=changeOrigin aria-label="Start from origin"
      when length(data.branches) == 0
        text data.branchEmpty padding=28 text-align="center" font-size=14 line-height="19px" color=colors.muted
      each branch in data.branches key=branch.id
        button press=action("branch", branch.id, "") disabled=branch.disabled text-align="left" role="radio" aria-checked=branch.selected
          min-height=49 padding-left=14 padding-right=14 padding-top=10.5 padding-bottom=10.5 background-color=colors.groupedCard
          border-bottom-width=(branch.last ? 0 : 1) border-bottom-style="solid" border-bottom-color=colors.borderSubtle
          row align-items="center" gap=10.5
            t3-symbol symbol-name="arrow.triangle.branch" point-size=17 symbol-weight="regular" symbol-tint=colors.iconSubtle width=17 height=17
            text branch.label flex=1 min-width=0 font-size=16 line-height="23px" color=colors.foreground line-clamp=1 text-overflow="ellipsis"
            when length(branch.badge) > 0
              text branch.badge font-size=12 line-height="16px" color=colors.muted
            when branch.selected
              t3-symbol symbol-name="checkmark" point-size=16 symbol-weight="semibold" symbol-tint=colors.primary width=16 height=16

component NewTaskHero
  props
    data: NewTaskSnapshot
    chooseProject: action
    chooseEnvironment: action
    colors: ComposerColors
    iconMuted: string
    voiceBusy: bool
  view
    column width="100%" box-sizing="border-box" align-items="center" padding-left=21 padding-right=21 gap=(data.scratch ? 7 : 21) testId="new-task-hero"
      when data.scratch
        text "What should we work on?" font-size=26 line-height="32px" font-weight=500 letter-spacing="-0.025em" color=colors.foreground text-align="center"
        row max-width="100%" flex-wrap="wrap" align-items="center" justify-content="center" gap=3.5
          button press=chooseProject disabled=(not data.canSelect or data.pendingEditor) box-sizing="border-box" height=38.5 padding-left=7 padding-right=7 max-width=190 border-radius=10.5 aria-label="Choose a project"
            row align-items="center" gap=7
              t3-symbol symbol-name="folder" point-size=14 symbol-tint=iconMuted width=14 height=14
              text "Choose a project" font-size=14 line-height="19px" font-weight=500 color=colors.muted line-clamp=1
              t3-symbol symbol-name="chevron.right" point-size=10 symbol-tint=iconMuted width=10 height=10
          NewTaskEnvironmentControl(data=data, choose=chooseEnvironment, colors=colors, iconMuted=iconMuted, voiceBusy=voiceBusy)
      else
        column width="100%" align-items="center" gap=5.25
          text "What should we build" font-size=26 line-height="32px" font-weight=500 letter-spacing="-0.025em" color=colors.foreground text-align="center"
          row max-width="100%" align-items="center" justify-content="center"
            text "in" margin-right=6.5 font-size=26 line-height="32px" font-weight=500 letter-spacing="-0.025em" color=colors.foreground
            button press=chooseProject disabled=(not data.canSelect or data.pendingEditor) max-width=250 min-width=0 padding=0 border-bottom-width=1 border-bottom-style="solid" border-bottom-color=colors.muted aria-label=data.projectTitle
              text data.projectTitle line-clamp=1 text-overflow="ellipsis" font-size=26 line-height="32px" font-weight=500 letter-spacing="-0.025em" color=colors.foreground
            text "?" font-size=26 line-height="32px" font-weight=500 letter-spacing="-0.025em" color=colors.foreground
        NewTaskEnvironmentControl(data=data, choose=chooseEnvironment, colors=colors, iconMuted=iconMuted, voiceBusy=voiceBusy)

component NewTaskEnvironmentControl
  props
    data: NewTaskSnapshot
    choose: action
    colors: ComposerColors
    iconMuted: string
    voiceBusy: bool
  view
    when length(data.environments) > 1
      button press=choose disabled=(not data.canSelect or data.pendingEditor or voiceBusy) box-sizing="border-box" height=38.5 max-width=(data.scratch ? 170 : 260) padding-left=7 padding-right=7 border-radius=10.5 aria-label=`Environment: ${data.environmentLabel}` opacity=(not data.canSelect or voiceBusy ? 0.45 : 1)
        NewTaskEnvironmentLabel(data=data, colors=colors, iconMuted=iconMuted)
    else
      row box-sizing="border-box" height=38.5 max-width=(data.scratch ? 170 : 260) padding-left=7 padding-right=7 align-items="center" opacity=(not data.canSelect or voiceBusy ? 0.45 : 1)
        NewTaskEnvironmentLabel(data=data, colors=colors, iconMuted=iconMuted)

component NewTaskEnvironmentLabel
  props
    data: NewTaskSnapshot
    colors: ComposerColors
    iconMuted: string
  view
    row min-width=0 align-items="center" gap=7
      each environment in data.environments key=environment.id
        when environment.selected
          t3-symbol symbol-name=environment.machine point-size=14 symbol-tint=iconMuted width=14 height=14 flex-shrink=0
      text `on ${data.environmentLabel}` min-width=0 flex-shrink=1 font-size=14 line-height="19px" font-weight=500 color=colors.muted line-clamp=1 text-overflow="ellipsis"
      when length(data.environments) > 1
        t3-symbol symbol-name="chevron.right" point-size=10 symbol-tint=iconMuted width=10 height=10 flex-shrink=0

component NewTaskWorkspace
  props
    data: NewTaskSnapshot
    action: action
    chooseBranch: action
    colors: ComposerColors
    iconMuted: string
    voiceBusy: bool
  view
    when not data.scratch
      row align-items="center" gap=3.5 padding-left=7 padding-right=7 padding-bottom=3.5
        button press=action("workspace", "", (data.workspaceMode == "local" ? "worktree" : "local")) disabled=(not data.canSelect or data.pendingEditor or voiceBusy) box-sizing="border-box" height=38.5 padding-left=7 padding-right=7 max-width=(data.workspaceMode == "local" ? 220 : 148) border-radius=10.5 aria-label=data.workspaceLabel opacity=(not data.canSelect or voiceBusy ? 0.45 : 1)
          row align-items="center" gap=7 min-width=0
            box width=14 height=14 position="relative" flex-shrink=0
              t3-symbol symbol-name="folder" point-size=14 symbol-tint=iconMuted width=14 height=14
              when data.workspaceMode == "worktree"
                t3-symbol position="absolute" right=(-3.5) bottom=(-3.5) symbol-name="arrow.triangle.branch" point-size=8 symbol-tint=iconMuted width=8 height=8
            text data.workspaceLabel min-width=0 flex-shrink=1 font-size=14 line-height="19px" font-weight=500 color=colors.muted line-clamp=1 text-overflow="ellipsis"
        button press=chooseBranch disabled=(not data.canSelect or data.pendingEditor) box-sizing="border-box" height=38.5 padding-left=7 padding-right=7 max-width=190 border-radius=10.5 aria-label=`${data.workspaceMode == "worktree" ? "Base branch" : "Branch"}: ${data.branchLabel}` opacity=(not data.canSelect ? 0.45 : 1)
          row align-items="center" gap=7 min-width=0
            t3-symbol symbol-name="arrow.triangle.branch" point-size=14 symbol-tint=iconMuted width=14 height=14 flex-shrink=0
            text data.branchLabel min-width=0 flex-shrink=1 font-size=14 line-height="19px" font-weight=500 color=colors.muted line-clamp=1 text-overflow="ellipsis"
            t3-symbol symbol-name="chevron.right" point-size=10 symbol-tint=iconMuted width=10 height=10 flex-shrink=0
