// Pinned365aa87982 ComposerAttachmentStrip dimensions; native preview/share transitions remain pending.
// @ref examples/t3-code/mobile/docs/1130.005-composer-and-transcript.decision.md#root-seam
use ThreadColors from "./thread-shapes.contract"
use ComposerAttachmentsSnapshot from "./composer-attachment-shapes.contract"
component ComposerAttachmentStrip
  props
    data: ComposerAttachmentsSnapshot
    remove: action
    open: action
    colors: ThreadColors
  view
    if data.items.length > 0
      scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0 scrollbar-width="none" touch-action="pan-x" testId="composer-attachment-strip"
        row gap=10 padding-left=14 padding-right=14 padding-bottom=8.75
          for item in data.items key=item.id
            column position="relative" width=72 height=72 flex-shrink=0 border-radius=16 overflow="hidden" background-color=colors.subtle aria-label=`${item.name}, ${item.size}` testId=`composer-attachment-${item.id}`
              button press=open(item.id, data.contentOwner) disabled=item.disabled role=(item.kind == "image" ? "imagebutton" : "button") aria-label=(item.kind == "image" ? `Preview ${item.name}` : `Open ${item.name}`) width=72 height=72 padding=0 testId=`composer-attachment-open-${item.id}`
                if item.preview != ""
                  image item.preview width=72 height=72 object-fit="cover" aria-hidden=true
                else
                  column width=72 height=72 justify-content="center" align-items="center" padding=7 box-sizing="border-box" gap=3.5
                    t3-symbol symbol-name=(item.kind == "video" ? "video" : "doc") symbol-tint=colors.iconSubtle width=22 height=22
                    text item.name width="100%" text-align="center" line-clamp=1 text-overflow="ellipsis" font-size=11 line-height="14px" color=colors.foreground
              button press=remove(item.removeOperation == "remove-retained" ? "remove-retained" : item.removeOperation == "remove-snapshot" ? "remove-image" : "remove-file", item.id, data.contentOwner) disabled=item.disabled position="absolute" top=4 right=4 width=22 height=22 border-radius=11 padding=0 background-color="rgba(0,0,0,0.55)" aria-label=`Remove ${item.name}` testId=`composer-attachment-remove-${item.id}`
                column width=22 height=22 align-items="center" justify-content="center"
                  t3-symbol symbol-name="xmark" symbol-weight="bold" symbol-tint="#ffffff" width=9 height=9
