// Pinned365aa87982 ComposerAttachmentStrip dimensions; preview/share transitions remain pending.
// @ref llp/1106.005-composer-and-transcript.decision.md#root-seam
use ThreadColors from "./thread-shapes.contract"
use ComposerAttachmentsSnapshot from "./composer-attachment-shapes.contract"
component ComposerAttachmentStrip
  props
    data: ComposerAttachmentsSnapshot
    remove: action
    colors: ThreadColors
  view
    when length(data.items) > 0
      scroll overflow-x="auto" overflow-y="hidden" flex-shrink=0 padding-left=14 padding-right=14 padding-bottom=8.75
        row gap=8.75
          each item in data.items key=item.id
            column position="relative" width=72 height=72 border-radius=16 overflow="hidden" background-color=colors.subtle aria-label=`${item.name}, ${item.size}`
              when item.preview != ""
                image item.preview width=72 height=72 object-fit="cover"
              else
                column width=72 height=72 justify-content="center" align-items="center" padding=7 box-sizing="border-box" gap=3.5
                  t3-symbol symbol-name=(item.kind == "video" ? "video" : "doc") point-size=22 symbol-tint=colors.iconSubtle width=22 height=22
                  text item.name width="100%" text-align="center" line-clamp=1 text-overflow="ellipsis" font-size=11 line-height="14px" color=colors.foreground
              button press=remove(item.removeOperation == "remove-snapshot" ? "remove-image" : "remove-file", item.id) disabled=item.disabled
                position="absolute" top=4 right=4 width=22 height=22 border-radius=11 padding=0 background-color="rgba(0,0,0,0.55)" aria-label=`Remove ${item.name}`
                column width=22 height=22 align-items="center" justify-content="center"
                  t3-symbol symbol-name="xmark" point-size=9 symbol-weight="bold" symbol-tint="#ffffff" width=9 height=9
