// @ref llp/1107.005-composer-and-transcript.decision.md#new-task-ownership
shape NewTaskFlowSnapshot
  owner: string
  requestRoute: string
  status: string
  title: string
  message: string
  draftOwner: string
  ready: bool
  fileReady: bool
  chooser: bool
  needsPrepare: bool
  busy: bool
  nextLocation: string
shape NewTaskFlowResult
  revision: number
  requestRoute: string
  nextLocation: string
  message: string
  alertTitle: string
  submitted: bool
  environmentId: string
  projectId: string
  threadId: string
