use ComposerActionResult from "./composer-shapes.contract"
use NewTaskFlowResult from "./new-task-flow.contract"
// @ref examples/t3-code/mobile/docs/1130.011-responsive-workspace.decision.md#navigation-and-data-ownership
// Pure presentation transitions. App retains requests, guards and route commits.
use ArchiveChromeEvent from "./archive-chrome.contract"
use AttachmentDocumentAction from "./attachment-document.contract"
use HomeActionResult, MediaCompletion, PairingFields, AppLink, Camera, SettingsScopeEvent, SettingsSelection, Change, AutomationChange, AutomationCreditConfirmation from "./app-shapes.contract"
use WorkspaceEntry from "./mobile-workspace.contract"
use homeAutomationPath from "./home-routes.contract"

shape HomeReplyPlan
  archiveRefresh: number
  alertTitle: string
  message: string
  nextLocation: string
fn homeReplyPlan(previousArchiveRefresh: number, reply: option<HomeActionResult>, route: string): HomeReplyPlan = match reply {
  case some(result) => HomeReplyPlan(
    archiveRefresh=previousArchiveRefresh + (result.archiveChanged ? 1 : 0),
    alertTitle=result.alertTitle,
    message=(result.requestRoute == route ? result.message : ""),
    nextLocation=(result.requestRoute == route ? result.nextLocation : "")
  ),
  case none => HomeReplyPlan(archiveRefresh=previousArchiveRefresh, alertTitle="", message="", nextLocation="")
}

fn followedLocation(reply: option<AppLink>, route: string): string = match reply {
  case some(result) => not result.ignore and result.requestRoute == route ? result.location : "",
  case none => ""
}
fn pairingUiScan(previous: PairingUi, reply: option<PairingFields>): PairingUi = match reply {
  case some(result) => PairingUi(previous, host=result.host, code=result.code, scannerOpen=false),
  case none => PairingUi(previous, scannerOpen=false)
}
shape SettingsVisitOwner
  visitToken: string
  routeKey: string
shape SettingsVisit
  visitToken: string
  selection: SettingsSelection
shape SettingsVisitPlan
  records: SettingsVisit[]
  close: bool
fn settingsContentRoute(name: string): bool = ["settingsNotifications", "settingsThreads", "settingsProjectOverview", "settingsServer", "settingsProviders", "settingsAppearance", "settingsChoice", "settingsScheduledTasks", "settingsScheduledNew", "settingsScheduledEdit", "settingsScheduledModel", "settingsScheduledBranch", "settingsAbout", "settingsClientStorage", "settingsDiagnostics", "settingsOpenSourceLicenses", "settingsOpenSourceLicense", "settingsUsage", "settingsUsageAccount", "archive", "environments", "environmentDetail"].includes(name)
fn settingsRootOwner(roots: WorkspaceEntry[], content: WorkspaceEntry[]): SettingsVisitOwner = match first(roots.slice(roots.length - 1, roots.length)) {
  case some(root) => SettingsVisitOwner(visitToken=`root:${root.id}`, routeKey=root.id),
  case none => match first(content) { case some(child) => SettingsVisitOwner(visitToken=`content:${child.id}`, routeKey=child.id), case none => SettingsVisitOwner(visitToken="", routeKey="") }
}
fn settingsPrefixOwner(entries: WorkspaceEntry[]): SettingsVisitOwner = settingsRootOwner(entries.filter(entry => entry.name == "settings"), entries.filter(entry => settingsContentRoute(entry.name)))
fn settingsVisitOwner(entries: WorkspaceEntry[], routeKey: string): SettingsVisitOwner = settingsPrefixOwner(entries.slice(0, entries.map(entry => entry.id).indexOf(routeKey) + 1))
fn settingsLiveTokens(entries: WorkspaceEntry[]): string[] = entries.filter(entry => entry.name == "settings" or settingsContentRoute(entry.name)).map(entry => settingsVisitOwner(entries, entry.id).visitToken)
fn settingsDefaultSelection(): SettingsSelection = SettingsSelection(allEnvironments=true, environmentIds=[""].slice(0, 0), projectKey="")
fn settingsVisitSelection(records: SettingsVisit[], token: string): SettingsSelection = match first(records.filter(record => record.visitToken == token)) { case some(record) => record.selection, case none => settingsDefaultSelection() }
fn settingsLiveRecords(records: SettingsVisit[], entries: WorkspaceEntry[]): SettingsVisit[] = records.filter(record => settingsLiveTokens(entries).includes(record.visitToken))
fn settingsEnvironmentSelection(previous: SettingsSelection, available: string[], selected: string[]): SettingsSelection = SettingsSelection(previous, allEnvironments=available.filter(id => not selected.includes(id)).length == 0, environmentIds=selected)
fn settingsToggledIds(selected: string[], id: string): string[] = selected.includes(id) ? selected.filter(candidate => candidate != id) : selected.concat([id])
fn settingsApplyOperation(previous: SettingsSelection, event: SettingsScopeEvent): SettingsSelection = (
  event.kind == "all" ? SettingsSelection(previous, allEnvironments=true, environmentIds=[""].slice(0, 0)) :
  event.kind == "project" ? SettingsSelection(previous, projectKey=event.value) :
  event.kind == "environment" and event.availableEnvironmentIds.includes(event.value) ? settingsEnvironmentSelection(previous, event.availableEnvironmentIds, settingsToggledIds(event.availableEnvironmentIds.filter(id => previous.allEnvironments or previous.environmentIds.includes(id)), event.value)) : previous
)
fn settingsOperationRecords(previous: SettingsVisit[], entries: WorkspaceEntry[], event: SettingsScopeEvent): SettingsVisit[] = (
  settingsLiveTokens(entries).includes(event.visitToken) and ["all", "environment", "project"].includes(event.kind)
    ? settingsLiveRecords(previous, entries).filter(record => record.visitToken != event.visitToken).concat([SettingsVisit(visitToken=event.visitToken, selection=settingsApplyOperation(settingsVisitSelection(previous, event.visitToken), event))])
    : settingsLiveRecords(previous, entries)
)
fn settingsEventPlan(previous: SettingsVisit[], reply: option<SettingsScopeEvent>, entries: WorkspaceEntry[], routeKey: string): SettingsVisitPlan = match reply {
  case some(event) => SettingsVisitPlan(records=settingsOperationRecords(previous, entries, event), close=settingsLiveTokens(entries).includes(event.visitToken) and event.requestRoute == routeKey and (event.kind == "close" or event.kind == "back")),
  case none => SettingsVisitPlan(records=settingsLiveRecords(previous, entries), close=false)
}
shape PairingCameraPlan
  next: PairingUi
  kind: string
  message: string
fn pairingCameraPlan(previous: PairingUi, reply: option<Camera>): PairingCameraPlan = match reply {
  case some(result) => PairingCameraPlan(
    next=PairingUi(previous, cameraStatus=result.status, scannerOpen=(result.status == "granted" or previous.scannerOpen)),
    kind=(result.status == "denied" ? "camera-settings" : "info"),
    message=(result.status == "granted" ? "" : result.status == "unavailable" ? "Camera capture is unavailable on this device." : result.status == "denied" ? "Camera access was denied for this app. Open Settings to enable it." : "Allow camera access to scan an environment pairing QR code.")
  ),
  case none => PairingCameraPlan(next=PairingUi(previous, cameraStatus="undetermined"), kind="", message="")
}

shape TerminalCaptureSelection
  text: string
  key: string
  start: number
  end: number
  anchor: number
fn terminalCaptureStart(text: string, key: string): TerminalCaptureSelection = (
  TerminalCaptureSelection(text=text, key=key, start=0, end=-1, anchor=-1)
)
fn terminalCaptureSelect(previous: TerminalCaptureSelection, index: number): TerminalCaptureSelection = (
  previous.anchor < 0
    ? TerminalCaptureSelection(previous, start=index, end=index, anchor=index)
    : TerminalCaptureSelection(previous, start=min(previous.anchor, index), end=max(previous.anchor, index), anchor=-1)
)
fn terminalCaptureAttached(previous: TerminalCaptureSelection): TerminalCaptureSelection = (
  TerminalCaptureSelection(previous, text="", key="")
)

shape ArchiveFilters
  query: string
  environment: string
  sort: string
shape ArchiveVisit
  routeKey: string
  filters: ArchiveFilters
fn archiveDefaultFilters(): ArchiveFilters = ArchiveFilters(query="", environment="", sort="newest")
fn archiveLiveKeys(entries: WorkspaceEntry[]): string[] = entries.filter(entry => entry.name == "archive").map(entry => entry.id)
fn archiveLiveRecords(previous: ArchiveVisit[], entries: WorkspaceEntry[]): ArchiveVisit[] = previous.filter(record => archiveLiveKeys(entries).includes(record.routeKey))
fn archiveVisitFilters(previous: ArchiveVisit[], entries: WorkspaceEntry[], routeKey: string): ArchiveFilters = match first(archiveLiveRecords(previous, entries).filter(record => record.routeKey == routeKey)) {
  case some(record) => record.filters,
  case none => archiveDefaultFilters()
}
fn archiveFilterOperation(previous: ArchiveFilters, event: ArchiveChromeEvent): ArchiveFilters = (
  event.kind == "search" ? ArchiveFilters(previous, query=event.value) :
  event.kind == "environment" ? ArchiveFilters(previous, environment=event.value) :
  event.kind == "sort" ? ArchiveFilters(previous, sort=event.value) : previous
)
// The decoder admits values while focused; completion still belongs to that captured live entry.
fn archiveOperationRecords(previous: ArchiveVisit[], entries: WorkspaceEntry[], event: ArchiveChromeEvent): ArchiveVisit[] = (
  archiveLiveKeys(entries).includes(event.routeKey) and (event.kind == "search" or event.kind == "environment" or (event.kind == "sort" and ["newest", "oldest"].includes(event.value)))
    ? archiveLiveRecords(previous, entries).filter(record => record.routeKey != event.routeKey).concat([ArchiveVisit(routeKey=event.routeKey, filters=archiveFilterOperation(archiveVisitFilters(previous, entries, event.routeKey), event))])
    : archiveLiveRecords(previous, entries)
)
fn archiveEventRecords(previous: ArchiveVisit[], reply: option<ArchiveChromeEvent>, entries: WorkspaceEntry[]): ArchiveVisit[] = match reply {
  case some(event) => archiveOperationRecords(previous, entries, event),
  case none => archiveLiveRecords(previous, entries)
}
shape ArchiveDeleteTarget
  environment: string
  project: string
  thread: string

shape GitForm
  message: string
  branch: string
  worktreeBase: string
  worktreeBranch: string
fn gitFormField(previous: GitForm, key: string, value: string): GitForm = (
  key == "message" ? GitForm(previous, message=value) :
  key == "branch" ? GitForm(previous, branch=value) :
  key == "base" ? GitForm(previous, worktreeBase=value) :
  key == "worktree" ? GitForm(previous, worktreeBranch=value) : previous
)
fn gitFormBranches(previous: GitForm, initialBase: string): GitForm = (
  GitForm(previous, branch="", worktreeBranch="", worktreeBase=initialBase)
)

// @ref examples/t3-code/mobile/docs/1130.005-composer-and-transcript.decision.md#media-presentation
// Only values move here; the root commits notices, preferences and navigation.
shape MediaUi
  readAt: number
  readVersion: number
  rendered: bool
  nativeOpen: bool
  nativeError: string
  nativeSource: string
shape DocumentReplyPlan
  next: MediaUi
  message: string
  close: bool
  toggleWrap: bool
shape MediaReplyPlan
  next: MediaUi
  message: string
  close: bool
  clearComposerFocus: bool
fn mediaUiInitial(): MediaUi = MediaUi(readAt=0, readVersion=0, rendered=true, nativeOpen=false, nativeError="", nativeSource="")
fn mediaUiOpen(previous: MediaUi, at: number): MediaUi = (
  MediaUi(previous, readAt=at, readVersion=0, rendered=true, nativeOpen=false, nativeError="", nativeSource="")
)
fn mediaUiRetry(previous: MediaUi, at: number): MediaUi = (
  MediaUi(previous, readAt=at, readVersion=previous.readVersion + 1, nativeOpen=false, nativeError="")
)
fn documentReplyPlan(previous: MediaUi, reply: option<AttachmentDocumentAction>, active: bool, identifier: string, at: number): DocumentReplyPlan = match reply {
  case some(result) => not active or result.identifier != identifier ? DocumentReplyPlan(next=previous, message="", close=false, toggleWrap=false) :
    result.operation == "native-error" ? DocumentReplyPlan(next=MediaUi(previous, nativeError=result.message), message="", close=false, toggleWrap=false) :
    result.message != "" ? DocumentReplyPlan(next=previous, message=result.message, close=false, toggleWrap=false) :
    result.removed ? DocumentReplyPlan(next=previous, message="", close=true, toggleWrap=false) :
    result.operation == "preview" or result.operation == "source" ? DocumentReplyPlan(next=MediaUi(previous, nativeError="", readAt=at, rendered=result.operation == "preview"), message="", close=false, toggleWrap=false) :
    result.operation == "word-wrap" ? DocumentReplyPlan(next=previous, message="", close=false, toggleWrap=true) :
    result.operation == "open-viewer" ? DocumentReplyPlan(next=MediaUi(previous, nativeSource=result.sourceJSON, nativeOpen=true), message="", close=false, toggleWrap=false) :
    DocumentReplyPlan(next=previous, message="", close=false, toggleWrap=false),
  case none => DocumentReplyPlan(next=previous, message="", close=false, toggleWrap=false)
}
fn mediaReplyPlan(previous: MediaUi, reply: option<MediaCompletion>, active: bool, identifier: string): MediaReplyPlan = match reply {
  case some(result) => not active or result.identifier == "" or result.identifier != identifier ? MediaReplyPlan(next=previous, message="", close=false, clearComposerFocus=false) :
    previous.nativeOpen ? MediaReplyPlan(next=MediaUi(previous, nativeOpen=false), message=result.message, close=false, clearComposerFocus=false) :
    result.message != "" ? MediaReplyPlan(next=MediaUi(previous, nativeError=result.message), message="", close=false, clearComposerFocus=false) :
    MediaReplyPlan(next=previous, message="", close=true, clearComposerFocus=false),
  case none => MediaReplyPlan(next=previous, message="", close=false, clearComposerFocus=true)
}

shape PairingUi
  host: string
  code: string
  formError: string
  expanded: string
  submitted: bool
  scannerOpen: bool
  cameraStatus: string

shape PairingReplyPlan
  next: PairingUi
  succeeded: bool
  message: string
fn pairingReplyPlan(previous: PairingUi, reply: option<Change>, operation: string): PairingReplyPlan = match reply {
  case some(result) => PairingReplyPlan(
    next=PairingUi(previous, formError=result.message, expanded=(operation == "save" and result.message == "" ? "" : previous.expanded), host=(previous.submitted and result.message == "" ? "" : previous.host), code=(previous.submitted and result.message == "" ? "" : previous.code), submitted=false),
    succeeded=previous.submitted and result.message == "",
    message=(operation == "thread-action" or operation == "attachments" ? result.message : "")
  ),
  case none => PairingReplyPlan(next=PairingUi(previous, submitted=false), succeeded=false, message="")
}
shape ModelReplyPlan
  hasReply: bool
  requestRoute: string
  message: string
  closed: bool
fn modelReplyPlan(reply: option<ComposerActionResult>): ModelReplyPlan = match reply {
  case some(result) => ModelReplyPlan(hasReply=true, requestRoute=result.requestRoute, message=result.message, closed=result.closed),
  case none => ModelReplyPlan(hasReply=false, requestRoute="", message="", closed=false)
}
shape TaskReplyPlan
  hasReply: bool
  requestRoute: string
  contextDelta: number
  alertTitle: string
  message: string
  navigation: string
  environmentId: string
  threadId: string
  nextLocation: string
fn taskReplyPlan(reply: option<NewTaskFlowResult>, operation: string): TaskReplyPlan = match reply {
  case some(result) => TaskReplyPlan(hasReply=true, requestRoute=result.requestRoute,
    contextDelta=(operation != "draft" and operation != "send" and operation != "send-alternate" ? 1 : 0),
    alertTitle=(result.alertTitle != "" ? result.alertTitle : operation == "scratch" ? "Could not start without a project" : "Could not update task"),
    message=result.message, environmentId=result.environmentId, threadId=result.threadId, nextLocation=result.nextLocation,
    navigation=(result.message != "" ? "" : result.submitted ? "thread" : result.nextLocation == "@close" ? "close" : result.nextLocation == "/" ? "home" : result.nextLocation != "" ? "push" : operation == "environment" or operation == "branch" ? "back" : "")
  ),
  case none => TaskReplyPlan(hasReply=false, requestRoute="", contextDelta=0, alertTitle="", message="", navigation="", environmentId="", threadId="", nextLocation="")
}

shape AutomationReplyPlan
  message: string
  refresh: bool
  debounce: bool
  closed: bool
  location: string
fn automationReplyPlan(reply: option<AutomationChange>, route: string): AutomationReplyPlan = match reply {
  case some(result) => AutomationReplyPlan(
    message=(result.requestRoute == route ? result.message : ""),
    refresh=(result.requestRoute == route and result.refresh),
    debounce=(result.requestRoute == route and result.debounce),
    closed=(result.requestRoute == route and result.closed),
    location=(result.requestRoute == route and not result.closed ? homeAutomationPath(result.route, result.accountKey, result.windowId, result.windowKind) : "")
  ),
  case none => AutomationReplyPlan(message="", refresh=false, debounce=false, closed=false, location="")
}
fn automationCreditHandoff(reply: option<AutomationCreditConfirmation>, route: string): AutomationCreditConfirmation = match reply {
  case some(result) => result.confirmed and result.requestRoute == route ? result : AutomationCreditConfirmation(token="", environmentId="", accountKey="", requestRoute="", confirmed=false),
  case none => AutomationCreditConfirmation(token="", environmentId="", accountKey="", requestRoute="", confirmed=false)
}
