shape PullRequestLabel
  key: string
  name: string

shape PullRequestRow
  key: string
  ref: string
  number: number
  title: string
  stateLabel: string
  conflict: string
  checksLabel: string
  reviewLabel: string
  additions: string
  deletions: string
  author: string
  repository: string
  age: string
  selected: bool
  labels: PullRequestLabel[]

shape PullRequestGroup
  key: string
  label: string
  count: number
  rows: PullRequestRow[]

shape PullRequestsData
  available: bool
  loading: bool
  error: string
  empty: string
  emptyDetail: string
  emptyAction: string
  query: string
  total: number
  groups: PullRequestGroup[]
  truncated: bool

shape PullRequestDetailLabel
  key: string
  name: string

shape PullRequestDetailBody
  id: string
  body: string

shape PullRequestDetailCheck
  key: string
  name: string
  statusLabel: string
  description: string

shape PullRequestDetailComment
  key: string
  author: string
  initial: string
  age: string
  body: string

shape PullRequestDetailEvent
  key: string
  kind: string
  title: string
  detail: string
  age: string

shape PullRequestDetailData
  open: bool
  loading: bool
  error: string
  errorTitle: string
  ref: string
  number: number
  numberLabel: string
  title: string
  repository: string
  stateLabel: string
  conflict: string
  author: string
  authorInitial: string
  updated: string
  baseBranch: string
  headBranch: string
  files: string
  additions: string
  deletions: string
  checksSummary: string
  checksTone: string
  reviewers: string[]
  labels: PullRequestDetailLabel[]
  bodies: PullRequestDetailBody[]
  hasBody: bool
  checks: PullRequestDetailCheck[]
  comments: PullRequestDetailComment[]
  commentCount: number
  commentsLabel: string
  timeline: PullRequestDetailEvent[]

component PullRequestDetail
  props
    data: PullRequestDetailData
    backAction: action
    reloadAction: action
  view
    column flex=1 min-height=0 font-family="DM Sans"
      if data.loading and data.title == ""
        column flex=1 align-items="center" justify-content="center"
          t3-archive-spinner spinner-tint="currentColor" width=20 height=20
          text "Loading pull request" margin-top=10
      else if data.error != ""
        column margin-left=16 margin-right=16 margin-top=16 padding=16 border-radius=14 role="alert"
          text (data.errorTitle != "" ? data.errorTitle : "Could not load pull request") font-weight=700
          text data.error margin-top=6
          button press=reloadAction margin-top=10 testId="pull-request-detail-retry"
            text "Try again"
      else
        scroll flex=1 min-height=0 testId="pull-request-detail-scroll" keyboardDismissMode="on-drag" scrollbar-width="none" touch-action="pan-y"
          column padding-left=16 padding-right=16 padding-top=12 padding-bottom=28 gap=10
            row align-items="center" gap=8
              text data.repository font-size=13 font-weight=700 flex=1
              text data.numberLabel font-size=13
            text data.title role="heading" aria-level=2 font-size=21 font-weight=700
            row align-items="center" gap=8
              text data.stateLabel font-size=13 font-weight=700
              if data.conflict != ""
                text data.conflict font-size=13
              if data.updated != ""
                text data.updated font-size=13
            text `${data.author}${data.headBranch != "" ? ` · ${data.headBranch} → ${data.baseBranch}` : ""}` font-size=13
            row gap=10
              if data.files != ""
                text data.files font-size=13
              if data.additions != ""
                text data.additions font-size=13
              if data.deletions != ""
                text data.deletions font-size=13
            if data.labels.length > 0
              row gap=6 flex-wrap="wrap"
                for label in data.labels key=label.key
                  text label.name font-size=12 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=999 background-color="#eef2ff"
            if data.hasBody
              column padding-top=8 gap=6
                text "Description" font-size=16 font-weight=700
                for body in data.bodies key=body.id
                  text body.body markup="markdown" font-size=15 line-height="22px"
            column padding-top=8 gap=6
              text "Checks" font-size=16 font-weight=700
              text data.checksSummary font-size=13
              for check in data.checks key=check.key
                row gap=8 align-items="flex-start"
                  text check.statusLabel font-size=13 font-weight=600
                  column flex=1 min-width=0
                    text check.name font-size=13
                    if check.description != ""
                      text check.description font-size=12
            column padding-top=8 gap=6
              text data.commentsLabel font-size=16 font-weight=700
              for comment in data.comments key=comment.key
                column padding-top=6 gap=3
                  text `${comment.author} · ${comment.age}` font-size=13 font-weight=600
                  if comment.body != ""
                    text comment.body markup="markdown" font-size=15 line-height="22px"
            if data.timeline.length > 0
              column padding-top=8 gap=6
                text "Activity" font-size=16 font-weight=700
                for event in data.timeline key=event.key
                  column padding-top=4 gap=2
                    text `${event.title}${event.age != "" ? ` · ${event.age}` : ""}` font-size=13 font-weight=600
                    if event.detail != ""
                      text event.detail font-size=13

component PullRequests
  props
    data: PullRequestsData
    reloadAction: action
    selectAction: action
    changeQuery: action
  state queryValue = ""
  state queryOwner = ""
  action editQuery(value: string)
    queryValue = value
    queryOwner = data.query
    changeQuery(value)
  action reload
    reloadAction()
  view
    column flex=1 min-height=0 font-family="DM Sans"
      row padding-left=16 padding-right=16 padding-top=4 padding-bottom=8 align-items="center" gap=8
        text "Pull Requests" role="heading" aria-level=2 font-size=20 font-weight=700 flex=1
        button press=reload aria-label="Refresh pull requests" testId="pull-requests-refresh" padding=8
          t3-symbol symbol-name="arrow.clockwise" width=18 height=18
      row padding-left=16 padding-right=16 padding-bottom=10 gap=8
        input value=(queryOwner == data.query ? queryValue : data.query) input=editQuery placeholder="Search pull requests" aria-label="Search pull requests" testId="pull-requests-search" flex=1
        button press=selectAction("state", "all") aria-label="Show all pull request states" testId="pull-requests-filter" padding=8
          t3-symbol symbol-name="line.3.horizontal.decrease.circle" width=19 height=19
      if data.error != ""
        column margin-left=16 margin-right=16 padding=16 border-radius=14 role="alert"
          text data.empty font-weight=700
          text data.emptyDetail margin-top=6
          button press=reload margin-top=10 testId="pull-requests-retry"
            text "Try again"
      else if data.loading and data.groups.length == 0
        column flex=1 align-items="center" justify-content="center"
          t3-archive-spinner spinner-tint="currentColor" width=20 height=20
          text "Loading pull requests" margin-top=10
      else if data.groups.length == 0
        column flex=1 align-items="center" justify-content="center" padding=28
          text (data.empty != "" ? data.empty : "No pull requests") role="heading" aria-level=3 font-weight=700 text-align="center"
          text (data.emptyDetail != "" ? data.emptyDetail : "Pull requests from every project in this workspace appear here.") margin-top=7 text-align="center"
      else
        scroll flex=1 min-height=0 testId="pull-requests-list"
          for group in data.groups key=group.key
            column padding-left=16 padding-right=16 padding-top=12
              row align-items="center" padding-bottom=6
                text group.label font-size=13 font-weight=700
                text `${group.count}` margin-left=5 font-size=13
              for row in group.rows key=row.key
                button press=selectAction("select", row.ref) testId=`pull-request-${row.number}` padding=12 margin-bottom=8 border-radius=14 text-align="left" background-color=(row.selected ? "#eef2ff" : "transparent")
                  column gap=4
                    row align-items="center" gap=6
                      text `#${row.number}` font-size=13 font-weight=700
                      text row.stateLabel font-size=13
                      if row.age != ""
                        text row.age font-size=12
                    text row.title font-size=16 font-weight=600
                    text `${row.repository} · ${row.author}` font-size=13
                    if row.conflict != ""
                      text row.conflict font-size=12
                    row gap=8
                      if row.additions != ""
                        text row.additions font-size=12
                      if row.deletions != ""
                        text row.deletions font-size=12
