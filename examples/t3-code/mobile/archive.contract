// @ref llp/1107.004-home-projection.decision.md#decision
// T3 Code 365aa87982 ArchivedThreadsScreen and thread-swipe-actions.
// The root owns the native header, search/filter menus and destructive confirmation.
shape ArchiveColors
  foreground: string
  muted: string
  tertiary: string
  card: string
  border: string
  groupedCard: string
  subtle: string
  separator: string
  icon: string
  iconSubtle: string
  iconMuted: string
  danger: string
  dangerBorder: string
  dangerForeground: string
  primary: string
  primaryForeground: string

shape ArchiveItem
  key: string
  kind: string
  environmentId: string
  projectId: string
  threadId: string
  title: string
  subtitle: string
  environmentLabel: string
  machineSymbol: string
  time: string
  initial: bool
  first: bool
  last: bool
  final: bool
  canOperate: bool
  favicon: string
  iconKind: string
  iconText: string
  iconColor: string
  iconSurface: string
  iconSize: number

shape ArchiveEnvironment
  id: string
  label: string

shape ArchiveData
  items: list<ArchiveItem>
  environments: list<ArchiveEnvironment>
  error: string
  loading: bool
  emptyTitle: string
  emptyDetail: string

component Archive
  props
    data: ArchiveData
    colors: ArchiveColors
    pending: bool
    loading: bool
    width: number
    reduced: bool
    refresh: action
    action: action
  state openKey = ""
  state dragKey = ""
  state offset = 0
  action close(scrollLeft: number, scrollTop: number)
    openKey = ""
    dragKey = ""
    offset = 0
  action dragged(key: string, allowed: bool, dx: number, dy: number)
    if allowed and not pending
      if dragKey == key or dy >= -10 and dy <= 10
        if dragKey != key
          offset = openKey == key ? -116 : 0
          dragKey = key
          openKey = ""
        offset = max(32 - width, min(0, offset + dx))
  action released(key: string, environmentId: string, projectId: string, threadId: string, vx: number, vy: number)
    if dragKey == key
      if offset <= 0 - max(160, (width - 32) * 0.58)
        action("delete", environmentId, projectId, threadId)
        openKey = ""
      else
        openKey = offset < -48.72 ? key : ""
      dragKey = ""
      offset = 0
  action choose(kind: string, environmentId: string, projectId: string, threadId: string)
    openKey = ""
    dragKey = ""
    offset = 0
    action(kind, environmentId, projectId, threadId)
  action reload
    openKey = ""
    dragKey = ""
    offset = 0
    refresh()
  view
    when length(data.items) == 0
      scroll flex=1 min-height=0 refresh=reload testId="archive-empty-scroll"
        column padding-left=16
          padding-right=16
          padding-top=4
          padding-bottom=32
          font-family="DM Sans"
          ArchiveError(message=data.error, colors=colors, refresh=reload)
          when (loading or data.loading) and length(data.error) == 0
            column align-items="center" padding-top=56 padding-bottom=56
              t3-archive-spinner spinner-tint=colors.icon width=20 height=20
              text "Loading archive..." margin-top=10.5
                font-size=14
                line-height="19px"
                color=colors.muted
          else
            column padding=17.5
              border-radius=22
              border-width=1
              border-style="solid"
              border-color=colors.border
              background-color=colors.card
              text data.emptyTitle font-size=18
                line-height="25px"
                font-weight=700
                color=colors.foreground
              text data.emptyDetail margin-top=7
                font-size=14
                line-height="22.75px"
                color=colors.muted
    else
      list id="archive-list"
        flex=1
        min-height=0
        virtualized=true
        estimated-item-height=62
        keyboardDismissMode="on-drag"
        refresh=reload
        scroll=close
        testId="archive-list"
        each item in data.items key = item.key
          column padding-left=16
            padding-right=16
            padding-top=(item.initial ? 4 : 0)
            padding-bottom=(item.final ? 32 : 0)
            font-family="DM Sans"
            when item.initial
              ArchiveError(message=data.error, colors=colors, refresh=reload)
            when item.kind == "project"
              row align-items="center"
                gap=8.75
                padding-left=3.5
                padding-right=3.5
                padding-top=14
                padding-bottom=7
                ArchiveProjectIcon(item=item, colors=colors)
                text item.title text-transform="uppercase"
                  flex=1
                  min-width=0
                  font-size=13
                  line-height="17px"
                  font-weight=500
                  letter-spacing=0.5
                  color=colors.muted
                  line-clamp=1
                row max-width="42%" min-width=0 align-items="center" gap=3.5
                  t3-symbol symbol-name=item.machineSymbol
                    point-size=10
                    symbol-weight="regular"
                    symbol-tint=colors.tertiary
                    width=10
                    height=10
                  text item.environmentLabel min-width=0
                    font-size=12
                    line-height="16px"
                    color=colors.tertiary
                    line-clamp=1
            else
              box position="relative"
                overflow="hidden"
                border-top-left-radius=(item.first ? 20 : 0)
                border-top-right-radius=(item.first ? 20 : 0)
                border-bottom-left-radius=(item.last ? 20 : 0)
                border-bottom-right-radius=(item.last ? 20 : 0)
                when item.canOperate and (openKey == item.key or dragKey == item.key)
                  row position="absolute" top=0 right=0 bottom=0 width=116 align-items="center"
                    ArchiveSwipeAction(
                      kind="unarchive",
                      label="Unarchive",
                      symbol="arrow.uturn.backward",
                      item=item,
                      colors=colors,
                      pending=pending,
                      choose=choose
                    )
                    ArchiveSwipeAction(
                      kind="delete",
                      label="Delete",
                      symbol="trash",
                      item=item,
                      colors=colors,
                      pending=pending,
                      choose=choose
                    )
                column translate=`${dragKey == item.key ? offset : openKey == item.key ? -116 : 0}px 0px`
                  transition=(dragKey == item.key or reduced ? "none" : "translate -exact-spring(330, 26, 0.7)")
                  pan=dragged(item.key, item.canOperate)
                  panrelease=released(item.key, item.environmentId, item.projectId, item.threadId)
                  touch-action="pan-y"
                  background-color=colors.groupedCard
                  testId=`archive-thread-${item.key}`
                  row align-items="center"
                    gap=10.5
                    padding-left=14
                    padding-right=14
                    padding-top=10.5
                    padding-bottom=10.5
                    box width=34
                      height=34
                      flex-shrink=0
                      display="flex"
                      align-items="center"
                      justify-content="center"
                      border-radius=11
                      background-color=colors.subtle
                      t3-symbol symbol-name="archivebox.fill"
                        point-size=15
                        symbol-weight="regular"
                        symbol-tint=colors.iconSubtle
                        width=15
                        height=15
                    column flex=1 min-width=0 gap=3.5
                      row align-items="center" gap=7
                        text item.title flex=1
                          min-width=0
                          font-size=16
                          line-height="22px"
                          font-weight=700
                          color=colors.foreground
                          line-clamp=1
                        text item.time min-width=30
                          text-align="right"
                          font-size=13
                          line-height="17px"
                          color=colors.tertiary
                      row align-items="center" gap=5.25
                        t3-symbol symbol-name="arrow.triangle.branch"
                          point-size=10
                          symbol-weight="regular"
                          symbol-tint=colors.iconSubtle
                          width=10
                          height=10
                        text item.subtitle min-width=0
                          font-family="Menlo"
                          font-size=12
                          line-height="16px"
                          color=colors.tertiary
                          line-clamp=1
                  when not item.last
                    box height=1 background-color=colors.separator

component ArchiveSwipeAction
  props
    kind: string
    label: string
    symbol: string
    item: ArchiveItem
    colors: ArchiveColors
    pending: bool
    choose: action
  view
    button width=58
      padding=0
      disabled=pending
      press=choose(kind, item.environmentId, item.projectId, item.threadId)
      aria-label=`${label} ${item.title}`
      testId=`archive-${kind}-${item.key}`
      column align-items="center" gap=2
        box width=36
          height=36
          border-radius=9999
          background-color=(kind == "delete" ? colors.danger : colors.primary)
          display="flex"
          align-items="center"
          justify-content="center"
          t3-symbol symbol-name=symbol
            point-size=15
            symbol-weight="regular"
            symbol-tint=(kind == "delete" ? colors.dangerForeground : colors.primaryForeground)
            width=15
            height=15
        text label font-size=11 line-height="15px" color=colors.muted

component ArchiveError
  props
    message: string
    colors: ArchiveColors
    refresh: action
  view
    when length(message) > 0
      column padding=14
        border-radius=20
        border-width=1
        border-style="solid"
        border-color=colors.dangerBorder
        background-color=colors.danger
        text "Could not load every archive" font-size=16
          line-height="23px"
          font-weight=700
          color=colors.dangerForeground
        text message margin-top=3.5 font-size=14 line-height="19px" color=colors.muted
        button press=refresh margin-top=10.5 align-self="flex-start" testId="archive-retry"
          text "Try again" font-size=14
            line-height="19px"
            font-weight=700
            color=colors.dangerForeground

component ArchiveProjectIcon
  props
    item: ArchiveItem
    colors: ArchiveColors
  state failedUrl = ""
  action failed(message: string)
    failedUrl = item.favicon
  view
    box width=18
      height=18
      flex-shrink=0
      display="flex"
      align-items="center"
      justify-content="center"
      overflow="hidden"
      when item.iconKind == "emoji"
        text item.iconText font-size=16 line-height="18px"
      else when item.iconKind == "monogram"
        box width=18
          height=18
          border-radius=4
          display="flex"
          align-items="center"
          justify-content="center"
          background-color=item.iconSurface
          text item.iconText font-size=item.iconSize
            line-height="18px"
            font-weight=700
            color=item.iconColor
      else when length(item.favicon) > 0 and failedUrl != item.favicon
        image item.favicon width=18 height=18 object-fit="contain" error=failed
      else
        t3-symbol symbol-name="folder"
          point-size=18
          symbol-weight="regular"
          symbol-tint=colors.iconMuted
          width=18
          height=18
