// SourceFileSurface365aa87982, over shared reads and mobile syntax colors.
// @ref examples/t3-code/mobile/docs/1130.006-review-and-files.decision.md#mobile-presentation
use ReviewColors from "./review-shapes.contract"
use ThreadCodeToken from "./thread-shapes.contract"

shape FileTableRun
  id: string
  kind: string
  text: string
shape FileTableCell
  id: string
  numeric: bool
  runs: FileTableRun[]
shape FileTableRow
  id: string
  header: bool
  cells: FileTableCell[]
shape FileMarkdownBlock
  id: string
  kind: string
  text: string
  language: string
  tokens: ThreadCodeToken[]
  level: number
  columns: number
  rows: FileTableRow[]

shape FileSourceRow
  id: string
  text: string
  newNumber: string
  selected: bool
  tokens: ThreadCodeToken[]

shape FileUi
  query: string
  preview: string

shape FileSnapshot
  owner: string
  revision: number
  path: string
  title: string
  subtitle: string
  loading: bool
  error: string
  contents: string
  copyContents: string
  rows: FileSourceRow[]
  maxColumns: number
  previewBlocks: FileMarkdownBlock[]
  truncated: bool
  notice: string
  markdown: bool
  initialRowId: string
  svg: bool
  svgSource: string
  svgRetry: string
  svgFailure: string
  svgSharing: bool
  svgCanRead: bool
  svgShareAction: string
  svgShareMessage: string
  svgShareReceipt: string
  fullPath: string
  relativePath: string
  svgPhase: string
  svgTitle: string
  svgDetail: string
  svgTrace: string
  svgTraceCopy: string
  svgRetrying: bool
  svgRetryAllowed: bool
  svgSymbol: string

shape FileActionResult
  owner: string
  message: string
  kind: string
  uncertain: bool

component MobileFileView
  props
    data: FileSnapshot
    requestFailed: bool
    requestPending: bool
    colors: ReviewColors
    wrap: bool
    fontSize: number
    rowHeight: number
    numberSize: number
    preview: bool
    routeId: string
    active: bool
    bodySize: number
    bodyLine: number
    refresh: action
    action: action
  view
    column flex=1 min-height=0 background-color=colors.sheet font-family="DM Sans"
      if requestFailed and not requestPending and data.rows.length == 0
        column flex=1 align-items="center" justify-content="center" padding=21 gap=7
          text "File unavailable" font-size=18 font-weight=700 color=colors.foreground
          text "This file could not be loaded." font-size=14 line-height="22.75px" text-align="center" color=colors.muted
          button "Try again" press=refresh
      else if data.svg
        if data.svgFailure == "disconnected"
          column flex=1 align-items="center" justify-content="center" padding-left=32 padding-right=32
            column max-width=320 align-items="center" gap=12
              if data.svgRetrying
                t3-archive-spinner spinner-tint=colors.iconMuted width=20 height=20
              else
                t3-symbol symbol-name=data.svgSymbol symbol-tint=colors.iconMuted width=24 height=24
              text data.svgTitle font-size=18 font-weight=700 text-align="center" color=colors.foreground
              text data.svgDetail font-size=14 text-align="center" color=colors.muted
              if data.svgTrace != ""
                button appearance="none" `Trace ID: ${data.svgTrace}` press=action(data.svgTraceCopy) aria-label=`Copy trace ID ${data.svgTrace}` aria-description="Copies the trace ID" font-size=12 color=colors.muted
              if data.svgRetryAllowed
                button "Retry now" press=action(data.svgRetry) margin-top=4 border-radius=999 background-color=colors.subtle padding-left=16 padding-right=16 padding-top=10 padding-bottom=10
        else if data.svgFailure == "failed"
          column flex=1 align-items="center" justify-content="center" padding=21 gap=7
            text "Preview unavailable" font-size=18 font-weight=700 color=colors.foreground
            text "This file may be missing, unsupported, or unavailable on this environment." font-size=14 line-height="22.75px" text-align="center" color=colors.muted
            button "Try again" press=action(data.svgRetry)
        else if data.svgSource == ""
          column flex=1 align-items="center" justify-content="center" gap=10.5
            t3-archive-spinner spinner-tint=colors.icon width=20 height=20
            text "Preparing preview..." font-size=14 color=colors.muted
        else
          t3-document-html media-source=data.svgSource flex=1 min-height=0
      else
        if data.truncated
          column padding-left=14 padding-right=14 padding-top=7 padding-bottom=7 border-bottom-width=1 border-bottom-style="solid" border-bottom-color=colors.border background-color=colors.card
            text "Partial file" font-size=10 font-weight=500 text-transform="uppercase" color=colors.muted
            text data.notice font-size=10.5 color=colors.muted
        if data.error != "" and data.rows.length == 0
          column flex=1 align-items="center" justify-content="center" padding=21 gap=7
            text "File unavailable" font-size=18 font-weight=700 color=colors.foreground
            text data.error font-size=14 line-height="22.75px" text-align="center" color=colors.muted
        else
          if (data.loading or requestPending) and data.rows.length == 0
            column flex=1 align-items="center" justify-content="center" gap=10.5
              t3-archive-spinner spinner-tint=colors.icon width=20 height=20
              text "Loading file..." font-size=14 color=colors.muted
          else
            if preview and data.markdown
              scroll flex=1 min-height=0 overflow-x="hidden" refresh=refresh
                MobileFileMarkdown(blocks=data.previewBlocks, colors=colors, owner=data.owner, path=data.path, routeId=routeId, active=active, bodySize=bodySize, bodyLine=bodyLine)
            else
              // The reference remounts its source renderer when wrapping changes.
              if wrap
                MobileFileSource(rows=data.rows, maxColumns=data.maxColumns, colors=colors, wrap=true, fontSize=fontSize, rowHeight=rowHeight, numberSize=numberSize, refresh=refresh)
              else
                MobileFileSource(rows=data.rows, maxColumns=data.maxColumns, colors=colors, wrap=false, fontSize=fontSize, rowHeight=rowHeight, numberSize=numberSize, refresh=refresh)

component MobileFileSource
  props
    rows: FileSourceRow[]
    maxColumns: number
    colors: ReviewColors
    wrap: bool
    fontSize: number
    rowHeight: number
    numberSize: number
    refresh: action
  state characterWidth = 0
  derive sourceWidth = 46 + min(32000, ceil(maxColumns * characterWidth) + 14)
  action characterSized(width: number, height: number)
    characterWidth = width / 64
  view
    column flex=1 min-height=0 min-width=0 position="relative"
      if not wrap
        text "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM" position="absolute" left=0 top=0 width="auto" font-family="monospace" font-size=fontSize white-space="pre" opacity=0 aria-hidden=true pointer-events="none" resize=characterSized
      list id="file-source" appearance="none" flex=1 min-height=0 min-width=0 overflow="auto" virtualized=true estimated-item-height=22 padding-top=(wrap ? 8 : 0) padding-bottom=rowHeight refresh=refresh
        for row in rows key=row.id
          row min-height=rowHeight min-width="100%" width=(wrap ? "100%" : `${sourceWidth}px`) align-items="start" background-color=(row.selected ? colors.selection : colors.codeBackground)
            column position="sticky" left=0 z-index=1 width=46 flex-shrink=0 align-self="stretch" background-color=colors.codeBackground
              text row.newNumber flex=1 box-sizing="border-box" padding-right=(wrap ? 10.5 : 7) text-align="right" font-family=(wrap ? "Menlo" : "monospace") font-size=numberSize line-height=`${rowHeight}px` color=colors.tertiary background-color=(row.selected ? colors.selection : colors.codeBackground)
            view flex=1 min-width=0
              text padding-left=(wrap ? 0 : 7) font-family=(wrap ? "Menlo" : "monospace") font-size=fontSize line-height=`${rowHeight}px` white-space=(wrap ? "pre-wrap" : "pre") color=colors.foreground
                if row.tokens.length == 0
                  text (row.text == "" ? " " : row.text)
                else
                  for token in row.tokens key=token.id
                    text token.text color=token.color font-weight=(wrap ? token.weight : 400) font-style=(wrap ? token.slant : "normal")


component MobileFileMarkdown
  props
    blocks: FileMarkdownBlock[]
    colors: ReviewColors
    owner: string
    path: string
    routeId: string
    active: bool
    bodySize: number
    bodyLine: number
  view
    column width="100%" min-width=0 box-sizing="border-box" padding=18 align-items="center"
      column width="100%" min-width=0 max-width=760 gap=14
        for block in blocks key=block.id
          if block.kind == "code"
            column min-width=0 overflow="hidden" border-radius=10 border-width=1 border-style="solid" border-color=colors.markdownBorder background-color=colors.codeBackground
              row min-height=42 align-items="center" justify-content="space-between" padding-left=14 padding-right=6 border-bottom-width=1 border-bottom-style="solid" border-bottom-color=colors.markdownBorder
                text (block.language == "" ? "CODE" : block.language) flex=1 min-width=0 font-family="monospace" font-size=max(10, round(bodySize * 0.8)) text-transform="uppercase" color=colors.markdownBody user-select="text"
                t3-file-code-copy route-key=routeId copy-owner=owner copy-path=path copy-block=block.id copy-text=block.text copy-language=block.language copy-active=active copy-tint=colors.markdownBody copy-success-tint=colors.markdownLink copy-background=colors.codeBackground copy-border=colors.markdownBorder width=34 height=34
              view overflow-x="auto" overflow-y="hidden" scrollbar-width="none" max-width="100%" padding-left=14 padding-right=14 padding-top=12 padding-bottom=12
                text font-family="monospace" font-size=max(10, round(bodySize * 0.8)) line-height=`${max(10, round(bodySize * 0.8)) + 6}px` white-space="pre" user-select="text" color=colors.codeForeground
                  for token in block.tokens key=token.id
                    text token.text color=token.color font-weight=token.weight font-style=token.slant
          else if block.kind == "heading"
            text block.text role="heading" aria-level=block.level font-size=fileMarkdownHeadingSize(block.level, bodySize) line-height=`${max(fileMarkdownHeadingSize(block.level, bodySize) + 6, bodyLine + 2)}px` font-weight=700 color=colors.markdownStrong user-select="text"
          else if block.kind == "table"
            view width="100%" box-sizing="border-box" overflow-x="auto" overflow-y="hidden" scrollbar-width="none" max-width="100%" min-width=0
              column width=(block.columns * 160 + 2) box-sizing="border-box" border-width=1 border-style="solid" border-color=colors.markdownBorder border-radius=8 corner-shape="-exact-continuous" overflow="hidden"
                for item in block.rows key=item.id
                  row border-top-width=(item.header ? 0 : 1) border-top-style="solid" border-top-color=colors.markdownBorder background-color=(item.header ? colors.codeBackground : "transparent")
                    for cell, index in item.cells key=cell.id
                      column width=160 flex-shrink=0 box-sizing="border-box" padding-left=10 padding-right=10 padding-top=8 padding-bottom=8 border-left-width=(index == 0 ? 0 : 1) border-left-style="solid" border-left-color=colors.markdownBorder
                        text user-select="text" overflow-wrap="break-word" font-family="DM Sans" font-size=bodySize line-height=`${bodyLine}px` font-weight=(item.header ? 700 : 400) font-variant-numeric=(cell.numeric ? "tabular-nums" : "normal") color=(item.header ? colors.markdownStrong : colors.markdownBody)
                          for run in cell.runs key=run.id
                            if run.kind == "strong"
                              text run.text font-family="DM Sans" font-size=bodySize font-weight=700 color=colors.markdownStrong
                            else
                              text run.text font-family=(run.kind == "code" ? "monospace" : "DM Sans") font-size=(run.kind == "code" ? max(12, bodySize - 2) : bodySize) color=(run.kind == "code" ? colors.codeForeground : item.header ? colors.markdownStrong : colors.markdownBody)
          else
            text block.text markup="markdown" font-size=bodySize line-height=`${bodyLine}px` color=colors.markdownBody user-select="text"

fn fileMarkdownHeadingSize(level: number, bodySize: number): number = max(level == 1 ? 16 : level == 2 ? 14 : level == 3 ? 13 : 12, round((level == 1 ? 21 : level == 2 ? 19 : level == 3 ? 17 : 15) * bodySize / 16))
