// SourceFileSurface365aa87982, over shared reads and mobile syntax colors.
// @ref llp/1107.006-review-and-files.decision.md#mobile-presentation
use ReviewColors, ReviewRow from "./review-shapes.contract"

shape FileSnapshot
  owner: string
  revision: number
  path: string
  title: string
  subtitle: string
  loading: bool
  error: string
  contents: string
  rows: list<ReviewRow>
  truncated: bool
  notice: string
  markdown: bool
  initialRowId: string

component MobileFileView
  props
    data: FileSnapshot
    colors: ReviewColors
    wrap: bool
    preview: bool
    refresh: action
  view
    column flex=1 min-height=0 background-color=colors.sheet font-family="DM Sans"
      when data.truncated
        column padding-left=14 padding-right=14 padding-top=7 padding-bottom=7 border-bottom-width=1 border-bottom-style="solid" border-bottom-color=colors.border background-color=colors.card
          text "Partial file" font-size=10 font-weight=500 text-transform="uppercase" color=colors.muted
          text data.notice font-size=10.5 color=colors.muted
      when data.error != "" and length(data.rows) == 0
        column flex=1 align-items="center" justify-content="center" padding=21 gap=7
          text "File unavailable" font-size=18 font-weight=700 color=colors.foreground
          text data.error font-size=14 line-height="22.75px" text-align="center" color=colors.muted
      else
        when data.loading and length(data.rows) == 0
          column flex=1 align-items="center" justify-content="center" gap=10.5
            t3-archive-spinner spinner-tint=colors.icon width=20 height=20
            text "Loading file..." font-size=14 color=colors.muted
        else
          when preview and data.markdown
            scroll flex=1 min-height=0 refresh=refresh
              text data.contents markup="markdown" padding=14 font-size=16 line-height="23px" color=colors.foreground
          else
            list id="file-source" flex=1 min-height=0 virtualized=true estimated-item-height=22 refresh=refresh
              each row in data.rows key=row.id
                row min-height=22 align-items="start" background-color=(row.selected ? colors.selection : colors.codeBackground)
                  text row.newNumber width=46 box-sizing="border-box" padding-right=10.5 text-align="right" font-family="Menlo" font-size=11 line-height="22px" color=colors.tertiary
                  view flex=1 min-width=0 overflow-x=(wrap ? "hidden" : "auto")
                    text padding-left=7 padding-top=2 padding-bottom=2 font-family="Menlo" font-size=12 line-height="18px" white-space=(wrap ? "pre-wrap" : "pre") color=colors.foreground
                      when length(row.tokens) == 0
                        text (row.text == "" ? " " : row.text)
                      else
                        each token in row.tokens key=token.id
                          text token.text color=token.color font-weight=token.weight font-style=token.slant
