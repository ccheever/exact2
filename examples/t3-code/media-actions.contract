// media-actions (T3 Code 1e2ecbd975, MIT; see LICENSE-T3): components/media/MediaActions.tsx,
// OpenMediaLink.tsx, MediaVideoPlayer.tsx's failure slot and FilePreviewPanel.tsx's
// WorkspaceImagePreview / WorkspaceVideoPreview (chat Markdown's media: media-markdown.contract).
// Only ShellIcon is imported, so the timeline's attachment views can use it without a cycle.
//
// `MediaActions` wraps a media node: it takes the focus (tabindex 0; a press elsewhere takes it off again,
// T3MediaFocus, hook `t3-media` kind "actions"), shows the path, URL or name as its drawn tooltip
// (MediaTip), and a right click, the Menu key or Shift+F10 opens the native menu
// (`chatlocal:media-menu`, media-actions.ts): at the pointer, or at the node's bottom-left corner
// for a key. The source is the JSON a view built (media-views.ts) or `attachment:<id>`.
use ShellIcon from "./shell-icons.contract"
use hoverTipAtFrame from "./hover-layer.contract" // MSU-1: the Markdown image's tooltip in the window's hover layer

// A media slot (media-views.ts MediaView): kind "image" / "video" / "" (none); state "loading",
// "ready" or "failed"; the open link ("" for none) and the Retry key ("" for no Retry).
shape MediaView
  kind: string
  state: string
  url: string
  name: string
  tip: string
  source: string
  failText: string
  openUrl: string
  openLabel: string
  openIcon: string
  retryKey: string
  retrying: bool

component MediaActions
  props
    source: string
    tip: string
    local: action
    testId: string
    // The id a dialog's focus guard names (dialog-trap.contract), "" on every other instance.
    elementId: string
  // MSU-1 (chat-markdown-media-and-code): the tooltip is drawn (MediaTip), as the reference's TooltipPopup; opening the menu closes it.
  state over = false
  action hover(value: bool)
    over = value
  action pointerMenu
    over = false
    local("media-menu", source, "pointer")
  // MediaActions onKeyDown: ContextMenu or Shift+F10 opens the menu at the node's bottom-left corner.
  action menuKey(k: string, e: KeyboardEvent)
    if k == "ContextMenu" or (e.shiftKey and not e.metaKey and not e.ctrlKey and not e.altKey and k == "F10")
      preventDefault()
      stopPropagation()
      over = false
      local("media-menu", source, "key")
  slot
  view
    box id=elementId data-focus-stop="enabled" tabindex=0 title="" hover=hover contextmenu=pointerMenu key=menuKey aria-label=tip hatch="t3-media" data-media-kind="actions" position="relative" max-width="100%" testId=testId
      children
      MediaTip(label=tip, shown=over)

// G4-05 (chat-markdown-media-and-code): a Markdown image once it has loaded (ChatMarkdown expandableMarkdownImageProps): the
// image is a button "Preview <alt>" (a click, Enter or Space) that opens the expanded image dialog over its document's images
// (markdownImageGallery), with the zoom-in cursor, and keeps MediaActions' menu and keys. A secondary click focuses it, as the
// reference's mousedown does. MSU-1: its tooltip is drawn by the window's hover layer (kind "code", hover-layer.contract), as
// the reference portals TooltipPopup, so the Files column or the transcript does not cut it and it flips below near the top.
component MediaPreviewActions
  inject
    rem: number
    hoverTipAt: action
  props
    source: string
    tip: string
    label: string
    open: action
    local: action
    testId: string
    // The occurrence's node id (the document's owner, its block and run): the hover layer finds it by it, and the dialog
    // gives the focus back to it.
    nodeId: string
  action hover(inside: bool)
    if tip != ""
      hoverTipAt(hoverTipAtFrame(nodeId, "code", tip, [], "top", "center", frame(nodeId), (floor(tip.length / 68) + 1) * 1.1171875 * rem + 0.625 * rem, "media-tooltip"), "trigger", inside)
  action pointerMenu
    hover(false)
    focus(nodeId)
    local("media-menu", source, "pointer")
  action menuKey(k: string, e: KeyboardEvent)
    if k == "ContextMenu" or (e.shiftKey and not e.metaKey and not e.ctrlKey and not e.altKey and k == "F10")
      preventDefault()
      stopPropagation()
      hover(false)
      local("media-menu", source, "key")
  action press
    hover(false)
    open()
  slot
  view
    button id=nodeId press=press hover=hover contextmenu=pointerMenu key=menuKey tabindex=0 aria-label=label title="" cursor="zoom-in" hatch="t3-media" data-media-kind="actions" position="relative" max-width="100%" padding=0 border-width=0 background-color="#00000000" display="flex" flex-direction="row" testId=testId
      children

// MediaActions' TooltipPopup (ui/tooltip.tsx, variant "code": monospace 11px, relaxed leading, up to 30rem wide, breaking
// anywhere): above the media, centred, after Base UI's 600 ms open delay; it takes no hits.
component MediaTip
  props
    label: string
    shown: bool
  view
    if label != ""
      row position="absolute" bottom="100%" left="-15rem" right="-15rem" padding-bottom="0.25rem" justify-content="center" pointer-events="none" z-index=140 aria-hidden=true
        column max-width="30rem" text-wrap="balance" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(shown ? 1 : 0) transition=(shown ? "opacity 150ms ease 600ms" : "opacity 0ms") pointer-events="none" testId="media-tooltip"
          text label font-family="ui-monospace" font-size="0.6875rem" line-height="1.1171875rem" text-align="left" overflow-wrap="anywhere" color="light-dark(#27272a, #f5f5f5)"

// OpenMediaLink: a small secondary button that opens the URL in the default browser.
component MediaOpenLink
  props
    url: string
    label: string
    icon: string
    dark: bool
    testId: string
  view
    if url != ""
      link href=url aria-label=label testId=testId height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(dark ? "#ffffff29" : "light-dark(#d4d4d8, #ffffff14)") background-color=(dark ? "#ffffff1a" : "light-dark(#f4f4f5, #ffffff0f)") display="flex" flex-direction="row" align-items="center" text-decoration-line="none"
        ShellIcon(name=icon, size=14, color=(dark ? "#ffffff" : "light-dark(#27272a, #f5f5f5)"))
        text label font-size="0.8125rem" line-height="1.125rem" font-weight=500 white-space="nowrap" color=(dark ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")

// MediaVideoPlayer's failure slot: the same 16:9 box as the player, "Video unavailable · <label>",
// then Retry video ("Retrying…" while it runs) and the open link. `dark` is the expanded dialog's
// black panel (EXPANDED_MEDIA_STATE_CLASS_NAME).
component MediaVideoFailure
  props
    media: MediaView
    dark: bool
    local: action
    testId: string
  view
    column role="alert" width="100%" aspect-ratio=(dark ? "auto" : "16 / 9") height=(dark ? "12rem" : "auto") min-height="7rem" padding="1rem" box-sizing="border-box" gap="0.75rem" align-items="center" justify-content="center" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(dark ? "light-dark(#e4e4e7b3, #ffffff0d)" : "light-dark(#e4e4e766, #ffffff06)") background-color=(dark ? "#000000" : "light-dark(#f4f4f566, #ffffff06)") testId=testId
      row gap="0.375rem" align-items="center" max-width="100%"
        ShellIcon(name="triangle-alert", size=14, color=(dark ? "#ffffff" : "light-dark(#71717b, #818181)"))
        text media.failText font-size="0.875rem" line-height="1.25rem" text-align="center" line-clamp=2 color=(dark ? "#ffffff" : "light-dark(#71717b, #818181)") testId=`${testId}-label`
      row flex-wrap="wrap" gap="0.5rem" align-items="center" justify-content="center"
        if media.retryKey != ""
          button press=local("media-retry", media.retryKey, media.url) disabled=media.retrying aria-label=(media.retrying ? "Retrying…" : "Retry video") testId=`${testId}-retry` height="1.75rem" padding-left="0.625rem" padding-right="0.625rem" box-sizing="border-box" gap="0.375rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(dark ? "#ffffff29" : "light-dark(#d4d4d8, #ffffff14)") background-color=(dark ? "#ffffff1a" : "light-dark(#f4f4f5, #ffffff0f)") opacity=(media.retrying ? 0.64 : 1) display="flex" flex-direction="row" align-items="center"
            svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke=(dark ? "#ffffff" : "light-dark(#27272a, #f5f5f5)") stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
              path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8M21 3v5h-5"
            text (media.retrying ? "Retrying…" : "Retry video") font-size="0.8125rem" line-height="1.125rem" font-weight=500 white-space="nowrap" color=(dark ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")
        MediaOpenLink(url=media.openUrl, label=media.openLabel, icon=media.openIcon, dark=dark, testId=`${testId}-open`)

// The Files surface's image or video file (WorkspaceImagePreview / WorkspaceVideoPreview).
component FilesMedia
  props
    media: MediaView
    local: action
  view
    if media.state == "loading"
      column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" role="status" aria-label=(media.kind == "video" ? "Loading video" : "Loading image") testId="file-media-loading"
        ShellIcon(name="loader", size=24, color="light-dark(#71717b, #818181)")
    if media.state == "failed" and media.kind == "image"
      MediaActions(source=media.source, tip=media.tip, local=local, elementId="", testId="file-image-failed")
        column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" padding-left="1.5rem" padding-right="1.5rem" box-sizing="border-box"
          text media.failText text-align="center" font-size="0.75rem" line-height="1.21875rem" color="light-dark(#e40014, #ff6467)" testId="file-image-error"
    if media.state == "ready" and media.kind == "image"
      column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" overflow="auto" padding="1rem" box-sizing="border-box" testId="file-image"
        MediaActions(source=media.source, tip=media.tip, local=local, elementId="", testId="file-image-actions")
          image media.url aria-label=media.name error=local("media-image-error", media.url) max-width="100%" max-height="100%" object-fit="contain" testId="file-image-picture"
    if media.kind == "video" and media.state != "loading"
      column flex=1 min-height=0 width="100%" align-items="center" justify-content="center" overflow="hidden" padding="1rem" box-sizing="border-box" testId="file-video"
        column width="100%" max-width="64rem" align-items="center"
          MediaActions(source=media.source, tip=media.tip, local=local, elementId="", testId="file-video-actions")
            if media.state == "failed"
              MediaVideoFailure(media=media, dark=false, local=local, testId="file-video-failed")
            else
              video media.url controls=true playsinline=true preload="metadata" aria-label=media.name error=local("media-video-error", media.url) width="100%" aspect-ratio="16 / 9" background-color="#000000" object-fit="contain" testId="file-video-player"
