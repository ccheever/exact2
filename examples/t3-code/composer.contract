use Snapshot from "./shapes.contract"
use QueueEditAttachment from "./composer-shapes.contract"
use Viewport from "./shapes.contract"
use ProviderInstanceMark from "./icons.contract"
use SnapshotDrafts from "./snapshot.contract"
use ComposerFooter from "./composer-controls.contract"
use ComposerEditorView from "./composer-editor.contract"
use PromptLengthValidation from "./composer-editor.contract"
use AttachmentUrl from "./timeline-attachments.contract"

// T3's ChatComposer: the composer card, its toolbar controls (ComposerControl.tsx
// "sm"), the send/stop actions (ComposerPrimaryActions.tsx) and the traits and
// runtime-mode menus (TraitsPicker.tsx, ChatComposer.tsx footer). Colours are
// the served build's tokens: foreground #27272a/#f5f5f5, muted #71717a/#818181,
// border #e4e4e7/white 6%, accent #f4f4f5/white 4%.

// Lucide geometry (24px grid) for the composer's own glyphs.
component CmpIcon
  props
    name: string
    size: number
    color: string
    weight: number
  view
    svg width=`${size / 16}rem` height=`${size / 16}rem` viewBox="0 0 24 24" color=color fill="none" stroke="currentColor" stroke-width=weight stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      when name == "chevron-down"
        path d="m6 9 6 6 6-6"
      when name == "chevron-right"
        path d="m9 18 6-6-6-6"
      when name == "lock" or name == "lock-open"
        rect x=3 y=11 width=18 height=11 rx=2 ry=2
        path d=(name == "lock" ? "M7 11V7a5 5 0 0 1 10 0v4" : "M7 11V7a5 5 0 0 1 9.9-1")
      when name == "pen-line"
        path d="M13 21h8M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497z"
      when name == "sparkles"
        path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594zM20 2v4M22 4h-4"
        circle cx=4 cy=20 r=2
      when name == "bot"
        path d="M12 8V4H8M2 14h2M20 14h2M15 13v2M9 13v2"
        rect x=4 y=8 width=16 height=12 rx=2
      when name == "pencil-ruler"
        path d="M13 7 8.7 2.7a2.41 2.41 0 0 0-3.4 0L2.7 5.3a2.41 2.41 0 0 0 0 3.4L7 13M8 6l2-2M18 16l2-2M17 11l4.3 4.3c.94.94.94 2.46 0 3.4l-2.6 2.6c-.94.94-2.46.94-3.4 0L11 17M21.174 6.812a1 1 0 0 0-3.986-3.987L3.842 16.174a2 2 0 0 0-.5.83l-1.321 4.352a.5.5 0 0 0 .623.622l4.353-1.32a2 2 0 0 0 .83-.497zM15 5l4 4"
      when name == "search"
        path d="m21 21-4.34-4.34"
        circle cx=11 cy=11 r=8
      when name == "star" or name == "star-filled"
        path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" fill=(name == "star-filled" ? "currentColor" : "none")

component ComposerCard
  props
    editor: ComposerEditorView
    data: Snapshot
    viewportWidth: number
    text: string
    resting: bool
    busy: bool
    narrow: bool
    keyModels: string
    modelsOpen: bool
    optionsOpen: string
    write: action
    send: action
    stop: action
    onFocus: action
    onBlur: action
    openModels: action
    openOptions: action
    removeSnapshot: action
    // r4-composer: app.contract titleMenuPick, for the shelf's "ui:confirm" before removing a referenced image.
    askRemove: action
    interaction: action
    command: action
    openProviders: action
    // A sidebar thread dragged over the composer (threadContextDrag.ts data-thread-context-over).
    contextOver: bool
    // composer-fidelity G12a: signed URLs for the queued edit's kept images.
    urls: list<AttachmentUrl>
  derive sendable = data.canSend and (text != "" or length(data.snapshotDrafts) > 0)
  view
    column width="100%" border-radius="1.375rem" border-style="solid" border-width=1 border-color=(contextOver ? "light-dark(#1b4ed8b3, #346bf1b3)" : (data.look.themed ? data.look.border : "light-dark(#00000014, #ffffff0d)")) background-color=(data.look.themed ? data.look.popover : "light-dark(#fefefe, #101010)") box-shadow="0 12px 28px -18px light-dark(#00000066, #00000000), inset 0 1px 0 0 light-dark(#00000000, #ffffff08)" box-sizing="border-box" testId="composer-surface" position="relative" hook="t3-frame" data-frame="card"
      // bg-accent/45 and ring-primary/70 while a thread is held over the composer.
      // composer-fidelity G9: ultrathink-frame, a static 2pt spectrum ring over the card's edge (index.css .ultrathink-frame::before:
      // the 120deg six-stop spectrum at 220% size shows its first 45%; saturate(.82) brightness(.92) baked into the stops). An SVG
      // stroke 4pt wide on the card's outline, clipped to the card, leaves the inner 2pt; SVG takes no presses.
      when data.composer.ultrathink
        svg position="absolute" left=-1 top=-1 width="calc(100% + 2px)" height="calc(100% + 2px)" overflow="hidden" pointer-events="none" aria-hidden=true testId="composer-ultrathink-frame"
          defs
            linearGradient id="ultrathink-spectrum" x1=0 y1=0 x2=1 y2=1
              stop offset=0 stop-color="#d76868"
              stop offset=0.396 stop-color="#d49324"
              stop offset=0.792 stop-color="#33ae61"
              stop offset=1 stop-color="#2da87c"
          rect x=0 y=0 width="100%" height="100%" rx=22 ry=22 fill="none" stroke="url(#ultrathink-spectrum)" stroke-width=4
      when contextOver
        box position="absolute" left=0 top=0 right=0 bottom=0 border-radius="1.3125rem" background-color="light-dark(#f4f4f573, #ffffff05)" aria-hidden=true testId="composer-context-over"
      column padding-top=(resting ? "0.4375rem" : "1rem") padding-bottom=(resting ? "0.4375rem" : "0.5rem") padding-left="1rem" padding-right=(resting ? "3.5rem" : "1rem") gap="0.5rem" box-sizing="border-box" width="100%"
        // SnapShot attachment frames are the snapshot lane's (snapshot.contract).
        SnapshotDrafts(images=data.snapshotDrafts, disabled=(busy or data.uncertain), remove=removeSnapshot, ask=askRemove, videos=data.composerVideos, command=command)
        // composer-fidelity G12a: the queued message's own attachments while it is edited (removable; new ones attach as usual).
        when data.composer.queueEditing != "" and length(data.composer.queueEditAttachments) > 0
          row width="100%" gap="0.5rem" flex-wrap="wrap" align-items="center" testId="queued-edit-attachments"
            each item in data.composer.queueEditAttachments key=item.id
              QueuedEditChip(item=item, urls=urls, disabled=busy, remove=command("cclocal:queued-attachment-remove", item.id, "", 0))
        // The web's ::placeholder colour (muted at 75%) is not a row: the text
        // sits behind the transparent field, which still takes every press.
        box position="relative" width="100%"
          when text == ""
            text data.composer.placeholder position="absolute" left=0 top=0 right=0 font-size="0.875rem" line-height=(resting ? "2rem" : "1.421875rem") line-clamp=(resting ? 1 : 3) color="light-dark(#71717abf, #818181bf)" aria-hidden=true testId="composer-placeholder"
          textarea id="composer" testId="composer" hook="t3-composer" data-snapshot-owner=data.snapshotOwner value=text input=write focus=onFocus blur=onBlur aria-label="Message" aria-description=data.composer.placeholder width="100%" margin-top=(resting ? "0px" : "-0.25rem") margin-bottom=(resting ? "0px" : "0.25rem") field-sizing=(resting ? "fixed" : "content") height=(resting ? "2rem" : "auto") min-height=(resting ? "2rem" : "4.375rem") max-height=(resting ? "2rem" : "12.5rem") font-size="0.875rem" line-height=(resting ? "2rem" : "1.421875rem") padding=0 border-width=0 box-sizing="border-box" background-color="#00000000" color="light-dark(#27272a, #f5f5f5)" caret-color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false"
      // The prompt editor's lane (composer-editor.contract): the length line,
      // and ⇧⇥'s plan toggle as a key button the native editor presses.
      when editor.promptLimit != "" and not resting
        PromptLengthValidation(message=editor.promptLimit)
      when data.composer.planVisible
        button hook="t3-composer-key" data-anchor="plan" press=interaction(data.composer.planActive ? "default" : "plan") disabled=(busy or not data.connected or data.running) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-plan-key"
          text "composer-plan-key" font-size=1
        button hook="t3-composer-key" data-anchor="mode-plan" press=interaction("plan") disabled=(busy or not data.connected or data.running) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-mode-plan-key"
          text "composer-mode-plan-key" font-size=1
        button hook="t3-composer-key" data-anchor="mode-default" press=interaction("default") disabled=(busy or not data.connected or data.running) position="absolute" left=0 top=0 width=1 height=1 overflow="hidden" padding=0 border-width=0 opacity=0 aria-hidden=true testId="composer-mode-default-key"
          text "composer-mode-default-key" font-size=1
      ComposerFooter(data=data, viewportWidth=viewportWidth, text=text, resting=resting, busy=busy, narrow=narrow, keyModels=keyModels, modelsOpen=modelsOpen, optionsOpen=optionsOpen, send=send, stop=stop, openModels=openModels, openOptions=openOptions, interaction=interaction, command=command, openProviders=openProviders)

// composer-fidelity G12a: one attachment the queued edit keeps (ChatView composerEditingQueuedAttachments):
// an image's 56pt thumbnail or a file's name, with its remove button.
component QueuedEditChip
  props
    item: QueueEditAttachment
    urls: list<AttachmentUrl>
    disabled: bool
    remove: action
  view
    row position="relative" height=(item.image ? "3.5rem" : "2rem") min-width=(item.image ? "3.5rem" : "0px") max-width="13.75rem" gap="0.375rem" align-items="center" padding-left=(item.image ? "0px" : "0.5rem") padding-right=(item.image ? "0px" : "1.75rem") box-sizing="border-box" overflow="hidden" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#e4e4e7cc, #ffffff14)" background-color="light-dark(#fcfcfcb3, #0a0a0ab3)" testId=`queued-edit-attachment-${item.id}`
      when item.image
        box width="3.5rem" height="3.5rem"
          each entry in filter(urls, (entry) => entry.id == item.id) key=entry.id
            image entry.url aria-label=item.name width="100%" height="100%" object-fit="cover"
      else
        svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="light-dark(#71717a, #818181)" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
          path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7ZM14 2v4a2 2 0 0 0 2 2h4"
        text item.name font-size="0.75rem" line-height="1rem" color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
      button press=remove disabled=disabled aria-label=`Remove ${item.name}` testId=`queued-edit-remove-${item.id}` position="absolute" right="0.25rem" top="0.25rem" width="1.25rem" height="1.25rem" padding=0 border-radius="0.625rem" border-width=0 background-color="light-dark(#ffffffe6, #18181be6)" display="flex" align-items="center" justify-content="center"
        svg width="0.75rem" height="0.75rem" viewBox="0 0 24 24" color="light-dark(#27272a, #f5f5f5)" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
          path d="M18 6 6 18M6 6l12 12"
