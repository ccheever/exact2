// Appearance → Typography: FontFamilyPicker (lane settings-a). A SelectButton that
// opens a 288pt combobox: Search fonts…, the default family first with its
// "default" tag, then the families this app can draw, each in its own face, a
// check on the one in use, and "No fonts found." when the search misses.
use CoreOption from "./settings-core.contract"
use CorePalette from "./settings-core.contract"
use CoreIcon from "./settings-core.contract"

component FontFamilyPicker
  props
    rowId: string
    label: string
    value: string
    families: list<CoreOption>
    pal: CorePalette
    disabled: bool
    choose: action
  state query = ""
  action search(next: string)
    query = next
  view
    box position="relative" flex-shrink=0
      button popovertarget=`font-picker-${rowId}` disabled=disabled role="combobox" aria-label=label id=`setting-${rowId}-family` testId=`setting-${rowId}-family` border-width=0 padding=0 background-color="#00000000"
        row justify-content="space-between" align-items="center" gap="0.5rem" width="11rem" height="1.75rem" padding-left="0.5625rem" padding-right="0.3125rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.input background-color=pal.field box-shadow="0 1px 2px #0000000d" box-sizing="border-box" opacity=(disabled ? 0.64 : 1)
          text value font-size="0.875rem" line-height="1.25rem" color=pal.text line-clamp=1 white-space="nowrap" flex-shrink=1 min-width=0
          box opacity=0.5 flex-shrink=0
            CoreIcon(name="chevron-down", size=12, color=pal.text)
      // ComboboxPopup align end: the popup's right edge meets the trigger's. Escape closes it (the host's light
      // dismiss) and Settings stays: the popup is the window's modal scope while it shows, so Back's Escape shortcut
      // does not take the key first (Base UI's dismissal prevents it; settings-escape-and-nav).
      column id=`font-picker-${rowId}` popover="auto" aria-modal=true position="absolute" top="100%" right=0 margin-top="0.25rem" width="18rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color=pal.popoverBorder background-color=pal.popover box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=label testId=`font-picker-${rowId}`
        column padding-top="0.625rem" padding-left="0.75rem" padding-right="0.75rem" box-sizing="border-box" width="100%"
          row height="2.0625rem" align-items="center" gap="0.25rem" padding-bottom="0.375rem" box-sizing="border-box" border-bottom-width=1 border-bottom-style="solid" border-color=pal.border
            CoreIcon(name="search", size=16, color=pal.muted)
            input value=query input=search placeholder="Search fonts…" aria-label="Search fonts" spellcheck="false" autocorrect="off" testId=`font-picker-${rowId}-search` flex=1 min-width=0 height="1.625rem" padding=0 border-width=0 background-color="#00000000" font-size="0.875rem" line-height="1.625rem" color=pal.text
        scroll max-height="18rem" width="100%"
          column padding="0.25rem" width="100%" box-sizing="border-box"
            when length(filter(families, (family) => (query == "" or (family.value != "" and includes(family.icon, trim(query)))))) == 0
              text "No fonts found." font-size="0.875rem" line-height="1.25rem" text-align="center" padding="0.5rem" color=pal.muted testId=`font-picker-${rowId}-empty`
            each family in families key=family.id
              when query == "" or (family.value != "" and includes(family.icon, trim(query)))
                button press=choose(family.value) popovertarget=`font-picker-${rowId}` popovertargetaction="hide" role="option" aria-selected=family.selected testId=`font-picker-${rowId}-${family.id}` display="flex" flex-direction="row" align-items="center" justify-content="space-between" gap="0.5rem" width="100%" height="1.875rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.375rem" background-color="#00000000"
                  text family.label font-family=(family.detail == "ui-serif" ? "ui-serif" : family.detail == "ui-rounded" ? "ui-rounded" : family.detail == "serif" ? "serif" : family.detail == "sans-serif" ? "sans-serif" : family.detail == "ui-monospace" ? "ui-monospace" : family.detail == "monospace" ? "monospace" : "system-ui") font-size="0.875rem" line-height="1.25rem" color=pal.text line-clamp=1 min-width=0 flex=1
                  row gap="0.375rem" align-items="center" flex-shrink=0
                    when family.value == ""
                      text "default" font-size="0.625rem" line-height="0.875rem" color=pal.muted opacity=0.6
                    when family.selected
                      CoreIcon(name="check", size=14, color=pal.muted)
