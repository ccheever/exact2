// The Pull Requests page's row extras (pr-handoffs-and-quick-actions), drawn from pages-pr-quick.ts:
// the Shift quick actions (PullRequestSpeedActions: a group of xs buttons after the row, shown while
// Shift alone is held and while one of them runs), the checks indicator that opens the checks
// popover (PullRequestChecksPopover on a listing row: headline, the checks needing attention and
// running, the completed ones behind "Show all"), and the stack indicator "n/m" that opens the stack
// menu (PullRequestStackPopover: Stack #N, the layers top-down, "↳ base"). Sources: T3 Code (MIT,
// see LICENSE-T3) components/pullRequest/{PullRequestSpeedActions,PullRequestChecksPopover,
// PullRequestStackPopover,PullRequestStackLayers,PullRequestStackHeader}.tsx, ui/{button,popover,menu}.tsx.
use PgIcon from "./pages-icons.contract"
use Tip from "./shell-tip.contract"
use R6Check from "./r6-pr-shapes.contract"
use KmItem from "./menu-keys.contract"
use KeyMenu from "./menu-keys.contract"
use kmOpenKey from "./menu-keys.contract"

keyframes pqSpin
  from rotate=0
  to rotate=360

shape PrSpeedAction
  key: string
  action: string
  label: string
  icon: string
  destructive: bool
  disabled: bool
  tooltip: string
  aria: string
  value: string
// A stack layer as pages-pr-stack.ts layerView gives it (PrStackLayer's fields; that file's `use`s would come back here).
shape PqStackLayer
  key: string
  number: number
  ref: string
  title: string
  detail: string
  compact: string
  state: string
  current: bool
shape PrChecksPopover
  ref: string
  headline: string
  loading: bool
  error: string
  empty: bool
  rows: list<R6Check>
  collapsible: bool
  expanded: bool
shape PrStackPopover
  ref: string
  number: number
  label: string
  notice: string
  noticeText: string
  retry: bool
  layers: list<PqStackLayer>
  base: string
  message: string

fn pqInk(): string = "light-dark(#27272a, #f5f5f5)"
fn pqMuted(): string = "light-dark(#71717b, #818181)"
fn pqDanger(): string = "light-dark(#e40014, #ff6467)"
fn pqTone(state: string): string = state == "draft" ? "light-dark(#71717b, #9f9fa9cc)" : state == "closed" ? "light-dark(#e7000b, #ffa2a2e6)" : state == "merged" ? "light-dark(#7f22fe, #c4b4ffe6)" : "light-dark(#009966, #5ee9b5e6)"
fn pqIcon(state: string): string = state == "draft" ? "git-pull-request-draft" : state == "closed" ? "git-pull-request-closed" : state == "merged" ? "git-merge" : "git-pull-request-arrow"
// CHECK_STATUS_PRESENTATION (one check) and CHECKS_STATE_PRESENTATION (the rollup).
fn pqCheckTone(status: string): string = status == "success" ? "light-dark(#009966, #5ee9b5e6)" : status == "failure" or status == "cancelled" ? "light-dark(#fb2c36, #fb414a)" : status == "action-required" ? "light-dark(#e17100, #ffb900e6)" : "light-dark(#71717bb3, #818181b3)"
fn pqCheckIcon(status: string): string = status == "success" ? "circle-check" : status == "failure" or status == "cancelled" ? "circle-x" : status == "action-required" ? "circle-dot" : "circle-dashed"
fn pqChecksIcon(checks: string): string = checks == "failing" ? "circle-x" : checks == "pending" ? "circle-dot" : "circle-check"
fn pqChecksTone(checks: string): string = checks == "failing" ? "light-dark(#e40014, #fb414a)" : checks == "pending" ? "light-dark(#e17100, #ffb900e6)" : "light-dark(#009966, #5ee9b5e6)"

// The group after the row's selection area: "Quick actions for pull request #N".
component PrQuickActions
  props
    actions: list<PrSpeedAction>
    number: number
    pending: bool
    act: action
  view
    row flex-shrink=0 align-items="center" gap="0.25rem" padding-right="0.75rem" role="group" aria-label=`Quick actions for pull request #${number}` testId=`pr-quick-${number}`
      each item in actions key=item.key
        PrQuickButton(item=item, number=number, pending=pending, act=act)

// Button size="xs": variant "destructive-outline" for Close, "outline" for the rest; a spinner while it runs.
component PrQuickButton
  props
    item: PrSpeedAction
    number: number
    pending: bool
    act: action
  state over = false
  action hover(value: bool)
    over = value
  view
    Tip(label=item.tooltip, side="top", align="center", offset=20)
      button press=act("quick", item.value) hover=hover disabled=item.disabled aria-label=item.aria testId=`pr-quick-${number}-${item.key}` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" gap="0.25rem" border-radius="0.5rem" border-width=1 border-style="solid" border-color=(item.destructive and over and not item.disabled ? "light-dark(#fb2c3652, #fb414a52)" : "light-dark(#d4d4d8, #ffffff14)") background-color=(over and not item.disabled ? (item.destructive ? "light-dark(#fb2c360a, #fb414a0a)" : "light-dark(#f4f4f580, #ffffff0d)") : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" opacity=(item.disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
        when pending
          box width="0.75rem" height="0.75rem" flex-shrink=0 display="flex" animation="pqSpin 1s linear infinite" aria-hidden=true
            svg width="0.75rem" height="0.75rem" viewBox="0 0 24 24" color=(item.destructive ? pqDanger() : pqInk()) fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
              path d="M21 12a9 9 0 1 1-6.219-8.56"
        else
          PgIcon(name=item.icon, size=12, color=(item.destructive ? pqDanger() : pqInk()))
        text item.label font-size="0.75rem" line-height="1rem" font-weight=500 white-space="nowrap" color=(item.destructive ? pqDanger() : pqInk())

// The checks indicator (Checks: <headline>) and its popover; the checks behind it are read when it opens.
component PrRowChecks
  props
    rowRef: string
    popId: string
    checks: string
    label: string
    headline: string
    popover: PrChecksPopover
    scheme: string
    control: action
  view
    column position="relative" flex-shrink=0 pointer-events="auto"
      button press=control("quick-checks", rowRef) popovertarget=popId aria-label=label testId=`${popId}-trigger` width="0.875rem" height="0.875rem" padding=0 border-width=0 background-color="#00000000" display="flex" align-items="center" justify-content="center" cursor="pointer"
        PgIcon(name=pqChecksIcon(checks), size=14, color=pqChecksTone(checks))
      row id=popId popover="auto" position="absolute" padding-top="0.25rem" align-items="flex-start" testId=`${popId}-layer`
        column width="20rem" box-sizing="border-box" padding="1rem" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #121212)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 10px 15px -3px #0000001a, 0 4px 6px -4px #0000001a") role="dialog" aria-label=headline testId=popId
          text headline font-size="0.875rem" line-height="1.25rem" font-weight=500 color=pqInk() margin-bottom="0.5rem"
          when popover.ref != rowRef or popover.loading
            text "Loading checks…" font-size="0.75rem" line-height="1rem" color=pqMuted() testId=`${popId}-loading`
          else
            when popover.error != ""
              text popover.error font-size="0.75rem" line-height="1rem" color=pqMuted()
            else
              when popover.empty
                text "No checks reported" font-size="0.75rem" line-height="1rem" color=pqMuted()
              else
                column width="100%" max-height="16rem" overflow-y="auto" gap="0.25rem" role="list"
                  each check in popover.rows key=check.key
                    PqCheckRow(check=check)
                when popover.collapsible
                  button press=control("quick-checks-all", rowRef) aria-expanded=popover.expanded testId=`${popId}-all` align-self="flex-start" margin-top="0.125rem" height="1.5rem" padding-left="0.5rem" padding-right="0.5rem" box-sizing="border-box" border-width=0 border-radius="0.5rem" background-color="#00000000" display="flex" flex-direction="row" align-items="center"
                    text (popover.expanded ? "Show less" : "Show all") font-size="0.75rem" line-height="1rem" font-weight=500 color=pqInk()

// The stack indicator "n/m" and its menu; the stack is read when it opens.
component PrRowStack
  props
    rowRef: string
    popId: string
    label: string
    ariaLabel: string
    tip: string
    popover: PrStackPopover
    scheme: string
    control: action
    select: action
  // fix-keyboard-focus: the stack menu's keyboard (menu-keys.contract).
  state keyed = 0
  derive layerItems = popover.ref != rowRef ? [] : concat((popover.retry ? [KmItem(id=`${popId}-retry`, label="Retry stack refresh")] : []), map(popover.layers, (layer) => KmItem(id=`${popId}-layer-${layer.number}`, label=layer.title)))
  action triggerKey(k: string)
    if kmOpenKey(k)
      keyed = keyed + 1
  view
    column position="relative" flex-shrink=0 pointer-events="auto"
      Tip(label=tip, side="top", align="center", offset=20)
        button press=control("quick-stack", rowRef) popovertarget=popId key=triggerKey aria-label=ariaLabel testId=`${popId}-trigger` height="1rem" padding=0 border-width=0 background-color="#00000000" gap="0.25rem" display="flex" flex-direction="row" align-items="center" cursor="pointer"
          PgIcon(name="layers", size=12, color=pqMuted())
          text label font-size="0.75rem" line-height="1rem" color=pqMuted() white-space="nowrap" font-variant-numeric="tabular-nums"
      row id=popId popover="auto" position="absolute" padding-top="0.25rem" align-items="flex-start" testId=`${popId}-layer`
        column width="18rem" padding="0.25rem" box-sizing="border-box" border-radius="0.625rem" border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffff, #121212)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" aria-label=ariaLabel testId=popId
          KeyMenu(menuId=`${popId}-keys`, items=layerItems, keyed=keyed, gap="0px", modal=true)
            row width="100%" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" box-sizing="border-box" justify-content="space-between" align-items="center" gap="0.5rem"
              text (popover.ref == rowRef ? popover.label : "") font-size="0.75rem" line-height="1rem" font-weight=500 color=pqMuted()
              when popover.ref == rowRef and popover.noticeText != ""
                Tip(label=popover.notice, side="top", align="center", offset=20)
                  text popover.noticeText role="status" font-size="0.75rem" line-height="1rem" color=pqMuted() testId=`${popId}-notice`
            when popover.ref != rowRef
              text "Loading stack…" padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.375rem" font-size="0.75rem" line-height="1rem" font-weight=500 color=pqMuted()
            else
              when popover.message != ""
                text popover.message padding-left="0.5rem" padding-right="0.5rem" padding-bottom="0.375rem" font-size="0.75rem" line-height="1rem" font-weight=500 color=pqMuted() testId=`${popId}-message`
              when popover.retry
                PqStackItem(icon="", label="Retry stack refresh", detail="", state="", current=false, popId=popId, press=control("quick-stack-retry", rowRef), testId=`${popId}-retry`)
              when length(popover.layers) > 0
                column width="100%" max-height="20rem" overflow-y="auto"
                  each layer in popover.layers key=layer.key
                    PqStackItem(icon=pqIcon(layer.state), label=layer.title, detail=layer.detail, state=layer.state, current=layer.current, popId=popId, press=select(layer.ref), testId=`${popId}-layer-${layer.number}`)
                  text popover.base padding-left="0.5rem" padding-right="0.5rem" padding-top="0.375rem" padding-bottom="0.375rem" font-size="0.75rem" line-height="1rem" font-weight=500 color=pqMuted() testId=`${popId}-base`

// MenuItem: a layer (state glyph, title over "#n · branch · State", a check on this row's) or Retry.
component PqStackItem
  props
    icon: string
    label: string
    detail: string
    state: string
    current: bool
    popId: string
    press: action
    testId: string
  state over = false
  state lit = false
  action hover(value: bool)
    over = value
  action focused(on: bool)
    lit = on
  view
    button id=testId press=press popovertarget=popId popovertargetaction="hide" hover=hover focus=focused(true) blur=focused(false) role="menuitem" aria-current=(current ? "true" : "") testId=testId width="100%" min-height="1.75rem" padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" box-sizing="border-box" gap="0.5rem" border-radius="0.375rem" border-width=0 background-color=(over or lit ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center"
      when icon != ""
        PgIcon(name=icon, size=16, color=pqTone(state))
      column flex=1 min-width=0 align-items="flex-start"
        text label font-size="0.875rem" line-height="1.25rem" color=pqInk() width="100%" min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        when detail != ""
          text detail font-size="0.75rem" line-height="1rem" color=pqMuted() width="100%" min-width=0 text-align="left" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      when current
        PgIcon(name="check", size=14, color=pqInk())

// One check: its status (the spinner while it runs), its name (the host's description as its tooltip), the label and Details.
component PqCheckRow
  props
    check: R6Check
  view
    row width="100%" height="1rem" gap="0.5rem" align-items="center" role="listitem"
      when check.status == "pending"
        box width="0.875rem" height="0.875rem" flex-shrink=0 display="flex" animation="pqSpin 1s linear infinite" aria-label="Loading"
          svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" color="#fe9a00" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M21 12a9 9 0 1 1-6.219-8.56"
      else
        PgIcon(name=pqCheckIcon(check.status), size=14, color=pqCheckTone(check.status))
      box flex=1 min-width=0 display="flex"
        Tip(label=check.description, side="top", align="center", offset=20)
          text check.name min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size="0.75rem" line-height="1rem" color=pqInk()
      text check.label flex-shrink=0 font-size="0.75rem" line-height="1rem" color=pqMuted()
      when check.url != ""
        link cursor="pointer" href=check.url aria-label=`Details: ${check.name}` flex-shrink=0 text-decoration-line="none"
          text "Details" font-size="0.75rem" line-height="1rem" color="light-dark(#1b4ed8, #346bf1)"
