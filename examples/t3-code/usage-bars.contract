use CnTooltip from "./settings-b-kit.contract"
use TipBubble from "./shell-tip.contract"

// The provider limits as bars, T3 Code 1e2ecbd975 (MIT, see LICENSE-T3):
// apps/web/src/components/usage/UsageLimits.tsx (PaceIcon, WindowBar, LimitWindows compact,
// ResetCredits, ResetCreditDialog) and chat/ComposerUsageLimits.tsx (AccountSummary,
// UsageLimitsBannerBody). The figures, pace and wording come from composer-controls-usage.ts
// (usage-limits.ts, reset-credits.ts); the Usage page's pooled view reuses PaceIcon and the
// bar colours. The base UI tooltips (600 ms open delay) are TipBubble cards in paint order.

// One window as composer-controls-usage.ts windowView presents it; `timeLeft` is -1 without a clock.
shape UsageWindow
  id: string
  label: string
  remaining: number
  timeLeft: number
  pace: string
  paceLabel: string
  resetsIn: string
  summary: string
  tipFigures: string
  tipResets: string
// One account of the /usage-limits report (accountViews). `redact` holds a label with an address,
// shown as `redactMask` until clicked; `label` is the plain label otherwise; `plan` is " · plan".
shape UsageAccount
  key: string
  // The account's place in the report: its testIds and focus target never carry an id that may hold an address.
  slot: string
  showLabel: bool
  label: string
  redact: string
  redactMask: string
  plan: string
  notice: string
  windows: list<UsageWindow>
  light: string
  dark: string
  manage: bool
  credits: string
  showCredits: bool
  canRedeem: bool
  busy: bool
  status: string

// PaceIcon: TrendingUp / Gauge / TrendingDown at 14 pt, muted, its words on hover.
component PaceIcon
  props
    pace: string
    label: string
  state over = false
  action hover(inside: bool)
    over = inside
  view
    box position="relative" display="flex" flex-shrink=0 hover=hover role="img" aria-label=label testId=`usage-pace-${pace}`
      svg width="0.875rem" height="0.875rem" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" color="light-dark(#71717b, #818181)" aria-hidden=true
        when pace == "ahead"
          path d="M16 7h6v6"
          path d="m22 7-8.5 8.5-5-5L2 17"
        when pace == "on"
          path d="m12 14 4-4"
          path d="M3.34 19a10 10 0 1 1 17.32 0"
        when pace == "under"
          path d="M16 17h6v-6"
          path d="m22 17-8.5-8.5-5 5L2 7"
      TipBubble(label=label, side="top", align="center", offset=18, inset=0, shown=over)

// WindowBar: a full-width bar from the window's start to its reset. The fill is the share of
// quota left; the hairline is how much of the window's time is left, which is where even
// spending would have put the fill. It takes the focus (tabIndex 0) and names its figures.
component WindowBar
  props
    slot: string
    window: UsageWindow
    light: string
    dark: string
  state over = false
  action hover(inside: bool)
    over = inside
  view
    box position="relative" height="1.5rem" min-width=0 border-radius="9999px" tabindex=0 role="img" aria-label=window.summary hover=hover cursor="default" testId=`usage-bar-${slot}-${window.id}`
      box position="absolute" left=0 right=0 top="0.375rem" bottom="0.375rem" border-radius="9999px" background-color="light-dark(#fafafa, #ffffff08)"
      when window.remaining > 0
        box position="absolute" left=0 top="0.375rem" bottom="0.375rem" width=`${window.remaining}%` border-radius="9999px" background-color=`light-dark(${light}, ${dark})` testId=`usage-bar-fill-${slot}-${window.id}`
      when window.timeLeft >= 0
        box position="absolute" top="0.125rem" bottom="0.125rem" left=`${window.timeLeft}%` width=1 margin-left="-0.5px" background-color="light-dark(#27272a99, #f5f5f599)" aria-hidden=true testId=`usage-bar-line-${slot}-${window.id}`
      row position="absolute" bottom="1.75rem" left="-10rem" right="-10rem" justify-content="center" pointer-events="none" z-index=140
        column padding-left="0.5rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.25rem" gap="0.125rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(over ? 1 : 0) transition=(over ? "opacity 150ms ease 600ms" : "opacity 0ms") role="tooltip" aria-hidden=(not over) testId=`usage-bar-tip-${slot}-${window.id}`
          text window.tipFigures font-size="0.75rem" line-height="1.03125rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
          when window.timeLeft >= 0
            text "The line is where even spending would be." font-size="0.75rem" line-height="1.03125rem" white-space="nowrap" color="light-dark(#71717b, #818181)"
          when window.tipResets != ""
            text window.tipResets font-size="0.75rem" line-height="1.03125rem" white-space="nowrap" color="light-dark(#71717b, #818181)"

// LimitWindows compact: per window, the label and what is left, the bar, then pace and countdown
// (grid-cols-[minmax(0,9rem)_minmax(3rem,1fr)_auto] gap-x-3 gap-y-0.5).
component LimitWindows
  inject
    rem: number
  props
    account: UsageAccount
  view
    box width="100%" display="grid" grid-template-columns=`minmax(0px, ${9 * rem}px) minmax(${3 * rem}px, 1fr) auto` column-gap="0.75rem" row-gap="0.125rem" testId=`usage-windows-${account.slot}`
      each window in account.windows key=window.id
        row min-width=0 align-items="center" gap="0.5rem"
          text window.label min-width=0 font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
          text `${window.remaining}% left` margin-left="auto" flex-shrink=0 font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
        WindowBar(slot=account.slot, window=window, light=account.light, dark=account.dark)
        row align-items="center" gap="0.5rem" white-space="nowrap"
          when window.pace != ""
            PaceIcon(pace=window.pace, label=window.paceLabel)
          text window.resetsIn margin-left="auto" flex-shrink=0 font-size="0.75rem" line-height="1rem" white-space="nowrap" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"

// RedactedSensitiveText as the composer's account label renders it (font-sans text-xs
// leading-normal): the same-shape placeholder, blurred and unselectable, until a press reveals
// it; hover raises it to the foreground. The reveal flag is this instance's own.
component UsageRedacted
  props
    value: string
    placeholder: string
    testId: string
  state revealed = false
  state over = false
  action toggle
    revealed = not revealed
  action hover(inside: bool)
    over = inside
  view
    box position="relative" min-width=0 max-width="100%" hover=hover
      button press=toggle aria-label="Toggle account label visibility" testId=testId cursor="pointer" min-width=0 max-width="100%" padding=0 border-width=0 border-radius="0.25rem" background-color="#00000000" display="flex" flex-direction="row" align-items="baseline"
        text (revealed ? value : placeholder) font-size="0.75rem" line-height="normal" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" min-width=0 user-select=(revealed ? "auto" : "none") filter=(revealed ? "none" : "blur(4px)") color=(over ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") testId=`${testId}-text`
      when over
        CnTooltip(tip=(revealed ? "Click to hide account" : "Click to reveal account"), tipId=`${testId}-tip`, above=20)

// AccountSummary: the account's label (redacted when it holds an address), then " · plan".
component UsageAccountLabel
  props
    label: string
    redact: string
    redactMask: string
    plan: string
    testId: string
  view
    row min-width=0 max-width="100%" align-items="baseline" overflow="hidden" testId=testId
      when redact != ""
        UsageRedacted(value=redact, placeholder=redactMask, testId=`${testId}-redacted`)
      else
        text label min-width=0 font-size="0.75rem" line-height="1rem" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" color="light-dark(#71717b, #818181)"
      when plan != ""
        text plan flex-shrink=0 font-size="0.75rem" line-height="1rem" white-space="pre" color="light-dark(#71717b, #818181)"

// ResetCredits: "N reset credits banked · next expires in …", "Use reset" (outline xs; "Using…"
// while the redeem runs) and the last outcome. The confirm is mounted over the window
// (ResetCreditDialog in app-overlays.contract), never inside the banner.
component ResetCreditsRow
  props
    account: UsageAccount
    busy: bool
    command: action
  view
    row width="100%" flex-wrap="wrap" align-items="center" column-gap="0.75rem" row-gap="0.25rem" testId=`usage-credits-${account.slot}`
      text account.credits font-size="0.75rem" line-height="1rem" font-variant-numeric="tabular-nums" color="light-dark(#71717b, #818181)"
      when account.canRedeem
        button id=`usage-reset-${account.slot}` press=command("cclocal:usage-reset-ask", account.key, "", 0) disabled=(busy or account.busy) testId=`usage-reset-${account.slot}` height="1.5rem" padding-left="0.4375rem" padding-right="0.4375rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" opacity=(busy or account.busy ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" flex-shrink=0
          text (account.busy ? "Using…" : "Use reset") font-size="0.75rem" font-weight=500 line-height="1rem" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
      when account.status != ""
        text account.status font-size="0.75rem" line-height="1rem" role="status" color="light-dark(#27272a, #f5f5f5)" testId=`usage-reset-status-${account.slot}`

// One account of UsageLimitsBannerBody: its summary when there are several, the windows or the
// provider's notice, "Manage usage" for usage kept outside the client, and the banked credits.
component UsageAccountBlock
  props
    account: UsageAccount
    busy: bool
    command: action
  state over = false
  action hover(inside: bool)
    over = inside
  view
    column width="100%" min-width=0 gap="0.25rem" testId=`usage-account-${account.slot}`
      when account.showLabel
        UsageAccountLabel(label=account.label, redact=account.redact, redactMask=account.redactMask, plan=account.plan, testId=`usage-label-${account.slot}`)
      when account.notice != ""
        text account.notice font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"
      else
        LimitWindows(account=account)
      when account.manage
        button press=command("cclocal:usage-manage", account.key, "", 0) hover=hover disabled=busy testId=`usage-manage-${account.slot}` align-self="flex-start" height="1.75rem" padding-left="0.5625rem" padding-right="0.5625rem" box-sizing="border-box" border-radius="0.5rem" border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center"
          text "Manage usage" font-size="0.875rem" font-weight=500 line-height="1.25rem" white-space="nowrap" text-decoration=(over ? "underline" : "none") color="light-dark(#27272a, #f5f5f5)"
      when account.showCredits
        ResetCreditsRow(account=account, busy=busy, command=command)

// UsageLimitsBannerBody: each account, then the sources' notices (ComposerBanner.Body pt-1
// pb-1.5 pe-2 ps-7, gap-2). Past two accounts it scrolls (ComposerBanner.Scroll, 24rem).
component UsageLimitsBody
  props
    accounts: list<UsageAccount>
    notices: list<string>
    busy: bool
    command: action
    testId: string
  view
    when length(accounts) > 2
      scroll width="100%" max-height="24rem" testId=`${testId}-scroll`
        UsageLimitsColumn(accounts=accounts, notices=notices, busy=busy, command=command, testId=testId)
    else
      UsageLimitsColumn(accounts=accounts, notices=notices, busy=busy, command=command, testId=testId)

component UsageLimitsColumn
  props
    accounts: list<UsageAccount>
    notices: list<string>
    busy: bool
    command: action
    testId: string
  view
    column width="100%" padding-left="1.75rem" padding-right="0.5rem" padding-top="0.25rem" padding-bottom="0.375rem" gap="0.5rem" box-sizing="border-box" testId=testId
      each account in accounts key=account.key
        UsageAccountBlock(account=account, busy=busy, command=command)
      each line in notices key=line
        text line font-size="0.75rem" line-height="1rem" color="light-dark(#71717b, #818181)"

// ResetCreditDialog: redeeming spends a credit the provider granted, so it never fires on a bare
// click. Cancel and Escape send nothing and return the focus to "Use reset"; "Use credit" closes
// the confirm and redeems once.
component ResetCreditDialog
  props
    target: string
    busy: bool
    command: action
  view
    column position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 display="flex" align-items="center" justify-content="center" padding="1rem" box-sizing="border-box" background-color="light-dark(#fcfcfc99, #0a0a0aa3)" backdrop-filter="blur(4px)" testId="reset-credit-overlay"
      column width="100%" max-width="32rem" box-sizing="border-box" border-radius="1.125rem" border-style="solid" border-width=1 border-color="light-dark(#27272a1a, #ffffff14)" background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 24px 64px -24px #000000a6" overflow="hidden" role="alertdialog" aria-modal=true aria-label="Use a reset credit?" testId="reset-credit-dialog"
        column gap="0.5rem" padding="1.5rem" box-sizing="border-box"
          text "Use a reset credit?" font-size="1.25rem" font-weight=600 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
          text "This redeems one credit on your account and clears the current rate-limit windows. It cannot be undone." font-size="0.875rem" line-height="1.25rem" color="light-dark(#71717b, #8f8f8f)"
        row gap="0.5rem" justify-content="flex-end" padding-left="1.5rem" padding-right="1.5rem" padding-top="1rem" padding-bottom="1rem" box-sizing="border-box" border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#fafafab8, #ffffff06)"
          button id="reset-credit-cancel" press=command("cclocal:usage-reset-cancel", target, "", 0) disabled=busy aria-keyshortcuts="Escape" testId="reset-credit-cancel" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d"
            text "Cancel" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="light-dark(#27272a, #f5f5f5)"
          button press=command("cclocal:usage-reset-confirm", target, "", 0) disabled=busy testId="reset-credit-confirm" display="flex" flex-direction="row" align-items="center" justify-content="center" height="2rem" padding-left="0.6875rem" padding-right="0.6875rem" box-sizing="border-box" border-radius="0.5rem" border-style="solid" border-width=1 opacity=(busy ? 0.64 : 1) border-color="light-dark(#1b4ed8, #346bf1)" background-color="light-dark(#1b4ed8, #346bf1)" box-shadow="0 1px 2px #0000000d"
            text "Use credit" font-size="0.875rem" font-weight=500 line-height="1.25rem" color="#ffffff"
