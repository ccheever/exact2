// UsagePriceOverrides, "Custom model prices" (lane "pages", upstream
// b05adb70b0 and e8545b293b's Set price), measured against the served
// reference at 1280×840: the Apply to menu, a table of Model ID, Map to and
// the four rates per million tokens, per-destination save results and the
// footer. Inputs show a seed and report every keystroke (pages-usage-prices.ts).
// T3 Code, MIT (LICENSE-T3).
use UsagePrices from "./pages-usage-shapes.contract"
use UsagePriceRow from "./pages-usage-shapes.contract"
use CheckRow from "./pages-usage.contract"
use TipBubble from "./shell-tip.contract"
use PgIcon from "./pages-icons.contract"

component UsagePricesDialog
  props
    prices: UsagePrices
    scheme: string
    viewportHeight: number
    busy: bool
    op: action
  view
    column flex-shrink=0 padding-top=24 padding-left=24 padding-right=24 padding-bottom=12 box-sizing="border-box" gap=8
      text "Custom model prices" font-size=20 line-height="20px" font-weight=600 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2 padding-right=24
      text "Prices and mappings apply to all past and future usage on the environments you select." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
    scroll max-height=(viewportHeight - 182) min-height=0 width="100%" testId="usage-prices-scroll"
      column width="100%" padding-top=4 padding-left=24 padding-right=24 padding-bottom=4 box-sizing="border-box" gap=16
        row flex-wrap="wrap" align-items="center" justify-content="space-between" gap=8
          row min-width=0 align-items="center" gap=8
            text "Apply to" font-size=14 line-height="16px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" flex-shrink=0
            UsagePricesApply(prices=prices, scheme=scheme, op=op)
          text "USD / million tokens" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
        when prices.selectionNotice != ""
          text prices.selectionNotice font-size=14 line-height="20px" color="light-dark(#71717b, #818181)" testId="usage-prices-notice"
        else
          column width="100%" min-width=0 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" overflow="hidden"
            // A table-fixed colgroup of 22%, 18%, four equal rate columns and 40pt; rows share the template.
            column width="100%" min-width=720 role="table" aria-label="Custom model prices" testId="usage-prices-table"
              box width="100%" display="grid" grid-template-columns="22% 18% minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 40px" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" role="row"
                UsagePriceHead(label="Model ID")
                UsagePriceHead(label="Map to")
                UsagePriceHead(label="Input")
                UsagePriceHead(label="Output")
                UsagePriceHead(label="Cache read")
                UsagePriceHead(label="Cache write")
                row height=40 padding-left=8 padding-right=8 align-items="center" justify-content="center"
                  UsageGhostIcon(icon="plus", label="Add model price", tip="", scheme=scheme, disabled=prices.locked, press=op("usage-prices-add", "", ""), testId="usage-prices-add")
              when length(prices.rows) == 0
                text prices.emptyRows width="100%" padding-top=32 padding-bottom=32 padding-left=8 padding-right=8 box-sizing="border-box" text-align="center" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" testId="usage-prices-empty"
              // The last row's rule sits under the frame's border (tbody tr:last-child border-0).
              column width="100%" margin-bottom=-1
                each row in prices.rows key=row.key
                  UsagePriceRowView(row=row, scheme=scheme, locked=prices.locked, op=op)
          text prices.footnote font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
        when length(prices.statuses) > 0
          column width="100%" gap=4 role="status" testId="usage-prices-status"
            each status in prices.statuses key=status.key
              row width="100%" justify-content="space-between" gap=12
                text status.label font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" line-clamp=1 min-width=0
                text status.status font-size=12 line-height="16px" text-align="right" color=(status.failed ? "light-dark(#fb2c36, #fb414a)" : "light-dark(#71717b, #818181)") flex-shrink=0
    row flex-shrink=0 padding-left=24 padding-right=24 padding-top=16 padding-bottom=16 box-sizing="border-box" align-items="center" justify-content="space-between" gap=8
      text prices.changesLabel font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" min-width=0
      row flex-wrap="wrap" justify-content="flex-end" gap=8
        when prices.hasChanges
          UsageGhostButton(label=prices.discardLabel, disabled=busy, press=op("usage-prices-discard", "", ""), testId="usage-prices-discard")
        UsagePricesSave(label=(busy ? "Saving…" : prices.saveLabel), scheme=scheme, disabled=(busy or prices.saveDisabled), press=op("usage-prices-save", "", ""))

// TableHead: h-10, px-2, text-xs medium in the foreground.
component UsagePriceHead
  props
    label: string
  view
    row height=40 padding-left=8 padding-right=8 box-sizing="border-box" align-items="center" min-width=0
      text label font-size=12 line-height="16px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" white-space="nowrap" role="columnheader"

// One row of the table. A mapped row reads "Counted as …" in place of its
// rates; a reset row reads "Automatic pricing after saving" until it is saved.
component UsagePriceRowView
  props
    row: UsagePriceRow
    scheme: string
    locked: bool
    op: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box width="100%" hover=hover border-bottom-width=1 border-bottom-style="solid" border-color="light-dark(#e4e4e7, #ffffff0f)" background-color=(over ? "light-dark(#fafafa80, #ffffff04)" : "#00000000") role="row" testId=`usage-price-row-${row.id}`
      box display="grid" grid-template-columns="22% 18% minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1fr) 40px" width="100%" align-items="center"
        column grid-column=1 padding=8 min-width=0 gap=4
          when row.isNew
            UsagePriceInput(value=row.modelValue, placeholder="Model ID", label="New model ID", mono=false, invalid=row.invalid, scheme=scheme, disabled=locked, edit=op("usage-prices-edit", `${row.id}:model`), testId=`usage-price-${row.id}-model`)
          else
            text row.model font-size=12 line-height="16px" overflow-wrap="anywhere" text-decoration-line=(row.removed ? "line-through" : "none") color=(row.removed ? "light-dark(#71717b, #818181)" : "light-dark(#27272a, #f5f5f5)") testId=`usage-price-${row.id}-name`
          when row.error != ""
            text row.error font-size=12 line-height="16px" color="light-dark(#fb2c36, #fb414a)" role="alert" testId=`usage-price-${row.id}-error`
        when row.removed
          text "Automatic pricing after saving" grid-column="2 / span 5" padding=8 font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
        else
          column grid-column=2 padding=8 min-width=0
            UsagePriceInput(value=row.aliasValue, placeholder=row.aliasPlaceholder, label=row.aliasLabel, mono=false, invalid=false, scheme=scheme, disabled=locked, edit=op("usage-prices-edit", `${row.id}:alias`), testId=`usage-price-${row.id}-alias`)
          when row.countedAs != ""
            text `Counted as ${row.countedAs}` grid-column="3 / span 4" padding=8 font-size=12 line-height="16px" overflow-wrap="anywhere" color="light-dark(#71717b, #818181)" testId=`usage-price-${row.id}-counted`
          else
            each cell in row.cells key=cell.key
              column padding=8 min-width=0
                UsagePriceInput(value=cell.value, placeholder=cell.placeholder, label=cell.ariaLabel, mono=true, invalid=false, scheme=scheme, disabled=locked, edit=op("usage-prices-edit", `${row.id}:${cell.key}`), testId=`usage-price-${row.id}-${cell.key}`)
        row grid-column=7 padding=8 align-items="center" justify-content="center"
          UsageGhostIcon(icon=(row.removed ? "rotate-ccw" : row.resetIcon), label=row.resetLabel, tip=row.resetTip, scheme=scheme, disabled=locked, press=op("usage-prices-reset", row.id, ""), testId=`usage-price-${row.id}-reset`)

// Input size="compact": 28pt inside its 1pt border, 9pt inset (7 here: the field cell adds 2), text-xs; aria-invalid tints the border and rings it.
component UsagePriceInput
  props
    value: string
    placeholder: string
    label: string
    mono: bool
    invalid: bool
    scheme: string
    disabled: bool
    edit: action
    testId: string
  view
    input value=value input=edit placeholder=placeholder aria-label=label disabled=disabled autocorrect="off" spellcheck="false" inputmode=(mono ? "decimal" : "text") testId=testId width="100%" height=30 padding-left=7 padding-right=7 padding-top=6 padding-bottom=6 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color=(invalid ? "light-dark(#fb2c36a3, #fb414aa3)" : "light-dark(#d4d4d8, #ffffff14)") background-color="light-dark(#fcfcfc, #ffffff07)" box-shadow=(invalid ? (scheme == "dark" ? "0 0 0 3px #fb414a3d" : "0 0 0 3px #fb2c3629") : "none") opacity=(disabled ? 0.64 : 1) font-family=(mono ? "ui-monospace" : "system-ui") font-size=12 line-height="16px" color="light-dark(#27272a, #f5f5f5)"

// Apply to: an outline sm trigger and its checkbox menu; locked while there are unsaved changes.
component UsagePricesApply
  props
    prices: UsagePrices
    scheme: string
    op: action
  view
    column position="relative" min-width=0
      button popovertarget="usage-prices-apply" disabled=(prices.pending or prices.hasChanges) aria-label=`Apply to ${prices.selectionLabel}` testId="usage-prices-apply" height=28 padding-left=9 padding-right=7 box-sizing="border-box" gap=4 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" opacity=(prices.pending or prices.hasChanges ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" min-width=0
        text prices.selectionLabel font-size=14 line-height="20px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" line-clamp=1 min-width=0
        UsageSchemeIcon(name="chevron-down", size=14, scheme=scheme, light="#27272a", dark="#f5f5f5")
      column id="usage-prices-apply" popover="auto" position="absolute" left=0 top=0 padding-top=4 testId="usage-prices-apply-layer"
        column width=prices.menuWidth padding=4 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#27272a1a, #f5f5f51a)" background-color="light-dark(#ffffffd5, #111111d5)" box-shadow=(scheme == "dark" ? "0 18px 44px -18px #000000cc" : "0 16px 40px -18px #0000008c") role="menu" testId="usage-prices-apply-menu"
          CheckRow(label="All environments", status="", checked=prices.allChecked, press=op("usage-prices-env", "", ""), testId="usage-prices-apply-all")
          box width="calc(100% - 16px)" height=1 margin-left=8 margin-top=4 margin-bottom=4 background-color="light-dark(#e4e4e7, #ffffff0f)" role="separator"
          each target in prices.targets key=target.key
            CheckRow(label=target.label, status=target.unavailable, checked=target.checked, press=op("usage-prices-env", target.key, ""), testId=`usage-prices-apply-${target.key}`)

// Button size="icon-xs" variant="ghost": 24pt, a 14pt glyph, bg-accent on hover, with its tooltip.
component UsageGhostIcon
  props
    icon: string
    label: string
    tip: string
    scheme: string
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" display="flex"
      button press=press hover=hover disabled=disabled aria-label=label testId=testId width=24 height=24 padding=0 border-radius=8 border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
        UsageSchemeIcon(name=icon, size=14, scheme=scheme, light="#27272a", dark="#f5f5f5")
      when tip != ""
        TipBubble(label=tip, side="top", align="center", offset=28, inset=0, shown=(over and not disabled))

// Button variant="ghost" (sm:h-8): text in the foreground, bg-accent on hover.
component UsageGhostButton
  props
    label: string
    disabled: bool
    press: action
    testId: string
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId=testId height=32 padding-left=11 padding-right=11 box-sizing="border-box" border-radius=8 border-width=0 background-color=(over and not disabled ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size=14 line-height="20px" font-weight=500 white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"

component UsagePricesSave
  props
    label: string
    scheme: string
    disabled: bool
    press: action
  state over = false
  action hover(value: bool)
    over = value
  view
    button press=press hover=hover disabled=disabled testId="usage-prices-save" height=32 padding-left=11 padding-right=11 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#1b4ed8, #346bf1)" background-color=(over and not disabled ? "light-dark(#1b4ed8e6, #346bf1e6)" : "light-dark(#1b4ed8, #346bf1)") box-shadow=(disabled ? "none" : (scheme == "dark" ? "inset 0 1px 0 #ffffff29, 0 1px 2px #346bf13d" : "inset 0 1px 0 #ffffff29, 0 1px 2px #1b4ed83d")) opacity=(disabled ? 0.64 : 1) display="flex" flex-direction="row" align-items="center" justify-content="center"
      text label font-size=14 line-height="20px" font-weight=500 white-space="nowrap" color="#ffffff"

// This dialog is drawn once for both schemes so its inputs survive an
// appearance change; an SVG's light-dark() would not follow the flip, so its
// glyphs are drawn per scheme instead.
component UsageSchemeIcon
  props
    name: string
    size: number
    scheme: string
    light: string
    dark: string
  view
    box display="flex" flex-shrink=0
      when scheme == "dark"
        PgIcon(name=name, size=size, color=dark)
      else
        PgIcon(name=name, size=size, color=light)
