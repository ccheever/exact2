// PublishRepositoryDialog (lane r4-git), after T3 Code (MIT; see LICENSE-T3):
// GitActionsControl.tsx and ui/wizard.tsx. A max-w-xl wizard: the header with its
// segmented steps (Provider, Repository, Summary), the panel band, the bare footer.
// Providers come from the server's source-control discovery (r4-git-actions.ts);
// one that is not installed or signed in shows "Setup Required" with its hint.
use R4GitCard from "./r4-git-shapes.contract"
use R4GitProvider from "./r4-git-shapes.contract"
use R4Dialog from "./r4-git.contract"
use R4Button from "./r4-git.contract"
use R4Glyph from "./r4-git.contract"
use ShellIcon from "./shell-icons.contract"
use BrandGitLab from "./settings-brands.contract"
use BrandAzureDevOps from "./settings-brands.contract"
use BrandBitbucket from "./settings-brands.contract"
use BrandForgejo from "./settings-brands.contract"

// The source-control host marks (Icons.tsx): GitHub in the foreground colour, the rest in their own.
component R4ProviderMark
  props
    provider: string
    size: number
  view
    when provider == "gitlab"
      BrandGitLab(size=size)
    else
      when provider == "azure-devops"
        BrandAzureDevOps(size=size)
      else
        when provider == "bitbucket"
          BrandBitbucket(size=size)
        else
          when provider == "forgejo"
            BrandForgejo(size=size)
          else
            R4Glyph(name="github", size=size, color="light-dark(#27272a, #f5f5f5)")

component R4PublishDialog
  props
    git: R4GitCard
    cwd: string
    act: action
    local: action
  view
    R4Dialog(label="Publish repository", maxWidth=576, close=local("git-dialog-close", "", ""), testId="git-publish-dialog")
      // WizardHeader: DialogHeader (p-6, pb-3 beside a panel) with the steps under the description.
      column gap=8 padding-left=24 padding-right=24 padding-top=24 padding-bottom=12 box-sizing="border-box"
        text "Publish repository" font-size=20 font-weight=600 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        text "Pick where to host it, then point us at a repo to push to." font-size=14 line-height="20px" color="light-dark(#71717b, #818181)"
        row gap=4 padding=4 box-sizing="border-box" border-radius=12 border-width=1 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfc, #ffffff0a)" role="list" aria-label="Setup progress"
          R4Step(index=0, label="Provider", summary=git.publishProviderLabel, current=git.publishStep, local=local)
          R4Step(index=1, label="Repository", summary=git.publishName, current=git.publishStep, local=local)
          R4Step(index=2, label="Summary", summary="", current=git.publishStep, local=local)
      // WizardPanel: a band with hairlines, px-6 py-5, space-y-4.
      column gap=16 padding-left=24 padding-right=24 padding-top=20 padding-bottom=20 box-sizing="border-box" border-top-width=1 border-bottom-width=1 border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color="light-dark(#fcfcfccc, #ffffff05)"
        when git.publishStep == 0
          column gap=8
            text "Provider" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
            column gap=12 role="radiogroup" aria-label="Provider"
              each row in git.publishRows key=row.key
                row gap=12 width="100%"
                  R4ProviderCard(provider=row.first, local=local)
                  when row.pair
                    R4ProviderCard(provider=row.second, local=local)
                  else
                    box flex=1 min-width=0
        when git.publishStep == 1
          column gap=8
            text "Repository" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
            row height=36 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" overflow="hidden" align-items="stretch"
              row flex-shrink=0 gap=6 padding-left=10 padding-right=10 align-items="center" border-right-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#f4f4f580, #ffffff07)"
                R4ProviderMark(provider=git.publishProvider, size=14)
                text `${git.publishHost}/` font-family="ui-monospace" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
              input value=git.publishRepository input=local("git-publish-repository", "") submit=act("shell:git-publish", cwd, "") placeholder=git.publishPlaceholder disabled=git.publishPending aria-label="Repository" testId="git-publish-repository" flex=1 min-width=0 padding-left=12 padding-right=12 border-width=0 background-color="#00000000" font-family="ui-monospace" font-size=14 color="light-dark(#27272a, #f5f5f5)" autocorrect="off" spellcheck="false"
          column gap=8
            text "Visibility" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
            row gap=12 role="radiogroup" aria-label="Visibility"
              R4Choice(value="private", label="Private", description="Only invited people", icon="lock", selected=(git.publishVisibility == "private"), disabled=git.publishPending, local=local)
              R4Choice(value="public", label="Public", description="Anyone on the web", icon="globe", selected=(git.publishVisibility == "public"), disabled=git.publishPending, local=local)
          column gap=12
            button press=local("git-publish-advanced", "", "") aria-expanded=git.publishAdvanced testId="git-publish-advanced" padding=0 gap=4 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" align-self="flex-start"
              box display="flex" rotate=(git.publishAdvanced ? 0 : -90)
                ShellIcon(name="chevron-down", size=14, color="light-dark(#71717b, #818181)")
              text "Advanced" font-size=12 font-weight=500 line-height="16px" color="light-dark(#71717b, #818181)"
            when git.publishAdvanced
              row gap=12
                column flex=1 gap=6
                  text "Remote" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
                  input value=git.publishRemote input=local("git-publish-remote", "") placeholder="origin" disabled=git.publishPending aria-label="Remote" testId="git-publish-remote" height=32 padding-left=10 padding-right=10 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"
                column flex=1 gap=6
                  text "Protocol" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
                  row height=32 gap=2 padding=2 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" role="group" aria-label="Protocol"
                    button press=local("git-publish-protocol", "", "ssh") disabled=git.publishPending testId="git-publish-ssh" flex=1 border-radius=6 border-width=0 background-color=(git.publishProtocol == "ssh" ? "light-dark(#f4f4f5, #ffffff14)" : "#00000000")
                      text "SSH" font-size=14 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
                    button press=local("git-publish-protocol", "", "https") disabled=git.publishPending testId="git-publish-https" flex=1 border-radius=6 border-width=0 background-color=(git.publishProtocol == "https" ? "light-dark(#f4f4f5, #ffffff14)" : "#00000000")
                      text "HTTPS" font-size=14 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
          when git.publishPending
            text `Publishing repository to ${git.publishProviderLabel}...` padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" background-color="light-dark(#f4f4f566, #ffffff09)" role="status"
          when git.publishError != "" and not git.publishPending
            column padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 border-width=1 border-style="solid" border-color="light-dark(#fb2c3666, #fb414a66)" background-color="light-dark(#fb2c361a, #fb414a1a)" role="alert"
              text "Publish failed" font-size=12 font-weight=500 line-height="16px" color="light-dark(#e7000b, #ff6467)"
              text git.publishError padding-top=2 font-size=12 line-height="16px" color="light-dark(#e7000be6, #ff6467e6)"
        when git.publishStep == 2
          column gap=8 align-items="center" padding-top=4 padding-bottom=4
            box width=32 height=32 border-radius=16 background-color="light-dark(#00bc7d26, #00bc7d26)" display="flex" align-items="center" justify-content="center"
              ShellIcon(name="check", size=16, color="light-dark(#009966, #00bc7d)")
            text (git.publishPushed ? "Repository published" : "Repository created") font-size=14 font-weight=600 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
            text git.publishSummary max-width=320 text-align="center" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
          row gap=8 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=8 align-items="center" background-color="light-dark(#f4f4f566, #ffffff09)"
            R4ProviderMark(provider=git.publishProvider, size=14)
            text git.publishName flex=1 min-width=0 line-clamp=1 font-family="ui-monospace" font-size=12 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
          link cursor="pointer" href=git.publishUrl testId="git-publish-open" height=32 border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" display="flex" align-items="center" justify-content="center"
            text `Open on ${git.publishProviderLabel}` font-size=14 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
      // WizardFooter: DialogFooter bare (px-6 py-4), the actions at the end.
      row gap=8 justify-content="flex-end" padding-left=24 padding-right=24 padding-top=16 padding-bottom=16 box-sizing="border-box"
        when git.publishStep == 2
          R4Button(label="Done", primary=true, disabled=false, press=local("git-dialog-close", "", ""), testId="git-publish-done")
        else
          R4Button(label=(git.publishStep == 0 ? "Cancel" : "Back"), primary=false, disabled=git.publishPending, press=local("git-publish-back", "", ""), testId="git-publish-back")
          when git.publishStep < 1
            R4Button(label="Next", primary=true, disabled=(not git.publishAnyReady or not git.publishCanNext), press=local("git-publish-step", "", "1"), testId="git-publish-next")
          else
            R4Button(label=(git.publishPending ? "Publishing..." : "Publish"), primary=true, disabled=(not git.publishCanSubmit), press=act("shell:git-publish", cwd, ""), testId="git-publish-submit")

// WizardSteps' step: a numbered (or checked) circle and its label; the current one is a raised pill.
component R4Step
  props
    index: number
    label: string
    summary: string
    current: number
    local: action
  view
    button press=local("git-publish-step", "", `${index}`) disabled=(current == 2 or index >= 2 or index > current) testId=`git-publish-step-${index}` flex=1 min-width=0 padding-left=10 padding-right=10 padding-top=8 padding-bottom=8 box-sizing="border-box" gap=8 border-radius=8 border-width=(index == current ? 1 : 0) border-style="solid" border-color="light-dark(#0000000d, #ffffff0d)" background-color=(index == current ? "light-dark(#ffffff, #ffffff0d)" : "#00000000") box-shadow=(index == current ? "0 1px 2px #0000000d" : "none") display="flex" flex-direction="row" align-items="center"
      box width=20 height=20 border-radius=10 flex-shrink=0 box-sizing="border-box" border-width=1 border-style="solid" border-color=(index < current ? "light-dark(#1b4ed8, #346bf1)" : index == current ? "light-dark(#1b4ed84d, #346bf14d)" : "light-dark(#0000001a, #ffffff1a)") background-color=(index < current ? "light-dark(#1b4ed8, #346bf1)" : index == current ? "light-dark(#1b4ed81a, #346bf11a)" : "light-dark(#ffffff, #ffffff0d)") display="flex" align-items="center" justify-content="center"
        when index < current
          ShellIcon(name="check", size=14, color="#ffffff")
        else
          text `${index + 1}` font-size=14 font-weight=500 line-height="20px" color=(index == current ? "light-dark(#1b4ed8, #6b97ff)" : "light-dark(#71717b, #818181)")
      text (summary != "" and index < current ? `${label}: ${summary}` : label) flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=14 font-weight=500 line-height="20px" color=(index == current ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)")

// A provider card: ready ones are radios; the others are dimmed with Setup Required and the hint on hover.
component R4ProviderCard
  props
    provider: R4GitProvider
    local: action
  state over = false
  action hover(value: bool)
    over = value
  view
    box position="relative" flex=1 min-width=0 hover=hover
      button press=local("git-publish-provider", provider.value, "") disabled=(not provider.ready) role="radio" aria-checked=provider.selected testId=`git-publish-provider-${provider.value}` width="100%" height=46 padding-left=12 padding-right=12 box-sizing="border-box" gap=12 border-radius=8 border-width=(provider.selected ? 2 : 1) border-style="solid" border-color=(provider.selected ? "light-dark(#1b4ed8, #346bf14d)" : "light-dark(#e4e4e7, #ffffff00)") background-color=(provider.selected ? "light-dark(#ffffff, #346bf11a)" : over and provider.ready ? "light-dark(#f4f4f580, #ffffff14)" : "light-dark(#ffffff, #ffffff09)") opacity=(provider.ready ? 1 : 0.64) display="flex" flex-direction="row" align-items="center"
        R4ProviderMark(provider=provider.value, size=20)
        text provider.label flex=1 min-width=0 white-space="nowrap" overflow="hidden" text-overflow="ellipsis" text-align="left" font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
        when not provider.ready
          text "Setup Required" flex-shrink=0 padding-left=6 padding-right=6 border-radius=6 border-width=1 border-style="solid" border-color="light-dark(#f59e0b66, #fbbf2466)" background-color="light-dark(#fffbeb, #fbbf240d)" font-size=11 font-weight=500 line-height="18px" color="light-dark(#d97706, #fbbf24)"
      when not provider.ready
        row position="absolute" bottom="100%" right=0 padding-bottom=4 pointer-events="none" z-index=82
          column max-width=320 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff0f)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" opacity=(over ? 1 : 0) role="tooltip" aria-hidden=(not over)
            text provider.hint font-size=12 line-height="16.5px" color="light-dark(#27272a, #f5f5f5)"

component R4Choice
  props
    value: string
    label: string
    description: string
    icon: string
    selected: bool
    disabled: bool
    local: action
  view
    button press=local("git-publish-visibility", "", value) disabled=disabled role="radio" aria-checked=selected testId=`git-publish-${value}` flex=1 min-width=0 padding-left=12 padding-right=12 padding-top=10 padding-bottom=10 box-sizing="border-box" gap=12 border-radius=8 border-width=(selected ? 2 : 1) border-style="solid" border-color=(selected ? "light-dark(#1b4ed8, #346bf14d)" : "light-dark(#e4e4e7, #ffffff00)") background-color=(selected ? "light-dark(#ffffff, #346bf11a)" : "light-dark(#ffffff, #ffffff09)") display="flex" flex-direction="row" align-items="center"
      R4Glyph(name=icon, size=16, color="light-dark(#71717b, #818181)")
      column flex=1 min-width=0 align-items="flex-start"
        text label font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
        text description font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
