// browser-surface part 1: the Browser tab's projection (browser-surface.ts `BrowserView`), apart from its
// views so the panel's shapes (r4-surfaces-shapes.contract) can carry it without a `use` cycle.
shape BrowserProfileChoice
  id: string
  name: string

shape BrowserPanel
  tabId: string
  runtimeId: string
  environment: string
  profileId: string
  profileName: string
  showProfile: bool
  url: string
  loading: bool
  canGoBack: bool
  canGoForward: bool
  refreshDisabled: bool
  hasWebContents: bool
  empty: bool
  failed: bool
  failHost: string
  failMessage: string
  failLabel: string
  live: bool
  profiles: list<BrowserProfileChoice>
