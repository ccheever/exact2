// browser-surface part 1: the Browser tab's projection (browser-surface.ts `BrowserView`), apart from its
// views so the panel's shapes (r4-surfaces-shapes.contract) can carry it without a `use` cycle.
shape BrowserProfileChoice
  id: string
  name: string

shape BrowserPanel
  tabId: string
  runtimeId: string
  environment: string
  profileId: string
  profileName: string
  showProfile: bool
  url: string
  loading: bool
  canGoBack: bool
  canGoForward: bool
  refreshDisabled: bool
  hasWebContents: bool
  empty: bool
  failed: bool
  failHost: string
  failMessage: string
  failLabel: string
  live: bool
  profiles: list<BrowserProfileChoice>
  capture: BrowserCapture // part 3 (browser-surface-capture)

// browser-surface part 3 (capture): the chrome row's Annotate, Capture and Float preview, and the separate window
// (browser-capture.ts `BrowserCaptureView`).
shape BrowserCapture
  pickActive: bool
  pickDisabled: bool
  pickTip: string
  captureDisabled: bool
  recording: bool
  floating: bool
  floatDisabled: bool
  separateWindow: bool
  sendSerial: number // ⌘Return in Annotate: the window's task sends the composer

// The floating player's browser source (browser-capture.ts `BrowserMiniView`); its frame is the chat canvas's.
shape BrowserMini
  show: bool
  key: string
  sourceKey: string
  tabId: string
  runtimeId: string
  url: string
  profileId: string
  environment: string
  hasWebContents: bool
  recording: bool
  separateWindow: bool
  width: number
  height: number
