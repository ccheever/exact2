use TerminalDrawerView from "./terminal.contract"
// The right panel's tabbed surfaces (lane r4-surfaces, r4-surfaces-panel.ts):
// the tab strip, the Files surface (tree and preview), the Linked pull requests
// surface and the device hub's setup wizard, as ShellView.panel carries them.
use ChatDocument from "./markdown.contract"
use CodeHighlight from "./markdown.contract"
use R5PrSurface from "./r5-panels-shapes.contract"
use R5Attachment from "./r5-panels-shapes.contract"
use R6DeviceView from "./r6-device-shapes.contract"
use R6DeviceMini from "./r6-device-shapes.contract"
use R12TabStrip from "./r12-threads.contract"
use BrowserPanel from "./browser-shapes.contract"
use BrowserMini from "./browser-shapes.contract"
use MediaView from "./media-actions.contract"

shape R4Tab
  id: string
  kind: string
  title: string
  icon: string
  tone: string
  fileToken: string
  active: bool
  pending: bool
  renaming: bool
  renameValue: string
  closeTitle: string
  closeBody: string
  closeTarget: string
  menu: list<R4TabMenuItem>
  favicon: string // browser-surface: a Browser tab's captured favicon, then the public service's
  faviconFallback: string
  audio: string // browser-surface part 5: "none", "audible" or "muted" (the tab's audio button)
// right-panel-tab-menu: one row of the tab's context menu (right-panel-tabs.ts tabMenuRows).
shape R4TabMenuItem
  id: string
  label: string
  disabled: bool
shape R4TreeRow
  id: string
  path: string
  name: string
  depth: number
  directory: bool
  expanded: bool
  selected: bool
  token: string
  ignored: bool
  guides: list<R4Guide>
shape R4Guide
  id: string
  left: number
shape R4Crumb
  id: string
  label: string
  path: string
  current: bool
  directory: bool
shape R4CodeRun
  id: string
  text: string
  syntax: string
shape R4CodeLine
  id: string
  number: string
  runs: list<R4CodeRun>
  // diff-review: a code line ("line"), or a saved ("note") or draft comment under its last line; line selection.
  kind: string
  line: number
  selected: bool
  entry: string
  text: string
  label: string
shape R4Editor
  id: string
  label: string
  selected: bool
shape R4TableRow
  id: string
  header: bool
  cells: list<R4CodeRun>
shape R4Files
  cwd: string
  project: string
  ready: bool
  loading: bool
  error: string
  query: string
  truncated: bool
  rows: list<R4TreeRow>
  hasDirectories: bool
  allExpanded: bool
  explorer: bool
  showExplorer: bool
  path: string
  preview: string
  previewError: string
  crumbs: list<R4Crumb>
  lines: list<R4CodeLine>
  commentOpen: bool
  text: string
  textKey: string
  gutter: number
  wrap: bool
  // FilePreviewPanel showsRawText (the word-wrap toggle) and canOpenInBrowser (a page or a PDF).
  rawText: bool
  openInBrowser: bool
  truncatedNote: string
  canRender: bool
  rendered: bool
  renderLabel: string
  renderIcon: string
  editable: bool
  pending: bool
  editorId: string
  editorLabel: string
  editorShow: bool
  editorHint: string
  editorUnavailable: string
  editors: list<R4Editor>
  absolutePath: string
  markdown: ChatDocument
  code: list<CodeHighlight>
  table: list<R4TableRow>
  editing: bool
  editorText: string
  editorsOpen: bool
  crumbMenu: R4CrumbMenu
  crumbsMask: string
  crumbsOffset: number
  url: string
  // media-actions: an image or video file (media-views.ts filesMediaView).
  media: MediaView
shape R4CrumbEntry
  id: string
  path: string
  label: string
  directory: bool
  token: string
  current: bool
  ignored: bool
shape R4CrumbMenu
  open: bool
  root: string
  x: number
  back: string
  backPath: string
  status: string
  entries: list<R4CrumbEntry>
shape R4LinkedRow
  key: string
  index: number
  number: number
  title: string
  url: string
  host: string
  repository: string
  depth: number
  state: string
  stateLabel: string
  waiting: bool
  conflict: string
  open: bool
  watching: bool
  checks: string
  checksLabel: string
  review: string
  reviewLabel: string
  additions: string
  deletions: string
  author: string
  avatar: string
  initial: string
  head: string
  base: string
  age: string
  stackSize: number
  stackLabel: string
  sourceLabel: string
  unlinkLabel: string
  canWatch: bool
shape R4Prs
  supported: bool
  rows: list<R4LinkedRow>
  footer: string
  canWatch: bool
  menu: string
shape R4Platform
  id: string
  platform: string
  ready: bool
  message: string
shape R4HostNotice
  id: string
  label: string
  detail: string
  failed: bool
shape R4DeviceRow
  id: string
  name: string
  description: string
  action: string
  platform: string
shape R4DeviceGroup
  id: string
  label: string
  devices: list<R4DeviceRow>
shape R4Device
  loaded: bool
  step: number
  enabled: bool
  busy: bool
  pending: string
  hostStatus: string
  hubStatus: string
  hubReady: bool
  platforms: list<R4Platform>
  agentEnabled: bool
  agentStatus: string
  agentReady: bool
  failure: string
  canContinue: bool
  doneLabel: string
  notices: list<R4HostNotice>
  groups: list<R4DeviceGroup>
  empty: string
  hint: string
  panelStatus: string
  refreshable: bool
  // lane r6-media: the opened device and its workspace (r6-media-device.ts).
  r6: R6DeviceView
  // 1e2ecbd975 (5318d054a5): a local host has no available platform (device-support.ts).
  localPlatformsUnavailable: bool
shape TerminalSurfaceClose
  op: string
  serial: number
  title: string
  body: string
  target: string

shape R4Panel
  key: string // audit-wave-followups FU-2: the thread (or draft) the panel belongs to (rightPanelStore byThreadKey)
  launcher: bool // open on the launcher alone (isOpen with no surface)
  terminalClose: TerminalSurfaceClose
  terminal: TerminalDrawerView
  open: bool
  kind: string
  active: string
  count: number
  tabs: list<R4Tab>
  files: R4Files
  prs: R4Prs
  device: R4Device
  deviceSetup: bool
  pr: R5PrSurface
  attachment: R5Attachment
  deviceMini: R6DeviceMini
  tabStrip: R12TabStrip // lane r12-threads: the tab strip's scroll (r12-threads-tabs.ts)
  browser: BrowserPanel // browser-surface: the active Browser tab (browser-surface.ts browserView)
  browserMini: BrowserMini // browser-surface part 3: the floating player's browser tab (browser-capture.ts browserMiniView)
  annotationSend: number // browser-surface part 3: an annotation's ⌘Return asks the window's Send, whatever the panel shows
