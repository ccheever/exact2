// Settings → Source control and Integrations (reference SourceControlSettings.tsx,
// ProjectDefaultsSettings.tsx, BranchNamingSettings.tsx,
// SourceControlWritingSettings.tsx, IntegrationsSettings.tsx). Scoped rows show
// where their value comes from (SettingInheritance) and a reset arrow.
use SelectOption from "./settings-kit.contract"
use SettingsSwitch from "./settings-kit.contract"
use SettingsSelect from "./settings-kit.contract"
use SettingsNotice from "./settings-kit.contract"
use LucideLayers from "./settings-icons.contract"
use LucideUndo2 from "./settings-icons.contract"
use LucideCheck from "./settings-icons.contract"
use LucideRefreshCw from "./settings-icons.contract"
use LucideChevronDown from "./settings-icons.contract"
use LucideChevronUp from "./settings-icons.contract"
use LucideMinus from "./settings-icons.contract"
use LucidePlus from "./settings-icons.contract"
use LucideEllipsisVertical from "./settings-icons.contract"
use BrandGit from "./settings-brands.contract"
use BrandJujutsu from "./settings-brands.contract"
use BrandGitHub from "./settings-brands.contract"
use BrandGitLab from "./settings-brands.contract"
use BrandAzureDevOps from "./settings-brands.contract"
use BrandBitbucket from "./settings-brands.contract"
use BrandForgejo from "./settings-brands.contract"
use BitbucketView from "./settings-a-bitbucket.contract"
use BitbucketForm from "./settings-a-bitbucket.contract"
use DeviceHostsView from "./settings-a-hosts.contract"
use DeviceHostsRow from "./settings-a-hosts.contract"
use SimulatorSupportRow from "./device-support.contract"
use SimulatorSupportSettingsRow from "./device-support.contract"

shape InheritLayer
  key: string
  label: string
  value: string
  effective: bool
  set: bool
shape ScopedRow
  key: string
  kind: string
  title: string
  description: string
  checked: bool
  value: string
  valueLabel: string
  options: list<SelectOption>
  placeholder: string
  disabled: bool
  first: bool
  summary: string
  state: string
  layers: list<InheritLayer>
  reset: string
  status: string
  child: string
shape DiscoveryRow
  kind: string
  label: string
  version: string
  comingSoon: bool
  badge: string
  dot: string
  summary: string
  account: bool
  enabled: bool
  details: bool
shape FetchInterval
  seconds: string
  canReset: bool
  decrease: string
  increase: string
  base: string
shape SourceControlPage
  available: bool
  error: string
  project: bool
  scope: string
  repositories: list<ScopedRow>
  text: list<ScopedRow>
  scanned: bool
  scanError: string
  vcs: list<DiscoveryRow>
  providers: list<DiscoveryRow>
  account: string
  fetches: list<FetchInterval>
  bitbucket: list<BitbucketView>
shape DeviceTool
  kind: string
  title: string
  label: string
  aria: string
  known: bool
  running: string
  required: string
  installed: string
  update: string
  inspect: bool
  offset: number
  error: string
shape IntegrationsPage
  available: bool
  error: string
  project: bool
  scope: string
  browser: list<ScopedRow>
  deviceHub: ScopedRow
  agentDevice: ScopedRow
  hubStatus: string
  agentStatus: string
  hosts: number
  hubTool: DeviceTool
  agentTool: DeviceTool
  hostsRow: ScopedRow
  deviceHosts: DeviceHostsView
  simulatorSupport: list<SimulatorSupportRow>

component SectionTitle
  props
    title: string
  view
    text title font-size=14 font-weight=400 line-height="20px" color="light-dark(#262629b3, #f5f5f5b3)" role="heading" aria-level=2

component Card
  slot
  view
    column width="100%" box-sizing="border-box" border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)" background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
      children

// SettingInheritance: the layers icon opens the top-down resolution chain.
component Inheritance
  props
    row: ScopedRow
  view
    button popovertarget=`inherit-${row.key}` aria-label=`${row.summary}. Show where this value comes from` testId=`inherit-${row.key}` width=20 height=20 padding=0 border-width=0 border-radius=6 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
      LucideLayers(size=12, color=(row.state == "overridden" ? "light-dark(#1b4ed8, #346bf1)" : (row.state == "mixed" ? "#fe9a00" : "light-dark(#71717b, #818181)")))
    column id=`inherit-${row.key}` popover="auto" position="absolute" width=320 padding-left=12 padding-right=12 padding-top=10 padding-bottom=10 box-sizing="border-box" border-radius=12 border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #ffffff14)" background-color="light-dark(#ffffff, #181818)" box-shadow="0 8px 24px #00000026" aria-label=row.summary testId=`inherit-popup-${row.key}`
      text "This environment" font-size=12 font-weight=500 line-height="16px" padding-bottom=6 color="light-dark(#71717b, #818181)"
      each layer in row.layers key=layer.key
        row align-items="center" gap=12 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 background-color=(layer.effective ? "light-dark(#27272a0f, #f5f5f50f)" : "#00000000")
          text layer.label font-size=14 line-height="20px" font-weight=(layer.effective ? 500 : 400) color=(layer.effective ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") flex=1 min-width=0 line-clamp=1
          text layer.value font-size=14 line-height="20px" max-width=128 line-clamp=1 color=(layer.effective ? "light-dark(#27272a, #f5f5f5)" : (layer.set ? "light-dark(#71717b, #818181)" : "light-dark(#71717b99, #81818199)"))
          box width=14 height=14
            when layer.effective
              LucideCheck(size=14, color="light-dark(#1b4ed8, #346bf1)")

// SettingsRow over a scoped server setting.
component ScopedSettingRow
  props
    row: ScopedRow
    busy: bool
    rest: action
    restInput: action
  view
    column width="100%" box-sizing="border-box" padding-top=12 padding-bottom=(row.child != "" or row.kind == "textarea" ? 4 : 12) padding-left=16 padding-right=16 border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)" opacity=(row.disabled and row.kind != "model" ? 0.64 : 1) testId=`scoped-row-${row.key}`
      when row.kind == "note"
        text row.description font-size=14 line-height="20px" padding-bottom=0 color="light-dark(#71717b, #818181)"
      when row.kind != "note"
        row width="100%" gap=32 align-items="center"
          column flex=1 min-width=0 gap=4
            row min-height=20 align-items="center" gap=6
              text row.title font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
              when row.summary != ""
                Inheritance(row=row)
              box width=20 height=20 display="flex" align-items="center" justify-content="center"
                when row.reset != ""
                  button press=rest("scoped", row.reset) disabled=busy aria-label=`Reset ${row.title} to default` testId=`reset-${row.key}` width=20 height=20 padding=0 border-width=0 border-radius=4 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    LucideUndo2(size=12, color="light-dark(#71717b, #818181)")
            when row.description != ""
              text row.description font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" max-width=576
            when row.status != ""
              text row.status font-size=12 line-height="16px" padding-top=2 color="light-dark(#71717b, #818181)"
          row flex-shrink=0 min-width=160 align-items="center" justify-content="flex-end" gap=8
            when row.kind == "switch"
              SettingsSwitch(checked=row.checked, label=row.title, disabled=(busy or row.disabled), switchId=`scoped-${row.key}`, toggle=rest("scoped", `key=${row.key}&value=${row.checked ? "false" : "true"}`))
            when row.kind == "select"
              SettingsSelect(selectId=`scoped-${row.key}`, label=row.title, valueLabel=row.valueLabel, width=(row.key == "sourceControlWritingStyle" ? 224 : 160), disabled=(busy or row.disabled), options=row.options, choose=restInput("scoped", `key=${row.key == "sourceControlWritingStyle" ? "sourceControlWritingStyle.mode" : row.key}&value=`))
            when row.kind == "text"
              ScopedTextField(value=row.value, placeholder=row.placeholder, label=row.title, fieldKey=row.key, busy=(busy or row.disabled), restInput=restInput)
            when row.kind == "model"
              when row.checked and length(row.options) > 0
                SettingsSelect(selectId="scoped-writer-model", label="Source control writer model", valueLabel=row.valueLabel, width=200, disabled=(busy or row.disabled), options=row.options, choose=restInput("scoped", "key=sourceControlWriterModelSelection&value="))
              SettingsSwitch(checked=row.checked, label="Use a separate source control writer model", disabled=(busy or row.disabled), switchId="scoped-writer-model-enabled", toggle=rest("scoped", `key=sourceControlWriterModelSelection&value=${row.checked ? "off" : "default"}`))
      when row.kind == "textarea"
        ScopedTextArea(value=row.value, placeholder=row.placeholder, label=row.title, fieldKey=row.key, busy=(busy or row.disabled), restInput=restInput)
      when row.child != "" or (row.key == "sourceControlWritingStyle" and row.value == "custom")
        ScopedTextArea(value=row.child, placeholder=row.placeholder, label="Custom source control writing instructions", fieldKey="sourceControlWritingStyle.customInstructions", busy=(busy or row.disabled), restInput=restInput)

// Inputs commit on blur, as the reference's onBlur writes do.
component ScopedTextField
  props
    value: string
    placeholder: string
    label: string
    fieldKey: string
    busy: bool
    restInput: action
  state draft = value
  action edit(next: string)
    draft = next
  view
    input value=draft input=edit change=restInput("scoped", `key=${fieldKey}&value=`) placeholder=placeholder aria-label=label disabled=busy testId=`scoped-input-${fieldKey}` box-sizing="border-box" width=178 height=32 padding-left=11 padding-right=11 padding-top=5 padding-bottom=5 line-height="20px" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 color="light-dark(#27272a, #f5f5f5)"

component ScopedTextArea
  props
    value: string
    placeholder: string
    label: string
    fieldKey: string
    busy: bool
    restInput: action
  state draft = value
  action edit(next: string)
    draft = next
  view
    column width="100%" max-width=672 padding-top=12 padding-bottom=14 box-sizing="border-box"
      textarea value=draft input=edit change=restInput("scoped", `key=${fieldKey}&value=`) placeholder=placeholder aria-label=label disabled=busy testId=`scoped-input-${fieldKey}` box-sizing="border-box" width="100%" height=96 padding=11 border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)"

component DiscoveryMark
  props
    kind: string
    dot: string
  view
    box position="relative" width=20 height=20 display="flex" align-items="center" justify-content="center" flex-shrink=0
      when kind == "git"
        BrandGit(size=18)
      when kind == "jj"
        BrandJujutsu(size=18)
      when kind == "github"
        BrandGitHub(size=18)
      when kind == "gitlab"
        BrandGitLab(size=18)
      when kind == "azure-devops"
        BrandAzureDevOps(size=18)
      when kind == "bitbucket"
        BrandBitbucket(size=18)
      when kind == "forgejo"
        BrandForgejo(size=18)
      box position="absolute" left=-2 top=-2 width=8 height=8 border-radius=6 border-style="solid" border-width=2 border-color="light-dark(#fcfcfc, #0a0a0a)" box-sizing="content-box" margin-left=-2 margin-top=-2 background-color=(dot == "success" ? "#00bc7d" : (dot == "warning" ? "#fe9a00" : "light-dark(#70707b59, #81818159)"))

component DiscoveryItem
  props
    item: DiscoveryRow
    first: bool
    account: string
    fetches: list<FetchInterval>
    forms: list<BitbucketView>
    busy: bool
    rest: action
    restInput: action
    reveal: action
  state open = false
  action toggleOpen
    open = not open
  view
    column width="100%" border-top-style="solid" border-top-width=(first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)" opacity=(item.comingSoon ? 0.8 : 1) testId=`discovery-${item.kind}`
      row width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=12 align-items="center"
        column flex=1 min-width=0 gap=4
          row min-width=0 gap=8 align-items="center" flex-wrap="wrap"
            DiscoveryMark(kind=item.kind, dot=item.dot)
            text item.label font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" line-clamp=1
            when item.version != ""
              text item.version font-family="monospace" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
            when item.comingSoon
              text "Coming Soon" font-size=10 font-weight=500 line-height="14px" padding-left=3 padding-right=3 border-radius=4 background-color="light-dark(#ff990014, #ff9b0029)" color="light-dark(#bb4d00, #ffb900)"
            when item.badge != ""
              text item.badge font-size=10 font-weight=500 line-height="14px" padding-left=3 padding-right=3 border-radius=4 background-color="light-dark(#ff990014, #ff9b0029)" color="light-dark(#bb4d00, #ffb900)"
          row gap=4 align-items="center" flex-wrap="wrap"
            text item.summary font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)"
            when item.account
              text "as" font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)"
              button press=reveal aria-label="Toggle source control account visibility" testId=`reveal-account-${item.kind}` height=17 padding-left=2 padding-right=2 border-width=0 border-radius=6 background-color=(account == "" ? "light-dark(#27272a14, #f5f5f514)" : "#00000000")
                text (account == "" ? "••••••••••" : account) font-family="monospace" font-size=11 line-height="16.5px" color="light-dark(#71717b, #818181)"
        row flex-shrink=0 align-items="center" gap=8
          when item.details
            button press=toggleOpen aria-expanded=open aria-label=`Toggle ${item.label} details` testId=`discovery-details-${item.kind}` width=24 height=24 padding=0 border-width=0 border-radius=8 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
              when open
                LucideChevronUp(size=14, color="light-dark(#71717b, #818181)")
              else
                LucideChevronDown(size=14, color="light-dark(#71717b, #818181)")
          when not item.comingSoon
            SettingsSwitch(checked=item.enabled, label=`${item.label} availability`, disabled=true, switchId=`discovery-switch-${item.kind}`, toggle=reveal)
      when open and item.kind == "bitbucket"
        each form in forms key=form.key
          BitbucketForm(form=form, busy=busy, rest=rest)
      when open and item.kind == "git"
        row width="100%" box-sizing="border-box" padding-left=16 padding-right=16 padding-top=4 padding-bottom=16 gap=12 align-items="flex-start" justify-content="space-between" testId="git-fetch-interval"
          column min-width=0 gap=4
            row align-items="center" gap=4
              text "Automatic Git fetch interval" font-size=12 font-weight=500 line-height="16px" color="light-dark(#27272a, #f5f5f5)"
              box width=20 height=20 display="flex" align-items="center" justify-content="center"
                when length(filter(fetches, current => current.canReset)) > 0
                  button press=rest("fetch-interval", "value=__default__") aria-label="Reset fetch interval to default" testId="reset-fetch-interval" width=20 height=20 padding=0 border-width=0 border-radius=4 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    LucideUndo2(size=12, color="light-dark(#71717b, #818181)")
            text "Refresh remote branches in the background. Set to 0 to avoid automatic Git prompts." font-size=12 line-height="19.5px" max-width=672 color="light-dark(#71717b, #818181)"
          row flex-shrink=0 align-items="center" gap=8
            each current in fetches key=current.seconds
              FetchField(fetch=current, busy=busy, rest=rest, restInput=restInput)
            text "seconds" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"

component FetchField
  props
    fetch: FetchInterval
    busy: bool
    rest: action
    restInput: action
  state draft = fetch.seconds
  action edit(next: string)
    draft = next
  view
    row role="group" align-items="center" width=128 height=28 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)"
      button press=rest("fetch-interval", `value=${fetch.decrease}`) disabled=busy aria-label="Decrease fetch interval" testId="decrease-fetch-interval" width=34 height=26 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
        LucideMinus(size=16, color="light-dark(#27272a, #f5f5f5)")
      input value=draft input=edit change=restInput("fetch-interval", "value=") disabled=busy aria-label="Automatic Git fetch interval in seconds" testId="fetch-interval-seconds" flex=1 min-width=0 height=26 padding=0 position="relative" top=4.5 line-height="26px" border-width=0 background-color="#00000000" font-size=14 text-align="center" color="light-dark(#27272a, #f5f5f5)"
      button press=rest("fetch-interval", `value=${fetch.increase}`) disabled=busy aria-label="Increase fetch interval" testId="increase-fetch-interval" width=34 height=26 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
        LucidePlus(size=16, color="light-dark(#27272a, #f5f5f5)")

component SourceControlPanel
  props
    data: SourceControlPage
    busy: bool
    error: string
    rest: action
    restInput: action
    restLocal: action
  view
    column width="100%" gap=32 testId="source-control-settings"
      when error != ""
        text error font-size=12 line-height="18px" color="light-dark(#dc2626, #f87171)" role="alert" testId="source-control-error" padding-left=16
      when data.error != ""
        Card()
          SettingsNotice(message=data.error, warning=false)
      when data.available
        column width="100%" gap=10 testId="source-control-repositories"
          row min-height=28 padding-left=16 padding-right=16 align-items="center"
            SectionTitle(title="Repositories")
          Card()
            each item in data.repositories key=`${data.scope}:${item.key}:${item.value}:${item.checked}`
              ScopedSettingRow(row=item, busy=busy, rest=rest, restInput=restInput)
        when length(data.vcs) > 0
          column width="100%" gap=10 testId="source-control-vcs"
            row min-height=28 padding-left=16 padding-right=16 align-items="center" justify-content="space-between"
              SectionTitle(title="Version Control")
              button press=restLocal("rescan", "") disabled=busy aria-label="Rescan server environment" testId="rescan-source-control" width=24 height=24 padding=0 border-width=0 border-radius=8 background-color="#00000000" display="flex" flex-direction="row" align-items="center" justify-content="center"
                LucideRefreshCw(size=14, color="light-dark(#71717b, #818181)")
            Card()
              each item in data.vcs key=item.kind
                DiscoveryItem(item=item, first=(item.kind == "git"), account=data.account, fetches=data.fetches, forms=data.bitbucket, busy=busy, rest=rest, restInput=restInput, reveal=restLocal("reveal-account", ""))
        when length(data.providers) > 0
          column width="100%" gap=10 testId="source-control-providers"
            row min-height=28 padding-left=16 padding-right=16 align-items="center"
              SectionTitle(title="Source Control Providers")
            Card()
              each item in data.providers key=item.kind
                DiscoveryItem(item=item, first=(item.kind == "github"), account=data.account, fetches=data.fetches, forms=data.bitbucket, busy=busy, rest=rest, restInput=restInput, reveal=restLocal("reveal-account", ""))
        when data.scanned and length(data.vcs) == 0 and length(data.providers) == 0
          column width="100%" gap=10
            row min-height=28 padding-left=16 padding-right=16 align-items="center"
              SectionTitle(title="Server environment")
            Card()
              column align-items="center" gap=8 padding=32 box-sizing="border-box" width="100%"
                text (data.scanError != "" ? "Could not scan the server environment" : "Nothing detected yet") font-size=16 font-weight=600 line-height="24px" color="light-dark(#27272a, #f5f5f5)"
                text (data.scanError != "" ? data.scanError : "Install Git on the server, add optional hosting integrations or credentials your workspace needs, then rescan.") font-size=14 line-height="20px" text-align="center" max-width=384 color="light-dark(#71717b, #818181)"
                button press=restLocal("rescan", "") disabled=busy testId="scan-source-control" display="flex" flex-direction="row" align-items="center" gap=6 height=28 padding-left=9 padding-right=9 border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)"
                  LucideRefreshCw(size=14, color="light-dark(#71717b, #818181)")
                  text "Scan" font-size=14 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
        column width="100%" gap=10 testId="source-control-text-generation"
          row min-height=28 padding-left=16 padding-right=16 align-items="center"
            SectionTitle(title="Text generation")
          Card()
            each item in data.text key=`${data.scope}:${item.key}:${item.value}:${item.checked}:${item.child}`
              ScopedSettingRow(row=item, busy=busy, rest=rest, restInput=restInput)

component IntegrationsPanel
  props
    data: IntegrationsPage
    busy: bool
    error: string
    rest: action
    restInput: action
  view
    column width="100%" gap=32 testId="integrations-settings"
      when error != ""
        text error font-size=12 line-height="18px" color="light-dark(#dc2626, #f87171)" role="alert" testId="integrations-error" padding-left=16
      when data.error != ""
        Card()
          SettingsNotice(message=data.error, warning=false)
      when data.available
        column width="100%" gap=10 testId="integrations-browser-access"
          row min-height=28 padding-left=16 padding-right=16 align-items="center"
            SectionTitle(title="Browser")
          Card()
            each item in data.browser key=`${data.scope}:${item.key}:${item.checked}`
              ScopedSettingRow(row=item, busy=busy, rest=rest, restInput=restInput)
        column width="100%" gap=10 testId="integrations-browser"
          row min-height=28 padding-left=16 padding-right=16 align-items="center"
            SectionTitle(title="Browser")
          Card()
            column width="100%" padding-top=6 padding-bottom=6 box-sizing="border-box" background-color="light-dark(#fafafa33, #ffffff02)"
              SettingsNotice(message="Only available in the desktop app.", warning=false)
              BrowserDefaults()
        column width="100%" gap=10 testId="integrations-devices"
          row min-height=28 padding-left=16 padding-right=16 align-items="center"
            SectionTitle(title="Devices")
          Card()
            DeviceRow(row=data.deviceHub, tool=data.hubTool, busy=busy, rest=rest)
            // 1e2ecbd975 (5318d054a5): Simulator support, revealed once the hub is ready or the local host lacks a platform.
            each support in data.simulatorSupport key=support.key
              SimulatorSupportSettingsRow(row=support, busy=busy, rest=rest)
            DeviceRow(row=data.agentDevice, tool=data.agentTool, busy=busy, rest=rest)
            DeviceHostsRow(view=data.deviceHosts, busy=busy, rest=rest)
              when data.hostsRow.summary != ""
                Inheritance(row=data.hostsRow)

component DeviceRow
  props
    row: ScopedRow
    tool: DeviceTool
    busy: bool
    rest: action
  view
    row width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=32 align-items="center" border-top-style="solid" border-top-width=(row.first ? 0 : 1) border-color="light-dark(#e3e3e780, #ffffff08)" testId=`device-row-${row.key}`
      column flex=1 min-width=0 gap=4
        row min-height=20 align-items="center" gap=6
          text row.title font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
          when row.summary != ""
            Inheritance(row=row)
          box width=20 height=20
        text row.description font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" max-width=576
      row flex-shrink=0 min-width=160 align-items="center" justify-content="flex-end" gap=8
        DeviceVersions(tool=tool, busy=busy, rest=rest)
        SettingsSwitch(checked=row.checked, label=row.title, disabled=(busy or row.disabled), switchId=`device-${row.key}`, toggle=rest("device", `key=${row.key}&value=${row.checked ? "false" : "true"}`))

// IntegrationsSettings preview defaults: client-local and unavailable outside
// the Electron desktop shell, shown as the reference shows them (inert at 64%).
component BrowserDefaults
  view
    column width="100%" testId="browser-defaults-unavailable"
      DisabledRow(title="Browser profiles", description="Profiles separate cookies and logins. Incognito data is cleared when the app closes.", control="Add profile", kind="button")
      row width="100%" box-sizing="border-box" padding-left=16 padding-right=16 padding-bottom=12 margin-top=-4
        row flex=1 min-width=0 height=42 box-sizing="border-box" padding-left=13 padding-right=13 gap=8 align-items="center" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)" testId="browser-profile-default"
          text "Default" font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" opacity=0.64
          text "Default" font-size=12 font-weight=500 line-height="16px" padding-left=3 padding-right=3 border-radius=6 border-style="solid" border-width=1 border-color="#00000000" background-color="light-dark(#1b4ed8, #346bf1)" color="#ffffff" opacity=0.64
          box flex=1
          box width=24 height=24 display="flex" align-items="center" justify-content="center" opacity=0.64 aria-label="Default options"
            LucideEllipsisVertical(size=14, color="light-dark(#71717b, #818181)")
      DisabledRow(title="Default browser viewport", description="Tab size for you and agents. Fill fits the panel; other sizes show the device toolbar.", control="Fill panel", kind="wide-select")
      DisabledRow(title="Default browser zoom", description="Page zoom applied to new browser tabs.", control="100%", kind="select")
      DisabledRow(title="Default browser appearance", description="The color scheme pages are told to prefer. System follows your OS setting.", control="System", kind="select")
      DisabledRow(title="Browser recording frame rate", description="Maximum recording rate. 30 fps saves CPU and storage; 60 fps is smoother.", control="30 fps", kind="select")
      DisabledRow(title="Show key presses in recordings", description="Show pressed keys and shortcuts in new recordings. Password fields are excluded.", control="", kind="switch")
      DisabledRow(title="Show mouse presses in recordings", description="Highlight mouse presses and held buttons in new recordings.", control="", kind="switch")
      DisabledRow(title="Open links in", description="Where links in the chat and terminal open. Hold ⌘ or Ctrl while clicking a link to open it in your default browser either way.", control="Your default browser", kind="wide-select")
      DisabledRow(title="Auto-show floating preview", description="Show the floating preview when an agent opens a browser or device unless the agent says otherwise.", control="on", kind="switch")

// SettingsUnavailableGroup's inert row: titles and descriptions at 64% (its
// [&_h3]/[&_p] opacity), controls drawn as they are but inert.
component DisabledRow
  props
    title: string
    description: string
    control: string
    kind: string
  view
    row width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=32 align-items="center"
      column flex=1 min-width=0 gap=4
        text title font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" opacity=0.64 role="heading" aria-level=3
        text description font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)" opacity=0.64 max-width=576
      row flex-shrink=0 min-width=160 align-items="center" justify-content="flex-end"
        when kind == "button"
          row align-items="center" gap=6 height=28 padding-left=9 padding-right=9 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" opacity=0.64 aria-label=control
            LucidePlus(size=16, color="light-dark(#71717b, #818181)")
            text control font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
        when kind == "select" or kind == "wide-select"
          row align-items="center" gap=6 width=(kind == "wide-select" ? 176 : 160) height=28 padding-left=9 padding-right=9 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#fcfcfc, #ffffff07)" opacity=0.64 role="combobox" aria-label=title
            text control font-size=14 line-height="20px" color="light-dark(#27272a, #f5f5f5)" flex=1 min-width=0 line-clamp=1
            LucideChevronDown(size=12, color="light-dark(#71717b, #818181)")
        when kind == "switch"
          row width=30 height=18 padding=2 box-sizing="border-box" border-radius=9 justify-content=(control == "on" ? "flex-end" : "flex-start") background-color=(control == "on" ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)") opacity=0.64 role="switch" aria-label=title aria-checked=(control == "on")
            box width=14 height=14 border-radius=7 background-color="light-dark(#fcfcfc, #0a0a0a)"

// DeviceToolVersions: a muted inline button (underlined while hovered or open) and
// its popover — Running / Required / Installed in monospace, the update note and
// versionActions' Update / Check versions. Native popovers anchor at the trigger's
// start; the estimated label width puts the popup's end at the trigger's end.
component DeviceVersions
  props
    tool: DeviceTool
    busy: bool
    rest: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box position="relative" flex-shrink=0
      button popovertarget=`device-versions-${tool.kind}` hover=hover aria-label=tool.aria testId=`device-status-${tool.kind}` display="flex" flex-direction="row" align-items="center" height=24 padding=0 border-width=0 background-color="#00000000"
        text tool.label font-size=16 font-weight=500 line-height="24px" color=(hovered ? "light-dark(#27272a, #f5f5f5)" : "light-dark(#71717b, #818181)") text-decoration-line=(hovered ? "underline" : "none") white-space="nowrap"
      column id=`device-versions-${tool.kind}` popover="auto" position="absolute" margin-top=4 margin-left=tool.offset width=320 padding=16 gap=0 box-sizing="border-box" border-radius=10 border-style="solid" border-width=1 border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role="dialog" aria-label=tool.title testId=`device-versions-${tool.kind}-popover`
        text tool.title font-size=14 font-weight=600 line-height="14px" color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=2
        when tool.known
          column gap=4 margin-top=16
            DeviceVersionLine(term="Running", value=tool.running)
            DeviceVersionLine(term="Required", value=tool.required)
            DeviceVersionLine(term="Installed", value=tool.installed)
        else
          text "Versions have not been checked." font-size=12 line-height="16px" margin-top=12 color="light-dark(#71717b, #818181)"
        text "Tools update automatically on this host when needed." font-size=12 line-height="16px" margin-top=16 padding-top=12 border-top-style="solid" border-top-width=1 border-color="light-dark(#e4e4e780, #ffffff0a)" color="light-dark(#71717b, #818181)"
        when tool.error != ""
          text tool.error role="status" font-size=12 line-height="16px" margin-top=8 color="light-dark(#dc2626, #f87171)"
        when tool.update != "" or tool.inspect
          row gap=8 margin-top=12 flex-wrap="wrap"
            when tool.update != ""
              button press=rest("device-tools", `action=update&tool=${tool.kind}`) disabled=busy testId=`device-update-${tool.kind}` display="flex" flex-direction="row" align-items="center" height=28 padding-left=10 padding-right=10 box-sizing="border-box" border-radius=8 border-width=0 background-color="light-dark(#1b4ed8, #346bf1)" opacity=(busy ? 0.64 : 1)
                text tool.update font-size=14 font-weight=500 line-height="20px" color="#ffffff" white-space="nowrap"
            when tool.inspect
              button press=rest("device-tools", "action=check") disabled=busy testId=`device-check-${tool.kind}` display="flex" flex-direction="row" align-items="center" height=28 padding-left=9 padding-right=9 box-sizing="border-box" border-radius=8 border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff07)" opacity=(busy ? 0.64 : 1)
                text (busy ? "Checking…" : "Check versions") font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"

component DeviceVersionLine
  props
    term: string
    value: string
  view
    row width="100%" gap=24 align-items="flex-start"
      text term font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" flex-shrink=0
      text value font-family="ui-monospace" font-size=12 line-height="16px" text-align="right" flex=1 min-width=0 overflow-wrap="anywhere" color="light-dark(#27272a, #f5f5f5)"
