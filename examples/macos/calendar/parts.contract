use Schedule from "./models.contract"

component Weekday
  props
    label: string
    tone: string
  view
    text label width="14.285714%" font-size=12 font-weight=600 text-align="center" color=tone

component ColorChoice
  props
    value: string
    label: string
    selected: string
    disabled: bool
    pick: action
  view
    button press=pick(value) disabled=disabled testId=`color-${label}` aria-label=label aria-selected=(selected == value) width=24 height=24 flex-shrink=0 padding=0 border-width=(selected == value ? 2 : 0) border-style="solid" border-color="#ffffff" box-shadow=(selected == value ? `0 0 0 2px ${value}` : "none") border-radius=12 background-color=value display="flex" align-items="center" justify-content="center" press-scale=0.94
      when selected == value
        text "✓" font-size=12 font-weight=700 color="#ffffff"

component TodoMark
  props
    completed: bool
    color: string
    size: number
  view
    svg width=size height=size viewBox="0 0 20 20" flex-shrink=0 aria-hidden=true opacity=(completed ? 0.55 : 1)
      circle cx=10 cy=10 r=8.5 fill=(completed ? color : "none") stroke=color stroke-width=1.5
      when completed
        path d="M 5.5 10 L 8.5 13 L 14.5 7" fill="none" stroke="#ffffff" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"

component AgendaMark
  props
    kind: string
    color: string
    completed: bool
  view
    box width=20 height=20 flex-shrink=0 display="flex" align-items="center" justify-content="center" aria-hidden=true
      when kind == "todo"
        TodoMark(completed=completed, color=color, size=18)
      else
        when kind == "plan"
          svg width=20 height=20 viewBox="0 0 24 24"
            circle cx=3 cy=12 r=2 fill=color
            path d="M 3 12 L 21 12 M 15.5 6.5 L 21 12 L 15.5 17.5" fill="none" stroke=color stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
        else
          box width=10 height=10 border-radius=5 background-color=color

// One schedule in the inspector. The drag handle covers the row: a click
// edits, a drag moves, a secondary click opens the Mac's context menu. While
// the row is hovered, a delete button sits above the handle at its right.
// The mark and title carry ids so a drag's ghost starts exactly on them.
component AgendaRow
  props
    id: string
    title: string
    color: string
    rangeLabel: string
    kind: string
    completed: bool
    hidden: bool
    disabled: bool
    hot: bool
    ink: string
    muted: string
    fill: string
    toggle: action
    edit: action
    command: action
    remove: action
    hover: action
  view
    box testId=`agenda-row-${id}` position="relative" width="100%" height=52 flex-shrink=0 hover=hover(`row-${id}`)
      row aria-hidden=true width="100%" height=52 box-sizing="border-box" padding-left=12 padding-right=36 border-radius=8 background-color=(hot and not hidden ? fill : "#ffffff00") opacity=(hidden ? 0 : 1) align-items="center" gap=10 transition="background-color 100ms ease-out"
        box id=`row-mark-${id}` testId=`row-mark-${id}` width=20 height=20 flex-shrink=0
          AgendaMark(kind=kind, color=color, completed=completed)
        column flex=1 min-width=0 gap=3 align-items="flex-start"
          text title id=`row-title-${id}` testId=`row-title-${id}` font-size=14 font-weight=500 color=ink opacity=(completed ? 0.5 : 1) text-decoration-line=(completed ? "line-through" : "none") white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
          text rangeLabel id=`row-range-${id}` font-size=12 color=muted white-space="nowrap" overflow="hidden" text-overflow="ellipsis" max-width="100%"
      calendar-drag-handle id=`agenda-item-${id}` testId=`agenda-item-${id}` event-id=id menu-kind=kind completed=(completed ? "true" : "false") enabled=(disabled ? "false" : "true") press=edit(id, kind) message=command(id, kind, completed) aria-label=`${title}, ${rangeLabel}` position="absolute" left=0 top=0 right=0 bottom=0
      when kind == "todo"
        button testId=`todo-check-${id}` press=toggle(id, not completed) role="checkbox" aria-checked=completed aria-label=`Complete ${title}` disabled=disabled position="absolute" left=4 top=8 width=36 height=36 padding=0 border-width=0 background-color="#ffffff00"
      when hot and not hidden and not disabled
        button testId=`delete-${id}` press=remove(id) aria-label=`Delete ${title}` position="absolute" right=8 top=15 width=22 height=22 padding=0 border-width=0 border-radius=11 background-color="#ffffff00" display="flex" align-items="center" justify-content="center" press-scale=0.92
          image "symbol:close" font-size=10 tint-color=muted

component StickerAgendaRow
  props
    day: number
    date: string
    stickerId: string
    hidden: bool
    disabled: bool
    hot: bool
    ink: string
    muted: string
    fill: string
    edit: action
    command: action
    remove: action
    hover: action
  view
    box testId="sticker-row" position="relative" width="100%" height=52 flex-shrink=0 hover=hover("row-sticker")
      row aria-hidden=true width="100%" height=52 box-sizing="border-box" padding-left=8 padding-right=36 border-radius=8 background-color=(hot and not hidden ? fill : "#ffffff00") opacity=(hidden ? 0 : 1) align-items="center" gap=8 transition="background-color 100ms ease-out"
        image `assets/stickers/${stickerId}.png` width=28 height=28 object-fit="contain"
        text stickerId text-transform="capitalize" flex=1 min-width=0 font-size=14 font-weight=500 color=ink white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
      calendar-drag-handle id=`sticker-agenda-${date}` testId=`sticker-agenda-${date}` event-id=`sticker-day:${day}:${stickerId}` menu-kind="sticker" completed="false" enabled=(disabled ? "false" : "true") press=edit message=command(day) aria-label=`${stickerId} sticker` position="absolute" left=0 top=0 right=0 bottom=0
      when hot and not hidden and not disabled
        button testId="delete-sticker" press=remove aria-label=`Remove the ${stickerId} sticker` position="absolute" right=8 top=15 width=22 height=22 padding=0 border-width=0 border-radius=11 background-color="#ffffff00" display="flex" align-items="center" justify-content="center" press-scale=0.92
          image "symbol:close" font-size=10 tint-color=muted

// A palette sticker: a click puts it on the selected date or, when the date
// already has it, takes it off; a drag places it on another date.
component StickerChip
  props
    value: string
    title: string
    selected: string
    disabled: bool
    dragId: string
    held: bool
    hot: bool
    fill: string
    selectedFill: string
    accent: string
    pick: action
    hover: action
  derive lifted = dragId == `sticker-pick:${value}`
  view
    box testId=`sticker-${value}` position="relative" width=48 height=48 flex-shrink=0 hover=hover(`sticker-${value}`)
      box aria-hidden=true position="absolute" left=0 top=0 width=48 height=48 box-sizing="border-box" border-radius=10 border-width=(selected == value ? 2 : 0) border-style="solid" border-color=accent background-color=(selected == value ? selectedFill : (hot ? fill : "#ffffff00")) transition="background-color 100ms ease-out"
      image `assets/stickers/${value}.png` position="absolute" left=7 top=7 width=34 height=34 object-fit="contain" opacity=(lifted ? 0 : 1) aria-hidden=true
      calendar-drag-handle id=`sticker-pick-${value}` testId=`sticker-pick-${value}` event-id=`sticker-pick:${value}` menu-kind="none" completed="false" enabled=(not disabled or (held and lifted) ? "true" : "false") press=pick(value) aria-label=`${title} sticker` aria-selected=(selected == value) position="absolute" left=0 top=0 width=48 height=48

component ThemeChoice
  props
    value: number
    title: string
    wallpaper: string
    selected: number
    surface: string
    field: string
    ink: string
    muted: string
    border: string
    accent: string
    hot: bool
    pick: action
    hover: action
  view
    button press=pick(value) hover=hover(`theme-${value}`) testId=`theme-${value}` aria-label=`Use ${title} theme` aria-selected=(selected == value) position="relative" width="calc(25% - 7.5px)" flex-shrink=0 min-width=0 height=104 box-sizing="border-box" padding=6 border-width=(selected == value ? 2 : 1) border-style="solid" border-color=(selected == value ? accent : border) border-radius=12 background-color=(selected == value or hot ? field : surface) display="flex" flex-direction="column" align-items="center" gap=6 transition="background-color 100ms ease-out"
      when value == 0
        box testId="theme-classic-preview" width="100%" height=64 flex-shrink=0 border-radius=8 background-color="#ffffff" overflow="hidden" aria-hidden=true
          svg width="100%" height=64 viewBox="0 0 160 96" preserveAspectRatio="xMidYMid slice"
            text "Sep" x=10 y=17 font-size=12 font-weight=600 fill="#242428"
            text "S" x=14 y=30 text-anchor="middle" font-size=6 fill="#d97777"
            text "M" x=36 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "T" x=58 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "W" x=80 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "T" x=102 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "F" x=124 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "S" x=146 y=30 text-anchor="middle" font-size=6 fill="#7796c1"
            path d="M 6 35 L 154 35 M 6 57 L 154 57 M 6 79 L 154 79" fill="none" stroke="#ededf1" stroke-width=0.7
            rect x=8 y=47 width=43 height=6 rx=1.5 fill="#FA7070"
            rect x=76 y=47 width=75 height=6 rx=1.5 fill="#747AFF"
            circle cx=11 cy=71 r=1.8 fill="#70B8A2"
            path d="M 11 71 L 95 71 M 91 68 L 95 71 L 91 74" fill="none" stroke="#70B8A2" stroke-width=1.1 stroke-linecap="round" stroke-linejoin="round"
            circle cx=115 cy=87 r=3 fill="none" stroke="#747AFF" stroke-width=1.1
      else
        image wallpaper width="100%" height=64 flex-shrink=0 object-fit="cover" border-radius=8
      text title font-size=12 font-weight=(selected == value ? 600 : 500) line-height="16px" color=(selected == value ? ink : muted) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
      when selected == value
        box position="absolute" top=11 right=11 width=20 height=20 border-radius=10 background-color=surface display="flex" align-items="center" justify-content="center"
          text "✓" font-size=13 font-weight=700 color=accent

// One segment of the editor's kind switch.
component KindTab
  props
    kind: string
    title: string
    selected: string
    disabled: bool
    ink: string
    muted: string
    surface: string
    pick: action
  view
    button testId=`kind-${kind}` press=pick(kind) role="radio" aria-checked=(selected == kind) disabled=disabled height=28 padding-left=12 padding-right=12 border-width=0 border-radius=7 background-color=(selected == kind ? surface : "#ffffff00") box-shadow=(selected == kind ? "0 1px 2px rgba(28, 31, 44, 0.14)" : "none") display="flex" align-items="center" justify-content="center"
      text title font-size=13 font-weight=(selected == kind ? 600 : 500) color=(selected == kind ? ink : muted)
