                box position="absolute" left=(landed ? 0 : (lifted ? chipX : markX + 1)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 8)) width=(lifted or landed ? 6 : 4) height=(lifted or landed ? 6 : 4) border-radius=3 background-color=dragTint opacity=(landed and landingBefore ? 0 : 1) transition=fadeTiming
                box position="absolute" left=(landed ? landingWidth - 8 : (lifted ? chipX + 192 : markX + 12)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 5)) width=(lifted or landed ? 8 : 6) height=(lifted or landed ? 6 : 10) opacity=(landed and landingAfter ? 0 : 1) transition=fadeTiming
                  svg width="100%" height="100%" viewBox="0 0 8 6" preserveAspectRatio="none"
                    path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=dragTint stroke-width=2 vector-effect="non-scaling-stroke"
              // A todo's circle shrinks to the bar's mark.
