                box position="absolute" left=(landed ? 0 : (lifted ? chipX : markX + 1)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 8)) width=(lifted or landed ? 6 : 4) height=(lifted or landed ? 6 : 4) border-radius=3 background-color=dragTint opacity=(landed and landingBefore ? 0 : 1) transition=fadeTiming layout-transition="300ms ease-in-out"
                box position="absolute" left=(landed ? landingWidth - 8 : (lifted ? chipX + 192 : markX + 12)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 5)) width=(lifted or landed ? 8 : 6) height=(lifted or landed ? 6 : 10) opacity=(landed and landingAfter ? 0 : 1) transition=fadeTiming layout-transition="300ms ease-in-out"
                  svg width="100%" height="100%" viewBox="0 0 8 6" preserveAspectRatio="none"
                    path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=dragTint stroke-width=2 vector-effect="non-scaling-stroke"
              // A todo's circle shrinks to the bar's mark.
              when dragKind == "todo"
                box position="absolute" left=(landed ? 2 : (lifted ? chipX + 4 : markX + 1)) top=(landed ? 4 : (lifted ? chipY + 6 : markY + 1)) width=(lifted or landed ? 12 : 18) height=(lifted or landed ? 12 : 18) opacity=(dragCompleted ? 0.55 : 1) layout-transition="300ms ease-in-out"
                  svg width="100%" height="100%" viewBox="0 0 20 20"
                    circle cx=10 cy=10 r=8.5 fill=(dragCompleted ? dragTint : "none") stroke=dragTint stroke-width=1.5
                    when dragCompleted
                      path d="M 5.5 10 L 8.5 13 L 14.5 7" fill="none" stroke="#ffffff" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
              // The dates fade; the title moves onto the block and shrinks to its size.
              text dragRangeLabel testId="calendar-drag-range" position="absolute" left=rangeX top=rangeY width=214 font-size=12 color=themeMuted white-space="nowrap" overflow="hidden" text-overflow="clip" opacity=(landed or lifted ? 0 : 1) transition=fadeTiming
              text dragTitle id="calendar-drag-title" testId="calendar-drag-title" position="absolute" left=(landed ? (dragKind == "todo" ? 18 : (dragKind == "plan" ? 3 : 6)) : (lifted ? chipX + (dragKind == "todo" ? 20 : (dragKind == "plan" ? 3 : 8)) : titleX)) top=(landed ? (dragKind == "plan" ? 7 : 4) : (lifted ? chipY + (dragKind == "plan" ? 8 : 5) : titleY)) width=214 font-size=14 font-weight=500 color=dragInk text-decoration-line=(dragCompleted ? "line-through" : "none") white-space="nowrap" overflow="hidden" text-overflow="clip" scale=(landed ? 11 / 14 : (lifted ? 12 / 14 : 1)) transform-origin="0px 0px" opacity=(landed ? 0 : (dragCompleted ? 0.5 : 1)) transition=fadeTiming layout-transition="300ms ease-in-out"
            // On landing the title hands over to the bar's own, as the month will draw it.
            box id="calendar-drag-landing-face" testId="calendar-drag-landing-face" position="absolute" left=0 top=0 width=landingWidth height=20 box-sizing="border-box" padding-left=(dragKind == "todo" ? 18 : 6) padding-right=6 overflow="hidden" display="flex" align-items="center" justify-content=(dragKind == "plan" ? "center" : "flex-start") opacity=(landed ? 1 : 0) transition=(viewport.prefersReducedMotion ? "none" : "opacity 150ms ease-out")
              text dragTitle text-decoration-line=(dragCompleted ? "line-through" : "none") opacity=(dragCompleted ? 0.5 : 1) position=(dragKind == "plan" ? "absolute" : "relative") left=(dragKind == "plan" ? 0 : "auto") right=(dragKind == "plan" ? 0 : "auto") top=(dragKind == "plan" ? 7 : "auto") text-align=(dragKind == "plan" ? "center" : "left") line-height="12px" font-size=11 font-weight=500 color=(dragKind == "plan" and theme == 0 ? paletteColor(theme, dragColor) : (theme == 0 ? "#292934" : themeInk)) padding-left=(dragKind == "plan" ? 3 : 0) padding-right=(dragKind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="clip" overflow="hidden"
      when themeOpen
        box testId="theme-backdrop" press=closeThemes position="absolute" left=0 right=0 top=0 bottom=0 z-index=30 background-color="#ffffff00"
        column id="theme-popup" testId="theme-popup" role="dialog" aria-label="Theme" press=keepThemes position="absolute" top="calc(env(safe-area-inset-top) + 46px)" right=384 width=520 max-width="calc(100% - 400px)" box-sizing="border-box" padding=14 gap=10 border-radius=12 border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface box-shadow="0 12px 40px rgba(28, 31, 44, 0.18)" z-index=31 opacity=(themeClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : "opacity 120ms ease-in") animation=(viewport.prefersReducedMotion or themeClosing ? "none" : "dropIn 140ms ease-out")
          row height=24 align-items="center"
            text "Theme" flex=1 font-size=14 font-weight=600 color=themeInk
            button press=closeThemes testId="close-themes" aria-label="Close themes" aria-keyshortcuts="Escape" class=ToolButton width=24 height=24 border-radius=6 background-color="#ffffff00"
              image "symbol:close" font-size=11 tint-color=themeMuted
          row gap=10
            ThemeChoice(value=0, title="Classic", wallpaper="", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-0"), pick=chooseTheme, hover=hoverOn)
            ThemeChoice(value=1, title="Blush Notebook", wallpaper="assets/themes/blush.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-1"), pick=chooseTheme, hover=hoverOn)
            ThemeChoice(value=2, title="Paris Haze", wallpaper="assets/themes/paris.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-2"), pick=chooseTheme, hover=hoverOn)
            ThemeChoice(value=6, title="San Francisco", wallpaper="assets/themes/sanfrancisco.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-6"), pick=chooseTheme, hover=hoverOn)
          row gap=10
            ThemeChoice(value=3, title="Meadow Morning", wallpaper="assets/themes/meadow.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-3"), pick=chooseTheme, hover=hoverOn)
            ThemeChoice(value=4, title="Lavender Sky", wallpaper="assets/themes/lavender.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-4"), pick=chooseTheme, hover=hoverOn)
            ThemeChoice(value=5, title="Linen Journal", wallpaper="assets/themes/linen.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-5"), pick=chooseTheme, hover=hoverOn)
      when editorOpen
        box testId="editor-backdrop" press=refocusEditor position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 background-color="rgba(28, 31, 44, 0.24)" display="flex" align-items="center" justify-content="center" opacity=(editorClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : (editorClosing ? "opacity 120ms ease-in" : "opacity 160ms ease-out"))
          column id="schedule-editor" testId=(editorKind == "todo" ? "todo-editor" : "schedule-editor") role="dialog" aria-label=editorLabel press=refocusEditor width=480 max-height="calc(100% - 96px)" min-height=0 box-sizing="border-box" border-radius=14 background-color=themeSurface box-shadow="0 24px 64px rgba(28, 31, 44, 0.28)" overflow="hidden" scale=(editorClosing ? 0.98 : 1) transition=(viewport.prefersReducedMotion ? "none" : "scale 120ms ease-in") animation=(viewport.prefersReducedMotion or editorClosing ? "none" : "dialogIn 160ms ease-out")
            row height=56 flex-shrink=0 box-sizing="border-box" padding-left=24 padding-right=20 align-items="center" gap=12
              text editorLabel testId="editor-title" flex=1 min-width=0 font-size=16 font-weight=600 color=themeInk white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
              when editId == ""
