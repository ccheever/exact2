// Lane r9-connect: the branch picker's "Checkout pull request" item and the
// PullRequestThreadDialog it opens (r9-connect-checkout.ts serves both).

// BranchToolbarBranchSelector's checkout item: shown while a local draft's ref
// search parses as a pull request reference (0 or 1 entries).
shape R9CheckoutItem
  reference: string
  title: string
  mark: string

// PullRequestThreadDialog: the reference field, the resolved pull request, and
// Local / Worktree (git.preparePullRequestThread; worktree passes the draft's thread id).
shape R9Checkout
  open: bool
  // One per opening: the field's own text belongs to the opening that typed it.
  key: string
  reference: string
  // The text the last answer was computed for; the field ahead of it is still resolving.
  settled: string
  mark: string
  title: string
  description: string
  label: string
  placeholder: string
  prTitle: string
  prMeta: string
  prState: string
  resolving: bool
  resolvingLabel: string
  error: string
  preparing: string
  canConfirm: bool
