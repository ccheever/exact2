// Shapes of the Usage page's mixes, model detail and Model prices dialog
// (lane "pages", pages-usage-detail.ts and pages-usage-prices.ts), and the
// one share bar both the page and the model dialog draw (UsageShareBar.tsx).
// T3 Code, MIT (LICENSE-T3).
use TipBubble from "./shell-tip.contract"

shape UsageTick
  key: string
  label: string
  top: number
shape UsageSeries
  key: string
  area: string
  line: string
  light: string
  dark: string
shape UsageChart
  ticks: list<UsageTick>
  series: list<UsageSeries>
  start: string
  middle: string
  end: string
shape UsageSegment
  key: string
  label: string
  value: string
  grow: number
  light: string
  dark: string
  tip: string
  first: bool
  last: bool
shape UsageShare
  key: string
  label: string
  aside: string
  ariaLabel: string
  segments: list<UsageSegment>
shape UsageStat
  key: string
  label: string
  value: string
shape UsageModelDetail
  open: bool
  key: string
  model: string
  driver: string
  description: string
  stats: list<UsageStat>
  chartTitle: string
  chart: UsageChart
  plotWidth: number
  shares: list<UsageShare>
  unpricedNote: string
shape UsagePriceCell
  key: string
  value: string
  placeholder: string
  ariaLabel: string
shape UsagePriceRow
  id: string
  key: string
  model: string
  isNew: bool
  removed: bool
  modelValue: string
  invalid: bool
  aliasValue: string
  aliasPlaceholder: string
  aliasLabel: string
  countedAs: string
  cells: list<UsagePriceCell>
  error: string
  resetLabel: string
  resetTip: string
  resetIcon: string
shape UsagePriceTarget
  key: string
  label: string
  checked: bool
  unavailable: string
shape UsagePriceStatus
  key: string
  label: string
  status: string
  failed: bool
shape UsagePrices
  open: bool
  generation: number
  menuWidth: number
  allChecked: bool
  selectionLabel: string
  targets: list<UsagePriceTarget>
  selectionNotice: string
  rows: list<UsagePriceRow>
  emptyRows: string
  footnote: string
  statuses: list<UsagePriceStatus>
  changesLabel: string
  hasChanges: bool
  discardLabel: string
  saveLabel: string
  saveDisabled: bool
  locked: bool
  pending: bool

// UsageShareBar: an h3 over an 8pt bar of segments (2pt apart, rounded ends,
// sized by value) and a legend of 8pt swatches with label and value.
component UsageShareBar
  props
    bar: UsageShare
    scheme: string
  view
    column min-width=0 gap=10 testId=`usage-share-${bar.key}`
      row align-items="baseline" justify-content="space-between" gap=12
        text bar.label font-size=14 line-height="20px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
        when bar.aside != ""
          row align-items="baseline" gap=4 flex-shrink=0
            text "Premium" font-size=12 line-height="16px" color="light-dark(#71717b, #818181)"
            text bar.aside font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)"
      row height=8 gap=2 width="100%" role="img" aria-label=bar.ariaLabel
        each segment in bar.segments key=segment.key
          UsageShareSegment(segment=segment, scheme=scheme)
      row flex-wrap="wrap" column-gap=16 row-gap=4
        each segment in bar.segments key=segment.key
          row align-items="center" gap=6
            box width=8 height=8 border-radius=2 flex-shrink=0 background-color=(scheme == "dark" ? segment.dark : segment.light) aria-hidden=true
            text segment.label font-size=12 line-height="16px" color="light-dark(#71717b, #818181)" white-space="nowrap"
            text segment.value font-size=12 line-height="16px" font-variant-numeric="tabular-nums" color="light-dark(#27272a, #f5f5f5)" white-space="nowrap"

// A segment (flex `value 1 0`, min-w-1, rounded-xs, full ends) and its tooltip.
component UsageShareSegment
  props
    segment: UsageSegment
    scheme: string
  state over = false
  action hover(value: bool)
    over = value
  view
    box hover=hover position="relative" flex-grow=segment.grow flex-shrink=1 flex-basis=0 min-width=4 height=8 border-top-left-radius=(segment.first ? 4 : 2) border-bottom-left-radius=(segment.first ? 4 : 2) border-top-right-radius=(segment.last ? 4 : 2) border-bottom-right-radius=(segment.last ? 4 : 2) background-color=(scheme == "dark" ? segment.dark : segment.light) testId=`usage-segment-${segment.key}`
      TipBubble(label=segment.tip, side="top", align="center", offset=12, inset=0, shown=over)
