// T3 settings primitives (settingsLayout.tsx, SettingsGroup.tsx, ui/switch,
// ui/button, ui/input) at the computed sizes and colors of the served
// reference, for the Providers and Connections routes.

// SettingsSection: a muted 14px title row (min-height 28, inset 16) above a group.
component PvSectionTitle
  props
    title: string
  slot
  view
    row min-height=28 padding-left=16 padding-right=16 gap=16 align-items="flex-start" justify-content="space-between" box-sizing="border-box" width="100%"
      row min-height=28 gap=8 align-items="center" min-width=0
        text title font-size=14 line-height="20px" font-weight=400 color="light-dark(#27272ab3, #f5f5f5b3)" role="heading" aria-level=2
      row min-height=28 min-width=28 gap=8 align-items="center" justify-content="flex-end"
        children

// SettingsGroup (grouped): rounded-xl card, border/60, card/40.
component PvGroup
  slot
  view
    column width="100%" box-sizing="border-box" border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff0a)" background-color="light-dark(#ffffff66, #11111166)" overflow="hidden"
      children

// One SettingsRow. Its own container query (≥ 32rem) puts the control beside
// the title; narrower rows stack it underneath. `divided` draws the border/50
// separator a grouped card draws between rows.
component PvRow
  props
    title: string
    description: string
    status: string
    wide: bool
    divided: bool
  slot
  view
    column width="100%" box-sizing="border-box" padding-left=16 padding-right=16 padding-top=12 padding-bottom=12 border-top-style="solid" border-top-width=(divided ? 1 : 0) border-color="light-dark(#e3e3e780, #ffffff08)"
      when wide
        row width="100%" gap=32 align-items="center"
          column flex=1 min-width=0 gap=4
            row min-height=20 align-items="center" gap=6
              text title font-size=14 line-height="20px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            when description != ""
              text description font-size=12 line-height="18px" max-width=576 color="light-dark(#70707acc, #818181cc)"
            when status != ""
              text status font-size=12 line-height="16px" padding-top=2 color="light-dark(#71717b, #818181)"
          row flex-shrink=0 min-width=160 gap=8 align-items="center" justify-content="flex-end"
            children
      else
        column width="100%" gap=12
          column min-width=0 gap=4
            row min-height=20 align-items="center" gap=6
              text title font-size=14 line-height="20px" font-weight=500 color="light-dark(#27272a, #f5f5f5)" role="heading" aria-level=3
            when description != ""
              text description font-size=12 line-height="18px" color="light-dark(#70707acc, #818181cc)"
            when status != ""
              text status font-size=12 line-height="16px" padding-top=2 color="light-dark(#71717b, #818181)"
          row width="100%" min-width=0 gap=8 align-items="center"
            children

// ui/switch: 30×18 (sm 26×16), 2px inset thumb; primary when on.
component PvSwitch
  props
    checked: bool
    small: bool
    disabled: bool
    label: string
    test: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled testId=test width=(small ? 26 : 30) height=(small ? 16 : 18) padding=2 border-width=0 border-radius=9999 box-sizing="border-box" display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
      box width=(small ? 12 : 14) height=(small ? 12 : 14) border-radius=9999 background-color="light-dark(#fcfcfc, #0a0a0a)"

// ui/input size=sm: 28px outline field (radius 10, 9px inset, 14px text).
style PvField
  box-sizing="border-box" height=28 padding-left=9 padding-right=9 padding-top=4 padding-bottom=4 border-radius=10
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#fcfcfc, #ffffff08)" font-size=14 color="light-dark(#27272a, #f5f5f5)"

// Button variants (ui/button): outline sm, ghost-muted xs and icon sizes.
style PvOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=6 flex-shrink=0
  box-sizing="border-box" height=28 padding-left=9 padding-right=9 border-radius=8 border-style="solid" border-width=1
  border-color="light-dark(#d4d4d8, #ffffff14)" background-color="light-dark(#ffffff, #ffffff08)"
  font-size=14 font-weight=500 color="light-dark(#27272a, #f5f5f5)"
style PvGhost
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=4 flex-shrink=0
  box-sizing="border-box" height=24 padding-left=7 padding-right=7 border-radius=8 border-width=0
  background-color="#00000000" font-size=12 font-weight=500 color="light-dark(#71717b, #818181)"
style PvIconButton
  display="flex" align-items="center" justify-content="center" flex-shrink=0
  box-sizing="border-box" width=24 height=24 padding=0 border-radius=8 border-width=0
  background-color="#00000000" color="light-dark(#71717b, #818181)"
style PvMicro
  display="flex" align-items="center" justify-content="center" flex-shrink=0
  box-sizing="border-box" width=20 height=20 padding=0 border-radius=6 border-width=0
  background-color="#00000000" color="light-dark(#71717b, #818181)"
style PvPrimary
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=6 flex-shrink=0
  box-sizing="border-box" height=28 padding-left=9 padding-right=9 border-radius=8 border-width=0
  background-color="light-dark(#1b4ed8, #346bf1)" font-size=14 font-weight=500 color="#ffffff"
