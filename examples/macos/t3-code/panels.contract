use Snapshot from "./shapes.contract"
use Thread from "./shapes.contract"
use Message from "./shapes.contract"
use Ink from "./shapes.contract"
use Muted from "./shapes.contract"
use Canvas from "./shapes.contract"
use Surface from "./shapes.contract"
use Edge from "./shapes.contract"
use Control from "./shapes.contract"
use Field from "./shapes.contract"
use Primary from "./shapes.contract"

use Icon from "./icons.contract"
use ProjectMark from "./icons.contract"

component ThreadSection
  props
    threads: list<Thread>
    section: string
    label: string
    select: action
  state expanded = true
  derive rows = filter(threads, (t) => t.section == section)
  action toggle
    expanded = not expanded
  view
    when length(rows) > 0
      column gap=1 width="100%"
        when label != ""
          button press=toggle class=Control width="100%" height=28 padding-left=10 padding-right=10 gap=8 aria-label=`Toggle ${label}`
            text label class=Muted font-size=12 font-weight=500
            box flex=1 height=1 background-color="light-dark(#e4e4e7, #171717)"
            box rotate=(expanded ? 180 : 0)
              Icon(name="chevron", size=12, color="light-dark(#71717a, #858585)")
        when expanded
          each t in rows key=t.id
            button press=select(t.id) testId=`thread-${t.id}` aria-label=`${t.title}, ${t.status}` width="100%" height=36 box-sizing="border-box" padding-left=10 padding-right=10 border-radius=8 border-width=0 background-color=(t.selected ? "light-dark(#ffffff, #1c1c1c)" : section == "settled" ? "light-dark(#f4f4f5, #121212)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap=10
              ProjectMark(label=t.projectMark, muted=(section == "settled"))
              text t.title font-size=14 font-weight=(section == "settled" ? 400 : 500) color=(section == "settled" ? "light-dark(#77777e, #737373)" : "light-dark(#27272a, #e2e2e2)") line-clamp=1 flex=1 min-width=0
              when t.badge != ""
                row gap=3 align-items="center"
                  Icon(name=(t.stacked ? "layers" : "branch"), size=12, color="light-dark(#71717a, #858585)")
                  text t.badge font-size=12 class=Muted
              when t.status != ""
                text t.status font-size=11 color=(t.status == "Working" ? "light-dark(#2451cc, #79a3ff)" : "light-dark(#71717a, #929292)")
              else
                text t.age font-size=12 class=Muted

component TimelineRow
  props
    message: Message
  state expanded = false
  action toggle
    expanded = not expanded
  view
    column width="100%" padding-top=(message.kind == "user" ? 20 : 8) padding-bottom=(message.kind == "user" ? 20 : 8) padding-left=20 padding-right=20 box-sizing="border-box" align-items="center"
      column width="100%" max-width=736 gap=6 align-items=(message.kind == "user" ? "flex-end" : "flex-start")
        when message.kind == "user"
          column max-width="80%" padding=12 border-radius=20 background-color="light-dark(#f0f0f2, #141414)" box-sizing="border-box"
            text message.body font-size=14 line-height=1.5 white-space="pre-wrap" overflow-wrap="break-word" class=Ink
        else
          when message.kind == "assistant" or message.kind == "plan"
            text message.body markup="markdown" width="100%" font-size=14 line-height=1.65 color="light-dark(#3f3f46, #b8b8b8)"
          else
            when message.kind == "system"
              row width="100%" align-items="center" gap=12 padding-top=20 padding-bottom=20
                box flex=1 height=1 background-color="light-dark(#e4e4e7, #181818)"
                Icon(name="compacted", size=12, color="light-dark(#71717a, #858585)")
                text message.title font-size=12 class=Muted
                box flex=1 height=1 background-color="light-dark(#e4e4e7, #181818)"
            else
              column width="100%" gap=5
                button press=toggle testId=`activity-${message.id}` width="100%" padding=0 height=24 border-width=0 background-color="#00000000" display="flex" flex-direction="row" align-items="center" gap=6
                  text message.title font-size=14 color=(message.kind == "error" ? "light-dark(#b91c1c, #fca5a5)" : "light-dark(#71717a, #858585)") line-clamp=1
                  box rotate=(expanded ? 90 : 0)
                    Icon(name="right", size=12, color="light-dark(#71717a, #858585)")
                when expanded or message.kind == "error"
                  text message.body font-size=13 font-family="monospace" line-height=1.5 white-space="pre-wrap" overflow-wrap="break-word" class=Muted width="100%" padding=10 box-sizing="border-box" background-color="light-dark(#f4f4f5, #111111)" border-radius=8

component Requests
  props
    data: Snapshot
    command: action
    answer: action
    busy: bool
    maximumHeight: number
  view
    when length(data.approvals) > 0 or length(data.questions) > 0
      scroll min-height=0 max-height=maximumHeight width="100%" padding=12 box-sizing="border-box" border-radius=16 background-color="light-dark(#fffbeb, #211b0e)" testId="pending-requests"
        column gap=16
          each a in data.approvals key=a.id
            column gap=8
              text a.label font-size=11 font-weight=600 color="light-dark(#a16207, #e9b949)"
              scroll max-height=80 width="100%"
                text a.detail font-size=12 line-height=1.5 font-family="monospace" white-space="pre-wrap" overflow-wrap="break-word" class=Ink
              when a.responseReason != ""
                text a.responseReason font-size=11 line-height=1.4 class=Muted testId=`approval-status-${a.id}`
              row gap=6 flex-wrap="wrap" justify-content="flex-end"
                each option in a.options key=option.id
                  button press=command("approval", a.id, option.id, 0) disabled=(busy or not a.canRespond) testId=`approval-${a.id}-${option.id}` class=Control border-style="solid" border-width=1 border-color="light-dark(#e4e4e7, #444038)" background-color=(option.id == "accept" ? "light-dark(#2451cc, #4475ed)" : "light-dark(#ffffff, #211b0e)")
                    text option.label font-size=12 color=(option.id == "accept" ? "#ffffff" : "light-dark(#27272a, #f5f5f5)")
          each q in data.questions key=q.id
            column gap=7
              text q.header font-size=11 font-weight=600 class=Muted
              text q.question font-size=14 line-height=1.45 class=Ink
              when q.responseReason != ""
                text q.responseReason font-size=11 line-height=1.4 class=Muted testId=`question-status-${q.id}`
              when q.multiSelect
                text "Select one or more options." font-size=11 class=Muted
              each option in q.options key=option.id
                button press=command("choice", q.id, option.id, 0) disabled=(not q.canRespond) testId=`choice-${q.id}-${option.id}` width="100%" padding=9 border-radius=8 border-style="solid" border-width=1 border-color=(option.selected ? "light-dark(#2451cc, #4475ed)" : "#00000000") background-color=(option.selected ? "light-dark(#e8efff, #24304a)" : "#00000000") display="flex" flex-direction="row" align-items="center" gap=8 box-sizing="border-box"
                  text (option.selected ? "✓" : q.multiSelect ? "□" : "○") font-size=14 class=Muted
                  column flex=1 min-width=0 gap=3
                    text option.label font-size=13 class=Ink
                    when option.description != ""
                      text option.description font-size=11 line-height=1.4 class=Muted
              when q.customAllowed
                textarea value=q.answer input=answer(q.id) disabled=(not q.canRespond) placeholder="Or write an answer…" aria-label=`Answer ${q.header}` testId=`answer-${q.id}` class=Field width="100%" height=52
              when q.last
                button press=command("submit-answers", q.requestId, "", 0) disabled=(busy or not q.canRespond) class=Primary align-self="flex-end" testId=`submit-answers-${q.requestId}`
                  text "Submit answers" font-size=12 color="#ffffff"

component DiffPanel
  props
    data: Snapshot
    close: action
  view
    column height="100%" width="100%" min-width=0 class=Canvas border-left-style="solid" border-left-width=1 border-color="light-dark(#e4e4e7, #252525)" testId="diff-panel"
      row height=52 flex-shrink=0 padding-left=16 padding-right=12 gap=8 align-items="center" border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e7, #252525)"
        column flex=1 min-width=0 gap=2
          text "Changes" font-size=13 font-weight=600 class=Ink
          text data.diffTitle font-size=10 class=Muted line-clamp=1
        button press=close class=Control width=28 aria-label="Close changes" testId="close-diff" aria-keyshortcuts="Escape"
          text "×" font-size=19 class=Muted
      when data.diffLoading
        text "Loading changes…" font-size=12 class=Muted padding=20
      else
        when data.diffError != ""
          text data.diffError font-size=12 color="light-dark(#b91c1c, #fca5a5)" padding=20
        else
          when data.diffText == ""
            column flex=1 justify-content="center" align-items="center" padding=24 gap=8
              text "No changes to show" font-size=14 class=Ink
              text "Changes appear after a turn creates a checkpoint." font-size=12 line-height=1.5 text-align="center" class=Muted
          else
            when length(data.diffFiles) > 0
              scroll max-height=144 flex-shrink=0 border-bottom-style="solid" border-bottom-width=1 border-color="light-dark(#e4e4e7, #252525)"
                column padding=8 gap=4
                  each file in data.diffFiles key=file.id
                    row gap=8 padding=5 align-items="center"
                      text file.name font-family="monospace" font-size=11 class=Ink flex=1 min-width=0 line-clamp=1
                      text `+${file.additions}` font-size=11 color="light-dark(#047857, #6ee7b7)"
                      text `−${file.deletions}` font-size=11 color="light-dark(#b91c1c, #fca5a5)"
            list virtualized=true flex=1 min-height=0 width="100%" testId="diff-content"
              each line in data.diffLines key=line.id
                text line.text padding-left=12 padding-right=12 min-height=20 font-family="monospace" font-size=13 line-height="20px" white-space="pre-wrap" overflow-wrap="anywhere" width="100%" box-sizing="border-box" color=(line.kind == "addition" ? "light-dark(#065f46, #a7f3d0)" : line.kind == "deletion" ? "light-dark(#991b1b, #fecaca)" : line.kind == "hunk" ? "light-dark(#2451cc, #93b4ff)" : "light-dark(#52525b, #c6c6c6)") background-color=(line.kind == "addition" ? "light-dark(#ecfdf5, #112b22)" : line.kind == "deletion" ? "light-dark(#fef2f2, #33191a)" : line.kind == "hunk" ? "light-dark(#eff6ff, #172136)" : "#00000000")
