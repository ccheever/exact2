// 737993303d: WorkEntryLogRow's Retry under a failed workspace preparation
// (ms-7 pb-1; Button size xs, variant outline, RotateCcwIcon).
component R11RetryPreparation
  props
    runId: string
    command: action
  state over = false
  action hover(value: bool)
    over = value
  view
    row margin-left=28 padding-bottom=4
      button press=command("chat:retry-preparation", "", runId, 0) hover=hover aria-label="Retry" testId=`retry-preparation-${runId}` height=24 padding-left=7 padding-right=7 gap=4 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color="light-dark(#d4d4d8, #ffffff14)" background-color=(over ? "light-dark(#f4f4f580, #ffffff1f)" : "light-dark(#ffffff, #ffffff07)") box-shadow="0 1px 2px #0000000d" flex-shrink=0 display="flex" flex-direction="row" align-items="center" justify-content="center"
        box margin-left=-2 margin-right=-2 display="flex"
          svg width=14 height=14 viewBox="0 0 24 24" fill="none" stroke="light-dark(#71717b, #a3a3a3)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round" aria-hidden=true
            path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8M3 3v5h5"
        text "Retry" font-size=12 font-weight=500 line-height="16px" white-space="nowrap" color="light-dark(#27272a, #f5f5f5)"
