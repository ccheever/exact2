// Outline geometry uses a shared 24px grid, matching T3's 16px toolbar icons.
component Icon
  props
    name: string
    size: number
    color: string
  view
    svg width=size height=size viewBox="0 0 24 24" fill="none" stroke=color stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round" flex-shrink=0 aria-hidden=true
      when name == "sidebar"
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M9 3v18m7-13-4 4 4 4"
      when name == "changes"
        rect x=3 y=3 width=18 height=18 rx=2
        path d="M15 3v18"
      when name == "search"
        circle cx=10.5 cy=10.5 r=7.5
        path d="m16 16 5 5"
      when name == "folder" or name == "folder-plus"
        path d="M3 7V5a2 2 0 0 1 2-2h4l3 3h7a2 2 0 0 1 2 2v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7Z"
        when name == "folder-plus"
          path d="M12 10v7m-3.5-3.5h7"
      when name == "compose"
        path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7M16 3l5 5M9 15l1-5L18 2a2.1 2.1 0 0 1 3 3l-8 8-4 2Z"
      when name == "chevron"
        path d="m7 10 5 5 5-5"
      when name == "right"
        path d="m9 6 6 6-6 6"
      when name == "up"
        path d="M12 19V5m-6 6 6-6 6 6"
      when name == "lock"
        rect x=3 y=11 width=18 height=11 rx=2
        path d="M7 11V7a5 5 0 0 1 10 0"
      when name == "bolt"
        path d="m13 2-9 12h7l-1 8 10-12h-7l1-8Z" fill=color stroke-width=1
      when name == "check"
        circle cx=12 cy=12 r=9
        path d="m8 12 3 3 5-6"
      when name == "refresh"
        path d="M20 7a9 9 0 1 0 1 9M21 3v5h-5"
      when name == "settings"
        path d="m9 3 .8-2h4.4l.8 2 2 .9 2.2-.3 2.2 3.8-1.3 1.8.1 2.2 1.3 1.8-2.2 3.8-2.2-.3-2 .9-.8 2H9l-.8-2-2-.9-2.2.3-2.2-3.8 1.3-1.8-.1-2.2L1.7 7.5l2.2-3.8 2.2.3L9 3Z" transform="translate(1 1) scale(.92)"
        circle cx=12 cy=12 r=3.5
      when name == "branch"
        circle cx=6 cy=5 r=2
        circle cx=18 cy=6 r=2
        circle cx=6 cy=19 r=2
        path d="M6 7v10m0-4c8 0 12-1 12-5"
      when name == "layers"
        path d="m12 2 10 6-10 6L2 8l10-6Zm-10 11 10 6 10-6M2 18l10 6 10-6"
      when name == "terminal"
        path d="m4 5 6 6-6 6m9 0h7"
      when name == "plan"
        path d="M9 6h12M9 12h12M9 18h12M3 6h.01M3 12h.01M3 18h.01"
      when name == "compacted"
        path d="M3 9h6V3m12 12h-6v6M2 2l7 7m13 13-7-7"
      when name == "provider"
        // A neutral provider mark; the label remains the server's model name.
        path d="m12 2 8.66 5v10L12 22l-8.66-5V7L12 2Zm0 0v10m8.66-5L12 12m0 10V12m-8.66 5L12 12m8.66 5L12 12M3.34 7 12 12"

// T3 Code's MIT-licensed brand paths; see LICENSE-T3.
component Wordmark
  view
    svg width=18 height=11 viewBox="15.5309 37 94.3941 56.96" aria-hidden=true
      path d="M33.4509 93V47.56H15.5309V37H64.3309V47.56H46.4109V93H33.4509ZM86.7253 93.96C82.832 93.96 78.9653 93.4533 75.1253 92.44C71.2853 91.3733 68.032 89.88 65.3653 87.96L70.4053 78.04C72.5386 79.5867 75.0186 80.8133 77.8453 81.72C80.672 82.6267 83.5253 83.08 86.4053 83.08C89.6586 83.08 92.2186 82.44 94.0853 81.16C95.952 79.88 96.8853 78.12 96.8853 75.88C96.8853 73.7467 96.0586 72.0667 94.4053 70.84C92.752 69.6133 90.0853 69 86.4053 69H80.4853V60.44L96.0853 42.76L97.5253 47.4H68.1653V37H107.365V45.4L91.8453 63.08L85.2853 59.32H89.0453C95.9253 59.32 101.125 60.8667 104.645 63.96C108.165 67.0533 109.925 71.0267 109.925 75.88C109.925 79.0267 109.099 81.9867 107.445 84.76C105.792 87.48 103.259 89.6933 99.8453 91.4C96.432 93.1067 92.0586 93.96 86.7253 93.96Z" fill="#ffffff"

component ProviderMark
  props
    driver: string
  view
    when driver == "codex"
      svg width=16 height=16 viewBox="100 100 411 411" flex-shrink=0 aria-hidden=true
        path d="M252.794 108.802C289.191 99.0484 326.265 110.305 351.148 135.135C385.113 126.072 422.85 134.862 449.492 161.505C476.136 188.149 484.925 225.888 475.862 259.85V259.854C500.696 284.735 511.95 321.81 502.198 358.207C492.447 394.602 464.161 421.084 430.215 430.217C421.083 464.162 394.603 492.448 358.206 502.199C321.812 511.951 284.734 500.693 259.852 475.864C225.887 484.927 188.15 476.137 161.507 449.495C134.864 422.851 126.073 385.111 135.136 351.149C110.304 326.266 99.0496 289.192 108.801 252.795C118.552 216.4 146.84 189.918 180.784 180.785C189.917 146.841 216.396 118.553 252.794 108.802ZM374.292 407.145C374.292 411.271 372.092 415.086 368.517 417.148L283.723 466.102C302.487 480.585 327.555 486.459 352.217 479.852C386.997 470.532 410.068 439.312 410.555 405.006V317.717C410.555 315.08 409.125 312.621 406.843 311.303L374.292 292.509V407.145ZM251.868 415.897C248.296 417.959 243.893 417.959 240.317 415.897L155.526 366.942C152.366 390.436 159.811 415.08 177.866 433.136H177.863C203.325 458.594 241.896 462.962 271.85 446.232L347.449 402.586C349.735 401.268 351.148 398.8 351.148 396.163V358.579L251.868 415.897ZM368.602 220.628C366.319 219.309 363.474 219.318 361.191 220.637L328.641 239.431L427.921 296.749C431.496 298.811 433.697 302.627 433.697 306.752V404.661C455.622 395.654 473.244 376.881 479.851 352.218C489.169 317.442 473.668 281.85 444.201 264.274L368.602 220.628ZM177.303 206.34C155.377 215.348 137.756 234.122 131.148 258.783C121.832 293.561 137.331 329.153 166.799 346.727L242.398 390.373C244.68 391.692 247.525 391.684 249.807 390.366L282.357 371.572L183.078 314.253C179.504 312.189 177.303 308.375 177.303 304.251V206.34ZM259.849 279.145V331.858L305.5 358.213L351.15 331.858V279.145L305.5 252.789L259.849 279.145ZM327.276 144.9C308.512 130.418 283.445 124.543 258.782 131.15C224.002 140.471 200.931 171.691 200.445 205.995V293.286C200.445 295.923 201.875 298.381 204.158 299.7L236.707 318.493V203.856C236.707 199.731 238.909 195.916 242.483 193.853L327.276 144.9ZM433.137 177.867C407.675 152.407 369.103 148.038 339.149 164.769L263.55 208.415C261.265 209.734 259.852 212.202 259.852 214.838V252.423L359.132 195.105C362.703 193.041 367.108 193.041 370.682 195.105L455.473 244.06C458.635 220.567 451.189 195.922 433.135 177.867H433.137Z" fill="light-dark(#71717a, #858585)" fill-rule="evenodd" clip-rule="evenodd"
    else
      Icon(name="provider", size=16, color="light-dark(#71717a, #858585)")

component ProjectMark
  props
    label: string
    muted: bool
  view
    box width=16 height=16 border-radius=4 background-color=(muted ? "light-dark(#e4e4e7, #161616)" : "light-dark(#d5f4e6, #002e21)") display="flex" align-items="center" justify-content="center" flex-shrink=0
      text label font-size=8 font-weight=700 color=(muted ? "light-dark(#92929a, #515151)" : "light-dark(#188b65, #00b883)")
