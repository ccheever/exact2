// Settings building blocks for the routes the settings-rest lane owns. Sizes
// and colors are the reference build's computed values (settingsLayout.tsx,
// SettingsGroup.tsx, ui/switch.tsx, ui/select.tsx, ui/button.tsx) at 1x, light
// and dark: CSS px are points.
use LucideChevronDown from "./settings-icons.contract"
use LucideInfo from "./settings-icons.contract"
use LucideTriangleAlert from "./settings-icons.contract"
use LucideCheck from "./settings-icons.contract"

shape SelectOption
  value: string
  label: string
  selected: bool

style SkTitle
  font-size=14 font-weight=400 line-height="20px" color="light-dark(#262629b3, #f5f5f5b3)"
style SkCard
  display="flex" flex-direction="column" width="100%" box-sizing="border-box"
  border-radius=14 border-style="solid" border-width=1 border-color="light-dark(#e4e4e899, #ffffff09)"
  background-color="light-dark(#ffffff66, #11111166)" box-shadow="0 1px 2px #0000000d"
style SkRowTitle
  font-size=14 font-weight=500 line-height="20px" color="light-dark(#27272a, #f5f5f5)"
style SkRowText
  font-size=12 font-weight=400 line-height="18px" color="light-dark(#70707acc, #818181cc)"
style SkMuted
  font-size=12 font-weight=400 line-height="16px" color="light-dark(#71717b, #818181)"
style SkInk
  color="light-dark(#27272a, #f5f5f5)"
style SkDivider
  border-top-style="solid" border-top-width=1 border-color="light-dark(#e3e3e780, #ffffff08)"
style SkOutline
  display="flex" flex-direction="row" align-items="center" justify-content="center" gap=6
  box-sizing="border-box" height=28 padding-left=9 padding-right=9 border-radius=8
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#ffffff, #ffffff07)" box-shadow="0 1px 2px #0000000d" flex-shrink=0
style SkGhost
  display="flex" flex-direction="row" align-items="center" justify-content="center"
  box-sizing="border-box" border-width=0 border-radius=6 background-color="#00000000" flex-shrink=0
style SkField
  box-sizing="border-box" height=28 padding-left=9 padding-right=9 border-radius=10
  border-style="solid" border-width=1 border-color="light-dark(#d4d4d8, #ffffff14)"
  background-color="light-dark(#fcfcfc, #ffffff07)" font-size=14 line-height="20px"
  color="light-dark(#27272a, #f5f5f5)" min-width=0
style SkError
  font-size=12 line-height="18px" color="light-dark(#dc2626, #f87171)"

// SettingsSection: a muted 14px heading over a grouped card (space-y-2.5).
component SettingsSection
  props
    title: string
    sectionId: string
  slot
  view
    column width="100%" gap=10 testId=sectionId
      row min-height=28 padding-left=16 padding-right=16 align-items="center" gap=8 box-sizing="border-box"
        text title class=SkTitle role="heading" aria-level=2
      column class=SkCard
        children

// SettingsRow: title and description beside a right-aligned control (the
// reference's @min-[32rem] grid: minmax(0,1fr) / auto, gap 32px).
component SettingsRow
  props
    title: string
    description: string
    first: bool
    rowId: string
  slot
  view
    row width="100%" box-sizing="border-box" padding-top=12 padding-bottom=12 padding-left=16 padding-right=16 gap=32 align-items="center" class=SkDivider border-top-width=(first ? 0 : 1) testId=rowId
      column flex=1 min-width=0 gap=4
        row min-height=20 align-items="center" gap=6
          text title class=SkRowTitle role="heading" aria-level=3
        when description != ""
          text description class=SkRowText max-width=576
      // grid-cols-[minmax(0,1fr)_minmax(10rem,auto)]: the control column is at least 160pt.
      row flex-shrink=0 min-width=160 align-items="center" justify-content="flex-end" gap=8
        children

// ui/switch.tsx: 30x18 track, 14px thumb, primary when checked.
component SettingsSwitch
  props
    checked: bool
    label: string
    disabled: bool
    switchId: string
    toggle: action
  view
    button press=toggle role="switch" aria-checked=checked aria-label=label disabled=disabled id=switchId testId=switchId display="flex" flex-direction="row" align-items="center" justify-content=(checked ? "flex-end" : "flex-start") width=30 height=18 padding=2 box-sizing="border-box" border-width=0 border-radius=9 flex-shrink=0 opacity=(disabled ? 0.64 : 1) background-color=(checked ? "light-dark(#1b4ed8, #346bf1)" : "light-dark(#d4d4d8, #ffffff14)")
      box width=14 height=14 border-radius=7 flex-shrink=0 background-color="light-dark(#fcfcfc, #0a0a0a)" box-shadow="0 1px 3px #0000000d"

// ui/select.tsx size="sm" trigger; the popup is the platform's menu.
component SettingsSelect
  props
    selectId: string
    label: string
    valueLabel: string
    width: number
    disabled: bool
    options: list<SelectOption>
    choose: action
  view
    button popovertarget=`${selectId}-menu` role="combobox" aria-label=label disabled=disabled id=selectId testId=selectId class=SkField display="flex" flex-direction="row" align-items="center" gap=6 width=width opacity=(disabled ? 0.64 : 1)
      text valueLabel font-size=14 line-height="20px" class=SkInk flex=1 min-width=0 line-clamp=1
      LucideChevronDown(size=12, color="light-dark(#71717b, #818181)")
    SkPopup(menuId=`${selectId}-menu`, label=label, width=width, list=true, endAlign=0)
      each option in options key=option.value
        SkMenuItem(label=option.label, menuId=`${selectId}-menu`, itemId=`${selectId}-option-${option.value}`, selected=option.selected, check=true, destructive=false, disabled=false, choose=choose(option.value))

// The reference's Select/Menu popup (rounded-lg border bg-popover p-1
// shadow-lg), painted by the kernel so every host shows the same surface.
// endAlign > 0 is the invoker's width: the popup's right edge meets the
// invoker's (MenuPopup align="end").
component SkPopup
  props
    menuId: string
    label: string
    width: number
    list: bool
    endAlign: number
  slot
  view
    column id=menuId popover="auto" position="absolute" margin-top=4 min-width=(width > 0 ? width : 160) width=(endAlign > 0 ? width : "auto") margin-left=(endAlign > 0 ? endAlign - width : 0)
      scroll width="100%" max-height=360 box-sizing="border-box" border-radius=10 border-width=1 border-style="solid" border-color="light-dark(#2727271a, #ffffff1a)" background-color="light-dark(#ffffff, #111111)" box-shadow="0 16px 40px -18px #0000008c" role=(list ? "listbox" : "menu") aria-label=label testId=menuId
        column width="100%" padding=4 box-sizing="border-box"
          children

component SkMenuItem
  props
    label: string
    menuId: string
    itemId: string
    selected: bool
    check: bool
    destructive: bool
    disabled: bool
    choose: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    button press=choose popovertarget=menuId popovertargetaction="hide" hover=hover disabled=disabled role=(check ? "option" : "menuitem") aria-selected=(check and selected) testId=itemId display="flex" flex-direction="row" align-items="center" justify-content="flex-start" gap=8 width="100%" min-height=28 padding-left=8 padding-right=8 box-sizing="border-box" border-width=0 border-radius=6 background-color=(hovered ? "light-dark(#27272a14, #f5f5f50f)" : "#00000000") opacity=(disabled ? 0.64 : 1)
      text label font-size=14 line-height="20px" flex=1 min-width=0 white-space="nowrap" color=(destructive ? "light-dark(#c10007, #ff6467)" : "light-dark(#27272a, #f5f5f5)")
      when check
        box width=14 height=14 flex-shrink=0
          when selected
            LucideCheck(size=14, color="light-dark(#27272a, #f5f5f5)")

// "Off" beside a retention switch, or the description of a disabled row.
component SettingsStatus
  props
    label: string
  view
    text label class=SkMuted

// The reference's SettingsScopeNotice / inline info line.
component SettingsNotice
  props
    message: string
    warning: bool
  view
    row width="100%" box-sizing="border-box" padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 gap=8 align-items="flex-start"
      box padding-top=3
        when warning
          LucideTriangleAlert(size=14, color="#fe9a00")
        else
          LucideInfo(size=14, color="#fe9a00")
      text message font-size=12 line-height="19.5px" color="light-dark(#71717b, #818181)" flex=1 min-width=0

// ui/tooltip.tsx TooltipPopup side="top" over an icon-micro ghost-muted trigger
// (settingsLayout PolicyTooltip, the diagnostics stat details): shown while the
// pointer rests on the trigger or it holds keyboard focus. The popup is 320pt
// wide (max-w-80), centred over the 20pt trigger, 4pt above it; textWidth stands
// in for text-balance's narrower line box.
component InfoTip
  props
    label: string
    tip: string
    tipId: string
    textWidth: number
    surface: string
    border: string
    ink: string
  slot
  state hovered = false
  state focused = false
  action hover(over: bool)
    hovered = over
  action focusTip(on: bool)
    focused = on
  view
    box position="relative" width=20 height=20 flex-shrink=0
      button hover=hover focus=focusTip(true) blur=focusTip(false) aria-label=label aria-description=tip testId=tipId display="flex" flex-direction="row" align-items="center" justify-content="center" width=20 height=20 padding=0 box-sizing="border-box" border-width=0 border-radius=4 background-color=(hovered or focused ? "light-dark(#27272a0f, #f5f5f50f)" : "#00000000")
        children
      when hovered or focused
        column position="absolute" left=-150 bottom=24 width=320 z-index=60 padding-top=4 padding-bottom=4 padding-left=8 padding-right=8 box-sizing="border-box" border-radius=8 border-width=1 border-style="solid" border-color=border background-color=surface box-shadow="0 4px 6px -1px #0000000d, 0 2px 4px -2px #0000000d" role="tooltip" testId=`${tipId}-tooltip`
          text tip font-size=12 line-height="16.5px" color=ink max-width=textWidth
