// TimelineMinimap (T3 Code, MIT; see LICENSE-T3): a rail in the transcript's
// left gutter with one 2pt strip per user message, 8pt apart. Strips of turns
// on screen are bright; hovering one widens it and its neighbours (fisheye)
// and opens a glass preview of the message and the turn's final answer.
// Pressing jumps to the turn; chevrons step to the previous and next turn.
// The rail centres on the timeline viewport, which runs from under the 52pt
// header to the window's bottom edge (the composer floats over it).
use Icon from "./icons.contract"
use Tip from "./shell-tip.contract"

shape MinimapItem
  id: string
  index: number
  label: string
  excerpt: string
  inView: bool

// resolveTimelineMinimapHeightStyle: (n - 1) × 8pt, at most 100vh − 18rem.
fn minimapHeight(count: number, windowHeight: number): number = max(1, min((count - 1) * 8, windowHeight - 288))
fn minimapTop(index: number, count: number, height: number): number = count <= 1 ? 0 : index / (count - 1) * height
// Width tiers of the hover fisheye (scale-x 1, .667, .417, .333 of 24pt).
fn stripWidth(distance: number): number = distance == 0 ? 24 : distance == 1 ? 16 : distance == 2 ? 10 : 8

component TimelineMinimap
  props
    items: list<MinimapItem>
    current: number
    gutter: number
    windowHeight: number
    local: action
  state active = -1
  state shown = -1
  state previewHover = false
  action setActive(index: number, over: bool)
    if over
      active = index
      shown = index
    else
      if active == index
        active = -1
  action setPreview(over: bool)
    previewHover = over
  derive count = length(items)
  derive railHeight = minimapHeight(count, windowHeight)
  derive hitWidth = max(0, min(40, floor(gutter) - 12))
  derive persistent = gutter >= 48
  derive open = active >= 0 or previewHover
  derive focusIndex = active >= 0 ? active : (previewHover ? shown : -1)
  view
    when count >= 2
      column position="absolute" top=0 left=0 width=72 height=(windowHeight - 52) pointer-events="none" justify-content="center" padding-left=12 box-sizing="border-box" opacity=(persistent or open ? 1 : 0) testId="timeline-minimap"
        column position="relative" width=(open ? 352 : hitWidth) height=railHeight pointer-events=(hitWidth > 0 ? "auto" : "none")
          MinimapStep(label="Previous turn", icon="chevron-up", target=(current > 0 ? current - 1 : -1), interactive=(hitWidth >= 14), top=(0 - 22), local=local)
          box position="absolute" left=12 top=0 width=1 height=railHeight background-color="light-dark(#e4e4e726, #ffffff03)"
          each item in items key=item.id
            box position="absolute" left=0 top=(minimapTop(item.index, count, railHeight) - 1) width=stripWidth(focusIndex < 0 ? 3 : max(item.index - focusIndex, focusIndex - item.index)) height=2 border-radius=1 background-color=(focusIndex == item.index ? "light-dark(#71717bbf, #818181bf)" : "light-dark(#71717b59, #81818159)") pointer-events="none"
              box width="100%" height="100%" border-radius=1 opacity=(item.inView ? 1 : 0) background-color="light-dark(#27272ae6, #f5f5f5e6)"
          each item in items key=item.id
            button press=local("jump", item.id, "") hover=setActive(item.index) aria-label=`Jump to message: ${item.label}` testId=`minimap-${item.index}` position="absolute" left=0 top=(minimapTop(item.index, count, railHeight) - 4) width=max(1, hitWidth) height=8 padding=0 border-width=0 background-color="#00000000"
          when focusIndex >= 0
            each item in filter(items, (entry) => entry.index == focusIndex) key=item.id
              column position="absolute" left=32 width=320 height=0 top=minimapTop(item.index, count, railHeight) justify-content=(item.index == 0 ? "flex-start" : item.index == count - 1 ? "flex-end" : "center")
                column hover=setPreview width=320 padding=12 box-sizing="border-box" border-radius=14 border-width=1 border-style="solid" border-color="light-dark(#2727291a, #ffffff1a)" background-color="light-dark(#fffffff7, #171717f7)" box-shadow="0 20px 25px -5px #00000040, 0 8px 10px -6px #00000040" testId="minimap-preview"
                  text item.label font-size=14 font-weight=500 line-height="20px" line-clamp=1 color="light-dark(#27272a, #f5f5f5)"
                  when item.excerpt != ""
                    text item.excerpt margin-top=4 font-size=14 line-height="20px" line-clamp=3 color="light-dark(#71717b, #818181)"
          MinimapStep(label="Next turn", icon="chevron", target=(current >= 0 and current < count - 1 ? current + 1 : -1), interactive=(hitWidth >= 14), top=(railHeight + 2), local=local)

// TimelineMinimapNavigationButton: a 20pt chevron centred 4pt into the strip,
// visible only while it is itself hovered.
component MinimapStep
  props
    label: string
    icon: string
    target: number
    interactive: bool
    top: number
    local: action
  state hovered = false
  action hover(over: bool)
    hovered = over
  view
    box position="absolute" left=-6 top=top width=20 height=20 opacity=(hovered ? 1 : 0) pointer-events=(interactive ? "auto" : "none")
      Tip(label=label, side=(label == "Previous turn" ? "top" : "bottom"), align="center", offset=24)
        button press=local("jump", "", toString(target)) hover=hover disabled=(target < 0) aria-label=label testId=(label == "Previous turn" ? "minimap-previous" : "minimap-next") width=20 height=20 padding=0 border-radius=6 border-width=0 background-color=(hovered ? "light-dark(#f4f4f5, #ffffff0a)" : "#00000000") display="flex" flex-direction="row" align-items="center" justify-content="center"
          Icon(name=icon, size=16, color="light-dark(#27272ae6, #f5f5f5e6)")
