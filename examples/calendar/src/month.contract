use Month from "./models.contract"
use TodoMark from "./agenda.contract"

// The month receives swipes from dates and compact item handles alike. Each
// handle covers one date so a tap selects the cell under it. The Mac hit-tests
// in tree order, so the date buttons follow the visual bars.
component MonthPage
  props
    compact: bool
    panMonth: action
    releaseMonth: action
    page: Month
    left: number
    width: number
    height: number
    today: number
    selected: number
    blocked: bool
    dragId: string
    activeDragId: string
    theme: number
    themeInk: string
    themeAccent: string
    themeMuted: string
    gridLine: string
    cellFill: string
    hoverFill: string
    selectedFill: string
    selectedRing: string
    hovered: string
    hoverDay: number
    dragSpan: number
    scrollTop: number
    reduceMotion: bool
    scrolled: action
    choose: action
    command: action
    create: action
    move: action
    hover: action
  derive minimumWeek = max(76, height / max(1, length(page.weeks)))
  view
    column id=`month-${page.month}` testId=`month-${page.id}` pan=panMonth panrelease=releaseMonth touch-action="pan-y" width=width height="100%" flex-shrink=0 min-height=0 position="absolute" left=left top=0 overflow="hidden" animation=(reduceMotion ? "none" : "monthIn 160ms ease-out")
      scroll id=`month-scroll-${page.month}` scrollTop=scrollTop scroll=scrolled(page.month) testId=`month-scroll-${page.id}` width="100%" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain" scrollbar-width="none" touch-action="pan-y"
        column width="100%" box-sizing="border-box"
          each week in page.weeks key=week.id
            box testId=`week-${page.id}-${week.id}` width="100%" height=max(minimumWeek, 34 + week.lanes * 24 + week.footer) position="relative" flex-shrink=0
              row position="absolute" left=0 top=0 right=0 bottom=0 aria-hidden=true
                each cell in week.cells key=cell.id
                  DateCell(cell=cell, today=today, selected=selected, theme=theme, themeInk=themeInk, themeAccent=themeAccent, themeMuted=themeMuted, gridLine=gridLine, cellFill=cellFill, hoverFill=hoverFill, selectedFill=selectedFill, selectedRing=selectedRing, hovered=hovered, hoverDay=hoverDay, dragSpan=dragSpan)
              each bar in week.bars key=bar.id
                box testId=`bar-${page.id}-${bar.id}` aria-hidden=true position="absolute" left=`calc(${bar.startCol * 100 / 7}% + 2px)` top=(34 + bar.lane * 24) width=`calc(${(bar.kind == "todo" ? 1 : bar.span) * 100 / 7}% - 4px)` height=20 box-sizing="border-box" padding-left=(bar.kind == "todo" ? 2 : 6) padding-right=(bar.kind == "todo" ? 2 : 6) overflow="hidden" background-color=(bar.kind != "event" ? "#ffffff00" : paletteColor(theme, bar.color)) border-top-left-radius=(bar.continuesBefore ? 0 : 4) border-bottom-left-radius=(bar.continuesBefore ? 0 : 4) border-top-right-radius=(bar.continuesAfter ? 0 : 4) border-bottom-right-radius=(bar.continuesAfter ? 0 : 4) display="flex" align-items="center" justify-content=(bar.kind == "plan" ? "center" : "flex-start") opacity=(dragId == bar.eventId ? 0.3 : 1)
                  when bar.kind == "plan"
                    box position="absolute" left=0 right=0 top=2 height=2 background-color=paletteColor(theme, bar.color)
                    when not bar.continuesBefore
                      box position="absolute" left=0 top=0 width=6 height=6 border-radius=3 background-color=paletteColor(theme, bar.color)
                    when not bar.continuesAfter
                      svg position="absolute" right=0 top=0 width=8 height=6 viewBox="0 0 8 6"
                        path d="M 1 0 L 7 3 L 1 6" fill="none" stroke=paletteColor(theme, bar.color) stroke-width=2
                  when bar.kind == "todo"
                    TodoMark(completed=bar.completed, color=paletteColor(theme, bar.color), size=12)
                  text bar.title margin-left=(bar.kind == "todo" ? 4 : 0) text-decoration-line=(bar.completed ? "line-through" : "none") opacity=(bar.completed ? 0.5 : 1) position=(bar.kind == "plan" ? "absolute" : "relative") left=(bar.kind == "plan" ? 0 : "auto") right=(bar.kind == "plan" ? 0 : "auto") top=(bar.kind == "plan" ? 7 : "auto") text-align=(bar.kind == "plan" ? "center" : "left") line-height="12px" font-size=11 font-weight=500 color=(bar.kind == "plan" and theme == 0 ? paletteColor(theme, bar.color) : (theme == 0 ? "#292934" : themeInk)) background-color="#ffffff00" padding-left=(bar.kind == "plan" ? 3 : 0) padding-right=(bar.kind == "plan" ? 3 : 0) max-width="100%" white-space="nowrap" text-overflow="clip" overflow="hidden"
              each cell in week.cells key=`sticker-${cell.id}`
                when cell.stickerId != ""
                  image `assets/stickers/${cell.stickerId}.png` testId=`sticker-${page.id}-${cell.date}` position="absolute" left=`calc(${(weekday(cell.day) + 1) * 100 / 7}% - 36px)` bottom=4 width=32 height=32 object-fit="contain" aria-hidden=true opacity=(activeDragId == `sticker-day:${cell.day}:${cell.stickerId}` ? 0 : 1)
              each cell in week.cells key=`hit-${cell.id}`
                button id=`day-${page.month}-${cell.day}` testId=`date-${page.id}-${cell.date}` press=choose(cell.day) touch-action="pan-y" dblclick=create("event", cell.day, cell.date) key=move(cell.day) hover=hover(`day-${cell.day}`) disabled=blocked aria-label=cell.date aria-selected=(selected == cell.day) position="absolute" left=`${weekday(cell.day) * 100 / 7}%` top=0 width="14.285714%" height="100%" padding=0 border-width=0 background-color="#ffffff00"
              when compact
                each bar in week.bars key=`handle-${bar.id}`
                  each cell in filter(week.cells, (cell) => weekday(cell.day) >= bar.startCol and weekday(cell.day) < bar.startCol + (bar.kind == "todo" ? 1 : bar.span)) key=cell.id
                    calendar-drag-handle testId=`bar-handle-${page.id}-${bar.id}-${cell.date}` event-id=bar.eventId menu-kind=bar.kind message=command(bar.eventId, bar.kind, bar.completed) completed=(bar.completed ? "true" : "false") enabled=(blocked ? "false" : "true") press=choose(cell.day) aria-label=bar.title position="absolute" left=`calc(${weekday(cell.day) * 100 / 7}% + 2px)` top=(34 + bar.lane * 24) width=`calc(${100 / 7}% - 4px)` height=20
                each cell in week.cells key=`sticker-handle-${cell.id}`
                  when cell.stickerId != ""
                    calendar-drag-handle testId=`sticker-cell-${page.id}-${cell.date}` event-id=`sticker-day:${cell.day}:${cell.stickerId}` enabled=(blocked ? "false" : "true") press=choose(cell.day) aria-label=`${cell.stickerId} sticker on ${cell.date}` position="absolute" left=`calc(${(weekday(cell.day) + 1) * 100 / 7}% - 36px)` bottom=4 width=32 height=32

// What a date shows; its button lies above the week's bars.
component DateCell
  props
    cell: Cell
    today: number
    selected: number
    theme: number
    themeInk: string
    themeAccent: string
    themeMuted: string
    gridLine: string
    cellFill: string
    hoverFill: string
    selectedFill: string
    selectedRing: string
    hovered: string
    hoverDay: number
    dragSpan: number
  derive highlighted = inRange(cell.day, hoverDay, dragSpan)
  derive isSelected = selected == cell.day
  derive hot = hovered == `day-${cell.day}`
  view
    box position="relative" width="14.285714%" height="100%" box-sizing="border-box" padding-top=5 border-style="solid" border-top-width=1 border-left-width=(weekday(cell.day) == 0 ? 0 : 1) border-bottom-width=0 border-right-width=0 border-color=gridLine background-color=(highlighted ? "rgba(174,192,255,0.30)" : cellFill) display="flex" flex-direction="column" align-items="center" justify-content="flex-start" transition="background-color 100ms ease-out"
      box position="absolute" left=4 top=4 right=4 bottom=4 border-radius=9 box-sizing="border-box" border-style="solid" border-width=1 background-color=(isSelected and not highlighted ? selectedFill : (hot and not highlighted ? hoverFill : "#ffffff00")) border-color=(isSelected and not highlighted ? selectedRing : "#ffffff00") transition="background-color 120ms ease-out, border-color 120ms ease-out" aria-hidden=true
      when highlighted
        svg position="absolute" left=0 top=0 width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden=true
          path d="M 0 0.5 L 100 0.5 M 0 99.5 L 100 99.5" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay or weekday(cell.day) == 0
            path d="M 0.5 0 L 0.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
          when cell.day == hoverDay + dragSpan or weekday(cell.day) == 6
            path d="M 99.5 0 L 99.5 100" fill="none" stroke="#AAC4FF" stroke-width=1 stroke-dasharray="5 4" vector-effect="non-scaling-stroke"
      box width=24 height=24 border-radius=12 background-color=(cell.day == today ? themeAccent : "#ffffff00") display="flex" align-items="center" justify-content="center"
        text `${cell.number}` font-size=13 font-weight=(cell.day == today or isSelected ? 600 : 400) color=(cell.day == today ? "#ffffff" : (isSelected ? themeAccent : (cell.inMonth ? themeInk : themeMuted)))

component Weekday
  props
    label: string
    tone: string
  view
    text label width="14.285714%" font-size=12 font-weight=600 text-align="center" color=tone
