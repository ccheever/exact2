use Viewport, dropIn from "./models.contract"
use ToolButton from "./editor.contract"

component ThemeChoice
  props
    value: number
    title: string
    wallpaper: string
    selected: number
    surface: string
    field: string
    ink: string
    muted: string
    border: string
    accent: string
    hot: bool
    pick: action
    hover: action
  view
    button press=pick(value) hover=hover(`theme-${value}`) testId=`theme-${value}` aria-label=`Use ${title} theme` aria-selected=(selected == value) position="relative" width="calc(25% - 7.5px)" flex-shrink=0 min-width=0 height=104 box-sizing="border-box" padding=6 border-width=(selected == value ? 2 : 1) border-style="solid" border-color=(selected == value ? accent : border) border-radius=12 background-color=(selected == value or hot ? field : surface) display="flex" flex-direction="column" align-items="center" gap=6 transition="background-color 100ms ease-out"
      when value == 0
        box testId="theme-classic-preview" width="100%" height=64 flex-shrink=0 border-radius=8 background-color="#ffffff" overflow="hidden" aria-hidden=true
          svg width="100%" height=64 viewBox="0 0 160 96" preserveAspectRatio="xMidYMid slice"
            text "Sep" x=10 y=17 font-size=12 font-weight=600 fill="#242428"
            text "S" x=14 y=30 text-anchor="middle" font-size=6 fill="#d97777"
            text "M" x=36 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "T" x=58 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "W" x=80 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "T" x=102 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "F" x=124 y=30 text-anchor="middle" font-size=6 fill="#929299"
            text "S" x=146 y=30 text-anchor="middle" font-size=6 fill="#7796c1"
            path d="M 6 35 L 154 35 M 6 57 L 154 57 M 6 79 L 154 79" fill="none" stroke="#ededf1" stroke-width=0.7
            rect x=8 y=47 width=43 height=6 rx=1.5 fill="#FA7070"
            rect x=76 y=47 width=75 height=6 rx=1.5 fill="#747AFF"
            circle cx=11 cy=71 r=1.8 fill="#70B8A2"
            path d="M 11 71 L 95 71 M 91 68 L 95 71 L 91 74" fill="none" stroke="#70B8A2" stroke-width=1.1 stroke-linecap="round" stroke-linejoin="round"
            circle cx=115 cy=87 r=3 fill="none" stroke="#747AFF" stroke-width=1.1
      else
        image wallpaper width="100%" height=64 flex-shrink=0 object-fit="cover" border-radius=8
      text title font-size=12 font-weight=(selected == value ? 600 : 500) line-height="16px" color=(selected == value ? ink : muted) max-width="100%" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
      when selected == value
        box position="absolute" top=11 right=11 width=20 height=20 border-radius=10 background-color=surface display="flex" align-items="center" justify-content="center"
          text "✓" font-size=13 font-weight=700 color=accent

// One segment of the editor's kind switch.

component Themes
  props
    themeOpen: bool
    themeClosing: bool
    compact: bool
    theme: number
    viewport: Viewport
    themeBorder: string
    themeSurface: string
    themeInk: string
    themeMuted: string
    themeField: string
    themeAccent: string
    hovered: string
    closeThemes: action
    keepThemes: action
    chooseTheme: action
    hoverOn: action
  view
    when themeOpen
      box testId="theme-backdrop" press=closeThemes position="absolute" left=0 right=0 top=0 bottom=0 z-index=30 background-color="#ffffff00"
      column id="theme-popup" testId="theme-popup" role="dialog" aria-label="Theme" press=keepThemes position="absolute" top=(compact ? "auto" : "calc(env(safe-area-inset-top) + 46px)") bottom=(compact ? "env(safe-area-inset-bottom)" : "auto") right=(compact ? 0 : 384) width=(compact ? viewport.width : 520) max-width=(compact ? "100%" : "calc(100% - 400px)") box-sizing="border-box" padding=14 gap=10 border-radius=12 border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface box-shadow="0 12px 40px rgba(28, 31, 44, 0.18)" z-index=31 opacity=(themeClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : "opacity 120ms ease-in") animation=(viewport.prefersReducedMotion or themeClosing ? "none" : "dropIn 140ms ease-out")
        row height=24 align-items="center"
          text "Theme" flex=1 font-size=14 font-weight=600 color=themeInk
          button press=closeThemes testId="close-themes" aria-label="Close themes" aria-keyshortcuts="Escape" class=ToolButton width=24 height=24 border-radius=6 background-color="#ffffff00"
            image "symbol:close" font-size=11 -exact-tint-color=themeMuted
        row gap=10
          ThemeChoice(value=0, title="Classic", wallpaper="", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-0"), pick=chooseTheme, hover=hoverOn)
          ThemeChoice(value=1, title="Blush Notebook", wallpaper="assets/themes/blush.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-1"), pick=chooseTheme, hover=hoverOn)
          ThemeChoice(value=2, title="Paris Haze", wallpaper="assets/themes/paris.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-2"), pick=chooseTheme, hover=hoverOn)
          ThemeChoice(value=6, title="San Francisco", wallpaper="assets/themes/sanfrancisco.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-6"), pick=chooseTheme, hover=hoverOn)
        row gap=10
          ThemeChoice(value=3, title="Meadow Morning", wallpaper="assets/themes/meadow.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-3"), pick=chooseTheme, hover=hoverOn)
          ThemeChoice(value=4, title="Lavender Sky", wallpaper="assets/themes/lavender.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-4"), pick=chooseTheme, hover=hoverOn)
          ThemeChoice(value=5, title="Linen Journal", wallpaper="assets/themes/linen.png", selected=theme, surface=themeSurface, field=themeField, ink=themeInk, muted=themeMuted, border=themeBorder, accent=themeAccent, hot=(hovered == "theme-5"), pick=chooseTheme, hover=hoverOn)
