                  svg width="100%" height="100%" viewBox="0 0 20 20"
                    circle cx=10 cy=10 r=8.5 fill=(dragCompleted ? dragTint : "none") stroke=dragTint stroke-width=1.5
                    when dragCompleted
                      path d="M 5.5 10 L 8.5 13 L 14.5 7" fill="none" stroke="#ffffff" stroke-width=1.8 stroke-linecap="round" stroke-linejoin="round"
              // The dates fade; the title moves onto the block and shrinks to its size.
              text dragRangeLabel testId="calendar-drag-range" position="absolute" left=rangeX top=rangeY width=214 font-size=12 color=themeMuted white-space="nowrap" overflow="hidden" text-overflow="clip" opacity=(landed or lifted ? 0 : 1) transition=fadeTiming
              text dragTitle id="calendar-drag-title" testId="calendar-drag-title" position="absolute" left=(landed ? (dragKind == "todo" ? 18 : (dragKind == "plan" ? 3 : 6)) : (lifted ? chipX + (dragKind == "todo" ? 20 : (dragKind == "plan" ? 3 : 8)) : titleX)) top=(landed ? (dragKind == "plan" ? 7 : 4) : (lifted ? chipY + (dragKind == "plan" ? 8 : 5) : titleY)) width=214 font-size=14 font-weight=500 color=dragInk text-decoration-line=(dragCompleted ? "line-through" : "none") white-space="nowrap" overflow="hidden" text-overflow="clip" scale=(landed ? 11 / 14 : (lifted ? 12 / 14 : 1)) transform-origin="0px 0px" opacity=(landed ? 0 : (dragCompleted ? 0.5 : 1)) transition=fadeTiming layout-transition="300ms ease-in-out"
