                box position="absolute" left=(landed ? 0 : (lifted ? chipX : markX + 1)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 8)) width=(lifted or landed ? 6 : 4) height=(lifted or landed ? 6 : 4) border-radius=3 background-color=dragTint opacity=(landed and landingBefore ? 0 : 1) transition=fadeTiming layout-transition="300ms ease-in-out"
                box position="absolute" left=(landed ? landingWidth - 8 : (lifted ? chipX + 192 : markX + 12)) top=(landed ? 0 : (lifted ? chipY + 1 : markY + 5)) width=(lifted or landed ? 8 : 6) height=(lifted or landed ? 6 : 10) opacity=(landed and landingAfter ? 0 : 1) transition=fadeTiming layout-transition="300ms ease-in-out"
