use Viewport, dialogIn from "./models.contract"
use Event from "./models.contract"
style FieldLabel
  font-size=12 font-weight=500 color="#74747c"
style DateField
  box-sizing="border-box" min-width=0 height=26 padding=0 border-width=0 border-radius=6 background-color="#ffffff00" color="#242428" font-size=13
style ToolButton
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=28 padding=0 border-width=0 border-radius=7 press-scale=0.96
style FooterButton
  display="flex" flex-direction="row" align-items="center" justify-content="center" height=30 padding-top=0 padding-bottom=0 padding-left=14 padding-right=14 border-radius=7 press-scale=0.97


component ColorChoice
  props
    value: string
    label: string
    selected: string
    disabled: bool
    pick: action
  view
    button press=pick(value) disabled=disabled testId=`color-${label}` aria-label=label aria-selected=(selected == value) width=24 height=24 flex-shrink=0 padding=0 border-width=(selected == value ? 2 : 0) border-style="solid" border-color="#ffffff" box-shadow=(selected == value ? `0 0 0 2px ${value}` : "none") border-radius=12 background-color=value display="flex" align-items="center" justify-content="center" press-scale=0.94
      when selected == value
        text "✓" font-size=12 font-weight=700 color="#ffffff"


component KindTab
  props
    kind: string
    title: string
    selected: string
    disabled: bool
    ink: string
    muted: string
    surface: string
    pick: action
  view
    button testId=`kind-${kind}` press=pick(kind) role="radio" aria-checked=(selected == kind) disabled=disabled height=28 padding-left=12 padding-right=12 border-width=0 border-radius=7 background-color=(selected == kind ? surface : "#ffffff00") box-shadow=(selected == kind ? "0 1px 2px rgba(28, 31, 44, 0.14)" : "none") display="flex" align-items="center" justify-content="center"
      text title font-size=13 font-weight=(selected == kind ? 600 : 500) color=(selected == kind ? ink : muted)

component Editor
  props
    editorOpen: bool
    editorClosing: bool
    compact: bool
    busy: bool
    editorReady: bool
    opening: bool
    libraryReady: bool
    allDay: bool
    confirmDelete: bool
    editorKind: string
    editorLabel: string
    editId: string
    title: string
    notes: string
    startDate: string
    endDate: string
    startTime: string
    endTime: string
    color: string
    error: string
    themeSurface: string
    themeInk: string
    themeMuted: string
    themeField: string
    themeBorder: string
    themeAccent: string
    sheetOffset: number
    viewport: Viewport
    opened: Event
    refocusEditor: action
    setKind: action
    retryEvent: action
    writeTitle: action
    save: action
    editorKey: action
    writeNotes: action
    toggleAllDay: action
    writeStartDate: action
    writeStartTime: action
    writeEndDate: action
    writeEndTime: action
    pickColor: action
    keepEvent: action
    remove: action
    askDelete: action
    closeEditor: action
    panSheet: action
    releaseSheet: action
  view
    when editorOpen
      box testId="editor-backdrop" press=refocusEditor position="absolute" left=0 right=0 top=0 bottom=0 z-index=40 background-color="rgba(28, 31, 44, 0.24)" display="flex" align-items=(compact ? "flex-end" : "center") justify-content="center" opacity=(editorClosing ? 0 : 1) transition=(viewport.prefersReducedMotion ? "none" : (editorClosing ? "opacity 120ms ease-in" : "opacity 160ms ease-out"))
        column id="schedule-editor" testId=(editorKind == "todo" ? "todo-editor" : "schedule-editor") role="dialog" aria-label=editorLabel press=refocusEditor width=(compact ? viewport.width : 480) max-height=(compact ? "92%" : "calc(100% - 96px)") padding-bottom=(compact ? "env(safe-area-inset-bottom)" : "0px") translate=`0px ${compact ? max(0, sheetOffset) : 0}px` min-height=0 box-sizing="border-box" border-radius=14 background-color=themeSurface box-shadow="0 24px 64px rgba(28, 31, 44, 0.28)" overflow="hidden" scale=(editorClosing ? 0.98 : 1) transition=(viewport.prefersReducedMotion ? "none" : "scale 120ms ease-in") animation=(viewport.prefersReducedMotion or editorClosing ? "none" : "dialogIn 160ms ease-out")
          when compact
            row height=24 flex-shrink=0 align-items="center" justify-content="center" touch-action="none" pan=panSheet panrelease=releaseSheet testId="editor-sheet-handle"
              box width=36 height=5 border-radius=3 background-color=themeBorder
          row height=56 flex-shrink=0 box-sizing="border-box" padding-left=24 padding-right=20 align-items="center" gap=12
            text editorLabel testId="editor-title" flex=1 min-width=0 font-size=16 font-weight=600 color=themeInk white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
            when editId == ""
              row testId="kind-tabs" role="radiogroup" aria-label="Item kind" height=32 flex-shrink=0 box-sizing="border-box" padding=2 gap=2 border-radius=9 background-color=themeField align-items="center"
                KindTab(kind="event", title="Event", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
                KindTab(kind="plan", title="Plan", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
                KindTab(kind="todo", title="Todo", selected=editorKind, disabled=busy, ink=themeInk, muted=themeMuted, surface=themeSurface, pick=setKind)
          scroll testId="editor-fields" flex=1 min-height=0 overflow-x="hidden" overscroll-behavior="contain"
            column padding-left=24 padding-right=24 padding-top=2 padding-bottom=18 gap=14
              when not editorReady
                text (opening ? "Opening…" : opened.message) color="#b74238" font-size=13 testId="event-error"
                when opened.message != "" and not opening
                  button press=retryEvent disabled=busy testId="retry-event" class=FooterButton align-self="flex-start" border-width=0 background-color=themeField
                    text "Try again" font-size=13 color=themeMuted
              input id="schedule-title" testId="schedule-title" aria-label="Title" placeholder=(editorKind == "todo" ? "What needs doing?" : "What are you planning?") value=title input=writeTitle submit=save key=editorKey disabled=(busy or not editorReady) width="100%" height=40 box-sizing="border-box" padding=0 border-width=0 background-color="#ffffff00" font-size=22 font-weight=600 letter-spacing=-0.3 color=themeInk
              textarea id="schedule-notes" testId="schedule-notes" aria-label="Notes" placeholder="Add a description…" value=notes input=writeNotes disabled=(busy or not editorReady) width="100%" height=60 min-height=60 box-sizing="border-box" padding=0 font-size=13 font-family="system-ui" line-height="19px" border-width=0 background-color="#ffffff00" color=themeInk
              column border-style="solid" border-top-width=1 border-right-width=0 border-bottom-width=1 border-left-width=0 border-color=themeBorder
                when editorKind != "todo"
                  row align-items="center" gap=8 height=40
                    text "All day" flex=1 font-size=13 color=themeInk
                    input type="checkbox" switch checked=allDay change=toggleAllDay disabled=(busy or not editorReady) testId="all-day" aria-label="All day" accent-color=themeAccent
                  box height=1 background-color=themeBorder
                row align-items="center" gap=8 height=40
                  text (editorKind == "todo" ? "Date" : "Starts") flex=1 min-width=0 font-size=13 color=themeInk
                  input type="date" id="start-date" testId="start-date" aria-label=(editorKind == "todo" ? "Todo date" : "Start date") value=startDate input=writeStartDate disabled=(busy or not editorReady) class=DateField width=128 color=themeInk min="1900-01-01" max="2100-12-31"
                  when editorKind != "todo" and not allDay
                    input type="time" id="start-time" testId="start-time" aria-label="Start time" value=startTime input=writeStartTime disabled=(busy or not editorReady) class=DateField width=88 color=themeInk
                when editorKind != "todo"
                  box height=1 background-color=themeBorder
                  row align-items="center" gap=8 height=40
                    text "Ends" flex=1 min-width=0 font-size=13 color=themeInk
                    input type="date" id="end-date" testId="end-date" aria-label="End date, included" value=endDate input=writeEndDate disabled=(busy or not editorReady) class=DateField width=128 color=themeInk min="1900-01-01" max="2100-12-31"
                    when not allDay
                      input type="time" id="end-time" testId="end-time" aria-label="End time" value=endTime input=writeEndTime disabled=(busy or not editorReady) class=DateField width=88 color=themeInk
              row gap=12 align-items="center"
                text "Color" class=FieldLabel color=themeMuted flex=1
                ColorChoice(value="#FA7070", label="Coral", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                ColorChoice(value="#747AFF", label="Blue", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                ColorChoice(value="#70B8A2", label="Mint", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                ColorChoice(value="#F39B65", label="Honey", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                ColorChoice(value="#D4BEF1", label="Lilac", selected=color, disabled=(busy or not editorReady), pick=pickColor)
                ColorChoice(value="#EE8192", label="Rose", selected=color, disabled=(busy or not editorReady), pick=pickColor)
              when error != ""
                text error testId="editor-error" aria-live="assertive" font-size=13 color="#b74238" padding=10 border-radius=8 background-color=themeField
          row testId="editor-footer" height=56 flex-shrink=0 box-sizing="border-box" padding-left=20 padding-right=20 align-items="center" gap=8 border-style="solid" border-top-width=1 border-right-width=0 border-bottom-width=0 border-left-width=0 border-color=themeBorder
            when confirmDelete
              text (editorKind == "todo" ? "Delete this todo?" : "Delete this item from every date?") testId="delete-question" flex=1 min-width=0 font-size=13 font-weight=500 color="#b74238" white-space="nowrap" text-overflow="ellipsis" overflow="hidden"
              button press=keepEvent disabled=busy testId="keep-schedule" aria-keyshortcuts="Escape" class=FooterButton border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface
                text "Keep" font-size=13 font-weight=500 color=themeInk
              button press=remove disabled=busy testId="confirm-delete" class=FooterButton border-width=0 background-color="#df666c"
                text (busy ? "Deleting…" : "Delete") font-size=13 font-weight=600 color="#ffffff"
            else
              when editId != ""
                button press=askDelete disabled=(busy or not editorReady) testId="delete-schedule" class=FooterButton padding-left=8 padding-right=8 border-width=0 background-color="#ffffff00"
                  text (editorKind == "todo" ? "Delete Todo…" : "Delete…") font-size=13 font-weight=500 color="#c85353"
              box flex=1
              button press=closeEditor testId="cancel-editor" aria-label="Cancel editing" aria-keyshortcuts="Escape" disabled=busy class=FooterButton border-width=1 border-style="solid" border-color=themeBorder background-color=themeSurface
                text "Cancel" font-size=13 font-weight=500 color=themeInk
              button press=save testId="save-schedule" aria-label=(editId != "" ? "Save item" : "Add item") disabled=(busy or not libraryReady or not editorReady or title == "") class=FooterButton border-width=0 background-color=(busy or title == "" ? themeBorder : themeAccent)
                text (busy ? "Saving…" : (editId != "" ? "Save" : "Add")) font-size=13 font-weight=600 color=(busy or title == "" ? themeMuted : "#ffffff")
