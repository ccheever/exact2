// The world is a guest; its HUD is ordinary Contract children.
shape Hud
  beacons: number

component Greybox
  state playing = false
  state seed = 7
  state paused = false
  state again = false
  resource hud = exactSurface("world") as shape Hud

  action play
    playing = true
  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  view
    main width="100%" height="100%" background-color="#202731" color="#ffffff"
      when playing
        canvas surface=world(seed=seed, paused=paused, restart=again) testId="world" width="100%" height="100%" position="relative" overflow="hidden"
          when hud.beacons == 1
            column testId="victory" position="absolute" inset=0 align-items="center" justify-content="center" gap=20
              text "All beacons lit" font-size=32
              button press=restart autofocus aria-label="Play again" testId="again" padding=16 background-color="#e8ad61"
                text "Play again" color="#202731"
          text `Beacons ${hud.beacons} / 1` aria-live="polite" testId="hud-beacons" position="absolute" top=24 left=24 padding=12 border-radius=8 background-color="#202731" color="#ffffff" font-size=18 font-weight=600
          button press=togglePause aria-label=(paused ? "Resume" : "Pause") testId="pause" position="absolute" top=24 right=24 padding=12 border-radius=8 background-color="#202731"
            text (paused ? "Resume" : "Pause") color="#ffffff" font-size=16 font-weight=600
      else
        column height="100%" align-items="center" justify-content="center" gap=24
          text "Grey box" font-size=48 font-weight=600 color="#ffffff"
          button press=play autofocus aria-label="Play" testId="play" padding=16 border-radius=8 background-color="#e8ad61"
            text "Play" font-size=20 font-weight=600 color="#202731"
