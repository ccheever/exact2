shape Hud
  buys: number

component ShortcutFixture
  resource hud = exactSurface("world") as shape Hud
  view
    main width="100%" height="100%" background-color="#101725" color="#ffffff"
      canvas surface=world() testId="world" width="100%" height="100%"
        text `Bought ${hud.buys}` testId="bought" aria-live="polite" position="absolute" top=24 left=24 padding=12 background-color="#202731"
        button action="buy" aria-keyshortcuts="1" aria-label="Buy" testId="buy" position="absolute" top=24 right=24 padding=12 background-color="#e8ad61"
          text "1 · Buy" color="#202731"
