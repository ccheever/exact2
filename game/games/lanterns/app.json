        "iphone",
        "ipad"
      ]
    },
    "web": {}
  },
  "game": {
    "crate": "lanterns-logic",
    "type": "Lanterns",
    "assets": true,
    "audio": true
  },
  "rust": false,
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0",
      "linux": "0"
    }
