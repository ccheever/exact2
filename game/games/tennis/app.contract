shape Hud
  you_games: number
  jev_games: number
  you_points: string
  jev_points: string
  serving: string
  call: string
  prompt: string
  jev: string
  jev_state: string
  jev_status: string
  ask: string
  over: bool
  winner: string
  asked: number
  on_time: number
  late: number
  rally: number
  longest: number

// The world publishes a numbered question in hud.ask; this resource carries
// it to Jev (data/src/lib.rs) and its answer returns as the world's live
// `plan` argument. A new question supersedes one still in flight.
component Tennis
  state playing = false
  state offline = false
  state again = false
  state paused = false
  resource hud = exactSurface("world") as shape Hud
  resource plan = jev(hud.ask) as shape string

  action playJev
    offline = false
    paused = false
    playing = true

  action playOffline
    offline = true
    paused = false
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action menu
    playing = false
    paused = false

  view
    main width="100%" height="100%" background-color="#0b1726" color="#f8fafc"
      when playing
        canvas surface=world(seed=7, offline=offline, paused=paused, restart=again, plan=plan) testId="world" width="100%" height="100%" position="relative"
          when paused and not hud.over
            column testId="paused" position="absolute" inset=0 align-items="center" justify-content="center" gap=12 background-color="#0b172699"
              text "Paused" font-size=40 font-weight=800
              text "Jev's clock stops too." color="#cbd5e1"
          row position="absolute" top=16 left=16 right=16 gap=12 align-items="flex-start" justify-content="space-between"
            column testId="scoreboard" gap=4 padding=10 border-radius=12 background-color="#0b1726d9" min-width=176
              row gap=8 align-items="center"
                text (hud.serving == "you" ? "●" : " ") width=10 color="#c6f432" font-size=12
                text "You" width=64 font-weight=600 color="#fdba74"
                text `${hud.you_games}` testId="you-games" width=20 text-align="center" font-weight=700
                text hud.you_points testId="you-points" width=36 padding-top=2 padding-bottom=2 text-align="center" border-radius=6 background-color="#1e3a5f" font-weight=700
              row gap=8 align-items="center"
                text (hud.serving == "jev" ? "●" : " ") width=10 color="#c6f432" font-size=12
                text "Jev" width=64 font-weight=600 color="#5eead4"
                text `${hud.jev_games}` testId="jev-games" width=20 text-align="center" font-weight=700
                text hud.jev_points testId="jev-points" width=36 padding-top=2 padding-bottom=2 text-align="center" border-radius=6 background-color="#1e3a5f" font-weight=700
            column flex-shrink=1 align-items="center" gap=8
              row testId="jev" gap=8 align-items="center" padding-top=8 padding-bottom=8 padding-left=14 padding-right=14 border-radius=20 background-color="#0b1726d9" border-width=1 border-color=(hud.jev_state == "late" ? "#fbbf24" : hud.jev_state == "unavailable" ? "#f87171" : hud.jev_state == "thinking" ? "#5eead4" : "#1e3a5f")
                text (pending(plan) ? "◌" : hud.jev_state == "late" ? "!" : "●") testId="jev-dot" color=(hud.jev_state == "late" ? "#fbbf24" : hud.jev_state == "unavailable" ? "#f87171" : "#5eead4") font-weight=700
                text (hud.jev == "" ? (offline ? "Offline opponent" : "Jev is watching") : hud.jev) testId="jev-line" aria-live="polite" font-size=15
                when hud.jev_status != ""
                  text hud.jev_status testId="jev-status" font-size=13 color=(hud.jev_state == "late" ? "#fbbf24" : hud.jev_state == "unavailable" ? "#f87171" : "#94a3b8")
              when hud.call != ""
                text hud.call testId="call" aria-live="assertive" padding-top=6 padding-bottom=6 padding-left=16 padding-right=16 border-radius=8 background-color="#c6f432" color="#0b1726" font-size=20 font-weight=800 letter-spacing=0.5
            row gap=8
              when paused
                button press=menu testId="menu" aria-label="Menu" padding=12 border-radius=10 background-color="#1e3a5f"
                  text "Menu"
                button press=restart testId="restart" aria-label="Restart" padding=12 border-radius=10 background-color="#1e3a5f"
                  text "Restart"
              button press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") padding=12 border-radius=10 background-color="#0b1726d9"
                text (paused ? "Resume" : "Pause")
          when hud.prompt != "" and not paused
            row position="absolute" left=0 right=0 bottom=148 justify-content="center"
              text hud.prompt testId="prompt" padding=10 border-radius=10 background-color="#0b1726d9" font-size=16
          button action="move" role="slider" aria-label="Move" testId="move" position="absolute" left=24 bottom=24 width=112 height=112 border-radius=56 background-color="#f8fafc26" border-width=2 border-color="#f8fafc55"
            text "Move" color="#f8fafc" text-align="center" padding-top=44
          row position="absolute" right=24 bottom=24 gap=12 align-items="flex-end"
            button action="backhand" aria-label="Backhand (K)" testId="backhand" width=92 height=92 border-radius=46 background-color="#1e3a5f" border-width=2 border-color="#5eead4"
              column align-items="center" padding-top=26
                text "Backhand" font-size=14 font-weight=700
                text "K" font-size=12 color="#94a3b8"
            button action="forehand" aria-label="Forehand (J)" testId="forehand" width=108 height=108 border-radius=54 background-color="#c6f432" color="#0b1726"
              column align-items="center" padding-top=32
                text "Forehand" font-size=15 font-weight=800
                text "J" font-size=12 color="#334155"
          when hud.over
            column testId="match-over" position="absolute" inset=0 align-items="center" justify-content="center" gap=16 background-color="#0b1726cc"
              text (hud.winner == "You" ? "You win!" : "Jev wins") testId="winner" font-size=48 font-weight=800 color=(hud.winner == "You" ? "#fdba74" : "#5eead4")
              text `${hud.you_games} – ${hud.jev_games} in games · longest rally ${hud.longest}` font-size=18
              text (offline ? "Offline opponent" : `Jev decided ${hud.on_time} shots in time · ${hud.late} late (fallback played)`) color="#cbd5e1" testId="jev-stats"
              row gap=12
                button press=restart autofocus aria-label="Play again" testId="again" padding=16 border-radius=12 background-color="#c6f432"
                  text "Play again" color="#0b1726" font-weight=700
                button press=menu aria-label="Menu" testId="over-menu" padding=16 border-radius=12 background-color="#1e3a5f"
                  text "Menu"
      else
        column height="100%" box-sizing="border-box" padding=24 align-items="center" justify-content="center" gap=20
          text "TENNIS" font-size=64 font-weight=800 letter-spacing=6 color="#c6f432"
          text "versus Jev, an AI that plans every shot" font-size=20 color="#cbd5e1" text-align="center"
          column width="100%" max-width=460 gap=6 padding=16 border-radius=14 background-color="#12233a"
            text "Move with WASD, the arrow keys or the stick" width="100%" text-align="center"
            text "J forehand · K backhand — on the correct side, in time" width="100%" text-align="center"
            text "Early pulls crosscourt, late pushes down the line" width="100%" text-align="center" color="#cbd5e1"
            text "Hold ↑ to flatten, ↓ to slice, ←/→ to aim" width="100%" text-align="center" color="#cbd5e1"
            text "Serve: J or K to toss, again at the top" width="100%" text-align="center" color="#cbd5e1"
            text "First to 4 games" width="100%" text-align="center" color="#cbd5e1"
          row gap=12
            button press=playJev autofocus aria-label="Play Jev" testId="play" padding=16 border-radius=12 background-color="#c6f432"
              text "Play Jev" font-size=20 font-weight=700 color="#0b1726"
            button press=playOffline aria-label="Play offline" testId="offline" padding=16 border-radius=12 background-color="#1e3a5f"
              text "Play offline" font-size=20 color="#f8fafc"
          text "Jev needs AI_GATEWAY_API_KEY (native) or the dev proxy (web): see README" font-size=13 color="#94a3b8" text-align="center"
