shape Hud
  day: number
  phase: string
  left: number
  survived: number
  health: number
  hunger: number
  battery: number
  flashlight: bool
  fuel: number
  radius: number
  logs: number
  scrap: number
  food: number
  prompt: string
  rescued: number
  children: number
  dead: bool
  deer: string
  chasing: number
  trees: number
  wolves: number

// The title chooses the forest's size and the pack count; both rebuild the world.
// `lite` swaps Rapier's trunk colliders for game-code collision on the tree grid.
component Forest
  state playing = false
  state again = false
  state paused = false
  state trees = 2000
  state wolves = 8
  state lite = false
  state primitives = false
  state torches = 0
  resource hud = exactSurface("world") as shape Hud

  action play
    playing = true
    paused = false

  action size(n: number)
    trees = n

  action pack(n: number)
    wolves = n

  action light(n: number)
    torches = n

  action toggleLite
    lite = not lite

  action togglePrimitives
    primitives = not primitives

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action menu
    playing = false
    paused = false

  view
    main width="100%" height="100%" background-color="#070b0a" color="#eef2e8"
      when playing
        canvas surface=world(seed=7, trees=trees, wolves=wolves, children=2, torches=torches, primitives=primitives, lite=lite, paused=paused, restart=again) testId="world" width="100%" height="100%" position="relative"
          row position="absolute" top=16 left=16 right=16 gap=12 align-items="flex-start" justify-content="space-between"
            column testId="clock" gap=6 padding=14 border-radius=14 background-color="#0a0e0cd9" border-width=1 border-color=(hud.phase == "Night" ? "#3b4470" : "#5a4a26") min-width=196
              row gap=8 align-items="baseline"
                text (hud.phase == "Night" ? "☾" : "☀") font-size=20 color=(hud.phase == "Night" ? "#93a4ff" : "#f6d77a")
                text `Day ${hud.day} · ${hud.phase}` testId="day" font-size=20 font-weight=700 color=(hud.phase == "Night" ? "#b7c2ff" : "#f6d77a")
              row width=168 height=4 border-radius=2 background-color="#ffffff1f"
                row width=((hud.phase == "Night" ? hud.left / 50 : hud.left / 80) * 168) height=4 border-radius=2 background-color=(hud.phase == "Night" ? "#7083e8" : "#e8b04a")
              text `${hud.left} s until ${hud.phase == "Night" ? "dawn" : "night"}` testId="left" font-size=12 color="#9aa596"
              text `Nights survived: ${hud.survived}` testId="survived" aria-live="polite" font-size=13 font-weight=600
            column testId="fire" gap=6 padding=14 border-radius=14 background-color="#0a0e0cd9" border-width=1 border-color=(hud.fuel < 20 ? "#a33a22" : "#6b3f1a") align-items="center" min-width=196
              row gap=8 align-items="baseline"
                text "🔥" font-size=16
                text `Fire ${hud.fuel}%` testId="fuel" font-weight=700 color=(hud.fuel < 20 ? "#ff7a59" : "#ffb35c")
              row width=168 height=7 border-radius=4 background-color="#ffffff1f"
                row width=(hud.fuel * 1.68) height=7 border-radius=4 background-color=(hud.fuel < 20 ? "#e0472b" : "#f08a2c")
              text `Safe radius ${hud.radius} m` testId="radius" font-size=12 color="#9aa596"
            row gap=8
              when paused
                button press=restart testId="restart" aria-label="Restart" padding=12 border-radius=12 background-color="#2d3a33"
                  text "Restart"
                button press=menu testId="menu" aria-label="Menu" padding=12 border-radius=12 background-color="#2d3a33"
                  text "Menu"
              button press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") padding=12 border-radius=12 background-color="#0a0e0cd9" border-width=1 border-color="#3a4a3f"
                text (paused ? "Resume" : "Pause")
          column testId="vitals" position="absolute" left=16 bottom=16 gap=7 padding=14 border-radius=14 background-color="#0a0e0cd9" border-width=1 border-color="#3a4a3f" min-width=220
            row gap=8 align-items="center"
              text "♥" width=16 color="#ff6b5a"
              text `Health ${hud.health}` testId="health" width=124 font-size=13 color=(hud.health < 30 ? "#ff7a59" : "#eef2e8")
              row width=100 height=7 border-radius=4 background-color="#ffffff1f"
                row width=(hud.health * 1.0) height=7 border-radius=4 background-color=(hud.health < 30 ? "#ff4b3a" : "#d9534a")
            row gap=8 align-items="center"
              text "◒" width=16 color="#e8b04a"
              text `Hunger ${hud.hunger}` testId="hunger" width=124 font-size=13 color=(hud.hunger < 25 ? "#ff7a59" : "#eef2e8")
              row width=100 height=7 border-radius=4 background-color="#ffffff1f"
                row width=(hud.hunger * 1.0) height=7 border-radius=4 background-color=(hud.hunger < 25 ? "#ff7a2b" : "#c9963a")
            row gap=8 align-items="center"
              text "✦" width=16 color=(hud.flashlight ? "#fff3b0" : "#6f7a70")
              text `Flashlight ${hud.flashlight ? "on" : "off"} · ${hud.battery}%` testId="battery" width=124 font-size=13
              row width=100 height=7 border-radius=4 background-color="#ffffff1f"
                row width=(hud.battery * 1.0) height=7 border-radius=4 background-color=(hud.flashlight ? "#f4e27a" : "#8c8a64")
            text `Carrying ${hud.logs} logs · ${hud.scrap} scrap · ${hud.food} food` testId="pack" font-size=12 color="#c9d1c3"
            text `Children ${hud.rescued} of ${hud.children} rescued` testId="children" font-size=12 color="#9fc3ff"
          column position="absolute" right=16 bottom=16 gap=4 padding=14 border-radius=14 background-color=(hud.deer == "Chase" ? "#3a0d0ad9" : "#0a0e0cd9") border-width=1 border-color=(hud.deer == "Chase" ? "#c0392b" : "#3a4a3f") align-items="flex-end"
            text `Deer: ${hud.deer}` testId="deer" font-weight=700 color=(hud.deer == "Chase" ? "#ff7a59" : hud.deer == "Hidden" ? "#7d877a" : "#e8c48a")
            text `${hud.chasing} hunting you` testId="chasing" font-size=12 color="#a7b0a3"
            text `${hud.trees} trees · ${hud.wolves} wolves` testId="census" font-size=12 color="#7d877a"
          when hud.prompt != ""
            text hud.prompt testId="prompt" position="absolute" left="42%" bottom=110 padding-top=10 padding-bottom=10 padding-left=18 padding-right=18 border-radius=20 background-color="#0a0e0ce6" border-width=1 border-color="#e8ad61" color="#f6d9a8" font-weight=600
          when hud.dead
            column testId="dead" position="absolute" inset=0 align-items="center" justify-content="center" gap=16 background-color="#000000b3"
              text "The forest took you" font-size=36 font-weight=800
              text `You survived ${hud.survived} nights` testId="final"
              button press=restart autofocus aria-label="Try again" testId="again" padding=16 border-radius=12 background-color="#e8ad61"
                text "Try again" color="#070b0a"
      else
        column width="100%" height="100%" box-sizing="border-box" padding=24 align-items="center" justify-content="center" gap=20
          text "99 Nights in the Forest" font-size=44 font-weight=800
          column width="100%" max-width=420 align-items="center" gap=6
            text "WASD moves · E chops, picks up, feeds the fire" width="100%" text-align="center"
            text "F flashlight · Q eats" width="100%" text-align="center"
            text "Keep the fire lit. The Deer hunts outside its light." width="100%" text-align="center" color="#a7b0a3"
          row gap=8 align-items="center"
            text "Trees" width=64
            button press=size(1000) aria-pressed=(trees == 1000) testId="trees-1k" padding=10 border-radius=10 background-color=(trees == 1000 ? "#e8ad61" : "#2d3a33")
              text "1k"
            button press=size(2000) aria-pressed=(trees == 2000) testId="trees-2k" padding=10 border-radius=10 background-color=(trees == 2000 ? "#e8ad61" : "#2d3a33")
              text "2k"
            button press=size(5000) aria-pressed=(trees == 5000) testId="trees-5k" padding=10 border-radius=10 background-color=(trees == 5000 ? "#e8ad61" : "#2d3a33")
              text "5k"
            button press=size(20000) aria-pressed=(trees == 20000) testId="trees-20k" padding=10 border-radius=10 background-color=(trees == 20000 ? "#e8ad61" : "#2d3a33")
              text "20k"
            button press=size(100000) aria-pressed=(trees == 100000) testId="trees-100k" padding=10 border-radius=10 background-color=(trees == 100000 ? "#e8ad61" : "#2d3a33")
              text "100k"
            button press=size(250000) aria-pressed=(trees == 250000) testId="trees-250k" padding=10 border-radius=10 background-color=(trees == 250000 ? "#e8ad61" : "#2d3a33")
              text "250k"
          row gap=8 align-items="center"
            text "Wolves" width=64
            button press=pack(8) aria-pressed=(wolves == 8) testId="wolves-8" padding=10 border-radius=10 background-color=(wolves == 8 ? "#e8ad61" : "#2d3a33")
              text "8"
            button press=pack(64) aria-pressed=(wolves == 64) testId="wolves-64" padding=10 border-radius=10 background-color=(wolves == 64 ? "#e8ad61" : "#2d3a33")
              text "64"
            button press=pack(512) aria-pressed=(wolves == 512) testId="wolves-512" padding=10 border-radius=10 background-color=(wolves == 512 ? "#e8ad61" : "#2d3a33")
              text "512"
            button press=pack(4096) aria-pressed=(wolves == 4096) testId="wolves-4096" padding=10 border-radius=10 background-color=(wolves == 4096 ? "#e8ad61" : "#2d3a33")
              text "4096"
          row gap=8 align-items="center"
            text "Torches" width=64
            button press=light(0) aria-pressed=(torches == 0) testId="torches-0" padding=10 border-radius=10 background-color=(torches == 0 ? "#e8ad61" : "#2d3a33")
              text "0"
            button press=light(16) aria-pressed=(torches == 16) testId="torches-16" padding=10 border-radius=10 background-color=(torches == 16 ? "#e8ad61" : "#2d3a33")
              text "16"
            button press=light(64) aria-pressed=(torches == 64) testId="torches-64" padding=10 border-radius=10 background-color=(torches == 64 ? "#e8ad61" : "#2d3a33")
              text "64"
            button press=light(256) aria-pressed=(torches == 256) testId="torches-256" padding=10 border-radius=10 background-color=(torches == 256 ? "#e8ad61" : "#2d3a33")
              text "256"
          row gap=8
            button press=toggleLite aria-pressed=lite testId="lite" padding=10 border-radius=10 background-color=(lite ? "#e8ad61" : "#2d3a33")
              text (lite ? "Grid collision" : "Rapier collision")
            button press=togglePrimitives aria-pressed=primitives testId="primitives" padding=10 border-radius=10 background-color=(primitives ? "#e8ad61" : "#2d3a33")
              text (primitives ? "Primitive trees" : "Generated pines")
          text `${trees} trees · ${wolves} wolves · ${lite ? "grid" : "Rapier"} collision · ${primitives ? "primitive" : "generated"} trees · ${torches} torches` testId="choice" color="#a7b0a3"
          button press=play autofocus aria-label="Play" testId="play" padding=16 border-radius=12 background-color="#e8ad61"
            text "Play" font-size=20 color="#070b0a"
