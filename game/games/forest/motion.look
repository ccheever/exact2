// The art pass's motion (`art="pass"`), declared: drawn-only rows rebuilt from
// the simulation at each shown tick, never saved or hashed. `logic/src/look.rs`
// is the same in Rust, kept as the reference this is compared with.
//
// - walk cycles: survivors' and creatures' limbs swing about their pivots as
//   fast as their owners go, and survivors turn to face it;
// - crowns between the camera and the player fade (dithered) instead of popping,
//   and so does undergrowth the player walks through;
// - carried supplies ride strapped on the survivor's backpack;
// - the flashlight's beam shows only while it is on.

// Crowns within this distance of the player may fade in front of them.
const REACH = 30
// A crown fading between the camera and the player keeps this much coverage.
const FADED = 0.3

let player = named("player")
guard some(player)
let you = player.Player
let at = player.Transform.position
let t = seconds()

// How fast an owner goes now (m/s), its full stride speed and its cadence
// (rad/s). Cadence is constant within a gait, so a limb's phase never jumps
// while its owner speeds up or slows down; only its swing grows and shrinks.
fn stride(speed: number, full: number, cadence: number) = {speed: speed, full: full, cadence: cadence}
fn following(owner: entity) =
  let d = length(xz(at - owner.Transform.position))
  owner.Child.fate is Following && d > 2 ? min(d - 2, 6.5) * 1.2 : 0
fn deer(v: number) = stride(v, 5, TAU * max(v, 3) / 2.6)
fn wolf(v: number) = stride(v, 4, TAU * v / 1.3)
fn gait(owner: entity) = match owner {
  case player => stride(you.dead ? 0 : length(xz(you.velocity)), 6, TAU * 3.75)
  case Child => stride(following(owner), 6, TAU * 3.5)
  case Deer d => deer(match d.mind { case Stalk => 3, case Chase => 6.6, case Flee => 7.5, case _ => 0 })
  case Wolf w => wolf(match w.mode { case Wander => 1.6, case Chase => 5.4, case Flee => 6 })
  case _ => stride(0, 1, 0)
}

// The way a survivor faces: the player where they walk, a following child
// toward the player, a rescued one toward the fire, a lost one away from camp.
fn facing(owner: entity) = match owner {
  case player => you.facing
  case Child c => match c.fate {
    case Following => at - owner.Transform.position
    case Rescued => -owner.Transform.position
    case _ => owner.Transform.position
  }
  case _ => owner.Transform.position
}

each e, part in Part
  if part.swing == 0
    let f = facing(part.owner)
    if !(f.x * f.x + f.z * f.z < 0.000001)
      Offset(e, rotation=yaw(atan2(f.x, f.z)))
  else
    let g = gait(part.owner)
    let pace = min(g.speed / g.full, 1)
    Offset(e, rotation=pitch(part.swing * pace * sin(t * g.cadence + part.phase)))

// Carried supplies are simulated stacked on the player's back; drawn, they ride
// strapped across the survivor's backpack, one above another, turning with it.
let turn = yaw(atan2(you.facing.x, you.facing.z))
for k, e in you.pack
  if has(e, Transform) && has(e, Item)
    let local = e.Transform
    // Logs stand along Y: lay them across the pack.
    let lie = e.Item.kind is Log ? roll(FRAC_PI_2) : identity()
    let slot = vec(0, -0.9, 0) + turn * vec(0, 1.5 + k * 0.3, -0.3)
    let back = inverse(local.rotation)
    Offset(e, position=back * (slot - local.position), rotation=back * turn * lie)

// Supplies on the ground near the player lie at varied angles.
each e, item in Item
  if !item.carried && has(e, Transform)
    let pose = e.Transform.position
    let to = pose - at
    if !(to.x * to.x + to.z * to.z > 1600)
      // A log lies along X (Y turned down Z): its local X is the world's up.
      let spin = sin(pose.x * 1.7 + pose.z) * 3
      Offset(e, rotation=item.kind is Log ? pitch(spin) : yaw(spin))

// Crowns between the camera and the player fade.
fn hides(eye: vec3, at: vec3, base: vec3, scale: number) =
  let seg = xz(at) - xz(eye)
  let len = dot(seg, seg)
  let f = dot(xz(base) - xz(eye), seg) / len
  let off = length(xz(base) - (xz(eye) + seg * f))
  let sight = eye.y + (at.y + 0.6 - eye.y) * f
  len >= 0.0001 && f >= 0 && f < 1 && off < 2.6 * scale && sight < base.y + 8.5 * scale

let camera = world_position(named("camera"))
let grove = Grove
if some(camera) && some(grove)
  let span = ceil(REACH / CELL)
  let n = grove.side
  let ci = floor((at.x + grove.half) / CELL)
  let cj = floor((at.z + grove.half) / CELL)
  if ci >= 0 && cj >= 0 && ci < n && cj < n
    for j in range(max(cj - span, 0), min(cj + span, n - 1) + 1)
      for i in range(max(ci - span, 0), min(ci + span, n - 1) + 1)
        let c = j * n + i
        if grove.hp[c] > 0
          let base = vec(grove.x[c], height(grove.x[c], grove.z[c]), grove.z[c])
          if hides(camera, at, base, grove.scale[c])
            Opacity(grove.trunk[c], FADED)

// Undergrowth has no collision: the player walks through it, so a bush or
// fern standing on the player fades rather than hiding them.
each e in Ambient
  if has(e, Transform)
    let pose = e.Transform
    let to = pose.position - at
    let reach = 0.5 + 0.8 * pose.scale.x
    if to.x * to.x + to.z * to.z < reach * reach
      Opacity(e, FADED)

let beam = named("beam")
if some(beam)
  Opacity(beam, you.flashlight ? 1 : 0)
