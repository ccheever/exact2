// The world is a guest; its HUD is ordinary Contract children.
shape Hud
  beacons: number

component Beacons
  state playing = false
  state seed = 7
  state run = 0
  state paused = false
  state heardMessage = ""
  resource hud = hud(heardMessage) as shape Hud

  action play writes playing
    playing = true
  action restart writes run, paused, heardMessage
    run = run + 1
    paused = false
    heardMessage = ""
  action togglePause writes paused
    paused = not paused
  action heard(message: string) writes heardMessage
    heardMessage = message

  view
    main width="100%" height="100%" background-color="#202731" color="#ffffff"
      when playing
        canvas surface=world(seed, paused, run) message=heard testId="world" width="100%" height="100%" position="relative" overflow="hidden"
          text `Beacons ${hud.beacons} / 3` testId="hud-beacons" position="absolute" top=24 left=24 padding=12 border-radius=8 background-color="#202731" color="#ffffff" font-size=18 font-weight=600
          button press=togglePause testId="pause" position="absolute" top=24 right=24 padding=12 border-radius=8 background-color="#202731"
            text (paused ? "Resume" : "Pause") color="#ffffff" font-size=16 font-weight=600
          text "WASD / arrows to move · Space to jump · E near a beacon" position="absolute" bottom=24 left=24 padding=12 border-radius=8 background-color="#202731" color="#ffffff" font-size=14
          when hud.beacons == 3
            column testId="victory" position="absolute" top="35%" left="25%" width="50%" padding=24 box-sizing="border-box" align-items="center" gap=16 border-radius=16 background-color="#202731"
              text "All beacons lit" font-size=32 font-weight=600 color="#ffffff"
              button press=restart testId="play-again" padding=16 border-radius=8 background-color="#e8ad61"
                text "Play again" font-size=20 color="#202731"
      else
        column height="100%" align-items="center" justify-content="center" gap=24
          text "Beacons" font-size=48 font-weight=600 color="#ffffff"
          text "Find the three lights. Bring them home." font-size=18 color="#d3dde5"
          button press=play testId="play" padding=16 border-radius=8 background-color="#e8ad61"
            text "Play" font-size=20 font-weight=600 color="#202731"
