shape Hud
  beacons: number

component Beacons
  state playing = false
  state seed = 7
  state paused = false
  state round = 0
  resource hud = exactSurface("world") as shape Hud

  action play writes playing
    playing = true
  action togglePause writes paused
    paused = not paused
  action restart writes round, paused
    round = round + 1
    paused = false

  view
    main width="100%" height="100%" background-color="#112d33" color="#ffffff"
      when playing
        canvas surface=world(seed, paused, round) testId="world" width="100%" height="100%" position="relative" overflow="hidden"
          text `Beacons ${hud.beacons} / 3` aria-live="polite" testId="hud-beacons" position="absolute" top=24 left=24 padding=14 border-radius=8 background-color="#112d33" color="#ffffff" font-size=20 font-weight=600
          button press=togglePause testId="pause" position="absolute" top=24 right=24 padding=14 border-radius=8 background-color="#112d33"
            text (paused ? "Resume" : "Pause") color="#ffffff" font-size=18
          text "WASD / arrows · Move     Space · Jump     E · Light nearby beacon" position="absolute" bottom=24 left=24 padding=12 border-radius=8 background-color="#112d33" color="#ffffff" font-size=16
          when hud.beacons == 3
            column testId="victory" position="absolute" top="35%" left="25%" width="50%" padding=24 align-items="center" gap=20 border-radius=12 background-color="#112d33"
              text "All beacons lit" aria-live="polite" font-size=32 color="#ffffff"
              button press=restart testId="again" padding=16 border-radius=8 background-color="#f5bf68"
                text "Play again" font-size=20 color="#112d33"
      else
        column height="100%" align-items="center" justify-content="center" gap=24
          text "BEACONS" font-size=60 font-weight=600 color="#f5bf68"
          text "Find three lights. Bring the clearing to life." font-size=20 color="#ffffff"
          text "WASD or arrows to move · Space to jump · E to light" font-size=16 color="#b4d6d5"
          button press=play autofocus testId="play" padding=18 border-radius=8 background-color="#f5bf68"
            text "Play" font-size=22 font-weight=600 color="#112d33"
