shape ShopRow
  id: string
  name: string
  rarity: string
  color: string
  price: string
  stock: number
  owned: number
  affordable: bool
  held: bool
  growth: string

shape BagRow
  id: string
  label: string
  weight: string
  value: string
  mutated: bool

// The world publishes three records (status, shop, backpack); Contract sees
// their fields as one surface record.
shape Hud
  sheckles: string
  sheckles_n: number
  held: string
  prompt: string
  plot: string
  planting: string
  weather: string
  weather_left: string
  restock_in: string
  plants: number
  fruit: number
  ripe: number
  mutated: number
  size: number
  expand_cost: string
  last: string
  away: string
  garden_time: string
  clock: string
  night: bool
  events: number
  queued: number
  order: string
  order_detail: string
  order_hint: string
  order_seed: string
  order_ready: bool
  orders: number
  water: number
  water_ready: bool
  care: string
  refill: string
  refill_ready: bool
  plant_food: number
  feed_ready: bool
  feeding: string
  shop: list<ShopRow>
  bag: list<BagRow>
  bag_count: number
  bag_value: string
  bag_page: number
  bag_pages: number

shape Time
  epochAtZero: number

// Lilita One and Sniglet: Google Fonts, SIL Open Font License (fonts/LICENSE-*).
font "Lilita One" = "assets/fonts/LilitaOne-Regular.ttf"
font "Sniglet"
  400 = "assets/fonts/Sniglet-Regular.ttf"
  800 = "assets/fonts/Sniglet-ExtraBold.ttf"

// Commands (`buy carrot`, `sell all`, …) are messages to the world.
component Garden
  state playing = false
  state again = false
  state paused = false
  state panel = "shop"
  state smooth = false
  state art = "pass"
  resource hud = exactSurface("world") as shape Hud
  resource time = exactTime() as shape Time

  action play
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action show(p: string)
    panel = panel == p ? "" : p

  action run(c: string)
    postMessage(c, "world")

  action toggleSmooth
    smooth = not smooth

  action look(a: string)
    art = a

  view
    main width="100%" height="100%" background-color="#1b2a1f" color="#fdfbf3" font-family="Sniglet"
      when playing
        canvas surface=world(seed=7, paused=paused, restart=again, epoch=time.epochAtZero, smooth=smooth, art=art) testId="world" width="100%" height="100%" position="relative"
          when art == "pass"
            text "Sam's Seeds" testId="stall-sign" width=240 padding=10 border-radius=8 background-color="#f6e7b8" background-image="linear-gradient(180deg, #fff3cf 0%, #e9cf8f 100%)" color="#5d3a1a" font-size=30 font-family="Lilita One" text-align="center" border-width=3 border-color="#7a4b25"
          column testId="hud" position="absolute" top=12 left=12 right=12 gap=8
            row testId="topbar" gap=8 align-items="center" flex-wrap="wrap"
              text `${hud.sheckles}¢` testId="sheckles" aria-label=`${hud.sheckles_n} sheckles` padding-top=6 padding-bottom=6 padding-left=14 padding-right=14 border-radius=14 background-image="linear-gradient(180deg, #4d7c0f 0%, #14532d 100%)" border-width=2 border-color="#a3e635" font-family="Lilita One" font-size=26 color="#ecfccb" text-shadow="0 1px 3px #000000b3"
              row gap=12 align-items="center" padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=999 background-color="#0f172a8c" font-size=13
                text (hud.weather_left == "" ? hud.weather : `${hud.weather} · ${hud.weather_left}`) testId="weather" aria-live="polite" color=(hud.weather == "Clear" ? "#f1f5f9" : "#93c5fd") font-family="Lilita One"
                text `Restock ${hud.restock_in}` testId="restock" color="#cbd5e1"
                text `${hud.plants} plants · ${hud.ripe}/${hud.fruit} ripe · ${hud.mutated} mutated` testId="census" color="#cbd5e1"
                when hud.clock == "" or art != "pass"
                  text `Day ${hud.garden_time}` testId="garden-time" color="#cbd5e1"
                else
                  text (hud.night ? `☾ ${hud.clock}` : `☀ ${hud.clock}`) testId="garden-time" color=(hud.night ? "#c7d2fe" : "#fde68a") font-family="Lilita One"
              row flex=1 justify-content="flex-end" gap=8
                button press=show("shop") testId="shop-tab" aria-label="Seed shop" padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=12 background-color=(panel == "shop" ? "#65a30d" : "#0f172acc")
                  text "Shop" font-family="Lilita One" font-size=17
                button press=show("bag") testId="bag-tab" aria-label=`Backpack, ${hud.bag_count} fruit` padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=12 background-color=(panel == "bag" ? "#65a30d" : "#0f172acc")
                  text `Backpack ${hud.bag_count}` font-family="Lilita One" font-size=17
                button press=show("tools") testId="tools-tab" aria-label="Garden tools" padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=12 background-color=(panel == "tools" ? "#65a30d" : "#0f172acc")
                  text "Garden" font-family="Lilita One" font-size=17
                button press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") padding-top=7 padding-bottom=7 padding-left=12 padding-right=12 border-radius=12 background-color="#0f172acc"
                  text (paused ? "Resume" : "Pause") font-family="Lilita One" font-size=17
            when panel == "shop"
              column testId="shop" width=340 max-height=440 padding=10 gap=6 border-radius=12 background-color="#0f172ae6"
                row justify-content="space-between" align-items="center"
                  text "Seed shop" font-size=22 font-family="Lilita One"
                  text `Restock in ${hud.restock_in}` font-size=13 color="#cbd5e1"
                list testId="shop-list" max-height=380 overflow-x="hidden" overflow-y="scroll"
                  each s in hud.shop key=s.id
                    ShopItem(s=s, buy=run(`buy ${s.id}`), equip=run(`equip ${s.id}`))
            when panel == "bag"
              column testId="bag" width=340 max-height=440 padding=10 gap=6 border-radius=12 background-color="#0f172ae6"
                row justify-content="space-between" align-items="center"
                  text `Backpack · ${hud.bag_count}` font-size=22 font-family="Lilita One"
                  button press=run("sell all") testId="sell-all" aria-label=`Sell all for ${hud.bag_value} sheckles` padding=8 border-radius=8 background-color="#ca8a04"
                    text `Sell all ${hud.bag_value}¢` font-family="Lilita One"
                when hud.bag_count == 0
                  text "Harvest ripe fruit with E" color="#94a3b8" testId="bag-empty"
                when hud.bag_pages > 1
                  row align-items="center" justify-content="space-between" gap=8
                    button press=run("page prev") testId="bag-newer" aria-label="Newer fruit" disabled=(hud.bag_page == 1) padding=6 border-radius=6 background-color="#334155"
                      text "Newer"
                    text `Page ${hud.bag_page} of ${hud.bag_pages}` testId="bag-page" font-size=13 color="#cbd5e1"
                    button press=run("page next") testId="bag-older" aria-label="Older fruit" disabled=(hud.bag_page == hud.bag_pages) padding=6 border-radius=6 background-color="#334155"
                      text "Older"
                list virtualized=true testId="bag-list" height=340 overflow-x="hidden" estimated-item-height=44
                  each b in hud.bag key=b.id
                    BagItem(b=b, sell=run(`sell ${b.id}`), compost=run(`compost ${b.id}`), compostReady=(hud.plant_food < 3))
            when panel == "tools"
              column testId="tools" width=340 padding=12 gap=8 border-radius=12 background-color="#0f172ae6"
                text `Garden ${hud.size}×${hud.size}` font-size=22 font-family="Lilita One"
                row gap=8 flex-wrap="wrap"
                  button press=run("harvest all") testId="harvest-all" padding=10 border-radius=8 background-color="#15803d"
                    text `Harvest all ${hud.ripe}`
                  button press=run("expand") testId="expand" padding=10 border-radius=8 background-color="#1d4ed8"
                    text `Expand ${hud.expand_cost}¢`
                  button press=run("zoom") testId="zoom" padding=10 border-radius=8 background-color="#334155"
                    text "Zoom"
                  when art == "pass"
                    button press=run("closeup") testId="closeup" padding=10 border-radius=8 background-color="#334155"
                      text "Close-up"
                text "Stress" font-size=14 color="#cbd5e1" padding-top=6
                row gap=8 flex-wrap="wrap"
                  button press=run("fill 100") testId="fill-100" padding=8 border-radius=8 background-color="#334155"
                    text "+100"
                  button press=run("fill 1000") testId="fill-1000" padding=8 border-radius=8 background-color="#334155"
                    text "+1,000"
                  button press=run("fill 10000") testId="fill-10000" padding=8 border-radius=8 background-color="#334155"
                    text "+10,000"
                  button press=run("away 3600") testId="away-hour" padding=8 border-radius=8 background-color="#334155"
                    text "Away 1 h"
                  button press=toggleSmooth testId="smooth" aria-label=(smooth ? "Stepped growth" : "Smooth growth") padding=8 border-radius=8 background-color=(smooth ? "#7c3aed" : "#334155")
                    text (smooth ? "Smooth" : "Stepped")
                text `${hud.events} events run · ${hud.queued} queued` font-size=12 color="#94a3b8" testId="events"
                text "Look (keeps your garden)" font-size=14 color="#cbd5e1" padding-top=6
                row gap=8 flex-wrap="wrap"
                  button press=look("") testId="look-classic" padding=8 border-radius=8 background-color=(art == "" ? "#65a30d" : "#334155")
                    text "Classic"
                  button press=look("golden") testId="look-golden" padding=8 border-radius=8 background-color=(art == "golden" ? "#65a30d" : "#334155")
                    text "Golden hour"
                  button press=look("storybook") testId="look-storybook" padding=8 border-radius=8 background-color=(art == "storybook" ? "#65a30d" : "#334155")
                    text "Storybook"
                  button press=look("pass") testId="look-pass" padding=8 border-radius=8 background-color=(art == "pass" ? "#65a30d" : "#334155")
                    text "Art pass"
          column testId="market" position="absolute" top=72 right=12 width=280 padding=12 gap=5 border-radius=14 background-color="#14532dd9" border-width=2 border-color="#4d7c0f"
            text hud.order testId="objective" font-family="Lilita One" font-size=19 color="#d9f99d"
            text hud.order_detail testId="order-detail" font-size=12 color="#d1fae5"
            text hud.order_hint testId="order-hint" font-size=13
            when hud.order_seed != ""
              button press=run(`equip ${hud.order_seed}`) testId="equip-order" aria-label="Hold requested seed" padding=8 border-radius=8 background-color="#65a30d"
                text "Hold requested seed" font-family="Lilita One"
            when hud.orders < 5
              button press=run("deliver") testId="deliver" aria-label="Deliver market order" disabled=(not hud.order_ready) padding=8 border-radius=8 background-color=(hud.order_ready ? "#ca8a04" : "#334155")
                text (hud.order_ready ? "Deliver order" : "Harvest into your backpack") font-family="Lilita One"
          when paused
            column testId="paused" position="absolute" top=72 right=12 padding=12 gap=8 border-radius=12 background-color="#0f172ae6"
              text "Paused" font-size=24 font-family="Lilita One"
              button press=restart testId="restart" aria-label="Restart" padding=10 border-radius=8 background-color="#334155"
                text "Restart"
          column position="absolute" right=24 bottom=144 width=232 gap=5 padding=10 border-radius=14 background-color="#0f172acc"
            text `Watering can · ${hud.water}/3` testId="water-count" font-family="Lilita One" font-size=17 color="#7dd3fc"
            text hud.care testId="care" font-size=11 color="#cbd5e1"
            row gap=8
              button action="water" testId="water" aria-label="Water this plot (Q)" disabled=(not hud.water_ready) padding=8 border-radius=8 background-color=(hud.water_ready ? "#0369a1" : "#334155")
                text "Q Water"
              button action="refill" testId="refill" aria-label="Refill watering can (R)" disabled=(not hud.refill_ready) padding=8 border-radius=8 background-color=(hud.refill_ready ? "#0369a1" : "#334155")
                text "R Refill"
            text hud.refill testId="refill-hint" font-size=10 color="#94a3b8"
            row gap=8 align-items="center" padding-top=4
              text `Plant food · ${hud.plant_food}/3` testId="food-count" flex=1 font-family="Lilita One" font-size=17 color="#d8b4fe"
              button action="feed" testId="feed" aria-label="Feed this plot (F)" disabled=(not hud.feed_ready) padding=8 border-radius=8 background-color=(hud.feed_ready ? "#7e22ce" : "#334155")
                text "F Feed"
            text hud.feeding testId="feeding" font-size=10 color="#94a3b8"
          when hud.away != ""
            text hud.away testId="away" position="absolute" top=240 right=12 max-width=320 padding=10 border-radius=10 background-color="#7c2d12e6" font-size=13
          column position="absolute" left=150 right=150 bottom=24 align-items="center" gap=5 pointer-events="none"
            when hud.planting != ""
              text hud.planting testId="planting" font-size=13 font-family="Lilita One" color="#d9f99d" text-shadow="0 1px 3px #000000b3"
            when hud.prompt != ""
              text hud.prompt testId="prompt" aria-live="polite" padding-top=8 padding-bottom=8 padding-left=16 padding-right=16 border-radius=14 background-color="#0f172ae0" font-family="Lilita One" font-size=21
            row gap=6 align-items="center" justify-content="center" flex-wrap="wrap"
              text hud.plot testId="plot" padding-top=3 padding-bottom=3 padding-left=8 padding-right=8 border-radius=8 background-color="#0f172a99" font-size=12 color="#e2e8f0"
              text (hud.held == "" ? "No seeds in hand" : `Holding ${hud.held}`) testId="held" padding-top=3 padding-bottom=3 padding-left=8 padding-right=8 border-radius=8 background-color="#14532dbf" font-size=12 color="#d9f99d"
            when hud.last != ""
              text hud.last testId="last" font-size=12 color="#f1f5f9" text-shadow="0 1px 3px #000000b3"
          button action="move" role="slider" aria-label="Move" testId="move" position="absolute" left=24 bottom=24 width=96 height=96 border-radius=48 background-color="#ffffff33"
            text "Move"
          button action="act" testId="act" aria-label="Plant or harvest (E)" position="absolute" right=24 bottom=24 width=96 height=96 border-radius=48 background-color="#65a30d"
            text "E" font-family="Lilita One" font-size=34
      else
        column width="100%" height="100%" box-sizing="border-box" padding=24 align-items="center" justify-content="center" gap=20
          text "Grow a Garden" font-family="Lilita One" font-size=68 color="#bef264" text-shadow="0 4px 0 #14532d"
          column width="100%" max-width=380 align-items="center" gap=6
            text "Walk with WASD · E plants and harvests" width="100%" text-align="center"
            text "Buy seeds, sell fruit, expand the garden" width="100%" text-align="center"
            text "Fill market orders for a bonus on your harvest" width="100%" text-align="center" color="#bef264"
            text "Q waters for faster growth · R refills at the blue barrel" width="100%" text-align="center" color="#7dd3fc"
            text "Compost backpack fruit · F feeds for a larger harvest" width="100%" text-align="center" color="#d8b4fe"
            text "Rain, snow and storms mutate ripening fruit" width="100%" text-align="center" color="#cbd5e1"
            text "It keeps growing while you are away" width="100%" text-align="center" color="#cbd5e1"
          button press=play autofocus aria-label="Play" testId="play" padding=16 border-radius=12 background-color="#65a30d"
            text "Play" font-family="Lilita One" font-size=26

component ShopItem
  props
    s: ShopRow
    buy: action
    equip: action
  view
    row testId=`shop-${s.id}` align-items="center" gap=8 padding=8 border-radius=8 background-color=(s.held ? "#365314" : "#1e293b") margin-bottom=6
      column flex=1 gap=2
        text s.name font-family="Lilita One"
        text `${s.rarity} · ${s.price}¢ · stock ${s.stock}` font-size=12 color=s.color
        text s.growth font-size=11 color="#cbd5e1"
      when s.owned > 0
        button press=equip testId=`equip-${s.id}` aria-label=`Hold ${s.name}, ${s.owned} owned` padding=6 border-radius=6 background-color="#334155"
          text `×${s.owned}` font-size=13
      button press=buy testId=`buy-${s.id}` aria-label=`Buy ${s.name} for ${s.price}` disabled=(s.stock == 0 or not s.affordable) padding=8 border-radius=6 background-color=(s.stock > 0 and s.affordable ? "#65a30d" : "#475569")
        text (s.stock == 0 ? "Sold out" : "Buy") font-size=13

component BagItem
  props
    b: BagRow
    sell: action
    compost: action
    compostReady: bool
  view
    row testId=`bag-${b.id}` height=44 box-sizing="border-box" align-items="center" gap=8 padding-left=8 padding-right=8 border-bottom-width=1 border-bottom-style="solid" border-color="#334155"
      column flex=1 min-width=0
        text b.label color=(b.mutated ? "#facc15" : "#fdfbf3") white-space="nowrap" overflow="hidden" text-overflow="ellipsis"
        text b.weight font-size=11 color="#94a3b8"
      button press=sell testId=`sell-${b.id}` aria-label=`Sell ${b.label} for ${b.value}` padding=6 border-radius=6 background-color="#ca8a04"
        text `${b.value}¢` font-size=12
      button press=compost testId=`compost-${b.id}` aria-label=`Compost ${b.label} instead of ${b.value} coins for one plant food` disabled=(not compostReady) padding=6 border-radius=6 background-color=(compostReady ? "#7e22ce" : "#334155")
        text "Compost" font-size=12
