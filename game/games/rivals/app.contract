shape Feed
  id: number
  killer: string
  victim: string
  weapon: string
  head: bool
  you: bool

shape Mark
  id: number
  amount: number
  head: bool
  kill: bool

shape Contact
  id: number
  label: string
  hp: number
  x: number
  y: number
  target: bool

shape Hud
  hp: number
  weapon: string
  slot: number
  ammo: number
  mag: number
  reloading: bool
  bandage_ready: bool
  bandaging: bool
  bandage_progress: number
  bandage_label: string
  kills: number
  deaths: number
  rival_kills: number
  rival: string
  to_win: number
  round: number
  you_rounds: number
  rival_rounds: number
  alive: bool
  respawn: number
  killed_by: string
  marker: string
  hurt: bool
  heading: string
  incoming: string
  incoming_angle: number
  over: bool
  winner: string
  you_won: bool
  sliding: bool
  accuracy: number
  feed: list<Feed>
  marks: list<Mark>
  contacts: list<Contact>
  training: bool
  drill_done: bool
  drill_left: number
  drill_score: number
  drill_combo: number
  drill_target: string
  drill_cleared: number

component Rivals
  state playing = false
  state bots = 1
  state training = false
  state again = false
  state paused = false
  resource hud = exactSurface("world") as shape Hud

  action duel
    bots = 1
    training = false
    playing = true

  action brawl
    bots = 7
    training = false
    playing = true

  action mayhem
    bots = 24
    training = false
    playing = true

  action range
    bots = 3
    training = true
    playing = true

  action togglePause
    paused = not paused

  action restart
    again = not again
    paused = false

  action menu
    playing = false
    paused = false

  view
    main width="100%" height="100%" background-color="#10141b" color="#f5f7fa"
      when playing
        canvas surface=world(seed=7, bots=bots, range=training, paused=paused, restart=again) testId="world" data-pointer-lock="true" width="100%" height="100%" position="relative"
          each c in hud.contacts key=c.id
            column testId=`target-${c.id}` position="absolute" left=c.x top=c.y width=1 height=1 pointer-events="none"
              column testId=`plate-${c.id}` position="absolute" left=-64 bottom=18 width=128 height=48 box-sizing="border-box" align-items="center" justify-content="center" gap=4 padding=4 border-radius=6 background-color=(c.target ? "#14532de6" : "#10141bcc")
                text (c.target ? `TARGET · ${c.label}` : c.label) testId=`target-label-${c.id}` font-size=12 line-height="14px" font-weight=700 color=(c.target ? "#bef264" : "#ff8a8a")
                text `${c.hp} HP` testId=`target-hp-${c.id}` font-size=11 line-height="12px"
                column width=64 height=3 background-color="#334155"
                  column width=(c.hp * 0.64) height=3 background-color=(c.target ? "#bef264" : "#ff8a8a")
          when hud.hurt
            column testId="hurt" position="absolute" inset=0 pointer-events="none" border-width=10 border-color="#e5484d88"
          when hud.incoming != ""
            column testId="incoming-arrow" position="absolute" top="50%" left="50%" width=180 height=180 margin-left=-90 margin-top=-90 rotate=hud.incoming_angle pointer-events="none"
              text "▲" position="absolute" top=0 left=78 width=24 line-height=1 font-size=24 color="#ff6b6b" text-align="center"
            text hud.incoming testId="incoming-direction" position="absolute" top=140 left="50%" width=280 margin-left=-146 padding=6 border-radius=6 background-color="#10141be6" text-align="center" color="#ff8a8a" font-weight=800 pointer-events="none"
          text `Facing ${hud.heading}` testId="heading" position="absolute" top=106 left="50%" width=220 margin-left=-116 padding=6 border-radius=6 background-color="#10141be6" text-align="center" font-size=13 color="#f5f7fa" font-weight=700 pointer-events="none"
          column position="absolute" top="50%" left="50%" width=40 height=40 margin-left=-20 margin-top=-20 align-items="center" justify-content="center" pointer-events="none"
            text (hud.marker == "" ? "+" : "×") testId="crosshair" line-height=1 font-size=(hud.marker == "" ? 26 : 34) font-weight=700 color=(hud.marker == "kill" ? "#ff4d4f" : hud.marker == "head" ? "#ffd33d" : hud.marker == "body" ? "#ffffff" : "#ffffffcc")
          column testId="marks" position="absolute" top="50%" left="50%" margin-left=28 margin-top=-64 gap=2 pointer-events="none"
            each m in hud.marks key=m.id
              text (m.kill ? `${m.amount} ✚` : `${m.amount}`) font-size=(m.head ? 22 : 17) font-weight=800 color=(m.kill ? "#ff4d4f" : m.head ? "#ffd33d" : "#ffffff")
          when hud.training
            column position="absolute" top=16 left="50%" width=440 margin-left=-220 align-items="center" gap=4 padding=10 border-radius=12 background-color="#10141be6" pointer-events="none"
              text `Target drill · ${hud.drill_left}s` testId="drill-clock" font-size=20 font-weight=800
              text `${hud.drill_score} points · ×${hud.drill_combo} combo · ${hud.drill_cleared} targets` testId="drill-score" color="#bef264"
              text `Next: ${hud.drill_target} · hit another target and lose the combo` testId="drill-target" font-size=12 color="#c9d1d9"
          else
            row testId="score" position="absolute" top=16 left="50%" width=360 margin-left=-180 justify-content="center" align-items="center" gap=14 padding=10 border-radius=12 background-color="#10141bcc" pointer-events="none"
              text "You" font-weight=700 color="#6cb6ff"
              text `${hud.kills}` testId="you-kills" font-size=28 font-weight=800
              column align-items="center" gap=2
                text `First to ${hud.to_win}` testId="score-target" font-size=12 color="#9aa4b2"
                text `Round ${hud.round} · ${hud.you_rounds}–${hud.rival_rounds}` testId="rounds" font-size=12 color="#9aa4b2"
              text `${hud.rival_kills}` testId="rival-kills" font-size=28 font-weight=800
              text hud.rival font-weight=700 color="#ff8a8a"
          column testId="feed" position="absolute" top=16 right=16 gap=6 align-items="flex-end" pointer-events="none"
            each f in hud.feed key=f.id
              row gap=8 padding-top=4 padding-bottom=4 padding-left=10 padding-right=10 border-radius=8 background-color=(f.you ? "#2b3a55e6" : "#10141bcc")
                when f.killer != ""
                  text f.killer font-weight=700 color=(f.killer == "player" ? "#6cb6ff" : "#ff8a8a")
                text (f.head ? `[${f.weapon} ◎]` : `[${f.weapon}]`) color="#c9d1d9"
                text f.victim font-weight=700 color=(f.victim == "player" ? "#6cb6ff" : "#ff8a8a")
          column testId="health" position="absolute" left=16 bottom=16 gap=6 padding=12 border-radius=12 background-color="#10141bcc"
            text `${hud.hp}` testId="hp" font-size=30 font-weight=800 color=(hud.hp > 40 ? "#f5f7fa" : "#ff6b6b")
            column width=200 height=8 border-radius=4 background-color="#2d333b"
              column width=(hud.hp * 2) height=8 border-radius=4 background-color=(hud.hp > 40 ? "#3fb950" : "#ff6b6b")
            text "Bandage · +40 HP · one per life" testId="bandage-hint" font-size=12 color="#a7d8c0"
            button action="bandage" disabled=(not hud.bandage_ready) testId="bandage" aria-label="Hold to bandage" width=200 height=34 box-sizing="border-box" padding=6 border-radius=6 background-color=(hud.bandage_ready ? "#246647" : "#2d333b")
              text hud.bandage_label testId="bandage-status" font-size=14 font-weight=700
            when hud.bandaging
              column width=200 height=4 border-radius=2 background-color="#2d333b" pointer-events="none"
                column width=(hud.bandage_progress * 200) height=4 border-radius=2 background-color="#67e8a5"
          column testId="weapon" position="absolute" right=16 bottom=16 gap=6 align-items="flex-end" padding=12 border-radius=12 background-color="#10141bcc" pointer-events="none"
            text (hud.reloading ? "Reloading…" : hud.slot == 3 ? "—" : `${hud.ammo} / ${hud.mag}`) testId="ammo" font-size=28 font-weight=800
            text hud.weapon testId="weapon-name" color="#c9d1d9"
            row gap=6
              text "1 Rifle" padding=4 border-radius=6 font-size=12 background-color=(hud.slot == 1 ? "#e8ad61" : "#2d333b") color=(hud.slot == 1 ? "#10141b" : "#c9d1d9")
              text "2 Rockets" padding=4 border-radius=6 font-size=12 background-color=(hud.slot == 2 ? "#e8ad61" : "#2d333b") color=(hud.slot == 2 ? "#10141b" : "#c9d1d9")
              text "3 Knife" padding=4 border-radius=6 font-size=12 background-color=(hud.slot == 3 ? "#e8ad61" : "#2d333b") color=(hud.slot == 3 ? "#10141b" : "#c9d1d9")
          when not hud.alive and not hud.over
            column testId="dead" position="absolute" top="34%" left=0 right=0 align-items="center" gap=6 pointer-events="none"
              text `Eliminated by ${hud.killed_by}` font-size=26 font-weight=800 color="#ff8a8a"
              text `Respawning in ${hud.respawn}` color="#c9d1d9"
          when hud.over
            column testId="round-over" position="absolute" inset=0 align-items="center" justify-content="center" gap=10 background-color="#10141baa" pointer-events="none"
              text (hud.you_won ? "You win the round" : `${hud.winner} wins the round`) testId="winner" font-size=40 font-weight=800 color=(hud.you_won ? "#6cb6ff" : "#ff8a8a")
              text `Rounds ${hud.you_rounds}–${hud.rival_rounds} · accuracy ${hud.accuracy}%` color="#c9d1d9"
          when paused
            column testId="paused" position="absolute" inset=0 align-items="center" justify-content="center" gap=14 background-color="#10141bcc"
              text "Paused" font-size=40 font-weight=800
              button press=restart testId="restart" aria-label="Restart" padding=12 border-radius=10 background-color="#354751"
                text "Restart"
              button press=menu testId="menu" aria-label="Menu" padding=12 border-radius=10 background-color="#354751"
                text "Menu"
          when hud.drill_done and not paused
            column testId="drill-done" position="absolute" inset=0 align-items="center" justify-content="center" gap=12 background-color="#10141bcc"
              text "Drill complete" font-size=40 font-weight=800 color="#bef264"
              text `${hud.drill_score} points · ${hud.drill_cleared} targets · accuracy ${hud.accuracy}%` font-size=20
              button press=restart testId="range-retry" aria-label="Try the drill again" padding=12 border-radius=10 background-color="#65a30d"
                text "Try again" font-size=18 font-weight=700
          button press=togglePause testId="pause" aria-label=(paused ? "Resume" : "Pause") position="absolute" top=16 left=16 padding=10 border-radius=10 background-color="#10141bcc"
            text (paused ? "Resume" : "Pause")
          button action="move" role="slider" aria-label="Move" testId="move" position="absolute" left=24 bottom=180 width=96 height=96 border-radius=48 background-color="#35475188"
            text "Move" color="#ffffff"
          row position="absolute" right=24 bottom=120 gap=12
            button action="jump" testId="jump" aria-label="Jump" padding=16 border-radius=12 background-color="#35475188"
              text "Jump"
            button action="fire" testId="fire" aria-label="Fire" padding=16 border-radius=12 background-color="#e8ad61"
              text "Fire" color="#10141b"
      else
        column width="100%" height="100%" box-sizing="border-box" padding=24 align-items="center" justify-content="center" gap=22
          text "RIVALS" font-size=56 font-weight=900 letter-spacing=4
          text "First to 5 kills · Mayhem first to 25" color="#9aa4b2"
          column width="100%" max-width=360 align-items="center" gap=6
            text "Mouse or arrow keys look · WASD move" width="100%" text-align="center"
            text "Shift sprint · Space jump · C slide" width="100%" text-align="center"
            text "Click or F fire · R reload · 1 2 3 weapons" width="100%" text-align="center"
            text "Hold Q: bandage +40 HP · damage or combat interrupts" width="100%" text-align="center" color="#a7d8c0"
            text "Range: 30 seconds · follow the green target · build a combo" width="100%" text-align="center" color="#bef264"
          row gap=12
            button press=duel autofocus aria-label="Play" testId="play" padding=16 border-radius=12 background-color="#e8ad61"
              text "Duel" font-size=20 color="#10141b"
            button press=brawl aria-label="Free for all" testId="ffa" padding=16 border-radius=12 background-color="#354751"
              text "Free for all" font-size=20
            button press=mayhem aria-label="Mayhem: 24 bots" testId="mayhem" padding=16 border-radius=12 background-color="#633847"
              text "Mayhem · 24 bots" font-size=20
            button press=range aria-label="Training range" testId="range" padding=16 border-radius=12 background-color="#354751"
              text "Range" font-size=20
