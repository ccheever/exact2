diff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs
index 733ba97..b4aac2c 100644
--- a/game/games/lanterns/logic/tests/capture.rs
+++ b/game/games/lanterns/logic/tests/capture.rs
@@ -42,6 +42,43 @@ fn land(sim: &mut Sim<Lanterns>, floor: f32) {
     }
     panic!("landing failed at {:?}", sim.position("player"));
 }
+
+fn jump_to_thirteenth(sim: &mut Sim<Lanterns>) {
+    steer(sim, -8.0, 9.0, 0.12);
+    press(sim, "light_press");
+    ticks(sim, 2);
+    assert!(
+        !sim.world().get::<Lantern>("lantern-13").unwrap().lit,
+        "the raised lantern must not be lightable from the ground"
+    );
+
+    press(sim, "jump_press");
+    hold(sim, "KeyW", 20);
+    land(sim, 1.0);
+    let feet = sim.position("player").unwrap() - exact_game::Vec3::Y * 0.65;
+    assert!(
+        (feet.y - 1.2).abs() < 0.12
+            && (-9.5..=-6.5).contains(&feet.x)
+            && (5.5..=8.5).contains(&feet.z),
+        "ordinary movement and jump must land on the new platform: {feet:?}"
+    );
+    press(sim, "light_press");
+    ticks(sim, 2);
+    assert!(sim.world().get::<Lantern>("lantern-13").unwrap().lit);
+}
+
+#[test]
+fn thirteenth_requires_proximity_is_jump_reachable_and_survives_save() {
+    let mut sim = game();
+    ticks(&mut sim, 2);
+    jump_to_thirteenth(&mut sim);
+    assert_eq!(sim.world().resource::<Session>().phase, 1);
+    let saved = sim.save().unwrap();
+    let restored = Sim::<Lanterns>::from_save(&saved).unwrap();
+    assert!(restored.world().get::<Lantern>("lantern-13").unwrap().lit);
+    assert_eq!(restored.world().resource::<Session>().phase, 1);
+}
