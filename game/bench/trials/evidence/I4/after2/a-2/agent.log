      1.16,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Sphere\": {\n            \"radius\": 0.19\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.18,\n            0.16,\n            0.14,\n            1\n          ]\n        },\n        \"PointLight\": {\n          \"color\": [\n            1,\n            0.42,\n            0.08\n          ],\n          \"intensity\": 0,\n          \"range\": 7\n        }\n      }\n    }\n  ]\n}\ngame/games/lanterns/app.contract:5:  total: number\ngame/games/lanterns/app.contract:57:            text `LANTERNS ${hud.count} / ${hud.total}` aria-live=\"polite\" testId=\"hud-lanterns\" padding=13 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=20 font-weight=700\ngame/games/lanterns/app.contract:86:              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\ngame/games/lanterns/app.contract:92:              text `You lit ${hud.count} of 12 lanterns.` font-size=18 color=\"#fff4d6\"\ngame/games/lanterns/app.contract:98:            text \"Light twelve lanterns before the last three minutes of dusk run out.\" font-size=20 color=\"#fff4d6\"\ngame/games/lanterns/scene.json:320:      \"id\": \"lantern-12\",\ngame/games/lanterns/assets/lanterns-adapter.mjs:135:      total: lanterns.length,\ngame/games/lanterns/README.md:28:Initial terrain and the twelve-lantern roster live in `scene.json`; repeated lantern\ngame/games/lanterns/logic/src/kind_tests.rs:55:    assert_eq!(w.rows::<Lamp>().count(), 12);\ngame/games/lanterns/logic/src/lib.rs:533:    world.publish(\"total\", world.rows::<Lamp>().count() as u32);\ngame/games/lanterns/logic/src/lib.rs:556:    fn level_has_matching_player_crate_obstacles_and_twelve_targets() {\ngame/games/lanterns/logic/src/lib.rs:559:        assert_eq!(world.rows::<Lamp>().count(), 12);\ngame/games/lanterns/logic/src/lib.rs:565:            world.get::<Transform>(\"lantern-12\").unwrap().position,\ngame/games/lanterns/logic/tests/difficult_moment.rs:61:        \"lantern-12\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:62:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:131:        rows.iter_mut().find(|r| r[\"id\"] == \"lantern-12\").unwrap()[\"overrides\"] = json!({\"bulb\":{\"Material\":{\"color\":[0.1,0.35,0.8,1]},\"PointLight\":{\"color\":[1,0.42,0.08],\"intensity\":2,\"range\":7}}});\ngame/games/lanterns/logic/tests/difficult_moment.rs:248:    let lamp = a.world().get::<historical::Lantern>(\"lantern-12\").unwrap();\ngame/games/lanterns/logic/tests/difficult_moment.rs:295:        appearance[\"fresh\"][\"entities\"][\"lantern-12/bulb\"][\"Material\"][\"color\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:300:            state[\"entities\"][\"lantern-12/bulb\"][\"Material\"][\"color\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:354:            (\"lantern-12\", \"Lantern\"),\ngame/games/lanterns/logic/tests/difficult_moment.rs:379:                    (\"lantern-12\", \"Lantern\"),\ngame/games/lanterns/logic/tests/difficult_moment.rs:395:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:402:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:467:                \"animation\":e[\"fox\"][\"Animation\"],\"spring\":e[\"lantern-12\"][\"Lantern\"][\"glow\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:468:                \"material\":e[\"lantern-12/bulb\"][\"Material\"],\"light\":e[\"lantern-12/bulb\"][\"PointLight\"][\"intensity\"],\n","exit_code":0,"status":"completed"}}
