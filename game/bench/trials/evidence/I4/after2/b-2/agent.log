ELVE ARE LIT\" aria-live=\"polite\" font-size=24 color=\"#ffd27a\" font-weight=700\n+              text \"Return to where you began before night falls!\" font-size=17 color=\"#fff4d6\"\n           row position=\"absolute\" bottom=22 right=22 gap=14 align-items=\"flex-end\"\n             button press=light testId=\"light\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#ffb43b\" justify-content=\"center\" align-items=\"center\"\n               text \"LIGHT\" width=\"100%\" text-align=\"center\" color=\"#241531\" font-size=17 font-weight=700\n@@ -83,7 +87,7 @@ component Lanterns\n           when hud.phase == \"won\"\n             column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n               text \"The island is glowing\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n-              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\n+              text \"All twelve lanterns are lit, and the fox is home.\" font-size=18 color=\"#fff4d6\"\n               button press=restart testId=\"again\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                 text \"Play again\" font-size=19 color=\"#241531\"\n           when hud.phase == \"lost\"\n@@ -95,7 +99,7 @@ component Lanterns\n         else\n           column testId=\"title\" position=\"absolute\" top=0 left=0 width=\"100%\" height=\"100%\" align-items=\"center\" justify-content=\"center\" gap=24 background-color=\"#130f24\"\n             text \"LANTERNS\" font-size=64 font-weight=700 color=\"#ffd27a\"\n-            text \"Light twelve lanterns before the last three minutes of dusk run out.\" font-size=20 color=\"#fff4d6\"\n+            text \"Light twelve lanterns and return home before dusk runs out.\" font-size=20 color=\"#fff4d6\"\n             text \"Push the crate to reach the lantern on the stone ledge.\" font-