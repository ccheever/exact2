   world.play(\"chime\").at(entity.entity()).start();\n     }\n     if world.rows::<Lamp>().all(|row| row.lantern.lit) {\n+        world.resource_mut::<Session>().phase = 4;\n+        world.log(\"all lanterns lit; return home\");\n+    }\n+    Ok(())\n+}\n+\n+fn finish_at_home(world: &mut World, hero: Id<Hero>) -> Result<(), exact_game::KindError> {\n+    if world.resource::<Session>().phase != 4 {\n+        return Ok(());\n+    }\n+    let at = world.row(hero)?.transform.position;\n+    let dx = at.x - SPAWN.x;\n+    let dz = at.z - SPAWN.z;\n+    if dx * dx + dz * dz <= HOME_RADIUS * HOME_RADIUS {\n         world.resource_mut::<Session>().phase = 2;\n-        world.log(\"all lanterns lit\");\n+        world.log(\"fox returned home\");\n     }\n     Ok(())\n }\n@@ -527,7 +545,8 @@ fn publish(world: &mut World) {\n         0 => \"title\",\n         1 => \"playing\",\n         2 => \"won\",\n-        _ => \"lost\",\n+        3 => \"lost\",\n+        _ => \"returning\",\n     };\n     world.publish(\"count\", count);\n     world.publish(\"total\", world.rows::<Lamp>().count() as u32);\ndiff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs\nindex 733ba97..b2e3d45 100644\n--- a/game/games/lanterns/logic/tests/capture.rs\n+++ b/game/games/lanterns/logic/tests/capture.rs\n@@ -42,8 +42,16 @@ fn land(sim: &mut Sim<Lanterns>, floor: f32) {\n     }\n     panic!(\"landing failed at {:?}\", sim.position(\"player\"));\n }\n+\n+fn return_home(sim: &mut Sim<Lanterns>) {\n+    steer(sim, 10.0, 5.0, 0.18);\n+    steer(sim, 5.0, 5.0, 0.18);\n+    steer(sim, 0.0, 8.0, 0.18);\n+    steer(sim, 0.0, 12.0, 0.18);\n+}\n+\n #[test]\n-fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n+fn crate_checkpoint_returns_home_twice_and_restores_both_final_states() {\n     let mut sim = game();\n     ticks(&mut sim, 2);\n     steer(&mut sim, -8.0, 12.0, 0.18);\n@@ -90,7 +98,7 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n     steer(&mut sim, 10.0, 8.0, 0.18);\n     press(&mut sim, \"light_press\");\n     ticks(&mut sim, 2);\n-    assert_eq!(sim.world().resource::<Session>().phase, 2);\n+    assert_eq!(sim.world().resource::<Session>().phase, 4);\n     assert_eq!(\n         sim.world()\n             .query::<&Lantern>()\n@@ -99,6 +107,32 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             .count(),\n         12\n     );\n+    let return_elapsed = sim.world().resource::<Session>().elapsed;\n+    let returning = sim.save().unwrap();\n+    let mut restored_return = Sim::<Lanterns>::from_save(&returning).unwrap();\n+    assert_eq!(restored_return.world().resource::<Session>().phase, 4);\n+    assert_eq!(\n+        restored_return.world().resource::<Session>().elapsed,\n+        return_elapsed\n+    );\n+    ticks(&mut sim, 10);\n+    ticks(&mut restored_return, 10);\n+    assert_eq!(sim.world().resource::<Session>().phase, 4);\n+    assert_eq!(\n+        sim.world().resource::<Session>().elapsed,\n+        return_elapsed + 10\n+    );\n+    assert_eq!(restored_return.world().hash(), sim.world().hash());\n+\n+    let mut timed_out = Sim::<Lanterns>::from_save(&returning).unwrap();\n+    ticks(&mut timed_out, 180 * 60 - return_elapsed);\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 3);\n+\n+    return_home(&mut sim);\n+    return_home(&mut restored_return);\n+    assert_eq!(sim.world().resource::<Session>().phase, 2);\n+    assert_eq!(restored_return.world().resource::<Session>().phase, 2);\n+    assert_eq!(restored_return.world().hash(), sim.world().hash());\n     let hash = sim.world().hash();\n     let capture = Capture::from_bytes(&sim.stop_capture().unwrap().to_bytes()).unwrap();\n     for _ in 0..2 {\n M game/games/lanterns/README.md\n M game/games/lanterns/app.contract\n M game/games/lanterns/assets/lanterns-adapter.mjs\n M game/games/lanterns/logic/src/lib.rs\n M game/games/lanterns/logic/tests/capture.rs\