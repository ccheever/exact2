esses while the left thumb remains on the raw movement stick.\n #[derive(Default, exact_game::Args)]\n@@ -290,6 +291,9 @@ impl Game for Lanterns {\n             if args.sound {\n                 world.play(\"night\").start();\n             }\n+        } else if all_lanterns_lit(world) && player_is_home(world, ids.hero) {\n+            world.resource_mut::<Session>().phase = 2;\n+            world.log(\"returned home\");\n         }\n         update_sun(world, ids.sun);\n         scene::follow(world);\n@@ -489,13 +493,22 @@ fn light_nearest(world: &mut World, sound: bool) -> Result<(), exact_game::KindE\n     if sound {\n         world.play(\"chime\").at(entity.entity()).start();\n     }\n-    if world.rows::<Lamp>().all(|row| row.lantern.lit) {\n-        world.resource_mut::<Session>().phase = 2;\n+    if all_lanterns_lit(world) {\n         world.log(\"all lanterns lit\");\n     }\n     Ok(())\n }\n \n+fn all_lanterns_lit(world: &World) -> bool {\n+    let mut lamps = world.rows::<Lamp>();\n+    lamps.next().is_some() && lamps.all(|row| row.lantern.lit)\n+}\n+\n+fn player_is_home(world: &World, hero: Id<Hero>) -> bool {\n+    let position = world.row(hero).expect(\"bound player Hero\").transform.position;\n+    Vec2::new(position.x - SPAWN.x, position.z - SPAWN.z).length() <= HOME_RADIUS\n+}\n+\n fn update_lanterns(world: &mut World) {\n     let now = world.now();\n     for row in world.rows::<Lamp>() {\n@@ -520,6 +533,7 @@ fn update_sun(world: &mut World, sun: Id<Pose>) {\n \n fn publish(world: &mut World) {\n     let count = world.rows::<Lamp>().filter(|row| row.lantern.lit).count() as u32;\n+    let total = world.rows::<Lamp>().count() as u32;\n     let remaining = DURATION_TICKS\n         .saturating_sub(world.resource::<Session>().elapsed)\n         .div_ceil(60);\n@@ -530,9 +544,10 @@ fn publish(world: &mut World) {\n         _ => \"lost\",\n     };\n     world.publish(\"count\", count);\n-    world.publish(\"total\", world.rows::<Lamp>().count() as u32);\n+    world.publish(\"total\", total);\n     world.publish(\"remaining\", remaining);\n     world.publish(\"phase\", phase);\n+    world.publish(\"returnHome\", count == total && total > 0 && phase == \"playing\");\n     world.publish(\"assetReady\", true);\n }\n \ndiff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs\nindex 733ba97..aaf0950 100644\n--- a/game/games/lanterns/logic/tests/capture.rs\n+++ b/game/games/lanterns/logic/tests/capture.rs\n@@ -90,7 +90,7 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n     steer(&mut sim, 10.0, 8.0, 0.18);\n     press(&mut sim, \"light_press\");\n     ticks(&mut sim, 2);\n-    assert_eq!(sim.world().resource::<Session>().phase, 2);\n+    assert_eq!(sim.world().resource::<Session>().phase, 1);\n     assert_eq!(\n         sim.world()\n             .query::<&Lantern>()\n@@ -99,6 +99,27 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             .count(),\n         12\n     );\n+    let returning_elapsed = sim.world().resource::<Session>().elapsed;\n+    let returning = sim.save().unwrap();\n+    let mut timed_out = Sim::<Lanterns>::from_save(&returning).unwrap();\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 1);\n+    assert_eq!(timed_out.world().resource::<Session>().elapsed, returning_elapsed);\n+    assert_eq!(\n+        timed_out\n+            .world()\n+            .query::<&Lantern>()\n+            .iter()\n+            .filter(|(_, lantern)| lantern.lit)\n+            .count(),\n+        12\n+    );\n+    ticks(&mut timed_out, 180 * 60 - returning_elapsed);\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 3);\n+\n+    steer(&mut sim, 5.0, 5.0, 0.18);\n+    steer(&mut sim, 0.0, 8.0, 0.18);\n+    steer(&mut sim, SPAWN_X, SPAWN_Z, 1.95);\n+    assert_eq!(sim.world().resource::<Session>().phase, 2);\n     let hash = sim.world().hash();\n     let capture = Capture::from_bytes(&sim.stop_capture