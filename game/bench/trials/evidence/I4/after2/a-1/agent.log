,\ngame/games/lanterns/logic/tests/difficult_moment.rs:61:        \"lantern-12\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:62:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:131:        rows.iter_mut().find(|r| r[\"id\"] == \"lantern-12\").unwrap()[\"overrides\"] = json!({\"bulb\":{\"Material\":{\"color\":[0.1,0.35,0.8,1]},\"PointLight\":{\"color\":[1,0.42,0.08],\"intensity\":2,\"range\":7}}});\ngame/games/lanterns/logic/tests/difficult_moment.rs:173:    for _ in 0..120 {\ngame/games/lanterns/logic/tests/difficult_moment.rs:248:    let lamp = a.world().get::<historical::Lantern>(\"lantern-12\").unwrap();\ngame/games/lanterns/logic/tests/difficult_moment.rs:268:    for tick in 0..120 {\ngame/games/lanterns/logic/tests/difficult_moment.rs:295:        appearance[\"fresh\"][\"entities\"][\"lantern-12/bulb\"][\"Material\"][\"color\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:300:            state[\"entities\"][\"lantern-12/bulb\"][\"Material\"][\"color\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:354:            (\"lantern-12\", \"Lantern\"),\ngame/games/lanterns/logic/tests/difficult_moment.rs:362:        for i in 0..120 {\ngame/games/lanterns/logic/tests/difficult_moment.rs:379:                    (\"lantern-12\", \"Lantern\"),\ngame/games/lanterns/logic/tests/difficult_moment.rs:395:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:402:        \"lantern-12/bulb\",\ngame/games/lanterns/logic/tests/difficult_moment.rs:467:                \"animation\":e[\"fox\"][\"Animation\"],\"spring\":e[\"lantern-12\"][\"Lantern\"][\"glow\"],\ngame/games/lanterns/logic/tests/difficult_moment.rs:468:                \"material\":e[\"lantern-12/bulb\"][\"Material\"],\"light\":e[\"lantern-12/bulb\"][\"PointLight\"][\"intensity\"],\ngame/engine/src/sim/route.rs:7:    pub fn move_to(\ngame/engine/src/sim/route.rs:7:    pub fn move_to(\ngame/games/lanterns/logic/tests/capture.rs:30:    sim.