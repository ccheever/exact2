{"type":"item.completed","item":{"id":"item_3","type":"command_execution","command":"/bin/bash -lc \"find game/games/lanterns/logic -type f -maxdepth 4 -print | sort && sed -n '261,700p' game/games/lanterns/logic/src/lib.rs && sed -n '1,360p' game/games/lanterns/proof.mjs && sed -n '1,360p' game/games/lanterns/scene.json && sed -n '1,320p' game/games/lanterns/app.contract && sed -n '1,220p' game/games/lanterns/app.json\"","aggregated_output":"game/games/lanterns/logic/Cargo.toml\ngame/games/lanterns/logic/src/bin/lanterns-scene.rs\ngame/games/lanterns/logic/src/lib.rs\ngame/games/lanterns/logic/src/scene_tests.rs\ngame/games/lanterns/logic/tests/capture.rs\nfn define_sounds(world: &mut World) {\n    world\n        .resource_mut::<Sounds>()\n        .add(\n            \"footstep\",\n            Synth::noise()\n                .seconds(0.08)\n                .attack(0.002)\n                .release(0.07)\n                .lowpass_hz(720.0)\n                .gain(0.24),\n        )\n        .add(\n            \"jump\",\n            Synth::sine(280.0)\n                .seconds(0.12)\n                .attack(0.005)\n                .release(0.1)\n                .gain(0.18),\n        )\n        .add(\n            \"chime\",\n            Synth::sine(660.0)\n                .seconds(0.7)\n                .attack(0.005)\n                .release(0.6)\n                .gain(0.28)\n                .layer(Synth::sine(990.0).seconds(0.5).release(0.42).gain(0.14)),\n        )\n        .add(\n            \"night\",\n            Synth::sine(160.0)\n                .seconds(1.2)\n                .attack(0.04)\n                .release(1.0)\n                .gain(0.24),\n        )\n        .add(\n            \"wind\",\n            Synth::noise()\n                .seconds(2.0)\n                .sustain(1.0)\n                .lowpass_hz(420.0)\n                .gain(0.1)\n                .looped(),\n        );\n}\n\nfn spawn_static_box(world: &mut World, name: &str, at: Vec3, size: Vec3, material: Material) {\n    let mesh = Mesh::cuboid(size);\n    world.spawn_named(\n        name,\n        (\n            Transform::at(at.x, at.y, at.z),\n            mesh.clone(),\n            material,\n            Collider::of(&mesh),\n        ),\n    );\n}\n\nfn spawn_sign(world: &mut World) {\n    spawn_static_box(\n        world,\n        \"sign-post\",\n        Vec3::new(3.0, 0.85, 10.0),\n        Vec3::new(0.18, 1.7, 0.18),\n        Material::rgb(0.32, 0.18, 0.08),\n    );\n    spawn_static_box(\n        world,\n        \"sign-board\",\n        Vec3::new(3.0, 1.55, 10.0),\n        Vec3::new(2.5, 0.9, 0.14),\n        Material::rgb(0.36, 0.21, 0.1),\n    );\n}\n\nfn spawn_decor(world: &mut World, seed: u64) {\n    world.reseed(seed);\n    let before: Vec<_> = world.entities().collect();\n    for i in 0..18 {\n        let angle = world.rand(0.0..std::f32::consts::TAU);\n        let radius = world.rand(13.0..16.5);\n        let x = angle.cos() * radius;\n        let z = angle.sin() * radius;\n        let trunk = world.spawn_named(\n            format!(\"tree-{i}\"),\n            (\n                Transform::at(x, 1.05, z),\n                Mesh::cylinder(0.17, 2.1),\n                Material::rgb(0.19, 0.12, 0.07),\n            ),\n        );\n        world.spawn((\n            Transform::at(0.0, 2.15, 0.0).with_scale(Vec3::new(1.0, 1.6, 1.0)),\n            Parent(trunk),\n            Mesh::cylinder(1.15, 2.4),\n            Material::rgb(0.04, 0.17, 0.1).rough(0.9),\n        ));\n    }\n    for i in 0..22 {\n        let angle = world.rand(0.0..std::f32::consts::TAU);\n        let radius = world.rand(14.0..17.0);\n        world.spawn_named(\n            format!(\"rock-{i}\"),\n            (\n                Transform::at(angle.cos() * radius, 0.2, angle.sin() * radius).with_scale(\n                    Vec3::new(\n                        world.rand(0.4..1.0),\n                        world.rand(0.2..0.6),\n                        world.rand(0.4..1.0),\n                    ),\n                ),\n                Mesh::sphere(0.5),\n                Material::rgb(0.24, 0.25, 0.3).rough(0.95),\n            ),\n        );\n    }\n    let generated: Vec<_> = world.entities().filter(|e| !before.contains(e)).collect();\n    for entity in generated {\n        world.insert(\n            entity,\n            exact_game_scene::GeneratedBy {\n                generator: \"lanterns::spawn_decor\".into(),\n                parameters: [\n                    (\"seed\".into(), seed.to_string()),\n                    (\"trees\".into(), \"18\".into()),\n                    (\"rocks\".into(), \"22\".into()),\n                ]\n                .into(),\n            },\n        );\n    }\n}\n\nfn update_player(world: &mut World, direction: Vec3, sound: bool) {\n    let player = world.named(\"player\").unwrap();\n    let (grounded, velocity) = {\n        let character = world.get::<Character>(player).unwrap();\n        (character.grounded, character.velocity)\n    };\n    let speed = Vec2::new(velocity.x, velocity.z).length();\n    let clip = if !grounded || speed >= 2.8 {\n        \"Run\"\n    } else if speed > 0.08 {\n        \"Walk\"\n    } else {\n        \"Survey\"\n    };\n    let fox = world.named(\"fox\").unwrap();\n    {\n        let mut animation = world.get_mut::<Animation>(fox).unwrap();\n        animation.play(clip);\n        animation.advance(world.dt());\n    }\n    if direction.length_squared() > 0.0025 {\n        let yaw = direction.x.atan2(-direction.z);\n        world.get_mut::<Transform>(fox).unwrap().rotation = Quat::from_rotation_y(yaw);\n    }\n    if grounded && speed > 0.08 {\n        let mut footsteps = 0;\n        {\n            let mut state = world.get_mut::<Player>(player).unwrap();\n            state.stride += speed * world.dt();\n            while state.stride >= 0.7 {\n                state.stride -= 0.7;\n                footsteps += 1;\n            }\n        }\n        if sound {\n            for _ in 0..footsteps {\n                world.play(\"footstep\").at(player).start();\n            }\n        }\n    }\n    let feet = world.get::<Transform>(player).unwrap().position.y - 0.65;\n    if feet < -6.0 {\n        let mut pose = *world.get::<Transform>(player).unwrap();\n        pose.position = SPAWN + Vec3::Y * 0.65;\n        world.teleport(player, pose);\n        let mut c = world.get_mut::<Character>(player).unwrap();\n        c.velocity = Vec3::ZERO;\n        c.grounded = false;\n        world.log(\"fall reset\");\n    }\n}\n\nfn light_nearest(world: &mut World, sound: bool) {\n    let center = world.get::<Transform>(\"player\").unwrap().position - Vec3::Y * 0.65;\n    let mut nearest = None;\n    let mut distance = 1.5f32;\n    for (entity, (pose, lantern)) in world.query::<(&Transform, &Lantern)>().iter() {\n        if lantern.lit {\n            continue;\n        }\n        let d = pose.position.distance(center);\n        if d <= distance {\n            distance = d;\n            nearest = Some(entity);\n        }\n    }\n    let Some(entity) = nearest else { return };\n    {\n        let mut lantern = world.get_mut::<Lantern>(entity).unwrap();\n        lantern.lit = true;\n        lantern.glow.set_target(world.now(), 1.0);\n    }\n    let name = world.name(entity).unwrap().to_owned();\n    world.log(format_args!(\"{name} lit\"));\n    if sound {\n        world.play(\"chime\").at(entity).start();\n    }\n    let count = world\n        .query::<&Lantern>()\n        .iter()\n        .filter(|(_, l)| l.lit)\n        .count();\n    if count == world.query::<&Lantern>().iter().count() {\n        world.resource_mut::<Session>().phase = 2;\n        world.log(\"all lanterns lit\");\n    }\n}\n\nfn update_lanterns(world: &mut World) {\n    let now = world.now();\n    let rows: Vec<_> = world\n        .query::<&Lantern>()\n        .iter()\n        .map(|(e, l)| (world.name(e).unwrap().to_owned(), l.glow.value(now)))\n        .collect();\n    for (name, glow) in rows {\n        let bulb = world.named(&format!(\"{name}/bulb\")).unwrap();\n        world.get_mut::<Material>(bulb).unwrap().emissive = [glow * 4.0, glow * 1.65, glow * 0.32];\n        world.get_mut::<PointLight>(bulb).unwrap().intensity = glow * 5.0;\n    }\n}\n\nfn update_sun(world: &mut World) {\n    let progress = world.resource::<Session>().elapsed as f32 / DURATION_TICKS as f32;\n    let angle = 0.22 - progress * 0.52;\n    let position = Vec3::new(24.0 * angle.cos(), 24.0 * angle.sin() + 4.0, -18.0);\n    *world.get_mut::<Transform>(\"sun\").unwrap() =\n        Transform::at(position.x, position.y, position.z).looking_at(Vec3::ZERO, Vec3::Y);\n}\n\nfn publish(world: &mut World) {\n    let count = world\n        .query::<&Lantern>()\n        .iter()\n        .filter(|(_, l)| l.lit)\n        .count() as u32;\n    let session = world.resource::<Session>();\n    let remaining = DURATION_TICKS.saturating_sub(session.elapsed).div_ceil(60);\n    let phase = match session.phase {\n        0 => \"title\",\n        1 => \"playing\",\n        2 => \"won\",\n        _ => \"lost\",\n    };\n    drop(session);\n    world.publish(\"count\", count);\n    world.publish(\"total\", world.query::<&Lantern>().iter().count() as u32);\n    world.publish(\"remaining\", remaining);\n    world.publish(\"phase\", phase);\n    world.publish(\"assetReady\", true);\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use exact_game::Sim;\n\n    fn game() -> Sim<Lanterns> {\n        Sim::new(Options {\n            scene: bake_scene().content,\n            seed: 1_041_003,\n            started: true,\n            sound: true,\n            ..Options::default()\n        })\n        .unwrap()\n    }\n\n    #[test]\n    fn level_has_matching_player_crate_obstacles_and_twelve_targets() {\n        let sim = game();\n        let world = sim.world();\n        assert_eq!(world.query::<&Lantern>().iter().count(), 12);\n        assert_eq!(\n            world.get::<Transform>(\"crate\").unwrap().position,\n            Vec3::new(6.0, 0.6, 8.0)\n        );\n        assert_eq!(\n            world.get::<Transform>(\"lantern-12\").unwrap().position,\n            Vec3::new(10.0, 2.4, 8.0)\n        );\n        assert!(world.has::<Animation>(world.named(\"fox\").unwrap()));\n    }\n\n    #[test]\n    fn one_second_moves_at_four_point_five_and_selects_run() {\n        let mut sim = game();\n        sim.key_down(\"KeyW\");\n        sim.run(1000.0);\n        sim.key_up(\"KeyW\");\n        let pose = sim.world().get::<Transform>(\"player\").unwrap();\n        assert!(\n            (pose.position.z - 7.5).abs() < 0.08,\n            \"z={}\",\n            pose.position.z\n        );\n        assert_eq!(sim.world().get::<Animation>(\"fox\").unwrap().clip, \"Run\");\n    }\n\n    #[test]\n    fn save_restores_dynamic_body_timer_animation_and_lights() {\n        let mut sim = game();\n        sim.run(100.0);\n        let bytes = sim.save();\n        let hash = sim.world().hash();\n        let mut restored = game();\n        restored.restore(&bytes).unwrap();\n        assert_eq!(restored.world().hash(), hash);\n        assert_eq!(restored.world().resource::<Session>().elapsed, 6);\n        assert_eq!(\n            restored.world().get::<Animation>(\"fox\").unwrap().clip,\n            \"Survey\"\n        );\n    }\n\n    #[test]\n    fn no_input_loses_at_exactly_three_minutes() {\n        let mut sim = game();\n        sim.run(180_000.0);\n        assert_eq!(sim.world().resource::<Session>().phase, 3);\n        assert_eq!(sim.world().resource::<Session>().elapsed, DURATION_TICKS);\n    }\n}\n\n/// Scene type selection; every field/default/variant comes from these Rust declarations.\npub fn scene_types() -> exact_game_scene::Types {\n    let mut types = exact_game_scene::Types::standard();\n    types\n        .component::<Lantern>()\n        .component::<Collider>()\n        .component::<Body>();\n    types\n}\n\n#[cfg(test)]\nfn bake_scene() -> exact_game_scene::bake::Baked {\n    exact_game_scene::bake::compile(\n        std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../scene.json\"),\n        &scene_types(),\n        Lanterns::assets(),\n    )\n    .unwrap()\n}\n#[cfg(test)]\nmod scene_tests;\n#!/usr/bin/env bun\nimport { resolve } from 'node:path';\nimport { proof } from '../../proof.mjs';\nimport { installAdapter } from './inject-adapter.mjs';\n\nawait proof(import.meta, async ({open, check, equal, out, host}) => {\n  if (host === 'web') installAdapter(resolve(import.meta.dirname, 'dist'));\n  const node = (tree, id) => tree.nodes.find(item => item.props?.testId === id);\n  const s = await open();\n  const title = await s.tree();\n  check('accessible Play overlays a real title-paused world at tick zero',\n    node(title, 'play')?.focused === true && node(title, 'world')?.world?.tick === 0);\n  await s.tap('play');\n  const playing = await s.tree();\n  check('the world and distinct Light and Jump controls are mounted',\n    !!node(playing, 'world') && !!node(playing, 'light') && !!node(playing, 'jump'));\n  const foxMesh = await s.world('world').get('fox', 'Mesh');\n  const foxAnimation = await s.world('world').get('fox', 'Animation');\n  check('the consumer uses the real Fox asset', equal(foxMesh, {Asset:['Fox.glb']}), foxMesh);\n  check('the Fox begins in the Survey clip', foxAnimation?.clip === 'Survey', foxAnimation);\n  await s.world('world').hold('KeyW', 1000);\n  const moved = await s.world('world').position('player');\n  const run = await s.world('world').get('fox', 'Animation');\n  check('one second of W moves 4.5 metres through real physics',\n    Math.abs(moved[2] - 7.5) < 0.08, moved);\n  check('movement selects and advances Run', run?.clip === 'Run' && run.seconds > 0, run);\n  await s.screenshot(resolve(out, 'lanterns-fox.png'));\n  const logs = await s.logs();\n  check('the browser and GPU report no errors',\n    !logs.host?.some(line => /^(exception:|console\\.error:|error:)/.test(line)), logs.host);\n  await s.close();\n});\n{\n  \"units\": \"metres-y-up\",\n  \"fragments\": {\n    \"solid\": \"../shared/solid.fragment.json\",\n    \"lantern\": \"lantern.fragment.json\"\n  },\n  \"assets\": {\n    \"fox\": {\n      \"name\": \"Fox.glb\",\n      \"path\": \"assets/Fox.glb\"\n    }\n  },\n  \"entities\": [\n    {\n      \"id\": \"ground\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          -0.5,\n          0\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              36,\n              1,\n              36\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.07,\n            0.18,\n            0.11,\n            1\n          ],\n          \"roughness\": 0.92\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  18.0,\n                  0.5,\n                  18.0\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"ledge\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          10,\n          1.2,\n          8\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              4,\n              2.4,\n              4\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.28,\n            0.27,\n            0.32,\n            1\n          ],\n          \"roughness\": 0.85\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  2.0,\n                  1.2,\n                  2.0\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"wall\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          -4,\n          1,\n          5\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              1,\n              2,\n              5\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.31,\n            0.29,\n            0.34,\n            1\n          ],\n          \"roughness\": 0.88\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  0.5,\n                  1.0,\n                  2.5\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"crate\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          6,\n          0.6,\n          8\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              1.2,\n              1.2,\n              1.2\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.45,\n            0.24,\n            0.09,\n            1\n          ],\n          \"roughness\": 0.78\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  0.6,\n                  0.6,\n                  0.6\n                ]\n              }\n            }\n          },\n          \"Body\": {\n            \"kind\": {\n              \"Dynamic\": {}\n            },\n            \"mass\": 3,\n            \"damping\": 0.45,\n            \"spin_damping\": 8\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"lantern-1\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -12,\n          0,\n          10\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-2\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -10,\n          0,\n          2\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-3\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -12,\n          0,\n          -8\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-4\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -6,\n          0,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-5\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          -10\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-6\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          6,\n          0,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-7\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          12,\n          0,\n          -8\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-8\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          12,\n          0,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-9\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          5,\n          0,\n          2\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-10\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-11\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          7\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-12\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          10,\n          2.4,\n          8\n        ]\n      }\n    }\n  ]\n}\nuse sceneContent from \"./.scene/scene.contract\"\n\nshape Hud\n  count: number\n  total: number\n  remaining: number\n  phase: string\n\ncomponent Lanterns\n  state started = false\n  state seed = 1041003\n  state paused = false\n  state round = 0\n  state jumpPress = 0\n  state lightPress = 0\n  state sound = true\n  state saveRequest = 0\n  state loadRequest = 0\n  state checkpointStatus = \"\"\n  resource hud = exactSurface(\"world\") as shape Hud\n\n  action play writes started\n    started = true\n  action togglePause writes paused\n    paused = not paused\n  action toggleSound writes sound\n    sound = not sound\n  action jump writes jumpPress\n    jumpPress = jumpPress + 1\n  action light writes lightPress\n    lightPress = lightPress + 1\n  action restart writes round, paused\n    round = round + 1\n    paused = false\n  action saveGame writes saveRequest, checkpointStatus\n    saveRequest = saveRequest + 1\n    checkpointStatus = \"Saving…\"\n  action loadGame writes loadRequest, checkpointStatus\n    loadRequest = loadRequest + 1\n    checkpointStatus = \"Loading…\"\n  action checkpoint(value: string) writes checkpointStatus, started\n    if value == \"surface-save:saved\"\n      checkpointStatus = \"Saved\"\n    if value == \"surface-load:loaded\"\n      checkpointStatus = \"Loaded\"\n      started = true\n    if value == \"surface-save:error\"\n      checkpointStatus = \"Save failed\"\n    if value == \"surface-load:error\"\n      checkpointStatus = \"No compatible save\"\n\n  view\n    main width=\"100%\" height=\"100%\" background-color=\"#130f24\" color=\"#fff4d6\"\n      canvas surface=world(seed, started, paused, round, jumpPress, lightPress, sound, sceneContent()) surface-save=saveRequest surface-load=loadRequest message=checkpoint testId=\"world\" width=\"100%\" height=\"100%\" position=\"relative\" overflow=\"hidden\"\n        when started\n          row position=\"absolute\" top=18 left=18 right=18 justify-content=\"space-between\" align-items=\"center\" flex-wrap=\"wrap\" gap=8\n            text `LANTERNS ${hud.count} / ${hud.total}` aria-live=\"polite\" testId=\"hud-lanterns\" padding=13 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=20 font-weight=700\n            text `TIME ${hud.remaining}` aria-live=\"polite\" testId=\"hud-time\" padding=13 border-radius=10 background-color=\"#1b1730\" color=\"#fff4d6\" font-size=20 font-weight=600\n            row gap=8\n              button press=toggleSound testId=\"sound\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text (sound ? \"Sound on\" : \"Sound off\") color=\"#fff4d6\" font-size=16\n              button press=saveGame testId=\"save\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text \"Save\" color=\"#fff4d6\" font-size=16\n              button press=loadGame testId=\"load-save\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text \"Load\" color=\"#fff4d6\" font-size=16\n              button press=togglePause testId=\"pause\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text (paused ? \"Resume\" : \"Pause\") color=\"#fff4d6\" font-size=16\n            when checkpointStatus != \"\"\n              text checkpointStatus aria-live=\"polite\" testId=\"save-status\" padding=10 border-radius=9 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          text \"Move: WASD / arrows / left thumb\" position=\"absolute\" bottom=22 left=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#d6cdec\" font-size=15\n          text \"Push the crate beside the high ledge. Jump onto it, then jump again.\" testId=\"sign-instruction\" position=\"absolute\" bottom=76 left=22 right=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          row position=\"absolute\" bottom=22 right=22 gap=14 align-items=\"flex-end\"\n            button press=light testId=\"light\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#ffb43b\" justify-content=\"center\" align-items=\"center\"\n              text \"LIGHT\" width=\"100%\" text-align=\"center\" color=\"#241531\" font-size=17 font-weight=700\n            button press=jump testId=\"jump\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#a78cff\" justify-content=\"center\" align-items=\"center\"\n              text \"JUMP\" width=\"100%\" text-align=\"center\" color=\"#171126\" font-size=17 font-weight=700\n          when paused\n            column testId=\"paused\" position=\"absolute\" top=\"34%\" left=\"30%\" width=\"40%\" padding=26 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Paused\" font-size=34 font-weight=700 color=\"#ffd27a\"\n              text \"Your 180 seconds are frozen.\" font-size=17 color=\"#d6cdec\"\n              button press=togglePause testId=\"resume\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Resume\" font-size=19 color=\"#241531\"\n          when hud.phase == \"won\"\n            column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"The island is glowing\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"again\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Play again\" font-size=19 color=\"#241531\"\n          when hud.phase == \"lost\"\n            column testId=\"lost\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Night fell\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text `You lit ${hud.count} of 12 lanterns.` font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"retry\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Try again\" font-size=19 color=\"#241531\"\n        else\n          column testId=\"title\" position=\"absolute\" top=0 left=0 width=\"100%\" height=\"100%\" align-items=\"center\" justify-content=\"center\" gap=24 background-color=\"#130f24\"\n            text \"LANTERNS\" font-size=64 font-weight=700 color=\"#ffd27a\"\n            text \"Light twelve lanterns before the last three minutes of dusk run out.\" font-size=20 color=\"#fff4d6\"\n            text \"Push the crate to reach the lantern on the stone ledge.\" font-size=17 color=\"#d6cdec\"\n            text \"WASD or arrows · Space to jump · E to light\" font-size=15 color=\"#a99fc1\"\n            row gap=12\n              button press=play autofocus testId=\"play\" padding=18 border-radius=10 background-color=\"#ffd27a\"\n                text \"Play\" font-size=22 font-weight=700 color=\"#241531\"\n              button press=loadGame testId=\"title-load\" padding=18 border-radius=10 background-color=\"#1b1730\"\n                text \"Load save\" font-size=22 font-weight=700 color=\"#ffd27a\"\n            when checkpointStatus != \"\"\n              text checkpointStatus aria-live=\"polite\" testId=\"title-save-status\" color=\"#ffd27a\" font-size=15\n{\n  \"$schema\": \"../../../scripts/app.schema.json\",\n  \"name\": \"Lanterns Exact\",\n  \"short_name\": \"Lanterns\",\n  \"id\": \"com.exact.lanterns.exact\",\n  \"start_url\": \"/\",\n  \"display\": \"standalone\",\n  \"theme_color\": \"#130f24\",\n  \"background_color\": \"#130f24\",\n  \"app\": { \"id\": \"com.exact.lanterns.exact\", \"name\": \"Lanterns Exact\" },\n  \"host\": {\n    \"macos\": { \"minimumOS\": \"14.0\", \"window\": { \"width\": 1280, \"height\": 720 } },\n    \"ios\": { \"minimumOS\": \"17.0\", \"deviceFamily\": [\"iphone\", \"ipad\"] },\n    \"web\": {}\n  },\n  \"game\": { \"crate\": \"lanterns-logic\", \"type\": \"Lanterns\" },\n  \"rust\": false,\n  \"deploy\": { \"store\": { \"web\": \"0\", \"macos\": \"0\", \"ios\": \"0\", \"linux\": \"0\" } }\n}\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_4","type":"agent_message","text":"The roster and victory logic are data-driven, so the core change is adding one static collider and one fragment-backed lantern to `scene.json`; the HUD total and serialized lantern state should then follow automatically. I’m now checking the existing scene/capture tests and generated-scene workflow so the proof exercises ordinary input rather than mutating state."}}
{"type":"item.started","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' game/games/lanterns/logic/src/scene_tests.rs && sed -n '1,360p' game/games/lanterns/logic/tests/capture.rs && sed -n '1,240p' game/games/lanterns/run.sh && sed -n '1,260p' game/games/lanterns/logic/src/bin/lanterns-scene.rs && sed -n '1,300p' game/games/lanterns/lantern.fragment.json && git status --short game/games/lanterns\"","aggregated_output":"","exit_code":null,"status":"in_progress"}}
{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,360p' game/games/lanterns/logic/src/scene_tests.rs && sed -n '1,360p' game/games/lanterns/logic/tests/capture.rs && sed -n '1,240p' game/games/lanterns/run.sh && sed -n '1,260p' game/games/lanterns/logic/src/bin/lanterns-scene.rs && sed -n '1,300p' game/games/lanterns/lantern.fragment.json && git status --short game/games/lanterns\"","aggregated_output":"use super::*;\nuse exact_game::{bin, Sim};\nuse exact_game_physics::BodyKind;\nconst LANTERNS: [(&str, Vec3); 12] = [\n    (\"lantern-1\", Vec3::new(-12.0, 0.0, 10.0)),\n    (\"lantern-2\", Vec3::new(-10.0, 0.0, 2.0)),\n    (\"lantern-3\", Vec3::new(-12.0, 0.0, -8.0)),\n    (\"lantern-4\", Vec3::new(-6.0, 0.0, -12.0)),\n    (\"lantern-5\", Vec3::new(0.0, 0.0, -10.0)),\n    (\"lantern-6\", Vec3::new(6.0, 0.0, -12.0)),\n    (\"lantern-7\", Vec3::new(12.0, 0.0, -8.0)),\n    (\"lantern-8\", Vec3::new(12.0, 0.0, 0.0)),\n    (\"lantern-9\", Vec3::new(5.0, 0.0, 2.0)),\n    (\"lantern-10\", Vec3::new(0.0, 0.0, 0.0)),\n    (\"lantern-11\", Vec3::new(0.0, 0.0, 7.0)),\n    (\"lantern-12\", Vec3::new(10.0, 2.4, 8.0)),\n];\n\nfn spawn_lantern(world: &mut World, name: &str, at: Vec3) {\n    let root = world.spawn_named(name, (Transform::at(at.x, at.y, at.z), Lantern::default()));\n    world.spawn_named(\n        format!(\"{name}/post\"),\n        (\n            Transform::at(0.0, 0.675, 0.0),\n            Parent(root),\n            Mesh::cylinder(0.06, 1.35),\n            Material::rgb(0.12, 0.08, 0.06).metallic(0.35).rough(0.7),\n        ),\n    );\n    world.spawn_named(\n        format!(\"{name}/cap\"),\n        (\n            Transform::at(0.0, 1.42, 0.0),\n            Parent(root),\n            Mesh::cylinder(0.24, 0.12),\n            Material::rgb(0.12, 0.08, 0.06).metallic(0.35).rough(0.7),\n        ),\n    );\n    world.spawn_named(\n        format!(\"{name}/bulb\"),\n        (\n            Transform::at(0.0, 1.16, 0.0),\n            Parent(root),\n            Mesh::sphere(0.19),\n            Material::rgb(0.18, 0.16, 0.14),\n            PointLight {\n                color: [1.0, 0.42, 0.08],\n                intensity: 0.0,\n                range: 7.0,\n            },\n        ),\n    );\n}\n\nfn legacy_scene(world: &mut World) {\n    spawn_static_box(\n        world,\n        \"ground\",\n        Vec3::new(0.0, -0.5, 0.0),\n        Vec3::new(36.0, 1.0, 36.0),\n        Material::rgb(0.07, 0.18, 0.11).rough(0.92),\n    );\n    spawn_static_box(\n        world,\n        \"ledge\",\n        Vec3::new(10.0, 1.2, 8.0),\n        Vec3::new(4.0, 2.4, 4.0),\n        Material::rgb(0.28, 0.27, 0.32).rough(0.85),\n    );\n    spawn_static_box(\n        world,\n        \"wall\",\n        Vec3::new(-4.0, 1.0, 5.0),\n        Vec3::new(1.0, 2.0, 5.0),\n        Material::rgb(0.31, 0.29, 0.34).rough(0.88),\n    );\n    let crate_mesh = Mesh::cube(1.2);\n    world.spawn_named(\n        \"crate\",\n        (\n            Transform::at(6.0, 0.6, 8.0),\n            crate_mesh.clone(),\n            Material::rgb(0.45, 0.24, 0.09).rough(0.78),\n            Collider::of(&crate_mesh),\n            Body {\n                kind: BodyKind::Dynamic,\n                mass: 3.0,\n                damping: 0.45,\n                spin_damping: 8.0,\n                ..Body::default()\n            },\n        ),\n    );\n\n    for (name, position) in LANTERNS {\n        spawn_lantern(world, name, position);\n    }\n}\n\n#[test]\nfn authored_initial_world_matches_previous_rust_construction() {\n    let baked = bake_scene();\n    let types = scene_types();\n    let mut authored = World::new(60, 1_041_003);\n    types.register(&mut authored);\n    types\n        .prepare(&baked.content, Lanterns::assets())\n        .unwrap()\n        .instantiate(&mut authored)\n        .unwrap();\n    let mut old = World::new(60, 1_041_003);\n    types.register(&mut old);\n    legacy_scene(&mut old);\n    old.insert_resource(exact_game_scene::SceneIdentity {\n        digest: baked.digest,\n        assets: [(\"Fox.glb\".into(), exact_game_scene::digest_bytes(FOX_BYTES))].into(),\n    });\n    old.propagate();\n    assert_eq!(\n        authored.hash(),\n        old.hash(),\n        \"same names, handles, parents and all typed component values\"\n    );\n    assert_eq!(authored.len(), 52);\n    for entity in authored.entities() {\n        assert_eq!(authored.name(entity), old.name(entity));\n        assert_eq!(authored.global(entity), old.global(entity));\n    }\n}\n\n#[test]\nfn later_content_is_for_restart_and_never_reapplied_to_a_saved_world() {\n    let baked = bake_scene();\n    let mut running = Sim::<Lanterns>::new(Options {\n        scene: baked.content.clone(),\n        seed: 7,\n        started: true,\n        ..Default::default()\n    })\n    .unwrap();\n    running.run(100.0);\n    // Seed nondefault runtime state to test save semantics independently of input delivery.\n    running\n        .world_mut()\n        .get_mut::<Transform>(\"player\")\n        .unwrap()\n        .position = Vec3::new(-12.0, 0.65, 10.0);\n    light_nearest(running.world_mut(), false);\n    running\n        .world_mut()\n        .get_mut::<Transform>(\"crate\")\n        .unwrap()\n        .position\n        .x = 6.8;\n    let before = running.world().hash();\n    let save = running.save();\n\n    let path = std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../scene.json\");\n    let temp = path.with_file_name(format!(\"scene-test-{}.json\", std::process::id()));\n    // This scratch source is beside the original only to preserve relative fragment/asset paths.\n    let original = std::fs::read_to_string(path).unwrap();\n    let modified = original.replace(\"-12,\", \"-11,\");\n    std::fs::write(&temp, modified).unwrap();\n    let replacement = exact_game_scene::bake::compile(&temp, &scene_types(), Lanterns::assets());\n    std::fs::remove_file(temp).unwrap();\n    let replacement = replacement.unwrap();\n    assert_ne!(replacement.digest, baked.digest);\n    let mut fresh = Sim::<Lanterns>::new(Options {\n        scene: replacement.content,\n        seed: 7,\n        started: true,\n        ..Default::default()\n    })\n    .unwrap();\n    assert_eq!(\n        fresh\n            .world()\n            .get::<Transform>(\"lantern-1\")\n            .unwrap()\n            .position\n            .x,\n        -11.0\n    );\n    fresh.restore_bound(&save).unwrap();\n    assert_eq!(fresh.world().hash(), before);\n    assert_eq!(fresh.world().resource::<Session>().elapsed, 6);\n    assert!(fresh.world().get::<Lantern>(\"lantern-1\").unwrap().lit);\n    assert_eq!(\n        fresh.world().get::<Transform>(\"crate\").unwrap().position.x,\n        6.8\n    );\n    assert_eq!(\n        fresh\n            .world()\n            .get::<Transform>(\"lantern-1\")\n            .unwrap()\n            .position\n            .x,\n        -12.0\n    );\n    assert_eq!(\n        fresh\n            .world()\n            .resource::<exact_game_scene::SceneIdentity>()\n            .digest,\n        baked.digest\n    );\n    // The ordinary portable save retains its original initial-condition argument too.\n    let mut restored = Sim::<Lanterns>::new(Options {\n        scene: baked.content,\n        ..Default::default()\n    })\n    .unwrap();\n    restored.restore(&save).unwrap();\n    assert_eq!(restored.world().hash(), before);\n    assert_eq!(\n        bin::to_vec(&*restored.world().resource::<Session>()),\n        bin::to_vec(&*fresh.world().resource::<Session>())\n    );\n}\n\n#[test]\nfn procedural_entities_report_named_generator_with_seed() {\n    let sim = Sim::<Lanterns>::new(Options {\n        scene: bake_scene().content,\n        seed: 41,\n        ..Default::default()\n    })\n    .unwrap();\n    let provenance = sim\n        .world()\n        .get::<exact_game_scene::GeneratedBy>(\"tree-0\")\n        .unwrap();\n    assert_eq!(provenance.generator, \"lanterns::spawn_decor\");\n    assert_eq!(provenance.parameters[\"seed\"], \"41\");\n}\n//! Simulation reproduction of the public native route; normalized inputs, not a UI claim.\nuse exact_game::{Args, Capture, CaptureLimits, Sim, Transform, Value};\nuse exact_game_physics::Character;\nuse lanterns_logic::{Lantern, Lanterns, Options, Session};\n\nfn ticks(sim: &mut Sim<Lanterns>, count: u32) {\n    let before = sim.world().tick();\n    let reply = sim.agent(&format!(r#\"{{\"op\":\"clock\",\"ticks\":{count}}}\"#));\n    assert!(!reply.contains(\"error\"), \"{reply}\");\n    assert_eq!(sim.world().tick(), before + count as u64);\n}\nfn hold(sim: &mut Sim<Lanterns>, code: &str, count: u32) {\n    sim.key_down(code);\n    ticks(sim, count);\n    sim.key_up(code);\n}\nfn press(sim: &mut Sim<Lanterns>, name: &str) {\n    let index = <Options as Args>::FIELDS\n        .iter()\n        .position(|(field, _)| *field == name)\n        .unwrap();\n    let mut values = sim.args().values();\n    let Value::Number(value) = &mut values[index] else {\n        panic!(\"counter\")\n    };\n    *value += 1.0;\n    sim.bind(&values, None).unwrap();\n}\nfn steer(sim: &mut Sim<Lanterns>, x: f32, z: f32, tolerance: f32) {\n    for _ in 0..160 {\n        let at = sim.position(\"player\").unwrap();\n        let dx = x - at.x;\n        let dz = z - at.z;\n        if dx.hypot(dz) <= tolerance {\n            return;\n        }\n        let x_axis = dx.abs() >= dz.abs();\n        let gap = if x_axis { dx } else { dz };\n        let key = if x_axis {\n            if gap > 0.0 {\n                \"KeyD\"\n            } else {\n                \"KeyA\"\n            }\n        } else if gap > 0.0 {\n            \"KeyS\"\n        } else {\n            \"KeyW\"\n        };\n        let count =\n            (((gap.abs() - tolerance * 0.45).max(0.075) / 0.075).floor() as u32).clamp(1, 10);\n        hold(sim, key, count);\n        ticks(sim, 1);\n    }\n    panic!(\n        \"route stalled toward {x},{z} at {:?}\",\n        sim.position(\"player\")\n    );\n}\nfn land(sim: &mut Sim<Lanterns>, floor: f32) {\n    for _ in 0..72 {\n        if sim.world().get::<Character>(\"player\").unwrap().grounded\n            && sim.position(\"player\").unwrap().y - 0.65 > floor\n        {\n            return;\n        }\n        ticks(sim, 1);\n    }\n    panic!(\"landing failed at {:?}\", sim.position(\"player\"));\n}\n#[test]\nfn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n    let mut sim = Sim::<Lanterns>::new(Options {\n        seed: 1_041_003,\n        started: true,\n        sound: true,\n        scene: exact_game_scene::bake::compile(\n            std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../scene.json\"),\n            &lanterns_logic::scene_types(),\n            <Lanterns as exact_game::Game>::assets(),\n        )\n        .unwrap()\n        .content,\n        ..Default::default()\n    })\n    .unwrap();\n    ticks(&mut sim, 2);\n    steer(&mut sim, -8.0, 12.0, 0.18);\n    for index in 1..=11 {\n        let name = format!(\"lantern-{index}\");\n        let at = sim\n            .world()\n            .get::<Transform>(name.as_str())\n            .unwrap()\n            .position;\n        steer(&mut sim, at.x, at.z, 0.18);\n        press(&mut sim, \"light_press\");\n        ticks(&mut sim, 2);\n        assert!(sim.world().get::<Lantern>(name.as_str()).unwrap().lit);\n    }\n    steer(&mut sim, 4.8, 8.0, 0.14);\n    let before = sim.position(\"crate\").unwrap();\n    hold(&mut sim, \"KeyD\", 65);\n    ticks(&mut sim, 15);\n    let at = sim.position(\"crate\").unwrap();\n    assert!(\n        at.x > before.x + 0.25 && at.x < 7.55 && (at.z - 8.0).abs() < 0.22,\n        \"{at:?}\"\n    );\n    sim.start_capture(\n        \"test-executable:lanterns-route\",\n        CaptureLimits {\n            bytes: 8 * 1024 * 1024,\n            ..Default::default()\n        },\n    )\n    .unwrap();\n    steer(&mut sim, at.x - 1.5, at.z, 0.11);\n    press(&mut sim, \"jump_press\");\n    hold(&mut sim, \"KeyD\", 20);\n    land(&mut sim, 0.9);\n    assert!(\n        (sim.position(\"player\").unwrap().y - 0.65 - (sim.position(\"crate\").unwrap().y + 0.6)).abs()\n            < 0.18\n    );\n    press(&mut sim, \"jump_press\");\n    hold(&mut sim, \"KeyD\", 35);\n    land(&mut sim, 2.2);\n    steer(&mut sim, 10.0, 8.0, 0.18);\n    press(&mut sim, \"light_press\");\n    ticks(&mut sim, 2);\n    assert_eq!(sim.world().resource::<Session>().phase, 2);\n    assert_eq!(\n        sim.world()\n            .query::<&Lantern>()\n            .iter()\n            .filter(|(_, l)| l.lit)\n            .count(),\n        12\n    );\n    let hash = sim.world().hash();\n    let capture = Capture::from_bytes(&sim.stop_capture().unwrap().to_bytes()).unwrap();\n    for _ in 0..2 {\n        let replay =\n            Sim::<Lanterns>::replay_capture(&capture, \"test-executable:lanterns-route\", None)\n                .unwrap();\n        assert_eq!(replay.world().hash(), hash);\n        assert_eq!(replay.world().resource::<Session>().phase, 2);\n    }\n    let terminal = sim.save();\n    let restored = Sim::<Lanterns>::from_save(&terminal).unwrap();\n    assert_eq!(restored.world().hash(), hash);\n    sim.start_capture(\"test-executable:lanterns-route\", CaptureLimits::default())\n        .unwrap();\n    ticks(&mut sim, 10);\n    let terminal_capture = sim.stop_capture().unwrap();\n    let replay =\n        Sim::<Lanterns>::replay_capture(terminal_capture, \"test-executable:lanterns-route\", None)\n            .unwrap();\n    assert_eq!(replay.world().resource::<Session>().phase, 2);\n}\n#!/bin/sh\nset -eu\nexport EXACT_UPDATE_TRUST=development\nAPP_DIR=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\nexport EXACT_APP_DIR=\"$APP_DIR\"\nexport CARGO_TARGET_DIR=\"$APP_DIR/target\"\nexport EXACT_WEB_DIST=\"$APP_DIR/dist\"\ncd \"$APP_DIR/../../..\"\ncase \"${1:-proof}\" in\n  proof) exec bun \"$APP_DIR/proof.mjs\" web ;;\n  build-web) exec bun \"$APP_DIR/build-web.mjs\" ;;\n  test) exec cargo test --manifest-path game/Cargo.toml --locked --offline -p lanterns-logic ;;\n  dev) exec bun game/dev.mjs lanterns ;;\n  macos) exec bun host/apple/build.mjs --run ;;\n  ios) exec bun host/apple/build.mjs --ios --device ;;\n  *) echo 'Usage: sh game/games/lanterns/run.sh [proof|test|build-web|dev|macos|ios]' >&2; exit 2 ;;\nesac\nuse exact_game::Game;\nfn main() {\n    exact_game_scene::bake::main(\n        lanterns_logic::scene_types(),\n        lanterns_logic::Lanterns::assets(),\n    );\n}\n{\n  \"units\": \"metres-y-up\",\n  \"parameters\": [\n    \"position\"\n  ],\n  \"entities\": [\n    {\n      \"id\": \"\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": {\n            \"$param\": \"position\"\n          }\n        },\n        \"Lantern\": {}\n      }\n    },\n    {\n      \"id\": \"post\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            0.675,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Cylinder\": {\n            \"radius\": 0.06,\n            \"height\": 1.35\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.12,\n            0.08,\n            0.06,\n            1\n          ],\n          \"metallic\": 0.35,\n          \"roughness\": 0.7\n        }\n      }\n    },\n    {\n      \"id\": \"cap\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            1.42,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Cylinder\": {\n            \"radius\": 0.24,\n            \"height\": 0.12\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.12,\n            0.08,\n            0.06,\n            1\n          ],\n          \"metallic\": 0.35,\n          \"roughness\": 0.7\n        }\n      }\n    },\n    {\n      \"id\": \"bulb\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            1.16,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Sphere\": {\n            \"radius\": 0.19\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.18,\n            0.16,\n            0.14,\n            1\n          ]\n        },\n        \"PointLight\": {\n          \"color\": [\n            1,\n            0.42,\n            0.08\n          ],\n          \"intensity\": 0,\n          \"range\": 7\n        }\n      }\n    }\n  ]\n}\n","exit_code":0,"status":"completed"}}
