+fn return_home(sim: &mut Sim<Lanterns>) {
+    steer(sim, 0.0, 8.0, 0.18);
+    for _ in 0..320 {
+        if sim.world().resource::<Session>().phase == 2 {
+            return;
+        }
+        let at = sim.position("player").unwrap();
+        let dx = -at.x;
+        let dz = 12.0 - at.z;
+        let key = if dx.abs() >= dz.abs() {
+            if dx > 0.0 {
+                "KeyD"
+            } else {
+                "KeyA"
+            }
+        } else if dz > 0.0 {
+            "KeyS"
+        } else {
+            "KeyW"
+        };
+        hold(sim, key, 4);
+        ticks(sim, 1);
+    }
+    panic!("return home stalled at {:?}", sim.position("player"));
+}
