ng'].includes(before.phase)) {\n             const {view} = await waitReady();\n             surface(view, {op: 'clock', ticks});\n           }\ndiff --git a/game/games/lanterns/logic/src/lib.rs b/game/games/lanterns/logic/src/lib.rs\nindex 4d7e920..5360a64 100644\n--- a/game/games/lanterns/logic/src/lib.rs\n+++ b/game/games/lanterns/logic/src/lib.rs\n@@ -13,6 +13,7 @@ use exact_game_physics::{self as physics, Body, Character, Collider, Physics};\n const FOX_BYTES: &[u8] = include_bytes!(\"../../assets/Fox.glb\");\n const DURATION_TICKS: u32 = 180 * 60;\n const SPAWN: Vec3 = Vec3::new(0.0, 0.0, 12.0);\n+const HOME_RADIUS: f32 = 2.0;\n /// Canvas inputs. Action counters let Contract overlay buttons feed distinct\n /// touch presses while the left thumb remains on the raw movement stick.\n #[derive(Default, exact_game::Args)]\n@@ -61,7 +62,7 @@ pub struct Lantern {\n pub struct Session {\n     /// Active fixed ticks; pause and terminal states do not add to this.\n     pub elapsed: u32,\n-    /// 0 title, 1 playing, 2 won, 3 lost.\n+    /// 0 title, 1 playing, 2 returning home, 3 won, 4 lost.\n     pub phase: u32,\n     /// Last Contract Jump counter consumed.\n     pub jump_press: u32,\n@@ -75,7 +76,7 @@ pub struct Lanterns;\n impl Game for Lanterns {\n     const CAPTURE_SUPPORTED: bool = true;\n     const ID: &'static str = \"lanterns\";\n-    const SAVE_VERSION: u32 = 2;\n+    const SAVE_VERSION: u32 = 3;\n     type Args = Options;\n \n     fn assets() -> &'static [Asset] {\n@@ -207,7 +208,7 @@ impl Game for Lanterns {\n             let light = session.light_press != args.light_press;\n             session.jump_press = args.jump_press;\n             session.light_press = args.light_press;\n-            (session.phase >= 2, jump, light)\n+            (session.phase >= 3, jump, light)\n         };\n         if terminal {\n             publish(world);\n@@ -245,11 +246,19 @@ impl Game for Lanterns {\n         update_lanterns(world);\n         let elapsed = world.resource::<Session>().elapsed;\n         if elapsed >= DURATION_TICKS {\n-            world.resource_mut::<Session>().phase = 3;\n+            world.resource_mut::<Session>().phase = 4;\n             world.log(\"night fell\");\n             if args.sound {\n                 world.play(\"night\").start();\n             }\n+        } else if world.resource::<Session>().phase == 2 {\n+            let at = world.get::<Transform>(player).unwrap().position;\n+            let dx = at.x - SPAWN.x;\n+            let dz = at.z - SPAWN.z;\n+            if dx * dx + dz * dz <= HOME_RADIUS * HOME_RADIUS {\n+                world.resource_mut::<Session>().phase = 3;\n+                world.log(\"returned home\");\n+            }\n         }\n         update_sun(world);\n         scene::follow(world);\n@@ -515,7 +524,8 @@ fn publish(world: &mut World) {\n     let phase = match session.phase {\n         0 => \"title\",\n         1 => \"playing\",\n-        2 => \"won\",\n+        2 => \"returning\",\n+        3 => \"won\",\n         _ => \"lost\",\n     };\n     drop(session);\n@@ -593,7 +603,7 @@ mod tests {\n     fn no_input_loses_at_exactly_three_minutes() {\n         let mut sim = game();\n         sim.run(180_000.0);\n-        assert_eq!(sim.world().resource::<Session>().phase, 3);\n+        assert_eq!(sim.world().resource::<Session>().phase, 4);\n         assert_eq!(sim.world().resource::<Session>().elapsed, DURATION_TICKS);\n     }\n }\ndiff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs\nindex 7f55422..1b2f329 100644\n--- a/game/games/lanterns/logic/tests/capture.rs\n+++ b/game/games/lanterns/logic/tests/capture.rs\n@@ -68,6 +68,34 @@ fn land(sim: &mut Sim<Lanterns>, floor: f32) {\n     }\n     panic!(\"landing failed at {:?}\", sim.position(\"player\"));\n }\n+\n+fn return_home(sim: &mut Sim<Lanterns>) {\n+    for _ in 0..320 {\n+        if sim.world().resource::<Session>().phase == 3 {\n+            return;\n+        }\n+        let at = sim.position(\"player\").unwrap();\n+        let dx = -at.x;\n+        let dz = 12.0 - at.z;\n+        let x_axis = dx.abs() >= dz.abs();\n+        let gap = if x_axis { dx } else { dz };\n+        let key = if x_axis {\n+            if gap > 0.0 {\n+                \"KeyD\"\n+            } else {\n+                \"KeyA\"\n+            }\n+        } else if gap > 0.0 {\n+            \"KeyS\"\n+        } else {\n+            \"KeyW\"\n+        };\n+        hold(sim, key, 6);\n+        ticks(sim, 1);\n+    }\n+    panic!(\"return route stalled at {:?}\", sim.position(\"player\"));\n+}\n+\n #[test]\n fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n     let mut sim = Sim::<Lanterns>::new(Options {\n@@ -138,6 +166,25 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             .count(),\n         12\n     );\n+    let returning_elapsed = sim.world().resource::<Session>().elapsed;\n+    let returning_save = sim.save();\n+    let mut returning = Sim::<Lanterns>::from_save(&returning_save).unwrap();\n+    assert_eq!(returning.world().resource::<Session>().phase, 2);\n+    assert_eq!(\n+        returning.world().resource::<Session>().elapsed,\n+        returning_elapsed\n+    );\n+    ticks(&mut returning, 10);\n+    assert_eq!(returning.world().resource::<Session>().phase, 2);\n+    assert_eq!(\n+        returning.world().resource::<Session>().elapsed,\n+        returning_elapsed + 10\n+    );\n+\n+    return_home(&mut sim);\n+    assert_eq!(sim.world().resource::<Session>().phase, 3);\n+    let home = sim.position(\"player\").unwrap();\n+    assert!(home.x * home.x + (home.z - 12.0) * (home.z - 12.0) <= 4.0);\n     let hash = sim.world().hash();\n     let capture = Capture::from_bytes(&sim.stop_capture().unwrap().to_bytes()).unwrap();\n     for _ in 0..2 {\n@@ -145,7 +192,7 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             Sim::<Lanterns>::replay_capture(&capture, \"test-executable:lanterns-route\", None)\n                 .unwrap();\n         assert_eq!(replay.world().hash(), hash);\n-        assert_eq!(replay.world().resource::<Session>().phase, 2);\n+        assert_eq!(replay.world().resource::<Session>().phase, 3);\n     }\n     let terminal = sim.save();\n     let restored = Sim::<Lanterns>::from_save(&terminal).unwrap();\n@@ -157,5 +204,5 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n     let replay =\n         Sim::<Lanterns>::replay_capture(terminal_capture, \"test-executable:lanterns-route\", None)\n             .unwrap();\n-    assert_eq!(replay.world().resource::<Session>().phase, 2);\n+    assert_eq!(replay.world().resource::<Session>().phase, 3);\n }\n","exit_code":0,"status":"completed"}}
