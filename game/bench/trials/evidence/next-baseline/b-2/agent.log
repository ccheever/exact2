{"type":"item.completed","item":{"id":"item_5","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' game/games/lanterns/app.contract && sed -n '330,660p' game/games/lanterns/logic/src/lib.rs && sed -n '1,220p' game/games/lanterns/app.json && sed -n '1,260p' game/games/lanterns/assets/lanterns-adapter.mjs && rg -n \\\"phase|all lanterns|victory|return|Session|SAVE_VERSION\\\" game/games/lanterns\"","aggregated_output":"use sceneContent from \"./.scene/scene.contract\"\n\nshape Hud\n  count: number\n  total: number\n  remaining: number\n  phase: string\n\ncomponent Lanterns\n  state started = false\n  state seed = 1041003\n  state paused = false\n  state round = 0\n  state jumpPress = 0\n  state lightPress = 0\n  state sound = true\n  state saveRequest = 0\n  state loadRequest = 0\n  state checkpointStatus = \"\"\n  resource hud = exactSurface(\"world\") as shape Hud\n\n  action play writes started\n    started = true\n  action togglePause writes paused\n    paused = not paused\n  action toggleSound writes sound\n    sound = not sound\n  action jump writes jumpPress\n    jumpPress = jumpPress + 1\n  action light writes lightPress\n    lightPress = lightPress + 1\n  action restart writes round, paused\n    round = round + 1\n    paused = false\n  action saveGame writes saveRequest, checkpointStatus\n    saveRequest = saveRequest + 1\n    checkpointStatus = \"Saving…\"\n  action loadGame writes loadRequest, checkpointStatus\n    loadRequest = loadRequest + 1\n    checkpointStatus = \"Loading…\"\n  action checkpoint(value: string) writes checkpointStatus, started\n    if value == \"surface-save:saved\"\n      checkpointStatus = \"Saved\"\n    if value == \"surface-load:loaded\"\n      checkpointStatus = \"Loaded\"\n      started = true\n    if value == \"surface-save:error\"\n      checkpointStatus = \"Save failed\"\n    if value == \"surface-load:error\"\n      checkpointStatus = \"No compatible save\"\n\n  view\n    main width=\"100%\" height=\"100%\" background-color=\"#130f24\" color=\"#fff4d6\"\n      canvas surface=world(seed, started, paused, round, jumpPress, lightPress, sound, sceneContent()) surface-save=saveRequest surface-load=loadRequest message=checkpoint testId=\"world\" width=\"100%\" height=\"100%\" position=\"relative\" overflow=\"hidden\"\n        when started\n          row position=\"absolute\" top=18 left=18 right=18 justify-content=\"space-between\" align-items=\"center\" flex-wrap=\"wrap\" gap=8\n            text `LANTERNS ${hud.count} / ${hud.total}` aria-live=\"polite\" testId=\"hud-lanterns\" padding=13 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=20 font-weight=700\n            text `TIME ${hud.remaining}` aria-live=\"polite\" testId=\"hud-time\" padding=13 border-radius=10 background-color=\"#1b1730\" color=\"#fff4d6\" font-size=20 font-weight=600\n            row gap=8\n              button press=toggleSound testId=\"sound\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text (sound ? \"Sound on\" : \"Sound off\") color=\"#fff4d6\" font-size=16\n              button press=saveGame testId=\"save\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text \"Save\" color=\"#fff4d6\" font-size=16\n              button press=loadGame testId=\"load-save\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text \"Load\" color=\"#fff4d6\" font-size=16\n              button press=togglePause testId=\"pause\" padding=13 border-radius=10 background-color=\"#1b1730\"\n                text (paused ? \"Resume\" : \"Pause\") color=\"#fff4d6\" font-size=16\n            when checkpointStatus != \"\"\n              text checkpointStatus aria-live=\"polite\" testId=\"save-status\" padding=10 border-radius=9 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          text \"Move: WASD / arrows / left thumb\" position=\"absolute\" bottom=22 left=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#d6cdec\" font-size=15\n          text \"Push the crate beside the high ledge. Jump onto it, then jump again.\" testId=\"sign-instruction\" position=\"absolute\" bottom=76 left=22 right=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          row position=\"absolute\" bottom=22 right=22 gap=14 align-items=\"flex-end\"\n            button press=light testId=\"light\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#ffb43b\" justify-content=\"center\" align-items=\"center\"\n              text \"LIGHT\" width=\"100%\" text-align=\"center\" color=\"#241531\" font-size=17 font-weight=700\n            button press=jump testId=\"jump\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#a78cff\" justify-content=\"center\" align-items=\"center\"\n              text \"JUMP\" width=\"100%\" text-align=\"center\" color=\"#171126\" font-size=17 font-weight=700\n          when paused\n            column testId=\"paused\" position=\"absolute\" top=\"34%\" left=\"30%\" width=\"40%\" padding=26 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Paused\" font-size=34 font-weight=700 color=\"#ffd27a\"\n              text \"Your 180 seconds are frozen.\" font-size=17 color=\"#d6cdec\"\n              button press=togglePause testId=\"resume\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Resume\" font-size=19 color=\"#241531\"\n          when hud.phase == \"won\"\n            column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"The island is glowing\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"again\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Play again\" font-size=19 color=\"#241531\"\n          when hud.phase == \"lost\"\n            column testId=\"lost\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Night fell\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text `You lit ${hud.count} of 12 lanterns.` font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"retry\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Try again\" font-size=19 color=\"#241531\"\n        else\n          column testId=\"title\" position=\"absolute\" top=0 left=0 width=\"100%\" height=\"100%\" align-items=\"center\" justify-content=\"center\" gap=24 background-color=\"#130f24\"\n            text \"LANTERNS\" font-size=64 font-weight=700 color=\"#ffd27a\"\n            text \"Light twelve lanterns before the last three minutes of dusk run out.\" font-size=20 color=\"#fff4d6\"\n            text \"Push the crate to reach the lantern on the stone ledge.\" font-size=17 color=\"#d6cdec\"\n            text \"WASD or arrows · Space to jump · E to light\" font-size=15 color=\"#a99fc1\"\n            row gap=12\n              button press=play autofocus testId=\"play\" padding=18 border-radius=10 background-color=\"#ffd27a\"\n                text \"Play\" font-size=22 font-weight=700 color=\"#241531\"\n              button press=loadGame testId=\"title-load\" padding=18 border-radius=10 background-color=\"#1b1730\"\n                text \"Load save\" font-size=22 font-weight=700 color=\"#ffd27a\"\n            when checkpointStatus != \"\"\n              text checkpointStatus aria-live=\"polite\" testId=\"title-save-status\" color=\"#ffd27a\" font-size=15\n    spawn_static_box(\n        world,\n        \"sign-board\",\n        Vec3::new(3.0, 1.55, 10.0),\n        Vec3::new(2.5, 0.9, 0.14),\n        Material::rgb(0.36, 0.21, 0.1),\n    );\n}\n\nfn spawn_decor(world: &mut World, seed: u64) {\n    world.reseed(seed);\n    let before: Vec<_> = world.entities().collect();\n    for i in 0..18 {\n        let angle = world.rand(0.0..std::f32::consts::TAU);\n        let radius = world.rand(13.0..16.5);\n        let x = angle.cos() * radius;\n        let z = angle.sin() * radius;\n        let trunk = world.spawn_named(\n            format!(\"tree-{i}\"),\n            (\n                Transform::at(x, 1.05, z),\n                Mesh::cylinder(0.17, 2.1),\n                Material::rgb(0.19, 0.12, 0.07),\n            ),\n        );\n        world.spawn((\n            Transform::at(0.0, 2.15, 0.0).with_scale(Vec3::new(1.0, 1.6, 1.0)),\n            Parent(trunk),\n            Mesh::cylinder(1.15, 2.4),\n            Material::rgb(0.04, 0.17, 0.1).rough(0.9),\n        ));\n    }\n    for i in 0..22 {\n        let angle = world.rand(0.0..std::f32::consts::TAU);\n        let radius = world.rand(14.0..17.0);\n        world.spawn_named(\n            format!(\"rock-{i}\"),\n            (\n                Transform::at(angle.cos() * radius, 0.2, angle.sin() * radius).with_scale(\n                    Vec3::new(\n                        world.rand(0.4..1.0),\n                        world.rand(0.2..0.6),\n                        world.rand(0.4..1.0),\n                    ),\n                ),\n                Mesh::sphere(0.5),\n                Material::rgb(0.24, 0.25, 0.3).rough(0.95),\n            ),\n        );\n    }\n    let generated: Vec<_> = world.entities().filter(|e| !before.contains(e)).collect();\n    for entity in generated {\n        world.insert(\n            entity,\n            exact_game_scene::GeneratedBy {\n                generator: \"lanterns::spawn_decor\".into(),\n                parameters: [\n                    (\"seed\".into(), seed.to_string()),\n                    (\"trees\".into(), \"18\".into()),\n                    (\"rocks\".into(), \"22\".into()),\n                ]\n                .into(),\n            },\n        );\n    }\n}\n\nfn update_player(world: &mut World, direction: Vec3, sound: bool) {\n    let player = world.named(\"player\").unwrap();\n    let (grounded, velocity) = {\n        let character = world.get::<Character>(player).unwrap();\n        (character.grounded, character.velocity)\n    };\n    let speed = Vec2::new(velocity.x, velocity.z).length();\n    let clip = if !grounded || speed >= 2.8 {\n        \"Run\"\n    } else if speed > 0.08 {\n        \"Walk\"\n    } else {\n        \"Survey\"\n    };\n    let fox = world.named(\"fox\").unwrap();\n    {\n        let mut animation = world.get_mut::<Animation>(fox).unwrap();\n        animation.play(clip);\n        animation.advance(world.dt());\n    }\n    if direction.length_squared() > 0.0025 {\n        let yaw = direction.x.atan2(-direction.z);\n        world.get_mut::<Transform>(fox).unwrap().rotation = Quat::from_rotation_y(yaw);\n    }\n    if grounded && speed > 0.08 {\n        let mut footsteps = 0;\n        {\n            let mut state = world.get_mut::<Player>(player).unwrap();\n            state.stride += speed * world.dt();\n            while state.stride >= 0.7 {\n                state.stride -= 0.7;\n                footsteps += 1;\n            }\n        }\n        if sound {\n            for _ in 0..footsteps {\n                world.play(\"footstep\").at(player).start();\n            }\n        }\n    }\n    let feet = world.get::<Transform>(player).unwrap().position.y - 0.65;\n    if feet < -6.0 {\n        let mut pose = *world.get::<Transform>(player).unwrap();\n        pose.position = SPAWN + Vec3::Y * 0.65;\n        world.teleport(player, pose);\n        let mut c = world.get_mut::<Character>(player).unwrap();\n        c.velocity = Vec3::ZERO;\n        c.grounded = false;\n        world.log(\"fall reset\");\n    }\n}\n\nfn light_nearest(world: &mut World, sound: bool) {\n    let center = world.get::<Transform>(\"player\").unwrap().position - Vec3::Y * 0.65;\n    let mut nearest = None;\n    let mut distance = 1.5f32;\n    for (entity, (pose, lantern)) in world.query::<(&Transform, &Lantern)>().iter() {\n        if lantern.lit {\n            continue;\n        }\n        let d = pose.position.distance(center);\n        if d <= distance {\n            distance = d;\n            nearest = Some(entity);\n        }\n    }\n    let Some(entity) = nearest else { return };\n    {\n        let mut lantern = world.get_mut::<Lantern>(entity).unwrap();\n        lantern.lit = true;\n        lantern.glow.set_target(world.now(), 1.0);\n    }\n    let name = world.name(entity).unwrap().to_owned();\n    world.log(format_args!(\"{name} lit\"));\n    if sound {\n        world.play(\"chime\").at(entity).start();\n    }\n    let count = world\n        .query::<&Lantern>()\n        .iter()\n        .filter(|(_, l)| l.lit)\n        .count();\n    if count == world.query::<&Lantern>().iter().count() {\n        world.resource_mut::<Session>().phase = 2;\n        world.log(\"all lanterns lit\");\n    }\n}\n\nfn update_lanterns(world: &mut World) {\n    let now = world.now();\n    let rows: Vec<_> = world\n        .query::<&Lantern>()\n        .iter()\n        .map(|(e, l)| (world.name(e).unwrap().to_owned(), l.glow.value(now)))\n        .collect();\n    for (name, glow) in rows {\n        let bulb = world.named(&format!(\"{name}/bulb\")).unwrap();\n        world.get_mut::<Material>(bulb).unwrap().emissive = [glow * 4.0, glow * 1.65, glow * 0.32];\n        world.get_mut::<PointLight>(bulb).unwrap().intensity = glow * 5.0;\n    }\n}\n\nfn update_sun(world: &mut World) {\n    let progress = world.resource::<Session>().elapsed as f32 / DURATION_TICKS as f32;\n    let angle = 0.22 - progress * 0.52;\n    let position = Vec3::new(24.0 * angle.cos(), 24.0 * angle.sin() + 4.0, -18.0);\n    *world.get_mut::<Transform>(\"sun\").unwrap() =\n        Transform::at(position.x, position.y, position.z).looking_at(Vec3::ZERO, Vec3::Y);\n}\n\nfn publish(world: &mut World) {\n    let count = world\n        .query::<&Lantern>()\n        .iter()\n        .filter(|(_, l)| l.lit)\n        .count() as u32;\n    let session = world.resource::<Session>();\n    let remaining = DURATION_TICKS.saturating_sub(session.elapsed).div_ceil(60);\n    let phase = match session.phase {\n        0 => \"title\",\n        1 => \"playing\",\n        2 => \"won\",\n        _ => \"lost\",\n    };\n    drop(session);\n    world.publish(\"count\", count);\n    world.publish(\"total\", world.query::<&Lantern>().iter().count() as u32);\n    world.publish(\"remaining\", remaining);\n    world.publish(\"phase\", phase);\n    world.publish(\"assetReady\", true);\n}\n\n#[cfg(test)]\nmod tests {\n    use super::*;\n    use exact_game::Sim;\n\n    fn game() -> Sim<Lanterns> {\n        Sim::new(Options {\n            scene: bake_scene().content,\n            seed: 1_041_003,\n            started: true,\n            sound: true,\n            ..Options::default()\n        })\n        .unwrap()\n    }\n\n    #[test]\n    fn level_has_matching_player_crate_obstacles_and_twelve_targets() {\n        let sim = game();\n        let world = sim.world();\n        assert_eq!(world.query::<&Lantern>().iter().count(), 12);\n        assert_eq!(\n            world.get::<Transform>(\"crate\").unwrap().position,\n            Vec3::new(6.0, 0.6, 8.0)\n        );\n        assert_eq!(\n            world.get::<Transform>(\"lantern-12\").unwrap().position,\n            Vec3::new(10.0, 2.4, 8.0)\n        );\n        assert!(world.has::<Animation>(world.named(\"fox\").unwrap()));\n    }\n\n    #[test]\n    fn one_second_moves_at_four_point_five_and_selects_run() {\n        let mut sim = game();\n        sim.key_down(\"KeyW\");\n        sim.run(1000.0);\n        sim.key_up(\"KeyW\");\n        let pose = sim.world().get::<Transform>(\"player\").unwrap();\n        assert!(\n            (pose.position.z - 7.5).abs() < 0.08,\n            \"z={}\",\n            pose.position.z\n        );\n        assert_eq!(sim.world().get::<Animation>(\"fox\").unwrap().clip, \"Run\");\n    }\n\n    #[test]\n    fn save_restores_dynamic_body_timer_animation_and_lights() {\n        let mut sim = game();\n        sim.run(100.0);\n        let bytes = sim.save();\n        let hash = sim.world().hash();\n        let mut restored = game();\n        restored.restore(&bytes).unwrap();\n        assert_eq!(restored.world().hash(), hash);\n        assert_eq!(restored.world().resource::<Session>().elapsed, 6);\n        assert_eq!(\n            restored.world().get::<Animation>(\"fox\").unwrap().clip,\n            \"Survey\"\n        );\n    }\n\n    #[test]\n    fn no_input_loses_at_exactly_three_minutes() {\n        let mut sim = game();\n        sim.run(180_000.0);\n        assert_eq!(sim.world().resource::<Session>().phase, 3);\n        assert_eq!(sim.world().resource::<Session>().elapsed, DURATION_TICKS);\n    }\n}\n\n/// Scene type selection; every field/default/variant comes from these Rust declarations.\npub fn scene_types() -> exact_game_scene::Types {\n    let mut types = exact_game_scene::Types::standard();\n    types\n        .component::<Lantern>()\n        .component::<Collider>()\n        .component::<Body>();\n    types\n}\n\n#[cfg(test)]\nfn bake_scene() -> exact_game_scene::bake::Baked {\n    exact_game_scene::bake::compile(\n        std::path::Path::new(env!(\"CARGO_MANIFEST_DIR\")).join(\"../scene.json\"),\n        &scene_types(),\n        Lanterns::assets(),\n    )\n    .unwrap()\n}\n#[cfg(test)]\nmod scene_tests;\n{\n  \"$schema\": \"../../../scripts/app.schema.json\",\n  \"name\": \"Lanterns Exact\",\n  \"short_name\": \"Lanterns\",\n  \"id\": \"com.exact.lanterns.exact\",\n  \"start_url\": \"/\",\n  \"display\": \"standalone\",\n  \"theme_color\": \"#130f24\",\n  \"background_color\": \"#130f24\",\n  \"app\": { \"id\": \"com.exact.lanterns.exact\", \"name\": \"Lanterns Exact\" },\n  \"host\": {\n    \"macos\": { \"minimumOS\": \"14.0\", \"window\": { \"width\": 1280, \"height\": 720 } },\n    \"ios\": { \"minimumOS\": \"17.0\", \"deviceFamily\": [\"iphone\", \"ipad\"] },\n    \"web\": {}\n  },\n  \"game\": { \"crate\": \"lanterns-logic\", \"type\": \"Lanterns\" },\n  \"rust\": false,\n  \"deploy\": { \"store\": { \"web\": \"0\", \"macos\": \"0\", \"ios\": \"0\", \"linux\": \"0\" } }\n}\n// Development-only bridge for the independent four-engine Lanterns evaluator.\n// It drives Exact's real surface input, clock, save carrier, and live world state.\nconst PARAMS = new URLSearchParams(location.search);\nconst ENABLED = PARAMS.get('agent') === '1';\nconst STORAGE_KEY = 'lanterns-exact-world-v1';\n\n\nif (ENABLED) {\n  let moveDown = false;\n  let jumpDown = false;\n  let actDown = false;\n  const adapterEvents = [];\n\n  const exact = () => globalThis.exact;\n  const tree = async () => exact()?.agent ? await exact().agent({op: 'tree'}) : null;\n  async function worldView() {\n    const t = await tree();\n    return t?.nodes?.find(node => node.props?.testId === 'world')?.id ?? null;\n  }\n  async function viewByTestId(testId) {\n    const t = await tree();\n    const id = t?.nodes?.find(node => node.props?.testId === testId)?.id;\n    return id == null ? null : exact().views.get(id);\n  }\n  const surface = (view, request) => exact().gpu?.agent?.(view, request) ?? null;\n  const entity = (view, name) => surface(view, {op: 'state', entity: name})?.entity?.components ?? null;\n\n  async function readyState() {\n    const view = await worldView();\n    if (view == null || !exact()?.gpu) return null;\n    const result = surface(view, {op: 'state'})?.world;\n    if (!result?.device || result.renderError) return null;\n    const fox = entity(view, 'fox');\n    return fox?.Mesh?.Asset?.[0] === 'Fox.glb' && fox?.Animation ? {view, result} : null;\n  }\n  async function waitReady() {\n    const deadline = performance.now() + 60000;\n    while (performance.now() < deadline) {\n      const result = await readyState();\n      if (result) return result;\n      await new Promise(resolve => setTimeout(resolve, 16));\n    }\n    throw new Error('Exact Lanterns surface did not become ready');\n  }\n  function dispatchKey(host, code, down) {\n    host.dispatchEvent(new KeyboardEvent(down ? 'keydown' : 'keyup', {\n      bubbles: true, cancelable: true, code, key: code === 'Space' ? ' ' : code === 'KeyE' ? 'e' : code,\n    }));\n  }\n  function dispatchPointer(host, phase, x, y) {\n    host.dispatchEvent(new PointerEvent(`pointer${phase}`, {\n      bubbles: true, cancelable: true, pointerId: 41003, pointerType: 'touch',\n      clientX: x, clientY: y, buttons: phase === 'up' || phase === 'cancel' ? 0 : 1,\n    }));\n  }\n  async function setInput(request = {}) {\n    const {view} = await waitReady();\n    const host = exact().views.get(view);\n    const rect = host.getBoundingClientRect();\n    const origin = {x: rect.left + Math.min(180, rect.width * .24), y: rect.top + rect.height * .5};\n    const moveX = Math.max(-1, Math.min(1, Number(request.moveX) || 0));\n    const moveZ = Math.max(-1, Math.min(1, Number(request.moveZ) || 0));\n    if (moveX !== 0 || moveZ !== 0) {\n      if (!moveDown) {\n        dispatchPointer(host, 'down', origin.x, origin.y);\n        moveDown = true;\n      }\n      dispatchPointer(host, 'move', origin.x + moveX * 60, origin.y + moveZ * 60);\n    } else if (moveDown) {\n      dispatchPointer(host, 'up', origin.x, origin.y);\n      moveDown = false;\n    }\n    const jump = request.jump === true;\n    const act = request.act === true;\n    if (jump !== jumpDown) dispatchKey(host, 'Space', jump);\n    if (act !== actDown) dispatchKey(host, 'KeyE', act);\n    jumpDown = jump;\n    actDown = act;\n  }\n  async function releaseInput() {\n    await setInput({});\n    moveDown = jumpDown = actDown = false;\n  }\n  function eventRows(lines) {\n    return lines.flatMap((line) => {\n      if (/\\bjump$/.test(line)) return [{type: 'jump'}];\n      const lit = /\\b(lantern-\\d+) lit$/.exec(line);\n      if (lit) return [{type: 'lantern-lit', id: lit[1]}];\n      if (/\\ball lanterns lit$/.test(line)) return [{type: 'win'}];\n      if (/\\bnight fell$/.test(line)) return [{type: 'lose'}];\n      return [];\n    });\n  }\n  async function state() {\n    const {view, result: world} = await waitReady();\n    const player = entity(view, 'player');\n    const fox = entity(view, 'fox');\n    const crate = entity(view, 'crate');\n    const session = world.resources?.Session ?? {};\n    const published = world.published ?? {};\n    const args = world.args ?? {};\n    const logs = surface(view, {op: 'logs', since: 0})?.lines ?? [];\n    const playerAt = player?.Transform?.position ?? [0, .65, 12];\n    const playerVelocity = player?.Character?.velocity ?? [0, 0, 0];\n    const crateAt = crate?.Transform?.position ?? [6, .6, 8];\n    const crateVelocity = crate?.Body?.velocity ?? [0, 0, 0];\n    const roster = surface(view, {op:'state', entity:'*'});\n    if (!roster?.entities || roster.truncated) throw new Error('Lantern roster inspection unavailable or truncated');\n    const lanterns = roster.entities.filter(row => row.components?.Lantern).map(row => {\n      const position = row.components.Transform?.position;\n      if (!row.name || !position) throw new Error('A runtime lantern is missing its authored identity or Transform');\n      const [x, y, z] = position;\n      return {id:row.name, x, y, z, lit:row.components.Lantern.lit === true};\n    });\n    let phase = published.phase ?? 'title';\n    if (phase === 'title' && args.started === true) phase = 'playing';\n    if (world.paused && args.started === true && phase === 'playing') phase = 'paused';\n    return {\n      phase,\n      ticks: world.tick,\n      elapsed: Number(session.elapsed ?? world.tick) / 60,\n      remaining: Number(published.remaining ?? Math.max(0, 180 - world.tick / 60)),\n      player: {\n        x: playerAt[0], y: playerAt[1] - .65, z: playerAt[2],\n        vx: playerVelocity[0], vy: playerVelocity[1], vz: playerVelocity[2],\n        grounded: player?.Character?.grounded === true,\n        animation: fox?.Animation?.clip ?? 'Survey',\n      },\n      crate: {\n        x: crateAt[0], y: crateAt[1], z: crateAt[2],\n        vx: crateVelocity[0], vy: crateVelocity[1], vz: crateVelocity[2],\n      },\n      lanterns,\n      count: lanterns.filter(item => item.lit).length,\n      total: lanterns.length,\n      events: [...eventRows(logs).map(event => ({...event, tick: world.tick})), ...adapterEvents],\n      assetReady: true,\n    };\n  }\n  async function restart(started) {\n    await releaseInput().catch(() => {});\n    await exact().reload(null);\n    await waitReady();\n    if (started) {\n      const play = await viewByTestId('play');\n      if (!play) throw new Error('Play action is unavailable');\n      play.click();\n      await Promise.resolve();\n    }\n    return state();\n  }\n  function encode(bytes) {\n    let text = '';\n    for (let i = 0; i < bytes.length; i += 8192) text += String.fromCharCode(...bytes.subarray(i, i + 8192));\n    return btoa(text);\n  }\n  function decode(text) {\n    const binary = atob(text), bytes = new Uint8Array(binary.length);\n    for (let i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);\n    return bytes;\n  }\n  async function save() {\n    const {view, result: world} = await waitReady();\n    const reply = exact().gpu.handle({op: 'screenshot', id: view, form: 'save'}, null, value => value);\n    if (!reply?.data) throw new Error(reply?.error ?? 'Exact surface did not provide a save');\n    localStorage.setItem(STORAGE_KEY, reply.data);\n    adapterEvents.push({type: 'save', tick: world.tick});\n    return {saved: true};\n  }\n  async function load() {\n    const encoded = localStorage.getItem(STORAGE_KEY);\n    if (!encoded) return {loaded: false};\n    const {view, result: world} = await waitReady();\n    await releaseInput();\n    const args = world.args ?? {};\n    if (typeof args.scene !== 'string' || !args.scene) throw new Error('Load needs the retained baked scene construction argument');\n    exact().worldCarry = decode(encoded);\n    exact().gpu.destroy(view);\n    exact().gpu.surface(view, 'world', [\n      args.seed ?? 1041003, true, false, args.round ?? 0,\n      args.jump_press ?? 0, args.light_press ?? 0, args.sound ?? true, args.scene,\n    ]);\n    await waitReady();\n    const loaded = await state();\n    adapterEvents.push({type: 'load', tick: loaded.ticks});\n    return loaded;\n  }\n  async function pause() {\n    const current = await state();\n    if (!['playing', 'paused'].includes(current.phase)) return current;\n    const button = await viewByTestId(current.phase === 'paused' ? 'resume' : 'pause');\n    if (!button) throw new Error('Pause action is unavailable');\n    button.click();\n    await Promise.resolve();\n    return state();\n  }\n\n  globalThis.lanterns = {\n    async command(request = {}) {\n      switch (request.op) {\n        case 'ready': {\n          const result = await readyState();\n          return result ? {ready: true, engine: 'exact', version: '1041.003'} : {ready: false};\n        }\n        case 'state': return state();\n        case 'start': return restart(true);\n        case 'reset': return restart(false);\n        case 'input': await setInput(request); return state();\n        case 'step': {\n          const ticks = Math.max(0, Math.trunc(Number(request.ticks) || 0));\n          const before = await state();\n          if (ticks && before.phase === 'playing') {\n            const {view} = await waitReady();\n            surface(view, {op: 'clock', ticks});\n          }\n          return state();\n        }\n        case 'pause': return pause();\n        case 'save': return save();\n        case 'load': return load();\n        default: throw new Error(`Unknown Lanterns command: ${request.op}`);\n      }\n    },\n  };\n}\ngame/games/lanterns/app.contract:7:  phase: string\ngame/games/lanterns/app.contract:83:          when hud.phase == \"won\"\ngame/games/lanterns/app.contract:84:            column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\ngame/games/lanterns/app.contract:89:          when hud.phase == \"lost\"\ngame/games/lanterns/logic/src/lib.rs:61:pub struct Session {\ngame/games/lanterns/logic/src/lib.rs:65:    pub phase: u32,\ngame/games/lanterns/logic/src/lib.rs:78:    const SAVE_VERSION: u32 = 2;\ngame/games/lanterns/logic/src/lib.rs:102:        world.register_audio().register_resource::<Session>();\ngame/games/lanterns/logic/src/lib.rs:103:        world.insert_resource(Session {\ngame/games/lanterns/logic/src/lib.rs:104:            phase: u32::from(args.started),\ngame/games/lanterns/logic/src/lib.rs:107:            ..Session::default()\ngame/games/lanterns/logic/src/lib.rs:202:            let mut session = world.resource_mut::<Session>();\ngame/games/lanterns/logic/src/lib.rs:203:            if session.phase == 0 && args.started {\ngame/games/lanterns/logic/src/lib.rs:204:                session.phase = 1;\ngame/games/lanterns/logic/src/lib.rs:210:            (session.phase >= 2, jump, light)\ngame/games/lanterns/logic/src/lib.rs:215:            return;\ngame/games/lanterns/logic/src/lib.rs:217:        world.resource_mut::<Session>().elapsed += 1;\ngame/games/lanterns/logic/src/lib.rs:246:        let elapsed = world.resource::<Session>().elapsed;\ngame/games/lanterns/logic/src/lib.rs:248:            world.resource_mut::<Session>().phase = 3;\ngame/games/lanterns/logic/src/lib.rs:463:    let Some(entity) = nearest else { return };\ngame/games/lanterns/logic/src/lib.rs:480:        world.resource_mut::<Session>().phase = 2;\ngame/games/lanterns/logic/src/lib.rs:481:        world.log(\"all lanterns lit\");\ngame/games/lanterns/logic/src/lib.rs:500:   