h(\"returnHome\", returning_home);\n     world.publish(\"assetReady\", true);\n }\n \ndiff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs\nindex 7f55422..ef9f1ca 100644\n--- a/game/games/lanterns/logic/tests/capture.rs\n+++ b/game/games/lanterns/logic/tests/capture.rs\n@@ -69,7 +69,7 @@ fn land(sim: &mut Sim<Lanterns>, floor: f32) {\n     panic!(\"landing failed at {:?}\", sim.position(\"player\"));\n }\n #[test]\n-fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n+fn crate_checkpoint_returns_home_twice_and_restores_both_states() {\n     let mut sim = Sim::<Lanterns>::new(Options {\n         seed: 1_041_003,\n         started: true,\n@@ -129,7 +129,8 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n     steer(&mut sim, 10.0, 8.0, 0.18);\n     press(&mut sim, \"light_press\");\n     ticks(&mut sim, 2);\n-    assert_eq!(sim.world().resource::<Session>().phase, 2);\n+    assert_eq!(sim.world().resource::<Session>().phase, 1);\n+    assert!(sim.world().resource::<Session>().returning_home);\n     assert_eq!(\n         sim.world()\n             .query::<&Lantern>()\n@@ -138,6 +139,22 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             .count(),\n         12\n     );\n+    let intermediate_elapsed = sim.world().resource::<Session>().elapsed;\n+    let intermediate = sim.save();\n+    let intermediate_restored = Sim::<Lanterns>::from_save(&intermediate).unwrap();\n+    assert_eq!(\n+        intermediate_restored.world().resource::<Session>().elapsed,\n+        intermediate_elapsed\n+    );\n+    assert_eq!(intermediate_restored.world().resource::<Session>().phase, 1);\n+    assert!(\n+        intermediate_restored\n+            .world()\n+            .resource::<Session>()\n+            .returning_home\n+    );\n+    steer(&mut sim, 1.9, 12.0, 0.18);\n+    assert_eq!(sim.world().resource::<Session>().phase, 2);\n     let hash = sim.worl