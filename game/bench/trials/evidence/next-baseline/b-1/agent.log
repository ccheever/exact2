ection * 4.5);\n   236\t        physics::step(world);\n   237\t        if jumped {\n   238\t            world.log(\"jump\");\n   239\t            if args.sound {\n   240\t                world.play(\"jump\").at(player).start();\n   241\t            }\n   242\t        }\n   243\t        update_player(world, direction, args.sound);\n   244\t        if light_button || input.pressed(\"light\") {\n   245\t            light_nearest(world, args.sound);\n   246\t        }\n   247\t        update_lanterns(world);\n   248\t        finish_at_home(world);\n   249\t        let elapsed = world.resource::<Session>().elapsed;\n   250\t        if elapsed >= DURATION_TICKS {\n   251\t            world.resource_mut::<Session>().phase = 3;\n   252\t            world.log(\"night fell\");\n   253\t            if args.sound {\n   254\t                world.play(\"night\").start();\n   255\t            }\n   256\t        }\n   257\t        update_sun(world);\n   258\t        scene::follow(world);\n   470\t        lantern.glow.set_target(world.now(), 1.0);\n   471\t    }\n   472\t    let name = world.name(entity).unwrap().to_owned();\n   473\t    world.log(format_args!(\"{name} lit\"));\n   474\t    if sound {\n   475\t        world.play(\"chime\").at(entity).start();\n   476\t    }\n   477\t    let count = world\n   478\t        .query::<&Lantern>()\n   479\t        .iter()\n   480\t        .filter(|(_, l)| l.lit)\n   481\t        .count();\n   482\t    if count == world.query::<&Lantern>().iter().count() {\n   483\t        world.resource_mut::<Session>().returning_home = true;\n   484\t        world.log(\"all lanterns lit\");\n   485\t    }\n   486\t}\n   487\t\n   488\tfn finish_at_home(world: &mut World) {\n   489\t    if !world.resource::<Session>().returning_home {\n   490\t        return;\n   491\t    }\n   492\t    let at = world.get::<Transform>(\"player\").unwrap().position;\n   493\t    let distance = Vec2::new(at.x - SPAWN.x, at.z - SPAWN.z).length();\n   494\t    if distance <=