diff --git a/game/games/lanterns/README.md b/game/games/lanterns/README.md
index 98f1be5..dc285bb 100644
--- a/game/games/lanterns/README.md
+++ b/game/games/lanterns/README.md
@@ -2,8 +2,9 @@
 
 A three-minute third-person game built on Exact's game add-on. Move the animated
 Fox with WASD, arrows, or the left side of a touch screen. Jump with Space or the
-purple button and press E or LIGHT within 1.5 metres of a lantern. Push the crate
-to reach the twelfth lantern on the ledge.
+purple button and press E or LIGHT within 1.5 metres of a lantern. Jump onto the
+west platform for the thirteenth lantern, and push the crate to reach the twelfth
+lantern on the ledge.
 
 From the repository root:
 
@@ -25,7 +26,7 @@ used by the independent comparison harness. It is inert unless the URL contains
 `?agent=1`; the adapter sends platform input into the real Exact surface, advances
 Exact's owned clock, and persists the surface's public save carrier in localStorage.
 
-Initial terrain and the twelve-lantern roster live in `scene.json`; repeated lantern
+Initial terrain and the thirteen-lantern roster live in `scene.json`; repeated lantern
 parts live in `lantern.fragment.json`. Run `bun game/dev.mjs lanterns --scene-only`
 after content edits, or add `--reuse-baker` to skip Cargo completely once the typed
 baker exists. Rust behavior remains unchanged. Restart uses the new content;
diff --git a/game/games/lanterns/app.contract b/game/games/lanterns/app.contract
index 8f0bde0..978acf8 100644
--- a/game/games/lanterns/app.contract
+++ b/game/games/lanterns/app.contract
@@ -83,19 +83,19 @@ component Lanterns
           when hud.phase == "won"
             column testId="victory" position="absolute" top="28%" left="24%" width="52%" padding=30 align-items="center" gap=18 border-radius=14 background-color="#1b1730"
               text "The island is glowing" aria-live="polite" font-size=34 color="#ffd27a" font-weight=700
-              text "All twelve lanterns are lit." font-size=18 color="#fff4d6"
+              text "All thirteen lanterns are lit." font-size=18 color="#fff4d6"
               button press=restart testId="again" padding=16 border-radius=9 background-color="#ffd27a"
                 text "Play again" font-size=19 color="#241531"
           when hud.phase == "lost"
             column testId="lost" position="absolute" top="28%" left="24%" width="52%" padding=30 align-items="center" gap=18 border-radius=14 background-color="#1b1730"
               text "Night fell" aria-live="polite" font-size=34 color="#ffd27a" font-weight=700
-              text `You lit ${hud.count} of 12 lanterns.` font-size=18 color="#fff4d6"
+              text `You lit ${hud.count} of ${hud.total} lanterns.` font-size=18 color="#fff4d6"
               button press=restart testId="retry" padding=16 border-radius=9 background-color="#ffd27a"
                 text "Try again" font-size=19 color="#241531"
         else
           column testId="title" position="absolute" top=0 left=0 width="100%" height="100%" align-items="center" justify-content="center" gap=24 background-color="#130f24"
             text "LANTERNS" font-size=64 font-weight=700 color="#ffd27a"
-            text "Light twelve lanterns before the last three minutes of dusk run out." font-size=20 color="#fff4d6"
+            text "Light thirteen lanterns before the last three minutes of dusk run out." font-size=20 color="#fff4d6"
             text "Push the crate to reach the lantern on the stone ledge." font-size=17 color="#d6cdec"
             text "WASD or arrows · Space to jump · E to light" font-size=15 color="#a99fc1"
             row gap=12
