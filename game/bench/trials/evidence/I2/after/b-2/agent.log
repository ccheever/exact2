 2, jump, light)\n+            (matches!(session.phase, PHASE_WON | PHASE_LOST), jump, light)\n         });\n         if terminal {\n             publish(world);\n@@ -285,11 +291,14 @@ impl Game for Lanterns {\n         update_lanterns(world);\n         let elapsed = world.resource::<Session>().elapsed;\n         if elapsed >= DURATION_TICKS {\n-            world.resource_mut::<Session>().phase = 3;\n+            world.resource_mut::<Session>().phase = PHASE_LOST;\n             world.log(\"night fell\");\n             if args.sound {\n                 world.play(\"night\").start();\n             }\n+        } else if let Err(error) = finish_if_home(world, args.sound) {\n+            world.log(error);\n+            return;\n         }\n         update_sun(world, ids.sun);\n         scene::follow(world);\n@@ -490,12 +499,30 @@ fn light_nearest(world: &mut World, sound: bool) -> Result<(), exact_game::KindE\n         world.play(\"chime\").at(entity.entity()).start();\n     }\n     if world.rows::<Lamp>().all(|row| row.lantern.lit) {\n-        world.resource_mut::<Session>().phase = 2;\n+        world.resource_mut::<Session>().phase = PHASE_RETURNING;\n         world.log(\"all lanterns lit\");\n     }\n     Ok(())\n }\n \n+fn finish_if_home(world: &mut World, sound: bool) -> Result<(), exact_game::KindError> {\n+    if world.resource::<Session>().phase != PHASE_RETURNING {\n+        return Ok(());\n+    }\n+    let hero = world.resource::<Session>().actors.hero;\n+    let position = world.row(hero)?.transform.position;\n+    let from_home = Vec2::new(position.x - SPAWN.x, position.z - SPAWN.z);\n+    if from_home.length_squared() > HOME_RADIUS * HOME_RADIUS {\n+        return Ok(());\n+    }\n+    world.resource_mut::<Session>().phase = PHASE_WON;\n+    world.log(\"returned home\");\n+    if sound {\n+        world.play(\"chime\").at(hero.entity()).start();\n+    }\n+    Ok(())\n+}\n+\n fn update_lanterns(world: &mut World) {\n     let now = world.now();\n     for row in world.rows::<Lamp>() {\n@@ -524,9 +551,10 @@ fn publish(world: &mut World) {\n         .saturating_sub(world.resource::<Session>().elapsed)\n         .div_ceil(60);\n     let phase = match world.resource::<Session>().phase {\n-        0 => \"title\",\n-        1 => \"playing\",\n-        2 => \"won\",\n+        PHASE_TITLE => \"title\",\n+        PHASE_PLAYING => \"playing\",\n+        PHASE_RETURNING => \"returning\",\n+        PHASE_WON => \"won\",\n         _ => \"lost\",\n     };\n     world.publish(\"count\", count);\n@@ -603,7 +631,7 @@ mod tests {\n     fn no_input_loses_at_exactly_three_minutes() {\n         let mut sim = game();\n         sim.run(180_000.0);\n-        assert_eq!(sim.world().resource::<Session>().phase, 3);\n+        assert_eq!(sim.world().resource::<Session>().phase, PHASE_LOST);\n         assert_eq!(sim.world().resource::<Session>().elapsed, DURATION_TICKS);\n     }\n }\ndiff --git a/game/games/lanterns/logic/tests/capture.rs b/game/games/lanterns/logic/tests/capture.rs\nindex 7f55422..f7ffd08 100644\n--- a/game/games/lanterns/logic/tests/capture.rs\n+++ b/game/games/lanterns/logic/tests/capture.rs\n@@ -57,6 +57,35 @@ fn steer(sim: &mut Sim<Lanterns>, x: f32, z: f32, tolerance: f32) {\n         sim.position(\"player\")\n     );\n }\n+fn return_home(sim: &mut Sim<Lanterns>) {\n+    for _ in 0..240 {\n+        let phase = sim.world().resource::<Session>().phase;\n+        if phase == 4 {\n+            return;\n+        }\n+        assert_eq!(phase, 2, \"return journey entered phase {phase}\");\n+        let at = sim.position(\"player\").unwrap();\n+        let dx = -at.x;\n+        let dz = 12.0 - at.z;\n+        // Pass left of the signboard at (3, 10) before entering the clearing.\n+        let x_axis = (at.z < 10.6 && at.x > 1.0) || dx.abs() >= dz.abs();\n+        let gap = if x_axis { dx } else { dz };\n+        let key = if x_axis {\n+            if gap > 0.0 {\n+                \"KeyD\"\n+            } else {\n+                \"KeyA\"\n+            }\n+        } else if gap > 0.0 {\n+            \"KeyS\"\n+        } else {\n+            \"KeyW\"\n+        };\n+        hold(sim, key, 8);\n+        ticks(sim, 1);\n+    }\n+    panic!(\"return journey stalled at {:?}\", sim.position(\"player\"));\n+}\n fn land(sim: &mut Sim<Lanterns>, floor: f32) {\n     for _ in 0..72 {\n         if sim.world().get::<Character>(\"player\").unwrap().grounded\n@@ -69,7 +98,7 @@ fn land(sim: &mut Sim<Lanterns>, floor: f32) {\n     panic!(\"landing failed at {:?}\", sim.position(\"player\"));\n }\n #[test]\n-fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n+fn crate_checkpoint_requires_return_home_and_restores_both_new_states() {\n     let mut sim = Sim::<Lanterns>::new(Options {\n         seed: 1_041_003,\n         started: true,\n@@ -138,6 +167,28 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             .count(),\n         12\n     );\n+    let return_elapsed = sim.world().resource::<Session>().elapsed;\n+    let intermediate = sim.save();\n+    let mut timed_out = Sim::<Lanterns>::from_save(&intermediate).unwrap();\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 2);\n+    assert_eq!(\n+        timed_out.world().resource::<Session>().elapsed,\n+        return_elapsed\n+    );\n+    ticks(&mut timed_out, 30);\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 2);\n+    assert_eq!(\n+        timed_out.world().resource::<Session>().elapsed,\n+        return_elapsed + 30\n+    );\n+    ticks(&mut timed_out, 180 * 60 - return_elapsed - 30);\n+    assert_eq!(timed_out.world().resource::<Session>().phase, 3);\n+\n+    return_home(&mut sim);\n+    let home = sim.position(\"player\").unwrap();\n+    assert!(home.x.hypot(home.z - 12.0) <= 2.0, \"{home:?}\");\n+    assert_eq!(sim.world().resource::<Session>().phase, 4);\n+    assert!(sim.world().resource::<Session>().elapsed > return_elapsed);\n     let hash = sim.world().hash();\n     let capture = Capture::from_bytes(&sim.stop_capture().unwrap().to_bytes()).unwrap();\n     for _ in 0..2 {\n@@ -145,17 +196,10 @@ fn crate_checkpoint_finishes_route_twice_and_restores_terminal_state() {\n             Sim::<Lanterns>::replay_capture(&capture, \"test-executable:lanterns-route\", None)\n                 .unwrap();\n         assert_eq!(replay.world().hash(), hash);\n-        assert_eq!(replay.world().resource::<Session>().phase, 2);\n+        assert_eq!(replay.world().resource::<Session>().phase, 4);\n     }\n     let terminal = sim.save();\n     let restored = Sim::<Lanterns>::from_save(&terminal).unwrap();\n     assert_eq!(restored.world().hash(), hash);\n-    sim.start_capture(\"test-executable:lanterns-route\", CaptureLimits::default())\n-        .unwrap();\n-    ticks(&mut sim, 10);\n-    let terminal_capture = sim.stop_capture().unwrap();\n-    let replay =\n-        Sim::<Lanterns>::replay_capture(terminal_capture, \"test-executable:lanterns-route\", None)\n-            .unwrap();\n-    assert_eq!(replay.world().resource::<Session>().phase, 2);\n+    assert_eq!(restored.world().resource::<Session>().phase, 4);\n }\n","exit_code":0,"status":"completed"}}
{"type":"item.completed","item":{"id":"item_30","type":"agent_message","text":"The final audit found one adapter-specific gap: its existing inspection `step` and `pause` commands only recognized `\"playing\"`, so an external ordinary-input route could stop advancing or fail to pause during `\"returning\"` even though the game itself continued correctly. I’m keeping the command names unchanged and extending those existing checks to treat the return journey as active play."}}
