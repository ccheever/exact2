tId=\"save-status\" padding=10 border-radius=9 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          text \"Move: WASD / arrows / left thumb\" position=\"absolute\" bottom=22 left=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#d6cdec\" font-size=15\n          text \"Push the crate beside the high ledge. Jump onto it, then jump again.\" testId=\"sign-instruction\" position=\"absolute\" bottom=76 left=22 right=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n          row position=\"absolute\" bottom=22 right=22 gap=14 align-items=\"flex-end\"\n            button press=light testId=\"light\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#ffb43b\" justify-content=\"center\" align-items=\"center\"\n              text \"LIGHT\" width=\"100%\" text-align=\"center\" color=\"#241531\" font-size=17 font-weight=700\n            button press=jump testId=\"jump\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#a78cff\" justify-content=\"center\" align-items=\"center\"\n              text \"JUMP\" width=\"100%\" text-align=\"center\" color=\"#171126\" font-size=17 font-weight=700\n          when paused\n            column testId=\"paused\" position=\"absolute\" top=\"34%\" left=\"30%\" width=\"40%\" padding=26 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Paused\" font-size=34 font-weight=700 color=\"#ffd27a\"\n              text \"Your 180 seconds are frozen.\" font-size=17 color=\"#d6cdec\"\n              button press=togglePause testId=\"resume\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Resume\" font-size=19 color=\"#241531\"\n          when hud.phase == \"won\"\n            column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"The island is glowing\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"again\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Play again\" font-size=19 color=\"#241531\"\n          when hud.phase == \"lost\"\n            column testId=\"lost\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n              text \"Night fell\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n              text `You lit ${hud.count} of 12 lanterns.` font-size=18 color=\"#fff4d6\"\n              button press=restart testId=\"retry\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                text \"Try again\" font-size=19 color=\"#241531\"\n        else\n          column testId=\"title\" position=\"absolute\" top=0 left=0 width=\"100%\" height=\"100%\" align-items=\"center\" justify-content=\"center\" gap=24 background-color=\"#130f24\"\n            text \"LANTERNS\" font-size=64 font-weight=700 color=\"#ffd27a\"\n            text \"Light twelve lanterns before the last three minutes of dusk run out.\" font-size=20 color=\"#fff4d6\"\n            text \"Push the crate to reach the lantern on the stone ledge.\" font-size=17 color=\"#d6cdec\"\n            text \"WASD or arrows · Space to jump · E to light\" font-size=15 color=\"#a99fc1\"\n            row gap=12\n              button press=play autofocus testId=\"play\" padding=18 border-radius=10 background-color=\"#ffd27a\"\n                text \"Play\" font-size=22 font-weight=700 color=\"#241531\"\n              button press=loadGame testId=\"title-load\" padding=18 border-radius=10 background-color=\"#1b1730\"\n                text \"Load save\" font-size=22 font-weight=700 color=\"#ffd27a\"\n            when checkpointStatus != \"\"\n              text checkpointStatus aria-live=\"polite\" testId=\"title-save-status\" color=\"#ffd27a\" font-size=15\n{\n  \"$schema\": \"../../../scripts/app.schema.json\",\n  \"name\": \"Lanterns Exact\",\n  \"short_name\": \"Lanterns\",\n  \"id\": \"com.exact.lanterns.exact\",\n  \"start_url\": \"/\",\n  \"display\": \"standalone\",\n  \"theme_color\": \"#130f24\",\n  \"background_color\": \"#130f24\",\n  \"app\": { \"id\": \"com.exact.lanterns.exact\", \"name\": \"Lanterns Exact\" },\n  \"host\": {\n    \"macos\": { \"minimumOS\": \"14.0\", \"window\": { \"width\": 1280, \"height\": 720 } },\n    \"ios\": { \"minimumOS\": \"17.0\", \"deviceFamily\": [\"iphone\", \"ipad\"] },\n    \"web\": {}\n  },\n  \"game\": { \"crate\": \"lanterns-logic\", \"type\": \"Lanterns\" },\n  \"rust\": false,\n  \"deploy\": { \"store\": { \"web\": \"0\", \"macos\": \"0\", \"ios\": \"0\", \"linux\": \"0\" } }\n}\n#!/bin/sh\nset -eu\nexport EXACT_UPDATE_TRUST=development\nAPP_DIR=$(CDPATH= cd -- \"$(dirname -- \"$0\")\" && pwd)\nexport EXACT_APP_DIR=\"$APP_DIR\"\nexport CARGO_TARGET_DIR=\"$APP_DIR/target\"\nexport EXACT_WEB_DIST=\"$APP_DIR/dist\"\ncd \"$APP_DIR/../../..\"\ncase \"${1:-proof}\" in\n  proof) exec bun \"$APP_DIR/proof.mjs\" web ;;\n  build-web) exec bun \"$APP_DIR/build-web.mjs\" ;;\n  test) exec cargo test --manifest-path game/Cargo.toml --locked --offline -p lanterns-logic ;;\n  dev) exec bun game/dev.mjs lanterns ;;\n  macos) exec bun host/apple/build.mjs --run ;;\n  ios) exec bun host/apple/build.mjs --ios --device ;;\n  *) echo 'Usage: sh game/games/lanterns/run.sh [proof|test|build-web|dev|macos|ios]' >&2; exit 2 ;;\nesac\n[package]\nname = \"lanterns-logic\"\nversion.workspace = true\nedition.workspace = true\nlicense.workspace = true\n\n[dependencies]\nexact-game.workspace = true\nexact-game-physics.workspace = true\nexact-game-scene.workspace = true\n","exit_code":0,"status":"completed"}}
