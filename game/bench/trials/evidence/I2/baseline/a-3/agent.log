         1\n          ],\n          \"roughness\": 0.85\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  2.0,\n                  1.2,\n                  2.0\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"wall\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          -4,\n          1,\n          5\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              1,\n              2,\n              5\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.31,\n            0.29,\n            0.34,\n            1\n          ],\n          \"roughness\": 0.88\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  0.5,\n                  1.0,\n                  2.5\n                ]\n              }\n            }\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"crate\",\n      \"fragment\": \"solid\",\n      \"parameters\": {\n        \"position\": [\n          6,\n          0.6,\n          8\n        ],\n        \"mesh\": {\n          \"Box\": {\n            \"size\": [\n              1.2,\n              1.2,\n              1.2\n            ]\n          }\n        },\n        \"material\": {\n          \"color\": [\n            0.45,\n            0.24,\n            0.09,\n            1\n          ],\n          \"roughness\": 0.78\n        }\n      },\n      \"overrides\": {\n        \"\": {\n          \"Collider\": {\n            \"shape\": {\n              \"Box\": {\n                \"half\": [\n                  0.6,\n                  0.6,\n                  0.6\n                ]\n              }\n            }\n          },\n          \"Body\": {\n            \"kind\": {\n              \"Dynamic\": {}\n            },\n            \"mass\": 3,\n            \"damping\": 0.45,\n            \"spin_damping\": 8\n          }\n        }\n      }\n    },\n    {\n      \"id\": \"lantern-1\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -12,\n          0,\n          10\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-2\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -10,\n          0,\n          2\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-3\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -12,\n          0,\n          -8\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-4\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          -6,\n          0,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-5\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          -10\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-6\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          6,\n          0,\n          -12\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-7\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          12,\n          0,\n          -8\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-8\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          12,\n          0,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-9\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          5,\n          0,\n          2\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-10\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          0\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-11\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          0,\n          0,\n          7\n        ]\n      }\n    },\n    {\n      \"id\": \"lantern-12\",\n      \"fragment\": \"lantern\",\n      \"parameters\": {\n        \"position\": [\n          10,\n          2.4,\n          8\n        ]\n      }\n    }\n  ]\n}\n{\n  \"units\": \"metres-y-up\",\n  \"parameters\": [\n    \"position\"\n  ],\n  \"entities\": [\n    {\n      \"id\": \"\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": {\n            \"$param\": \"position\"\n          }\n        },\n        \"Lantern\": {}\n      }\n    },\n    {\n      \"id\": \"post\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            0.675,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Cylinder\": {\n            \"radius\": 0.06,\n            \"height\": 1.35\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.12,\n            0.08,\n            0.06,\n            1\n          ],\n          \"metallic\": 0.35,\n          \"roughness\": 0.7\n        }\n      }\n    },\n    {\n      \"id\": \"cap\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            1.42,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Cylinder\": {\n            \"radius\": 0.24,\n            \"height\": 0.12\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.12,\n            0.08,\n            0.06,\n            1\n          ],\n          \"metallic\": 0.35,\n          \"roughness\": 0.7\n        }\n      }\n    },\n    {\n      \"id\": \"bulb\",\n      \"parent\": \"$root\",\n      \"components\": {\n        \"Transform\": {\n          \"position\": [\n            0,\n            1.16,\n            0\n          ]\n        },\n        \"Mesh\": {\n          \"Sphere\": {\n            \"radius\": 0.19\n          }\n        },\n        \"Material\": {\n          \"color\": [\n            0.18,\n            0.16,\n            0.14,\n            1\n          ]\n        },\n        \"PointLight\": {\n          \"color\": [\n            1,\n            0.42,\n            0.08\n          ],\n          \"intensity\": 0,\n          \"range\": 7\n        }\n      }\n    }\n  ]\n}\nuse sceneContent from \"./.scene/scene.contract\"\n\nshape Hud\n  count: number\n  total: number\n  remaining: number\n  phase: string\n\ncomponent Lanterns\n  state started = false\n  state seed = 1041003\n  state paused = false\n  state round = 0\n  state jumpPress = 0\n  state lightPress = 0\n  state sound = true\n  state saveRequest = 0\n  state loadRequest = 0\n  state checkpointStatus = \"\"\n  resource hud = exactSurface(\"world\") as shape Hud\n\n  action play writes started\n    started = true\n  action togglePause writes paused\n    paused = not paused\n  action toggleSound writes sound\n    sound = not sound\n  action jump writes jumpPress\n    jumpPress = jumpPress + 1\n  action light writes lightPress\n    lightPress = lightPress + 1\n  action restart writes round, paused\n    round = round + 1\n    paused = false\n  action saveGame writes saveRequest, checkpointStatus\n    saveRequest = saveRequest + 1\n    checkpointStatus = \"Saving…\"\n  action loadGame writes loadRequest, checkpointStatus\n    loadRequest = loadRequest + 1\n    checkpointStatus = \"Loading…\"\n  action checkpoint(value: string) writes checkpointStatus, started\n    if value == \"surface-save:saved\"\n      checkpointStatus = \"Saved\"\n    if value == \"surface-load:loaded\"\n      checkpointStatus = \"Load