action is unavailable');\n     button.click();\n@@ -209,7 +209,7 @@ if (ENABLED) {\n         case 'step': {\n           const ticks = Math.max(0, Math.trunc(Number(request.ticks) || 0));\n           const before = await state();\n-          if (ticks && before.phase === 'playing') {\n+          if (ticks && ['playing', 'returning'].includes(before.phase)) {\n             const {view} = await waitReady();\n             surface(view, {op: 'clock', ticks});\n           }\ndiff --git a/game/games/lanterns/logic/src/lib.rs b/game/games/lanterns/logic/src/lib.rs\nindex 4d7e920..ed26bb9 100644\n--- a/game/games/lanterns/logic/src/lib.rs\n+++ b/game/games/lanterns/logic/src/lib.rs\n@@ -61,7 +61,7 @@ pub struct Lantern {\n pub struct Session {\n     /// Active fixed ticks; pause and terminal states do not add to this.\n     pub elapsed: u32,\n-    /// 0 title, 1 playing, 2 won, 3 lost.\n+    /// 0 title, 1 active (lighting or returning), 2 won, 3 lost.\n     pub phase: u32,\n     /// Last Contract Jump counter consumed.\n     pub jump_press: u32,\n@@ -250,6 +250,9 @@ impl Game for Lanterns {\n             if args.sound {\n                 world.play(\"night\").start();\n             }\n+        } else if all_lanterns_lit(world) && player_is_home(world) {\n+            world.resource_mut::<Session>().phase = 2;\n+            world.log(\"returned home\");\n         }\n         update_sun(world);\n         scene::follow(world);\n@@ -471,17 +474,21 @@ fn light_nearest(world: &mut World, sound: bool) {\n     if sound {\n         world.play(\"chime\").at(entity).start();\n     }\n-    let count = world\n-        .query::<&Lantern>()\n-        .iter()\n-        .filter(|(_, l)| l.lit)\n-        .count();\n-    if count == world.query::<&Lantern>().iter().count() {\n-        world.resource_mut::<Session>().phase = 2;\n+    if all_lanterns_lit(world) {\n         world.log(\"all lanterns lit\");\n     }\n }\n \n+fn all_lanterns_lit(world: &World) -> bool {\n+    let mut lanterns = world.query::<&Lantern>().iter();\n+    lanterns.next().is_some() && lanterns.all(|(_, lantern)| lantern.lit)\n+}\n+\n+fn player_is_home(world: &World) -> bool {\n+    let at = world.get::<Transform>(\"player\").unwrap().position;\n+    Vec2::new(at.x - SPAWN.x, at.z - SPAWN.z).length_squared() <= 2.0 * 2.0\n+}\n+\n fn update_lanterns(world: &mut World) {\n     let now = world.now();\n     let rows: Vec<_> = world\n@@ -514,6 +521,7 @@ fn publish(world: &mut World) {\n     let remaining = DURATION_TICKS.saturating_sub(session.elapsed).div_ceil(60);\n     let phase = match session.phase {\n         0 => \"title\",\n+        1 if count == world.query::<&Lantern>().iter().count() as u32 => \"returning\",\n         1 => \"playing\",\n         2 => \"won\",\n         _ => \"lost\",\n","exit_code":0,"status":"completed"}}
