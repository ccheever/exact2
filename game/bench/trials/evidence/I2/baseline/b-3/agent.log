home\" position=\"absolute\" bottom=76 left=22 right=22 padding=14 border-radius=10 background-color=\"#ffd27a\" color=\"#241531\" font-size=18 font-weight=700 text-align=\"center\"\n+          when hud.phase != \"returning\"\n+            text \"Push the crate beside the high ledge. Jump onto it, then jump again.\" testId=\"sign-instruction\" position=\"absolute\" bottom=76 left=22 right=22 padding=12 border-radius=10 background-color=\"#1b1730\" color=\"#ffd27a\" font-size=14\n           row position=\"absolute\" bottom=22 right=22 gap=14 align-items=\"flex-end\"\n             button press=light testId=\"light\" width=92 height=92 display=\"flex\" border-radius=46 background-color=\"#ffb43b\" justify-content=\"center\" align-items=\"center\"\n               text \"LIGHT\" width=\"100%\" text-align=\"center\" color=\"#241531\" font-size=17 font-weight=700\n@@ -83,7 +86,7 @@ component Lanterns\n           when hud.phase == \"won\"\n             column testId=\"victory\" position=\"absolute\" top=\"28%\" left=\"24%\" width=\"52%\" padding=30 align-items=\"center\" gap=18 border-radius=14 background-color=\"#1b1730\"\n               text \"The island is glowing\" aria-live=\"polite\" font-size=34 color=\"#ffd27a\" font-weight=700\n-              text \"All twelve lanterns are lit.\" font-size=18 color=\"#fff4d6\"\n+              text \"All twelve lanterns are lit, and the fox made it home.\" font-size=18 color=\"#fff4d6\"\n               button press=restart testId=\"again\" padding=16 border-radius=9 background-color=\"#ffd27a\"\n                 text \"Play again\" font-size=19 color=\"#241531\"\n           when hud.phase == \"lost\"\n@@ -95,7 +98,7 @@ component Lanterns\n         else\n           column testId=\"title\" position=\"absolute\" top=0 left=0 width=\"100%\" height=\"100%\" align-items=\"center\" justify-content=\"center\" gap=24 background-color=\"#130f24\"\n             text \"LANTERNS\" font-size=64 font-weight=700 color=\"#ffd27a\"\n-            text