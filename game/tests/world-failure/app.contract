shape Hud
  ticks: number

component Failure
  state clicks = 0
  state restart = false
  resource hud = exactSurface("world") as shape Hud
  action click writes clicks
    clicks = clicks + 1
  action reset writes restart
    restart = !restart
  view
    column width="100%" height="100%"
      canvas surface=world(restart=restart) testId="world" width=300 height=100
        text `Tick ${hud.ticks}` testId="ticks"
      button testId="alive" press=click
        text `Clicks ${clicks}`
      button testId="restart" press=reset
        text "Restart"
