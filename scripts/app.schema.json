{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exact2/app.json",
  "title": "The app manifest (LLP 1030 D2, 1030.000 D7): the W3C Web App Manifest's own keys, plus `app` (identity), `host.<platform>` (host metadata bake generates per platform), and `deploy` (policy, never identity).",
  "type": "object",
  "required": [
    "name",
    "app"
  ],
  "properties": {
    "modules": {
      "type": "array",
      "description": "The native-module roster (LLP 1024 D1): the custom-element tags the app's module artifact serves (modules/apple/*.swift beside libexact_modules.dylib on Apple, modules/web/index.js on the web). A hyphenated tag in the Contract that this list lacks is bake-unknown-module.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(-[a-z][a-z0-9_]*)+$"
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "shaderRoots": {
          "type": "array",
          "description": "Additional flat WGSL directories relative to app.json; duplicate stems and symlinks are refused.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "shaderPreludes": {
          "type": "object",
          "description": "Ordered WGSL library paths relative to app.json, prepended to the named shader stem before reflection and packaging.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "modules": {
          "type": "object",
          "description": "GPU artifacts beside the primary <app>-gpu (LLP 1009 D6): module name -> the surface names it registers. Module m is the crate <app>-gpu-m, loaded the first time a canvas of one of its surfaces is on screen; every other surface is the primary's.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          }
        }
      }
    },
    "game": {
      "type": "object",
      "description": "Generate the game's GPU, web and Apple shells from the logic package and Game type.",
      "required": ["crate", "type"],
      "additionalProperties": false,
      "properties": {
        "audio": { "type": "boolean" },
        "assets": { "type": "boolean" },
        "crate": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-logic$" },
        "data": {
          "type": "object",
          "description": "An optional linked Rust DataSource in the app's data/ crate, constructed with Default and wrapped by host storage.",
          "required": ["crate", "type"],
          "additionalProperties": false,
          "properties": {
            "crate": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*-data$" },
            "type": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" }
          }
        },
        "type": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?:::[A-Za-z_][A-Za-z0-9_]*)*$" }
      }
    },
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "short_name": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "start_url": {
      "type": "string"
    },
    "display": {
      "type": "string",
      "enum": [
        "fullscreen",
        "standalone",
        "minimal-ui",
        "browser"
      ]
    },
    "theme_color": {
      "type": "string"
    },
    "background_color_dark": {
      "type": "string",
      "description": "The dark first-frame background beside background_color, used by the web page and iOS launch screen."
    },
    "background_color": {
      "type": "string"
    },
    "lang": {
      "description": "The W3C manifest's language: a BCP 47 tag for the page's <html lang> and the web manifest. Absent is en.",
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$"
    },
    "icons": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "src"
        ],
        "properties": {
          "src": {
            "type": "string"
          },
          "sizes": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "file_handlers": {
      "type": "array",
      "description": "The W3C Web App Manifest's file handling declaration: what this app opens. The Apple bake derives `CFBundleDocumentTypes` from it (LLP 1033 D1), and a browser reads the same key.",
      "items": {
        "type": "object",
        "required": [
          "action",
          "accept"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "accept": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "additionalProperties": false
      }
    },
    "launch_handler": {
      "type": "object",
      "description": "The W3C Web App Manifest's launch handler: where a launch or an opened document lands. `navigate-new` opens each document in its own window with its own session (LLP 1069.010 D4); `navigate-existing`, the default, delivers it to the window in front; `focus-existing` brings that window forward and delivers nothing to a window already showing a document.",
      "properties": {
        "client_mode": {
          "oneOf": [
            { "enum": ["auto", "navigate-new", "navigate-existing", "focus-existing"] },
            { "type": "array", "items": { "enum": ["auto", "navigate-new", "navigate-existing", "focus-existing"] } }
          ]
        }
      },
      "additionalProperties": false
    },
    "app": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][a-zA-Z0-9-]*(\\.[a-zA-Z][a-zA-Z0-9-]*)+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "origin": {
          "type": "string",
          "pattern": "^https?://"
        },
        "command": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$",
          "description": "The name this app answers to on the command line: `exact install <app>` writes a shim by this name (LLP 1033 D2). Default: the app directory's name."
        }
      },
      "additionalProperties": false
    },
    "host": {
      "type": "object",
      "properties": {
        "ios": {
          "type": "object",
          "properties": {
            "minimumOS": {
              "type": "string"
            },
        "link": {
          "type": "array",
          "description": "Linker arguments for the app's native-module artifact (LLP 1024), one argument each, for what an archive in modules/apple/*.xcframework needs but cannot declare, such as -lc++.",
          "items": {
            "type": "string"
          }
        },
            "deviceFamily": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "iphone",
                  "ipad"
                ]
              }
            },
            "localNetworking": {
              "type": [
                "string",
                "boolean"
              ]
            },
            "backgroundModes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "associatedDomains": {
              "oneOf": [
                { "type": "boolean" },
                { "type": "array", "items": { "type": "string" } }
              ]
            },
            "urlSchemes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "team": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "macos": {
          "type": "object",
          "properties": {
            "minimumOS": {
              "type": "string"
            },
            "designRequiresCompatibility": {
              "type": "boolean",
              "description": "Draw AppKit in its design before macOS 26 (no Liquid Glass bezels or control metrics), as Apple's UIDesignRequiresCompatibility key did; macOS 27 ignores that key, so the link records the macOS 15 SDK, the last before the new design, and every AppKit behaviour keyed on a later SDK is off. App Store Connect requires uploads to be built with a recent SDK and reads the recorded one. Absent or false: the SDK the app is built with."
            },
        "link": {
          "type": "array",
          "description": "Linker arguments for the app's native-module artifact (LLP 1024), one argument each, for what an archive in modules/apple/*.xcframework needs but cannot declare, such as -lc++.",
          "items": {
            "type": "string"
          }
        },
            "team": {
              "type": "string"
            },
            "urlSchemes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "window": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                },
                "height": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                },
                "minWidth": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                },
                "minHeight": {
                  "type": "number",
                  "minimum": 1,
                  "maximum": 16384
                }
              },
              "required": [
                "width",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "linux": {
          "type": "object",
          "additionalProperties": false
        },
        "web": {
          "type": "object",
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "deploy": {
      "type": "object",
      "properties": {
        "origin": {
          "$ref": "#/$defs/cadence"
        },
        "bundles": {
          "$ref": "#/$defs/cadence"
        },
        "binaries": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cadenceOrOff"
          }
        },
        "release": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "automatic",
              "internal",
              "manual"
            ]
          }
        },
        "phased": {
          "type": "object",
          "additionalProperties": {
            "type": "boolean"
          }
        },
        "store": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "0",
              "A"
            ]
          }
        },
        "streams": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "channel",
              "compatibilityId"
            ],
            "properties": {
              "channel": {
                "type": "string"
              },
              "compatibilityId": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "channels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "activate": {
          "type": "string",
          "enum": [
            "next-launch",
            "app-decides"
          ]
        },
        "check": {
          "type": "object",
          "properties": {
            "background": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "sunset": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "message"
            ],
            "properties": {
              "message": {
                "type": "string"
              },
              "store": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "brownfield": {
          "type": "boolean"
        },
        "signing": {
          "type": "object",
          "properties": {
            "key": {
              "type": "string",
              "description": "The id of the key `exact deploy` signs with, by reference: the private key lives in the publisher's key directory (`EXACT_SIGNING_KEY_DIR`, default `~/.config/exact/keys/<id>.pem`), never here."
            },
            "keys": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              },
              "description": "Verification keys by id, each an Ed25519 public key as base64 of its 32 raw bytes; baked into the binary and part of the compatibility id (LLP 1026 D11; 1030 D3a)."
            }
          },
          "additionalProperties": false
        },
        "channel": {
          "type": "string",
          "description": "The channel this build bakes in (LLP 1030.000 D4): a key of `channels`. Default: the only key of `channels`, else \"prod\"."
        }
      },
      "additionalProperties": false
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "web": {
          "$ref": "#/$defs/installPlatform"
        },
        "ios": {
          "$ref": "#/$defs/installPlatform"
        },
        "macos": {
          "$ref": "#/$defs/installPlatform"
        }
      }
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "type": "string"
        },
        "wordmark": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string"
            },
            "text": {
              "type": "string"
            },
            "font": {
              "type": "string"
            },
            "weight": {
              "type": "number",
              "minimum": 100,
              "maximum": 900
            },
            "letterSpacing": {
              "type": "number",
              "minimum": -10,
              "maximum": 20
            }
          }
        }
      }
    },
    "rust": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/rustMode"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/rustMode"
            },
            "dev": {
              "$ref": "#/$defs/rustChoice"
            },
            "prod": {
              "$ref": "#/$defs/rustChoice"
            },
            "placement": {
              "$ref": "#/$defs/placement"
            },
            "platforms": {
              "type": "object",
              "properties": {
                "web": {
                  "$ref": "#/$defs/rustEnvironment"
                },
                "ios": {
                  "$ref": "#/$defs/rustEnvironment"
                },
                "macos": {
                  "$ref": "#/$defs/rustEnvironment"
                },
                "linux": {
                  "$ref": "#/$defs/rustEnvironment"
                },
                "android": {
                  "$ref": "#/$defs/rustEnvironment"
                },
                "windows": {
                  "$ref": "#/$defs/rustEnvironment"
                }
              },
              "additionalProperties": false
            },
            "module": {
              "type": "object",
              "properties": {
                "package": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9_-]+$"
                }
              },
              "required": [
                "package"
              ],
              "additionalProperties": false,
              "description": "The portable logic-wrapper cdylib package exporting the Exact logic ABI. One explicit replacement unit; data/helper crates remain ordinary Cargo dependencies."
            }
          },
          "additionalProperties": false
        }
      ],
      "description": "Rust live replacement, enabled by default in dev and prod. Resolve root, environment, platform, then platform environment. false/off removes replacement support at bake; true/auto uses browser Wasm, iOS Wasm interpreter, native desktop, Android native dev / Wasm prod. Android and Windows hosts remain future work."
    },
    "strings": {
      "type": "object",
      "description": "The UI's string tables (LLP 1060): strings/<locale>.json beside app.contract, read by `t(\"key\", name=value)`.",
      "additionalProperties": false,
      "properties": {
        "base": {
          "type": "string",
          "pattern": "^[A-Za-z]{2,8}(-[A-Za-z0-9]{1,8})*$",
          "description": "The locale every `t` is checked against and every other table falls back to; \"en\" when absent."
        }
      }
    },
    "auth": {
      "description": "Signing in through the system browser (LLP 1069.006): the scope the client-metadata documents name.",
      "type": "object",
      "properties": { "scope": { "type": "string" } },
      "additionalProperties": false
    },
    "typescript": {
      "type": "object",
      "properties": {
        "placement": {
          "$ref": "#/$defs/placement"
        },
        "sources": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Directories outside the app its TypeScript imports, by the name they take beside app.ts: {\"core\": \"../../src/core\"} makes ./core/model resolve to ../../src/core/model.ts. Captured with the app; a link of that name, for an editor, is allowed."
        },
        "platforms": {
          "type": "object",
          "properties": {
            "web": { "$ref": "#/$defs/placementPolicy" },
            "ios": { "$ref": "#/$defs/placementPolicy" },
            "macos": { "$ref": "#/$defs/placementPolicy" },
            "linux": { "$ref": "#/$defs/placementPolicy" },
            "android": { "$ref": "#/$defs/placementPolicy" },
            "windows": { "$ref": "#/$defs/placementPolicy" }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "description": "The TypeScript module's placement (LLP 1027.002), globally and per platform, and the directories it imports from outside the app."
    },
    "dev": {
      "type": "object",
      "properties": {
        "rebuild": {
          "type": "object",
          "properties": {
            "rust": {
              "type": "string",
              "enum": [
                "save",
                "manual"
              ]
            },
            "typescript": {
              "type": "string",
              "enum": [
                "save",
                "manual"
              ]
            }
          },
          "additionalProperties": false,
          "description": "Build trigger while the development watcher runs; save by default for both languages. Independent from replacement capability."
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "cadence": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "continuous",
            "manual"
          ]
        },
        {
          "type": "object",
          "required": [
            "schedule"
          ],
          "properties": {
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "cadenceOrOff": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "continuous",
            "manual",
            "off"
          ]
        },
        {
          "type": "object",
          "required": [
            "schedule"
          ],
          "properties": {
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "installPlatform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "methods"
      ],
      "properties": {
        "recommended": {
          "type": "string"
        },
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/installMethod"
          }
        },
        "urls": {
          "type": "array",
          "description": "Additional known web destinations, such as the public deployment URL. Web only.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "label",
              "url"
            ],
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "installMethod": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "url"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "browser",
            "go",
            "direct",
            "testflight",
            "app-store",
            "download",
            "terminal"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "setupUrl": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "rustMode": {
      "type": "string",
      "enum": [
        "auto",
        "native",
        "tiered",
        "wasm",
        "off"
      ]
    },
    "rustChoice": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/rustMode"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/rustMode"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "rustEnvironment": {
      "oneOf": [
        {
          "type": "boolean"
        },
        {
          "$ref": "#/$defs/rustMode"
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/rustMode"
            },
            "dev": {
              "$ref": "#/$defs/rustChoice"
            },
            "prod": {
              "$ref": "#/$defs/rustChoice"
            },
            "placement": {
              "$ref": "#/$defs/placement"
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "placement": {
      "type": "string",
      "enum": [
        "main",
        "worker"
      ],
      "description": "Where the module instance runs (LLP 1027.002 D1): on the runner's thread, or on an owner of its own. A change is a new compatibility id."
    },
    "placementPolicy": {
      "type": "object",
      "properties": {
        "placement": {
          "$ref": "#/$defs/placement"
        }
      },
      "additionalProperties": false
    }
  }
}
