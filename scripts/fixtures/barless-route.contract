// LLP 1130 D3: a route that says it has no bar (`navigationBar="none"`), in
// a stack that takes the whole view, whose first child is its scroller. The
// scroller runs under the status bar as a hand-built screen's table view
// does, its content starting below it (PageEdgesIOSTests).
routes nav
  start "/"

component BarlessRoute
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar="none" testId="route" position="absolute" inset=0 display="flex" flex-direction="column"
          scroll testId="list" flex=1 min-height=0
            text "list top" testId="list-top"
            column height=1600
