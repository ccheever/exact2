// LLP 1069.011: native buttons — every `buttonStyles` row with a title,
// then a symbol, a symbol and a title, a fixed width, a stretched one, a
// disabled one, an accent, and glass buttons in a glass group with a
// fading one. The platform draws each; the web draws its stated look.
component NativeButtons
  state presses = 0
  state fading = false
  action go writes presses
    presses = presses + 1
  action fade writes fading
    fading = not fading
  view
    column testId="native-buttons" padding=16 gap=10 background-color="light-dark(#ffffff, #000000)"
      text `presses ${presses}` testId="count"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="plain" press=go testId="plain"
          text "plain"
        button appearance="auto" buttonStyle="gray" press=go testId="gray"
          text "gray"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="tinted" press=go testId="tinted"
          text "tinted"
        button appearance="auto" buttonStyle="filled" press=go testId="filled"
          text "filled"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="borderless" press=go testId="borderless"
          text "borderless"
        button appearance="auto" buttonStyle="bordered" press=go testId="bordered"
          text "bordered"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="bordered-tinted" press=go testId="bordered-tinted"
          text "bordered-tinted"
        button appearance="auto" buttonStyle="bordered-prominent" press=go testId="bordered-prominent"
          text "bordered-prominent"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="glass" press=go testId="glass"
          text "glass"
        button appearance="auto" buttonStyle="prominent-glass" press=go testId="prominent-glass"
          text "prominent-glass"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="clear-glass" press=go testId="clear-glass"
          text "clear-glass"
        button appearance="auto" buttonStyle="prominent-clear-glass" press=go testId="prominent-clear-glass"
          text "prominent-clear-glass"
      row gap=12 align-items="center"
        button appearance="auto" buttonStyle="glass" press=go testId="symbol-only" aria-label="Add"
          image "symbol:add"
        button appearance="auto" buttonStyle="filled" press=go testId="symbol-title"
          image "symbol:send"
          text "Send"
        button appearance="auto" buttonStyle="tinted" press=go testId="title-symbol"
          text "Forward"
          image "symbol:forward"
      button appearance="auto" buttonStyle="bordered-prominent" press=go testId="wide" width=240 accent-color="#34c759"
        text "Fixed 240 wide"
      button appearance="auto" press=go testId="stretched"
        text "Stretched (default bordered)"
      button appearance="auto" buttonStyle="filled" press=go testId="disabled" disabled=true align-self="flex-start"
        text "Disabled"
      row testId="group" glassGroup=24 gap=8 padding=12 background-color="#ff9500" align-self="flex-start"
        button appearance="auto" buttonStyle="glass" press=go testId="g1"
          text "Lock"
        button appearance="auto" buttonStyle="glass" press=go testId="g2"
          text "Unlock"
        button appearance="auto" buttonStyle="glass" press=fade testId="g3" opacity=(fading ? 0.3 : 1)
          text "Fade"
