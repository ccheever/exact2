// LLP 1077 D13's vibrancy page: UIKit's label, fill and separator colours
// over a material, which Apple draws vibrantly (the colour blends with what
// the material blurs) and every other host draws as the colour's light and
// dark pair. A striped, coloured backdrop so the blend shows; two materials,
// one that clips its children and one that does not; in each, the six
// system colours and a plain `#000000` control. Apple pictures are the point
// here — Chrome draws the plain pairs.
component Vibrancy
  state dark = false
  action scheme
    dark = not dark
    setScheme(dark ? "light" : "dark")
  view
    main testId="vibrancy" position="relative" width=390 height=520 background-color="light-dark(#ffffff, #121212)"
      box position="absolute" left=0 top=0 width=390 height=520 display="flex" flex-direction="row"
        box width=65 background-color="#e53935"
        box width=65 background-color="#fdd835"
        box width=65 background-color="#43a047"
        box width=65 background-color="#1e88e5"
        box width=65 background-color="#8e24aa"
        box width=65 background-color="#212121"
      box testId="clipped" position="absolute" left=15 top=20 width=360 height=220 border-radius=16 overflow="hidden" backgroundMaterial="thin" display="flex" flex-direction="column" padding=12 gap=2
        text "Label" testId="c-label" font-size=20 font-weight=700 color="-apple-system-label"
        text "Secondary label" testId="c-secondary" font-size=20 font-weight=700 color="-apple-system-secondary-label"
        text "Tertiary label" testId="c-tertiary" font-size=20 font-weight=700 color="-apple-system-tertiary-label"
        text "Quaternary label" testId="c-quaternary" font-size=20 font-weight=700 color="-apple-system-quaternary-label"
        box height=2 background-color="-apple-system-separator"
        box height=18 background-color="-apple-system-fill"
        text "Plain #000000" testId="c-plain" font-size=20 font-weight=700 color="#000000"
      box testId="visible" position="absolute" left=15 top=260 width=360 height=200 border-radius=16 backgroundMaterial="regular" display="flex" flex-direction="column" padding=12 gap=2
        text "Label" testId="v-label" font-size=20 font-weight=700 color="-apple-system-label"
        text "Secondary label" testId="v-secondary" font-size=20 font-weight=700 color="-apple-system-secondary-label"
        text "Tertiary label" testId="v-tertiary" font-size=20 font-weight=700 color="-apple-system-tertiary-label"
        text "Plain #000000" testId="v-plain" font-size=20 font-weight=700 color="#000000"
      button testId="dark" press=scheme aria-label="Scheme" position="absolute" left=340 top=470 width=40 height=40 background-color="#757575"
