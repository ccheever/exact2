// LLP 1115.000 D5: on iOS the navigation bar is each route's, and Back is
// always there (NavigationBasicsIOSTests). One stack that opens on a route
// with no header, and the routes pushed over it:
//
// - `start`, the stack's first route, has no header: nothing to go back to,
//   no bar;
// - `detail` has a header of one heading: the bar, its title and UIKit's Back;
// - `plain` has no header, and `twin` a header of two headings, which is no
//   bar's and paints in the page: each gets the system Back alone;
// - `own` has no header and draws its own Back control, which the system's
//   Back presses;
// - `viewer` draws its own Back control too and says it has no bar
//   (`navigationBar="none"`): a full-bleed screen;
// - `sheet` is a modal route with no header: the first route of its own
//   presented stack.
//
// Every one of those routes offers a button to each of the others, and to
// the four below.
//
// LLP 1115.000 D11.1: the route's scroller is the bar's scroller with nothing
// written (NavigationCollapseIOSTests). Four routes that scroll:
//
// - `tall` has a large title and one `scroll` right after its header, and
//   names nothing: the title collapses with it and it runs under the bar;
// - `pair` has two scrollers and names neither: the first is the bar's, and
//   the status bar's;
// - `named` has the same two and names the second with `navigationScroll`,
//   which is how a route says another;
// - `bare` has no header: its scroller runs under the bar that holds the
//   system Back alone.
//
// LLP 1115.000 D11.3 (GroupedListIOSTests): `rows` is a grouped list. One
// row pushes `detail` and stays selected under it; one presses and stays.
routes nav
  start "/"
    detail "/detail"
    plain "/plain"
    twin "/twin"
    own "/own"
    viewer "/viewer"
    sheet "/sheet"
    tall "/tall"
    pair "/pair"
    named "/named"
    bare "/bare"
    rows "/rows"

component NavigationBars
  state backs = 0
  state stays = 0
  action open(name: string)
    nav = push(nav, "/" + name)
  action stay
    stays = stays + 1
  action back
    backs = backs + 1
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar=(e.name == "viewer" ? "none" : "auto") navigationPresentation=(e.name == "sheet" ? "modal" : "") navigationScroll=(e.name == "named" ? "named-second" : "") testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
          if e.name == "tall"
            header testId="header-tall" display="flex" align-items="center" padding="8px 16px"
              text "Tall" role="heading" aria-level=1
            scroll testId="tall-scroll" flex=1 min-height=0
              text "tall top" testId="tall-top"
              column height=1600
          else if e.name == "pair" or e.name == "named"
            header testId=`header-${e.name}` display="flex" align-items="center" padding="8px 16px"
              text "Two" role="heading" aria-level=1
            scroll id=`${e.name}-first` testId=`${e.name}-first` flex=1 min-height=0
              column height=1600
            scroll id=`${e.name}-second` testId=`${e.name}-second` flex=1 min-height=0
              column height=1600
          else if e.name == "bare"
            scroll testId="bare-scroll" flex=1 min-height=0
              text "bare top" testId="bare-top"
              column height=1600
          else if e.name == "rows"
            header testId="header-rows" display="flex" align-items="center" padding="8px 16px"
              text "Rows" role="heading" aria-level=2
            list appearance="auto" testId="rows-list" flex=1 min-height=0
              section
                button press=open("detail") testId="rows-open-detail"
                  text "Detail"
                  image "symbol:forward-chevron"
                button press=stay testId="rows-stay"
                  text `Stayed ${stays}`
          else
            if e.name == "detail"
              header testId="header-detail" display="flex" align-items="center" padding="8px 16px"
                text "Detail" role="heading" aria-level=2
            if e.name == "twin"
              header testId="header-twin" display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
                text "Left" role="heading" aria-level=2
                text "Right" role="heading" aria-level=2
            column testId=`content-${e.name}` flex=1 min-height=0 padding=16 gap=8
              if e.name == "own" or e.name == "viewer"
                button id="back" press=back testId=`${e.name}-back` align-self="flex-start"
                  text "Close"
              text `backs ${backs}` testId=`${e.name}-backs`
              for l in ["detail", "plain", "twin", "own", "viewer", "sheet", "tall", "pair", "named", "bare", "rows"] key=l
                button press=open(l) testId=`${e.name}-open-${l}`
                  text l
