// Dotted/dashed border parity at 1x: Chrome is the reference for the native
// painters. Each 100x70 box is at the same positions as borders.contract.
component BorderPatterns
  view
    main testId="borders" position="relative" width=390 height=460 background-color="#ffffff"
      box testId="dot1" position="absolute" left=20 top=20 width=100 height=70 box-sizing="border-box" border-style="dotted" border-width=1 border-color="#e53935"
      box testId="dot2" position="absolute" left=145 top=20 width=100 height=70 box-sizing="border-box" border-style="dotted" border-width=2 border-color="#e53935"
      box testId="dot4" position="absolute" left=270 top=20 width=100 height=70 box-sizing="border-box" border-style="dotted" border-width=4 border-color="#e53935"
      box testId="dash1" position="absolute" left=20 top=115 width=100 height=70 box-sizing="border-box" border-style="dashed" border-width=1 border-color="#43a047"
      box testId="dash2" position="absolute" left=145 top=115 width=100 height=70 box-sizing="border-box" border-style="dashed" border-width=2 border-color="#43a047"
      box testId="dash4" position="absolute" left=270 top=115 width=100 height=70 box-sizing="border-box" border-style="dashed" border-width=4 border-color="#43a047"
      box testId="round-dot" position="absolute" left=20 top=210 width=100 height=70 box-sizing="border-box" border-style="dotted" border-width=4 border-radius=20 border-color="#1e88e5"
      box testId="round-dash" position="absolute" left=145 top=210 width=100 height=70 box-sizing="border-box" border-style="dashed" border-width=4 border-radius=20 border-color="#1e88e5"
      box testId="mixed" position="absolute" left=270 top=210 width=100 height=70 box-sizing="border-box" border-top-style="dotted" border-right-style="solid" border-bottom-style="dashed" border-left-style="solid" border-width=4 border-radius=16 border-color="#e53935 #43a047 #1e88e5 #fdd835"
      box testId="unequal-dot" position="absolute" left=20 top=305 width=100 height=70 box-sizing="border-box" border-style="dotted" border-top-width=1 border-right-width=2 border-bottom-width=4 border-left-width=2 border-radius=12 border-color="#6a1b9a"
      box testId="underline-dot" position="absolute" left=145 top=305 width=100 height=70 box-sizing="border-box" border-bottom-style="dotted" border-bottom-width=1 border-bottom-color="#e53935"
      box testId="underline-dash" position="absolute" left=270 top=305 width=100 height=70 box-sizing="border-box" border-bottom-style="dashed" border-bottom-width=4 border-bottom-color="#43a047"
