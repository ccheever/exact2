component App
  state count = 0
  state inside = false
  state ratio = 0
  state initialCount = 0
  state initialInside = false
  state initialRatio = 0
  action initialSeen(e: IntersectionObserverEntry)
    initialCount = initialCount + 1
    initialInside = e.isIntersecting
    initialRatio = e.intersectionRatio
  action seen(e: IntersectionObserverEntry)
    count = count + 1
    inside = e.isIntersecting
    ratio = e.intersectionRatio
  view
    column width=400 height=400
      scroll width=200 height=100 testId="port"
        box height=150 flex-shrink=0
        box width=100 height=50 flex-shrink=0 intersect=seen intersect-margin="10% 0px 20px" testId="target"
        box height=300 flex-shrink=0
      text `${count}:${inside}:${ratio}` testId="facts"
      scroll width=200 height=100 scrollTop=150 testId="initial-port"
        box height=150 flex-shrink=0
        box width=100 height=50 flex-shrink=0 intersect=initialSeen
        box height=300 flex-shrink=0
      text `${initialCount}:${initialInside}:${initialRatio}` testId="initial-facts"
