// LLP 1077 D8: a box in space takes taps where it is drawn. `near` is moved
// toward the viewer under a perspective whose vanishing point is the stage's
// top left, so it is drawn half again as large and down and to the right of
// its flat frame: the middle of what is seen lies outside that frame. `front`
// is turned away with its back face hidden, over `back`: a tap at their
// middle reaches `back`, as CSS has it. `turned` is a card turned about y.
component SpaceHits
  state near = 0
  state front = 0
  state back = 0
  state turned = 0
  action pressNear
    near = near + 1
  action pressFront
    front = front + 1
  action pressBack
    back = back + 1
  action pressTurned
    turned = turned + 1
  view
    main testId="space-hits" position="relative" width=390 height=560 background-color="#ffffff"
      box testId="stage" position="absolute" left=0 top=0 width=300 height=300 perspective=300 perspective-origin="left top" background-color="#eeeeee"
        button testId="near" press=pressNear aria-label="Near" position="absolute" left=100 top=100 width=60 height=60 translate="0 0 100px" background-color="#1e88e5"
      box position="absolute" left=20 top=320 width=160 height=100 perspective=300 background-color="#eeeeee"
        button testId="back" press=pressBack aria-label="Back" position="absolute" left=20 top=20 width=120 height=60 background-color="#43a047"
        button testId="front" press=pressFront aria-label="Front" position="absolute" left=20 top=20 width=120 height=60 rotate="y 180deg" backface-visibility="hidden" background-color="#e53935"
      box position="absolute" left=200 top=320 width=160 height=100 perspective=200 background-color="#eeeeee"
        button testId="turned" press=pressTurned aria-label="Turned" position="absolute" left=20 top=20 width=120 height=60 rotate="y 60deg" background-image="linear-gradient(to right, #fdd835, #43a047)"
      text `near ${near} front ${front} back ${back} turned ${turned}` testId="counts" position="absolute" left=20 top=450
