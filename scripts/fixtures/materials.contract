// LLP 1053.000 D4's parity page: named `backgroundMaterial`s over a grey
// backdrop (black and white bars, so the web's `saturate()` is a no-op and
// the web's and Linux's stated approximation is one picture). Chrome's
// picture (the web host at 1×) is materials.web.png; Linux's raster test
// holds both painters to it. On Apple each name draws the platform's own
// material (the schema's `materials` table), which is the point: the
// pictures differ there by design.
component Materials
  view
    main testId="materials" position="relative" width=390 height=460 background-color="#ffffff"
      box position="absolute" left=0 top=0 width=390 height=460 display="flex" flex-direction="row"
        box width=30 background-color="#000000"
        box width=30 background-color="#ffffff"
        box width=30 background-color="#808080"
        box width=30 background-color="#000000"
        box width=30 background-color="#ffffff"
