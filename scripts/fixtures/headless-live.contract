// A live headless session (LLP 1126.002 D3): a repeating timer that missed
// beats fires once on the live clock (HeadlessLiveTests). Compiled by
// build.mjs --test.
component HeadlessLive
  state ticks = 0
  action tick
    ticks = ticks + 1
  task ticker mount
    every(1000, tick)
  view
    column
      text `${ticks}` testId="ticks"
