// LLP 1075.003 §3.7: a tab whose stack shows no bar and has pushed nothing
// holds its route without a navigation controller, which is built when the
// stack first pushes or its route first shows a bar (HeldStackIOSTests).
// Plain's root has no header until `titled`, a level-1 heading whose large
// title collapses with the scroller right after it; its field keeps the
// focus as the route moves into the navigation controller. Open Two pushes
// two routes in one batch. Titled starts with a bar. Bump changes a text no
// tab shows, Rename the Titled tab's own: a tab's face is read again only
// after the second (NavigationTabsIOSTests). Detail in Plain, from Titled,
// selects Plain and pushes onto its held stack in one update.
routes nav
  tab plain "/"
    detail "/detail"
      more "/detail/more"
    sheet "/sheet"
  tab titled "/titled"

component HeldTab
  state titled = false
  state draft = ""
  state bumps = 0
  state renamed = false
  action pick(name: string)
    nav = select(nav, name)
  action open
    nav = push(nav, "/detail")
  action openTwo
    nav = push(push(nav, "/detail"), "/detail/more")
  action openFromTitled
    nav = open(nav, "/detail")
  action openSheet
    nav = push(nav, "/sheet")
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action title
    titled = ! titled
  action write(text: string)
    draft = text
  action bump
    bumps = bumps + 1
  action rename
    renamed = ! renamed
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationPresentation=(e.name == "sheet" ? "modal" : "") testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
                if e.name == "titled" || e.name == "detail" || e.name == "more" || (e.name == "plain" && titled)
                  header display="flex" align-items="center" padding="8px 16px"
                    if e.name == "detail" || e.name == "more"
                      button id="back" press=back testId=`back-${e.name}` aria-label="Back"
                        text "Back"
                    text e.name role="heading" aria-level=(e.name == "plain" || e.name == "titled" ? 1 : 2)
                if e.name == "plain"
                  scroll testId="list" flex=1 min-height=0
                    input value=draft input=write placeholder="Draft" testId="draft"
                    button press=open testId="open"
                      text "Open"
                    button press=openTwo testId="open-two"
                      text "Open two"
                    button press=openSheet testId="open-sheet"
                      text "Sheet"
                    button press=title testId="title"
                      text "Title"
                    button press=bump testId="bump"
                      text "Bump"
                    button press=rename testId="rename"
                      text "Rename"
                    column height=1600
                  // Outside the scroller, so its batch is projected (`onlyListRows`).
                  text `Bumped ${bumps}` testId="bumps"
                if e.name == "titled"
                  button press=openFromTitled testId="open-from-titled"
                    text "Detail in Plain"
                if e.name == "sheet"
                  button id="back" press=back testId="close"
                    text "Close"
      row role="tablist"
        button role="tab" aria-controls="panel-plain" aria-selected=(nav.tab == "plain") press=pick("plain") testId="tab-plain" flex=1
          text "Plain"
        button role="tab" aria-controls="panel-titled" aria-selected=(nav.tab == "titled") press=pick("titled") testId="tab-titled" flex=1
          text (renamed ? "Renamed" : "Titled")
