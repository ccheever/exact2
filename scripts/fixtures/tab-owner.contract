// LLP 1123 D2: a tab's route is read where UIKit shows it. The tab
// container holds the routes beside their authored tab panels, so a panel's
// own transform (a quarter turn, then a scale to nothing) does not reach
// what UIKit shows: the card stays where its route puts it, and `frame`,
// `elementFromPoint`, `elementsFromPoint` and the intersection observer,
// whose margin leaves the viewport's right half, read it there
// (ContentOwnersIOSTests). The beacon turns with the panel and leaves the
// viewport, and comes back as the panel flattens, so the observers have run
// once each change is seen.
routes nav
  tab first "/"
  tab second "/second"

component TabOwner
  state spin = false
  state flat = false
  state frame = "unread"
  state hit = "unread"
  state all = "unread"
  state seen = "unseen"
  state beacon = "unseen"
  action pick(name: string)
    nav = select(nav, name)
  action turn
    spin = ! spin
  action flatten
    flat = true
  action observe(e: IntersectionObserverEntry)
    seen = `${e.isIntersecting}:${e.intersectionRatio}`
  action observeBeacon(e: IntersectionObserverEntry)
    beacon = `${e.isIntersecting}`
  // A point in the card, where UIKit shows it (its `top` starts past the
  // status bar the route's cover clears, whatever the phone's)
  action read
    let f = frame("card")
    frame = `${f.x},${f.y},${f.width},${f.height}`
    hit = match elementFromPoint(f.x + 24, f.y + 20) { case some(id) => id, case none => "none" }
    all = elementsFromPoint(f.x + 24, f.y + 20).join(",")
  view
    main navigationKey=`${top(nav).id}` width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0 rotate=(spin ? "90deg" : "none") scale=(flat ? 0 : 1)
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0
                if e.name == "first"
                  box id="card" testId="card" position="absolute" left=16 top=400 width=100 height=40 intersect=observe intersect-margin="0px 0px 0px -200px"
      row role="tablist"
        button role="tab" aria-controls="panel-first" aria-selected=(nav.tab == "first") press=pick("first") flex=1
          text "First"
        button role="tab" aria-controls="panel-second" aria-selected=(nav.tab == "second") press=pick("second") flex=1
          text "Second"
      box position="absolute" left=-80 top=600 width=100 height=20 rotate=(spin && ! flat ? "90deg" : "none") intersect=observeBeacon
      button press=turn testId="turn" position="absolute" left=0 bottom=0 width=1 height=1 aria-label="Turn"
      button press=flatten testId="flatten" position="absolute" left=2 bottom=0 width=1 height=1 aria-label="Flatten"
      button press=read testId="read" position="absolute" left=1 bottom=0 width=1 height=1 aria-label="Read"
