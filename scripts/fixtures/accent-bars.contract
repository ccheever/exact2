// A pushed route whose heading and header button write `AccentColor`: its bar is projected
// before the route is in the window, and takes the window's tint from the push on; and one
// with an accent of its own, which its bar takes (AppAccentIOSTests).
routes nav
  home "/"
  detail "/detail"
  teal "/teal"

component AccentBars
  action open
    nav = push(nav, "/detail")
  action openTeal
    nav = push(nav, "/teal")
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` testId=`route-${e.name}` accent-color=(e.name == "teal" ? "-exact-system-teal" : "AccentColor") position="absolute" inset=0 display="flex" flex-direction="column"
          if e.name == "teal"
            header display="flex" align-items="center" padding="8px 16px"
              text "Teal" role="heading" aria-level=1 color="AccentColor"
              button press=open testId="teal-action" color="AccentColor"
                text "Next"
          else if e.name == "detail"
            header display="flex" align-items="center" padding="8px 16px"
              text "Detail" role="heading" aria-level=1 color="AccentColor"
              button press=open testId="detail-action" color="AccentColor"
                text "Edit"
          else
            header display="flex" align-items="center" padding="8px 16px"
              text "Home" role="heading" aria-level=1
            button press=open testId="open"
              text "Open"
            button press=openTeal testId="open-teal"
              text "Teal"
