// A pushed route whose heading and header button write `AccentColor`: its bar is projected
// before the route is in the window, and takes the window's tint from the push on
// (AppAccentIOSTests).
routes nav
  home "/"
  detail "/detail"

component AccentBars
  action open
    nav = push(nav, "/detail")
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
          if e.name == "detail"
            header display="flex" align-items="center" padding="8px 16px"
              text "Detail" role="heading" aria-level=1 color="AccentColor"
              button press=open testId="detail-action" color="AccentColor"
                text "Edit"
          else
            header display="flex" align-items="center" padding="8px 16px"
              text "Home" role="heading" aria-level=1
            button press=open testId="open"
              text "Open"
