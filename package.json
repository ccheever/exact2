{
  "name": "exact2",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": { "bun": ">=1.4.2" },
  "description": "The bake's TypeScript toolchain (LLP 1027 D5, ruled 2026-09-03): Rolldown bundles and strips an app's `app.ts` to one script for hermesc. SQLite WASM is shipped as a lazy browser storage artifact.",
  "workspaces": ["packages/*"],
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "fflate": "0.8.3",
    "playwright-core": "1.64.1",
    "rolldown": "1.2.9",
    "snapback4": "0.4.33",
    "typescript": "7.0.2"
  },
  "bin": {
    "exact": "scripts/exact.mjs"
  },
  "dependencies": {
    "@exact/scale-fixture-cards": "workspace:*",
    "@exact/actions": "workspace:*",
    "@exact/lists": "workspace:*",
    "@exact/cards": "workspace:*",
    "@exact/geolocation": "workspace:*",
    "@exact/local-auth": "workspace:*",
    "@exact/camera": "workspace:*",
    "@exact/media-capture": "workspace:*",
    "@exact/motion": "workspace:*",
    "@exact/recording": "workspace:*",
    "@exact/speech-recognition": "workspace:*",
    "@exact/speech-synthesis": "workspace:*",
    "@exact/scale-fixture-notes": "workspace:*",
    "@exact/reading": "workspace:*"
  }
}
