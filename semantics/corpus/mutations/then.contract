// A mutation's `then`: armed by the commit its answer landed in, it runs
// as its own commit when the input lands, never inside the sending commit.
shape Ack
  ok: bool

component App
  state sent = 0
  state after = 0
  state stamp = -1
  mutation ack as shape Ack then landed
  action poke
    sent = sent + 1
    send ack = ping(sent)
  action landed
    after = after + 1
    stamp = performanceNow()
  view
    column
      text `${sent}/${after}` testId="count"
      button "poke" press=poke testId="poke"

test "an input lands its then"
  expect state after == 0
  tap "poke"
  expect state after == 1
  clock +0
  expect state after == 1
  expect state stamp == 0
  clock +100
  expect state after == 1

test "armed again by each answer"
  clock +40
  tap "poke"
  tap "poke"
  expect state after == 2
  expect state stamp == 41
  clock +5
  expect state after == 2
  expect state stamp == 41
  tap "poke"
  clock +1
  expect state after == 3
  expect state stamp == 47
