// A filter toggled on and off over string-keyed rows: hidden rows lose
// their state, visible ones keep it, whatever their position.
shape Item
  id: string
  on: bool

component App
  resource a = items(1) as shape Item[]
  resource b = items(2) as shape Item[]
  resource c = items(3) as shape Item[]
  derive ab = a.length >= b.length ? a : b
  derive items = ab.length >= c.length ? ab : c
  state onlyOn = false
  derive shown = items.filter(it => ! onlyOn || it.on)
  action toggle
    onlyOn = ! onlyOn
  view
    column
      button "toggle" press=toggle testId="toggle"
      for it, i in shown key=`${it.id}/${it.on}`
        Row(index=i)

component Row
  props
    index: number
  state hits = 0
  action hit
    hits = hits + 1
  view
    button "hit" press=hit testId=`hit-${index}`
      text `${index}:${hits}` testId=`row-${index}`

test "toggle filter"
  tap "hit-0"
  tap "hit-1"
  tap "hit-1"
  tap "hit-2"
  tap "toggle"
  tap "hit-0"
  tap "toggle"
