// A slot initialised to `[]`, compared and rewritten.
shape Item
  id: string

component App
  resource items = items() as shape Item[]
  state picked = []
  derive count = picked.length
  action take
    picked = items.map(i => i.id)
  action drop
    picked = []
  view
    column
      text `${count}` testId="count"
      button "take" press=take testId="take"
      button "drop" press=drop testId="drop"

test "list slot"
  expect state count == 0
  tap "take"
  tap "drop"
  expect state count == 0
