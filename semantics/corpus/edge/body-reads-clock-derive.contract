// An action's body reads a derive and a resource whose inputs read now(),
// after an advance that committed nothing: it sees them as the last commit
// settled them (the pre-state), and the resource is asked again only at
// settlement, with the written slot. The web JS target once re-evaluated
// both inside the body at the new time, asking its source a question the
// runner never asks.
component App
  state k = 1
  derive at = now() * k
  resource r = load(now() * k) as shape number
  state seen = -1
  state seenR = -1
  action mark
    seen = at
    seenR = r
    k = k + 1
  view
    column
      text `${seen}` testId="seen"
      button "mark" press=mark testId="mark"

test "the body reads the pre-state"
  clock +100
  tap "mark"
  expect state seen == 0
  clock +50
  tap "mark"
  expect state seen == 200
