component App
  state count = 0
  state enabled = true
  action tick
    count = count + 1
  action disable
    enabled = false
  task first when enabled
    after(50, tick, wait=idle)
  task second mount
    after(50, disable)
  view
    text `${count}`

test "wait-idle-order"
  clock +50
  expect state count == 0
