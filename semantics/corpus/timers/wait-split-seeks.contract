component App
  state count = 0
  state seen = 0
  action tick
    count = count + 1
    seen = performanceNow()
  task t mount
    every(7, tick, wait=frame)
  view
    text `${count}`

test "wait-split-seeks"
  clock +49
  expect state count == 2
  clock +1
  expect state count == 3
  clock +50
  expect state count == 6
