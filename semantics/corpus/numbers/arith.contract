// Basic arithmetic: precedence, unary minus, IEEE rounding of decimal sums.
component App
  state a = 7
  state b = 2
  derive sum = a + b
  derive diff = a - b
  derive prod = a * b
  derive quot = a / b
  derive rem = a % b
  derive prec = a + b * 3
  derive paren = (a + b) * 3
  derive neg = -a + b
  derive tenth = 0.1 + 0.2
  derive chain = a - b - 1
  derive divchain = 64 / 4 / 2
  action setB(n: number)
    b = n
  view
    column
      text `${sum} ${diff} ${prod} ${quot} ${rem}` testId="ops"
      text `${prec} ${paren} ${neg}` testId="prec"
      text `${tenth}` testId="tenth"
      text `${chain} ${divchain}` testId="chain"
      text `${0.1 * 3} ${1 - 0.9} ${0.3 - 0.1}` testId="float"
      button "b3" press=setB(3) testId="b3"
      button "bneg" press=setB(-4) testId="bneg"
      button "bfrac" press=setB(0.5) testId="bfrac"

test "initial values"
  expect state sum == 9
  expect state diff == 5
  expect state prod == 14
  expect state quot == 3.5
  expect state rem == 1
  expect state prec == 13
  expect state paren == 27
  expect text "prec" == "13 27 -5"
  expect state chain == 4
  expect state divchain == 8
  expect text "ops" == "9 5 14 3.5 1"
  expect text "prec" == "13 27 -5"
  expect text "tenth" == "0.30000000000000004"
  expect text "float" == "0.30000000000000004 0.09999999999999998 0.19999999999999998"

test "change divisor"
  tap "b3"
  expect text "ops" == "10 4 21 2.3333333333333335 1"
  tap "bneg"
  expect text "ops" == "3 11 -28 -1.75 3"
  tap "bfrac"
  expect text "ops" == "7.5 6.5 3.5 14 0"
