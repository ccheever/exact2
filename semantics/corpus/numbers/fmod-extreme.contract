// `%` as exact fmod on extreme operands: huge dividends, tiny and subnormal
// divisors, decimal divisors. Expected texts are JavaScript's `%`.
component App
  view
    column
      text `${ % 7}` testId="m0"
      text `${ % 3}` testId="m1"
      text `${ % 0.1}` testId="m2"
      text `${ % 1000000007}` testId="m3"
      text `${9007199254740993 % 2}` testId="m4"
      text `${123456789.123 % 0.001}` testId="m5"
      text `${0.0000001 % 0.00000003}` testId="m6"
      text `${5.5 % 0.0001}` testId="m7"
      text `${1 % 0.1}` testId="m8"
      text `${2 % 0.2}` testId="m9"
      text `${-1 % 0.3}` testId="m10"
      text `${100 % 0.7}` testId="m11"
      text `${17.25 % -4.5}` testId="m12"
      text `${0.5 % 1}` testId="m13"
      text `${3 % 3}` testId="m14"
      text `${-3 % 3}` testId="m15"
      text `${0. % 0.}` testId="m16"
      text `${ % 0.}` testId="m17"

test "fmod values"
  expect text "m0" == "1"
  expect text "m1" == "0"
  expect text "m2" == "0.00011215964963492975"
  expect text "m3" == "673966564"
  expect text "m4" == "0"
  expect text "m5" == "0.000999993376923471"
  expect text "m6" == "1.0000000000000004e-8"
  expect text "m7" == "0.00009999999999973644"
  expect text "m8" == "0.09999999999999995"
  expect text "m9" == "0.1999999999999999"
  expect text "m10" == "-0.10000000000000003"
  expect text "m11" == "0.6000000000000063"
  expect text "m12" == "3.75"
  expect text "m13" == "0.5"
  expect text "m14" == "0"
  expect text "m15" == "0"
  expect text "m16" == "2e-323"
  expect text "m17" == "4.468544092038189e-301"
