// A branch and an integer that turn on sin's last bit. The runner's libm
// gives sin(4) = -0.7568024953079282; JavaScriptCore's Math.sin gives
// -0.7568024953079283, one unit in the last place below. The semantics and
// the JS driver must reach the runner's branch and integers exactly. `again`
// feeds one sin into another, and `chain` seven trig results from `s` on,
// each into the next, so an input exists only once the result before it is
// computed: more drives of the JS target than three.
component App
  state x = 4
  derive s = sin(x)
  derive branch = s < -0.7568024953079282 ? 9007199254740992 : 9007199254740994
  derive digits = floor(s * -10000000000000000)
  derive again = floor(sin(s * 1000) * 10000000000000000)
  derive a = sin(sin(s * 3) * 7)
  derive b = sin(a * 11)
  derive c = cos(b * 13)
  derive chain = floor(sin(cos(c * 17) * 19) * 10000000000000000)
  action set(v: number)
    x = v
  view
    column
      text `${s}` testId="s"
      text `${branch} ${digits}` testId="integers"
      text `${again} ${chain}` testId="again"
      button "four" press=set(4) testId="four"
      button "seven" press=set(7) testId="seven"

test "sin's last bit picks no other branch"
  expect text "integers" == "9007199254740994 7568024953079282"
  tap "seven"
  tap "four"
