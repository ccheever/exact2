// `for` over an empty list renders nothing; siblings before and after
// stay in order.
shape Item
  id: string

component App
  mutation got as shape Item[]
  derive items = match got { case some(xs) => xs, case none => [] }
  view
    column
      text "before" testId="before"
      for it, i in items key=i
        text it.id testId=`row-${i}`
      text "after" testId="after"

test "empty each"
  expect tree has "before"
  expect tree has "after"
  expect tree missing "row-0"
