// Formats of the clock: a view and a timer reading `now()` through
// `formatTime`/`formatNumber`, so each advance re-renders them.
component App
  state base = 1790000000000
  state ticks = 0
  derive label = formatTime(base + now() * 1000, -420, "short")
  derive count = formatNumber(ticks * 1234.5, "compact")
  action tick
    ticks = ticks + 1
  task t mount
    every(60000, tick)
  view
    column
      text label testId="label"
      text count testId="count"
      text formatDate(base + now() * 86400, 60, "medium") testId="day"

test "advance"
  clock +60000
  clock +600000
  clock +3600000
