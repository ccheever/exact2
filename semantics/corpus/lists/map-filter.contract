// map / filter / join / length / isEmpty / first / at over a list from a
// source. Assertions are properties that hold for any answer; the
// differential run compares the values.
shape Item
  id: string
  n: number
  on: bool

component App
  resource items = items() as shape Item[]
  derive ids = items.map(i => i.id)
  derive ons = items.filter(i => i.on)
  derive offs = items.filter(i => ! i.on)
  derive split = ons.length + offs.length == items.length
  derive doubled = items.map(i => i.n * 2)
  derive indexed = items.map((i, k) => `${k}:${i.id}`).join(",")
  derive allNums = items.map(i => i.n).join("|")
  derive bools = items.map(i => i.on).join(" ")
  derive empty = items.isEmpty()
  derive emptyAgree = empty == (items.length == 0)
  derive firstId = match first(items) { case some(i) => i.id, case none => "none" }
  derive lastId = match items.at(-1) { case some(i) => i.id, case none => "none" }
  derive atZero = items.at(0) == first(items)
  derive outOfRange = items.at(items.length) == none
  derive mapLen = items.map(i => i.n).length == items.length
  view
    column
      text indexed testId="indexed"
      text allNums testId="nums"
      text bools testId="bools"
      text firstId testId="first"
      text lastId testId="last"
      text `${ons.length}/${items.length}` testId="count"

test "list properties"
  expect state split == true
  expect state emptyAgree == true
  expect state atZero == true
  expect state outOfRange == true
  expect state mapLen == true
