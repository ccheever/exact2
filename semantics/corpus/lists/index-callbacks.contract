// Callbacks with an index parameter in map and filter.
shape Item
  id: string

component App
  resource items = items() as shape Item[]
  derive evens = items.filter((x, i) => i % 2 == 0)
  derive odds = items.filter((x, i) => i % 2 == 1)
  derive parts = evens.length + odds.length == items.length
  derive numbered = items.map((x, i) => `${i + 1}`).join(",")
  derive firstHalf = items.filter((x, i) => i < items.length / 2)
  derive lastIndex = items.filter((x, i) => i == items.length - 1).map((x, i) => i.toString()).join("")
  view
    column
      text numbered testId="numbered"
      text `${evens.length}/${odds.length}` testId="split"

test "index callbacks"
  expect state parts == true
