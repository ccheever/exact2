// toString on numbers, bools and strings.
component App
  state n = -12.5
  derive a = n.toString()
  derive b = (n > 0).toString()
  derive c = "already".toString()
  derive d = (n * 0).toString()
  derive e = (0.1 + 0.2).toString() + (1 / 3).toString()
  view
    text a testId="a"

test "toString"
  expect state a == "-12.5"
  expect state b == "false"
  expect state c == "already"
  expect state d == "0"
  expect state e == "0.300000000000000040.3333333333333333"
