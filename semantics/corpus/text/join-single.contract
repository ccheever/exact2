// join with one item returns it unchanged (a string) or printed (a number
// or bool); with none it is empty; the separator appears only between.
shape Row
  s: string
  n: number
  b: bool

component App
  resource rows = rows() as shape Row[]
  state count = 1
  derive taken = rows.filter((r, i) => i < count)
  derive ss = taken.map(r => r.s).join("--")
  derive ns = taken.map(r => r.n).join("--")
  derive bs = taken.map(r => r.b).join("--")
  derive none0 = rows.map(r => r.s).filter(s => false).join("--")
  derive sepCount = ss.length >= 2 * (taken.length - 1)
  action more
    count = count + 1
  view
    column
      text ss testId="ss"
      text ns testId="ns"
      text bs testId="bs"
      button "more" press=more testId="more"

test "growing joins"
  expect state none0 == ""
  expect state sepCount == true
  tap "more"
  expect state sepCount == true
  tap "more"
  tap "more"
  expect state sepCount == true
