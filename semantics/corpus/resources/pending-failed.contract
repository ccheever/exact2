// `pending(r)`, `failed(r)` and `failure(r)`: with answers that arrive
// synchronously a settled resource is neither, and says no why.
shape Item
  id: string

component App
  state q = 1
  resource items = items(q) as shape list<Item>
  derive loading = pending(items)
  derive broken = failed(items)
  derive why = match failure(items) { case some(f) => `${f.code}: ${f.message}`, case none => "none" }
  action next
    q = q + 1
  view
    column
      when pending(items)
        text "loading" testId="loading"
      else
        text `${length(items)}` testId="count"
      text why testId="why"
      button "next" press=next testId="next"

test "never pending"
  expect state loading == false
  expect state broken == false
  expect state why == "none"
  expect text "why" == "none"
  expect tree missing "loading"
  tap "next"
  expect state loading == false
