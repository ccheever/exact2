component HeightRepro
  state open = false
  action toggle
    open = not open
  view
    column width="100%" height="100%" background-color="#ffffff" color="#111111" padding=24 box-sizing="border-box"
      button "Toggle" press=toggle testId="toggle"
      column box-sizing="border-box" interpolate-size="allow-keywords" height=(open ? 280 : 0) min-height=0 flex-shrink=0 overflow="hidden" transition="height 400ms ease-out" testId="clip"
        column height=280 flex-shrink=0 background-color="#99bbff" testId="inner"
          text "Retained content"
      text "Following content" testId="following"
