// The Exact docs: exact2's own Markdown, one page per route, rendered at build.
// tools/gen.ts turns ../*.md into content/<route>.ts and content/nav.ts from constants/navigation.ts;
// app.ts imports one page's module per route, so a reader downloads only the page it reads.
// Each route waits for the reader before its runtime loads.
use Page, Nav, Moved, Markdown, Viewport from "./components/shapes.contract"
use Sidebar from "./components/sidebar.contract"
use Article from "./components/article.contract"

font "Inter"
  400 = "assets/fonts/Inter-Regular.ttf"
  400 italic = "assets/fonts/Inter-Italic.ttf"
  500 = "assets/fonts/Inter-Medium.ttf"
  600 = "assets/fonts/Inter-SemiBold.ttf"
  700 = "assets/fonts/Inter-Bold.ttf"

font "JetBrains Mono"
  400 = "assets/fonts/JetBrainsMono-Regular.ttf"
  500 = "assets/fonts/JetBrainsMono-Medium.ttf"
  600 = "assets/fonts/JetBrainsMono-SemiBold.ttf"

routes nav
  // routes: generated by tools/gen.ts from constants/navigation.ts
  home "/" render=build activate=idle
  startHere "/start" render=build activate=idle
  contractForHumans "/learn/contract-for-humans" render=build activate=idle
  learnContractForHumansRunAnApp "/learn/contract-for-humans/run-an-app" render=build activate=idle
  learnContractForHumansYourFirstComponent "/learn/contract-for-humans/your-first-component" render=build activate=idle
  learnContractForHumansFilesIndentationAndLiterals "/learn/contract-for-humans/files-indentation-and-literals" render=build activate=idle
  learnContractForHumansValuesAndTypes "/learn/contract-for-humans/values-and-types" render=build activate=idle
  learnContractForHumansStateDerivesAndActions "/learn/contract-for-humans/state-derives-and-actions" render=build activate=idle
  learnContractForHumansExpressionsAndFunctions "/learn/contract-for-humans/expressions-and-functions" render=build activate=idle
  learnContractForHumansViewsAndRepeatedContent "/learn/contract-for-humans/views-and-repeated-content" render=build activate=idle
  learnContractForHumansComponentsProvidersAndSlots "/learn/contract-for-humans/components-providers-and-slots" render=build activate=idle
  learnContractForHumansResourcesAndMutations "/learn/contract-for-humans/resources-and-mutations" render=build activate=idle
  learnContractForHumansWritingTheDataModule "/learn/contract-for-humans/writing-the-data-module" render=build activate=idle
  learnContractForHumansStylingAndLayout "/learn/contract-for-humans/styling-and-layout" render=build activate=idle
  learnContractForHumansInputEventsAndCommands "/learn/contract-for-humans/input-events-and-commands" render=build activate=idle
  learnContractForHumansNavigationAndDocuments "/learn/contract-for-humans/navigation-and-documents" render=build activate=idle
  learnContractForHumansTimeMotionAndGeometry "/learn/contract-for-humans/time-motion-and-geometry" render=build activate=idle
  learnContractForHumansGraphicsMediaAndNativeExtensions "/learn/contract-for-humans/graphics-media-and-native-extensions" render=build activate=idle
  learnContractForHumansPlatformFactsAndLocalization "/learn/contract-for-humans/platform-facts-and-localization" render=build activate=idle
  learnContractForHumansTestingDiagnosticsAndDelivery "/learn/contract-for-humans/testing-diagnostics-and-delivery" render=build activate=idle
  learnContractForHumansWhereToGoNext "/learn/contract-for-humans/where-to-go-next" render=build activate=idle
  recipeAfterAWrite "/recipes/after-a-write" render=build activate=idle
  recipeAppJson "/recipes/app-json" render=build activate=idle
  recipeBackgroundTransfers "/recipes/background-transfers" render=build activate=idle
  recipeBackgroundWork "/recipes/background-work" render=build activate=idle
  recipeChatThread "/recipes/chat-thread" render=build activate=idle
  recipeContentDesign "/recipes/content-design" render=build activate=idle
  recipeDatesAndDays "/recipes/dates-and-days" render=build activate=idle
  recipeDevice "/recipes/device" render=build activate=idle
  recipeEditSheet "/recipes/edit-sheet" render=build activate=idle
  recipeEditableRows "/recipes/editable-rows" render=build activate=idle
  recipeErrorAlert "/recipes/error-alert" render=build activate=idle
  recipeFetchLoadingError "/recipes/fetch-loading-error" render=build activate=idle
  recipeFilesAndGrants "/recipes/files-and-grants" render=build activate=idle
  recipeFirstLaunch "/recipes/first-launch" render=build activate=idle
  recipeFoldables "/recipes/foldables" render=build activate=idle
  recipeFunctions "/recipes/functions" render=build activate=idle
  recipeGroupedForm "/recipes/grouped-form" render=build activate=idle
  recipeIosDriving "/recipes/ios-driving" render=build activate=idle
  recipeKeyboardAndFocus "/recipes/keyboard-and-focus" render=build activate=idle
  recipeListRows "/recipes/list-rows" render=build activate=idle
  recipeLocalNetwork "/recipes/local-network" render=build activate=idle
  recipeMoney "/recipes/money" render=build activate=idle
  recipeMotion "/recipes/motion" render=build activate=idle
  recipeNativeModule "/recipes/native-module" render=build activate=idle
  recipeNativeViews "/recipes/native-views" render=build activate=idle
  recipeNavigationStack "/recipes/navigation-stack" render=build activate=idle
  recipeNfc "/recipes/nfc" render=build activate=idle
  recipeNumberField "/recipes/number-field" render=build activate=idle
  recipeNumericReadout "/recipes/numeric-readout" render=build activate=idle
  recipeOauth "/recipes/oauth" render=build activate=idle
  recipePermissions "/recipes/permissions" render=build activate=idle
  recipePersistedSetting "/recipes/persisted-setting" render=build activate=idle
  recipePortingAndRelease "/recipes/porting-and-release" render=build activate=idle
  recipePortsAndBrowsers "/recipes/ports-and-browsers" render=build activate=idle
  recipeProperties "/recipes/properties" render=build activate=idle
  recipePurchases "/recipes/purchases" render=build activate=idle
  recipeRandomAndShuffle "/recipes/random-and-shuffle" render=build activate=idle
  recipeRandomRolls "/recipes/random-rolls" render=build activate=idle
  recipeResponsiveColumns "/recipes/responsive-columns" render=build activate=idle
  recipeRestBackend "/recipes/rest-backend" render=build activate=idle
  recipeSequencer "/recipes/sequencer" render=build activate=idle
  recipeSignIn "/recipes/sign-in" render=build activate=idle
  recipeSnapbackAuth "/recipes/snapback-auth" render=build activate=idle
  recipeSnapbackTests "/recipes/snapback-tests" render=build activate=idle
  recipeSnapback "/recipes/snapback" render=build activate=idle
  recipeSymbols "/recipes/symbols" render=build activate=idle
  recipeTabs "/recipes/tabs" render=build activate=idle
  recipeTamber "/recipes/tamber" render=build activate=idle
  recipeTests "/recipes/tests" render=build activate=idle
  recipeTheme "/recipes/theme" render=build activate=idle
  recipeTimerInAComponent "/recipes/timer-in-a-component" render=build activate=idle
  recipeTimerThatSurvivesRelaunch "/recipes/timer-that-survives-relaunch" render=build activate=idle
  recipeTimers "/recipes/timers" render=build activate=idle
  recipeUsbHidSerial "/recipes/usb-hid-serial" render=build activate=idle
  recipeWebLook "/recipes/web-look" render=build activate=idle
  recipeWebsite "/recipes/website" render=build activate=idle
  components "/_components" render=build activate=idle
  agents "/agents" render=build activate=idle
  // routes: end
  notfound render=build activate=idle

// One layout for every width, made at build: CSS clamp() against 100vw shows the sidebar from 960px,
// "On this page" from 1280px, and the top bar with its Menu below 960px, so the page needs no runtime
// to fit its window. The not-found page resolves its URL through constants/redirects.ts (app.ts) and
// replaces it once the page shows, so a moved page and a trailing slash land on their page.
component App
  resource page = loadPage(top(nav).name) as shape Page else empty()
  resource site = loadNav() as shape Nav else empty()
  // Which chrome a reader can reach: the CSS clamp() layout draws it, and these keep what it hides
  // out of the tab order and the accessibility tree.
  resource viewport = exactViewport() as shape Viewport
  derive wide = viewport.width >= 960
  derive roomy = viewport.width >= 1280
  resource moved = resolveMoved(top(nav).name == "notfound" ? top(nav).url : "") as shape Moved else empty()
  mutation markdown as shape Markdown then copyFetched
  state menu = false
  state theme = "system" persist
  state sidebar = true persist
  state opened: string[] = []
  state navToggled: string[] = []
  state copied = false
  state voted = ""
  state active = ""
  state visible: string[] = []
  derive from = searchParam(top(nav), "from")
  derive slashless = top(nav).name == "notfound" and top(nav).url.length > 1 and top(nav).url.endsWith("/") ? top(nav).url.slice(0, top(nav).url.length - 1) : ""
  derive destination = moved.go != "" ? moved.go : slashless
  action follow(url: string)
    menu = false
    copied = false
    voted = ""
    visible = []
    active = ""
    nav = go(nav, url)
  action vote(answer: string)
    voted = answer
  action toggle(id: string)
    opened = opened.includes(id) ? opened.filter(x => x != id) : opened.concat([id])
  action pick(set: string, id: string)
    opened = opened.filter(x => not x.startsWith(`${set}|`)).concat([id])
  action copyMarkdown
    send markdown = fetchMarkdown(top(nav).name)
  action seen(id: string, entry: IntersectionObserverEntry)
    let now = entry.isIntersecting ? (visible.includes(id) ? visible : visible.concat([id])) : visible.filter(x => x != id)
    visible = now
    match first(page.toc.filter(t => now.includes(t.href.slice(1))))
      case some(t)
        active = t.href.slice(1)
      case none
        visible = now
  action copyFetched
    match markdown
      case some(m)
        copyText(m.text)
        copied = true
      case none
        copied = false
  task theming mount
    after(1, applyTheme)
  action applyTheme
    setScheme(theme)
  action chooseTheme(value: string)
    theme = value
    setScheme(value)
  action toggleNav(route: string)
    navToggled = navToggled.includes(route) ? navToggled.filter(x => x != route) : navToggled.concat([route])
  action toggleSidebar
    sidebar = not sidebar
  action toggleMenu
    menu = not menu
  action redirect(entry: IntersectionObserverEntry)
    if entry.isIntersecting and destination != ""
      nav = replace(nav, destination)
  view
    view navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="var(--color-background-screen)"
      for e in stack(nav).slice(-1) key=e.id
        column navigationKey=`${e.id}` navigationScroll=`page-${e.id}` navigationBar="none" position="absolute" inset=0
          font-family="var(--font-sans)" color="var(--color-text-default)"
          if e.name == "notfound"
            head title=page.title description=page.description status=404
            if destination != ""
              view intersect=redirect height=1 testId="redirect"
          else
            head title=page.title description=page.description
          header appearance="none" inert=wide display="flex" align-items="center" justify-content="space-between" flex-shrink=0 overflow="hidden"
            height="clamp(0px, (960px - 100vw) * 1000, 57px)" padding="0 16px" border-bottom="1px solid var(--color-border-secondary)" background-color="var(--color-background-default)"
            link href="/" testId="home-bar"
              row align-items="center" gap=8
                image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
                text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
            button press=toggleMenu appearance="none" aria-expanded=menu aria-controls="site-menu" padding="6px 12px" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-lg)" testId="menu"
              row gap=6 align-items="center"
                image (menu ? "symbol:close" : "symbol:menu") aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-default)"
                text (menu ? "Close" : "Menu") font-size="var(--text-sm)"
          row flex=1 min-height=0 overflow="hidden"
            column width=(sidebar ? "clamp(0px, (100vw - 960px) * 1000, 234px)" : "0px") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or not sidebar) testId=(sidebar ? "sidebar-shown" : "sidebar-hidden")
              row align-items="center" justify-content="space-between" padding="12px 12px 0 20px" min-width=234 box-sizing="border-box"
                link href="/" testId="home"
                  row align-items="center" gap=8
                    image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
                    text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
                button press=toggleSidebar appearance="none" aria-label="Hide the sidebar" title="Hide the sidebar" padding=6 border-radius="var(--radius-lg)" testId="sidebar-hide"
                  image "symbol:icon.panelclose" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
              scroll flex=1 min-height=0 min-width=234
                Sidebar(nav=site, current=e.name, toggled=navToggled, toggle=toggleNav, prefix="")
            column width=(sidebar ? "0px" : "clamp(0px, (100vw - 960px) * 1000, 48px)") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or sidebar) padding-top=12 align-items="center" testId=(sidebar ? "sidebar-rail" : "sidebar-rail-shown")
              button press=toggleSidebar appearance="none" aria-label="Show the sidebar" title="Show the sidebar" padding=6 border-radius="var(--radius-lg)" testId="sidebar-show"
                image "symbol:icon.panelopen" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
            if menu
              scroll id="site-menu" flex=1 min-width=0 background-color="var(--color-background-screen)" testId="site-menu"
                Sidebar(nav=site, current=e.name, toggled=navToggled, toggle=toggleNav, prefix="menu-")
            else
              scroll id=`page-${e.id}` flex=1 min-width=0 -exact-layout-transition="220ms ease" background-color="var(--color-background-default)"
                margin="clamp(-1px, (100vw - 960px) * 1000, 8px)" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-xl)"
                Article(page=page, nav=site, missing=(e.name == "notfound"), url=top(nav).url, moved=moved.to, suggestions=moved.suggestions, from=from, opened=opened, toggle=toggle, pick=pick, seen=seen, active=active, copyMarkdown=copyMarkdown, copied=copied, voted=voted, vote=vote, roomy=roomy, year=site.year, theme=theme, chooseTheme=chooseTheme)
