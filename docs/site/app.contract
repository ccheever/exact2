// The Exact docs: exact2's own Markdown, one page per route, rendered at build.
// tools/gen.ts turns ../*.md into content/<route>.ts and content/nav.ts from constants/navigation.ts;
// app.ts imports one page's module per route, so a reader downloads only the page it reads.
// Each route waits for the reader before its runtime loads.
use Page, Nav, Moved, Markdown, Viewport, Hit from "./components/shapes.contract"
use Sidebar from "./components/sidebar.contract"
use Article from "./components/article.contract"

font "Inter"
  400 = "assets/fonts/Inter-Regular.ttf"
  400 italic = "assets/fonts/Inter-Italic.ttf"
  500 = "assets/fonts/Inter-Medium.ttf"
  600 = "assets/fonts/Inter-SemiBold.ttf"
  700 = "assets/fonts/Inter-Bold.ttf"

font "JetBrains Mono"
  400 = "assets/fonts/JetBrainsMono-Regular.ttf"
  500 = "assets/fonts/JetBrainsMono-Medium.ttf"
  600 = "assets/fonts/JetBrainsMono-SemiBold.ttf"

routes nav
  // routes: generated by tools/gen.ts from constants/navigation.ts
  home "/" render=build activate=idle
  startHere "/start" render=build activate=idle
  contractForHumans "/learn/contract-for-humans" render=build activate=idle
