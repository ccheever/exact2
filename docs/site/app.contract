  agents "/agents" render=build activate=idle
  // routes: end
  notfound render=build activate=idle

// One layout for every width, made at build: CSS clamp() against 100vw shows the sidebar from 960px,
// "On this page" from 1280px, and the top bar with its Menu below 960px, so the page needs no runtime
// to fit its window. The not-found page resolves its URL through constants/redirects.ts (app.ts) and
// replaces it once the page shows, so a moved page and a trailing slash land on their page.
component App
  resource page = loadPage(top(nav).name) as shape Page else empty()
  resource site = loadNav() as shape Nav else empty()
  // Which chrome a reader can reach: the CSS clamp() layout draws it, and these keep what it hides
  // out of the tab order and the accessibility tree.
  resource viewport = exactViewport() as shape Viewport
  derive wide = viewport.width >= 960
  derive roomy = viewport.width >= 1280
  resource moved = resolveMoved(top(nav).name == "notfound" ? top(nav).url : "") as shape Moved else empty()
  mutation markdown as shape Markdown then copyFetched
  state menu = false
  state theme = "system" persist
  state sidebar = true persist
  state opened: string[] = []
  state navToggled: string[] = []
  state copied = false
  state voted = ""
  state active = ""
  state visible: string[] = []
  derive from = searchParam(top(nav), "from")
  derive slashless = top(nav).name == "notfound" and top(nav).url.length > 1 and top(nav).url.endsWith("/") ? top(nav).url.slice(0, top(nav).url.length - 1) : ""
  derive destination = moved.go != "" ? moved.go : slashless
  action follow(url: string)
    menu = false
    copied = false
    voted = ""
    visible = []
    active = ""
    nav = go(nav, url)
  action vote(answer: string)
    voted = answer
  action toggle(id: string)
    opened = opened.includes(id) ? opened.filter(x => x != id) : opened.concat([id])
  action pick(set: string, id: string)
    opened = opened.filter(x => not x.startsWith(`${set}|`)).concat([id])
  action copyMarkdown
    send markdown = fetchMarkdown(top(nav).name)
  action seen(id: string, entry: IntersectionObserverEntry)
    let now = entry.isIntersecting ? (visible.includes(id) ? visible : visible.concat([id])) : visible.filter(x => x != id)
    visible = now
    match first(page.toc.filter(t => now.includes(t.href.slice(1))))
      case some(t)
        active = t.href.slice(1)
      case none
        visible = now
  action copyFetched
    match markdown
      case some(m)
        copyText(m.text)
        copied = true
      case none
        copied = false
  task theming mount
    after(1, applyTheme)
  action applyTheme
    setScheme(theme)
  action chooseTheme(value: string)
    theme = value
    setScheme(value)
  action toggleNav(route: string)
    navToggled = navToggled.includes(route) ? navToggled.filter(x => x != route) : navToggled.concat([route])
  action toggleSidebar
    sidebar = not sidebar
  action toggleMenu
    menu = not menu
  action redirect(entry: IntersectionObserverEntry)
    if entry.isIntersecting and destination != ""
      nav = replace(nav, destination)
  view
    view navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" background-color="var(--color-background-screen)" font-family="var(--font-sans)" color="var(--color-text-default)"
      for e in stack(nav).slice(-1) key=e.id
        column navigationKey=`${e.id}` navigationScroll=`page-${e.id}` navigationBar="none" position="absolute" inset=0
          padding-top="clamp(0px, (960px - 100vw) * 1000, 57px)" padding-left=(sidebar ? "clamp(0px, (100vw - 960px) * 1000, 234px)" : "clamp(0px, (100vw - 960px) * 1000, 48px)") -exact-layout-transition="220ms ease"
          if e.name == "notfound"
            head title=page.title description=page.description status=404
            if destination != ""
              view intersect=redirect height=1 testId="redirect"
          else
            head title=page.title description=page.description
          scroll id=`page-${e.id}` flex=1 min-width=0 -exact-layout-transition="220ms ease" background-color="var(--color-background-default)"
            margin="clamp(-1px, (100vw - 960px) * 1000, 8px)" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-xl)"
            Article(page=page, nav=site, missing=(e.name == "notfound"), url=top(nav).url, moved=moved.to, suggestions=moved.suggestions, from=from, opened=opened, toggle=toggle, pick=pick, seen=seen, active=active, copyMarkdown=copyMarkdown, copied=copied, voted=voted, vote=vote, roomy=roomy, year=site.year, theme=theme, chooseTheme=chooseTheme)
      header appearance="none" inert=wide display="flex" align-items="center" justify-content="space-between" flex-shrink=0 overflow="hidden" position="absolute" top=0 left=0 right=0
        height="clamp(0px, (960px - 100vw) * 1000, 57px)" padding="0 16px" border-bottom="1px solid var(--color-border-secondary)" background-color="var(--color-background-default)"
        link href="/" class=Hit testId="home-bar"
          row align-items="center" gap=8
            image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
            text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
        button press=toggleMenu appearance="none" aria-expanded=menu aria-controls="site-menu" padding="6px 12px" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-lg)" testId="menu"
          row gap=6 align-items="center"
            image (menu ? "symbol:close" : "symbol:menu") aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-default)"
            text (menu ? "Close" : "Menu") font-size="var(--text-sm)"
      column width=(sidebar ? "clamp(0px, (100vw - 960px) * 1000, 234px)" : "0px") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or not sidebar) testId=(sidebar ? "sidebar-shown" : "sidebar-hidden") position="absolute" top=0 bottom=0 left=0
        row align-items="center" justify-content="space-between" padding="12px 12px 0 20px" min-width=234 box-sizing="border-box"
          link href="/" class=Hit testId="home"
            row align-items="center" gap=8
              image "symbol:icon.exactmark" aria-hidden=true width="1.625rem" height="1rem" color="var(--color-text-default)"
              text "Exact Docs" font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
          button press=toggleSidebar appearance="none" aria-label="Hide the sidebar" title="Hide the sidebar" padding=6 border-radius="var(--radius-lg)" testId="sidebar-hide"
            image "symbol:icon.panelclose" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
        scroll flex=1 min-height=0 min-width=234
          Sidebar(nav=site, current=top(nav).name, toggled=navToggled, toggle=toggleNav, prefix="")
      column width=(sidebar ? "0px" : "clamp(0px, (100vw - 960px) * 1000, 48px)") -exact-layout-transition="220ms ease" flex-shrink=0 overflow="hidden" inert=(not wide or sidebar) padding-top=12 align-items="center" testId=(sidebar ? "sidebar-rail" : "sidebar-rail-shown") position="absolute" top=0 bottom=0 left=0
        button press=toggleSidebar appearance="none" aria-label="Show the sidebar" title="Show the sidebar" padding=6 border-radius="var(--radius-lg)" testId="sidebar-show"
          image "symbol:icon.panelopen" aria-hidden=true font-size="var(--text-base)" color="var(--color-icon-default)"
      if menu
        scroll id="site-menu" flex=1 min-width=0 background-color="var(--color-background-screen)" testId="site-menu" position="absolute" top="clamp(0px, (960px - 100vw) * 1000, 57px)" left=0 right=0 bottom=0
          Sidebar(nav=site, current=top(nav).name, toggled=navToggled, toggle=toggleNav, prefix="menu-")
