  referenceDeveloperInstallationPage "/reference/developer/installation-page" render=build activate=idle
  referenceDeveloperRustLiveReplacement "/reference/developer/rust-live-replacement" render=build activate=idle
  referenceDeveloperInteractiveStressExamples "/reference/developer/interactive-stress-examples" render=build activate=idle
  referenceDeveloperTimerOptions "/reference/developer/timer-options" render=build activate=idle
  referenceDeveloperLiveTimeAndProgress "/reference/developer/live-time-and-progress" render=build activate=idle
  agentPitfalls "/reference/pitfalls" render=build activate=idle
