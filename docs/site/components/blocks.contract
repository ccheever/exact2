use Run, Block from "./shapes.contract"
use CodeBlock, Terminal from "./code.contract"

style Prose
  font-size="var(--text-base)" line-height=1.65 color="var(--color-text-secondary)"

style Cell
  padding="8px 12px" text-align="start" border-bottom="1px solid var(--color-border-secondary)" font-size="var(--text-sm)"

style Box
  border="1px solid var(--color-border-secondary)" border-radius="var(--radius-lg)" background-color="var(--color-background-subtle)"

component Runs
  props
    runs: Run[]
    weight: number
  view
    for r in runs key=r.id
      if r.code
        if r.href != ""
          text r.text font-family="var(--font-mono)" font-size="0.875em" color="var(--color-text-default)" background-color="var(--color-background-element)" border-radius=4 padding="1px 5px" text-decoration="underline" href=r.href
        else
          text r.text font-family="var(--font-mono)" font-size="0.875em" color="var(--color-text-default)" background-color="var(--color-background-element)" border-radius=4 padding="1px 5px"
      else
        if r.href != ""
          text r.text font-weight=(r.strong ? 600 : weight) font-style=(r.em ? "italic" : "normal") text-decoration="underline" color="var(--color-text-default)" href=r.href
        else
          text r.text font-weight=(r.strong ? 600 : weight) font-style=(r.em ? "italic" : "normal")

component Permalink
  props
    slug: string
  view
    link href=`#${slug}` aria-label="Link to this section"
      row
        image "symbol:link" font-size="0.7em" color="var(--color-icon-tertiary)" aria-hidden=true

component Blocks
  props
    block: Block
    opened: string[]
    toggle: action
    seen: action
  view
    if block.kind == "heading"
      if block.depth == 2
        row align-items="baseline" gap=8 margin="40px 0 8px" intersect=seen(block.href)
          h2 id=block.href testId=`h-${block.href}` font-size="var(--text-xl)" font-weight=600 letter-spacing="-0.25px" color="var(--color-text-default)"
            Runs(runs=block.runs, weight=600)
          Permalink(slug=block.href)
      else
        if block.depth == 3
          row align-items="baseline" gap=8 margin="28px 0 4px" intersect=seen(block.href)
            h3 id=block.href testId=`h-${block.href}` font-size="var(--text-base)" font-weight=600 color="var(--color-text-default)"
              Runs(runs=block.runs, weight=600)
            Permalink(slug=block.href)
        else
          row align-items="baseline" gap=8 margin="20px 0 4px"
            h4 id=block.href testId=`h-${block.href}` font-size="var(--text-sm)" font-weight=600 color="var(--color-text-default)"
              Runs(runs=block.runs, weight=600)
            Permalink(slug=block.href)
    else
      if block.kind == "paragraph"
        text class=Prose margin-top=12 margin-left=(block.depth * 24)
          Runs(runs=block.runs, weight=400)
      else
        if block.kind == "item"
          row margin-top=6 margin-left=(block.depth * 24) gap=8
            text block.text class=Prose color="var(--color-text-secondary)" flex-shrink=0
            text class=Prose flex=1 min-width=0
              Runs(runs=block.runs, weight=400)
        else
          if block.kind == "code"
            view margin-top=16 margin-left=(block.depth * 24)
              CodeBlock(lang=block.lang, source=block.text, lines=block.lines)
          else
            if block.kind == "terminal"
              view margin-top=16 margin-left=(block.depth * 24)
                Terminal(source=block.text, lines=block.lines)
            else
              if block.kind == "collapsible"
                button press=toggle(block.href) appearance="none" aria-expanded=opened.includes(block.href) class=Box margin-top=16 padding="12px 16px" display="flex" align-items="center" gap=10 text-align="start" width="100%" box-sizing="border-box" testId=`collapsible-${block.href}`
                  image "symbol:back" aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-default)" transition="rotate 200ms ease" rotate=(opened.includes(block.href) ? "270deg" : "180deg")
                  if block.lang == "prerequisites"
                    text "Prerequisites" font-size="var(--text-sm)" font-weight=600 color="var(--color-text-default)"
                    text block.text font-size="var(--text-sm)" color="var(--color-text-secondary)"
                  else
                    text block.text font-size="var(--text-sm)" font-weight=600 color="var(--color-text-default)"
              else
                if block.kind == "step"
                  row margin-top=20 margin-left=(block.depth * 24) gap=12 align-items="flex-start" testId=`step-${block.text}`
                    text block.text flex-shrink=0 width=24 height=24 line-height="24px" text-align="center" border-radius="var(--radius-full)" background-color="var(--color-background-element)" font-family="var(--font-mono)" font-size="var(--text-xs)" color="var(--color-text-default)"
                    text flex=1 min-width=0 font-size="var(--text-base)" line-height=1.5 color="var(--color-text-default)"
                      Runs(runs=block.runs, weight=600)
                else
                  if block.kind == "prerequisite"
                    row margin-top=8 padding-left=16 gap=10 align-items="flex-start"
                      text `${block.text}.` flex-shrink=0 font-family="var(--font-mono)" font-size="var(--text-sm)" color="var(--color-text-secondary)" line-height=1.65
                      text class=Prose flex=1 min-width=0
                        Runs(runs=block.runs, weight=400)
                  else
                    if block.kind == "filetree"
                      column class=Box margin-top=16 padding="12px 16px" gap=4 testId="filetree"
                        for r in block.tree key=r.id
                          row gap=8 align-items="center" padding-left=(r.depth * 18)
                            image (r.folder ? "symbol:layers" : "symbol:document") aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-tertiary)"
                            text (r.folder ? `${r.name}/` : r.name) font-family="var(--font-mono)" font-size="var(--text-sm)" color=(r.folder ? "var(--color-text-default)" : "var(--color-text-secondary)")
                    else
                      if block.kind == "callout"
                        row margin-top=16 margin-left=(block.depth * 24) gap=10 align-items="flex-start" padding="12px 16px" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-xl)" background-color="var(--color-background-subtle)" testId=`callout-${block.lang}`
                          image (block.lang == "warning" or block.lang == "caution" ? "symbol:alert" : block.lang == "tip" ? "symbol:sparkles" : "symbol:info") aria-hidden=true font-size="var(--text-base)" margin-top=3 flex-shrink=0 color=(block.lang == "warning" or block.lang == "caution" ? "var(--color-icon-warning)" : "var(--color-icon-default)")
                          text class=Prose flex=1 min-width=0
                            Runs(runs=block.runs, weight=400)
                      else
                        if block.kind == "quote"
                          text class=Prose margin-top=16 padding="12px 16px" border="1px solid var(--color-border-secondary)" border-radius="var(--radius-lg)" background-color="var(--color-background-subtle)"
                            Runs(runs=block.runs, weight=400)
                        else
                          if block.kind == "table"
                            view margin-top=16 overflow-x="auto"
                              table border-spacing=0 width="100%"
                                for r in block.rows key=r.id
                                  tr
                                    for c in r.cells key=c.id
                                      if r.header
                                        th scope="col" class=Cell font-weight=600 color="var(--color-text-secondary)"
                                          text
                                            Runs(runs=c.runs, weight=600)
                                      else
                                        td class=Cell color="var(--color-text-default)"
                                          text
                                            Runs(runs=c.runs, weight=400)
                          else
                            view margin-top=32 border-bottom="1px solid var(--color-border-secondary)"
