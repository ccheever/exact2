style FooterLink
  font-size="var(--text-sm)" color="var(--color-text-secondary)"

component ThemeButton
  props
    value: string
    label: string
    icon: string
    theme: string
    choose: action
  view
    button press=choose(value) appearance="none" role="radio" aria-checked=(theme == value) aria-label=label title=label
      padding=6 border-radius="var(--radius-full)" testId=`theme-${value}`
      background-color=(theme == value ? "var(--color-background-element)" : "transparent")
      image icon aria-hidden=true font-size="var(--text-sm)" color=(theme == value ? "var(--color-text-default)" : "var(--color-icon-tertiary)")

component Footer
  props
    year: string
    theme: string
    choose: action
  view
    footer appearance="none" display="flex" flex-wrap="wrap" align-items="center" justify-content="space-between" gap=16
      padding="24px 0 8px" border-top="1px solid var(--color-border-secondary)" testId="footer"
      row flex-wrap="wrap" gap=20 align-items="center"
        text `© ${year} Exact` font-size="var(--text-sm)" color="var(--color-text-secondary)" testId="copyright"
        link href="https://github.com/ccheever/exact2"
          row align-items="center" gap=6
            image "symbol:icon.github" aria-hidden=true font-size="var(--text-sm)" color="var(--color-icon-default)"
            text "GitHub" class=FooterLink
      row role="radiogroup" aria-label="Theme" gap=2 padding=2 border="1px solid var(--color-border-secondary)" border-radius="var(--radius-full)"
        ThemeButton(value="system", label="System theme", icon="symbol:icon.desktop", theme=theme, choose=choose)
        ThemeButton(value="light", label="Light theme", icon="symbol:icon.sun", theme=theme, choose=choose)
        ThemeButton(value="dark", label="Dark theme", icon="symbol:icon.moon", theme=theme, choose=choose)
