// Starter: a dashboard: a summary, bars that compare and the latest rows, over a source.
// Two columns on a wide window (the summary beside the rows), one on a phone; the one colour
// written is the accent, on the root.
use SummaryCard, StatBar, RowText, EmptyState from "exact:content"

routes nav
  home "/"

shape Category
  id: string
  name: string
  spent: number
  budget: number

shape Expense
  id: string
  title: string
  detail: string
  amount: number

shape Summary
  spent: number
  budget: number
  categories: list<Category>
  recent: list<Expense>

fn money(n: number): string = formatNumber(n, "currency", "USD")

component App
  state period = "month"
  resource summary = loadSummary(period) as shape Summary else empty()
  derive left = summary.budget - summary.spent
  derive detail = left < 0 ? `${money(-left)} over budget` : `${money(left)} left of ${money(summary.budget)}`
  action show(p: string)
    period = p
  action reload
    refresh summary
  view
    main testId="root" navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%"
      accent-color="-exact-system-indigo"
      each e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0
          display="flex" flex-direction="column"
          header display="flex" align-items="center" padding="8px 16px"
            text "Starter" role="heading" aria-level=1
          scroll id="content" refresh=reload refreshing=pending(summary) flex=1 min-height=0
            // Two columns on a wide window, one on a phone: each is `flex="1 1 320px"` in a
            // wrapping row, so as many 320-point columns as fit share the width. The summary
            // and its controls lead; the rows sit beside them, or under them on a phone.
            row flex-wrap="wrap" align-items="flex-start" gap=20 padding=16 max-width=1040 margin-left="auto" margin-right="auto"
              column flex="1 1 320px" min-width=0 gap=20 testId="summary"
                row role="radiogroup" aria-label="Period"
                  button role="radio" aria-checked=(period == "week") press=show("week") testId="week" flex=1
                    text "This Week"
                  button role="radio" aria-checked=(period == "month") press=show("month") testId="month" flex=1
                    text "This Month"
                SummaryCard(label="Spent", value=money(summary.spent), detail=detail, progress=some(min(1, summary.spent / summary.budget)), symbol=some("symbol:chart"))
                // On this plain page a card is `-exact-secondary-background`, as the summary's is.
                when length(summary.categories) > 0
                  column gap=14 padding=20 border-radius=16 background-color="-exact-secondary-background" testId="by-category"
                    text "By Category" role="heading" aria-level=3
                    each c in summary.categories key=c.id
                      StatBar(label=c.name, value=`${money(c.spent)} of ${money(c.budget)}`, fraction=c.spent / c.budget, tint=(c.spent > c.budget ? some("-exact-system-red") : none))
              column flex="1 1 320px" min-width=0
                when length(summary.recent) == 0
                  EmptyState(symbol="symbol:chart", title="Nothing spent this week", message="Spending shows here by category as it comes in.")
                    button press=show("month") testId="see-month"
                      text "See This Month"
                else
                  column padding="20px 20px 10px" border-radius=16 background-color="-exact-secondary-background" testId="recent"
                    text "Recent" role="heading" aria-level=3
                    each x in summary.recent key=x.id
                      RowText(title=x.title, detail=x.detail, value=some(money(x.amount)))
