// A test has no colour scheme; look at both before calling it done:
//   bun exact.mjs agent web --storage s1 "screenshot .exact/light.png" "prefer prefers-color-scheme dark" "screenshot .exact/dark.png"
test "the count grows toward the goal and survives a relaunch"
  expect state count == 0
  tap "add"
  tap "add"
  tap "remove"
  tap "add"
  expect state count == 2
  expect text "to-go" == "6 to go"
  reload
  expect state count == 2
  tap "reset"
  expect state count == 0

test "the summary says the goal"
  expect state goal.target == 8
  expect tree has "add"
