// Starter: a list that pushes a detail, a sheet to add, an alert to delete, kept in a file.
// The items are app.ts's (app:/data/items.json). A phone pushes the detail; a wide window
// shows the list beside it by itself, because a row draws the disclosure chevron
// (`contract vocab navigationSplit`). A smaller app deletes what it doesn't need: the
// delete (`askRemove`, `remove`, the dialog), the notes (the shape's field, the sheet's and
// the detail's sections), or the lock (the shape's `locked`, `setLock`, the badge, the
// switch and Delete's reason).
use Badge, EmptyState from "exact:content"

routes nav
  items "/"
    item "/item/:id"
    add "/add"

shape Item
  id: string
  title: string
  notes: string
  locked: bool

shape Reply
  ok: bool
  error: string

fn titleOf(items: list<Item>, id: string): string = match first(filter(items, i => i.id == id)) { case some(i) => i.title, case none => "" }
fn found(items: list<Item>, id: string): bool = length(filter(items, i => i.id == id)) > 0

component App
  state draftTitle = ""
  state draftNotes = ""
  state submitted = false
  resource lib = loadItems() as shape list<Item> else empty()
  mutation added as shape Reply refreshes lib then afterSave
  mutation removed as shape Reply refreshes lib
  mutation lockSaved as shape Reply refreshes lib
  derive selected = match at(filter(stack(nav), e => e.name == "item"), -1) { case some(e) => e.params.id, case none => "" }
  derive saveError = match added { case some(r) => r.error, case none => "" }
  // Said after the first Save, in red under the field; the next attempt clears it.
  derive formError = not submitted ? "" : trim(draftTitle) == "" ? "Enter a title." : pending(added) ? "" : saveError

  action openAdd
    draftTitle = ""
    draftNotes = ""
    submitted = false
    nav = push(nav, "/add")
  action back
    nav = back(nav)
  // A row is a link to its item; the browser's Back, Forward and a deep link arrive here too.
  // An item shown beside the list (a wide window) is replaced by the next one opened.
  action follow(url: string)
    nav = top(nav).name == "item" and startsWith(url, "/item/") ? replace(nav, url) : go(nav, url)
  action editTitle(v: string)
    draftTitle = v
  action editNotes(v: string)
    draftNotes = v
  action save
    submitted = true
    if trim(draftTitle) != "" and not pending(added)
      send added = addItem(trim(draftTitle), trim(draftNotes))
  // The sheet closes only on an ok reply; a refusal keeps it open, saying why.
  action afterSave
    if saveError == "" and top(nav).name == "add"
      nav = back(nav)
  action setLock(on: bool)
    send lockSaved = lockItem(selected, on)
  action askRemove
    showModal("remove")
  action remove
    send removed = removeItem(selected)
    nav = back(nav)

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="app" width="100%" height="100%"
      accent-color="-exact-system-indigo"
      each e in stack(nav) key=e.id
        when e.name == "items"
          column navigationKey=`${e.id}` navigationScroll="items-list" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              text "Starter" role="heading" aria-level=1
              button press=openAdd aria-label="Add Item" testId="add-item"
                image "symbol:add"
            list id="items-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                // A title over its notes; the chevron says the row pushes. It only navigates, so it is a link.
                each it in lib key=it.id
                  link href=path("item", it.id) testId=`item-${it.id}`
                    column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
                      text it.title
                      when it.notes != ""
                        text it.notes font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
                    // A status is a badge, not coloured text: `some("-exact-system-orange")` for Full.
                    when it.locked
                      Badge(label="Locked", tint=none)
                    image "symbol:forward-chevron"
                footer
                  text (length(lib) == 0 ? "Nothing yet. Tap + to add the first item." : "") testId="items-empty"
        when e.name == "item"
          column navigationKey=`${e.id}` navigationScroll="item-detail" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text (found(lib, e.params.id) or pending(lib) ? titleOf(lib, e.params.id) : "Not Found") role="heading" aria-level=2 testId="detail-title"
            // An id that names nothing (a stale link, /item/999) says so, once the list has loaded.
            when found(lib, e.params.id) or pending(lib)
              list id="item-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                each it in filter(lib, x => x.id == e.params.id) key=it.id
                  ItemSections(item=it, setLock=setLock, askRemove=askRemove)
            else
              EmptyState(symbol="symbol:alert", title="No such item", message="It may have been deleted.")
                button press=back buttonStyle="bordered" testId="missing-back"
                  text "Back to Items"
        when e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              button id="back" press=back testId="add-cancel"
                text "Cancel"
              text "New Item" role="heading"
              button press=save buttonStyle="bordered-prominent" testId="add-save"
                text "Save"
            list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                // The message sits in the field's row, under the field.
                row
                  column flex=1 min-width=0 gap=4
                    input value=draftTitle input=editTitle placeholder="Title" aria-label="Title"
                      autofocus=true enterkeyhint="next" testId="add-title"
                    when formError != ""
                      text formError font="-exact-footnote" color="-exact-system-red" testId="add-error"
              section
                header
                  text "Notes"
                row padding-top=8 padding-bottom=8
                  textarea value=draftNotes input=editNotes placeholder="Optional" aria-label="Notes"
                    rows=4 testId="add-notes" flex=1 min-width=0
      dialog id="remove" role="alertdialog" aria-label="Delete Item?"
        text "This can’t be undone."
        button press=remove destructive=true commandfor="remove" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"

// One item: its notes, its lock, and Delete, which asks first, or says why it can't.
component ItemSections
  props
    item: Item
    setLock: action
    askRemove: action
  view
    section
      header
        text "Notes"
      row padding-top=10 padding-bottom=10
        text (item.notes == "" ? "No notes." : item.notes) flex=1 min-width=0
          color=(item.notes == "" ? "-exact-secondary-label" : "-exact-label") testId="detail-notes"
    section
      row
        text "Locked"
        input type="checkbox" switch checked=item.locked change=setLock aria-label="Locked" testId="lock-item"
      button press=askRemove destructive=true disabled=item.locked testId="delete-item"
        text "Delete Item"
      footer
        text (item.locked ? "Unlock this item to delete it." : "") testId="delete-reason"
