// Starter: a list that pushes a detail, a sheet to add, an alert to delete, kept in a file.
// The items are app.ts's (app:/data/items.json); the order is a setting kept by `persist`.
// A phone pushes the detail; a wide window shows the list and the detail side by side.
routes nav
  items "/"
    item "/item/:id"
    add "/add"

shape Item
  id: string
  title: string
  notes: string

shape Items
  items: list<Item>

shape Reply
  ok: bool
  error: string

shape Viewport
  width: number

fn titleOf(items: list<Item>, id: string): string = match first(filter(items, i => i.id == id)) { case some(i) => i.title, case none => "" }

component App
  state order = "newest" persist
  state draftTitle = ""
  state draftNotes = ""
  state submitted = false
  state aimed = ""
  resource lib = loadItems(order) as shape Items else empty()
  resource viewport = exactViewport() as shape Viewport
  mutation added as shape Reply refreshes lib then afterSave
  mutation removed as shape Reply refreshes lib
  derive wide = viewport.width >= 720
  derive selected = match at(filter(stack(nav), e => e.name == "item"), -1) { case some(e) => e.params.id, case none => "" }
  derive titleError = trim(draftTitle) == "" ? "Enter a title." : ""
  derive saveError = match added { case some(r) => r.error, case none => "" }
  derive formError = not submitted ? "" : titleError != "" ? titleError : pending(added) ? "" : saveError

  action sort(o: string)
    order = o
  // A phone pushes the item; a wide window replaces the one beside the list.
  action open(id: string)
    nav = selected == "" ? push(nav, path("item", id)) : replace(nav, path("item", id))
  action openAdd
    draftTitle = ""
    draftNotes = ""
    submitted = false
    nav = push(nav, "/add")
  action back
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  action editTitle(v: string)
    draftTitle = v
  action editNotes(v: string)
    draftNotes = v
  action save
    submitted = true
    if titleError == "" and not pending(added)
      send added = addItem(trim(draftTitle), trim(draftNotes))
  // The sheet closes only on an ok reply; a refusal stays in it, in words.
  action afterSave
    if saveError == "" and top(nav).name == "add"
      nav = back(nav)
  action askRemove(id: string)
    aimed = id
    showModal("remove")
  action remove
    if top(nav).name == "item"
      nav = back(nav)
    send removed = removeItem(aimed)

  view
    main navigationKey=(wide and top(nav).name != "add" ? "split" : `${top(nav).id}`) navigationBack="back"
      navigate=follow testId="app" width="100%" height="100%" accent-color="-exact-system-indigo"
      when wide
        column navigationKey="split" navigationScroll="side" position="absolute" inset=0
          display="flex" flex-direction="column"
          ListHeader(order=order, sort=sort, openAdd=openAdd)
          row flex=1 min-height=0
            list id="side" appearance="auto" listStyle="inset-grouped" width=340 flex-shrink=0
              ItemRows(items=lib.items, selected=selected, pushes=false, open=open)
            column flex=1 min-width=0 border-left-width=1 border-left-style="solid" border-color="-exact-separator"
              when selected == ""
                text "Choose an item." color="-exact-secondary-label" padding=24
              else
                list id="detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                  each it in filter(lib.items, x => x.id == selected) key=it.id
                    ItemSections(item=it, titled=true, askRemove=askRemove)
      each e in stack(nav) key=e.id
        when e.name == "items" and not wide
          column navigationKey=`${e.id}` navigationScroll="items-list" position="absolute" inset=0
            display="flex" flex-direction="column"
            ListHeader(order=order, sort=sort, openAdd=openAdd)
            list id="items-list" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              ItemRows(items=lib.items, selected="", pushes=true, open=open)
        when e.name == "item" and not wide
          column navigationKey=`${e.id}` navigationScroll="item-detail" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" padding="8px 16px"
              text titleOf(lib.items, e.params.id) role="heading" aria-level=2
            list id="item-detail" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              each it in filter(lib.items, x => x.id == e.params.id) key=it.id
                ItemSections(item=it, titled=false, askRemove=askRemove)
        when e.name == "add"
          column navigationKey=`${e.id}` navigationPresentation="modal" navigationScroll="add-form" position="absolute" inset=0
            display="flex" flex-direction="column"
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              button id="back" press=back testId="add-cancel"
                text "Cancel"
              text "New Item" role="heading"
              button press=save buttonStyle="bordered-prominent" testId="add-save"
                text "Save"
            list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              section
                row
                  input appearance="none" value=draftTitle input=editTitle placeholder="Title" aria-label="Title"
                    autofocus=true enterkeyhint="next" testId="add-title" flex=1 min-width=0
                footer
                  text formError testId="add-error"
              section
                header
                  text "Notes"
                row padding-top=8 padding-bottom=8
                  textarea appearance="none" value=draftNotes input=editNotes placeholder="Optional" aria-label="Notes"
                    rows=4 testId="add-notes" flex=1 min-width=0
      dialog id="remove" role="alertdialog" aria-label="Delete Item?"
        text "This can’t be undone."
        button press=remove destructive=true commandfor="remove" command="close" testId="remove-confirm"
          text "Delete"
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"

// The list's bar: the large title, a menu for the order, and Add.
component ListHeader
  props
    order: string
    sort: action
    openAdd: action
  view
    header display="flex" align-items="center" justify-content="space-between" gap=8 padding="8px 16px"
      text "Starter" role="heading" aria-level=1 flex=1
      button popovertarget="order-menu" aria-label="Sort" testId="sort"
        image "symbol:sort"
      button press=openAdd aria-label="Add Item" testId="add-item"
        image "symbol:add"
    column id="order-menu" popover="auto" role="menu" aria-label="Sort"
      button press=sort("newest") popovertarget="order-menu" popovertargetaction="hide" testId="sort-newest"
        text "Newest First"
        when order == "newest"
          image "symbol:checkmark"
      button press=sort("title") popovertarget="order-menu" popovertargetaction="hide" testId="sort-title"
        text "Title"
        when order == "title"
          image "symbol:checkmark"

// The rows: each a title over its notes. A phone's push, so they carry the chevron;
// wide, the selected one is the accent.
component ItemRows
  props
    items: list<Item>
    selected: string
    pushes: bool
    open: action
  view
    section
      each it in items key=it.id
        button press=open(it.id) aria-current=(it.id == selected) testId=`item-${it.id}`
          column flex=1 min-width=0 gap=2 padding-top=4 padding-bottom=4
            text it.title color=(it.id == selected ? "AccentColor" : "-exact-label") white-space="nowrap"
              overflow="hidden" text-overflow="ellipsis"
            when it.notes != ""
              text it.notes font="-exact-subheadline" color="-exact-secondary-label" white-space="nowrap"
                overflow="hidden" text-overflow="ellipsis"
          when pushes
            image "symbol:forward-chevron"
      footer
        text (length(items) == 0 ? "Nothing yet. Tap + to add the first item." : "") testId="items-empty"

// One item's screen: a section per concern, and Delete, which asks first. A phone's
// bar holds the title; wide, it leads the sections.
component ItemSections
  props
    item: Item
    titled: bool
    askRemove: action
  view
    when titled
      section
        row
          text item.title font="-exact-headline" testId="detail-title"
    section
      header
        text "Notes"
      row padding-top=10 padding-bottom=10
        text (item.notes == "" ? "No notes." : item.notes) flex=1 min-width=0
          color=(item.notes == "" ? "-exact-secondary-label" : "-exact-label") testId="detail-notes"
    section
      button press=askRemove(item.id) destructive=true testId="delete-item"
        text "Delete Item"
