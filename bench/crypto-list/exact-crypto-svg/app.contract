// Crypto list (../SPEC.md, "Decisions" included) on exact2, inline-SVG variant
// (LLP 1055): the GPU app (../exact-crypto-gpu) with only the chart swapped for
// an `svg` + `polyline` and CSS `@keyframes`, and the price flash as a keyed
// CSS animation instead of the opacity-transition workaround.
// One `list virtualized=true` with one keyed `each` carries the 5,000 coins
// from `data/coins.json`. The data source (`data/`) answers the market, the
// launch config and the live ticks; everything a row looks like is this file.
//
// The chart is the `Chart` component at the bottom and nothing else refers to
// how it is drawn.
//
// Each coin's 48 prices are held once, as numbers in the row with their
// minimum and maximum, and the chart maps them to SVG `points` in the view
// (LLP 1017.003), as the SwiftUI and UIKit apps build a row's path only when it
// shows.

shape Flash
  seq: string
  up: bool
  on: bool
shape Coin
  id: string
  name: string
  ticker: string
  letter: string
  color: string
  price: string
  change: string
  up: bool
  // The last 48 prices, oldest first, and their minimum and maximum.
  series: list<number>
  lo: number
  hi: number
  // The last price's y in the chart's 96 × 32 box, where the pulse sits.
  lastY: number
  // Zero or one: the latest price flash, keyed by its sequence number.
  flash: list<Flash>
// The draw-in: `pathLength=1` makes the dash one whole line, so moving the
// offset from 1 to 0 draws it left to right.
keyframes draw
  from stroke-dashoffset=1
  to stroke-dashoffset=0

// The pulse ring: radius 3 → 9, opacity 0.5 → 0.
keyframes breathe
  from r=3 opacity=0.5
  to r=9 opacity=0

// Hidden, then shown: with `step-end` and a fill, the dot is absent for the
// 600 ms draw-in and present after it.
keyframes shown
  from opacity=0
  to opacity=1

// The price flash: the coloured copy appears opaque and fades over 400 ms.
keyframes fade
  from opacity=1
  to opacity=0

shape Market
  coins: list<Coin>
shape Config
  live: bool
  freeze: bool

component Crypto
  resource initial = market() as shape Market
  mutation changed as shape Market
  derive market = match changed { case some(m) => m, case none => initial }
  // `BENCH_LIVE`, `BENCH_SCENARIO` and `BENCH_FREEZE` are launch-environment
  // facts, so they are asked at run time (a resource would be baked with the
  // build machine's environment).
  mutation config as shape Config
  derive live = match config { case some(c) => c.live, case none => false }
  derive freeze = match config { case some(c) => c.freeze, case none => false }
  // Every 100 ms: the first tick asks for the launch config; when live, each
  // later tick advances the market.
  action tick
    match config
      case none
        send config = config()
      case some(c)
        if c.live
          send changed = tick()

  task producer mount
    every(100, tick)

  view
    main testId="crypto" viewport-fit="cover" width="100%" height="100%" box-sizing="border-box" display="flex" flex-direction="column" overflow="hidden" padding-top="env(safe-area-inset-top)" background-color="#ffffff" color="#000000" font-family="system-ui"
      row flex-shrink=0 width="100%" box-sizing="border-box" align-items="center" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-bottom-style="solid" border-bottom-width=0.5 border-color="#E5E5EA"
        text "Markets" testId="title" flex=1 font-size=17 font-weight=600
        text (live ? "Live: on" : "Live: off") testId="live" font-size=13 color="#8E8E93"
      list id="coins" virtualized=true estimated-item-height=64 testId="coins" flex=1 min-height=0 width="100%" overflow-x="hidden" background-color="#ffffff"
        each c in market.coins key=c.id
          CoinRow(c=c, freeze=freeze)

component CoinRow
  props
    c: Coin
    freeze: bool
  view
    row testId=`row-${c.id}` aria-label=`${c.name}, ${c.price}` width="100%" height=64 flex-shrink=0 box-sizing="border-box" padding-left=16 padding-right=16 gap=12 align-items="center" border-bottom-style="solid" border-bottom-width=0.5 border-color="#E5E5EA"
      row width=32 height=32 flex-shrink=0 border-radius=16 background-color=c.color align-items="center" justify-content="center"
        text c.letter font-size=15 font-weight=600 color="#ffffff"
      column flex=1 min-width=0 gap=2
        text c.name white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size=16 font-weight=600 color="#000000"
        text c.ticker white-space="nowrap" overflow="hidden" text-overflow="ellipsis" font-size=13 color="#8E8E93"
      Chart(c=c, freeze=freeze)
      column width=104 flex-shrink=0 align-items="flex-end" gap=4
        // The flash: motion animates no colour, so the flash colour is a
        // second copy of the price over the black one, a new key per update,
        // whose `fade` animation starts when it is inserted (as on the web).
        column position="relative"
          text c.price white-space="nowrap" font-size=16 font-weight=600 font-variant-numeric="tabular-nums" color="#000000"
          each f in c.flash key=f.seq
            text c.price position="absolute" top=0 left=0 white-space="nowrap" font-size=16 font-weight=600 font-variant-numeric="tabular-nums" color=(f.up ? "#16a34a" : "#dc2626") background-color="#ffffff" opacity=0 animation="fade 400ms ease both"
        text c.change white-space="nowrap" padding-top=2 padding-bottom=2 padding-left=6 padding-right=6 border-radius=4 font-size=12 font-weight=600 color="#ffffff" background-color=(c.up ? "#16a34a" : "#dc2626")

// The chart: 96 × 32 in the row's layout; the pulse ring reaches past the
// box, so the `svg` does not clip (its UA default is `overflow: hidden`).
// A price's y in the box, the minimum at the bottom (a flat series mid-way),
// and a coordinate to hundredths, as the other apps draw them. What every
// point shares (the last index, the span) is computed once per series.
fn chartY(p: number, lo: number, span: number): number = span <= 0 ? 16 : 32 - (p - lo) / span * 32
fn hundredths(v: number): number = floor(v * 100 + 0.5) / 100
fn plot(series: list<number>, last: number, lo: number, span: number): string = join(map(series, (p, i) => `${hundredths(i * 96 / last)},${hundredths(chartY(p, lo, span))}`), " ")
fn chartPoints(series: list<number>, lo: number, hi: number): string = plot(series, max(length(series), 2) - 1, lo, hi - lo)

component Chart
  props
    c: Coin
    freeze: bool
  view
    svg width=96 height=32 flex-shrink=0 viewBox="0 0 96 32" overflow="visible" color=(c.up ? "#16a34a" : "#dc2626")
      polyline points=chartPoints(c.series, c.lo, c.hi) fill="none" stroke="currentcolor" stroke-width=1.5 stroke-linejoin="round" stroke-linecap="round" pathLength=1 stroke-dasharray="1" animation=(freeze ? "none" : "draw 600ms ease-out both")
      // The ring: a disc behind the dot (SPEC Decisions), breathing once the
      // draw-in ends; frozen at radius 6 and opacity 0.25.
      circle cx=96 cy=c.lastY r=(freeze ? 6 : 3) fill="currentcolor" opacity=(freeze ? 0.25 : 0) animation=(freeze ? "none" : "breathe 1200ms ease-out 600ms infinite")
      // The dot appears when the draw-in ends.
      circle cx=96 cy=c.lastY r=3 fill="currentcolor" animation=(freeze ? "none" : "shown 600ms step-end both")
