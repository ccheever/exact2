 // ~/.claude/.credentials.json login: its refresh token is replaced whenever it's used, so a
 // copy handed to one container stops working for the next.
 function credentialName() {
+  if (process.env.CLAUDE_CREDENTIALS_FILE) return 'CLAUDE_CODE_OAUTH_TOKEN';
   for (const name of ['ANTHROPIC_API_KEY', 'CLAUDE_CODE_OAUTH_TOKEN']) if (process.env[name]) return name;
   throw new Error('No Claude credentials: set ANTHROPIC_API_KEY, or CLAUDE_CODE_OAUTH_TOKEN from `claude setup-token`');
 }
 
+// CLAUDE_CREDENTIALS_FILE: a Claude Code login (~/.claude/.credentials.json). Its access
+// token, read again before each agent, is all a container gets: the refresh token stays on
+// the host, whose own sessions keep the access token fresh.
+function subscriptionToken() {
+  const { accessToken, expiresAt } = JSON.parse(fs.readFileSync(process.env.CLAUDE_CREDENTIALS_FILE, 'utf8')).claudeAiOauth;
+  const minutes = (expiresAt - Date.now()) / 60_000;
+  if (minutes < 60) throw new Error(`the login's access token expires in ${Math.round(minutes)} min; open Claude Code on the host to refresh it`);
+  return accessToken;
+}
+
