// `pointerdown` and `pointerup` bubble to every ancestor that hears them,
// innermost first (Charlie, 2026-10-15); the innermost that hears any of the
// three holds the moves, and a `pointermove` takes no ancestor's down or up.
// A press in a popover reaches the popover's authored ancestors, and a pan
// that takes its contact takes nothing from them.
// linux: the agent's tap there is an activation, which sends no pointer events
component PointerBubble
  state log = ""
  state moves = 0
  state presses = 0
  state panned = 0
  action down(name: string)
    log = `${log} down:${name}`
  action up(name: string)
    log = `${log} up:${name}`
  action moved(e: PointerEvent)
    moves = moves + 1
  action pick
    presses = presses + 1
  action pan(dx: number, dy: number)
    panned = panned + dx
  view
    column testId="root" gap=8 padding=8 pointerdown=down("root") pointerup=up("root")
      text log testId="log"
      text `moves ${moves} presses ${presses} panned ${panned > 0}` testId="counts"
      column testId="outer" padding=8 pointerdown=down("outer") pointerup=up("outer")
        column testId="inner" padding=8 pointerdown=down("inner")
          button "Pick" press=pick testId="pick"
      column testId="moving" padding=8 pointermove=moved touch-action="none"
        button "Move" press=pick testId="move-row"
      box testId="panner" height=40 pan=pan touch-action="none"
      button "Open" popovertarget="pop" testId="open"
      column id="pop" popover="auto" testId="pop" padding=8 pointerup=up("pop")
        button "In popover" press=pick testId="pop-row"
