decoration mention color="light-dark(#1083fe, #208bfe)"
decoration link color="light-dark(#1083fe, #208bfe)" text-decoration="underline"
decoration tag color="light-dark(#1083fe, #208bfe)" background-color="light-dark(#e8f1ff, #14243a)"

component App
  state draft = "hi @alice.bsky.social see https://bsky.app #art"
  state painted = "hi @alice.bsky.social see https://bsky.app #art"
  state geometry = ""
  derive ranges = TextDecorations(value=painted, spans=[TextDecorationSpan(name="mention", start=3, end=21), TextDecorationSpan(name="link", start=26, end=42), TextDecorationSpan(name="tag", start=43, end=47)])
  action edit(value: string)
    draft = value
  action reset
    let text = "hi @alice.bsky.social see https://bsky.app #art"
    draft = text
    painted = text
  action replace
    let text = "hi @carol.bsky.social see https://bsky.app #art"
    draft = text
    painted = text
  action measure
    let caret = rangeFrame("composer", 3, 3)
    let mention = rangeFrame("composer", 3, 21)
    let past = rangeFrame("composer", 0, 999)
    geometry = caret.unavailable ? "unavailable" : `caret ${caret.width}×${caret.height} mention ${mention.width}×${mention.height} past ${past.unavailable}`
  view
    column padding=24 gap=12
      textarea id="composer" testId="composer" aria-label="Composer" value=draft input=edit decorations=ranges width=340 height=120 font-size=16
      row gap=8
        button testId="reset" press=reset
          text "Reset"
        button testId="replace" press=replace
          text "Replace mention"
        button testId="measure" press=measure
          text "Measure"
      text geometry testId="geometry"
