decoration mention color="light-dark(#1083fe, #208bfe)"
decoration link color="light-dark(#1083fe, #208bfe)" text-decoration="underline"
decoration tag color="light-dark(#1083fe, #208bfe)" background-color="light-dark(#e8f1ff, #14243a)"

component App
  state draft = "hi @alice.bsky.social see https://bsky.app #art"
  state painted = "hi @alice.bsky.social see https://bsky.app #art"
  state geometry = ""
  state sizes = ""
  state lines = ""
  derive ranges = TextDecorations(value=painted, spans=[TextDecorationSpan(name="mention", start=3, end=21), TextDecorationSpan(name="link", start=26, end=42), TextDecorationSpan(name="tag", start=43, end=47)])
  action edit(value: string)
    draft = value
  action reset
    let text = "hi @alice.bsky.social see https://bsky.app #art"
    draft = text
    painted = text
  action replace
    let text = "hi @carol.bsky.social see https://bsky.app #art"
    draft = text
    painted = text
  action measure
    let caret = rangeFrame("composer", 3, 3)
    let mention = rangeFrame("composer", 3, 21)
    let past = rangeFrame("composer", 0, 999)
    let field = frame("composer")
    // Facts every host's fonts agree on (theme2's 17:27 ruling), and the
    // sizes, which wasm and JS compare and Linux does not (its fonts are its
    // own: conform.mjs's LINUX_APART, theme2's 18:18 ruling).
    let line = mention.y == caret.y && mention.height == caret.height
    let inside = mention.x > field.x && mention.x + mention.width <= field.x + field.width && mention.y > field.y
    sizes = caret.unavailable ? "unavailable" : `caret ${caret.width}×${caret.height} mention ${mention.width}×${mention.height} past ${past.unavailable}`
    geometry = caret.unavailable ? "unavailable" : `caret width ${caret.width} mention on its line ${line} from it ${mention.x == caret.x} wide ${mention.width > caret.height * 4} inside ${inside} past ${past.unavailable}`
  action measureLines
    // The painted caret on an empty line and in an empty field (theme2's
    // 18:42 ruling), as facts every host's fonts agree on.
    let first = rangeFrame("notes", 0, 0)
    let middle = rangeFrame("notes", 2, 2)
    let next = rangeFrame("notes", 3, 3)
    let blank = rangeFrame("blank", 0, 0)
    let box = frame("blank")
    let typed = rangeFrame("typed", 0, 0)
    let typedBox = frame("typed")
    let start = round(middle.x) == round(first.x) && round(middle.x) == round(next.x)
    let between = middle.y > first.y && middle.y < next.y && round(middle.y - first.y) == round(next.y - middle.y)
    let inside = round(blank.x - box.x) == round(typed.x - typedBox.x) && round(blank.y - box.y) == round(typed.y - typedBox.y) && round(blank.height) == round(typed.height)
    lines = middle.unavailable ? "unavailable" : `empty line at the start ${start} between ${between} height ${round(middle.height) == round(first.height)} width ${middle.width}; empty field where a typed one starts ${inside} width ${blank.width}`
  view
    column padding=24 gap=12
      textarea id="composer" testId="composer" aria-label="Composer" value=draft input=edit decorations=ranges width=340 height=120 font-size=16
      row gap=8
        button testId="reset" press=reset
          text "Reset"
        button testId="replace" press=replace
          text "Replace mention"
        button testId="measure" press=measure
          text "Measure"
        button testId="measure-lines" press=measureLines
          text "Lines"
      textarea id="notes" testId="notes" aria-label="Notes" value="a\n\nb" width=200 height=80 font-size=16
      textarea id="blank" testId="blank" aria-label="Blank" value="" width=200 height=40 font-size=16
      textarea id="typed" testId="typed" aria-label="Typed" value="x" width=200 height=40 font-size=16
      text geometry testId="geometry"
