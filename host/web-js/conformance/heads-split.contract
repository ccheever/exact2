// The list stays pressable in a wide split, but only the selected route
// contributes document fields. Commit again after projection stamps the list.
routes nav
  tab items "/"
    person "/people/ada"

component HeadsSplit
  state commits = 0
  state named = true
  action detail
    nav = push(nav, "/people/ada")
  action back
    nav = back(nav)
  action commit
    commits = commits + 1
  action toggle
    named = not named
  view
    column width="100%" height="100%" display="flex" flex-direction="column" background-color="#ffffff"
      head title="Directory" description="Directory description" canonical="/directory"
      row gap=8
        button press=commit testId="commit"
          text `Commit ${commits}`
        button press=toggle testId="toggle-head"
          text "Toggle detail head"
      main navigationKey=`${top(nav).id}` navigationBack="back" position="relative" flex=1
        for e in stack(nav) key=e.id
          column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0 background-color="#ffffff"
            if e.name == "items"
              head title="Items" description="All items" canonical="/"
              list
                button press=detail testId="open-detail"
                  text "Ada"
                  image "symbol:forward-chevron" width=16 height=16
                button press=commit testId="list-commit"
                  text "Commit from list"
            if e.name == "person"
              if named
                head title="Ada"
              button press=back testId="back" id="back"
                text "Back"
              text "Ada's details"
