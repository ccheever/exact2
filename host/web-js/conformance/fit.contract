// Synthetic conformance plan: `-exact-fit="shrink"` (LLP 1116.001 D1.4). A
// readout too wide for its box draws at the scale that fits it, down to a
// floor, as both web targets pick it (navigation.js `fitText`): a literal row
// and a bound one, a text that grows and a row turned off and on again.
component Fit
  state fitted = true
  state digits = "00:00:48.12"
  action toggle
    fitted = not fitted
  action longer
    digits = `${digits}3`
  view
    column testId="root" width=320 align-items="center" gap=8
      text digits font-size=64 white-space="nowrap" font-variant-numeric="tabular-nums"
        -exact-fit="shrink" testId="readout"
      text "A label too wide to fit" font-size=40 white-space="nowrap"
        -exact-fit=(fitted ? "shrink" : "none") testId="bound"
      button press=toggle testId="toggle"
        text "Toggle"
      button press=longer testId="longer"
        text "Longer"
