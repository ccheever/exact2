// Synthetic conformance plan: the `blur` command. `blur()` drops the focus,
// whoever holds it; `blur(id)` drops it only when that node holds it
// (host/linux presenter, docs/contract-grammar.md#commands). A field that
// commits on Enter calls `blur()` — the authoring bench's todo row (LLP 1087),
// which the JavaScript target once left focused. Moving the focus from one
// field to another runs the first's `blur`, then the second's `focus`, in DOM
// order, a tap's or a `focus` command's; the JavaScript target once ran a
// command's (and the driver's `type`) the other way (splitter rough 13).
component Blur
  state text = ""
  state focused = false
  state log = ""
  action typed(v: string)
    text = v
  action focusIn
    focused = true
    log = `${log}+`
  action focusOut
    focused = false
    log = `${log}-`
  action commit(k: string)
    if k == "Enter"
      blur()
      preventDefault()
    if k == "ArrowDown"
      focus("second")
  action secondIn
    log = `${log}2`
  action secondOut
    log = `${log}/`
  action other(k: string)
    if k == "Enter"
      blur("field")
      preventDefault()
    if k == "Escape"
      blur("second")
  view
    column testId="root" gap=8 padding=8
      input id="field" value=text input=typed key=commit focus=focusIn blur=focusOut testId="field" padding=8
      input id="second" key=other focus=secondIn blur=secondOut testId="second" padding=8
      text (focused ? "focused" : "not focused") testId="state"
      text log testId="log"
