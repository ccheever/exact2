// data: native-fixture
// Structural reads: an id-less Inspect layer, a closed top layer, and an open one.
component Reads
  state hits = []
  state marked = []
  action probe
    hits = elementsFromPoint(10, 60)
    marked = querySelectorAll("[data-mood~=\"accent\"]")
  action mark
    marked = querySelectorAll("[data-mood~=\"accent\"]")
  view
    main testId="root" width=400 height=240 position="relative"
      button press=probe testId="probe"
        text "Read"
      button popovertarget="menu" testId="open" position="absolute" left=200 top=0
        text "Open"
      column id="paint-surface-card" position="absolute" left=0 top=50 width=100 height=100
        button id="paint-primary-save" data-mood="accent" width=50 height=50
          text "Save"
        column testId="layer" position="absolute" left=0 top=0 width=100 height=100
      column id="menu" popover="auto"
        button id="menu-save" data-mood="accent" press=mark testId="menu-save"
          text "Menu Save"
