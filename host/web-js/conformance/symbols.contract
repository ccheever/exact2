// LLP 1035.004.000: opaque names, empty slots and source replacement; a
// portable role no string of the plan names, built at runtime as data names
// one (ledger diary F10).
component Symbols
  state part = "cal"
  state source = "symbol:sf/airpodsmax"
  state selected = "home"
  state count = 0
  state large = false
  action missing
    source = "symbol:sf/exact.nonexistent.symbol"
  action empty
    source = "symbol:sf/"
  action restore
    source = "symbol:sf/airpodsmax"
  action portable
    source = "symbol:home"
  action raster
    source = "assets/caltrain.png"
  action resize
    large = not large
  action press
    count = count + 1
  action home
    selected = "home"
  action saved
    selected = "saved"
  view
    column padding=12 gap=12 font-size=(large ? 28 : 20) background-color="#ffffff"
      text "SF Symbols" color="#222222"
      row gap=6
        button "Missing" press=missing testId="missing"
        button "Empty" press=empty testId="empty"
        button "Restore" press=restore testId="restore"
      row gap=6
        button "Portable" press=portable testId="portable"
        button "Raster" press=raster testId="raster"
        button "Size" press=resize testId="resize"
      row gap=8 align-items="flex-start"
        image source testId="natural" -exact-tint-color="#0066cc"
        image source width=40 testId="width-only" -exact-tint-color="#0066cc"
        image source width=40 height=24 testId="fixed" -exact-tint-color="#0066cc"
        image "symbol:sf/" testId="empty-literal"
        image `symbol:${part}endar` width=24 height=24 testId="computed" -exact-tint-color="#0066cc"
      button aria-label="Count" press=press testId="count-button"
        image source width=24 height=24 testId="button-icon" -exact-tint-color="#0066cc"
      text `Count ${count}` testId="count"
      row role="tablist" testId="tabs" width=340 height=80
        button role="tab" aria-selected=(selected == "home") press=home testId="home"
          image source width=24 height=24 testId="tab-icon" -exact-tint-color="#0066cc"
          text "Home"
        button role="tab" aria-selected=(selected == "saved") press=saved testId="saved"
          image "symbol:sf/star" width=24 height=24 -exact-tint-color="#0066cc"
          text "Saved"
      row role="tablist" testId="segments" width=340 height=44
        button role="tab" aria-label="Home" aria-selected=(selected == "home") press=home testId="segment-home"
          image source width=24 height=24 testId="segment-icon" -exact-tint-color="#0066cc"
        button role="tab" aria-label="Saved" aria-selected=(selected == "saved") press=saved testId="segment-saved"
          image "symbol:sf/star" width=24 height=24 -exact-tint-color="#0066cc"
