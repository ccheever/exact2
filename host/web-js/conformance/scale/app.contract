// linux: layout
// Synthetic conformance plan: the base spacing and radius scale (LLP 1121
// stage 11, D11). Boxes whose padding and gap are space.xs to space.xl, and
// corners radius.sm to radius.full, inline and through a style, and rows
// whose gaps are space.xs to space.xl; radius.full
// on a wide and a tall box, a pill on each (every host clamps the one
// oversized length by CSS's corner overlap rule, theme2's stage 11 C ruling);
// the design's own space.md (an app's override, ruling 4) and space.header
// (a name the scale does not reserve, ruling 5); and a bound corner that
// moves between radius.md and radius.full. Every web build and the Linux host
// draw the neutral column, so all three agree. A padded box its child fills
// but for its padding holds the terminal's cells to the same rows above and
// below. A box padded `box.pad`, `calc(space.lg * 2)`, holds each host to
// its own column's evaluation of an expression (stage 12 B2): each of
// expect.json's numbers for it is space.lg × 2 in that column (Apple 20,
// neutral and Material 24, the terminal 2 cells of 8px), so a change to
// space.lg's row owes a change there.
style Card
  padding="space.lg"
  border-radius="radius.lg"

component App
  state round = false
  action flip
    round = !round
  view
    column testId="root" width=420 gap="space.sm" background-color="probe.ground"
      button testId="flip" press=flip
        text "Flip"
      view testId="r-sm" width=120 height=48 border-radius="radius.sm" background-color="probe.fill"
      view testId="r-md" width=120 height=48 border-radius="radius.md" background-color="probe.fill"
      column testId="r-lg" class=Card width=120 height=80 background-color="probe.fill"
        view testId="r-lg-inner" width=20 height=10 background-color="probe.ground"
      view testId="pill-wide" width=120 height=32 border-radius="radius.full" background-color="probe.fill"
      view testId="pill-tall" width=40 height=96 border-radius="radius.full" background-color="probe.fill"
      view testId="bound" width=120 height=40 border-radius=(round ? "radius.full" : "radius.md") background-color="probe.fill"
      view testId="header" width=120 height="space.header" background-color="probe.fill"
      column testId="even" padding="space.sm" background-color="probe.fill"
        view testId="even-inner" height=32 background-color="probe.ground"
      column testId="xs" padding="space.xs" background-color="probe.fill"
        view testId="xs-inner" width=20 height=10 background-color="probe.ground"
      column testId="sm" padding="space.sm" background-color="probe.fill"
        view testId="sm-inner" width=20 height=10 background-color="probe.ground"
      column testId="md" padding="space.md" background-color="probe.fill"
        view testId="md-inner" width=20 height=10 background-color="probe.ground"
      column testId="lg" padding="space.lg" background-color="probe.fill"
        view testId="lg-inner" width=20 height=10 background-color="probe.ground"
      column testId="xl" padding="space.xl" background-color="probe.fill"
        view testId="xl-inner" width=20 height=10 background-color="probe.ground"
      column testId="expr" padding="box.pad" background-color="probe.fill"
        view testId="expr-inner" width=20 height=10 background-color="probe.ground"
      row testId="gap-xs" gap="space.xs"
        view testId="gap-xs-a" width=20 height=10 background-color="probe.fill"
        view testId="gap-xs-b" width=20 height=10 background-color="probe.fill"
      row testId="gap-sm" gap="space.sm"
        view testId="gap-sm-a" width=20 height=10 background-color="probe.fill"
        view testId="gap-sm-b" width=20 height=10 background-color="probe.fill"
      row testId="gap-md" gap="space.md"
        view testId="gap-md-a" width=20 height=10 background-color="probe.fill"
        view testId="gap-md-b" width=20 height=10 background-color="probe.fill"
      row testId="gap-lg" gap="space.lg"
        view testId="gap-lg-a" width=20 height=10 background-color="probe.fill"
        view testId="gap-lg-b" width=20 height=10 background-color="probe.fill"
      row testId="gap-xl" gap="space.xl"
        view testId="gap-xl-a" width=20 height=10 background-color="probe.fill"
        view testId="gap-xl-b" width=20 height=10 background-color="probe.fill"
