// linux: layout
// Synthetic conformance plan: the base spacing and radius scale (LLP 1121
// stage 11, D11). Boxes whose padding and gap are space.xs to space.xl, and
// corners radius.sm to radius.full, inline and through a style; radius.full
// on a wide and a tall box, a pill on each (every host clamps the one
// oversized length by CSS's corner overlap rule, theme2's stage 11 C ruling);
// the design's own space.md (an app's override, ruling 4) and space.header
// (a name the scale does not reserve, ruling 5); and a bound corner that
// moves between radius.md and radius.full. Every web build and the Linux host
// draw the neutral column, so all three agree.
style Card
  padding="space.lg"
  border-radius="radius.lg"

component App
  state round = false
  action flip
    round = !round
  view
    column testId="root" width=420 gap="space.sm" background-color="#ffffff"
      button testId="flip" press=flip
        text "Flip"
      column testId="xs" padding="space.xs" background-color="#0000ff"
        view testId="xs-inner" width=20 height=10 background-color="#ffffff"
      column testId="sm" padding="space.sm" background-color="#0000ff"
        view testId="sm-inner" width=20 height=10 background-color="#ffffff"
      column testId="md" padding="space.md" background-color="#0000ff"
        view testId="md-inner" width=20 height=10 background-color="#ffffff"
      column testId="lg" padding="space.lg" background-color="#0000ff"
        view testId="lg-inner" width=20 height=10 background-color="#ffffff"
      column testId="xl" padding="space.xl" background-color="#0000ff"
        view testId="xl-inner" width=20 height=10 background-color="#ffffff"
      row testId="gapped" gap="space.md"
        view testId="g1" width=20 height=10 background-color="#0000ff"
        view testId="g2" width=20 height=10 background-color="#0000ff"
      view testId="r-sm" width=120 height=48 border-radius="radius.sm" background-color="#0000ff"
      view testId="r-md" width=120 height=48 border-radius="radius.md" background-color="#0000ff"
      column testId="r-lg" class=Card width=120 height=80 background-color="#0000ff"
        view testId="r-lg-inner" width=20 height=10 background-color="#ffffff"
      view testId="pill-wide" width=120 height=32 border-radius="radius.full" background-color="#0000ff"
      view testId="pill-tall" width=40 height=96 border-radius="radius.full" background-color="#0000ff"
      view testId="bound" width=120 height=40 border-radius=(round ? "radius.full" : "radius.md") background-color="#0000ff"
      view testId="header" width=120 height="space.header" background-color="#0000ff"
