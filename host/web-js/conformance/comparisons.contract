// Synthetic conformance plan (LLP 1001 §2, 2026-10-07): CSS's `min()`,
// `max()` and `clamp()` lengths, Bluesky's bottom bar and compose button
// among them — the bar padded by `clamp(15px, env(safe-area-inset-bottom),
// 60px)`, the button that far plus 15 and 44 above the page's bottom. The
// wasm page and the JS target write CSS's own functions and Chrome resolves
// them; the Linux host's kernel resolves them against its insets (zero, as
// Chrome's are here) and its viewport. A tap swaps one row's bound text
// between two comparisons, which the JS target writes as written and the
// kernel parses.
// linux: layout
component Comparisons
  state wide = false
  action flip
    wide = !wide
  view
    main testId="root" viewport-fit="cover" width="100%" height="100%" position="relative" background-color="#12081f"
      button press=flip testId="flip" width="min(50vw, 300px)" height="max(5vh, 20px)" padding-top=(wide ? "max(24px, env(safe-area-inset-top))" : "min(4px, calc(env(safe-area-inset-top) + 8px))") background-color="#7c4dff"
        text "flip" color="#ffffff"
      column testId="fab" position="absolute" right=16 width=56 height=56 border-radius="clamp(4px, 10vw, 28px)" bottom="calc(clamp(15px, env(safe-area-inset-bottom), 60px) + 15px + 44px)" background-color="#ffd60a"
      row testId="bar" position="absolute" left=0 right=0 bottom=0 height=49 padding="0 0 clamp(15px, env(safe-area-inset-bottom), 60px)" background-color="#2a9d8f"
