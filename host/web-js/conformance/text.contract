// Synthetic conformance plan (LLP 1088 D1, D2): strings compare in UTF-16
// code-unit order, and `slice`, `replaceAll` and `toLowerCase` are the web's,
// each result made well formed — beside the roster's other string and list
// entries (`at`, `join`, `includes`, `formatDate`). A `replaceAll` whose
// `$\`` grows the text quadratically traps at `MAX_STRING` on both runners:
// the action is refused and its state kept. Case fixtures use only mappings
// every Unicode version agrees on: `İ`, a final sigma, ASCII.
shape Location
  lat: number
  lon: number

shape Station
  id: string
  name: string
  zone: number
  distance: number

component Text
  resource loc = defaultLocation() as shape Location
  resource close = nearest(loc, 3) as shape Station[]
  state typed = "ΟΔΟΣ İ Paris"
  state expr = "12+3"
  state start = "09:30"
  state end = "10:00"
  state grown = "x"
  action edit(v: string)
    typed = v
  action setEnd(v: string)
    end = v
  action backspace
    expr = expr.slice(0, -1)
  action flip
    expr = expr.replaceAll("+", "-")
  action grow
    grown = "x".replaceAll("x", "0123456789abcdef").slice(0, 16).replaceAll("", "$`$'$`$'")
  action explode
    grown = grown.replaceAll("", "$`$'").replaceAll("", "$`$'").replaceAll("", "$`$'")
  view
    column testId="root" gap=4 padding=8
      input value=typed input=edit testId="typed" padding=4
      input value=end input=setEnd testId="end" padding=4
      text typed.toLowerCase() testId="lower"
      text (typed.toLowerCase().includes("paris") ? "has paris" : "no paris") testId="has"
      text (end > start ? "after" : "not after") testId="order"
      text ("" < "😀" ? "code points" : "code units") testId="units"
      text expr testId="expr"
      text expr.slice(1) testId="tail"
      text "a😀b".slice(1, 2) testId="cut"
      text "😀".replaceAll("", "-") testId="halves"
      text "😀😀".replaceAll("", "") testId="joined"
      // A literal Markdown source is built into pieces as a bound one is (it painted nothing).
      text "Go to [the other page](/other), **now**." markup="markdown" testId="markdown"
      text "abc".replaceAll("b", "[$&|$`|$'|$$|$1]") testId="subst"
      text `${grown.length}` testId="grown"
      text close.map(s => s.name.toLowerCase()).join(" < ") testId="join"
      text match close.at(-1) { case some(s) => s.name.slice(-4), case none => "" } testId="at"
      text formatDate(0, 0, "medium") testId="date"
      button "Backspace" press=backspace testId="back"
      button "Flip" press=flip testId="flip"
      button "Grow" press=grow testId="grow"
      button "Explode" press=explode testId="explode"
