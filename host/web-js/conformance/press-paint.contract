// data: svg-gallery
// Synthetic conformance plan: the pressed paint (LLP 1061 D7). While a finger
// holds a node, the web host's input piece shows its -exact-press-opacity, its
// -exact-press-background-color and its -exact-press-color (which its text
// inherits, as `color` is, unless a text writes its own), with a press
// scale beside them; a bound value follows its state.
component PressPaint
  state presses = 0
  action press
    presses = presses + 1
  view
    column testId="root" padding=40 gap=24 background-color="#ffffff" height=900 box-sizing="border-box"
      text `${presses} presses` testId="count"
      view press=press -exact-press-opacity=0.5 -exact-press-background-color="#1d4ed8" -exact-press-color="#fde047" testId="painted" width=240 height=80 background-color="#2563eb" color="#ffffff" border-radius=12 padding=12 box-sizing="border-box" gap=4
        text "Inherits the press colour" testId="inherits"
        text "Keeps its own" color="#bbf7d0" testId="keeps"
      button press=press -exact-press-scale=0.9 -exact-press-opacity=(presses % 2 == 0 ? 0.4 : 0.8) testId="both" width=200 height=60 background-color="#16a34a" border-width=0 border-radius=12
        text "Scale and dim" color="#ffffff"
