component App
  state small = true
  state omitted = false
  state zero = false
  state initial = false
  derive extent = initial ? "auto" : zero ? "0" : small ? "25vh" : "50vh"
  derive offset = zero ? 0 : small ? 10 : 20
  action resize
    small = not small
  action omit
    omitted = not omitted
  action collapse
    zero = not zero
  action reset
    initial = not initial
  view
    column background-color="#ffffff"
      row
        button "Resize" press=resize testId="resize"
        button "Omit" press=omit testId="omit"
        button "Zero" press=collapse testId="zero"
        button "Auto" press=reset testId="auto"
      svg width=200 height=400
        defs
          symbol id="shape" viewBox="0 0 100 100"
            rect width=100 height=100 fill="#0ea5e9"
          mask testId="mask" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
            rect width=100 height=100 fill="#ffffff"
          pattern testId="pattern" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
            rect width=10 height=10
          radialGradient testId="gradient" cx=(omitted ? none : extent) cy=(omitted ? none : extent) r=(omitted ? none : extent)
            stop offset="0%" stop-color="#14b8a6"
          filter testId="filter" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
            feFlood testId="primitive" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
        foreignObject testId="foreign" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
        use testId="use" href="#shape" x=(omitted ? none : offset) y=(omitted ? none : offset) width=(omitted ? none : extent) height=(omitted ? none : extent)
        svg testId="nested" x=(omitted ? none : offset) y=(omitted ? none : offset) width=100 height=(omitted ? none : extent)
          rect width="100%" height="100%" fill="#14b8a6"
