// Synthetic conformance plan: CSS `user-select: all` (CSS UI 4 §6.1). One
// click on such an element selects all of it, a paragraph, an inline run in
// its paragraph or a box of paragraphs, and a drag from outside into one
// takes it whole. Each paragraph says its part of the selection.
component SelectAll
  state path = ""
  state folder = ""
  state first = ""
  state second = ""
  action heardPath(s: Selection)
    path = `${s.text}:${s.start}-${s.end}`
  action heardFolder(s: Selection)
    folder = `${s.text}:${s.start}-${s.end}`
  action heardFirst(s: Selection)
    first = `${s.text}:${s.start}-${s.end}`
  action heardSecond(s: Selection)
    second = `${s.text}:${s.start}-${s.end}`
  view
    column padding=24 gap=16 width=360
      text "/Users/me/project/src/file.ts" user-select="all" testId="path" selectionchange=heardPath
      text testId="folder" selectionchange=heardFolder
        text "Folder: "
        text "/tmp/work" user-select="all" testId="run"
        text ". Check it."
      column user-select="all" testId="box"
        text "First line" testId="first" selectionchange=heardFirst
        text "Second line" testId="second" selectionchange=heardSecond
      text `path ${path}` testId="out-path"
      text `folder ${folder}` testId="out-folder"
      text `box ${first} ${second}` testId="out-box"
