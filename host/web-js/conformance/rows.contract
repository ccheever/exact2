// Synthetic conformance plan: per-row state in keyed rows, component
// derives, fn, map/filter, string and number formatting in the roster. A
// key that changes with its item unchanged is a new row (jukebox F19).
fn clamp(v: number, lo: number, hi: number): number = max(lo, min(hi, v))

shape Location
  lat: number
  lon: number

shape Station
  id: string
  name: string
  zone: number
  distance: number

component Rows
  resource loc = defaultLocation() as shape Location
  resource line = stations(loc) as shape list<Station>
  resource close = nearest(loc, 4) as shape list<Station>
  state near = false
  state dropped = false
  derive names = map(filter(near ? close : line, s => not dropped or s.zone != 3), s => s.name)
  state scale = 1.5
  state positioned = false
  state flex = true
  state epoch = 0
  action rekey
    epoch = epoch + 1
  action paint
    positioned = not positioned
    flex = not flex
  action reverse
    near = not near
  action drop
    dropped = not dropped
  action grow
    scale = scale * 2
  view
    column testId="root" gap=4 padding=8
      button press=reverse testId="reverse"
        text "reverse"
      button press=drop testId="drop"
        text "drop grace"
      button press=grow testId="grow"
        text `scale ${scale} floor ${floor(scale)} clamp ${clamp(scale, 0, 4)}`
      button "Toggle paint facts" press=paint testId="paint"
      button `rekey ${epoch}` press=rekey testId="rekey"
      box
        box position="absolute" width=20 height=20
        box position=(positioned ? "relative" : "static") testId="bound-position" height=20
      box display=(flex ? "flex" : "block")
        box z-index=0 width=20 height=20
        box width=20 height=20 testId="after-z"
      box
        each n in names key=n
          box height=2 testId=`paint-row-${n}`
            box position="absolute" width=1 height=1
      each n in names key=`${n}@${epoch}`
        Row(name=n)
      text `${length(names)} names, empty ${isEmpty(names)}, ${toString(1 / 3)}, ${trim("  x  ")}, ${includes("grace", "ace")}` testId="summary"

component Row
  props
    name: string
  state count = 0
  derive label = `${name} × ${count}`
  action bump
    count = count + 1
  view
    button press=bump testId=`bump-${name}`
      text label testId=`label-${name}`
