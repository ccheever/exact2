// data: sparkline
// Synthetic conformance plan: a virtualized list's row whose item leaves
// the data plays its root's `-exact-exit-animation` as its wrapper, where the
// window placed it (kernel `leaving_with`, LLP 1063), on Sparkline's sources
// and wasm (it links collections and the animation grammars): one in view,
// and one the window built below the port.
shape Coin
  id: string
  name: string
  ticker: string
  letter: string
  color: string
  price: string
  change: string
  up: bool
  points: string
  lastX: number
  lastY: number

keyframes leave
  to opacity=0 translate="-40px 0px"

style Row
  -exact-exit-animation="leave 240ms ease-in both"
  height=56 box-sizing="border-box" padding-left=12 display="flex" align-items="center" border-bottom-width=1 border-bottom-style="solid" border-color="#e5e7eb"

component ListExit
  resource coins = coins(0) as shape list<Coin>
  state a = ""
  state b = ""
  action drop
    a = "c1"
  action far
    b = "c30"
  view
    column testId="root" height="100%" display="flex" flex-direction="column"
      row gap=8 padding=8 flex-shrink=0
        button press=drop testId="drop"
          text "drop"
        button press=far testId="far"
          text "far"
      list virtualized=true estimated-item-height=56 testId="rows" flex=1 min-height=0 width="100%" overflow-x="hidden"
        each c in filter(coins, c => c.id != a and c.id != b) key=c.id
          row testId=`row-${c.id}` class=Row
            text c.name font-size=14
