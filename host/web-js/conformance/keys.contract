// Synthetic conformance plan: `key` is the DOM's keydown
// (docs/contract-grammar.md#keys). A key at a field bubbles to its
// ancestors' handlers, innermost first, and a printable one is typed unless a
// handler calls `preventDefault()` (calc F3); a grid claims ArrowDown and
// Space, so the scroller around it does not move (minesweeper F7). An action
// taking the `KeyboardEvent` reads its modifiers: a textarea's Enter sends
// and Shift+Enter breaks the line (chat F2), and ⌘S/Ctrl+S saves (kanban F27).
component Keys
  state text = ""
  state heard = ""
  state cursor = 0
  state draft = ""
  state sent = ""
  state saved = 0
  action typed(v: string)
    text = v
  action field(k: string)
    heard = `${heard}f${k}`
    if k == "x"
      preventDefault()
  action outer(k: string, e: KeyboardEvent)
    heard = `${heard}o${k}`
    if (e.metaKey or e.ctrlKey) and k == "s"
      saved = saved + 1
      preventDefault()
  action grid(k: string)
    if k == "ArrowDown"
      cursor = cursor + 1
      preventDefault()
    if k == " "
      cursor = 0
      preventDefault()
  action write(v: string)
    draft = v
  action compose(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey
      sent = draft
      draft = ""
      preventDefault()
  view
    column testId="page" key=outer height=320 overflow-y="scroll" gap=8 padding=8
      input value=text input=typed key=field testId="field" padding=8
      text heard testId="heard"
      textarea value=draft input=write key=compose testId="area" height=60
      text sent testId="sent"
      column key=grid testId="grid" height=900 background-color="#eeeeee"
        text `${cursor}` testId="cursor"
