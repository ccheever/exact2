// Synthetic conformance plan: `key` is the DOM's keydown
// (docs/contract-grammar.md#keys). A key at a field bubbles to its
// ancestors' handlers, innermost first, and a printable one is typed unless a
// handler calls `preventDefault()` (calc F3); Enter submits only when no
// handler on its path prevented it (the page's, while the field is empty);
// a grid claims ArrowDown and Space, so the scroller around it does not move
// (minesweeper F7). An action taking the `KeyboardEvent` reads its
// modifiers: a textarea's Enter sends and Shift+Enter breaks the line (chat
// F2), and ⌘S/Ctrl+S saves (kanban F27). A pressable that is no button takes
// the focus and Enter or Space presses it, as natively (chat F14).
// `selectText` focuses a field with its text selected, so the next key
// replaces it (files diary F5: the JS target did not carry it). A field's
// handler that calls `stopPropagation()` is the last to hear its key, and
// the key's default still happens: Enter submits (files diary F8). A key's
// release reaches the page's `keyup` handler with its physical `code`, a
// modifier's too (its own flag no longer held), and a held key's downs after
// the first are `repeat`s (#140).
component Keys
  state text = ""
  state heard = ""
  state cursor = 0
  state submits = 0
  state draft = ""
  state sent = ""
  state saved = 0
  state pressed = 0
  state ups = ""
  action released(k: string, e: KeyboardEvent)
    ups = `${ups}${k}:${e.code}${e.metaKey ? ":m" : ""}${e.repeat ? ":r" : ""};`
  action submitted
    submits = submits + 1
  action typed(v: string)
    text = v
  action field(k: string)
    heard = `${heard}f${k}`
    if k == "x"
      preventDefault()
    if k == "Escape" or (k == "Enter" and text == "go")
      stopPropagation()
  action outer(k: string, e: KeyboardEvent)
    heard = `${heard}o${k}${e.repeat ? "r" : ""}`
    if k == "Enter" and text == ""
      preventDefault()
    if (e.metaKey or e.ctrlKey) and k == "s"
      saved = saved + 1
      preventDefault()
  action grid(k: string)
    if k == "ArrowDown"
      cursor = cursor + 1
      preventDefault()
    if k == " "
      cursor = 0
      preventDefault()
  action hit
    pressed = pressed + 1
  action rename
    text = "report.txt"
    selectText("field")
  action write(v: string)
    draft = v
  action compose(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey
      sent = draft
      draft = ""
      preventDefault()
  view
    column testId="page" key=outer keyup=released height=320 overflow-y="scroll" gap=8 padding=8
      input value=text input=typed key=field submit=submitted testId="field" id="field" padding=8
      button "Rename" press=rename testId="rename"
      text heard testId="heard"
      text ups testId="ups"
      textarea value=draft input=write key=compose testId="area" height=60
      text sent testId="sent"
      column press=hit testId="pressable" padding=8
        text `pressed ${pressed}`
      column key=grid testId="grid" height=900 background-color="#eeeeee"
        text `${cursor}` testId="cursor"
