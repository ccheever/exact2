# A disabled box hears its wheel; a disabled button does not (all three runners).
wheel pad 40
wheel off 40
# The row's own handler, and only it, hears its contextmenu.
menu row
# Dismiss the browser's native menu before the next keyboard input.
key row Escape
# The keyboard's ContextMenu uses the same handler at the focus.
key row ContextMenu
key row Escape
# A field keeps the browser's edit menu: nothing runs.
menu area
# The outer column's handler hears a contextmenu on itself.
menu heard
# A control's input has no edit menu: the row's handler hears it, and the
# popover its node names opens.
menu check
menu other

key other Escape
key trigger ArrowDown
tap first
tap trigger
key trigger Escape
tap twice
tap outside
tap roundtrip
tap missing
tap trigger
tap trigger
