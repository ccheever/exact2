// Synthetic conformance plan: LLP 1095 D4's reach on the web. The theme
// replaces the page's colour and ground (CanvasText, Canvas), the accent,
// and a separator; unsaid text, a rule, an accent-coloured control and an
// authored accent-color below (which wins for its subtree) read them on
// both web targets alike; a `color-scheme="dark"` card,
// fixed or bound, reads the dark side; an authored colour above a card,
// fixed or bound, stays its own; a button with
// a scheme reads it too, and a field with one keeps the look's colours.
theme
  CanvasText = "light-dark(#5a1f2b, #f6e7d8)"
  Canvas = "light-dark(#fbf3e9, #1e1410)"
  AccentColor = "#c8102e"
  separator = "#d4a373"

component ThemeReach
  state on = true
  state scheme = "dark"
  state tone = "#1083fe"
  action flip(checked: bool)
    on = checked
  action plain
    tone = "inherit"
  view
    column gap=8 padding=12
      text "Unsaid" testId="unsaid"
      hr
      input type="checkbox" checked=on change=flip aria-label="On" testId="on"
      column accent-color="#1083fe"
        input type="checkbox" checked=on change=flip aria-label="Own" testId="own"
        text "Link" testId="link" color="AccentColor"
      column color-scheme="dark" background-color="Canvas" padding=8
        text "Dark" testId="dark"
        hr
        column color="#c8102e"
          column color-scheme="light"
            text "Authored" testId="authored"
      column color-scheme=scheme padding=8
        text "Bound" testId="bound"
      column color=tone
        column color-scheme="dark" background-color="Canvas" padding=8
          text "Bound authored" testId="bound-authored"
      button press=plain testId="plain"
        text "Plain"
      button press=flip(true) color-scheme="dark" background-color="Canvas" padding=8 testId="dark-button"
        text "Dark button"
      button press=flip(true) color-scheme=scheme background-color="Canvas" padding=8 testId="bound-button"
        text "Bound button"
      input type="text" value="Fixed" color-scheme="dark" aria-label="Fixed field" testId="fixed-field"
      input type="text" value="Bound" color-scheme=scheme aria-label="Bound field" testId="bound-field"
