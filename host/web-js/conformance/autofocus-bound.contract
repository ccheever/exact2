// Synthetic conformance plan: a bound `autofocus` that is false focuses
// nothing. Written as the attribute `autofocus="false"`, HTML would read
// it as true and the field would take the focus at mount; a static
// `autofocus=false` is no attribute.
component AutofocusBound
  state on = false
  state log = ""
  action focusIn
    log = `${log}+`
  view
    column
      input value="" autofocus=on focus=focusIn testId="field"
      text log testId="log"
