// data: carousel
// Synthetic conformance plan: a list in a tab that is not selected asks for
// nothing, as one on a covered route does (covered.contract); its `reachend`
// is offered once its tab shows. Both runners read an unselected tabpanel as
// inactive (runner/src/head.rs `inactive`, document.js `inactive`).
routes nav
  tab home "/"
  tab saved "/saved"

shape Card
  id: string
  n: number
  label: string
  width: number
  color: string

component CoveredTab
  resource cards = cards(2000) as shape list<Card>
  derive current = top(nav)
  state hi = 0
  state asks = 0
  derive rows = filter(cards, c => c.n < hi or c.n == 1999)
  action pick(name: string)
    nav = select(nav, name)
  action back
    nav = back(nav)
  action more
    asks = asks + 1
    hi = hi + 30
  view
    main navigationKey=`${current.id}` navigationBack="back" testId="root" width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        each t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            each e in t.stack key=e.id
              column navigationKey=`${e.id}` testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column" background-color="#ffffff"
                when e.name == "home"
                  text `${asks} asks, ${hi} rows` testId="count"
                when e.name == "saved"
                  list virtualized=true reachend=more testId="feed" flex=1 min-height=0 width="100%"
                    each c in rows key=c.id
                      row testId=`row-${c.n}` height=(c.n == 1999 ? 40 : 150) box-sizing="border-box" padding-left=12 align-items="center"
                        text (c.n == 1999 ? "Loading…" : c.label) font-size=14
      row role="tablist" flex-shrink=0 height=56
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=pick("home") testId="tab-home" flex=1
          text `Home: ${asks} asks`
        button role="tab" aria-controls="panel-saved" aria-selected=(nav.tab == "saved") press=pick("saved") testId="tab-saved" flex=1
          text "Saved"
