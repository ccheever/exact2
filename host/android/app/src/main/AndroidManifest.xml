<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- An app, not the benchmark's harness (LLP 1115.001 §3): it does not show over the keyguard, turn the screen on
         or run before the phone's first unlock. It still signs with the debug key and has no icon. -->
    <application android:label="${appName}" android:theme="@style/ExactLaunch" android:hardwareAccelerated="true">
        <profileable android:shell="true" />
        <activity android:name=".MainActivity" android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
