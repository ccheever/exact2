routes nav
  tab first "/"
    photo "/photo"
  tab second "/second"

component ZoomTabs
  state hideInPhoto = false
  action pick(name: string)
    nav = select(nav, name)
  action open
    nav = push(nav, "/photo")
  action hideAndOpen
    hideInPhoto = true
    nav = push(nav, "/photo")
  action back
    nav = back(nav)
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" width="100%" height="100%" display="flex" flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              column navigationKey=`${e.id}` navigationBar="none" navigationPresentation=(e.name == "photo" ? "fullscreen" : "") navigationSource=(e.name == "photo" ? "zoom" : "") testId=`route-${e.name}` position="absolute" inset=0 background-color=(e.name == "photo" ? "-exact-secondary-background" : "-exact-background")
                if e.name == "photo"
                  view id="zoom" testId="zoom-photo" width="100%" height="80%" background-color="AccentColor"
                  button "Close" press=back testId="close"
                else
                  view press=open id="zoom" testId="open" margin-top=100 margin-left=30 width=160 height=180 background-color="AccentColor"
                  button "Hide bar in photo" press=hideAndOpen testId="hide-open"
      row role="tablist" testId="tabs" display=(hideInPhoto && top(nav).name == "photo" ? "none" : "flex")
        button role="tab" aria-controls="panel-first" aria-selected=(nav.tab == "first") press=pick("first") flex=1
          image "symbol:home"
          text "First"
        button role="tab" aria-controls="panel-second" aria-selected=(nav.tab == "second") press=pick("second") flex=1
          image "symbol:star"
          text "Second"
