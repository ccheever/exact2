routes nav
  start "/"
    detail "/detail"
    sheet "/sheet"

component HeldRoot
  state titled = false
  action title
    titled = not titled
  view
    main navigationKey=`${top(nav).id}` testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationBar=(e.name == "start" and not titled ? "none" : "auto") navigationPresentation=(e.name == "sheet" ? "modal" : "") testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
          if titled or e.name != "start"
            header
              text e.name role="heading" aria-level=1
          scroll flex=1 min-height=0
            button "Title" press=title testId="title"
            link href="/detail" testId="detail"
              text "Detail"
            link href="/sheet" testId="sheet"
              text "Sheet"
            input value="draft" testId=`field-${e.name}`
