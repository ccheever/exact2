routes nav
  start "/"
    detail "/detail"
    sheet "/sheet"

component ProgressContexts
  view
    main navigationKey=`${top(nav).id}` accent-color="#00c800" testId="app" width="100%" height="100%"
      for e in stack(nav) key=e.id
        column navigationKey=`${e.id}` navigationPresentation=(e.name == "sheet" ? "modal" : "") testId=`route-${e.name}` position="absolute" inset=0 display="flex" flex-direction="column"
          progress accent-color="AccentColor" testId=`busy-${e.name}`
          if e.name == "start"
            list appearance="auto" flex=1 min-height=0
              section
                row testId="carried-row"
                  progress accent-color="AccentColor" testId="busy-carried"
                  text "Loading"
      dialog id="form" width=280 height=200
        progress accent-color="AccentColor" testId="busy-dialog"
      view id="popup" popover="manual" width=200 height=80
        progress accent-color="AccentColor" testId="busy-popover"
