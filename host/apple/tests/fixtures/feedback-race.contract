// A list a collection report races in (FeedbackRaceTests): wrapping rows the
// host measures, and an action that appends a row past the port, a commit
// that moves the list's snapshot on without moving what the host shows.
component App
  state rows = ["Row 0: a sentence long enough to wrap onto a second line in a narrow list", "Row 1: a sentence long enough to wrap onto a second line in a narrow list", "Row 2: a sentence long enough to wrap onto a second line in a narrow list", "Row 3: a sentence long enough to wrap onto a second line in a narrow list", "Row 4: a sentence long enough to wrap onto a second line in a narrow list", "Row 5: a sentence long enough to wrap onto a second line in a narrow list", "Row 6: a sentence long enough to wrap onto a second line in a narrow list", "Row 7: a sentence long enough to wrap onto a second line in a narrow list", "Row 8: a sentence long enough to wrap onto a second line in a narrow list", "Row 9: a sentence long enough to wrap onto a second line in a narrow list", "Row 10: a sentence long enough to wrap onto a second line in a narrow list", "Row 11: a sentence long enough to wrap onto a second line in a narrow list", "Row 12: a sentence long enough to wrap onto a second line in a narrow list", "Row 13: a sentence long enough to wrap onto a second line in a narrow list", "Row 14: a sentence long enough to wrap onto a second line in a narrow list", "Row 15: a sentence long enough to wrap onto a second line in a narrow list", "Row 16: a sentence long enough to wrap onto a second line in a narrow list", "Row 17: a sentence long enough to wrap onto a second line in a narrow list", "Row 18: a sentence long enough to wrap onto a second line in a narrow list", "Row 19: a sentence long enough to wrap onto a second line in a narrow list", "Row 20: a sentence long enough to wrap onto a second line in a narrow list", "Row 21: a sentence long enough to wrap onto a second line in a narrow list", "Row 22: a sentence long enough to wrap onto a second line in a narrow list", "Row 23: a sentence long enough to wrap onto a second line in a narrow list", "Row 24: a sentence long enough to wrap onto a second line in a narrow list", "Row 25: a sentence long enough to wrap onto a second line in a narrow list", "Row 26: a sentence long enough to wrap onto a second line in a narrow list", "Row 27: a sentence long enough to wrap onto a second line in a narrow list", "Row 28: a sentence long enough to wrap onto a second line in a narrow list", "Row 29: a sentence long enough to wrap onto a second line in a narrow list", "Row 30: a sentence long enough to wrap onto a second line in a narrow list", "Row 31: a sentence long enough to wrap onto a second line in a narrow list", "Row 32: a sentence long enough to wrap onto a second line in a narrow list", "Row 33: a sentence long enough to wrap onto a second line in a narrow list", "Row 34: a sentence long enough to wrap onto a second line in a narrow list", "Row 35: a sentence long enough to wrap onto a second line in a narrow list", "Row 36: a sentence long enough to wrap onto a second line in a narrow list", "Row 37: a sentence long enough to wrap onto a second line in a narrow list", "Row 38: a sentence long enough to wrap onto a second line in a narrow list", "Row 39: a sentence long enough to wrap onto a second line in a narrow list"]
  action more
    rows = rows.concat(["One more row, past the port"])
  view
    column width="100%" height="100%"
      button press=more testId="more"
        text "More"
      list id="feed" testId="feed" virtualized=true estimated-item-height=40 width="15rem" height=300
        for r in rows key=r
          text r padding=6
