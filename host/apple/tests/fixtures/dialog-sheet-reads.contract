// The UIKit sheet's point reads cross the native top-layer ABI.
component App
  state hit = "unread"
  state hits = "unread"
  action read(e: PointerEvent)
    hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "none" }
    hits = elementsFromPoint(e.clientX, e.clientY).join(",")
  view
    main id="page" width="100%" height="100%"
      dialog id="form" width=300 height=1800 pointermove=read
        column id="content" width=100 height=50 margin-left=20 margin-top=40
          text "Visible"
        column id="clipped" position="absolute" left=20 top=1700 width=100 height=50
          text "Clipped"
      dialog id="responsive" width="100%" height=180
        text "Sheet width"
