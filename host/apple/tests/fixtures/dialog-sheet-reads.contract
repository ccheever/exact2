// The UIKit sheet's point reads cross the native top-layer ABI.
component App
  state contentHeight = 100
  action grow
    contentHeight = 300
  state hit = "unread"
  state hits = "unread"
  state seen = false
  state observations = 0
  action intersected(e: IntersectionObserverEntry)
    seen = e.isIntersecting
    observations = observations + 1
  action read(e: PointerEvent)
    hit = match elementFromPoint(e.clientX, e.clientY) { case some(id) => id, case none => "none" }
    hits = elementsFromPoint(e.clientX, e.clientY).join(",")
  view
    main id="page" width="100%" height="100%"
      dialog id="form" width=300 height=1800 pointermove=read
        column id="content" width=100 height=50 margin-left=20 margin-top=40
          text "Visible"
        column id="clipped" intersect=intersected position="absolute" left=20 top=1700 width=100 height=50
          text "Clipped"
      dialog id="responsive" width="100%" height=180
        text "Sheet width"
      dialog id="growing" width=300
        view width=100 height=contentHeight press=grow testId="grow-sheet"
      dialog id="percentage" width=300 height="50%"
        text "Half the available height"
