component App
  state blue = false
  state shown = true
  action swap
    blue = !blue
  action remove
    shown = false
  view
    column padding=20 gap=12
      button appearance="auto" testId="photo"
        if shown
          image (blue ? "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAADAAAAAYCAYAAAC8/X7cAAAAP0lEQVR4nO3PsQ0AMAjAMP5/mh7BYFXKkN2Zmd2/44AGNKABDWhAAxrQgAY0oAENaEADGtCABjSgAQ1oQANuPW9i93nzNlyCAAAAAElFTkSuQmCC" : "data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAACAAAAAUCAYAAADskT9PAAAAJUlEQVR4nO3OIQEAAAwEoetfeovxBoGnq1tKQEBAQEBAQEBgHXhQmvs9CPiiZwAAAABJRU5ErkJggg==")
        text "Photo"
        text "Choose a picture"
      button "Swap" press=swap testId="swap"
      button "Remove" press=remove testId="remove"
