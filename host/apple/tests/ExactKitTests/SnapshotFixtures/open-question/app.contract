// LLP 1126.000 WP4's fidelity fixture: Interview's open-question widget as
// the hand-built SwiftUI baseline (`spike/1126-baseline`) has it, one entry
// per family. It says what that baseline says and no more: text styles,
// colour roles, the serif the app's headlines use, a heading for the
// accented group, `aria-label`s, and `data-privacy="public"` on what is not
// account content. The relative time is a string until WP3's `time` lands.

shape QuestionProps
  id: string
  title: string
  topic: string
  answerCount: number
  authorName: string
  authorInitials: string
  isAI: bool
  summary: string
  score: number
  answeredAgo: string

component Topic
  props
    topic: string
  view
    text topic font="-exact-caption2" font-weight=600 letter-spacing=1.2 color="-exact-secondary-label" line-clamp=1 role="heading" aria-level=6 data-privacy="public"

component Byline
  props
    name: string
    initials: string
    isAI: bool
    ago: string
  view
    column gap=3
      row gap=6 align-items="center"
        row width=20 height=20 border-radius=10 background-color="-exact-quaternary-fill" align-items="center" justify-content="center" aria-hidden=true
          text initials font-size=9 font-weight=600 font-family="ui-rounded"
        text name font="-exact-caption1" font-weight=600 line-clamp=1
        if isAI
          text "AI" font="-exact-caption2" font-weight=600 padding-left=4 padding-right=4 padding-top=1 padding-bottom=1 background-color="-exact-quaternary-fill" border-radius=4 aria-label="AI answer"
      text `${ago} ago` font="-exact-caption2" color="-exact-secondary-label" line-clamp=1 data-privacy="public"

component QuestionSmall
  props
    id: string
    title: string
    topic: string
    answerCount: number
    authorName: string
    authorInitials: string
    isAI: bool
    summary: string
    score: number
    answeredAgo: string
  view
    link href=`/prompt/${id}` width="100%" height="100%" display="flex" flex-direction="column" gap=6 color="CanvasText"
      Topic(topic=topic)
      text title font="-exact-footnote" font-family="serif" font-weight=600 line-clamp=4
      view flex=1
      Byline(name=authorName, initials=authorInitials, isAI=isAI, ago=answeredAgo)

component QuestionMedium
  props
    id: string
    title: string
    topic: string
    answerCount: number
    authorName: string
    authorInitials: string
    isAI: bool
    summary: string
    score: number
    answeredAgo: string
  view
    link href=`/prompt/${id}` width="100%" height="100%" display="flex" flex-direction="row" gap=14 color="CanvasText"
      column gap=6 flex=1 min-width=0
        Topic(topic=topic)
        text title font="-exact-subheadline" font-family="serif" font-weight=600 line-clamp=4
        view flex=1
        text `${answerCount} ${answerCount == 1 ? "perspective" : "perspectives"}` font="-exact-caption2" color="-exact-secondary-label" data-privacy="public"
      column gap=6 flex=1 min-width=0
        Byline(name=authorName, initials=authorInitials, isAI=isAI, ago=answeredAgo)
        text summary font="-exact-footnote" line-clamp=4
        view flex=1
        row gap=4 align-items="center" color="-exact-secondary-label" aria-label=`${score} upvotes` data-privacy="public"
          image "symbol:sf/arrow.up" font="-exact-caption2" font-weight=600 aria-hidden=true
          text `${score}` font="-exact-caption2" font-weight=600

component QuestionRectangular
  props
    id: string
    title: string
    topic: string
    answerCount: number
    authorName: string
    authorInitials: string
    isAI: bool
    summary: string
    score: number
    answeredAgo: string
  view
    link href=`/prompt/${id}` width="100%" height="100%" display="flex" flex-direction="column" justify-content="center" gap=2 color="CanvasText"
      row gap=4 align-items="center"
        image "symbol:sf/text.bubble" font="-exact-headline" aria-hidden=true
        text authorName font="-exact-headline" line-clamp=1 role="heading" aria-level=6
      text title font="-exact-caption1" line-clamp=2
      text `Answered ${answeredAgo} ago` font="-exact-caption2" color="-exact-secondary-label" line-clamp=1 data-privacy="public"

component App
  view
    text "The widget fixture has no app."

// Paint the driver's tests sample: gradients in the batch's forms (an
// axial ramp; an ellipse whose extent a circle would get wrong; one the
// kernel places from its CSS; a diagonal on a wide box; a ramp through
// wide stops, which crosses as srgb-linear), a dashed rectangular border
// and a dashed elliptical one, and plain text.
shape GradientProps
  label: string

component GradientCard
  props
    label: string
  view
    column width="100%" height="100%" gap=2
      view height=14 background-image="linear-gradient(to right, #ff0000, #0000ff)"
      view height=14 background-image="radial-gradient(ellipse farthest-side at 50% 50%, #00ff00, #000000)"
      view height=14 background-image="linear-gradient(to right, #ff0000 20px, #0000ff 80%)"
      view height=14 background-image="linear-gradient(45deg, #ff0000, #0000ff)"
      view height=14 background-image="linear-gradient(to right, color(display-p3 1 0 0), color(display-p3 0 0 1))"
      view height=14 border-width=2 border-style="dashed" border-color="#ff0000"
      view height=14 border-width=2 border-style="dashed" border-color="#ff0000" border-radius="50%"
      view height=14 background-color="#ff0000" opacity=0
      view height=14 background-color="#ff0000" opacity=0.5
      text label font="-exact-footnote" text-decoration="line-through"
