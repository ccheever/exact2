    { "name": "JumpIfNone", "operands": ["u32"] },
    { "name": "Unwrap", "operands": [] },
    { "name": "Call", "operands": ["enum:Stdlib"] },
    { "name": "StoreSlot", "operands": ["idx:slots"] },
    { "name": "Command", "operands": ["str", "u16"] },
    { "name": "Pop", "operands": [] },
