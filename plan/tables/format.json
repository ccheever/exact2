    { "name": "formatClockTime", "params": ["number"], "returns": "string" },
    { "name": "formatCountdownMinutes", "params": ["number", "number"], "returns": "string" },
    { "name": "formatDistance", "params": ["number"], "returns": "string" },
    { "name": "formatWalk", "params": ["number"], "returns": "string" },
