// Markdown — a reader for Markdown files.
//
// The document is data: `apps/markdown/data` reads a file on the host's
// worker and `apps/markdown/parse` turns it into the ordered blocks and
// styled runs below. Nothing here parses anything, and no file content is
// ever Contract source (LLP 1033).
//
// One field carries every way of opening a document: `⌘O`, a Finder
// double-click, `mdview README.md`, a link followed inside a document, a
// name in the folder beside this one. They are all a value arriving at
// `open-file`, which is why there is one code path and not five.

shape Theme
  page: string
  chrome: string
  edge: string
  ink: string
  strongInk: string
  softInk: string
  faintInk: string
  accent: string
  code: string
  codeBg: string
  field: string
  fieldEdge: string
  pill: string
  pillInk: string
  control: string
  quoteEdge: string
  quoteInk: string
  warnBg: string
  warnEdge: string
  warnInk: string

shape Run
  id: string
  text: string
  weight: number
  slant: string
  mono: bool
  href: string

shape Cell
  id: string
  runs: list<Run>

shape Block
  id: string
  kind: string
  depth: number
  marker: string
  text: string
  href: string
  header: bool
  runs: list<Run>
  cells: list<Cell>

shape Entry
  id: string
  name: string
  path: string
  current: bool

shape Document
  path: string
  name: string
  title: string
  message: string
  failed: bool
  count: number
  blocks: list<Block>
  siblings: list<Entry>

component Markdown
  state asked = ""
  state folder = true
  // Which appearance the reader asked for; `system` follows the OS.
  state scheme = "system"
  // What the host says the system appearance is, delivered into the
  // `appearance` node below. Only read when `scheme` is `system`.
  state systemScheme = "light"
  // The palette, as tokens rather than as literals scattered through the
  // view: exact1 called this Facet and made it a signal-backed capability;
  // here the tokens are data and `provide` carries them, the same idea in
  // the language's own terms (LLP 1033 D6). Since LLP 1034 each token is a
  // CSS `light-dark()` pair the host resolves, so this record is one
  // constant and is never re-asked when the appearance changes.
  resource theme = theme() as shape Theme
  resource doc = open(asked) as shape Document

  // What the host delivers, what the field shows, and what a followed link
  // does are one action, because they are one thing.
  action openFile(value) writes asked
    asked = value
  action toggleFolder writes folder
    folder = not folder
  action chooseScheme(name: string) writes scheme
    scheme = name
    setScheme(name)
  // The host tells the app what the system is set to, the way it tells it
  // which document to open: a value arriving at a declared node.
  action noteAppearance(value) writes systemScheme
    systemScheme = value

  // The one thing the appearance is still needed for: a PNG has no
  // `currentColor` to follow, so the artwork is chosen rather than tinted
  // (LLP 1034 D3).
  derive iconSet = (scheme == "system" ? systemScheme : scheme) == "dark" ? "-dark" : ""
  derive hasFolder = not isEmpty(doc.siblings)

  view
    provide theme = theme
      main testId="markdown-main" width="100%" height="100%" background-color=theme.page
        // The host reports the system appearance here (LLP 1033 D6),
        // as it reports an opened document at `open-file`.
        view testId="appearance" change=noteAppearance width=0 height=0
        column width="100%" height="100%"
          header width="100%" padding=10 gap=8 background-color=theme.chrome border-bottom-style="solid" border-bottom-width=1 border-color=theme.edge box-sizing="border-box"
            row gap=8 align-items="center" width="100%"
              button press=toggleFolder aria-label="Show the folder" testId="folder-toggle" padding=6 border-radius=6 background-color=theme.control
                text "Files" font-size=12 font-weight=600 color=theme.ink
              // The one node every open route ends at. A path typed here and
              // a path delivered by Launch Services are the same event.
              input value=asked change=openFile placeholder="Path to a Markdown file" aria-label="Path to a Markdown file" testId="open-file" flex=1 padding=8 border-radius=8 border-style="solid" border-width=1 border-color=theme.fieldEdge background-color=theme.field font-size=13 color=theme.ink
              text doc.name font-size=12 font-weight=600 color=theme.softInk testId="document-name"
              // Appearance: system, light, dark — the icons exact1's blog used
              // (`js/src/blog/lib/icons.ts`: monitor, sun, moon), rasterised
              // to PNG because an Exact `image` is a raster asset (LLP 1011)
              // and the Apple host decodes through ImageIO, which has no SVG.
              // Following the system is the absence of an override, not a
              // third appearance, on every host.
              SchemeButton(name="system", icon="assets/monitor", label="Follow the system", chosen=scheme, icons=iconSet, press=chooseScheme)
              SchemeButton(name="light", icon="assets/sun", label="Light", chosen=scheme, icons=iconSet, press=chooseScheme)
              SchemeButton(name="dark", icon="assets/moon", label="Dark", chosen=scheme, icons=iconSet, press=chooseScheme)
          // A file that would not open never replaces the one being read: the
          // reader says so and keeps the page (LLP 1033's milestone).
          when doc.failed
            row width="100%" padding=10 gap=8 background-color=theme.warnBg border-bottom-style="solid" border-bottom-width=1 border-color=theme.warnEdge box-sizing="border-box" testId="open-failed"
              text "Could not open" font-size=12 font-weight=700 color=theme.warnInk
              text doc.message font-size=12 color=theme.warnInk testId="open-message"
          // `min-height: 0` is what lets the panes below scroll rather than
          // grow: a flex item's default `min-height: auto` is its content, so
          // a row holding a 4,000-point document is 4,000 points tall and the
          // window merely clips it. The web has the same rule and the same fix.
          row flex=1 min-height=0 width="100%"
            when folder and hasFolder
              scroll width=230 height="100%" overflow-x="hidden" overscroll-behavior="contain" box-sizing="border-box" background-color=theme.chrome border-right-style="solid" border-right-width=1 border-color=theme.edge testId="folder"
                column width="100%" box-sizing="border-box" padding=8 gap=1
                  each e in doc.siblings key=e.id
                    FolderRow(entry=e, open=openFile)
            // A virtualized list's container takes no block-axis padding (its
            // rows are the extent), so the page's top and end space is the
            // first and last rows' own. A block's id is its index.
            list virtualized=true estimated-item-height=96 flex=1 height="100%" overflow-x="hidden" overscroll-behavior="contain" testId="document" box-sizing="border-box"
              each b in doc.blocks key=`${doc.path}:${b.id}`
                view width="100%" padding-top=(b.id == "0" ? 28 : 0) padding-bottom=(b.id == `${doc.count - 1}` ? 72 : 0) box-sizing="border-box"
                  Blocks(block=b)

component FolderRow
  inject
    theme: Theme
  props
    entry: Entry
    open: action
  view
    button press=open(entry.path) aria-label=entry.name testId=`file-${entry.id}` width="100%"
      when entry.current
        row width="100%" box-sizing="border-box" padding=6 border-radius=6 background-color=theme.pill
          text entry.name font-size=12 font-weight=600 color=theme.pillInk
      else
        row width="100%" box-sizing="border-box" padding=6 border-radius=6
          text entry.name font-size=12 color=theme.ink

// One block. A document is a flat list of these — Contract inlines
// components syntactically and cannot recurse, and a flat list is also what
// a long document needs to stay measurable one row at a time.
//
// Every block's root is the reading column itself: as wide as the pane up to
// 740, centred by its auto margins, 32 of gutter inside. A row is mounted and
// retired as the reader scrolls, so what a row is made of is what scrolling
// costs: a paragraph is one `text` node — its own padding, no box around it —
// where it used to be a text in a box in a column. A `text` that flexes says
// `min-width=0`, as it would on the web: its width is its share, and the
// layout is not asked to find its longest word first.
component Blocks
  inject
    theme: Theme
  props
    block: Block
  view
    when block.kind == "heading"
      text aria-level=block.depth testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=22 padding-bottom=6 box-sizing="border-box" color=theme.strongInk line-height=`${block.depth == 1 ? 38 : block.depth == 2 ? 30 : block.depth == 3 ? 25 : 21}px`
        Runs(runs=block.runs, size=(block.depth == 1 ? 31 : block.depth == 2 ? 23 : block.depth == 3 ? 18 : 15), weight=(block.depth > 3 ? 600 : 700))
    else
      when block.kind == "paragraph"
        text testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=6 padding-bottom=8 box-sizing="border-box" color=theme.ink line-height=1.625
          Runs(runs=block.runs, size=16, weight=400)
      else
        when block.kind == "item"
          row testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" box-sizing="border-box" padding-top=2 padding-bottom=4 padding-left=(36 + block.depth * 22) padding-right=32
            text block.marker font-size=16 line-height=1.625 color=theme.softInk width=26
            text flex=1 min-width=0 color=theme.ink line-height=1.625
              Runs(runs=block.runs, size=16, weight=400)
        else
          when block.kind == "code"
            // `pre-wrap` and not a horizontal scroll: a code block inside a
            // reading column that scrolls sideways is a code block nobody
            // reads the end of.
            view testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=8 padding-bottom=10 box-sizing="border-box"
              view background-color=theme.codeBg border-radius=10 padding=14 width="100%" box-sizing="border-box"
                text block.text font-family="ui-monospace" font-size=13 line-height="20px" color=theme.ink white-space="pre-wrap"
          else
            when block.kind == "quote"
              row testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=6 padding-bottom=8 box-sizing="border-box"
                view width=3 background-color=theme.quoteEdge border-radius=2
                text flex=1 min-width=0 padding-left=16 color=theme.quoteInk line-height=1.625
                  Runs(runs=block.runs, size=16, weight=400)
            else
              when block.kind == "rule"
                view testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=22 padding-bottom=24 box-sizing="border-box"
                  view width="100%" height=1 background-color=theme.edge
              else
                when block.kind == "table-row"
                  view testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-bottom=2 box-sizing="border-box"
                    row width="100%" border-bottom-style="solid" border-bottom-width=1 border-color=theme.edge
                      each c in block.cells key=c.id
                        when block.header
                          text flex=1 min-width=0 padding=8 color=theme.strongInk line-height="20px"
                            Runs(runs=c.runs, size=13, weight=700)
                        else
                          text flex=1 min-width=0 padding=8 color=theme.ink line-height="20px"
                            Runs(runs=c.runs, size=13, weight=400)
                else
                  when block.kind == "image"
                    column testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=10 padding-bottom=12 gap=6 box-sizing="border-box"
                      image block.href width="100%" object-fit="contain" aria-label=block.text
                      when block.text != ""
                        text block.text font-size=12 color=theme.faintInk
                  else
                    // Raw HTML: shown, never interpreted.
                    text block.text testId=`block-${block.id}` width="100%" max-width=740 margin-left="auto" margin-right="auto" padding-left=32 padding-right=32 padding-top=4 padding-bottom=6 box-sizing="border-box" font-family="ui-monospace" font-size=12 color=theme.faintInk

// The styled spans of one paragraph, as the inline `text` children the
// kernel measures as one paragraph and CoreText paints as one typeset run.
//
// Every run carries its own size, weight, height and colour: a style row
// belongs to the node it is on and does not cascade into the inline nodes
// below it, so a heading whose runs said nothing would draw at 16 px. The
// paragraph's type comes in as props and each run departs from it — bolder
// where the source said `**`, monospaced and warm where it said a backtick.
// `font-family` is literal-only in Contract v1, so that is the one branch.
component Runs
  inject
    theme: Theme
  props
    runs: list<Run>
    size: number
    weight: number
  view
    each r in runs key=r.id
      when r.mono
        text r.text font-family="ui-monospace" font-size=(size * 0.92) font-weight=(r.weight > weight ? r.weight : weight) font-style=r.slant color=theme.code href=r.href
      else
        text r.text font-size=size font-weight=(r.weight > weight ? r.weight : weight) font-style=r.slant href=r.href

// One appearance choice. The icon is a fixed grey, so which one is chosen is
// said with a pill and with opacity rather than by tinting the artwork — a
// PNG has no `currentColor` to follow.
component SchemeButton
  inject
    theme: Theme
  props
    name: string
    icon: string
    label: string
    chosen: string
    icons: string
    press: action
  view
    button press=press(name) aria-label=label testId=`scheme-${name}` padding=4 border-radius=7
      when chosen == name
        view padding=4 border-radius=7 background-color=theme.pill
          image `${icon}${icons}.png` width=16 height=16 object-fit="contain" aria-label=label
      else
        view padding=4 border-radius=7 opacity=0.45
          image `${icon}${icons}.png` width=16 height=16 object-fit="contain" aria-label=label
