// Fieldnotes: the view is Contract; durable notes and backup files live below it.
shape Note
  id: string
  title: string
  excerpt: string
  pinned: bool
shape Library
  notes: list<Note>
  total: number
  message: string
  ready: bool
shape Opened
  version: number
  title: string
  body: string
  pinned: bool
  message: string
  ready: bool
shape Saved
  id: string
  version: number
  title: string
  body: string
  pinned: bool
  revision: number
  message: string
  failed: bool
shape Status
  revision: number
  message: string
  failed: bool
  backupText: string

component Fieldnotes
  state query = ""
  state noteId = ""
  state savedId = ""
  state draftTitle = none
  state draftBody = none
  state draftPinned = none
  state originalTitle = none
  state originalBody = none
  state originalPinned = none
  state version = 0
  state backups = false
  state importText = ""
  state confirmRestore = false
  state confirmDelete = false
  mutation saved as shape Saved
  mutation status as shape Status
  derive saveRevision = match saved { case some(s) => s.revision, case none => 0 }
  derive serviceRevision = match status { case some(s) => s.revision, case none => 0 }
  resource library = library(query, saveRevision, serviceRevision) as shape Library
  mutation opened as shape Opened
  derive openedTitle = match opened { case some(n) => n.version == version ? n.title : "", case none => "" }
  derive openedBody = match opened { case some(n) => n.version == version ? n.body : "", case none => "" }
  derive openedPinned = match opened { case some(n) => n.version == version and n.pinned, case none => false }
  derive openedReady = noteId == "" or match opened { case some(n) => n.version == version and n.ready, case none => false }
  derive openInterrupted = noteId != "" and not pending(opened) and match opened { case some(n) => n.version != version, case none => true }
  derive openedMessage = match opened { case some(n) => n.version == version ? n.message : "", case none => "" }
  derive title = match draftTitle { case some(value) => value, case none => openedTitle }
  derive body = match draftBody { case some(value) => value, case none => openedBody }
  derive pinned = match draftPinned { case some(value) => value, case none => openedPinned }
  derive baseTitle = match originalTitle { case some(value) => value, case none => openedTitle }
  derive baseBody = match originalBody { case some(value) => value, case none => openedBody }
  derive basePinned = match originalPinned { case some(value) => value, case none => openedPinned }
  derive baseId = savedId != "" ? savedId : noteId
  derive editingId = match saved { case some(s) => s.version == version and not s.failed ? s.id : baseId, case none => baseId }
  derive referenceTitle = match saved { case some(s) => s.version == version and not s.failed ? s.title : baseTitle, case none => baseTitle }
  derive referenceBody = match saved { case some(s) => s.version == version and not s.failed ? s.body : baseBody, case none => baseBody }
  derive referencePinned = match saved { case some(s) => s.version == version and not s.failed ? s.pinned : basePinned, case none => basePinned }
  derive dirty = title != referenceTitle or body != referenceBody or pinned != referencePinned
  derive busy = pending(saved) or pending(status) or pending(library) or pending(opened)
  derive backupText = match status { case some(s) => s.backupText, case none => "" }

  action search(value) writes query
    query = value
  action beginSearch writes backups
    backups = false
    focus("search")
  action closeSearch writes query
    query = ""
    focus("note-body")
  action changeTitle(value) writes draftTitle
    if openedReady and not pending(opened)
      draftTitle = some(value)
  action changeBody(value) writes draftBody
    if openedReady and not pending(opened)
      draftBody = some(value)
  action togglePin writes draftPinned
    draftPinned = some(not pinned)
  action edit(id: string) writes opened, noteId, savedId, draftTitle, draftBody, draftPinned, originalTitle, originalBody, originalPinned, version, confirmDelete
    send opened = openNote(id, version + 1)
    noteId = id
    savedId = ""
    draftTitle = none
    draftBody = none
    draftPinned = none
    originalTitle = none
    originalBody = none
    originalPinned = none
    version = version + 1
    confirmDelete = false
    focus("note-body")
  action newNote writes noteId, savedId, draftTitle, draftBody, draftPinned, originalTitle, originalBody, originalPinned, version, confirmDelete, query, backups
    noteId = ""
    savedId = ""
    draftTitle = none
    draftBody = none
    draftPinned = none
    originalTitle = none
    originalBody = none
    originalPinned = none
    version = version + 1
    confirmDelete = false
    query = ""
    backups = false
    focus("note-title")
  action discard writes draftTitle, draftBody, draftPinned
    draftTitle = some(referenceTitle)
    draftBody = some(referenceBody)
    draftPinned = some(referencePinned)
  action save writes saved, savedId, originalTitle, originalBody, originalPinned
    savedId = editingId
    originalTitle = some(referenceTitle)
    originalBody = some(referenceBody)
    originalPinned = some(referencePinned)
    send saved = saveNote(editingId, title, body, pinned, version)
  action showBackups writes backups
    if backups
      focus("note-body")
    backups = not backups
  action backup writes status
    send status = backupNotes()
  action readBackup writes status
    send status = readBackup()
  action changeImport(value) writes importText
    importText = value
  action askRestore writes confirmRestore
    confirmRestore = true
  action cancelRestore writes confirmRestore
    confirmRestore = false
  action restore writes status, confirmRestore, noteId, savedId, draftTitle, draftBody, originalTitle, originalBody, draftPinned, originalPinned, version
    send status = restoreNotes(importText)
    confirmRestore = false
    noteId = ""
    savedId = ""
    draftTitle = none
    draftBody = none
    originalTitle = none
    originalBody = none
    draftPinned = none
    originalPinned = none
    version = version + 1
  action askDelete writes confirmDelete
    confirmDelete = true
  action cancelDelete writes confirmDelete
    confirmDelete = false
  action remove writes status, confirmDelete, noteId, savedId, draftTitle, draftBody, originalTitle, originalBody, draftPinned, originalPinned, version
    send status = deleteNote(editingId)
    confirmDelete = false
    noteId = ""
    savedId = ""
    draftTitle = none
    draftBody = none
    originalTitle = none
    originalBody = none
    draftPinned = none
    originalPinned = none
    version = version + 1

  view
    main testId="fieldnotes" display="flex" flex-direction="column" width="100%" height="100%" box-sizing="border-box" overflow-y="scroll" background-color="#f6f3eb" color="#263f35" padding=16 gap=16
      row justify-content="space-between" align-items="center" gap=12 flex-wrap="wrap" flex-shrink=0
        column gap=3
          text "Fieldnotes" font-family="serif" font-size=26 font-weight=400
          text "A little room for your thoughts." font-size=12 color="#63766a"
        row gap=8 align-items="center"
          button press=newNote disabled=(dirty or busy) testId="new-note" aria-label="New note" aria-keyshortcuts="Meta+N Control+N" padding=10 background-color="#31554a" border-radius=8
            row gap=6 align-items="center"
              image "symbol:add" font-size=13 font-weight=600 tint-color="#ffffff"
              text "New note" color="#ffffff" font-weight=600 font-size=13
          button press=beginSearch testId="find-notes" aria-label="Find notes" aria-keyshortcuts="Meta+F Control+F" padding=10 border-style="solid" border-width=1 border-color="#cbd3c8" border-radius=8 background-color="#f6f3eb"
            text "Find" font-size=13 color="#31554a"
          button press=showBackups testId="backups" aria-keyshortcuts=(backups ? "Escape" : "") padding=10 border-style="solid" border-width=1 border-color="#cbd3c8" border-radius=8 background-color="#f6f3eb"
            text (backups ? "Back to notes" : "Backups") font-size=13 color="#31554a"
      row justify-content="space-between" align-items="center" gap=12 flex-wrap="wrap" flex-shrink=0
        text `${library.total} ${library.total == 1 ? "note" : "notes"} · on this device` font-size=12 color="#63766a" testId="note-count"
        when busy
          text "Working…" font-size=12 color="#63766a" testId="working"
        else
          when dirty
            text "Unsaved changes" font-size=12 color="#92622f" testId="unsaved"
          else
            when library.ready
              text "All changes saved" font-size=12 color="#63766a" testId="saved-indicator"
      when library.message != ""
        text library.message font-size=13 color="#92622f" testId="library-message" flex-shrink=0
      match status
        case some(s)
          text s.message font-size=13 color=(s.failed ? "#a34336" : "#31554a") testId="status-message" flex-shrink=0
        case none
          text "Private, local, and yours." font-size=12 color="#63766a" flex-shrink=0
      when backups
        column padding=20 gap=12 background-color="#e9eee4" border-radius=12 testId="backup-panel"
          text "Keep a spare copy" font-family="serif" font-size=23
          text "Save a backup on this device, or copy the backup text somewhere safe. Restoring replaces all current notes." font-size=14 color="#63766a"
          row gap=10 flex-wrap="wrap"
            button press=backup disabled=(busy or dirty) testId="save-backup" padding=12 background-color="#31554a" border-radius=7
              text "Save backup" color="#ffffff"
            button press=readBackup disabled=busy testId="read-backup" padding=12 background-color="#ffffff" border-radius=7
              text "Show saved backup" color="#31554a"
          when backupText != ""
            textarea font-family="sans-serif" value=backupText readonly=true aria-label="Backup text to copy" testId="backup-text" height=130 width="100%" box-sizing="border-box" padding=12 font-size=12 background-color="#ffffff" border-style="solid" border-width=1 border-color="#cbd3c8" border-radius=7
          textarea font-family="sans-serif" value=importText change=changeImport aria-label="Paste a Fieldnotes backup" placeholder="Paste backup text here, or leave empty to restore this device's saved backup" testId="import-text" height=90 width="100%" box-sizing="border-box" padding=12 font-size=13 background-color="#ffffff" border-style="solid" border-width=1 border-color="#cbd3c8" border-radius=7
          when confirmRestore
            row gap=12 align-items="center" flex-wrap="wrap"
              text "Replace all notes with this backup?" font-size=14
              button press=restore disabled=(busy or dirty) testId="confirm-restore" padding=10 background-color="#a34336" border-radius=7
                text "Replace notes" color="#ffffff"
              button press=cancelRestore testId="cancel-restore" padding=10
                text "Cancel"
          else
            button press=askRestore disabled=(busy or dirty) testId="restore-backup" padding=10 align-self="flex-start"
              text "Restore backup…" color="#a34336"
      else
        row testId="workspace" flex=1 min-height=400 gap=16 flex-wrap="wrap" align-items="stretch"
          column testId="sidebar" flex=1 min-width=220 min-height=400 gap=12
            row gap=6 align-items="center" flex-shrink=0
              input id="search" value=query change=search placeholder="Search your notes" aria-label="Search notes" testId="search" flex=1 min-width=0 box-sizing="border-box" padding=12 border-style="solid" border-width=1 border-color="#cbd3c8" border-radius=9 background-color="#ffffff" font-size=14
              button press=closeSearch testId="close-search" aria-label="Close search" aria-keyshortcuts="Escape" padding=10 border-radius=8 background-color="#e9eee4"
                image "symbol:close" font-size=18 font-weight=400 tint-color="#31554a"
            scroll testId="note-list" flex=1 min-height=160
              column gap=10
                when length(library.notes) == 0
                  column padding=20 gap=8
                    text (query == "" ? "Your notebook starts here." : "No matching notes.") font-family="serif" font-size=22 testId="empty-notebook"
                    text (query == "" ? "Write a thought, a list, or something worth keeping." : "Try a different word.") font-size=14 color="#63766a"
                each note in library.notes key=note.id
                  button press=edit(note.id) disabled=(dirty or busy) testId=`note-${note.id}` aria-label=note.title padding=16 border-style="solid" border-width=1 border-color=(note.id == editingId ? "#31554a" : "#dedfd5") border-radius=9 background-color=(note.id == editingId ? "#e9eee4" : "#fcfbf7")
                    column gap=6 align-items="flex-start"
                      when note.pinned
                        text "PINNED" font-size=10 font-weight=700 letter-spacing=1 color="#7b7957"
                      text note.title font-size=17 font-weight=600 text-align="left"
                      text note.excerpt font-size=13 color="#63766a" text-align="left"
            when dirty
              text "Save or discard your draft before opening another note." font-size=12 color="#92622f"
          column testId="editor" flex=3 min-width=300 min-height=400 gap=14 padding=20 box-sizing="border-box" background-color="#fffefa" border-style="solid" border-width=1 border-color="#dedfd5" border-radius=12
            row justify-content="space-between" align-items="center"
              text (editingId == "" ? "A NEW PAGE" : "YOUR NOTE") font-size=11 font-weight=700 letter-spacing=2 color="#63766a"
              button press=togglePin disabled=(busy or not openedReady) testId="pin-note" padding=8
                text (pinned ? "Pinned" : "Pin note") font-size=13 color="#63766a"
            input id="note-title" value=(pending(opened) ? "" : title) readonly=(pending(opened) or not openedReady) change=changeTitle placeholder="Untitled note" aria-label="Note title" testId="note-title" width="100%" box-sizing="border-box" padding=10 font-family="serif" font-size=27 border-width=0 background-color="#fffefa"
            textarea id="note-body" font-family="sans-serif" value=(pending(opened) ? "" : body) readonly=(pending(opened) or not openedReady) change=changeBody placeholder="What's on your mind?" aria-label="Note body" testId="note-body" width="100%" flex=1 min-height=160 box-sizing="border-box" padding=10 font-size=16 line-height="24px" border-width=0 background-color="#fffefa"
            row gap=10 align-items="center" flex-wrap="wrap" flex-shrink=0
              button press=save disabled=(busy or not openedReady or not dirty or (title == "" and body == "")) testId="save-note" aria-keyshortcuts="Meta+S Control+S" padding=12 background-color="#31554a" border-radius=7
                text "Save note" color="#ffffff" font-weight=600
              when dirty
                button press=discard disabled=busy testId="discard" padding=12
                  text "Discard changes" color="#63766a"
              when editingId != ""
                button press=askDelete disabled=busy testId="delete-note" padding=12
                  text "Delete…" color="#a34336"
            when confirmDelete
              row gap=12 align-items="center" flex-wrap="wrap"
                text "Delete this note?" color="#a34336" font-size=14
                button press=remove disabled=busy testId="confirm-delete" padding=10
                  text "Delete note" color="#a34336" font-weight=700
                button press=cancelDelete testId="cancel-delete" padding=10
                  text "Keep it"
            when openInterrupted
              text "Opening this note was interrupted. Try again." font-size=13 color="#a34336" testId="open-interrupted"
              button press=edit(noteId) disabled=busy testId="retry-open" padding=10 align-self="flex-start"
                text "Retry opening note" color="#31554a"
            when openedMessage != ""
              text openedMessage font-size=13 color="#a34336" testId="open-message"
            match saved
              case some(s)
                when s.version == version
                  text s.message font-size=13 color=(s.failed ? "#a34336" : "#63766a") testId="save-message"
              case none
                text "Your words stay here until you choose to back them up." font-size=12 color="#63766a"
