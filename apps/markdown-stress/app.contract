// LLP 1041: real Markdown parser, blocks and styled runs from LLP 1033.
// Blocks/Runs below match apps/markdown/app.contract; no private renderer.
// The readers' palette (LLP 1095 D4), one `light-dark()` pair an entry; a
// row names an entry (`color="ink"`). The dark half is warm rather than
// blue-black, so the same documents read as the same documents, and its text
// sits below white-on-black contrast, which is what makes a long document
// comfortable at night. `apps/llp`, `apps/markdown` and
// `apps/markdown-stress` say the same palette: a theme is the root's.
theme
  page="light-dark(#ffffff, #17181b)" // behind the document
  chrome="light-dark(#f6f5f1, #1e1f23)" // header, index, outline
  edge="light-dark(#e2e1d9, #2f3138)" // the hairlines between them
  ink="light-dark(#22221b, #d4d1c9)" // running prose
  strongInk="light-dark(#16160f, #f1eee7)" // headings
  softInk="light-dark(#8a8a80, #8b8c92)" // metadata, markers, captions
  faintInk="light-dark(#b0b0a2, #63656d)" // the quietest text there is
  accent="light-dark(#4a5a3a, #a2b585)" // the brand mark, a number
  code="light-dark(#8a3020, #e0a189)" // a code span's text
  codeBg="light-dark(#f4f4f0, #23252b)" // behind a code block
  fieldBg="light-dark(#ffffff, #212329)" // inside a text field
  fieldEdge="light-dark(#d5d4cc, #3a3d45)" // its border
  pill="light-dark(#e5e8dc, #2f3a28)" // a chosen row
  pillInk="light-dark(#2c3520, #d6e4c4)" // text on a pill
  control="light-dark(#e8e7e0, #2a2c32)" // a button that is not a pill
  quoteEdge="light-dark(#d3d3c8, #3b3e46)" // the rule on a quote
  quoteInk="light-dark(#55554a, #a6a39b)" // a quote's text
  warnBg="light-dark(#fdecea, #3a1e1b)" // behind a refusal
  warnEdge="light-dark(#f5c6c0, #5d302a)" // its border
  warnInk="light-dark(#8a1c12, #f0a89c)" // its text

// Inline atoms (LLP 1045.000): a citation link is always one, a mention and
// a skill only when a face names them.
atom citation link="cite:"
atom mention prefix="@"
atom skill prefix="$" background-color="light-dark(#efe7ff, #2c2340)"

shape Run
  id: string
  text: string
  weight: number
  slant: string
  mono: bool
  href: string

shape Cell
  id: string
  runs: Run[]

shape Block
  id: string
  kind: string
  depth: number
  marker: string
  text: string
  href: string
  header: bool
  runs: Run[]
  cells: Cell[]

shape Document
  title: string
  sourceBytes: number
  totalBlocks: number
  materialized: number
  first: number
  end: number
  revision: number
  largestBlock: number
  tableRows: number
  blocks: Block[]
  source: string

component MarkdownStress
  state contentRegion = false
  state profile = "mixed"
  state size = 16384
  state revision = 0
  state page = 0
  state eager = false
  state windowed = false
  state single = false
  state wide = false
  state running = false
  state ticks = 0
  state draft = ""
  state editorText = "# A heading\n\nSome **bold**, *italic* and `code` with [a link](https://example.com).\n\n- one\n- [ ] two\n\n> quoted\n\n```\nlet a = 1;\n```"
  state draftTooLong = false
  resource doc = document(profile, size, revision, page, eager or windowed, single) as shape Document

  action enableContentRegion
    contentRegion = true

  // Explicit native trial launch: cold generation starts before first layout.
  action launchParagraph1MiB
    contentRegion = true
    profile = "paragraph"
    size = 1048576
  action launchParagraph4MiB
    contentRegion = true
    profile = "paragraph"
    size = 4194304

  action chooseProfile(value: string)
    profile = value
    page = 0
    running = false
    ticks = 0
  action chooseSize(value: number)
    size = value
    page = 0
    running = false
    ticks = 0
  action toggleEager
    eager = not eager
    windowed = false
    single = false
    page = 0
    running = false
  action toggleWindowed
    windowed = not windowed
    eager = false
    single = false
    page = 0
    running = false
  action toggleSingle
    single = not single
    eager = false
    windowed = false
    page = 0
    running = false
  action nextPage
    if doc.end < doc.totalBlocks
      page = page + 1
  action previousPage
    page = max(0, page - 1)
  action firstPage
    page = 0
  action chooseWidth(value: bool)
    wide = value
  action reparse
    revision = min(1000, revision + 1)
    running = false
  action start
    ticks = 0
    running = revision < 1000
  action pause
    running = false
  action tick
    if running
      let nextRevision = min(1000, revision + 1)
      let nextTicks = min(20, ticks + 1)
      revision = nextRevision
      ticks = nextTicks
      running = nextTicks < 20 and nextRevision < 1000
  action editMarkdown(value)
    editorText = value
  action editDraft(value)
    if value.length <= 512
      draft = value
      draftTooLong = false
    else
      draftTooLong = true
  action reset
    profile = "mixed"
    size = 16384
    revision = 0
    page = 0
    eager = false
    windowed = false
    single = false
    wide = false
    running = false
    ticks = 0
    draft = ""
    draftTooLong = false

  task producer mount
    every(1000, tick)

  view
    main testId="markdown-stress" display="flex" flex-direction="column" width="100%" height="100%" min-height=0 background-color="page" color="ink"
      column flex-shrink=0 padding=12 gap=6 width="100%" box-sizing="border-box" background-color="chrome"
        row gap=10 align-items="center" flex-wrap="wrap"
          text "Markdown stress" font-size=22 font-weight=700 color="strongInk"
          text "LLP 1041 · synthetic documents" font-size=12 color="softInk"
          button press=reset testId="reset" padding=6 background-color="control" border-width=0 border-radius=6
            text "Reset" font-size=12 color="ink"
        row gap=6 align-items="center" flex-wrap="wrap"
          ProfileButton(name="mixed", label="Mixed", chosen=profile, choose=chooseProfile)
          ProfileButton(name="paragraph", label="One long paragraph", chosen=profile, choose=chooseProfile)
          ProfileButton(name="code", label="One code block", chosen=profile, choose=chooseProfile)
          ProfileButton(name="table", label="Giant table", chosen=profile, choose=chooseProfile)
          ProfileButton(name="blocks", label="Many blocks", chosen=profile, choose=chooseProfile)
        row gap=6 align-items="center" flex-wrap="wrap"
          text "Source budget" font-size=12 color="ink"
          SizeButton(n=16384, label="16 KiB", chosen=size, choose=chooseSize)
          SizeButton(n=262144, label="256 KiB", chosen=size, choose=chooseSize)
          SizeButton(n=1048576, label="1 MiB", chosen=size, choose=chooseSize)
          SizeButton(n=4194304, label="4 MiB", chosen=size, choose=chooseSize)
          button press=toggleEager testId="toggle-eager" padding=6 background-color="control" border-width=0 border-radius=6
            text (eager ? "Use manual page" : "Render ALL blocks") font-size=12 color="ink"
          button press=toggleWindowed testId="toggle-windowed" padding=6 background-color="control" border-width=0 border-radius=6
            text (windowed ? "Use manual page" : "Window full document") font-size=12 color="ink"
          button press=toggleSingle testId="toggle-single" padding=6 background-color="control" border-width=0 border-radius=6
            text (single ? "Use manual page" : "One markup node") font-size=12 color="ink"
        row gap=6 align-items="center" flex-wrap="wrap"
          button press=chooseWidth(false) testId="width-narrow" padding=6 background-color="control" border-width=0 border-radius=6
            text "640 px column" font-size=12 color="ink"
          button press=chooseWidth(true) testId="width-wide" padding=6 background-color="control" border-width=0 border-radius=6
            text "1200 px column" font-size=12 color="ink"
          button press=reparse testId="reparse" padding=6 background-color="control" border-width=0 border-radius=6
            text "Parse again" font-size=12 color="ink"
          if running
            button press=pause testId="pause" padding=6 background-color="control" border-width=0 border-radius=6
              text "Pause" font-size=12 color="ink"
          else
            button press=start testId="start" padding=6 background-color="control" border-width=0 border-radius=6
              text "20 reparses at 1 Hz" font-size=12 color="ink"
        text `${doc.sourceBytes} source bytes · ${doc.totalBlocks} parsed blocks · ${doc.materialized} supplied blocks · ${doc.tableRows} table rows · revision ${doc.revision}` testId="stats" font-size=12 color="ink"
        text `${doc.largestBlock} text bytes in largest block · ${wide ? "1200" : "640"} px column · ${running ? "reparsing" : "paused"}` testId="load-stats" font-size=12 color="softInk"
        text (single ? "ONE NODE: the whole source as one text markup=\"markdown\" node; the host styles it (LLP 1045 D4)." : windowed ? "WINDOWED: complete parsed document; only nearby blocks mounted. One giant block remains giant." : eager ? "EAGER: all blocks mounted. Large documents may stall input." : "MANUAL PAGE: 40 blocks; the entire document is still parsed. One giant block remains giant.") testId="mode" font-size=11 color="warnInk"
      if not eager and not windowed
        row flex-shrink=0 padding=6 gap=8 flex-wrap="wrap" align-items="center" background-color="chrome"
          button press=previousPage testId="previous-page" padding=6 background-color="control" border-width=0
            text "Previous 40" font-size=12 color="ink"
          button press=nextPage testId="next-page" padding=6 background-color="control" border-width=0
            text "Next 40" font-size=12 color="ink"
          button press=firstPage testId="first-page" padding=6 background-color="control" border-width=0
            text "First page" font-size=12 color="ink"
          text `${doc.first + 1}–${doc.end} of ${doc.totalBlocks}` testId="page-range" font-size=12 color="softInk"
      if contentRegion
        view id="markdown-region-owner" width="100%" height=400 flex-shrink=0 overflow-x="hidden" overflow-y="hidden"
          view id="markdown-region-content" width="100%" height="100%" display="flex" flex-direction="column"
            if pending(doc)
              text `Generating ${profile} · ${size} byte budget…` testId="region-source-pending" font-size=14 color="ink"
            else
              DocumentBody(doc=doc, windowed=windowed, single=single, wide=wide, editorText=editorText, editMarkdown=editMarkdown)
          text "Preparing exact content…" id="markdown-region-pending" position="absolute" font-size=14 color="ink"
      else
        DocumentBody(doc=doc, windowed=windowed, single=single, wide=wide, editorText=editorText, editMarkdown=editMarkdown)
      column flex-shrink=0 padding=10 gap=4 width="100%" box-sizing="border-box" background-color="chrome"
        input appearance="none" value=draft input=editDraft testId="stress-input" aria-label="Type while Markdown reflows" placeholder="Type while scrolling, reparsing or resizing…" width="100%" box-sizing="border-box" padding=8 border-width=1 border-color="fieldEdge" background-color="fieldBg" color="ink" font-size=14
        text draft testId="stress-echo" font-size=12 color="ink"
        if draftTooLong
          text "Input limited to 512 Unicode characters; previous text retained." font-size=11 color="warnInk"

component ProfileButton
  props
    name: string
    label: string
    chosen: string
    choose: action
  view
    button press=choose(name) testId=`profile-${name}` padding=6 border-width=0 border-radius=6 background-color=(name == chosen ? "pill" : "control")
      text label font-size=12 color="ink"

component SizeButton
  props
    n: number
    label: string
    chosen: number
    choose: action
  view
    button press=choose(n) testId=`size-${n}` padding=6 border-width=0 border-radius=6 background-color=(n == chosen ? "pill" : "control")
      text label font-size=12 color="ink"

// One block. A document is a flat list of these — Contract inlines
// components syntactically and cannot recurse, and a flat list is also what
// a long document needs to stay measurable one row at a time.
component Blocks
  props
    block: Block
  view
    if block.kind == "heading"
      column width="100%" padding-top=22 padding-bottom=4 testId=`block-${block.id}`
        text role="heading" aria-level=block.depth font-size="1em" font-weight=400 color="strongInk" line-height=`${block.depth == 1 ? 38 : block.depth == 2 ? 30 : block.depth == 3 ? 25 : 21}px`
          Runs(runs=block.runs, size=(block.depth == 1 ? 31 : block.depth == 2 ? 23 : block.depth == 3 ? 18 : 15), weight=(block.depth > 3 ? 600 : 700))
    else
      if block.kind == "paragraph"
        view width="100%" padding-top=6 padding-bottom=6 testId=`block-${block.id}`
          text color="ink" line-height=1.625
            Runs(runs=block.runs, size=16, weight=400)
      else
        if block.kind == "item"
          row width="100%" box-sizing="border-box" padding-top=2 padding-bottom=2 padding-left=(4 + block.depth * 22) testId=`block-${block.id}`
            text block.marker font-size=16 line-height=1.625 color="softInk" width=26
            text flex=1 color="ink" line-height=1.625
              Runs(runs=block.runs, size=16, weight=400)
        else
          if block.kind == "code"
            // `pre-wrap` and not a horizontal scroll: a code block inside a
            // reading column that scrolls sideways is a code block nobody
            // reads the end of.
            view width="100%" padding-top=8 padding-bottom=8 testId=`block-${block.id}`
              view background-color="codeBg" border-radius=10 padding=14 width="100%" box-sizing="border-box"
                text block.text font-family="ui-monospace" font-size=13 line-height="20px" color="ink" white-space="pre-wrap"
          else
            if block.kind == "quote"
              row width="100%" padding-top=6 padding-bottom=6 testId=`block-${block.id}`
                view width=3 background-color="quoteEdge" border-radius=2
                view flex=1 padding-left=16
                  text color="quoteInk" line-height=1.625
                    Runs(runs=block.runs, size=16, weight=400)
            else
              if block.kind == "rule"
                view width="100%" height=1 background-color="edge" margin-top=22 margin-bottom=22 testId=`block-${block.id}`
              else
                if block.kind == "table-row"
                  row width="100%" border-bottom-style="solid" border-bottom-width=1 border-color="edge" testId=`block-${block.id}`
                    for c in block.cells key=c.id
                      view flex=1 padding=8
                        if block.header
                          text color="strongInk" line-height="20px"
                            Runs(runs=c.runs, size=13, weight=700)
                        else
                          text color="ink" line-height="20px"
                            Runs(runs=c.runs, size=13, weight=400)
                else
                  if block.kind == "image"
                    column width="100%" padding-top=10 padding-bottom=10 gap=6 testId=`block-${block.id}`
                      image block.href width="100%" object-fit="contain" aria-label=block.text
                      if block.text != ""
                        text block.text font-size=12 color="faintInk"
                  else
                    // Raw HTML: shown, never interpreted.
                    view width="100%" padding-top=4 padding-bottom=4 testId=`block-${block.id}`
                      text block.text font-family="ui-monospace" font-size=12 color="faintInk"

// The styled spans of one paragraph, as the inline `text` children the
// kernel measures as one paragraph and CoreText paints as one typeset run.
//
// Every run carries its own size, weight, height and colour: a style row
// belongs to the node it is on and does not cascade into the inline nodes
// below it, so a heading whose runs said nothing would draw at 16 px. The
// paragraph's type comes in as props and each run departs from it — bolder
// where the source said `**`, monospaced and warm where it said a backtick.
// `font-family` is literal-only in Contract v1, so that is the one branch.
component Runs
  props
    runs: Run[]
    size: number
    weight: number
  view
    for r in runs key=r.id
      if r.mono
        text r.text font-family="ui-monospace" font-size=(size * 0.92) font-weight=(r.weight > weight ? r.weight : weight) font-style=r.slant color="code" href=r.href
      else
        text r.text font-size=size font-weight=(r.weight > weight ? r.weight : weight) font-style=r.slant href=r.href

// Same parsed blocks and renderer in both modes. Only the explicit native
// launch action selects the independently sized content/placeholder wrapper.
component DocumentBody
  props
    doc: Document
    windowed: bool
    single: bool
    wide: bool
    editorText: string
    editMarkdown: action
  state formats = ""
  state mixed = false
  state currentLink = ""
  state unavailable = ""
  state linkOpen = false
  state linkUrl = ""
  // The atom fixture (LLP 1045.000 §5 stage 1).
  state atomText = "Ask [Assistant quote](cite://v1/quote?text=a%20long%20quoted%20passage) about @src/main.rs and $tidy here.\n\n@a-very-long-file-name-that-does-not-fit-in-a-narrow-field.rs [B](cite:2)[C](cite:3) end"
  state atomPress = ""
  state atomSelected = ""
  // Each face paints its atom over its kind's (LLP 1045.000 D2): `tidy` is green, not the skill's violet.
  derive atomFaces = [AtomFace(source="@src/main.rs", label="main.rs", icon="", title="src/main.rs", color="light-dark(#0f5fa8, #8cc4ff)", backgroundColor="light-dark(#1a85d424, #69b1ff33)", direction=""), AtomFace(source="$tidy", label="tidy", icon="", title="Skill: tidy", color="light-dark(#137a35, #7ad893)", backgroundColor="light-dark(#199f4324, #5ecc7133)", direction=""), AtomFace(source="@a-very-long-file-name-that-does-not-fit-in-a-narrow-field.rs", label="", icon="", title="", color="light-dark(#b5242d, #ff8f8a)", backgroundColor="light-dark(#d52c3624, #ff676233)", direction="")]
  // A right-to-left line's pills (LLP 1045.000 D4): each in its line's
  // direction, but those whose faces pin left to right. Apple draws a
  // `symbol:sf/` icon and the web an image's, so each host shows two.
  state atomRtl = "שאל את @notes ואת @pinned כאן\n\nבדוק את @web ואת @webpin כאן"
  derive atomRtlFaces = [AtomFace(source="@notes", label="notes…", icon="symbol:sf/doc.text", title="", color="", backgroundColor="", direction=""), AtomFace(source="@pinned", label="pinned…", icon="symbol:sf/doc.text", title="", color="", backgroundColor="", direction="ltr"), AtomFace(source="@web", label="notes…", icon="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Cpath d=%27M3 1h7l3 3v11H3z%27 fill=%27%236b7280%27/%3E%3C/svg%3E", title="", color="", backgroundColor="", direction=""), AtomFace(source="@webpin", label="pinned…", icon="data:image/svg+xml,%3Csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 16 16%27%3E%3Cpath d=%27M3 1h7l3 3v11H3z%27 fill=%27%236b7280%27/%3E%3C/svg%3E", title="", color="", backgroundColor="", direction="ltr")]
  action editRtl(value)
    atomRtl = value
  action editAtoms(value)
    atomText = value
  action pressedAtom(e: AtomEvent)
    atomPress = `${e.kind} ${e.start}-${e.end}${e.metaKey ? " meta" : ""}`
  action selectedAtom(s)
    atomSelected = s.atom
  action selected(s)
    formats = s.formats
    mixed = s.mixed
    currentLink = s.link
    unavailable = s.unavailable
  action applyFormat(name: string)
    format("markup-editor", name)
  action heading
    format("markup-editor", "heading", "2")
  action openLink
    linkOpen = true
    linkUrl = currentLink
    focus("markup-link-url")
  action linkChanged(value)
    linkUrl = value
  action applyLink
    format("markup-editor", "link", linkUrl)
    linkOpen = false
    focus("markup-editor")
  action cancelLink
    linkOpen = false
    focus("markup-editor")
  view
    if single
      scroll testId="document" flex=1 min-height=60 width="100%" overflow-x="hidden" overscroll-behavior="contain"
        column width="100%" align-items="center" padding-top=16 padding-bottom=64
          column width="100%" max-width=(wide ? 1200 : 640) padding-left=20 padding-right=20 box-sizing="border-box" testId="reading-column" gap=16
            // The WYSIWYG editor prototype (LLP 1045 D5): the same source
            // string the one-node reader below it draws.
            row role="toolbar" aria-label="Markdown formatting" gap=6 flex-wrap="wrap"
              MarkdownTool(name="bold", label="Bold", formats=formats, unavailable=unavailable, apply=applyFormat)
              MarkdownTool(name="italic", label="Italic", formats=formats, unavailable=unavailable, apply=applyFormat)
              MarkdownTool(name="code", label="Code", formats=formats, unavailable=unavailable, apply=applyFormat)
              MarkdownTool(name="bullet", label="List", formats=formats, unavailable=unavailable, apply=applyFormat)
              MarkdownTool(name="quote", label="Quote", formats=formats, unavailable=unavailable, apply=applyFormat)
              button press=heading retainFocus=true testId="format-heading" aria-label=(` ${formats} `.includes(" heading2 ") ? "Heading 2 active" : "Heading 2") border-width=1 border-color=(` ${formats} `.includes(" heading2 ") ? "ink" : "#00000000") disabled=` ${unavailable} `.includes(" heading ") min-height=40 padding=8 background-color="control" border-radius=6
                text "H2" font-size=13 color="ink"
              button press=openLink retainFocus=true testId="format-link" aria-label=(` ${formats} `.includes(" link ") ? "Link active" : "Link") border-width=1 border-color=(` ${formats} `.includes(" link ") ? "ink" : "#00000000") disabled=` ${unavailable} `.includes(" link ") min-height=40 padding=8 background-color="control" border-radius=6
                text "Link" font-size=13 color="ink"
            if linkOpen
              row gap=6 align-items="center" width="100%"
                input id="markup-link-url" value=linkUrl input=linkChanged submit=applyLink aria-label="Link URL" placeholder="https://example.com" testId="markup-link-url" flex=1 min-width=0 padding=8
                button appearance="none" press=applyLink retainFocus=true testId="apply-link" min-height=40 padding=8
                  text (linkUrl == "" ? "Remove link" : "Apply") font-size=13 color="ink"
                button appearance="none" press=cancelLink testId="cancel-link" min-height=40 padding=8
                  text "Cancel" font-size=13 color="ink"
            text `${mixed ? "Mixed · " : ""}${formats}` testId="markup-selection" min-height=16 font-size=12 color="softInk"
            textarea id="markup-editor" markup="markdown" value=editorText input=editMarkdown select=selected testId="markup-editor" aria-label="Markdown editor" width="100%" height=260 box-sizing="border-box" padding=12 border-width=1 border-color="fieldEdge" border-radius=8 background-color="fieldBg" color="ink" font-size=16 line-height="26px"
            text editorText markup="markdown" testId="markup-preview" width="100%" font-size=16 line-height="26px" color="ink"
            textarea id="atom-editor" markup="markdown" value=atomText input=editAtoms select=selectedAtom atoms="citation mention skill" atomFaces=atomFaces atompress=pressedAtom testId="atom-editor" aria-label="Atoms" width="100%" height=160 box-sizing="border-box" padding=12 border-width=1 border-color="fieldEdge" border-radius=8 background-color="fieldBg" color="ink" font-size=16 line-height="26px"
            text `pressed: ${atomPress} · selected: ${atomSelected}` testId="atom-state" font-size=12 color="softInk"
            text atomText markup="markdown" atoms="citation mention skill" atomFaces=atomFaces atompress=pressedAtom testId="atom-reader" width="100%" font-size=16 line-height="26px" color="ink"
            textarea id="atom-rtl-editor" markup="markdown" value=atomRtl input=editRtl atoms="mention" atomFaces=atomRtlFaces testId="atom-rtl-editor" aria-label="Right-to-left atoms" width="100%" height=96 box-sizing="border-box" padding=12 border-width=1 border-color="fieldEdge" border-radius=8 background-color="fieldBg" color="ink" font-size=16 line-height="26px" direction="rtl"
            text atomRtl markup="markdown" atoms="mention" atomFaces=atomRtlFaces testId="atom-rtl-reader" width="100%" font-size=16 line-height="26px" color="ink" direction="rtl"
            text doc.source markup="markdown" testId="markup-node" width="100%" font-size=16 line-height="26px" color="ink"
    else
      if windowed
        list appearance="none" virtualized=true testId="document" flex=1 min-height=60 width="100%" box-sizing="border-box" overflow-x="hidden" overscroll-behavior="contain"
          for b in doc.blocks key=b.id
            column width="100%" align-items="center" padding-top=(b.id == "0" ? 16 : 0) padding-bottom=(b.id == `${doc.totalBlocks - 1}` ? 64 : 2)
              column width="100%" max-width=(wide ? 1200 : 640) padding-left=20 padding-right=20 box-sizing="border-box" testId=`reading-column-${b.id}`
                Blocks(block=b)
      else
        scroll testId="document" flex=1 min-height=60 width="100%" overflow-x="hidden" overscroll-behavior="contain"
          column width="100%" align-items="center" padding-top=16 padding-bottom=64
            column width="100%" max-width=(wide ? 1200 : 640) padding-left=20 padding-right=20 box-sizing="border-box" gap=2 testId="reading-column"
              for b in doc.blocks key=b.id
                Blocks(block=b)

component MarkdownTool
  props
    name: string
    label: string
    formats: string
    unavailable: string
    apply: action
  view
    button press=apply(name) retainFocus=true testId=`format-${name}` aria-label=(` ${formats} `.includes(` ${name} `) ? `${label} active` : label) border-width=1 border-color=(` ${formats} `.includes(` ${name} `) ? "ink" : "#00000000") disabled=` ${unavailable} `.includes(` ${name} `) min-height=40 padding=8 background-color="control" border-radius=6
      text label font-size=13 font-weight=(` ${formats} `.includes(` ${name} `) ? 700 : 400) color="ink"
