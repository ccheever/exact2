// Map Demo — `exact-map` from `@exact/maps` (LLP 1133.021): MapKit on Apple
// hosts, the Maps SDK on Android, and on the web the OpenStreetMap tiles
// this app names in app.json. The markers are a list prop; the map says
// which marker the person selected (`change`, its id) and where its camera
// came to rest (`moveend`). The buttons select a marker through the
// `selected` prop, the non-gesture way to the same state.

use MapCamera, MapMarker from "@exact/maps"

// No pointer is a TV's remote: it pans the map, but has no pinch, so the
// zoom has buttons there (LLP 1039).
shape Viewport
  pointer: string

component MapDemo
  resource viewport = exactViewport() as shape Viewport
  derive tv = viewport.pointer == "none"
  derive stores = [MapMarker(id="ferry", latitude=37.7955, longitude=-122.3937, title=some("Ferry Building")), MapMarker(id="coit", latitude=37.8024, longitude=-122.4058, title=some("Coit Tower")), MapMarker(id="union", latitude=37.788, longitude=-122.4075, title=some("Union Square")), MapMarker(id="chinatown", latitude=37.7941, longitude=-122.4078, title=some("Dragon Gate"))]
  // The camera's zoom as the map last reported it, so the buttons zoom from
  // where a person's pinch left it.
  state zoom = 15
  state selected = ""
  state picks = 0
  action pick(id: string)
    selected = id
    picks = picks + 1
  action choose(id: string)
    selected = id
  action moved(c: MapCamera)
    zoom = c.zoom
  action zoomIn
    zoom = min(19, round(zoom) + 1)
  action zoomOut
    zoom = max(3, round(zoom) - 1)
  view
    main testId="map-demo" width="100%" height="100%" display="flex" flex-direction="column" background-color="#ffffff" color="#15171c" font-family="system-ui"
      row flex-shrink=0 align-items="center" padding-left=16 padding-right=16 padding-top=12 padding-bottom=12
        text "Stores" flex=1 font-size=19 font-weight=600
        text (selected == "" ? "No store selected" : "Selected: " + selected) testId="selected" aria-live="polite" font-size=14 color="#4a505c"
      exact-map testId="map" flex=1 min-height=0 width="100%" latitude=37.7946 longitude=-122.404 zoomLevel=zoom selected=selected markers=stores aria-label="Map of stores; the buttons below select a store without the map" change=pick moveend=moved
      row flex-shrink=0 gap=8 padding=12 flex-wrap="wrap"
        button press=choose("ferry") testId="pick-ferry" padding=10 border-radius=8 background-color="#eef1f6"
          text "Ferry Building"
        button press=choose("coit") testId="pick-coit" padding=10 border-radius=8 background-color="#eef1f6"
          text "Coit Tower"
        button press=choose("union") testId="pick-union" padding=10 border-radius=8 background-color="#eef1f6"
          text "Union Square"
        if tv
          view flex=1
          button press=zoomOut disabled=(zoom <= 3) testId="zoom-out" aria-label="Zoom out" padding=10 border-radius=8 background-color="#eef1f6"
            text "Zoom out −"
          button press=zoomIn disabled=(zoom >= 19) testId="zoom-in" aria-label="Zoom in" padding=10 border-radius=8 background-color="#eef1f6"
            text "Zoom in +"
      text ("Pins selected on the map: " + picks.toString()) testId="picks" font-size=13 color="#4a505c" padding-left=12 padding-bottom=12
      text ("Zoom: " + zoom.toString()) testId="zoom" font-size=13 color="#4a505c" padding-left=12 padding-bottom=12
