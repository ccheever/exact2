                        text (t.note != "" ? t.note : t.facts) color=(t.note != "" ? "-exact-system-orange" : "-exact-secondary-label") font="-exact-caption1" max-width=390 testId=`grid-note-${t.name}`
                        if t.app != ""
                          text t.app color="-exact-secondary-label" font="-exact-caption1" max-width=390 testId=`grid-app-${t.name}`
            Inspector(inspected=inspected, changes=changes, canWrite=canWrite, canPropose=canPropose, canvasView=canvasView, gridAt=gridAt, upNote=upNote, upNoteKey=upNoteKey, foldedRows=foldedRows, foldedHeld=foldedHeld, impactToken=impactToken, uses=uses, inspectSent=inspectSent, selectedUp=selectedUp, holdSent=holdSent, outlined=outlined, sendingInspect=pending(inspectSent), movingUp=pending(selectedUp), sendingHold=pending(holdSent), outlining=pending(outlined), readingUses=pending(uses), toggleInspect=toggleInspect, selectUp=selectUp, showInitial=showInitial, editState=editState, editRow=editRow, moveRow=moveRow, holdState=holdState, editFromSelection=editFromSelection, outlineImpact=outlineImpact)
            Builds(builds=changes.builds, reloading=changes.reloading, reloadGen=changes.reloadGen, reloadSeen=reloadSeen, canWrite=canWrite, pinBuild=pinBuild, pinScheme=pinScheme, pinContrast=pinContrast, pinMode=pinMode, pinFont=pinFont, pinFontOk=pinFontOk, pinAxes=pinAxes, pinned=pinned, sendingPin=pending(pinned), choosePinBuild=choosePinBuild, choosePinScheme=choosePinScheme, choosePinContrast=choosePinContrast, choosePinMode=choosePinMode, choosePinFont=choosePinFont, applyPin=applyPin, previewPin=previewPin, clearPins=clearPins)
            // Design files only: the server's files hold the app's Contract
