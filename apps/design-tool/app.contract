                          text "Pin a value"
                      else
                        if branch.expression and typed.ok
                          // Its fields keep the names it holds (a shadow's colour token).
                          text `Names ${branch.inputs.concat(branch.dials.map(d => d.name)).concat(branch.roles).join(", ")}: its fields keep them; edit those for their own values.` color="-exact-secondary-label" testId="branch-names"
                          for n in branch.inputs key=n
                            button press=selectCell(n, selColumn, false) testId=`input-${n}`
                              text n
                          for d in branch.dials.filter(d => not d.hidden) key=d.name
                            button press=showDial(d.name, d.group, d.more) testId=`input-${d.name}`
                              text `${d.name} (dial)`
                        else if branch.expression
                          text `Pinned here: no longer follows ${branch.inputs.concat(branch.dials.map(d => d.name)).concat(branch.roles).join(", ")}.` color="-exact-system-orange" testId="pinned"
                        if typed.ok and typed.of == partsBase
                          column gap=6 testId="typed"
                            for p in typed.parts.filter(p => p.control != "fixed") key=p.key
                              row gap=8 align-items="center" testId=`part-${p.key}`
                                text p.label width="7rem" color="-exact-secondary-label" font="-exact-footnote"
                                if p.control == "number"
                                  input type="number" value=fieldTexts.slice(p.index, p.index + 1).join("") input=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` flex=1 min-width=0 testId=`part-${p.key}-field`
                                else if p.control == "select"
                                  select value=fieldTexts.slice(p.index, p.index + 1).join("") change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                    for o in p.options key=o
                                      option (o == "" ? "none" : o) value=o
                                else if p.control == "inset"
                                  select value=fieldTexts.slice(p.index, p.index + 1).join("").toLowerCase() change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                    option "outside" value=""
                                    option "inset" value="inset"
                                else if p.control == "style"
                                  select value=fieldTexts.slice(p.index, p.index + 1).join("") change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                    option "unsaid" value=""
                                    option "italic" value="italic"
                                else
                                  input value=fieldTexts.slice(p.index, p.index + 1).join("") input=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") placeholder=(p.optional ? "unsaid" : "") aria-label=`${branch.token} ${p.label}` flex=1 min-width=0 testId=`part-${p.key}-field`
                            if partMissing != ""
                              text `Give ${partMissing} a value: emptied, the part after it would be read in its place.` color="-exact-system-orange" font="-exact-footnote" testId="typed-missing"
                        input value=shownValue input=typingValue change=cellText disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} value` id="branch-value" testId="branch-value"
                      if not branch.exact
                        button press=onlyThisMode disabled=(not canPropose or branch.readOnly != "") testId="only-this-mode"
                          text "Only this mode"
                      if not branch.param
                        row gap=8
                          input value=renameTo input=editRename submit=renameToken disabled=(not canPropose or branch.readOnly != "") placeholder="New name" aria-label="New name" flex=1 min-width=0 testId="rename-to"
                          button press=renameToken disabled=(renameTo.trim() == "" or not canPropose or branch.readOnly != "") testId="rename"
                            text "Rename"
                          button commandfor="confirm-remove" command="show-modal" disabled=(not canPropose or branch.readOnly != "") destructive=true testId="remove"
                            text "Remove"
                  if not branch.ok
                    text branch.error color="-exact-system-red" testId="branch-error"
                  if editKind == "promote-param" or editKind == "promote-token" or editKind == "detach-param"
                    column gap=4 testId="move-editor"
                      text rowWords role="heading" aria-level=3 testId="row-label"
                      text (editKind == "detach-param" ? "One transaction: the param's default written at this row, and the param removed, with any param it alone left read (listed below); refused where the app's design sets it." : "One transaction: the new one, its default the value as written, and this row reading it.") color="-exact-secondary-label" font="-exact-footnote"
                      if stateStale
                        text "The copy this edit was opened on is no longer current: select it again." color="-exact-system-orange" font="-exact-footnote" testId="state-stale"
                      if editKind != "detach-param"
                        input value=editValue input=stateValue disabled=(not canPropose) aria-label=(editKind == "promote-param" ? "The new param's name" : "The new token's name") testId="move-name"
                  if editKind == "set-state" or editKind == "set-row"
                    column gap=4 testId="state-editor"
                      if editKind == "set-row"
                        text rowWords role="heading" aria-level=3 testId="row-label"
                        text "A row as its author wrote it: written by set-row where it is written (this template: every copy of this node; a style: every node using it), which rebuilds the app; the file must be as it was when selected, and the app must build." color="-exact-secondary-label" font="-exact-footnote"
                      else
                        text `${editTarget.split("|").slice(0, 1).join("")} :${editTarget.split("|").slice(1, 2).join("")} ${editTarget.split("|").slice(2, 3).join("")}` role="heading" aria-level=3 testId="state-label"
                        text "A state part's row: written by set-state, which rebuilds the app; a hold on it is held again once it has, where its node still corresponds." color="-exact-secondary-label" font="-exact-footnote"
                      if stateStale
                        text "The copy this edit was opened on is no longer current: select it again." color="-exact-system-orange" font="-exact-footnote" testId="state-stale"
                      input value=editValue input=stateValue disabled=(not canPropose) aria-label=(editKind == "set-row" ? "The row's value" : "The state part's value") testId="state-value"
                  if editKind != ""
                    // In the edit dock with the cell's editor (the third pass's #7; the second pass's param proposal, opened
                    // about 16,500 px below its field, docked first).
                    column gap=8 padding=12 border-radius=10 background-color="-exact-tertiary-background" id="proposal-dock" tabindex=-1 role="region" aria-label="Proposal" testId="proposal"
                      if editKind == "set-token" and editTarget == setForAppName and setForAppNote != ""
                        text setForAppNote font="-exact-footnote" color="-exact-secondary-label" testId="set-for-app-note"
                      if draftStale or partsStale
                        text "The branch this edit was for has changed: choose the cell and type it again." color="-exact-system-orange" testId="draft-stale"
                      // Said to a screen reader as it comes: a typed draft keeps the focus in its field.
                      text readyLine aria-live="polite" font="-exact-footnote" color="-exact-secondary-label" testId="proposal-ready"
                      if not proposal.ok
                        text proposal.error color="-exact-system-red" white-space="pre-wrap" testId="proposal-error"
                      else if proposal.active
                        row gap=8 align-items="center"
                          text (proposal.chip == "live" ? "Live" : "Rebuilds") font="-exact-footnote" padding="2px 8px" border-radius=8 background-color="-exact-tertiary-background" testId="chip"
                          text proposal.tokens.join(", ") color="-exact-secondary-label" font="-exact-footnote" flex=1 testId="proposal-tokens"
                        text proposal.diff font="-exact-caption1" font-family="ui-monospace, monospace" white-space="pre" testId="proposal-diff"
                      if scrubShown
                        column gap=4 testId="scrub"
                          if not scrub.ok
                            text scrub.error color="-exact-system-red" white-space="pre-wrap" testId="scrub-error"
                          else if scrub.open != ""
                            text (scrub.ready ? "Previewing: the running copies show this value, and the files are unchanged until Keep." : scrub.sending ? "Previewing: sending this value to the running copies…" : "Previewing the last value sent: this one is not previewed.") color="-exact-system-orange" testId="scrub-previewing"
                          row gap=8
                            button press=keepScrub disabled=(not scrub.ok or not scrub.ready or partsStale or pending(scrub) or pending(written) or not canWrite) buttonStyle="filled" testId="scrub-keep"
                              text "Keep"
                            button press=cancelScrub disabled=(not canWrite) testId="scrub-cancel"
                              text "Cancel scrub"
                      else
                        row gap=8
                          button id="proposal-apply" press=apply disabled=(not applyReady) buttonStyle="filled" testId="apply"
                            text (canWrite ? "Apply" : "Propose for review")
                          if editKind == "set-dial" or editKind == "set-token" or editKind == "set-param"
                            button press=startScrub disabled=(not hello.live or not proposal.ok or not proposal.active or pending(proposal) or proposal.key != draftKey or proposal.chip != "live" or not proposal.scrubbable or draftStale or partsStale or pending(written) or not canWrite or (branch.readOnly != "" and editTarget == branch.token and editKind == branchOp)) testId="scrub-start"
                              text "Scrub live"
                          button press=cancelEdit testId="cancel-edit"
                            text "Cancel"
                        if (editKind == "set-dial" or editKind == "set-token" or editKind == "set-param") and proposal.ok and proposal.active and proposal.chip != "live"
                          text (hello.live ? "This edit rebuilds the app, so it can't be scrubbed: Apply writes it." : "Scrubbing previews on the running copies: open the tool through a dev loop (tamber tool --via).") color="-exact-secondary-label" font="-exact-footnote" testId="scrub-unavailable"
              // The Remove confirmation outside the dock, so its own Escape (which closes it) never reaches the dock's.
              if branchShown and not branch.param
                dialog id="confirm-remove" role="alertdialog" aria-label=`Remove ${selToken}?`
                  button press=removeToken disabled=(not canPropose or branch.readOnly != "") destructive=true commandfor="confirm-remove" command="close" testId="confirm-remove-yes"
                    text "Remove"
                  button commandfor="confirm-remove" command="close"
                    text "Cancel"
              column gap=8 testId="add"
                text "Add a token" role="heading" aria-level=3
                row gap=8
                  input value=newName input=editNewName submit=addToken disabled=(not canPropose) placeholder="surface.raised" aria-label="New token's name" flex=1 min-width=0 testId="new-name"
                  input value=newValue input=editNewValue submit=addToken disabled=(not canPropose) placeholder="light-dark(#fff, #000)" aria-label="New token's value" flex=1 min-width=0 testId="new-value"
                  button press=addToken disabled=(newName.trim() == "" or newValue.trim() == "" or not canPropose) testId="add-token"
                    text "Add"
              if not scrubShown and scrub.ended != ""
                text scrub.ended color="-exact-secondary-label" testId="scrub-note"
              row gap=8 align-items="center" testId="undo-bar"
                button press=undo disabled=(stack.undo == 0 or pending(written) or not canWrite) testId="undo"
                  text `Undo (${stack.undo})`
                button press=redo disabled=(stack.redo == 0 or pending(written) or not canWrite) testId="redo"
                  text `Redo (${stack.redo})`
                if stack.rescope != ""
                  button press=rescope disabled=(pending(written) or not canWrite) testId="rescope"
                    text stack.rescope
                if not stack.ok
                  text stack.error color="-exact-system-red" white-space="pre-wrap" flex=1 testId="write-error"
                else if stack.note != ""
                  text stack.note color="-exact-secondary-label" flex=1 testId="write-note"
              column gap=8 testId="contrast"
                text "Contrast" role="heading" aria-level=2
                text "Text over background, between the stored values: a role or platform colour is its fallback until a running app reports it." color="-exact-secondary-label" font="-exact-footnote"
                row gap=8
                  select value=pickA change=chooseA aria-label="Text" testId="pick-a"
                    option "Text…" value=""
                    for n in design.names key=n
                      option n value=n
                  select value=pickB change=chooseB aria-label="Background" testId="pick-b"
                    option "Background…" value=""
                    for n in design.names key=n
                      option n value=n
                if not contrast.ok
                  text contrast.error color="-exact-system-red" testId="contrast-error"
                for r in contrast.ratios key=r.column
                  row gap=12
                    text r.label width=160
                    text r.ratio testId=`ratio-${r.column}`
            column gap=4 testId="files"
              button press=toggleFiles aria-expanded=filesShown aria-label=`${filesShown ? "Hide" : "Show"} the ${hello.files.length} files and their digests` testId="toggle-files"
                text (filesShown ? "Hide files" : `Files (${hello.files.length})`)
              if filesShown
                for f in hello.files key=f.path
                  row gap=12
                    text f.path flex=1 testId=`file-${f.path}`
                    text f.digest.slice(0, 12) color="-exact-secondary-label" font="-exact-footnote" testId=`digest-${f.path}`
            Proposals(held=changes.held, diffs=chosenDiffs.diffs, picked=picked, client=client, canWrite=canWrite, canPropose=canPropose, writing=pending(written), acceptImportNow=acceptImportNow, editImportValue=editImportValue, toggleLeaveOut=toggleLeaveOut, toggleOffer=toggleOffer, togglePick=togglePick, acceptAll=acceptAll, acceptPicked=acceptPicked, dropProposal=dropProposal)
            column gap=8 testId="import"
              text "Import a theme" role="heading" aria-level=2
              text "Its tokens, the role overrides it offers (each off until ticked) and what it could not map are held as a proposal, reviewed above." color="-exact-secondary-label" font="-exact-footnote"
              row gap=8 align-items="center"
                select value=importKind change=chooseKind disabled=(not canPropose) aria-label="Kind" testId="import-kind"
                  option "shadcn (CSS)" value="shadcn"
                  option "Tailwind v4 (CSS)" value="tailwind"
                  option "DTCG (JSON, a file a mode)" value="dtcg"
                button press=pickImport disabled=(pending(imported) or not canPropose) testId="import-choose"
                  text "Choose files…"
                input type="file" multiple=(importKind == "dtcg") disabled=(not canPropose) id="import-file" testId="import-file" display="none" change=importPicked
              match imported
                case some(i)
                  text (i.ok ? i.note : i.error) color=(i.ok ? "-exact-secondary-label" : "-exact-system-red") white-space="pre-wrap" testId="import-result"
                  if i.counted != ""
                    text i.counted color="-exact-secondary-label" font="-exact-footnote" testId="import-counted"
                    for u in i.unmapped key=u.key
                      text `${u.name} = ${u.value}${u.block != "" and not u.derived ? ` (${u.block})` : ""}: ${u.why}` color="-exact-secondary-label" font="-exact-caption1"
                case none
                  text "" display="none"
            ChangesPanel(changeset=changeset, scope=scope, canWrite=canWrite, committed=committed, committing=pending(committed), commit=commit)
            HistoryPanel(history=history, historyShown=historyShown, historyPages=historyPages, canPropose=canPropose, reverted=reverted, reverting=pending(reverted), toggleHistory=toggleHistory, moreHistory=moreHistory, newerHistory=newerHistory, revert=revert)
            column gap=4 testId="following"
              text (changes.ok ? `Following changes · ${changes.seq}` : changes.error) color="-exact-secondary-label" font="-exact-footnote" testId="follow-state"
              for c in changes.recent key=`${c.seq}`
                text `${c.files.join(", ")} · ${c.who}` testId=`change-${c.seq}`
