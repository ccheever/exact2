// The design tool (LLP 1122), T1: a `tamber/1` client over an app's design
// files, served by the app's Tamber server at its own local URL
// (`bun exact.mjs tamber tool <app>`). app.ts is the protocol client; this
// view keeps no design state of its own: the files are the design.

shape FileDigest
  path: string
  digest: string

// The dev loop's page refusing this tool's frame, in words; empty when it lets it or can't be asked (canvas-check.ts).
shape CanvasCheck
  refused: string

shape ChainLink
  text: string
  up: number

// A move of the selection up the chain (`inspect` `select`): sent, or why not.
shape SelectUp
  ok: bool
  error: string

shape Hello
  ok: bool
  error: string
  protocol: string
  format: number
  app: string
  files: FileDigest[]
  // The dev loop's own origin, as it prints it, which "Open in a tab"
  // opens; "" with none. And the origin the canvas frames it at: the same
  // port as localhost, another site than the tool's.
  page: string
  frame: string
  // A dev loop serves the wire: a value edit applies in place, and a
  // scrub previews on the running copies.
  live: bool
  // The server's run: a restart is another.
  epoch: string
  // This tool's scope on the server, and whether its token is the local
  // one, which pairs and revokes clients (tamber/1.13); a paired client's
  // name, as the server gives it.
  scope: string
  local: bool
  client: string

// A remote door a paired client comes through (LLP 1121 stage 10 B): its
// origin and its certificate's SHA-256, made for this run, which the other
// machine checks; a tunnel the developer trusts has none.
shape Door
  origin: string
  fingerprint: string
  tunnel: bool

// A pairing code (LLP 1122 D12, T6): good once, until `until`, for a
// client's own token at `scope`.
shape PairCode
  ok: bool
  error: string
  code: string
  scope: string
  until: string
  doors: Door[]

// A paired tool's canvas through the server's gateway (stage 10 C): the
// frame's URL, its single-use grant in the fragment; "" with none.
shape Canvas
  ok: bool
  error: string
  frame: string
  // The gateway's own page, without the grant.
  root: string

shape CanvasIn
  entered: bool

// One live copy of several (LLP 1122 T7): its frame's name, what it shows
// (a mode and text size, or a state), the page it frames, the build its
// page said it is, that build's facts as it reports them, and what is
// wrong, if anything.
shape GridTile
  name: string
  label: string
  src: string
  build: string
  ready: bool
  facts: string
  note: string
  // What the app asked that the copy's pin holds over (theme2's F2 ruling), or "".
  app: string

shape Grid
  ok: bool
  error: string
  note: string
  tiles: GridTile[]

shape Client
  client: string
  name: string
  scope: string
  peer: string
  seen: string
  until: string

shape Clients
  ok: bool
  error: string
  clients: Client[]

shape Change
  seq: number
  kind: string
  who: string
  files: string[]
  tokens: string[]

// A held proposal (LLP 1122 D10): its proposer, diff, the tokens it
// changes and its operations; a recomputed one names the one it replaces.
shape HeldItem
  index: number
  text: string

// An import's review (LLP 1122 D11): the mapped tokens with each mode's
// value and swatches, the role overrides it offers (off until ticked), the
// values it did not map and why, and the count check.
// A mode's value: `mode` 0 is the default (or a set's own `when`), k the
// k-th `when`; a swatch side is "" for a value no page can paint (a
// reference to a token).
shape ModeValue
  label: string
  mode: number
  value: string
  light: string
  dark: string

// `kind`: `token` (added or set, its modes' values), `axis` (a new axis),
// `drop` (a mode's value dropped), or `other`, said in `text`.
shape Mapped
  index: number
  kind: string
  name: string
  text: string
  modes: ModeValue[]

shape Offer
  role: string
  token: string
  items: string
  note: string
  // Ticked to begin with (a recomputed import's kept offers); a picked id
  // flips it.
  on: bool

shape Unmapped
  name: string
  value: string
  why: string
  derived: bool
  block: string
  key: string

shape Held
  proposal: string
  client: string
  tint: string
  diff: string
  tokens: string[]
  replaces: string
  items: HeldItem[]
  // An import's ("" for any other proposal).
  importer: string
  mapped: Mapped[]
  offers: Offer[]
  unmapped: Unmapped[]
  counted: string
  countOk: bool
  // The import an edit replaced, and whether its offers begin on (a
  // recomputed import, or an edit of one).
  from: string
  kept: bool

// An import started from picked files: the proposal it holds, or why not.
shape Imported
  ok: bool
  error: string
  proposal: string
  note: string
  // With nothing to propose, what it still reports.
  counted: string
  unmapped: Unmapped[]

// A running build (LLP 1122 D4): its effective scheme, contrast, mode and
// root font size from its status, its pin, whether its status has caught
// up with the last pin frame the server sent it (any client's pin, or a
// hand-back), and the last command it could not apply.
shape RefusalCount
  id: string
  count: number

shape InspectRefusal
  id: string
  host: string
  // As the Builds list names it; and the rest of its sentence.
  name: string
  tail: string

shape Build
  id: string
  host: string
  // The variant gallery's page (`page: 'gallery'`, tamber/1.15): a label only.
  gallery: bool
  // Its status has come (none since it registered or reloaded, else).
  reported: bool
  scheme: string
  contrast: string
  mode: string
  rootFontSize: number
  pin: string
  caughtUp: bool
  // Its status names a pin revision older than the last frame it was sent.
  behind: bool
  unsupported: string

shape AxisChoice
  name: string
  values: string[]

// The app's own design's axes, read while another file is open.
shape AppAxes
  axes: AxisChoice[]
  // Which read this is (0 for none): the inspector follows each.
  answer: number

// One row of an inspected node (LLP 1122 D5): its value, where it comes
// from, and what the inspector offers: the token rung (`rung` "token", the
// token and the grid column of the branch that won), a token it links, or
// why it is read-only.
shape SelRow
  name: string
  // Nothing sets it (its initial value): folded in the Inspector.
  initial: bool
  value: string
  source: string
  rung: string
  token: string
  // The param rung's (LLP 1122 T3): its full and short names; `token` is
  // then the token it aliases, offered, never the default (D6).
  param: string
  short: string
  // The state rung's (T4): the edit `set-state` makes of a style's state
  // part row (style|state|row|file), its words, or "" for none.
  state: string
  stateLabel: string
  // The row's value as its state part writes it, which the editor starts from.
  stateText: string
  // The template or style rung's (T5): `set-row`'s address (JSON), its words
  // ("Edit this template · 2 instances", "Edit style Panel") and the value as written.
  edit: string
  editLabel: string
  editText: string
  // The editor's heading: the scope and the attribute written (a shorthand's whole for a longhand of it).
  editWords: string
  // A template row's promotion (D6: to a new param; to a token where `tokenize`, an unconditional value),
  // and a param row's detach to its template: each move's address and value as written (JSON), or "".
  promote: string
  tokenize: bool
  detach: string
  reason: string
  column: string

// The latest node a build's inspect mode selected, joined to source.
shape Inspected
  // The copy it is (build, node, site, instance): a state edit is of it.
  key: string
  // Its visit (inspector.ts visitOf): a refresh of the same view keeps it; a round trip makes a new one.
  visit: string
  // The files' digests when it was reported (as Changes' `files` gives them after its count).
  files: string
  has: bool
  // Why it is no longer current (its page left inspect mode, its build
  // went or moved on, changes were missed, the axes changed, its scheme is
  // not known): it offers no edit then.
  stale: string
  build: string
  node: number
  readOnly: string
  source: string
  // Each call site above it, innermost first, and how many up it is (tamber/1.16 `inspect` `select`).
  chain: ChainLink[]
  // The grid column of the branch that won for it (its modes and scheme),
  // and that column's place, whole (every axis's value, the scheme).
  modes: string
  place: string
  rows: SelRow[]
  trimmed: bool
  // Whether this tool has inspect mode on a build, as the server and the
  // pages tell it.
  inspecting: bool
  // A state held on it (LLP 1122 D8): whether its build can hold, what is
  // held here, and what the server and the build said; the rows the held
  // state shows, or why they are not known.
  hold: HoldView
  heldState: string
  heldRows: SelRow[]
  heldNote: string
  // A node of an exported library component's own view (stage 12 D4, LLP
  // 1139 D5): the component's declaring identity ("" outside one), the
  // part this node is ("" for none), and its parts as the server lists them.
  libraryIdentity: string
  libraryPart: string
  libraryParts: LibraryPart[]

// One part of a library component, in the inspector's part outline.
shape LibraryPart
  name: string
  // Whether the selected node is this part, and whether it holds the slot.
  here: bool
  slot: bool

// A hold on the selected copy's build, as the inspector says it.
shape HoldView
  can: bool
  // The state held on this copy ("" for none here), and whether its build
  // says it holds it.
  state: string
  held: bool
  status: string

// A token's static source sites (`uses`): the impact of editing it.
shape UseSite
  file: string
  line: number
  col: number
  text: string

shape Uses
  ok: bool
  error: string
  token: string
  sites: UseSite[]

// What a pin did.
shape Pinned
  ok: bool
  error: string
  note: string

shape Changes
  ok: bool
  error: string
  answer: number
  seq: number
  epoch: string
  missed: bool
  recent: Change[]
  // The session's undo and redo depth, and which run of the server they
  // are for (a new run empties them).
  undo: number
  redo: number
  session: number
  held: Held[]
  builds: Build[]
  // The builds whose page refused inspect mode, said in the Inspector (at most three), and how many more.
  refusals: InspectRefusal[]
  refusedMore: number
  // Each build's refusal events, counted (one more each, the same words again included).
  refusalCounts: RefusalCount[]
  // The builds whose page can't move a selection up the chain (it answered `unsupported inspect` to a move).
  noStep: string[]
  // The files' digests as the poll has them: what a design read follows
  // (a build's status, a scrub's frame or a proposal moves `seq`, not them).
  files: string
  // Each answer, but while a scrub is open (any client's) only the files'
  // changes, the commits told and scrubs opening or ending: what hello, a
  // token's uses and a draft's proposal are read again on, so a scrub's
  // frames and its builds' statuses cost no reads.
  paced: string
  // What a commit could take moves only with these: the files' changes, the commits told and another run. The
  // commit's dry run is read on it, not on each answer, so a session with nothing to commit isn't asked again and again.
  committable: string
  // Each client paired or gone, and each start again: the clients read again on it.
  clients: string

// A control drawn from a dial's declared metadata (LLP 1122 D7, LLP 1121
// D4): `control` is `color`, `slider`, `stepper` or `select`.
shape Control
  name: string
  kind: string
  control: string
  label: string
  help: string
  value: string
  number: number
  min: number
  max: number
  step: number
  priority: number
  // A slider's or stepper's range and step, as the person reads them.
  bounds: string
  options: string[]
  // What a number the slider or stepper gives is written with: `px` for a
  // length (LLP 1121 D15: a length dial is a px value), nothing for a number.
  unit: string
  // A colour's swatch: the value itself, or (a param naming a token) what
  // it folds to.
  swatch: string

shape DialGroup
  name: string
  dials: Control[]
  more: Control[]

// The component panel (LLP 1122 D7, T3): a component's params, each with
// its control (`c.name` is the param's full name), grouped as dials are.
shape ParamRow
  c: Control
  // `Component.param`, or the full name where two components share it.
  short: string
  // The app has a line for it in the design's `params` block.
  set: bool
  // The tokens the default reads that a literal line no longer follows
  // (LLP 1121 D14's mark).
  pinned: string[]
  default: string
  // The token its default names ("" for none), that token's package ("" for
  // the app's own), and whether its component is a package's (LLP 1139 D5:
  // "Set for this app" writes the app's line).
  token: string
  tokenPackage: string
  // Whether that token is a base name the app leaves unset (Exact's base).
  tokenBase: bool
  package: bool
  // The package token its default reaches ("" for none) and whether the app
  // has its own line for it: "Back to the package" removes that line.
  packageToken: string
  appSet: bool
  // How many `when` branches the app's own param line has.
  whens: number
  // Whether the app's line is a literal with no when branch (its own value
  // then wins on both scheme sides).
  levelSelf: bool
  // A colour param's colour in each of the token grid's columns, labelled as they are, and the chain to it in
  // words (none for another kind).
  swatches: ParamSwatch[]
  words: string

shape ParamSwatch
  label: string
  css: string

// A package param's winning level for the first tuple (stage 12 B2-levels,
// each side's), read after the design: raw (the tooltip), and said: one
// level where the sides agree, else each side's, and whether other tuples
// differ.
shape LevelRow
  name: string
  level: string
  text: string

shape Levels
  ok: bool
  answer: number
  rows: LevelRow[]

shape ParamGroup
  name: string
  params: ParamRow[]
  more: ParamRow[]

shape ComponentPanel
  identity: string
  name: string
  // Declared in the design (`app.tamber#Name`): a view that isn't Contract.
  native: bool
  package: bool
  // A library component's variant props (stage 12 D3), each with the
  // options it takes: listed as text, nothing pinned or shown as chosen
  // (per-instance pins are LLP 1139 §9 Q5).
  variants: Variant[]
  groups: ParamGroup[]

shape Variant
  prop: string
  options: string[]

shape Column
  id: string
  label: string

// A declared pair's contrast in one cell (LLP 1121 D3, `pair=`).
shape PairBadge
  name: string
  ratio: string
  low: bool

shape Cell
  column: string
  label: string
  css: string
  swatch: string
  residual: bool
  note: string
  // The token's kind (LLP 1121 stage 6), and a shadow's value to preview
  // in the column's scheme.
  kind: string
  shadow: string
  scheme: string
  pairs: PairBadge[]

// A base scale value on one platform (LLP 1121 stage 11): its value, its
// source (a metric, a measurement, a guideline), whether it is a stretch, and
// whether this app's targets draw it.
shape BaseColumn
  name: string
  label: string
  value: string
  from: string
  stretch: bool
  ships: bool

shape TokenRow
  name: string
  kind: string
  follows: string
  cells: Cell[]
  // The value "Set for this app" starts from: a base row's first column's (the app ships it first), else its first cell's;
  // and, for a base row, that column in words ("iOS's 16px").
  start: string
  startFrom: string
  // Where its value comes from (stage 11 D): "app", "base" (Exact's scale)
  // or "package" (read-only; the app overrides it in its own file); for an
  // app line over a base or package name, what it replaces and the way back.
  source: string
  package: string
  of: string
  over: string
  back: string
  columns: BaseColumn[]

// The tokens changed since the last highlight faded, each by its latest
// client and in that client's colour (LLP 1122 D10).
shape Lit
  seq: number
  epoch: string
  file: string
  // The cursor once the oldest highlight here fades (per file and run).
  fadeTo: string
  // Each cell changed, `<token>|<column>`, and its client's colour.
  cells: string[]
  cellTints: string[]
  names: string[]
  whos: string[]
  tints: string[]

shape TokenGroup
  name: string
  tokens: TokenRow[]

shape Design
  ok: bool
  error: string
  file: string
  answer: number
  groups: DialGroup[]
  columns: Column[]
  // The first column's id ("" for none): where a token opened from the
  // component panel is shown when no cell is selected.
  firstColumn: string
  tokenGroups: TokenGroup[]
  names: string[]
  axes: AxisChoice[]
  // The design's icons (LLP 1121 D10), read only: no operation writes one.
  icons: IconRow[]
  // Each component with params (LLP 1121 D15) or variant props (LLP 1139 D5).
  components: ComponentPanel[]

shape IconRow
  name: string
  // Each source as written, "" where unwritten.
  sf: string
  material: string
  svg: string

// A dial an expression names, and where its control is.
shape DialInput
  name: string
  group: string
  more: bool
  // `control=none`: no control to go to.
  hidden: bool

// The branch a grid cell shows (LLP 1122 D6's target branch): the `when`
// that won for its tuple, or the default, and what its value reads.
shape Branch
  ok: bool
  error: string
  token: string
  // Its kind (a platform name it reads is a colour's, or a length's or a text style's).
  kind: string
  column: string
  // The column's place, whole: its scheme and every axis's value.
  place: string
  label: string
  when: string
  value: string
  expression: bool
  inputs: string[]
  dials: DialInput[]
  // Platform roles and system colours it names, which no token overrides.
  roles: string[]
  exact: bool
  own: string
  // A component's param (LLP 1122 T3), its full name in `token`: its edit
  // is `set-param`, and it has no rename or remove.
  param: bool
  // Why it is not edited here (a base or package value, stage 11), or "".
  readOnly: string
  // The design read it is of.
  answer: number

// The branch editor's typed fields (stage 6's kinds): the value shown, cut
// into parts by its kind, the source between them kept as `fixed` parts.
// Joined again they are the value byte for byte; an optional part left
// empty is dropped with its `pre` and `post`.
shape Part
  index: number
  key: string
  label: string
  // number, select, inset, style, text; fixed: written as it is, not shown.
  control: string
  text: string
  pre: string
  post: string
  optional: bool
  // A later part (its key; `after`, its index, -1 for none) while which
  // holds something this optional one is required: a blur before a spread.
  needs: string
  after: number
  options: string[]

shape Typed
  // A field fits this value (not an expression, a `calc()` or a named length).
  ok: bool
  of: string
  parts: Part[]
  tail: string

// An edit before it is written: `propose`'s answer.
// The scrub as the data module keeps it (LLP 1122 D6): `live` from Scrub
// live until Keep, Cancel or an end; `open` its id once the server opened
// it; `ready` when the server previews the draft as it is now (Keep writes
// that); `ended`, how the last one ended without a write, said once it is
// not live.
shape Scrub
  ok: bool
  error: string
  live: bool
  open: string
  ready: bool
  // A frame is on its way.
  sending: bool
  ended: string

shape Proposal
  ok: bool
  error: string
  active: bool
  chip: string
  diff: string
  tokens: string[]
  // The edit it is of (as `draftKey` spells it), and what Apply writes:
  // that edit against the digests this proposal read.
  key: string
  // One operation, which a scrub can preview (not a param's first `when`
  // line, which writes its own line first).
  scrubbable: bool
  review: string

// A write, an undo or a redo: what it did, and the stacks after it.
shape Written
  ok: bool
  error: string
  undo: number
  redo: number
  last: string
  key: string
  session: number
  // What an accept or a drop did, in words; an edited import's picks,
  // carried to the proposal that replaced it.
  note: string
  carried: string[]
  // The last write moved to its other rung (LLP 1122 D6's re-scope, T3):
  // what the offer says, or "" where it has none.
  rescope: string

// The session changeset (LLP 1122 D9): each write since the tool opened,
// in plain words, with the diff under the tool's own.
shape ChangeEntry
  seq: number
  who: string
  tint: string
  mine: bool
  text: string
  diff: string
  committed: bool

shape Changeset
  ok: bool
  error: string
  entries: ChangeEntry[]

// What a commit would take now: its edits, or a refusal to show.
shape Scope
  open: number
  refused: bool
  // No answer: Commit stays on, and says why when pressed.
  unavailable: bool

shape Refusal
  file: string
  why: string

// A `commit`: its sha and files and the edits it took, or each file it
// refused and why.
shape EditLine
  n: number
  text: string

shape Committed
  ok: bool
  error: string
  commit: string
  files: string[]
  refused: Refusal[]
  edits: EditLine[]

// The design files' git log, read as edits.
shape HistoryFile
  file: string
  refused: string
  edits: string[]

shape HistoryCommit
  commit: string
  short: string
  author: string
  date: string
  subject: string
  files: HistoryFile[]

shape History
  ok: bool
  error: string
  commits: HistoryCommit[]
  more: bool

// A past commit's inverse, held for review, or why it cannot apply.
shape Reverted
  ok: bool
  error: string
  commit: string
  proposal: string
  refused: string[]

shape Ratio
  column: string
  label: string
  ratio: string

shape Contrast
  ok: bool
  error: string
  ratios: Ratio[]

component DesignTool
  // Who this person is, asked once: every write is `design-tool:<person>`.
  state person = "" persist
  state renaming = false
  // The canvas's size: a bare frame never sizes to its guest (LLP 1020 D1).
  state canvasSize = "phone" persist
  // The pin being composed: which build ("" every build), and the facts
  // `prefer` pins, each "" when left alone.
  state pinBuild = ""
  state pinScheme = ""
  state pinContrast = ""
  state pinMode: string[] = []
  state pinFont = 0
  mutation pinned as shape Pinned
  // Inspect mode on the builds (LLP 1122 D4, D5), and the token whose
  // impact the inspector shows.
  resource inspected = loadSelection(changes.answer, design.answer, appAxes.answer) as shape Inspected else empty()
  mutation inspectSent as shape Pinned refreshes inspected
  mutation selectedUp as shape SelectUp refreshes inspected
  mutation holdSent as shape Pinned refreshes inspected
  state impactToken = ""
  resource uses = loadUses(impactToken, changes.paced) as shape Uses else empty(ok=true)
  mutation outlined as shape Pinned
  state draftName = ""
  // The long poll's place: the last sequence number seen, in which run, and
  // one more ask per answer, so an answer with nothing new asks again.
  state since = 0
  state epoch = ""
  // The files as of the last answer: reads of the design follow these, not
  // `since`, so a stream of build statuses never reads a big design again.
  state filesAt = ""
  state pacedAt = ""
  // A proposal's place in the poll: it follows every answer, at least one
  // each 25 s, but while a scrub is shown (its class moves without files:
  // the JS loop's builds, its design reader getting ready, which says
  // nothing), so a stream of scrub frames proposes nothing again.
  state proposeAt = ""
  state asks = 0
  resource hello = loadHello() as shape Hello else empty(ok=true)
  // Asked again with hello, so a loop restarted with EXACT_TOOL_PORT clears it.
  resource canvasCheck = loadCanvasCheck() as shape CanvasCheck else empty(refused="")
  // Pairing (LLP 1122 D12, T6), the local tool's alone: the scope a code is
  // minted at, the code, the paired clients, and a revoke.
  state pairScope = "propose"
  mutation paircode as shape PairCode
  resource clients = loadClients(hello.local, changes.clients) as shape Clients else empty(ok=true)
  mutation revoked as shape Pinned refreshes clients
  state clientsTries = 0
  // A paired client is the name the server gave it (T6), whatever it asks.
  derive client = hello.client != "" ? hello.client : `design-tool:${person}`
  // Its scope (T6): below write, what writes is greyed, said once why; the
  // tool sends none of it (wire.ts), and the server refuses it too.
  derive canWrite = hello.scope == "" or hello.scope == "write"
  derive canPropose = canWrite or hello.scope == "propose"
  // Pairing with another machine's server (remote mode): its address and the
  // code it shows, typed here; the code is not kept once sent.
  state remoteAt = ""
  state remoteCode = ""
  mutation pairedWith as shape Pinned refreshes hello
  // Its canvas, read once a server run, and again when it is opened again
  // or asked for again (a grant enters once).
  state canvasTick = 0
  // Its entry page's word that it entered (C2), asked each second while the
  // frame's URL holds the grant: then the canvas comes back as its gateway
  // page, the grant gone from the frame and this state.
  state canvasPoll = 0
  // (Asked for the grant's 30 s life, and a little more, each canvas: an
  // entry page that never says so is not asked for ever.)
  derive canvasKey = `${hello.client}|${hello.epoch}|${canvasTick}`
  state canvasPolled = ""
  state canvasPollsLeft = 40
  resource canvasIn = canvasEntered(hello.client, hello.epoch, canvasTick, canvasPoll) as shape CanvasIn else empty()
  resource canvasAt = loadCanvas(hello.local, hello.client, hello.epoch, canvasTick, canvasIn.entered) as shape Canvas else empty(ok=true)
  // A pin's modes are the running app's: its own design's axes, whichever
  // file is open (the last read of it).
  resource appAxes = loadAppAxes(file, filesAt, epoch) as shape AppAxes else empty()
  derive pinAxes = file == "" ? design.axes : appAxes.axes
  derive pinFontOk = pinFont == 0 or (pinFont >= 4 and pinFont <= 64)
  resource changes = waitChanges(since, epoch, asks, client) as shape Changes else empty(ok=true)
  // Several live copies (LLP 1122 T7): one copy, a grid of modes, or the
  // selected view's states side by side; the axis the grid's dark copies
  // vary, its larger text size, how many copies, and whether a copy moved
  // leads the others. The copies frame the dev loop's page (paired: the
  // gateway's, once entered), and are read each second while shown.
  // The visit to a selection (inspector.ts visitOf) whose rows nothing sets are shown: folded again for the next.
  state initialFor = ""
  state canvasView = "one"
  // The variant gallery (the JS dev loop's /__dev/gallery/) in the canvas and the grid, in place of the app.
  state galleryOn = false
  state gridAxis = ""
  state gridLarge = 22 persist
  state gridCap = 6 persist
  state gridMirror = true
  state gridPoll = 0
  derive galleryFrame = hello.local and hello.frame != "" ? `${hello.frame}/__dev/gallery/` : ""
  derive gridPage = hello.local ? (galleryOn and canvasView == "grid" ? galleryFrame : hello.frame) : (canvasAt.frame != "" and canvasAt.frame.indexOf("#g=") < 0 ? canvasAt.frame : "")
  resource gridAt = loadGrid(client, canvasView, gridAxis, gridLarge, gridCap, gridPage, gridMirror, canWrite, hello.epoch, hello.local, gridPoll, changes.answer) as shape Grid else empty(ok=true)
  // The design file shown ("": the app's own), a group's "more" opened,
  // and the two tokens whose contrast is shown.
  state file = ""
  state opened: string[] = []
  // Base rows whose other platforms are shown; what a base value set for this app starts from, and its name.
  state openedBase: string[] = []
  state setForAppNote = ""
  state setForAppName = ""
  state pickA = ""
  state pickB = ""
  resource design = loadDesign(file, filesAt, epoch) as shape Design else empty(ok=true)
  resource levels = loadLevels(design.answer) as shape Levels else empty(ok=true)
  // Contrast and a cell's branch follow the design read they are of.
  resource contrast = loadContrast(pickA, pickB, design.answer) as shape Contrast else empty(ok=true)
  // The cell chosen in the grid, and the edit being considered: an
  // operation, the token or dial, the `when` (`axis=value …`, "" for the
  // default) and the value. Nothing is written until Apply.
  state selToken = ""
  state selColumn = ""
  // The place the inspector put the cell at: a design read since with
  // other axes puts another tuple at that column, refused.
  state selPlace = ""
  state pinning = false
  // "Only this mode" chosen for the cell's edit, and a dial an expression's
  // input pointed to.
  state scopeOwn = false
  state focusDial = ""
  state editKind = ""
  state editTarget = ""
  state editWhen = ""
  state editValue = ""
  // The typed fields' cut (stage 6's kinds): the value they are cut from is
  // the branch's, or what its text field set (`rawBase`, for `rawFor`'s
  // branch); a field's edits keep the cut, so a part mid-typing (`1` on its
  // way to `1px`) leaves every field where it is. `partTexts`: the fields'
  // texts, for `partFor`'s cut.
  state rawBase = ""
  state rawFor = ""
  state partTexts: string[] = []
  state partFor = ""
  // The branch (by its value) a cell's token draft was typed against.
  state draftFor = ""
  state newName = ""
  state newValue = ""
  state renameTo = ""
  resource branch = loadBranch(file, selToken, selColumn, design.answer) as shape Branch else empty(ok=true)
  resource proposal = proposeEdit(file, editKind, editTarget, editWhen, editValue, filesAt, proposeAt, hello.live, epoch) as shape Proposal else empty(ok=true)
  // Scrubbing, chosen explicitly (D6, never the default): each value the
  // draft takes is a frame previewed on every running copy, written to no
  // file; Keep (or a slider let go) writes it once, Cancel puts the
  // committed value back. `scrubAsk` counts Scrub live presses, `scrubTick`
  // each Keep or Cancel; the module keeps the session, and the poll's
  // answers bring an end the server made.
  state scrubAsk = 0
  state scrubTick = 0
  // From Scrub live to Keep or Cancel: the panel shows while the opening
  // frame is still on its way.
  state scrubWant = false
  resource scrub = scrubFrame(scrubAsk, scrubTick, file, editKind, editTarget, editWhen, editValue, client, proposal.review, changes.answer) as shape Scrub else empty(ok=true)
  derive scrubShown = scrub.live or (scrubWant and pending(scrub))
  // The changeset follows the long poll and each design read (which
  // measures what changed); history is read when shown.
  resource changeset = loadChangeset(file, since, design.answer) as shape Changeset else empty(ok=true)
  resource scope = loadScope(client, changes.committable) as shape Scope else empty(open=0, refused=false, unavailable=false)
  // The items of held proposals picked for "Accept picked"
  // (`<proposal>:<index>`), and the last change whose highlight has faded.
  state picked: string[] = []
  state faded = ""
  resource lit = loadLit(file, design.answer, faded) as shape Lit else empty(seq=0)
  state historyShown = false
  // The server's files and their digests, folded below the canvas and the tokens (the hands-on pass: 25 rows came
  // before either on the clone).
  state filesShown = false
  // A move up the chain (tamber/1.16 `select`): the selection it moved from, and the chain length it should land at;
  // the page's own tree may have fewer above it (a rebuild), and its selection then lands higher, said so.
  state upFromKey = ""
  state upExpect = -1
  // Said of the selection the move lands on alone (the first after it), kept for that visit of it (a click away and
  // back is another).
  state upNote = ""
  state upNoteKey = ""
  derive upFailed = match selectedUp { case some(r) => not r.ok, case none => false }
  task upLanded when upExpect >= 0 and inspected.has and inspected.key != upFromKey key=inspected.key
    after(1, landUp)
  task upRefused when upExpect >= 0 and not pending(selectedUp) and upFailed key=upFromKey
    after(1, dropUp)
  // The page refusing it (its own `unsupported`, said in the Inspector's refusals) ends the move too.
  state upRefusalsAt = ""
  derive refusalsKey = changes.refusalCounts.filter(r => r.id == inspected.build).map(r => `${r.count}`).join("")
  task upPageRefused when upExpect >= 0 and refusalsKey != upRefusalsAt key=refusalsKey
    after(1, dropUp)
  // A page that can't step (it answered `unsupported inspect`): the move is over, and its up control greyed.
  task upCantStep when upExpect >= 0 and changes.noStep.includes(inspected.build) key=`${upFromKey}|cant`
    after(1, dropUp)
  // The edit a panel began (a dial's, a param's, its row's Back to the package), whose proposal docks at the window's
  // bottom: the panels sit far above the panel's own place. One begun from the token grid stays in place, under it.
  state dockedFor = ""
  derive docked = editKind != "" and dockedFor == `${editKind}|${editTarget}`
  state historyPages = 1
  resource history = loadHistory(historyShown, historyPages, since, epoch) as shape History else empty(ok=true)
  mutation committed as shape Committed refreshes changeset, scope
  // The importer for a picked file: shadcn CSS, a Tailwind v4 sheet, DTCG
  // JSON (several files, a mode each).
  state importKind = "shadcn"
  mutation imported as shape Imported
  mutation reverted as shape Reverted
  // One slot for a write, an undo or a redo: its reply holds the stacks.
  mutation written as shape Written refreshes design then afterWrite
  // The stacks as the last write left them, unless a new run of the
  // server has emptied them since (a write that found the restart itself is
  // newer than the poll, and says so).
  derive stack = match written { case some(w) => (w.session >= changes.session ? w : Written(ok=true, error="", undo=changes.undo, redo=changes.redo, last="", key="", session=changes.session, note="", carried=[], rescope="")), case none => Written(ok=true, error="", undo=changes.undo, redo=changes.redo, last="", key="", session=changes.session, note="", carried=[], rescope="") }
  derive draftKey = `${file}␟${editKind}␟${editTarget}␟${editWhen}␟${editValue}`
  // A cell's edit whose branch the grid no longer shows (another client
  // changed it): not applied, lest it make a `when` no one asked for.
  // What the branch editor writes: a token's branch, or a param's line (T3).
  derive branchOp = branch.param ? "set-param" : "set-token"
  // A state edit is of the copy it was opened on: once that is no longer current, it is stale.
  state stateFor = ""
  // The row editor's heading for a `set-row` edit (T5).
  state rowWords = ""
  // (Bound to the copy and the files' digests it was opened on, which its selection was reported
  // under: a write since either, anyone's, leaves it stale until selected and opened again; a
  // re-read that moves nothing does not.)
  derive filesNow = changes.files.split(" ").slice(1).join(" ")
  derive stateStale = (editKind == "set-state" or editKind == "set-row" or editKind == "promote-param" or editKind == "promote-token" or editKind == "detach-param") and (inspected.stale != "" or inspected.readOnly != "" or inspected.files != filesNow or `${inspected.key}␟${filesNow}` != stateFor)
  // (A panel edit of a param is no branch editor draft: `draftFor` is the branch editor's.)
  derive draftStale = editKind == branchOp and draftFor != "" and not scopeOwn and (branch.token != editTarget or branch.when != editWhen)
  // The branch's value as the draft has it, and its typed fields.
  derive shownValue = editKind == branchOp and draftFor != "" and editTarget == branch.token and not draftStale ? editValue : branch.value
  // The branch by what it is, not which read: a read that gives the same
  // value back (after a scrub cancelled, an undo elsewhere) keeps the cut.
  derive branchKey = `${branch.token}␟${branch.column}␟${branch.when}␟${branch.value}␟${branch.readOnly}`
  derive partsBase = rawFor == branchKey and editKind == branchOp and editTarget == branch.token ? rawBase : branch.value
  resource typed = loadParts(branch.kind, partsBase, design.answer) as shape Typed else empty(ok=false)
  // The cut by its value and its parts (a reread that reads a name as
  // another kind cuts it otherwise, and a draft of the old cut is stale).
  derive partsKey = `${branchKey}␟${typed.of}␟${typed.parts.map(p => p.key).join(",")}`
  // The fields' texts: the draft's while it is this cell's token edit from
  // this cut, else the cut's own (another edit replaced it, or none).
  derive fieldDraft = partFor == partsKey and editKind == branchOp and editTarget == branch.token
  derive fieldTexts = fieldDraft ? partTexts : typed.parts.map(p => p.text)
  // Fields that must hold something and are empty (required, or holding the
  // place before a later part that is written): emptied, a later part would
  // read in its place, so nothing is drafted until they are filled.
  derive partMissing = typed.parts.filter(p => p.control != "fixed" and fieldTexts.slice(p.index, p.index + 1).join("") == "" and (not p.optional or (p.after >= 0 and fieldTexts.slice(p.after, p.after + 1).join("") != ""))).map(p => p.label).join(", ")
  // A cell's token draft typed against another value of its branch (it
  // moved under it, a write elsewhere): stale, as one for another branch is.
  derive partsStale = editKind == branchOp and editTarget == branch.token and draftFor != "" and draftFor != branchKey

  // The oldest highlight here fades after 3 s, then the next.
  task fading when lit.names.length > 0 key=`${lit.epoch}-${lit.file}-${lit.seq}`
    after(3000, fade)
  // Each answer asks again: at once after one, after 3 s after a failure.
  // The rows nothing sets that the Inspector folds now (the selection's, and its held state's): never the row being
  // edited, none once shown for this visit.
  derive foldedRows = initialFor == inspected.visit ? [] : inspected.rows.filter(r => r.initial and not (editTarget != "" and (editTarget == r.edit or editTarget == r.state))).map(r => r.name)
  derive foldedHeld = initialFor == inspected.visit ? [] : inspected.heldRows.filter(r => r.initial and not (editTarget != "" and (editTarget == r.edit or editTarget == r.state))).map(r => r.name)
  // Apply can be pressed: the proposal is in, for this draft, and nothing it rests on moved.
  // Said once each draft first can be applied, and kept while it is read again on each answer (no repeat), but not
  // while a scrub replaces Apply or the draft is stale (review2's round 1).
  state readyFor = ""
  derive draftReadyKey = `${editKind}|${editTarget}|${editWhen}|${editValue}`
  derive readyLine = readyFor == draftReadyKey and editKind != "" and applyAnswer and not scrubShown ? "Proposal ready: Apply or Cancel." : ""
  task sayReady when applyReady and editKind != "" and readyFor != draftReadyKey key=draftReadyKey
    after(1, markReady)
  // The answer in hand is this draft's and could be applied (a re-read on each answer keeps the last one in hand);
  // Apply itself waits on no read or write in flight.
  derive applyAnswer = not (not proposal.ok or not proposal.active or proposal.key != draftKey or draftStale or partsStale or stateStale or not canPropose or (branch.readOnly != "" and editTarget == branch.token and editKind == branchOp))
  derive applyReady = applyAnswer and not pending(proposal) and not pending(written)
  task follow when not pending(changes) and changes.ok key=changes.answer
    after(1, advance)
  task retry when not pending(changes) and not changes.ok key=changes.answer
    after(3000, advance)
  // A clients read refused while the poll goes on is asked again, each 3 s
  // (its own count: the poll's answers would put it off for ever).
  task watchCanvas when canvasAt.frame.indexOf("#g=") >= 0 and (canvasPolled != canvasKey or canvasPollsLeft > 0) and not pending(canvasIn) and not pending(canvasAt) key=canvasPoll
    after(1000, pollCanvas)
  task watchGrid when canvasView != "one" and gridPage != "" and not pending(gridAt) key=gridPoll
    after(1000, pollGrid)
  task retryClients when hello.local and not pending(clients) and not clients.ok key=clientsTries
    after(3000, reloadClients)

  action advance
    // A change (an answer, paced while a scrub is open), another run, more
    // missed than the server keeps, or no answer: read the files again.
    if changes.missed or not hello.ok or not changes.ok or changes.paced != pacedAt
      refresh hello
      refresh canvasCheck
    if not design.ok
      refresh design
    since = changes.seq
    filesAt = changes.files
    pacedAt = changes.paced
    if not scrubShown
      proposeAt = changes.paced
    epoch = changes.epoch
    asks = asks + 1
  action editRemoteAt(v: string)
    remoteAt = v
  action editRemoteCode(v: string)
    remoteCode = v
  action pairRemote
    if not pending(pairedWith) and remoteAt.trim() != "" and remoteCode.trim() != ""
      send pairedWith = pairRemote(remoteAt, remoteCode, person)
      remoteCode = ""
  action pollCanvas
    canvasPoll = canvasPoll + 1
    canvasPollsLeft = (canvasPolled == canvasKey ? canvasPollsLeft : 40) - 1
    canvasPolled = canvasKey
  action reloadCanvas
    canvasTick = canvasTick + 1
  action pollGrid
    gridPoll = gridPoll + 1
  action toggleGallery(checked: bool)
    galleryOn = checked
  action chooseCanvasView(v: string)
    canvasView = v
  action chooseGridAxis(v: string)
    gridAxis = v
  action chooseGridLarge(v: string)
    gridLarge = match parseNumber(v) { case some(n) => n, case none => 0 }
  action chooseGridCap(v: string)
    gridCap = match parseNumber(v) { case some(n) => n, case none => 6 }
  action toggleGridMirror(checked: bool)
    gridMirror = checked
  action reloadClients
    clientsTries = clientsTries + 1
    refresh clients
  action choosePairScope(v: string)
    pairScope = v
  action mintCode
    if not pending(paircode)
      send paircode = mintCode(pairScope)
  action revokeClient(c: string)
    if not pending(revoked)
      send revoked = revokeClient(c)
  action reconnect
    refresh hello
    refresh canvasCheck
    // A poll still held answers for itself; a second would race it. One
    // answered goes on from where it got to, as `advance` would.
    if not pending(changes)
      if changes.ok
        since = changes.seq
        filesAt = changes.files
        pacedAt = changes.paced
        if not scrubShown
          proposeAt = changes.paced
        epoch = changes.epoch
      asks = asks + 1
  action editName(v: string)
    draftName = v
  action saveName
    canvasTick = canvasTick + 1
    if draftName.trim() != ""
      person = draftName.trim()
      renaming = false
  action changeName
    // The tool stays itself while the name is retyped: its long poll keeps
    // naming it, so its pins hold. A scrub open is its own: it ends first.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    draftName = person
    renaming = true
  action dialNumber(op: string, name: string, unit: string, n: number)
    // A scrub open on another edit ends first.
    if scrubShown and not (editKind == op and editTarget == name and editWhen == "")
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = op
    editTarget = name
    // (A slider mid-drag is not scrolled: its row goes clear of the dock when it is let go.)
    dockedFor = `${op}|${name}`
    editWhen = ""
    // A panel edit: the param's own line, no branch editor draft or mode scope.
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
    editValue = `${n}${unit}`
  action dialStepped(op: string, name: string, unit: string, v: string)
    // A stepper's number, with its dial's unit.
    if scrubShown and not (editKind == op and editTarget == name and editWhen == "")
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = op
    editTarget = name
    // The dock newly opened for this edit: its row scrolled to the top, clear of it (the focus stays in the field).
    if not docked or dockedFor != `${op}|${name}`
      scrollIntoView(`dial-${name}`, block="start")
    dockedFor = `${op}|${name}`
    editWhen = ""
    // A panel edit: the param's own line, no branch editor draft or mode scope.
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
    editValue = v.trim() == "" ? "" : `${v.trim()}${unit}`
  action dialReleased(op: string, name: string, n: number)
    if docked and dockedFor == `${op}|${name}`
      scrollIntoView(`dial-${name}`, block="start")
    // A slider let go: the scrub on it writes its last value, once that is
    // previewed.
    if scrubShown and editKind == op and editTarget == name and editWhen == "" and not pending(written)
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = releaseScrub(file, editKind, editTarget, editWhen, editValue)
  action dialText(op: string, name: string, v: string)
    // A scrub open on another edit ends first.
    if scrubShown and not (editKind == op and editTarget == name and editWhen == "")
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = op
    editTarget = name
    // The dock newly opened for this edit: its row scrolled to the top, clear of it (the focus stays in the field).
    if not docked or dockedFor != `${op}|${name}`
      scrollIntoView(`dial-${name}`, block="start")
    dockedFor = `${op}|${name}`
    editWhen = ""
    // A panel edit: the param's own line, no branch editor draft or mode scope.
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
    editValue = v.trim()
  action resetParam(name: string)
    // The app's line goes, and the default applies again: `unset-param`.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = "unset-param"
    editTarget = name
    dockedFor = `unset-param|${name}`
    editWhen = ""
    editValue = ""
    // A press: focus goes to the dock at once (drawn in this commit, and never disabled, as Apply is while the
    // proposal is read again), Tab then reaching Apply; a typed draft's never moves (review2 06:54). Its row
    // scrolled to the top, clear of the dock.
    focus("proposal-dock")
    scrollIntoView(`dial-${name}`, block="start")
    // A panel edit: the param's own line, no branch editor draft or mode scope.
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
  action rescope
    if not pending(written)
      send written = rescopeLast(client)
  action toggleInspect
    if not pending(inspectSent)
      send inspectSent = sendInspect(client, not inspected.inspecting)
  action selectUp(up: number)
    if not pending(selectedUp)
      // How deep the selection it lands on should be, from the selection it moves from (review2 11:33).
      upFromKey = inspected.key
      upRefusalsAt = refusalsKey
      upExpect = inspected.chain.length - up
      upNote = ""
      send selectedUp = sendSelectUp(client, inspected.build, up)
  action showInitial(key: string)
    initialFor = key
  action editState(target: string, value: string)
    dockedFor = ""
    // A style's state part row (T4): `set-state`, which rebuilds, so no scrub.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    // (A token cell open in the branch editor closes: one edit at a time.)
    selToken = ""
    editKind = "set-state"
    editTarget = target
    editWhen = ""
    editValue = value
    stateFor = `${inspected.key}␟${filesNow}`
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
  action editRow(target: string, words: string, value: string)
    dockedFor = ""
    // A row as its author wrote it (T5): `set-row` where it is written, or on its style; it rebuilds, so no scrub.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    selToken = ""
    editKind = "set-row"
    editTarget = target
    rowWords = words
    editWhen = ""
    editValue = value
    stateFor = `${inspected.key}␟${filesNow}`
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
  action moveRow(kind: string, target: string, words: string)
    dockedFor = ""
    // A row moved between rungs (T5, D6's set): promoted to a new param or token (its name typed), or a param
    // detached to its template; one transaction, rebuilt.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    selToken = ""
    editKind = kind
    editTarget = target
    rowWords = words
    editWhen = ""
    editValue = ""
    stateFor = `${inspected.key}␟${filesNow}`
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
  action stateValue(v: string)
    editValue = v.trim()
  action holdState(state: string)
    if not pending(holdSent)
      send holdSent = sendHold(client, state)
  // A row's token, on the branch that won for the selected copy: the grid's
  // cell editor, its edits and scrubs, scoped to that branch.
  action editFromSelection(token: string, column: string, place: string)
    dockedFor = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    // The app's own design: the one the running app resolved it in.
    file = ""
    selToken = token
    selColumn = column
    selPlace = place
    pinning = false
    scopeOwn = false
    focusDial = ""
    editKind = ""
    rawFor = ""
    partFor = ""
    impactToken = token
  action showImpact(token: string)
    impactToken = token
  action outlineImpact
    if impactToken != "" and not pending(outlined)
      send outlined = outlineUses(client, impactToken)
  action selectCell(token: string, column: string)
    dockedFor = ""
    // A scrub open is of another edit: it ends first.
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    selToken = token
    selColumn = column
    selPlace = ""
    pinning = false
    scopeOwn = false
    focusDial = ""
    editKind = ""
    rawFor = ""
    partFor = ""
  action showDial(name: string, group: string, more: bool)
    if more and not opened.includes(group)
      opened = opened.concat([group])
    focusDial = name
  action cellText(v: string)
    dockedFor = ""
    // A scrub open on another edit (another branch of it, a panel edit) ends first.
    if scrubShown and not (editKind == branchOp and editTarget == branch.token and editWhen == (scopeOwn ? branch.own : branch.when))
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = branchOp
    editTarget = branch.token
    editWhen = scopeOwn ? branch.own : branch.when
    editValue = v.trim()
    // The typed fields are cut from this text now.
    rawBase = v.trim()
    rawFor = branchKey
    partFor = ""
    draftFor = branchKey
  action partEdit(i: number, v: string)
    dockedFor = ""
    // One typed field: the value with this part changed and every other as
    // written, so the line written changes only there.
    if typed.ok and typed.of == partsBase
      if scrubShown and not (editKind == branchOp and editTarget == branch.token and editWhen == (scopeOwn ? branch.own : branch.when))
        scrubTick = scrubTick + 1
        scrubWant = false
        send written = cancelScrub(scrubAsk)
      let texts = fieldTexts.map((t, j) => j == i ? v.trim() : t)
      let missing = typed.parts.filter(p => p.control != "fixed" and texts.slice(p.index, p.index + 1).join("") == "" and (not p.optional or (p.after >= 0 and texts.slice(p.after, p.after + 1).join("") != ""))).length > 0
      partTexts = texts
      partFor = partsKey
      draftFor = branchKey
      editKind = branchOp
      editTarget = branch.token
      editWhen = scopeOwn ? branch.own : branch.when
      editValue = missing ? "" : [typed.parts.map(p => p.control == "fixed" ? p.text : (texts.slice(p.index, p.index + 1).join("") == "" and p.optional ? "" : [p.pre, texts.slice(p.index, p.index + 1).join(""), p.post].join(""))).join(""), typed.tail].join("")
  action onlyThisMode
    dockedFor = ""
    if scrubShown and not (editKind == branchOp and editTarget == branch.token and editWhen == branch.own)
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    // A value already typed for this cell is kept, now for this mode alone.
    if not (editKind == branchOp and draftFor != "" and editTarget == branch.token)
      editValue = branch.value
      // A fresh draft: the fields are the value's, and it is of this value.
      rawFor = ""
      partFor = ""
      draftFor = branchKey
    scopeOwn = true
    editKind = branchOp
    editTarget = branch.token
    editWhen = branch.own
  action pin
    pinning = true
  action editNewName(v: string)
    newName = v
  action editNewValue(v: string)
    newValue = v
  // Its button's `disabled` is no guard against Enter in either field (`submit`).
  action addToken
    if newName.trim() != "" and newValue.trim() != ""
      if scrubShown
        scrubTick = scrubTick + 1
        scrubWant = false
        send written = cancelScrub(scrubAsk)
      editKind = "add-token"
      editTarget = newName.trim()
      editWhen = ""
      editValue = newValue.trim()
  // Stage 11: a base or package value set for this app (its override line: set-token, theme2's 17:09Z
  // ruling, one op for both), or the app's line over one of theirs taken away (remove-token), each
  // reviewed and applied as any edit.
  action setForApp(name: string, value: string, from: string)
    dockedFor = ""
    // (The override is the app's line: written in the app's design, whichever file is open.)
    file = ""
    newName = name
    newValue = value
    // (One platform's value becomes the app's on every platform: said beside the proposal.)
    setForAppNote = from != "" ? `${name} for this app starts from ${from}, and the app's value is every platform's.` : ""
    setForAppName = name
    // (A new edit: the read-only branch a base's or package's cell opened is closed, so its guard is not this one's.)
    selToken = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = "set-token"
    editTarget = name
    editWhen = ""
    editValue = value
    // (A panel edit: no branch draft, no mode scope.)
    draftFor = ""
    rawFor = ""
    partFor = ""
    scopeOwn = false
  action backToBase(name: string)
    dockedFor = ""
    file = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = "remove-token"
    editTarget = name
    editWhen = ""
    editValue = ""
  action panelBackToPackage(name: string, row: string)
    // Back to the package from a param's row: as backToBase, its proposal docked and its row scrolled clear of it.
    // (No file reset: the component panel shows for the app's design alone, so the proposal is drawn at once.)
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = "remove-token"
    editTarget = name
    editWhen = ""
    editValue = ""
    dockedFor = `remove-token|${name}`
    focus("proposal-dock")
    scrollIntoView(`dial-${row}`, block="start")
  action openBase(name: string)
    openedBase = openedBase.concat([name])
  action editRename(v: string)
    renameTo = v
  action renameToken
    if renameTo.trim() != ""
      if scrubShown
        scrubTick = scrubTick + 1
        scrubWant = false
        send written = cancelScrub(scrubAsk)
      editKind = "rename-token"
      editTarget = selToken
      editWhen = ""
      editValue = renameTo.trim()
  action removeToken
    dockedFor = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = "remove-token"
    editTarget = selToken
    editWhen = ""
    editValue = ""
  action cancelEdit
    dockedFor = ""
    readyFor = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    editKind = ""
    scopeOwn = false
    rawFor = ""
    partFor = ""
  action startScrub
    if not scrub.live and not pending(written)
      scrubAsk = scrubAsk + 1
      scrubWant = true
  action keepScrub
    // The one write: what the server previews, once it is the draft.
    if scrub.live and scrub.ready and not partsStale and not pending(scrub) and not pending(written)
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = releaseScrub(file, editKind, editTarget, editWhen, editValue)
  action cancelScrub
    scrubTick = scrubTick + 1
    scrubWant = false
    send written = cancelScrub(scrubAsk)
  action apply
    // Only the proposal shown, for the edit drafted, is written.
    if canPropose and proposal.ok and proposal.active and not pending(proposal) and proposal.key == draftKey and not draftStale and not partsStale and not pending(written) and not scrubShown
      send written = writeEdit(file, editKind, editTarget, editWhen, editValue, client, proposal.review)
  action afterWrite
    // The draft written is done with; one drafted since stays.
    match written
      case some(w)
        if w.carried.length > 0
          picked = picked.concat(w.carried)
        if w.ok and w.key != "" and w.key == draftKey
          editKind = ""
          // (Its dock and its readiness go with it: the same field edited again opens, and is said, afresh.)
          dockedFor = ""
          readyFor = ""
          scopeOwn = false
          rawFor = ""
          partFor = ""
          if w.last == "remove" or w.last == "rename"
            selToken = ""
      case none
        editKind = ""
  action undo
    if not pending(written)
      send written = undoLast(client)
  action redo
    if not pending(written)
      send written = redoLast(client)
  action reloadDesign
    refresh design
  action chooseCanvasSize(size: string)
    canvasSize = size
  action choosePinBuild(id: string)
    pinBuild = id
  action choosePinScheme(v: string)
    pinScheme = v
  action choosePinContrast(v: string)
    pinContrast = v
  action choosePinMode(axis: string, value: string)
    pinMode = pinMode.filter(m => m.indexOf(`${axis}=`) != 0).concat(value == "" ? [] : [`${axis}=${value}`])
  action choosePinFont(v: string)
    pinFont = match parseNumber(v) { case some(n) => n, case none => 0 }
  action applyPin
    if not pending(pinned)
      send pinned = sendPin(client, pinBuild, pinScheme, pinContrast, pinMode.join(" "), pinFont, false, false)
  action clearPins
    pinScheme = ""
    pinContrast = ""
    pinMode = []
    pinFont = 0
    if not pending(pinned)
      send pinned = sendPin(client, pinBuild, "", "", "", 0, false, true)
  action previewPin
    if not pending(pinned) and pinBuild != "" and pinMode.length == 1
      send pinned = sendPin(client, pinBuild, "", "", pinMode.join(" "), 0, true, false)
  action chooseKind(k: string)
    importKind = k
  action pickImport
    showPicker("import-file")
  action importPicked(files: Picked[])
    if not pending(imported) and files.length > 0
      send imported = importFiles(client, importKind, files.map(f => f.path).join("\n"), files.map(f => f.name).join("\n"))
  action acceptImportNow(proposal: string)
    if not pending(written)
      send written = acceptImport(client, proposal, picked.join(";"))
  action editImportValue(proposal: string, index: number, mode: number, v: string)
    if not pending(written)
      send written = editImport(client, proposal, index, mode, v, picked.join(";"))
  // A mapped token is in until unticked: its id is picked when left out.
  action toggleLeaveOut(id: string, checked: bool)
    picked = checked ? picked.filter(p => p != id) : picked.filter(p => p != id).concat([id])
  // An offer's id is picked when it differs from where it began.
  action toggleOffer(id: string, on: bool, checked: bool)
    picked = checked != on ? picked.filter(p => p != id).concat([id]) : picked.filter(p => p != id)
  action togglePick(id: string, checked: bool)
    picked = checked ? picked.filter(p => p != id).concat([id]) : picked.filter(p => p != id)
  action acceptAll(proposal: string)
    if not pending(written)
      send written = acceptHeld(client, proposal, "")
  action acceptPicked(proposal: string, items: string)
    if not pending(written) and items != ""
      send written = acceptHeld(client, proposal, items)
  action dropProposal(proposal: string)
    if not pending(written)
      send written = dropHeld(client, proposal)
  action fade
    faded = lit.fadeTo
  action commit
    if not pending(committed)
      send committed = commitSession(client)
  action toggleHistory
    historyShown = not historyShown
  action toggleFiles
    filesShown = not filesShown
  action markReady
    readyFor = draftReadyKey
  action landUp
    upNote = inspected.chain.length < upExpect ? `The page's tree had fewer above it: it selected ${inspected.source}.` : ""
    upNoteKey = inspected.visit
    upExpect = -1
  action dropUp
    upExpect = -1
  action moreHistory
    historyPages = historyPages + 1
  action newerHistory
    historyPages = historyPages > 1 ? historyPages - 1 : 1
  action revert(commit: string)
    if not pending(reverted)
      send reverted = revertCommit(client, commit)
  action toggleMore(group: string)
    opened = opened.includes(group) ? opened.filter(g => g != group) : opened.concat([group])
  action chooseFile(f: string)
    dockedFor = ""
    if scrubShown
      scrubTick = scrubTick + 1
      scrubWant = false
      send written = cancelScrub(scrubAsk)
    // An edit drafted in one file is not carried to another.
    file = f
    editKind = ""
    selToken = ""
    selColumn = ""
    selPlace = ""
    pinning = false
    scopeOwn = false
    focusDial = ""
  action chooseA(name: string)
    pickA = name
  action chooseB(name: string)
    pickB = name

  view
    main testId="root" width="100%" height="100%" display="flex" flex-direction="column"
      header display="flex" align-items="center" gap=12 padding="8px 16px"
        text "Design tool" role="heading" aria-level=1 flex=1
        if person != "" and not renaming
          button press=changeName testId="person"
            text client
      scroll id="content" flex=1 min-height=0 padding=16
        if person == "" or renaming
          column gap=8 max-width=420 testId="ask-name"
            text "Your name" role="heading" aria-level=2
            text "Every edit you make is written as yours, so others reading the history know who made it." color="-exact-secondary-label"
            if renaming
              text "A new name is a new client: pins this tool holds are handed back when it changes." color="-exact-secondary-label" font="-exact-footnote" testId="rename-note"
            input value=draftName input=editName submit=saveName placeholder="Ada" aria-label="Your name" testId="name"
            button press=saveName disabled=(draftName.trim() == "") buttonStyle="filled" testId="save-name"
              text "Continue"
        else if not hello.ok
          column gap=8 max-width=520 testId="no-server"
            text (hello.error.startsWith("This client was revoked") ? "Revoked" : "No design server") role="heading" aria-level=2 testId="no-server-title"
            text hello.error color="-exact-secondary-label" testId="no-server-message"
            button press=reconnect buttonStyle="bordered" testId="reconnect"
              text "Try Again"
            // Remote mode (T6): another machine's server, by the address and
            // code its tool shows; an https door or a tunnel to this machine.
            column gap=8 padding=12 border-radius=12 background-color="-exact-secondary-background" testId="pair-remote"
              text "A design server on another machine" role="heading" aria-level=3
              text "Its tool shows a code and an address. Pair from the tool that address serves (<address>/__tamber/tool/, its certificate accepted in this browser if its SHA-256 is the one shown): type the address and the code there. That server refuses a tool opened anywhere else." color="-exact-secondary-label" font="-exact-footnote" testId="pair-remote-how"
              input value=remoteAt input=editRemoteAt placeholder="https://192.168.1.20:7743" aria-label="Design server address" testId="remote-at"
              input value=remoteCode input=editRemoteCode submit=pairRemote placeholder="XXXXX-XXXXX" aria-label="Pairing code" testId="remote-code"
              button press=pairRemote disabled=(pending(pairedWith) or remoteAt.trim() == "" or remoteCode.trim() == "") buttonStyle="bordered" testId="remote-pair"
                text "Pair"
              match pairedWith
                case some(r)
                  if not r.ok
                    text r.error color="-exact-system-red" font="-exact-footnote" testId="remote-error"
                case none
                  text "" display="none"
        else
          column gap=16
            column gap=4 testId="hello"
              text hello.app role="heading" aria-level=2 testId="app"
              text `${hello.protocol} · IR format ${hello.format}` color="-exact-secondary-label" testId="protocol"
              if not hello.local
                text (canWrite ? `Paired with this design server as ${hello.client}, at write.` : canPropose ? `Paired as ${hello.client}, at propose: an edit is held for review, for someone with write to accept; undo, commit, pins, holds, outlines, inspect mode and scrubs are greyed.` : `Paired as ${hello.client}, at read: you see the design, its history and the inspector's last selections; edits, pins, holds and the rest are greyed.`) color="-exact-system-orange" font="-exact-footnote" testId="paired-scope"
            // Pairing (LLP 1122 D12, T6): a code for a client on another
            // machine, at a scope, with each remote door to check it by; the
            // clients paired, each revoked here. The local tool's alone.
            if hello.local
              column gap=8 testId="pairing"
                row gap=8 align-items="center" flex-wrap="wrap"
                  text "Clients" role="heading" aria-level=2 flex=1
                  select value=pairScope change=choosePairScope aria-label="Pairing scope" testId="pair-scope"
                    option "Read" value="read"
                    option "Propose" value="propose"
                    option "Write" value="write"
                  button press=mintCode disabled=pending(paircode) buttonStyle="bordered" testId="pair-mint"
                    text "Pair a client"
                text (pairScope == "read" ? "Read: it sees the design and its history, and inspects without moving anyone's screens." : pairScope == "propose" ? "Propose: it reads, and offers changes for someone with write to accept." : "Write: it edits, commits, and pins, holds and outlines on the running copies.") color="-exact-secondary-label" font="-exact-footnote" testId="pair-scope-note"
                match paircode
                  case some(c)
                    if c.ok
                      column gap=4 padding=12 border-radius=12 background-color="-exact-secondary-background" testId="pair-code"
                        text c.code font="-exact-title2" font-family="ui-monospace, monospace" testId="pair-code-text"
                        text `Good once, until ${c.until}, for a client of its own at ${c.scope}. Type it on the other machine; nothing else is needed.` color="-exact-secondary-label" font="-exact-footnote" testId="pair-code-note"
                        if c.doors.length == 0
                          text "No remote door is open: start the dev loop or tamber serve with --remote <host:port> for a client on another machine." color="-exact-secondary-label" font="-exact-footnote" testId="pair-no-door"
                        for d in c.doors key=d.origin
                          if d.tunnel
                            text `Through the tunnel you trusted, at ${d.origin}` font="-exact-footnote" testId=`pair-door-${d.origin}`
                          else
                            column gap=2 testId=`pair-door-${d.origin}`
                              text `Open ${d.origin}/__tamber/tool/ there, and check its certificate's SHA-256 is` font="-exact-footnote"
                              text d.fingerprint font="-exact-caption1" font-family="ui-monospace, monospace" testId=`pair-fingerprint-${d.origin}`
                    else
                      text c.error color="-exact-system-red" font="-exact-footnote" testId="pair-error"
                  case none
                    text "" display="none"
                if not clients.ok
                  text clients.error color="-exact-system-red" font="-exact-footnote" testId="clients-error"
                else if clients.clients.length == 0
                  text "No client is paired." color="-exact-secondary-label" font="-exact-footnote" testId="no-clients"
                for k in clients.clients key=k.client
                  row gap=8 align-items="center" flex-wrap="wrap" testId=`client-${k.client}`
                    text k.client flex=1 min-width=0
                    text k.scope font="-exact-footnote" testId=`client-scope-${k.client}`
                    text `${k.peer}${k.seen != "" ? ` · seen ${k.seen}` : ""}` color="-exact-secondary-label" font="-exact-footnote"
                    button press=revokeClient(k.client) disabled=pending(revoked) buttonStyle="bordered" testId=`revoke-${k.client}`
                      text "Revoke"
                match revoked
                  case some(r)
                    text (r.ok ? r.note : r.error) color=(r.ok ? "-exact-secondary-label" : "-exact-system-red") font="-exact-footnote" testId="revoke-result"
                  case none
                    text "" display="none"
            // The canvas (LLP 1122 D3): the running app, at the dev loop's own
            // URL, in a frame the tool never scripts; every control goes
            // through the design server. Sandboxed short of navigating the tool.
            column gap=8 testId="canvas"
              row gap=8 align-items="center"
                text "Canvas" role="heading" aria-level=2 flex=1
                select value=canvasView change=chooseCanvasView aria-label="Copies shown" testId="canvas-view"
                  option "One copy" value="one"
                  option "Grid of modes" value="grid"
                  option "States side by side" value="states"
                select value=canvasSize change=chooseCanvasSize aria-label="Canvas size" testId="canvas-size"
                  option "Phone" value="phone"
                  option "Tablet" value="tablet"
                  option "Desktop" value="desktop"
                if hello.page != ""
                  link href=hello.page target="_blank" testId="canvas-open"
                    text "Open in a tab"
                // (The gallery is the local dev loop's: a paired canvas's gateway serves the app's pages only.)
                if hello.local and hello.page != "" and canvasView != "states"
                  row gap=4 align-items="center"
                    input type="checkbox" checked=galleryOn change=toggleGallery aria-label="Variant gallery" testId="canvas-gallery"
                    text "Gallery"
              // (The local dev loop's: a paired canvas comes through its gateway.)
              if hello.local and canvasCheck.refused != ""
                text canvasCheck.refused color="-exact-system-orange" font="-exact-footnote" testId="canvas-refused"
              if galleryOn and hello.local and hello.page != "" and canvasView != "states"
                text "The variant gallery: each library component the app uses, once per variant value, on the app's design. It follows each kept edit, not each scrub frame. It runs on the JS dev loop; another loop says so in the frame." color="-exact-secondary-label" font="-exact-footnote" testId="gallery-note"
              if not hello.local
                // (A grant spent, or an entry slower than its 30 s: a new one.)
                if canvasAt.frame != ""
                  button press=reloadCanvas disabled=pending(canvasAt) buttonStyle="bordered" testId="canvas-reload"
                    text "Reload Canvas"
                // (Several copies once the one entry frame has entered: they load the gateway's pages on its session.)
                if canvasAt.frame != "" and not pending(canvasAt) and (canvasView == "one" or canvasAt.frame.indexOf("#g=") >= 0)
                  iframe src=canvasAt.frame width=(canvasSize == "phone" ? 390 : canvasSize == "tablet" ? 820 : 1280) height=(canvasSize == "phone" ? 844 : canvasSize == "tablet" ? 1180 : 800) border="1px solid -exact-separator" border-radius=12 flex-shrink=0 sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads" testId="canvas-frame"
                else if canvasAt.frame != "" and not pending(canvasAt)
                  text "" display="none"
                else
                  row gap=8 align-items="center" flex-wrap="wrap"
                    text (canvasAt.error != "" ? canvasAt.error : "The canvas comes through the design server's gateway.") color="-exact-secondary-label" flex=1 testId="canvas-remote-none"
                    if canvasAt.error != ""
                      button press=reloadCanvas disabled=pending(canvasAt) buttonStyle="bordered" testId="canvas-retry"
                        text "Try Again"
              else if hello.page != ""
                if canvasView == "one"
                  iframe src=(galleryOn ? galleryFrame : hello.frame) width=(canvasSize == "phone" ? 390 : canvasSize == "tablet" ? 820 : 1280) height=(canvasSize == "phone" ? 844 : canvasSize == "tablet" ? 1180 : 800) border="1px solid -exact-separator" border-radius=12 flex-shrink=0 sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads" testId="canvas-frame"
              else
                column gap=4 padding=16 border-radius=12 background-color="-exact-secondary-background" testId="no-app"
                  text "No app running" role="heading" aria-level=3
                  text "The canvas shows the app from its dev loop. Start one (bun exact.mjs web, in the app's directory), then open the tool through it: bun exact.mjs tamber tool --via <its URL>. Stop this tool first: it holds the design server, and --via refuses while it runs." color="-exact-secondary-label" testId="no-app-how"
              // Several live copies (LLP 1122 T7), each its own build: pinned to its
              // mode and text size, or holding the selected view's state.
              if canvasView != "one"
                column gap=8 testId="grid-section"
                  if canvasView == "grid"
                    row gap=8 align-items="center" flex-wrap="wrap" testId="grid-controls"
                      select value=gridAxis change=chooseGridAxis aria-label="Dark copies vary" testId="grid-axis"
                        option "The first axis" value=""
                        for a in pinAxes key = a.name
                          option a.name value=a.name
                      input type="number" min=4 max=64 value=(gridLarge > 0 ? `${gridLarge}` : "") placeholder="px" change=chooseGridLarge aria-label="Larger text size" width=80 testId="grid-large"
                      select value=`${gridCap}` change=chooseGridCap aria-label="How many copies" testId="grid-cap"
                        option "4 copies" value="4"
                        option "6 copies" value="6"
                        option "8 copies" value="8"
                      row gap=4 align-items="center"
                        input type="checkbox" checked=gridMirror change=toggleGridMirror aria-label="Mirror navigation" testId="grid-mirror"
                        text "Mirror navigation"
                  text (hello.local ? "Each copy is its own origin, with its own storage: each starts with its own data. Mirrored navigation replays no actions." : "Copies through the gateway share its storage: what one writes, the others may read. Mirrored navigation replays no actions.") color="-exact-secondary-label" font="-exact-footnote" testId="grid-shared"
                  if not canWrite
                    text "Pins and holds need write scope: each copy shows the app's own mode." color="-exact-secondary-label" font="-exact-footnote" testId="grid-scope"
                  if gridPage == ""
                    text (hello.local ? "No app running: the copies frame its dev loop's page." : "The copies come through the gateway once the canvas has entered.") color="-exact-secondary-label" testId="grid-none"
                  if gridAt.note != ""
                    text gridAt.note color="-exact-secondary-label" testId="grid-note"
                  if gridAt.error != ""
                    text gridAt.error color="-exact-system-red" testId="grid-error"
                  row gap=12 flex-wrap="wrap" align-items="flex-start" testId="grid"
                    for t in gridAt.tiles key = t.name
                      column gap=4 testId=`grid-tile-${t.name}`
                        text t.label font="-exact-headline" testId=`grid-label-${t.name}`
                        iframe name=t.name src=t.src width=(canvasSize == "phone" ? 390 : canvasSize == "tablet" ? 820 : 1280) height=(canvasSize == "phone" ? 844 : canvasSize == "tablet" ? 1180 : 800) border="1px solid -exact-separator" border-radius=12 flex-shrink=0 sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-modals allow-downloads" testId=`grid-frame-${t.name}`
                        text (t.note != "" ? t.note : t.facts) color=(t.note != "" ? "-exact-system-orange" : "-exact-secondary-label") font="-exact-caption1" max-width=390 testId=`grid-note-${t.name}`
                        if t.app != ""
                          text t.app color="-exact-secondary-label" font="-exact-caption1" max-width=390 testId=`grid-app-${t.name}`
            // The builds (LLP 1122 D4): every running copy, its effective
            // facts from its own report, and pins, which last while the tool
            // runs (its long poll names it) and are handed back when it stops.
            // The inspector (LLP 1122 D5): inspect mode on the builds, the node
            // a click in one selected, where each row's value comes from, and
            // what may be edited from here (failing closed).
            column gap=8 testId="inspector"
              row gap=8 align-items="center"
                text "Inspector" role="heading" aria-level=2 flex=1
                button press=toggleInspect disabled=(pending(inspectSent) or not canWrite) buttonStyle=(inspected.inspecting ? "filled" : "bordered") testId="inspect-toggle"
                  text (inspected.inspecting ? "Stop inspecting" : "Inspect")
              match inspectSent
                case some(i)
                  text (i.ok ? i.note : i.error) color=(i.ok ? "-exact-secondary-label" : "-exact-system-red") font="-exact-footnote" testId="inspect-result"
                case none
                  text "" display="none"
              if inspected.inspecting
                for r in changes.refusals key=r.id
                  // A copy in the grid by its tile's label, as the grid shows it now.
                  if canvasView != "one" and gridAt.tiles.filter(t => t.build == r.id).length > 0
                    text `The ${gridAt.tiles.filter(t => t.build == r.id).map(t => t.label).join(", ")} copy (${r.host})${r.tail}` color="-exact-system-orange" font="-exact-footnote" testId=`inspect-refused-${r.id}`
                  else
                    text `${r.name}${r.tail}` color="-exact-system-orange" font="-exact-footnote" testId=`inspect-refused-${r.id}`
                if changes.refusedMore > 0
                  text `and ${changes.refusedMore} more builds could not turn Inspect on` color="-exact-system-orange" font="-exact-footnote" testId="inspect-refused-more"
              if not inspected.has
                text (inspected.inspecting ? "Click a view in the canvas or on a device: its source, rows and tokens show here." : "Turn on Inspect, then click a view in the canvas or on a device: its source, rows and tokens show here.") color="-exact-secondary-label" testId="no-selection"
              else
                column gap=4 testId="selection"
                  text inspected.source font="-exact-headline" testId="selection-source"
                  // Each a press that selects that ancestor on the build, as a click on it would (tamber/1.16).
                  if changes.noStep.includes(inspected.build) and inspected.chain.length > 0
                    text "This build can't move its selection up the chain: click the node itself." color="-exact-secondary-label" font="-exact-footnote" testId="selection-up-none"
                  for c in inspected.chain key=c.up
                    button press=selectUp(c.up) disabled=(not inspected.inspecting or pending(selectedUp) or changes.noStep.includes(inspected.build)) aria-label=`Select ${c.text}` testId=`selection-up-${c.up}`
                      text `in ${c.text}` color="-exact-secondary-label" font="-exact-footnote"
                  if upNote != "" and upNoteKey == inspected.visit
                    text upNote color="-exact-system-orange" font="-exact-footnote" testId="selection-up-note"
                  // (A move refused: the server's or the page's words.)
                  match selectedUp
                    case some(r)
                      if not r.ok
                        text r.error color="-exact-system-red" font="-exact-footnote" white-space="pre-wrap" testId="selection-up-error"
                    case none
                      text "" display="none"
                  text `${inspected.build}${inspected.modes != "" ? ` · ${inspected.modes}` : ""}` color="-exact-secondary-label" font="-exact-footnote" testId="selection-build"
                  if inspected.libraryIdentity != ""
                    column gap=2 testId="selection-library"
                      text `Library: ${inspected.libraryIdentity}` font="-exact-footnote" role="heading" aria-level=3 testId="library-identity"
                      text (inspected.libraryPart != "" ? `This node is its part ${inspected.libraryPart}` : "This node is no part of it") color="-exact-secondary-label" font="-exact-footnote" testId="library-part"
                      for p in inspected.libraryParts key=p.name
                        text `${p.here ? "▸ " : ""}${p.name}${p.slot ? " · its slot" : ""}` color=(p.here ? "-exact-label" : "-exact-secondary-label") font="-exact-footnote" testId=`library-part-${p.name}`
                      text "Its rows are the package's recipe, read only here; a token or param a row reads is set for this app." color="-exact-secondary-label" font="-exact-caption1" testId="library-readonly"
                  if inspected.stale != ""
                    text `No longer current: ${inspected.stale}. Select it again to edit from here.` color="-exact-system-orange" testId="selection-stale"
                  if inspected.readOnly != ""
                    text `Read-only: ${inspected.readOnly}` color="-exact-system-orange" testId="selection-readonly"
                  if inspected.trimmed
                    text "Some rows were left out: the report was too large." color="-exact-secondary-label" font="-exact-footnote"
                  if inspected.hold.status != "" and not inspected.hold.can
                    text inspected.hold.status color="-exact-secondary-label" font="-exact-footnote" testId="hold-status"
                  if inspected.hold.can
                    column gap=4 testId="hold"
                      row gap=8 align-items="center" flex-wrap="wrap"
                        text "Hold" font="-exact-footnote"
                        button press=holdState("active") disabled=(pending(holdSent) or not canWrite) buttonStyle=(inspected.hold.state == "active" ? "filled" : "bordered") testId="hold-active"
                          text "Pressed"
                        button press=holdState("hover") disabled=(pending(holdSent) or not canWrite) buttonStyle=(inspected.hold.state == "hover" ? "filled" : "bordered") testId="hold-hover"
                          text "Hovered"
                        button press=holdState("focus-visible") disabled=(pending(holdSent) or not canWrite) buttonStyle=(inspected.hold.state == "focus-visible" ? "filled" : "bordered") testId="hold-focus"
                          text "Focused"
                        button press=holdState("") disabled=(pending(holdSent) or inspected.hold.state == "" or not canWrite) testId="hold-release"
                          text "Let go"
                      if inspected.hold.status != ""
                        text inspected.hold.status color="-exact-secondary-label" font="-exact-footnote" testId="hold-status"
                      match holdSent
                        case some(h)
                          if not h.ok
                            text h.error color="-exact-system-red" font="-exact-footnote" testId="hold-error"
                        case none
                          text ""
                      if inspected.heldNote != ""
                        text inspected.heldNote color="-exact-system-orange" font="-exact-footnote" testId="held-note"
                      for r in inspected.heldRows.filter(r => not foldedHeld.includes(r.name)) key=r.name
                        row gap=8 align-items="center" flex-wrap="wrap" testId=`heldrow-${r.name}`
                          text r.name font="-exact-footnote" width="9rem"
                          text r.value font="-exact-caption1" font-family="ui-monospace, monospace" flex=1 min-width=0
                          text r.source color="-exact-secondary-label" font="-exact-caption1"
                          if r.token != ""
                            button press=editFromSelection(r.token, r.column, inspected.place) testId=`heldrow-link-${r.name}`
                              text ((r.state != "" or r.edit != "") ? `Edit the token ${r.token} instead` : `Open ${r.token}`)
                          if r.state != ""
                            button press=editState(r.state, r.stateText) disabled=(not canPropose) buttonStyle="bordered" testId=`heldrow-state-${r.name}`
                              text r.stateLabel
                          if r.edit != ""
                            button press=editRow(r.edit, r.editWords, r.editText) disabled=(not canPropose) buttonStyle="bordered" testId=`heldrow-row-${r.name}`
                              text r.editLabel
                          if r.reason != ""
                            text r.reason color="-exact-secondary-label" font="-exact-caption1" testId=`heldrow-reason-${r.name}`
                      if foldedHeld.length > 0
                        button press=showInitial(inspected.visit) aria-label=`Show ${foldedHeld.length} more held rows nothing sets (initial values)` testId="heldrow-initial"
                          text `${foldedHeld.length} more rows nothing sets (initial values)`
                  // Rows nothing sets, folded behind one control, but never the row being edited.
                  for r in inspected.rows.filter(r => not foldedRows.includes(r.name)) key=r.name
                    row gap=8 align-items="center" flex-wrap="wrap" testId=`selrow-${r.name}`
                      text r.name font="-exact-footnote" width="9rem"
                      text r.value font="-exact-caption1" font-family="ui-monospace, monospace" flex=1 min-width=0
                      text r.source color="-exact-secondary-label" font="-exact-caption1" testId=`selrow-source-${r.name}`
                      if r.rung == "param"
                        button press=editFromSelection(r.param, r.column, inspected.place) buttonStyle="bordered" testId=`selrow-edit-${r.name}`
                          text `Edit ${r.short}`
                        if r.token != ""
                          button press=editFromSelection(r.token, r.column, inspected.place) testId=`selrow-token-${r.name}`
                            text `Edit the token ${r.token} instead`
                      else if r.rung == "token"
                        button press=editFromSelection(r.token, r.column, inspected.place) buttonStyle="bordered" testId=`selrow-edit-${r.name}`
                          text `Edit ${r.token}`
                      else if (r.rung == "state" or r.rung == "template" or r.rung == "style") and r.token != ""
                        button press=editFromSelection(r.token, r.column, inspected.place) testId=`selrow-token-${r.name}`
                          text `Edit the token ${r.token} instead`
                      else if r.token != ""
                        button press=editFromSelection(r.token, r.column, inspected.place) testId=`selrow-link-${r.name}`
                          text `Open ${r.token}`
                      if r.state != ""
                        button press=editState(r.state, r.stateText) disabled=(not canPropose) buttonStyle="bordered" testId=`selrow-state-${r.name}`
                          text r.stateLabel
                      if r.edit != ""
                        button press=editRow(r.edit, r.editWords, r.editText) disabled=(not canPropose) buttonStyle="bordered" testId=`selrow-row-${r.name}`
                          text r.editLabel
                      if r.promote != ""
                        button press=moveRow("promote-param", r.promote, `${r.name}, as a new param`) disabled=(not canPropose) testId=`selrow-param-${r.name}`
                          text "Make it a param"
                      if r.promote != "" and r.tokenize
                        button press=moveRow("promote-token", r.promote, `${r.name}, as a new token`) disabled=(not canPropose) testId=`selrow-tokenize-${r.name}`
                          text "Make it a token"
                      if r.detach != ""
                        button press=moveRow("detach-param", r.detach, `${r.short}, detached to this template`) disabled=(not canPropose) testId=`selrow-detach-${r.name}`
                          text "Detach to this template"
                      if r.rung == "" and r.reason != ""
                        text r.reason color="-exact-secondary-label" font="-exact-caption1" testId=`selrow-reason-${r.name}`
                  if foldedRows.length > 0
                    button press=showInitial(inspected.visit) aria-label=`Show ${foldedRows.length} more rows nothing sets (initial values)` testId="selrow-initial"
                      text `${foldedRows.length} more rows nothing sets (initial values)`
              if impactToken != ""
                column gap=2 testId="impact"
                  row gap=8 align-items="center"
                    text (pending(uses) or uses.token != impactToken ? `${impactToken}: reading its uses…` : uses.ok ? `${impactToken}: read at ${uses.sites.length} source site(s), statically (not a count of mounted copies)` : uses.error) font="-exact-footnote" flex=1 testId="impact-count"
                    button press=outlineImpact disabled=(pending(outlined) or not inspected.inspecting or not canWrite) testId="impact-outline"
                      text "Outline"
                  match outlined
                    case some(o)
                      text (o.ok ? o.note : o.error) color=(o.ok ? "-exact-secondary-label" : "-exact-system-red") font="-exact-caption1" testId="impact-outlined"
                    case none
                      text "" display="none"
                  for u in (uses.token == impactToken ? uses.sites : []) key=`${u.file}:${u.line}:${u.col}`
                    text u.text color="-exact-secondary-label" font="-exact-caption1"
            column gap=8 testId="builds"
              text "Builds" role="heading" aria-level=2
              if changes.builds.length == 0
                text "No build is connected. The canvas's page is one once a dev loop runs; a device joins launched at the dev URL: bun exact.mjs ios --run --url <dev url>, or the Mac's likewise." color="-exact-secondary-label" testId="no-builds"
              for b in changes.builds key=b.id
                column gap=2 padding=8 border-radius=8 background-color="-exact-secondary-background" testId=`build-${b.id}`
                  row gap=8 align-items="center"
                    text `${b.host} · ${b.id}${b.gallery ? " · the gallery" : ""}` font="-exact-footnote" flex=1 testId=`build-name-${b.id}`
                    if b.pin != ""
                      text (b.caughtUp ? `pinned: ${b.pin}` : `pinning: ${b.pin}`) font="-exact-caption1" color=(b.caughtUp ? "-exact-secondary-label" : "-exact-system-orange") testId=`build-pin-${b.id}`
                    else if b.behind
                      text "handing back" font="-exact-caption1" color="-exact-system-orange" testId=`build-pin-${b.id}`
                  if b.reported
                    text `${b.scheme}${b.contrast != "" and b.contrast != "no-preference" ? ` · contrast ${b.contrast}` : ""}${b.mode != "" ? ` · ${b.mode}` : ""}${b.rootFontSize > 0 ? ` · ${b.rootFontSize}px` : ""}` testId=`build-status-${b.id}`
                  else
                    text "Not reported yet: it has not said what it shows." color="-exact-secondary-label" font="-exact-caption1" testId=`build-status-${b.id}`
                  if b.unsupported != ""
                    text `Not applied: ${b.unsupported}` color="-exact-system-orange" font="-exact-caption1" testId=`build-unsupported-${b.id}`
              row gap=8 align-items="center" flex-wrap="wrap" testId="pin-form"
                select value=pinBuild change=choosePinBuild disabled=(not canWrite) aria-label="Pin on" testId="pin-build"
                  option "Every build" value=""
                  for b in changes.builds key=b.id
                    option `${b.host} · ${b.id}` value=b.id
                select value=pinScheme change=choosePinScheme disabled=(not canWrite) aria-label="Scheme" testId="pin-scheme"
                  option "Scheme…" value=""
                  option "Light" value="light"
                  option "Dark" value="dark"
                select value=pinContrast change=choosePinContrast disabled=(not canWrite) aria-label="Contrast" testId="pin-contrast"
                  option "Contrast…" value=""
                  option "More" value="more"
                  option "Less" value="less"
                  option "No preference" value="no-preference"
                for a in pinAxes key=a.name
                  select value=pinMode.filter(m => m.indexOf(`${a.name}=`) == 0).map(m => m.slice(a.name.length + 1)).join("") change=choosePinMode(a.name) disabled=(not canWrite) aria-label=a.name testId=`pin-mode-${a.name}`
                    option `${a.name}…` value=""
                    for v in a.values key=v
                      option v value=v
                input type="number" min=4 max=64 value=(pinFont > 0 ? `${pinFont}` : "") disabled=(not canWrite) placeholder="px" change=choosePinFont aria-label="Root font size" width=80 testId="pin-font"
                button press=applyPin disabled=(pending(pinned) or (pinScheme == "" and pinContrast == "" and pinMode.length == 0 and pinFont == 0) or not pinFontOk or not canWrite) buttonStyle="filled" testId="pin-apply"
                  text "Pin"
                // One axis on one build, alone: it replaces that build's pin.
                button press=previewPin disabled=(pending(pinned) or pinBuild == "" or pinMode.length != 1 or pinScheme != "" or pinContrast != "" or pinFont != 0 or not canWrite) testId="pin-preview"
                  text "Preview this mode only"
                button press=clearPins disabled=(pending(pinned) or not canWrite) testId="pin-clear"
                  text "Hand back"
              match pinned
                case some(p)
                  text (p.ok ? p.note : p.error) color=(p.ok ? "-exact-secondary-label" : "-exact-system-red") testId="pin-result"
                case none
                  text "" display="none"
            // Design files only: the server's files hold the app's Contract
            // sources too (LLP 1121 stage 8 D), whose state parts it writes.
            if hello.files.filter(f => !f.path.endsWith(".contract")).length > 1
              select value=file change=chooseFile aria-label="Design file" testId="file"
                option "The app's design" value=""
                for f in hello.files.filter(f => !f.path.endsWith(".contract")) key=f.path
                  option f.path value=f.path
            if pending(design) and design.answer == 0
              row gap=8 align-items="center" testId="design-loading"
                progress aria-label="Reading the design"
                text "Reading the design…" color="-exact-secondary-label"
            else if not design.ok
              row gap=8 align-items="center"
                text design.error color="-exact-system-red" white-space="pre-wrap" flex=1 testId="design-error"
                button press=reloadDesign buttonStyle="bordered" testId="reload-design"
                  text "Try Again"
            // The design read, and nothing of it before or after a refusal.
            if design.ok and design.answer != 0 and design.file == file
              column gap=12 testId="dials"
                text "Dials" role="heading" aria-level=2
                if design.groups.length == 0
                  text "This design has no dials." color="-exact-secondary-label" testId="no-dials"
                for g in design.groups key=g.name
                  column gap=8 padding=12 border-radius=10 background-color="-exact-secondary-background" testId=`group-${g.name}`
                    text (g.name == "" ? "Dials" : g.name) role="heading" aria-level=3
                    for c in g.dials key=c.name
                      DialControl(locked=(not canPropose), c=c, focused=(focusDial == c.name), onNumber=dialNumber("set-dial", c.name, c.unit), onText=dialText("set-dial", c.name), onStep=dialStepped("set-dial", c.name, c.unit), onRelease=dialReleased("set-dial", c.name))
                    if g.more.length > 0
                      button press=toggleMore(g.name) testId=`more-${g.name}`
                        text (opened.includes(g.name) ? "Fewer" : `More (${g.more.length})`)
                      if opened.includes(g.name)
                        for c in g.more key=c.name
                          DialControl(locked=(not canPropose), c=c, focused=(focusDial == c.name), onNumber=dialNumber("set-dial", c.name, c.unit), onText=dialText("set-dial", c.name), onStep=dialStepped("set-dial", c.name, c.unit), onRelease=dialReleased("set-dial", c.name))
              if design.components.length > 0
                column gap=12 testId="components"
                  text "Components" role="heading" aria-level=2
                  for k in design.components key=k.identity
                    column gap=8 padding=12 border-radius=10 background-color="-exact-secondary-background" testId=`component-${k.name}`
                      row gap=8 align-items="baseline"
                        text k.name role="heading" aria-level=3
                        text (k.native ? `${k.identity} · a native view's` : k.identity) color="-exact-secondary-label" font="-exact-footnote" testId=`component-${k.name}-identity`
                      if k.variants.length > 0
                        column gap=4 testId=`variants-${k.name}`
                          text "Variants: the options each prop takes (the tool pins none on an instance)" color="-exact-secondary-label" font="-exact-footnote"
                          for v in k.variants key=v.prop
                            text `${v.prop}: ${v.options.join(" · ")}` testId=`variant-${k.name}-${v.prop}`
                      for g in k.groups key=g.name
                        column gap=4 testId=`param-group-${k.name}-${g.name}`
                          if g.name != ""
                            text g.name font="-exact-subheadline"
                          for r in g.params key=r.c.name
                            ParamControl(locked=(not canPropose), r=r, won=(levels.answer == design.answer ? levels.rows.filter(l => l.name == r.c.name) : []), focused=(focusDial == r.c.name), onNumber=dialNumber("set-param", r.c.name, r.c.unit), onText=dialText("set-param", r.c.name), onStep=dialStepped("set-param", r.c.name, r.c.unit), onRelease=dialReleased("set-param", r.c.name), onReset=resetParam(r.c.name), onToken=selectCell(r.token, design.columns.map(c => c.id).includes(selColumn) ? selColumn : design.firstColumn), onBackToPackage=panelBackToPackage(r.packageToken, r.c.name))
                          if g.more.length > 0
                            button press=toggleMore(`${k.identity}|${g.name}`) testId=`more-${k.name}-${g.name}`
                              text (opened.includes(`${k.identity}|${g.name}`) ? "Fewer" : `More (${g.more.length})`)
                            if opened.includes(`${k.identity}|${g.name}`)
                              for r in g.more key=r.c.name
                                ParamControl(locked=(not canPropose), r=r, won=(levels.answer == design.answer ? levels.rows.filter(l => l.name == r.c.name) : []), focused=(focusDial == r.c.name), onNumber=dialNumber("set-param", r.c.name, r.c.unit), onText=dialText("set-param", r.c.name), onStep=dialStepped("set-param", r.c.name, r.c.unit), onRelease=dialReleased("set-param", r.c.name), onReset=resetParam(r.c.name), onToken=selectCell(r.token, design.columns.map(c => c.id).includes(selColumn) ? selColumn : design.firstColumn), onBackToPackage=panelBackToPackage(r.packageToken, r.c.name))
              column gap=8 testId="tokens"
                text "Tokens" role="heading" aria-level=2
                column overflow-x="auto" align-items="flex-start" testId="grid"
                  column gap=2 flex-shrink=0
                    row gap=8 align-items="end"
                      text "Token" width=200 flex-shrink=0 font="-exact-footnote" color="-exact-secondary-label"
                      for col in design.columns key=col.id
                        text col.label width=96 flex-shrink=0 font="-exact-footnote" color="-exact-secondary-label" testId=`column-${col.id}`
                    for tg in design.tokenGroups key=tg.name
                      text tg.name font="-exact-subheadline" padding="8px 0 2px" testId=`token-group-${tg.name}`
                      for t in tg.tokens key=t.name
                        row gap=8 align-items="center" testId=`token-${t.name}`
                          column width=200 flex-shrink=0
                            text t.name
                            // (Stage 11: the base's and a package's values are read-only; the app sets its own.)
                            if t.source == "base"
                              text "Exact's base, per platform" font="-exact-caption1" color="-exact-secondary-label" testId=`token-source-${t.name}`
                            else if t.source == "package"
                              text `From the ${t.package} package` font="-exact-caption1" color="-exact-secondary-label" testId=`token-source-${t.name}`
                            if lit.names.includes(t.name)
                              text `changed by ${lit.whos.filter((w, i) => lit.names.indexOf(t.name) == i).join("")}` font="-exact-caption1" color=lit.tints.filter((c, i) => lit.names.indexOf(t.name) == i).join("") testId=`changed-by-${t.name}`
                            if t.follows != ""
                              text `follows ${t.follows}` font="-exact-caption1" color="-exact-secondary-label" testId=`follows-${t.name}`
                          for cell in t.cells key=cell.column
                            column width=96 flex-shrink=0 box-sizing="border-box" gap=2 padding=2 border-radius=6 border-width=2 border-style="solid" border-color=(lit.cells.includes(`${t.name}|${cell.column}`) ? lit.cellTints.filter((c, i) => lit.cells.indexOf(`${t.name}|${cell.column}`) == i).join("") : "transparent") press=selectCell(t.name, cell.column) role="button" aria-label=cell.label testId=`cell-${t.name}-${cell.column}`
                              if cell.kind == "box-shadow"
                                // In a padded box of the column's scheme, so the shadow falls on its own ground.
                                view padding=6 border-radius=4 color-scheme=cell.scheme background-color="-exact-background" testId=`cell-shadow-${t.name}-${cell.column}`
                                  view height=16 border-radius=4 background-color="-exact-secondary-background" box-shadow=cell.shadow
                              else if cell.kind == "text-shadow"
                                view color-scheme=cell.scheme background-color="-exact-background" border-radius=4 testId=`cell-shadow-${t.name}-${cell.column}`
                                  text "Aa" color="-exact-label" text-shadow=cell.shadow
                              else if cell.kind == "color"
                                view height=24 border-radius=4 background-color=cell.swatch border="1px solid -exact-separator"
                              if cell.residual
                                text "fallback" font="-exact-caption2" color="-exact-system-orange" testId=`cell-fallback-${t.name}-${cell.column}`
                              text (cell.residual ? cell.note : cell.css) font="-exact-caption2" color="-exact-secondary-label" line-clamp=1 testId=`cell-text-${t.name}-${cell.column}`
                              for b in cell.pairs key=b.name
                                text `${b.ratio} on ${b.name}` font="-exact-caption2" color=(b.low ? "-exact-system-red" : "-exact-secondary-label") line-clamp=1 testId=`pair-${t.name}-${cell.column}-${b.name}`
                          // A base or package value per platform, a cell each across the grid (not wrapped in the name
                          // column), then what may be done with it: name, columns, controls, in reading order.
                          for c in t.columns.filter(c => c.ships or openedBase.includes(t.name)) key=c.name
                            column width=160 flex-shrink=0 testId=`token-base-cell-${t.name}-${c.name}`
                              text `${c.label} ${c.value}${c.stretch ? " (a stretch)" : ""} · ${c.from}` font="-exact-caption2" color="-exact-secondary-label" testId=`token-base-${t.name}-${c.name}`
                          if (t.columns.filter(c => not c.ships).length > 0 and not openedBase.includes(t.name)) or t.source != "app" or t.over != ""
                            row gap=8 align-items="center" flex-shrink=0
                              if t.columns.filter(c => not c.ships).length > 0 and not openedBase.includes(t.name)
                                button press=openBase(t.name) testId=`token-base-more-${t.name}`
                                  text "Other platforms"
                              if t.source != "app"
                                button press=setForApp(t.name, t.start, t.startFrom) disabled=(not canPropose) testId=`set-for-app-${t.name}`
                                  text "Set for this app"
                              if t.over != ""
                                text t.over font="-exact-caption1" color="-exact-secondary-label" testId=`token-over-${t.name}`
                                button press=backToBase(t.name) disabled=(not canPropose) testId=`back-${t.name}`
                                  text t.back
              if design.icons.length > 0
                column gap=4 testId="icons"
                  text "Icons" font="-exact-subheadline" padding="8px 0 2px"
                  text "Read only: no edit operation writes an icon, so change one in the design file." color="-exact-secondary-label" font="-exact-footnote"
                  for ic in design.icons key=ic.name
                    row gap=8 align-items="center" testId=`icon-${ic.name}`
                      text ic.name width="12rem" flex-shrink=0
                      text [ic.sf != "" ? `sf ${ic.sf}` : "", ic.material != "" ? `material ${ic.material}` : "", ic.svg != "" ? "svg" : ""].filter(x => x != "").join(" · ") color="-exact-secondary-label" font="-exact-footnote" testId=`icon-${ic.name}-sources`
              // The branch of the cell chosen, read of the grid shown.
              if selPlace != "" and branch.ok and branch.token == selToken and branch.column == selColumn and branch.answer == design.answer and not pending(branch) and branch.place != selPlace
                text "The design's axes changed since that copy was selected, so this column is another branch now: select it again." color="-exact-system-orange" testId="branch-moved"
              if selToken != "" and branch.ok and branch.token == selToken and branch.column == selColumn and branch.answer == design.answer and not pending(branch) and (selPlace == "" or branch.place == selPlace)
                column gap=8 padding=12 border-radius=10 background-color="-exact-secondary-background" testId="branch"
                  text (scopeOwn ? `${branch.token} · ${branch.own} (only this mode)` : branch.label) role="heading" aria-level=3 testId="branch-label"
                  if branch.readOnly != ""
                    text branch.readOnly color="-exact-secondary-label" font="-exact-footnote" testId="branch-readonly"
                  if branch.kind == "duration" or branch.kind == "easing"
                    text "Rebuilds: an edit to a motion token rebuilds the app, so Apply writes it, with no scrub." font="-exact-footnote" color="-exact-secondary-label" testId="branch-rebuilds"
                  if branch.expression and not pinning and not typed.ok
                    text `Follows ${branch.inputs.concat(branch.dials.map(d => d.name)).concat(branch.roles).join(", ")}: edit those, or pin a value here.` color="-exact-secondary-label" testId="branch-inputs"
                    for n in branch.inputs key=n
                      button press=selectCell(n, selColumn) testId=`input-${n}`
                        text n
                    for d in branch.dials key=d.name
                      if d.hidden
                        text `${d.name}: a dial with no control (control=none)` color="-exact-secondary-label" font="-exact-footnote" testId=`input-${d.name}`
                      else
                        button press=showDial(d.name, d.group, d.more) testId=`input-${d.name}`
                          text `${d.name} (dial)`
                    for r in branch.roles key=r
                      text `${r}: ${branch.kind == "color" ? "a platform colour" : "a platform value"}, set by the system` color="-exact-secondary-label" font="-exact-footnote" testId=`input-${r}`
                    button press=pin disabled=(not canPropose or branch.readOnly != "") buttonStyle="bordered" testId="pin"
                      text "Pin a value"
                  else
                    if branch.expression and typed.ok
                      // Its fields keep the names it holds (a shadow's colour token).
                      text `Names ${branch.inputs.concat(branch.dials.map(d => d.name)).concat(branch.roles).join(", ")}: its fields keep them; edit those for their own values.` color="-exact-secondary-label" testId="branch-names"
                      for n in branch.inputs key=n
                        button press=selectCell(n, selColumn) testId=`input-${n}`
                          text n
                      for d in branch.dials.filter(d => not d.hidden) key=d.name
                        button press=showDial(d.name, d.group, d.more) testId=`input-${d.name}`
                          text `${d.name} (dial)`
                    else if branch.expression
                      text `Pinned here: no longer follows ${branch.inputs.concat(branch.dials.map(d => d.name)).concat(branch.roles).join(", ")}.` color="-exact-system-orange" testId="pinned"
                    if typed.ok and typed.of == partsBase
                      column gap=6 testId="typed"
                        for p in typed.parts.filter(p => p.control != "fixed") key=p.key
                          row gap=8 align-items="center" testId=`part-${p.key}`
                            text p.label width="7rem" color="-exact-secondary-label" font="-exact-footnote"
                            if p.control == "number"
                              input type="number" value=fieldTexts.slice(p.index, p.index + 1).join("") input=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` flex=1 min-width=0 testId=`part-${p.key}-field`
                            else if p.control == "select"
                              select value=fieldTexts.slice(p.index, p.index + 1).join("") change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                for o in p.options key=o
                                  option (o == "" ? "none" : o) value=o
                            else if p.control == "inset"
                              select value=fieldTexts.slice(p.index, p.index + 1).join("").toLowerCase() change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                option "outside" value=""
                                option "inset" value="inset"
                            else if p.control == "style"
                              select value=fieldTexts.slice(p.index, p.index + 1).join("") change=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} ${p.label}` testId=`part-${p.key}-field`
                                option "unsaid" value=""
                                option "italic" value="italic"
                            else
                              input value=fieldTexts.slice(p.index, p.index + 1).join("") input=partEdit(p.index) disabled=(not canPropose or branch.readOnly != "") placeholder=(p.optional ? "unsaid" : "") aria-label=`${branch.token} ${p.label}` flex=1 min-width=0 testId=`part-${p.key}-field`
                        if partMissing != ""
                          text `Give ${partMissing} a value: emptied, the part after it would be read in its place.` color="-exact-system-orange" font="-exact-footnote" testId="typed-missing"
                    input value=shownValue change=cellText disabled=(not canPropose or branch.readOnly != "") aria-label=`${branch.token} value` testId="branch-value"
                  if not branch.exact
                    button press=onlyThisMode disabled=(not canPropose or branch.readOnly != "") testId="only-this-mode"
                      text "Only this mode"
                  if not branch.param
                    row gap=8
                      input value=renameTo input=editRename submit=renameToken disabled=(not canPropose or branch.readOnly != "") placeholder="New name" aria-label="New name" flex=1 min-width=0 testId="rename-to"
                      button press=renameToken disabled=(renameTo.trim() == "" or not canPropose or branch.readOnly != "") testId="rename"
                        text "Rename"
                      button commandfor="confirm-remove" command="show-modal" disabled=(not canPropose or branch.readOnly != "") destructive=true testId="remove"
                        text "Remove"
                  dialog id="confirm-remove" role="alertdialog" aria-label=`Remove ${selToken}?`
                    button press=removeToken disabled=(not canPropose or branch.readOnly != "") destructive=true commandfor="confirm-remove" command="close" testId="confirm-remove-yes"
                      text "Remove"
                    button commandfor="confirm-remove" command="close"
                      text "Cancel"
              if not branch.ok
                text branch.error color="-exact-system-red" testId="branch-error"
              column gap=8 testId="add"
                text "Add a token" role="heading" aria-level=3
                row gap=8
                  input value=newName input=editNewName submit=addToken disabled=(not canPropose) placeholder="surface.raised" aria-label="New token's name" flex=1 min-width=0 testId="new-name"
                  input value=newValue input=editNewValue submit=addToken disabled=(not canPropose) placeholder="light-dark(#fff, #000)" aria-label="New token's value" flex=1 min-width=0 testId="new-value"
                  button press=addToken disabled=(newName.trim() == "" or newValue.trim() == "" or not canPropose) testId="add-token"
                    text "Add"
              if editKind == "promote-param" or editKind == "promote-token" or editKind == "detach-param"
                column gap=4 testId="move-editor"
                  text rowWords role="heading" aria-level=3 testId="row-label"
                  text (editKind == "detach-param" ? "One transaction: the param's default written at this row, and the param removed, with any param it alone left read (listed below); refused where the app's design sets it." : "One transaction: the new one, its default the value as written, and this row reading it.") color="-exact-secondary-label" font="-exact-footnote"
                  if stateStale
                    text "The copy this edit was opened on is no longer current: select it again." color="-exact-system-orange" font="-exact-footnote" testId="state-stale"
                  if editKind != "detach-param"
                    input value=editValue input=stateValue disabled=(not canPropose) aria-label=(editKind == "promote-param" ? "The new param's name" : "The new token's name") testId="move-name"
              if editKind == "set-state" or editKind == "set-row"
                column gap=4 testId="state-editor"
                  if editKind == "set-row"
                    text rowWords role="heading" aria-level=3 testId="row-label"
                    text "A row as its author wrote it: written by set-row where it is written (this template: every copy of this node; a style: every node using it), which rebuilds the app; the file must be as it was when selected, and the app must build." color="-exact-secondary-label" font="-exact-footnote"
                  else
                    text `${editTarget.split("|").slice(0, 1).join("")} :${editTarget.split("|").slice(1, 2).join("")} ${editTarget.split("|").slice(2, 3).join("")}` role="heading" aria-level=3 testId="state-label"
                    text "A state part's row: written by set-state, which rebuilds the app; a hold on it is held again once it has, where its node still corresponds." color="-exact-secondary-label" font="-exact-footnote"
                  if stateStale
                    text "The copy this edit was opened on is no longer current: select it again." color="-exact-system-orange" font="-exact-footnote" testId="state-stale"
                  input value=editValue input=stateValue disabled=(not canPropose) aria-label=(editKind == "set-row" ? "The row's value" : "The state part's value") testId="state-value"
              if editKind != ""
                // A panel's edit docks it at the window's bottom (the second hands-on pass: a param's proposal opened
                // about 16,500 px below its field), at most 40% of it, scrolling inside; a grid edit's stays here.
                column gap=8 padding=12 border-radius=10 background-color="-exact-secondary-background" position=(docked ? "sticky" : "relative") bottom=0 z-index=5 max-height=(docked ? "40vh" : "none") overflow-y=(docked ? "auto" : "visible") box-shadow=(docked ? "0 -2px 12px rgba(0, 0, 0, 0.18)" : "none") id="proposal-dock" tabindex=-1 role="region" aria-label="Proposal" testId="proposal"
                  if editKind == "set-token" and editTarget == setForAppName and setForAppNote != ""
                    text setForAppNote font="-exact-footnote" color="-exact-secondary-label" testId="set-for-app-note"
                  if draftStale or partsStale
                    text "The branch this edit was for has changed: choose the cell and type it again." color="-exact-system-orange" testId="draft-stale"
                  // Said to a screen reader as it comes: a typed draft keeps the focus in its field.
                  text readyLine aria-live="polite" font="-exact-footnote" color="-exact-secondary-label" testId="proposal-ready"
                  if not proposal.ok
                    text proposal.error color="-exact-system-red" white-space="pre-wrap" testId="proposal-error"
                  else if proposal.active
                    row gap=8 align-items="center"
                      text (proposal.chip == "live" ? "Live" : "Rebuilds") font="-exact-footnote" padding="2px 8px" border-radius=8 background-color="-exact-tertiary-background" testId="chip"
                      text proposal.tokens.join(", ") color="-exact-secondary-label" font="-exact-footnote" flex=1 testId="proposal-tokens"
                    text proposal.diff font="-exact-caption1" font-family="ui-monospace, monospace" white-space="pre" testId="proposal-diff"
                  if scrubShown
                    column gap=4 testId="scrub"
                      if not scrub.ok
                        text scrub.error color="-exact-system-red" white-space="pre-wrap" testId="scrub-error"
                      else if scrub.open != ""
                        text (scrub.ready ? "Previewing: the running copies show this value, and the files are unchanged until Keep." : scrub.sending ? "Previewing: sending this value to the running copies…" : "Previewing the last value sent: this one is not previewed.") color="-exact-system-orange" testId="scrub-previewing"
                      row gap=8
                        button press=keepScrub disabled=(not scrub.ok or not scrub.ready or partsStale or pending(scrub) or pending(written) or not canWrite) buttonStyle="filled" testId="scrub-keep"
                          text "Keep"
                        button press=cancelScrub aria-keyshortcuts="Escape" disabled=(not canWrite) testId="scrub-cancel"
                          text "Cancel scrub"
                  else
                    row gap=8
                      button id="proposal-apply" press=apply disabled=(not applyReady) buttonStyle="filled" testId="apply"
                        text (canWrite ? "Apply" : "Propose for review")
                      if editKind == "set-dial" or editKind == "set-token" or editKind == "set-param"
                        button press=startScrub disabled=(not hello.live or not proposal.ok or not proposal.active or pending(proposal) or proposal.key != draftKey or proposal.chip != "live" or not proposal.scrubbable or draftStale or partsStale or pending(written) or not canWrite or (branch.readOnly != "" and editTarget == branch.token and editKind == branchOp)) testId="scrub-start"
                          text "Scrub live"
                      button press=cancelEdit testId="cancel-edit"
                        text "Cancel"
                    if (editKind == "set-dial" or editKind == "set-token" or editKind == "set-param") and proposal.ok and proposal.active and proposal.chip != "live"
                      text (hello.live ? "This edit rebuilds the app, so it can't be scrubbed: Apply writes it." : "Scrubbing previews on the running copies: open the tool through a dev loop (tamber tool --via).") color="-exact-secondary-label" font="-exact-footnote" testId="scrub-unavailable"
              if not scrubShown and scrub.ended != ""
                text scrub.ended color="-exact-secondary-label" testId="scrub-note"
              row gap=8 align-items="center" testId="undo-bar"
                button press=undo disabled=(stack.undo == 0 or pending(written) or not canWrite) testId="undo"
                  text `Undo (${stack.undo})`
                button press=redo disabled=(stack.redo == 0 or pending(written) or not canWrite) testId="redo"
                  text `Redo (${stack.redo})`
                if stack.rescope != ""
                  button press=rescope disabled=(pending(written) or not canWrite) testId="rescope"
                    text stack.rescope
                if not stack.ok
                  text stack.error color="-exact-system-red" white-space="pre-wrap" flex=1 testId="write-error"
                else if stack.note != ""
                  text stack.note color="-exact-secondary-label" flex=1 testId="write-note"
              column gap=8 testId="contrast"
                text "Contrast" role="heading" aria-level=2
                text "Text over background, between the stored values: a role or platform colour is its fallback until a running app reports it." color="-exact-secondary-label" font="-exact-footnote"
                row gap=8
                  select value=pickA change=chooseA aria-label="Text" testId="pick-a"
                    option "Text…" value=""
                    for n in design.names key=n
                      option n value=n
                  select value=pickB change=chooseB aria-label="Background" testId="pick-b"
                    option "Background…" value=""
                    for n in design.names key=n
                      option n value=n
                if not contrast.ok
                  text contrast.error color="-exact-system-red" testId="contrast-error"
                for r in contrast.ratios key=r.column
                  row gap=12
                    text r.label width=160
                    text r.ratio testId=`ratio-${r.column}`
            column gap=4 testId="files"
              button press=toggleFiles aria-expanded=filesShown aria-label=`${filesShown ? "Hide" : "Show"} the ${hello.files.length} files and their digests` testId="toggle-files"
                text (filesShown ? "Hide files" : `Files (${hello.files.length})`)
              if filesShown
                for f in hello.files key=f.path
                  row gap=12
                    text f.path flex=1 testId=`file-${f.path}`
                    text f.digest.slice(0, 12) color="-exact-secondary-label" font="-exact-footnote" testId=`digest-${f.path}`
            column gap=8 testId="inbox"
              text "Proposals" role="heading" aria-level=2
              if changes.held.length == 0
                text "No proposal is waiting." color="-exact-secondary-label" testId="no-proposals"
              for h in changes.held key=h.proposal
                column gap=6 padding=12 border-radius=10 border-width=2 border-style="solid" border-color=h.tint testId=`held-${h.proposal}`
                  if h.importer != ""
                    // An import (LLP 1122 D11): mapped tokens in until unticked, role
                    // overrides out until ticked, what it did not map, and the count.
                    text `${h.client} imports a ${h.importer} theme` font="-exact-headline" testId=`held-title-${h.proposal}`
                    text h.counted color=(h.countOk ? "-exact-secondary-label" : "-exact-system-red") font="-exact-footnote" testId=`held-count-${h.proposal}`
                    if h.replaces != ""
                      text `Recomputed from ${h.replaces} with the items chosen, on the files as they are now: review its diff, then accept it to write it. The overrides kept are on because they were ticked.` color="-exact-system-orange" font="-exact-footnote" testId=`held-replaces-${h.proposal}`
                    else if h.from != ""
                      text `Held again from ${h.from} with your edit, on the files as they are now: review its diff, then accept it.` color="-exact-system-orange" font="-exact-footnote" testId=`held-replaces-${h.proposal}`
                    if h.replaces != "" or h.from != ""
                      text h.diff font="-exact-caption1" font-family="ui-monospace, monospace" white-space="pre" testId=`held-diff-${h.proposal}`
                    text `Tokens (${h.mapped.length})` role="heading" aria-level=3
                    for m in h.mapped key=`${m.index}`
                      row gap=8 align-items="center" flex-wrap="wrap" testId=`mapped-${h.proposal}-${m.index}`
                        input type="checkbox" disabled=(pending(written) or not canWrite) checked=(not picked.includes(`${h.proposal}:${m.index}`)) change=toggleLeaveOut(`${h.proposal}:${m.index}`) aria-label=m.name testId=`take-${h.proposal}-${m.index}`
                        text m.name width=200 flex-shrink=0 font="-exact-footnote"
                        if m.kind != "token"
                          text m.text color="-exact-secondary-label" font="-exact-caption1" testId=`mapped-text-${h.proposal}-${m.index}`
                        for md in m.modes key=`${md.mode}`
                          row gap=4 align-items="center"
                            if md.light != ""
                              view width=16 height=16 border-radius=3 background-color=md.light border="1px solid -exact-separator"
                            if md.dark != ""
                              view width=16 height=16 border-radius=3 background-color=md.dark border="1px solid -exact-separator"
                            text md.label font="-exact-caption2" color="-exact-secondary-label"
                            input value=md.value change=editImportValue(h.proposal, m.index, md.mode) disabled=(not canPropose) aria-label=`${m.name} ${md.label}` min-width=160 font="-exact-caption1" testId=`mapped-value-${h.proposal}-${m.index}-${md.mode}`
                    text (h.kept ? "Role overrides, as ticked" : "Role overrides, off until ticked") role="heading" aria-level=3
                    for o in h.offers key=o.role
                      row gap=8 align-items="center" testId=`offer-${h.proposal}-${o.role}`
                        if o.items != ""
                          input type="checkbox" disabled=(pending(written) or not canWrite) checked=(o.on != picked.includes(`${h.proposal}:${o.items}`)) change=toggleOffer(`${h.proposal}:${o.items}`, o.on) aria-label=`${o.role} = ${o.token}` testId=`override-${h.proposal}-${o.role}`
                        text `${o.role} = ${o.token}` font="-exact-footnote"
                        if o.note != ""
                          text o.note color="-exact-secondary-label" font="-exact-caption1" testId=`offer-note-${h.proposal}-${o.role}`
                    text `Not mapped (${h.unmapped.length})` role="heading" aria-level=3
                    for u in h.unmapped key=u.key
                      text `${u.name} = ${u.value}${u.block != "" and not u.derived ? ` (${u.block})` : ""}: ${u.why}` color="-exact-secondary-label" font="-exact-caption1" testId=`unmapped-${h.proposal}-${u.key}`
                    row gap=8
                      button press=acceptImportNow(h.proposal) disabled=(pending(written) or not canWrite) buttonStyle="filled" testId=`accept-${h.proposal}`
                        text "Accept"
                      button press=dropProposal(h.proposal) disabled=(pending(written) or not (canWrite or h.client == client)) destructive=true testId=`drop-${h.proposal}`
                        text "Drop"
                  else
                    text `${h.client} proposes ${h.tokens.join(", ")}` testId=`held-title-${h.proposal}`
                    if h.replaces != ""
                      text `Recomputed from ${h.replaces} on the files as they are now: review it again.` color="-exact-system-orange" font="-exact-footnote" testId=`held-replaces-${h.proposal}`
                    text h.diff font="-exact-caption1" font-family="ui-monospace, monospace" white-space="pre" testId=`held-diff-${h.proposal}`
                    for it in h.items key=`${it.index}`
                      row gap=8 align-items="center"
                        input type="checkbox" disabled=(not canWrite) checked=picked.includes(`${h.proposal}:${it.index}`) change=togglePick(`${h.proposal}:${it.index}`) aria-label=it.text testId=`pick-${h.proposal}-${it.index}`
                        text it.text font="-exact-footnote"
                    row gap=8
                      button press=acceptAll(h.proposal) disabled=(pending(written) or not canWrite) buttonStyle="filled" testId=`accept-${h.proposal}`
                        text "Accept"
                      button press=acceptPicked(h.proposal, h.items.filter(it => picked.includes(`${h.proposal}:${it.index}`)).map(it => `${it.index}`).join(",")) disabled=(pending(written) or not h.items.map(it => picked.includes(`${h.proposal}:${it.index}`)).includes(true) or not canWrite) testId=`accept-picked-${h.proposal}`
                        text "Accept picked"
                      button press=dropProposal(h.proposal) disabled=(pending(written) or not (canWrite or h.client == client)) destructive=true testId=`drop-${h.proposal}`
                        text "Drop"
            column gap=8 testId="import"
              text "Import a theme" role="heading" aria-level=2
              text "Its tokens, the role overrides it offers (each off until ticked) and what it could not map are held as a proposal, reviewed above." color="-exact-secondary-label" font="-exact-footnote"
              row gap=8 align-items="center"
                select value=importKind change=chooseKind disabled=(not canPropose) aria-label="Kind" testId="import-kind"
                  option "shadcn (CSS)" value="shadcn"
                  option "Tailwind v4 (CSS)" value="tailwind"
                  option "DTCG (JSON, a file a mode)" value="dtcg"
                button press=pickImport disabled=(pending(imported) or not canPropose) testId="import-choose"
                  text "Choose files…"
                input type="file" multiple=(importKind == "dtcg") disabled=(not canPropose) id="import-file" testId="import-file" display="none" change=importPicked
              match imported
                case some(i)
                  text (i.ok ? i.note : i.error) color=(i.ok ? "-exact-secondary-label" : "-exact-system-red") white-space="pre-wrap" testId="import-result"
                  if i.counted != ""
                    text i.counted color="-exact-secondary-label" font="-exact-footnote" testId="import-counted"
                    for u in i.unmapped key=u.key
                      text `${u.name} = ${u.value}${u.block != "" and not u.derived ? ` (${u.block})` : ""}: ${u.why}` color="-exact-secondary-label" font="-exact-caption1"
                case none
                  text "" display="none"
            column gap=8 testId="changeset"
              text "Changes" role="heading" aria-level=2
              if changeset.entries.length == 0
                text "Nothing has changed since the tool opened." color="-exact-secondary-label" testId="no-changes"
              for e in changeset.entries key=`${e.seq}`
                column gap=2 testId=`entry-${e.seq}`
                  row gap=6 align-items="center"
                    view width=8 height=8 border-radius=4 background-color=e.tint
                    text e.text color=(e.committed ? "-exact-secondary-label" : "-exact-label") flex=1 testId=`entry-text-${e.seq}`
                  if e.mine and e.diff != ""
                    text e.diff font="-exact-caption1" font-family="ui-monospace, monospace" white-space="pre" color="-exact-secondary-label" testId=`entry-diff-${e.seq}`
              row gap=8 align-items="center"
                button press=commit disabled=(pending(committed) or (scope.open == 0 and not scope.refused and not scope.unavailable) or not canWrite) buttonStyle="bordered" testId="commit"
                  text "Commit"
                text "Commits what this session wrote, never pushes." color="-exact-secondary-label" font="-exact-footnote"
              match committed
                case some(c)
                  if c.ok
                    column gap=2 testId="committed"
                      text `Committed ${c.commit}: ${c.files.join(", ")}` testId="committed-summary"
                      for t in c.edits key=`${t.n}`
                        text t.text color="-exact-secondary-label" font="-exact-footnote"
                  else
                    column gap=2 testId="commit-refused"
                      text c.error color="-exact-system-red" white-space="pre-wrap" testId="commit-error"
                      for r in c.refused key=r.file
                        text `${r.file}: ${r.why}` color="-exact-system-red" testId=`refused-${r.file}`
                case none
                  text "" display="none"
            column gap=8 testId="history"
              button press=toggleHistory testId="toggle-history"
                text (historyShown ? "Hide history" : "History")
              if historyShown
                if not history.ok
                  text history.error color="-exact-system-red" testId="history-error"
                for c in history.commits key=c.commit
                  column gap=2 padding=8 border-radius=8 background-color="-exact-secondary-background" testId=`commit-${c.short}`
                    row gap=8 align-items="center"
                      text `${c.short} · ${c.author} · ${c.date}` font="-exact-footnote" color="-exact-secondary-label" flex=1
                      button press=revert(c.commit) disabled=(pending(reverted) or not canPropose) testId=`revert-${c.short}`
                        text "Revert"
                    text c.subject testId=`subject-${c.short}`
                    for f in c.files key=f.file
                      text f.file font="-exact-footnote"
                      if f.refused != ""
                        text f.refused color="-exact-system-orange" font="-exact-caption1"
                      for t in f.edits key=t
                        text t font="-exact-caption1" testId=`edit-${c.short}`
                row gap=8
                  if historyPages > 1
                    button press=newerHistory testId="newer-history"
                      text "Newer"
                  if history.more
                    button press=moreHistory testId="more-history"
                      text "Older"
                match reverted
                  case some(r)
                    if r.ok
                      text `Held for review as ${r.proposal}: the revert of ${r.commit.slice(0, 12)}.` testId="reverted"
                    else
                      column gap=2 testId="revert-refused"
                        text r.error color="-exact-system-red" white-space="pre-wrap"
                        for t in r.refused key=t
                          text t color="-exact-system-red" font="-exact-footnote"
                  case none
                    text "" display="none"
            column gap=4 testId="following"
              text (changes.ok ? `Following changes · ${changes.seq}` : changes.error) color="-exact-secondary-label" font="-exact-footnote" testId="follow-state"
              for c in changes.recent key=`${c.seq}`
                text `${c.files.join(", ")} · ${c.who}` testId=`change-${c.seq}`

// One dial's control. A dial with no metadata has its kind's: a colour's
// field and swatch, a ranged number's slider.
component DialControl
  props
    c: Control
    focused: bool
    // Below propose (a paired reader, T6): not editable.
    locked: bool
    onNumber: action
    onText: action
    onStep: action
    onRelease: action
  view
    column id=`dial-${c.name}` gap=4 padding=4 border-radius=6 background-color=(focused ? "-exact-tertiary-background" : "transparent") testId=`dial-${c.name}`
      row gap=8 align-items="center"
        text c.label flex=1
        text c.value color="-exact-secondary-label" font="-exact-footnote" testId=`dial-${c.name}-value`
      if c.control == "color"
        row gap=8 align-items="center" testId=`dial-${c.name}-color`
          view width=28 height=28 border-radius=6 background-color=c.swatch border="1px solid -exact-separator"
          input value=c.value change=onText disabled=(locked) aria-label=c.label flex=1 min-width=0 testId=`dial-${c.name}-field`
      else if c.control == "slider"
        // Each value while it is dragged; let go, a scrub open on it is kept.
        input type="range" min=c.min max=c.max step=c.step value=c.number input=onNumber change=onRelease disabled=(locked) aria-label=c.label testId=`dial-${c.name}-slider`
      else if c.control == "stepper"
        input type="number" min=c.min max=c.max step=c.step value=`${c.number}` input=onStep disabled=(locked) aria-label=c.label testId=`dial-${c.name}-stepper`
      else if c.control == "select"
        select value=c.value change=onText disabled=(locked) aria-label=c.label testId=`dial-${c.name}-select`
          for o in c.options key=o
            option o value=o
      else if c.control == "token"
        // A param's own default: a token's name or a literal, typed.
        input value=c.value change=onText disabled=(locked) aria-label=c.label testId=`dial-${c.name}-field`
      if c.bounds != ""
        text c.bounds color="-exact-secondary-label" font="-exact-footnote" testId=`dial-${c.name}-bounds`
      if c.help != ""
        text c.help color="-exact-secondary-label" font="-exact-footnote" testId=`dial-${c.name}-help`

// A param's row in the component panel: its control (the dials panel's),
// whether the app sets it or the default applies, Reset, and D14's mark.
component ParamControl
  props
    r: ParamRow
    // Its winning level, when read for the design shown (`levels`: none or one).
    won: LevelRow[]
    focused: bool
    // Below propose (a paired reader, T6): not editable.
    locked: bool
    onNumber: action
    onText: action
    onStep: action
    onRelease: action
    onReset: action
    // A package component's param whose default names a token: open that token instead (its every use).
    onToken: action
    // Its package token's own line in the app removed: the token follows the package's line again.
    onBackToPackage: action
  view
    column gap=2 testId=`param-${r.short}`
      DialControl(c=r.c, locked=locked, focused=focused, onNumber=onNumber, onText=onText, onStep=onStep, onRelease=onRelease)
      // Its colour per grid column, each with its value as words (not colour alone), and the chain to it.
      if r.swatches.length > 0
        row gap=6 align-items="center" flex-wrap="wrap" padding="0 4px" testId=`param-${r.short}-swatches`
          for s in r.swatches key=s.label
            row gap=4 align-items="center" testId=`param-${r.short}-swatch-${s.label}`
              view width=18 height=18 border-radius=4 background-color=s.css border="1px solid -exact-separator" role="img" aria-label=`${s.label}: ${s.css}`
              text `${s.label} ${s.css}` color="-exact-secondary-label" font="-exact-caption2"
      // (The words with no swatch too: a role the page alone paints.)
      if r.words != ""
        text r.words color="-exact-secondary-label" font="-exact-footnote" padding="0 4px" testId=`param-${r.short}-words`
      row gap=8 align-items="center" padding="0 4px"
        text (r.package ? (r.set ? `set for this app · the package's default ${r.default}` : `the package's default ${r.default}: a change here is set for this app`) : r.set ? `set here · default ${r.default}` : "the default") color="-exact-secondary-label" font="-exact-footnote" flex=1 testId=`param-${r.short}-source`
        if r.set
          button press=onReset disabled=(locked) testId=`param-${r.short}-reset`
            text (r.package ? "Back to the default" : "Reset")
      for l in won key=l.name
        text l.text title=l.level color="-exact-secondary-label" font="-exact-footnote" padding="0 4px" testId=`param-${r.short}-level`
      if r.set
        text `${r.package ? "Back to the default" : "Reset"} removes the app's line${r.whens > 0 ? ` and its ${r.whens} when ${r.whens == 1 ? "branch" : "branches"} with it` : ""}.` color="-exact-secondary-label" font="-exact-footnote" padding="0 4px" testId=`param-${r.short}-whens`
      if r.package and r.packageToken != "" and r.appSet
        row gap=8 align-items="center" padding="0 4px"
          button press=onBackToPackage disabled=(locked) testId=`param-${r.short}-package`
            text "Back to the package"
          text `removes the app's line for ${r.packageToken}, with any when branches it has: the token follows the package's line${r.levelSelf ? "; the app's own value of this param still wins over it" : r.set ? "; the app's own line for this param stays" : ""}.` color="-exact-secondary-label" font="-exact-footnote" flex=1 testId=`param-${r.short}-package-note`
      if r.package and r.token != ""
        button press=onToken disabled=(locked) testId=`param-${r.short}-token`
          text (r.tokenPackage != "" ? `Edit the package token ${r.token} instead` : r.tokenBase ? `Edit Exact's base ${r.token} instead` : `Edit the token ${r.token} instead`)
      if r.pinned.length > 0
        text `pinned: no longer follows ${r.pinned.join(", ")}` color="-exact-system-orange" font="-exact-footnote" padding="0 4px" testId=`param-${r.short}-pinned`
