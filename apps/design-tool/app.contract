                for g in design.groups key=g.name
                  column gap=8 padding=12 border-radius=10 background-color="-exact-secondary-background" testId=`group-${g.name}`
                    text (g.name == "" ? "Dials" : g.name) role="heading" aria-level=3
                    for c in g.dials key=c.name
