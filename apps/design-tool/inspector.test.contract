test "a move whose page finds its selection gone ends there and leaves Up working; a page that can't step greys it until it registers again"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  // The page's selection went in a rebuild while the move was on its way: staleness, not inability (theme2 06:05).
  request POST "/__stub/page-select-gone" {} as ada
  tap "selection-up-1"
  clock data
  clock +1
  clock data
  expect state upExpect == -1
  expect tree missing "selection-up-none"
  // Selected again, Up moves as ever.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect enabled "selection-up-1"
  tap "selection-up-1"
  clock data
  clock +1
  clock data
  expect text "selection-source" == "row.contract:6 · Row"
  expect tree missing "selection-up-none"
  // Inspect stopped while a move is on its way: the move ends all the same.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  request POST "/__stub/page-select-gone" {} as ada
  tap "selection-up-1"
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect state upExpect == -1
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  // A page that can't step: its up control greyed.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  request POST "/__stub/page-refuses-select" {} as ada
  tap "selection-up-1"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect tree has "selection-up-none"
  // It registers again (its status reset): it may step now.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect tree missing "selection-up-none"
  // Refused again before its first report: a listing that still records the refusal keeps Up greyed; one registered
  // again (none recorded) lets it go.
  tap "selection-up-1"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect tree has "selection-up-none"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "unsupported": {"what": "inspect", "detail": "this build cannot move its selection up (select): click the node instead"}, "status": null, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree has "selection-up-none"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree missing "selection-up-none"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 11, "site": 6, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/row.contract", "line": 6, "col": 3, "end_col": 9, "component": "Row"}, {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect enabled "selection-up-1"
  request POST "/__stub/restart" {} as ada

test "the inspector: inspect mode on the builds, a selection's source and rows, the token rung on the branch that won, a link for an inherited colour, a style's row read-only, and the token's impact"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree has "no-selection"
  tap "inspect-toggle"
  clock data
  expect text "inspect-result" == "Inspecting on 1 build(s): click a view in one. ios-1 cannot inspect."
  // The toggle follows the server's event for its own command.
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect text "selection-source" == "card.contract:4 · Card"
  expect text "selection-build" == "web-1 · Dark · dark-style=dim"
  expect tree missing "selection-stale"
  expect text "selrow-source-background-color" == "set here (own)"
  expect text "selrow-edit-background-color" == "Edit surface.card"
  expect text "selrow-source-color" == "inherited from #1"
  expect text "selrow-link-color" == "Open text.primary"
  expect text "selrow-reason-color" == "inherited from #1: the token is that node's to edit"
  expect tree missing "selrow-edit-padding"
  expect text "selrow-reason-padding" == "a style's row (Panel): comes with template editing (T5)"
  // The token rung: its cell in the app's design, on the branch the
  // selected copy shows (Dark, Dim), and its impact.
  tap "selrow-edit-background-color"
  clock data
  expect state file == ""
  expect state selToken == "surface.card"
  expect state selColumn == "2-dark"
  clock +1
  clock data
  expect text "impact-count" == "surface.card: read at 2 source site(s), statically (not a count of mounted copies)"
  tap "impact-outline"
  clock data
  expect text "impact-outlined" == "Sent surface.card's 2 site(s) to web-1; a build in inspect mode on that plan outlines them."
  // The page leaves inspect mode itself: the selection is no longer
  // current (no edit offered), and the tool no longer inspects.
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"]}, {"event": "selected", "build": "web-1", "selected": null}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its page left inspect mode. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  expect tree missing "selrow-link-color"
  expect text "inspect-toggle" == "Inspect"
  request POST "/__stub/restart" {} as ada

test "the param rung: a row that reads a component param opens the param on the branch that won, its edit set-param, the token it aliases offered, never the default"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 1, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1083feff", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fill"], "text": "app.contract#Card.fill", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fill", "short": "Card.fill", "token": "accent.fill", "modes": ""}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.pad"], "text": "app.contract#Card.pad", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.pad", "short": "Card.pad", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit Card.fill"
  expect text "selrow-token-background-color" == "Edit the token accent.fill instead"
  expect text "selrow-edit-padding" == "Edit Card.pad"
  expect tree missing "selrow-token-padding"
  expect tree missing "selrow-reason-padding"
  tap "selrow-edit-padding"
  clock data
  expect state selToken == "app.contract#Card.pad"
  expect state selColumn == "2-dark"
  clock +1
  clock data
  expect tree missing "rename-to"
  type "part-amount-field" "14"
  expect state editKind == "set-param"
  expect state editTarget == "app.contract#Card.pad"
  expect state editValue == "14px"
  // Another param edited in the panel while Card.pad's branch is open: the
  // panel's draft, not a stale one of the branch.
  type "dial-app.tamber#MapCard.zoom-stepper" "13"
  expect state editTarget == "app.tamber#MapCard.zoom"
  expect state editValue == "13"
  expect tree missing "draft-stale"
  // A grid cell pressed, then, before its branch is read, a token opened from the Inspector: no cell to give the focus
  // back to, and the press's focus is not moved into the Inspector's token's editor (the edit dock's).
  tap "cell-surface.card-0-light"
  expect state returnTo == "cell-surface.card-0-light"
  expect state pressed == 1
  tap "selrow-token-background-color"
  // (Marked moved by the selection itself, before any branch is read: no press's focus left to move.)
  expect state focusedPress == 1
  clock data
  clock +1
  clock data
  expect state selToken == "accent.fill"
  expect state returnTo == ""
  expect state focusedPress == 1
  request POST "/__stub/restart" {} as ada

test "Only this mode on a param with no line: its line is written first, in the one reviewed transaction, which has no scrub"
  request POST "/__stub/live" {"live": true} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  reload
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 1, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1083feff", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fill"], "text": "app.contract#Card.fill", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fill", "short": "Card.fill", "token": "accent.fill", "modes": ""}}]} as ada
  clock +1
  clock data
  tap "selrow-edit-background-color"
  clock data
  clock +1
  clock data
  tap "only-this-mode"
  expect state editKind == "set-param"
  expect state editWhen == "dark-style=dim density=regular"
  clock data
  expect text "chip" == "Live"
  expect disabled "scrub-start"
  request POST "/__stub/restart" {} as ada

test "holding a state on the selected copy: one a build, held once its build says so, why it went, the held look's rows at their part asked of its page, or provenance incomplete"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": null, "held": null}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}]} as ada
  clock +1
  clock data
  expect tree has "hold-active"
  expect disabled "hold-release"
  // What its page reports once asked again (an inspect refresh) while it is held.
  request POST "/__stub/held-answer" {"held": {"state": "active", "rows": [{"name": "press_background_color", "value": "#0f73ffff", "state": "active", "source": {"file": "/stub/post.contract", "line": 20, "col": 5, "end_col": 30}}]}} as ada
  tap "hold-active"
  clock data
  clock +1
  clock data
  expect text "hold-status" == "Holding pressed."
  // The build's own report, as the server publishes it (no new listing).
  request POST "/__stub/event" {"event": "held", "build": "web-1", "state": "active"} as ada
  clock +1
  clock data
  expect text "hold-status" == "Held pressed."
  expect text "held-note" == "Its page is asked for the held look's rows."
  // Its rows, as its page reports them again: each at its part's place, with its state.
  clock +1
  clock data
  clock +1
  clock data
  expect text "heldrow-:active background-color" == ":active background-color#0f73ffff:active part at post.contract:20"
  expect tree missing "held-note"
  // Another state held in its place: the pressed rows are not the hovered look's.
  request POST "/__stub/held-answer" {"held": {"state": "hover", "rows": [{"name": "background_color", "value": "#222222ff", "state": "hover", "source": {"file": "/stub/post.contract", "line": 24, "col": 5, "end_col": 30}}]}} as ada
  tap "hold-hover"
  clock data
  clock +1
  clock data
  expect text "hold-status" == "Holding hovered."
  expect tree missing "heldrow-:active background-color"
  request POST "/__stub/event" {"event": "held", "build": "web-1", "state": "hover"} as ada
  clock +1
  clock data
  clock +1
  clock data
  clock +1
  clock data
  expect text "hold-status" == "Held hovered."
  expect text "heldrow-:hover background-color" == ":hover background-color#222222ff:hover part at post.contract:24"
  // Another node of that build selected: one hold a build, so a hold there replaces this one.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 6, "site": 5, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}]} as ada
  clock +1
  clock data
  expect text "hold-status" == "Held hovered on another node of this build: a hold here replaces it."
  // Held, but this host reports no rows for it: read-only, said so.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}], "held": {"state": "hover", "rows": []}} as ada
  clock +1
  clock data
  expect text "held-note" == "Provenance incomplete: this host reports no rows (or not their tokens) for the held look, so it is read-only here."
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}], "held": {"state": "hover", "rows": [{"name": "background_color", "value": "#222222ff", "state": "hover", "source": {"file": "/stub/post.contract", "line": 24, "col": 5, "end_col": 30}}]}} as ada
  clock +1
  clock data
  expect tree has "heldrow-:hover background-color"
  // Real input lets it go; the rows it showed go with it.
  request POST "/__stub/event" {"event": "held", "build": "web-1", "state": null, "reason": "input"} as ada
  clock +1
  clock data
  expect text "hold-status" == "The hold was let go: real input on the node let it go."
  expect tree missing "held-note"
  expect tree missing "heldrow-:hover background-color"
  // Held again in the same state: that report was the last hold's, so its page is asked again.
  request POST "/__stub/held-answer" {"held": {"state": "hover", "rows": [{"name": "background_color", "value": "#333333ff", "state": "hover", "source": {"file": "/stub/post.contract", "line": 24, "col": 5, "end_col": 30}}]}} as ada
  tap "hold-hover"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "held", "build": "web-1", "state": "hover"} as ada
  clock +1
  clock data
  expect text "held-note" == "Its page is asked for the held look's rows."
  clock +1
  clock data
  clock +1
  clock data
  expect text "heldrow-:hover background-color" == ":hover background-color#333333ff:hover part at post.contract:24"
  // Another client holds another node, then this one is held again: its page is asked again.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": {"site": 9, "instance": [], "state": "hover"}, "held": {"state": "hover"}}]} as ada
  clock +1
  clock data
  expect tree missing "heldrow-:hover background-color"
  request POST "/__stub/held-answer" {"held": {"state": "hover", "rows": [{"name": "background_color", "value": "#444444ff", "state": "hover", "source": {"file": "/stub/post.contract", "line": 24, "col": 5, "end_col": 30}}]}} as ada
  tap "hold-hover"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "held", "build": "web-1", "state": "hover"} as ada
  clock +1
  clock data
  clock +1
  clock data
  clock +1
  clock data
  expect text "heldrow-:hover background-color" == ":hover background-color#444444ff:hover part at post.contract:24"
  // Then let go from here: said, not as an empty reason.
  tap "hold-release"
  clock data
  clock +1
  clock data
  expect text "hold-status" == "Let go."
  // A host that cannot hold that state says so by name.
  request POST "/__stub/event" {"event": "unsupported", "build": "web-1", "what": "hold", "detail": "hover: iOS has no pointer"} as ada
  clock +1
  clock data
  expect text "hold-status" == "This build cannot hold that state: hover: iOS has no pointer."
  // Another client's hold ends that word; a let-go only a listing says (its event missed) says why.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": {"site": 3, "instance": [], "state": "active"}, "held": null}]} as ada
  clock +1
  clock data
  expect text "hold-status" == "Holding pressed."
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": null, "held": {"state": null, "reason": "disabled"}}]} as ada
  clock +1
  clock data
  expect text "hold-status" == "The hold was let go: the node is disabled, which refuses a hold."
  request POST "/__stub/restart" {} as ada

test "a style's state part row is edited by set-state, the default, from its value as written: a field, Rebuilds, Apply; a token it reads offered beside; a held one too; a stale copy's edit is not applied"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": {"site": 3, "instance": [], "state": "active"}, "held": {"state": "active"}}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  // The held look as its page reports it when asked (its first report, unasked, is asked again).
  request POST "/__stub/held-answer" {"held": {"state": "active", "site": 3, "rows": [{"name": "press_opacity_to", "value": "0.8", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract"}}]}} as ada
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/post.contract", "line": 9, "col": 5, "end_col": 11, "component": "PostButton", "chain": []}, "rows": [{"name": "press_opacity_to", "value": "0.8", "source": "authored", "origin": "class:PostButton", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract", "text": "0.8"}}, {"name": "press_background_color", "value": "#0f73ffff", "source": "authored", "origin": "class:PostButton", "state": "active", "token": {"names": ["accent.fill"], "text": "accent.fill", "modes": "", "implied": false}, "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "background-color", "file": "post.contract", "text": "accent.fill", "token": "accent.fill"}}], "held": {"state": "active", "site": 3, "rows": [{"name": "press_opacity_to", "value": "0.8", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract"}}]}} as ada
  clock +1
  clock data
  expect text "selrow-state-:active opacity" == "Edit PostButton :active opacity"
  expect text "selrow-token-:active background-color" == "Edit the token accent.fill instead"
  expect text "selrow-state-:active background-color" == "Edit PostButton :active background-color"
  clock +1
  clock data
  clock +1
  clock data
  expect text "heldrow-state-:active opacity" == "Edit PostButton :active opacity"
  tap "selrow-state-:active opacity"
  expect state editKind == "set-state"
  expect state editTarget == "PostButton|active|opacity|post.contract"
  expect state editValue == "0.8"
  type "state-value" "0.7"
  expect state editValue == "0.7"
  clock data
  expect text "chip" == "Rebuilds"
  expect tree missing "scrub-start"
  tap "apply"
  clock data
  expect text "undo" == "Undo (1)"
  // The write moved the files: the copy is reported again (a rebuild would), and is current.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/post.contract", "line": 9, "col": 5, "end_col": 11, "component": "PostButton", "chain": []}, "rows": [{"name": "press_opacity_to", "value": "0.8", "source": "authored", "origin": "class:PostButton", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract", "text": "0.8"}}, {"name": "press_background_color", "value": "#0f73ffff", "source": "authored", "origin": "class:PostButton", "state": "active", "token": {"names": ["accent.fill"], "text": "accent.fill", "modes": "", "implied": false}, "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "background-color", "file": "post.contract", "text": "accent.fill", "token": "accent.fill"}}], "held": {"state": "active", "site": 3, "rows": [{"name": "press_opacity_to", "value": "0.8", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract"}}]}} as ada
  clock +1
  clock data
  // An edit opened on that copy, then the selection goes stale (its page left inspect mode): not applied.
  tap "selrow-state-:active background-color"
  expect state editValue == "accent.fill"
  expect tree missing "state-stale"
  // Another client writes the file meanwhile: stale, and the same copy reported afresh does not revive it.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["post.contract"], "changed": [], "files": {"post.contract": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}} as ada
  clock +1
  clock data
  expect tree has "state-stale"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/post.contract", "line": 9, "col": 5, "end_col": 11, "component": "PostButton", "chain": []}, "rows": [{"name": "press_opacity_to", "value": "0.8", "source": "authored", "origin": "class:PostButton", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract", "text": "0.8"}}, {"name": "press_background_color", "value": "#0f73ffff", "source": "authored", "origin": "class:PostButton", "state": "active", "token": {"names": ["accent.fill"], "text": "accent.fill", "modes": "", "implied": false}, "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "background-color", "file": "post.contract", "text": "accent.fill", "token": "accent.fill"}}], "held": {"state": "active", "site": 3, "rows": [{"name": "press_opacity_to", "value": "0.8", "state": "active", "editable": {"rung": "state", "style": "PostButton", "state": "active", "row": "opacity", "file": "post.contract"}}]}} as ada
  clock +1
  clock data
  expect tree has "state-stale"
  expect disabled "apply"
  tap "selrow-state-:active background-color"
  expect tree missing "state-stale"
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"]}, {"event": "selected", "build": "web-1", "selected": null}]} as ada
  clock +1
  clock data
  expect tree has "state-stale"
  expect disabled "apply"
  request POST "/__stub/restart" {} as ada

test "a row its author wrote is edited by set-row, the default: this template (every copy) at its place, or its style in its own file, the attribute named; the token beside; a refusal (a moved file, a value the app does not build with) writes nothing"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 3, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "template", "file": "card.contract", "at": {"line": 3, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "background-color", "instances": 2, "text": "surface.card", "token": "surface.card", "modes": ""}}, {"name": "text_color", "value": "#ff0000ff", "source": "authored", "origin": "class:Panel", "editable": {"rung": "style", "style": "Panel", "row": "color", "file": "styles.contract", "text": "red"}}]} as ada
  clock +1
  clock data
  expect text "selrow-row-background-color" == "Edit this template · 2 instances"
  expect text "selrow-token-background-color" == "Edit the token surface.card instead"
  expect text "selrow-row-color" == "Edit style Panel"
  tap "selrow-row-background-color"
  expect state editKind == "set-row"
  expect state editTarget == "{\"file\":\"card.contract\",\"at\":{\"line\":3,\"col\":9},\"sha256\":\"aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\",\"row\":\"background-color\"}"
  expect state editValue == "surface.card"
  expect text "row-label" == "This template · 2 instances: background-color"
  // A value the app does not build with: the server's refusal, nothing written.
  type "state-value" "not-a-colour"
  clock data
  expect text "proposal-error" == "the app does not build with that: card.contract:3:9: `not-a-colour` is not a colour"
  expect disabled "apply"
  type "state-value" "#ff0000"
  clock data
  expect text "chip" == "Rebuilds"
  expect tree missing "scrub-start"
  tap "apply"
  clock data
  expect text "undo" == "Undo (1)"
  // The style's row, in its own file.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 3, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "template", "file": "card.contract", "at": {"line": 3, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "background-color", "instances": 2, "text": "surface.card", "token": "surface.card", "modes": ""}}, {"name": "text_color", "value": "#ff0000ff", "source": "authored", "origin": "class:Panel", "editable": {"rung": "style", "style": "Panel", "row": "color", "file": "styles.contract", "text": "red"}}]} as ada
  clock +1
  clock data
  tap "selrow-row-color"
  expect state editTarget == "{\"style\":\"Panel\",\"row\":\"color\",\"file\":\"styles.contract\"}"
  expect state editValue == "red"
  expect text "row-label" == "Style Panel: color"
  type "state-value" "blue"
  clock data
  expect text "chip" == "Rebuilds"
  tap "apply"
  clock data
  expect text "undo" == "Undo (2)"
  // A file moved since it was compiled: refused, said so.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 3, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "template", "file": "card.contract", "at": {"line": 3, "col": 9}, "sha256": "stale", "row": "background-color", "instances": 2, "text": "surface.card", "token": "surface.card", "modes": ""}}, {"name": "text_color", "value": "#ff0000ff", "source": "authored", "origin": "class:Panel", "editable": {"rung": "style", "style": "Panel", "row": "color", "file": "styles.contract", "text": "red"}}]} as ada
  clock +1
  clock data
  tap "selrow-row-background-color"
  type "state-value" "#00ff00"
  clock data
  expect text "proposal-error" == "card.contract changed since it was compiled (sha256): select the view again"
  expect disabled "apply"
  request POST "/__stub/restart" {} as ada

test "a template row moves to a new param or token, and a param row detaches to its template: each one transaction, one undo; a name the component has is refused; a detach removes the params it alone left read"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "editable": {"rung": "template", "file": "app.contract", "at": {"line": 9, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "background-color", "instances": 1, "text": "#1e2732"}}, {"name": "border_color", "value": "#0f73ffff", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fill"], "text": "app.contract#Card.fill", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fill", "short": "Card.fill", "token": "accent.fill", "modes": "", "template": {"rung": "template", "file": "app.contract", "at": {"line": 10, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "border-color", "instances": 1, "text": "Card.fill"}}}]} as ada
  clock +1
  clock data
  expect text "selrow-param-background-color" == "Make it a param"
  expect text "selrow-tokenize-background-color" == "Make it a token"
  expect text "selrow-detach-border-color" == "Detach to this template"
  tap "selrow-param-background-color"
  expect state editKind == "promote-param"
  expect text "row-label" == "background-color, as a new param"
  type "move-name" "taken"
  clock data
  expect text "proposal-error" == "a param `taken` exists on `Card` already: give it another name"
  type "move-name" "ground"
  clock data
  expect text "chip" == "Rebuilds"
  tap "apply"
  clock data
  expect text "undo" == "Undo (1)"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "editable": {"rung": "template", "file": "app.contract", "at": {"line": 9, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "background-color", "instances": 1, "text": "#1e2732"}}, {"name": "border_color", "value": "#0f73ffff", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fill"], "text": "app.contract#Card.fill", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fill", "short": "Card.fill", "token": "accent.fill", "modes": "", "template": {"rung": "template", "file": "app.contract", "at": {"line": 10, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "border-color", "instances": 1, "text": "Card.fill"}}}]} as ada
  clock +1
  clock data
  tap "selrow-tokenize-background-color"
  type "move-name" "surface.ground"
  clock data
  expect text "chip" == "Rebuilds"
  tap "apply"
  clock data
  expect text "undo" == "Undo (2)"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "editable": {"rung": "template", "file": "app.contract", "at": {"line": 9, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "background-color", "instances": 1, "text": "#1e2732"}}, {"name": "border_color", "value": "#0f73ffff", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fill"], "text": "app.contract#Card.fill", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fill", "short": "Card.fill", "token": "accent.fill", "modes": "", "template": {"rung": "template", "file": "app.contract", "at": {"line": 10, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "border-color", "instances": 1, "text": "Card.fill"}}}]} as ada
  clock +1
  clock data
  tap "selrow-detach-border-color"
  expect state editKind == "detach-param"
  clock data
  expect tree missing "proposal-error"
  expect text "chip" == "Rebuilds"
  tap "apply"
  clock data
  expect text "undo" == "Undo (3)"
  // A param another row still reads: detached here, its declaration kept (the server says the other reads it).
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 5, "site": 4, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 11, "col": 5, "end_col": 8, "component": "Card", "chain": []}, "rows": [{"name": "transition_duration", "value": "150ms", "source": "authored", "origin": "own", "token": {"names": ["app.contract#Card.fade"], "text": "app.contract#Card.fade", "modes": "", "implied": false}, "editable": {"rung": "param", "param": "app.contract#Card.fade", "short": "Card.fade", "modes": "", "template": {"rung": "template", "file": "app.contract", "at": {"line": 11, "col": 9}, "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", "row": "transition-duration", "instances": 1, "text": "Card.fade"}}}]} as ada
  clock +1
  clock data
  tap "selrow-detach-transition-duration"
  clock data
  expect tree missing "proposal-error"
  tap "apply"
  clock data
  expect text "undo" == "Undo (4)"
  request POST "/__stub/restart" {} as ada

test "the inspector places a light copy on the light column, and a build whose scheme is not known, or that went, offers no edit"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-2", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "compact"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  // Light: the under-dark axis is its default there; density is compact.
  expect text "selection-build" == "web-1 · Light · density=compact"
  tap "selrow-edit-background-color"
  clock data
  expect state selColumn == "1-light"
  // A build that has not reported: its scheme is not known, no edit.
  request POST "/__stub/event" {"event": "selection", "build": "web-2", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the scheme it is shown in is not known. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // The build goes: no longer current.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build is gone. Select it again to edit from here."
  request POST "/__stub/restart" {} as ada

test "a selection stays stale once its build reloads, its mode moves or it runs a new plan, even back to the same facts; a trimmed report without its scheme offers no edit"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  // (An initial row, folded until shown.)
  expect tree missing "selrow-source-color-scheme"
  tap "selrow-initial"
  expect text "selrow-source-color-scheme" == "initial"
  expect text "selrow-source-border-top-left-radius" == "set here (own)"
  // A reload: the build registers again (no status), then reports the same
  // facts, both in one answer. Another document: still not current.
  request POST "/__stub/event" {"events": [{"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}]}, {"event": "build-status", "build": {"id": "web-1", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // Selected again: current. The app moves its mode: not current.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"density": "compact"}, "rootFontSize": 16, "revision": 0}}} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  // Selected again; the build runs a new plan, its status the same: not current.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "plan": "g2", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"density": "compact"}, "rootFontSize": 16, "revision": 0}}} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  // A report trimmed of its `color-scheme` row: the scheme is not known.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": true, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the scheme it is shown in is not known. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // A copy whose modes the design has no column for: not placed, no edit.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "spacious"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its modes are not a column of the app's design. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  request POST "/__stub/restart" {} as ada

test "a cell the inspector opens after the design's axes were reordered is refused, not put on another tuple"
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  type "file" "brand.tamber"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}]} as ada
  clock +1
  clock data
  expect text "selection-build" == "web-1 · Dark · dark-style=dim"
  // The axes move before the app's design is read again: the column the
  // selection names is another tuple there.
  request POST "/__stub/reverse-axes" {} as ada
  tap "selrow-edit-background-color"
  clock data
  clock +1
  clock data
  expect state file == ""
  expect text "branch-moved" == "The design's axes changed since that copy was selected, so this column is another branch now: select it again."
  expect tree missing "branch"
  request POST "/__stub/restart" {} as ada

test "the inspect toggle follows the server's inspect events: another client taking the build over, and this client's lapse"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  // Another client takes the build: this one no longer inspects there.
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"], "to": "agent"}, {"event": "inspect", "client": "agent", "on": true, "builds": ["web-1"]}, {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "inspector": "agent", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  // On again, then its presence lapses at the server: off, said by the event.
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "black", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"], "to": null}, {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "inspector": null, "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  expect text "selection-stale" == "No longer current: inspect mode was turned off there. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // Another name is another client: this one inspects nothing yet.
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  tap "person"
  type "name" "Grace"
  tap "save-name"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  request POST "/__stub/restart" {} as ada

test "a folded :disabled row is read as its base, a param's rung, its part beneath it at its place with its own edit (LLP 1122 queue item (2))"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": null, "held": null}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 4, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/post.contract", "line": 9, "col": 5, "end_col": 11, "component": "PostButton", "chain": []}, "rows": [{"name": "background_color", "value": "#999999", "source": "dynamic", "origin": "own", "at": {"file": "/stub/post.contract", "line": 10, "col": 7, "end_col": 23, "sha256": "x"}, "attr": "background-color", "editable": {"rung": "param", "param": "post.contract#PostButton.fill", "short": "PostButton.fill", "modes": ""}, "states": [{"state": "disabled", "source": {"file": "/stub/post.contract", "line": 12, "col": 9, "end_col": 25}, "editable": {"rung": "state", "style": "PostButton", "state": "disabled", "row": "background-color", "file": "post.contract", "text": "#999999"}}]}]} as ada
  clock +1
  clock data
  // The base: the param it reads, not a dynamic expression's refusal.
  expect text "selrow-edit-background-color" == "Edit PostButton.fill"
  expect tree missing "selrow-reason-background-color"
  // Its `:disabled` part beneath it: at its own place, set-state's edit.
  expect text "selrow-source-:disabled background-color" == ":disabled part at post.contract:12"
  expect text "selrow-state-:disabled background-color" == "Edit PostButton :disabled background-color"
  request POST "/__stub/restart" {} as ada

test "a library component's node: the part outline, its identity and part, its parts with this one and the slot marked; its package rows read only, with no recipe write control (stage 12 D, LLP 1139 D5)"
  // The server's describe of the library component's parts (stage 12 D3), as the stub gives it.
  request POST "/__stub/library" {"@acme/cards/card.contract#Card": {"name": "Card", "parts": [{"name": "root", "groups": ["paint", "shape"], "slot": false}, {"name": "header", "groups": ["paint", "text"], "slot": false}, {"name": "body", "groups": ["space"], "slot": true}], "variants": []}} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "hold": null, "held": null}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  // A node that is the Card's header part: its rows are the package's recipe, read only through the package guard.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/node_modules/@acme/cards/card.contract", "line": 9, "col": 5, "end_col": 9, "component": "Card", "chain": [], "library": {"identity": "@acme/cards/card.contract#Card", "part": "header"}}, "rows": [{"name": "background_color", "value": "#ffffff", "source": "authored", "origin": "class:CardHeader", "library": {"identity": "@acme/cards/card.contract#Card", "part": "header"}, "editable": {"rung": null, "reason": "a package's style (CardHeader): read-only here"}}, {"name": "text_color", "value": "#0a7aff", "source": "authored", "origin": "class:CardHeader", "library": {"identity": "@acme/cards/card.contract#Card", "part": "header"}, "token": {"names": ["accent.fill"], "text": "accent.fill", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "accent.fill", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "library-identity" == "Library: @acme/cards/card.contract#Card"
  expect text "library-part" == "This node is its part header"
  expect text "library-part-root" == "root"
  expect text "library-part-header" == "▸ header"
  expect text "library-part-body" == "body · its slot"
  expect text "library-readonly" == "Its rows are the package's recipe, read only here; a token or param a row reads is set for this app."
  // Read only: the reason, and no write control of any kind on its row.
  expect text "selrow-reason-background-color" == "a package's style (CardHeader): read-only here"
  expect tree missing "selrow-edit-background-color"
  expect tree missing "selrow-state-background-color"
  expect tree missing "selrow-row-background-color"
  expect tree missing "selrow-param-background-color"
  expect tree missing "selrow-detach-background-color"
  expect tree missing "selrow-token-background-color"
  expect tree missing "selrow-tokenize-background-color"
  // A recipe row reading a token: the token (the library's knob, set for this app) is offered; the row itself is not.
  expect text "selrow-edit-color" == "Edit accent.fill"
  expect tree missing "selrow-row-color"
  expect tree missing "selrow-state-color"
  expect tree missing "selrow-param-color"
  expect tree missing "selrow-tokenize-color"
  expect tree missing "selrow-detach-color"
  // A node of its view that is no part: its identity, and so.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 8, "site": 4, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/node_modules/@acme/cards/card.contract", "line": 11, "col": 7, "end_col": 11, "component": "Card", "chain": [], "library": {"identity": "@acme/cards/card.contract#Card", "part": null}}, "rows": []} as ada
  clock +1
  clock data
  expect text "library-part" == "Not one of its parts."
  expect text "library-part-header" == "header"
  // Another design file open: the app's describe still gives the parts, and the outline follows it (a part gone).
  type "file" "brand.tamber"
  clock settle
  request POST "/__stub/library" {"@acme/cards/card.contract#Card": {"name": "Card", "parts": [{"name": "root", "groups": ["paint", "shape"], "slot": false}, {"name": "body", "groups": ["space"], "slot": true}], "variants": []}} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "files": {"app.tamber": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd", "brand.tamber": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  clock settle
  expect state file == "brand.tamber"
  expect tree missing "library-part-header"
  expect text "library-part-body" == "body · its slot"
  // A node outside a library component (the app's own, or a slot's fill): no outline.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 9, "site": 5, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 3, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": []} as ada
  clock +1
  clock data
  expect tree missing "selection-library"
  request POST "/__stub/restart" {} as ada

test "a gallery cell selected: its literal rows read only, the gallery's reason said, no row, promote, tokenize or detach control; its token row's edit is still the app's token (variant gallery G4)"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-js-2", "host": "web-js", "page": "gallery", "capabilities": ["pin", "inspect", "hold"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect text "build-name-web-js-2" == "web-js · web-js-2 · the gallery"
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-js-2", "node": 1, "site": 0, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/repo/node_modules/.cache/exact-gallery/com.x/live/app.contract", "line": 3, "col": 5, "end_col": 11, "component": "Gallery", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "opacity", "value": 1, "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "the variant gallery's generated source: read-only (its tokens and params are the app's)"}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  expect text "selrow-reason-opacity" == "the variant gallery's generated source: read-only (its tokens and params are the app's)"
  expect tree missing "selrow-row-opacity"
  expect tree missing "selrow-param-opacity"
  expect tree missing "selrow-detach-opacity"
  expect tree missing "selrow-state-opacity"
  expect tree missing "selrow-tokenize-opacity"
  expect tree missing "selrow-tokenize-background-color"
  expect tree missing "selrow-detach-background-color"
  request POST "/__stub/restart" {} as ada

test "the inspector folds the rows nothing sets behind one control, opened per selection, and never folds the row being edited"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "tint_color", "value": "currentcolor", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a value the map gives no place for: the source's to edit"}}, {"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  expect tree has "selrow-color"
  expect tree missing "selrow-stroke-linecap"
  expect tree missing "selrow-padding"
  // (Lowering's own tint at its default, with no source place, folds with them: stage 15 D4 batch 1 #5.)
  expect tree missing "selrow--exact-tint-color"
  expect text "selrow-initial" == "4 more rows nothing sets (initial values)"
  tap "selrow-initial"
  expect tree has "selrow-stroke-linecap"
  expect tree has "selrow-marker-end"
  expect tree has "selrow--exact-tint-color"
  expect tree missing "selrow-initial"
  // Its edit begun, the padding row is in play: another view selected (the same style row on it), the rest fold
  // again and it stays.
  tap "selrow-row-padding"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 8, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "tint_color", "value": "currentcolor", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a package's style (Glyph): read-only here"}}, {"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  expect tree has "selrow-padding"
  // (The same value written in a package, which has a place: shown, never folded as lowering's own.)
  expect tree has "selrow--exact-tint-color"
  expect tree missing "selrow-stroke-linecap"
  expect text "selrow-initial" == "2 more rows nothing sets (initial values)"
  // A round trip folds again: shown on one view, another selected, then the first again.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "tint_color", "value": "currentcolor", "source": "authored", "origin": "class:Glyph", "editable": {"rung": null, "reason": "a style's row (Glyph) the map gives no place for: the source's to edit"}}, {"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  // (A class's colour lowered to the tint, with no place either: folded too.)
  expect tree missing "selrow--exact-tint-color"
  tap "selrow-initial"
  expect tree has "selrow-stroke-linecap"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 8, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  expect tree missing "selrow-stroke-linecap"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  // (The padding row, still being edited, stays out of the count.)
  expect text "selrow-initial" == "2 more rows nothing sets (initial values)"
  expect tree missing "selrow-stroke-linecap"
  // A refresh of the same view (its report again) keeps them shown.
  tap "selrow-initial"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": [{"name": "text_color", "value": "#000000ff", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a literal"}}, {"name": "stroke_linecap", "value": "butt", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}, {"name": "padding", "value": "0px", "source": "initial", "origin": null, "editable": {"rung": "style", "style": "Panel", "row": "padding", "file": "styles.contract", "text": "0px"}}, {"name": "marker_end", "value": "none", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "its initial value: nothing sets it"}}]} as ada
  clock +1
  clock data
  expect tree has "selrow-stroke-linecap"

test "a refused inspect is said in the inspector, three at most, and goes when its build inspects after all, re-registers, is another's, or inspect is asked again"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-2", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-3", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-4", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "no-selection" == "Click a view in the canvas or on a device: its source, rows and tokens show here."
  expect tree missing "inspect-refused-web-1"
  request POST "/__stub/event" {"event": "unsupported", "build": "web-1", "what": "inspect", "detail": "Failed to fetch"} as ada
  request POST "/__stub/event" {"event": "unsupported", "build": "web-2", "what": "inspect", "detail": "this build has no inspect table (503)"} as ada
  request POST "/__stub/event" {"event": "unsupported", "build": "web-3", "what": "inspect"} as ada
  request POST "/__stub/event" {"event": "unsupported", "build": "web-4", "what": "inspect", "detail": "Failed to fetch"} as ada
  clock +1
  clock data
  expect text "inspect-refused-web-1" == "web · web-1 could not turn Inspect on: Failed to fetch. Stop inspecting and Inspect again to retry."
  expect text "inspect-refused-web-3" == "web · web-3 could not turn Inspect on. Stop inspecting and Inspect again to retry."
  expect tree has "inspect-refused-web-2"
  expect tree missing "inspect-refused-web-4"
  expect text "inspect-refused-more" == "and 1 more builds could not turn Inspect on"
  // A status naming this tool its inspector says nothing of whether its page inspects: the line stays.
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-2", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "inspector": "design-tool:Ada"}} as ada
  clock +1
  clock data
  expect tree has "inspect-refused-web-2"
  // web-1 inspects after all: a view selected in it. Its line goes, and the fourth shows.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": []}, "rows": []} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-1"
  expect tree has "inspect-refused-web-4"
  expect tree missing "inspect-refused-more"
  // web-3 registers again (its status not reported yet): a new page, its refusal gone with the old one.
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-3", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-3"
  // Another tool takes inspect on web-4: this tool's refusal there is not its to say.
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-4", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "inspector": "design-tool:Grace"}} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-4"
  expect tree has "inspect-refused-web-2"
  // web-2's page leaves inspect mode itself (the server says so in an inspect event alone): its line goes.
  request POST "/__stub/event" {"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-2"], "to": null} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-2"
  // A build that refused before its first status, registered again: no refusal recorded, so none said. (The list
  // carries each build's inspector as the stub's records have it.)
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "inspector": "design-tool:Ada"}, {"id": "web-2", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-3", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "inspector": "design-tool:Ada"}, {"id": "web-4", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0, "inspector": "design-tool:Grace"}, {"id": "web-5", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0, "inspector": "design-tool:Ada"}]} as ada
  request POST "/__stub/event" {"event": "inspect", "client": "design-tool:Ada", "on": true, "builds": ["web-5"]} as ada
  request POST "/__stub/event" {"event": "unsupported", "build": "web-5", "what": "inspect", "detail": "Failed to fetch"} as ada
  clock +1
  clock data
  expect tree has "inspect-refused-web-5"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-5", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0, "unsupported": null}} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-5"
  // A refusal from a build this tool does not inspect is not this tool's to say.
  request POST "/__stub/event" {"event": "unsupported", "build": "web-2", "what": "inspect", "detail": "Failed to fetch"} as ada
  clock +1
  clock data
  expect tree missing "inspect-refused-web-2"
  // Off, nothing is said; asked again (the stub accepts), the refusals said before go.
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  expect tree missing "inspect-refused-web-2"
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  expect tree missing "inspect-refused-web-2"

test "a design that declares no mode axes is read, not 'not read yet': its copy sits on its light column and its rows offer their edits (stage 15 D4 batch 1 #1)"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/no-axes" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-build" == "web-1 · Light"
  expect tree missing "selection-stale"
  expect text "selrow-edit-background-color" == "Edit surface.card"
  // Another run of the server: what the last one's describe said is not this one's, so until this run's is read
  // (refused here) a selection is not placed on the old axes.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/event" {"refuseDescribe": "describe refused (a test)", "events": [{"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the app's design is not read yet. Select it again to edit from here."
  request POST "/__stub/restart" {} as ada

test "a selection made before another run's describe is read is placed once it is, not against the last run's axes (no-axes round 2)"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  // (This run's design has two axes, read.) Another run, whose design has none, its describe refused for now.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/no-axes" {} as ada
  request POST "/__stub/event" {"refuseDescribe": "describe refused (a test)", "events": [{"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the app's design is not read yet. Select it again to edit from here."
  // Its describe answered (a file's change reads the design again): the same selection is placed, and edits.
  request POST "/__stub/event" {"refuseDescribe": "", "events": [{"client": "agent:codex", "edited": ["app.tamber"], "changed": []}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree missing "selection-stale"
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/restart" {} as ada

test "a slot's host is its own chain line, named by its call, and a press of it lands there with no note (stage 15 D3, tamber/1.18)"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/app.contract", "line": 5, "col": 7, "end_col": 11, "component": "Card", "slot": true}, {"file": "/stub/app.contract", "line": 12, "col": 7, "end_col": 11, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "fromAt": {"file": "/stub/app.contract", "line": 12, "component": "App"}, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect text "selection-up-1" == "in Card's slot (app.contract:5)"
  expect text "selection-up-2" == "in /stub/app.contract:12 · App"
  tap "selection-up-1"
  clock data
  clock +1
  clock data
  expect text "selection-source" == "app.contract:5 · Card"
  expect tree missing "selection-up-note"
  request POST "/__stub/restart" {} as ada
