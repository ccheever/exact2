test "an undo goes only to the server run that issued it: after a restart it is refused, and undo and redo start again"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "dial-hue-stepper" "210"
  clock data
  tap "apply"
  clock data
  expect text "undo" == "Undo (1)"
  request POST "/__stub/restart" {} as ada
  tap "undo"
  clock data
  expect text "write-error" == "The design server restarted (or another took its port) since this session began: nothing was written, and undo and redo start again."
  expect text "undo" == "Undo (0)"

test "a gap in the long poll is said in Changes"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}} as ada
  request POST "/__stub/miss" {} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "entry-text-1" == "Some changes were missed here (the server keeps the last 256), so this list may be incomplete."

test "the canvas frames the dev loop's page at the size chosen, and says how to start one when there is none"
  request POST "/__stub/page" {"page": null} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-app"
  expect text "no-app-how" == "The canvas shows the app from its dev loop. Start one (bun exact.mjs web, in the app's directory), then open the tool through it: bun exact.mjs tamber tool --via <its URL>. Stop this tool first: it holds the design server, and --via refuses while it runs."
  expect tree missing "canvas-frame"
  expect tree missing "canvas-open"
  request POST "/__stub/page" {"page": "http://127.0.0.1:8765"} as ada
  reload
  clock data
  expect tree has "canvas-frame"
  expect tree has "canvas-open"
  // Framed as localhost: another site than the tool's, its own process;
  // opened in a tab as the dev loop prints it.
  expect state hello.frame == "http://localhost:8765"
  expect state hello.page == "http://127.0.0.1:8765"
  expect tree missing "no-app"
  type "canvas-size" "tablet"
  expect state canvasSize == "tablet"
  reload
  clock data
  expect state canvasSize == "tablet"
  request POST "/__stub/page" {"page": null} as ada

test "the canvas frames only a loopback origin: another host, a path, or the tool's own origin is no page"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/page" {"page": "http://example.com:8765"} as ada
  reload
  clock data
  expect tree has "no-app"
  expect tree missing "canvas-frame"
  request POST "/__stub/page" {"page": "http://127.0.0.1:8765/elsewhere"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://127.0.0.1:70000"} as ada
  reload
  clock data
  expect tree has "no-app"
  expect text "app" == "/stub/theme-fixture"
  request POST "/__stub/page" {"page": "http://127.0.0.1:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://localhost:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://127.0.0.1:07740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://[::1]:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://[::1]:8765"} as ada
  reload
  clock data
  expect tree has "canvas-frame"
  expect state hello.frame == "http://localhost:8765"
  request POST "/__stub/page" {"page": null} as ada

test "builds: each with its effective facts from its status; a pin on one shows pinning until its status reaches the pin's revision, and only that build moves"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-builds"
  // Pin waits for something to pin, and a root font size it can take.
  expect disabled "pin-apply"
  type "pin-font" "3"
  expect disabled "pin-apply"
  type "pin-font" ""
  expect disabled "pin-preview"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "status": {"scheme": "dark", "contrast": "more", "mode": {"dark-style": "dim"}, "rootFontSize": 17, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "mac-1", "host": "macos", "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree missing "no-builds"
  expect text "build-status-web-1" == "light · dark-style=black · 16px"
  expect text "build-status-ios-1" == "dark · contrast more · dark-style=dim · 17px"
  expect text "build-status-mac-1" == "Not reported yet: it has not said what it shows."
  expect tree missing "build-pin-web-1"
  type "pin-build" "web-1"
  type "pin-scheme" "dark"
  type "pin-mode-dark-style" "dim"
  tap "pin-apply"
  clock data
  expect text "pin-result" == "Pinned on 1 build(s)."
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark, dark-style=dim"
  expect tree missing "build-pin-ios-1"
  // Its status, at the pin's revision: the effective facts are the
  // build's own (its app chose Black over the pin's Dim).
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 1}, "pin": {"scheme": "dark", "mode": {"dark-style": "dim"}}, "pinRevision": 1}} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinned: dark, dark-style=dim"
  expect text "build-status-web-1" == "dark · dark-style=black · 16px"
  expect text "build-status-ios-1" == "dark · contrast more · dark-style=dim · 17px"
  // Handed back: said until its status reaches the hand-back's revision.
  tap "pin-clear"
  clock data
  expect text "pin-result" == "Pins handed back on 1 build(s)."
  clock +1
  clock data
  expect text "build-pin-web-1" == "handing back"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 2}, "pin": null, "pinRevision": 2}} as ada
  clock +1
  clock data
  expect tree missing "build-pin-web-1"
  request POST "/__stub/restart" {} as ada

test "builds: a preview replaces a build's pin; an unsupported pin is named until its status moves on; another client's pin is followed; a refused pin says why; a new run lists its own builds"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  type "pin-build" "web-1"
  type "pin-scheme" "dark"
  type "pin-contrast" "more"
  tap "pin-apply"
  clock data
  request POST "/__stub/event" {"event": "unsupported", "build": "web-1", "what": "pin.contrast", "detail": "the web has no contrast preference to set"} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark, contrast more"
  expect text "build-unsupported-web-1" == "Not applied: pin.contrast: the web has no contrast preference to set"
  // One axis previewed: the pin is that axis alone; the refusal stays
  // until the build's status moves to the preview's revision.
  type "pin-scheme" ""
  type "pin-contrast" ""
  type "pin-mode-dark-style" "dim"
  tap "pin-preview"
  clock data
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark-style=dim"
  expect tree has "build-unsupported-web-1"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 2}, "pin": {"mode": {"dark-style": "dim"}}, "pinRevision": 2, "unsupported": null}} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinned: dark-style=dim"
  expect tree missing "build-unsupported-web-1"
  // Another client's pin, announced by the server: followed, and not
  // caught up until the status says so.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 2}, "pin": {"scheme": "light", "rootFontSize": 20}, "pinRevision": 3}]} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: light, 20px"
  // A build gone from the server's list: a pin on it is refused. It was connected, so for 10 s it is one reloading
  // (stage 15 D1.2), not "no build", and back under its id it is listed again. (The window ios-1 and mac-1 opened,
  // going above, closed first.)
  clock +10000
  expect tree missing "build-reloading-ios-1"
  request POST "/__stub/event" {"event": "builds", "builds": []} as ada
  clock +1
  clock data
  expect text "build-reloading-web-1" == "web · web-1 · reloading"
  expect tree missing "no-builds"
  tap "pin-apply"
  clock data
  expect text "pin-result" == "no registered build `web-1`"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree has "build-web-1"
  expect tree missing "build-reloading-web-1"
  expect tree missing "no-builds"
  clock +10000
  // Gone again and not back: past the window (10 s from its going) it is no build, as one never connected is.
  request POST "/__stub/event" {"event": "builds", "builds": []} as ada
  clock +1
  clock data
  expect tree has "build-reloading-web-1"
  clock +9000
  expect tree has "build-reloading-web-1"
  expect tree missing "no-builds"
  clock +1000
  expect tree missing "build-reloading-web-1"
  expect tree has "no-builds"
  // A new run of the server: its builds, from its hello, at once.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "linux-1", "host": "linux", "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "build-linux-1"
  expect tree missing "build-web-1"
  request POST "/__stub/restart" {} as ada

test "the pin form offers the app's own axes whichever file is open, and retyping the name keeps the tool's client while it is typed"
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  expect tree has "pin-mode-dark-style"
  type "file" "brand.tamber"
  clock data
  expect tree has "pin-mode-dark-style"
  tap "person"
  expect tree has "rename-note"
  expect state person == "Ada"
  type "name" "Grace"
  tap "save-name"
  expect state person == "Grace"
  expect tree missing "rename-note"

test "pairing: a code at the scope chosen, with each remote door's fingerprint to check; the clients as they pair; a revoke ends one"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/remote" {"remote": [{"origin": "https://192.168.1.20:7743", "fingerprint": "AB:CD:EF:01"}, {"origin": "http://127.0.0.1:7744", "tunnel": true}]} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "no-clients" == "No client is paired."
  expect text "pair-scope-note" == "Propose: it reads, and offers changes for someone with write to accept."
  type "pair-scope" "read"
  expect text "pair-scope-note" == "Read: it sees the design and its history, and inspects without moving anyone's screens."
  tap "pair-mint"
  clock data
  expect text "pair-code-text" == "7Q2KD-M4X01"
  expect text "pair-fingerprint-https://192.168.1.20:7743" == "AB:CD:EF:01"
  expect text "pair-door-http://127.0.0.1:7744" == "Through the tunnel you trusted, at http://127.0.0.1:7744"
  request POST "/__tamber/pair" {"code": "7Q2KD-M4X01", "name": "laptop"} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "client-scope-remote:laptop#1" == "read"
  expect tree missing "no-clients"
  tap "revoke-remote:laptop#1"
  clock data
  expect text "revoke-result" == "remote:laptop#1 was revoked: its token is refused from now on, and its stream and long poll end."
  expect tree missing "client-remote:laptop#1"
  expect text "no-clients" == "No client is paired."
  request POST "/__stub/restart" {} as ada

test "a refused pair-code or clients read is said, and the clients are asked again with the poll"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/refuse-pairing" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "clients-error" == "clients: refused, as the test asked"
  tap "pair-mint"
  clock data
  expect text "pair-error" == "pair-code: refused, as the test asked"
  clock +3000
  clock data
  expect text "no-clients" == "No client is paired."
  request POST "/__stub/restart" {} as ada

test "pairing with no remote door open says how to open one"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "pair-mint"
  clock data
  expect text "pair-code-text" == "7Q2KD-M4X01"
  expect text "pair-no-door" == "No remote door is open: start the dev loop or tamber serve with --remote <host:port> for a client on another machine."
  request POST "/__stub/restart" {} as ada

test "remote mode: the tool pairs with another machine's server by its address and code, only over an https door or a tunnel to loopback; at propose an edit is held for review and what writes is greyed and never sent; a revoke ends it and says so"
  // No server on this machine: the browser is the other machine's (the stub stands in for that
  // machine's server, through a tunnel to loopback, so only this machine's token is refused).
  fail fetch "http://127.0.0.1:7740/__tamber/token"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "pair-remote"
  expect disabled "remote-pair"
  // A plain http door off this machine is refused before anything is sent.
  type "remote-at" "http://192.168.1.20:7740"
  type "remote-code" "7Q2KD-M4X01"
  tap "remote-pair"
  clock data
  expect text "remote-error" == "Pairing goes only over an encrypted connection: an https address, or a tunnel to this machine (http://127.0.0.1:<port>). Nothing was sent."
  // The code was not kept.
  expect state remoteCode == ""
  type "remote-at" "http://127.0.0.1:7740"
  type "remote-code" "7Q2KD-M4X99"
  tap "remote-pair"
  clock data
  expect text "remote-error" == "no such pairing code: it may have expired, been used, or been burned by failed attempts"
  request POST "/__stub/pair-code" {"scope": "propose"} as ada
  type "remote-code" "7q2kd-m4x01"
  tap "remote-pair"
  clock data
  clock +1
  clock data
  expect text "person" == "remote:Ada#1"
  expect text "paired-scope" == "Paired as remote:Ada#1, at propose: an edit is held for review, for someone with write to accept; undo, commit, pins, holds, outlines, inspect mode and scrubs are greyed."
  // The local tool's own: no clients panel.
  expect tree missing "pairing"
  expect disabled "inspect-toggle"
  expect disabled "commit"
  type "dial-hue-stepper" "210"
  clock data
  expect text "chip" == "Rebuilds"
  expect text "apply" == "Propose for review"
  tap "apply"
  clock data
  expect text "write-note" == "Held for review as held-1: someone with write accepts it."
  expect disabled "undo"
  // Its canvas comes only through the server's TLS door (stage 10 C): through this tunnel there is none.
  expect text "canvas-remote-none" == "No canvas: the design server named no gateway this tool can frame (its canvas is https, on its TLS door's host, another machine, and another port)."
  expect tree missing "canvas-frame"
  // Revoked on the other machine: the next request is refused, and the tool says so and sends no more.
  request POST "/__stub/revoke" {"client": "remote:Ada#1"} as ada
  clock +1
  clock data
  clock +3000
  clock data
  expect text "no-server-title" == "Revoked"
  expect tree missing "canvas-frame"
  expect text "no-server-message" == "This client was revoked, or its pairing expired: nothing more is sent to the design server. Pair again with a new code."
  request POST "/__stub/restart" {} as ada

test "a paired tool frames no page of this machine, whatever the server's hello says"
  fail fetch "http://127.0.0.1:7740/__tamber/token"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/pair-code" {"scope": "read"} as ada
  request POST "/__stub/forge-local" {} as ada
  type "remote-at" "http://127.0.0.1:7740"
  type "remote-code" "7Q2KD-M4X01"
  tap "remote-pair"
  clock data
  clock +3000
  clock data
  expect text "person" == "remote:Ada#1"
  expect tree missing "canvas-frame"
  expect tree missing "canvas-open"
  expect tree missing "pairing"
  request POST "/__stub/restart" {} as ada

test "T7: a grid of live copies, each pinned to its mode on the build its own frame said, whichever registers first; a copy moved leads the others, one that can't navigate is reloaded there; Mirror off moves none; a smaller grid and one copy hand the pins back"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/copies" {"delays": {"exact-copy-1": 4000}, "noNavigate": ["exact-copy-3"], "refuseLater": ["exact-copy-5"]} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  type "canvas-view" "grid"
  clock data
  expect text "grid-shared" == "Each copy is its own origin, with its own storage: each starts with its own data. Mirrored navigation replays no actions."
  expect tree missing "canvas-frame"
  // Copy 1's build registers last (4 s after the others), and still takes its own pin, no other's.
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-label-exact-copy-1" == "Light"
  expect text "grid-label-exact-copy-2" == "Black"
  expect text "grid-label-exact-copy-3" == "Dim"
  expect text "grid-label-exact-copy-4" == "Light · 22px"
  expect text "grid-label-exact-copy-6" == "Dim · 22px"
  expect tree missing "grid-tile-exact-copy-7"
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 16px · /"
  expect text "grid-note-exact-copy-6" == "dark · dark-style=dim · 22px · /"
  expect text "grid-note-exact-copy-1" == "light · 16px · /"
  expect text "grid-note-exact-copy-4" == "light · 22px · /"
  expect text "build-pin-copy-1" == "pinned: light"
  expect text "build-pin-copy-3" == "pinned: dark, dark-style=dim"
  // Copy 2's app asked for Dim; its pin held (theme2's F2 ruling), and the tile says so.
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "copy-2", "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0, "location": "/", "app": {"mode": {"dark-style": "dim"}}}}} as ada
  clock +1000 real
  clock data
  expect text "grid-app-exact-copy-2" == "The app set dark-style=dim; pinned to dark, dark-style=black."
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 16px · /"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "copy-2", "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0, "location": "/"}}} as ada
  // The person moves copy 2: the others follow; copy 3's build can't navigate, so its frame reloads there, and says so.
  request POST "/__stub/move" {"build": "copy-2", "location": "/post/3"} as ada
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-1" == "light · 16px · /post/3"
  expect text "grid-note-exact-copy-6" == "dark · dark-style=dim · 22px · /post/3"
  expect text "grid-note-exact-copy-3" == "dark · dark-style=dim · 16px · /post/3 · reloaded there: its build can't navigate"
  // Copy 5's page took the command and then refused it: reloaded there too.
  expect text "grid-note-exact-copy-5" == "dark · dark-style=black · 22px · /post/3 · reloaded there: its build can't navigate"
  // Mirror off: a copy moved leads no other.
  tap "grid-mirror"
  request POST "/__stub/move" {"build": "copy-1", "location": "/post/9"} as ada
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-1" == "light · 16px · /post/9"
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 16px · /post/3"
  // Fewer copies: the two left out are handed back.
  type "grid-cap" "4"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect tree missing "grid-tile-exact-copy-5"
  expect tree missing "build-pin-copy-5"
  expect text "build-pin-copy-4" == "pinned: light, 22px"
  // One copy again: every pin the grid made handed back.
  type "canvas-view" "one"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect tree missing "grid-section"
  expect tree missing "build-pin-copy-1"
  expect tree missing "build-pin-copy-4"
  request POST "/__stub/restart" {} as ada

test "T7: the selected view's states side by side, each copy holding one on the selection's site in the selection's plan and mode, kept while its pins move the selected build; the grid lets the holds go, and so does One copy"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/copies" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  type "canvas-view" "states"
  clock +1000 real
  clock data
  expect text "grid-note" == "Select a view (Inspect, then click it in a copy) to see its states side by side."
  expect tree missing "grid-tile-exact-copy-1"
  // A view selected in a copy registered meanwhile (the grid's frames register as the grid opens).
  type "canvas-view" "grid"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "copy-5", "node": 4, "site": 3, "instance": [], "type": "Card", "planDigest": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc", "tuple": {"dark-style": "dim"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 9, "col": 5, "end_col": 11, "component": "Card", "chain": []}, "rows": []} as ada
  clock +1
  clock data
  type "canvas-view" "states"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note" == "Card #4, in dark · dark-style=black · 22px."
  expect text "grid-label-exact-copy-1" == "At rest"
  expect text "grid-label-exact-copy-2" == "Pressed"
  expect text "grid-label-exact-copy-4" == "Focused"
  expect tree missing "grid-tile-exact-copy-5"
  expect text "grid-note-exact-copy-1" == "dark · dark-style=black · 22px · /"
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 22px · / · holding pressed"
  expect text "grid-note-exact-copy-3" == "dark · dark-style=black · 22px · / · holding hovered"
  expect text "grid-note-exact-copy-4" == "dark · dark-style=black · 22px · / · holding focused"
  // Its build says it holds it.
  request POST "/__stub/event" {"event": "held", "build": "copy-2", "state": "active"} as ada
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 22px · / · held pressed"
  // The copy the view was selected in, no longer shown, is handed back.
  expect tree missing "build-pin-copy-5"
  // The grid again: its copies hold no state.
  type "canvas-view" "grid"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 16px · /"
  expect text "grid-note-exact-copy-3" == "dark · dark-style=dim · 16px · /"
  // One copy: the pins handed back.
  type "canvas-view" "one"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect tree missing "build-pin-copy-2"
  request POST "/__stub/restart" {} as ada

test "the variant gallery: a toggle beside a local canvas frames the dev loop's /__dev/gallery/ in its place, and says it follows each kept edit, not each scrub frame; none for a page that isn't a loopback origin, nor in States (variant gallery G4)"
  request POST "/__stub/page" {"page": "http://127.0.0.1:8765"} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  reload
  clock data
  expect tree has "canvas-frame"
  expect state galleryOn == false
  expect state galleryFrame == "http://localhost:8765/__dev/gallery/"
  expect tree missing "gallery-note"
  tap "canvas-gallery"
  expect state galleryOn == true
  expect tree has "canvas-frame"
  expect text "gallery-note" == "The variant gallery: each library component the app uses, once per variant value, on the app's design. Each cell is a column's width, as a caller's column shows it. It follows each kept edit, not each scrub frame. It runs on the JS dev loop; another loop says so in the frame."
  // States: the copies hold the selection's own view, the app's.
  type "canvas-view" "states"
  expect tree missing "canvas-gallery"
  expect tree missing "gallery-note"
  type "canvas-view" "one"
  // A page on another origin is no page: no canvas, so no gallery.
  request POST "/__stub/page" {"page": "http://example.com:8765"} as ada
  reload
  clock data
  expect tree missing "canvas-frame"
  expect tree missing "canvas-gallery"
  expect state galleryFrame == ""
  request POST "/__stub/page" {"page": null} as ada

test "a gallery copy in the grid: listed as the gallery's, never sent where a moved copy leads, nor reloaded there; one moved leads no other (variant gallery G4)"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/copies" {"gallery": ["exact-copy-2"], "noNavigate": ["exact-copy-3"]} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  type "canvas-view" "grid"
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "build-name-copy-2" == "web · copy-2 · the gallery"
  expect text "build-name-copy-1" == "web · copy-1"
  // An app copy moved: the app copies follow; the gallery's stays on its own page.
  request POST "/__stub/move" {"build": "copy-1", "location": "/post/3"} as ada
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-3" == "dark · dark-style=dim · 16px · /post/3 · reloaded there: its build can't navigate"
  expect text "grid-note-exact-copy-2" == "dark · dark-style=black · 16px · /"
  // The gallery's copy moved: no copy follows it.
  request POST "/__stub/move" {"build": "copy-2", "location": "/x"} as ada
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-1" == "light · 16px · /post/3"
  expect text "grid-note-exact-copy-3" == "dark · dark-style=dim · 16px · /post/3 · reloaded there: its build can't navigate"
  // The gallery on: every copy frames it, the one reloaded at the app's place too.
  tap "canvas-gallery"
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  clock +1000 real
  clock data
  expect text "grid-note-exact-copy-3" == "dark · dark-style=dim · 16px · /__dev/gallery/"
  expect text "grid-note-exact-copy-1" == "light · 16px · /__dev/gallery/"
  type "canvas-view" "one"
  request POST "/__stub/restart" {} as ada
