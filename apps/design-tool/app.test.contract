test "the inspector: inspect mode on the builds, a selection's source and rows, the token rung on the branch that won, a link for an inherited colour, a style's row read-only, and the token's impact"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree has "no-selection"
  tap "inspect-toggle"
  clock data
  expect text "inspect-result" == "Inspecting on 1 build(s): click a view in one. ios-1 cannot inspect."
  // The toggle follows the server's event for its own command.
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect text "selection-source" == "card.contract:4 · Card"
  expect text "selection-build" == "web-1 · Dark · dark-style=dim"
  expect tree missing "selection-stale"
  expect text "selrow-source-background-color" == "set here (own)"
  expect text "selrow-edit-background-color" == "Edit surface.card"
  expect text "selrow-source-color" == "inherited from #1"
  expect text "selrow-link-color" == "Open text.primary"
  expect text "selrow-reason-color" == "inherited from #1: the token is that node's to edit"
  expect tree missing "selrow-edit-padding"
  expect text "selrow-reason-padding" == "a style's row (Panel): comes with template editing (T5)"
  // The token rung: its cell in the app's design, on the branch the
  // selected copy shows (Dark, Dim), and its impact.
  tap "selrow-edit-background-color"
  clock data
  expect state file == ""
  expect state selToken == "surface.card"
  expect state selColumn == "2-dark"
  clock +1
  clock data
  expect text "impact-count" == "surface.card: read at 2 source site(s), statically (not a count of mounted copies)"
  tap "impact-outline"
  clock data
  expect text "impact-outlined" == "Sent surface.card's 2 site(s) to web-1; a build in inspect mode on that plan outlines them."
  // The page leaves inspect mode itself: the selection is no longer
  // current (no edit offered), and the tool no longer inspects.
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"]}, {"event": "selected", "build": "web-1", "selected": null}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its page left inspect mode. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  expect tree missing "selrow-link-color"
  expect text "inspect-toggle" == "Inspect"
  request POST "/__stub/restart" {} as ada

