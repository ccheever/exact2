  clock data
  expect text "write-note" == "imp was recomputed on the files as they are now, as imp-r: review its diff and accept it again."

test "a recomputed import's diff follows its card's choice at once: the plan of what is chosen, the held one when all is, none when nothing is (stage 15 D1.1)"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/long-poll" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/hold" {"proposal": "imp-r", "replaces": "imp", "client": "design-tool:Ada", "diff": "--- app.tamber\n+++ app.tamber\n+  every operation\n", "changed": [], "ops": [{"index": 0, "op": {"op": "add-token", "name": "shadcn.card", "value": "#ffffff"}}, {"index": 1, "op": {"op": "add-token", "name": "shadcn.ring", "value": "#000000"}}], "review": {"importer": "shadcn", "counted": {"source": 2, "mapped": 2, "reported": 0}, "tokens": 2, "unmapped": [], "offers": []}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "held-diff-imp-r" == "--- app.tamber\n+++ app.tamber\n+  every operation\n"
  tap "take-imp-r-1"
  clock data
  expect text "held-diff-imp-r" == "--- app.tamber\n+++ app.tamber\n+  {\"op\":\"add-token\",\"name\":\"shadcn.card\",\"value\":\"#ffffff\"}\n"
  tap "take-imp-r-0"
  clock data
  expect text "held-diff-imp-r" == ""
  expect text "held-diff-note-imp-r" == "Nothing is chosen, so accepting it would write nothing."
  tap "take-imp-r-0"
  tap "take-imp-r-1"
  clock data
  expect text "held-diff-imp-r" == "--- app.tamber\n+++ app.tamber\n+  every operation\n"
  expect tree missing "held-diff-note-imp-r"

