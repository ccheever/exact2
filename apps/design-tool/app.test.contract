// The design tool against a stand-in Tamber server (stub/tamber-stub.ts, run
// by `test` and `verify`): its hello and long poll, the canvas, builds and
// pins, pairing, review, commit and history, and the grid of live copies.
// editing.test.contract holds the panels' edits and scrubs, and
// inspector.test.contract the inspector; `bun exact.mjs test` runs all three,
// `verify` this file alone. Its drives against a real `tamber serve` are in
// scripts/design-tool.test.mjs and its -ops, -canvas and -scrub files (and
// stage 11's base scale and package rows in scripts/design-tool-scale.test.mjs).

test "it asks for the person's name once, then shows the server's hello"
  expect tree has "ask-name"
  expect disabled "save-name"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "person" == "design-tool:Ada"
  expect text "app" == "/stub/theme-fixture"
  expect text "protocol" == "tamber/1.13 · IR format 1"
  // The files folded behind one line (below the canvas and the tokens), opened on asking.
  expect tree missing "file-app.tamber"
  expect text "toggle-files" == "Files (2)"
  tap "toggle-files"
  expect tree has "file-app.tamber"
  expect tree has "file-brand.tamber"
  expect text "toggle-files" == "Hide files"
  reload
  expect text "person" == "design-tool:Ada"

test "a dev loop whose page won't let this tool frame it is said above the canvas, and the line goes once it does"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree missing "canvas-refused"
  request POST "/__stub/canvas-check" {"via": "http://127.0.0.1:5173", "allowed": false, "origins": ["http://localhost:5173", "http://127.0.0.1:9999"], "portFixes": true} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "canvas-refused" == "The dev loop at http://127.0.0.1:5173 lets only http://localhost:5173 http://127.0.0.1:9999 frame its page, not this tool, so the canvas stays empty: start the loop with EXACT_TOOL_PORT=7740."
  // The loop started again with the tool's port: asked again with hello, the line goes.
  request POST "/__stub/canvas-check" {"via": "http://127.0.0.1:5173", "allowed": true, "origins": []} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree missing "canvas-refused"
  request POST "/__stub/restart" {} as ada

test "no server: a clear way to start one, and Try Again"
  fail fetch "http://127.0.0.1:7740"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-server"
  expect text "no-server-message" == "No design server answers at http://127.0.0.1:7740. Start one for your app with `bun exact.mjs tamber tool <app>`, then try again."
  pass fetch "http://127.0.0.1:7740"
  tap "reconnect"
  clock data
  expect tree has "hello"

test "another client's write arrives on the long poll, attributed"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "toggle-files"
  expect text "digest-app.tamber" == "aaaaaaaaaaaa"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "change-1" == "app.tamber · agent:codex"
  expect text "digest-app.tamber" == "cccccccccccc"
  request POST "/__stub/event" {"client": null, "edited": ["brand.tamber"]} as ada
  clock +1
  clock data
  expect text "change-2" == "brand.tamber · changed on disk"

test "a restarted server starts the list again"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:before", "edited": ["app.tamber"]} as ada
  clock +1
  clock data
  expect text "change-1" == "app.tamber · agent:before"
  request POST "/__stub/restart" {} as ada
  clock +1
  clock data
  expect tree missing "change-1"
  request POST "/__stub/event" {"client": "design-tool:Grace", "edited": ["brand.tamber"]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "change-1" == "brand.tamber · design-tool:Grace"

test "another design file is read when chosen, and a refused one shows its error and a retry"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "file" "brand.tamber"
  clock data
  expect text "design-error" == "the stub has no design in brand.tamber"
  expect tree has "reload-design"
  expect tree missing "no-dials"
  expect tree missing "dials"
  expect tree missing "contrast"
  type "file" ""
  clock data
  expect tree missing "design-error"
  expect tree has "dial-accent-color"

test "a commit's dry run is read again only when what a commit could take moves: not on each answer, a build's status or a scrub"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/refuse-commit" {"nothing": true} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect disabled "commit"
  // From here a dry run would find an edit and turn Commit on: nothing below but a file's change asks it.
  request POST "/__stub/refuse-commit" {"nothing": false} as ada
  // Answers with nothing in them (the hands-on pass: a dry commit polled with each, 400 "nothing to commit").
  clock +1
  clock data
  clock +1
  clock data
  expect disabled "commit"
  request POST "/__stub/event" {"events": [{"event": "builds", "builds": [{"id": "ios-1", "host": "ios", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}, {"event": "scrub", "client": "agent:codex", "scrub": "scrub-7", "reason": "opened"}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"events": [{"event": "build-status", "build": {"id": "ios-1", "host": "ios", "design": "d1", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}}, {"event": "scrub", "client": "agent:codex", "scrub": "scrub-7", "reason": "cancelled"}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect disabled "commit"
  // A file's change reads it again.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect enabled "commit"
  request POST "/__stub/refuse-commit" {"why": ""} as ada
  request POST "/__stub/restart" {} as ada

test "nothing is read for no one before the name; the dry commit is asked only once the run has written since its last commit, a write from before the tool opened included (stage 15 D1.6)"
  // A write from before the tool's name: in the first answer's backlog, so the dry run is asked and Commit turns on.
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +3000
  clock data
  request POST "/__stub/asked" {"dry": false, "nameless": false} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  expect enabled "commit"
  request POST "/__stub/asked" {"dry": true} as ada
  // Committed (by anyone): nothing is asked again until the next write, though a dry run would find an edit here.
  request POST "/__stub/event" {"event": "committed", "client": "agent:codex", "commit": "c0ffee0123456789abcdef0123456789abcdef01", "files": ["app.tamber"], "edits": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect disabled "commit"
  request POST "/__stub/asked" {"dry": false} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect enabled "commit"
  request POST "/__stub/asked" {"dry": true} as ada
  request POST "/__stub/restart" {} as ada

test "a new run that has written nothing asks no dry commit (the hands-on pass's 400 on every load)"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  clock +1
  clock data
  expect disabled "commit"
  request POST "/__stub/asked" {"dry": false, "nameless": false} as ada

test "a name ending in a colon is a client like any other: its dry run is read and Commit turns on"
  type "name" "Ada:"
  tap "save-name"
  clock data
  expect text "person" == "design-tool:Ada:"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": []} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect enabled "commit"
  request POST "/__stub/restart" {} as ada

test "the changeset lists each write since the tool opened, and commit reports what it took or why not"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-changes"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "entry-text-1" == "app.tamber: surface.card · agent:codex"
  request POST "/__stub/refuse-commit" {"why": "it differed from HEAD when the session first wrote it"} as ada
  tap "commit"
  clock data
  expect text "refused-app.tamber" == "app.tamber: it differed from HEAD when the session first wrote it"
  request POST "/__stub/refuse-commit" {"why": ""} as ada
  tap "commit"
  clock data
  expect text "committed-summary" == "Committed c0ffee012345: app.tamber"

test "the changes' long poll by cursor (tamber/1.17): a reply folds as it comes and asks nothing again; one that names a cursor the tool never had is read again once by POST; another run starts again"
  // (A new run first: its changes numbered from 1.)
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/long-poll" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  clock +1
  clock data
  // Hello says 1.17: the poll is the GET by cursor, held by the stub until there is news.
  expect tree has "no-changes"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}]} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == true
  expect text "entry-text-1" == "app.tamber: surface.card · agent:codex"
  // The next reply comes on the same poll, asked again by the host, not the tool.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.page"}]} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == true
  expect text "entry-text-1" == "app.tamber: surface.card · agent:codex"
  expect text "entry-text-2" == "app.tamber: surface.page · agent:codex"
  // A reply that names a cursor the tool never had (one coalesced away): not folded, but read again once by POST,
  // which folds what it missed, then the poll goes on.
  request POST "/__stub/skip-cursor" {} as ada
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "text.primary"}]} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == false
  clock +1
  clock data
  expect text "entry-text-3" == "app.tamber: text.primary · agent:codex"
  expect text "entry-text-2" == "app.tamber: surface.page · agent:codex"
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "text.label"}]} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == true
  expect text "entry-text-4" == "app.tamber: text.label · agent:codex"
  // A reply larger than a stream's default ceiling (1 MiB) comes on it as a read's would.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "text.secondary"}], "pad": 1500000} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == true
  expect text "entry-text-5" == "app.tamber: text.secondary · agent:codex"
  // Another run of the server: the poll held there answers that, which is read again by POST (it starts again), and
  // a new poll goes on in the new run.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/long-poll" {} as ada
  // (Its poll held there answers at once, and its next ask is refused, on a token that run does not know: the
  // tool asks again, within 3 s, by a read, which asks a token.)
  clock +500 real
  clock data
  clock +3000
  clock data
  clock +1
  clock data
  clock +1
  clock data
  // (The new poll's opening reply in, alone, before the next event.)
  clock +200 real
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "text.label"}]} as ada
  clock held changes
  clock +1
  clock data
  expect state changes.stream == true
  expect text "entry-text-1" == "app.tamber: text.label · agent:codex"
  // Nothing new a while: the stub's heartbeat (a 204, here after 300 ms) is a reply `clock held` returns on, and
  // nothing comes of it: the poll goes on, asked again by the host.
  request POST "/__stub/long-poll" {"heartbeat": 300} as ada
  clock held changes
  clock held changes
  clock data
  expect state changes.stream == true
  expect tree missing "entry-text-2"
  // Another name is another client, read again with hello; hello refused (the files unreadable) while the events
  // still read: said, and asked again in 3 s, not a read and a hello each commit.
  request POST "/__stub/refuse-hello" {} as ada
  tap "person"
  type "name" "Grace"
  tap "save-name"
  clock data
  clock +1
  clock data
  expect state changes.ok == false
  expect state changes.stream == false
  request POST "/__stub/restart" {} as ada

test "history reads as edits, and revert holds a proposal"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "toggle-history"
  clock data
  expect text "subject-beef01234567" == "design: a warmer card"
  expect tree has "edit-beef01234567"
  tap "revert-beef01234567"
  clock data
  expect text "reverted" == "Held for review as prop-stub-1: the revert of beef01234567."
  // Ten a page: Older reads past them, Newer back.
  tap "more-history"
  clock data
  expect text "subject-feed01234567" == "design: the first"
  expect tree missing "subject-beef01234567"
  expect tree missing "more-history"
  tap "newer-history"
  clock data
  expect tree has "subject-beef01234567"

test "a restarted server starts the changeset again"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "entry-1"
  expect tree has "changed-by-surface.card"
  // The highlight fades after 3 s.
  clock +3000
  clock data
  expect tree missing "changed-by-surface.card"
  request POST "/__stub/restart" {} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "no-changes"
  // A new run's first change is highlighted, though its number is one an
  // earlier run's faded highlight had passed.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "entry-1"
  expect tree has "changed-by-surface.card"

test "a held proposal's title names what it edits, then what reads it, a param by component.param (stage 15 D4 batch 1 #4)"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/hold" {"proposal": "p9", "client": "agent:d4", "diff": "", "changed": [{"file": "app.tamber", "token": "cards.avatar-default"}, {"file": "app.tamber", "token": "cards.banner"}, {"file": "app.tamber", "token": "@exact/cards/profile-header.contract#ProfileHeader.banner"}], "ops": [{"index": 0, "op": {"op": "set-token", "name": "cards.avatar-default", "value": "#aa00aa"}}]} as ada
  clock +1
  clock data
  expect text "held-title-p9" == "agent:d4 proposes cards.avatar-default (and 2 that read it: cards.banner, ProfileHeader.banner)"
  // A rename edits both its names; a param's add names its component.
  request POST "/__stub/hold" {"proposal": "p10", "client": "agent:d4", "diff": "", "changed": [{"file": "app.tamber", "token": "surface.card"}, {"file": "app.tamber", "token": "surface.panel"}, {"file": "app.tamber", "token": "ink.on-card"}], "ops": [{"index": 0, "op": {"op": "rename-token", "from": "surface.card", "to": "surface.panel"}}]} as ada
  request POST "/__stub/hold" {"proposal": "p11", "client": "agent:d4", "diff": "", "changed": [{"file": "app.tamber", "token": "@app/app.contract#Card.fill"}], "ops": [{"index": 0, "op": {"op": "add-param", "component": "Card", "name": "fill", "value": "surface.card"}}]} as ada
  clock +1
  clock data
  expect text "held-title-p10" == "agent:d4 proposes surface.card, surface.panel (and 1 that read them: ink.on-card)"
  expect text "held-title-p11" == "agent:d4 proposes Card.fill"
  // An operation naming no file edits the app's design, so a same-named reader elsewhere is still a reader; a declaring
  // path is matched whole, so another component's param of the same short name is one too.
  request POST "/__stub/hold" {"proposal": "p12", "client": "agent:d4", "diff": "", "changed": [{"file": "app.tamber", "token": "surface.card"}, {"file": "brand.tamber", "token": "surface.card"}], "ops": [{"index": 0, "op": {"op": "set-token", "name": "surface.card", "value": "#eeeeee"}}]} as ada
  request POST "/__stub/hold" {"proposal": "p13", "client": "agent:d4", "diff": "", "changed": [{"file": "app.tamber", "token": "@a/a.contract#Card.fill"}, {"file": "app.tamber", "token": "@b/b.contract#Card.fill"}], "ops": [{"index": 0, "op": {"op": "set-param", "name": "@a/a.contract#Card.fill", "value": "surface.card"}}]} as ada
  clock +1
  clock data
  expect text "held-title-p12" == "agent:d4 proposes surface.card (and 1 that read it: surface.card)"
  expect text "held-title-p13" == "agent:d4 proposes Card.fill (and 1 that read it: Card.fill)"
  request POST "/__stub/restart" {} as ada

test "held proposals: each with its proposer, diff and items; accepted in part, recomputed, then whole; or dropped"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-proposals"
  request POST "/__stub/hold" {"proposal": "p1", "client": "agent:codex", "diff": "--- app.tamber\n+++ app.tamber\n+  surface.card = #eeeeee\n", "changed": [{"file": "app.tamber", "token": "surface.card"}, {"file": "app.tamber", "token": "ink.on-brand"}], "ops": [{"index": 0, "op": {"op": "set-token", "name": "surface.card", "value": "#eeeeee"}}, {"index": 1, "op": {"op": "set-token", "name": "ink.on-brand", "value": "#fefefe"}}]} as ada
  request POST "/__stub/hold" {"proposal": "p2", "client": "agent:claude", "diff": "", "changed": [], "ops": [{"index": 0, "op": {"op": "remove-token", "name": "tone.deep"}}]} as ada
  clock +1
  clock data
  expect text "held-title-p1" == "agent:codex proposes surface.card, ink.on-brand"
  expect tree has "pick-p1-1"
  expect disabled "accept-picked-p1"
  tap "pick-p1-0"
  tap "accept-picked-p1"
  clock data
  expect text "write-note" == "p1 was recomputed on the files as they are now, as p1-r: review its diff and accept it again."
  clock +1
  clock data
  expect tree missing "held-p1"
  expect text "held-replaces-p1-r" == "Recomputed from p1 on the files as they are now: review it again."
  expect text "held-title-p1-r" == "agent:codex proposes surface.card"
  expect text "held-diff-p1-r" == "--- app.tamber\n+++ app.tamber\n+  surface.card (kept)\n"
  tap "accept-p1-r"
  clock data
  expect text "write-note" == "Accepted p1-r."
  expect text "undo" == "Undo (1)"
  tap "drop-p2"
  clock data
  clock +1
  clock data
  expect tree has "no-proposals"

test "an import's review: tokens in, overrides off until ticked with their notes, every unmapped value, the count; a token's value edited before accepting"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/hold" {"proposal": "imp", "client": "design-tool:Ada", "diff": "", "changed": [], "ops": [{"index": 0, "op": {"op": "add-token", "name": "shadcn.card", "value": "light-dark(#ffffff, #222222)"}}, {"index": 1, "op": {"op": "set-token", "name": "AccentColor", "value": "shadcn.primary"}}], "review": {"importer": "shadcn", "counted": {"source": 3, "mapped": 2, "reported": 1}, "tokens": 1, "unmapped": [{"block": ":root", "name": "--radius", "value": "0.5rem", "why": "kind pending (stage 6): length"}], "offers": [{"role": "AccentColor", "token": "shadcn.primary", "items": [1], "note": null}, {"role": "-exact-label", "token": "shadcn.foreground", "items": [], "note": "tamber-role-axis: it would vary by dark-style"}]}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "held-title-imp" == "design-tool:Ada imports a shadcn theme"
  expect text "held-count-imp" == "3 source values = 2 mapped + 1 reported"
  expect tree has "take-imp-0"
  expect tree has "override-imp-AccentColor"
  expect text "unmapped-imp-0" == "--radius = 0.5rem (:root): kind pending (stage 6): length"
  expect text "offer-note-imp--exact-label" == "tamber-role-axis: it would vary by dark-style"
  expect tree missing "override-imp--exact-label"
  expect state picked == []
  type "mapped-value-imp-0-0" "light-dark(#fafafa, #222222)"
  type "mapped-value-imp-0-0" key "Enter"
  clock data
  expect text "write-note" == "shadcn.card is light-dark(#fafafa, #222222) in the import, held again as held-1 with what was chosen: review it and accept."
  clock +1
  clock data
  expect tree missing "held-imp"
  expect tree has "held-held-1"


test "a 1.17 server edits a held import's value in place (edit-held): no ops sent, the old one replaced in the same step, the agent's still and edited by the person"
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/long-poll" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/hold" {"proposal": "imp", "client": "agent:codex", "diff": "", "changed": [], "ops": [{"index": 0, "op": {"op": "add-token", "name": "shadcn.card", "value": "light-dark(#ffffff, #222222)"}}, {"index": 1, "op": {"op": "set-token", "name": "AccentColor", "value": "shadcn.primary"}}], "review": {"importer": "shadcn", "counted": {"source": 3, "mapped": 2, "reported": 1}, "tokens": 1, "unmapped": [{"block": ":root", "name": "--radius", "value": "0.5rem", "why": "kind pending (stage 6): length"}], "offers": [{"role": "AccentColor", "token": "shadcn.primary", "items": [1], "note": null}, {"role": "-exact-label", "token": "shadcn.foreground", "items": [], "note": "tamber-role-axis: it would vary by dark-style"}]}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "held-title-imp" == "agent:codex imports a shadcn theme"
  expect tree missing "held-edited-imp"
  expect text "held-count-imp" == "3 source values = 2 mapped + 1 reported"
  expect tree has "take-imp-0"
  expect tree has "override-imp-AccentColor"
  expect text "unmapped-imp-0" == "--radius = 0.5rem (:root): kind pending (stage 6): length"
  expect text "offer-note-imp--exact-label" == "tamber-role-axis: it would vary by dark-style"
  expect tree missing "override-imp--exact-label"
  expect state picked == []
  type "mapped-value-imp-0-0" "light-dark(#fafafa, #222222)"
  type "mapped-value-imp-0-0" key "Enter"
  clock data
  expect text "write-note" == "shadcn.card is light-dark(#fafafa, #222222) in the import, held again as edited-1 with what was chosen: review it and accept."
  clock +1
  clock data
  expect tree missing "held-imp"
  expect tree has "held-edited-1"
  expect text "held-title-edited-1" == "agent:codex imports a shadcn theme"
  expect text "held-edited-edited-1" == "Edited by design-tool:Ada"
  expect text "held-replaces-edited-1" == "Held again from imp with your edit, on the files as they are now: review its diff, then accept it."
  request POST "/__stub/restart" {} as ada
test "a role override ticked, then a value edited (third pass #6): the edit keeps it, ticked, and accepting writes both"
