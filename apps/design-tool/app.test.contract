// The design tool against a stand-in Tamber server (stub/tamber-stub.ts, run
// by `test` and `verify`); its drives against a real `tamber serve` are in
// scripts/design-tool.test.mjs.

test "it asks for the person's name once, then shows the server's hello"
  expect tree has "ask-name"
  expect disabled "save-name"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "person" == "design-tool:Ada"
  expect text "app" == "/stub/theme-fixture"
  expect text "protocol" == "tamber/1.1 · IR format 1"
  expect tree has "file-app.tamber"
  expect tree has "file-brand.tamber"
  reload
  expect text "person" == "design-tool:Ada"

test "no server: a clear way to start one, and Try Again"
  fail fetch "http://127.0.0.1:7740"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-server"
  expect text "no-server-message" == "No design server answers at http://127.0.0.1:7740. Start one for your app with `bun exact.mjs tamber tool <app>`, then try again."
  pass fetch "http://127.0.0.1:7740"
  tap "reconnect"
  clock data
  expect tree has "hello"

test "another client's write arrives on the long poll, attributed"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "digest-app.tamber" == "aaaaaaaaaaaa"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "change-1" == "app.tamber · agent:codex"
  expect text "digest-app.tamber" == "cccccccccccc"
  request POST "/__stub/event" {"client": null, "edited": ["brand.tamber"]} as ada
  clock +1
  clock data
  expect text "change-2" == "brand.tamber · changed on disk"

test "a restarted server starts the list again"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:before", "edited": ["app.tamber"]} as ada
  clock +1
  clock data
  expect text "change-1" == "app.tamber · agent:before"
  request POST "/__stub/restart" {} as ada
  clock +1
  clock data
  expect tree missing "change-1"
  request POST "/__stub/event" {"client": "design-tool:Grace", "edited": ["brand.tamber"]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "change-1" == "brand.tamber · design-tool:Grace"

// stub/dials.tamber: dials of each kind a colour follows, with and without
// metadata, two groups, the three priorities (declared out of order), a
// select with an option that is no literal, a range in scientific
// notation, two axes and a residual.
test "the dials panel is drawn from each dial's declared metadata"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "group-Colour"
  expect tree has "dial-accent-color"
  expect tree has "dial-lift-slider"
  expect text "dial-lift-value" == "0.1"
  expect tree has "dial-hue-stepper"
  expect tree has "dial-chroma-slider"
  expect tree missing "dial-shade"
  expect tree missing "dial-warmth"
  tap "more-Tone"
  expect tree has "dial-warmth-slider"
  expect tree has "dial-fine-slider"
  tap "more-Colour"
  expect tree has "dial-paint-select"
  expect text "dial-paint-value" == "#f00"
  expect text "dial-paint-help" == "brand.red is not a value a dial can take (a dial is a literal), so it is not offered."

test "a length dial's slider and stepper write a px length, as a length dial takes"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "group-Space"
  expect text "dial-gap-value" == "8px"
  type "dial-gap-slider" "10"
  expect state editTarget == "gap"
  expect state editValue == "10px"
  type "dial-inset-stepper" "6"
  expect state editTarget == "inset"
  expect state editValue == "6px"

test "the token grid: every mode tuple light and dark, swatches, residuals, what each follows"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect text "column-0-light" == "Light"
  expect text "column-1-light" == "Light · density=compact"
  expect tree missing "column-2-light"
  expect text "column-3-dark" == "Dark · dark-style=dim · density=compact"
  expect text "cell-text-surface.page-2-dark" == "#15202bff"
  expect text "cell-text-surface.page-0-dark" == "#000000ff"
  expect text "cell-text-surface.inset-1-light" == "#eef0f2ff"
  expect text "cell-text-text.system-0-light" == "-exact-secondary-label"
  // A length token (LLP 1121 stage 6): its value, no swatch, no sides.
  expect text "cell-text-space.gap-0-light" == "8px"
  expect text "cell-text-space.gap-0-dark" == "8px"
  // A shadow, previewed in each column's scheme.
  expect tree has "cell-shadow-shadow.card-0-light"
  expect tree has "cell-shadow-shadow.card-0-dark"
  expect text "cell-text-shadow.card-0-light" == "0px 1px 3px light-dark(#000000ff, #ffffffff)"
  expect tree has "cell-fallback-text.system-0-light"
  expect tree missing "cell-fallback-surface.page-0-light"
  expect text "follows-accent.soft" == "follows accent, lift"
  // A declared pair's contrast in each cell, a low one marked.
  expect text "pair-text.primary-0-light-surface.page" == "18.51:1 on surface.page"
  expect text "pair-tone.warm-0-light-surface.page" == "2.78:1 on surface.page"
  // And said with the cell, a low one so named.
  tap "tone.warm, Light, oklch(0.7 0.1 20), 2.78:1 on surface.page, low contrast"
  clock data
  expect text "branch-label" == "tone.warm · default (Light)"
  expect tree missing "follows-surface.page"
  expect tree has "token-group-roles"

test "contrast between two tokens, per column, on the stored values"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "pick-a" "text.primary"
  type "pick-b" "surface.page"
  clock data
  expect text "ratio-0-light" == "18.51:1"
  expect text "ratio-0-dark" == "17.24:1"
  expect text "ratio-2-dark" == "13.54:1"
  type "pick-a" "text.system"
  clock data
  expect text "ratio-0-light" == "3.44:1 (fallback)"
  type "pick-a" "surface.page"
  type "pick-b" "text.system"
  clock data
  expect text "ratio-0-light" == "translucent background"

test "an edit is proposed with its chip and diff before it is written, then undone and redone"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree missing "proposal"
  type "dial-hue-stepper" "210"
  clock data
  expect text "chip" == "Rebuilds"
  expect text "proposal-tokens" == "hue"
  expect disabled "undo"
  tap "apply"
  clock data
  expect tree missing "proposal"
  expect text "undo" == "Undo (1)"
  tap "undo"
  clock data
  expect text "undo" == "Undo (0)"
  expect text "redo" == "Redo (1)"
  tap "redo"
  clock data
  expect text "undo" == "Undo (1)"
  // Another run of the server has none of these inverses: undo and redo
  // start again.
  request POST "/__stub/restart" {} as ada
  clock +1
  clock data
  expect text "undo" == "Undo (0)"
  expect disabled "undo"

test "a cell shows the branch that won for its mode; an expression offers its inputs until pinned"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "cell-surface.page-2-dark"
  clock data
  expect text "branch-label" == "surface.page · dark-style=dim (Dark · dark-style=dim)"
  tap "cell-accent.soft-0-light"
  clock data
  expect text "branch-inputs" == "Follows accent, lift: edit those, or pin a value here."
  expect tree missing "branch-value"
  tap "pin"
  expect text "pinned" == "Pinned here: no longer follows accent, lift."
  expect tree has "branch-value"
  // A cell is named by its column's label and its colour, a fallback said.
  tap "text.system, Light, -exact-secondary-label, fallback #3c3c4399"
  clock data
  expect text "branch-label" == "text.system · default (Light)"
  // A platform role is an input too: overwriting it is a pin.
  expect text "branch-inputs" == "Follows -exact-secondary-label: edit those, or pin a value here."
  expect text "input--exact-secondary-label" == "-exact-secondary-label: a platform colour, set by the system"
  expect tree missing "branch-value"
  // A dial with no control is said, not offered.
  tap "cell-tone.deep-0-light"
  clock data
  expect text "input-shade" == "shade: a dial with no control (control=none)"

test "cancel forgets only this mode, and another file forgets the draft"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "cell-surface.card-1-dark"
  clock data
  tap "only-this-mode"
  expect state editWhen == "dark-style=black density=compact"
  expect text "branch-label" == "surface.card · dark-style=black density=compact (only this mode)"
  tap "cancel-edit"
  type "branch-value" "light-dark(#f1f3f5, #101010)"
  type "branch-value" key "Enter"
  clock settle
  expect state editKind == "set-token"
  expect state editWhen == ""
  type "file" "brand.tamber"
  clock settle
  expect state editKind == ""
  expect state selToken == ""

test "a dial an expression follows opens its control, not a token"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "cell-paint.pick-0-light"
  clock data
  expect tree missing "dial-paint-select"
  tap "input-paint"
  expect tree has "dial-paint-select"
  expect tree missing "branch-error"
  expect text "branch-label" == "paint.pick · default (Light)"

test "another design file is read when chosen, and a refused one shows its error and a retry"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "file" "brand.tamber"
  clock data
  expect text "design-error" == "the stub has no design in brand.tamber"
  expect tree has "reload-design"
  expect tree missing "no-dials"
  expect tree missing "dials"
  expect tree missing "contrast"
  type "file" ""
  clock data
  expect tree missing "design-error"
  expect tree has "dial-accent-color"

test "the changeset lists each write since the tool opened, and commit reports what it took or why not"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-changes"
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "entry-text-1" == "app.tamber: surface.card · agent:codex"
  request POST "/__stub/refuse-commit" {"why": "it differed from HEAD when the session first wrote it"} as ada
  tap "commit"
  clock data
  expect text "refused-app.tamber" == "app.tamber: it differed from HEAD when the session first wrote it"
  request POST "/__stub/refuse-commit" {"why": ""} as ada
  tap "commit"
  clock data
  expect text "committed-summary" == "Committed c0ffee012345: app.tamber"

test "history reads as edits, and revert holds a proposal"
  type "name" "Ada"
  tap "save-name"
  clock data
  tap "toggle-history"
  clock data
  expect text "subject-beef01234567" == "design: a warmer card"
  expect tree has "edit-beef01234567"
  tap "revert-beef01234567"
  clock data
  expect text "reverted" == "Held for review as prop-stub-1: the revert of beef01234567."
  // Ten a page: Older reads past them, Newer back.
  tap "more-history"
  clock data
  expect text "subject-feed01234567" == "design: the first"
  expect tree missing "subject-beef01234567"
  expect tree missing "more-history"
  tap "newer-history"
  clock data
  expect tree has "subject-beef01234567"

test "a restarted server starts the changeset again"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "entry-1"
  expect tree has "changed-by-surface.card"
  // The highlight fades after 3 s.
  clock +3000
  clock data
  expect tree missing "changed-by-surface.card"
  request POST "/__stub/restart" {} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "no-changes"
  // A new run's first change is highlighted, though its number is one an
  // earlier run's faded highlight had passed.
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "entry-1"
  expect tree has "changed-by-surface.card"

test "held proposals: each with its proposer, diff and items; accepted in part, recomputed, then whole; or dropped"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-proposals"
  request POST "/__stub/hold" {"proposal": "p1", "client": "agent:codex", "diff": "--- app.tamber\n+++ app.tamber\n+  surface.card = #eeeeee\n", "changed": [{"file": "app.tamber", "token": "surface.card"}, {"file": "app.tamber", "token": "ink.on-brand"}], "ops": [{"index": 0, "op": {"op": "set-token", "name": "surface.card", "value": "#eeeeee"}}, {"index": 1, "op": {"op": "set-token", "name": "ink.on-brand", "value": "#fefefe"}}]} as ada
  request POST "/__stub/hold" {"proposal": "p2", "client": "agent:claude", "diff": "", "changed": [], "ops": [{"index": 0, "op": {"op": "remove-token", "name": "tone.deep"}}]} as ada
  clock +1
  clock data
  expect text "held-title-p1" == "agent:codex proposes surface.card, ink.on-brand"
  expect tree has "pick-p1-1"
  expect disabled "accept-picked-p1"
  tap "pick-p1-0"
  tap "accept-picked-p1"
  clock data
  expect text "write-note" == "p1 was recomputed on the files as they are now, as p1-r: review its diff and accept it again."
  clock +1
  clock data
  expect tree missing "held-p1"
  expect text "held-replaces-p1-r" == "Recomputed from p1 on the files as they are now: review it again."
  expect text "held-title-p1-r" == "agent:codex proposes surface.card"
  expect text "held-diff-p1-r" == "--- app.tamber\n+++ app.tamber\n+  surface.card (kept)\n"
  tap "accept-p1-r"
  clock data
  expect text "write-note" == "Accepted p1-r."
  expect text "undo" == "Undo (1)"
  tap "drop-p2"
  clock data
  clock +1
  clock data
  expect tree has "no-proposals"

test "an import's review: tokens in, overrides off until ticked with their notes, every unmapped value, the count; a token's value edited before accepting"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/hold" {"proposal": "imp", "client": "design-tool:Ada", "diff": "", "changed": [], "ops": [{"index": 0, "op": {"op": "add-token", "name": "shadcn.card", "value": "light-dark(#ffffff, #222222)"}}, {"index": 1, "op": {"op": "set-token", "name": "AccentColor", "value": "shadcn.primary"}}], "review": {"importer": "shadcn", "counted": {"source": 3, "mapped": 2, "reported": 1}, "tokens": 1, "unmapped": [{"block": ":root", "name": "--radius", "value": "0.5rem", "why": "kind pending (stage 6): length"}], "offers": [{"role": "AccentColor", "token": "shadcn.primary", "items": [1], "note": null}, {"role": "-exact-label", "token": "shadcn.foreground", "items": [], "note": "tamber-role-axis: it would vary by dark-style"}]}} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "held-title-imp" == "design-tool:Ada imports a shadcn theme"
  expect text "held-count-imp" == "3 source values = 2 mapped + 1 reported"
  expect tree has "take-imp-0"
  expect tree has "override-imp-AccentColor"
  expect text "unmapped-imp-0" == "--radius = 0.5rem (:root): kind pending (stage 6): length"
  expect text "offer-note-imp--exact-label" == "tamber-role-axis: it would vary by dark-style"
  expect tree missing "override-imp--exact-label"
  expect state picked == []
  type "mapped-value-imp-0-0" "light-dark(#fafafa, #222222)"
  type "mapped-value-imp-0-0" key "Enter"
  clock data
  expect text "write-note" == "shadcn.card is light-dark(#fafafa, #222222) in the import, held again as held-1 with what was chosen: review it and accept."
  clock +1
  clock data
  expect tree missing "held-imp"
  expect tree has "held-held-1"

test "an undo goes only to the server run that issued it: after a restart it is refused, and undo and redo start again"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "dial-hue-stepper" "210"
  clock data
  tap "apply"
  clock data
  expect text "undo" == "Undo (1)"
  request POST "/__stub/restart" {} as ada
  tap "undo"
  clock data
  expect text "write-error" == "The design server restarted (or another took its port) since this session began: nothing was written, and undo and redo start again."
  expect text "undo" == "Undo (0)"

test "a gap in the long poll is said in Changes"
  request POST "/__stub/restart" {} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  clock data
  request POST "/__stub/event" {"client": "agent:codex", "edited": ["app.tamber"], "changed": [{"file": "app.tamber", "token": "surface.card"}], "files": {"app.tamber": "ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"}} as ada
  request POST "/__stub/miss" {} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "entry-text-1" == "Some changes were missed here (the server keeps the last 256), so this list may be incomplete."

test "the canvas frames the dev loop's page at the size chosen, and says how to start one when there is none"
  request POST "/__stub/page" {"page": null} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-app"
  expect text "no-app-how" == "The canvas shows the app from its dev loop. Start one (bun exact.mjs web, in the app's directory), then open the tool through it: bun exact.mjs tamber tool --via <its URL>. Stop this tool first: it holds the design server, and --via refuses while it runs."
  expect tree missing "canvas-frame"
  expect tree missing "canvas-open"
  request POST "/__stub/page" {"page": "http://127.0.0.1:8765"} as ada
  reload
  clock data
  expect tree has "canvas-frame"
  expect tree has "canvas-open"
  // Framed as localhost: another site than the tool's, its own process;
  // opened in a tab as the dev loop prints it.
  expect state hello.frame == "http://localhost:8765"
  expect state hello.page == "http://127.0.0.1:8765"
  expect tree missing "no-app"
  type "canvas-size" "tablet"
  expect state canvasSize == "tablet"
  reload
  clock data
  expect state canvasSize == "tablet"
  request POST "/__stub/page" {"page": null} as ada

test "the canvas frames only a loopback origin: another host, a path, or the tool's own origin is no page"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/page" {"page": "http://example.com:8765"} as ada
  reload
  clock data
  expect tree has "no-app"
  expect tree missing "canvas-frame"
  request POST "/__stub/page" {"page": "http://127.0.0.1:8765/elsewhere"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://127.0.0.1:70000"} as ada
  reload
  clock data
  expect tree has "no-app"
  expect text "app" == "/stub/theme-fixture"
  request POST "/__stub/page" {"page": "http://127.0.0.1:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://localhost:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://127.0.0.1:07740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://[::1]:7740"} as ada
  reload
  clock data
  expect tree has "no-app"
  request POST "/__stub/page" {"page": "http://[::1]:8765"} as ada
  reload
  clock data
  expect tree has "canvas-frame"
  expect state hello.frame == "http://localhost:8765"
  request POST "/__stub/page" {"page": null} as ada

test "builds: each with its effective facts from its status; a pin on one shows pinning until its status reaches the pin's revision, and only that build moves"
  type "name" "Ada"
  tap "save-name"
  clock data
  expect tree has "no-builds"
  // Pin waits for something to pin, and a root font size it can take.
  expect disabled "pin-apply"
  type "pin-font" "3"
  expect disabled "pin-apply"
  type "pin-font" ""
  expect disabled "pin-preview"
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "status": {"scheme": "dark", "contrast": "more", "mode": {"dark-style": "dim"}, "rootFontSize": 17, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "mac-1", "host": "macos", "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree missing "no-builds"
  expect text "build-status-web-1" == "light · dark-style=black · 16px"
  expect text "build-status-ios-1" == "dark · contrast more · dark-style=dim · 17px"
  expect text "build-status-mac-1" == "Not reported yet: it has not said what it shows."
  expect tree missing "build-pin-web-1"
  type "pin-build" "web-1"
  type "pin-scheme" "dark"
  type "pin-mode-dark-style" "dim"
  tap "pin-apply"
  clock data
  expect text "pin-result" == "Pinned on 1 build(s)."
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark, dark-style=dim"
  expect tree missing "build-pin-ios-1"
  // Its status, at the pin's revision: the effective facts are the
  // build's own (its app chose Black over the pin's Dim).
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 1}, "pin": {"scheme": "dark", "mode": {"dark-style": "dim"}}, "pinRevision": 1}} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinned: dark, dark-style=dim"
  expect text "build-status-web-1" == "dark · dark-style=black · 16px"
  expect text "build-status-ios-1" == "dark · contrast more · dark-style=dim · 17px"
  // Handed back: said until its status reaches the hand-back's revision.
  tap "pin-clear"
  clock data
  expect text "pin-result" == "Pins handed back on 1 build(s)."
  clock +1
  clock data
  expect text "build-pin-web-1" == "handing back"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "black"}, "rootFontSize": 16, "revision": 2}, "pin": null, "pinRevision": 2}} as ada
  clock +1
  clock data
  expect tree missing "build-pin-web-1"
  request POST "/__stub/restart" {} as ada

test "builds: a preview replaces a build's pin; an unsupported pin is named until its status moves on; another client's pin is followed; a refused pin says why; a new run lists its own builds"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  type "pin-build" "web-1"
  type "pin-scheme" "dark"
  type "pin-contrast" "more"
  tap "pin-apply"
  clock data
  request POST "/__stub/event" {"event": "unsupported", "build": "web-1", "what": "pin.contrast", "detail": "the web has no contrast preference to set"} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark, contrast more"
  expect text "build-unsupported-web-1" == "Not applied: pin.contrast: the web has no contrast preference to set"
  // One axis previewed: the pin is that axis alone; the refusal stays
  // until the build's status moves to the preview's revision.
  type "pin-scheme" ""
  type "pin-contrast" ""
  type "pin-mode-dark-style" "dim"
  tap "pin-preview"
  clock data
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: dark-style=dim"
  expect tree has "build-unsupported-web-1"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 2}, "pin": {"mode": {"dark-style": "dim"}}, "pinRevision": 2, "unsupported": null}} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinned: dark-style=dim"
  expect tree missing "build-unsupported-web-1"
  // Another client's pin, announced by the server: followed, and not
  // caught up until the status says so.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 2}, "pin": {"scheme": "light", "rootFontSize": 20}, "pinRevision": 3}]} as ada
  clock +1
  clock data
  expect text "build-pin-web-1" == "pinning: light, 20px"
  // A build gone from the server's list: a pin on it is refused.
  request POST "/__stub/event" {"event": "builds", "builds": []} as ada
  clock +1
  clock data
  expect tree has "no-builds"
  tap "pin-apply"
  clock data
  expect text "pin-result" == "no registered build `web-1`"
  // A new run of the server: its builds, from its hello, at once.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "linux-1", "host": "linux", "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect tree has "build-linux-1"
  expect tree missing "build-web-1"
  request POST "/__stub/restart" {} as ada

test "a scrub, chosen explicitly: each value previews, the files unchanged, and Keep writes the value previewed once, undone in one step"
  request POST "/__stub/live" {"live": true} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  reload
  clock data
  type "dial-hue-stepper" "210"
  clock data
  expect text "chip" == "Live"
  expect tree missing "scrub"
  tap "scrub-start"
  clock data
  expect text "scrub-previewing" == "Previewing: the running copies show this value, and the files are unchanged until Keep."
  expect tree missing "apply"
  type "dial-hue-stepper" "215"
  clock data
  type "dial-hue-stepper" "220"
  clock data
  expect text "undo" == "Undo (0)"
  tap "scrub-keep"
  clock data
  expect tree missing "scrub"
  expect tree missing "proposal"
  expect text "undo" == "Undo (1)"
  clock +1
  clock data
  expect text "change-2" == "app.tamber · design-tool:Ada"
  clock +1
  clock data
  // What was written is the last value previewed (the stub's digest names it).
  expect text "digest-app.tamber" == "220000000000"
  tap "undo"
  clock data
  expect text "undo" == "Undo (0)"
  request POST "/__stub/restart" {} as ada

test "a scrub cancelled writes nothing; one the server ends says why, and the next starts afresh; a refused Keep names who moved the file"
  request POST "/__stub/live" {"live": true} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  reload
  clock data
  type "dial-hue-stepper" "210"
  clock data
  tap "scrub-start"
  clock data
  type "dial-hue-stepper" "215"
  clock data
  tap "scrub-cancel"
  clock data
  expect text "write-note" == "Cancelled: nothing was written, and the running copies have the committed value back."
  expect text "undo" == "Undo (0)"
  expect tree has "apply"
  // Another write came first: the server ended it.
  tap "scrub-start"
  clock data
  expect tree has "scrub-previewing"
  request POST "/__stub/end-scrub" {"reason": "competing write"} as ada
  clock +1
  clock data
  expect text "scrub-note" == "The scrub ended: another write came first. Nothing was written, and the running copies have the committed value back."
  expect tree missing "scrub"
  // The next one is not ended by the last one's end.
  tap "scrub-start"
  clock data
  clock +1
  clock data
  expect tree has "scrub-previewing"
  expect tree missing "scrub-note"
  // A value refused, then back to the one previewed: Keep is fine again.
  type "dial-hue-stepper" ""
  clock data
  expect text "scrub-error" == "Give it a value: an empty one is not previewed."
  expect disabled "scrub-keep"
  type "dial-hue-stepper" "210"
  clock data
  expect tree missing "scrub-error"
  // A file moved since it opened: Keep writes nothing, and says who.
  request POST "/__stub/refuse-release" {"by": "agent:codex"} as ada
  tap "scrub-keep"
  clock data
  expect text "write-error" == "Not written: app.tamber was changed by agent:codex since the scrub opened; the running copies have the committed value back."
  expect text "undo" == "Undo (0)"
  request POST "/__stub/restart" {} as ada

test "a scrub ends with its edit: another cell chosen cancels it, Cancel while it opens leaves none open, and a new server run ends it"
  request POST "/__stub/live" {"live": true} as ada
  type "name" "Ada"
  tap "save-name"
  clock data
  reload
  clock data
  type "dial-hue-stepper" "210"
  clock data
  tap "scrub-start"
  clock data
  expect tree has "scrub-previewing"
  tap "cell-surface.page-0-light"
  clock data
  expect text "write-note" == "Cancelled: nothing was written, and the running copies have the committed value back."
  expect tree missing "scrub"
  // Another control moved while one is open: that scrub ends first, and
  // nothing is written for it.
  type "dial-hue-stepper" "212"
  clock data
  tap "scrub-start"
  clock data
  tap "more-Tone"
  type "dial-fine-slider" "0.004"
  clock data
  expect text "write-note" == "Cancelled: nothing was written, and the running copies have the committed value back."
  expect text "undo" == "Undo (0)"
  // Cancelled before the server answered its opening: Scrub live waits
  // until the server has let that one go, so the next opens as its own and
  // the old one's cancel never ends it.
  request POST "/__stub/slow-preview" {"ms": 1500} as ada
  type "dial-hue-stepper" "215"
  clock data
  tap "scrub-start"
  tap "scrub-cancel"
  clock data
  expect tree missing "scrub"
  request POST "/__stub/slow-preview" {"ms": 0} as ada
  tap "scrub-start"
  clock data
  clock +1
  clock data
  expect tree has "scrub-previewing"
  expect tree missing "scrub-note"
  // Events missed: an end among them could be lost, so it ends here.
  request POST "/__stub/miss" {} as ada
  clock +1
  clock data
  expect text "scrub-note" == "The scrub was ended: some changes were missed, so its state was not known. Nothing was written."
  expect tree missing "scrub"
  tap "scrub-start"
  clock data
  expect tree has "scrub-previewing"
  // A new run of the server: the scrub ended there.
  request POST "/__stub/restart" {} as ada
  request POST "/__stub/live" {"live": true} as ada
  clock +1
  clock data
  clock +1
  clock data
  expect text "scrub-note" == "The scrub ended: the design server stopped. Nothing was written, and the running copies have the committed value back."
  expect tree missing "scrub"
  // The new run's first scrub (its ids start again) opens and stays.
  reload
  clock data
  type "dial-hue-stepper" "214"
  clock data
  tap "scrub-start"
  clock data
  clock +1
  clock data
  expect tree has "scrub-previewing"
  request POST "/__stub/restart" {} as ada

test "no scrub for an edit that rebuilds, nor without a dev loop: said before the gesture"
  type "name" "Ada"
  tap "save-name"
  clock data
  type "dial-hue-stepper" "210"
  clock data
  expect disabled "scrub-start"
  expect text "scrub-unavailable" == "Scrubbing previews on the running copies: open the tool through a dev loop (tamber tool --via)."
  request POST "/__stub/live" {"live": true} as ada
  reload
  clock data
  tap "more-Tone"
  type "dial-warmth-slider" "0.5"
  clock data
  expect text "chip" == "Rebuilds"
  expect disabled "scrub-start"
  expect text "scrub-unavailable" == "This edit rebuilds the app, so it can't be scrubbed: Apply writes it."
  request POST "/__stub/restart" {} as ada

test "the pin form offers the app's own axes whichever file is open, and retyping the name keeps the tool's client while it is typed"
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  expect tree has "pin-mode-dark-style"
  type "file" "brand.tamber"
  clock data
  expect tree has "pin-mode-dark-style"
  tap "person"
  expect tree has "rename-note"
  expect state person == "Ada"
  type "name" "Grace"
  tap "save-name"
  expect state person == "Grace"
  expect tree missing "rename-note"

test "the inspector: inspect mode on the builds, a selection's source and rows, the token rung on the branch that won, a link for an inherited colour, a style's row read-only, and the token's impact"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "ios-1", "host": "ios", "capabilities": ["pin"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect tree has "no-selection"
  tap "inspect-toggle"
  clock data
  expect text "inspect-result" == "Inspecting on 1 build(s): click a view in one. ios-1 cannot inspect."
  // The toggle follows the server's event for its own command.
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/card.contract", "line": 4, "col": 7, "end_col": 11, "component": "Card", "chain": [{"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App"}]}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}, {"name": "text_color", "value": "#f7f9f9ff", "source": "inherited", "from": 1, "origin": null, "editable": {"rung": null, "reason": "inherited from #1: the token is that node's to edit", "link": "text.primary"}}, {"name": "padding", "value": "12px", "source": "authored", "origin": "class:Panel", "editable": {"rung": null, "reason": "a style's row (Panel): comes with template editing (T5)"}}]} as ada
  clock +1
  clock data
  expect text "selection-source" == "card.contract:4 · Card"
  expect text "selection-build" == "web-1 · Dark · dark-style=dim"
  expect tree missing "selection-stale"
  expect text "selrow-source-background-color" == "set here (own)"
  expect text "selrow-edit-background-color" == "Edit surface.card"
  expect text "selrow-source-color" == "inherited from #1"
  expect text "selrow-link-color" == "Open text.primary"
  expect text "selrow-reason-color" == "inherited from #1: the token is that node's to edit"
  expect tree missing "selrow-edit-padding"
  expect text "selrow-reason-padding" == "a style's row (Panel): comes with template editing (T5)"
  // The token rung: its cell in the app's design, on the branch the
  // selected copy shows (Dark, Dim), and its impact.
  tap "selrow-edit-background-color"
  clock data
  expect state file == ""
  expect state selToken == "surface.card"
  expect state selColumn == "2-dark"
  clock +1
  clock data
  expect text "impact-count" == "surface.card: read at 2 source site(s), statically (not a count of mounted copies)"
  tap "impact-outline"
  clock data
  expect text "impact-outlined" == "Sent surface.card's 2 site(s) to web-1; a build in inspect mode on that plan outlines them."
  // The page leaves inspect mode itself: the selection is no longer
  // current (no edit offered), and the tool no longer inspects.
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"]}, {"event": "selected", "build": "web-1", "selected": null}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its page left inspect mode. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  expect tree missing "selrow-link-color"
  expect text "inspect-toggle" == "Inspect"
  request POST "/__stub/restart" {} as ada

test "the inspector places a light copy on the light column, and a build whose scheme is not known, or that went, offers no edit"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}, {"id": "web-2", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "compact"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  // Light: the under-dark axis is its default there; density is compact.
  expect text "selection-build" == "web-1 · Light · density=compact"
  tap "selrow-edit-background-color"
  clock data
  expect state selColumn == "1-light"
  // A build that has not reported: its scheme is not known, no edit.
  request POST "/__stub/event" {"event": "selection", "build": "web-2", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the scheme it is shown in is not known. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // The build goes: no longer current.
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build is gone. Select it again to edit from here."
  request POST "/__stub/restart" {} as ada

test "a selection stays stale once its build reloads, its mode moves or it runs a new plan, even back to the same facts; a trimmed report without its scheme offers no edit"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  expect text "selrow-source-color-scheme" == "initial"
  expect text "selrow-source-border-top-left-radius" == "set here (own)"
  // A reload: the build registers again (no status), then reports the same
  // facts, both in one answer. Another document: still not current.
  request POST "/__stub/event" {"events": [{"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": null, "pin": null, "pinRevision": 0}]}, {"event": "build-status", "build": {"id": "web-1", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // Selected again: current. The app moves its mode: not current.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"density": "compact"}, "rootFontSize": 16, "revision": 0}}} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  // Selected again; the build runs a new plan, its status the same: not current.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"event": "build-status", "build": {"id": "web-1", "plan": "g2", "status": {"scheme": "light", "contrast": "no-preference", "mode": {"density": "compact"}, "rootFontSize": 16, "revision": 0}}} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its build has moved on (a reload, a pin, a mode, a new status). Select it again to edit from here."
  // A report trimmed of its `color-scheme` row: the scheme is not known.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": true, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: the scheme it is shown in is not known. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // A copy whose modes the design has no column for: not placed, no edit.
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "spacious"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "border_radius_top_left", "value": "8px", "source": "authored", "origin": "own", "editable": {"rung": null, "reason": "a length, not a token"}}, {"name": "color_scheme", "value": "normal", "source": "initial", "origin": null, "editable": {"rung": null, "reason": "no token"}}, {"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selection-stale" == "No longer current: its modes are not a column of the app's design. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  request POST "/__stub/restart" {} as ada

test "a cell the inspector opens after the design's axes were reordered is refused, not put on another tuple"
  type "name" "Ada"
  tap "save-name"
  clock data
  clock +1
  type "file" "brand.tamber"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "dark", "contrast": "no-preference", "mode": {"dark-style": "dim"}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "dim", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#1e2732ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "dark-style=dim", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": "dark-style=dim"}}]} as ada
  clock +1
  clock data
  expect text "selection-build" == "web-1 · Dark · dark-style=dim"
  // The axes move before the app's design is read again: the column the
  // selection names is another tuple there.
  request POST "/__stub/reverse-axes" {} as ada
  tap "selrow-edit-background-color"
  clock data
  clock +1
  clock data
  expect state file == ""
  expect text "branch-moved" == "The design's axes changed since that copy was selected, so this column is another branch now: select it again."
  expect tree missing "branch"
  request POST "/__stub/restart" {} as ada

test "the inspect toggle follows the server's inspect events: another client taking the build over, and this client's lapse"
  type "name" "Ada"
  tap "save-name"
  clock data
  request POST "/__stub/event" {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]} as ada
  clock +1
  clock data
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  // Another client takes the build: this one no longer inspects there.
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"], "to": "agent"}, {"event": "inspect", "client": "agent", "on": true, "builds": ["web-1"]}, {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "inspector": "agent", "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  // On again, then its presence lapses at the server: off, said by the event.
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  request POST "/__stub/event" {"event": "selection", "build": "web-1", "node": 7, "site": 3, "instance": [], "tuple": {"dark-style": "black", "density": "regular"}, "trimmed": false, "readOnly": null, "source": {"file": "/stub/app.contract", "line": 12, "col": 5, "end_col": 9, "component": "App", "chain": []}, "rows": [{"name": "background_color", "value": "#f1f3f5ff", "source": "authored", "origin": "own", "token": {"names": ["surface.card"], "text": "surface.card", "modes": "", "implied": false}, "editable": {"rung": "token", "token": "surface.card", "modes": ""}}]} as ada
  clock +1
  clock data
  expect text "selrow-edit-background-color" == "Edit surface.card"
  request POST "/__stub/event" {"events": [{"event": "inspect", "client": "design-tool:Ada", "on": false, "builds": ["web-1"], "to": null}, {"event": "builds", "builds": [{"id": "web-1", "host": "web", "capabilities": ["pin", "inspect"], "inspector": null, "status": {"scheme": "light", "contrast": "no-preference", "mode": {}, "rootFontSize": 16, "revision": 0}, "pin": null, "pinRevision": 0}]}]} as ada
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  expect text "selection-stale" == "No longer current: inspect mode was turned off there. Select it again to edit from here."
  expect tree missing "selrow-edit-background-color"
  // Another name is another client: this one inspects nothing yet.
  tap "inspect-toggle"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Stop inspecting"
  tap "person"
  type "name" "Grace"
  tap "save-name"
  clock data
  clock +1
  clock data
  expect text "inspect-toggle" == "Inspect"
  request POST "/__stub/restart" {} as ada
