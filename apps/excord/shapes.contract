// What the data module answers the transcript (Excord LLP 0001 §4.2). A
// message's Markdown arrives parsed and flattened (`render.ts`): Contract
// components cannot recurse, so a message is a flat list of blocks and a block
// a flat list of runs.

// One styled run of a paragraph. `kind` is "text", "code", "link", "user",
// "channel", "role", "everyone", "emoji", "time" or "edited". A "time" run's
// `format` is a `time` element's format and `at` its instant; an "emoji" run's
// `href` is the custom emoji's image. `spoiler` names the spoiler the run is
// inside ("" for none), unique within its message.
shape Run
  id: string
  kind: string
  text: string
  bold: bool
  italic: bool
  underline: bool
  strike: bool
  spoiler: string
  href: string
  at: number
  format: string
  self: bool

// A block: "paragraph", "heading" (`level` 1–3), "subtext", "code" (`text`,
// `lang`), "item" (a list item's first paragraph: `marker`, `level` its
// nesting from 0) or "emoji" (a jumbo message's custom emoji, one per run).
// `quote` marks a block inside a block quote.
shape Block
  id: string
  kind: string
  level: number
  marker: string
  quote: bool
  lang: string
  text: string
  runs: Run[]

// An image: an attachment, an embed's image or thumbnail. `width` and
// `height` are what Discord declared (0 when it declared none); `fitWidth`
// and `fitHeight` the box the transcript reserves, scaled to fit 320 points.
shape Media
  id: string
  src: string
  width: number
  height: number
  fitWidth: number
  fitHeight: number
  alt: string
  spoiler: bool

shape Embed
  id: string
  color: string
  provider: string
  author: string
  title: string
  url: string
  description: Block[]
  image: Media[]
  thumbnail: Media[]

shape Reaction
  id: string
  emoji: string
  src: string
  name: string
  count: number
  me: bool

// The message a reply answers; `missing` when it was deleted.
shape ReplyRef
  id: string
  author: string
  tint: number
  preview: string
  missing: bool

// One transcript row. `key` is the row's identity for its whole life: the
// nonce of a message sent from here, else its id, so a confirmed send keeps
// its row. `grouped` says it continues the previous message's group (same
// author within seven minutes, Discord's rule); the view also breaks a group
// at a day change, which it decides from `prevAt` in the reader's time zone.
// `state` is "sent", "pending" or "failed".
shape Message
  key: string
  id: string
  authorId: string
  author: string
  tint: number
  initials: string
  bot: bool
  at: number
  prevAt: number
  grouped: bool
  edited: bool
  mine: bool
  state: string
  mentionsMe: bool
  jumbo: bool
  system: string
  plain: string
  blocks: Block[]
  media: Media[]
  embeds: Embed[]
  reactions: Reaction[]
  reply: ReplyRef[]

// One contiguous run of a channel's history, at most 200 rows. `hasBefore`
// and `hasAfter` say whether older or newer history exists outside it; a
// window without `hasAfter` ends at the channel's newest message. `pin` is
// the anchor that answers this same window while no message arrives.
shape Window
  channel: string
  anchor: string
  rows: Message[]
  hasBefore: bool
  hasAfter: bool
  firstId: string
  lastId: string
  pin: string

// What the gateway knows about one channel. `version` moves whenever its
// history changes; `total` counts its messages; `firstUnread` is the oldest
// unread message ("" when read to the end); `typing` names who is typing; `pending`
// counts sends not yet confirmed.
shape Channel
  id: string
  name: string
  topic: string
  version: number
  total: number
  unread: number
  mentions: number
  firstUnread: string
  firstUnreadAt: number
  typing: string
  pending: number

shape Gateway
  state: string
  me: string
  channels: Channel[]

shape Ack
  ok: bool
  error: string
