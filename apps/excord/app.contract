// Excord (apps/excord/llp/0001): a Discord client. Stage 1 is the transcript and
// its composer on iOS, against the fixture server (§3, §4.2, §4.4).
//
// The data seam is §4.2's: `gatewayState` is the gateway's stream and its small
// snapshot (a version for the lists and one per channel); each list is a
// resource taking its version, and the transcript is one resource, `loadWindow`,
// answering one contiguous run of at most 200 messages around `anchor` ("" is
// the live tail).
// Paging moves the anchor a page ahead of the reader (`scrolled`, with
// `reachstart` and `reachend` behind it); a jump replaces the window and places
// its target with `scrollIntoView`.

use Run, Block, Media, Embed, Reaction, ReplyRef, Message, Window, Channel, Guild, Category, Gateway, Session, Ack, Sent, EditTarget, Suggestion, EmojiChoice, SwitchTarget, RoleTag, Profile, RailEntry, MemberRow, Pasted, MediaPreferences, Place, Viewport, Page, noAnswers, channelOf, connected, draftOf, withDraft, placeOf, piece, keyOf, Time, typingDot from "./shapes.contract"
use MessageLanguage, Translated, withTranslated, pendingLineOf from "./translate.contract"
use translatorAvailability, createTranslator, translate, createLanguageDetector, TranslatorAvailability, TranslatorInfo, TranslatorResult, LanguageDetectorInfo from "@exact/translation"
use AgeGate from "./agegate.contract"
use MessageRow from "./transcript.contract"
use DirectoryList from "./directory.contract"
use ImageViewer, photoFit, photoZoom, photoClamp from "./viewer.contract"
use MemberList, ProfileCard from "./members.contract"
use Badge from "exact:content"
use authenticate, localAuthStatus, LocalAuthentication, LocalAuthStatus from "@exact/local-auth"
use requestAgeRange, AgeRange from "@exact/age-range"

routes nav
  home "/"
    channel "/c/:channel"

component Excord
  state now = 0
  state open = ""
  state anchor = ""
  state since = ""
  state away = false
  state endGap = 0
  state settling = false
  state topKey = ""
  state topOffset = 0
  state historyStart = false
  state places: Place[] = []
  state drafts: string[] = [] persist
  // The server whose channels the list shows, "@me" for the direct messages.
  state server = "" persist
  state directoryFor = ""
  // The channel last opened in each server ("@me" for the direct messages), as `server\tchannel`.
  state lastChannels: string[] = [] persist
  state tokenDraft = ""
  state replyTo = ""
  state replyName = ""
  // Whether a reply pings its original's author (Discord's @ ON), as Discord's default has it.
  state replyMention = true
  state editing = ""
  state editText = ""
  state editRevision = 0
  state editLookup = false
  state editLookupError = ""
  state editPageAsked = ""
  state editRequest = 0
  state editPageRequest = 0
  state editError = ""
  state deleteError = ""
  state stash = ""
  state stashReplyTo = ""
  state stashReplyName = ""
  state stashReplyMention = true
  state savingChannel = ""
  state savingId = ""
  state savingRevision = 0
  state savingText = ""
  state savingStash = ""
  state savingReplyTo = ""
  state savingReplyName = ""
  state savingReplyMention = true
  state unreadBar = false
  state unreadLabel = ""
  state composerFocused = false
  state ackTries = 0
  state pageTries = 0
  state pageAsked = ""
  state pageAsks = 0
  state baseArrived = 0
  state followed = 0
  state highlight = ""
  state target = ""
  state targetBlock = "center"
  state restoreOffset = 0
  state jumpFromAnchor = ""
  state jumpFromKey = ""
  state jumpFromOffset = 0
  state revealed: string[] = []
  // A poll's answers chosen before its vote, as `${message id}:${answer id}`.
  state pollPicks: string[] = []
  // The picture the viewer shows full screen ("" while it is closed).
  state viewing = ""
  state viewingAlt = ""
  state viewingWidth = 0
  state viewingHeight = 0
  state viewPanX = 0
  state viewPanY = 0
  state viewZoom = 1
  state viewBoxWidth = 0
  state viewBoxHeight = 0
  state viewPortWidth = 0
  state viewPortHeight = 0
  state aimed = ""
  state aimedId = ""
  state aimedText = ""
  state aimedMine = false
  state aimedAuthor = ""
  // A forward is deleted, never edited, as in Discord.
  state aimedForward = false
  // The row the pointer is over, and the row that shows its hover. While the list scrolls the hover is
  // hidden, and rows sliding under a still pointer move only `pointerKey`: each change was a commit that
  // built or dropped a row's toolbar, many a second in a fling. The scroll's end shows it again, or 200 ms
  // without a scroll event where none comes (Windows sends no `scrollend`; a list replaced mid-scroll
  // drops its own).
  state pointerKey = ""
  state hoverKey = ""
  state scrolling = false
  state scrollTick = 0
  state composing = false
  // Files picked for the next send: their copies under app:/tmp/picked.
  state picked: Picked[] = []
  // Why a picked file or a pasted picture could not be added ("" when every one was).
  state attachError = ""
  state swipeKey = ""
  state swipeX = 0
  state dragging = false
  state live = false
  state slow = false
  state lagAnchor = ""
  state lagVersion = 0
  // Lock Excord (LLP 1133.010 §9): the launch asks for the check once; every
  // return covers the transcript until the person passes it again
  // (`lockedOut`), the return task skipping its own first run (`launched`).
  state launchAsked = false
  state launched = false
  state lockedOut = false
  resource mediaPreferences = exactViewport() as shape MediaPreferences
  resource time = exactTime() as shape Time
  resource page = exactPage() as shape Page
  // Translate: the aimed message's language, the pair to the person's, and each translation for the session.
  state translated: Translated[] = []
  state translating = ""
  state translatingText = ""
  state translatingFrom = ""
  resource lang = messageLanguage(aimedText) as shape MessageLanguage else empty()
  derive myLanguage = piece(time.locale.split("-"), 0)
  resource pair = translatorAvailability(sourceLanguage=lang.language, targetLanguage=myLanguage) as shape TranslatorAvailability else empty()
  mutation translator as shape TranslatorInfo then runTranslation
  mutation translation as shape TranslatorResult then landTranslation
  mutation detectorMade as shape LanguageDetectorInfo refreshes lang
  derive canTranslate = lang.detector == "downloadable" or (lang.language != "" and lang.language != myLanguage and pair.availability != "unavailable")
  derive pendingLine = translating == "" ? "" : pendingLineOf(match failure(translator) { case some(f) => f.code, case none => match failure(translation) { case some(f) => f.code, case none => "" } }, translatingFrom, pair)
  derive translations = pendingLine == "" ? translated : withTranslated(translated, Translated(id=translating, text="", line=pendingLine))
  resource viewport = exactViewport() as shape Viewport
  // The gateway opens once the kept credentials are read, which only `session` reads, so
  // keeping a new identify or token re-asks it and not the socket. The launch's epoch makes
  // the session clock real from its first step.
  resource session = loadSession() as shape Session else empty()
  resource lock = localAuthStatus() as shape LocalAuthStatus else empty(available=false)
  resource gateway = gatewayState(session.ready) with time.epochAtZero as shape Gateway else empty(state="connecting")
  // A large frame (a login's READY) waits for `digest`, which works through it a slice a turn and
  // answers a newer snapshot than the stream's last; the stream's next one is newer again.
  mutation digested as shape Gateway queue
  derive gw = match digested { case some(d) => (d.seq > gateway.seq ? d : gateway), case none => gateway }
  resource guilds = loadGuilds(gw.sidebar) as shape Guild[] else empty()
  resource rail = loadRail(gw.sidebar) as shape RailEntry[] else empty()
  resource members = loadMembers(open, gw.members) as shape MemberRow[] else empty()
  derive membersBeside = showMembers and paneWidth >= 900 and chan.guild != ""
  // The rail's open folders, kept across launches.
  state openFolders: string[] = [] persist
  derive dmsShown = server == "@me" or guilds.length == 0
  // What covers the screens: the image viewer, or the lock while the launch or a return waits on it.
  // Nothing under it takes a press, a key or a shortcut.
  derive locked = session.locked or lockedOut
  derive covered = viewing != "" or locked
  derive dmUnread = dms.map(c => c.unread > 0).includes(true)
  // The list shows the most recent conversations, a hundred more at each ask, and any older one that is
  // unread, mentions the reader or is open: a platform list builds every row, and a large account's
  // thousands took seconds to open. The switcher finds any of them.
  state dmsShownCount = 100
  derive recentDms = dms.slice(0, dmsShownCount).concat(dms.slice(dmsShownCount).filter(c => c.unread > 0 or c.mentions > 0 or c.id == open))
  derive dmMentions = sum(dms.map(c => c.mentions))
  // The browser tab's title, as Discord's: what mentions the reader, then the channel on screen; locked,
  // the app's name alone.
  derive mentionTotal = dmMentions + sum(guilds.map(g => g.mentions))
  derive pageTitle = locked ? "Excord" : `${mentionTotal > 0 ? `(${mentionTotal}) ` : guilds.map(g => g.unread).includes(true) or dmUnread ? "• " : ""}Excord${reading and chan.name != "" ? ` | ${chan.guild != "" ? "#" : "@"}${chan.name}` : ""}`
  derive guild = dmsShown ? Guild(id="", name="", icon="", acronym="", unread=false, mentions=0) : match first(guilds.filter(g => g.id == server).concat(guilds)) { case some(g) => g, case none => Guild(id="", name="", icon="", acronym="", unread=false, mentions=0) }
  resource categories = loadChannels(guild.id, gw.sidebar) as shape Category[] else empty()
  // The server's channels, never another's: a load that failed keeps the last server's answer.
  derive here = categories.filter(g => g.channels.map(c => c.guild).includes(guild.id))
  derive channels = here.map(g => g.channels).flat()
  // A browser window wide enough to show the channel beside the list (the web's split, from 900
  // points) opens the server's last channel, or its first, as Discord's web app does. The Mac's split
  // gives the list its own column's width, and Windows and Android push, so they show the list first.
  derive wide = viewport.displayMode == "browser" and viewport.width >= 900
  derive listed = dmsShown ? dms : channels
  derive remembered = draftOf(lastChannels, dmsShown ? "@me" : guild.id)
  derive resumeChannel = listed.map(c => c.id).includes(remembered) ? remembered : match first(listed) { case some(c) => c.id, case none => "" }
  resource dms = loadDms(gw.sidebar) as shape Channel[] else empty()
  // Keep the directory visible through refreshes and reconnects. A new account waits
  // for its complete READY (large accounts arrive in slices) and the lists it starts.
  derive directoryLoaded = gw.me != "" and directoryFor == gw.me
  derive directoryFailed = failed(guilds) or failed(categories) or failed(dms)
  // The snapshot carries the versions of the channel on screen; until it names the
  // one just opened, the lists' version stands in, which moves with its changes too.
  derive chanVersion = gw.channel == open ? gw.version : gw.sidebar
  derive histVersion = gw.channel == open ? gw.history : gw.sidebar
  resource chan = loadChannel(open, chanVersion) as shape Channel else empty()
  // Slow history (the fixture's): the window is asked with the anchor and version as of
  // the last pump, every 150 ms of the test clock, as a real store's page takes a while.
  // The delay is in the request because a data module has no clock, and a native
  // host refuses an answer that waits on a promise another call settles.
  derive askAnchor = slow ? lagAnchor : anchor
  derive askVersion = slow ? lagVersion : histVersion
  resource win = loadWindow(open, askAnchor, askVersion, since) as shape Window else empty()
  resource editTarget = loadEditTarget(editLookup ? open : "", editLookup ? histVersion : 0, editLookup ? editRequest : 0) as shape EditTarget else empty()
  mutation editPaged as shape Ack refreshes editTarget then afterEditPage
  // A send shows at once (`echoed`, the local row), then posts (`sent`).
  mutation echoed as shape Sent queue refreshes win, chan then postEchoed
  mutation sent as shape Ack queue refreshes win, chan, categories
  mutation changed as shape Ack queue refreshes win, chan, categories, dms, guilds, rail
  mutation deleted as shape Ack queue refreshes win, chan, categories, dms, guilds, rail then afterDelete
  mutation edited as shape Ack refreshes win then afterEdit
  mutation pastedPictures as shape Pasted queue then takePasted
  // An ack changes the read state, not the history the window shows.
  mutation acked as shape Ack queue refreshes chan, categories, dms, guilds, rail then afterAck
  // The page the window names (`win.need`), one at a time.
  mutation paged as shape Ack queue refreshes win, chan then afterPage
  mutation beat as shape Ack
  // The clock moved on and the gateway asked again: a backoff's retry.
  mutation redialed as shape Ack refreshes gateway
  // An IDENTIFY goes out only once its record is kept (`recorded`), else the gateway stops.
  mutation recorded as shape Ack then identifyNow
  mutation identified as shape Ack
  mutation typed as shape Ack
  mutation joined as shape Ack
  // A token kept re-asks the session and the gateway, which then connects with it.
  mutation signedIn as shape Ack refreshes session, gateway then afterSignIn
  mutation signedOut as shape Ack refreshes session, gateway, guilds, rail, categories, dms, chan, win
  // The launch's unlock reads the token behind the check; a return's check
  // gates the screen, the token being in memory already. Turning the lock on
  // asks first, as WhatsApp does, then keeps the token locked.
  mutation unlocked as shape Ack refreshes session
  mutation returned as shape LocalAuthentication then afterReturn
  mutation lockChecked as shape LocalAuthentication then lockAfterCheck
  mutation lockSet as shape Ack refreshes session
  mutation age as shape AgeRange
  state ageGate = ""
  derive rows = win.channel == open ? win.rows : []
  derive keys = rows.map(r => r.key)
  derive lastKey = match rows.at(-1) { case some(r) => r.key, case none => "" }
  derive dividerKey = match first(rows.filter(r => r.isNew)) { case some(r) => r.key, case none => "" }
  // The window answers the reader's present request (a page or a jump has
  // landed). A window's pin asks for the same rows, so pinning it keeps it current.
  // A window still lacking the page that holds its anchor (or its tail) answers nothing yet.
  derive current = win.channel == open and (win.anchor == anchor or win.pin == anchor) and win.need != "around" and win.need != "latest"
  derive pageKey = `${win.channel}/${win.need}/${win.cursor}`
  // Asks count as well as failures: a page whose answer the host refused (a window it could not read)
  // runs no `afterPage`, or leaves the window as it was, and would otherwise be asked again for good.
  derive historyFailed = win.channel == open and win.need != "" and pageAsked == pageKey and (pageTries >= 3 or (pageAsks >= 3 and not pending(paged)))
  derive historyLoading = pending(win) or win.channel != open or win.need != ""
  // The transcript is on screen, not the channel list or a picture over it.
  derive reading = top(nav).name == "channel" and viewing == ""
  derive draft = editing == "" ? draftOf(drafts, open) : editText
  // A name being written (`@ada`, `#gen`, `:fer`) and what it could be.
  resource suggestions = suggest(open, draft) as shape Suggestion[] else empty()
  // The emoji picker's search and what it finds; nothing is asked while it is closed. It reacts to the
  // aimed message, or (`pickingForDraft`) puts the emoji in the composer where the caret is.
  state picking = false
  state pickingForDraft = false
  // The composer's selection, as its last `selectionchange` left it (-1 before any): where a picked emoji goes.
  state caretFrom = -1
  state caretTo = -1
  state pickerQuery = ""
  resource choices = emojiChoices(picking ? open : "", pickerQuery) as shape EmojiChoice[] else empty()
  // The quick switcher (⌘K): its search and matches, asked only while it shows.
  state switching = false
  state switchQuery = ""
  resource targets = switchTargets(switchQuery, switching) as shape SwitchTarget[] else empty()
  // The person whose card shows, and the message it was opened from.
  state profileUser = ""
  state profileMessage = ""
  state profileChannel = ""
  // A channel a link or mention opens once its server's list holds it, and the message to show there.
  state pendingOpen = ""
  // The member list: shown beside a channel when there is room for it (`paneWidth`), else in a sheet.
  state showMembers = true persist
  state paneWidth = 0
  state pendingMessage = ""
  resource profile = userProfile(profileUser != "" ? profileChannel : "", profileUser, profileMessage) as shape Profile else empty()
  derive signInError = match signedIn { case some(r) => (r.ok ? "" : r.error), case none => "" }
  // The fixture signs itself in, unless the platform dropped its locked token (Lock Excord).
  derive droppedLock = match unlocked { case some(r) => r.error == "Sign in again", case none => false }
  derive signedOutNow = gw.state == "signed-out" and (not gw.fixture or droppedLock)
  derive editFailure = match edited { case some(r) => (r.ok ? "" : r.error), case none => "" }
  derive deleteFailure = match deleted { case some(r) => (r.ok ? "" : r.error), case none => "" }
  derive clock = time.epochAtZero + now
  derive newCount = max(0, chan.arrived - baseArrived)
  // The lock is offered where the device can keep the token locked (on the web it cannot).
  derive lockable = session.signedIn and lock.available and lock.presenceSecrets
  derive biometryLabel = lock.biometry == "faceID" ? "Require Face ID" : lock.biometry == "touchID" ? "Require Touch ID" : lock.biometry == "opticID" ? "Require Optic ID" : "Require Passcode"
  // Android names no modality: the switch takes the platform's own label ("Use fingerprint").
  derive lockLabel = match lock.android { case some(a) => match a.label { case some(l) => l, case none => biometryLabel }, case none => biometryLabel }
  derive unreadText = `${win.unread}${win.unreadMore ? "+" : ""} new ${win.unread == 1 and not win.unreadMore ? "message" : "messages"} since ${formatTime(win.unreadAt, time.utcOffset, "short")}`

  task tick mount
    every(60000, step)
  task directory when directoryFor != gw.me and (gw.me == "" or (gw.queued == 0 and not pending(guilds) and not pending(categories) and not pending(dms) and not directoryFailed))
    after(1, directoryLanded)
  // The heartbeat is the gateway session's (`discord/gateway.ts`); this asks it each
  // second whether one is due, which is also the data module's clock.
  task heartbeat when connected(gw.state)
    every(1000, beatNow)
  // A dropped connection resumes once its backoff has passed.
  task redial when gw.state == "backoff"
    every(1000, redialNow)
  // A gateway answer the host refused (a turn over its budget) ends the stream with no close the data
  // module hears, and the resource keeps its last state: asked again, it connects again (the identify
  // budget bounds how often). Not while `digest` is applying a large READY: connecting again drops the
  // rest of it, and a resumed session would never bring those servers back.
  task regateway when failed(gateway) and session.ready and session.signedIn and gw.queued == 0 and not pending(digested)
    every(10000, redialNow)
  task record when gw.state == "recording"
    after(1, recordNow)
  // Discord refusing the token (close 4004) signs out: the channel on screen goes with the account.
  task opening when pendingOpen != "" and listed.map(c => c.id).includes(pendingOpen)
    after(1, openPending)
  task resume when wide and top(nav).name == "home" and resumeChannel != "" and not signedOutNow and pendingOpen == ""
    after(1, openResume)
  task signedOutHome when signedOutNow and top(nav).name != "home"
    after(1, toSignIn)
  members "./routing.contract"
  task digest when gw.queued > 0 and not pending(digested) key=gw.seq
    after(1, digestNow)
  task traffic when live and open != ""
    every(2500, trafficTick)
  // Discord's typing lasts ten seconds unless sent again.
  task typingEnds when chan.typing != "" key=chan.version
    after(10000, stopTyping)
  task scrollQuiet when scrolling key=scrollTick
    after(200, scrollSettled)
  task unhighlight when highlight != "" key=highlight
    after(2500, clearHighlight)
  // A jump, a restored place or a return to the present lands once the window
  // holding it has.
  task land when target != "" and current and not pending(win) key=target
    after(1, landJump)
  // A message arriving while the reader is within a row of the end is followed
  // (§3.7); the list follows by itself only from the end exactly.
  task follow when current and anchor == "" and not away and chan.arrived > followed key=chan.arrived
    after(1, followEnd)
  // What the reader has seen at the end is acknowledged a second after it shows,
  // while the transcript is in front: at most one ack a second. Leaving the end
  // or the channel acknowledges at once what was on screen (`scrolled`, `back`).
  // It is asked again when the channel changes (a message reached the tail after the
  // ack chose its newest) and after a failed ack, at most three times.
  task ack when reading and not signedOutNow and current and anchor == "" and not away and chan.unread > 0 and page.visibilityState == "visible" key=`${chan.version}/${ackTries}`
    after(1000, ackNow)
  // The page the window lacks; a failed one is asked again, at most three times.
  task fetchPage when win.channel == open and not signedOutNow and win.need != "" and not historyFailed and not pending(paged) and not pending(editPaged) key=`${pageKey}/${pageTries}`
    after(1, pageNow)
  // The bar says what was unread when the channel opened: its label is held from
  // the first window that answers it, as arrivals and sends move the count on.
  task unreadLands when unreadBar and unreadLabel == "" and current
    after(1, holdUnread)
  task pumping when slow
    every(150, pumpNow)
  task findEdit when editLookup and reading and not session.locked and not lockedOut and not pending(editTarget) and not pending(editPaged) and not pending(paged) and editTarget.channel == open key=`${editTarget.id}/${editTarget.need}/${editTarget.cursor}`
    after(1, resolveEdit)
  // A launch that begins locked asks for the check once, right after the first
  // data answer; a cancel leaves the lock screen and its Unlock button.
  task unlockAtLaunch when session.locked and not launchAsked
    after(1, unlockFirst)
  // A gate follows a state, and the page is visible at launch: the action skips
  // its own first run and then hears every return (docs/agent-pitfalls.md).
  task returnLock when page.visibilityState == "visible"
    after(1, onReturn)

  action step
    now = performanceNow()
  action directoryLanded
    directoryFor = gw.me
  action beatNow
    send beat = heartbeat(time.epochAtZero + performanceNow())
  action redialNow
    send redialed = heartbeat(time.epochAtZero + performanceNow())
  action digestNow
    send digested = digest(time.epochAtZero + performanceNow())
  action recordNow
    send recorded = recordIdentify()
  action identifyNow
    send identified = sendIdentify()
  action trafficTick
    send changed = inject(open, "message", topKey, time.epochAtZero + performanceNow())
  action stopTyping
    send changed = expireTyping(time.epochAtZero + performanceNow())
  action clearHighlight
    highlight = ""
  action ackNow
    if not away
      send acked = markRead(open)
  action afterAck
    match acked
      case some(r)
        ackTries = r.ok ? 0 : min(3, ackTries + 1)
      case none
        ackTries = 0
  action pageNow
    if pageAsked != pageKey
      pageTries = 0
    pageAsks = pageAsked != pageKey ? 1 : pageAsks + 1
    pageAsked = pageKey
    send paged = loadPage(win.channel, win.need, win.cursor)
  action afterPage
    match paged
      case some(r)
        pageTries = r.ok ? 0 : pageTries + 1
        // A collection at offset zero shows prepended rows. A transcript keeps
        // the message being read, including when a slow page lands at that edge.
        if r.ok and reading and pageAsked.startsWith(`${open}/before/`) and historyStart and target == "" and topKey != ""
          target = topKey
          targetBlock = "offset"
          restoreOffset = topOffset
      case none
        pageTries = 0
  action retryHistory
    pageTries = 0
    pageAsks = 0
  action followEnd
    followed = chan.arrived
    if not away and endGap > 0.5
      scrollIntoView("transcript", lastKey, offset=1000000, behavior="smooth")

  // Opening a channel: at its newest (§3.1), at its first unread with the bar
  // (§3.2), or where this session left it (§3.3).
  action openChannel(id: string)
    let c = channelOf(channels.concat(dms).concat(targets.map(t => t.channel)), id)
    let p = placeOf(places, id)
    // A split opens one channel over another: the one left keeps its place and draft, and is read
    // as `leaving` reads it (its `viewChannel` is this one's below).
    if top(nav).name == "channel" and open != "" and open != id
      places = places.filter(q => q.channel != open).concat([Place(channel=open, anchor=anchor, key=topKey, offset=topOffset, atEnd=not away)])
      if editing != ""
        drafts = withDraft(drafts, open, stash)
        stash = ""
      if not away and anchor == "" and chan.unread > 0 and viewing == ""
        send acked = markRead(open)
    now = performanceNow()
    open = id
    replyTo = ""
    replyName = ""
    editing = ""
    editText = ""
    stash = ""
    stashReplyTo = ""
    stashReplyName = ""
    cancelEditLookup()
    editError = ""
    picked = []
    attachError = ""
    highlight = ""
    away = false
    historyStart = false
    // A New divider only for what was unread on opening: what arrives while the
    // reader watches is not new to them.
    since = c.unread > 0 ? c.lastRead : ""
    unreadBar = c.unread > 0
    unreadLabel = ""
    baseArrived = c.arrived
    followed = c.arrived
    if p.channel == id and not p.atEnd
      anchor = p.anchor
      target = p.key
      restoreOffset = p.offset
      targetBlock = "offset"
    else
      anchor = ""
      target = ""
    ackTries = 0
    pageTries = 0
    pageAsks = 0
    if c.ageRestricted and ageGate == ""
      ageGate = "asked"
      send age = requestAgeRange(ageGates=[18])
    send joined = viewChannel(id)
    lastChannels = withDraft(lastChannels, c.guild != "" ? c.guild : "@me", id)
    // Beside the list (a split) one channel replaces another, as a sidebar's selection does.
    nav = top(nav).name == "channel" ? replace(nav, path("channel", id)) : push(nav, path("channel", id))
  action confirmAge
    ageGate = "confirmed"
  action toggleFolder(id: string)
    openFolders = openFolders.includes(id) ? openFolders.filter(f => f != id) : openFolders.concat([id])
  // A hundred more past the first conversation not shown: the next hundred may already show, unread.
  action moreDms
    let hidden = dms.slice(dmsShownCount).map(c => c.unread > 0 or c.mentions > 0 or c.id == open).indexOf(false)
    dmsShownCount = (hidden < 0 ? dms.length : dmsShownCount + hidden) + 100
  action retryChannels
    refresh categories
  action pickServer(v: string)
    server = v
    pendingOpen = ""
    if wide and top(nav).name != "home"
      leaving()
      nav = go(nav, "/")
  action openResume
    if wide and top(nav).name == "home" and resumeChannel != ""
      openChannel(resumeChannel)
  // Signing in keeps the pasted token; the field is cleared once it is taken.
  action editToken(v: string)
    tokenDraft = v
  action signInNow
    if tokenDraft.trim() != "" and not pending(signedIn)
      dmsShownCount = 100
      send signedIn = signIn(tokenDraft)
  action afterSignIn
    if signInError == ""
      tokenDraft = ""
  action askSignOut
    showModal("confirm-sign-out")
  action signOutNow
    toSignIn()
    send signedOut = signOut()
  action toSignIn
    cancelEditLookup()
    nav = go(nav, "/")
    open = ""
    dmsShownCount = 100
    profileUser = ""
    close("profile")
  // Leaving keeps the reader's place, puts an unsaved edit away and acknowledges
  // what was on screen at the end.
  action leave(url: string)
    leaving()
    nav = go(nav, url)
  action back
    restore = restore == "?" ? "!" : restore
    leaving()
    nav = back(nav)
  action leaving
    cancelEditLookup()
    places = places.filter(p => p.channel != open).concat([Place(channel=open, anchor=anchor, key=topKey, offset=topOffset, atEnd=not away)])
    if editing != ""
      drafts = withDraft(drafts, open, stash)
      editing = ""
      editText = ""
      editError = ""
      stash = ""
      stashReplyTo = ""
      stashReplyName = ""
    // What arrived behind a picture was not seen: a Back over the viewer reads nothing.
    if not away and anchor == "" and chan.unread > 0 and viewing == ""
      send acked = markRead(open)
    viewing = ""
    send joined = viewChannel("")

  // The window: the reader's place decides which run of history it holds.
  // The reader is at the end within the last row's height of it (§3.7). The
  // window anchors at its first (last) row when the first visible row comes
  // within 15 rows of that edge, and the data module then fetches the one page
  // (50 rows) beyond it (§2: the next page only as the reader moves toward the
  // edge): `reachstart` alone gives one viewport of lead, which a fling
  // overruns. A page is asked only of a window that answers the present
  // request, whatever else is refreshing.
  action scrolled(x: number, y: number, e: ScrollEvent)
    if not scrolling
      scrolling = true
      hoverKey = ""
    scrollTick = scrollTick + 1
    let k = match e.firstVisibleKey { case some(k) => k, case none => "" }
    let at = keys.indexOf(k)
    let gap = e.scrollHeight - e.scrollTop - e.clientHeight
    let isAway = gap > max(1, frame(`message-${lastKey}`).height)
    // Rows arriving below grow the gap without the reader moving (and the live
    // window shedding its oldest row moves the offset): only a reader whose first
    // visible row or its offset moved changes whether they are at the end.
    // While a send's return to the end is owed or still settling, a fling's remaining
    // reports do not decide it (`scrollEnded` puts the list back at its end).
    let moved = k != topKey or max(e.firstVisibleOffset - topOffset, topOffset - e.firstVisibleOffset) > 0.5
    if isAway != away and moved and target == "" and not settling
      away = isAway
      if isAway
        baseArrived = chan.arrived
        if anchor == "" and chan.unread > 0 and reading
          send acked = markRead(open)
        if anchor == ""
          anchor = win.pin
      else
        followed = chan.arrived
        if anchor != "" and not win.hasAfter
          anchor = ""
    if at >= 0 and current and target == ""
      if at < 15 and win.hasBefore
        anchor = win.firstId
      else
        if at > keys.length - 15 and win.hasAfter
          anchor = win.lastId
    endGap = gap < 1 ? 0 : round(gap)
    historyStart = e.scrollTop <= 0.5
    topKey = k
    topOffset = e.firstVisibleOffset
  // A send's return to the end settles at a scrollend that finds the list there;
  // momentum that carried it off is undone once the live window is in.
  action scrollEnded
    scrollSettled()
    if settling and target == ""
      if endGap > 0.5
        scrollIntoView("transcript", lastKey, offset=1000000, behavior="instant")
      else
        settling = false
  action older
    if win.hasBefore and current and target == ""
      anchor = win.firstId
  action newer
    if win.hasAfter and current and target == ""
      anchor = win.lastId

  // "The end" is the last row with an offset past it, which the list clamps to the
  // end of its range: the bottom inset (the typing line) included.
  // A jump: in the window it scrolls; outside it the window is replaced around
  // the target, which is placed in the same commit when the window is already
  // there and by `land` when it arrives (§3.6). While a jump is owed (`target`)
  // the window does not page.
  action jumpTo(id: string)
    highlight = id
    if rows.map(r => r.id).includes(id)
      scrollIntoView("transcript", keyOf(rows, id), block="center", behavior="instant")
    else
      jumpFromAnchor = anchor
      jumpFromKey = topKey
      jumpFromOffset = topOffset
      anchor = id
      target = id
      targetBlock = "center"
      scrollIntoView("transcript", id, block="center", behavior="instant")
  // The New divider is on the first row after the read position the channel
  // opened at, so a deleted first unread message moves it to the next one.
  action jumpToUnread
    unreadBar = false
    if dividerKey != ""
      scrollIntoView("transcript", dividerKey, block="start", behavior="instant")
    else
      if since != ""
        anchor = since
        target = "new"
  action dismissUnread
    unreadBar = false
    send acked = markRead(open)
  action toPresent
    away = false
    if anchor == ""
      scrollIntoView("transcript", lastKey, offset=1000000, behavior="smooth")
    else
      anchor = ""
      target = "end"
  action landJump
    let key = keyOf(rows, target)
    if target == "end"
      scrollIntoView("transcript", lastKey, offset=1000000, behavior="instant")
      target = ""
    else
      if target == "new"
        if dividerKey != ""
          scrollIntoView("transcript", dividerKey, block="start", behavior="instant")
        target = ""
      else
        if keys.includes(key)
          if targetBlock == "offset"
            scrollIntoView("transcript", key, offset=restoreOffset, behavior="instant")
          else
            scrollIntoView("transcript", key, block="center", behavior="instant")
          target = ""
        else
          // The target is not in history (deleted since its reply was drawn):
          // the reader goes back to where they were.
          highlight = ""
          if targetBlock == "offset"
            target = ""
          else
            anchor = jumpFromAnchor
            target = jumpFromKey
            targetBlock = "offset"
            restoreOffset = jumpFromOffset

  // The composer. A send returns a reader in history to the live tail, at its end
  // (§3.9). An edit keeps its text until the server takes it.
  action edit(v: string)
    cancelEditLookup()
    // Closing during an edit must leave the persisted new-message draft intact.
    if editing == ""
      drafts = withDraft(drafts, open, v)
    else
      editText = v
    if v.trim() != "" and editing == ""
      send typed = sendTyping(open, time.epochAtZero + performanceNow())
  action keyed(k: string, e: KeyboardEvent)
    // A Return that confirms an input method's candidate is the input method's.
    if (k == "Enter" or k == "Tab") and not e.shiftKey and not e.isComposing and suggestions.length > 0
      preventDefault()
      match first(suggestions)
        case some(s)
          pick(s.text)
        case none
          aimed = aimed
    else if k == "Enter" and not e.shiftKey and not e.isComposing
      preventDefault()
      post()
    else
      if k == "ArrowUp" and draft == "" and editing == "" and replyTo == "" and not e.isComposing and not e.shiftKey and not e.ctrlKey and not e.altKey and not e.metaKey
        preventDefault()
        if not e.repeat and not editLookup
          editRequest = editRequest + 1
          editLookupError = ""
          editPageAsked = ""
          editLookup = true
      else if (k == "PageUp" or k == "PageDown") and not e.isComposing
        preventDefault()
        scrollBy("transcript", 0, (k == "PageUp" ? -1 : 1) * max(80, frame("transcript").height - 60))
  action pick(text: string)
    edit(text)
    focus("composer")
  action cancelEditLookup
    editLookup = false
    editLookupError = ""
  action cancelFindEdit
    cancelEditLookup()
    focus("composer")
  action resolveEdit
    if draft != "" or editing != "" or replyTo != ""
      cancelEditLookup()
    else
      if editTarget.id != ""
        beginEdit(editTarget.id, editTarget.content)
      else
        if editTarget.need != ""
          let request = `${editTarget.need}/${editTarget.cursor}`
          if request == editPageAsked
            editLookup = false
            editLookupError = "History did not advance. Press Up to try again."
          else
            editPageAsked = request
            editPageRequest = editRequest
            send editPaged = loadPage(open, editTarget.need, editTarget.cursor)
        else
          cancelEditLookup()
  action afterEditPage
    match editPaged
      case some(r)
        if not r.ok and editLookup and editPageRequest == editRequest
          editLookup = false
          editLookupError = r.error
      case none
        editLookup = editLookup
  action channelKey(k: string, e: KeyboardEvent)
    if k == "Escape" and not e.isComposing and reading and not session.locked and not lockedOut
      preventDefault()
      if not e.repeat
        if editLookup or editLookupError != ""
          cancelEditLookup()
        else
          if editing != ""
            cancelEdit()
          else
            if replyTo != ""
              cancelReply()
            else
              dismissUnread()
              toPresent()
        focus("composer")
  action post
    if pending(pastedPictures)
      aimed = aimed
    else if draft.trim() != "" or (picked.length > 0 and editing == "")
      if editing != ""
        if not pending(edited)
          savingChannel = open
          savingId = editing
          savingRevision = editRevision
          savingText = draft
          savingStash = stash
          savingReplyTo = stashReplyTo
          savingReplyName = stashReplyName
          savingReplyMention = stashReplyMention
          send edited = editMessage(open, editing, draft.trim())
      else
        send echoed = echoMessage(open, draft.trim(), replyTo, time.epochAtZero + performanceNow(), picked, replyMention)
        picked = []
        attachError = ""
        replyTo = ""
        drafts = withDraft(drafts, open, "")
        if away or anchor != ""
          away = false
          anchor = ""
          target = "end"
          settling = true
    focus("composer")
  action postEchoed
    match echoed
      case some(r)
        if r.ok
          send sent = postMessage(r.channel, r.key)
      case none
        aimed = aimed
  // A save belongs to one edit session, even if the same message is reopened.
  // Text typed while that save is pending remains editable after it succeeds.
  action afterEdit
    if open == savingChannel and editing == savingId and editRevision == savingRevision
      if editFailure == ""
        editError = ""
        if draft == savingText
          editing = ""
          editText = ""
          drafts = withDraft(drafts, savingChannel, savingStash)
          replyTo = savingReplyTo
          replyName = savingReplyName
          replyMention = savingReplyMention
          stash = ""
          stashReplyTo = ""
          stashReplyName = ""
      else
        editError = editFailure
  action cancelReply
    replyTo = ""
    replyName = ""
    focus("composer")
  action toggleReplyMention
    replyMention = not replyMention
  action cancelEdit
    editing = ""
    editText = ""
    editError = ""
    drafts = withDraft(drafts, open, stash)
    replyTo = stashReplyTo
    replyName = stashReplyName
    replyMention = stashReplyMention
    stash = ""
    stashReplyTo = ""
    stashReplyName = ""
    focus("composer")
  action beginEdit(id: string, text: string)
    cancelEditLookup()
    if editing == ""
      stash = draft
      stashReplyTo = replyTo
      stashReplyName = replyName
      stashReplyMention = replyMention
    replyTo = ""
    replyName = ""
    editing = id
    editRevision = editRevision + 1
    editError = ""
    editText = text
    focus("composer")
  action beginReply(id: string, author: string)
    cancelEditLookup()
    if editing != ""
      cancelEdit()
    replyTo = id
    replyName = author
    replyMention = true
    focus("composer")

  // A message's own controls. `aimedText` is the message's Markdown as sent.
  action reveal(key: string)
    revealed = revealed.concat([key])
  // What a poll's card asks (`PollView`); a vote replaces the reader's earlier one, as in Discord.
  action pollAct(what: string, id: string, answer: string, multi: bool)
    if what == "pick"
      pollPicks = pollPicks.includes(`${id}:${answer}`) ? pollPicks.filter(k => k != `${id}:${answer}`) : (multi ? pollPicks : pollPicks.filter(k => not k.startsWith(`${id}:`))).concat([`${id}:${answer}`])
    else if what == "vote"
      // The choices stay until the vote is taken back, so a vote Discord refuses can be sent again.
      send changed = vote(open, id, pollPicks.filter(k => k.startsWith(`${id}:`)).map(k => k.slice(id.length + 1)))
    else if what == "unvote"
      send changed = vote(open, id, noAnswers())
      pollPicks = pollPicks.filter(k => not k.startsWith(`${id}:`))
    else if what == "results"
      revealed = revealed.concat([`poll:${id}`])
    else
      revealed = revealed.filter(k => k != `poll:${id}`)
  action show(src: string, alt: string, w: number, h: number)
    viewingAlt = alt
    viewingWidth = w
    viewingHeight = h
    viewPanX = 0
    viewPanY = 0
    viewZoom = 1
    viewing = src
  action closeViewer
    viewing = ""
  action viewerGeometry(bw: number, bh: number, pw: number, ph: number)
    viewBoxWidth = bw
    viewBoxHeight = bh
    viewPortWidth = pw
    viewPortHeight = ph
  // At fit, a drag down far or fast enough closes the viewer; otherwise the
  // pinch's scale is kept between fit and 4x and the pan stays inside the picture.
  action viewerRelease(x: number, y: number, scale: number, vx: number, vy: number, vscale: number)
    // A picture Discord gave no size is taken as filling the box.
    let w = viewingWidth > 0 ? viewingWidth : viewBoxWidth
    let h = viewingHeight > 0 ? viewingHeight : viewBoxHeight
    let fit = photoFit(viewBoxWidth, viewBoxHeight, w, h)
    if photoZoom(scale) == 1 and (y > 120 or vy > 800)
      viewing = ""
    else
      viewZoom = photoZoom(scale)
      viewPanX = fit > 0 ? photoClamp(x, w, fit, photoZoom(scale), viewPortWidth) : 0
      viewPanY = fit > 0 ? photoClamp(y, h, fit, photoZoom(scale), viewPortHeight) : 0
  action viewerToggleZoom
    viewZoom = viewZoom > 1 ? 1 : 2
    viewPanX = 0
    viewPanY = 0
  action aim(key: string, id: string, mine: bool, text: string, author: string, forwarded: bool)
    aimedForward = forwarded
    aimedAuthor = author
    aimed = key
    aimedId = id
    aimedMine = mine
    aimedText = text
  action replyAimed
    beginReply(aimedId, aimedAuthor)
  action editAimed
    beginEdit(aimedId, aimedText)
  action askDelete
    deleteError = ""
    showModal("confirm-delete")
  action deleteAimed
    send deleted = deleteMessage(open, aimed)
  action afterDelete
    if deleteFailure != ""
      deleteError = deleteFailure
      showModal("delete-failed")
  action copyAimed
    copyText(aimedText)
  action copyLink
    let serverId = chan.guild == "" ? "@me" : chan.guild
    copyText(`https://discord.com/channels/${serverId}/${open}/${aimedId}`)
  // On the web the detector itself may need a download, which this press makes; the next press translates (§10 step 4).
  action translateAimed
    if lang.detector == "downloadable"
      send detectorMade = createLanguageDetector()
    else
      translating = aimedId
      translatingText = aimedText
      translatingFrom = lang.name
      send translator = createTranslator(sourceLanguage=lang.language, targetLanguage=myLanguage)
  action runTranslation
    send translation = translate(translator=(match translator { case some(t) => t.id, case none => "" }), input=translatingText)
  action landTranslation
    translated = withTranslated(translated, Translated(id=translating, text=(match translation { case some(r) => r.text, case none => "" }), line=`Translated from ${translatingFrom}`))
    translating = ""
  action showOriginal(id: string)
    translated = translated.filter(t => t.id != id)
  action reactAimed(emoji: string)
    send changed = react(open, aimedId, emoji)
  action openPicker
    pickerQuery = ""
    pickingForDraft = false
    picking = true
    showModal("react-picker")
  action caretMoved(e: InputEvent)
    caretFrom = e.selectionStart
    caretTo = e.selectionEnd
  action openDraftPicker
    pickerQuery = ""
    pickingForDraft = true
    picking = true
    showModal("react-picker")
  action searchPicker(v: string)
    pickerQuery = v
  action emojiPicked(value: string, text: string)
    picking = false
    close("react-picker")
    if pickingForDraft
      let from = caretFrom < 0 ? draft.length : min(caretFrom, draft.length)
      setRangeText("composer", text, from, max(from, min(caretTo, draft.length)), "end")
      focus("composer")
    else
      send changed = react(open, aimedId, value)
  action pickerClosed
    picking = false
  // What a mention or a Discord link in a message opens (a run's `ref`, shapes.contract): a person's
  // card, a channel, or a message in its channel, highlighted. Another server's channel opens once that
  // server's list holds it (`opening`), so it opens with its unread state, as from the list.
  action follow(ref: string)
    let part = ref.split(":")
    if piece(part, 0) == "u"
      showProfile(piece(part, 1), "")
    else
      let guildId = piece(part, 1)
      let channelId = piece(part, 2)
      let messageId = piece(part, 3)
      if channelId == open and messageId != ""
        jumpTo(messageId)
      else if channelId != "" and channelId != open
        server = guildId != "" ? guildId : "@me"
        pendingOpen = channelId
        pendingMessage = messageId
  action openPending
    let id = pendingOpen
    let message = pendingMessage
    pendingOpen = ""
    pendingMessage = ""
    openChannel(id)
    // A message that is not there leaves the reader at the channel's end.
    if message != ""
      highlight = message
      anchor = message
      target = message
      targetBlock = "center"
      jumpFromAnchor = ""
      jumpFromKey = "end"
      jumpFromOffset = 0
  action showProfile(userId: string, messageId: string)
    if not locked
      profileUser = userId
      profileMessage = messageId
      profileChannel = open
      showModal("profile")
  action profileClosed
    profileUser = ""
  action toggleMembers
    if paneWidth >= 900
      showMembers = not showMembers
    else
      showModal("members")
  action paneResized(w: number, h: number)
    paneWidth = w
  action memberCard(userId: string, messageId: string)
    close("members")
    showProfile(userId, messageId)
  action openSwitcher
    if not locked
      switchQuery = ""
      switching = true
      showModal("switcher")
  // ⌘K (Ctrl+K) wherever the focus is, a channel's composer included, as Discord's desktop app takes it.
  action windowKey(k: string, e: KeyboardEvent)
    if (e.metaKey or e.ctrlKey) and (k == "k" or k == "K") and not e.isComposing and not switching
      preventDefault()
      openSwitcher()
    else
      channelKey(k, e)
  action searchSwitcher(v: string)
    switchQuery = v
  action switcherKey(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.isComposing
      preventDefault()
      match first(targets)
        case some(t)
          switchTo(t.server, t.id)
        case none
          switching = switching
  action switchTo(serverId: string, id: string)
    switching = false
    close("switcher")
    profileUser = ""
    close("profile")
    server = serverId
    openChannel(id)
    // A picture open over the channel left closes with it.
    viewing = ""
  action switcherClosed
    switching = false
  action toggleReaction(id: string, emoji: string)
    send changed = react(open, id, emoji)
  action retry(key: string)
    send echoed = retrySend(open, key)
  action discard(key: string)
    send deleted = deleteMessage(open, key)
  action attach
    showPicker("attach")
  // Discord refuses a file over its 10 MB limit; a picture over it is made smaller when it is sent (`upload`).
  action filesPicked(files: Picked[])
    let refused = files.filter(f => f.size > 10485760 and not f.type.startsWith("image/"))
    let fit = files.filter(f => f.size <= 10485760 or f.type.startsWith("image/"))
    let over = picked.length + fit.length > 10
    picked = picked.concat(fit).slice(0, 10)
    attachError = refused.length > 0 ? `${refused.map(f => f.name).join(", ")} ${refused.length == 1 ? "is" : "are"} over Discord's 10 MB limit.` : over ? "A message takes up to 10 files." : ""
    focus("composer")
  // Pictures pasted into the composer join the picked ones, as Discord's do; text pastes as text.
  action pastedInto(e: ClipboardEvent)
    if e.files.length > 0 and editing == ""
      preventDefault()
      attachError = ""
      send pastedPictures = adoptPasted(open, e.files, time.epochAtZero + performanceNow())
  // A paste's pictures join its own channel's composer: one left while they were copied keeps none.
  action takePasted
    match pastedPictures
      case some(r)
        if r.channel == open
          let over = picked.length + r.files.length > 10
          picked = picked.concat(r.files).slice(0, 10)
          attachError = over ? (r.error != "" ? `A message takes up to 10 pictures; ${r.error}` : "A message takes up to 10 pictures.") : r.error
      case none
        aimed = aimed
  action unpick(path: string)
    picked = picked.filter(p => p.path != path)
  action composerFocus(on: bool)
    composing = on
  action scrollSettled
    scrolling = false
    hoverKey = pointerKey
  action hoverRow(key: string, on: bool)
    let over = on ? key : (pointerKey == key ? "" : pointerKey)
    pointerKey = over
    if not scrolling
      hoverKey = over
  action startReply(id: string, author: string)
    beginReply(id, author)
  action swipe(key: string, dx: number, dy: number)
    swipeKey = key
    swipeX = min(80, max(0, swipeX - dx))
    dragging = true
  action swipeEnd(id: string, author: string, vx: number, vy: number)
    if swipeX >= 56
      beginReply(id, author)
      haptic("impact-light")
    swipeX = 0
    dragging = false

  // The fixture's traffic (§4.4), on the drive's clock.
  action injectNow(what: string)
    send changed = inject(open, what, topKey, time.epochAtZero + performanceNow())
  action toggleLive
    live = not live
  action toggleSlow
    slow = not slow
    lagAnchor = anchor
    lagVersion = histVersion
  action holdUnread
    unreadLabel = unreadText
  action focusComposer
    composerFocused = true
  action blurComposer
    composerFocused = false
  action pumpNow
    lagAnchor = anchor
    lagVersion = histVersion
  action unlockFirst
    launchAsked = true
    send unlocked = unlockSession()
  action onReturn
    if launched and session.ready and session.lockOn
      lockedOut = true
      // A dialog shows above everything, the lock included: the lock closes them.
      switching = false
      picking = false
      close("switcher")
      close("react-picker")
      close("confirm-delete")
      close("confirm-sign-out")
      close("profile")
      close("members")
      hidePopover("message-menu")
      hidePopover("account-menu")
      hidePopover("fixture-menu")
    launched = true
  action unlockTap
    if session.locked
      send unlocked = unlockSession()
    else
      send returned = authenticate(reason="reason.unlock")
  action afterReturn
    lockedOut = false
  action toggleLock
    if session.lockOn
      send lockSet = unprotectToken()
    else
      send lockChecked = authenticate(reason="reason.unlock")
  action lockAfterCheck
    send lockSet = protectToken()
  action signInFixture
    dmsShownCount = 100
    send unlocked = signInAgain()

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=leave key=windowKey interactive-widget="resizes-content" width="100%" height="100%"
      head title=pageTitle
      for e in stack(nav) key=e.id
        if e.name == "home" and signedOutNow
          column navigationKey=`${e.id}` navigationScroll="sign-in" position="absolute" inset=0 inert=covered
            header display="flex" align-items="center" padding="8px 16px"
              h1 "Sign In to Discord" flex=1 min-width=0
            list id="sign-in" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
              if droppedLock
                section
                  text "Sign in again: this device no longer keeps your token behind its lock." testId="signed-out"
                  if gw.fixture
                    button press=signInFixture testId="sign-in-fixture"
                      text "Sign In"
              section
                header
                  text "Token"
                row
                  input type="password" value=tokenDraft input=editToken submit=signInNow autocomplete="off" placeholder="Paste your token" aria-label="Token" testId="token" flex=1 min-width=0
                footer
                  text "On a computer, open discord.com in a browser and sign in, then open the browser's developer tools and their Network tab. Pick any request to discord.com/api and copy the value of its Authorization header. Excord keeps the token in this device's secure storage and sends it only to Discord. Treat it like a password: anyone who has it can use your account."
              section
                button press=signInNow disabled=(tokenDraft.trim() == "" or pending(signedIn)) testId="sign-in"
                  text (pending(signedIn) ? "Signing In…" : "Sign In")
                if signInError != ""
                  text signInError color="-exact-system-red" testId="sign-in-error"
                else if gw.detail != ""
                  text (gw.detail.includes("4004") ? "Discord didn't accept the last token. Sign in with a new one." : gw.detail) color="-exact-system-red" testId="signed-out-detail"
        else if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="channels" position="absolute" inset=0 inert=covered
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              h1 (not directoryLoaded ? "Excord" : dmsShown ? "Direct Messages" : guild.name) flex=1 min-width=0 line-clamp=1 testId="directory-title"
              button press=openSwitcher aria-label="Find or Start a Conversation" aria-keyshortcuts="Meta+K Control+K" testId="switcher-open"
                image "symbol:search"
              button popovertarget="account-menu" aria-label="Account" testId="account"
                image "symbol:person"
            column id="account-menu" popover="auto" role="menu" aria-label="Account"
              button commandfor="account-details" command="show-modal" testId="account-details"
                image "symbol:person"
                text "Account Details"
              if lockable
                hr
                button press=toggleLock popovertarget="account-menu" popovertargetaction="hide" role="menuitemcheckbox" aria-checked=session.lockOn testId="lock-switch"
                  text lockLabel
              if not gw.fixture
                hr
                button press=askSignOut destructive=true popovertarget="account-menu" popovertargetaction="hide" testId="menu-sign-out"
                  image "symbol:sign-out"
                  text "Sign Out"
            dialog id="account-details" role="alertdialog" aria-label="Account"
              text (gw.meName == "" ? "Connecting…" : gw.fixture ? `Sample account: ${gw.meName}` : `Signed in as ${gw.meName}`) testId="account-identity"
              button commandfor="account-details" command="close" testId="account-close"
                text "Close"
            dialog id="confirm-sign-out" role="alertdialog" aria-label="Sign Out?"
              text "Excord forgets your token on this device."
              button press=signOutNow destructive=true commandfor="confirm-sign-out" command="close" testId="sign-out-confirm"
                text "Sign Out"
              button commandfor="confirm-sign-out" command="close" testId="sign-out-cancel"
                text "Cancel"
            // What a split shows beside the list while no channel is open.
            column navigationSplit="placeholder" align-items="center" justify-content="center" gap=12 padding=24 testId="no-channel"
              image "symbol:messages" font-size=40 color="-exact-tertiary-label"
              text (dmsShown ? "Choose a conversation" : "Choose a channel") font="-exact-title3" color="-exact-secondary-label"
            DirectoryList(gw=gw, dmsShown=dmsShown, guild=guild, dmUnread=dmUnread, dmMentions=dmMentions, rail=rail, openFolders=openFolders, directoryLoaded=directoryLoaded, directoryFailed=directoryFailed, recentDms=recentDms, dms=dms, here=here, channelsFailed=failed(categories), pickServer=pickServer, toggleFolder=toggleFolder, openChannel=openChannel, moreDms=moreDms, retryChannels=retryChannels)
        else
          column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0 inert=covered
            header display="flex" align-items="center" gap=8 padding="8px 16px"
              button id="back" press=back aria-label="Back" testId="back"
                image "symbol:back"
              h2 (chan.guild != "" ? `# ${chan.name}` : chan.name) flex=1 min-width=0 line-clamp=1
              if chan.guild != ""
                button press=toggleMembers aria-label="Members" aria-pressed=membersBeside testId="members-toggle"
                  image "symbol:people"
              if gw.fixture
                button popovertarget="fixture-menu" aria-label="Fixture traffic" testId="fixture"
                  image "symbol:more"
            column id="fixture-menu" popover="auto" role="menu" aria-label="Fixture traffic"
              button press=injectNow("message") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-message"
                text "Receive a message"
              button press=injectNow("burst") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-burst"
                text "Receive a burst"
              button press=injectNow("japanese") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-japanese"
                text "Receive a message in Japanese"
              button press=injectNow("typing") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-typing"
                text "Someone types"
              hr
              button press=injectNow("edit-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-edit-above"
                text "Edit a message above"
              button press=injectNow("delete-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-delete-above"
                text "Delete a message above"
              button press=injectNow("react-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-react-above"
                text "React to a message above"
              button press=injectNow("embed-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-embed-above"
                text "Embed arrives above"
              button press=injectNow("delete-unread") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-delete-unread"
                text "Delete the first unread message"
              hr
              button press=toggleSlow popovertarget="fixture-menu" popovertargetaction="hide" role="menuitemcheckbox" aria-checked=slow testId="toggle-slow"
                text "Slow history"
              button press=injectNow("fail-next") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-fail-next"
                text "Fail the next send"
              button press=toggleLive popovertarget="fixture-menu" popovertargetaction="hide" role="menuitemcheckbox" aria-checked=live testId="toggle-live"
                text "Live traffic"
            // The transcript and its composer, and beside them the member list when there is room.
            row flex=1 min-height=0 position="relative" resize=paneResized
              column flex=1 min-width=0 min-height=0
                if historyFailed and rows.length > 0
                  row align-items="center" gap=12 padding="8px 16px" flex-wrap="wrap" background-color="-exact-secondary-background"
                    text "Couldn’t load more messages." testId="history-error" flex=1 min-width=0
                    button press=retryHistory testId="retry-history"
                      text "Retry"
                if unreadBar and unreadLabel != ""
                  row align-items="center" column-gap=12 padding="0px 16px" flex-shrink=0 background-color="AccentColor" testId="unread"
                    button appearance="none" press=jumpToUnread testId="unread-bar" aria-label=unreadLabel flex=1 min-width=0 padding="9px 0px"
                      text unreadLabel color="AccentColorText" font="-exact-footnote" font-weight=600 line-clamp=1 text-align="left" flex=1 min-width=0
                    button appearance="none" press=dismissUnread testId="mark-read" flex-shrink=0 padding="9px 0px"
                      text "Mark As Read" color="AccentColorText" font="-exact-footnote" font-weight=600
                column flex=1 min-height=0 position="relative"
                  // A list of its own for each channel: one opened over another (a split replaces the
                  // route) starts at its newest message rather than at the last one's scroll position.
                  for ch in [open] key=ch
                    list id="transcript" testId="transcript" appearance="none" virtualized=true estimated-item-height=72
                      scroll-start="end" scrollFollowEnd=true scroll-behavior="smooth"
                      reachstart=older reachend=newer scroll=scrolled scrollend=scrollEnded
                      flex=1 min-height=0 padding-top=8 padding-bottom=22
                      for m in rows key=m.key
                        MessageRow(m=m, contrast=(mediaPreferences.prefersContrast == "custom"), touch=(viewport.pointer == "coarse"), clock=clock, offset=time.utcOffset, isNew=m.isNew, lit=(m.id == highlight), revealed=revealed, picks=pollPicks, swipeX=(viewport.pointer == "coarse" and m.key == swipeKey ? swipeX : 0), dragging=(viewport.pointer == "coarse" and dragging and m.key == swipeKey), reveal=reveal, jump=jumpTo, aim=aim, react=toggleReaction, retry=retry, discard=discard, swipe=swipe, swipeEnd=swipeEnd, show=show, hovered=(m.key == hoverKey), hover=hoverRow, reply=startReply, profile=showProfile, follow=follow, poll=pollAct, translations=translations, original=showOriginal)
                  if rows.length == 0
                    column position="absolute" inset=0 align-items="center" justify-content="center" gap=12 padding=24
                      if historyFailed
                        text "Couldn’t load messages." testId="history-error" text-align="center"
                        button press=retryHistory testId="retry-history"
                          text "Retry"
                      else
                        if historyLoading
                          progress aria-label="Loading messages"
                          text "Loading messages…" testId="history-loading" color="-exact-secondary-label"
                        else
                          text "No messages yet." testId="history-empty" color="-exact-secondary-label"
                  column id="message-menu" popover="auto" role="menu"
                    button press=replyAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-reply"
                      image "symbol:reply"
                      text "Reply"
                    button press=reactAimed("👍") popovertarget="message-menu" popovertargetaction="hide" testId="menu-thumbs"
                      text "👍 Thumbs Up"
                    button press=reactAimed("❤️") popovertarget="message-menu" popovertargetaction="hide" testId="menu-heart"
                      text "❤️ Heart"
                    button press=reactAimed("😂") popovertarget="message-menu" popovertargetaction="hide" testId="menu-laugh"
                      text "😂 Laugh"
                    button press=openPicker popovertarget="message-menu" popovertargetaction="hide" testId="menu-react"
                      image "symbol:add"
                      text "Add Reaction"
                    hr
                    button press=copyAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-copy"
                      image "symbol:copy"
                      text "Copy Text"
                    if canTranslate
                      button press=translateAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-translate"
                        text "Translate"
                    button press=copyLink popovertarget="message-menu" popovertargetaction="hide" testId="menu-link"
                      image "symbol:link"
                      text "Copy Message Link"
                    if aimedMine
                      hr
                      if not aimedForward
                        button press=editAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-edit"
                          image "symbol:pencil"
                          text "Edit Message"
                      button press=askDelete destructive=true popovertarget="message-menu" popovertargetaction="hide" testId="menu-delete"
                        image "symbol:delete"
                        text "Delete Message"
                  dialog id="react-picker" aria-label=(pickingForDraft ? "Emoji" : "Add Reaction") close=pickerClosed testId="react-picker"
                    column gap=10 padding=12 width="22rem" max-width="100%"
                      input type="search" value=pickerQuery input=searchPicker placeholder="Find an emoji" aria-label="Find an emoji" autofocus=true testId="picker-search"
                      scroll height="16rem"
                        view display="grid" grid-template-columns="repeat(auto-fill, minmax(44px, 1fr))" gap=2
                          for e in choices key=e.id
                            button appearance="none" press=emojiPicked(e.value, e.text) aria-label=e.label padding=6 border-radius=8 testId=`pick-${e.id}`
                              if e.avatar != ""
                                image e.avatar width=28 height=28 margin="auto"
                              else
                                text e.glyph font-size=26 text-align="center"
                      if choices.length == 0
                        text "No emoji match." font="-exact-footnote" color="-exact-secondary-label" text-align="center"
                  dialog id="confirm-delete" role="alertdialog" aria-label="Delete Message"
                    text "Are you sure you want to delete this message?"
                    button press=deleteAimed destructive=true commandfor="confirm-delete" command="close" testId="delete-confirm"
                      text "Delete"
                    button commandfor="confirm-delete" command="close" testId="delete-cancel"
                      text "Cancel"
                  if chan.typing != ""
                    row position="absolute" left=16 right=16 bottom=2 gap=6 align-items="center"
                      row gap=3 aria-hidden=true
                        for d in ["0", "1", "2"] key=d
                          view width=5 height=5 border-radius=3 background-color="-exact-secondary-label"
                            animation=(viewport.prefersReducedMotion ? "none" : `typingDot 1.2s ${d == "0" ? 0 : d == "1" ? 160 : 320}ms ease-in-out infinite`)
                      text chan.typing testId="typing" font="-exact-caption1" color="-exact-secondary-label" line-clamp=1 flex=1 min-width=0
                  if away and (newCount > 0 or win.hasAfter)
                    button press=toPresent buttonStyle="filled" testId="jump-present" position="absolute" bottom=28 right=16
                      text (newCount > 0 ? `${newCount} new ${newCount == 1 ? "message" : "messages"}` : "Jump to Present")
                column padding="4px 12px 6px" max-height="50vh" flex-shrink=0 min-height=0
                  if editLookup
                    row align-items="center" gap=8 padding="4px 4px" flex-shrink=0
                      text "Finding your last message…" font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 testId="finding-edit"
                      button press=cancelFindEdit aria-label="Cancel finding message" testId="cancel-find-edit"
                        image "symbol:close"
                  if editLookupError != ""
                    text editLookupError font="-exact-footnote" color="-exact-system-red" padding="0px 4px 4px" flex-shrink=0 testId="find-edit-error"
                  // One bar for a reply and an edit: its height holds through the swap, so the transcript keeps its end.
                  if replyTo != "" or editing != ""
                    row align-items="center" gap=8 padding="4px 4px" flex-shrink=0 testId=(editing != "" ? "editing" : "reply-bar")
                      if editing != ""
                        if editError != "" and not (pending(edited) and editRevision == savingRevision)
                          text `Not saved: ${editError}` font="-exact-footnote" color="-exact-system-red" flex=1 min-width=0 testId="edit-error"
                        else
                          text (pending(edited) and editRevision == savingRevision ? "Saving message…" : "Editing message") font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0
                        button press=cancelEdit aria-label="Cancel edit" testId="cancel-edit"
                          image "symbol:close"
                      else
                        text `Replying to ${replyName}` font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 testId="replying"
                        button appearance="none" press=toggleReplyMention aria-pressed=replyMention aria-label=(replyMention ? "Mention on" : "Mention off") testId="reply-mention" padding="2px 6px"
                          text (replyMention ? "@ ON" : "@ OFF") font="-exact-footnote" font-weight=700 color=(replyMention ? "AccentColor" : "-exact-secondary-label")
                        button press=cancelReply aria-label="Cancel reply" testId="cancel-reply"
                          image "symbol:close"
                  // One line of text is as tall as Send beside it, so the text sits at its middle.
                  if attachError != ""
                    text attachError font="-exact-footnote" color="-exact-system-red" margin="0px 4px 6px" testId="attach-error"
                  if picked.length > 0
                    scroll overflow-x="auto" overflow-y="hidden" height=88 flex-shrink=0 margin="0px 0px 6px" testId="picked"
                      row gap=8 padding="6px 2px"
                        for f in picked key=f.path
                          view position="relative" flex-shrink=0
                            if f.type.startsWith("image/")
                              image f.path width=72 height=72 border-radius=8 object-fit="cover" background-color="-exact-tertiary-fill" aria-label=f.name
                            else
                              // Any other file: its icon and name, as Discord's composer shows one.
                              column width=72 height=72 box-sizing="border-box" padding="8px 6px" gap=4 align-items="center" justify-content="center" border-radius=8 background-color="-exact-tertiary-fill" aria-label=f.name testId=`picked-file-${f.name}`
                                image "symbol:document" width=24 height=24 color="AccentColor" flex-shrink=0
                                text f.name font="-exact-caption2" text-align="center" line-clamp=2 max-width="100%" overflow-wrap="anywhere"
                            button appearance="none" press=unpick(f.path) aria-label=`Remove ${f.name}` position="absolute" top=4 right=4 width=22 height=22 border-radius=11
                              display="flex" align-items="center" justify-content="center" background-color="-exact-label" testId=`unpick-${f.name}`
                              image "symbol:close" width=10 height=10 color="-exact-background"
                  if suggestions.length > 0
                    column margin="0px 0px 6px" padding="4px 0px" border-radius=12 border="1px solid -exact-separator" background-color="-exact-background" testId="suggestions"
                      for g in suggestions key=g.id
                        button appearance="none" press=pick(g.text) testId=`suggest-${g.id}` aria-label=g.label
                          row gap=10 align-items="center" padding="6px 12px" min-width=0
                            if g.avatar != ""
                              image g.avatar width=24 height=24 border-radius=(g.glyph == "" and g.detail != "" ? 12 : 4) object-fit="cover" flex-shrink=0 aria-hidden=true
                            else
                              text g.glyph width="1.5rem" text-align="center" font="-exact-title3" color="-exact-secondary-label" flex-shrink=0 aria-hidden=true
                            text g.label font-weight=500 flex="0 1 auto" min-width=0 line-clamp=1
                            if g.detail != ""
                              text g.detail font="-exact-footnote" color="-exact-secondary-label" flex="0 100 auto" min-width=0 line-clamp=1
                  row align-items="flex-end" gap=8
                    // Pictures only: uploading other files is out of Excord's scope (llp/0001 §1).
                    input type="file" id="attach" multiple=true display="none" change=filesPicked testId="attach-input"
                    button press=attach aria-label="Add a file" testId="attach" disabled=(editing != "") margin-bottom=4
                      image "symbol:add"
                    // The field draws no ring of its own: the pill's border shows the focus. One line
                    // sits at Send's middle, whatever height the platform gives Send; Send stays at the
                    // bottom as the field grows.
                    row flex=1 min-width=0 min-height=0 align-items="center" padding="3px 3px 3px 14px" border-radius=21 border=(composing ? "1px solid AccentColor" : "1px solid -exact-separator")
                      focusin=composerFocus(true) focusout=composerFocus(false)
                      textarea id="composer" value=draft input=edit selectionchange=caretMoved paste=pastedInto key=keyed focus=focusComposer blur=blurComposer rows=1 field-sizing="content" max-height="9rem" min-height=0
                        placeholder=(chan.guild != "" ? `Message #${chan.name}` : chan.direct ? `Message @${chan.name}` : `Message ${chan.name}`) aria-label="Message" testId="composer" flex=1 min-width=0
                        line-height="1.4em" padding="8px 0px" border="none" outline="none" background-color="transparent"
                      // Discord's emoji button: dim until the pointer is over it.
                      button appearance="none" press=openDraftPicker aria-label="Emoji" testId="composer-emoji" padding="4px 6px" align-self="flex-end" margin-bottom=5 opacity=0.6
                        :hover
                          opacity = 1
                        text "🙂" font-size=20 line-height="24px"
                      button press=post disabled=((draft.trim() == "" and (picked.length == 0 or editing != "")) or pending(pastedPictures) or (editing != "" and pending(edited))) buttonStyle="filled"
                        retainFocus=true aria-label=(editing == "" ? "Send" : "Save edit") testId="send" align-self="flex-end"
                        image "symbol:send"
              if membersBeside
                scroll width="15rem" flex-shrink=0 border-left="1px solid -exact-separator" testId="members"
                  MemberList(rows=members, open=showProfile)
              if chan.ageRestricted and ageGate != "confirmed"
                AgeGate(age=age, asking=pending(age), confirm=confirmAge, leave=back)
      dialog id="members" aria-label="Members" testId="members-sheet"
        scroll max-height="70vh" width="20rem" max-width="100%"
          MemberList(rows=members, open=memberCard)
      dialog id="profile" aria-label=(profile.name != "" ? profile.name : "Profile") close=profileClosed testId="profile"
        column gap=10 padding=20 width="20rem" max-width="100%" align-items="flex-start"
          ProfileCard(profile=profile)
          button commandfor="profile" command="close" align-self="stretch" testId="profile-close"
            text "Done"
      // The quick switcher is the window's, so ⌘K shows it over whichever screen is on top.
      dialog id="switcher" aria-label="Find or Start a Conversation" close=switcherClosed testId="switcher"
        column gap=8 padding=12 width="28rem" max-width="100%"
          input type="search" value=switchQuery input=searchSwitcher key=switcherKey placeholder="Where would you like to go?" aria-label="Where would you like to go?" autofocus=true testId="switcher-search"
          scroll max-height="20rem"
            column
              for t in targets key=t.id
                button appearance="none" press=switchTo(t.server, t.id) aria-label=`${t.label}, ${t.detail}` testId=`switch-${t.id}` padding="8px 10px" border-radius=8
                  row gap=10 align-items="center" min-width=0
                    if t.avatar != ""
                      image t.avatar width=24 height=24 border-radius=12 object-fit="cover" flex-shrink=0 aria-hidden=true
                    else
                      text t.glyph width="1.5rem" text-align="center" color="-exact-secondary-label" flex-shrink=0 aria-hidden=true
                    text t.label font-weight=(t.unread ? 600 : 400) flex="0 1 auto" min-width=0 line-clamp=1
                    text t.detail font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 line-clamp=1
                    if t.mentions > 0
                      Badge(label=`${t.mentions}`, tint=some("-exact-system-red"))
          if targets.length == 0
            text (switchQuery == "" ? "Type a channel's or a person's name." : "Nothing matches.") font="-exact-footnote" color="-exact-secondary-label" padding="8px 10px"
      if viewing != "" and not locked
        for v in [viewing] key=v
          ImageViewer(src=v, alt=viewingAlt, panX=viewPanX, panY=viewPanY, zoom=viewZoom, geometry=viewerGeometry, release=viewerRelease, toggleZoom=viewerToggleZoom, close=closeViewer)
      dialog id="delete-failed" role="alertdialog" aria-label="Couldn’t Delete Message"
        text deleteError testId="delete-error"
        button commandfor="delete-failed" command="close" testId="delete-error-ok"
          text "OK"
      // Nothing of the account shows while the launch is locked or a return
      // has covered it.
      if session.locked or lockedOut
        column position="absolute" inset=0 align-items="center" justify-content="center" gap=16 padding=24 background-color="-exact-background" testId="lock-screen"
          image "symbol:lock" font-size=44 color="-exact-secondary-label"
          text "Excord is locked" font="-exact-title3"
          button press=unlockTap buttonStyle="filled" testId="unlock"
            text "Unlock"
