// Excord (apps/excord/llp/0001): a Discord client. Stage 1 is the transcript and
// its composer on iOS, against the stand-in world in `world.ts` (§3, §4.2).
//
// The data seam is §4.2's: `gatewayState` is the small snapshot (a version per
// channel), and the transcript is one resource, `loadWindow`, answering one
// contiguous run of at most 200 messages around `anchor` ("" is the live tail).
// Paging moves the anchor a page ahead of the reader (`scrolled`, with
// `reachstart` and `reachend` behind it); a jump replaces the window and places
// its target with `scrollIntoView`.

use Run, Block, Media, Embed, Reaction, ReplyRef, Message, Window, Channel, Gateway, Ack from "./shapes.contract"
use MessageRow from "./transcript.contract"
use Badge from "exact:content"

shape Time
  epochAtZero: number
  utcOffset: number

// Where a reader left a channel, kept for the session (§3.3).
shape Place
  channel: string
  anchor: string
  key: string
  offset: number
  atEnd: bool

routes nav
  home "/"
    channel "/c/:channel"

fn channelOf(cs: Channel[], id: string): Channel = match first(cs.filter(c => c.id == id)) { case some(c) => c, case none => Channel(id="", name="", topic="", version=0, total=0, unread=0, mentions=0, firstUnread="", firstUnreadAt=0, typing="", pending=0) }

// Drafts are kept per channel, across launches, as `channel\ttext` entries.
fn draftOf(drafts: string[], channel: string): string = match first(drafts.filter(d => d.startsWith(`${channel}\t`))) { case some(d) => d.slice(channel.length + 1), case none => "" }
fn withDraft(drafts: string[], channel: string, text: string): string[] = drafts.filter(d => not d.startsWith(`${channel}\t`)).concat(text == "" ? [] : [`${channel}\t${text}`])

fn placeOf(places: Place[], channel: string): Place = match first(places.filter(p => p.channel == channel)) { case some(p) => p, case none => Place(channel="", anchor="", key="", offset=0, atEnd=true) }

// A row's key for a message id: a send confirmed here keeps its nonce as key.
fn keyOf(rows: Message[], id: string): string = match first(rows.filter(r => r.id == id)) { case some(r) => r.key, case none => id }

component Excord
  state now = 0
  state open = ""
  state anchor = ""
  state away = false
  state topKey = ""
  state topOffset = 0
  state places: Place[] = []
  state drafts: string[] = [] persist
  state replyTo = ""
  state replyName = ""
  state editing = ""
  state divider = ""
  state dividerAt = 0
  state unreadCount = 0
  state unreadBar = false
  state baseTotal = 0
  state highlight = ""
  state target = ""
  state targetBlock = "center"
  state restoreOffset = 0
  state revealed: string[] = []
  state aimed = ""
  state aimedId = ""
  state aimedText = ""
  state aimedMine = false
  state aimedAuthor = ""
  state swipeKey = ""
  state swipeX = 0
  state dragging = false
  state live = false
  resource time = exactTime() as shape Time
  resource gateway = gatewayState() as shape Gateway else empty(state="connecting")
  derive chan = channelOf(gateway.channels, open)
  resource win = loadWindow(open, anchor, chan.version) as shape Window else empty()
  mutation sent as shape Ack queue refreshes gateway
  mutation settled as shape Ack refreshes gateway
  mutation changed as shape Ack queue refreshes gateway
  mutation jumped as shape Ack refreshes win then landJump
  derive rows = win.channel == open ? win.rows : []
  derive keys = rows.map(r => r.key)
  derive draft = draftOf(drafts, open)
  derive clock = time.epochAtZero + now
  derive newCount = max(0, chan.total - baseTotal)

  task tick mount
    every(60000, step)
  // A send is confirmed (or refused) a moment after it is made, as Discord's
  // MESSAGE_CREATE with its nonce follows the POST.
  task confirm when chan.pending > 0 key=chan.version
    after(300, confirmSends)
  task traffic when live and open != ""
    every(2500, trafficTick)
  task typingEnds when chan.typing != "" key=chan.version
    after(8000, stopTyping)
  task unhighlight when highlight != "" key=highlight
    after(2500, clearHighlight)

  action step
    now = performanceNow()
  action confirmSends
    send settled = settleSends(open)
  action trafficTick
    send changed = inject(open, "message", topKey, time.epochAtZero + performanceNow())
  action stopTyping
    send changed = inject(open, "typing-stop", topKey, time.epochAtZero + performanceNow())
  action clearHighlight
    highlight = ""

  // Opening a channel: at its newest (§3.1), at its first unread with the bar
  // (§3.2), or where this session left it (§3.3).
  action openChannel(id: string)
    let c = channelOf(gateway.channels, id)
    let p = placeOf(places, id)
    now = performanceNow()
    open = id
    replyTo = ""
    editing = ""
    highlight = ""
    away = false
    divider = c.firstUnread
    dividerAt = c.firstUnreadAt
    unreadCount = c.unread
    unreadBar = c.firstUnread != ""
    baseTotal = c.total
    if p.channel == id and not p.atEnd
      anchor = p.anchor
      target = p.key
      restoreOffset = p.offset
      targetBlock = "offset"
      send jumped = noteJump(id, p.key)
    else
      anchor = ""
      target = ""
    nav = push(nav, path("channel", id))
    if c.firstUnread != ""
      send changed = markRead(id)
  action leave(url: string)
    places = places.filter(p => p.channel != open).concat([Place(channel=open, anchor=anchor, key=topKey, offset=topOffset, atEnd=not away)])
    nav = go(nav, url)
  action back
    places = places.filter(p => p.channel != open).concat([Place(channel=open, anchor=anchor, key=topKey, offset=topOffset, atEnd=not away)])
    nav = back(nav)

  // The window: the reader's place decides which run of history it holds.
  // The window moves a page (100 rows) when the first visible row comes within 50
  // rows of its edge: `reachstart` alone gives one viewport of lead, which a fling
  // overruns. Paging up leaves that row at index 100 to 150 and paging down at 50
  // to 100, so the two thresholds never answer each other.
  action scrolled(x: number, y: number, e: ScrollEvent)
    let k = match e.firstVisibleKey { case some(k) => k, case none => "" }
    let at = keys.indexOf(k)
    let gap = e.scrollHeight - e.scrollTop - e.clientHeight
    let isAway = gap > 48
    if isAway != away
      away = isAway
      if isAway
        baseTotal = chan.total
        if anchor == ""
          anchor = win.pin
      else
        if anchor != "" and not win.hasAfter
          anchor = ""
    if at >= 0 and not pending(win) and target == ""
      if at < 50 and win.hasBefore
        anchor = win.firstId
      else
        if at > keys.length - 50 and win.hasAfter
          anchor = win.lastId
    topKey = k
    topOffset = e.firstVisibleOffset
  action older
    if win.hasBefore and not pending(win) and target == ""
      anchor = win.firstId
  action newer
    if win.hasAfter and not pending(win) and target == ""
      anchor = win.lastId

  // A jump: in the window it scrolls; outside it the window is replaced
  // around the target, placed in the same commit and again once the window
  // has landed (§3.6). While a jump is owed (`target`) the window does not page.
  action jumpTo(id: string)
    highlight = id
    if rows.map(r => r.id).includes(id)
      scrollIntoView("transcript", keyOf(rows, id), block="center", behavior="instant")
    else
      anchor = id
      target = id
      targetBlock = "center"
      scrollIntoView("transcript", id, block="center", behavior="instant")
      send jumped = noteJump(open, id)
  action jumpToUnread
    unreadBar = false
    if rows.map(r => r.id).includes(divider)
      scrollIntoView("transcript", keyOf(rows, divider), block="start", behavior="instant")
    else
      anchor = divider
      target = divider
      targetBlock = "start"
      scrollIntoView("transcript", divider, block="start", behavior="instant")
      send jumped = noteJump(open, divider)
  action dismissUnread
    unreadBar = false
  action toPresent
    away = false
    if anchor == ""
      scrollIntoView("transcript", keyOf(rows, win.lastId), block="end", behavior="smooth")
    else
      anchor = ""
      target = "end"
      targetBlock = "end"
      send jumped = noteJump(open, "")
  action landJump
    if target == "end"
      scrollIntoView("transcript", keyOf(rows, win.lastId), block="end", behavior="instant")
    else
      if targetBlock == "offset"
        scrollIntoView("transcript", target, offset=restoreOffset, behavior="instant")
      else
        if targetBlock == "start"
          scrollIntoView("transcript", keyOf(rows, target), block="start", behavior="instant")
        else
          scrollIntoView("transcript", keyOf(rows, target), block="center", behavior="instant")
    target = ""

  // The composer.
  action edit(v: string)
    drafts = withDraft(drafts, open, v)
  action keyed(k: string, e: KeyboardEvent)
    if k == "Enter" and not e.shiftKey
      preventDefault()
      post()
  action post
    if draft.trim() != ""
      if editing != ""
        send changed = editMessage(open, editing, draft.trim())
        editing = ""
      else
        send sent = sendMessage(open, draft.trim(), replyTo, time.epochAtZero + performanceNow())
        replyTo = ""
        if anchor != "" and win.hasAfter
          anchor = ""
      drafts = withDraft(drafts, open, "")
    focus("composer")
  action cancelReply
    replyTo = ""
  action cancelEdit
    editing = ""
    drafts = withDraft(drafts, open, "")

  // A message's own controls.
  action reveal(key: string)
    revealed = revealed.concat([key])
  action aim(key: string, id: string, mine: bool, text: string, author: string)
    aimedAuthor = author
    aimed = key
    aimedId = id
    aimedMine = mine
    aimedText = text
  action replyAimed
    replyTo = aimedId
    replyName = aimedAuthor
    focus("composer")
  action editAimed
    editing = aimedId
    drafts = withDraft(drafts, open, aimedText)
    focus("composer")
  action askDelete
    showModal("confirm-delete")
  action deleteAimed
    send changed = deleteMessage(open, aimed)
  action copyAimed
    copyText(aimedText)
  action copyLink
    copyText(`https://discord.com/channels/@me/${open}/${aimedId}`)
  action reactAimed(emoji: string)
    send changed = react(open, aimedId, emoji)
  action toggleReaction(id: string, emoji: string)
    send changed = react(open, id, emoji)
  action retry(key: string)
    send sent = retrySend(open, key)
  action discard(key: string)
    send changed = deleteMessage(open, key)
  action swipe(key: string, dx: number, dy: number)
    swipeKey = key
    swipeX = min(80, max(0, swipeX - dx))
    dragging = true
  action swipeEnd(id: string, author: string, vx: number, vy: number)
    if swipeX >= 56
      replyTo = id
      replyName = author
      haptic("impact-light")
      focus("composer")
    swipeX = 0
    dragging = false

  // The fixture's traffic (§4.4), on the drive's clock.
  action injectNow(what: string)
    send changed = inject(open, what, topKey, time.epochAtZero + performanceNow())
  action toggleLive
    live = not live

  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=leave interactive-widget="resizes-content" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="channels" position="absolute" inset=0
            header
              h1 "Exact Club"
            list id="channels" appearance="auto" flex=1 min-height=0
              section
                for c in gateway.channels key=c.id
                  button press=openChannel(c.id) testId=`channel-${c.id}` aria-label=`${c.name}${c.unread > 0 ? ", unread" : ""}`
                    row gap=8 align-items="center" flex=1 min-width=0
                      text "#" color="-exact-secondary-label"
                      text c.name font-weight=(c.unread > 0 ? 600 : 400) flex=1 min-width=0
                      if c.mentions > 0
                        Badge(label=`${c.mentions}`, tint=some("-exact-system-red"))
        else
          column navigationKey=`${e.id}` navigationScroll="transcript" position="absolute" inset=0
            header
              h2 `# ${chan.name}`
              button popovertarget="fixture-menu" aria-label="Fixture traffic" testId="fixture"
                image "symbol:more"
            column id="fixture-menu" popover="auto" role="menu" aria-label="Fixture traffic"
              button press=injectNow("message") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-message"
                text "Receive a message"
              button press=injectNow("burst") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-burst"
                text "Receive a burst"
              button press=injectNow("typing") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-typing"
                text "Someone types"
              hr
              button press=injectNow("edit-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-edit-above"
                text "Edit a message above"
              button press=injectNow("delete-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-delete-above"
                text "Delete a message above"
              button press=injectNow("react-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-react-above"
                text "React to a message above"
              button press=injectNow("embed-above") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-embed-above"
                text "Embed arrives above"
              hr
              button press=injectNow("fail-next") popovertarget="fixture-menu" popovertargetaction="hide" testId="inject-fail-next"
                text "Fail the next send"
              button press=toggleLive popovertarget="fixture-menu" popovertargetaction="hide" role="menuitemcheckbox" aria-checked=live testId="toggle-live"
                text "Live traffic"
            column flex=1 min-height=0 position="relative"
              list id="transcript" testId="transcript" appearance="none" virtualized=true estimated-item-height=72
                scroll-start="end" scrollFollowEnd=true scroll-behavior="smooth"
                reachstart=older reachend=newer scroll=scrolled
                flex=1 min-height=0 padding-top=8 padding-bottom=22
                for m in rows key=m.key
                  MessageRow(m=m, clock=clock, offset=time.utcOffset, isNew=(m.id == divider), lit=(m.id == highlight), revealed=revealed, swipeX=(m.key == swipeKey ? swipeX : 0), dragging=(dragging and m.key == swipeKey), reveal=reveal, jump=jumpTo, aim=aim, react=toggleReaction, retry=retry, discard=discard, swipe=swipe, swipeEnd=swipeEnd)
              column id="message-menu" popover="auto" role="menu"
                button press=replyAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-reply"
                  text "Reply"
                  image "symbol:reply"
                button press=reactAimed("👍") popovertarget="message-menu" popovertargetaction="hide" testId="menu-thumbs"
                  text "👍 Thumbs Up"
                button press=reactAimed("❤️") popovertarget="message-menu" popovertargetaction="hide" testId="menu-heart"
                  text "❤️ Heart"
                button press=reactAimed("😂") popovertarget="message-menu" popovertargetaction="hide" testId="menu-laugh"
                  text "😂 Laugh"
                hr
                button press=copyAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-copy"
                  image "symbol:copy"
                  text "Copy Text"
                button press=copyLink popovertarget="message-menu" popovertargetaction="hide" testId="menu-link"
                  image "symbol:link"
                  text "Copy Message Link"
                if aimedMine
                  hr
                  button press=editAimed popovertarget="message-menu" popovertargetaction="hide" testId="menu-edit"
                    image "symbol:pencil"
                    text "Edit Message"
                  button press=askDelete destructive=true popovertarget="message-menu" popovertargetaction="hide" testId="menu-delete"
                    image "symbol:delete"
                    text "Delete Message"
              dialog id="confirm-delete" role="alertdialog" aria-label="Delete Message"
                text "Are you sure you want to delete this message?"
                button press=deleteAimed destructive=true commandfor="confirm-delete" command="close" testId="delete-confirm"
                  text "Delete"
                button commandfor="confirm-delete" command="close" testId="delete-cancel"
                  text "Cancel"
              if unreadBar
                row position="absolute" top=0 left=0 right=0 align-items="center" column-gap=12 padding="0px 16px" flex-wrap="wrap" background-color="AccentColor" testId="unread"
                  button appearance="none" press=jumpToUnread testId="unread-bar" flex="1 1 12rem" min-width=0 padding="9px 0px"
                    text `${unreadCount} new ${unreadCount == 1 ? "message" : "messages"} since ${formatTime(dividerAt, time.utcOffset, "short")}` color="AccentColorText" font="-exact-footnote" font-weight=600
                  button appearance="none" press=dismissUnread testId="mark-read" padding="9px 0px"
                    text "Mark As Read" color="AccentColorText" font="-exact-footnote" font-weight=600
              if chan.typing != ""
                text chan.typing testId="typing" position="absolute" left=16 right=16 bottom=2 font="-exact-caption1" color="-exact-secondary-label" line-clamp=1
              if away and (newCount > 0 or win.hasAfter)
                button press=toPresent buttonStyle="filled" testId="jump-present" position="absolute" bottom=28 right=16
                  text (newCount > 0 ? `${newCount} new ${newCount == 1 ? "message" : "messages"}` : "Jump to Present")
            column padding="4px 12px 6px"
              if replyTo != ""
                row align-items="center" gap=8 padding="4px 4px"
                  text `Replying to ${replyName}` font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 testId="replying"
                  button press=cancelReply aria-label="Cancel reply" testId="cancel-reply"
                    image "symbol:close"
              if editing != ""
                row align-items="center" gap=8 padding="4px 4px"
                  text "Editing message" font="-exact-footnote" color="-exact-secondary-label" flex=1 min-width=0 testId="editing"
                  button press=cancelEdit aria-label="Cancel edit" testId="cancel-edit"
                    image "symbol:close"
              row align-items="flex-end" padding="4px 4px 4px 12px" border-radius=20 border="1px solid -exact-separator"
                textarea id="composer" value=draft input=edit key=keyed rows=1 field-sizing="content" max-height="9rem"
                  placeholder=`Message #${chan.name}` aria-label="Message" testId="composer" flex=1 min-width=0
                  border="none" background-color="transparent"
                button press=post disabled=(draft.trim() == "") buttonStyle="filled"
                  retainFocus=true aria-label="Send" testId="send"
                  image "symbol:send"
