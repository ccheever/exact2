// The wiring's reviews (Sol, Grok): one test a finding the view shows.

test "a failed ack at the end is sent again (wiring review: Grok 4)"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages/1562887009075210000/ack" times 1
  clock +500 real
  tap "channel-general"
  clock settle
  clock +1100
  clock data
  clock +1100
  clock data
  expect state chan.unread == 0

test "a channel never read jumps to its first message (wiring review: Sol 8)"
  clock +500 real
  tap "channel-announcements"
  clock settle
  expect text "unread-bar" == "50+ new messages since 8:27 AM"
  tap "unread-bar"
  clock settle
  expect state anchor == "0"
  expect tree has "new-divider"
  expect tree has "message-1432427377459200001"

test "the server menu switches the list to the direct messages, which open like a channel, and is kept"
  clock +500 real
  tap "server"
  tap "server-@me"
  clock settle
  expect state server == "@me"
  expect tree missing "channel-general"
  tap "Weekend rides"
  clock settle
  expect state chan.name == "Weekend rides"
  expect state win.hasAfter == false
  back
  clock settle
  reload
  clock +500 real
  expect state server == "@me"

test "image spoilers with and without dimensions wait for disclosure"
  clock +500 real
  tap "channel-random"
  clock settle
  tap "transcript" into "1556955556722245885"
  clock settle
  tap "transcript" into "1555571352889458936"
  clock settle
  expect tree has "media-1555571352889458936-1555571352889561158"
  expect tree has "reveal-media-1555571352889458936-1555571352889561158"
  expect tree missing "media-image-1555571352889458936-1555571352889561158"
  tap "reveal-media-1555571352889458936-1555571352889561158"
  clock settle
  expect state revealed.length == 1
  expect tree has "media-image-1555571352889458936-1555571352889561158"
  expect tree missing "reveal-media-1555571352889458936-1555571352889561158"
  tap "transcript" into "1557156753160798473"
  clock settle
  expect tree has "reveal-media-1557156753160798473-1557156753160900848"
  expect tree missing "media-image-1557156753160798473-1557156753160900848"
  type "reveal-media-1557156753160798473-1557156753160900848" key "Enter"
  clock settle
  expect state revealed.length == 2
  expect tree has "media-image-1557156753160798473-1557156753160900848"

test "failed history can be retried without reopening the channel"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages"
  clock +500 real
  tap "channel-general"
  clock settle
  expect text "history-error" == "Couldn’t load messages."
  expect tree has "retry-history"
  expect tree missing "history-loading"
  expect state pageTries == 3
  type "composer" "Keep this draft"
  pass fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages"
  type "retry-history" key "Enter"
  clock settle
  expect tree has "message-1562887009075210000"
  expect tree missing "history-error"
  expect text "composer" == "Keep this draft"

test "a failed page leaves cached messages readable and another channel loads"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages"
  tap "transcript" into "1562732896249194217"
  clock settle
  expect text "history-error" == "Couldn’t load more messages."
  expect tree has "message-1562732896249194217"
  expect state pageTries == 3
  back
  clock settle
  tap "channel-help"
  clock settle
  expect tree missing "history-error"
  expect state pageTries == 0
  back
  clock settle
  pass fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages"
  tap "channel-general"
  clock settle
  expect tree missing "history-error"
  expect state win.firstId == "1562033782335219374"

test "a failed older page does not block a jump to a different history page"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages?limit=50&before="
  tap "transcript" into "1562624645306263268"
  clock settle
  expect text "history-error" == "Couldn’t load more messages."
  expect state pageTries == 3
  tap "reply-to-1562624645306263268"
  clock settle
  expect state anchor == "1518635600276626020"
  expect tree has "message-1518635600276626020"
  expect tree missing "history-error"
  expect state pageTries == 0

test "retrying older history at the exact top keeps the first visible message"
  size 1100x760
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages?limit=50&before="
  type "transcript" key "Home"
  clock settle
  expect state pageTries == 3
  expect state historyStart == true
  expect state topKey == "1562618399954052832"
  pass fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages?limit=50&before="
  tap "retry-history"
  clock settle
  expect tree has "message-1562618399954052832"
  expect state target == ""
  expect state historyStart == false

test "choosing Reply during an edit restores the draft and sends a reply"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect tree missing "editing"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "a saved draft"
  tap "send"
  clock settle
  expect state win.rows.49 .plain == "original message"
  expect state win.rows.50 .plain == "a saved draft"
  expect state win.rows.50 .reply.0 .id == "1562887009075210000"

test "editing temporarily puts a reply aside and restores it on cancel or save"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "reply draft"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  expect state editing == "1562888267366400000"
  expect state replyTo == ""
  expect tree missing "replying"
  type "composer" "unsaved edit"
  type "composer" key "Escape"
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "reply draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "saved edit"
  tap "send"
  clock settle
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "reply draft"
  expect state win.rows.49 .plain == "saved edit"
