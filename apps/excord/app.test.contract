test "a poll takes the reader's vote, shows the results, and gives the vote back"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-random"
  clock data
  clock settle
  tap "transcript" into "1562732834387394850"
  clock settle
  expect disabled "poll-1562732834387394850-vote"
  tap "poll-1562732834387394850-1"
  tap "poll-1562732834387394850-2"
  expect state pollPicks.length == 1
  expect state pollPicks.0 == "1562732834387394850:2"
  tap "poll-1562732834387394850-vote"
  clock data
  clock settle
  expect tree has "poll-1562732834387394850-unvote"
  expect text "poll-1562732834387394850-2-votes" == "4 votes"
  expect text "poll-1562732834387394850-2-share" == "44%"
  tap "poll-1562732834387394850-unvote"
  clock data
  clock settle
  expect tree has "poll-1562732834387394850-vote"
  tap "poll-1562732834387394850-results"
  clock settle
  expect text "poll-1562732834387394850-1-votes" == "5 votes"
  // Another member's vote arrives from the gateway.
  request POST "/control/vote" {"channel_id": "1191168914235588610", "message_id": "1562732834387394850", "user_id": "1191168914227200001", "answer_id": 3, "add": true}
  clock +100 real
  clock data
  clock settle
  expect text "poll-1562732834387394850-3-votes" == "1 vote"

