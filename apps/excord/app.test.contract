test "a jump whose history arrives later still lands on its target (review: Sol 3)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562624645306263268"
  clock settle
  tap "fixture"
  tap "toggle-slow"
