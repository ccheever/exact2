  tap "reply-to-1562624645306263268"
  clock data
  expect state win.anchor == "1562618399954052832"
  expect state target == "1518635600276626020"
  clock +400
  clock settle
  expect state win.anchor == "1518635600276626020"
  expect state target == ""
  expect state highlight == "1518635600276626020"
  expect tree has "message-1518635600276626020"

