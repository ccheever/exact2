  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "||secret|| and **bold**"
  tap "send"
  clock +350
  clock settle
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  expect text "composer" == "||secret|| and **bold**"

test "an edit the server refuses keeps its text and says why (review: Sol 4)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "first try"
  tap "send"
  clock +350
  clock settle
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "second try"
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  tap "send"
  clock settle
  expect text "composer" == "second try"
  expect tree has "edit-error"

test "a send settles while its reader is in another channel (review: Sol 5)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "sent then left"
  tap "send"
  back
  clock settle
  tap "channel-random"
  clock settle
  clock +1000
  back
  clock settle
  tap "channel-general"
  clock data
  expect state win.rows.49 .state == "sent"

test "the unread jump survives the first unread message's deletion (review: Sol 6)"
