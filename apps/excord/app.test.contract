test "paging is not refused while another refresh is in flight (review: Grok 6)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "toggle-slow"
  clock data
  tap "fixture"
  tap "inject-typing"
  clock data
  tap "transcript" into "1562732896249194217"
  clock +400
  clock settle
  // The lead's pages go on until 100 rows stand above the reader (F1); slow pages land on the
  // pump, so the clock runs on until the chain has ended and its end is what is checked.
  clock +3000
  clock settle
  clock +3000
  clock settle
  expect state win.firstId == "1561797858988926588"

test "a jump whose history arrives later still lands on its target (review: Sol 3)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562624645306263268"
  clock settle
  tap "fixture"
  tap "toggle-slow"
  clock data
  tap "reply-to-1562624645306263268"
  clock data
  expect state win.anchor == "1562033782335219374"
  expect state target == "1518635600276626020"
  clock +400
  clock settle
  // (landed: the window's anchor then follows the lead toward older pages, F1, so it isn't asserted)
  expect state target == ""
  expect state highlight == "1518635600276626020"
  expect tree has "message-1518635600276626020"
  expect state topKey == "1518631444790909538"
  // The lead waits for the highlight to clear, then pages above the target; the reader's first
  // visible row stays the same (macOS lost it when a page landed as the jump was placed).
  clock +3000
  clock settle
  clock +3000
  clock settle
  expect state highlight == ""
  expect state win.firstId == "1516268419677166056"
  expect state topKey == "1518631444790909538"
  expect tree has "message-1518635600276626020"

