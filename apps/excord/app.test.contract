// Excord's transcript on the stand-in world (Excord LLP 0001 §3; `world.ts`). The
// world's newest message is five minutes before this epoch; #general holds 10,000
// messages with its last 37 unread, #help 1,200 with its last 260 unread.
// A test asserts what every host reports alike: the window (`anchor`, `win`), the
// rows mounted, the reader's first visible row where nothing has just been
// estimated. Where a property is a position on screen, a drive measures it.
epoch "2026-10-22T18:00:00Z"
time-zone "America/Los_Angeles"

test "a channel opens at its newest message, live (§3.1)"
  tap "channel-general"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state win.hasAfter == false
  expect tree has "message-0037262130000010000"
  expect tree missing "jump-present"

test "unread: the bar says how many since when, and lands on the New divider (§3.2)"
  tap "channel-help"
  clock settle
  expect text "unread-bar" == "260 new messages since 8:09 AM"
  expect tree missing "new-divider"
  tap "unread-bar"
  clock settle
  expect tree has "new-divider"
  expect state anchor == "0037062287000000940"
  expect state target == ""
  expect tree missing "unread"

test "a channel reopens where its reader left it (§3.3)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037258518100009964"
  clock settle
  expect state away == true
  expect state anchor == "0037241759900009901"
  back
  clock settle
  tap "channel-random"
  clock settle
  back
  clock settle
  tap "channel-general"
  clock settle
  expect state anchor == "0037241759900009901"
  expect state away == true
  expect tree has "message-0037258518100009964"
  expect tree missing "message-0037262130000010000"

test "reading back moves the window a page ahead of the reader, who stays put (§3.4)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037235381600009829"
  clock settle
  expect state win.firstId == "0037186915100009701"
  expect state win.rows.0 .key == "0037186915100009701"
  expect tree has "message-0037235381600009829"
  expect state win.hasAfter == true

test "changes above the viewport leave the reader's row where it is (§3.5)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037261654000009984"
  clock settle
  expect state topKey == "0037261654000009984"
  expect state topOffset == 0
  tap "fixture"
  tap "inject-edit-above"
  clock data
  tap "fixture"
  tap "inject-react-above"
  clock data
  tap "fixture"
  tap "inject-embed-above"
  clock data
  tap "fixture"
  tap "inject-delete-above"
  clock data
  clock settle
  expect state topKey == "0037261654000009984"
  expect state topOffset == 0

test "a reply's original far back loads around it, lit, and Jump to Present returns (§3.6)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037255874700009956"
  clock settle
  tap "reply-to-0037255874700009956"
  clock settle
  expect state anchor == "0036207094100006756"
  expect state highlight == "0036207094100006756"
  expect tree has "message-0036207094100006756"
  expect state win.hasAfter == true
  expect text "jump-present" == "Jump to Present"
  clock +3000
  expect state highlight == ""
  tap "jump-present"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state win.hasAfter == false
  expect tree missing "jump-present"

test "at the end a burst follows; nothing to jump to (§3.7)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "inject-burst"
  clock settle
  expect state away == false
  expect state win.rows.199 .author == "Lin Chen"
  expect state win.rows.194 .author == "Ada"
  expect tree missing "jump-present"

test "away from the end nothing moves, and a pill counts what arrived (§3.8)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037258518100009964"
  clock settle
  expect state away == true
  tap "fixture"
  tap "inject-burst"
  clock settle
  expect state anchor == "0037241759900009901"
  expect tree has "message-0037258518100009964"
  expect text "jump-present" == "6 new messages"
  tap "jump-present"
  clock settle
  expect state away == false
  expect tree missing "jump-present"

test "a send shows at once, dimmed, and its confirmation keeps its row (§3.9)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "Shipping the anchor fix now"
  tap "send"
  clock data
  expect text "composer" == ""
  expect state win.rows.199 .state == "pending"
  expect state win.rows.199 .key == "0037262160000020002"
  clock +350
  clock settle
  expect state win.rows.199 .state == "sent"
  expect state win.rows.199 .key == "0037262160000020002"
  expect state win.rows.199 .id == "0037262160000020003"

test "a failed send stays, marked, and Retry sends it (§3.9)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "inject-fail-next"
  type "composer" "This one will fail"
  tap "send"
  clock +350
  clock settle
  expect state win.rows.199 .state == "failed"
  tap "retry-0037262160000020002"
  clock data
  expect state win.rows.199 .state == "pending"
  clock +350
  clock settle
  expect state win.rows.199 .state == "sent"
  expect tree missing "failed-0037262160000020002"

test "Return sends and Shift-Return breaks the line (§3.12, §3.13)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "first line"
  type "composer" key "Shift+Enter"
  expect text "composer" == "first line\n"
  type "composer" "first line\nsecond line"
  type "composer" key "Enter"
  clock settle
  expect text "composer" == ""
  expect state win.rows.199 .plain == "first line\nsecond line"

test "a draft survives switching channels and relaunching (§3.12)"
  tap "channel-general"
  clock settle
  type "composer" "half a thought"
  back
  clock settle
  tap "channel-random"
  clock settle
  expect text "composer" == ""
  back
  clock settle
  tap "channel-general"
  clock settle
  expect text "composer" == "half a thought"
  back
  clock settle
  reload
  tap "channel-general"
  clock settle
  expect text "composer" == "half a thought"

test "one author within seven minutes is one group; a day change draws its date (§3.15)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  expect tree has "author-0037262028900009997"
  expect tree missing "author-0037262057500009998"
  tap "transcript" into "0037258455600009961"
  clock settle
  expect text "day-0037258455600009961" == "Oct 22, 2026"
  expect tree missing "day-0037258480400009962"

// The reviews of the first commit (Sol, Grok): one test a finding.

test "a send from history returns to the live tail and lands at its end (review: Sol 2, Grok 1)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037235381600009829"
  clock settle
  expect state win.hasAfter == true
  type "composer" "Back to the present"
  tap "send"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state endGap == 0
  expect tree has "message-0037262160000020002"

test "a send from a window pinned inside the tail shows at the end (review: Sol 2, Grok 1)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037258518100009964"
  clock settle
  expect state away == true
  type "composer" "Still here"
  tap "send"
  clock settle
  expect state anchor == ""
  expect state endGap == 0
  expect tree has "message-0037262160000020002"

test "Edit starts from the message's Markdown, spoilers kept (review: Sol 1)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "||secret|| and **bold**"
  tap "send"
  clock +350
  clock settle
  tap "row-0037262160000020002" contextmenu
  tap "menu-edit"
  expect text "composer" == "||secret|| and **bold**"

test "an edit the server refuses keeps its text and says why (review: Sol 4)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "first try"
  tap "send"
  clock +350
  clock settle
  tap "row-0037262160000020002" contextmenu
  tap "menu-edit"
  type "composer" "second try"
  tap "row-0037262160000020002" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  tap "send"
  clock settle
  expect text "composer" == "second try"
  expect tree has "edit-error"

test "a send settles while its reader is in another channel (review: Sol 5)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "sent then left"
  tap "send"
  back
  clock settle
  tap "channel-random"
  clock settle
  clock +1000
  back
  clock settle
  tap "channel-general"
  clock data
  expect state win.rows.199 .state == "sent"

test "the unread jump survives the first unread message's deletion (review: Sol 6)"
  tap "channel-general"
  clock settle
  tap "fixture"
  tap "inject-delete-unread"
  clock settle
  tap "unread-bar"
  clock settle
  expect tree has "new-divider"
  expect state target == ""

test "the pill counts arrivals; a deletion does not cancel one (review: Sol 7, Grok 3)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037258518100009964"
  clock settle
  expect state away == true
  tap "fixture"
  tap "inject-delete-above"
  clock settle
  tap "fixture"
  tap "inject-message"
  clock settle
  expect text "jump-present" == "1 new message"

test "within one row's height of the end, a new message is followed (review: Sol 8, Grok 2)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" drag 0 40 hold 150
  clock settle
  expect state away == false
  tap "fixture"
  tap "inject-message"
  clock settle
  expect state endGap == 0
  expect tree missing "jump-present"

test "a reply to a deleted message does not jump (review: Grok 5)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037242607000009923"
  clock settle
  expect state anchor == "0037241759900009901"
  tap "reply-to-0037242607000009923"
  clock settle
  expect state anchor == "0037241759900009901"
  expect state highlight == ""

test "what was read at the end is acknowledged (review: Grok 4)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "inject-burst"
  clock settle
  clock +2000
  back
  clock settle
  expect state gateway.channels.0 .unread == 0

test "paging is not refused while another refresh is in flight (review: Grok 6)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "toggle-slow"
  clock data
  tap "fixture"
  tap "inject-typing"
  clock data
  tap "transcript" into "0037235381600009829"
  clock +400
  clock settle
  expect state win.firstId == "0037186915100009701"

test "a jump whose history arrives later still lands on its target (review: Sol 3)"
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "0037255874700009956"
  clock settle
  tap "fixture"
  tap "toggle-slow"
  clock data
  tap "reply-to-0037255874700009956"
  clock data
  expect state win.anchor == "0037241759900009901"
  expect state target == "0036207094100006756"
  clock +400
  clock settle
  expect state win.anchor == "0036207094100006756"
  expect state target == ""
  expect state highlight == "0036207094100006756"
  expect tree has "message-0036207094100006756"
