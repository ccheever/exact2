test "image spoilers with and without dimensions wait for disclosure"
  // #random's single spoiler pictures: one with no dimensions, then one with them (main's fixture tiles some photos,
  // which moved the spoilers onto these messages).
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-random"
  clock settle
  tap "transcript" into "1556955556722245885"
  clock data
  clock settle
  tap "transcript" into "1553618685438984394"
  clock settle
  // It is a page further back than the window holds: the first tap brings the window there, this one lands.
  tap "transcript" into "1553618685438984394"
  clock settle
  expect tree has "media-1553618685438984394-1553618685439086202"
  expect tree has "reveal-media-1553618685438984394-1553618685439086202"
  expect tree missing "media-image-1553618685438984394-1553618685439086202"
  tap "reveal-media-1553618685438984394-1553618685439086202"
  clock settle
  expect state revealed.length == 1
  expect tree has "media-image-1553618685438984394-1553618685439086202"
  expect tree missing "reveal-media-1553618685438984394-1553618685439086202"
  tap "transcript" into "1557059859277414659"
  clock settle
  expect tree has "reveal-media-1557059859277414659-1557059859277516980"
  expect tree missing "media-image-1557059859277414659-1557059859277516980"
  // Space presses a focused button on every host; on a Mac, Return is the default button's.
  type "reveal-media-1557059859277414659-1557059859277516980" key " "
  clock settle
  expect state revealed.length == 2
  expect tree has "media-image-1557059859277414659-1557059859277516980"

test "choosing Reply during an edit restores the draft and sends a reply"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect tree missing "editing"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "a saved draft"
  tap "send"
  clock settle
  expect state win.rows.49 .plain == "original message"
  expect state win.rows.50 .plain == "a saved draft"
  expect state win.rows.50 .reply.0 .id == "1562887009075210000"

test "editing temporarily puts a reply aside and restores it on cancel or save"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "reply draft"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  expect state editing == "1562888267366400000"
  expect state replyTo == ""
  expect tree missing "replying"
  type "composer" "unsaved edit"
  type "composer" key "Escape"
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "reply draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "saved edit"
  tap "send"
  clock settle
  expect state editing == ""
  expect state replyTo == "1562887009075210000"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "reply draft"
  expect state win.rows.49 .plain == "saved edit"

