test "Command-K opens the quick switcher from a channel's composer"
  clock +500 real
  tap "channel-general"
  clock data
  clock settle
  type "composer" key "Meta+k"
  clock settle
  expect state switching == true
  expect state draft == ""
  type "switcher-search" "hel"
  clock data
  type "switcher-search" key "Enter"
  clock data
  clock settle
  expect state chan.name == "help"

test "Up in an empty composer edits your last message; Escape ends the edit"
  clock +500 real
  tap "channel-general"
  clock data
  clock settle
  type "composer" "a first draft"
  tap "send"
  clock data
  clock settle
  type "composer" key "ArrowUp"
  clock settle
  expect state draft == "a first draft"
  expect tree has "editing"
  type "composer" key "Escape"
  clock settle
  expect state editing == ""
  expect tree missing "editing"
  expect state draft == ""

