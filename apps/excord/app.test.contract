  tap "channel-general"
  clock data
  clock settle
  tap "row-1562883971870631694" contextmenu
  clock settle
  tap "menu-react"
  clock settle
  type "picker-search" "ferr"
  clock data
  tap "pick-e501"
  clock data
  clock settle
  expect state picking == false
  expect state changed.ok == true
  expect tree has "reaction-1562883971870631694-501"

test "the quick switcher opens a channel by name"
  clock +500 real
  tap "switcher-open"
  clock settle
  type "switcher-search" "hel"
  clock data
  type "switcher-search" key "Enter"
  clock data
  clock settle
  expect state chan.name == "help"
