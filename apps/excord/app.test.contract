test "within one row's height of the end, a new message is followed (review: Sol 8, Grok 2)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" drag 0 40 hold 150
  clock settle
  expect state away == false
  tap "fixture"
  tap "inject-message"
  clock settle
  expect state endGap == 0
  expect tree missing "jump-present"

