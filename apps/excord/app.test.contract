  tap "fixture"
  tap "inject-edit-above"
  clock data
  tap "fixture"
  tap "inject-react-above"
  clock data
  tap "fixture"
  tap "inject-embed-above"
  clock data
  tap "fixture"
  tap "inject-delete-above"
  clock data
  clock settle
  expect state topKey == "1562867046130132736"
  expect state topOffset == 0

test "a reply's original far back loads around it, lit, and Jump to Present returns (§3.6)"
