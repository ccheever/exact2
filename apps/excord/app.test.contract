// Excord's transcript on the fixture server (Excord LLP 0001 §3, §4.4), over the
// real protocol client: the test run starts the fixture with --world transcript
// --reset-on-identify, so each launch's IDENTIFY starts from the same world.
// The world's newest message is five minutes before this epoch; #general holds
// 10,000 messages with its last 37 unread, #help 1,200 with its last 260 unread.
// A channel opens on one page of 50 messages (49 shown: the first waits for the
// one before it), and the window grows a page at a time, each the moment the last
// lands, while the reader is within 100 rows of its top (llp/0001 §2; x2-perf4's
// fling plan, F1), so a test reads back by landing the reader there.
// A test asserts what every host reports alike: the window (`anchor`, `win`), the
// rows mounted, the reader's first visible row where nothing has just been
// estimated. Where a property is a position on screen, a drive measures it.
// The gateway's READY follows HELLO and IDENTIFY on real time, which no clock step
// waits for: each launch (and relaunch) runs `clock settle` (the `after(1, …)` task
// that sends IDENTIFY), waits for READY with the clock frozen, `clock until state
// gateway.state == "ready"` (docs/testing.md: a protocol's later state, not `clock
// +N real`, which a loaded machine outruns), then `clock settle` again for what READY
// armed a commit later (the directory, the channel list). The
// picture viewer's tests are viewer.test.contract, the routing ones routing.test.contract,
// Translate's translate.test.contract, the member list's and cards' members.test.contract,
// the typing line's typing.test.contract, a failed history page's history.test.contract.
epoch "2026-10-22T18:00:00Z"
time-zone "America/Los_Angeles"

test "the fixture account menu has reachable account details"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "account"
  tap "account-details"
  expect text "account-identity" == "Sample account: Charlie"
  tap "account-close"
  tap "channel-general"
  clock settle
  expect tree has "composer"

test "a channel opens at its newest message, live (§3.1)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state win.hasAfter == false
  expect tree has "message-1562887009075210000"
  expect tree missing "jump-present"

test "unread: the bar says how many since when, and lands on the New divider (§3.2)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-help"
  clock settle
  expect text "unread-bar" == "50+ new messages since 7:47 AM"
  expect tree missing "new-divider"
  tap "unread-bar"
  clock settle
  expect tree has "new-divider"
  expect state anchor == "1552174792428225378"
  expect state target == ""
  expect tree missing "unread"

test "the unread bar goes once a send lands, not when it fails"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-help"
  clock settle
  expect tree has "unread-bar"
  tap "fixture"
  tap "inject-fail-next"
  type "composer" "caught up"
  tap "send"
  clock +350
  clock settle
  expect tree has "unread-bar"
  tap "Retry"
  clock data
  clock settle
  expect tree missing "unread"

test "a channel reopens where its reader left it (§3.3)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  expect state anchor == "1562033782335219374"
  back
  clock settle
  tap "channel-random"
  clock settle
  back
  clock settle
  tap "channel-general"
  clock settle
  expect state anchor == "1562033782335219374"
  expect state away == true
  expect tree has "message-1562755578936174328"

test "reading back moves the window a page ahead of the reader, who stays put (§3.4)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562732896249194217"
  clock settle
  expect state anchor == "1562033782335219374"
  expect state win.firstId == "1561797858988926588"
  expect state win.rows.0 .key == "1561797858988926588"
  expect tree has "message-1562732896249194217"

test "the lead pages on with no scroll by the reader and stops once 100 rows stand above them (F1)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  // One scroll: the reader's row, 40 from the end, is 9 rows below the window's first. The first page
  // brings 50 rows above it (59), so the lead (leadOlder) asks the next with no scroll by the reader;
  // at 109 it stops. Without leadOlder the window stops after the first page.
  tap "transcript" into "1562732896249194217"
  clock settle
  expect state topKey == "1562732896249194217"
  expect state win.firstId == "1561797858988926588"
  expect state win.need == ""
  clock +5000
  clock settle
  expect state win.firstId == "1561797858988926588"
  expect state pageTries == 0

test "changes above the viewport leave the reader's row where it is (§3.5)"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562867046130132736"
