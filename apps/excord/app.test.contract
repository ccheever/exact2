// Excord's transcript on the fixture server (Excord LLP 0001 §3, §4.4), over the
// real protocol client: the test run starts the fixture with --world transcript
// --reset-on-identify, so each launch's IDENTIFY starts from the same world.
// The world's newest message is five minutes before this epoch; #general holds
// 10,000 messages with its last 37 unread, #help 1,200 with its last 260 unread.
// A channel opens on one page of 50 messages (49 shown: the first waits for the
// one before it), and the window grows a page at a time as the reader nears its
// top (llp/0001 §2), so a test reads back by landing the reader there.
// A test asserts what every host reports alike: the window (`anchor`, `win`), the
// rows mounted, the reader's first visible row where nothing has just been
// estimated. Where a property is a position on screen, a drive measures it.
// The gateway's READY follows HELLO and IDENTIFY on real time, which no clock step
// waits for: each launch lets 500 ms of it pass.
epoch "2026-10-22T18:00:00Z"
time-zone "America/Los_Angeles"

test "the fixture account menu has reachable account details"
  clock +500 real
  tap "account"
  tap "account-details"
  expect text "account-identity" == "Sample account: Charlie"
  tap "account-close"
  tap "channel-general"
  clock settle
  expect tree has "composer"

test "a channel opens at its newest message, live (§3.1)"
  clock +500 real
  tap "channel-general"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state win.hasAfter == false
  expect tree has "message-1562887009075210000"
  expect tree missing "jump-present"

test "unread: the bar says how many since when, and lands on the New divider (§3.2)"
  clock +500 real
  tap "channel-help"
  clock settle
  expect text "unread-bar" == "50+ new messages since 7:47 AM"
  expect tree missing "new-divider"
  tap "unread-bar"
  clock settle
  expect tree has "new-divider"
  expect state anchor == "1554504989743776684"
  expect state target == ""
  expect tree missing "unread"

test "a channel reopens where its reader left it (§3.3)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  expect state anchor == "1562740055536051951"
  back
  clock settle
  tap "channel-random"
  clock settle
  back
  clock settle
  tap "channel-general"
  clock settle
  expect state anchor == "1562740055536051951"
  expect state away == true
  expect tree has "message-1562755578936174328"

test "reading back moves the window a page ahead of the reader, who stays put (§3.4)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562732896249194217"
  clock settle
  expect state anchor == "1562618399954052832"
  expect state win.firstId == "1562033782335219374"
  expect state win.rows.0 .key == "1562033782335219374"
  expect tree has "message-1562732896249194217"

test "changes above the viewport leave the reader's row where it is (§3.5)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562867046130132736"
  clock settle
  expect state topKey == "1562867046130132736"
  expect state topOffset == 0
  tap "fixture"
  tap "inject-edit-above"
  clock data
  tap "fixture"
  tap "inject-react-above"
  clock data
  tap "fixture"
  tap "inject-embed-above"
  clock data
  tap "fixture"
  tap "inject-delete-above"
  clock data
  clock settle
  expect state topKey == "1562867046130132736"
  expect state topOffset == 0

test "a reply's original far back loads around it, lit, and Jump to Present returns (§3.6)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562624645306263268"
  clock settle
  tap "reply-to-1562624645306263268"
  clock settle
  expect state anchor == "1518635600276626020"
  expect state highlight == "1518635600276626020"
  expect tree has "message-1518635600276626020"
  expect state win.hasAfter == true
  expect text "jump-present" == "Jump to Present"
  clock +3000
  expect state highlight == ""
  tap "jump-present"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state win.hasAfter == false
  expect tree missing "jump-present"

test "at the end a burst follows; nothing to jump to (§3.7)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "inject-burst"
  clock settle
  expect state away == false
  expect state win.rows.54 .author == "Lin Chen"
  expect state win.rows.49 .author == "Ada"
  expect tree missing "jump-present"

test "away from the end nothing moves, and a pill counts what arrived (§3.8)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  tap "fixture"
  tap "inject-burst"
  clock settle
  expect state anchor == "1562740055536051951"
  expect tree has "message-1562755578936174328"
  expect text "jump-present" == "6 new messages"
  tap "jump-present"
  clock settle
  expect state away == false
  expect tree missing "jump-present"

test "a send shows at once, dimmed, and its confirmation keeps its row (§3.9)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  request POST "/control/hold-sends" {"on": true}
  type "composer" "Shipping the anchor fix now"
  tap "send"
  clock +1
  expect text "composer" == ""
  // The row's key is the send's nonce, the app's clock at the send, which differs
  // by host; render.test.ts holds it across the confirmation.
  expect state win.rows.49 .state == "pending"
  expect state win.rows.49 .plain == "Shipping the anchor fix now"
  request POST "/control/hold-sends" {"on": false}
  clock data
  clock settle
  expect state win.rows.49 .state == "sent"
  expect state win.rows.49 .plain == "Shipping the anchor fix now"
  expect state win.rows.49 .id == "1562888267366400000"

test "a failed send stays, marked, and Retry sends it (§3.9)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "fixture"
  tap "inject-fail-next"
  type "composer" "This one will fail"
  tap "send"
  clock +350
  clock settle
  expect state win.rows.49 .state == "failed"
  request POST "/control/hold-sends" {"on": true}
  tap "Retry"
  clock +1
  expect state win.rows.49 .state == "pending"
  request POST "/control/hold-sends" {"on": false}
  clock data
  clock settle
  expect state win.rows.49 .state == "sent"
  expect tree missing "failed-1562888267366400000"

test "Return sends and Shift-Return breaks the line (§3.12, §3.13)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "first line"
  type "composer" key "Shift+Enter"
  expect text "composer" == "first line\n"
  type "composer" "first line\nsecond line"
  type "composer" key "Enter"
  clock settle
  expect text "composer" == ""
  expect state win.rows.49 .plain == "first line\nsecond line"

test "Up edits the newest own message from history and Escape cancels it (§3.13)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "my newest **message**"
  tap "send"
  clock +350
  clock settle
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  type "composer" key "ArrowUp"
  clock settle
  expect state editing == "1562888267366400000"
  expect text "composer" == "my newest **message**"
  expect tree has "editing"
  type "composer" key "Escape"
  expect state editing == ""
  expect text "composer" == ""

test "Cancel finding a message restores typing focus and prevents a late edit"
  clock +500 real
  tap "channel-general"
  clock settle
  type "composer" key "ArrowUp"
  expect state editLookup == true
  tap "cancel-find-edit"
  expect state editLookup == false
  expect state composerFocused == true
  clock settle
  expect state editing == ""
  expect text "composer" == ""
  type "composer" key "ArrowUp"
  type "cancel-find-edit" key "Escape"
  expect state editLookup == false
  expect state composerFocused == true
  clock settle
  expect state editing == ""
  type "composer" key "ArrowUp"
  type "composer" "a new draft"
  clock settle
  expect state editLookup == false
  expect state editing == ""
  expect text "composer" == "a new draft"

test "Up preserves drafts, modified arrows and replies (§3.13)"
  clock +500 real
  tap "channel-general"
  clock settle
  type "composer" "leave this draft"
  type "composer" key "ArrowUp"
  expect state editing == ""
  expect text "composer" == "leave this draft"
  type "composer" ""
  type "composer" key "Shift+ArrowUp"
  expect state editLookup == false
  expect state editing == ""
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  type "composer" key "ArrowUp"
  expect state replyTo == "1562887009075210000"
  expect state editing == ""
  expect state editLookup == false

test "Escape cancels a reply and preserves the draft (§3.13)"
  clock +500 real
  tap "channel-general"
  clock settle
  type "composer" "a saved draft"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  expect state replyTo == "1562887009075210000"
  type "composer" key "Escape"
  expect state replyTo == ""
  expect tree missing "replying"
  expect text "composer" == "a saved draft"

test "Cancel reply and Cancel edit return keyboard focus to the preserved draft"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-reply"
  tap "cancel-reply"
  expect state replyTo == ""
  expect state composerFocused == true
  expect text "composer" == "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  tap "cancel-edit"
  expect state editing == ""
  expect state composerFocused == true
  expect text "composer" == "a saved draft"
  expect state win.rows.49 .plain == "original message"

test "Escape cancels an edit and restores the stashed draft (§3.13)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved changes"
  type "composer" key "Escape"
  expect state editing == ""
  expect state stash == ""
  expect tree missing "editing"
  expect text "composer" == "a saved draft"
  expect state win.rows.49 .plain == "original message"

test "Escape from history returns to the end and marks the channel read (§3.13)"
  clock +500 real
  tap "channel-help"
  clock settle
  type "composer" "a saved draft"
  tap "transcript" into "1562230937540887704"
  clock data
  expect state away == true
  type "composer" key "Escape"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect tree missing "unread"
  expect tree missing "jump-present"
  expect state chan.unread == 0
  expect text "composer" == "a saved draft"

test "a draft survives switching channels and relaunching (§3.12)"
  clock +500 real
  tap "channel-general"
  clock settle
  type "composer" "half a thought"
  back
  clock settle
  tap "channel-random"
  clock settle
  expect text "composer" == ""
  back
  clock settle
  tap "channel-general"
  clock settle
  expect text "composer" == "half a thought"
  back
  clock settle
  reload
  clock +500 real
  tap "channel-general"
  clock settle
  expect text "composer" == "half a thought"

test "relaunching during an edit preserves the unsent message draft (§3.12)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "Keep this unsent message"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  reload
  clock +500 real
  tap "channel-general"
  clock settle
  expect state editing == ""
  expect tree missing "editing"
  expect text "composer" == "Keep this unsent message"

test "relaunching during an edit does not turn it into a new message draft"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  reload
  clock +500 real
  tap "channel-general"
  clock settle
  expect state editing == ""
  expect tree missing "editing"
  expect text "composer" == ""

test "one author within seven minutes is one group; a day change draws its date (§3.15)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  expect tree has "author-1562882770722629389"
  expect tree missing "author-1562883971870631694"
  tap "transcript" into "1562732896249194217"
  clock settle
  expect text "day-1562732896249194217" == "Oct 22, 2026"
  expect tree missing "day-1562733934096164586"

// The reviews of the first commit (Sol, Grok): one test a finding.

test "a send from history returns to the live tail and lands at its end (review: Sol 2, Grok 1)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562732896249194217"
  clock settle
  expect state anchor == "1562618399954052832"
  type "composer" "Back to the present"
  tap "send"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect state endGap == 0
  expect tree has "message-1562888267366400000"

test "a send from a window pinned inside the tail shows at the end (review: Sol 2, Grok 1)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  type "composer" "Still here"
  tap "send"
  clock settle
  expect state anchor == ""
  expect state endGap == 0
  expect tree has "message-1562888267366400000"

test "spoilers in headings, small text and timestamps reveal only when pressed"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "# ||Heading surprise||\n-# ||Quiet surprise||\nA date: ||<t:1700000000:D>||\nA paragraph: ||Body surprise||"
  tap "send"
  clock +350
  clock settle
  expect state revealed.length == 0
  tap "Heading surprise"
  expect state revealed.length == 1
  tap "Quiet surprise"
  expect state revealed.length == 2
  tap "November 14, 2023"
  expect state revealed.length == 3
  tap "Body surprise"
  expect state revealed.length == 4

test "Edit starts from the message's Markdown, spoilers kept (review: Sol 1)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "||secret|| and **bold**"
  tap "send"
  clock +350
  clock settle
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  expect text "composer" == "||secret|| and **bold**"

test "an edit the server refuses keeps its text and says why (review: Sol 4)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "first try"
  tap "send"
  clock +350
  clock settle
  type "composer" "reply draft"
  tap "row-1562887009075210000" contextmenu
  tap "menu-reply"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "second try"
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  tap "send"
  clock settle
  expect text "composer" == "second try"
  expect tree has "edit-error"
  expect state replyTo == ""
  tap "cancel-edit"
  expect state replyTo == "1562887009075210000"
  expect text "replying" == "Replying to Ada"
  expect text "composer" == "reply draft"

test "a refused deletion says why, keeps the message and draft, and can be retried"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "message to delete"
  tap "send"
  clock +350
  clock settle
  type "composer" "Keep this draft"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages/1562888267366400000" times 1
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  expect state win.rows.49 .plain == "message to delete"
  expect text "composer" == "Keep this draft"
  expect text "delete-error" == "Check your connection and try again."
  tap "delete-error-ok"
  pass fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages/1562888267366400000"
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  expect tree missing "message-1562888267366400000"
  expect state deleteError == ""
  expect text "composer" == "Keep this draft"

test "a send settles while its reader is in another channel (review: Sol 5)"
