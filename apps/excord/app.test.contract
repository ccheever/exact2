test "Cancel reply and Cancel edit return keyboard focus to the preserved draft"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "original message"
  tap "send"
  clock +350
  clock settle
  type "composer" "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-reply"
  tap "cancel-reply"
  expect state replyTo == ""
  expect state composerFocused == true
  expect text "composer" == "a saved draft"
  tap "row-1562888267366400000" contextmenu
  tap "menu-edit"
  type "composer" "unsaved edit"
  tap "cancel-edit"
  expect state editing == ""
  expect state composerFocused == true
  expect text "composer" == "a saved draft"
  expect state win.rows.49 .plain == "original message"

