// The wiring's reviews (Sol, Grok): one test a finding the view shows.

test "a failed ack at the end is sent again (wiring review: Grok 4)"
  fail fetch "http://127.0.0.1:4790/api/v9/channels/1191168914235588608/messages/1562887009075210000/ack" times 1
  clock +500 real
  tap "channel-general"
  clock settle
  clock +1100
  clock data
  clock +1100
  clock data
  expect state chan.unread == 0

test "a channel never read jumps to its first message (wiring review: Sol 8)"
  clock +500 real
  tap "channel-announcements"
  clock settle
  expect text "unread-bar" == "50+ new messages since 8:27 AM"
  tap "unread-bar"
  clock settle
  expect state anchor == "0"
  expect tree has "new-divider"
  expect tree has "message-1432427377459200001"

test "the server rail switches the list to the direct messages, which open like a channel, and is kept"
  clock +500 real
  tap "server-@me"
  clock settle
  expect state server == "@me"
  expect tree missing "channel-general"
  tap "Weekend rides"
  clock settle
  expect state chan.name == "Weekend rides"
  expect state win.hasAfter == false
  back
  clock settle
  reload
  clock +500 real
  expect state server == "@me"

test "an image opens full screen, zooms on a double tap and closes"
  clock +500 real
  tap "channel-general"
  clock data
  clock settle
  tap "open-1562887009075210000-1562887009075399990"
  clock settle
  expect tree has "viewer"
  expect state viewing == "http://127.0.0.1:4790/media/cafe.png"
  tap "viewer-handle" dblclick
  clock settle
  expect state viewZoom == 2
  tap "viewer-close"
  clock settle
  expect tree missing "viewer"

test "picked pictures go up with the message"
  clock +500 real
  tap "channel-general"
  clock data
  clock settle
  tap "attach"
  pick "attach-input" "assets/media/garden.png"
  clock data
  tap "attach"
  pick "attach-input" "assets/media/cafe.png"
  clock data
  expect state picked.length == 2
  tap "unpick-garden.png"
  expect state picked.length == 1
  tap "attach"
  pick "attach-input" "assets/media/garden.png"
  clock data
  type "composer" "look at this"
  tap "send"
  clock data
  clock settle
  clock data
  expect state picked.length == 0
  expect state sent.ok == true

test "any emoji reacts from the picker, a server's own by its id"
