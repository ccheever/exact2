test "a send while the list is still moving lands at the live end (re-check: Grok new 1)" on web, ios, tvos, android, linux, windows
  // (A finger's fling, still moving at the send: a Mac's wheel lands at once, so its twin
  // below is a send after a scroll away, not this.)
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562732896249194217"
  clock settle
  type "composer" "sent mid-fling"
  tap "transcript" drag 0 500 over 60
  tap "send"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect tree has "message-1562888267366400000"

test "a send after a wheel scroll away lands at the live end (the Mac's twin; no fling)" on macos
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562732896249194217"
  clock settle
  type "composer" "sent after a scroll"
  // (On a Mac a drag selects text, and a wheel lands at once, so this is a send after
  // the reader scrolled away, not mid-fling: the moving case stays with the hosts above.)
  tap "transcript" wheel 0 -500
  tap "send"
  clock settle
  expect state anchor == ""
  expect state away == false
  expect tree has "message-1562888267366400000"

