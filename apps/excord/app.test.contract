test "a refused deletion says why, keeps the message and draft, and can be retried"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  tap "mark-read"
  type "composer" "message to delete"
  tap "send"
  clock +350
  clock settle
  type "composer" "Keep this draft"
  fail fetch "/api/v9/channels/1191168914235588608/messages/1562888267366400000" times 1
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  expect state win.rows.49 .plain == "message to delete"
  expect text "composer" == "Keep this draft"
  expect text "delete-error" == "Check your connection and try again."
  tap "delete-error-ok"
  pass fetch "/api/v9/channels/1191168914235588608/messages/1562888267366400000"
  tap "row-1562888267366400000" contextmenu
  tap "menu-delete"
  tap "delete-confirm"
  clock settle
  expect tree missing "message-1562888267366400000"
  expect state deleteError == ""
  expect text "composer" == "Keep this draft"

