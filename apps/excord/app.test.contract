  clock settle
  // The relaunch reopens the channel its address names, with its draft and without the edit.
  expect state chan.name == "general"
  expect tree has "transcript"
  expect state editing == ""
  expect tree missing "editing"
  expect text "composer" == ""

// A web relaunch keeps the channel's address, with the list beneath it to go Back to; a native relaunch
// starts at the list, with nothing beneath. Its host-neutral twin (a conversation chosen first) is in
// routing.test.contract.

test "a user action before the launch's restore lands wins: Back to the list cancels it" on web
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  type "composer" "kept for later"
  reload
  // Back at once, before the gateway's READY lists the channel: the restore is dropped, not applied late.
  back
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  expect state open == ""
  expect state reading == false
  // And the next launch starts at the list too.
  reload
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  expect state open == ""
  tap "channel-general"
  clock settle
  expect text "composer" == "kept for later"

test "the launch's restore runs once: Back to the list stays, through a list refresh"
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  tap "channel-general"
  clock settle
  reload
  clock settle
  clock until state gateway.state == "ready" within 10000
  clock settle
  expect state chan.name == "general"
  // A message arrives (the list's unread state refreshes) after Back: the list stays.
  tap "fixture"
  tap "inject-message"
  back
  clock settle
  clock +3000
  clock settle
  expect state reading == false
  expect tree has "channel-general"

