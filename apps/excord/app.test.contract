test "the pill counts arrivals; a deletion does not cancel one (review: Sol 7, Grok 3)"
  clock +500 real
  tap "channel-general"
  clock settle
  tap "mark-read"
  tap "transcript" into "1562755578936174328"
  clock settle
  expect state away == true
  tap "fixture"
  tap "inject-delete-above"
  clock settle
  tap "fixture"
  tap "inject-message"
