// A picture full screen, as Discord's viewer has it: black behind it, a pinch
// zooms between fit and 4x and a drag pans the zoomed picture; at fit, a drag
// down far or fast enough closes it, the backdrop fading as the picture leaves
// (the photo pair of LLP 1057.001, interaction-gallery's viewer).

fn photoFit(bw: number, bh: number, nw: number, nh: number): number = bw > 0 and bh > 0 and nw > 0 and nh > 0 ? min(bw / nw, bh / nh) : 0
fn photoZoom(scale: number): number = min(max(scale, 1), 4)
fn photoClamp(value: number, natural: number, fit: number, zoom: number, port: number): number = min(max(value, -max(0, (natural * fit * zoom - port) / 2)), max(0, (natural * fit * zoom - port) / 2))

// The backdrop fades over the first 300 points of the picture's drag down.
keyframes viewerFade
  from opacity=1
  to opacity=0

// Stateless: the app holds the pan and zoom (`viewerRelease` in app.contract),
// so a release that dismisses can close the viewer.
component ImageViewer
  props
    src: string
    alt: string
    panX: number
    panY: number
    zoom: number
    geometry: action
    release: action
    toggleZoom: action
    close: action
  view
    // Dark in both schemes, as a photo viewer is, with the status bar's light text over it.
    column position="absolute" inset=0 timeline-scope="--dismiss" overflow="hidden" color-scheme="dark" status-bar-style="light-content" testId="viewer" aria-label=(alt != "" ? alt : "Image")
      view position="absolute" inset=0 background-color="-exact-background" animation=(zoom == 1 ? "viewerFade 1s linear both" : "none") animation-timeline="--dismiss" animation-range="0px 300px" aria-hidden=true
      box id="viewer-transform" position="absolute" left=0 top=0 width="100%" height="100%" box-sizing="border-box" translate=`${panX}px ${panY}px` scale=zoom transition="translate -exact-spring(300, 30, 1), scale -exact-spring(300, 30, 1)" -exact-drag-timeline="--dismiss y"
        image src position="absolute" inset=0 width="100%" height="100%" object-fit="contain" aria-label=alt testId="viewer-image"
        box transformDragFor="viewer-transform" transformgeometry=geometry transformrelease=release dblclick=toggleZoom touch-action="none" position="absolute" left=0 top=0 width="100%" height="100%" testId="viewer-handle"
      row position="absolute" top=0 left=0 right=0 padding="12px 16px" padding-top="calc(env(safe-area-inset-top) + 8px)" justify-content="flex-end"
        button press=close buttonStyle="bordered" aria-label="Close" aria-keyshortcuts="Escape" testId="viewer-close"
          image "symbol:close"
