use TextStyles from "./text-styles.contract"

shape Display
  colorGamut: string
  dynamicRange: string

shape NativeFeatures
  reference: bool
  video: bool

shape Swatch
  label: string
  color: string

shape SpaceRow
  name: string
  note: string
  swatches: Swatch[]

shape Picture
  src: string
  label: string
  height: number

shape HdrPicture
  src: string
  label: string

shape PicturePair
  a: Picture
  b: Picture
  two: bool

style Section
  font-size=16
  font-weight=700
  padding-top=18
style Name
  font-family="monospace"
  font-size=12
style Label
  font-family="monospace"
  font-size=11
  padding-top=8
  padding-bottom=2
style Note
  font-size=11
  color="light-dark(#6b655a, #a1a1aa)"
style Legend
  font-size=11
  color="light-dark(#6b655a, #a1a1aa)"
  padding-top=2
  padding-bottom=4
style Row
  flex-direction="row"
style Card
  padding=10
  border-radius=12
style Segmented
  flex-direction="row"
  border-radius=9
  overflow="hidden"
style Segment
  flex-grow=1
  flex-basis=0
  padding-top=6
  padding-bottom=6
style SegmentText
  font-size=13
  font-weight=600
style ColumnTitle
  font-size=11
  font-weight=600
  width=116
  text-align="center"
style Hairline
  border-width=0.5
  border-style="solid"
  border-color="light-dark(#9ca3af, #6b7280)"
style Framed
  border-width=1
  border-style="solid"
  border-color="light-dark(#d8d4cc, #3a3a3c)"
style Chip
  width=42
  height=28
  border-width=1
  border-style="solid"
  border-color="light-dark(#d8d4cc, #3a3a3c)"
style Page
  padding-left="calc(env(safe-area-inset-left) + 16px)"
  padding-right="calc(env(safe-area-inset-right) + 16px)"
  padding-bottom=12
  width="100%"
  box-sizing="border-box"
  max-width=720
  margin-left="auto"
  margin-right="auto"

component GalleryDemo
  props
    section: string
    navigationId: string
    authoredHeader: bool
    compact: bool
    back: action
    display: Display
    css: SpaceRow[]
    platform: SpaceRow[]
    pictures: PicturePair[]
    hdr: HdrPicture[]
    hiddenPictures: string
    hiddenHdr: string
    caveat: string
    host: string
    tallText: string
    nativeFeatures: NativeFeatures
    one: string
    four: string
    limit: string
    moved: bool
    textMoved: bool
    videoSource: string
    videoPlaying: bool
    liftPicked: string
    active: bool
    chooseVideo: action
    toggleVideo: action
    choose: action
    toggleMoved: action
    toggleText: action
    pickLift: action
  view
    column navigationKey=navigationId navigationBar=(authoredHeader ? "none" : "auto") dynamic-range-limit=limit navigationScroll=`gallery-${section}` position="absolute" inset=0 display="flex" flex-direction="column"
      header display="flex" align-items="center" column-gap=16 padding="12px 16px"
        if authoredHeader and compact
          button id="back" press=back aria-label="Back to UI Gallery" testId="gallery-back" appearance="none" padding=8
            image "symbol:back"
        if section == "typography"
          text "Typography" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "textcolors"
          text "Text colors" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "css"
          text "CSS color spaces" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "profiles"
          text "Platform profiles" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "images"
          text "Image profiles" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "hdr"
          text "HDR" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "effects"
          text "Effects & controls" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "media"
          text "Canvas & video" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
        if section == "menus"
          text "Context menus" role="heading" aria-level=1 font-size=(authoredHeader ? 22 : 34) font-weight=600
      if section != "hdr" and section != "menus" and (host != "web" or section == "images") and (section != "media" or nativeFeatures.video)
        column id="range-bar" hatch="sticky-limit" position="relative" z-index=1 flex-shrink=0 padding-top=8 padding-bottom=12 padding-left="calc(env(safe-area-inset-left) + 16px)" padding-right="calc(env(safe-area-inset-right) + 16px)" testId=`range-bar-${section}`
          column testId=`range-card-${section}`
            LimitControl(section=section, limit=limit, choose=choose)
      scroll id=`gallery-${section}` testId="gallery" position="relative" z-index=0 flex=1 min-height=0 width="100%" overflow-x="hidden" overflow-y="scroll" -exact-scroll-edge-effect="soft"
        column class=Page padding-top=12 padding-bottom=(host == "web" ? "calc(env(safe-area-inset-bottom) + 12px)" : "12px") testId=`page-${section}`
          if section == "typography"
            text "Sizes, weights, scripts, decorations and changing text." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            TextStyles(one=one, four=four, moved=textMoved, toggle=toggleText, tall=tallText)
          if section == "textcolors"
            text "Every supported color space, on light and dark backgrounds." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Text in every color space" class=Section
            text "Each color is drawn as text on white and on dark. Compare sRGB with wide-gamut and HDR colors, then change the range limit above." class=Legend
            for row in css key=row.name
              TextColorRow(row=row)
            for row in platform key=row.name
              TextColorRow(row=row)
            text "Text" class=Section
            text "The same red as text: sRGB, then Display P3 (redder on a P3 display)." class=Legend
            text "sRGB red text" color="red" font-size=18 font-weight=700
            text "Display P3 red text" testId="p3-text" color="color(display-p3 1 0 0)" font-size=18 font-weight=700
            text "oklch(0.7 0.25 145) text" testId="oklch-text" color="oklch(0.7 0.25 145)" font-size=18 font-weight=700
          if section == "css"
            text "Compare CSS color models and wide-gamut swatches." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text `Display: ${display.colorGamut} · ${display.dynamicRange}` class=Note padding-bottom=8
            text "CSS color spaces" class=Section
            text "Each row: red · green · blue · mid · white in that color space (HDR rows: as noted). More saturated than srgb means a wider gamut, visible on a P3 display." class=Legend
            for row in css key=row.name
              SpaceRowView(row=row)
          if section == "profiles"
            text "Colors interpreted through the profiles supplied by the OS." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Platform profiles · color(--name …)" class=Section
            text "Color spaces the OS ships, drawn by Apple from the profile. Apple only: browsers and Linux have no such profiles." class=Legend
            for row in platform key=row.name
              SpaceRowView(row=row)
          if section == "images"
            text "Embedded color profiles, formats and bit depths." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Image profiles" class=Section
            text "One picture per embedded profile, format and depth." class=Legend
            // Labels get their own grid row, so a wrapped label doesn't
            // misalign the pictures.
            column display="grid" grid-template-columns="minmax(0, 1fr) minmax(0, 1fr)" column-gap=8 testId="pictures"
              for pair in pictures key=pair.a.src
                text pair.a.label class=Label align-self="end"
                text (pair.two ? pair.b.label : "") class=Label align-self="end"
                image pair.a.src width="100%" height=pair.a.height object-fit="fill" class=Framed testId=pair.a.src
                if pair.two
                  image pair.b.src width="100%" height=pair.b.height object-fit="fill" class=Framed testId=pair.b.src
            if hiddenPictures != ""
              text hiddenPictures class=Note padding-top=6
          if section == "hdr"
            text "Compare dynamic-range limits and native UIKit references." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text `Display: ${display.colorGamut} · ${display.dynamicRange}` class=Note padding-bottom=8
            text "HDR under each limit, side by side" class=Section
            text "On an HDR display the bright patches step down left to right; on SDR all three match." class=Legend
            column class=Row column-gap=6 padding-top=4
              text "no-limit" class=ColumnTitle
              text "constrained" class=ColumnTitle
              text "standard" class=ColumnTitle
            for p in hdr key=p.src
              HdrTrio(src=p.src, label=p.label)
            if hiddenHdr != ""
              text hiddenHdr class=Note padding-top=6
            if caveat != ""
              text caveat class=Note padding-top=6 testId="constrained-caveat"

            text "HDR colors under each limit" class=Section
            text "color(rec2100-linear 4 4 4): four times SDR white, as a background, text, a text shadow behind white text, a border (laid on a layer, and drawn by the view), a box shadow, a gradient from 1× to 4× and SVG paint. On an HDR display each row steps down left to right; on SDR all three match." class=Legend
            if host == "web"
              text "Not in browsers yet: none draws rec2100 colors." class=Note padding-top=6
            if host != "web"
              column class=Row column-gap=6 padding-top=4
                text "no-limit" class=ColumnTitle
                text "constrained" class=ColumnTitle
                text "standard" class=ColumnTitle
              HdrPaintTrio(kind="background", label="background", one=one, four=four)
              HdrPaintTrio(kind="text", label="text", one=one, four=four)
              HdrPaintTrio(kind="text-shadow", label="text-shadow", one=one, four=four)
              HdrPaintTrio(kind="border", label="border", one=one, four=four)
              HdrPaintTrio(kind="drawn-border", label="border, sides of two widths (drawn by the view)", one=one, four=four)
              HdrPaintTrio(kind="shadow", label="box-shadow", one=one, four=four)
              HdrPaintTrio(kind="gradient", label="linear-gradient, 1× to 4× in srgb-linear", one=one, four=four)
              HdrPaintTrio(kind="svg-fill", label="SVG fill", one=one, four=four)
              HdrPaintTrio(kind="svg-stroke", label="SVG stroke", one=one, four=four)
              text "Not yet HDR on Apple: SVG gradients, patterns, masks and filters, which are drawn into SDR pictures (LLP 1100)." class=Note padding-top=6
            if nativeFeatures.reference
              text "UIKit reference · iOS 26+" class=Section
              text "Native gradient, PQ image and shadow under no-limit, constrained and standard. The gradient runs from 1× to 4× white; the shadow uses 4× white." class=Legend
              row column-gap=6
                box width=116 height=112 hatch="hdr-reference" data-limit="no-limit" testId="native-no-limit"
                box width=116 height=112 hatch="hdr-reference" data-limit="constrained" testId="native-constrained"
                box width=116 height=112 hatch="hdr-reference" data-limit="standard" testId="native-standard"
          if section == "effects"
            text "Shadows, borders, gradients, transitions and accent colors." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Shadows" class=Section
            text "A shadow's color is painted on its own path. Each row: the sRGB color, then the Display P3 one (more vivid on a P3 display)." class=Legend
            column class=Row column-gap=24 padding-top=4
              box width=48
              text "sRGB" class=ColumnTitle width=96
              text "Display P3" class=ColumnTitle width=96
            ShadowPair(label="green", srgb="rgb(0 255 0 / 0.85)", p3="color(display-p3 0 1 0 / 0.85)")
            ShadowPair(label="red", srgb="rgb(255 0 0 / 0.85)", p3="color(display-p3 1 0 0 / 0.85)")
            ShadowPair(label="blue", srgb="rgb(0 0 255 / 0.85)", p3="color(display-p3 0 0 1 / 0.85)")

            text "Borders" class=Section
            text "Each row: the sRGB color, then the Display P3 one with square and with round corners (more vivid on a P3 display). Last, mixed sides: the top sRGB blue, the others red in the column's space." class=Legend
            column class=Row column-gap=8 padding-top=4
              box width=48
              text "sRGB" class=ColumnTitle width=72
              text "Display P3" class=ColumnTitle width=72
              text "P3, rounded" class=ColumnTitle width=72
            BorderRow(label="red", srgb="rgb(255 0 0)", p3="color(display-p3 1 0 0)")
            BorderRow(label="green", srgb="rgb(0 255 0)", p3="color(display-p3 0 1 0)")
            BorderRow(label="blue", srgb="rgb(0 0 255)", p3="color(display-p3 0 0 1)")
            column class=Row column-gap=8 padding-top=8 align-items="center"
              text "mixed" class=Name width=48
              box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-color="rgb(255 0 0)" border-top-color="rgb(0 0 255)" testId="mixed-srgb-border"
              box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-color="color(display-p3 1 0 0)" border-top-color="rgb(0 0 255)" testId="mixed-border"
              box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-radius=10 border-color="color(display-p3 1 0 0)" border-top-color="rgb(0 0 255)" testId="mixed-rounded-border"

            text "Gradients" class=Section
            text "Blue to yellow in each interpolation space. sRGB's midpoint is gray, Oklab's lighter; Oklch goes round the hue wheel. Without `in`, legacy colors interpolate in sRGB and modern ones in Oklab." class=Legend
            GradientRow(label="legacy sRGB", gradient="linear-gradient(to right, #0000ff, #ffff00)")
            GradientRow(label="in srgb", gradient="linear-gradient(in srgb to right, #0000ff, #ffff00)")
            GradientRow(label="in srgb-linear", gradient="linear-gradient(in srgb-linear to right, #0000ff, #ffff00)")
            GradientRow(label="in oklab", gradient="linear-gradient(in oklab to right, #0000ff, #ffff00)")
            GradientRow(label="in oklch", gradient="linear-gradient(in oklch to right, #0000ff, #ffff00)")
            GradientRow(label="in display-p3", gradient="linear-gradient(in display-p3 to right, #0000ff, #ffff00)")
            GradientRow(label="P3 stops", gradient="linear-gradient(to right, color(display-p3 1 0 0), color(display-p3 0 1 0))")
            text "Hue methods" class=Label
            text "Red to blue in oklch, the four ways round: shorter and decreasing pass through magenta, longer and increasing through yellow, green and cyan." class=Note
            GradientRow(label="shorter hue", gradient="linear-gradient(in oklch shorter hue to right, #ff0000, #0000ff)")
            GradientRow(label="longer hue", gradient="linear-gradient(in oklch longer hue to right, #ff0000, #0000ff)")
            GradientRow(label="increasing hue", gradient="linear-gradient(in oklch increasing hue to right, #ff0000, #0000ff)")
            GradientRow(label="decreasing hue", gradient="linear-gradient(in oklch decreasing hue to right, #ff0000, #0000ff)")
            text "Transitions" class=Section
            text "Two seconds, linear. Legacy colors move in sRGB; a color in its own space moves in Oklab, so its midpoint stays light and saturated." class=Legend
            button press=toggleMoved testId="transition-toggle" align-self="flex-start" margin-top=4 padding-left=14 padding-right=14 padding-top=6 padding-bottom=6 border-radius=8 background-color="#1f6feb"
              text (moved ? "Transition back" : "Transition") color="#ffffff" font-size=13 font-weight=600
            TransitionRow(label="legacy", moved=moved, from="#0000ff", to="#ffff00")
            TransitionRow(label="oklch", moved=moved, from="oklch(0.45 0.31 264)", to="oklch(0.97 0.21 110)")
            TransitionRow(label="display-p3", moved=moved, from="color(display-p3 0 0 1)", to="color(display-p3 1 1 0)")
            if host != "web"
              TransitionRow(label="HDR, 1× to 4×", moved=moved, from=one, to=four)
            if host == "web"
              text "The HDR row is not on the web: no browser draws rec2100 colors yet." class=Note padding-top=6
            text "Accent" class=Section
            text "The app's accent (on Apple, its catalog's AccentColor), a box's accent-color, one control's own, then auto: the app's again. Nested radii are concentric." class=Legend
            button "App accent" buttonStyle="filled" press=choose(limit) testId="accent-app" align-self="flex-start"
            column border-width=1 border-style="solid" border-color="-exact-separator" corner-shape="-exact-continuous" padding=12 row-gap=10 border-radius=32 accent-color="#0a84ff" testId="accent-blue"
              button "Box: blue" buttonStyle="filled" press=choose(limit) align-self="flex-start"
              column border-width=1 border-style="solid" border-color="-exact-separator" corner-shape="-exact-continuous" padding=12 row-gap=10 border-radius=20
                row column-gap=8
                  button "Own: green" buttonStyle="filled" accent-color="#34c759" press=choose(limit) testId="accent-green"
                  button "Inherited" buttonStyle="filled" press=choose(limit)
                column border-width=1 border-style="solid" border-color="-exact-separator" corner-shape="-exact-continuous" padding=12 row-gap=10 border-radius=8 accent-color="auto"
                  button "auto: the app's" buttonStyle="filled" press=choose(limit) testId="accent-auto" align-self="flex-start"
          if section == "media"
            text "Canvas color spaces and native video playback." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Canvas 2D color-space" class=Section
            text "Each canvas: sRGB red, then color(display-p3 1 0 0). They match in the sRGB canvas; the right half is redder in the P3 ones." class=Legend
            text "color-space=srgb" class=Label
            canvas surface=reds() testId="canvas-srgb" width=256 height=24
            text "color-space=display-p3" class=Label
            canvas surface=reds() testId="canvas-p3" width=256 height=24 color-space="display-p3"
            text "color-space=display-p3 color-type=float16" class=Label
            canvas surface=reds() testId="canvas-p3-float16" width=256 height=24 color-space="display-p3" color-type="float16"
            if nativeFeatures.video
              text "Video color profiles" class=Section
              text "The same three-second clip without controls and with native controls. A moving dark bar confirms playback. The page limit applies to both players." class=Legend
              column row-gap=12 padding-top=8 padding-bottom=12
                row role="tablist" aria-label="Video color profile" testId="video-formats"
                  button "SDR" role="tab" aria-selected=(videoSource == "assets/sdr.mp4") press=chooseVideo("assets/sdr.mp4") testId="video-sdr"
                  button "PQ" role="tab" aria-selected=(videoSource == "assets/pq.mov") press=chooseVideo("assets/pq.mov") testId="video-pq"
                  button "HLG" role="tab" aria-selected=(videoSource == "assets/hlg.mov") press=chooseVideo("assets/hlg.mov") testId="video-hlg"
                  button "P3 SDR" role="tab" aria-selected=(videoSource == "assets/p3-sdr.mov") press=chooseVideo("assets/p3-sdr.mov") testId="video-p3"
                button buttonStyle="filled" press=toggleVideo testId="video-toggle" align-self="flex-start"
                  image (videoPlaying ? "symbol:pause" : "symbol:play")
                  text (videoPlaying ? "Pause videos" : "Play videos")
              row column-gap=8
                video videoSource controls=false muted=true loop=true playsinline=true preload="auto" paused=(not videoPlaying or not active) width=170 height=100 testId="video-inline"
                video videoSource controls=true muted=true loop=true playsinline=true preload="auto" paused=(not videoPlaying or not active) width=170 height=100 testId="video-controls"
          if section == "menus"
            text "Text lifted from flat colors, gradients, images and materials." font="-exact-subheadline" color="-exact-secondary-label" padding-bottom=8 testId=`intro-${section}`
            text "Text lifted into a menu" class=Section
            text "Press and hold a #tag, or Control-click it. On iPhone and iPad, UIKit lifts the tag with the padding it chooses, filled from what lies under it: one flat color as that color, gradients and pictures drawn from their layers, a blur from the screen. The words beside the tag stay behind, except over the blur." class=Legend
            column row-gap=14 padding-top=6 testId="lift"
              text font-size=17 max-width="15rem"
                text "#tag with words enough to wrap onto a second line" contextPopover="lift-menu"
                text " and then plain text"
              text font-size=17 max-width="15rem"
                text "#tag with so many words in it that it wraps onto a third line and keeps on going" contextPopover="lift-menu"
                text " and plain text"
              column background-color="#0a64ff" padding=12 border-radius=18 max-width="15rem" align-self="flex-start"
                text font-size=17 color="#ffffff"
                  text "#tag on a balloon, long enough to wrap" contextPopover="lift-menu"
                  text " and more"
              column background-color="#ffd60a" padding=12 border-radius=14 press=pickLift("card") testId="lift-card"
                text font-size=17 color="#000000"
                  text "#tag" contextPopover="lift-menu"
                  text " in a card you can tap"
              column background-color="#ffd60a" padding=12 border-radius=14 max-width="15rem" align-self="flex-start" press=pickLift("long card")
                text font-size=17 color="#000000"
                  text "#tag in a card you can tap, long enough to wrap" contextPopover="lift-menu"
                  text " and more"
              column padding=12 border-radius=14 background-image="linear-gradient(to right, #ff3b30, #ffffff)"
                text font-size=17 color="#000000"
                  text "#tag" contextPopover="lift-menu"
                  text " on a red gradient"
              column position="relative" height=140 border-radius=16 overflow="hidden"
                image "assets/lift-picture.jpg" position="absolute" inset=0 width="100%" height="100%" object-fit="cover" aria-label="A fractal"
                column position="absolute" left=12 bottom=12 background-color="#00000080" padding=10 border-radius=10
                  text font-size=17 color="#ffffff"
                    text "#tag" contextPopover="lift-menu"
                    text " caption over a picture"
              column position="relative" height=110 border-radius=16 overflow="hidden" press=pickLift("picture card")
                image "assets/lift-picture.jpg" position="absolute" inset=0 width="100%" height="100%" object-fit="cover" aria-label="A fractal"
                text position="absolute" left=14 top=14 right=14 font-size=17 color="#ffffff"
                  text "#tag" contextPopover="lift-menu"
                  text " on a picture card you can tap"
              column position="relative" height=140 border-radius=16 overflow="hidden"
                image "assets/lift-picture.jpg" position="absolute" inset=0 width="100%" height="100%" object-fit="cover" aria-label="A fractal"
                column position="absolute" left=12 right=12 bottom=12 backdrop-filter="blur(12px)" background-color="#ffffff40" padding=10 border-radius=12
                  text font-size=17 color="#000000"
                    text "#tag" contextPopover="lift-menu"
                    text " on frosted glass"
              text (liftPicked == "" ? "Nothing picked yet." : `Picked: ${liftPicked}.`) class=Note testId="lift-picked"
            column id="lift-menu" popover="auto" role="menu"
              button press=pickLift("share") popovertarget="lift-menu" popovertargetaction="hide"
                text "Share"
              button press=pickLift("favorite") popovertarget="lift-menu" popovertargetaction="hide"
                text "Favorite"

component LimitControl
  props
    section: string
    limit: string
    choose: action
  view
    row align-items="center" column-gap=16
      text "Dynamic range limit" font="-exact-subheadline" font-weight=600 flex-shrink=1 min-width=96 testId=`range-${section}-title`
      // A UISegmentedControl on iOS; these styles draw it elsewhere.
      column class=Segmented flex="1 0 224px" min-width=224 role="tablist" aria-label="Dynamic range limit" testId=`range-${section}`
        button role="tab" aria-selected=(limit == "no-limit") press=choose("no-limit") testId=`range-${section}-no-limit` class=Segment background-color=(limit == "no-limit" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "no-limit" class=SegmentText color=(limit == "no-limit" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")
        button role="tab" aria-selected=(limit == "constrained") press=choose("constrained") testId=`range-${section}-constrained` class=Segment background-color=(limit == "constrained" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "constrained" class=SegmentText color=(limit == "constrained" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")
        button role="tab" aria-selected=(limit == "standard") press=choose("standard") testId=`range-${section}-standard` class=Segment background-color=(limit == "standard" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "standard" class=SegmentText color=(limit == "standard" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")

component ShadowPair
  props
    label: string
    srgb: string
    p3: string
  view
    column class=Row column-gap=24 align-items="center" padding-top=14 padding-bottom=6
      text label class=Name width=48
      box width=96 height=28 border-radius=8 background-color="light-dark(#ffffff, #1c1c1e)" box-shadow=`0 6px 16px ${srgb}`
      box width=96 height=28 border-radius=8 background-color="light-dark(#ffffff, #1c1c1e)" box-shadow=`0 6px 16px ${p3}` testId=`p3-shadow-${label}`

component SpaceRowView
  props
    row: SpaceRow
  view
    column class=Row testId=row.name align-items="center" column-gap=8 padding-top=6
      column width=128 flex-shrink=0
        text row.name class=Name
        text row.note class=Note
      column class=Row column-gap=4
        for s in row.swatches key=s.label
          box class=Chip background-color=s.color

component BorderRow
  props
    label: string
    srgb: string
    p3: string
  view
    column class=Row column-gap=8 padding-top=8 align-items="center"
      text label class=Name width=48
      box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-color=srgb
      box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-color=p3 testId=`p3-border-${label}`
      box width=72 height=28 box-sizing="border-box" border-width=4 border-style="solid" border-radius=10 border-color=p3 testId=`p3-rounded-border-${label}`

component GradientRow
  props
    label: string
    gradient: string
  view
    column class=Row column-gap=8 padding-top=6 align-items="center"
      text label class=Name width=112 flex-shrink=0
      box flex=1 height=24 background-image=gradient testId=`gradient-${label}`

component TransitionRow
  props
    label: string
    moved: bool
    from: string
    to: string
  view
    column class=Row column-gap=8 padding-top=6 align-items="center"
      text label class=Name width=112 flex-shrink=0
      box flex=1 height=24 box-sizing="border-box" class=Hairline background-color=(moved ? to : from) transition="background-color 2s linear" testId=`transition-${label}`

component HdrPaintTrio
  props
    kind: string
    label: string
    one: string
    four: string
  view
    column
      text label class=Label
      column class=Row column-gap=6
        column dynamic-range-limit="no-limit"
          HdrPaint(kind=kind, one=one, four=four, limit="no-limit")
        column dynamic-range-limit="constrained"
          HdrPaint(kind=kind, one=one, four=four, limit="constrained")
        column dynamic-range-limit="standard"
          HdrPaint(kind=kind, one=one, four=four, limit="standard")

component HdrPaint
  props
    limit: string
    kind: string
    one: string
    four: string
  view
    column width=116 height=32 box-sizing="border-box" background-color="#000000" align-items="center" justify-content="center" class=Hairline testId=`hdr-${kind}-${limit}` hatch="hdr-probe" data-kind=kind data-limit=limit
      if kind == "background"
        box width=116 height=32 background-color=four
      if kind == "text"
        text "HDR" font-size=20 font-weight=800 color=four
      if kind == "text-shadow"
        text "HDR" font-size=20 font-weight=800 color="#ffffff" text-shadow=`3px 3px 3px ${four}`
      if kind == "border"
        box width=100 height=20 border-width=4 border-style="solid" border-color=four
      if kind == "drawn-border"
        box width=100 height=20 box-sizing="border-box" border-width=2 border-left-width=8 border-right-width=8 border-style="solid" border-color=four
      if kind == "shadow"
        box width=60 height=12 background-color="#000000" box-shadow=`0 0 10px 4px ${four}`
      if kind == "gradient"
        box width=116 height=32 background-image=`linear-gradient(in srgb-linear to right, ${one}, ${four})`
      if kind == "svg-fill"
        svg viewBox="0 0 116 32" width=116 height=32
          rect x=8 y=6 width=100 height=20 rx=4 fill=four
      if kind == "svg-stroke"
        svg viewBox="0 0 116 32" width=116 height=32
          rect x=8 y=6 width=100 height=20 rx=4 fill="none" stroke=four stroke-width=4

component HdrTrio
  props
    src: string
    label: string
  view
    column
      text label class=Label
      column class=Row column-gap=6
        column dynamic-range-limit="no-limit"
          image src width=116 height=32 object-fit="fill" class=Hairline
        column dynamic-range-limit="constrained"
          image src width=116 height=32 object-fit="fill" class=Hairline
        column dynamic-range-limit="standard"
          image src width=116 height=32 object-fit="fill" class=Hairline

component TextColorRow
  props
    row: SpaceRow
  view
    column padding-top=8 testId=`text-space-${row.name}`
      text row.name class=Name
      row column-gap=4
        for swatch in row.swatches key=swatch.label
          column flex=1 min-width=0
            text swatch.label class=Label
            text "Aa" color=swatch.color background-color="#ffffff" font-size=24 font-weight=700 text-align="center" testId=`text-color-${row.name}-${swatch.label}-light`
            text "Aa" color=swatch.color background-color="#111827" font-size=24 font-weight=700 text-align="center" testId=`text-color-${row.name}-${swatch.label}-dark`
