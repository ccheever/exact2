use GalleryDemo, Display, SpaceRow, PicturePair, HdrPicture, NativeFeatures from "./gallery.contract"

routes nav
  tab typography "/"
  tab textcolors "/textcolors"
  tab css "/css"
  tab profiles "/profiles"
  tab images "/images"
  tab hdr "/hdr"
  tab effects "/effects"
  tab media "/media"
  tab menus "/menus"

component UIGallery
  resource display = exactViewport() as shape Display
  resource css = colorSpaces("css") as shape SpaceRow[]
  resource platform = colorSpaces("platform") as shape SpaceRow[]
  resource pictures = picturePairs() as shape PicturePair[]
  resource hdr = hdrPictures() as shape HdrPicture[]
  resource hiddenPictures = hidden("pictures") as shape string
  resource hiddenHdr = hidden("hdr") as shape string
  resource caveat = caveat("constrained") as shape string
  resource host = hostKind() as shape string
  resource tallText = textSample() as shape string
  resource nativeFeatures = nativeFeatures() as shape NativeFeatures
  // rec2100 colors come from data: the web build refuses a literal one.
  resource one = hdrWhite(1) as shape string
  resource four = hdrWhite(4) as shape string
  state limit = "no-limit"
  state moved = false
  state textMoved = false
  state videoSource = "assets/sdr.mp4"
  state videoPlaying = false
  state liftPicked = ""
  action chooseVideo(value: string)
    videoSource = value
    videoPlaying = true
  action toggleVideo()
    videoPlaying = not videoPlaying
  action choose(value: string)
    limit = value
  action toggleMoved()
    moved = not moved
  action toggleText()
    textMoved = not textMoved
  action pickLift(choice: string)
    liftPicked = choice
  action pick(name: string)
    nav = select(nav, name)
  action back()
    nav = back(nav)
  action follow(url: string)
    nav = go(nav, url)
  view
    main viewport-fit="cover" navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow width="100%" height="100%" display="flex" flex-direction="column" background-color="light-dark(#ffffff, #000000)" color="light-dark(#111827, #f3f4f6)"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key=e.id
              GalleryDemo(section=t.name, navigationId=`${e.id}`, authoredHeader=false, compact=false, back=back, display=display, css=css, platform=platform, pictures=pictures, hdr=hdr, hiddenPictures=hiddenPictures, hiddenHdr=hiddenHdr, caveat=caveat, host=host, tallText=tallText, nativeFeatures=nativeFeatures, one=one, four=four, limit=limit, moved=moved, textMoved=textMoved, videoSource=videoSource, videoPlaying=videoPlaying, liftPicked=liftPicked, active=nav.tab == t.name, chooseVideo=chooseVideo, toggleVideo=toggleVideo, choose=choose, toggleMoved=toggleMoved, toggleText=toggleText, pickLift=pickLift)
      row role="tablist" testId="gallery-sections" overflow-x="auto"
        button appearance="none" role="tab" aria-controls="panel-typography" aria-selected=(nav.tab == "typography") press=pick("typography") testId="section-typography" flex-shrink=0 padding=10
          image "symbol:sf/textformat"
          text "Typography"
        button appearance="none" role="tab" aria-controls="panel-textcolors" aria-selected=(nav.tab == "textcolors") press=pick("textcolors") testId="section-textcolors" flex-shrink=0 padding=10
          image "symbol:sf/paintpalette"
          text "Text colors"
        button appearance="none" role="tab" aria-controls="panel-css" aria-selected=(nav.tab == "css") press=pick("css") testId="section-css" flex-shrink=0 padding=10
          image "symbol:sf/circle.lefthalf.filled"
          text "CSS color spaces"
        button appearance="none" role="tab" aria-controls="panel-profiles" aria-selected=(nav.tab == "profiles") press=pick("profiles") testId="section-profiles" flex-shrink=0 padding=10
          image "symbol:sf/slider.horizontal.3"
          text "Platform profiles"
        button appearance="none" role="tab" aria-controls="panel-images" aria-selected=(nav.tab == "images") press=pick("images") testId="section-images" flex-shrink=0 padding=10
          image "symbol:sf/photo"
          text "Image profiles"
        button appearance="none" role="tab" aria-controls="panel-hdr" aria-selected=(nav.tab == "hdr") press=pick("hdr") testId="section-hdr" flex-shrink=0 padding=10
          image "symbol:sf/sun.max"
          text "HDR"
        button appearance="none" role="tab" aria-controls="panel-effects" aria-selected=(nav.tab == "effects") press=pick("effects") testId="section-effects" flex-shrink=0 padding=10
          image "symbol:sf/sparkles"
          text "Effects & controls"
        button appearance="none" role="tab" aria-controls="panel-media" aria-selected=(nav.tab == "media") press=pick("media") testId="section-media" flex-shrink=0 padding=10
          image "symbol:sf/play.rectangle"
          text "Canvas & video"
        button appearance="none" role="tab" aria-controls="panel-menus" aria-selected=(nav.tab == "menus") press=pick("menus") testId="section-menus" flex-shrink=0 padding=10
          image "symbol:sf/text.bubble"
          text "Context menus"
