// The color gallery (LLP 1100 §10). Not built for Linux, which draws sRGB
// only (LLP 1100 D10).

shape Display
  colorGamut: string
  dynamicRange: string

shape Swatch
  label: string
  color: string

shape SpaceRow
  name: string
  note: string
  swatches: list<Swatch>

shape Picture
  src: string
  label: string
  height: number

shape HdrPicture
  src: string
  label: string

shape PicturePair
  a: Picture
  b: Picture
  two: bool

style Section
  font-size=16
  font-weight=700
  padding-top=18
style Name
  font-family="monospace"
  font-size=12
style Label
  font-family="monospace"
  font-size=11
  padding-top=8
  padding-bottom=2
style Note
  font-size=11
  color="light-dark(#6b655a, #a1a1aa)"
style Legend
  font-size=11
  color="light-dark(#6b655a, #a1a1aa)"
  padding-top=2
  padding-bottom=4
style Row
  flex-direction="row"
style Card
  padding=10
  border-radius=12
style Segmented
  flex-direction="row"
  border-radius=9
  overflow="hidden"
style Segment
  flex-grow=1
  flex-basis=0
  padding-top=6
  padding-bottom=6
  align-items="center"
style SegmentText
  font-size=13
  font-weight=600
style ColumnTitle
  font-size=11
  font-weight=600
  width=116
  text-align="center"
style Hairline
  border-width=0.5
  border-style="solid"
  border-color="light-dark(#9ca3af, #6b7280)"
style Framed
  border-width=1
  border-style="solid"
  border-color="light-dark(#d8d4cc, #3a3a3c)"
style Chip
  width=42
  height=28
  border-width=1
  border-style="solid"
  border-color="light-dark(#d8d4cc, #3a3a3c)"
style Page
  padding-left=16
  padding-right=16
  padding-bottom="calc(env(safe-area-inset-bottom) + 32px)"
  width="100%"
  box-sizing="border-box"
  max-width=720
  margin-left="auto"
  margin-right="auto"

component ColorGallery
  resource display = exactViewport() as shape Display
  resource css = colorSpaces("css") as shape list<SpaceRow>
  resource platform = colorSpaces("platform") as shape list<SpaceRow>
  resource pictures = picturePairs() as shape list<PicturePair>
  resource hdr = hdrPictures() as shape list<HdrPicture>
  resource hiddenPictures = hidden("pictures") as shape string
  resource hiddenHdr = hidden("hdr") as shape string
  resource caveat = caveat("constrained") as shape string
  resource host = hostKind() as shape string
  state limit = "no-limit"
  // Whether the sticky limit card has docked (native only; the web's
  // `sticky-limit` hook animates it on a scroll timeline). It docks at a
  // scroll of 128: the 136 of fixed-height content above it, less its
  // sticky top of 8.
  state docked = false
  action choose(value: string)
    limit = value
  action scrolled(left: number, top: number)
    if host != "web" and docked != (top >= 128)
      docked = top >= 128
  view
    // On the web the document scrolls; natively the scroll view does.
    main viewport-fit="cover" display="flex" flex-direction="column" height=(host == "web" ? "auto" : "100%") min-height="100%" width="100%" position="relative" overflow=(host == "web" ? "visible" : "hidden") dynamic-range-limit=limit background-color="light-dark(#ffffff, #000000)" color="light-dark(#111827, #f3f4f6)"
      scroll flex=(host == "web" ? 0 : 1) min-height=0 width="100%" overflow-x=(host == "web" ? "visible" : "hidden") overflow-y=(host == "web" ? "visible" : "scroll") testId="gallery" scroll=scrolled scroll-edge-effect="soft"
        column class=Page padding-top=16
          box height="env(safe-area-inset-top)" flex-shrink=0
          text "Color Gallery" testId="title" font-size=26 font-weight=800 height=34
          text "Every color space, profile and HDR format Exact supports, side by side." testId="subtitle" font-size=13 color="light-dark(#4b5563, #9ca3af)" height=34 overflow="hidden"
          text `This display's color gamut is ${display.colorGamut == "p3" ? "P3" : display.colorGamut == "rec2020" ? "Rec. 2020" : "sRGB"} and its dynamic range is ${display.dynamicRange == "high" ? "high (HDR)" : "standard (SDR)"}.` testId="facts" font-size=13 margin-top=8 height=34 overflow="hidden"
          column class=Card height=68 margin-top=10 box-sizing="border-box" position="sticky" top="calc(env(safe-area-inset-top) + 8px)" z-index=2 testId="limit-sticky" hook="sticky-limit" box-shadow=(docked ? "0 2px 8px rgba(0, 0, 0, 0.1)" : "0 2px 8px rgba(0, 0, 0, 0)") background-color=(docked ? "light-dark(#ffffff, #1c1c1e)" : "light-dark(#f5f6f8, #1c1c1e)") transition="box-shadow 250ms ease-out, background-color 250ms ease-out"
            LimitControl(limit=limit, choose=choose)

          text "CSS color spaces" class=Section
          text "Each row: red · green · blue · mid · white in that color space (HDR rows: as noted). More saturated than srgb means a wider gamut, visible on a P3 display." class=Legend
          each row in css key=row.name
            SpaceRowView(row=row)

          text "Platform profiles · color(--name …)" class=Section
          text "Color spaces the OS ships, drawn by Apple from the profile. Apple only: browsers and Linux have no such profiles." class=Legend
          each row in platform key=row.name
            SpaceRowView(row=row)

          text "Image profiles" class=Section
          text "One picture per embedded profile, format and depth." class=Legend
          // Labels get their own grid row, so a wrapped label doesn't
          // misalign the pictures.
          column display="grid" grid-template-columns="minmax(0, 1fr) minmax(0, 1fr)" column-gap=8 testId="pictures"
            each pair in pictures key=pair.a.src
              text pair.a.label class=Label align-self="end"
              text (pair.two ? pair.b.label : "") class=Label align-self="end"
              image pair.a.src width="100%" height=pair.a.height object-fit="fill" class=Framed testId=pair.a.src
              when pair.two
                image pair.b.src width="100%" height=pair.b.height object-fit="fill" class=Framed testId=pair.b.src
          when hiddenPictures != ""
            text hiddenPictures class=Note padding-top=6

          text "HDR under each limit, side by side" class=Section
          text "On an HDR display the bright patches step down left to right; on SDR all three match." class=Legend
          column class=Row column-gap=6 padding-top=4
            text "no-limit" class=ColumnTitle
            text "constrained" class=ColumnTitle
            text "standard" class=ColumnTitle
          each p in hdr key=p.src
            HdrTrio(src=p.src, label=p.label)
          when hiddenHdr != ""
            text hiddenHdr class=Note padding-top=6
          when caveat != ""
            text caveat class=Note padding-top=6 testId="constrained-caveat"

          text "HDR colors under each limit" class=Section
          text "color(rec2100-linear 4 4 4): four times SDR white, as a background, text, a text shadow, a border (laid on a layer, and drawn by the view), a box shadow and SVG paint. On an HDR display each row steps down left to right; on SDR all three match." class=Legend
          when host == "web"
            text "Not in browsers yet: none draws rec2100 colors." class=Note padding-top=6
          when host != "web"
            column class=Row column-gap=6 padding-top=4
              text "no-limit" class=ColumnTitle
              text "constrained" class=ColumnTitle
              text "standard" class=ColumnTitle
            HdrPaintTrio(kind="background", label="background")
            HdrPaintTrio(kind="text", label="text")
            HdrPaintTrio(kind="text-shadow", label="text-shadow")
            HdrPaintTrio(kind="border", label="border")
            HdrPaintTrio(kind="drawn-border", label="border, sides of two widths (drawn by the view)")
            HdrPaintTrio(kind="shadow", label="box-shadow")
            HdrPaintTrio(kind="svg-fill", label="SVG fill")
            HdrPaintTrio(kind="svg-stroke", label="SVG stroke")
            text "Not yet HDR on Apple: SVG gradients, patterns, masks and filters, which are drawn into SDR pictures (LLP 1100)." class=Note padding-top=6

          text "Canvas 2D color-space" class=Section
          text "Each canvas: sRGB red, then color(display-p3 1 0 0). They match in the sRGB canvas; the right half is redder in the P3 ones." class=Legend
          text "color-space=srgb" class=Label
          canvas surface=reds() testId="canvas-srgb" width=256 height=24
          text "color-space=display-p3" class=Label
          canvas surface=reds() testId="canvas-p3" width=256 height=24 color-space="display-p3"
          text "color-space=display-p3 color-type=float16" class=Label
          canvas surface=reds() testId="canvas-p3-float16" width=256 height=24 color-space="display-p3" color-type="float16"

          text "Text" class=Section
          text "The same red as text: sRGB, then Display P3 (redder on a P3 display)." class=Legend
          text "sRGB red text" color="red" font-size=18 font-weight=700
          text "Display P3 red text" testId="p3-text" color="color(display-p3 1 0 0)" font-size=18 font-weight=700

          text "Shadows" class=Section
          text "A shadow's color is painted on its own path. Each pair: the sRGB color, then the Display P3 one (more vivid on a P3 display)." class=Legend
          ShadowPair(label="green", srgb="rgb(0 255 0 / 0.85)", p3="color(display-p3 0 1 0 / 0.85)")
          ShadowPair(label="red", srgb="rgb(255 0 0 / 0.85)", p3="color(display-p3 1 0 0 / 0.85)")
          ShadowPair(label="blue", srgb="rgb(0 0 255 / 0.85)", p3="color(display-p3 0 0 1 / 0.85)")

component LimitControl
  props
    limit: string
    choose: action
  view
    column row-gap=4
      // A UISegmentedControl on iOS; these styles draw it elsewhere.
      column class=Segmented role="tablist" aria-label="dynamic-range-limit" testId="limit-segments"
        button role="tab" aria-selected=(limit == "no-limit") press=choose("no-limit") testId="limit-no-limit" class=Segment background-color=(limit == "no-limit" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "no-limit" class=SegmentText color=(limit == "no-limit" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")
        button role="tab" aria-selected=(limit == "constrained") press=choose("constrained") testId="limit-constrained" class=Segment background-color=(limit == "constrained" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "constrained" class=SegmentText color=(limit == "constrained" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")
        button role="tab" aria-selected=(limit == "standard") press=choose("standard") testId="limit-standard" class=Segment background-color=(limit == "standard" ? "#1f6feb" : "light-dark(#e5e7eb, #2c2c2e)")
          text "standard" class=SegmentText color=(limit == "standard" ? "#ffffff" : "light-dark(#1f2937, #e5e7eb)")
      text `dynamic-range-limit: ${limit} · all but the side-by-side HDR` testId="limit-note" class=Note text-align="center" white-space="nowrap" overflow="hidden" text-overflow="ellipsis"

component ShadowPair
  props
    label: string
    srgb: string
    p3: string
  view
    column class=Row column-gap=24 align-items="center" padding-top=14 padding-bottom=6
      text label class=Name width=48
      column align-items="center" row-gap=10
        box width=96 height=28 border-radius=8 background-color="light-dark(#ffffff, #1c1c1e)" box-shadow=`0 6px 16px ${srgb}`
        text "sRGB" class=Note
      column align-items="center" row-gap=10
        box width=96 height=28 border-radius=8 background-color="light-dark(#ffffff, #1c1c1e)" box-shadow=`0 6px 16px ${p3}` testId=`p3-shadow-${label}`
        text "Display P3" class=Note

component SpaceRowView
  props
    row: SpaceRow
  view
    column class=Row testId=row.name align-items="center" column-gap=8 padding-top=6
      column width=128 flex-shrink=0
        text row.name class=Name
        text row.note class=Note
      column class=Row column-gap=4
        each s in row.swatches key=s.label
          box class=Chip background-color=s.color

component HdrPaintTrio
  props
    kind: string
    label: string
  view
    column
      text label class=Label
      column class=Row column-gap=6
        column dynamic-range-limit="no-limit"
          HdrPaint(kind=kind)
        column dynamic-range-limit="constrained"
          HdrPaint(kind=kind)
        column dynamic-range-limit="standard"
          HdrPaint(kind=kind)

component HdrPaint
  props
    kind: string
  view
    column width=116 height=32 box-sizing="border-box" background-color="#000000" align-items="center" justify-content="center" class=Hairline testId=`hdr-${kind}`
      when kind == "background"
        box width=116 height=32 background-color="color(rec2100-linear 4 4 4)"
      when kind == "text"
        text "HDR" font-size=20 font-weight=800 color="color(rec2100-linear 4 4 4)"
      when kind == "text-shadow"
        text "HDR" font-size=20 font-weight=800 color="#202020" text-shadow="0 0 6px color(rec2100-linear 4 4 4)"
      when kind == "border"
        box width=100 height=20 border-width=4 border-style="solid" border-color="color(rec2100-linear 4 4 4)"
      when kind == "drawn-border"
        box width=100 height=20 box-sizing="border-box" border-width=2 border-left-width=8 border-right-width=8 border-style="solid" border-color="color(rec2100-linear 4 4 4)"
      when kind == "shadow"
        box width=60 height=12 background-color="#000000" box-shadow="0 0 10px 4px color(rec2100-linear 4 4 4)"
      when kind == "svg-fill"
        svg viewBox="0 0 116 32" width=116 height=32
          rect x=8 y=6 width=100 height=20 rx=4 fill="color(rec2100-linear 4 4 4)"
      when kind == "svg-stroke"
        svg viewBox="0 0 116 32" width=116 height=32
          rect x=8 y=6 width=100 height=20 rx=4 fill="none" stroke="color(rec2100-linear 4 4 4)" stroke-width=4

component HdrTrio
  props
    src: string
    label: string
  view
    column
      text label class=Label
      column class=Row column-gap=6
        column dynamic-range-limit="no-limit"
          image src width=116 height=32 object-fit="fill" class=Hairline
        column dynamic-range-limit="constrained"
          image src width=116 height=32 object-fit="fill" class=Hairline
        column dynamic-range-limit="standard"
          image src width=116 height=32 object-fit="fill" class=Hairline
