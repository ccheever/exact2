{
  "$schema": "../../scripts/app.schema.json",
  "name": "Color Gallery",
  "short_name": "Color Gallery",
  "id": "com.exact.colorgallery",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "icons": [
    {
      "src": "assets/icon.png",
      "sizes": "1024x1024",
      "type": "image/png"
    }
  ],
  "app": {
    "id": "com.exact.colorgallery",
    "name": "Color Gallery"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 420,
        "height": 900,
        "minWidth": 320,
        "minHeight": 420
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0"
    }
  },
  "hatches": [
    "sticky-limit"
  ]
}
