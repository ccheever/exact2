// @ref LLP 1042 — a stable video leaf, resized by the keyboard's viewport.
component VideoPlayer
  state note = ""
  state paused = false
  state failure = ""
  action edit(value) writes note
    note = value
  action toggle writes paused
    paused = not paused
  action playing writes paused
    paused = false
  action stopped writes paused
    paused = true
  action failed(message) writes failure
    failure = message
  action done
    focus("done")
  view
    column testId="player-app" interactive-widget="resizes-content" height="100%" box-sizing="border-box" padding=20 gap=16 background-color="#11151c" color="#f5f7fa"
      row justify-content="space-between" align-items="center" flex-shrink=0
        column gap=4
          text "VIDEO" font-size=11 font-weight=700 letter-spacing=2 color="#94a3b8"
          text "Room to watch." font-size=26 font-weight=600
        button testId="toggle" press=toggle aria-label="Play or pause" padding=12 background-color="#273244" border-radius=12
          text (paused ? "Play" : "Pause") font-size=14
      video "assets/motion.mp4" testId="video" aria-label="An animated color study" controls=true autoplay=true muted=true loop=true playsinline=true preload="auto" paused=paused play=playing pause=stopped error=failed width="100%" flex=1 min-height=0 object-fit="contain" overflow="hidden" background-color="#000000" border-radius=16
      when failure != ""
        text failure testId="video-error" color="#fca5a5" font-size=12 flex-shrink=0
      column gap=10 flex-shrink=0
        text "Keep watching. Leave a thought." font-size=16 font-weight=600
        row gap=10 align-items="center"
          input id="note" testId="note" aria-label="Your note" placeholder="Tap here to bring up the keyboard" value=note change=edit submit=done flex=1 min-width=0 padding=14 box-sizing="border-box" font-size=16 border-radius=12 background-color="#202938" color="#f5f7fa"
          button id="done" testId="done" press=done padding=14 background-color="#bed6ff" border-radius=12
            text "Done" color="#102540" font-weight=600
        text "The picture makes room while you type." font-size=12 color="#94a3b8"
