  derive pending6 = (pending(r96) ? 1 : 0) + (pending(r97) ? 1 : 0) + (pending(r98) ? 1 : 0) + (pending(r99) ? 1 : 0) + (pending(r100) ? 1 : 0) + (pending(r101) ? 1 : 0) + (pending(r102) ? 1 : 0) + (pending(r103) ? 1 : 0) + (pending(r104) ? 1 : 0) + (pending(r105) ? 1 : 0) + (pending(r106) ? 1 : 0) + (pending(r107) ? 1 : 0) + (pending(r108) ? 1 : 0) + (pending(r109) ? 1 : 0) + (pending(r110) ? 1 : 0) + (pending(r111) ? 1 : 0)
