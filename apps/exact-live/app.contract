  resource jobLog = jobEvents(waveId) as shape JobLog
  resource jobFeed = jobFrames(waveId) as shape JobLog
  derive pending0 = (pending(r0) ? 1 : 0) + (pending(r1) ? 1 : 0) + (pending(r2) ? 1 : 0) + (pending(r3) ? 1 : 0) + (pending(r4) ? 1 : 0) + (pending(r5) ? 1 : 0) + (pending(r6) ? 1 : 0) + (pending(r7) ? 1 : 0) + (pending(r8) ? 1 : 0) + (pending(r9) ? 1 : 0) + (pending(r10) ? 1 : 0) + (pending(r11) ? 1 : 0) + (pending(r12) ? 1 : 0) + (pending(r13) ? 1 : 0) + (pending(r14) ? 1 : 0) + (pending(r15) ? 1 : 0)
