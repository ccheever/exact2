// Exact Live: one device-local creative workspace, ordinary Exact hosts.
fn photoFit(bw: number, bh: number, nw: number, nh: number): number = bw > 0 && bh > 0 && nw > 0 && nh > 0 ? min(bw / nw, bh / nh) : 0
fn photoZoom(scale: number): number = min(max(scale, 1), 4)
fn photoClamp(value: number, natural: number, fit: number, zoom: number, port: number): number = min(max(value, -max(0, (natural * fit * zoom - port) / 2)), max(0, (natural * fit * zoom - port) / 2))

shape Theme
  page: string
  card: string
  edge: string
  ink: string
  muted: string
  wash: string
  accent: string

shape Photo
  id: string
  title: string
  subtitle: string
  asset: string
  alt: string
  tone: string
  notes: string
  rank: number

shape ViewerState
  viewerToken: number
  photo: Photo
  naturalWidth: number
  naturalHeight: number

shape GalleryState
  mode: string
  total: number
  requested: number
  page: number
  pages: number
  first: number
  end: number
  revision: number
  selected: Photo
  hasSelection: bool
  viewerOpen: bool
  viewerToken: number
  hasPrevious: bool
  hasNext: bool
  reordering: bool
  dragToken: number
  liftedId: string
  beforeId: string
  previewLabel: string
  notice: string
  returnKind: string
  returnId: string
  canInsert: bool
  canPagePrevious: bool
  canPageNext: bool
  viewer: ViewerState[]

shape Viewport
  height: number
  width: number
  pointer: string
shape Message
  id: string
  sender: string
  body: string
  outgoing: bool
  meta: string
shape History
  rows: Message[]
  materialized: number
  revision: number
  changed: number
  bodyBytes: number
  earlier: string
  later: string
  hasEarlier: bool
  hasLater: bool
shape Run
  id: string
  text: string
  weight: number
  slant: string
  mono: bool
  href: string
shape Cell
  id: string
  runs: Run[]
shape Block
  id: string
  kind: string
  depth: number
  marker: string
  text: string
  href: string
  header: bool
  runs: Run[]
  cells: Cell[]
shape Runbook
  title: string
  sourceBytes: number
  blocks: Block[]
shape Wave
  id: number
  count: number
  message: string
shape Reply
  wave: number
  lane: number
  ok: bool
  message: string
shape Control
  message: string
  received: number
  issued: number
  held: number
shape JobLog
  wave: number
  status: string
  count: number
  received: number
  held: number
  finished: number
  entries: number
  seq: number
  messages: number
  coalesced: number
  gaps: number
  reasks: number
  last: string

component ExactLive
  resource viewport = exactViewport() as shape Viewport
  resource theme = theme() as shape Theme
  resource initial = gallery() as shape GalleryState
  mutation changed as shape GalleryState
  derive gallery = match changed { case some(value) => value, case none => initial }
  resource rows = galleryRows(gallery.revision, 0, true) as shape Photo[]
  state bookBytes = 0
  resource book = runbook(bookBytes) as shape Runbook
  state pane = "rundown"
  state inspector = false
  state crewSheet = false
  state sheetPx = 360
  state readingNarrow = false
  state count = 0
  state revision = 0
  state batch = 32
  state running = false
  state draft = ""
  state echo = ""
  state replying = ""
  state draftTooLong = false
  resource history = history(count, revision, batch, echo, 0, true) as shape History
  derive wide = viewport.width >= 900
  // No pointer is a TV's remote: text is read from across a room, 1.4 times as large.
  derive tv = viewport.pointer == "none"
  derive k = tv ? 1.4 : 1
  state fixtureEnabled = false
  mutation wave as shape Wave
  mutation fixture as shape Control
  derive waveId = match wave { case some(value) => value.id, case none => 0 }
  derive waveCount = match wave { case some(value) => value.count, case none => 0 }
  derive waveMessage = match wave { case some(value) => value.message, case none => "Desktop fixture not attached" }
  derive fixtureMessage = match fixture { case some(value) => value.message, case none => "" }
  derive active = waveId > 0 && ! pending(wave)
  resource r0 = completion(waveId, 0, waveCount, active) as shape Reply
  resource r1 = completion(waveId, 1, waveCount, active) as shape Reply
