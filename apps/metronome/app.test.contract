// The metronome's tests (LLP 1125 D5): a sequence's steps are voices in the
// runner's record, so `clock +N` then `expect sound … at N` checks every hit
// with no audio, and `exactTransport()` is `transport`. Run on any host with
// `bun scripts/agent.mjs <host> --test apps/metronome/app.test.contract`.

test "four clicks count in, then beat 1 is accented"
  tap "toggle"
  expect state transport.state == "countin"
  expect state transport.anchorBeat == -4
  clock +2100
  expect state transport.state == "playing"
  expect sound has "assets/click-high.wav" at 0
  expect sound has "assets/click-high.wav" at 1500
  expect sound has "assets/click-high.wav" at 2000
  expect sound has "assets/click-low.wav" at 2500 gain 0.6
  expect text "beat" == "Beat 1"

test "the tempo moves from the beat it reached"
  tap "count-in"
  tap "toggle"
  clock +1000
  tap "faster"
  expect text "bpm" == "121"
  expect state transport.bpm == 121
  expect state transport.anchorBeat == 2
  clock +2000
  expect sound has "assets/click-low.wav" at 500
  expect sound has "assets/click-low.wav" at 1500 by edit
  expect sound missing "assets/click-low.wav" at 1500 by end

test "an edit retracts what has not started and plays the new value"
  tap "count-in"
  tap "toggle"
  clock +1250
  tap "accent"
  expect sound has "assets/click-low.wav" at 1500 by edit
  expect sound has "assets/click-low.wav" at 1500 by end
  clock +1000
  expect sound has "assets/click-low.wav" at 2000 gain 1
  expect sound missing "assets/click-high.wav" at 2000

test "the drum pattern's tracks loop at their own lengths"
  tap "count-in"
  tap "groove"
  tap "toggle"
  clock +3000
  expect sound has "assets/kick.wav" at 0
  expect sound has "assets/snare.wav" at 500
  expect sound has "assets/kick.wav" at 1250 gain 0.8
  expect sound has "assets/hat.wav" at 250 gain 0.35
  expect sound has "assets/clap.wav" at 1000
  expect sound has "assets/clap.wav" at 2500
  expect sound has "assets/kick.wav" at 2000

test "stop ends what waits, and the transport says why"
  tap "haptics"
  expect state haptics == true
  tap "count-in"
  tap "toggle"
  clock +1250
  tap "toggle"
  expect state transport.state == "stopped"
  expect state transport.reason == "gate"
  expect sound has "assets/click-low.wav" at 1500 by cancelled
  clock +2000
  expect sound missing "assets/click-high.wav" at 2000

test "with an output chosen, each click is a note there, on the clock it sends"
  prefer midi.outputs "OP-XY, IAC"
  tap "connect"
  type "output" "OP-XY"
  tap "clock"
  tap "count-in"
  tap "toggle"
  clock +1000
  expect midi sent "OP-XY" fa at 0
  expect midi sent "OP-XY" 99 4c 7f at 0
  expect midi sent "OP-XY" 89 4c 00 at 50
  expect midi sent "OP-XY" 99 4d 4c at 500
  expect midi missing "IAC" 99 4c 7f
  tap "toggle"
  expect midi sent "OP-XY" fc

test "the drum pattern's notes follow its tracks"
  prefer midi.outputs "OP-XY"
  tap "connect"
  type "output" "OP-XY"
  tap "count-in"
  tap "groove"
  tap "toggle"
  clock +2000
  expect midi sent "OP-XY" 99 24 7f at 0
  expect midi sent "OP-XY" 99 26 72 at 500
  expect midi sent "OP-XY" 99 2a 2c at 250
  expect midi sent "OP-XY" 99 27 59 at 1000
  expect midi missing "OP-XY" fa

test "with no output chosen nothing is sent"
  prefer midi.outputs "OP-XY"
  tap "connect"
  tap "count-in"
  tap "toggle"
  clock +1000
  expect midi missing "OP-XY" 99 4c 7f at 0

test "following an input's clock, it waits for Start and plays at the device's tempo"
  prefer midi.inputs "OP-XY"
  tap "connect"
  type "follow" "OP-XY"
  tap "count-in"
  tap "toggle"
  expect state transport.state == "waiting"
  expect text "beat" == "Waiting for clock"
  tap midi "OP-XY" clock 125 1000
  expect text "bpm" == "125"
  tap midi "OP-XY" fa
  tap midi "OP-XY" clock 125 1000
  expect state transport.state == "playing"
  expect sound has "assets/click-high.wav" at 1020
  expect sound has "assets/click-low.wav" at 1500 gain 0.6
  expect sound has "assets/click-low.wav" at 1980 gain 0.6
  tap midi "OP-XY" fc
  expect state transport.state == "waiting"
  expect state transport.reason == "clock"
  expect text "beat" == "Waiting for clock"

after "faster" "faster writes only bpm"
  only writes bpm

after "slower" "slower writes only bpm"
  only writes bpm

always "bpm is a whole number"
  expect state bpm whole
