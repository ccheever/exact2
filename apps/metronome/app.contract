// A metronome and drum machine, LLP 1125's stage 2 consumer: one `sequence`
// declares what plays, and the runner plays it a second ahead on its own
// clock. A tempo stepper, an accent on beat 1, a count-in of four, a haptic on
// each beat, and a four-track drum pattern whose tracks loop at their own
// lengths. No action runs per beat. The beat readout is the one thing that
// changes with the beat, so it is a frame task gated on the states that show
// it, whose action writes the beat it reads from `exactTransport()`, not the
// time: a frame on which the beat has not changed commits nothing. With a
// MIDI output chosen (LLP 1125 stage 3) each click and drum is also a note on
// the General MIDI percussion channel, and the output can be sent its clock.
// With an input chosen to follow (stage 4) the sequence keeps that device's
// time instead: it waits for Start, counts in, and plays at the device's
// tempo, which the stepper's place shows. Share as image sends a picture of
// the tempo card where the host draws one (LLP 1125 D12). A practice timer is an
// alarm (LLP 1133.030 D17): it rings through silent mode and Focus when the
// time is up, stops the transport, and offers another round; its row shows
// only where the device has alarms.
use scheduleAlarm, cancelAlarm, pauseAlarm, resumeAlarm, alarms, alarmStatus, AlarmStatus, Alarm from "@exact/alarms"

sound "assets/click-high.wav"
sound "assets/click-low.wav"
sound "assets/kick.wav"
sound "assets/snare.wav"
sound "assets/hat.wav"
sound "assets/clap.wav"

shape Step
  beat: number
  src: string
  gain: number
  group: string
  note: number
  velocity: number
  channel: number
  duration: number
  haptic: string

shape Track
  beats: number
  loops: number
  offset: number
  output: string
  steps: Step[]

shape Page
  canSharePictures: bool

shape Transport
  state: string
  reason: string
  bpm: number
  anchorAt: number
  anchorBeat: number

shape Port
  id: string
  name: string
  state: string

shape MIDI
  state: string
  inputs: Port[]
  outputs: Port[]

shape Time
  epochAtZero: number

// A step's sample and, on a track with a MIDI output, its General MIDI
// percussion note (channel 10, index 9) at the sample's level.
fn step(beat: number, src: string, gain: number, haptic: string, note: number): Step = Step(beat=beat, src=src, gain=gain, group="", note=note, velocity=max(1, round(gain * 127)), channel=9, duration=0.1, haptic=haptic)
fn drum(beat: number, src: string, gain: number, note: number): Step = step(beat, src, gain, "", note)
fn track(beats: number, out: string, steps: Step[]): Track = Track(beats=beats, loops=0, offset=0, output=out, steps=steps)

// Time left as minutes and seconds, rounded up, as a countdown reads.
fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn clock(ms: number): string = `${floor(ceil(ms / 1000) / 60)}:${pad2(ceil(ms / 1000) % 60)}`

// A bar of four clicks: beat 1 high when accented (the high and low wood
// blocks, 76 and 77), each beat's haptic when asked.
fn bar(accent: bool, buzz: bool, out: string): Track = track(4, out, [step(0, accent ? "assets/click-high.wav" : "assets/click-low.wav", 1, buzz ? "impact-medium" : "", accent ? 76 : 77), step(1, "assets/click-low.wav", 0.6, buzz ? "impact-light" : "", 77), step(2, "assets/click-low.wav", 0.6, buzz ? "impact-light" : "", 77), step(3, "assets/click-low.wav", 0.6, buzz ? "impact-light" : "", 77)])

// Kick and snare over a bar, eighth-note hats, and a clap every three beats
// against them (General MIDI's 36, 38, 42 and 39).
fn drums(out: string): Track[] = [track(4, out, [drum(0, "assets/kick.wav", 1, 36), drum(2.5, "assets/kick.wav", 0.8, 36)]), track(4, out, [drum(1, "assets/snare.wav", 0.9, 38), drum(3, "assets/snare.wav", 0.9, 38)]), track(1, out, [drum(0, "assets/hat.wav", 0.5, 42), drum(0.5, "assets/hat.wav", 0.35, 42)]), track(3, out, [drum(2, "assets/clap.wav", 0.7, 39)])]

component Metronome
  state playing = false
  state bpm = 120
  state accent = true
  state countIn = true
  state haptics = false
  state groove = false
  // The beat the readout shows: the floor of the transport's position, written by `draw`.
  state beat = 0
  // The MIDI output chosen, by its id ("" for none), and whether it follows the clock.
  state output = ""
  state clock = false
  // The MIDI input whose clock it follows, by its id ("" keeps its own time).
  state follow = ""
  // The practice length chosen, in minutes, and the session's time, which a
  // running practice timer ticks each second for its readout.
  state practiceMinutes = 10
  state now = 0
  resource transport = exactTransport() as shape Transport
  resource page = exactPage() as shape Page
  resource midi = exactMIDI() as shape MIDI
  resource time = exactTime() as shape Time
  resource alarmState = alarmStatus() as shape AlarmStatus
  resource alarmList = alarms() as shape Alarm[]
  // The practice alarm, and its state ("" when there is none).
  derive practice = alarmList.filter(a => a.tag == "practice")
  derive practiceState = practice.map(a => a.state).join("")
  derive tracks = groove ? [bar(accent, haptics, output)].concat(drums(output)) : [bar(accent, haptics, output)]
  derive clicks = [step(0, "assets/click-high.wav", 1, "", 76), step(1, "assets/click-high.wav", 1, "", 76), step(2, "assets/click-high.wav", 1, "", 76), step(3, "assets/click-high.wav", 1, "", 76)]
  // The beat now: computed here so the transport's own commit (start, seek, the
  // count-in's end) shows its first beat, not the one `draw` wrote before it;
  // `beat` is read too so each beat `draw` writes recomputes it.
  derive current = floor(transport.anchorBeat + (performanceNow() - transport.anchorAt) * transport.bpm / 60000) + 0 * beat
  derive shown = transport.state == "countin" ? `Count-in ${current + 5}` : transport.state == "playing" ? `Beat ${current % 4 + 1}` : transport.state == "waiting" ? "Waiting for clock" : "Stopped"
  // Following a clock, the device's tempo while the sequence follows it.
  derive tempo = follow != "" and transport.state != "stopped" ? transport.bpm : bpm

  action toggle
    playing = not playing
  action slower
    bpm = max(30, bpm - 1)
  action faster
    bpm = min(300, bpm + 1)
  action setAccent(on: bool)
    accent = on
  action setCountIn(on: bool)
    countIn = on
  action setHaptics(on: bool)
    haptics = on
  action setGroove(on: bool)
    groove = on
  action shareCard
    share(title="Metronome", text=`${bpm} BPM`, files=["#card"])
  action draw
    beat = floor(transport.anchorBeat + (performanceNow() - transport.anchorAt) * transport.bpm / 60000)
  action connect
    requestMIDIAccess()
  action chooseOutput(id: string)
    output = id
  action setClock(on: bool)
    clock = on
  action chooseFollow(id: string)
    follow = id
  action choosePractice(minutes: number)
    practiceMinutes = minutes
  // The alarm asks for permission itself while it is `prompt` (D7).
  action startPractice
    now = performanceNow()
    scheduleAlarm(tag="practice", title=`Practice: ${practiceMinutes} min`, duration=practiceMinutes * 60000, snooze=practiceMinutes * 60000)
  action pausePractice
    pauseAlarm(tag="practice")
  action resumePractice
    now = performanceNow()
    resumeAlarm(tag="practice")
  action cancelPractice
    cancelAlarm(tag="practice")
  action tickPractice
    now = performanceNow()
  // The alarm is heard alone, and nothing resumes after it.
  action practiceUp
    playing = false
  action practiceSettings
    openURL("app-settings:")

  sequence click when playing
    play(tracks, bpm=bpm, from=countIn ? -4 : 0, countIn=clicks, clock=follow, clockOut=clock ? output : "")
  task readout when transport.state == "countin" or transport.state == "playing"
    every(frame, draw)
  task practiceTick when practiceState == "countdown"
    every(1000, tickPractice)
  task practiceRing when practiceState == "alerting"
    after(1, practiceUp)

  view
    main accent-color="-exact-system-orange" display="flex" flex-direction="column" align-items="center" justify-content="center" flex=1 gap=24 padding=24 testId="app"
      column align-items="center" gap=8 max-width=420
        column id="card" align-items="center" gap=4 padding=16 border-radius=12 background-color="-exact-secondary-background" testId="card"
          text `${tempo}` font="-exact-large-title" testId="bpm"
          text "beats a minute" font="-exact-footnote" color="-exact-secondary-label"
          text (groove ? "Kick, snare, hats and clap" : accent ? "Click, beat 1 accented" : "Click") font="-exact-footnote" testId="pattern"
        row gap=12
          button press=slower aria-label="Slower" testId="slower"
            text "−"
          button press=faster aria-label="Faster" testId="faster"
            text "+"
      text shown font="-exact-title-2" testId="beat"
      button press=toggle buttonStyle="filled" testId="toggle"
        text (playing ? "Stop" : "Start")
      if page.canSharePictures
        button press=shareCard testId="share-card"
          text "Share as image"
      // A practice timer, where the device has alarms (iOS 26 and Android).
      if alarmState.available
        column gap=8 max-width=420 align-items="center" testId="practice"
          match first(practice)
            case some(p)
              match p.at
                case some(at)
                  text (p.state == "alerting" ? "Time is up" : `${clock(max(0, at - time.epochAtZero - now))} left`) font="-exact-title-3" font-variant-numeric="tabular-nums" testId="practice-left"
                case none
                  match p.remaining
                    case some(left)
                      text `Paused, ${clock(left)} left` font="-exact-title-3" font-variant-numeric="tabular-nums" testId="practice-left"
                    case none
                      text p.title font="-exact-title-3" testId="practice-left"
              row gap=12
                if p.state == "paused"
                  button press=resumePractice testId="practice-resume"
                    text "Resume"
                else if p.state == "countdown"
                  button press=pausePractice testId="practice-pause"
                    text "Pause"
                button press=cancelPractice testId="practice-cancel"
                  text (p.state == "alerting" ? "Stop" : "Cancel")
            case none
              text "Practice" font="-exact-headline"
              row role="radiogroup" aria-label="Practice length" gap=4
                for m in [5, 10, 20, 30] key=m
                  button role="radio" aria-checked=(practiceMinutes == m) press=choosePractice(m) testId=`practice-${m}`
                    text `${m} min`
              if alarmState.state == "denied"
                text "Alarms are turned off for Metronome." font="-exact-footnote" color="-exact-secondary-label" testId="practice-denied"
                button press=practiceSettings testId="practice-settings"
                  text "Open Settings"
              else
                button press=startPractice buttonStyle="bordered" testId="practice-start"
                  text "Start practice"
      column gap=8 max-width=420
        row gap=8 align-items="center"
          input type="checkbox" checked=accent change=setAccent aria-label="Accent beat 1" testId="accent"
          text "Accent beat 1"
        row gap=8 align-items="center"
          input type="checkbox" checked=countIn change=setCountIn aria-label="Count in" testId="count-in"
          text "Count in"
        row gap=8 align-items="center"
          input type="checkbox" checked=haptics change=setHaptics aria-label="Haptic on the beat" testId="haptics"
          text "Haptic on the beat"
        row gap=8 align-items="center"
          input type="checkbox" checked=groove change=setGroove aria-label="Drum pattern" testId="groove"
          text "Drum pattern"
      // MIDI out: asked for at a press, then an output to play on and follow the clock.
      column gap=8 max-width=420
        if midi.state == "granted"
          row gap=8 align-items="center"
            text "MIDI output"
            select value=output change=chooseOutput aria-label="MIDI output" testId="output"
              option "None" value=""
              for o in midi.outputs key = o.id
                option (o.state == "connected" ? o.name : `${o.name} (disconnected)`) value=o.id
          row gap=8 align-items="center"
            input type="checkbox" checked=clock change=setClock aria-label="Send MIDI clock" testId="clock"
            text "Send MIDI clock"
          row gap=8 align-items="center"
            text "Follow clock"
            select value=follow change=chooseFollow aria-label="Follow clock" testId="follow"
              option "None" value=""
              for i in midi.inputs key = i.id
                option (i.state == "connected" ? i.name : `${i.name} (disconnected)`) value=i.id
        else if midi.state == "prompt"
          button press=connect testId="connect"
            text "Connect MIDI"
        else
          text (midi.state == "denied" ? "MIDI is not allowed" : "MIDI is unavailable here") font="-exact-footnote" color="-exact-secondary-label" testId="midi-state"
