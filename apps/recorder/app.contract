// The recorder (LLP 1133.009 §11): the microphone through the standard
// packages, as any app's would be. `getUserMedia` opens a track and
// `startMediaRecorder` records it to a file at app:/data/takes; the waveform
// is the level's last 200 intervals drawn as bars, and the elapsed time is
// the recorder's own. app.ts lists the takes and keeps each one's length and
// level.
use getUserMedia, stopTrack, microphoneStatus, MediaStream, MediaStreamTrack, MicrophoneStatus from "@exact/media-capture"
use startMediaRecorder, stopMediaRecorder, pauseMediaRecorder, resumeMediaRecorder, mediaRecorderState, audioLevel, MediaRecorderInfo, RecordedMedia, AudioLevel from "@exact/recording"

shape Take
  name: string
  label: string
  path: string
shape Takes
  takes: Take[]
  next: number
shape Kept
  name: string
  message: string

component Recorder
  state trackId = ""
  state recorderId = ""
  resource mic = microphoneStatus() as shape MicrophoneStatus else empty()
  resource library = takes() as shape Takes else empty()
  resource level = audioLevel(track=trackId, history=200) as shape AudioLevel else empty()
  resource rec = mediaRecorderState(recorder=recorderId, interval=100) as shape MediaRecorderInfo else empty()
  mutation opened as shape MediaStream then arm
  mutation started as shape MediaRecorderInfo then begun
  mutation saved as shape RecordedMedia then filed
  mutation paused as shape MediaRecorderInfo
  mutation stopped as shape MediaStreamTrack
  mutation kept as shape Kept refreshes library
  derive recording = recorderId != ""
  derive busy = pending(opened) or pending(started) or pending(saved)
  derive denied = mic.state == "denied"
  action toggle
    if recording
      send saved = stopMediaRecorder(recorder=recorderId)
    else
      send opened = getUserMedia(audio=true)
  // Supersedes the microphone's request, whatever stage it is at.
  action cancelRecord
    send opened = getUserMedia(audio=false)
  action arm
    match opened
      case some(s)
        trackId = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        send started = startMediaRecorder(stream=s.id, path=`app:/data/takes/take-${library.next}`)
      case none
        trackId = ""
  action begun
    match started
      case some(r)
        recorderId = r.id
      case none
        recorderId = ""
  action pause
    if rec.state == "paused"
      send paused = resumeMediaRecorder(recorder=recorderId)
    else
      send paused = pauseMediaRecorder(recorder=recorderId)
  action filed
    match saved
      case some(m)
        send kept = keepTake(m.path, m.duration, level.levels.length == 0 ? 0 : sum(level.levels) / level.levels.length)
        send stopped = stopTrack(track=trackId)
        trackId = ""
        recorderId = ""
      case none
        recorderId = recorderId
  action openSettings
    openURL("app-settings:")
  view
    column testId="recorder" width="100%" height="100%" gap=16 padding=20 box-sizing="border-box" background-color="-exact-background" color="-exact-label" accent-color="light-dark(#0b66d6, #68a5fe)" font-family="system-ui"
      text "Recorder" font-size=24 font-weight=600
      row testId="waveform" width="100%" height=140 flex-shrink=0 gap=2 padding=8 box-sizing="border-box" align-items="center" justify-content="flex-end" overflow="hidden" border-radius=12 background-color="-exact-secondary-background"
        for v, i in level.levels key=i
          box width=3 flex-shrink=0 height=(2 + v * 116) border-radius=1 background-color=(recording ? "light-dark(#d1242f, #ff4245)" : "AccentColor")
      row gap=12 align-items="center"
        // System red and AccentColorText do not guarantee 4.5:1 on every host.
        button press=toggle disabled=(busy or denied or not mic.available) testId="toggle" padding=12 border-radius=24 background-color=(recording ? "light-dark(#b91c1c, #ff4245)" : "AccentColor")
          text (recording ? "Stop" : "Record") color="light-dark(#ffffff, #000000)" font-weight=600
        if recording
          button press=pause testId="pause" padding=12 border-radius=24 background-color="-exact-secondary-background"
            text (rec.state == "paused" ? "Resume" : "Pause") font-weight=600
          text (rec.state == "paused" ? "Paused " : "● ") + formatDecimal(round(rec.duration / 100), 1) + " s" testId="elapsed" font-size=14 color="-exact-secondary-label" font-variant-numeric="tabular-nums"
        else
          text (mic.available ? "Ready" : "Recording is not available here.") testId="status" font-size=14 color="-exact-secondary-label"
      if pending(opened)
        button press=cancelRecord testId="cancel-record"
          text "Cancel"
      if denied
        text "The microphone is off for Recorder. Turn it on in Settings to record." testId="denied" font-size=13 color="-exact-secondary-label"
        button press=openSettings testId="open-settings"
          text "Open Settings"
      match kept
        case some(k)
          text k.message testId="saved-message" font-size=13 color="light-dark(#166534, #7ee2a8)"
        case none
          text "" font-size=13
      text (library.takes.length == 0 ? "No takes yet." : "Takes") font-size=16 font-weight=600 testId="takes-heading"
      column gap=6 testId="takes"
        for take in library.takes key=take.name
          column gap=6 padding=10 border-radius=8 background-color="-exact-secondary-background" testId=("take-" + take.name)
            text take.label font-size=14
            audio src=take.path controls=true preload="metadata" width="100%" testId=("play-" + take.name)
