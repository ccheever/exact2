use PrimaryText from "./palette.contract"
use AccentText from "./palette.contract"
use PrimaryIcon from "./palette.contract"
use PrimaryFill from "./palette.contract"
use PageSurface from "./palette.contract"
use PageCanvas from "./palette.contract"
use Inbox, DeletedInbox, Recipients, ComposerDraft, Conversation from "./models.contract"
use Change from "./models.contract"
use NewMessageSheet from "./new-message-sheet.contract"
use MessageBubble, TypingIndicator, ReactionArtwork from "./message-parts.contract"
use NewContactSheet from "./new-contact-sheet.contract"
use ContactDetails from "./contact-details.contract"

// Messages: the router owns locations; UIKit owns the keyboard and scrolling.
// @ref LLP 1038 §6, D8/D11 — state outside nav remains application state.
routes nav
  inbox "/"
    thread "/t/:thread"
      details "/t/:thread/details"
        newContact "/t/:thread/contact"
    compose "/new"

component Messages
  state ticks = 0
  derive thread = top(nav).params.thread
  // A compose overlay keeps the conversation beneath it alive and editable.
  derive chatThread = (top(nav).name == "compose" ? top(back(nav)).params.thread : thread)
  state query = ""
  state inboxCursor = ""
  state inboxShift = 0
  state inboxMode = "messages"
  state deletedSelection = ""
  state deletedCursor = ""
  state deletedShift = 0
  state recoveryTargets = ""
  state recoveryCount = 0
  state inboxTop = 0
  derive inboxTitleOpacity = (inboxTop < 44 ? 0 : (inboxTop > 60 ? 1 : (inboxTop - 44) / 16))
  state swipedThread = ""
  state swipeOffset = 70
  state timestampOffset = 0
  derive timestampDistance = (timestampOffset < 0 ? 0 : (timestampOffset * 0.4 > 58 ? 58 : timestampOffset * 0.4))
  derive timestampCompensation = timestampOffset - timestampDistance
  // A cold URL and browser Forward load the destination's saved composer.
  // Local edits belong to one conversation, including beneath its detail/modal.
  state draftThread = ""
  state draftText = ""
  derive draft = (draftThread == chatThread ? draftText : (savedComposer.thread == chatThread ? savedComposer.draft : ""))
  state selecting = false
  state selection = ""
  state cursor = ""
  state windowShift = 0
  state selected = ""
  state selectingText = ""
  state selectedBody = ""
  state selectedRoot = ""
  state selectedOutgoing = false
  state selectedReaction = ""
  state selectedTail = false
  state selectedGroup = false
  state selectedActions = false
  state selectedMenuActions = false
  state selectedPicker = false
  state selectedPickerVisited = false
  state selectedEditing = false
  state replyThread = ""
  state replyRoot = ""
  derive replying = (replyThread == chatThread ? replyRoot : (savedComposer.thread == chatThread ? savedComposer.reply : ""))
  state composerEditing = false
  state detailsEditing = false
  state attachments = false
  derive composing = top(nav).name == "compose"
  state contactFirst = ""
  state contactLast = ""
  state contactCompany = ""
  state contactPhone = ""
  state contactEmail = ""
  state contactNotes = ""
  state contactPhoneShown = true
  state contactEmailShown = false
  state recipientQuery = ""
  state recipientCursor = ""
  state recipientShift = 0
  state recipient = ""
  state recipientSelection = ""
  state recipientRemainder = ""
  state newDraft = ""
  state showContacts = false
  mutation change as shape Change
  // A draft saved on the way to a new message: its own mutation, so the
  // message's send does not forget its reply (LLP 1088 D8).
  mutation draftSaved as shape Change
  derive revision = match change { case some(c) => c.revision, case none => 0 }
  derive pendingReplies = match change { case some(c) => c.pending, case none => false }
  derive typingPhase = ticks % 4
  derive bellPath = "path('M 12 1 C 10 1 10 3 10 3 C 5 4 4 7 4 12 L 4 16 L 1 20 L 23 20 L 20 16 L 20 12 C 20 7 19 4 14 3 C 14 3 14 1 12 1 Z M 8 22 C 8 27 16 27 16 22 Z')"
  derive trashPath = "path('M 8 1 L 16 1 Q 18 1 18 3 L 18 5 L 23 5 L 23 7 L 21 7 L 19 27 L 5 27 L 3 7 L 1 7 L 1 5 L 6 5 L 6 3 Q 6 1 8 1 Z M 8 3 L 8 5 L 16 5 L 16 3 Z M 6 8 L 7.5 24 L 9.5 24 L 8 8 Z M 11 8 L 11 24 L 13 24 L 13 8 Z M 16 8 L 14.5 24 L 16.5 24 L 18 8 Z')"
  derive callPath = "path('M 4 0 Q 2 0 1 3 C -3 12 12 27 21 23 Q 24 22 23 20 L 18 16 Q 17 15 15 17 L 13 18 Q 7 15 5 9 L 7 7 Q 9 5 7 3 Z')"
  derive personPath = "path('M 16 2 C 11 2 8 6 8 11 C 8 16 11 20 16 20 C 21 20 24 16 24 11 C 24 6 21 2 16 2 Z M 2 35 C 2 26 8 22 16 22 C 24 22 30 26 30 35 Z')"
  derive emojiFacePath = "path('M 12 1 C 5.925 1 1 5.925 1 12 C 1 18.075 5.925 23 12 23 C 18.075 23 23 18.075 23 12 C 23 5.925 18.075 1 12 1 Z M 12 3 C 16.971 3 21 7.029 21 12 C 21 16.971 16.971 21 12 21 C 7.029 21 3 16.971 3 12 C 3 7.029 7.029 3 12 3 Z M 7 9 C 7 7 10 7 10 9 C 10 11 7 11 7 9 Z M 14 9 C 14 7 17 7 17 9 C 17 11 14 11 14 9 Z M 5 13 Q 12 17 19 13 C 18 23 6 23 5 13 Z M 7 16 C 9 20 15 20 17 16 Q 12 18 7 16 Z')"
  derive outgoingTailPath = "path('M 0 0 L 22 0 C 22 14.4 16.4 11.9 16.4 17.8 C 16.4 18.7 17.7 21.7 18.7 22.4 C 18.6 23.6 18.5 24 16.8 23.6 C 11.6 21.7 0.6 13.2 0 11 Z')"
  derive incomingTailPath = "path('M 22 0 L 0 0 C 0 14.4 5.6 11.9 5.6 17.8 C 5.6 18.7 4.3 21.7 3.3 22.4 C 3.4 23.6 3.5 24 5.2 23.6 C 10.4 21.7 21.4 13.2 22 11 Z')"
  resource inbox = inbox(query, revision, inboxCursor) as shape Inbox
  resource syncStatus = syncState(revision) as shape string
  resource deletedInbox = recentlyDeleted(deletedSelection, revision, now(), deletedCursor) as shape DeletedInbox
  resource contacts = recipients(recipient, recipientQuery, revision, recipientCursor) as shape Recipients
  resource savedComposer = conversationDraft(chatThread, revision) as shape ComposerDraft
  resource chat = conversation(chatThread, revision, replying, selection, cursor) as shape Conversation

  // Negative, changing requests clamp to the top on every explicit shift.
  // Latest restores end-following; an eager transcript has no retained anchor.
  action shiftWindow(value: string)
    cursor = value
    windowShift = windowShift + 1
    timestampOffset = 0
    selectingText = ""
  action pageInbox(value: string)
    inboxCursor = value
    inboxShift = inboxShift + 1
    swipedThread = ""
    inboxTop = 0
  action pageRecipients(value: string)
    recipientCursor = value
    recipientShift = recipientShift + 1
  action search(value)
    if value != query
      inboxCursor = ""
      inboxShift = inboxShift + 1
      inboxTop = 0
    query = value
    swipedThread = ""
  action filterInbox(value: string)
    inboxMode = value
    deletedSelection = ""
    deletedCursor = ""
    deletedShift = deletedShift + 1
    swipedThread = ""
  action pageDeleted(value: string)
    deletedCursor = value
    deletedShift = deletedShift + 1
  action chooseDeleted(value: string)
    deletedSelection = value
  action prepareRecovery
    recoveryTargets = deletedInbox.targets
    recoveryCount = deletedInbox.count
  action recoverDeleted
    send change = recoverConversations(recoveryTargets, now())
    deletedSelection = ""
  action permanentlyDelete
    send change = purgeConversations(recoveryTargets, now())
    deletedSelection = ""
  action open(id: string, savedDraft: string, savedReply: string)
    cursor = ""
    selectingText = ""
    timestampOffset = 0
    if swipedThread != ""
      swipedThread = ""
    else
      nav = open(nav, path("thread", id))
      composerEditing = false
      selected = ""
      draftThread = id
      draftText = savedDraft
      replyThread = id
      replyRoot = savedReply
      send change = markRead(id)
  action back
    cursor = ""
    selectingText = ""
    selecting = false
    selection = ""
    timestampOffset = 0
    if chatThread != "" and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
      send change = saveDraft(chatThread, draft, replying)
    nav = back(nav)
    composerEditing = false
    selected = ""
    attachments = false
  action timestampsScrolled(left: number, top: number)
    timestampOffset = left
  action inboxListScrolled(left: number, top: number)
    inboxTop = top
  action inboxScrolled(id: string, left: number, top: number)
    if left < 69 or left > 71
      swipedThread = id
      swipeOffset = left
    if left == 70 and swipedThread == id
      swipedThread = ""
  action muteThread(id: string)
    swipedThread = ""
    send change = muteConversation(id)
  // The details switch is controlled: it asks for a state, and only a
  // different one is sent (LLP 1069.001 D4).
  action setThreadMuted(muted: bool)
    if muted != chat.muted
      send change = muteConversation(thread)
  action blockThread(value: bool)
    send change = blockConversation(thread, value)
  action readThread(id: string, unread: bool)
    swipedThread = ""
    send change = setConversationUnread(id, unread)
  action deleteThread(id: string)
    swipedThread = ""
    send change = deleteConversation(id, now())
  action write(value)
    draftThread = chatThread
    draftText = value
  action sendDraft
    cursor = ""
    if draft != ""
      send change = sendMessage(thread, draft, replying, ticks, now())
      draftThread = chatThread
      draftText = ""
      attachments = false
      focus("composer")
  action select(id: string, body: string, outgoing: bool, emoji: string, tail: bool, root: string, group: bool, actions: bool)
    selectingText = ""
    selected = id
    selectedBody = body
    selectedRoot = root
    selectedOutgoing = outgoing
    selectedReaction = emoji
    selectedTail = tail
    selectedGroup = group
    selectedActions = actions
    selectedMenuActions = actions
    selectedPicker = false
    selectedPickerVisited = false
    selectedEditing = composerEditing
    if actions
      focus("emoji-return")
  action menuKey(value)
    if value == "Escape"
      if selectedPicker
        selectedPicker = false
        if not selectedActions and selectedEditing
          focus("composer")
        else
          focus("emoji-return")
      else
        selected = ""
        if (selectedActions or selectedPickerVisited) and selectedEditing
          focus("composer")
  action showEmojiPicker
    selectedPicker = true
    selectedPickerVisited = true
    selectedMenuActions = false
    focus("emoji-input")
  action closeEmojiPicker
    selectedPicker = false
    if not selectedActions and selectedEditing
      focus("composer")
    else
      focus("emoji-return")
  action dismiss
    selected = ""
    selectedPicker = false
    if (selectedActions or selectedPickerVisited) and selectedEditing
      focus("composer")
    attachments = false
  action reaction(emoji: string)
    send change = react(thread, selected, emoji)
    selected = ""
    selectedPicker = false
    if (selectedActions or selectedPickerVisited) and selectedEditing
      focus("composer")
  action reply
    replyThread = chatThread
    replyRoot = selectedRoot
    selected = ""
    focus("composer")
  action copyMessage
    copyText(selectedBody)
    selected = ""
    selectedPicker = false
    if selectedEditing
      focus("composer")
  action selectMessageText
    selectingText = selected
    selected = ""
    selectedPicker = false
    selectText("selected-message-text")
  action finishTextSelection
    selectingText = ""
  action openReplies(id: string)
    replyThread = chatThread
    replyRoot = id
    focus("composer")
  action cancelReply
    replyThread = chatThread
    replyRoot = ""
  action more
    selection = selected
    selecting = true
    selected = ""
    timestampOffset = 0
    attachments = false
    focus("selection-toolbar")
  action chooseMessage(value: string)
    selection = value
  action cancelSelection
    selecting = false
    selection = ""
  action selectionKey(value)
    if value == "Escape"
      selecting = false
      selection = ""
  action deleteSelected
    send change = deleteMessages(thread, selection, now())
    selecting = false
    selection = ""
  action composerFocus
    composerEditing = true
    selectingText = ""
  action composerBlur
    composerEditing = false
  action showDetails
    selectingText = ""
    detailsEditing = composerEditing
    selected = ""
    attachments = false
    nav = push(nav, path("details", thread))
  action createContact
    contactFirst = ""
    contactLast = ""
    contactCompany = ""
    contactNotes = ""
    contactPhone = (chat.contactKind == "phone" ? chat.contactAddress : "")
    contactEmail = (chat.contactKind == "email" ? chat.contactAddress : "")
    contactPhoneShown = chat.contactKind == "phone"
    contactEmailShown = chat.contactKind == "email"
    nav = push(nav, path("newContact", thread))
    focus("contact-first")
  action discardContact
    nav = back(nav)
  action saveContact
    send change = createLocalContact(contactFirst, contactLast, contactCompany, contactPhone, contactEmail, contactNotes)
    nav = back(nav)
  action writeContactFirst(value)
    contactFirst = value
  action writeContactLast(value)
    contactLast = value
  action writeContactCompany(value)
    contactCompany = value
  action writeContactPhone(value)
    contactPhone = value
  action writeContactEmail(value)
    contactEmail = value
  action writeContactNotes(value)
    contactNotes = value
  action addContactPhone
    contactPhoneShown = true
    focus("contact-phone")
  action removeContactPhone
    contactPhoneShown = false
    contactPhone = ""
  action addContactEmail
    contactEmailShown = true
    focus("contact-email")
  action removeContactEmail
    contactEmailShown = false
    contactEmail = ""
  action closeDetails
    nav = back(nav)
    if detailsEditing
      focus("composer")
  action showAttachments
    attachments = not attachments
  action insert(value: string)
    draftText = draft + value
    draftThread = chatThread
    attachments = false
    focus("composer")
  action newMessage
    recipientCursor = ""
    recipientShift = recipientShift + 1
    swipedThread = ""
    nav = push(nav, "/new")
    recipientSelection = ""
    recipientQuery = ""
    recipient = ""
    newDraft = ""
    showContacts = false
    focus("recipient-search")
  action forwardSelected
    if chat.selectionCount > 0
      recipientCursor = ""
      recipientShift = recipientShift + 1
      newDraft = chat.selectedText
      nav = push(nav, "/new")
      selecting = false
      selection = ""
      recipientSelection = ""
      recipientQuery = ""
      recipient = ""
      showContacts = false
      focus("recipient-search")
  action cancelNewMessage
    nav = back(nav)
  action searchRecipient(value)
    if value != recipientQuery
      recipientCursor = ""
      recipientShift = recipientShift + 1
    if recipientSelection != "" and value != ""
      recipient = recipientRemainder
    recipientQuery = value
    recipientSelection = ""
  action chooseRecipient(id: string)
    recipientCursor = ""
    recipientShift = recipientShift + 1
    recipientSelection = ""
    recipient = recipient + "|" + id
    recipientQuery = ""
    showContacts = false
    focus("new-composer")
  action selectRecipient(id: string, remaining: string)
    if recipientQuery == ""
      recipientSelection = id
      recipientRemainder = remaining
    focus("recipient-search")
  action recipientKey(k: string)
    if k == "Backspace" and recipientQuery == ""
      recipientCursor = ""
      recipientShift = recipientShift + 1
      if recipientSelection == ""
        recipientSelection = contacts.last
        recipientRemainder = contacts.withoutLast
      else
        recipient = recipientRemainder
        recipientSelection = ""
      showContacts = false
    if k == "Escape"
      recipientSelection = ""
    if k == "Enter" and contacts.resolved != ""
      recipientCursor = ""
      recipientShift = recipientShift + 1
      recipient = contacts.resolved
      recipientQuery = ""
      recipientSelection = ""
      showContacts = false
      focus("new-composer")
  action clearRecipientSelection
    recipientSelection = ""
    if contacts.resolved != ""
      recipientCursor = ""
      recipientShift = recipientShift + 1
      recipient = contacts.resolved
      recipientQuery = ""
      showContacts = false
  action browseContacts
    recipientCursor = ""
    recipientShift = recipientShift + 1
    recipientSelection = ""
    showContacts = not showContacts
    focus("recipient-search")
  action writeNew(value)
    newDraft = value
  action sendNewMessage
    cursor = ""
    timestampOffset = 0
    if contacts.canSend and trim(newDraft) != ""
      if chatThread != "" and chatThread != contacts.target and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
        send draftSaved = saveDraft(chatThread, draft, replying)
      send change = sendMessage(contacts.target, newDraft, "", ticks, now())
      nav = open(nav, path("thread", contacts.target))
      draftThread = contacts.target
      draftText = ""
      newDraft = ""
      replyThread = contacts.target
      replyRoot = ""
      focus("composer")

  // Fixture time is explicit and follows the same seekable clock on every host.
  action tick
    if pendingReplies
      ticks = ticks + 1
      send change = advanceReplies(ticks + 1, chatThread, now())
  task replies mount
    every(300, tick)

  action synchronize
    send change = syncMessages(now())
  task synchronization mount
    every(3000, synchronize)

  action followLink(location: string)
    cursor = ""
    if chatThread != "" and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
      send change = saveDraft(chatThread, draft, replying)
    draftThread = ""
    replyThread = ""
    selected = ""
    selecting = false
    selection = ""
    selectingText = ""
    selectedPicker = false
    composerEditing = false
    detailsEditing = false
    attachments = false
    timestampOffset = 0
    swipedThread = ""
    // Messages has one active conversation. Opening its ancestry also keeps the
    // swipe underlay correct instead of rendering every retained thread as chat.
    nav = open(nav, location)

  view
    main testId="messages" navigationKey=`${top(nav).id}` navigationBack="back" navigate=followLink viewport-fit="cover" interactive-widget="resizes-content" width="100%" height="100%" box-sizing="border-box" display="flex" flex-direction="column" overflow="hidden" class=PageCanvas font-family="system-ui"
      each e in stack(nav) key=e.id
        when e.name == "inbox"
          column navigationKey=`${e.id}` testId="inbox-screen" position="absolute" top=0 right=0 bottom=0 left=0 box-sizing="border-box" class=PageSurface padding-top="env(safe-area-inset-top)" padding-left="env(safe-area-inset-left)" padding-right="env(safe-area-inset-right)"
            when inboxMode == "messages"
              column position="relative" flex=1 min-height=0
                row testId="inbox-title-bar" position="absolute" top=0 left=0 right=0 z-index=1 padding-left=20 padding-right=20 height=44 align-items="center" justify-content="space-between" backgroundMaterial="ultra-thin" opacity=inboxTitleOpacity
                  text "Messages" testId="inbox-title-compact" font-size=17 font-weight=600 flex=1 text-align="center"
                scroll scroll=inboxListScrolled scrollTop=(0 - inboxShift) testId="conversation-list" flex=1 min-height=0
                  column
                    column testId="inbox-title-area" padding-top=57 padding-bottom=8 padding-left=16 padding-right=16
                      text "Messages" testId="inbox-title-large" font-size=34 font-weight=700 line-height="41px" opacity=(1 - inboxTitleOpacity)
                    when inbox.earlier != ""
                      button press=pageInbox(inbox.earlier) testId="previous-conversations" padding=16
                        text "Previous conversations" font-size=14 class=AccentText
                    each person in inbox.people key=person.id
                      scroll swipeContent=`conversation-${person.id}` swipeLeading=`read-thread-${person.id}` swipeTrailing=`delete-thread-${person.id} mute-${person.id}` scroll=inboxScrolled(person.id) testId=`thread-swipe-${person.id}` width="100%" height=86.6667 overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory" scrollLeft=(swipedThread == person.id ? swipeOffset : 70)
                        row width="100%" height=86.6667
                          row testId=`thread-read-action-${person.id}` width=70 height=86.6667 flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=10 padding-right=10 align-items="center"
                            button press=readThread(person.id, not person.unread) id=`read-thread-${person.id}` testId=`read-thread-${person.id}` aria-label=(person.unread ? "Mark as Read" : "Mark as Unread") width=50 height=50 border-radius=25 background-color="#0088ff" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                              box position="relative" width=24 height=22
                                box width=24 height=22 background-color="#ffffff" clip-path="path('M 12 2 C 5.5 2 0 5.8 0 11 C 0 13.4 1.3 15.6 3.3 17.2 L 1.8 21 L 7.3 19.4 C 8.7 19.8 10.3 20 12 20 C 18.6 20 24 16 24 11 C 24 5.8 18.6 2 12 2 Z')"
                                when not person.unread
                                  box position="absolute" right=-1 top=0 width=9 height=9 border-radius=5 background-color="#0088ff" display="flex" align-items="center" justify-content="center"
                                    box width=4 height=4 border-radius=3 border-style="solid" border-width=1.5 border-color="#ffffff"
                          button background-color=(swipedThread == person.id ? "light-dark(#e5e5ea, #2c2c2e)" : "light-dark(#ffffff, #000000)") border-radius=(swipedThread == person.id ? 28 : 0) press=open(person.id, person.draft, person.reply) id=`conversation-${person.id}` testId=`conversation-${person.id}` aria-label=`${person.name}, ${person.preview}` display="flex" flex-direction="row" align-items="center" width="100%" flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=11 padding-right=16 height=86.6667 gap=8 text-align="start"
                            box testId=`unread-dot-${person.id}` width=7 height=7 border-radius=4 background-color=(person.unread ? "light-dark(#007aff, #0a84ff)" : "#00000000") flex-shrink=0
                            column width=45 height=45 border-radius=22.5 background-color=person.color justify-content="center" align-items="center" flex-shrink=0
                              when person.initials != ""
                                text person.initials font-size=20 color="#ffffff" font-weight=500
                              else
                                box width=32 height=36 scale=0.65 clip-path=personPath background-color="#ffffff"
                            column flex=1 min-width=0 height=86.6667 box-sizing="border-box" padding-top=13 padding-bottom=10 margin-left=4 border-bottom-style="solid" border-bottom-width=0.6667 border-color=(swipedThread == person.id ? "#00000000" : "light-dark(#d9d9dc, #38383a)") gap=0
                              row justify-content="space-between" gap=8 align-items="center" height=20.3333 flex-shrink=0
                                text person.name testId=`conversation-name-${person.id}` line-height="20.3333px" font-size=17 font-weight=600 flex=1 min-width=0 line-clamp=1
                                when person.muted
                                  box position="relative" testId=`muted-${person.id}` width=12 height=14 flex-shrink=0
                                    box width=24 height=28 scale=0.5 position="absolute" left=-6 top=-7 clip-path=bellPath background-color="#8e8e93"
                                    box position="absolute" left=5 top=-1 width=1.5 height=16 rotate=-45 background-color="#8e8e93"
                                text person.time font-size=14 color="#8e8e93"
                                text "›" font-size=21 color="light-dark(#c7c7cc, #48484a)"
                              text (person.draft != "" ? `Draft: ${person.draft}` : person.preview) testId=`conversation-preview-${person.id}` font-size=15 color="#8e8e93" line-clamp=2 line-height="20.3333px" text-align="left" flex-shrink=0
                          row testId=`thread-actions-${person.id}` width=130 height=86.6667 flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=10 padding-right=10 gap=10 align-items="center"
                            button press=muteThread(person.id) id=`mute-${person.id}` testId=`mute-${person.id}` aria-label=(person.muted ? "Show Alerts" : "Hide Alerts") width=50 height=50 border-radius=25 background-color="light-dark(#6155f5, #6d7cff)" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                              box width=24 height=28 scale=0.75
                                box width=24 height=28 clip-path=bellPath background-color="#ffffff"
                                when not person.muted
                                  box position="absolute" left=10 top=-3 width=5 height=34 rotate=-45 background-color="light-dark(#6155f5, #6d7cff)"
                                  box position="absolute" left=11.5 top=-3 width=2 height=34 rotate=-45 background-color="#ffffff"
                            button destructive=true press=deleteThread(person.id) id=`delete-thread-${person.id}` testId=`delete-thread-${person.id}` aria-label=`Delete conversation with ${person.name}` width=50 height=50 border-radius=25 background-color="light-dark(#ff383c, #ff4245)" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                              box width=24 height=28 scale=0.75 clip-path=trashPath background-color="#ffffff"
                    when inbox.later != ""
                      button press=pageInbox(inbox.later) testId="more-conversations" padding=16
                        text "More conversations" font-size=14 class=AccentText
                    when length(inbox.people) == 0
                      text "No Results" text-align="center" padding=40 font-size=20 font-weight=600 color="#8e8e93"
                    text syncStatus testId="sync-status" text-align="center" padding=16 font-size=12 color="#8e8e93"
                row testId="inbox-bar" margin-left=28 margin-right=16 margin-bottom=16 gap=8 align-items="center" flex-shrink=0 glassGroup=8
                  row testId="search-bar" padding-left=18 padding-right=14 height=48 flex=1 min-width=0 border-radius=24 backgroundMaterial="glass" align-items="center" gap=12 flex-shrink=0
                    image "symbol:search" font-size=20 font-weight=400 flex-shrink=0 class=PrimaryIcon
                    input appearance="none" id="search" testId="search" value=query input=search placeholder="Search" aria-label="Search conversations" class=PrimaryText font-size=17 flex=1 min-width=0 height=44 border-width=0
                    button disabled=true testId="search-dictation" aria-label="Dictate search" width=28 height=40 display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                      image "symbol:microphone" font-size=17 font-weight=400 class=PrimaryIcon
                  button press=newMessage testId="new-message" aria-label="New message" width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                    image "symbol:compose" testId="compose-symbol" font-size=22 font-weight=400 class=PrimaryIcon
                box height="calc(env(safe-area-inset-bottom) - 22px)" min-height=0 flex-shrink=0
            when inboxMode == "deleted"
              column testId="recently-deleted-screen" flex=1 min-height=0
                row height=54 align-items="center" justify-content="center" flex-shrink=0
                  text "Recently Deleted" font-size=17 font-weight=600
                scroll scrollTop=(0 - deletedShift) testId="deleted-conversations" flex=1 min-height=0
                  column
                    text "Conversations show the days remaining before deletion. After that time, messages will be permanently deleted. This may take up to 40 days." font-size=13 line-height="18px" color="light-dark(#8e8e93, #98989d)" text-align="center" padding-top=24 padding-bottom=20 padding-left=24 padding-right=24
                    when deletedInbox.earlier != ""
                      button press=pageDeleted(deletedInbox.earlier) testId="previous-deleted-conversations" padding=16
                        text "Previous conversations" class=AccentText
                    each person in deletedInbox.people key=person.id
                      button press=chooseDeleted(person.selection) testId=`deleted-${person.id}` aria-label=`${person.name}, ${person.count} messages, ${person.days} days remaining` aria-checked=person.chosen height=86.6667 width="100%" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" padding-left=16 padding-right=16 gap=16 background-color=(person.chosen ? "light-dark(#d1d1d6, #3a3a3c)" : "#00000000") text-align="start"
                        column width=22 height=22 box-sizing="border-box" border-radius=11 border-style="solid" border-width=(person.chosen ? 0 : 1.5) border-color="light-dark(#c7c7cc, #636366)" background-color=(person.chosen ? "#0088ff" : "#00000000") align-items="center" justify-content="center" flex-shrink=0
                          when person.chosen
                            box width=12 height=12 clip-path="path('M 1 6 L 4 9 L 11 1 L 12 2 L 4 12 L 0 7 Z')" background-color="#ffffff"
                        column width=44 height=44 border-radius=22 background-color=person.color align-items="center" justify-content="center" flex-shrink=0
                          text person.initials font-size=18 font-weight=500 color="#ffffff"
                        column flex=1 min-width=0 align-self="stretch" justify-content="center" border-bottom-style="solid" border-bottom-width=(person.chosen ? 0 : 0.5) border-color="light-dark(#d9d9dc, #38383a)"
                          row align-items="baseline" gap=8
                            text person.name font-size=17 font-weight=600 line-clamp=1 flex=1 min-width=0
                            text `${person.days} Days` font-size=15 color="light-dark(#8e8e93, #98989d)" flex-shrink=0
                          text (person.count == 1 ? "1 Message" : `${person.count} Messages`) font-size=15 color="light-dark(#8e8e93, #98989d)" margin-top=2
                    when deletedInbox.later != ""
                      button press=pageDeleted(deletedInbox.later) testId="more-deleted-conversations" padding=16
                        text "More conversations" class=AccentText
                row height=54 flex-shrink=0 padding-left=28 padding-right=28 align-items="center" justify-content="space-between"
                  button press=prepareRecovery popovertarget="recover-confirmation" disabled=(deletedInbox.count == 0) testId="recover-deleted" aria-label=(deletedSelection == "" ? "Recover All" : "Recover") height=48 padding-left=16 padding-right=16 border-radius=24 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center" color=(deletedInbox.count == 0 ? "light-dark(#b4b4b7, #636366)" : "light-dark(#000000, #ffffff)")
                    text (deletedSelection == "" ? "Recover All" : "Recover") font-size=17
                  button press=prepareRecovery popovertarget="purge-confirmation" disabled=(deletedInbox.count == 0) testId="purge-deleted" aria-label=(deletedSelection == "" ? "Delete All" : "Delete") width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    box width=24 height=28 clip-path=trashPath background-color=(deletedInbox.count == 0 ? "light-dark(#b4b4b7, #636366)" : "light-dark(#000000, #ffffff)")
                box height="calc(env(safe-area-inset-bottom) - 6px)" min-height=0 flex-shrink=0
            button popovertarget="inbox-filters" testId="inbox-filters-button" aria-label="Filter messages" position="absolute" top="env(safe-area-inset-top)" right=16 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center" z-index=2
              column width=22 gap=4 align-items="center"
                box width=22 height=1.5 border-radius=1 class=PrimaryFill
                box width=16 height=1.5 border-radius=1 class=PrimaryFill
                box width=10 height=1.5 border-radius=1 class=PrimaryFill
            column id="inbox-filters" popover="auto" position="absolute" role="menu" aria-label="Filter messages" width=250 padding=8 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              button press=filterInbox("messages") popovertarget="inbox-filters" popovertargetaction="hide" role="menuitemradio" aria-checked=(inboxMode == "messages") testId="filter-messages" height=44 padding-left=16 padding-right=16 text-align="start"
                text "Messages" font-size=17
              button press=filterInbox("deleted") popovertarget="inbox-filters" popovertargetaction="hide" role="menuitemradio" aria-checked=(inboxMode == "deleted") testId="filter-deleted" height=44 padding-left=16 padding-right=16 text-align="start"
                text "Recently Deleted" font-size=17
            column id="recover-confirmation" popover="auto" position="absolute" role="alertdialog" aria-label="Recover messages" width=240 box-sizing="border-box" padding=16 gap=16 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              text "These messages will be recovered." font-size=17
              button press=recoverDeleted popovertarget="recover-confirmation" popovertargetaction="hide" testId="confirm-recover" class=AccentText background-color="#0088ff" height=48 border-radius=24
                text (recoveryCount == 1 ? "Recover Message" : `Recover ${recoveryCount} Messages`) font-size=17 font-weight=600 color="#ffffff"
              button popovertarget="recover-confirmation" popovertargetaction="hide" testId="cancel-recover" height=44
                text "Cancel" font-size=17
            column id="purge-confirmation" popover="auto" position="absolute" role="alertdialog" aria-label="Permanently delete messages" width=240 box-sizing="border-box" padding=16 gap=16 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              text "These messages will be permanently deleted. This action cannot be undone." font-size=17
              button destructive=true press=permanentlyDelete popovertarget="purge-confirmation" popovertargetaction="hide" testId="confirm-purge" color="light-dark(#ff383c, #ff4245)" height=48 border-radius=24
                text (recoveryCount == 1 ? "Delete Message" : `Delete ${recoveryCount} Messages`) font-size=17 font-weight=600
              button popovertarget="purge-confirmation" popovertargetaction="hide" testId="cancel-purge" height=44
                text "Cancel" font-size=17
        when e.name == "thread"
          column navigationKey=`${e.id}` testId="conversation-screen" position="absolute" top=0 right=0 bottom=0 left=0 box-sizing="border-box" class=PageSurface padding-top="env(safe-area-inset-top)" padding-left="env(safe-area-inset-left)" padding-right="env(safe-area-inset-right)"
            row position="relative" testId="conversation-header" height=95.333333 flex-shrink=0 align-items="flex-start" justify-content="center" padding-left=16 padding-right=16
              button press=back disabled=composing id="back" testId="back" aria-label="Back to Messages" position="absolute" left=16 top=0 width=44 height=44 border-radius=22 backgroundMaterial="glass" display=(replying == "" and not selecting ? "flex" : "none") flex-direction="row" align-items="center" justify-content="center"
                image "symbol:back" font-size=20 font-weight=600 class=PrimaryIcon
              when replying != "" and not selecting
                button press=cancelReply testId="close-reply-thread" aria-label="Close replies" position="absolute" right=16 top=0 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center" z-index=2
                  image "symbol:close" testId="close-symbol" font-size=20 font-weight=500 class=PrimaryIcon
              when selecting
                button press=cancelSelection testId="cancel-selection" aria-label="Cancel message selection" position="absolute" right=16 top=0 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center" z-index=2
                  image "symbol:close" font-size=20 font-weight=500 class=PrimaryIcon
              button press=showDetails retainFocus=true disabled=selecting testId="contact-details" aria-label=`Contact information for ${chat.name}` max-width="70%" display="flex" flex-direction="column" align-items="center"
                column id="contact-photo" width=60 height=60 border-radius=30 background-color=chat.color align-items="center" justify-content="center" z-index=1
                  when chat.initials != ""
                    text chat.initials color="#ffffff" font-size=26 font-weight=600
                  else
                    box width=32 height=36 scale=0.8 clip-path=personPath background-color="#ffffff"
                row max-width="100%" box-sizing="border-box" padding-left=14 padding-right=12 height=32 margin-top=-5 border-radius=16 backgroundMaterial="glass" align-items="center" gap=6
                  text chat.name min-width=0 line-clamp=1 font-size=17 font-weight=600 class=PrimaryText
                  text "›" font-size=22 font-weight=600 color="light-dark(#b4b4b7, #8e8e93)"
            column position="relative" testId="conversation-body" flex=1 min-height=0
              scroll testId="transcript" scrollFollowEnd=(cursor == "") keyboardDismissMode="interactive" scrollTop=(cursor == "" ? 1000000 + chat.scrollRevision : 0 - windowShift) flex=1 min-height=0 overflow-x="hidden"
                scroll scroll=timestampsScrolled testId="timestamp-reveal" width="100%" overflow-x=(selecting ? "hidden" : "scroll") overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory"
                  row width="200%"
                    column scroll-snap-align="start" width="50%" box-sizing="border-box" padding-left=16 padding-right=16 padding-top=14 padding-bottom=14 gap=4
                      when chat.hasEarlier
                        button position="relative" press=shiftWindow(chat.earlier) testId="show-earlier-messages" left=timestampOffset padding=12
                          text "Show earlier messages" font-size=14 class=AccentText
                      when length(chat.messages) > 0 and not chat.hasEarlier
                        column position="relative" testId="conversation-service" left=timestampOffset align-items="center" margin-bottom=10
                          text "iMessage" font-size=11 line-height="13.333333px" color="#8e8e93"
                          row testId="conversation-encryption" align-items="center" gap=4.333333 height=13.333333
                            box width=6 height=8.333333 background-color="#8e8e93" clip-path="path('M 1 3.333 L 1 2.167 C 1 0.972 1.895 0 3 0 C 4.105 0 5 0.972 5 2.167 L 5 3.333 L 5.333 3.333 Q 6 3.333 6 4 L 6 7.667 Q 6 8.333 5.333 8.333 L 0.667 8.333 Q 0 8.333 0 7.667 L 0 4 Q 0 3.333 0.667 3.333 Z M 2 3.333 L 4 3.333 L 4 2.167 C 4 1.522 3.552 1 3 1 C 2.448 1 2 1.522 2 2.167 Z')"
                            text "Encrypted" font-size=11 line-height="13.333333px" color="#8e8e93"
                      each message in chat.messages key=message.id
                        when message.timeLabel != ""
                          text position="relative" message.timeLabel testId=`time-label-${message.id}` left=timestampOffset font-size=11 line-height="13.333333px" color="#8e8e93" text-align="center" margin-bottom=2.666667
                        column position="relative" testId=`message-row-${message.id}` left=(timestampCompensation + (selecting and not message.outgoing ? 40.666667 : 0)) align-items=(message.outgoing ? "flex-end" : "flex-start") padding-left=(message.senderName != "" ? 44 : 0) box-sizing="border-box" margin-top=(message.reactionCount > 0 ? 13 : 0) margin-bottom=(message.tail ? 6 : 0)
                          when message.showSender
                            text message.senderName testId=`sender-${message.id}` font-size=11 color="#8e8e93" margin-left=12 margin-bottom=4
                          when message.senderName != "" and message.tail
                            column testId=`avatar-${message.id}` position="absolute" left=4 bottom=(message.replyCount > 0 ? 28 : 0) width=32 height=32 border-radius=16 background-color=message.senderColor align-items="center" justify-content="center"
                              when message.senderInitials != ""
                                text message.senderInitials font-size=12 color="#ffffff" font-weight=600
                              else
                                box width=32 height=36 scale=0.55 clip-path=personPath background-color="#ffffff"
                          when message.reply != ""
                            text message.reply font-size=13 color="#8e8e93" max-width="75%" border-left-style="solid" border-left-width=2 border-color="light-dark(#c7c7cc, #48484a)" padding-left=8 margin-bottom=5 line-clamp=2
                          row position="relative" width="100%" justify-content=(message.outgoing ? "flex-end" : "flex-start")
                            MessageBubble(
                              message=message,
                              bubbleId=`bubble-${message.id}`,
                              swipeId=`swipe-indicator-${message.id}`,
                              reactionPrefix="reaction",
                              hidden=(selected == message.id and replying == ""),
                              selectingText=(selectingText == message.id and replying == ""),
                              outgoingTailPath=outgoingTailPath,
                              incomingTailPath=incomingTailPath,
                              openReplies=openReplies(message.replyRoot),
                              showActions=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", true),
                              showReactions=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", false),
                              finishTextSelection=finishTextSelection,
                            )
                            when selecting
                              button press=chooseMessage(message.selection) retainFocus=true testId=`selection-toggle-${message.id}` aria-label=`Select message: ${message.body}` aria-checked=message.chosen position="absolute" left=(message.outgoing ? -8 : (message.senderName != "" ? -92.666667 : -48.666667)) top="50%" margin-top=-16 width=32 height=32 z-index=4 display="flex" flex-direction="row" align-items="center" justify-content="center"
                                column testId=`selection-circle-${message.id}` width=22 height=22 border-radius=11 background-color=(message.chosen ? "light-dark(#007aff, #0a84ff)" : "light-dark(#c7c7cc, #48484a)") align-items="center" justify-content="center"
                                  when message.chosen
                                    box width=12 height=12 clip-path="path('M 0 6 L 2 4 L 5 8 L 10 0 L 12 1 L 5 12 Z')" background-color="#ffffff"
                                  else
                                    box width=19 height=19 border-radius=9.5 class=PageSurface
                            column position="absolute" left="100%" margin-left=8 top=0 bottom=0 width=50 opacity=(timestampDistance > 0 ? 1 : 0) justify-content="center"
                              text message.time testId=`timestamp-${message.id}` font-size=11 line-height="14px" color="#8e8e93" text-align="right"
                          when message.delivery != ""
                            text message.delivery testId=`delivery-status-${message.id}` opacity=(selecting or (selected == message.id and replying == "") ? 0 : 1) font-size=11 font-weight=600 color="#8e8e93" margin-top=6.333333 margin-right=20
                          when message.replyCount > 0
                            button press=openReplies(message.replyRoot) testId=`replies-${message.id}` margin-top=5 margin-left=6 margin-right=6 padding=3
                              text (message.replyCount == 1 ? "1 Reply" : `${message.replyCount} Replies`) font-size=12 class=AccentText
                          when selecting
                            button press=chooseMessage(message.selection) retainFocus=true testId=`select-message-${message.id}` aria-label=`Select message: ${message.body}` aria-checked=message.chosen position="absolute" top=0 right=0 bottom=0 left=0 width="100%" height="100%" z-index=3
                      when chat.hasLater
                        button position="relative" press=shiftWindow(chat.later) testId="show-later-messages" left=timestampOffset padding=12
                          text "Show later messages" font-size=14 class=AccentText
                      when cursor != "" and (chat.hasEarlier or chat.hasLater)
                        button position="relative" press=shiftWindow("") testId="show-latest-messages" left=timestampOffset padding=12
                          text "Show latest messages" font-size=14 class=AccentText
                      when chat.typingName != ""
                        row position="relative" testId="typing-indicator" left=timestampCompensation aria-label=`${chat.typingName} is typing` align-items="flex-end" gap=6 margin-top=4 margin-bottom=6 height=40 flex-shrink=0
                          TypingIndicator(avatar=chat.typingAvatar, phase=typingPhase, prefix="typing")
                    box width="50%"
              when replying != "" and not selecting
                column testId="reply-thread" z-index=2 position="absolute" top=0 right=0 bottom=0 left=0 backgroundMaterial="ultra-thin" justify-content="center"
                  button press=cancelReply testId="dismiss-reply-thread" aria-label="Return to conversation" position="absolute" top=0 right=0 bottom=0 left=0 width="100%" height="100%"
                  scroll testId="reply-messages" max-height="100%" width="100%" scrollFollowEnd=true scrollTop=(1000000 + chat.scrollRevision) keyboardDismissMode="interactive" overflow-x="hidden"
                    column padding=16 gap=12
                      each message in chat.replies key=message.id
                        column
                          when message.timeLabel != ""
                            text message.timeLabel testId=`reply-time-label-${message.id}` font-size=11 color="#8e8e93" align-self="center" margin-bottom=8
                          column position="relative" align-items=(message.outgoing ? "flex-end" : "flex-start") padding-left=(message.senderName != "" ? 44 : 0) box-sizing="border-box"
                            when message.showSender
                              text message.senderName testId=`reply-sender-${message.id}` font-size=11 color="#8e8e93" margin-left=12 margin-bottom=4
                            when message.senderName != "" and message.tail
                              column testId=`reply-avatar-${message.id}` position="absolute" left=4 bottom=0 width=32 height=32 border-radius=16 background-color=message.senderColor align-items="center" justify-content="center"
                                when message.senderInitials != ""
                                  text message.senderInitials font-size=12 color="#ffffff" font-weight=600
                                else
                                  box width=32 height=36 scale=0.55 clip-path=personPath background-color="#ffffff"
                            row width="100%" justify-content=(message.outgoing ? "flex-end" : "flex-start")
                              MessageBubble(
                                message=message,
                                bubbleId=`reply-bubble-${message.id}`,
                                swipeId=`reply-swipe-indicator-${message.id}`,
                                reactionPrefix="reply-reaction",
                                hidden=(selected == message.id),
                                selectingText=(selectingText == message.id),
                                outgoingTailPath=outgoingTailPath,
                                incomingTailPath=incomingTailPath,
                                openReplies=openReplies(message.replyRoot),
                                showActions=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", true),
                                showReactions=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", false),
                                finishTextSelection=finishTextSelection,
                              )
                            when message.delivery != ""
                              text message.delivery testId=`reply-delivery-status-${message.id}` opacity=(selected == message.id ? 0 : 1) font-size=11 font-weight=600 color="#8e8e93" margin-top=6.333333 margin-right=20
                      when chat.typingName != "" and chat.typingRoot == replying
                        row testId="reply-typing-indicator" aria-label=`${chat.typingName} is typing` align-items="flex-end" gap=6 margin-top=4 margin-bottom=6 height=40 flex-shrink=0
                          TypingIndicator(avatar=chat.typingAvatar, phase=typingPhase, prefix="reply-typing")
            when attachments and not selecting
              row testId="attachments" gap=16 padding=16 justify-content="center" background-color="light-dark(#f2f2f7, #1c1c1e)" flex-shrink=0
                button press=insert("😊") retainFocus=true testId="insert-smile" padding=12 border-radius=14 class=PageSurface
                  text "😊" font-size=30
                button press=insert("❤️") retainFocus=true testId="insert-heart" padding=12 border-radius=14 class=PageSurface
                  text "❤️" font-size=30
                button press=insert("☕️") retainFocus=true testId="insert-coffee" padding=12 border-radius=14 class=PageSurface
                  text "☕️" font-size=30
            column testId="composer-bar" display=(selecting ? "none" : "flex") padding-left=16 padding-right=16 padding-top=0 padding-bottom=16 flex-shrink=1 min-height=40.333333 class=PageSurface
              row align-items="flex-end" min-height=0
                box width="calc(env(safe-area-inset-bottom) - 22px)" min-width=0 flex-shrink=0
                row flex=1 min-width=0 gap=12 align-items="flex-end" align-self="stretch" max-height="100%"
                  button press=showAttachments retainFocus=true testId="add" aria-label="Add attachment" width=40 height=40 display="flex" flex-direction="row" justify-content="center" align-items="center" border-radius=20 backgroundMaterial="glass"
                    image "symbol:add" font-size=22 font-weight=400 rotate=(attachments ? 45 : 0) class=PrimaryIcon
                  row testId="composer-surface" flex=1 min-width=0 min-height=40.333333 max-height="100%" align-self="stretch" box-sizing="border-box" backgroundMaterial="glass" border-radius=20 align-items="flex-end" padding-left=16 padding-right=6.333333 padding-top=6 padding-bottom=6 gap=5
                    textarea appearance="none" id="composer" testId="composer" value=draft input=write focus=composerFocus blur=composerBlur placeholder="iMessage" aria-label="Message" class=PrimaryText font-family="system-ui" font-size=17 line-height="20px" flex=1 min-width=0 field-sizing="content" min-height=28.333333 max-height="100%" align-self="stretch" padding-top=4.166667 padding-bottom=4.166667 box-sizing="border-box" border-width=0
                    button press=sendDraft retainFocus=true disabled=(draft == "") testId="send" aria-label=(draft == "" ? "Dictate message" : "Send message") width=38 height=28 box-sizing="border-box" padding-left=(draft == "" ? 10 : 0) border-radius=14 background-color=(draft == "" ? "#00000000" : "light-dark(#007aff, #0a84ff)") display="flex" flex-direction="row" align-items="center" justify-content="center"
                      when draft == ""
                        image "symbol:microphone" font-size=17 font-weight=400 tint-color="light-dark(#b4b4b7, #8e8e93)"
                      else
                        image "symbol:send" testId="send-symbol" font-size=17 font-weight=700 tint-color="#ffffff"
                box width="calc(env(safe-area-inset-bottom) - 22px)" min-width=0 flex-shrink=0
              box height="calc(env(safe-area-inset-bottom) - 22px)" min-height=0 flex-shrink=0
            when selecting
              column id="selection-toolbar" testId="selection-toolbar" key=selectionKey flex-shrink=0 padding-top=10
                row height=48 padding-left=28 padding-right=28 justify-content="space-between"
                  button commandfor="delete-confirmation" command="show-modal" disabled=(chat.selectionCount == 0) testId="delete-selection" aria-label="Delete selected messages" width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    image "symbol:delete" testId="delete-symbol" position="relative" top=-0.666667 font-size=22 font-weight=400 tint-color=(chat.selectionCount > 0 ? "light-dark(#000000, #ffffff)" : "light-dark(#b4b4b7, #636366)")
                  button press=forwardSelected disabled=(chat.selectionCount == 0) testId="forward-selection" aria-label="Forward selected messages" width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                    image "symbol:forward" testId="forward-symbol" position="relative" top=0.333333 font-size=22 font-weight=400 tint-color=(chat.selectionCount > 0 ? "light-dark(#000000, #ffffff)" : "light-dark(#b4b4b7, #636366)")
                box height="calc(env(safe-area-inset-bottom) - 6px)" min-height=0
              dialog id="delete-confirmation" testId="delete-confirmation" role="alertdialog" aria-label="Delete selected messages" closedby="any" backgroundMaterial="glass" position="absolute" left=10 right="auto" top="auto" bottom="calc(env(safe-area-inset-bottom) + 10px)" margin=0 width=240 padding=16 box-sizing="border-box" border-width=0 border-radius=36
                button destructive=true press=deleteSelected commandfor="delete-confirmation" command="close" testId="confirm-delete-messages" aria-label=(chat.selectionCount == 1 ? "Delete Message" : `Delete ${chat.selectionCount} Messages`) height=48 border-radius=24 background-color="light-dark(#d9d9dc, #555559)" display="flex" flex-direction="row" align-items="center" justify-content="center" color="light-dark(#ff383c, #ff4245)"
                  text (chat.selectionCount == 1 ? "Delete Message" : `Delete ${chat.selectionCount} Messages`) font-size=17 font-weight=600
                button commandfor="delete-confirmation" command="close" testId="dismiss-delete-confirmation" aria-label="Cancel deletion" height=44
                  text "Cancel" font-size=17
            when selected != ""
              column testId="tapback-layer" z-index=10 position="absolute" top=0 right=0 bottom=0 left=0
                button press=dismiss retainFocus=true testId="dismiss-tapback" aria-label="Dismiss Tapbacks" width="100%" height="100%" position="absolute" top=0 right=0 bottom=0 left=0 background-color=(selectedActions ? "#16152a" : "light-dark(#0000001a, #00000080)") opacity=(selectedActions ? 0.21 : 1)
                each message in chat.messages key=message.id
                  when message.id == selected
                    when message.reactionCount > 0
                      row position="absolute" top="env(safe-area-inset-top)" left=12 right=12 justify-content="center"
                        row testId="reaction-participants" width=message.reactionPanelWidth max-width="100%" height=122 border-radius=32 backgroundMaterial="glass" justify-content="center" align-items="center"
                          scroll width="100%" height="100%" display="flex" flex-direction="row" justify-content="center" align-items="center" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none"
                            each group in message.reactionGroups key=group.value
                              column width=98 height=104 flex-shrink=0 align-items="center"
                                column position="relative" width=50 height=50 border-radius=25 background-color="light-dark(#ffffff, #3a3a3c)" align-items="center" justify-content="center"
                                  ReactionArtwork(value=group.value, extent=44, emojiSize=27)
                                  box position="absolute" left=19 top=45 width=12 height=12 border-radius=6 background-color="light-dark(#ffffff, #3a3a3c)"
                                  box position="absolute" left=22.5 top=60 width=5 height=5 border-radius=2.5 background-color="light-dark(#ffffff, #3a3a3c)"
                                row position="relative" width=group.width height=32 margin-top=20
                                  each person in group.people key=person.id
                                    column testId=`reaction-person-${person.id}` aria-label=person.name position="absolute" left=person.offset top=0 width=32 height=32 box-sizing="border-box" border-radius=16 border-style="solid" border-width=1 border-color="light-dark(#ffffff, #000000)" background-color=person.color align-items="center" justify-content="center"
                                      text person.initials font-size=14 color="#ffffff" font-weight=600
                    column testId="tapback-region" press=dismiss retainFocus=true position="absolute" left=0 right=0 bottom=0 top=(message.reactionCount > 0 ? (selectedPicker ? "calc(env(safe-area-inset-top) + 122px)" : "calc(env(safe-area-inset-top) + 146px)") : "0%")
                      column id="emoji-return" key=menuKey testId="tapback-menu" position="absolute" left=11 right=16 top=0 gap=6
                        when selectedPicker
                          box testId="emoji-picker-controls" width="100%" height=88
                        else
                          column testId="tapback-surface" backgroundMaterial="glass" width="100%" height=64 border-radius=32 flex-shrink=0
                            scroll testId="tapback-choices" width="100%" height=64 overflow-x="scroll" overflow-y="hidden" border-radius=32 flex-shrink=0
                              row height=64 padding-left=7.5 padding-right=7.5 align-items="center"
                                each choice in chat.reactions key=choice.id
                                  button press=reaction(choice.value) testId=`tapback-${choice.id}` aria-label=choice.label aria-checked=(selectedReaction == choice.value) width=49 height=64 border-radius=24 display="flex" flex-direction="row" align-items="center" justify-content="center" flex-shrink=0
                                    box testId=`tapback-selection-${choice.id}` width=44 height=44 border-radius=22 background-color=(selectedReaction == choice.value ? "light-dark(#26aeff, #0065d3)" : "#00000000") display="flex" align-items="center" justify-content="center"
                                      ReactionArtwork(value=choice.value, extent=44, emojiSize=25)
                        column width="100%" box-sizing="border-box" padding-left=(selectedGroup ? 49 : 5) align-items=(selectedOutgoing ? "flex-end" : "flex-start")
                          row width="100%" justify-content=(selectedOutgoing ? "flex-end" : "flex-start")
                            when selectedOutgoing
                              box position="relative" width=50 height=0 flex-shrink=0 z-index=2
                                when selectedPicker
                                  column press=showEmojiPicker position="absolute" left=22 top=-80 width=74 height=74 border-radius=37 backgroundMaterial="glass" align-items="center" justify-content="center"
                                    input appearance="none" id="emoji-input" testId="emoji-input" emojiPicker=true input=reaction value="" aria-label="Choose an emoji" position="absolute" top=0 left=0 width=74 height=74 font-size=1 color="#00000000" border-width=0
                                    box width=24 height=24 clip-path=emojiFacePath scale=1.666667 background-color="light-dark(#99999e, #b4b4b9)"
                                  button press=closeEmojiPicker retainFocus=true testId="close-emoji-picker" aria-label="Close emoji picker" position="absolute" left=80 top=-84 width=26 height=26 border-radius=13 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                                    box position="relative" width=14 height=14
                                      box position="absolute" left=6 top=0 width=1.5 height=14 rotate=45 class=PrimaryFill
                                      box position="absolute" left=6 top=0 width=1.5 height=14 rotate=-45 class=PrimaryFill
                                else
                                  button press=showEmojiPicker retainFocus=true testId="open-emoji-picker" aria-label="Choose another emoji" position="absolute" left=0 top=-12 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                                    box width=24 height=24 clip-path=emojiFacePath background-color="light-dark(#99999e, #b4b4b9)"
                            column position="relative" contextTarget=(replying == "" ? `bubble-${selected}` : `reply-bubble-${selected}`) contextMagnify=selectedActions testId="tapback-preview" max-width="75%" min-width=48 box-sizing="border-box" display="flex" justify-content="center" align-items="center" padding-left=14 padding-right=14 padding-top=10 padding-bottom=10 border-radius=20 background-color=(selectedOutgoing ? "light-dark(#007aff, #0a84ff)" : "light-dark(#ffffff, #38383a)")
                              when selectedTail
                                when selectedOutgoing
                                  box position="absolute" right=5 bottom=-7 width=22 height=24 clip-path=outgoingTailPath background-color="light-dark(#007aff, #0a84ff)"
                                else
                                  box position="absolute" left=5 bottom=-7 width=22 height=24 clip-path=incomingTailPath background-color="light-dark(#ffffff, #38383a)"
                              text selectedBody white-space="pre-wrap" font-size=17 line-height="20px" color=(selectedOutgoing ? "#ffffff" : "light-dark(#000000, #ffffff)") text-align="left"
                            when not selectedOutgoing
                              box position="relative" width=50 height=0 flex-shrink=0 z-index=2
                                when selectedPicker
                                  column press=showEmojiPicker position="absolute" left=-46 top=-80 width=74 height=74 border-radius=37 backgroundMaterial="glass" align-items="center" justify-content="center"
                                    input appearance="none" id="emoji-input" testId="emoji-input" emojiPicker=true input=reaction value="" aria-label="Choose an emoji" position="absolute" top=0 left=0 width=74 height=74 font-size=1 color="#00000000" border-width=0
                                    box width=24 height=24 clip-path=emojiFacePath scale=1.666667 background-color="light-dark(#99999e, #b4b4b9)"
                                  button press=closeEmojiPicker retainFocus=true testId="close-emoji-picker" aria-label="Close emoji picker" position="absolute" left=-56 top=-84 width=26 height=26 border-radius=13 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                                    box position="relative" width=14 height=14
                                      box position="absolute" left=6 top=0 width=1.5 height=14 rotate=45 class=PrimaryFill
                                      box position="absolute" left=6 top=0 width=1.5 height=14 rotate=-45 class=PrimaryFill
                                else
                                  button press=showEmojiPicker retainFocus=true testId="open-emoji-picker" aria-label="Choose another emoji" position="absolute" left=6 top=-12 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" flex-direction="row" align-items="center" justify-content="center"
                                    box width=24 height=24 clip-path=emojiFacePath background-color="light-dark(#99999e, #b4b4b9)"
                          column testId="tapback-status" display=(selectedPicker and selectedActions ? "none" : "flex") min-height=(selectedMenuActions ? 20.333333 : 0) width="100%" align-items="flex-end"
                            each message in (replying == "" ? chat.messages : chat.replies) key=message.id
                              when message.id == selected and message.delivery != ""
                                text message.delivery testId="tapback-delivery" font-size=11 font-weight=600 color="#8e8e93" margin-top=6.333333 margin-right=20
                        when selectedMenuActions
                          column id="message-actions" testId="message-actions" backgroundMaterial="glass" align-self=(selectedOutgoing ? "flex-end" : "flex-start") margin-left=(selectedOutgoing ? 0 : 5) width=250 border-radius=32 padding-top=10 padding-bottom=10
                            button press=reply testId="reply" height=42 padding-left=24 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                              column width=32 height=32 align-items="center" justify-content="center"
                                text "↩︎" font-size=22 class=PrimaryText
                              text "Reply" font-size=17 class=PrimaryText
                            button press=copyMessage testId="copy-message" height=42 padding-left=24 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                              column width=32 height=32 align-items="center" justify-content="center"
                                image "symbol:copy" testId="copy-symbol" font-size=17 font-weight=400 class=PrimaryIcon
                              text "Copy" font-size=17 class=PrimaryText
                            button press=selectMessageText testId="select-message-text" height=42 padding-left=24 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                              column width=32 height=32 align-items="center" justify-content="center"
                                image "symbol:select-text" testId="select-text-symbol" font-size=17 font-weight=400 class=PrimaryIcon
                              text "Select" font-size=17 class=PrimaryText
                            button press=more testId="more-message" height=42 padding-left=24 padding-right=16 display="flex" flex-direction="row" align-items="center" gap=8
                              column width=32 height=32 align-items="center" justify-content="center"
                                image "symbol:more" testId="more-symbol" font-size=17 font-weight=400 class=PrimaryIcon
                              text "More…" font-size=17 class=PrimaryText
        when e.name == "details"
          ContactDetails(
            routeKey=`${e.id}`,
            chat=chat,
            personPath=personPath,
            callPath=callPath,
            createContact=createContact,
            setMuted=setThreadMuted,
            blockThread=blockThread,
            closeDetails=closeDetails,
          )

        when e.name == "newContact"
          NewContactSheet(
            routeKey=`${e.id}`,
            initials=chat.initials,
            personPath=personPath,
            contactFirst=contactFirst,
            contactLast=contactLast,
            contactCompany=contactCompany,
            contactPhone=contactPhone,
            contactEmail=contactEmail,
            contactNotes=contactNotes,
            contactPhoneShown=contactPhoneShown,
            contactEmailShown=contactEmailShown,
            saveContact=saveContact,
            discardContact=discardContact,
            writeContactFirst=writeContactFirst,
            writeContactLast=writeContactLast,
            writeContactCompany=writeContactCompany,
            writeContactPhone=writeContactPhone,
            writeContactEmail=writeContactEmail,
            writeContactNotes=writeContactNotes,
            addContactPhone=addContactPhone,
            removeContactPhone=removeContactPhone,
            addContactEmail=addContactEmail,
            removeContactEmail=removeContactEmail,
          )

        when e.name == "compose"
          NewMessageSheet(
            routeKey=`${e.id}`,
            contacts=contacts,
            recipientSelection=recipientSelection,
            recipientQuery=recipientQuery,
            recipientShift=recipientShift,
            pageRecipients=pageRecipients,
            newDraft=newDraft,
            showContacts=showContacts,
            personPath=personPath,
            editable=(chatThread != "" or contacts.target != ""),
            cancelNewMessage=cancelNewMessage,
            selectRecipient=selectRecipient,
            searchRecipient=searchRecipient,
            recipientKey=recipientKey,
