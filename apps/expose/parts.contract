// Expose: the shapes the sources answer, the named styles, and the leaf
// components every screen builds from — a status bar, an app tile, a
// notification card, a settings row, a message bubble, the home indicator.
// The screens themselves are in app.contract.

shape Time
  epochAtZero: number
  utcOffset: number
shape Clock
  time: string
  ampm: string
  weekday: string
  date: string
  day: string
  month: string
  greeting: string
shape Thread
  id: string
  name: string
  initials: string
  kind: string
  preview: string
  time: string
  unread: bool
shape Inbox
  threads: list<Thread>
  unread: number
shape Message
  id: string
  role: string
  sender: string
  body: string
  time: string
  streaming: bool
shape Conversation
  id: string
  name: string
  initials: string
  kind: string
  messages: list<Message>
  streaming: bool
  error: string
shape Turn
  revision: number
  done: bool
  error: string
shape Article
  id: string
  section: string
  minutes: number
  author: string
  posted: string
  title: string
  deck: string
  pull: string
  body: list<string>
shape Library
  articles: list<Article>
  lead: string
shape Hour
  id: string
  label: string
  temp: string
  glyph: string
shape Weather
  ready: bool
  temp: string
  condition: string
  high: string
  low: string
  place: string
  hours: list<Hour>
shape ModelChoice
  id: string
  name: string
  maker: string
  selected: bool
shape Intelligence
  hasKey: bool
  keySource: string
  keyHint: string
  model: string
  modelName: string
  models: list<ModelChoice>

// The system's surfaces: near-black and near-white, the scheme's choice.
style Page
  background-color="light-dark(#f4f4f6, #000000)"
  color="light-dark(#0b0b0c, #f5f5f7)"
style Card
  background-color="light-dark(#ffffff, #161618)"
  border-radius=16
  overflow="hidden"
style Hairline
  border-bottom-style="solid"
  border-bottom-width=0.5
  border-color="light-dark(#d9d9de, #2a2a2e)"
style Muted
  color="light-dark(#6e6e75, #9a9aa0)"
style Title
  font-family="Exciting Lilt"
  font-weight=700
  font-size=34
  line-height="40px"
  letter-spacing=-0.3

// The lock screen's card comes in from below and settles.
keyframes settle
  from opacity=0 translate="0px 14px"
  to opacity=1 translate="0px 0px"
// The assistant's caret while it is still writing.
keyframes blink
  from opacity=1
  50% opacity=0.15
  to opacity=1
// A banner drops from the top edge.
keyframes drop
  from opacity=0 translate="0px -40px"
  to opacity=1 translate="0px 0px"

// The status bar: the time, then signal, Wi-Fi and battery drawn as marks.
component StatusBar
  props
    time: string
    tone: string
    wifi: bool
    airplane: bool
    press: action
  view
    row width="100%" box-sizing="border-box" height=30 align-items="center" justify-content="space-between" padding-left=28 padding-right=24 flex-shrink=0
      button press=press testId="status-time" height=30 display="flex" flex-direction="row" align-items="center"
        text time font-family="Exciting Lilt" font-weight=700 font-size=17 color=tone
      row align-items="center" gap=7
        when airplane
          svg viewBox="0 0 24 24" width=16 height=16
            path d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2 1.5V22l3.5-1 3.5 1v-1.5L13 19v-5.5l8 2.5z" fill=tone
        else
          svg viewBox="0 0 20 12" width=18 height=12
            rect x=0 y=8 width=3 height=4 rx=0.8 fill=tone
            rect x=5 y=5.5 width=3 height=6.5 rx=0.8 fill=tone
            rect x=10 y=3 width=3 height=9 rx=0.8 fill=tone
            rect x=15 y=0 width=3 height=12 rx=0.8 fill=tone
          svg viewBox="0 0 24 24" width=17 height=17
            path d="M12 20.5a1.6 1.6 0 1 1 0-3.2 1.6 1.6 0 0 1 0 3.2zm-4.2-4.6a6 6 0 0 1 8.4 0l-1.6 1.6a3.7 3.7 0 0 0-5.2 0l-1.6-1.6zm-3.4-3.4a10.8 10.8 0 0 1 15.2 0l-1.6 1.6a8.5 8.5 0 0 0-12 0l-1.6-1.6zM1 9.1a15.6 15.6 0 0 1 22 0l-1.6 1.6a13.3 13.3 0 0 0-18.8 0L1 9.1z" fill=tone opacity=(wifi ? 1 : 0.3)
        svg viewBox="0 0 28 13" width=27 height=13
          rect x=0.5 y=0.5 width=23 height=12 rx=3.5 fill="none" stroke=tone stroke-width=1 opacity=0.45
          rect x=2.5 y=2.5 width=17.5 height=8 rx=2 fill=tone
          path d="M25.5 4.5v4a2 2 0 0 0 0-4z" fill=tone opacity=0.45

// A home-screen tile: a mark set in Exciting on a gray tile, and a label.
component AppTile
  props
    id: string
    label: string
    glyph: string
    tile: string
    ink: string
    badge: number
    small: bool
    press: action
  view
    button press=press testId=`app-${id}` aria-label=label -exact-press-scale=0.94 width=78 display="flex" flex-direction="column" align-items="center" gap=7
      column width=66 height=66 border-radius=17 background-color=tile align-items="center" justify-content="center" position="relative"
        text glyph font-family="Exciting" font-weight=900 font-size=(small ? 24 : 34) line-height="40px" color=ink
        when badge > 0
          column position="absolute" top=-6 right=-6 min-width=22 height=22 border-radius=11 background-color="#ff6a2b" align-items="center" justify-content="center" padding-left=6 padding-right=6 box-sizing="border-box"
            text toString(badge) font-size=12 font-weight=700 color="#ffffff"
      text label font-size=12 font-weight=500 color="#ffffffd9" line-clamp=1

// The same tile in the dock, without a label.
component DockTile
  props
    id: string
    glyph: string
    tile: string
    ink: string
    press: action
  view
    button press=press testId=`dock-${id}` aria-label=id -exact-press-scale=0.94 width=66 height=66 border-radius=17 background-color=tile display="flex" flex-direction="row" align-items="center" justify-content="center"
      text glyph font-family="Exciting" font-weight=900 font-size=34 line-height="40px" color=ink

// A notification card on the lock screen: the app's mark, who, what, when.
component Notice
  props
    id: string
    glyph: string
    app: string
    title: string
    body: string
    time: string
    press: action
  view
    button press=press testId=`notice-${id}` width="100%" display="flex" flex-direction="row" gap=12 padding=14 box-sizing="border-box" border-radius=22 background-color="#ffffff1c" align-items="flex-start" animation="settle 420ms ease-out" text-align="start"
      column width=40 height=40 border-radius=10 background-color="#f5f5f7" align-items="center" justify-content="center" flex-shrink=0
        text glyph font-family="Exciting" font-weight=900 font-size=22 line-height="26px" color="#0b0b0c"
      column flex=1 min-width=0 gap=2
        row justify-content="space-between" align-items="baseline" gap=8
          text title font-family="Exciting Lilt" font-weight=700 font-size=17 color="#ffffff" flex=1 min-width=0 line-clamp=1
          text time font-size=13 color="#ffffff8c" flex-shrink=0
        text body font-size=15 color="#ffffffe0" line-clamp=3 line-height=1.3

// A Settings row: a mark on a gray tile, a title, an optional value, a chevron.
component SettingsRow
  props
    id: string
    glyph: string
    title: string
    value: string
    last: bool
    scale: number
    press: action
  view
    button press=press testId=`row-${id}` width="100%" box-sizing="border-box" display="flex" flex-direction="row" align-items="center" gap=12 padding-left=16 min-height=46 text-align="start"
      column width=30 height=30 border-radius=8 background-color="light-dark(#2c2c2e, #3a3a3c)" align-items="center" justify-content="center" flex-shrink=0
        text glyph font-family="Exciting" font-weight=900 font-size=16 line-height="20px" color="#ffffff"
      row flex=1 min-width=0 align-self="stretch" align-items="center" gap=8 padding-right=14 padding-top=11 padding-bottom=11 border-bottom-style="solid" border-bottom-width=(last ? 0 : 0.5) border-color="light-dark(#d9d9de, #2a2a2e)"
        text title font-size=(17 * scale) flex=1 min-width=0 color="light-dark(#0b0b0c, #f5f5f7)"
        text value font-size=(16 * scale) color="light-dark(#6e6e75, #9a9aa0)" flex-shrink=0 line-clamp=1
        svg viewBox="0 0 24 24" width=18 height=18 flex-shrink=0
          path d="M9 6l6 6-6 6" fill="none" stroke="light-dark(#b4b4ba, #5a5a5e)" stroke-width=2 stroke-linecap="round" stroke-linejoin="round"

// A Settings row whose right side is the platform's switch, tinted monochrome.
component SwitchRow
  props
    id: string
    glyph: string
    title: string
    on: bool
    last: bool
    scale: number
    set: action
  view
    row width="100%" box-sizing="border-box" align-items="center" gap=12 padding-left=16 min-height=46
      column width=30 height=30 border-radius=8 background-color="light-dark(#2c2c2e, #3a3a3c)" align-items="center" justify-content="center" flex-shrink=0
        text glyph font-family="Exciting" font-weight=900 font-size=16 line-height="20px" color="#ffffff"
      row flex=1 min-width=0 align-self="stretch" align-items="center" gap=8 padding-right=14 padding-top=8 padding-bottom=8 border-bottom-style="solid" border-bottom-width=(last ? 0 : 0.5) border-color="light-dark(#d9d9de, #2a2a2e)"
        text title font-size=(17 * scale) flex=1 min-width=0 color="light-dark(#0b0b0c, #f5f5f7)"
        input type="checkbox" switch checked=on change=set testId=`switch-${id}` aria-label=title accent-color="light-dark(#0b0b0c, #e5e5ea)" margin=0 flex-shrink=0

// The back button at the top of a pushed page.
component BackButton
  props
    id: string
    label: string
    press: action
  view
    button press=press testId=`back-${id}` height=44 display="flex" flex-direction="row" align-items="center" gap=2 padding-right=8
      svg viewBox="0 0 24 24" width=26 height=26
        path d="M15 5l-7 7 7 7" fill="none" stroke="light-dark(#0b0b0c, #f5f5f7)" stroke-width=2.2 stroke-linecap="round" stroke-linejoin="round"
      text label font-size=17 color="light-dark(#0b0b0c, #f5f5f7)"

// A message bubble: mine in the scheme's ink, theirs on a gray, the
// assistant's with a caret while it is still writing.
component Bubble
  props
    id: string
    body: string
    role: string
    streaming: bool
    scale: number
  view
    row width="100%" justify-content=(role == "me" ? "flex-end" : "flex-start") testId=`bubble-${id}`
      row max-width="82%" padding-top=9 padding-bottom=9 padding-left=14 padding-right=14 border-radius=20 align-items="flex-end" gap=2 background-color=(role == "me" ? "light-dark(#0b0b0c, #f5f5f7)" : "light-dark(#e9e9ee, #202024)")
        text (streaming and body == "" ? "Thinking" : body) font-size=(17 * scale) line-height=1.32 white-space="pre-wrap" overflow-wrap="anywhere" color=(role == "me" ? "light-dark(#ffffff, #0b0b0c)" : "light-dark(#0b0b0c, #f5f5f7)")
        when streaming
          box width=3 height=(17 * scale) border-radius=1 margin-bottom=2 background-color="#ff6a2b" animation="blink 900ms ease-in-out infinite"

// The home indicator: tapping it goes home, as the gesture would.
component HomeBar
  props
    tone: string
    press: action
  view
    button press=press testId="home-bar" aria-label="Home" width="100%" height="calc(env(safe-area-inset-bottom) + 10px)" min-height=28 display="flex" flex-direction="column" align-items="center" justify-content="flex-end" padding-bottom=8 box-sizing="border-box" flex-shrink=0
      box width=134 height=5 border-radius=3 background-color=tone
