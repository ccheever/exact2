  action setCount(value)
    requested = value
  action setErrors(value)
    errors = value
  action editNote(value)
    note = value
  action interact
    clicks = clicks + 1
  action startWave
    mounted = true
    send wave = openWave(settings.count, settings.errors)
  action navigateAway
    mounted = false
    wave = none
  action releaseCurrent
    send fixture = releaseWave(waveId)
  action releaseAll
    send fixture = releaseWave(0)
  action inspectFixture
    send fixture = fixtureStats()
  action sample
    refresh counters

  task counters mount
    every(500, sample)

  view
    main testId="completion-storm" display="flex" flex-direction="column" width="100%" height="100%" box-sizing="border-box" overflow-y="scroll" padding=20 gap=14 background-color="#edf2f7" color="#14263d"
      column gap=5 flex-shrink=0
        text "COMPLETION STORM" font-size=12 font-weight=700 letter-spacing=2 color="#426d95"
        text "Many requests. One responsive screen?" font-size=26 font-weight=700
        text "Real local HTTP → Rust parse → runner fulfill → Contract results." font-size=13 color="#52667c"
      column padding=16 gap=10 background-color="#ffffff" border-radius=12 flex-shrink=0
        text "1. Choose the next wave" font-size=18 font-weight=600
        row gap=8 align-items="center"
          text "Concurrent lanes (1–128)" font-size=13
          input appearance="none" value=requested input=setCount testId="concurrency" width=80 padding=8 background-color="#edf2f7" aria-label="Concurrent requests"
        row gap=8
          button press=setCount("6") testId="count-6" padding=9 background-color="#dfebf7" border-radius=6
            text "6"
          button press=setCount("32") testId="count-32" padding=9 background-color="#dfebf7" border-radius=6
            text "32"
          button press=setCount("128") testId="count-128" padding=9 background-color="#dfebf7" border-radius=6
            text "128"
        row gap=8 align-items="center"
          text "Injected errors (0–100%)" font-size=13
          input appearance="none" value=errors input=setErrors testId="error-percent" width=80 padding=8 background-color="#edf2f7" aria-label="Error percentage"
        row gap=8
          button press=setErrors("0") testId="errors-0" padding=9 background-color="#dfebf7" border-radius=6
            text "All succeed"
          button press=setErrors("50") testId="errors-50" padding=9 background-color="#dfebf7" border-radius=6
            text "50% mixed errors"
        text `Next: ${settings.count} independent ${settings.count == 1 ? "lane" : "lanes"}, ${settings.errors}% error threshold (deterministic mix).` font-size=12 color="#52667c"
        button press=startWave testId="start-wave" padding=12 background-color="#244f79" border-radius=8
          text "Start / replace / remount wave" color="#ffffff" font-weight=600
        if pending(wave)
          text "Asking local fixture to admit a wave…" font-size=13
        match wave
          case some(w)
            text `Wave ${w.id}: ${w.message}` font-size=13 testId="wave-status"
          case none
            text "No active wave." font-size=13 testId="wave-status"
      column padding=16 gap=10 background-color="#ffffff" border-radius=12 flex-shrink=0
        text "2. Release held replies together" font-size=18 font-weight=600
        row gap=8 flex-wrap="wrap"
          button press=releaseCurrent testId="release-wave" padding=10 background-color="#cceee1" border-radius=6
            text "Release current"
          button press=releaseAll testId="release-all" padding=10 background-color="#cceee1" border-radius=6
            text "Release all old + current"
          button press=inspectFixture testId="inspect-fixture" padding=10 background-color="#dfebf7" border-radius=6
            text "Inspect fixture"
        text "Native: two independent HTTP workers hold data; ordered control requests keep release available. Capacity failures are visible." font-size=12 color="#8c641e" testId="native-release-hint"
        text "Release opens the gate for queued arrivals too. The browser limits open HTTP/1 sockets; issued lanes are not simultaneous sockets." font-size=12 color="#52667c"
        match fixture
          case some(f)
            text f.message font-size=13 testId="fixture-message"
            text `Fixture snapshot: ${f.received} received · ${f.issued} ${f.issued == 1 ? "response" : "responses"} issued · ${f.held} held` font-size=12 testId="fixture-counts"
          case none
            text "Inspect for a server-side snapshot; counters are separate from accepted results." font-size=12
      column padding=16 gap=10 background-color="#ffffff" border-radius=12 flex-shrink=0
        text "3. Keep interacting during settlement" font-size=18 font-weight=600
        input appearance="none" value=note input=editNote testId="stress-input" aria-label="Type during completions" placeholder="Type here while replies land" padding=10 background-color="#edf2f7" width="100%" box-sizing="border-box"
        text note testId="stress-echo" font-size=16
        button press=interact testId="interact" padding=10 background-color="#dfebf7" border-radius=6
          text `Still interactive: ${clicks} ${clicks == 1 ? "click" : "clicks"}` testId="interaction-count"
        button press=navigateAway testId="navigate-away" padding=10 background-color="#f7e0cf" border-radius=6
          text "Navigate away / unmount result views"
        text "Start a held wave → navigate away → start again → release all. Old replies must not populate the remounted results." font-size=12 color="#52667c"
      column padding=16 gap=7 background-color="#14263d" color="#ffffff" border-radius=12 flex-shrink=0
        text `${pendingCount} pending ${pendingCount == 1 ? "lane" : "lanes"}` testId="pending-count" font-size=21 font-weight=600
        text `${validCount} valid ${validCount == 1 ? "success" : "successes"} in this wave` testId="valid-count" font-size=15
        text `${failedCount} failed or invalid ${failedCount == 1 ? "reply" : "replies"} in this wave` testId="failed-count" font-size=15
        text `Lifetime: ${counters.emitted} ${counters.emitted == 1 ? "request" : "requests"} emitted · ${counters.accepted} current-ticket ${counters.accepted == 1 ? "reply" : "replies"} parsed` testId="lifetime-counts" font-size=12
        text "Pending uses runner flags. Valid success checks wave + lane + exact payload. Parsed includes failures, excludes dropped stale tickets; lifetime counts refresh every 500ms." font-size=12 color="#c4d5e4"
      if mounted
        column testId="results" gap=5 flex-shrink=0
