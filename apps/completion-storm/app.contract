      else
        column testId="away-screen" padding=20 gap=8 background-color="#ffffff" border-radius=12 flex-shrink=0
          text "Result views unmounted" font-size=20
          text "Root request arguments are explicitly disabled. Late replies are forgotten, not cancelled on the wire. Start to remount with a fresh wave." font-size=13

component Lane
  props
    result: Reply
    busy: bool
    expected: number
    lane: number
  view
    row testId=`lane-${lane}` gap=10 padding=9 background-color="#ffffff" border-radius=5
      text `#${lane}` width=45 font-size=12 color="#52667c"
      when busy
        text "Pending — no current result yet" testId=`result-${lane}` font-size=12 color="#8c641e"
      else
        when result.wave != expected
          text "No result for this wave" testId=`result-${lane}` font-size=12 color="#52667c"
        else
          when result.ok
            text `VALID · ${result.message}` testId=`result-${lane}` font-size=12 color="#187155"
          else
            text `FAILED · ${result.message}` testId=`result-${lane}` font-size=12 color="#a83f36"
