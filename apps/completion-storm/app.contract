// Root-owned independent requests: child effects are deliberately not required.
shape Settings
  count: number
  errors: number

shape Wave
  id: number
  count: number
  message: string

shape Reply
  wave: number
  lane: number
  ok: bool
  message: string

shape Counters
  emitted: number
  accepted: number

shape Control
  message: string
  received: number
  issued: number
  held: number

component CompletionStorm
  state requested = "32"
  state errors = "0"
  state mounted = true
  state note = ""
  state clicks = 0
  mutation wave as shape Wave
  mutation fixture as shape Control
  resource settings = settings(requested, errors) as shape Settings
  resource counters = counters() as shape Counters
  derive waveId = match wave { case some(w) => w.id, case none => 0 }
  derive waveCount = match wave { case some(w) => w.count, case none => 0 }
  derive active = mounted and waveId > 0 and not pending(wave)
