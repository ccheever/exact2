                    image "symbol:delete" testId="delete-symbol" position="relative" top=-0.666667 font-size=22 font-weight=400 tint-color=(chat.selectionCount > 0 ? "light-dark(#000000, #ffffff)" : "light-dark(#b4b4b7, #636366)")
                  button press=forwardSelected disabled=(chat.selectionCount == 0) testId="forward-selection" aria-label="Forward selected messages" width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
