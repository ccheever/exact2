                      else
                        box width=32 height=36 scale=3 clip-path=personPath background-color="#ffffff"
                    button disabled=true aria-label="Add Photo" margin-top=12 width=127 height=48 border-radius=24 background-color="light-dark(#e3e3e9, #2c2c2e)" display="flex" align-items="center" justify-content="center"
                      text "Add Photo" font-size=16 font-weight=600
                  column border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" overflow="hidden"
                    ContactNameField(value=contactFirst, label="First name", fieldId="contact-first", write=writeContactFirst, separated=true)
                    ContactNameField(value=contactLast, label="Last name", fieldId="contact-last", write=writeContactLast, separated=true)
                    ContactNameField(value=contactCompany, label="Company", fieldId="contact-company", write=writeContactCompany, separated=false)
                  column border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" overflow="hidden"
                    when contactPhoneShown
                      row height=53 box-sizing="border-box" align-items="center" padding-left=16 padding-right=16 gap=12 border-bottom-style="solid" border-bottom-width=0.333333 border-color="light-dark(#e5e5e5, #38383a)"
                        button press=removeContactPhone testId="remove-contact-phone" aria-label="Remove phone" width=28 height=44 display="flex" align-items="center" justify-content="center" flex-shrink=0
                          box width=25.666667 height=25.666667 border-radius=13 background-color="#ff3b30" display="flex" align-items="center" justify-content="center"
                            box width=13 height=2 border-radius=1 background-color="#ffffff"
                        button disabled=true aria-label="Phone label" width=92 height=44 display="flex" align-items="center" justify-content="space-between" flex-shrink=0
                          text "phone" font-size=17
                          image "symbol:back" rotate=180 font-size=12 tint-color="#8e8e93"
                        input id="contact-phone" testId="contact-phone" aria-label="Phone" placeholder="Phone" inputmode="tel" value=contactPhone change=writeContactPhone font-size=17 height=22 flex=1 min-width=0 border-width=0
                    button press=addContactPhone disabled=contactPhoneShown testId="add-contact-phone" aria-label="Add phone" height=51.333333 display="flex" align-items="center" padding-left=19.333333 padding-right=16 gap=14
                      box width=25.666667 height=25.666667 border-radius=13 background-color="#34c759" display="flex" align-items="center" justify-content="center"
                        image "symbol:add" font-size=18 tint-color="#ffffff"
                      text "add phone" font-size=17
                  column border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" overflow="hidden"
                    when contactEmailShown
                      row height=53 box-sizing="border-box" align-items="center" padding-left=16 padding-right=16 gap=12 border-bottom-style="solid" border-bottom-width=0.333333 border-color="light-dark(#e5e5e5, #38383a)"
                        button press=removeContactEmail testId="remove-contact-email" aria-label="Remove email" width=28 height=44 display="flex" align-items="center" justify-content="center" flex-shrink=0
                          box width=25.666667 height=25.666667 border-radius=13 background-color="#ff3b30" display="flex" align-items="center" justify-content="center"
                            box width=13 height=2 border-radius=1 background-color="#ffffff"
                        text "home" font-size=17 width=92 flex-shrink=0
                        input id="contact-email" testId="contact-email" aria-label="Email" placeholder="Email" type="email" value=contactEmail change=writeContactEmail font-size=17 height=22 flex=1 min-width=0 border-width=0
                    button press=addContactEmail disabled=contactEmailShown testId="add-contact-email" aria-label="Add email" height=51.333333 display="flex" align-items="center" padding-left=19.333333 padding-right=16 gap=14
                      box width=25.666667 height=25.666667 border-radius=13 background-color="#34c759" display="flex" align-items="center" justify-content="center"
                        image "symbol:add" font-size=18 tint-color="#ffffff"
                      text "add email" font-size=17
                  button disabled=true aria-label="Add pronouns" height=51.333333 border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" display="flex" align-items="center" padding-left=19.333333 gap=14
                    box width=25.666667 height=25.666667 border-radius=13 background-color="#34c759" display="flex" align-items="center" justify-content="center"
                      image "symbol:add" font-size=18 tint-color="#ffffff"
                    text "add pronouns" font-size=17
                  button disabled=true aria-label="Ringtone" height=51.333333 border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" display="flex" align-items="center" padding-left=16 padding-right=16 gap=8
                    text "Ringtone" font-size=17 flex=1
                    text "Default" font-size=17 color="#8e8e93"
                    image "symbol:back" rotate=180 font-size=12 tint-color="#8e8e93"
                  button disabled=true aria-label="Text Tone" height=51.333333 border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)" display="flex" align-items="center" padding-left=16 padding-right=16 gap=8
                    text "Text Tone" font-size=17 flex=1
                    text "Default" font-size=17 color="#8e8e93"
                    image "symbol:back" rotate=180 font-size=12 tint-color="#8e8e93"
                  column min-height=106.333333 box-sizing="border-box" padding=16 border-radius=28 background-color="light-dark(#ffffff, #1c1c1e)"
                    text "Notes" font-size=17
                    textarea id="contact-notes" testId="contact-notes" aria-label="Notes" value=contactNotes change=writeContactNotes font-size=17 line-height="22px" field-sizing="content" min-height=44 border-width=0
            column id="discard-contact-confirmation" popover="auto" role="alertdialog" aria-label="Discard new contact" position="absolute" width=240 box-sizing="border-box" padding=16 border-width=0 border-radius=28 background-color="light-dark(#efeff0, #1c1c1e)" gap=12
              text "Are you sure you want to discard this new contact?" font-size=13 color="#8e8e93" text-align="center"
              button destructive=true press=discardContact id="back" testId="discard-new-contact" popovertarget="discard-contact-confirmation" popovertargetaction="hide" color="#ff3b30" height=48 border-radius=24 background-color="light-dark(#ffffff, #38383a)"
                text "Discard Changes" font-size=17
              button testId="keep-new-contact" popovertarget="discard-contact-confirmation" popovertargetaction="hide" color="light-dark(#007aff, #0a84ff)" height=44
                text "Cancel" font-size=17

        when e.name == "compose"
          NewMessageSheet(routeKey=`${e.id}`, contacts=contacts, recipientSelection=recipientSelection, recipientQuery=recipientQuery, newDraft=newDraft, showContacts=showContacts, personPath=personPath, editable=(chatThread != "" or contacts.target != ""), cancelNewMessage=cancelNewMessage, selectRecipient=selectRecipient, searchRecipient=searchRecipient, recipientKey=recipientKey, browseContacts=browseContacts, chooseRecipient=chooseRecipient, writeNew=writeNew, clearRecipientSelection=clearRecipientSelection, sendNewMessage=sendNewMessage)

component NewMessageSheet
  props
    routeKey: string
    contacts: Recipients
    recipientSelection: string
    recipientQuery: string
    newDraft: string
    showContacts: bool
    personPath: string
    editable: bool
    cancelNewMessage: action
    selectRecipient: action
    searchRecipient: action
    recipientKey: action
    browseContacts: action
    chooseRecipient: action
    writeNew: action
    clearRecipientSelection: action
    sendNewMessage: action
  view
    column navigationKey=routeKey navigationPresentation="modal" closedby=(newDraft == "" ? "closerequest" : "none") testId="new-message-layer" position="absolute" top=0 left=0 right=0 bottom=0 z-index=10
      box position="absolute" top="calc(env(safe-area-inset-top) + 40px)" left=0 right=0 bottom=0 background-color="light-dark(#ffffff, #1c1c1e)"
      column testId="new-message-sheet" position="absolute" top="env(safe-area-inset-top)" left=0 right=0 bottom=0 border-radius=40 background-color="light-dark(#ffffff, #1c1c1e)" overflow="hidden"
        row testId="compose-header" retainFocus=true height=80 flex-shrink=0 align-items="center" justify-content="center"
          text "New Message" font-size=17 font-weight=600
          button press=cancelNewMessage id="back" testId="cancel-new-message" aria-label="Close new message" position="absolute" right=16 top=16 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
            image "symbol:close" font-size=22 font-weight=400 tint-color="light-dark(#000000, #ffffff)"
        row testId="recipient-field" margin-left=16 margin-right=16 min-height=48 border-radius=24 backgroundMaterial="glass" align-items="center" padding-left=14 padding-right=12 gap=6 flex-shrink=0
          text "To:" font-size=15 color="#8e8e93" flex-shrink=0
          row flex=1 min-width=0 flex-wrap="wrap" align-items="center" column-gap=4 padding-top=4 padding-bottom=4
            each person in contacts.selected key=person.id
              button press=selectRecipient(person.id, person.without) testId=`selected-recipient-${person.id}` aria-label=`${person.name}${recipientSelection == person.id ? ", selected" : ""}` background-color=(recipientSelection == person.id ? "light-dark(#007aff, #0a84ff)" : "#00000000") border-radius=4 max-width="100%" height=32 display="flex" align-items="center"
                text person.name font-size=17 color=(recipientSelection == person.id ? "#ffffff" : "light-dark(#007aff, #0a84ff)") line-clamp=1
            input id="recipient-search" testId="recipient-search" autocapitalize="none" autocorrect="off" spellcheck="false" value=recipientQuery change=searchRecipient key=recipientKey aria-label="To" font-size=17 color="light-dark(#000000, #ffffff)" flex=1 min-width=36 height=40 border-width=0
          button press=browseContacts testId="choose-contact" aria-label="Add contact" width=28 height=28 border-radius=14 background-color="light-dark(#e5e5ea, #48484a)" display="flex" align-items="center" justify-content="center"
            box width=14 height=14
              box position="absolute" left=6 top=0 width=2 height=14 border-radius=1 background-color="light-dark(#000000, #ffffff)"
              box position="absolute" left=0 top=6 width=14 height=2 border-radius=1 background-color="light-dark(#000000, #ffffff)"
        scroll testId="recipient-results" flex=1 min-height=0 keyboardDismissMode="interactive" margin-top=8
          when recipientQuery != "" or showContacts
            column padding-left=28 padding-right=20
              each person in contacts.people key=person.id
                button press=chooseRecipient(person.id) testId=`recipient-${person.id}` aria-label=person.name height=64 display="flex" align-items="center" gap=12 border-bottom-style="solid" border-bottom-width=0.5 border-color="light-dark(#d9d9dc, #38383a)"
                  column width=36 height=36 border-radius=18 background-color=person.color align-items="center" justify-content="center" flex-shrink=0
                    when person.initials != ""
                      text person.initials font-size=14 color="#ffffff"
                    else
                      box width=32 height=36 scale=0.55 clip-path=personPath background-color="#ffffff"
                  text person.name font-size=17 line-clamp=1 color="light-dark(#007aff, #0a84ff)"
              when length(contacts.people) == 0
                text "No Results" font-size=17 color="#8e8e93" text-align="center" padding=24
        column padding-left=16 padding-right=16 padding-top=0 padding-bottom=16 flex-shrink=1 min-height=40.333333
          row gap=12 align-items="flex-end" min-height=0
            button disabled=true aria-label="Add attachment" width=40 height=40 border-radius=20 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
              image "symbol:add" font-size=22 font-weight=400 tint-color="#b4b4b7"
            row testId="new-composer-surface" flex=1 min-width=0 min-height=40.333333 max-height="100%" align-self="stretch" box-sizing="border-box" backgroundMaterial="glass" border-radius=20 align-items="flex-end" padding-left=16 padding-right=6.333333 padding-top=6 padding-bottom=6 gap=5
              textarea id="new-composer" testId="new-composer" disabled=(not editable) value=newDraft change=writeNew focus=clearRecipientSelection placeholder=(contacts.target == "" ? "" : "iMessage") aria-label="New message" color="light-dark(#000000, #ffffff)" font-size=17 line-height="20px" flex=1 min-width=0 field-sizing="content" min-height=28.333333 max-height="100%" align-self="stretch" padding-top=4.166667 padding-bottom=4.166667 box-sizing="border-box" border-width=0
              button press=sendNewMessage retainFocus=true disabled=(not contacts.canSend) testId="send-new-message" aria-label="Send message" width=38 height=28 box-sizing="border-box" padding-left=(newDraft == "" ? 10 : 0) border-radius=14 background-color=(newDraft == "" ? "#00000000" : (contacts.canSend ? "light-dark(#007aff, #0a84ff)" : "light-dark(#e9e9eb, #3a3a3c)")) display="flex" align-items="center" justify-content="center"
                when newDraft != ""
                  image "symbol:send" font-size=17 font-weight=700 tint-color=(contacts.canSend ? "#ffffff" : "light-dark(#b4b4b7, #8e8e93)")
                else
                  image "symbol:microphone" font-size=17 font-weight=400 tint-color="light-dark(#b4b4b7, #8e8e93)"
        box height="calc(env(safe-area-inset-bottom) - 22px)" min-height=0 flex-shrink=0

// A zero-width side slot preserves the balloon's percentage width and gesture target.
component ReactionBadges
  props
    message: Message
    prefix: string
    hidden: bool
    open: action
  view
    box width=0 height=0 flex-shrink=0 z-index=3 opacity=(hidden ? 0 : 1)
      each entry in message.reactionEntries key=entry.id
        button press=open retainFocus=true testId=(entry.edge ? `${prefix}-${message.id}` : `${prefix}-${message.id}-${entry.id}`) aria-label=`${entry.name}: ${entry.value} reaction` position="absolute" left=(message.outgoing ? -15 + entry.offset : -21 - entry.offset) top=-28 width=36 height=36 box-sizing="border-box" border-radius=18 border-style="solid" border-width=1 border-color="light-dark(#ffffff, #000000)" background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)") display="flex" align-items="center" justify-content="center" z-index=(100 - entry.offset)
          when entry.edge
            box position="absolute" left=(message.outgoing ? 2 : 23) top=27 width=11 height=11 border-radius=5.5 background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)")
            box position="absolute" left=(message.outgoing ? -2 : 33) top=38 width=5 height=5 border-radius=2.5 background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)")
          ReactionArtwork(value=entry.value, extent=32, emojiSize=19)

component MessageBody
  props
    body: string
    outgoing: bool
    selecting: bool
    finish: action
  view
    column min-width=0
      text body white-space="pre-wrap" overflow-wrap="break-word" font-size=17 line-height="20px" color=(outgoing ? "#ffffff" : "light-dark(#000000, #ffffff)") text-align="left" opacity=(selecting ? 0 : 1)
      when selecting
        textarea id="selected-message-text" testId="selected-message-text" readonly=true value=body blur=finish aria-label="Selected message text" position="absolute" top=0 left=0 width="100%" height="100%" box-sizing="border-box" padding=0 border-width=0 font-size=17 line-height="20px" color=(outgoing ? "#ffffff" : "light-dark(#000000, #ffffff)") caret-color=(outgoing ? "#ffffff" : "auto")

// Standard Tapbacks use the reference's resting artwork; other choices remain emoji.
component ReactionArtwork
  props
    value: string
    extent: number
    emojiSize: number
  view
    when value == "❤️" or value == "👍" or value == "👎" or value == "haha" or value == "‼️" or value == "❓"
      image (value == "❤️" ? "assets/tapbacks/heart.png" : (value == "👍" ? "assets/tapbacks/like.png" : (value == "👎" ? "assets/tapbacks/dislike.png" : (value == "haha" ? "assets/tapbacks/laugh.png" : (value == "‼️" ? "assets/tapbacks/emphasis.png" : "assets/tapbacks/question.png"))))) width=extent height=extent object-fit="contain"
    else
      text value font-size=emojiSize

component ContactNameField
  props
    value: string
    label: string
    fieldId: string
    write: action
    separated: bool
  view
    row height=53 box-sizing="border-box" padding-left=16 padding-right=16 align-items="center"
      input id=fieldId testId=fieldId aria-label=label placeholder=label value=value change=write autocapitalize="words" font-size=17 height=22 flex=1 min-width=0 border-width=0
      when separated
        box position="absolute" left=16 right=0 bottom=0 height=0.333333 background-color="light-dark(#e5e5e5, #38383a)"
