                button destructive=true press=deleteSelected commandfor="delete-confirmation" command="close" testId="confirm-delete-messages" aria-label=(chat.selectionCount == 1 ? "Delete Message" : `Delete ${chat.selectionCount} Messages`) height=48 border-radius=24 background-color="light-dark(#d9d9dc, #555559)" display="flex" align-items="center" justify-content="center" color="light-dark(#ff383c, #ff4245)"
                  text (chat.selectionCount == 1 ? "Delete Message" : `Delete ${chat.selectionCount} Messages`) font-size=17 font-weight=600
