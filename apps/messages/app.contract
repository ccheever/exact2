                  image "symbol:close" font-size=20 font-weight=500 tint-color="light-dark(#000000, #ffffff)"
              button press=showDetails retainFocus=true disabled=selecting testId="contact-details" aria-label=`Contact information for ${chat.name}` max-width="70%" display="flex" flex-direction="column" align-items="center"
                column id="contact-photo" width=60 height=60 border-radius=30 background-color=chat.color align-items="center" justify-content="center" z-index=1
                  when chat.initials != ""
                    text chat.initials color="#ffffff" font-size=26 font-weight=600
                  else
                    box width=32 height=36 scale=0.8 clip-path=personPath background-color="#ffffff"
                row max-width="100%" box-sizing="border-box" padding-left=14 padding-right=12 height=32 margin-top=-5 border-radius=16 backgroundMaterial="glass" align-items="center" gap=6
                  text chat.name min-width=0 line-clamp=1 font-size=17 font-weight=600 color="light-dark(#000000, #ffffff)"
                  text "›" font-size=22 font-weight=600 color="light-dark(#b4b4b7, #8e8e93)"
            column testId="conversation-body" flex=1 min-height=0
              scroll testId="transcript" scrollFollowEnd=true keyboardDismissMode="interactive" scrollTop=(1000000 + chat.scrollRevision) flex=1 min-height=0 overflow-x="hidden"
                scroll scroll=timestampsScrolled testId="timestamp-reveal" width="100%" overflow-x=(selecting ? "hidden" : "scroll") overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory"
                  row width="200%"
                    column scroll-snap-align="start" width="50%" box-sizing="border-box" padding-left=16 padding-right=16 padding-top=14 padding-bottom=14 gap=4
                      when length(chat.messages) > 0
                        column testId="conversation-service" left=timestampOffset align-items="center" margin-bottom=10
                          text "iMessage" font-size=11 line-height="13.333333px" color="#8e8e93"
                          row testId="conversation-encryption" align-items="center" gap=4.333333 height=13.333333
                            box width=6 height=8.333333 background-color="#8e8e93" clip-path="path('M 1 3.333 L 1 2.167 C 1 0.972 1.895 0 3 0 C 4.105 0 5 0.972 5 2.167 L 5 3.333 L 5.333 3.333 Q 6 3.333 6 4 L 6 7.667 Q 6 8.333 5.333 8.333 L 0.667 8.333 Q 0 8.333 0 7.667 L 0 4 Q 0 3.333 0.667 3.333 Z M 2 3.333 L 4 3.333 L 4 2.167 C 4 1.522 3.552 1 3 1 C 2.448 1 2 1.522 2 2.167 Z')"
                            text "Encrypted" font-size=11 line-height="13.333333px" color="#8e8e93"
                      each message in chat.messages key=message.id
                        when message.timeLabel != ""
                          text message.timeLabel testId=`time-label-${message.id}` left=timestampOffset font-size=11 line-height="13.333333px" color="#8e8e93" text-align="center" margin-bottom=2.666667
                        column testId=`message-row-${message.id}` left=(timestampCompensation + (selecting and not message.outgoing ? 40.666667 : 0)) align-items=(message.outgoing ? "flex-end" : "flex-start") padding-left=(message.senderName != "" ? 44 : 0) box-sizing="border-box" margin-top=(message.reactionCount > 0 ? 13 : 0) margin-bottom=(message.tail ? 6 : 0)
                          when message.showSender
                            text message.senderName testId=`sender-${message.id}` font-size=11 color="#8e8e93" margin-left=12 margin-bottom=4
                          when message.senderName != "" and message.tail
                            column testId=`avatar-${message.id}` position="absolute" left=4 bottom=(message.replyCount > 0 ? 28 : 0) width=32 height=32 border-radius=16 background-color=message.senderColor align-items="center" justify-content="center"
                              when message.senderInitials != ""
                                text message.senderInitials font-size=12 color="#ffffff" font-weight=600
                              else
                                box width=32 height=36 scale=0.55 clip-path=personPath background-color="#ffffff"
                          when message.reply != ""
                            text message.reply font-size=13 color="#8e8e93" max-width="75%" border-left-style="solid" border-left-width=2 border-color="light-dark(#c7c7cc, #48484a)" padding-left=8 margin-bottom=5 line-clamp=2
                          row width="100%" justify-content=(message.outgoing ? "flex-end" : "flex-start")
                            when message.outgoing
                              ReactionBadges(message=message, prefix="reaction", hidden=(selected == message.id and replying == ""), open=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", false))
                            button retainFocus=true swiperight=openReplies(message.replyRoot) touch-action="pan-right pan-y" transition="translate 180ms ease-out" contextmenu=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", true) dblclick=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", false) id=`bubble-${message.id}` testId=`bubble-${message.id}` opacity=(selected == message.id and replying == "" ? 0 : 1) aria-label=message.body max-width="75%" min-width=48 box-sizing="border-box" display="flex" justify-content="center" align-items="center" padding-left=14 padding-right=14 padding-top=10 padding-bottom=10 border-radius=20 background-color=(message.outgoing ? "light-dark(#007aff, #0a84ff)" : "light-dark(#e9e9eb, #262629)")
                              column swipeIndicator=true testId=`swipe-indicator-${message.id}` position="absolute" left=-40 top="50%" margin-top=-16 width=32 height=32 align-items="center" justify-content="center" opacity=0 scale=0.5 transition="opacity 180ms ease-out, scale 180ms ease-out"
                                box width=20 height=16 clip-path="path('M 8 0 Q 9 0 9 1 L 9 4 L 11 4 C 17 4 20 8 20 14 Q 20 16 19 14 C 17 10 15 9 11 9 L 9 9 L 9 12 Q 9 13 8 12 L 1 7 Q 0 6 1 5 Z')" background-color="light-dark(#aeaeb2, #636366)"
