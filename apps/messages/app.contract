// Messages: the router owns locations; UIKit owns the keyboard and scrolling.
// @ref LLP 1038 §6, D8/D11 — state outside nav remains application state.
routes nav
  inbox "/"
    thread "/t/:thread"
      details "/t/:thread/details"
        newContact "/t/:thread/contact"
    compose "/new"

shape Person
  id: string
  name: string
  initials: string
  color: string
  preview: string
  time: string
  unread: bool
  draft: string
  reply: string
  muted: bool
shape Inbox
  people: list<Person>
shape DeletedConversation
  id: string
  name: string
  initials: string
  color: string
  count: number
  days: number
  chosen: bool
  selection: string
shape DeletedInbox
  people: list<DeletedConversation>
  targets: string
  count: number
shape Recipient
  id: string
  name: string
  without: string
shape Recipients
  selected: list<Recipient>
  people: list<Person>
  target: string
  canSend: bool
  last: string
  withoutLast: string
  resolved: string
shape SavedReaction
  id: string
  value: string
  name: string
  initials: string
  color: string
  own: bool
  offset: number
  edge: bool
shape ReactionGroup
  value: string
  people: list<SavedReaction>
  width: number
shape Message
  chosen: bool
  selection: string
  id: string
  body: string
  outgoing: bool
  time: string
  reaction: string
  reactionCount: number
  reactionEntries: list<SavedReaction>
  reactionGroups: list<ReactionGroup>
  reactionPanelWidth: number
  day: string
  timeLabel: string
  delivery: string
  reply: string
  tail: bool
  replyRoot: string
  replyCount: number
  sender: string
  senderName: string
  senderInitials: string
  senderColor: string
  showSender: bool
shape ReactionChoice
  id: string
  value: string
  label: string
shape Conversation
  selectionCount: number
  selectedText: string
  muted: bool
  blocked: bool
  knownContact: bool
  contactKind: string
  contactAddress: string
  id: string
  name: string
  initials: string
  color: string
  messages: list<Message>
  revision: number
  scrollRevision: number
  reactions: list<ReactionChoice>
  replies: list<Message>
  typingName: string
  typingAvatar: string
  typingRoot: string
shape Change
  revision: number
  pending: bool
shape ComposerDraft
  thread: string
  draft: string
  reply: string

component Messages
  state ticks = 0
  derive thread = top(nav).params.thread
  // A compose overlay keeps the conversation beneath it alive and editable.
  derive chatThread = (top(nav).name == "compose" ? top(back(nav)).params.thread : thread)
  state query = ""
  state inboxMode = "messages"
  state deletedSelection = ""
  state recoveryTargets = ""
  state recoveryCount = 0
  state inboxTop = 0
  derive inboxTitleOpacity = (inboxTop < 44 ? 0 : (inboxTop > 60 ? 1 : (inboxTop - 44) / 16))
  state swipedThread = ""
  state swipeOffset = 70
  state timestampOffset = 0
  derive timestampDistance = (timestampOffset < 0 ? 0 : (timestampOffset * 0.4 > 58 ? 58 : timestampOffset * 0.4))
  derive timestampCompensation = timestampOffset - timestampDistance
  // A cold URL and browser Forward load the destination's saved composer.
  // Local edits belong to one conversation, including beneath its detail/modal.
  state draftThread = ""
  state draftText = ""
  derive draft = (draftThread == chatThread ? draftText : (savedComposer.thread == chatThread ? savedComposer.draft : ""))
  state selecting = false
  state selection = ""
  state selected = ""
  state selectingText = ""
  state selectedBody = ""
  state selectedRoot = ""
  state selectedOutgoing = false
  state selectedReaction = ""
  state selectedTail = false
  state selectedGroup = false
  state selectedActions = false
  state selectedMenuActions = false
  state selectedPicker = false
  state selectedPickerVisited = false
  state selectedEditing = false
  state replyThread = ""
  state replyRoot = ""
  derive replying = (replyThread == chatThread ? replyRoot : (savedComposer.thread == chatThread ? savedComposer.reply : ""))
  state composerEditing = false
  state detailsEditing = false
  state attachments = false
  derive composing = top(nav).name == "compose"
  state contactFirst = ""
  state contactLast = ""
  state contactCompany = ""
  state contactPhone = ""
  state contactEmail = ""
  state contactNotes = ""
  state contactPhoneShown = true
  state contactEmailShown = false
  state recipientQuery = ""
  state recipient = ""
  state recipientSelection = ""
  state recipientRemainder = ""
  state newDraft = ""
  state showContacts = false
  mutation change as shape Change
  derive revision = match change { case some(c) => c.revision, case none => 0 }
  derive pendingReplies = match change { case some(c) => c.pending, case none => false }
  derive typingPhase = ticks % 4
  derive bellPath = "path('M 12 1 C 10 1 10 3 10 3 C 5 4 4 7 4 12 L 4 16 L 1 20 L 23 20 L 20 16 L 20 12 C 20 7 19 4 14 3 C 14 3 14 1 12 1 Z M 8 22 C 8 27 16 27 16 22 Z')"
  derive trashPath = "path('M 8 1 L 16 1 Q 18 1 18 3 L 18 5 L 23 5 L 23 7 L 21 7 L 19 27 L 5 27 L 3 7 L 1 7 L 1 5 L 6 5 L 6 3 Q 6 1 8 1 Z M 8 3 L 8 5 L 16 5 L 16 3 Z M 6 8 L 7.5 24 L 9.5 24 L 8 8 Z M 11 8 L 11 24 L 13 24 L 13 8 Z M 16 8 L 14.5 24 L 16.5 24 L 18 8 Z')"
  derive callPath = "path('M 4 0 Q 2 0 1 3 C -3 12 12 27 21 23 Q 24 22 23 20 L 18 16 Q 17 15 15 17 L 13 18 Q 7 15 5 9 L 7 7 Q 9 5 7 3 Z')"
  derive personPath = "path('M 16 2 C 11 2 8 6 8 11 C 8 16 11 20 16 20 C 21 20 24 16 24 11 C 24 6 21 2 16 2 Z M 2 35 C 2 26 8 22 16 22 C 24 22 30 26 30 35 Z')"
  derive emojiFacePath = "path('M 12 1 C 5.925 1 1 5.925 1 12 C 1 18.075 5.925 23 12 23 C 18.075 23 23 18.075 23 12 C 23 5.925 18.075 1 12 1 Z M 12 3 C 16.971 3 21 7.029 21 12 C 21 16.971 16.971 21 12 21 C 7.029 21 3 16.971 3 12 C 3 7.029 7.029 3 12 3 Z M 7 9 C 7 7 10 7 10 9 C 10 11 7 11 7 9 Z M 14 9 C 14 7 17 7 17 9 C 17 11 14 11 14 9 Z M 5 13 Q 12 17 19 13 C 18 23 6 23 5 13 Z M 7 16 C 9 20 15 20 17 16 Q 12 18 7 16 Z')"
  derive outgoingTailPath = "path('M 0 0 L 22 0 C 22 14.4 16.4 11.9 16.4 17.8 C 16.4 18.7 17.7 21.7 18.7 22.4 C 18.6 23.6 18.5 24 16.8 23.6 C 11.6 21.7 0.6 13.2 0 11 Z')"
  derive incomingTailPath = "path('M 22 0 L 0 0 C 0 14.4 5.6 11.9 5.6 17.8 C 5.6 18.7 4.3 21.7 3.3 22.4 C 3.4 23.6 3.5 24 5.2 23.6 C 10.4 21.7 21.4 13.2 22 11 Z')"
  resource inbox = inbox(query, revision) as shape Inbox
  resource syncStatus = syncState(revision) as shape string
  resource deletedInbox = recentlyDeleted(deletedSelection, revision, now()) as shape DeletedInbox
  resource contacts = recipients(recipient, recipientQuery, newDraft, revision) as shape Recipients
  resource savedComposer = conversationDraft(chatThread, revision) as shape ComposerDraft
  resource chat = conversation(chatThread, revision, replying, selection) as shape Conversation

  action search(value) writes query, swipedThread
    query = value
    swipedThread = ""
  action filterInbox(value: string) writes inboxMode, deletedSelection, swipedThread
    inboxMode = value
    deletedSelection = ""
    swipedThread = ""
  action chooseDeleted(value: string) writes deletedSelection
    deletedSelection = value
  action prepareRecovery writes recoveryTargets, recoveryCount
    recoveryTargets = deletedInbox.targets
    recoveryCount = deletedInbox.count
  action recoverDeleted writes change, deletedSelection
    send change = recoverConversations(recoveryTargets, now())
    deletedSelection = ""
  action permanentlyDelete writes change, deletedSelection
    send change = purgeConversations(recoveryTargets, now())
    deletedSelection = ""
  action open(id: string, savedDraft: string, savedReply: string) writes nav, selected, change, draftText, draftThread, replyRoot, replyThread, swipedThread, composerEditing, timestampOffset, selectingText
    selectingText = ""
    timestampOffset = 0
    if swipedThread != ""
      swipedThread = ""
    else
      nav = open(nav, path("thread", id))
      composerEditing = false
      selected = ""
      draftThread = id
      draftText = savedDraft
      replyThread = id
      replyRoot = savedReply
      send change = markRead(id)
  action back writes nav, selected, attachments, change, composerEditing, timestampOffset, selecting, selection, selectingText
    selectingText = ""
    selecting = false
    selection = ""
    timestampOffset = 0
    if chatThread != "" and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
      send change = saveDraft(chatThread, draft, replying)
    nav = back(nav)
    composerEditing = false
    selected = ""
    attachments = false
  action timestampsScrolled(left: number, top: number) writes timestampOffset
    timestampOffset = left
  action inboxListScrolled(left: number, top: number) writes inboxTop
    inboxTop = top
  action inboxScrolled(id: string, left: number, top: number) writes swipedThread, swipeOffset
    if left < 69 or left > 71
      swipedThread = id
      swipeOffset = left
    if left == 70 and swipedThread == id
      swipedThread = ""
  action muteThread(id: string) writes change, swipedThread
    swipedThread = ""
    send change = muteConversation(id)
  action blockThread(value: bool) writes change
    send change = blockConversation(thread, value)
  action readThread(id: string, unread: bool) writes change, swipedThread
    swipedThread = ""
    send change = setConversationUnread(id, unread)
  action deleteThread(id: string) writes change, swipedThread
    swipedThread = ""
    send change = deleteConversation(id, now())
  action write(value) writes draftText, draftThread
    draftThread = chatThread
    draftText = value
  action sendDraft writes draftText, draftThread, change, attachments
    if draft != ""
      send change = sendMessage(thread, draft, replying, ticks, now())
      draftThread = chatThread
      draftText = ""
      attachments = false
      focus("composer")
  action select(id: string, body: string, outgoing: bool, emoji: string, tail: bool, root: string, group: bool, actions: bool) writes selected, selectedBody, selectedOutgoing, selectedReaction, selectedTail, selectedRoot, selectedGroup, selectedActions, selectedEditing, selectedMenuActions, selectedPicker, selectedPickerVisited, selectingText
    selectingText = ""
    selected = id
    selectedBody = body
    selectedRoot = root
    selectedOutgoing = outgoing
    selectedReaction = emoji
    selectedTail = tail
    selectedGroup = group
    selectedActions = actions
    selectedMenuActions = actions
    selectedPicker = false
    selectedPickerVisited = false
    selectedEditing = composerEditing
    if actions
      focus("emoji-return")
  action menuKey(value) writes selected, selectedPicker
    if value == "Escape"
      if selectedPicker
        selectedPicker = false
        if not selectedActions and selectedEditing
          focus("composer")
        else
          focus("emoji-return")
      else
        selected = ""
        if (selectedActions or selectedPickerVisited) and selectedEditing
          focus("composer")
  action showEmojiPicker writes selectedPicker, selectedPickerVisited, selectedMenuActions
    selectedPicker = true
    selectedPickerVisited = true
    selectedMenuActions = false
    focus("emoji-input")
  action closeEmojiPicker writes selectedPicker
    selectedPicker = false
    if not selectedActions and selectedEditing
      focus("composer")
    else
      focus("emoji-return")
  action dismiss writes selected, attachments, selectedPicker
    selected = ""
    selectedPicker = false
    if (selectedActions or selectedPickerVisited) and selectedEditing
      focus("composer")
    attachments = false
  action reaction(emoji: string) writes change, selected, selectedPicker
    send change = react(thread, selected, emoji)
    selected = ""
    selectedPicker = false
    if (selectedActions or selectedPickerVisited) and selectedEditing
      focus("composer")
  action reply writes replyRoot, replyThread, selected
    replyThread = chatThread
    replyRoot = selectedRoot
    selected = ""
    focus("composer")
  action copyMessage writes selected, selectedPicker
    copyText(selectedBody)
    selected = ""
    selectedPicker = false
    if selectedEditing
      focus("composer")
  action selectMessageText writes selected, selectedPicker, selectingText
    selectingText = selected
    selected = ""
    selectedPicker = false
    selectText("selected-message-text")
  action finishTextSelection writes selectingText
    selectingText = ""
  action openReplies(id: string) writes replyRoot, replyThread
    replyThread = chatThread
    replyRoot = id
    focus("composer")
  action cancelReply writes replyRoot, replyThread
    replyThread = chatThread
    replyRoot = ""
  action more writes selecting, selection, selected, timestampOffset, attachments
    selection = selected
    selecting = true
    selected = ""
    timestampOffset = 0
    attachments = false
    focus("selection-toolbar")
  action chooseMessage(value: string) writes selection
    selection = value
  action cancelSelection writes selecting, selection
    selecting = false
    selection = ""
  action selectionKey(value) writes selecting, selection
    if value == "Escape"
      selecting = false
      selection = ""
  action deleteSelected writes change, selecting, selection
    send change = deleteMessages(thread, selection, now())
    selecting = false
    selection = ""
  action composerFocus writes composerEditing, selectingText
    composerEditing = true
    selectingText = ""
  action composerBlur writes composerEditing
    composerEditing = false
  action showDetails writes nav, detailsEditing, selected, attachments, selectingText
    selectingText = ""
    detailsEditing = composerEditing
    selected = ""
    attachments = false
    nav = push(nav, path("details", thread))
  action createContact writes nav, contactFirst, contactLast, contactCompany, contactPhone, contactEmail, contactNotes, contactPhoneShown, contactEmailShown
    contactFirst = ""
    contactLast = ""
    contactCompany = ""
    contactNotes = ""
    contactPhone = (chat.contactKind == "phone" ? chat.contactAddress : "")
    contactEmail = (chat.contactKind == "email" ? chat.contactAddress : "")
    contactPhoneShown = chat.contactKind == "phone"
    contactEmailShown = chat.contactKind == "email"
    nav = push(nav, path("newContact", thread))
    focus("contact-first")
  action discardContact writes nav
    nav = back(nav)
  action saveContact writes nav, change
    send change = createLocalContact(contactFirst, contactLast, contactCompany, contactPhone, contactEmail, contactNotes)
    nav = back(nav)
  action writeContactFirst(value) writes contactFirst
    contactFirst = value
  action writeContactLast(value) writes contactLast
    contactLast = value
  action writeContactCompany(value) writes contactCompany
    contactCompany = value
  action writeContactPhone(value) writes contactPhone
    contactPhone = value
  action writeContactEmail(value) writes contactEmail
    contactEmail = value
  action writeContactNotes(value) writes contactNotes
    contactNotes = value
  action addContactPhone writes contactPhoneShown
    contactPhoneShown = true
    focus("contact-phone")
  action removeContactPhone writes contactPhoneShown, contactPhone
    contactPhoneShown = false
    contactPhone = ""
  action addContactEmail writes contactEmailShown
    contactEmailShown = true
    focus("contact-email")
  action removeContactEmail writes contactEmailShown, contactEmail
    contactEmailShown = false
    contactEmail = ""
  action closeDetails writes nav
    nav = back(nav)
    if detailsEditing
      focus("composer")
  action showAttachments writes attachments
    attachments = not attachments
  action insert(value: string) writes draftText, draftThread, attachments
    draftText = draft + value
    draftThread = chatThread
    attachments = false
    focus("composer")
  action newMessage writes nav, recipientQuery, recipient, newDraft, showContacts, recipientSelection, swipedThread
    swipedThread = ""
    nav = push(nav, "/new")
    recipientSelection = ""
    recipientQuery = ""
    recipient = ""
    newDraft = ""
    showContacts = false
    focus("recipient-search")
  action forwardSelected writes nav, selecting, selection, recipientQuery, recipient, newDraft, showContacts, recipientSelection
    if chat.selectionCount > 0
      newDraft = chat.selectedText
      nav = push(nav, "/new")
      selecting = false
      selection = ""
      recipientSelection = ""
      recipientQuery = ""
      recipient = ""
      showContacts = false
      focus("recipient-search")
  action cancelNewMessage writes nav
    nav = back(nav)
  action searchRecipient(value) writes recipientQuery, recipientSelection, recipient
    if recipientSelection != "" and value != ""
      recipient = recipientRemainder
    recipientQuery = value
    recipientSelection = ""
  action chooseRecipient(id: string) writes recipient, recipientQuery, showContacts, recipientSelection
    recipientSelection = ""
    recipient = recipient + "|" + id
    recipientQuery = ""
    showContacts = false
    focus("new-composer")
  action selectRecipient(id: string, remaining: string) writes recipientSelection, recipientRemainder
    if recipientQuery == ""
      recipientSelection = id
      recipientRemainder = remaining
    focus("recipient-search")
  action recipientKey(k: string) writes recipient, recipientQuery, recipientSelection, recipientRemainder, showContacts
    if k == "Backspace" and recipientQuery == ""
      if recipientSelection == ""
        recipientSelection = contacts.last
        recipientRemainder = contacts.withoutLast
      else
        recipient = recipientRemainder
        recipientSelection = ""
      showContacts = false
    if k == "Escape"
      recipientSelection = ""
    if k == "Enter" and contacts.resolved != ""
      recipient = contacts.resolved
      recipientQuery = ""
      recipientSelection = ""
      showContacts = false
      focus("new-composer")
  action clearRecipientSelection writes recipientSelection, recipient, recipientQuery, showContacts
    recipientSelection = ""
    if contacts.resolved != ""
      recipient = contacts.resolved
      recipientQuery = ""
      showContacts = false
  action browseContacts writes showContacts, recipientSelection
    recipientSelection = ""
    showContacts = not showContacts
    focus("recipient-search")
  action writeNew(value) writes newDraft
    newDraft = value
  action sendNewMessage writes change, nav, draftText, draftThread, replyRoot, replyThread, newDraft, timestampOffset
    timestampOffset = 0
    if contacts.canSend
      if chatThread != "" and chatThread != contacts.target and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
        send change = saveDraft(chatThread, draft, replying)
      send change = sendMessage(contacts.target, newDraft, "", ticks, now())
      nav = open(nav, path("thread", contacts.target))
      draftThread = contacts.target
      draftText = ""
      newDraft = ""
      replyThread = contacts.target
      replyRoot = ""
      focus("composer")

  // Fixture time is explicit and follows the same seekable clock on every host.
  action tick writes ticks, change
    if pendingReplies
      ticks = ticks + 1
      send change = advanceReplies(ticks + 1, chatThread, now())
  task replies mount
    every(300, tick)

  action synchronize writes change
    send change = syncMessages(now())
  task synchronization mount
    every(3000, synchronize)

  action followLink(location: string) writes nav, change, draftThread, replyThread, selected, selecting, selection, selectingText, selectedPicker, composerEditing, detailsEditing, attachments, timestampOffset, swipedThread
    if chatThread != "" and (draftThread == chatThread or replyThread == chatThread or savedComposer.thread == chatThread)
      send change = saveDraft(chatThread, draft, replying)
    draftThread = ""
    replyThread = ""
    selected = ""
    selecting = false
    selection = ""
    selectingText = ""
    selectedPicker = false
    composerEditing = false
    detailsEditing = false
    attachments = false
    timestampOffset = 0
    swipedThread = ""
    // Messages has one active conversation. Opening its ancestry also keeps the
    // swipe underlay correct instead of rendering every retained thread as chat.
    nav = open(nav, location)

  view
    main testId="messages" navigationKey=`${top(nav).id}` navigationBack="back" navigate=followLink viewport-fit="cover" interactive-widget="resizes-content" width="100%" height="100%" box-sizing="border-box" display="flex" flex-direction="column" overflow="hidden" background-color="light-dark(#ffffff, #000000)" color="light-dark(#000000, #ffffff)" font-family="system-ui"
      each e in stack(nav) key=e.id
        when e.name == "inbox"
          column navigationKey=`${e.id}` testId="inbox-screen" position="absolute" top=0 right=0 bottom=0 left=0 box-sizing="border-box" background-color="light-dark(#ffffff, #000000)" padding-top="env(safe-area-inset-top)" padding-left="env(safe-area-inset-left)" padding-right="env(safe-area-inset-right)"
            when inboxMode == "messages"
              column flex=1 min-height=0
                row testId="inbox-title-bar" position="absolute" top=0 left=0 right=0 z-index=1 padding-left=20 padding-right=20 height=44 align-items="center" justify-content="space-between" backgroundMaterial="ultra-thin" opacity=inboxTitleOpacity
                  text "Messages" testId="inbox-title-compact" font-size=17 font-weight=600 flex=1 text-align="center"
                scroll scroll=inboxListScrolled testId="conversation-list" flex=1 min-height=0
                  column
                    column testId="inbox-title-area" padding-top=57 padding-bottom=8 padding-left=16 padding-right=16
                      text "Messages" testId="inbox-title-large" font-size=34 font-weight=700 line-height="41px" opacity=(1 - inboxTitleOpacity)
                    each person in inbox.people key=person.id
                      scroll swipeContent=`conversation-${person.id}` swipeLeading=`read-thread-${person.id}` swipeTrailing=`delete-thread-${person.id} mute-${person.id}` scroll=inboxScrolled(person.id) testId=`thread-swipe-${person.id}` width="100%" height=86.6667 overflow-x="scroll" overflow-y="hidden" scrollbar-width="none" scroll-snap-type="x mandatory" scrollLeft=(swipedThread == person.id ? swipeOffset : 70)
                        row width="100%" height=86.6667
                          row testId=`thread-read-action-${person.id}` width=70 height=86.6667 flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=10 padding-right=10 align-items="center"
                            button press=readThread(person.id, not person.unread) id=`read-thread-${person.id}` testId=`read-thread-${person.id}` aria-label=(person.unread ? "Mark as Read" : "Mark as Unread") width=50 height=50 border-radius=25 background-color="#0088ff" display="flex" align-items="center" justify-content="center" flex-shrink=0
                              box width=24 height=22
                                box width=24 height=22 background-color="#ffffff" clip-path="path('M 12 2 C 5.5 2 0 5.8 0 11 C 0 13.4 1.3 15.6 3.3 17.2 L 1.8 21 L 7.3 19.4 C 8.7 19.8 10.3 20 12 20 C 18.6 20 24 16 24 11 C 24 5.8 18.6 2 12 2 Z')"
                                when not person.unread
                                  box position="absolute" right=-1 top=0 width=9 height=9 border-radius=5 background-color="#0088ff" display="flex" align-items="center" justify-content="center"
                                    box width=4 height=4 border-radius=3 border-style="solid" border-width=1.5 border-color="#ffffff"
                          button background-color=(swipedThread == person.id ? "light-dark(#e5e5ea, #2c2c2e)" : "light-dark(#ffffff, #000000)") border-radius=(swipedThread == person.id ? 28 : 0) press=open(person.id, person.draft, person.reply) id=`conversation-${person.id}` testId=`conversation-${person.id}` aria-label=`${person.name}, ${person.preview}` display="flex" flex-direction="row" align-items="center" width="100%" flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=11 padding-right=16 height=86.6667 gap=8
                            box testId=`unread-dot-${person.id}` width=7 height=7 border-radius=4 background-color=(person.unread ? "light-dark(#007aff, #0a84ff)" : "#00000000") flex-shrink=0
                            column width=45 height=45 border-radius=22.5 background-color=person.color justify-content="center" align-items="center" flex-shrink=0
                              when person.initials != ""
                                text person.initials font-size=20 color="#ffffff" font-weight=500
                              else
                                box width=32 height=36 scale=0.65 clip-path=personPath background-color="#ffffff"
                            column flex=1 min-width=0 height=86.6667 box-sizing="border-box" padding-top=13 padding-bottom=10 margin-left=4 border-bottom-style="solid" border-bottom-width=0.6667 border-color=(swipedThread == person.id ? "#00000000" : "light-dark(#d9d9dc, #38383a)") gap=0
                              row justify-content="space-between" gap=8 align-items="center" height=20.3333 flex-shrink=0
                                text person.name testId=`conversation-name-${person.id}` line-height="20.3333px" font-size=17 font-weight=600 flex=1 min-width=0 line-clamp=1
                                when person.muted
                                  box testId=`muted-${person.id}` width=12 height=14 flex-shrink=0
                                    box width=24 height=28 scale=0.5 position="absolute" left=-6 top=-7 clip-path=bellPath background-color="#8e8e93"
                                    box position="absolute" left=5 top=-1 width=1.5 height=16 rotate=-45 background-color="#8e8e93"
                                text person.time font-size=14 color="#8e8e93"
                                text "›" font-size=21 color="light-dark(#c7c7cc, #48484a)"
                              text (person.draft != "" ? `Draft: ${person.draft}` : person.preview) testId=`conversation-preview-${person.id}` font-size=15 color="#8e8e93" line-clamp=2 line-height="20.3333px" text-align="left" flex-shrink=0
                          row testId=`thread-actions-${person.id}` width=130 height=86.6667 flex-shrink=0 scroll-snap-align="start" box-sizing="border-box" padding-left=10 padding-right=10 gap=10 align-items="center"
                            button press=muteThread(person.id) id=`mute-${person.id}` testId=`mute-${person.id}` aria-label=(person.muted ? "Show Alerts" : "Hide Alerts") width=50 height=50 border-radius=25 background-color="light-dark(#6155f5, #6d7cff)" display="flex" align-items="center" justify-content="center" flex-shrink=0
                              box width=24 height=28 scale=0.75
                                box width=24 height=28 clip-path=bellPath background-color="#ffffff"
                                when not person.muted
                                  box position="absolute" left=10 top=-3 width=5 height=34 rotate=-45 background-color="light-dark(#6155f5, #6d7cff)"
                                  box position="absolute" left=11.5 top=-3 width=2 height=34 rotate=-45 background-color="#ffffff"
                            button destructive=true press=deleteThread(person.id) id=`delete-thread-${person.id}` testId=`delete-thread-${person.id}` aria-label=`Delete conversation with ${person.name}` width=50 height=50 border-radius=25 background-color="light-dark(#ff383c, #ff4245)" display="flex" align-items="center" justify-content="center" flex-shrink=0
                              box width=24 height=28 scale=0.75 clip-path=trashPath background-color="#ffffff"
                    when length(inbox.people) == 0
                      text "No Results" text-align="center" padding=40 font-size=20 font-weight=600 color="#8e8e93"
                    text syncStatus testId="sync-status" text-align="center" padding=16 font-size=12 color="#8e8e93"
                row margin-left=28 margin-right=16 margin-bottom=16 gap=8 align-items="center" flex-shrink=0
                  row testId="search-bar" padding-left=18 padding-right=14 height=48 flex=1 min-width=0 border-radius=24 backgroundMaterial="glass" align-items="center" gap=12 flex-shrink=0
                    image "symbol:search" font-size=20 font-weight=400 flex-shrink=0 tint-color="light-dark(#000000, #ffffff)"
                    input id="search" testId="search" value=query change=search placeholder="Search" aria-label="Search conversations" color="light-dark(#000000, #ffffff)" font-size=17 flex=1 min-width=0 height=44 border-width=0
                    button disabled=true testId="search-dictation" aria-label="Dictate search" width=28 height=40 display="flex" align-items="center" justify-content="center" flex-shrink=0
                      image "symbol:microphone" font-size=17 font-weight=400 tint-color="light-dark(#000000, #ffffff)"
                  button press=newMessage testId="new-message" aria-label="New message" width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" flex-shrink=0
                    image "symbol:compose" testId="compose-symbol" font-size=22 font-weight=400 tint-color="light-dark(#000000, #ffffff)"
                box height="calc(env(safe-area-inset-bottom) - 22px)" min-height=0 flex-shrink=0
            when inboxMode == "deleted"
              column testId="recently-deleted-screen" flex=1 min-height=0
                row height=54 align-items="center" justify-content="center" flex-shrink=0
                  text "Recently Deleted" font-size=17 font-weight=600
                scroll testId="deleted-conversations" flex=1 min-height=0
                  column
                    text "Conversations show the days remaining before deletion. After that time, messages will be permanently deleted. This may take up to 40 days." font-size=13 line-height="18px" color="light-dark(#8e8e93, #98989d)" text-align="center" padding-top=24 padding-bottom=20 padding-left=24 padding-right=24
                    each person in deletedInbox.people key=person.id
                      button press=chooseDeleted(person.selection) testId=`deleted-${person.id}` aria-label=`${person.name}, ${person.count} messages, ${person.days} days remaining` aria-checked=person.chosen height=86.6667 width="100%" box-sizing="border-box" display="flex" align-items="center" padding-left=16 padding-right=16 gap=16 background-color=(person.chosen ? "light-dark(#d1d1d6, #3a3a3c)" : "#00000000")
                        column width=22 height=22 box-sizing="border-box" border-radius=11 border-style="solid" border-width=(person.chosen ? 0 : 1.5) border-color="light-dark(#c7c7cc, #636366)" background-color=(person.chosen ? "#0088ff" : "#00000000") align-items="center" justify-content="center" flex-shrink=0
                          when person.chosen
                            box width=12 height=12 clip-path="path('M 1 6 L 4 9 L 11 1 L 12 2 L 4 12 L 0 7 Z')" background-color="#ffffff"
                        column width=44 height=44 border-radius=22 background-color=person.color align-items="center" justify-content="center" flex-shrink=0
                          text person.initials font-size=18 font-weight=500 color="#ffffff"
                        column flex=1 min-width=0 align-self="stretch" justify-content="center" border-bottom-style="solid" border-bottom-width=(person.chosen ? 0 : 0.5) border-color="light-dark(#d9d9dc, #38383a)"
                          row align-items="baseline" gap=8
                            text person.name font-size=17 font-weight=600 line-clamp=1 flex=1 min-width=0
                            text `${person.days} Days` font-size=15 color="light-dark(#8e8e93, #98989d)" flex-shrink=0
                          text (person.count == 1 ? "1 Message" : `${person.count} Messages`) font-size=15 color="light-dark(#8e8e93, #98989d)" margin-top=2
                row height=54 flex-shrink=0 padding-left=28 padding-right=28 align-items="center" justify-content="space-between"
                  button press=prepareRecovery popovertarget="recover-confirmation" disabled=(deletedInbox.count == 0) testId="recover-deleted" aria-label=(deletedSelection == "" ? "Recover All" : "Recover") height=48 padding-left=16 padding-right=16 border-radius=24 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" color=(deletedInbox.count == 0 ? "light-dark(#b4b4b7, #636366)" : "light-dark(#000000, #ffffff)")
                    text (deletedSelection == "" ? "Recover All" : "Recover") font-size=17
                  button press=prepareRecovery popovertarget="purge-confirmation" disabled=(deletedInbox.count == 0) testId="purge-deleted" aria-label=(deletedSelection == "" ? "Delete All" : "Delete") width=48 height=48 border-radius=24 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
                    box width=24 height=28 clip-path=trashPath background-color=(deletedInbox.count == 0 ? "light-dark(#b4b4b7, #636366)" : "light-dark(#000000, #ffffff)")
                box height="calc(env(safe-area-inset-bottom) - 6px)" min-height=0 flex-shrink=0
            button popovertarget="inbox-filters" testId="inbox-filters-button" aria-label="Filter messages" position="absolute" top="env(safe-area-inset-top)" right=16 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" z-index=2
              column width=22 gap=4 align-items="center"
                box width=22 height=1.5 border-radius=1 background-color="light-dark(#000000, #ffffff)"
                box width=16 height=1.5 border-radius=1 background-color="light-dark(#000000, #ffffff)"
                box width=10 height=1.5 border-radius=1 background-color="light-dark(#000000, #ffffff)"
            column id="inbox-filters" popover="auto" position="absolute" role="menu" aria-label="Filter messages" width=250 padding=8 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              button press=filterInbox("messages") popovertarget="inbox-filters" popovertargetaction="hide" role="menuitemradio" aria-checked=(inboxMode == "messages") testId="filter-messages" height=44 padding-left=16 padding-right=16
                text "Messages" font-size=17
              button press=filterInbox("deleted") popovertarget="inbox-filters" popovertargetaction="hide" role="menuitemradio" aria-checked=(inboxMode == "deleted") testId="filter-deleted" height=44 padding-left=16 padding-right=16
                text "Recently Deleted" font-size=17
            column id="recover-confirmation" popover="auto" position="absolute" role="alertdialog" aria-label="Recover messages" width=240 box-sizing="border-box" padding=16 gap=16 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              text "These messages will be recovered." font-size=17
              button press=recoverDeleted popovertarget="recover-confirmation" popovertargetaction="hide" testId="confirm-recover" color="light-dark(#007aff, #0a84ff)" background-color="#0088ff" height=48 border-radius=24
                text (recoveryCount == 1 ? "Recover Message" : `Recover ${recoveryCount} Messages`) font-size=17 font-weight=600 color="#ffffff"
              button popovertarget="recover-confirmation" popovertargetaction="hide" testId="cancel-recover" height=44
                text "Cancel" font-size=17
            column id="purge-confirmation" popover="auto" position="absolute" role="alertdialog" aria-label="Permanently delete messages" width=240 box-sizing="border-box" padding=16 gap=16 border-width=0 border-radius=28 background-color="light-dark(#f2f2f7, #2c2c2e)"
              text "These messages will be permanently deleted. This action cannot be undone." font-size=17
              button destructive=true press=permanentlyDelete popovertarget="purge-confirmation" popovertargetaction="hide" testId="confirm-purge" color="light-dark(#ff383c, #ff4245)" height=48 border-radius=24
                text (recoveryCount == 1 ? "Delete Message" : `Delete ${recoveryCount} Messages`) font-size=17 font-weight=600
              button popovertarget="purge-confirmation" popovertargetaction="hide" testId="cancel-purge" height=44
                text "Cancel" font-size=17
        when e.name == "thread"
          column navigationKey=`${e.id}` testId="conversation-screen" position="absolute" top=0 right=0 bottom=0 left=0 box-sizing="border-box" background-color="light-dark(#ffffff, #000000)" padding-top="env(safe-area-inset-top)" padding-left="env(safe-area-inset-left)" padding-right="env(safe-area-inset-right)"
            row testId="conversation-header" height=95.333333 flex-shrink=0 align-items="flex-start" justify-content="center" padding-left=16 padding-right=16
              button press=back disabled=composing id="back" testId="back" aria-label="Back to Messages" position="absolute" left=16 top=0 width=44 height=44 border-radius=22 backgroundMaterial="glass" display=(replying == "" and not selecting ? "flex" : "none") align-items="center" justify-content="center"
                image "symbol:back" font-size=20 font-weight=600 tint-color="light-dark(#000000, #ffffff)"
              when replying != "" and not selecting
                button press=cancelReply testId="close-reply-thread" aria-label="Close replies" position="absolute" right=16 top=0 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center" z-index=2
