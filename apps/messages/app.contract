                    row position="absolute" top="env(safe-area-inset-top)" left=12 right=12 justify-content="center"
                      row testId="reaction-participants" width=message.reactionPanelWidth max-width="100%" height=122 border-radius=32 backgroundMaterial="glass" justify-content="center" align-items="center"
                        scroll width="100%" height="100%" display="flex" flex-direction="row" justify-content="center" align-items="center" overflow-x="scroll" overflow-y="hidden" scrollbar-width="none"
                          each group in message.reactionGroups key=group.value
                            column width=98 height=104 flex-shrink=0 align-items="center"
                              column width=50 height=50 border-radius=25 background-color="light-dark(#ffffff, #3a3a3c)" align-items="center" justify-content="center"
                                text (group.value == "❤️" ? "🩷" : (group.value == "haha" ? "HA\nHA" : group.value)) font-size=27 color="#00baff" font-weight=800 text-align="center"
                                box position="absolute" left=19 top=45 width=12 height=12 border-radius=6 background-color="light-dark(#ffffff, #3a3a3c)"
                                box position="absolute" left=22.5 top=60 width=5 height=5 border-radius=2.5 background-color="light-dark(#ffffff, #3a3a3c)"
                              row width=group.width height=32 margin-top=20
                                each person in group.people key=person.id
                                  column testId=`reaction-person-${person.id}` aria-label=person.name position="absolute" left=person.offset top=0 width=32 height=32 box-sizing="border-box" border-radius=16 border-width=1 border-color="light-dark(#ffffff, #000000)" background-color=person.color align-items="center" justify-content="center"
                                    text person.initials font-size=14 color="#ffffff" font-weight=600
                  column testId="tapback-region" press=dismiss retainFocus=true position="absolute" left=0 right=0 bottom=0 top=(message.reactionCount > 0 ? (selectedPicker ? "calc(env(safe-area-inset-top) + 122px)" : "calc(env(safe-area-inset-top) + 146px)") : "0%")
                    column id="emoji-return" key=menuKey testId="tapback-menu" position="absolute" left=11 right=16 top=0 gap=6
                      when selectedPicker
                        box testId="emoji-picker-controls" width="100%" height=88
                      else
                        column testId="tapback-surface" backgroundMaterial="glass" width="100%" height=64 border-radius=32 flex-shrink=0
                          scroll testId="tapback-choices" width="100%" height=64 overflow-x="scroll" overflow-y="hidden" border-radius=32 flex-shrink=0
                            row height=64 padding-left=8 padding-right=8 align-items="center" gap=1
                              each choice in chat.reactions key=choice.id
                                button press=reaction(choice.value) testId=`tapback-${choice.id}` aria-label=choice.label aria-checked=(selectedReaction == choice.value) width=48 height=48 border-radius=24 background-color=(selectedReaction == choice.value ? "light-dark(#dadadd, #555559)" : "#00000000") display="flex" align-items="center" justify-content="center" flex-shrink=0
                                  when choice.value == "haha"
                                    box testId="laugh-symbol" width=26 height=28 clip-path=laughPath background-color="#00baff"
                                  else
                                    text (choice.id == "heart" ? "🩷" : choice.value) font-size=25
                      column width="100%" box-sizing="border-box" padding-left=(selectedGroup ? 49 : 5) align-items=(selectedOutgoing ? "flex-end" : "flex-start")
                        row width="100%" justify-content=(selectedOutgoing ? "flex-end" : "flex-start")
                          when selectedOutgoing
                            box width=50 height=0 flex-shrink=0 z-index=2
                              when selectedPicker
                                column press=showEmojiPicker position="absolute" left=22 top=-80 width=74 height=74 border-radius=37 backgroundMaterial="glass" align-items="center" justify-content="center"
                                  input id="emoji-input" testId="emoji-input" emojiPicker=true change=reaction value="" aria-label="Choose an emoji" position="absolute" top=0 left=0 width=74 height=74 font-size=1 color="#00000000" border-width=0
                                  box width=24 height=24 clip-path=emojiFacePath scale=1.666667 background-color="light-dark(#99999e, #b4b4b9)"
                                button press=closeEmojiPicker retainFocus=true testId="close-emoji-picker" aria-label="Close emoji picker" position="absolute" left=80 top=-84 width=26 height=26 border-radius=13 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
                                  box width=14 height=14
                                    box position="absolute" left=6 top=0 width=1.5 height=14 rotate=45 background-color="light-dark(#000000, #ffffff)"
                                    box position="absolute" left=6 top=0 width=1.5 height=14 rotate=-45 background-color="light-dark(#000000, #ffffff)"
                              else
                                button press=showEmojiPicker retainFocus=true testId="open-emoji-picker" aria-label="Choose another emoji" position="absolute" left=0 top=-12 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
                                  box width=24 height=24 clip-path=emojiFacePath background-color="light-dark(#99999e, #b4b4b9)"
                          column contextTarget=(replying == "" ? `bubble-${selected}` : `reply-bubble-${selected}`) contextMagnify=selectedActions testId="tapback-preview" max-width="75%" min-width=48 box-sizing="border-box" display="flex" justify-content="center" align-items="center" padding-left=14 padding-right=14 padding-top=10 padding-bottom=10 border-radius=20 background-color=(selectedOutgoing ? "light-dark(#007aff, #0a84ff)" : "light-dark(#ffffff, #38383a)")
                            when selectedTail
                              when selectedOutgoing
                                box position="absolute" right=5 bottom=-7 width=22 height=24 clip-path=outgoingTailPath background-color="light-dark(#007aff, #0a84ff)"
                              else
                                box position="absolute" left=5 bottom=-7 width=22 height=24 clip-path=incomingTailPath background-color="light-dark(#ffffff, #38383a)"
                            text selectedBody font-size=17 line-height=20 color=(selectedOutgoing ? "#ffffff" : "light-dark(#000000, #ffffff)") text-align="left" line-clamp=8
                          when not selectedOutgoing
                            box width=50 height=0 flex-shrink=0 z-index=2
                              when selectedPicker
                                column press=showEmojiPicker position="absolute" left=-46 top=-80 width=74 height=74 border-radius=37 backgroundMaterial="glass" align-items="center" justify-content="center"
                                  input id="emoji-input" testId="emoji-input" emojiPicker=true change=reaction value="" aria-label="Choose an emoji" position="absolute" top=0 left=0 width=74 height=74 font-size=1 color="#00000000" border-width=0
                                  box width=24 height=24 clip-path=emojiFacePath scale=1.666667 background-color="light-dark(#99999e, #b4b4b9)"
                                button press=closeEmojiPicker retainFocus=true testId="close-emoji-picker" aria-label="Close emoji picker" position="absolute" left=-56 top=-84 width=26 height=26 border-radius=13 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
                                  box width=14 height=14
                                    box position="absolute" left=6 top=0 width=1.5 height=14 rotate=45 background-color="light-dark(#000000, #ffffff)"
                                    box position="absolute" left=6 top=0 width=1.5 height=14 rotate=-45 background-color="light-dark(#000000, #ffffff)"
                              else
                                button press=showEmojiPicker retainFocus=true testId="open-emoji-picker" aria-label="Choose another emoji" position="absolute" left=6 top=-12 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
                                  box width=24 height=24 clip-path=emojiFacePath background-color="light-dark(#99999e, #b4b4b9)"
                        column testId="tapback-status" display=(selectedPicker and selectedActions ? "none" : "flex") min-height=(selectedMenuActions ? 20.333333 : 0) width="100%" align-items="flex-end"
                          each message in (replying == "" ? chat.messages : chat.replies) key=message.id
                            when message.id == selected and message.delivery != ""
                              text message.delivery testId="tapback-delivery" font-size=11 font-weight=600 color="#8e8e93" margin-top=6.333333 margin-right=20
                      when selectedMenuActions
                        column id="message-actions" testId="message-actions" backgroundMaterial="glass" align-self=(selectedOutgoing ? "flex-end" : "flex-start") margin-left=(selectedOutgoing ? 0 : 5) width=250 border-radius=32 padding-top=10 padding-bottom=10
                          button press=reply testId="reply" height=42 padding-left=24 padding-right=16 display="flex" align-items="center" gap=8
                            column width=32 height=32 align-items="center" justify-content="center"
                              text "↩︎" font-size=22 color="light-dark(#000000, #ffffff)"
                            text "Reply" font-size=17 color="light-dark(#000000, #ffffff)"
                          button press=copyMessage testId="copy-message" height=42 padding-left=24 padding-right=16 display="flex" align-items="center" gap=8
                            column width=32 height=32 align-items="center" justify-content="center"
                              box width=18 height=22
                                box position="absolute" left=5 top=1 width=11 height=15 border-width=1.5 border-color="light-dark(#000000, #ffffff)" border-radius=2
                                box position="absolute" left=1 top=6 width=11 height=15 border-width=1.5 border-color="light-dark(#000000, #ffffff)" border-radius=2
                            text "Copy" font-size=17 color="light-dark(#000000, #ffffff)"
                          button press=more testId="more-message" height=42 padding-left=24 padding-right=16 display="flex" align-items="center" gap=8
                            column width=32 height=32 align-items="center" justify-content="center"
                              row width=18 height=18 box-sizing="border-box" border-width=1.5 border-radius=9 border-color="light-dark(#000000, #ffffff)" align-items="center" justify-content="center" gap=1.5
                                box width=2 height=2 border-radius=1 background-color="light-dark(#000000, #ffffff)"
                                box width=2 height=2 border-radius=1 background-color="light-dark(#000000, #ffffff)"
                                box width=2 height=2 border-radius=1 background-color="light-dark(#000000, #ffffff)"
                            text "More…" font-size=17 color="light-dark(#000000, #ffffff)"
      when details
        column navigationKey=`details:${thread}` testId="details-screen" position="absolute" top=0 right=0 bottom=0 left=0 box-sizing="border-box" background-color="light-dark(#ffffff, #000000)" padding-top="env(safe-area-inset-top)" padding-left="env(safe-area-inset-left)" padding-right="env(safe-area-inset-right)"
          scroll testId="details-scroll" touch-action="pan-y" flex=1 min-height=0
            column padding-left=16 padding-right=16 padding-bottom="calc(env(safe-area-inset-bottom) + 24px)" align-items="center"
              column testId="details-avatar" width=80 height=80 border-radius=40 background-color=chat.color align-items="center" justify-content="center"
                when chat.initials != ""
                  text chat.initials font-size=36 font-weight=600 color="#ffffff"
                else
                  box width=32 height=36 scale=1.1 clip-path=personPath background-color="#ffffff"
              text chat.name testId="details-name" width="100%" margin-top=4 font-size=28 line-height=34 font-weight=700 text-align="center" line-clamp=1
              row margin-top=16 gap=20 height=48
                button disabled=true aria-label="Call" width=48 height=48 border-radius=24 background-color="light-dark(#efeff0, #1c1c1e)" display="flex" align-items="center" justify-content="center"
                  box width=22 height=24 clip-path=callPath background-color="light-dark(#000000, #ffffff)"
                button disabled=true aria-label="Video call" width=48 height=48 border-radius=24 background-color="light-dark(#efeff0, #1c1c1e)" display="flex" align-items="center" justify-content="center"
                  box width=24 height=18 clip-path="path('M 3 1 L 14 1 Q 17 1 17 4 L 17 14 Q 17 17 14 17 L 3 17 Q 0 17 0 14 L 0 4 Q 0 1 3 1 Z M 18 6 L 22 3 Q 24 2 24 4 L 24 14 Q 24 16 22 15 L 18 12 Z')" background-color="#bababc"
                button disabled=true aria-label="Email" width=48 height=48 border-radius=24 background-color="light-dark(#efeff0, #1c1c1e)" display="flex" align-items="center" justify-content="center"
                  box width=24 height=18 clip-path="path('M 1 0 L 23 0 L 12 9 Z M 0 1 L 9 9 L 0 17 Z M 24 1 L 15 9 L 24 17 Z M 1 18 L 10 10 L 12 12 L 14 10 L 23 18 Z')" background-color="#bababc"
              column width="100%" margin-top=20 gap=20
                when chat.contactAddress != ""
                  row testId="details-address" height=70 border-radius=28 background-color="light-dark(#efeff0, #1c1c1e)" padding-left=16 padding-right=16 align-items="center"
                    column flex=1 min-width=0
                      row gap=5 align-items="center"
                        text chat.contactKind font-size=13 color="#8e8e93"
                        text "RECENT" font-size=9 font-weight=700 color="#ffffff" background-color="#8e8e93" border-radius=3 padding-left=3 padding-right=3
                      text chat.contactAddress font-size=17 line-clamp=1
                    when chat.contactKind == "phone"
                      box width=12 height=14
                        box position="absolute" left=-5 top=-5 width=22 height=24 scale=0.6 clip-path=callPath background-color="#8e8e93"
                when not chat.knownContact
                  column border-radius=28 background-color="light-dark(#efeff0, #1c1c1e)" padding-left=16 padding-right=16
                    button disabled=true aria-label="Create New Contact" height=51 display="flex" align-items="center"
                      text "Create New Contact" font-size=17 color="light-dark(#007aff, #0a84ff)"
                    box height=0.5 background-color="light-dark(#d9d9dc, #38383a)"
                    button disabled=true aria-label="Add to Existing Contact" height=51 display="flex" align-items="center"
                      text "Add to Existing Contact" font-size=17 color="light-dark(#007aff, #0a84ff)"
                button press=muteThread(thread) testId="details-hide-alerts" role="switch" aria-label="Hide Alerts" aria-checked=chat.muted height=52 border-radius=28 background-color="light-dark(#efeff0, #1c1c1e)" display="flex" align-items="center" justify-content="space-between" padding-left=16 padding-right=14
                  text "Hide Alerts" font-size=17
                  box width=64 height=28 border-radius=14 background-color=(chat.muted ? "#34c759" : "#bababc")
                    box testId="details-alerts-thumb" position="absolute" left=(chat.muted ? 26 : 2) top=2 width=36 height=24 border-radius=12 background-color="#ffffff"
                button disabled=true aria-label="Block Contact" height=52 border-radius=28 background-color="light-dark(#efeff0, #1c1c1e)" display="flex" align-items="center" padding-left=16 padding-right=16
                  text "Block Contact" font-size=17 color="#ff3b30"
          button press=closeDetails id="close-details" testId="close-details" aria-label="Back to conversation" position="absolute" left=16 top="env(safe-area-inset-top)" width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
            box width=18 height=24
              box position="absolute" left=7 top=2 width=3 height=14 border-radius=1.5 rotate=45 background-color="light-dark(#000000, #ffffff)"
              box position="absolute" left=7 top=10 width=3 height=14 border-radius=1.5 rotate=-45 background-color="light-dark(#000000, #ffffff)"

      when composing
        NewMessageSheet(contacts=contacts, recipientSelection=recipientSelection, recipientQuery=recipientQuery, newDraft=newDraft, showContacts=showContacts, personPath=personPath, editable=(thread != "" or contacts.target != ""), cancelNewMessage=cancelNewMessage, selectRecipient=selectRecipient, searchRecipient=searchRecipient, recipientKey=recipientKey, browseContacts=browseContacts, chooseRecipient=chooseRecipient, writeNew=writeNew, clearRecipientSelection=clearRecipientSelection, sendNewMessage=sendNewMessage)

component NewMessageSheet
  props
    contacts: Recipients
    recipientSelection: string
    recipientQuery: string
    newDraft: string
    showContacts: bool
    personPath: string
    editable: bool
    cancelNewMessage: action
    selectRecipient: action
    searchRecipient: action
    recipientKey: action
    browseContacts: action
    chooseRecipient: action
    writeNew: action
    clearRecipientSelection: action
    sendNewMessage: action
  view
    column navigationKey="compose" navigationPresentation="modal" closedby=(newDraft == "" ? "closerequest" : "none") testId="new-message-layer" position="absolute" top=0 left=0 right=0 bottom=0 z-index=10
      box position="absolute" top="calc(env(safe-area-inset-top) + 40px)" left=0 right=0 bottom=0 background-color="light-dark(#ffffff, #1c1c1e)"
      column testId="new-message-sheet" position="absolute" top="env(safe-area-inset-top)" left=0 right=0 bottom=0 border-radius=40 background-color="light-dark(#ffffff, #1c1c1e)" overflow="hidden"
        row retainFocus=true height=80 flex-shrink=0 align-items="center" justify-content="center"
          text "New Message" font-size=17 font-weight=600
          button press=cancelNewMessage id="cancel-new-message" testId="cancel-new-message" aria-label="Close new message" position="absolute" right=16 top=16 width=44 height=44 border-radius=22 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
            box width=18 height=18
              box position="absolute" left=8 top=-1 width=2 height=20 border-radius=1 rotate=45 background-color="light-dark(#000000, #ffffff)"
              box position="absolute" left=8 top=-1 width=2 height=20 border-radius=1 rotate=-45 background-color="light-dark(#000000, #ffffff)"
        row testId="recipient-field" margin-left=16 margin-right=16 min-height=48 border-radius=24 backgroundMaterial="glass" align-items="center" padding-left=14 padding-right=12 gap=6 flex-shrink=0
          text "To:" font-size=15 color="#8e8e93" flex-shrink=0
          row flex=1 min-width=0 flex-wrap="wrap" align-items="center" column-gap=4 padding-top=4 padding-bottom=4
            each person in contacts.selected key=person.id
              button press=selectRecipient(person.id, person.without) testId=`selected-recipient-${person.id}` aria-label=`${person.name}${recipientSelection == person.id ? ", selected" : ""}` background-color=(recipientSelection == person.id ? "light-dark(#007aff, #0a84ff)" : "#00000000") border-radius=4 max-width="100%" height=32 display="flex" align-items="center"
                text person.name font-size=17 color=(recipientSelection == person.id ? "#ffffff" : "light-dark(#007aff, #0a84ff)") line-clamp=1
            input id="recipient-search" testId="recipient-search" autocapitalize="none" autocorrect="off" spellcheck="false" value=recipientQuery change=searchRecipient key=recipientKey aria-label="To" font-size=17 color="light-dark(#000000, #ffffff)" flex=1 min-width=36 height=40 border-width=0
          button press=browseContacts testId="choose-contact" aria-label="Add contact" width=28 height=28 border-radius=14 background-color="light-dark(#e5e5ea, #48484a)" display="flex" align-items="center" justify-content="center"
            box width=14 height=14
              box position="absolute" left=6 top=0 width=2 height=14 border-radius=1 background-color="light-dark(#000000, #ffffff)"
              box position="absolute" left=0 top=6 width=14 height=2 border-radius=1 background-color="light-dark(#000000, #ffffff)"
        scroll testId="recipient-results" flex=1 min-height=0 keyboardDismissMode="interactive" margin-top=8
          when recipientQuery != "" or showContacts
            column padding-left=28 padding-right=20
              each person in contacts.people key=person.id
                button press=chooseRecipient(person.id) testId=`recipient-${person.id}` aria-label=person.name height=64 display="flex" align-items="center" gap=12 border-bottom-width=0.5 border-color="light-dark(#d9d9dc, #38383a)"
                  column width=36 height=36 border-radius=18 background-color=person.color align-items="center" justify-content="center" flex-shrink=0
                    when person.initials != ""
                      text person.initials font-size=14 color="#ffffff"
                    else
                      box width=32 height=36 scale=0.55 clip-path=personPath background-color="#ffffff"
                  text person.name font-size=17 line-clamp=1 color="light-dark(#007aff, #0a84ff)"
              when length(contacts.people) == 0
                text "No Results" font-size=17 color="#8e8e93" text-align="center" padding=24
        column padding-left=16 padding-right=16 padding-top=12 padding-bottom=16 flex-shrink=0
          row gap=12 align-items="flex-end"
            button disabled=true aria-label="Add attachment" width=40 height=40 border-radius=20 backgroundMaterial="glass" display="flex" align-items="center" justify-content="center"
              box width=18 height=18
                box position="absolute" left=8 top=0 width=2 height=18 border-radius=1 background-color="#b4b4b7"
                box position="absolute" left=0 top=8 width=18 height=2 border-radius=1 background-color="#b4b4b7"
            row testId="new-composer-surface" flex=1 min-width=0 min-height=40 box-sizing="border-box" backgroundMaterial="glass" border-radius=20 align-items="flex-end" padding-left=16 padding-right=6 padding-top=6 padding-bottom=6 gap=4
              textarea id="new-composer" testId="new-composer" disabled=(not editable) value=newDraft change=writeNew focus=clearRecipientSelection placeholder=(contacts.target == "" ? "" : "iMessage") aria-label="New message" color="light-dark(#000000, #ffffff)" font-size=17 line-height=22 flex=1 min-width=0 field-sizing="content" min-height=28 max-height=138 padding-top=3 padding-bottom=3 box-sizing="border-box" border-width=0
              button press=sendNewMessage disabled=(not contacts.canSend) testId="send-new-message" aria-label="Send message" width=28 height=28 border-radius=14 background-color=(newDraft == "" ? "#00000000" : (contacts.canSend ? "light-dark(#007aff, #0a84ff)" : "light-dark(#e9e9eb, #3a3a3c)")) display="flex" align-items="center" justify-content="center"
                when newDraft != ""
                  box width=16 height=18 background-color=(contacts.canSend ? "#ffffff" : "light-dark(#b4b4b7, #8e8e93)") clip-path="path('M 8 0 Q 8.5 0 9 0.5 L 15.5 7 Q 16.5 8 15.5 9 Q 14.5 10 13.5 9 L 9.5 5 L 9.5 16.5 Q 9.5 18 8 18 Q 6.5 18 6.5 16.5 L 6.5 5 L 2.5 9 Q 1.5 10 0.5 9 Q -0.5 8 0.5 7 L 7 0.5 Q 7.5 0 8 0 Z')"
                else
                  box width=14 height=20 clip-path="path('M 7 0 C 4.8 0 3 1.8 3 4 L 3 10 C 3 12.2 4.8 14 7 14 C 9.2 14 11 12.2 11 10 L 11 4 C 11 1.8 9.2 0 7 0 Z M 7 1.5 C 8.4 1.5 9.5 2.6 9.5 4 L 9.5 10 C 9.5 11.4 8.4 12.5 7 12.5 C 5.6 12.5 4.5 11.4 4.5 10 L 4.5 4 C 4.5 2.6 5.6 1.5 7 1.5 Z M 0 8 L 1.5 8 L 1.5 10 C 1.5 13 4 15.5 7 15.5 C 10 15.5 12.5 13 12.5 10 L 12.5 8 L 14 8 L 14 10 C 14 13.6 11.3 16.6 7.75 17 L 7.75 18.5 L 11 18.5 L 11 20 L 3 20 L 3 18.5 L 6.25 18.5 L 6.25 17 C 2.7 16.6 0 13.6 0 10 Z')" background-color="light-dark(#b4b4b7, #8e8e93)"
        box height="calc(env(safe-area-inset-bottom) - 22px)" min-height=0 flex-shrink=0

// A zero-width side slot preserves the balloon's percentage width and gesture target.
component ReactionBadges
  props
    message: Message
    prefix: string
    hidden: bool
    open: action
    laughPath: string
  view
    box width=0 height=0 flex-shrink=0 z-index=3 opacity=(hidden ? 0 : 1)
      each entry in message.reactionEntries key=entry.id
        button press=open retainFocus=true testId=(entry.edge ? `${prefix}-${message.id}` : `${prefix}-${message.id}-${entry.id}`) aria-label=`${entry.name}: ${entry.value} reaction` position="absolute" left=(message.outgoing ? -15 + entry.offset : -21 - entry.offset) top=-28 width=36 height=36 box-sizing="border-box" border-radius=18 border-width=1 border-color="light-dark(#ffffff, #000000)" background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)") display="flex" align-items="center" justify-content="center" z-index=(100 - entry.offset)
          when entry.edge
            box position="absolute" left=(message.outgoing ? 2 : 23) top=27 width=11 height=11 border-radius=5.5 background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)")
            box position="absolute" left=(message.outgoing ? -2 : 33) top=38 width=5 height=5 border-radius=2.5 background-color=(entry.own ? "#008cff" : "light-dark(#e9e9eb, #262629)")
          when entry.value == "haha"
            box width=26 height=28 scale=0.65 clip-path=laughPath background-color=(entry.own ? "#ffffff" : "#00baff")
          else
            text (entry.value == "❤️" ? "🩷" : entry.value) font-size=19
