                                  else
                                    box width=19 height=19 border-radius=9.5 background-color="light-dark(#ffffff, #000000)"
                            column position="absolute" left="100%" margin-left=8 top=0 bottom=0 width=50 opacity=(timestampDistance > 0 ? 1 : 0) justify-content="center"
                              text message.time testId=`timestamp-${message.id}` font-size=11 line-height="14px" color="#8e8e93" text-align="right"
                          when message.delivery != ""
                            text message.delivery testId=`delivery-status-${message.id}` opacity=(selecting or (selected == message.id and replying == "") ? 0 : 1) font-size=11 font-weight=600 color="#8e8e93" margin-top=6.333333 margin-right=20
                          when message.replyCount > 0
                            button press=openReplies(message.replyRoot) testId=`replies-${message.id}` margin-top=5 margin-left=6 margin-right=6 padding=3
                              text (message.replyCount == 1 ? "1 Reply" : `${message.replyCount} Replies`) font-size=12 color="light-dark(#007aff, #0a84ff)"
                          when selecting
                            button press=chooseMessage(message.selection) retainFocus=true testId=`select-message-${message.id}` aria-label=`Select message: ${message.body}` aria-checked=message.chosen position="absolute" top=0 right=0 bottom=0 left=0 width="100%" height="100%" z-index=3
                      when chat.typingName != ""
                        row testId="typing-indicator" left=timestampCompensation aria-label=`${chat.typingName} is typing` align-items="flex-end" gap=6 margin-top=4 margin-bottom=6 height=40 flex-shrink=0
                          when chat.typingAvatar != ""
                            column width=28 height=28 border-radius=14 background-color="#76a998" align-items="center" justify-content="center"
                              text chat.typingAvatar font-size=11 color="#ffffff" font-weight=600
                          row width=68 height=36 border-radius=18 background-color="light-dark(#e9e9eb, #262629)" align-items="center" justify-content="center" gap=5
                            box position="absolute" left=0 bottom=-2 width=12 height=12 border-radius=6 background-color="light-dark(#e9e9eb, #262629)"
                            box position="absolute" left=-4 bottom=-6 width=6 height=6 border-radius=3 background-color="light-dark(#e9e9eb, #262629)"
                            box testId="typing-dot-0" width=9 height=9 border-radius=4.5 background-color="light-dark(#8e8e93, #98989d)" opacity=(typingPhase == 0 ? 1 : 0.45) scale=(typingPhase == 0 ? 1 : 0.8) transition="opacity 300ms ease-in-out, scale 300ms ease-in-out"
                            box testId="typing-dot-1" width=9 height=9 border-radius=4.5 background-color="light-dark(#8e8e93, #98989d)" opacity=(typingPhase == 1 ? 1 : 0.45) scale=(typingPhase == 1 ? 1 : 0.8) transition="opacity 300ms ease-in-out, scale 300ms ease-in-out"
                            box testId="typing-dot-2" width=9 height=9 border-radius=4.5 background-color="light-dark(#8e8e93, #98989d)" opacity=(typingPhase == 2 ? 1 : 0.45) scale=(typingPhase == 2 ? 1 : 0.8) transition="opacity 300ms ease-in-out, scale 300ms ease-in-out"
                    box width="50%"
              when replying != "" and not selecting
                column testId="reply-thread" z-index=2 position="absolute" top=0 right=0 bottom=0 left=0 backgroundMaterial="ultra-thin" justify-content="center"
                  button press=cancelReply testId="dismiss-reply-thread" aria-label="Return to conversation" position="absolute" top=0 right=0 bottom=0 left=0 width="100%" height="100%"
                  scroll testId="reply-messages" max-height="100%" width="100%" scrollFollowEnd=true scrollTop=(1000000 + chat.scrollRevision) keyboardDismissMode="interactive" overflow-x="hidden"
                    column padding=16 gap=12
                      each message in chat.replies key=message.id
                        column
                          when message.timeLabel != ""
                            text message.timeLabel testId=`reply-time-label-${message.id}` font-size=11 color="#8e8e93" align-self="center" margin-bottom=8
                          column align-items=(message.outgoing ? "flex-end" : "flex-start") padding-left=(message.senderName != "" ? 44 : 0) box-sizing="border-box"
                            when message.showSender
                              text message.senderName testId=`reply-sender-${message.id}` font-size=11 color="#8e8e93" margin-left=12 margin-bottom=4
                            when message.senderName != "" and message.tail
