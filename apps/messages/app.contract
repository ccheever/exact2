                              MessageBody(body=message.body, outgoing=message.outgoing, selecting=(selectingText == message.id and replying == ""), finish=finishTextSelection)
                            when not message.outgoing
                              ReactionBadges(message=message, prefix="reaction", hidden=(selected == message.id and replying == ""), open=select(message.id, message.body, message.outgoing, message.reaction, message.tail, message.replyRoot, message.senderName != "", false))
                            when selecting
