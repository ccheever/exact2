                            box testId="reply-typing-dot-1" width=9 height=9 border-radius=4.5 background-color="light-dark(#8e8e93, #98989d)" opacity=(typingPhase == 1 ? 1 : 0.45) scale=(typingPhase == 1 ? 1 : 0.8) transition="opacity 300ms ease-in-out, scale 300ms ease-in-out"
                            box testId="reply-typing-dot-2" width=9 height=9 border-radius=4.5 background-color="light-dark(#8e8e93, #98989d)" opacity=(typingPhase == 2 ? 1 : 0.45) scale=(typingPhase == 2 ? 1 : 0.8) transition="opacity 300ms ease-in-out, scale 300ms ease-in-out"
            when attachments and not selecting
