// Caltrain — the v1 app, in Contract, on the LLP 1004 boundary.
//
// No JavaScript anywhere: schedule data comes from the Rust data crate
// (apps/caltrain/data) through `resource` declarations; formatting comes from
// the stdlib roster; everything else is Contract. The first frame is
// compiled data — the build bakes every resource's boot value into the plan.

shape Location
  lat: number
  lon: number

shape Station
  id: string
  name: string
  zone: number
  distance: number

shape Departure
  id: string
  train: number
  service: string
  headsign: string
  at: number

component Caltrain
  state nowMs = 1787915400000
  state screen = "home"
  state stationId = none
  state query = ""
  state material = "glass"
  state deck = false
  state focus = none
  // The sky: its colour behind the status bar and the home indicator, or
  // none for the plain page (the "Sky off" button).
  state sky = some("#05081a")
  // The pointer over a station row, the search field's focus, the last key it
  // saw: the events beyond press and change (LLP 1005 §3), each shown.
  state hoverId = ""
  state hoverOn = false
  state searchFocused = false
  state lastKey = ""

  resource location = defaultLocation() as shape Location
  derive selectedId = match stationId { case some(id) => id, case none => "mv" }
  resource station = station(selectedId, location) as shape Station
  resource northBoard = board(selectedId, "north") as shape list<Departure>
  resource southBoard = board(selectedId, "south") as shape list<Departure>
  resource nearby = nearest(location, 3) as shape list<Station>
  resource allStations = stations(location) as shape list<Station>
  resource matches = search(query, location) as shape list<Station>

  action tick writes nowMs
    nowMs = nowMs + 1000
  action openStations writes screen
    screen = "stations"
  action goHome writes screen, query
    screen = "home"
    query = ""
  action selectStation(id) writes stationId, screen, query, searchFocused
    stationId = some(id)
    screen = "home"
    query = ""
    searchFocused = false
  action setQuery(value) writes query
    query = value
  action setScheme(scheme: string)
    setScheme(scheme)
  action setMaterial(m: string) writes material
    material = m
  action toggleDeck writes deck
    deck = not deck
  action focusDeparture(id) writes focus
    focus = some(id)
  derive skyOn = match sky { case some(c) => true, case none => false }
  derive canvasColor = match sky { case some(c) => c, case none => "#ffffff" }
  action hoverStation(id, over) writes hoverId, hoverOn
    hoverId = id
    hoverOn = over
  action focusSearch writes searchFocused
    searchFocused = true
  action blurSearch writes searchFocused
    searchFocused = false
  action searchKey(k) writes lastKey
    lastKey = k
  action toggleSky writes sky
    sky = match sky { case some(c) => none, case none => some("#05081a") }

  task ticker mount
    every(1000, tick)

  view
    // The sky is optional (the "Sky off" button): the same content inside
    // the aurora canvas — captured through its surface, the shader every
    // frame — or in a plain scroll, to see what each costs on a phone. The
    // root's background is what a phone paints behind the status bar and
    // the home indicator (the web's rule): the sky's dark, or white.
    main testId="caltrain-main" width="100%" height="100%" background-color=canvasColor
      when skyOn
        canvas surface=glass(material, selectedId) width="100%" height="100%" testId="sky"
          scroll width="100%" height="100%"
            Content(station=station, selectedId=selectedId, screen=screen, material=material, deck=deck, focus=focus, nowMs=nowMs, query=query, sky=skyOn, hoverId=hoverId, hoverOn=hoverOn, searchFocused=searchFocused, lastKey=lastKey, northBoard=northBoard, southBoard=southBoard, nearby=nearby, allStations=allStations, matches=matches, openStations=openStations, setScheme=setScheme, setMaterial=setMaterial, toggleDeck=toggleDeck, toggleSky=toggleSky, focusDeparture=focusDeparture, selectStation=selectStation, setQuery=setQuery, goHome=goHome, hoverStation=hoverStation, focusSearch=focusSearch, blurSearch=blurSearch, searchKey=searchKey)
      else
        scroll width="100%" height="100%"
          Content(station=station, selectedId=selectedId, screen=screen, material=material, deck=deck, focus=focus, nowMs=nowMs, query=query, sky=skyOn, hoverId=hoverId, hoverOn=hoverOn, searchFocused=searchFocused, lastKey=lastKey, northBoard=northBoard, southBoard=southBoard, nearby=nearby, allStations=allStations, matches=matches, openStations=openStations, setScheme=setScheme, setMaterial=setMaterial, toggleDeck=toggleDeck, toggleSky=toggleSky, focusDeparture=focusDeparture, selectStation=selectStation, setQuery=setQuery, goHome=goHome, hoverStation=hoverStation, focusSearch=focusSearch, blurSearch=blurSearch, searchKey=searchKey)

component Content
  props
    station: Station
    selectedId: string
    screen: string
    material: string
    deck: bool
    focus: option<string>
    nowMs: number
    query: string
    sky: bool
    hoverId: string
    hoverOn: bool
    searchFocused: bool
    lastKey: string
    northBoard: list<Departure>
    southBoard: list<Departure>
    nearby: list<Station>
    allStations: list<Station>
    matches: list<Station>
    openStations: action
    setScheme: action
    setMaterial: action
    toggleDeck: action
    toggleSky: action
    focusDeparture: action
    selectStation: action
    setQuery: action
    goHome: action
    hoverStation: action
    focusSearch: action
    blurSearch: action
    searchKey: action
  view
    column gap=16 padding=20 max-width=640 align-self="center" width="100%" box-sizing="border-box"
      header width="100%" background-color="#ffffffd9" border-radius=16 padding=14 box-sizing="border-box"
        row justify-content="space-between" align-items="center"
          column gap=2
            image "assets/caltrain.png" width=96 object-fit="contain" aria-label="A Caltrain train" testId="logo"
            text "Caltrain" font-size=13 font-weight=700 letter-spacing=1.2 color="#c0392b"
            text station.name font-size=24 font-weight=700 testId="station-name" aria-level=1
            text `${formatDistance(station.distance)} · ${formatWalk(station.distance)}` font-size=12 color="#666666"
          column gap=6 align-items="flex-end"
            button press=openStations aria-label="Change station" testId="change-station" padding=8 border-radius=8 background-color="#eeeeee"
              text "Change station" font-size=13 font-weight=600
            row gap=6
              button press=setScheme("light") aria-label="Light" testId="scheme-light"
                text "Light" font-size=12
              button press=setScheme("dark") aria-label="Dark" testId="scheme-dark"
                text "Dark" font-size=12
              button press=toggleSky aria-label="Toggle the sky" testId="sky-toggle"
                when sky
                  text "Sky off" font-size=12
                else
                  text "Sky on" font-size=12
            row gap=6
              button press=setMaterial("glass") aria-label="Glass" testId="material-glass"
                text "Glass" font-size=12 font-weight=600
              button press=setMaterial("ink") aria-label="Ink" testId="material-ink"
                text "Ink" font-size=12 font-weight=600
              button press=setMaterial("crt") aria-label="CRT" testId="material-crt"
                text "CRT" font-size=12 font-weight=600
              button press=toggleDeck aria-label="Deck" testId="deck-toggle"
                text "Deck" font-size=12 font-weight=600 color="#c0392b"

      when screen == "home"
        column padding=20 gap=4 height=220 box-sizing="border-box" justify-content="flex-end" testId="aurora"
          when material == "glass"
            text "Next stop" font-size=12 font-weight=700 letter-spacing=1.2 color="#9ad8ff"
            text station.name font-size=34 font-weight=800 color="#ffffff" testId="aurora-title"
            text `${formatDistance(station.distance)} · ${formatWalk(station.distance)} · the whole app laid out by the kernel, painted by CoreText, refracted by the aurora` font-size=12 color="#d0e4ff"
          else
            text "Next stop" font-size=12 font-weight=700 letter-spacing=1.2 color="#8a5a2b"
            text station.name font-size=34 font-weight=800 color="#2a1f14" testId="aurora-title"
            text `${formatDistance(station.distance)} · ${formatWalk(station.distance)} · the whole app laid out by the kernel, painted by CoreText, composed by the surface` font-size=12 color="#5a4a3a"
        canvas surface=map(allStations, selectedId, northBoard, nowMs) width="100%" height=160 border-radius=16 testId="line-map"
          column height="100%" box-sizing="border-box" padding-top=16 padding-bottom=16 justify-content="space-between"
            each s in allStations key=s.id
              row align-items="center" height=14 testId=`map-${s.id}`
                view flex=1
                view width=14 height=14 align-items="center" justify-content="center"
                  when s.id == selectedId
                    view width=14 height=14 border-radius=7 background-color="#bf382b"
                  else
                    view width=7 height=7 border-radius=3.5 background-color="#666666"
                view flex=1 padding-left=10
                  text s.name font-size=11 color="#444444" testId=`map-name-${s.id}`
        section role="region" aria-label="Departures" gap=14 testId="home-screen"
          when deck
            canvas surface=stack(northBoard, focus, deck, nowMs) width="100%" height=460 testId="deck"
              each d in northBoard key=d.id
                button press=focusDeparture(d.id) aria-label=`Train ${d.train}` testId=`card-${d.id}` width="100%"
                  column border-radius=16 padding=16 gap=6 background-color="#ffffff" width="100%" box-sizing="border-box"
                    row gap=8 align-items="flex-end"
                      text formatCountdownMinutes(d.at, nowMs) font-size=30 font-weight=800
                      text "min" font-size=13 color="#666666"
                    text `${formatClockTime(d.at)} · Train ${d.train} · ${d.service} to ${d.headsign}` font-size=13 color="#444444"
          else
            DirectionCard(title="Northbound", board=northBoard, nowMs=nowMs, testId="board-north")
          DirectionCard(title="Southbound", board=southBoard, nowMs=nowMs, testId="board-south")
      else
        section role="region" aria-label="Stations" gap=12 testId="stations-screen" background-color="#ffffffd9" border-radius=16 padding=14 box-sizing="border-box"
          input value=query change=setQuery focus=focusSearch blur=blurSearch key=searchKey placeholder="Search stations" aria-label="Search stations" testId="station-search" padding=12 border-radius=10 border-width=1 border-color="#cccccc"
          when searchFocused
            text `searching · last key ${lastKey}` font-size=11 color="#999999" testId="search-hint"
          when query == ""
            column gap=8
              text "Nearest" font-size=12 font-weight=700 letter-spacing=0.8 color="#999999"
              each s in nearby key=s.id
                StationRow(station=s, press=selectStation, hover=hoverStation, hot=(hoverOn and s.id == hoverId))
              text "All stations" font-size=12 font-weight=700 letter-spacing=0.8 color="#999999"
              each s in allStations key=s.id
                StationRow(station=s, press=selectStation, hover=hoverStation, hot=(hoverOn and s.id == hoverId))
          else
            column gap=8
              text "Matches" font-size=12 font-weight=700 letter-spacing=0.8 color="#999999"
              each s in matches key=s.id
                StationRow(station=s, press=selectStation, hover=hoverStation, hot=(hoverOn and s.id == hoverId))
          button press=goHome aria-label="Back" testId="stations-back"
            text "Back" font-size=13

component DirectionCard
  props
    title: string
    board: list<Departure>
    nowMs: number
    testId: string
  view
    column border-radius=16 padding=16 gap=10 background-color="#ffffffd9" testId=testId
      text title font-size=13 font-weight=700 color="#c0392b"
      when isEmpty(board)
        text "No more trains today" font-size=14 color="#666666"
      else
        each d in board key=d.id
          when d.at >= nowMs
            row gap=8 align-items="flex-end" testId=`dep-${d.id}`
              text formatCountdownMinutes(d.at, nowMs) font-size=28 font-weight=700 testId=`countdown-${d.id}`
              text `min · ${formatClockTime(d.at)} · Train ${d.train} · ${d.service} to ${d.headsign}` font-size=13 color="#666666"

component StationRow
  props
    station: Station
    press: action
    hover: action
    hot: bool
  view
    button press=press(station.id) hover=hover(station.id) aria-label=station.name testId=`station-${station.id}` width="100%"
      when hot
        row justify-content="space-between" align-items="center" padding-top=10 padding-bottom=10 border-bottom-width=1 border-color="#e0e0e0" width="100%" background-color="#f2f2f2" testId=`station-hot-${station.id}`
          column gap=2
            text station.name font-size=15 font-weight=600
            text `Zone ${station.zone}` font-size=12 color="#999999"
          text formatDistance(station.distance) font-size=12 color="#666666"
      else
        row justify-content="space-between" align-items="center" padding-top=10 padding-bottom=10 border-bottom-width=1 border-color="#e0e0e0" width="100%"
          column gap=2
            text station.name font-size=15 font-weight=600
            text `Zone ${station.zone}` font-size=12 color="#999999"
          text formatDistance(station.distance) font-size=12 color="#666666"
