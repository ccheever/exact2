// The auth fixture (LLP 1069.006): an OAuth sign-in with PAR, DPoP and
// PKCE against a local fixture authorization server (`fixture.mjs`),
// the way the Bluesky port would sign in. Preparing does discovery, the
// DPoP key and PAR; the press opens the system browser (a popup on the
// web) with `openAuthSession`, and its answer exchanges the code.
//
// Passkeys (LLP 1133.011 §10) against the same server's relying party: a
// button registers one, another signs in with one, a third has the server
// forget the one signed in with (drive 9's signal), and while the sign-in
// screen shows, a conditional `get` offers them in the username field's
// suggestions. Each ceremony is data code's (`app.ts`); the view reads only
// what the server answered.
//
// Sign-in (LLP 1133.014 §10): the providers' own buttons, each an action
// whose data code asks `get` with a nonce fetched when the screen showed,
// and, where the target offers it, one passive request beside a passkey
// when the sign-in screen shows. The view reads the server's account only.
//
// "Check this build" (LLP 1133.028 §8.1) proves to the server that this is
// a genuine build on a genuine device; the row shows the server's verdict.

use getClientCapabilities, ClientCapabilities from "@exact/passkeys"
use attestationStatus, AttestationStatus from "@exact/attestation"
use getIdentityCapabilities, IdentityCapabilities from "@exact/sign-in"

shape Time
  epochAtZero: number
shape Session
  signedIn: bool
  handle: string
shape Result
  ok: bool
  message: string

component AuthFixture
  resource time = exactTime() as shape Time
  resource session = currentSession() as shape Session
  resource caps = getClientCapabilities() as shape ClientCapabilities else empty(available=false)
  mutation prepared as shape Result
  mutation signed as shape Result refreshes session
  mutation left as shape Result refreshes session
  // The modal ceremonies, and the conditional one the field offers.
  mutation passkey as shape Result refreshes session
  mutation suggested as shape Result refreshes session
  resource attestation = attestationStatus() as shape AttestationStatus
  resource identities = getIdentityCapabilities() as shape IdentityCapabilities
  mutation nonce as shape Result
  mutation identity as shape Result refreshes session
  mutation offered as shape Result refreshes session
  state identityOffer = true
  mutation checked as shape Result
  state username = ""
  derive busy = pending(prepared) or pending(signed)
  derive conditional = match caps.conditionalGet { case some(c) => c, case none => false }
  // A conditional request while the sign-in screen shows and no sheet is up;
  // the gate's turning true again after one ends starts the next, until the
  // data code reports the platform refuses them (an error line).
  derive offering = match suggested { case some(r) => r.ok or r.message == "", case none => true }
  task suggesting when caps.available and conditional and offering and not session.signedIn and not pending(passkey) and not pending(suggested)
    after(1, suggest)
  // A nonce for the next press, fetched when the screen shows; each sign-in fetches the next.
  task prepareIdentity mount
    after(1, getNonce)
  action getNonce
    send nonce = identityNonce()
  // One passive request beside a passkey per sign-out, where the target offers one.
  task offerIdentity when identities.available and identityOffer and not session.signedIn and not pending(identity) and not pending(passkey) and not pending(nonce)
    after(1, offer)
  action offer
    identityOffer = false
    send offered = offerSignIn()
  action appleSignIn
    send identity = signInWith("apple")
  action googleSignIn
    send identity = signInWith("google")
  action prepare
    send prepared = prepareSignIn(time.epochAtZero + performanceNow())
  // A desktop's loopback callback (LLP 1133.005 D9), signed in by the same press.
  action prepareLoopback
    send prepared = prepareLoopbackSignIn(time.epochAtZero + performanceNow())
  action signIn
    send signed = signIn(time.epochAtZero + performanceNow())
  action signOut
    send left = signOut()
    identityOffer = true
    // A ceremony or a check in flight is for the session that is ending.
    send passkey = passkeyIdle()
    send checked = passkeyIdle()
    // So is a sign-in whose sheet is still up, whose answer is then dropped (LLP 1133.014 D12).
    send identity = passkeyIdle()
  action setUsername(value)
    username = value
  // A press asks for suggestions again once its sheet is done, even after the
  // platform refused them.
  action createPasskey
    send passkey = createPasskey(username)
    send suggested = passkeyIdle()
  action signInPasskey
    send passkey = signInWithPasskey()
    send suggested = passkeyIdle()
  action forget
    send passkey = forgetPasskey()
  action suggest
    send suggested = suggestPasskey()
  action check
    send checked = checkBuild()
  view
    column testId="auth" width="100%" height="100%" gap=14 padding=24 box-sizing="border-box" background-color="#f5f6f8" color="#1d2a3a" font-family="system-ui"
      text "Auth Fixture" font-size=24 font-weight=600
      text (session.signedIn ? "Signed in as " + session.handle : "Signed out") testId="session" font-size=16
      button press=prepare disabled=busy testId="prepare" padding=12 border-radius=8 background-color="#dfe5ee"
        text "Prepare sign-in"
      button press=prepareLoopback disabled=busy testId="prepare-loopback" padding=12 border-radius=8 background-color="#dfe5ee"
        text "Prepare loopback sign-in"
      button press=signIn disabled=busy testId="sign-in" padding=12 border-radius=8 background-color="#2f6fd6"
        text "Sign in" color="#ffffff" font-weight=600
      button press=signOut testId="sign-out" padding=12 border-radius=8 background-color="#dfe5ee"
        text "Sign out"
      if not session.signedIn
        input value=username input=setUsername placeholder="Username" autocomplete="username webauthn" aria-label="Username" testId="username"
      if not session.signedIn and identities.providers.apple.active
        exact-sign-in-button provider="apple" press=appleSignIn testId="apple-sign-in" width="100%" height=44
      if not session.signedIn and identities.providers.google.active
        exact-sign-in-button provider="google" press=googleSignIn testId="google-sign-in" width="100%" height=44
      match identity
        case some(i)
          text i.message testId="identity" font-size=14
        case none
          text "" font-size=14
      match offered
        case some(i)
          text i.message testId="offered" font-size=14
        case none
          text "" font-size=14
      if caps.available
        button press=createPasskey disabled=pending(passkey) testId="create-passkey"
          text "Create a passkey"
        if not session.signedIn
          button press=signInPasskey disabled=pending(passkey) testId="sign-in-passkey"
            text "Sign in with a passkey"
        if session.signedIn
          button press=forget disabled=pending(passkey) testId="forget-passkey"
            text "Forget this passkey"
      match passkey
        case some(p)
          text p.message testId="passkey" font-size=14
        case none
          text "" font-size=14
      match suggested
        case some(p)
          text p.message testId="suggested" font-size=14
        case none
          text "" font-size=14
      text (attestation.available ? "Attestation: " + attestation.provider : "Attestation: unavailable") testId="attestation-status" font-size=14
      if attestation.available
        button press=check disabled=pending(checked) testId="check-build"
          text "Check this build"
      match checked
        case some(c)
          text c.message testId="checked" font-size=14
        case none
          text "" font-size=14
      match prepared
        case some(p)
          text p.message testId="prepared" font-size=14
        case none
          text "" font-size=14
      match signed
        case some(s)
          text s.message testId="signed" font-size=14 color=(s.ok ? "#1a7f37" : "#b42318")
        case none
          text "" font-size=14
