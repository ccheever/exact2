// LLP 1041 §8.5: shared viewport collections and explicit height/transform bindings.
fn photoFit(bw: number, bh: number, nw: number, nh: number): number = bw > 0 and bh > 0 and nw > 0 and nh > 0 ? min(bw / nw, bh / nh) : 0
fn photoZoom(scale: number): number = min(max(scale, 1), 4)
fn photoClamp(value: number, natural: number, fit: number, zoom: number, port: number): number = min(max(value, -max(0, (natural * fit * zoom - port) / 2)), max(0, (natural * fit * zoom - port) / 2))

// LLP 1061: the header rises in unless the reader asked for less motion.
keyframes rise
  from opacity=0 translate="0px 6px"

shape Media
  prefersReducedMotion: bool

shape Theme
  page: string
  card: string
  edge: string
  ink: string
  muted: string
  wash: string
  accent: string

shape Photo
  id: string
  title: string
  subtitle: string
  asset: string
  alt: string
  tone: string
  notes: string
  rank: number

shape ViewerState
  viewerToken: number
  photo: Photo
  naturalWidth: number
  naturalHeight: number

shape GalleryState
  mode: string
  total: number
  requested: number
  page: number
  pages: number
  first: number
  end: number
  revision: number
  selected: Photo
  hasSelection: bool
  viewerOpen: bool
  viewerToken: number
  hasPrevious: bool
  hasNext: bool
  reordering: bool
  dragToken: number
  liftedId: string
  beforeId: string
  previewLabel: string
  notice: string
  returnKind: string
  returnId: string
  canInsert: bool
  canPagePrevious: bool
  canPageNext: bool
  viewer: list<ViewerState>

component InteractionGallery
  resource initial = gallery() as shape GalleryState
  resource theme = theme() as shape Theme
  resource media = exactViewport() as shape Media
  mutation changed as shape GalleryState
  derive gallery = match changed { case some(value) => value, case none => initial }
  state draft = ""
  state rendering = "windowed"
  state sheetPx = 360
  derive fullCollection = gallery.mode != "photos" and rendering != "manual"
  resource rows = galleryRows(gallery.revision, (fullCollection ? 0 : gallery.page), fullCollection) as shape list<Photo>

  action chooseRendering(value: string) writes rendering
    if value == "windowed" or value == "manual" or value == "eager"
      rendering = value

  action chooseSheet(value: number) writes sheetPx
    if value == 180 or value == 360 or value == 640
      sheetPx = value

  action snapSheet(height: number, velocity: number) writes sheetPx
    sheetPx = (height + velocity * 0.15 < 270 ? 180 : (height + velocity * 0.15 < 500 ? 360 : 640))

  action command(op: string, id: string, n: number) writes changed, sheetPx
    if op == "reset" or op == "load"
      sheetPx = 360
    send changed = galleryAction(op, id, n)
    if op == "open"
      focus("close-viewer")
    if op == "close"
      focus(`open-${gallery.selected.id}`)
    if op == "mode"
      focus(`mode-${id}`)
    if op == "lift"
      focus("place")
    if op == "place" or op == "cancel"
      if rendering == "windowed"
        focus("mode-reorder")
      else
        focus(`lift-${gallery.selected.id}`)
    if op == "delete"
      focus(`mode-${gallery.mode}`)
  action dropArrange(item: string, before: option<string>) writes changed
    send changed = galleryReorder(item, before, gallery.revision)

  action edit(value) writes draft
    if length(value) <= 512
      draft = value

  view
    provide theme = theme
      main testId="interaction-gallery" display="flex" flex-direction="column" width="100%" height="100%" min-height=0 background-color=theme.page color=theme.ink
        column flex-shrink=0 padding=20 gap=14 border-bottom-width=1 border-color=theme.edge
          row gap=16 align-items="center" flex-wrap="wrap"
            text "still." font-size=30 font-weight=700 letter-spacing=-1 color=theme.accent animation=(media.prefersReducedMotion ? "none" : "rise 520ms cubic-bezier(0.32, 0.72, 0, 1) both")
            text "A collection of imagined places" font-size=12 color=theme.muted flex=1 min-width=180
            row gap=8 flex-shrink=0
              ModeButton(name="photos", label="Photos", shortcut="Meta+1 Control+1", gallery=gallery, command=command)
              ModeButton(name="reorder", label="Arrange", shortcut="Meta+2 Control+2", gallery=gallery, command=command)
              ModeButton(name="sheet", label="Read", shortcut="Meta+3 Control+3", gallery=gallery, command=command)
          row align-items="center" gap=8 flex-wrap="wrap"
            text "COLLECTION" font-size=10 font-weight=700 letter-spacing=1 color=theme.muted
            CountButton(count=100, label="100", gallery=gallery, command=command)
            CountButton(count=1000, label="1,000", gallery=gallery, command=command)
            CountButton(count=25000, label="25,000", gallery=gallery, command=command)
            text `${gallery.total} studies · 6 local images` font-size=12 color=theme.muted flex=1 min-width=170
            button press=command("insert", "", 0) disabled=(not gallery.canInsert) testId="insert" aria-label="Insert a new study at the beginning" press-scale=0.97 padding=7 background-color=theme.card border-width=0 border-radius=6
              text "+ Add study" font-size=12 color=theme.ink
            button press=command("reset", "", 0) testId="reset" aria-label="Reset this collection and its edits" press-scale=0.97 padding=7 background-color=theme.card border-width=0 border-radius=6
              text "Reset" font-size=12 color=theme.muted
        when gallery.mode != "photos"
          row gap=8 padding-left=20 padding-right=20 padding-bottom=8 flex-shrink=0 align-items="center" flex-wrap="wrap"
            RenderButton(name="windowed", label="Windowed", selected=rendering, choose=chooseRendering)
            RenderButton(name="manual", label="Manual 12", selected=rendering, choose=chooseRendering)
            RenderButton(name="eager", label="Eager all", selected=rendering, choose=chooseRendering)
            text `${length(rows)} supplied · ${gallery.total} logical · ${rendering == "windowed" ? "viewport rows mounted" : rendering == "eager" ? "all supplied rows mounted" : "manual page"}` testId="supplied-count" font-size=11 color=theme.muted
        when gallery.mode == "photos"
          when gallery.viewerOpen
            each viewer in gallery.viewer key=viewer.viewerToken
              Viewer(viewer=viewer, gallery=gallery, command=command)
          else
            scroll testId="photos-scroll" flex=1 min-height=0 overflow-x="hidden"
              column padding=24 gap=20 width="100%" box-sizing="border-box"
                column gap=6
                  text "Places to pause." font-size=32 font-weight=600 color=theme.ink
                  text "Six studies in light, texture and distance. Open a photograph to look a little closer." font-size=14 color=theme.muted
                row flex-wrap="wrap" gap=18 align-items="flex-start"
                  each photo in rows key=photo.id
                    PhotoCard(photo=photo, returned=(gallery.returnId == photo.id), command=command)
                when gallery.total == 0
                  text "A clean slate. Add a study or reset your collection." font-size=18 color=theme.muted
        when gallery.mode == "reorder"
          column flex=1 min-height=0
            column padding=20 gap=8 flex-shrink=0
              text "Find a new rhythm." font-size=28 font-weight=600 color=theme.ink
              text "Pick up a study, preview a position, then Place. Cancel keeps the original order." font-size=13 color=theme.muted
              when gallery.reordering
                row gap=8 flex-wrap="wrap" align-items="center" padding=10 background-color=theme.wash border-radius=8
                  text gallery.previewLabel testId="move-preview" font-size=12 color=theme.accent flex=1
                  ActionButton(id="earlier", label="Earlier", op="earlier", target="", n=gallery.dragToken, shortcut="Meta+, Control+,", command=command)
                  ActionButton(id="later", label="Later", op="later", target="", n=gallery.dragToken, shortcut="Meta+. Control+.", command=command)
                  ActionButton(id="place", label="Place", op="place", target="", n=gallery.dragToken, shortcut="Meta+p Control+p", command=command)
                  ActionButton(id="cancel", label="Cancel", op="cancel", target="", n=gallery.dragToken, shortcut="Escape", command=command)
            when rendering == "windowed"
              list id="arrange-list" reorderdrop=dropArrange virtualized=true scrollFollowEnd=true testId="reorder-scroll" flex=1 min-height=0 width="100%" overflow-x="hidden"
                each photo in rows key=photo.id
                  column width="100%" box-sizing="border-box" padding-left=20 padding-right=20 padding-bottom=10 testId=`arrange-row-${photo.id}`
                    ArrangeCard(photo=photo, gallery=gallery, windowed=true, command=command)
            else
              scroll testId="reorder-scroll" flex=1 min-height=0 overflow-x="hidden"
                column padding=20 padding-top=0 gap=10
                  each photo in rows key=photo.id
                    ArrangeCard(photo=photo, gallery=gallery, windowed=false, command=command)
        when gallery.mode == "sheet"
          column flex=1 min-height=0 position="relative" overflow="hidden" testId="sheet-stage"
            when gallery.hasSelection
              image gallery.selected.asset aria-label=gallery.selected.alt width="100%" height="100%" object-fit="cover"
            when sheetPx != 640
              column position="absolute" top=16 left=20 right=20 max-width=340 padding=12 box-sizing="border-box" border-radius=10 background-color="#203b37" gap=5
                text "A little closer." font-size=30 font-weight=600 color="#ffffff"
                text "Drag the header or choose a height; scroll the notes inside." font-size=13 color="#ffffff"
            column id="reading-sheet" position="absolute" bottom=0 left=0 right=0 height=sheetPx min-height=0 max-height="100%" transition="height spring(300, 30, 1)" background-color=theme.card border-top-left-radius=20 border-top-right-radius=20 padding=16 box-sizing="border-box" gap=12 testId="reading-sheet"
              row flex-shrink=0 align-items="center" gap=8 flex-wrap="wrap"
                column heightDragFor="reading-sheet" heightrelease=snapSheet touch-action="none" testId="sheet-handle" aria-label="Resize reading sheet" flex=1 min-width=120 gap=3 padding-top=2 padding-bottom=2
                  text "Field notes" font-size=20 font-weight=600 color=theme.ink
                  text "Drag to resize" font-size=10 color=theme.muted
                SheetButton(name="peek", label="Peek", px=180, selected=sheetPx, choose=chooseSheet)
                SheetButton(name="read", label="Read", px=360, selected=sheetPx, choose=chooseSheet)
                SheetButton(name="full", label="Full", px=640, selected=sheetPx, choose=chooseSheet)
              when rendering == "windowed"
                list virtualized=true scrollFollowEnd=true flex=1 min-height=0 width="100%" testId="sheet-scroll" overscroll-behavior="contain" overflow-x="hidden"
                  each photo in rows key=photo.id
                    column width="100%" box-sizing="border-box" padding-bottom=12 testId=`read-row-${photo.id}`
                      NoteCard(photo=photo, selected=gallery.selected.id, command=command)
              else
                scroll flex=1 min-height=0 testId="sheet-scroll" overscroll-behavior="contain" overflow-x="hidden"
                  column gap=12
                    each photo in rows key=photo.id
                      NoteCard(photo=photo, selected=gallery.selected.id, command=command)
        column flex-shrink=0 padding=12 gap=8 border-top-width=1 border-color=theme.edge background-color=theme.card
          when not fullCollection
            row gap=8 align-items="center" flex-wrap="wrap"
              button press=command("previousPage", "", 0) testId="previous-page" disabled=(not gallery.canPagePrevious) aria-label="Previous page" padding=7 border-width=0 background-color=theme.page border-radius=6
                text "Previous 12" font-size=12 color=theme.ink
              text `${gallery.first}–${gallery.end} of ${gallery.total} · Page ${gallery.page + 1}/${gallery.pages}` testId="page-range" font-size=12 color=theme.muted
              button press=command("nextPage", "", 0) testId="next-page" disabled=(not gallery.canPageNext) aria-label="Next page" padding=7 border-width=0 background-color=theme.page border-radius=6
                text "Next 12" font-size=12 color=theme.ink
              text "Browse your collection" font-size=11 color=theme.muted flex=1
          text gallery.notice testId="status" font-size=11 color=theme.accent
          input value=draft input=edit testId="gallery-input" aria-label="Write a note while browsing and resizing" placeholder="Write a note while browsing or resizing…" padding=8 border-width=1 border-style="solid" border-color=theme.edge border-radius=6 background-color=theme.page color=theme.ink font-size=13
          text "Six imagined places · Generated photographic illustrations · Available offline" testId="readiness" font-size=10 color=theme.muted
          text (media.prefersReducedMotion ? "Reduced motion: press feedback stays, no entrance" : "Buttons give under a press; cards barely") testId="motion-preference" font-size=10 color=theme.muted

component ModeButton
  inject
    theme: Theme
  props
    name: string
    label: string
    shortcut: string
    gallery: GalleryState
    command: action
  view
    button press=command("mode", name, 0) id=`mode-${name}` testId=`mode-${name}` aria-keyshortcuts=shortcut aria-label=`${label}${gallery.mode == name ? ", selected" : ""}` press-scale=0.97 padding=9 border-width=0 border-radius=8 background-color=(gallery.mode == name ? theme.wash : theme.page)
      text label font-size=13 font-weight=600 color=(gallery.mode == name ? theme.accent : theme.muted)

component CountButton
  inject
    theme: Theme
  props
    count: number
    label: string
    gallery: GalleryState
    command: action
  view
    button press=command("load", "", count) testId=`count-${count}` aria-label=`Reset to ${count} studies` press-scale=0.97 padding=7 border-width=0 border-radius=6 background-color=(gallery.requested == count ? theme.wash : theme.card)
      text label font-size=12 color=theme.ink

component PhotoCard
  inject
    theme: Theme
  props
    photo: Photo
    returned: bool
    command: action
  view
    button press=command("open", photo.id, 0) id=`open-${photo.id}` testId=`open-${photo.id}` aria-label=`Open ${photo.title}, study ${photo.id}` press-scale=0.994 display="flex" flex-direction="column" flex=1 flex-basis="30%" min-width=220 padding=0 border-width=1 border-style="solid" border-color=(returned ? theme.accent : theme.edge) border-radius=12 overflow="hidden" background-color=theme.card
      image photo.asset aria-label=photo.alt width="100%" height=190 object-fit="cover" background-color=photo.tone testId=`image-${photo.id}`
      column padding=13 gap=5 width="100%" box-sizing="border-box"
        text photo.title font-size=17 font-weight=600 color=theme.ink
        text photo.subtitle font-size=11 color=theme.muted

component Viewer
  inject
    theme: Theme
  props
    viewer: ViewerState
    gallery: GalleryState
    command: action
  state panX = 0
  state panY = 0
  state zoom = 1
  state boxWidth = 0
  state boxHeight = 0
  state portWidth = 0
  state portHeight = 0
  derive geometryReady = boxWidth > 0 and boxHeight > 0 and portWidth > 0 and portHeight > 0
  derive fit = photoFit(boxWidth, boxHeight, viewer.naturalWidth, viewer.naturalHeight)
  // LLP 1057.002 §6.7 spike B: at Fit, with dismissing on, the photo drags down to
  // dismiss; per-frame app code moves it and derives the backdrop from the distance.
  state dismissing = false
  state dragging = false
  state dismissY = 0
  derive backdrop = 1 - min(max(dismissY / 300, 0), 1)

  action toggleDismiss writes dismissing, dismissY
    dismissing = not dismissing
    dismissY = 0

  action dismissStart writes dragging
    dragging = true

  action dismissPan(dx: number, dy: number) writes dismissY
    dismissY = dismissY + dy

  action dismissEnd(vx: number, vy: number) writes dragging, dismissY
    dragging = false
    dismissY = (dismissY + vy * 0.15 > 150 ? 700 : 0)

  action chooseZoom(value: number) writes zoom, panX, panY
    if value == 1 or value == 2
      zoom = value
      panX = geometryReady ? photoClamp(panX, viewer.naturalWidth, fit, value, portWidth) : 0
      panY = geometryReady ? photoClamp(panY, viewer.naturalHeight, fit, value, portHeight) : 0

  action resetPhoto writes zoom, panX, panY, dismissY
    zoom = 1
    panX = 0
    panY = 0
    dismissY = 0

  action photoGeometry(bw: number, bh: number, pw: number, ph: number) writes boxWidth, boxHeight, portWidth, portHeight, panX, panY
    if bw != boxWidth or bh != boxHeight or pw != portWidth or ph != portHeight
      boxWidth = bw
      boxHeight = bh
      portWidth = pw
      portHeight = ph
      if bw > 0 and bh > 0 and pw > 0 and ph > 0
        panX = photoClamp(panX, viewer.naturalWidth, photoFit(bw, bh, viewer.naturalWidth, viewer.naturalHeight), zoom, pw)
        panY = photoClamp(panY, viewer.naturalHeight, photoFit(bw, bh, viewer.naturalWidth, viewer.naturalHeight), zoom, ph)
      else
        panX = 0
        panY = 0

  // A pinch's scale is adopted between Fit and 4× (LLP 1057.001 §4); Fit, 2× and
  // Center remain the controls that need no gesture.
  action releasePhoto(x: number, y: number, scale: number, vx: number, vy: number, vscale: number) writes zoom, panX, panY
    zoom = photoZoom(scale)
    panX = geometryReady ? photoClamp(x, viewer.naturalWidth, fit, photoZoom(scale), portWidth) : 0
    panY = geometryReady ? photoClamp(y, viewer.naturalHeight, fit, photoZoom(scale), portHeight) : 0

  view
    scroll flex=1 min-height=0 testId="viewer-scroll" overflow-x="hidden"
      column padding=20 gap=14 align-items="center"
        row width="100%" gap=8 align-items="center" flex-wrap="wrap"
          ActionButton(id="close-viewer", label="Back to collection", op="close", target="", n=viewer.viewerToken, shortcut="Escape", command=command)
          text `${viewer.photo.rank} / ${gallery.total}` font-size=12 color=theme.muted flex=1
          button press=command("previous", "", viewer.viewerToken) testId="previous-photo" disabled=(not gallery.hasPrevious) aria-keyshortcuts="Meta+[ Control+[" padding=8 border-width=0 border-radius=6 background-color=theme.card
            text "Previous" font-size=12 color=theme.ink
          button press=command("next", "", viewer.viewerToken) testId="next-photo" disabled=(not gallery.hasNext) aria-keyshortcuts="Meta+] Control+]" padding=8 border-width=0 border-radius=6 background-color=theme.card
            text "Next" font-size=12 color=theme.ink
        row width="100%" gap=8 align-items="center" flex-wrap="wrap"
          button press=chooseZoom(1) testId="viewer-zoom-fit" aria-label=`Fit${zoom == 1 ? ", selected" : ""}` padding=8 border-width=0 border-radius=6 background-color=(zoom == 1 ? theme.wash : theme.card)
            text "Fit" font-size=12 color=theme.ink
          button press=chooseZoom(2) testId="viewer-zoom-detail" aria-label=`2×${zoom == 2 ? ", selected" : ""}` padding=8 border-width=0 border-radius=6 background-color=(zoom == 2 ? theme.wash : theme.card)
            text "2×" font-size=12 color=theme.ink
          button press=resetPhoto testId="viewer-reset" aria-label="Reset photo position and zoom" padding=8 border-width=0 border-radius=6 background-color=theme.card
            text "Center and fit" font-size=12 color=theme.ink
          button press=toggleDismiss testId="viewer-dismiss-mode" aria-label=`Drag to dismiss${dismissing ? ", on" : ""}` padding=8 border-width=0 border-radius=6 background-color=(dismissing ? theme.wash : theme.card)
            text "Drag to dismiss" font-size=12 color=theme.ink
        box testId="viewer-clip" width="100%" height=410 flex-shrink=0 position="relative" overflow="hidden" padding=0 border-width=0 box-sizing="border-box" border-radius=12
          box testId="viewer-backdrop" position="absolute" left=0 top=0 width="100%" height="100%" background-color="#172521" opacity=backdrop transition=(dragging ? "none" : "opacity spring(300, 30, 1)")
          box id="viewer-transform" testId="viewer-transform" width="100%" height="100%" position="relative" padding=0 border-width=0 margin=0 box-sizing="border-box" translate=`${panX}px ${panY}px` scale=zoom transition="translate spring(300, 30, 1), scale spring(300, 30, 1)"
            image viewer.photo.asset aria-label=viewer.photo.alt position="absolute" left=0 top=0 width="100%" height="100%" object-fit="contain" testId="viewer-image" translate=`0px ${dismissY}px` transition=(dragging ? "none" : "translate spring(300, 30, 1)")
            when dismissing and zoom == 1
              box pan=dismissPan panstart=dismissStart panend=dismissEnd touch-action="none" position="absolute" left=0 top=0 width="100%" height="100%" testId="viewer-dismiss" aria-label=`Drag ${viewer.photo.title} down to dismiss`
            else
              box transformDragFor="viewer-transform" transformgeometry=photoGeometry transformrelease=releasePhoto touch-action="none" position="absolute" left=0 top=0 width="100%" height="100%" testId="viewer-handle" aria-label=`Pan ${viewer.photo.title}`
        column width="100%" max-width=740 gap=7
          row gap=10 align-items="center"
            text viewer.photo.title font-size=28 font-weight=600 color=theme.ink flex=1
            ActionButton(id="delete-photo", label="Remove study", op="delete", target=viewer.photo.id, n=0, shortcut="", command=command)
          text viewer.photo.subtitle font-size=12 color=theme.muted
          text viewer.photo.notes font-size=15 line-height=1.5 color=theme.ink
          text "Generated photographic illustration · bundled locally" font-size=10 color=theme.muted

component ArrangeCard
  inject
    theme: Theme
  props
    photo: Photo
    gallery: GalleryState
    windowed: bool
    command: action
  view
    row testId=`card-${photo.id}` gap=14 padding=12 border-width=1 border-style="solid" border-color=(gallery.liftedId == photo.id ? theme.accent : theme.edge) border-radius=10 background-color=theme.card align-items="flex-start" flex-wrap="wrap"
      image photo.asset aria-label=photo.alt width=104 height=104 object-fit="cover" border-radius=7 flex-shrink=0
      column flex=1 min-width=180 gap=6
        text `${photo.rank}. ${photo.title}` font-size=18 font-weight=600 color=theme.ink
        text photo.notes font-size=13 line-height=1.4 color=theme.muted
        text photo.subtitle font-size=10 color=theme.muted
      column gap=6
        when windowed
          box reorderFor="arrange-list" disabled=gallery.reordering touch-action="none" testId=`arrange-grip-${photo.id}` aria-label=`Drag ${photo.title} to reorder` padding=8 border-radius=6 background-color=theme.page
            text "⋮⋮" font-size=16 color=theme.muted
        when gallery.reordering and gallery.liftedId != photo.id
          ActionButton(id=`before-${photo.id}`, label="Preview here", op="before", target=photo.id, n=gallery.dragToken, shortcut="", command=command)
        else
          ActionButton(id=`lift-${photo.id}`, label="Pick up", op="lift", target=photo.id, n=0, shortcut="", command=command)
        ActionButton(id=`delete-${photo.id}`, label="Remove", op="delete", target=photo.id, n=0, shortcut="", command=command)

component SheetButton
  inject
    theme: Theme
  props
    name: string
    label: string
    px: number
    selected: number
    choose: action
  view
    button press=choose(px) testId=`sheet-${name}` aria-label=`${label}${selected == px ? ", selected" : ""}` press-scale=0.97 padding=8 border-width=0 border-radius=6 background-color=(selected == px ? theme.wash : theme.page)
      text label font-size=12 color=theme.ink

component ActionButton
  inject
    theme: Theme
  props
    id: string
    label: string
    op: string
    target: string
    n: number
    shortcut: string
    command: action
  view
    button press=command(op, target, n) id=id testId=id aria-keyshortcuts=shortcut press-scale=0.97 padding=8 border-width=0 border-radius=6 background-color=theme.wash
      text label font-size=12 color=theme.accent

component RenderButton
  inject
    theme: Theme
  props
    name: string
    label: string
    selected: string
    choose: action
  view
    button press=choose(name) testId=`render-${name}` aria-label=`${label}${selected == name ? ", selected" : ""}` press-scale=0.97 padding=7 border-width=0 border-radius=6 background-color=(selected == name ? theme.wash : theme.card)
      text label font-size=12 color=theme.ink

component NoteCard
  inject
    theme: Theme
  props
    photo: Photo
    selected: string
    command: action
  view
    button press=command("select", photo.id, 0) testId=`note-${photo.id}` aria-label=`Read ${photo.title}, study ${photo.id}` press-scale=0.994 display="flex" flex-direction="row" gap=14 padding=12 border-width=0 border-radius=10 background-color=(selected == photo.id ? theme.wash : theme.page) align-items="flex-start"
      image photo.asset aria-label=photo.alt width=72 height=88 object-fit="cover" border-radius=6 flex-shrink=0
      column flex=1 min-width=0 gap=5
        text photo.title font-size=17 font-weight=600 color=theme.ink
        text photo.subtitle font-size=11 color=theme.muted
        text photo.notes font-size=14 line-height=1.45 color=theme.ink
