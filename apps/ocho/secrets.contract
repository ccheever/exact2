// The Secrets sidebar and its alert (ui/secret_requests_ui.rs, 1:1).
// The sidebar sits right of the body, 312 wide; the alert floats at the
// top right. Values are typed into a password field: the model keeps the
// draft and the view only ever carries its length.

use Ellipsis from "./theme.contract"
use Reset from "./theme.contract"

component SecretsSidebar
  props
    model: SecretRequests
    t: Theme
    hoverId: string
    press: action
    hover: action
    typed: action
  view
    column testId="secret-requests" width=312 height="100%" flex-shrink=0 background-color=t.bg border-left-style="solid" border-left-width=1 border-color=t.border box-sizing="border-box"
      // Header: px_3 py_2, border_b_1, row gap_2.
      row align-items="center" gap=8 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-bottom-style="solid" border-bottom-width=1 border-color=t.border
        text model.title flex=1 font-weight=600
        when model.pending != ""
          text model.pending font-size=11 line-height="17px" color=t.muted
        button press=press("secret-requests-close") testId="secret-requests-close" hover=hover("secret-requests-close") aria-label="Close Secrets" class=Reset padding-left=4 padding-right=4 color=(hoverId == "secret-requests-close" ? t.text : t.muted)
          text "×"
      when model.demo != ""
        text model.demo padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 background-color=t.accent09 font-size=11 line-height="17px" color=t.muted
      when model.error != ""
        text model.error padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 font-size=11 line-height="17px" color=t.danger
      scroll testId="secret-requests-list" flex=1 min-height=0
        column padding=12 gap=12
          when model.empty != ""
            text model.empty font-size=12 line-height="19px" color=t.muted
          each c in model.cards key=c.id
            column testId=c.id gap=8 padding=12 border-radius=8 border-style="solid" border-width=1 border-color=(c.editing ? t.accent : t.border) background-color=t.elevated
              row align-items="center" gap=8
                text c.name flex=1 min-width=0 font-weight=600 font-size=12 line-height="19px" overflow-wrap="anywhere"
                text c.status font-size=11 line-height="17px" color=(c.statusColor == "warn" ? t.warn : (c.statusColor == "good" ? t.good : t.muted))
              text c.reason font-size=12 line-height="19px" color=t.muted
              when c.actions
                row align-items="center" gap=8
                  SecretButton(id=c.openId, label="Provide value", primary=true, t=t, hoverId=hoverId, press=press, hover=hover)
                  SecretButton(id=c.dismissId, label="Dismiss", primary=false, t=t, hoverId=hoverId, press=press, hover=hover)
              when c.revoke
                row
                  SecretButton(id=c.revokeId, label="Revoke", primary=false, t=t, hoverId=hoverId, press=press, hover=hover)
              when c.entry
                column gap=8
                  // rounded_md, border_1, bg, px_2 py_1; the placeholder is
                  // its own muted layer (an input's placeholder cannot be coloured).
                  box position="relative" border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=t.bg padding-left=8 padding-right=8 padding-top=4 padding-bottom=4
                    when model.masked == ""
                      text model.placeholder position="absolute" left=8 top=4 color=t.placeholder font-size=13 line-height="21px"
                    input id="secret-demo-input" testId="secret-demo-input" type="password" input=typed("secret-demo-input") focus=press("secret-demo-input") blur=press("secret-blur") placeholder="" autofocus=model.focused aria-label=model.placeholder width="100%" min-height=21 line-height="21px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-size=13 color=t.text box-sizing="border-box"
                  row align-items="center" gap=4
                    each l in model.lifetimes key=l.id
                      button press=press(l.id) testId=l.id hover=hover(l.id) class=Reset padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 font-size=11 line-height="17px" background-color=(hoverId == l.id ? t.selected : (l.selected ? t.accent16 : t.element)) color=(l.selected ? t.text : t.muted)
                        text l.label
                  row align-items="center" gap=8
                    SecretButton(id=c.provideId, label=model.provideLabel, primary=true, t=t, hoverId=hoverId, press=press, hover=hover)
                    SecretButton(id=c.cancelId, label="Cancel", primary=false, t=t, hoverId=hoverId, press=press, hover=hover)
      when model.reset != ""
        row padding=12 border-top-style="solid" border-top-width=1 border-color=t.border
          SecretButton(id="secret-demo-reset", label=model.reset, primary=false, t=t, hoverId=hoverId, press=press, hover=hover)

// ui.rs `action_button`: row gap_1p5, px_2 py_0p5, rounded_md, border_1
// (accent when primary), bg accent 12 % when primary else element, hover selected.
component SecretButton
  props
    id: string
    label: string
    primary: bool
    t: Theme
    hoverId: string
    press: action
    hover: action
  view
    button press=press(id) testId=id hover=hover(id) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=(primary ? t.accent : t.border) background-color=(hoverId == id ? t.selected : (primary ? t.accent12 : t.element)) color=t.text
      text label

// The alert (ui.rs `render_secret_alert`): right 0, top 52, up to 376
// wide, p_3 around a status-bar card with an accent border.
component SecretAlertCard
  props
    model: SecretAlert
    t: Theme
    hoverId: string
    press: action
    hover: action
  view
    column testId="secret-alert" position="absolute" right=0 top=52 width="100%" max-width=376 padding=12 box-sizing="border-box"
      column gap=8 padding=12 border-radius=8 background-color=t.statusBar border-style="solid" border-width=1 border-color=t.accent box-shadow="0 10px 15px rgba(0,0,0,0.1)"
        row align-items="center" gap=8
          text model.title flex=1 font-weight=600 font-size=12 line-height="19px"
          button press=press("secret-alert-dismiss") testId="secret-alert-dismiss" hover=hover("secret-alert-dismiss") aria-label="Dismiss" class=Reset color=(hoverId == "secret-alert-dismiss" ? t.text : t.muted)
            text "×"
        text model.name class=Ellipsis font-size=12 line-height="19px" font-weight=600
        scroll testId="secret-alert-reason" max-height=96
          text model.reason font-size=12 line-height="19px" color=t.muted
        row
          SecretButton(id="secret-alert-open", label=model.openLabel, primary=true, t=t, hoverId=hoverId, press=press, hover=hover)
