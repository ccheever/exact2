// Markdown as the model flattens it (data/src/markdown_doc.rs): one record
// per rendered row, drawn as markdown.rs `blocks`/`block` draw them. Runs
// are nested `text` children, measured and painted as one paragraph.
//
// Math is typeset upstream with RaTeX; Contract has no typesetter, so a
// formula shows its TeX source (italic serif) on the same row upstream
// gives it.

use Reset from "./theme.contract"

component MarkdownBlocks
  props
    blocks: list<MarkdownBlock>
    t: Theme
    size: number
    lineHeight: number
    hoverId: string
    keyPrefix: string
    press: action
    hover: action
  view
    column gap=12 min-width=0 width="100%"
      each b in blocks key=b.id
        // A list item: the marker column (24 wide, muted), then the content.
        row min-width=0 gap=(b.depth > 0 ? 8 : 0) padding-left=(b.depth > 1 ? (b.depth - 1) * 32 : 0) margin-left=(b.quote > 1 ? (b.quote - 1) * 18 : 0) border-left-style=(b.quote > 0 ? "solid" : "none") border-left-width=(b.quote > 0 ? 2 : 0) border-color=t.border
          when b.depth > 0
            text b.marker min-width=24 flex-shrink=0 color=t.muted font-size=size line-height=`${lineHeight}px`
          column flex=1 min-width=0 padding-left=(b.quote > 0 ? 16 : 0)
            MarkdownBlock(b=b, t=t, size=size, lineHeight=lineHeight, hoverId=hoverId, keyPrefix=keyPrefix, press=press, hover=hover)

component MarkdownBlock
  props
    b: MarkdownBlock
    t: Theme
    size: number
    lineHeight: number
    hoverId: string
    keyPrefix: string
    press: action
    hover: action
  view
    when b.kind == "paragraph"
      text min-width=0 font-size=size line-height=`${lineHeight}px` color=(b.subdued ? t.muted : t.text) overflow-wrap="anywhere"
        MarkdownRuns(runs=b.runs, t=t, size=size)
    when b.kind == "heading"
      text min-width=0 padding-top=8 font-weight=700 font-size=(b.level == 1 ? 25 : (b.level == 2 ? 21 : (b.level == 3 ? 18 : 16))) line-height=`${(b.level == 1 ? 25 : (b.level == 2 ? 21 : (b.level == 3 ? 18 : 16))) * 1.4}px` color=(b.subdued ? t.muted : t.text) overflow-wrap="anywhere"
        MarkdownRuns(runs=b.runs, t=t, size=(b.level == 1 ? 25 : (b.level == 2 ? 21 : (b.level == 3 ? 18 : 16))))
    when b.kind == "code"
      // rounded_lg on elevated: a header (language, Copy), then the code
      // scrolling sideways, unwrapped.
      column border-radius=8 background-color=t.elevated overflow="hidden" min-width=0
        row align-items="center" padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 font-size=12 line-height="19px" color=t.muted
          text b.language flex=1
          button press=press(`transcript-copy:${b.text}`) testId=`${keyPrefix}-${b.id}-copy` hover=hover(`${keyPrefix}-${b.id}-copy`) class=Reset padding-left=8 padding-right=8 border-radius=6 font-size=12 line-height="19px" background-color=(hoverId == `${keyPrefix}-${b.id}-copy` ? t.hover : "rgba(0,0,0,0)") color=(hoverId == `${keyPrefix}-${b.id}-copy` ? t.text : t.muted)
            text "Copy"
        scroll overflow-x="scroll" overflow-y="hidden" padding-left=16 padding-right=16 padding-bottom=16
          text b.text font-family="ui-monospace" font-size=13 line-height="21px" white-space="pre" font-style=(b.subdued ? "italic" : "normal") color=(b.subdued ? t.muted : t.text)
    when b.kind == "table"
      scroll overflow-x="scroll" overflow-y="hidden" min-width=0
        column
          each r in b.rows key=r.id
            row border-bottom-style="solid" border-bottom-width=1 border-color=t.border background-color=(r.header ? t.elevated : "rgba(0,0,0,0)")
              each c in r.cells key=c.id
                text flex=1 min-width=140 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 text-align=c.align font-weight=(r.header ? 700 : 400) font-size=size line-height=`${lineHeight}px` color=t.text
                  MarkdownRuns(runs=c.runs, t=t, size=size)
    when b.kind == "rule"
      box height=1 margin-top=8 margin-bottom=8 background-color=t.border
    when b.kind == "math"
      scroll overflow-x="scroll" overflow-y="hidden" margin-top=8 margin-bottom=8
        text b.text text-align="center" font-family="serif" font-style="italic" font-size=size line-height=`${lineHeight}px` white-space="pre" color=(b.subdued ? t.muted : t.text)

// One paragraph's styled spans: bold, italic, Menlo code on `element`,
// strikethrough, `accent` underlined links, muted italic progress text.
component MarkdownRuns
  props
    runs: list<MarkdownRun>
    t: Theme
    size: number
  view
    each r in runs key=r.id
      when r.math != ""
        text r.text font-family="serif" font-style="italic" color=(r.subdued ? t.muted : t.text)
      else
        when r.code
          text r.text font-family="ui-monospace" font-size=(size * 0.87) background-color=t.element color=(r.subdued ? t.muted : t.text)
        else
          when r.url != ""
            text r.text href=r.url font-weight=(r.bold ? 700 : 400) font-style=((r.italic or r.subdued) ? "italic" : "normal") color=t.accent text-decoration-line="underline"
          else
            text r.text font-weight=(r.bold ? 700 : 400) font-style=((r.italic or r.subdued) ? "italic" : "normal") text-decoration-line=(r.strike ? "line-through" : "none") color=(r.subdued ? t.muted : t.text)
