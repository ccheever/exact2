// Overlays (ui.rs:3492-3690 and the cards): the backdrop at black 45%, a
// card (elevated, radius 8, border, shadow_lg) top-aligned 72 down for the
// pickers and centred for the dialogs; and the popup menu card
// (ui.rs:1376), anchored to its trigger or at the pointer.

use Icon from "./icons.contract"
use MarkdownBlocks from "./markdown.contract"
use Ellipsis from "./theme.contract"
use Reset from "./theme.contract"
use Card from "./theme.contract"

component Overlays
  props
    model: Overlay
    popup: Popup
    whatsNew: WhatsNew
    pairing: IMessagePair
    t: Theme
    hoverId: string
    windowWidth: number
    windowHeight: number
    press: action
    pressAt: action
    hover: action
    typed: action
    overlayKeyDown: action
  view
    when model.kind != ""
      column testId="backdrop" position="absolute" top=0 left=0 right=0 bottom=0 background-color=t.backdrop align-items="center" justify-content=(model.top ? "flex-start" : "center") padding-top=(model.top ? 72 : 24) padding-bottom=24 box-sizing="border-box" key=overlayKeyDown
        button press=press("backdrop") testId="backdrop-close" class=Reset position="absolute" top=0 left=0 right=0 bottom=0 width="100%" height="100%" aria-label="Close"
        column testId=`overlay-${model.kind}` class=Card width=model.width max-width="100%" background-color=t.elevated border-color=t.border position="relative"
          // ---- Pickers: palette, PR finder, topic finder, themes (ui.rs:2078) ----
          when model.kind == "picker"
            row align-items="center" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-bottom-style="solid" border-bottom-width=1 border-bottom-color=t.border font-family="ui-monospace"
              text model.glyph color=t.accent
              // GPUI paints placeholders in `muted`; exact2 inputs have no placeholder color, so a text layer stands in.
              box position="relative" flex=1 min-width=0
                when model.query == ""
                  text model.placeholder position="absolute" top=0 left=0 right=0 font-size=13 line-height="21px" font-family="ui-monospace" color=t.muted class=Ellipsis pointer-events="none"
                input id="query" testId="query" value=model.query input=typed("query") placeholder="" autofocus=true aria-label=model.placeholder flex=1 min-width=0 height=21 line-height="21px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-family="ui-monospace" font-size=13 color=t.text
              text "↑ ↓ choose · Enter open · Esc close" font-size=11 line-height="18px" color=t.muted white-space="nowrap"
            when model.status != ""
              text model.status padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 font-size=12 line-height="19px" color=(model.statusError ? t.danger : t.muted)
            scroll id="picker-list" max-height=(min(440, windowHeight - 200)) padding-top=4 padding-bottom=4
              column
                each r in model.rows key=r.id
                  button press=press(`pick:${r.id}`) testId=`pick-${r.id}` hover=hover(`pick:${r.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=12 margin-left=4 margin-right=4 padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 border-radius=6 background-color=(r.selected ? t.selected : (hoverId == `pick:${r.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="calc(100% - 8px)" box-sizing="border-box"
                    when r.swatch != ""
                      box width=12 height=12 border-radius=2 background-color=r.swatch border-style="solid" border-width=1 border-color=r.swatchBorder flex-shrink=0
                    when r.chip != ""
                      text r.chip width=64 flex-shrink=0 font-size=11 line-height="18px" color=t.accent
                    when r.second != ""
                      column flex=1 min-width=0
                        text r.label class=Ellipsis color=(r.accent ? t.accent : t.text)
                        text r.second class=Ellipsis font-size=12 line-height="19px" color=t.muted
                    else
                      text r.label flex=1 class=Ellipsis color=(r.accent ? t.accent : t.text)
                    when r.detail != ""
                      text r.detail class=Ellipsis font-size=12 line-height="19px" color=t.muted max-width="45%"
                    when r.hint != ""
                      text r.hint flex-shrink=0 font-size=11 line-height="18px" color=t.muted
            when model.footer != ""
              text model.footer padding-left=16 padding-right=16 padding-top=4 padding-bottom=4 border-top-style="solid" border-top-width=1 border-top-color=t.border font-size=11 line-height="18px" color=t.muted
          // ---- What's New (whats_new_ui.rs, 1:1) ----
          when model.kind == "whats-new"
            row align-items="center" padding-left=16 padding-right=16 padding-top=12 padding-bottom=8 flex-shrink=0
              text whatsNew.title flex=1 font-weight=600
              button press=press("button:whats-new-close") testId="whats-new-close" hover=hover("button:whats-new-close") class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=(hoverId == "button:whats-new-close" ? t.selected : t.element) color=t.text
                text whatsNew.closeLabel
                text "Esc" font-size=11 line-height="18px" color=t.muted
            column padding-left=16 padding-right=16 padding-bottom=8 font-size=12 line-height="19px" color=t.muted flex-shrink=0
              when whatsNew.build != ""
                text whatsNew.build
              text whatsNew.subtitle
            scroll id="whats-new-rows" flex=1 min-height=0 max-height=(windowHeight - 220) padding-left=16 padding-right=16 padding-bottom=12
              column
                when whatsNew.empty != ""
                  text whatsNew.empty padding-top=16 padding-bottom=16 color=t.muted
                each r in whatsNew.rows key=`${r.kind}-${r.id}-${r.date}`
                  when r.kind == "date"
                    text r.date padding-top=16 padding-bottom=8 font-size=11 line-height="18px" font-weight=600 color=t.muted
                  else
                    button press=press(`button:${r.id}`) testId=r.id hover=hover(`button:${r.id}`) class=Reset display="flex" flex-direction="row" align-items="flex-start" gap=12 padding-left=8 padding-right=8 padding-top=8 padding-bottom=8 border-radius=6 background-color=(hoverId == `button:${r.id}` ? t.hover : "rgba(0,0,0,0)") color=t.text width="100%" box-sizing="border-box"
                      text r.title flex=1 font-size=12 line-height="19px"
                      text r.commit flex-shrink=0 font-family="ui-monospace" font-size=11 line-height="18px" color=t.muted
            text whatsNew.footer padding-left=16 padding-right=16 padding-top=12 padding-bottom=12 border-top-style="solid" border-top-width=1 border-top-color=t.border font-size=11 line-height="18px" color=t.muted flex-shrink=0
          // ---- Pair iMessage (ui.rs render_pair_imessage, 1:1) ----
          when model.kind == "pair-imessage"
            text pairing.title padding-left=16 padding-right=16 padding-top=12 padding-bottom=8 font-weight=600
            when pairing.state == "loading"
              text pairing.loading padding-left=16 padding-right=16 padding-top=12 padding-bottom=12 color=t.muted
            when pairing.state == "error"
              text pairing.error padding-left=16 padding-right=16 padding-top=12 padding-bottom=12 font-size=12 line-height="19px" color=t.warn
            when pairing.state == "ready"
              text pairing.instructions padding-left=16 padding-right=16 font-size=12 line-height="19px"
              row justify-content="center" padding-top=12 padding-bottom=12
                column padding=12 background-color="#ffffff" border-radius=6
                  each line in pairing.qr key=line.id
                    row
                      each cell in line.cells key=cell.id
                        box width=4 height=4 background-color=(cell.dark ? "#000000" : "#ffffff")
              text pairing.code padding-left=16 padding-right=16 font-family="ui-monospace"
              text pairing.sendTo padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 font-size=12 line-height="19px" color=t.muted
              text pairing.sendFrom padding-left=16 padding-right=16 padding-bottom=12 font-size=12 line-height="19px" color=t.muted
              row gap=8 padding-left=16 padding-right=16 padding-bottom=8
                button press=press("button:imessage-copy") testId="imessage-copy" hover=hover("button:imessage-copy") class=Reset padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=(hoverId == "button:imessage-copy" ? t.selected : t.element) color=t.text
                  text "Copy code"
                button press=press("button:imessage-open") testId="imessage-open" hover=hover("button:imessage-open") class=Reset padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=t.accent background-color=(hoverId == "button:imessage-open" ? t.selected : t.accent12) color=t.text
                  text "Open Messages"
            row justify-content="flex-end" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=8
              when pairing.retry
                button press=press("button:imessage-retry") testId="imessage-retry" hover=hover("button:imessage-retry") class=Reset padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=(hoverId == "button:imessage-retry" ? t.selected : t.element) color=t.text
                  text "New code"
              button press=press("button:imessage-close") testId="imessage-close" hover=hover("button:imessage-close") class=Reset display="flex" flex-direction="row" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=(hoverId == "button:imessage-close" ? t.selected : t.element) color=t.text
                text "Close"
                text "Esc" font-size=11 line-height="18px" color=t.muted
          // ---- Confirm (ui.rs:3689): title in warn, body muted, Cancel n / Yes y ----
          when model.kind == "confirm"
            text model.title padding-left=16 padding-right=16 padding-top=12 font-weight=600 color=t.warn
            text model.body padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 font-size=12 line-height="19px" color=t.muted
            row justify-content="flex-end" gap=8 padding-left=16 padding-right=16 padding-top=12 padding-bottom=12
              each b in model.buttons key=b.id
                button press=press(`button:${b.id}`) testId=`button-${b.id}` hover=hover(`button:${b.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=(b.primary ? t.accent : t.border) background-color=(hoverId == `button:${b.id}` ? t.selected : (b.primary ? t.accent12 : t.element)) color=t.text
                  text b.label
                  when b.hint != ""
                    text b.hint font-size=11 line-height="18px" color=t.muted
          // ---- Message (m): title, meta line, markdown body ----
          // ---- The last agent message (ui.rs Overlay::Message): title, the
          // state line, the Markdown body (14 px, line height 1.6), Close ----
          when model.kind == "message"
            text model.title padding-left=16 padding-right=16 padding-top=12 font-weight=600
            text model.subtitle padding-left=16 padding-right=16 padding-bottom=8 font-size=12 line-height="19px" color=t.muted
            scroll testId="message-body" max-height=(min(420, windowHeight - 200)) padding-left=16 padding-right=16 padding-top=8 padding-bottom=8 border-top-style="solid" border-top-width=1 border-color=t.border
              MarkdownBlocks(blocks=model.blocks, t=t, size=14, lineHeight=22.4, hoverId=hoverId, keyPrefix="message", press=press, hover=hover)
            row justify-content="flex-end" padding-left=16 padding-right=16 padding-top=8 padding-bottom=8
              each b in model.buttons key=b.id
                button press=press(b.id) testId=b.id hover=hover(b.id) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=(b.primary ? t.accent : t.border) background-color=(hoverId == b.id ? t.selected : (b.primary ? t.accent12 : t.element)) color=t.text
                  text b.label
                  when b.hint != ""
                    text b.hint font-size=11 line-height="17px" color=t.muted
          // ---- Help (ui.rs:3891): sections from the keymap, keys in Menlo at 200 wide ----
          when model.kind == "help"
            row align-items="center" padding-left=16 padding-right=16 padding-top=12
              text model.title flex=1 font-weight=600
              text model.hint font-size=12 line-height="19px" color=t.muted
            scroll id="help-body" max-height=(min(560, windowHeight - 140)) padding-left=16 padding-right=16 padding-top=12 padding-bottom=12
              column gap=2
                each r in model.rows key=r.id
                  when r.chip == "section"
                    text r.label padding-top=(r.id == "section-Everywhere" ? 0 : 10) font-size=11 line-height="18px" font-weight=700 color=t.accent
                  else
                    row gap=12
                      text r.label width=200 flex-shrink=0 font-family="ui-monospace" font-size=12 line-height="19px"
                      text r.detail font-size=12 line-height="19px" color=t.muted
          // ---- Settings and forms: fields in a column (ui.rs:5102, 5360) ----
          // ---- The launch composer (ui.rs render_launch_composer, e6adfa8): a
          // prompt, one line of controls (where · what · who) with the send
          // button, an error, and the open menu as a panel inside the card. ----
          when model.kind == "launch"
            each f in filter(model.fields, x => x.id == "launch-prompt") key=f.id
              column padding-left=12 padding-right=12 padding-top=12 padding-bottom=4 min-height=56
                // GPUI paints placeholders in `muted`; exact2 inputs have no placeholder color, so a text layer stands in.
                box position="relative" width="100%"
                  when f.value == ""
                    text "Do anything" position="absolute" top=0 left=0 right=0 font-size=13 line-height="21px" color=t.muted class=Ellipsis pointer-events="none"
                  input id="field-launch-prompt" testId="field-launch-prompt" value=f.value input=typed("field:launch-prompt") placeholder="" autofocus=f.focused aria-label="Prompt" width="100%" min-height=21 line-height="21px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-size=13 color=t.text box-sizing="border-box"
            row align-items="center" gap=4 padding-left=8 padding-right=8 padding-bottom=8
              each f in filter(model.fields, x => x.kind == "control") key=f.id
                button press=press(`pick:${f.id}`) testId=`field-${f.id}` hover=hover(`ctl:${f.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=6 padding-right=6 padding-top=2 padding-bottom=2 min-width=0 max-width=(f.id == "launch-who" ? 176 : 9999) border-radius=6 font-size=12 line-height="19px" color=(f.focused or includes(f.placeholder, "open") ? t.text : t.muted) background-color=(f.focused or includes(f.placeholder, "open") ? t.selected : (hoverId == `ctl:${f.id}` ? t.hover : "rgba(0,0,0,0)"))
                  when f.hint != ""
                    box width=7 height=7 border-radius=999 flex-shrink=0 background-color=f.hint
                  text f.label class=Ellipsis color=(includes(f.placeholder, "muted") ? t.muted : (f.focused or includes(f.placeholder, "open") ? t.text : t.muted))
                  when f.value != ""
                    text f.value flex-shrink=0 font-size=11 line-height="18px" color=(includes(f.placeholder, "danger") ? t.danger : t.placeholder)
              box flex=1
              button press=press("pick:launch-send") testId="launch-send" hover=hover("launch-send") class=Reset display="flex" align-items="center" justify-content="center" flex-shrink=0 width=26 height=26 border-radius=6 background-color=t.accent color=t.bg opacity=(hoverId == "launch-send" ? 0.9 : 1) aria-label="Launch"
                text "↑"
            when model.status != ""
              text model.status padding-left=12 padding-right=12 padding-bottom=8 font-size=11 line-height="18px" color=t.danger
            when length(model.rows) > 0 or length(filter(model.fields, x => x.kind == "search")) > 0
              column max-height=330 border-top-style="solid" border-top-width=1 border-top-color=t.border background-color=t.surface border-bottom-left-radius=8 border-bottom-right-radius=8 overflow="hidden"
                when length(filter(model.fields, x => x.kind == "tab")) > 1
                  row border-bottom-style="solid" border-bottom-width=1 border-bottom-color=t.border background-color=t.surface flex-shrink=0
                    each f in filter(model.fields, x => x.kind == "tab") key=f.id
                      button press=press(`pick:${f.id}`) testId=`field-${f.id}` hover=hover(`tab:${f.id}`) class=Reset display="flex" align-items="center" padding-left=12 padding-right=12 padding-top=6 padding-bottom=6 font-size=12 line-height="19px" border-bottom-style="solid" border-bottom-width=2 border-bottom-color=(f.focused ? t.accent : "rgba(0,0,0,0)") color=(f.focused ? t.text : t.muted) background-color=(not f.focused and hoverId == `tab:${f.id}` ? t.hover : "rgba(0,0,0,0)")
                        text f.label
                each f in filter(model.fields, x => x.kind == "search") key=f.id
                  row align-items="center" gap=8 padding-left=12 padding-right=12 padding-top=6 padding-bottom=6 border-bottom-style="solid" border-bottom-width=1 border-bottom-color=t.border flex-shrink=0
                    // GPUI paints placeholders in `muted`; exact2 inputs have no placeholder color, so a text layer stands in.
                    box position="relative" flex=1 min-width=0
                      when f.value == ""
                        text f.placeholder position="absolute" top=0 left=0 right=0 font-size=12 line-height="19px" color=t.muted class=Ellipsis pointer-events="none"
                      input id="field-launch-menu-query" testId="field-launch-menu-query" value=f.value input=typed("field:launch-menu-query") placeholder="" autofocus=true aria-label=f.placeholder flex=1 min-width=0 height=19 line-height="19px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-size=12 color=t.text
                scroll id="launch-menu-list" flex=1 min-height=0 padding-top=4 padding-bottom=4
                  column
                    each r in model.rows key=r.id
                      when r.hint == "group"
                        text r.label padding-left=12 padding-right=12 padding-top=8 padding-bottom=2 font-size=11 line-height="18px" color=t.placeholder
                      when r.hint == "note"
                        text r.label padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 font-size=11 line-height="18px" color=t.muted
                      when r.hint == "item" or r.hint == "folder"
                        button press=press(`pick:${r.id}`) testId=`pick-${r.id}` hover=hover(`pick:${r.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=8 flex-shrink=0 margin-left=4 margin-right=4 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 background-color=(r.selected ? t.selected : (hoverId == `pick:${r.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="calc(100% - 8px)" box-sizing="border-box"
                          text r.chip width=14 flex-shrink=0 font-size=11 line-height="18px" color=t.accent
                          when r.swatch != ""
                            box width=7 height=7 border-radius=999 flex-shrink=0 background-color=r.swatch
                          text r.label flex=1 class=Ellipsis font-size=12 line-height="19px" font-family=(r.hint == "folder" ? "ui-monospace" : "system-ui") color=(r.accent ? t.danger : t.text)
                          when r.detail != ""
                            text r.detail flex-shrink=0 max-width=256 class=Ellipsis font-size=11 line-height="18px" color=t.muted
          when model.kind == "settings"
            row align-items="center" gap=6 padding-left=16 padding-right=16 padding-top=12 padding-bottom=4 flex-shrink=0
              text model.title flex=1 font-weight=600
              // ui.rs render_settings (e6adfa8): a ghost "What’s New" button.
              button press=press("whats-new") testId="settings-whats-new" hover=hover("settings-whats-new") class=Reset padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 font-size=13 line-height="21px" background-color=(hoverId == "settings-whats-new" ? t.hover : "rgba(0,0,0,0)") color=(hoverId == "settings-whats-new" ? t.text : t.muted)
                text "What’s New"
              text model.subtitle font-size=12 line-height="19px" color=t.muted
            scroll flex=1 min-height=0 max-height=(min(520, windowHeight - 200)) padding-left=8 padding-right=8 padding-top=8 padding-bottom=8
              column
                each f in model.fields key=f.id
                  row align-items="flex-start" gap=16 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 background-color=(f.focused and f.kind != "text" ? t.selected : (hoverId == `setting:${f.id}` ? t.hover : "rgba(0,0,0,0)")) border-style="solid" border-width=1 border-color=(f.focused and f.kind == "text" ? `${t.accent}66` : "rgba(0,0,0,0)") hover=hover(`setting:${f.id}`) box-sizing="border-box"
                    button press=press(`field:${f.id}`) class=Reset display="flex" flex-direction="column" gap=2 flex=1 min-width=0 color=t.text
                      row align-items="center" gap=8
                        text f.label font-weight=500
                        when f.hint != ""
                          button press=press(`reset:${f.id}`) testId=`reset-${f.id}` hover=hover(`reset:${f.id}`) class=Reset padding-left=4 padding-right=4 border-radius=2 font-size=11 line-height="18px" color=(hoverId == `reset:${f.id}` ? t.text : t.muted) background-color=(hoverId == `reset:${f.id}` ? t.hover : "rgba(0,0,0,0)") aria-label="Reset to default  ·  ⌫"
                            text "↺"
                      text f.placeholder font-size=12 line-height="19px" color=t.muted white-space="pre-wrap"
                    when f.kind == "picker"
                      button press=press(`field:${f.id}`) testId=`field-${f.id}` hover=hover(`field:${f.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=8 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 margin-top=2 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=(hoverId == `field:${f.id}` ? t.hover : t.bg) color=t.text flex-shrink=0
                        text f.value class=Ellipsis max-width=224
                        text "▾" color=t.muted
                    when f.kind == "stepper"
                      row align-items="center" margin-top=2 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=t.bg flex-shrink=0
                        button press=press(`step-down:${f.id}`) testId=`step-down-${f.id}` hover=hover(`step-down:${f.id}`) class=Reset padding-left=8 padding-right=8 border-radius=6 color=(hoverId == `step-down:${f.id}` ? t.text : t.muted) background-color=(hoverId == `step-down:${f.id}` ? t.hover : "rgba(0,0,0,0)")
                          text "−"
                        text f.value width=56 text-align="center" font-family="ui-monospace" font-size=12 line-height="19px"
                        button press=press(`step-up:${f.id}`) testId=`step-up-${f.id}` hover=hover(`step-up:${f.id}`) class=Reset padding-left=8 padding-right=8 border-radius=6 color=(hoverId == `step-up:${f.id}` ? t.text : t.muted) background-color=(hoverId == `step-up:${f.id}` ? t.hover : "rgba(0,0,0,0)")
                          text "+"
                    when f.kind == "toggle"
                      button press=press(`toggle:${f.id}`) testId=`toggle-${f.id}` hover=hover(`toggle:${f.id}`) class=Reset padding-left=12 padding-right=12 padding-top=2 padding-bottom=2 margin-top=2 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=(hoverId == `toggle:${f.id}` ? t.hover : (f.value == "On" ? t.selected : t.bg)) color=(f.value == "On" ? t.accent : t.muted) flex-shrink=0
                        text f.value
                    when f.kind == "text"
                      column width=352 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 margin-top=2 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=t.bg flex-shrink=0 box-sizing="border-box"
                        // GPUI paints placeholders in `muted`; exact2 inputs have no placeholder color, so a text layer stands in.
                        box position="relative" width="100%"
                          when f.value == ""
                            text "Instructions…" position="absolute" top=0 left=0 right=0 font-size=12 line-height="19px" font-family="ui-monospace" color=t.muted class=Ellipsis pointer-events="none"
                          input id=`field-${f.id}` testId=`field-${f.id}` value=f.value input=typed(`field:${f.id}`) placeholder="" focus=press(`focus:${f.id}`) aria-label=f.label width="100%" min-height=22 line-height="19px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-family="ui-monospace" font-size=12 color=t.text box-sizing="border-box"
            when model.status != ""
              text model.status padding-left=16 padding-right=16 padding-bottom=8 font-size=12 line-height="19px" color=t.warn flex-shrink=0
            text model.footer padding-left=16 padding-right=16 padding-bottom=12 font-size=11 line-height="18px" color=t.muted flex-shrink=0
          when model.kind == "form" or model.kind == "quick" or model.kind == "machine-picker" or model.kind == "project-picker" or model.kind == "add-folder" or model.kind == "pair"
            row align-items="center" gap=8 padding-left=16 padding-right=16 padding-top=12
              text model.title flex=1 font-weight=600 class=Ellipsis
              when model.pill != ""
                text model.pill padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 font-size=11 line-height="18px" font-weight=700 color=model.pillColor background-color=`${model.pillColor}2e`
              when model.subtitle != ""
                text model.subtitle font-size=12 line-height="19px" color=t.muted
            when model.status != ""
              text model.status padding-left=16 padding-right=16 padding-top=8 font-size=12 line-height="19px" color=(model.statusError ? t.danger : t.muted)
            scroll max-height=(min(520, windowHeight - 200)) padding-left=16 padding-right=16 padding-top=12 padding-bottom=12
              column gap=8
                each f in model.fields key=f.id
                  column gap=4
                    when f.kind == "text" or f.kind == "prompt" or f.kind == "path" or f.kind == "model"
                      text f.label font-size=11 line-height="18px" color=(f.focused ? t.accent : t.muted)
                      column padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=t.bg
                        // GPUI paints placeholders in `muted`; exact2 inputs have no placeholder color, so a text layer stands in.
                        box position="relative" width="100%"
                          when f.value == ""
                            text f.placeholder position="absolute" top=0 left=0 right=0 font-size=12 line-height="19px" font-family="ui-monospace" color=t.muted class=Ellipsis pointer-events="none"
                          input id=`field-${f.id}` testId=`field-${f.id}` value=f.value input=typed(`field:${f.id}`) placeholder="" focus=press(`focus:${f.id}`) autofocus=f.focused aria-label=f.label width="100%" min-height=(f.multiline ? 68 : 19) line-height="19px" padding=0 border-width=0 background-color="rgba(0,0,0,0)" font-family="ui-monospace" font-size=12 color=t.text box-sizing="border-box"
                      when length(f.suggestions) > 0
                        column
                          each s in f.suggestions key=s.id
                            button press=press(`pick:${s.id}`) hover=hover(`pick:${s.id}`) class=Reset display="flex" padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 border-radius=6 background-color=(s.selected ? t.selected : (hoverId == `pick:${s.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="100%" box-sizing="border-box" font-family="ui-monospace" font-size=12
                              text s.label class=Ellipsis
                    when f.kind == "choice" or f.kind == "picker" or f.kind == "chip"
                      button id=`field-${f.id}` press=pressAt(`field:${f.id}`, `field-${f.id}`) testId=`field-${f.id}` hover=hover(`field:${f.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=4 padding-bottom=4 border-radius=6 border-style="solid" border-width=1 border-color=(f.focused ? t.accent : t.border) background-color=t.bg color=t.text width="100%" box-sizing="border-box"
                        text f.label font-size=11 line-height="18px" color=(f.focused ? t.accent : t.muted) flex-shrink=0
                        text f.value flex=1 class=Ellipsis font-family="ui-monospace" font-size=12
                        text "▾" font-size=11 line-height="18px" color=t.placeholder
                    when f.kind == "toggle" or f.kind == "stepper" or f.kind == "info"
                      row align-items="center" gap=16 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 background-color=(f.focused ? t.selected : "rgba(0,0,0,0)")
                        text f.label flex=1
                        when f.kind == "stepper"
                          button press=press(`step-down:${f.id}`) hover=hover(`step-down:${f.id}`) class=Reset padding-left=8 padding-right=8 border-radius=6 background-color=(hoverId == `step-down:${f.id}` ? t.selected : t.element) color=t.text
                            text "−"
                          text f.value width=48 text-align="center" font-family="ui-monospace" font-size=12
                          button press=press(`step-up:${f.id}`) hover=hover(`step-up:${f.id}`) class=Reset padding-left=8 padding-right=8 border-radius=6 background-color=(hoverId == `step-up:${f.id}` ? t.selected : t.element) color=t.text
                            text "+"
                        when f.kind == "toggle"
                          button press=press(`toggle:${f.id}`) hover=hover(`toggle:${f.id}`) class=Reset padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 background-color=(f.value == "On" ? t.selected : (hoverId == `toggle:${f.id}` ? t.hover : t.element)) color=(f.value == "On" ? t.accent : t.text)
                            text f.value
                        when f.kind == "info"
                          text f.value font-size=12 line-height="19px" color=t.muted
                        when f.hint != ""
                          button press=press(`reset:${f.id}`) hover=hover(`reset:${f.id}`) class=Reset padding-left=6 padding-right=6 border-radius=6 color=(hoverId == `reset:${f.id}` ? t.text : t.muted) aria-label="Reset to default  ·  ⌫"
                            text "↺"
                    when f.kind == "quick-row"
                      button press=press(`pick:${f.id}`) hover=hover(`pick:${f.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=12 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 background-color=(f.focused ? t.surface : (hoverId == `pick:${f.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="100%" box-sizing="border-box"
                        text f.hint font-weight=600 color=t.accent font-family="ui-monospace"
                        text f.label class=Ellipsis
                        when f.value != ""
                          text f.value class=Ellipsis font-size=12 line-height="19px" color=t.muted
                when length(model.rows) > 0
                  column
                    each r in model.rows key=r.id
                      button press=press(`pick:${r.id}`) testId=`pick-${r.id}` hover=hover(`pick:${r.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=12 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=6 background-color=(r.selected ? t.selected : (hoverId == `pick:${r.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="100%" box-sizing="border-box"
                        when r.chip != ""
                          text r.chip width=24 flex-shrink=0 color=t.accent
                        column flex=1 min-width=0
                          text r.label class=Ellipsis color=(r.accent ? t.accent : t.text) font-family=(model.kind == "project-picker" ? "ui-monospace" : "system-ui") font-size=(model.kind == "project-picker" ? 12 : 13)
                          when r.second != ""
                            text r.second class=Ellipsis font-size=12 line-height="19px" color=t.muted
                        when r.detail != ""
                          text r.detail class=Ellipsis font-size=12 line-height="19px" color=t.muted
                when model.body != ""
                  text model.body font-size=12 line-height="19px" color=t.muted white-space="pre-wrap"
            when model.footer != "" or length(model.buttons) > 0
              row align-items="center" gap=8 padding-left=16 padding-right=16 padding-top=8 padding-bottom=12 border-top-style="solid" border-top-width=1 border-top-color=t.border
                text model.footer flex=1 min-width=0 font-size=11 line-height="18px" color=t.muted
                each b in model.buttons key=b.id
                  button press=press(`button:${b.id}`) testId=`button-${b.id}` hover=hover(`button:${b.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=6 padding-left=8 padding-right=8 padding-top=2 padding-bottom=2 border-radius=6 border-style="solid" border-width=1 border-color=(b.primary ? t.accent : t.border) background-color=(hoverId == `button:${b.id}` ? t.selected : (b.primary ? t.accent12 : t.element)) color=t.text opacity=(b.disabled ? 0.5 : 1)
                    text b.label
                    when b.hint != ""
                      text b.hint font-size=11 line-height="18px" color=t.muted
    // ---- The popup menu card (ui.rs:1376): min 208, max 416, py_1; items px_3 py_1 ----
    when popup.kind != ""
      button press=press("popup-close") testId="popup-scrim" class=Reset position="absolute" top=0 left=0 right=0 bottom=0 width="100%" height="100%" aria-label="Close menu"
      // Snapped to the window with an 8 px margin (GPUI `snap_to_window_with_margin`): a card that would overflow hangs from the far edge instead.
      column testId="popup-card" position="absolute" left=(popup.right > 0 or popup.x + 224 > windowWidth ? "auto" : `${popup.x}px`) right=(popup.right > 0 ? `${max(8, windowWidth - popup.right)}px` : (popup.x + 224 > windowWidth ? "8px" : "auto")) top=(popup.y + length(popup.items) * 27 + 16 > windowHeight ? "auto" : `${popup.y}px`) bottom=(popup.y + length(popup.items) * 27 + 16 > windowHeight ? "8px" : "auto") min-width=208 max-width=416 padding-top=4 padding-bottom=4 border-radius=6 border-style="solid" border-width=1 border-color=t.border background-color=t.elevated box-shadow="0 10px 15px rgba(0,0,0,0.1)" role="menu" z-index=2
        when popup.title != ""
          text popup.title padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 font-size=11 line-height="18px" font-weight=700 color=t.accent
        when length(popup.items) == 0
          text popup.empty padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 font-size=12 line-height="19px" color=t.muted
        each item in popup.items key=item.id
          button press=press(`menu:${item.id}`) testId=`menu-${item.id}` hover=hover(`menu:${item.id}`) class=Reset display="flex" flex-direction="row" align-items="center" gap=8 padding-left=12 padding-right=12 padding-top=4 padding-bottom=4 font-size=12 line-height="19px" background-color=(item.selected ? t.selected : (hoverId == `menu:${item.id}` ? t.hover : "rgba(0,0,0,0)")) color=t.text width="100%" box-sizing="border-box" role="menuitem" opacity=(item.disabled ? 0.5 : 1)
            when item.checkable
              text (item.checked ? "✓" : "") width=12 flex-shrink=0 color=t.accent
            when item.icon != ""
              Icon(name=item.icon, size=13, color=t.text)
            text item.label flex=1 class=Ellipsis
            when item.hint != ""
              text item.hint flex-shrink=0 font-size=10 line-height="16px" color=t.placeholder
