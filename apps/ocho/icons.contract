        path d="m8 21-4-4 4-4" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M4 17h16" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
    when name == "chevron-down"
      svg width=size height=size viewBox="0 0 24 24" flex-shrink=0
        path d="m6 9 6 6 6-6" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
