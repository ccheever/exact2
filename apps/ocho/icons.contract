// Lucide icons (ISC), the 24 the GPUI Ocho embeds (main.rs:79-154) plus its
// iMessage bubble, as inline SVG: 24-unit view box, stroked in `color` at
// width 2, round caps and joins, scaled to `size`. One component, chosen by name.
component Icon
  props
    name: string
    size: number
    color: string
  view
    when name == "archive-restore"
      svg width=size height=size viewBox="0 0 24 24" flex-shrink=0
        rect width="20" height="5" x="2" y="3" rx="1" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M4 8v11a2 2 0 0 0 2 2h2" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M20 8v11a2 2 0 0 1-2 2h-2" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="m9 15 3-3 3 3" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M12 12v9" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
    when name == "archive"
      svg width=size height=size viewBox="0 0 24 24" flex-shrink=0
        rect width="20" height="5" x="2" y="3" rx="1" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
        path d="M10 12h4" fill="none" stroke=color stroke-width=2 stroke-linecap="round" stroke-linejoin="round"
    when name == "arrow-right-left"
