  active: bool
  ancestor: bool
  status: string
  statusMarkdown: bool
  working: bool
  workingGlyph: string
  workingHead: string
  workingHeadColor: string
  workingRest: string
  imessage: bool
  number: string
  dropBefore: bool
  dropAfter: bool
  dropInto: bool
shape RailModel
  width: number
  nav: bool
  pages: list<RailPage>
  tabs: list<RailTab>
  hint: string
  updateLabel: string
  updateTip: string
  selectedTab: string
  resizing: bool
shape RowAction
  id: string
