// Ocho — a client for Fleet: your machines, your sessions, in one window.
// A 1:1 port of the GPUI desktop (fleet/desktop, origin/main e577272).
//
// The model lives in the Rust data source (`data/`): every event the window
// sees goes to `dispatch`, and `view` is what the model wants painted. The
// app's native module (`modules/`) runs the fleet feed, the fleet CLI, the
// desktop.json mirror and each tab's terminal (`<ghostty-terminal>`).

use Icon from "./icons.contract"
use Rail from "./rail.contract"
use SecretsSidebar from "./secrets.contract"
use SecretAlertCard from "./secrets.contract"
use Manager from "./manager.contract"
use Overlays from "./overlays.contract"
use TabBody from "./terminal.contract"
use Ellipsis from "./theme.contract"
use Pill from "./theme.contract"
use Reset from "./theme.contract"

// ---- The view-model, field for field with data/src/shapes.rs ----

shape Ui
  version: number
  io: number
shape Version
  version: number
shape Theme
  name: string
  dark: bool
  bg: string
  surface: string
  elevated: string
  element: string
  border: string
  text: string
  muted: string
  placeholder: string
  accent: string
  warn: string
  danger: string
  good: string
  selected: string
  hover: string
  termBg: string
  termFg: string
  cursor: string
  statusBar: string
  selectedBg: string
  hoverBg: string
  accent09: string
  accent12: string
  accent15: string
  accent16: string
  accent18: string
  accent35: string
  accent55: string
  warn60: string
  warn70: string
  muted70: string
  border72: string
  backdrop: string
shape RailPage
  id: string
  title: string
  icon: string
  count: string
  selected: bool
shape RailTab
  key: string
  slug: string
  title: string
  machine: string
  badge: string
