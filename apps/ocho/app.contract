  disabled: bool
shape Overlay
  kind: string
  width: number
  top: bool
  title: string
  subtitle: string
  pill: string
  pillColor: string
  glyph: string
  placeholder: string
  query: string
  status: string
  statusError: bool
  rows: list<PickerRow>
  index: number
  footer: string
  body: string
  bodyMarkdown: bool
  fields: list<Field>
  buttons: list<Button>
  hint: string
  focusId: string
shape TabView
  key: string
  title: string
  argv: list<string>
  argvJson: string
  machine: string
  cwd: string
  readOnly: bool
  strip: string
  stripLabel: string
  stripDetail: string
  stripColor: string
  stripRetry: bool
  exitBanner: string
  limited: bool
  limitedStatus: string
  limitedProvider: string
  overlay: string
  overlayTitle: string
  overlayDetail: string
  overlayButtons: list<Button>
  overlayNote: string
  panelOpen: bool
  panelArgv: list<string>
