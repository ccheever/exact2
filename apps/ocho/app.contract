  label: string
  hint: string
shape Meter
  label: string
  percent: number
  text: string
  reset: string
  color: string
shape Row
  id: string
  header: string
  badge: string
  badgeColor: string
  badgeBg: string
  title: string
  imessage: bool
  prs: list<string>
  lines: list<string>
  firstLine: string
  markdownLine: number
  attention: bool
  working: bool
  workingGlyph: string
  workingHead: string
  workingHeadColor: string
  workingRest: string
  usage: list<Meter>
  usageNote: string
  archived: bool
  selected: bool
  actions: list<RowAction>
shape ManagerModel
  page: string
  title: string
  filterSummary: string
  query: string
  searching: bool
  primary: string
  primaryHint: string
  rows: list<Row>
  empty: string
  selected: number
  focused: bool
  viewOpen: bool
shape MenuItem
  id: string
  label: string
  icon: string
  hint: string
  checked: bool
  checkable: bool
  selected: bool
  disabled: bool
shape Popup
  kind: string
