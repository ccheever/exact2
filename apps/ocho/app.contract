shape QrRow
  id: string
  cells: list<QrCell>
shape IMessagePair
  visible: bool
  title: string
  state: string
  loading: string
  error: string
  instructions: string
  qr: list<QrRow>
  code: string
  sendTo: string
  sendFrom: string
  url: string
  retry: bool
shape SecretLifetime
  id: string
  label: string
  seconds: number
  selected: bool
shape SecretRequestCard
  id: string
  requestId: string
  name: string
  reason: string
  status: string
  statusColor: string
  editing: bool
  entry: bool
  actions: bool
  revoke: bool
  openId: string
  dismissId: string
  revokeId: string
  provideId: string
  cancelId: string
shape SecretAlert
  visible: bool
  title: string
  name: string
  reason: string
  openLabel: string
shape SecretRequests
  visible: bool
  title: string
  pending: string
  demo: string
  error: string
  empty: string
  cards: list<SecretRequestCard>
  masked: string
  placeholder: string
  focused: bool
  provideLabel: string
  lifetimes: list<SecretLifetime>
  busy: bool
  reset: string
  alert: SecretAlert
shape View
  theme: Theme
  windowTitle: string
  loaded: bool
  rail: RailModel
  manager: ManagerModel
  onTab: bool
  tab: TabView
  overlay: Overlay
  popup: Popup
  toast: Toast
  focusId: string
  scrollTo: string
  uiFontSize: number
  termFontSize: number
  region: string
  whatsNew: WhatsNew
  pairing: IMessagePair
  secrets: SecretRequests
shape Media
  prefersColorScheme: string
  width: number
  height: number

// ---- Styles: GPUI's spacing at 16 px per rem (theme.rs:325) ----

component Ocho
  mutation ui as shape Ui
  state hoverId = ""
  state drag = ""
  state clock = 0
  resource media = exactViewport() as shape Media
  resource feed = feed() as shape Version
  resource desktop = desktop() as shape Version
  derive uiVersion = match ui { case some(r) => r.version, case none => 0 }
  derive uiIo = match ui { case some(r) => r.io, case none => 0 }
  resource io = io(uiIo) as shape Version
  resource vm = picture(uiVersion, feed.version, desktop.version, io.version) as shape View
  derive t = vm.theme

  // Every event is one `dispatch(kind, a, b, x, y)`; the model answers the
  // counters and `view` follows (LLP 1016: a resource re-asked by its args).
  action press(id: string) writes ui
    send ui = dispatch("press", id, "", 0, 0)
  // A press that opens a popup carries its trigger's frame (LLP 1051 `frame`),
  // so the card can hang off the trigger as GPUI's anchored popups do.
  action pressAt(id: string, anchor: string) writes ui
    send ui = dispatch("press-at", id, "", frame(anchor).x, frame(anchor).y)
  // The keys that move focus are the manager's `/` (⌘F too, below) into the
  // search box and Enter / Escape out of it: the model decides the rest.
  action keyDown(name: string) writes ui
    send ui = dispatch("key", name, "", 0, 0)
    if name == "/" and not vm.onTab and vm.overlay.kind == "" and vm.popup.kind == ""
      focus("search")
  action searchKeyDown(name: string) writes ui
    send ui = dispatch("key-at", name, "search", 0, 0)
    if name == "Enter" or name == "Escape"
      focus("manager")
  action focusSearch writes ui
    send ui = dispatch("press", "key:meta+f", "", 0, 0)
    focus("search")
  action overlayKeyDown(name: string) writes ui
    send ui = dispatch("key-at", name, "overlay", 0, 0)
  action terminalKeyDown(name: string) writes ui
    send ui = dispatch("key-at", name, "terminal", 0, 0)
  action terminalExited(message: string) writes ui
    send ui = dispatch("press", `terminal:${message}`, "", 0, 0)
  action typed(id: string, value: string) writes ui
    send ui = dispatch("input", id, value, 0, 0)
  action hover(id: string, on: bool) writes ui, hoverId
    hoverId = (on ? id : "")
    send ui = dispatch("hover", id, (on ? "true" : "false"), 0, 0)
  action panned(id: string, dx: number, dy: number) writes ui
    send ui = dispatch("pan", id, "", dx, dy)
  action doubleClick(id: string) writes ui
    send ui = dispatch("dblclick", id, "", 0, 0)
  // A right-click has no pointer position in Contract (LLP 1005 §5): the menu
  // opens a little inside the node's own frame instead.
  action contextMenu(id: string, anchor: string) writes ui
    send ui = dispatch("contextmenu", id, "", frame(anchor).x + 24, frame(anchor).y + 24)
  // One tick a second (workspace.rs: toasts fade, indicators animate, the
  // window's size rides along so the rail's clamp knows it).
  action tick writes ui, clock
    clock = now()
    send ui = dispatch("tick", `${now()}`, "", media.width, media.height)
  task ticker mount
    every(1000, tick)

  view
    main testId="ocho" viewport-fit="cover" key=keyDown display="flex" flex-direction="column" position="relative" width="100%" height="100%" font-family="system-ui" font-size=13 line-height="21px" color=t.text background-color=t.bg overflow="hidden"
      row flex=1 min-height=0
        Rail(model=vm.rail, t=t, hoverId=hoverId, press=press, hover=hover, panned=panned, doubleClick=doubleClick, contextMenu=contextMenu)
        column flex=1 min-width=0 min-height=0
          when vm.onTab
            TabBody(model=vm.tab, t=t, appearance=(t.dark ? "dark" : "light"), hoverId=hoverId, press=press, hover=hover, terminalKeyDown=terminalKeyDown, exited=terminalExited)
          else
            Manager(model=vm.manager, t=t, hoverId=hoverId, press=press, pressAt=pressAt, hover=hover, typed=typed, searchKeyDown=searchKeyDown, doubleClick=doubleClick, contextMenu=contextMenu)
        when vm.secrets.visible
          SecretsSidebar(model=vm.secrets, t=t, hoverId=hoverId, press=press, hover=hover, typed=typed)
      when vm.secrets.alert.visible
        SecretAlertCard(model=vm.secrets.alert, t=t, hoverId=hoverId, press=press, hover=hover)
      // The toast (ui.rs:1932): bottom right, 464 wide at most.
      when vm.toast.text != ""
        column position="absolute" right=0 bottom=0 width="100%" max-width=464 padding=12 box-sizing="border-box"
          row align-items="flex-start" gap=8 min-width=0 padding-left=12 padding-right=12 padding-top=8 padding-bottom=8 border-radius=8 background-color=t.statusBar border-style="solid" border-width=1 border-color=t.border box-shadow="0 10px 15px rgba(0,0,0,0.1)" font-size=12 line-height="19px" color=(vm.toast.error ? t.warn : t.text)
            scroll flex=1 min-width=0 max-height=160
              text vm.toast.text
            when vm.toast.dismissible
              button press=press("toast-dismiss") testId="toast-dismiss" hover=hover("toast-dismiss") class=Reset color=(hoverId == "toast-dismiss" ? t.text : t.muted) padding-left=4 padding-right=4
                text "×"
      Overlays(model=vm.overlay, popup=vm.popup, whatsNew=vm.whatsNew, pairing=vm.pairing, t=t, hoverId=hoverId, windowWidth=media.width, windowHeight=media.height, press=press, pressAt=pressAt, hover=hover, typed=typed, overlayKeyDown=overlayKeyDown)
      // ⌘ chords the app declares reach the model as `key:` presses: the
      // key handler above sees bare keys only (LLP 1005 §5).
      // A 1 px transparent button each, in a strip under the traffic lights, so a
      // drive can press the chords too (`tap key-meta-p`); nothing paints.
      row position="absolute" bottom=8 left=8 flex-wrap="wrap" width=96 gap=0
        button press=press("key:meta+p") testId="key-meta-p" aria-keyshortcuts="Meta+P" aria-label="Command palette" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+p") testId="key-meta-shift-p" aria-keyshortcuts="Meta+Shift+P" aria-label="Command palette" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+p") testId="key-meta-alt-p" aria-keyshortcuts="Meta+Alt+P" aria-label="Open session for PR" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+f") testId="key-meta-shift-f" aria-keyshortcuts="Meta+Shift+F" aria-label="Find session by topic" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+n") testId="key-meta-n" aria-keyshortcuts="Meta+N" aria-label="Launch session" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+n") testId="key-meta-shift-n" aria-keyshortcuts="Meta+Shift+N" aria-label="Quick launch" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+w") testId="key-meta-w" aria-keyshortcuts="Meta+W" aria-label="Close tab" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+t") testId="key-meta-shift-t" aria-keyshortcuts="Meta+Shift+T" aria-label="Reopen closed tab" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+r") testId="key-meta-r" aria-keyshortcuts="Meta+R" aria-label="Refresh" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+]") testId="key-meta-shift-rbracket" aria-keyshortcuts="Meta+Shift+]" aria-label="Next tab" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+[") testId="key-meta-shift-lbracket" aria-keyshortcuts="Meta+Shift+[" aria-label="Previous tab" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+0") testId="key-meta-0" aria-keyshortcuts="Meta+0" aria-label="Manager" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+1") testId="key-meta-1" aria-keyshortcuts="Meta+1" aria-label="Terminal 1" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+2") testId="key-meta-2" aria-keyshortcuts="Meta+2" aria-label="Terminal 2" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+3") testId="key-meta-3" aria-keyshortcuts="Meta+3" aria-label="Terminal 3" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+4") testId="key-meta-4" aria-keyshortcuts="Meta+4" aria-label="Terminal 4" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+5") testId="key-meta-5" aria-keyshortcuts="Meta+5" aria-label="Terminal 5" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+6") testId="key-meta-6" aria-keyshortcuts="Meta+6" aria-label="Terminal 6" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+7") testId="key-meta-7" aria-keyshortcuts="Meta+7" aria-label="Terminal 7" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+8") testId="key-meta-8" aria-keyshortcuts="Meta+8" aria-label="Terminal 8" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+9") testId="key-meta-9" aria-keyshortcuts="Meta+9" aria-label="Terminal 9" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+t") testId="key-meta-alt-t" aria-keyshortcuts="Meta+Alt+T" aria-label="Toggle transcript" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+k") testId="key-meta-k" aria-keyshortcuts="Meta+K" aria-label="Clear scrollback" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+.") testId="key-meta-period" aria-keyshortcuts="Meta+." aria-label="Interrupt" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+,") testId="key-meta-comma" aria-keyshortcuts="Meta+," aria-label="Settings" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+z") testId="key-meta-z" aria-keyshortcuts="Meta+Z" aria-label="Undo" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+/") testId="key-meta-slash" aria-keyshortcuts="Meta+/" aria-label="Help" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+shift+e") testId="key-meta-shift-e" aria-keyshortcuts="Meta+Shift+E" aria-label="Enter NAV" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=focusSearch testId="key-meta-f" aria-keyshortcuts="Meta+F" aria-label="Search" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:ctrl+d") testId="key-ctrl-d" aria-keyshortcuts="Control+D" aria-label="Half page down" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:ctrl+u") testId="key-ctrl-u" aria-keyshortcuts="Control+U" aria-label="Half page up" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:shift+tab") testId="key-shift-tab" aria-keyshortcuts="Shift+Tab" aria-label="Previous page" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+1") testId="key-meta-alt-1" aria-keyshortcuts="Meta+Alt+1" aria-label="Profile 1" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+2") testId="key-meta-alt-2" aria-keyshortcuts="Meta+Alt+2" aria-label="Profile 2" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+3") testId="key-meta-alt-3" aria-keyshortcuts="Meta+Alt+3" aria-label="Profile 3" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+4") testId="key-meta-alt-4" aria-keyshortcuts="Meta+Alt+4" aria-label="Profile 4" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+5") testId="key-meta-alt-5" aria-keyshortcuts="Meta+Alt+5" aria-label="Profile 5" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+6") testId="key-meta-alt-6" aria-keyshortcuts="Meta+Alt+6" aria-label="Profile 6" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+7") testId="key-meta-alt-7" aria-keyshortcuts="Meta+Alt+7" aria-label="Profile 7" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+8") testId="key-meta-alt-8" aria-keyshortcuts="Meta+Alt+8" aria-label="Profile 8" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
        button press=press("key:meta+alt+9") testId="key-meta-alt-9" aria-keyshortcuts="Meta+Alt+9" aria-label="Profile 9" class=Reset width=2 height=2 flex-shrink=0
          box width=2 height=2
