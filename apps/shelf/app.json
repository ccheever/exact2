{
  "$schema": "../../scripts/app.schema.json",
  "name": "Shelf",
  "short_name": "Shelf",
  "id": "com.exact.shelf",
  "start_url": "/",
  "display": "standalone",
  "shortcuts": [
    {
      "name": "Add Book",
      "url": "/add",
      "apple": {
        "symbol": "plus"
      }
    }
  ],
  "intents": {
    "entities": {
      "book": { "title": "Book" }
    },
    "tools": {
      "logPages": {
        "title": "Log Pages",
        "parameters": {
          "id": { "title": "Book", "entity": "book" },
          "page": { "title": "Page", "type": "integer" }
        },
        "apple": { "phrases": ["Log pages in ${applicationName}"] }
      },
      "addToShelf": {
        "title": "Add to Shelf",
        "parameters": {
          "title": { "title": "Title" },
          "author": { "title": "Author" },
          "pages": { "title": "Pages", "type": "integer" }
        }
      }
    }
  },
  "app": {
    "id": "com.exact.shelf",
    "name": "Shelf"
  },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": [
        "iphone",
        "ipad"
      ]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": {
        "width": 900,
        "height": 700
      }
    },
    "windows": {
      "painter": "ink",
      "window": {
        "width": 1024,
        "height": 720,
        "minWidth": 360,
        "minHeight": 500
      }
    },
    "web": {}
  },
  "deploy": {
    "store": {
      "web": "0",
      "macos": "0",
      "ios": "0",
      "linux": "0",
      "windows": "0"
    }
  },
  "widgets": [
    {
      "kind": "library",
      "title": "Your Shelf",
      "description": "Your book count and latest addition.",
      "families": [
        "systemSmall",
        "accessoryRectangular"
      ],
      "component": "ShelfWidget",
      "props": "ShelfWidgetProps",
      "refresh": "widgetLibrary",
      "preview": {
        "count": 7,
        "latest": "The Dispossessed"
      }
    }
  ]
}
