// Shelf: a reading tracker, and the recipe for an iPhone app in Exact. Copy from
// here (LLP 1115, "write the web, ship the platform").
//
// Say what a thing is; leave how it looks unsaid. This file writes no colour and
// no font size or weight: where it must, it names a role (`-exact-secondary-label`,
// `-exact-fill`, `AccentColor`) or a text style (`role="heading"`
// with an `aria-level`, `font="-exact-footnote"`), and `bun scripts/no-tells.mjs
// shelf` fails on anything else. The platform supplies the rest, and on iOS:
//
// - each route's `header` is its navigation bar: a level-1 heading the large
//   title, a level-2 one the inline title, its buttons the bar items, its
//   `input type="search"` the bar's search field;
// - the root `tablist` is the tab bar, a `tablist` in the content a segmented
//   control, `list appearance="auto"` a grouped list (Settings' look);
// - a `list` is a plain list, each child of it a row: the separators, the
//   press and a tapped row staying selected under the screen it pushed are
//   the platform's, and this file draws none of them (a filter or a heading
//   that is no row stands outside the list);
// - a `modal` route is a sheet; a pushed route gets the system Back button and
//   edge swipe, and the sheet swipes down, with nothing written for either;
// - `dialog role="alertdialog"` is the system alert, `contextPopover` the
//   long-press menu, `delete=` the row's swipe to delete, `refresh=` the
//   pull-to-refresh, `progress` the activity indicator, and `progress value=`
//   the progress bar.
//
// The tint is the platform's: the app names none, so every bar button, control,
// selected tab and star is the system's accent. (A root `accent-color` is the one
// place to set an app's tint: on iOS it is the window's tint, so bars, sheets and
// alerts take it too.) Layout (flex, gap, padding) is
// CSS and the author's; the web host draws the same file as a web page.
//
// The camera, barcodes and text come from packages (LLP 1133.027 §10): Scan
// Barcode reads a book's ISBN off the back camera and looks it up; Add Quote
// from Photo reads a page's text into the notes. Each is shown only where its
// package says it works here.

use getSupportedFormats, detectedBarcodes, BarcodeFormats, BarcodeScan from "@exact/barcode-detection"
use textDetectorAvailability, detectText, TextDetectorAvailability, DetectedTextList from "@exact/text-detection"
use getUserMedia, stopTrack, cameraStatus, MediaStream, MediaStreamTrack, CameraStatus, MediaTrackConstraints from "@exact/media-capture"
use takePhoto, Photo from "@exact/camera"

use setAppShortcuts, ShortcutItem from "@exact/quick-actions"
use setContentIndex, ContentDescription from "@exact/search-index"

routes nav
  tab library "/"
    book "/book/:id"
    quote "/quote/:id"
    add "/add"
    scan "/add/scan"
  tab discover "/discover"
  tab stats "/stats"

shape Book
  id: string
  title: string
  author: string
  pages: number
  currentPage: number
  status: string
  rating: number
  notes: string
  addedAt: number
  coverUrl: string
  sourceKey: string
  quotes: number

shape Library
  ready: bool
  books: Book[]
  goal: number
  pagesRead: number
  avgText: string

shape Ack
  ok: bool

shape Work
  key: string
  title: string
  author: string
  pages: number
  coverUrl: string

shape Subject
  ok: bool
  error: string
  works: Work[]

shape Time
  epochAtZero: number
  locale: string

// What Open Library has for an ISBN.
shape Found
  isbn: string
  found: bool
  title: string
  author: string
  pages: number

fn statusLabel(s: string): string = s == "want" ? "Want to Read" : (s == "reading" ? "Reading" : "Finished")
fn percent(cur: number, total: number): number = total > 0 ? round(cur / total * 100) : 0
fn matches(b: Book, f: string, q: string): bool = (f == "all" or b.status == f) and (q == "" or b.title.toLowerCase().includes(q) or b.author.toLowerCase().includes(q))
fn wholePages(text: string): bool = match parseNumber(text) { case some(n) => floor(n) == n and n > 0 and n <= 10000, case none => false }
fn pagesValue(text: string): number = match parseNumber(text) { case some(n) => n, case none => 0 }
fn countText(n: number, one: string, many: string): string = n == 1 ? `1 ${one}` : `${n} ${many}`
fn lineAt(lines: string[], i: number): string = match lines.at(i) { case some(x) => x, case none => "" }
fn digitAt(s: string, i: number): number = match parseNumber(s.slice(i, i + 1)) { case some(n) => n, case none => -1 }
// An ISBN-13: 978 or 979, thirteen digits, and its check digit (weights 1 and 3).
fn isIsbn(s: string): bool = s.length == 13 and (s.startsWith("978") or s.startsWith("979")) and range(13).filter(i => digitAt(s, i) < 0).length == 0 and sum(range(13).map(i => digitAt(s, i) * (i % 2 == 0 ? 1 : 3))) % 10 == 0

component Shelf
  state query = ""
  state filter = "all"
  // The book a long press or Remove is about, for the alert.
  state aimed = ""
  state draftTitle = ""
  state draftAuthor = ""
  state draftPages = ""
  state draftStatus = "want"
  state submitted = false
  state subject = "science_fiction"
  // The scan's camera track, and the ISBNs Try Again passed over.
  state scanTrack = ""
  state skipped: string[] = []
  // The book a quote is for, and the lines turned off in the quote sheet.
  state quoteBook = ""
  state quoteOff: number[] = []

  resource time = exactTime() as shape Time
  resource lib = library() as shape Library else empty(ready=false, goal=12, avgText="—")
  resource works = subjectWorks(subject) as shape Subject else empty(ok=true)
  mutation changed as shape Ack queue refreshes lib
  // The tools' own: a call's `fails when` reads its reply, never a page
  // turn the person made while the call waited for `lib`.
  mutation logged as shape Ack queue refreshes lib
  resource formats = getSupportedFormats() as shape BarcodeFormats else empty()
  resource camera = cameraStatus() as shape CameraStatus else empty()
  resource scan = detectedBarcodes(track=scanTrack, formats=["ean_13"]) as shape BarcodeScan else empty()
  resource lookup = bookByIsbn(isbn) as shape Found else empty()
  resource readerAny = textDetectorAvailability() as shape TextDetectorAvailability else empty()
  resource reader = textDetectorAvailability(languages=quoteLanguages) as shape TextDetectorAvailability else empty()
  mutation opened as shape MediaStream then arm
  mutation stopped as shape MediaStreamTrack
  mutation quoted as shape DetectedTextList then showQuote

  derive current = top(nav)
  derive visible = lib.books.filter(b => matches(b, filter, query.trim().toLowerCase()))
  derive aimedTitle = match first(lib.books.filter(b => b.id == aimed)) { case some(b) => b.title, case none => "This book" }
  derive finished = lib.books.filter(b => b.status == "done").length
  derive owned = lib.books.map(b => b.sourceKey)
  derive titleError = draftTitle.trim() == "" ? "Enter a title." : ""
  derive pagesError = draftPages == "" or wholePages(draftPages) ? "" : "Pages must be a whole number from 1 to 10,000."
  derive reading = lib.books.filter(b => b.status == "reading")
  derive indexKey = lib.books.map(b => `${b.id}|${b.title}|${b.author}|${b.status}`).join("\n")

  // The system's ways in (LLP 1133.023 §11): every book in its search, and
  // the newest book being read on the icon's menu, after the manifest's Add
  // Book. Set once the library has loaded, so the empty placeholder never
  // clears what the last launch set.
  task index when lib.ready key=indexKey
    after(1, reindex)
  action reindex
    setContentIndex(kind="book", entries=lib.books.map(b => ContentDescription(id=b.id, kind=none, title=b.title, description=some(b.author),
      category=none, icons=none, url=`/book/${b.id}`, apple=none)))
    setAppShortcuts(shortcuts=reading.slice(0, 1).map(b => ShortcutItem(name=`Continue ${b.title}`,
      short_name=some(b.title), description=none, url=`/book/${b.id}`, icons=none, apple=none, android=none)))
  derive canScan = formats.tracks and formats.formats.includes("ean_13") and camera.available
  derive backCamera = MediaTrackConstraints(deviceId=none, groupId=none, facingMode=some("environment"), width=none, height=none, aspectRatio=none, frameRate=none, resizeMode=none, zoom=none, torch=none, sampleRate=none, sampleSize=none, channelCount=none, echoCancellation=none, autoGainControl=none, noiseSuppression=none, latency=none)
  // The first ISBN the scan has seen that Try Again did not pass over.
  derive isbn = scanTrack == "" ? "" : match first(scan.seen.filter(s => isIsbn(s.rawValue) and not skipped.includes(s.rawValue))) { case some(s) => s.rawValue, case none => "" }
  // The person's language and English; the platform's default where it reads neither.
  derive quoteLanguages = [time.locale, "en"]
  derive canQuote = readerAny.availability == "available"
  derive quoteLines = match quoted { case some(q) => q.texts.map(t => t.rawValue), case none => [] }
  derive quoteChosen = range(quoteLines.length).filter(i => not quoteOff.includes(i)).map(i => lineAt(quoteLines, i))

  // What Shortcuts, Siri and an agent may do (LLP 1111 D2; LLP 1133.023
  // §11); app.json's `intents` gives each its face.
  tool logPages writes idempotent closed "Set the page you're on in a book." = logPages
    fails when match logged { case some(a) => not a.ok, case none => false }
  tool addToShelf writes additive closed "Add a book to your shelf." = addTitled
    fails when match logged { case some(a) => not a.ok, case none => false }
  action logPages(id: string, page: number)
    send logged = setPage(id, page)
  action addTitled(title: string, author: string, pages: number)
    send logged = addBook(title, author, pages, "want", "", "", time.epochAtZero + performanceNow())

  // Navigation: a tab, a location (a book's row is a link to its route; the
  // browser's Back, Forward and a deep link arrive here too), a sheet, and
  // Back (also what the platform's own Back button, edge swipe and sheet
  // swipe-down press).
  action pick(name: string)
    nav = select(nav, name)
  action follow(url: string)
    nav = go(nav, url)
  action back
    if current.name == "scan"
      endTrack()
    nav = back(nav)
  action openAdd
    draftTitle = ""
    draftAuthor = ""
    draftPages = ""
    draftStatus = "want"
    submitted = false
    nav = push(nav, "/add")

  // Library
  action search(v: string)
    query = v
  action show(f: string)
    filter = f
  action aim(id: string)
    aimed = id
  // A destructive choice asks first: the system alert, from any action.
  action askRemove(id: string)
    aimed = id
    showModal("remove")
  action askRemoveAimed
    showModal("remove")
  action remove
    if current.name == "book"
      nav = back(nav)
    send changed = removeBook(aimed)
  // A full swipe is its own confirmation, as in Mail.
  action swipeRemove(id: string)
    send changed = removeBook(id)

  // The add sheet
  action editTitle(v: string)
    draftTitle = v
  action editAuthor(v: string)
    draftAuthor = v
  action editPages(v: string)
    draftPages = v
  action chooseDraftStatus(s: string)
    draftStatus = s

  // Scan Barcode: the back camera, a screen inside the add sheet, and the lookup.
  action openScan
    skipped = []
    send opened = getUserMedia(video=true, videoConstraints=backCamera)
    nav = push(nav, "/add/scan")
  // The camera opened; if the scan screen was left while it was asked, it stops.
  action arm
    match opened
      case some(s)
        let track = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
        if current.name == "scan"
          scanTrack = track
        else if track != ""
          send stopped = stopTrack(track=track)
      case none
        scanTrack = ""
  action endTrack
    if scanTrack != ""
      send stopped = stopTrack(track=scanTrack)
    scanTrack = ""
  action endScan
    endTrack()
    nav = back(nav)
  action useBook
    draftTitle = lookup.title
    draftAuthor = lookup.author
    draftPages = lookup.pages > 0 ? `${lookup.pages}` : ""
    endScan()
  action tryAgain
    skipped = skipped.concat([isbn])
  action save
    submitted = true
    if titleError == "" and pagesError == ""
      let author = draftAuthor.trim() == "" ? "Unknown author" : draftAuthor.trim()
      send changed = addBook(draftTitle.trim(), author, pagesValue(draftPages), draftStatus, "", "", time.epochAtZero + performanceNow())
      nav = back(nav)

  // A book
  action setStatus(id: string, s: string)
    send changed = setStatus(id, s)
  action turnTo(id: string, page: number)
    send changed = setPage(id, page)
  action rate(id: string, n: number)
    send changed = setRating(id, n)
  action keepNotes(id: string, text: string)
    send changed = setNotes(id, text)

  // Add Quote from Photo: a picked image's lines, in a sheet, into the notes.
  action chooseQuote(id: string)
    quoteBook = id
    showPicker("quote-photo")
  action quotePicked(files: Picked[])
    match files.at(0)
      case some(f)
        if reader.availability == "available"
          send quoted = detectText(image=f.path, languages=quoteLanguages)
        else
          send quoted = detectText(image=f.path)
      case none
        quoteBook = quoteBook
  action showQuote
    quoteOff = []
    nav = push(nav, path("quote", quoteBook))
  action toggleLine(i: number, on: bool)
    quoteOff = on ? quoteOff.filter(x => x != i) : quoteOff.concat([i])
  action addQuote
    if quoteChosen.length > 0
      send changed = appendQuote(quoteBook, `“${quoteChosen.join(" ")}”`)
    nav = back(nav)

  // Discover
  action chooseSubject(s: string)
    subject = s
  action reload
    refresh works
  action addWork(w: Work)
    send changed = addBook(w.title, w.author, w.pages, "want", w.coverUrl, w.key, time.epochAtZero + performanceNow())

  // Stats
  action goalBy(d: number)
    send changed = setGoal(lib.goal + d)

  view
    main testId="shelf"
      navigationKey=`${current.id}`
      navigationBack="back"
      navigate=follow
      width="100%"
      height="100%"
      display="flex"
      flex-direction="column"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key = t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for e in t.stack key = e.id
              if e.name == "library"
                column navigationKey=`${e.id}`
                  navigationScroll="library-list"
                  testId="route-library"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex"
                    flex-wrap="wrap"
                    align-items="center"
                    gap=8
                    padding="8px 16px"
                    text "Library" role="heading" aria-level=1 flex=1
                    button press=openAdd aria-label="Add Book" testId="add-book"
                      image "symbol:add"
                    input type="search"
                      value=query
                      input=search
                      placeholder="Search"
                      aria-label="Search title or author"
                      testId="search"
                      width="100%"
                  row role="tablist" aria-label="Filter" testId="filter" margin="8px 16px"
                    button role="tab"
                      aria-selected=(filter == "all")
                      press=show("all")
                      testId="filter-all"
                      flex=1
                      text "All"
                    button role="tab"
                      aria-selected=(filter == "reading")
                      press=show("reading")
                      testId="filter-reading"
                      flex=1
                      text "Reading"
                    button role="tab"
                      aria-selected=(filter == "want")
                      press=show("want")
                      testId="filter-want"
                      flex=1
                      text "Want"
                    button role="tab"
                      aria-selected=(filter == "done")
                      press=show("done")
                      testId="filter-done"
                      flex=1
                      text "Finished"
                  // Each child of the list is a row, with the platform's separator.
                  // What is in the list and is no row says so: an edge written
                  // `none` is the author's, and no separator is drawn there.
                  list id="library-list" testId="library-list" flex=1 min-height=0
                    for b in visible key = b.id
                      BookRow(book=b, aim=aim, swipeRemove=swipeRemove)
                    if lib.ready and visible.length == 0
                      column border-top="none" border-bottom="none"
                        Empty(
                          title=(lib.books.length == 0 ? "No Books" : "No Results"),
                          message=(lib.books.length == 0 ? "Tap + to add the first book on your shelf." : "Try another search or filter."),
                          tid="library-empty"
                        )
                    if visible.length > 0
                      text `${visible.length} of ${countText(lib.books.length, "book", "books")}` testId="library-count"
                        font="-exact-footnote"
                        color="-exact-secondary-label"
                        text-align="center"
                        padding=16
                        border-bottom="none"
                  // The long-press menu every row names (`contextPopover`).
                  column id="book-menu" popover="auto" role="menu" aria-label="Book"
                    button press=askRemoveAimed
                      destructive=true
                      popovertarget="book-menu"
                      popovertargetaction="hide"
                      testId="menu-remove"
                      image "symbol:delete"
                      text "Remove…"
              if e.name == "book"
                column navigationKey=`${e.id}`
                  navigationScroll="book-list"
                  testId="route-book"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex" align-items="center" padding="8px 16px"
                    text (match first(lib.books.filter(b => b.id == e.params.id)) { case some(b) => b.title, case none => "" }) role="heading"
                      aria-level=2
                  list id="book-list"
                    appearance="auto"
                    listStyle="inset-grouped"
                    testId="book-detail"
                    flex=1
                    min-height=0
                    for b in lib.books.filter(x => x.id == e.params.id) key = b.id
                      BookSections(
                        book=b,
                        setStatus=setStatus,
                        turnTo=turnTo,
                        rate=rate,
                        keepNotes=keepNotes,
                        askRemove=askRemove,
                        canQuote=canQuote,
                        chooseQuote=chooseQuote
                      )
              if e.name == "quote"
                column navigationKey=`${e.id}`
                  navigationPresentation="modal"
                  navigationScroll="quote-lines"
                  testId="route-quote"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex"
                    align-items="center"
                    justify-content="space-between"
                    padding="8px 16px"
                    button id="back" press=back testId="quote-cancel"
                      text "Cancel"
                    text "Add Quote" role="heading"
                    button press=addQuote
                      buttonStyle="bordered-prominent"
                      disabled=(quoteChosen.length == 0)
                      testId="quote-add"
                      text "Add"
                  list id="quote-lines" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section testId="quote-list"
                      if quoteLines.length == 0
                        row
                          text "No text found in this photo." color="-exact-secondary-label" testId="quote-empty"
                      for i in range(quoteLines.length) key = i
                        row align-items="center" gap=8
                          text lineAt(quoteLines, i) flex=1 testId=`quote-line-${i}`
                          input type="checkbox"
                            role="switch"
                            checked=(not quoteOff.includes(i))
                            change=toggleLine(i)
                            aria-label=lineAt(quoteLines, i)
                            testId=`quote-toggle-${i}`
                      footer
                        text "The lines you leave on are added to the notes as one quotation."
              if e.name == "add"
                column navigationKey=`${e.id}`
                  navigationPresentation="modal"
                  navigationScroll="add-form"
                  testId="route-add"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex"
                    align-items="center"
                    justify-content="space-between"
                    padding="8px 16px"
                    button id="back" press=back testId="add-cancel"
                      text "Cancel"
                    text "New Book" role="heading"
                    if canScan
                      button press=openScan aria-label="Scan Barcode" testId="scan-barcode"
                        image "symbol:camera"
                    button press=save buttonStyle="bordered-prominent" testId="add-save"
                      text "Save"
                  list id="add-form" appearance="auto" listStyle="inset-grouped" flex=1 min-height=0
                    section
                      header
                        text "Title"
                      row
                        input
                          value=draftTitle
                          input=editTitle
                          placeholder="Middlemarch"
                          aria-label="Title"
                          autofocus=true
                          enterkeyhint="next"
                          testId="add-title"
                          flex=1
                      footer
                        text (submitted ? titleError : "") color="-exact-system-red"
                          testId="error-title"
                    section
                      header
                        text "Author"
                      row
                        input
                          value=draftAuthor
                          input=editAuthor
                          placeholder="Optional"
                          aria-label="Author"
                          autocomplete="off"
                          enterkeyhint="next"
                          testId="add-author"
                          flex=1
                    section
                      header
                        text "Pages"
                      row
                        input type="number"
                          value=draftPages
                          input=editPages
                          submit=save
                          placeholder="Optional"
                          aria-label="Pages"
                          inputmode="numeric"
                          testId="add-pages"
                          flex=1
                      footer
                        text (submitted ? pagesError : "") color="-exact-system-red"
                          testId="error-pages"
                    section background-color="transparent"
                      StatusControl(
                        status=draftStatus,
                        choose=chooseDraftStatus,
                        prefix="add-status"
                      )
              // The scan: pushed inside the add sheet, the camera running only
              // while it is shown.
              if e.name == "scan"
                column navigationKey=`${e.id}`
                  testId="route-scan"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex"
                    align-items="center"
                    justify-content="space-between"
                    padding="8px 16px"
                    button press=endScan testId="scan-cancel"
                      text "Cancel"
                    text "Scan Barcode" role="heading" aria-level=2
                  exact-camera srcObject=scanTrack
                    aria-label="Viewfinder"
                    testId="scan-viewfinder"
                    object-fit="cover"
                    flex=1
                    min-height=0
                    width="100%"
                  column gap=8 padding=16 align-items="center" testId="scan-result"
                    if isbn == ""
                      text "Point the camera at the barcode on the back of the book" text-align="center"
                        testId="scan-hint"
                    else if pending(lookup) or lookup.isbn != isbn
                      progress aria-label="Looking up the book" testId="scan-looking"
                    else if lookup.found
                      text lookup.title role="heading" aria-level=3 text-align="center" testId="scan-title"
                      text lookup.author color="-exact-secondary-label" text-align="center" testId="scan-author"
                      button press=useBook buttonStyle="bordered-prominent" testId="use-book"
                        text "Use This Book"
                    else
                      text `No book found for ISBN ${isbn}` text-align="center" testId="scan-none"
                      button press=tryAgain buttonStyle="bordered" testId="scan-again"
                        text "Try Again"
              if e.name == "discover"
                column navigationKey=`${e.id}`
                  navigationScroll="discover-list"
                  testId="route-discover"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Discover" role="heading" aria-level=1
                  row role="tablist" aria-label="Subject" testId="subjects" margin="8px 16px"
                    button role="tab"
                      aria-selected=(subject == "science_fiction")
                      press=chooseSubject("science_fiction")
                      testId="subject-science_fiction"
                      flex=1
                      text "Sci-Fi"
                    button role="tab"
                      aria-selected=(subject == "fantasy")
                      press=chooseSubject("fantasy")
                      testId="subject-fantasy"
                      flex=1
                      text "Fantasy"
                    button role="tab"
                      aria-selected=(subject == "mystery_and_detective_stories")
                      press=chooseSubject("mystery_and_detective_stories")
                      testId="subject-mystery_and_detective_stories"
                      flex=1
                      text "Mystery"
                  // Pull to refresh: `refresh` on the list; `refreshing` holds the
                  // spinner until the reload settles. What stands in for the rows
                  // (the spinner, the error and its button) is one child, with no
                  // separator at either edge.
                  list id="discover-list"
                    testId="discover-list"
                    refresh=reload
                    refreshing=(pending(works) and works.works.length > 0)
                    flex=1
                    min-height=0
                    if pending(works) and works.works.length == 0
                      row justify-content="center" padding=40 border-top="none" border-bottom="none"
                        progress aria-label="Loading" testId="discover-loading"
                    else if not works.ok
                      column border-top="none" border-bottom="none"
                        Empty(title="Couldn’t Load Books", message=works.error, tid="discover-error")
                        row justify-content="center"
                          button press=reload testId="retry"
                            text "Try Again"
                    else
                      for w in works.works key = w.key
                        WorkRow(work=w, added=owned.includes(w.key), add=addWork)
              if e.name == "stats"
                column navigationKey=`${e.id}`
                  navigationScroll="stats-list"
                  testId="route-stats"
                  position="absolute"
                  inset=0
                  display="flex"
                  flex-direction="column"
                  header display="flex" align-items="center" padding="8px 16px"
                    text "Stats" role="heading" aria-level=1
                  list id="stats-list"
                    appearance="auto"
                    listStyle="inset-grouped"
                    testId="stats"
                    flex=1
                    min-height=0
                    StatsSections(lib=lib, finished=finished, goalBy=goalBy)
      // The tab bar: each tab a symbol over its label, naming its panel.
      row role="tablist" testId="tabs"
        button role="tab"
          aria-controls="panel-library"
          aria-selected=(nav.tab == "library")
          press=pick("library")
          testId="tab-library"
          flex=1
          image "symbol:book"
          text "Library"
        button role="tab"
          aria-controls="panel-discover"
          aria-selected=(nav.tab == "discover")
          press=pick("discover")
          testId="tab-discover"
          flex=1
          image "symbol:sparkles"
          text "Discover"
        button role="tab"
          aria-controls="panel-stats"
          aria-selected=(nav.tab == "stats")
          press=pick("stats")
          testId="tab-stats"
          flex=1
          image "symbol:chart"
          text "Stats"
      // The confirmation: the system alert. Its label is the title, the text the
      // message; Cancel is the closing button without a `press`.
      dialog id="remove" role="alertdialog" aria-label="Remove Book?"
        text `“${aimedTitle}” will be removed from your library.`
        button press=remove
          destructive=true
          commandfor="remove"
          command="close"
          testId="remove-confirm"
          text "Remove"
        button commandfor="remove" command="close" testId="remove-cancel"
          text "Cancel"
      // Add Quote from Photo's picker: the platform's, for an image.
      input type="file" accept="image/*" id="quote-photo" display="none" change=quotePicked testId="quote-photo"

// A row of the library: tap to open, long-press for the menu, swipe to delete.
// The row only navigates, so it is a `link` to the book's route: the root's
// `navigate` pushes it on every host, and on the web it is a real link (a new
// tab, "Copy Link", the address in the status bar). `delete=` is its swipe to
// delete: on iOS UIKit's own, which a full swipe performs, and the web scrolls
// the row to its Delete.
component BookRow
  props
    book: Book
    aim: action
    swipeRemove: action
  view
    link href=path("book", book.id)
      delete=swipeRemove(book.id)
      contextmenu=aim(book.id)
      contextPopover="book-menu"
      testId=`book-${book.id}`
      text-align="start"
      display="flex"
      align-items="center"
      row flex=1
        min-width=0
        align-items="center"
        gap=8
        padding="10px 0"
        column flex=1 min-width=0 gap=2
          text book.title font="-exact-headline" line-clamp=2 testId=`book-title-${book.id}`
          text book.author font="-exact-subheadline" color="-exact-secondary-label"
          row align-items="center" gap=6
            text (book.status == "reading" ? `${percent(book.currentPage, book.pages)}% · page ${book.currentPage} of ${book.pages}` : statusLabel(book.status)) font="-exact-footnote"
              color="-exact-secondary-label"
              testId=`book-status-${book.id}`
            if book.status == "done" and book.rating > 0
              Stars(value=book.rating, tid=`book-stars-${book.id}`)
          if book.status == "reading"
            Meter(value=percent(book.currentPage, book.pages), tid=`book-progress-${book.id}`)
        image "symbol:forward-chevron" aria-hidden=true
          font="-exact-footnote"
          color="-exact-tertiary-label"

// A book's screen: a grouped list, one section per concern.
component BookSections
  props
    book: Book
    setStatus: action
    turnTo: action
    rate: action
    keepNotes: action
    askRemove: action
    canQuote: bool
    chooseQuote: action
  view
    if book.coverUrl != ""
      section background-color="transparent"
        row justify-content="center"
          image book.coverUrl alt=book.title width=100 height=150 object-fit="cover" border-radius=6
    section
      row
        text "Author"
        text book.author testId="detail-author"
      if book.pages > 0
        row
          text "Pages"
          text `${book.pages}` testId="detail-pages"
    section background-color="transparent"
      StatusControl(status=book.status, choose=setStatus(book.id), prefix="detail-status")
    if book.status != "want" and book.pages > 0
      section testId="progress"
        header
          text "Progress"
        // A custom row is a flex row: its content takes the width with `flex=1`.
        row padding-top=12 padding-bottom=12
          column flex=1 gap=12
            Meter(value=percent(book.currentPage, book.pages), tid="detail-progress")
            row align-items="center" justify-content="space-between"
              button appearance="auto"
                buttonStyle="bordered"
                press=turnTo(book.id, book.currentPage - 10)
                disabled=(book.currentPage <= 0)
                aria-label="Back 10 pages"
                testId="page-back"
                text "−10"
              text `Page ${book.currentPage} of ${book.pages}` testId="page-label"
              button appearance="auto"
                buttonStyle="bordered"
                press=turnTo(book.id, book.currentPage + 10)
                disabled=(book.currentPage >= book.pages)
                aria-label="Forward 10 pages"
                testId="page-forward"
                text "+10"
        footer
          text `${percent(book.currentPage, book.pages)}% read` testId="page-percent"
    if book.status == "done"
      section testId="rating-section"
        header
          text "Rating"
        row flex=1
          justify-content="center"
          gap=12
          padding-top=8
          padding-bottom=8
          role="group"
          aria-label=`Rated ${book.rating} of 5`
          testId="rating"
          for n in [1, 2, 3, 4, 5] key = n
            button appearance="auto"
              buttonStyle="plain"
              press=rate(book.id, n == book.rating ? 0 : n)
              aria-label=(n == 1 ? "1 star" : `${n} stars`)
              testId=`star-${n}`
              image (n <= book.rating ? "symbol:star-fill" : "symbol:star")
    section
      header
        text "Notes"
      // Keyed by the book and its quotes, so the draft starts from the saved
      // notes once, and again when a quote is added to them.
      for k in [`${book.id}-${book.quotes}`] key = k
        Notes(bookId=book.id, initial=book.notes, keep=keepNotes)
      if canQuote
        button press=chooseQuote(book.id) testId="add-quote"
          image "symbol:camera"
          text "Add Quote from Photo"
    section
      button press=askRemove(book.id) destructive=true testId="remove-book"
        text "Remove from Library"

component Notes
  props
    bookId: string
    initial: string
    keep: action
  state draft = initial
  action edit(v: string)
    draft = v
    keep(bookId, v)
  view
    row padding-top=8 padding-bottom=8
      textarea
        value=draft
        input=edit
        placeholder="Thoughts, quotes, where you left off…"
        aria-label="Notes"
        rows=4
        testId="notes"
        flex=1

// A segmented control: a `tablist` of text tabs outside a header.
component StatusControl
  props
    status: string
    choose: action
    prefix: string
  view
    row role="tablist" aria-label="Status" testId=prefix
      button role="tab"
        aria-selected=(status == "want")
        press=choose("want")
        testId=`${prefix}-want`
        flex=1
        text "Want to Read"
      button role="tab"
        aria-selected=(status == "reading")
        press=choose("reading")
        testId=`${prefix}-reading`
        flex=1
        text "Reading"
      button role="tab"
        aria-selected=(status == "done")
        press=choose("done")
        testId=`${prefix}-done`
        flex=1
        text "Finished"

component WorkRow
  props
    work: Work
    added: bool
    add: action
  view
    // The cover inside the row's margins, as a list cell's image is, so
    // neighbouring covers do not meet.
    row align-items="center" gap=12 padding-top=10 padding-bottom=10 testId=`work-${work.key}`
      if work.coverUrl != ""
        image work.coverUrl alt=""
          width=44
          height=66
          object-fit="cover"
          border-radius=4
          flex-shrink=0
          background-color="-exact-fill"
      else
        column width=44 height=66 border-radius=4 flex-shrink=0 background-color="-exact-fill"
      row flex=1
        min-width=0
        align-items="center"
        gap=12
        column flex=1 min-width=0 gap=2
          text work.title font="-exact-headline" line-clamp=2
          text work.author font="-exact-subheadline" color="-exact-secondary-label" line-clamp=1
        if added
          button disabled=true buttonStyle="bordered" testId=`added-${work.key}` flex-shrink=0
            text "Added"
        else
          button press=add(work)
            buttonStyle="bordered"
            aria-label=`Add ${work.title}`
            testId=`add-${work.key}`
            flex-shrink=0
            text "Add"

component StatsSections
  props
    lib: Library
    finished: number
    goalBy: action
  view
    section
      header
        text "Library"
      row testId="stat-reading"
        text "Reading"
        text `${lib.books.filter(b => b.status == "reading").length}`
      row testId="stat-want"
        text "Want to Read"
        text `${lib.books.filter(b => b.status == "want").length}`
      row testId="stat-finished"
        text "Finished"
        text `${finished}`
      row testId="stat-pages"
        text "Pages Read"
        text `${lib.pagesRead}`
    section
      row testId="stat-rating"
        text "Average Rating"
        text lib.avgText testId="avg-rating"
      footer
        text "Of the finished books you rated."
    section
      header
        text "Yearly Goal"
      row padding-top=12 padding-bottom=12 testId="goal-row"
        column flex=1 gap=10
          row align-items="center" gap=8
            text countText(lib.goal, "book", "books") testId="goal" flex=1
            button appearance="auto"
              buttonStyle="bordered"
              press=goalBy(-1)
              disabled=(lib.goal <= 1)
              aria-label="Fewer books"
              testId="goal-down"
              image "symbol:minus"
            button appearance="auto"
              buttonStyle="bordered"
              press=goalBy(1)
              disabled=(lib.goal >= 365)
              aria-label="More books"
              testId="goal-up"
              image "symbol:add"
          Meter(
            value=(lib.goal > 0 ? min(100, round(finished / lib.goal * 100)) : 0),
            tid="goal-progress"
          )
      footer
        text (finished >= lib.goal ? "Goal reached." : `${lib.goal - finished} to go.`) testId="goal-left"

// What a screen shows with nothing in it (UIKit's ContentUnavailableView).
component Empty
  props
    title: string
    message: string
    tid: string
  view
    column align-items="center" gap=6 padding="48px 32px 16px" testId=tid
      text title role="heading" aria-level=3 text-align="center"
      text message color="-exact-secondary-label" text-align="center" testId=`${tid}-message`

// A determinate progress bar, 0 to 100: the platform's own (`UIProgressView`
// in the tint, LLP 1116 D8), which says its value itself. It is as wide as its
// column with nothing written (LLP 1115.000 D10.2).
component Meter
  props
    value: number
    tid: string
  view
    progress value=value max=100 testId=tid

// Five stars, filled to the rating, in the tint.
component Stars
  props
    value: number
    tid: string
  view
    row gap=2 role="img" aria-label=`Rated ${value} of 5` testId=tid
      for n in [1, 2, 3, 4, 5] key = n
        image (n <= value ? "symbol:star-fill" : "symbol:star") font="-exact-caption2"

shape ShelfWidgetProps
  count: number
  latest: string

component ShelfWidget
  props
    count: number
    latest: string
  view
    column gap=8
      text "On your shelf" role="heading" aria-level=2
      text `${count}` font-variant-numeric="tabular-nums"
      text latest line-clamp=2
