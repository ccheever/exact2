// The native-module fixture (LLP 1024 D8, LLP 1075.003 §3.9): the seam and
// nothing else. Three module tags from the roster in app.json —
// `exact-fixture` (a coloured box that takes the snapshot bit, fires every
// event on request, and rejects a `reject` prop), `exact-plain` (a box the
// ordinary capture paints) and `exact-absent` (in the roster, never in the
// artifact: its node reports the missing factory) — and the hatches: two
// routes, a header-shaped one whose heading iOS lifts into its navigation
// bar and one pushed over it, `data-*` words the module's hatches read, and
// the scroll view the route names. `bun scripts/smoke.mjs <web|macos|ios>
// --app native-fixture` drives it through the eight operations.

routes nav
  tab home "/"
    detail "/detail"
    rows "/rows"
    sheet "/sheet"
    menu "/menu"
    chat "/chat"
    photo "/photo"
    plain "/plain"
    note "/note"
  tab second "/second"

// The hatched list's rows (LLP 1075.003.000), from the fixture's data source,
// asked for when the Rows route is pushed: a session without that source
// (the UIKit tests' host) never asks.
shape Row
  n: number

shape Rows
  items: Row[]

// The map providers installed, for the "Open in…" chooser (LLP 1021): rows
// from data, because only the run time knows what is installed.
shape Provider
  id: string
  name: string
  icon: string

shape Providers
  items: Provider[]

shape SurfaceClock
  epochAtZero: number

component NativeFixture
  resource surfaceClock = exactTime() as shape SurfaceClock
  state popoverValue = ""
  state popoverSearch = ""
  action popoverChange(v: string)
    popoverValue = v
  action searchChange(v: string)
    popoverSearch = v
  state inputValue = ""
  state inputEvents = ""
  state inputCommands = 0
  action inputCommand
    inputCommands = inputCommands + 1
  state dialogValue = ""
  state dialogCommands = 0
  action dialogChange(v: string)
    dialogValue = v
  action dialogCommand
    dialogCommands = dialogCommands + 1
  state blocked = false
  state inputHidden = false
  state inputInert = false
  state blockOnBlur = ""
  action blurWrapper
    blur("box")
  action armDisabled
    blockOnBlur = "disabled"
  action armInert
    blockOnBlur = "inert"
  action restrictInput
    if blockOnBlur == "disabled"
      blocked = true
    if blockOnBlur == "inert"
      inputInert = true
    blockOnBlur = ""
  action focusInput
    focus("native-input")
  action blurInput
    focus("native-input")
    blur("native-input")
  action blurPlain
    focus("native-input")
    blur("plain")
  action blockInput
    blocked = not blocked
  action hideInput
    inputHidden = not inputHidden
  action inertInput
    inputInert = not inputInert
  action inputChange(v: string)
    inputValue = v
  action inputFocus
    inputEvents = inputEvents + "focus;"
  action inputBlur
    inputEvents = inputEvents + "blur;"
  action inputKey(k: string)
    inputEvents = inputEvents + "key:" + k + ";"
  state expanded = false
  state natural = true
  action grow
    expanded = not expanded
  action sizing
    natural = not natural
  state count = 0
  state emit = 0
  state shown = true
  state rejecting = false
  state moded = false
  state loads = 0
  state events = ""
  state received = ""
  action bump
    count = count + 1
  // What hatches ask of authored nodes (LLP 1075.003.000.001 §2.5): the `feed`
  // hatch replaces a field's value with `input`; the `presser` hatch clicks
  // its own button once when armed, and on every change while looping, which
  // never settles until it is stopped.
  state fed = ""
  state feedWith = ""
  state armed = false
  state looping = false
  state hatchPresses = 0
  // A post that opens with a card at its middle, and a box with no press
  // with Like at its middle, on Detail (LLP 1012 §1: a tap that names a
  // node presses that node, never a control inside it).
  state postOpens = 0
  state cardOpens = 0
  state likes = 0
  action openPost
    postOpens = postOpens + 1
  action openCard
    cardOpens = cardOpens + 1
  action like
    likes = likes + 1
  // A date and a time with a hatch, and a date and time without one: on
  // Android each opens its picker, and the `due` hatch's Kotlin sets what the
  // picker offers (LLP 1115.001.000 D3; `modules/android`).
  state due = "2026-10-16"
  state dueAt = "09:30"
  state remind = ""
  action setDue(v: string)
    due = v
  action setDueAt(v: string)
    dueAt = v
  action setRemind(v: string)
    remind = v
  action setFed(v: string)
    fed = v
  action feed
    feedWith = "Palo Alto"
  action arm
    armed = true
  action hatchPress
    hatchPresses = hatchPresses + 1
  action loop
    looping = true
  action stopLoop
    looping = false
  // The hatches' frame clock (§2.4): while clocking, a frame task counts
  // frames, and the `clock` hatch's ticket reads the count at each tick. Its
  // third tick presses the node 65 times; the 65th press changes its words,
  // and its `changed` presses once more.
  state clocking = false
  state frameCount = 0
  state clockPresses = 0
  action startClock
    clocking = true
  action stopClock
    clocking = false
  action countFrame
    frameCount = frameCount + 1
  action clockPress
    clockPresses = clockPresses + 1
  task framer when clocking
    every(frame, countFrame)
  action unbump
    count = 0
  // A confirmation raised from an action (LLP 1115 D6): the context menu's
  // Clear asks first, as a hand-built app's long-press → alert does.
  action askClear
    showModal("clear-confirm")
  action fire
    emit = emit + 1
  action toggle
    shown = not shown
  action reject
    rejecting = not rejecting
  action mode
    moded = not moded
  action onLoad
    loads = loads + 1
  action onPress
    events = events + "press;"
  action onChange(v: string)
    events = events + "change:" + v + ";"
  action onHover(over: bool)
    events = events + "hover:" + over.toString() + ";"
  action onFocus
    events = events + "focus;"
  action onBlur
    events = events + "blur;"
  action onKey(k: string)
    events = events + "key:" + k + ";"
  action onSubmit
    events = events + "submit;"
  action onMessage(m: string)
    if m.includes("props:")
      received = m
    else
      events = events + "message:" + m + ";"
  state composed = 0
  state violate = false
  state transition = false
  action compose
    composed = composed + 1
  mutation rows as shape Rows
  // Asked as the chooser opens, never at boot: a session without the
  // fixture's source (the UIKit tests' host) never asks.
  mutation providers as shape Providers
  derive providerItems = match providers { case some(p) => p.items, case none => [] }
  state remembered = "apple"
  state opened = ""
  action openIn(id: string)
    remembered = id
    opened = id
  action refreshProviders
    send providers = providers()
  // A context menu with a preview (LLP 1021 §5.1): its source's own
  // `contextmenu` counts the openings; tapping the preview pushes Detail.
  state peeks = 0
  action peeked
    peeks = peeks + 1
  derive rowItems = match rows { case some(r) => r.items, case none => [] }
  action showRows
    nav = push(nav, "/rows")
    send rows = rows()
  action detail
    nav = push(nav, "/detail")
  action back
    nav = back(nav)
  // LLP 1115 D5: Plain (pushed) and Note (a sheet) declare no Back control;
  // the platform's Back still goes, delivered here as the web's history
  // Back is: the location beneath.
  state focusPlain = false
  action openFocusedPlain
    focusPlain = true
    nav = push(nav, "/plain")
  action openPlain
    nav = push(nav, "/plain")
  action openNote
    nav = push(nav, "/note")
  // A composer: an opener that asked for focus (a tabindex) presents a
  // sheet whose textarea a later answer mounts, after the sheet is up, and
  // which autofocuses.
  state focusNote = false
  state noteLoading = false
  action openFocusedNote
    focusNote = false
    noteLoading = true
    nav = push(nav, "/note")
  action noteLoaded
    noteLoading = false
    focusNote = true
  task loadNote when noteLoading
    after(1000, noteLoaded)
  action follow(url: string)
    nav = go(nav, url)
  action breakOwnership
    violate = not violate
  action customTransition
    transition = not transition
  state top = 0
  action scrollTo(y: number)
    top = y
  state draft = ""
  state query = ""
  action setQuery(text: string)
    query = text
  state segment = "all"
  action chooseSegment(name: string)
    segment = name
  action setDraft(text: string)
    draft = text
  action selectTab(name: string)
    nav = select(nav, name)
  // A root overlay with a z-index after the tabs (docs/agent-pitfalls.md's
  // pattern for full-screen overlays): it paints and takes touches over the
  // native tab container (LLP 1083.000 D4).
  state overlayShown = false
  action showOverlay
    overlayShown = true
  action hideOverlay
    overlayShown = false
  state toast = ""
  action say
    toast = "Saved"
  action hush
    toast = ""
  // LLP 1075.003 §9.11: a sheet at its rows' height, following them; with
  // `menuLarge`, draggable to large from there.
  state menuItems = [0]
  state menuLarge = false
  action openMenu
    nav = push(nav, "/menu")
  action moreMenu
    menuItems = menuItems.concat([menuItems.length])
  action fewerMenu
    menuItems = menuItems.slice(0, -1)
  action toggleMenuLarge
    menuLarge = not menuLarge
  action openSheet
    nav = push(nav, "/sheet")
  // The menu over Sheet and Sheet, closed at once.
  action closeSheets
    nav = back(back(nav))
  // The menu over Sheet opened by an answer's `then`, as a confirmation
  // shown once a request answers (the answer itself is unused); from home,
  // Sheet and the menu over it at once.
  mutation asked as shape Providers then askedMenu
  action askMenu
    send asked = providers()
  action askedMenu
    nav = push((top(nav).name == "sheet" ? nav : push(nav, "/sheet")), "/menu")
  // LLP 1075.003 §9.10: a pressable title with an avatar and a subtitle, a
  // route pushed with the tablist hidden, and one that asks for no bar.
  state subtitle = "Online"
  state titlePresses = 0
  action openChat
    nav = push(nav, "/chat")
  action openPhoto
    nav = push(nav, "/photo")
  action pressTitle
    titlePresses = titlePresses + 1
  action toggleSubtitle
    subtitle = subtitle == "" ? "Online" : ""
  // A subtitle as a line of symbols and texts (§9.10).
  state muted = false
  action toggleMuted
    muted = not muted
  // Chat's scroller with its tall box gone: a column that fills its height,
  // laid out between the bar and the home indicator (LLP 1116.000 D1.2).
  state shortChat = false
  action toggleShortChat
    shortChat = not shortChat
  // Second's scroller replaced in place by a taller or a shorter one, as a
  // quiz's results replace its question: each opens at its top.
  state secondPage = ""
  action showSecondPage(page: string)
    secondPage = page
  // The tablist hidden over the root, as Signal's chat-list multi-select
  // hides its tab bar (LLP 1075.003 §3.7, amended 2026-10-05).
  state tabsAtTop = false
  action toggleTabsAtTop
    tabsAtTop = not tabsAtTop
  // The tablist the author keeps (`appearance: none`, LLP 1075.003 §9.10).
  state tabsAuthored = false
  action toggleTabsAuthored
    tabsAuthored = not tabsAuthored
  state choosing = false
  action toggleChoosing
    choosing = not choosing
  view
    main data-mood=(composed > 0 ? "busy" : "calm") navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow testId="navigation" width="100%" height="100%" display="flex" flex-direction=(tabsAtTop ? "column-reverse" : "column") background-color="#ffffff" color="#111111" font-family="system-ui"
      column testId="panels" flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` testId=`panel-${t.name}` position="absolute" top=0 right=0 bottom=0 left=0
            for e in t.stack key=e.id
              // Second names no scroller: its `scroll` right after the header
              // is the bar's with nothing written (LLP 1115.000 D11.1), and
              // its large title collapses with it. The others name theirs.
              column navigationKey=`${e.id}` navigationBar=(e.name == "photo" ? "none" : "auto") navigationPresentation=(e.name == "sheet" or e.name == "menu" or e.name == "note" ? "modal" : "") navigationDetent=(e.name == "sheet" ? "300 large" : (e.name == "menu" ? (menuLarge ? "fit-content large" : "fit-content") : "")) navigationScroll=(e.name == "second" ? "" : (e.name == "chat" ? "list-chat" : "list-detail")) data-screen=e.name data-menu="compose" data-violate=violate data-transition=transition testId=`route-${e.name}` position="absolute" top=0 right=0 bottom=0 left=0 display="flex" flex-direction="column" background-color="#ffffff"
                // Photo is a full-bleed viewer that draws its own Close: it
                // says it has no bar (`navigationBar="none"`, LLP 1115.000
                // D5.2). Menu, a sheet's first route, has nothing to go back to.
                if e.name != "photo" and e.name != "menu" and not tabsAtTop
                  header testId=`header-${e.name}` display="flex" flex-direction="row" align-items="center" gap=8 padding=12 flex-shrink=0 border-bottom-width=1 border-bottom-style="solid" border-color="#e5e7eb"
                    if e.name == "detail" or e.name == "rows" or e.name == "chat"
                      button id="back" press=back testId="back" aria-label="Back" padding=6 background-color="#e5e7eb"
                        image "symbol:back" width=20 height=20
                    if e.name == "sheet"
                      button id="back" press=back testId="close-sheet" aria-label="Close" padding=6 background-color="#e5e7eb"
                        image "symbol:close" width=20 height=20
                    if e.name == "home"
                      // A drawn face (LLP 1075.003 §9.6): a button whose one
                      // child is a filled box holding a text is an image item.
                      button press=compose aria-label="Profile" testId="badge-item" padding=0
                        column width=32 height=32 border-radius=16 background-color="#e3e3fe" align-items="center" justify-content="center"
                          text "AB" font-size=13 color="#3838f5"
                      // A popover's invoker is a bar item opening a UIMenu.
                      button popovertarget="bar-menu" aria-label="More" testId="menu-item" padding=6 background-color="#e5e7eb"
                        image "symbol:sf/ellipsis.circle" width=20 height=20
                      // A search field in the header: the item's search controller.
                      input type="search" value=query input=setQuery placeholder="Search the fixture" testId="header-search" width=80
                      // A text tablist in the header: the item's segmented title view.
                      row role="tablist" testId="header-segments"
                        // The projected segmented control owns the chrome; its
                        // authored tabs keep their bare text widths.
                        button appearance="none" role="tab" aria-selected=(segment == "all") press=chooseSegment("all") testId="segment-all"
                          text "All"
                        button appearance="none" role="tab" aria-selected=(segment == "missed") press=chooseSegment("missed") testId="segment-missed"
                          text "Missed"
                    // A pressable group around the heading, with an avatar and
                    // a subtitle: the item's title, drawn, tapped (§9.10).
                    if e.name == "chat"
                      button press=pressTitle testId="title-group" display="flex" flex-direction="row" flex=1 align-items="center" gap=8
                        column width=32 height=32 border-radius="50%" background-color="#dcfce7" align-items="center" justify-content="center"
                          text "CD" font-size=13 color="#166534"
                        column
                          text "Chat" role="heading" aria-level=2 testId="title-chat" font-weight=700 font-size=17
                          if subtitle != "" and not muted
                            text subtitle testId="subtitle-chat" font-size=12 color="#6b7280"
                          if muted
                            row gap=3 align-items="center" testId="subtitle-glyphs" aria-label="Muted, disappearing messages after 1 week"
                              image "symbol:sf/bell.slash" width=12 height=12 object-fit="contain"
                              text "Muted" font-size=12 color="#6b7280"
                              image "symbol:sf/timer" width=12 height=12 object-fit="contain"
                              text "1w" font-size=12 color="#6b7280"
                    if e.name != "chat"
                      text (e.name == "home" ? "Fixture" : e.name == "detail" ? "Detail" : e.name == "rows" ? "Rows" : e.name == "sheet" ? "Sheet" : e.name == "plain" ? "Plain" : e.name == "note" ? "Note" : "Second") role="heading" aria-level=(e.name == "home" or e.name == "second" ? 1 : 2) testId=`title-${e.name}` flex=1 font-weight=700 font-size=20
                    // The heading the header holds directly: the first text
                    // after it is the bar's subtitle; a second is not shown
                    // on iOS, which the agent says (LLP 1116 D2).
                    if e.name == "plain"
                      text "No Back control" testId="subtitle-plain" font-size=12 color="#6b7280"
                      text "Draft" testId="aside-plain" font-size=12 color="#6b7280"
                    button id="compose" press=compose aria-label="Compose" testId=`compose-${e.name}` padding=6 background-color="#e5e7eb"
                      image "symbol:compose" width=20 height=20
                    // A readout after the buttons: an item nothing presses,
                    // its dot and monospaced count drawn as written, which
                    // follows the count in place (LLP 1075.003 §9.15).
                    if e.name == "plain"
                      row role="status" testId="readout-plain" aria-label=`${composed} composed` display="flex" align-items="center" gap=6
                        column width=7 height=7 border-radius=3.5 background-color=(composed > 0 ? "#16a34a" : "#9ca3af")
                        text `${composed} sent` testId="readout-text" font-family="Menlo" font-size=12 color="#6b7280"
                if e.name == "home"
                  column id="bar-menu" popover="auto" position="absolute" role="menu" aria-label="Actions" width=200 padding=8 background-color="#ffffff"
                    button appearance="none" press=bump popovertarget="bar-menu" popovertargetaction="hide" role="menuitem" testId="bar-menu-bump" height=44 text-align="start"
                      text "Bump from the bar"
                    // Rows that open a confirmation, with no handler or after one: it presents
                    // once the menu has gone, from the bar item.
                    button appearance="none" commandfor="clear-confirm" command="show-modal" role="menuitem" testId="bar-menu-clear" height=44 text-align="start"
                      text "Clear count…"
                    button appearance="none" press=refreshProviders popovertarget="open-in-sheet" popovertargetaction="show" role="menuitem" testId="bar-menu-open-in" height=44 text-align="start"
                      text "Open in…"
                if e.name == "home"
                  column testId="fixture" gap=8 padding=12
                    row gap=6 flex-wrap="wrap"
                      button press=detail testId="detail" padding=6 background-color="#e5e7eb"
                        text "Detail"
                      button press=toggleChoosing testId="toggle-choosing" padding=6 background-color="#e5e7eb"
                        text "Choose"
                      button press=showRows testId="rows" padding=6 background-color="#e5e7eb"
                        text "Rows"
                      button press=customTransition testId="transition" padding=6 background-color="#e5e7eb"
                        text "Transition"
                      button press=openSheet testId="sheet" padding=6 background-color="#e5e7eb"
                        text "Sheet"
                      button press=askMenu testId="ask-sheets" padding=6 background-color="#e5e7eb"
                        text "Sheets once asked"
                      button press=openMenu testId="menu" padding=6 background-color="#e5e7eb"
                        text "Menu"
                      button press=toggleMenuLarge testId="menu-large" padding=6 background-color="#e5e7eb"
                        text (menuLarge ? "Menu: fit-content large" : "Menu: fit-content")
                      button "Tabs at top" press=toggleTabsAtTop testId="tabs-at-top"
                      button "Authored tabs" press=toggleTabsAuthored testId="tabs-authored"
                      button press=openChat testId="chat" padding=6 background-color="#e5e7eb"
                        text "Chat"
                      button press=openPlain testId="open-plain" padding=6 background-color="#e5e7eb"
                        text "Plain"
                      button press=openFocusedPlain testId="open-focused-plain" height=44
                        text "Focus fields"
                      button press=openNote testId="open-note" padding=6 background-color="#e5e7eb"
                        text "Note"
                      button press=openFocusedNote tabindex=0 testId="open-focused-note" padding=6 background-color="#e5e7eb"
                        text "Compose"
                      column hatch="badge" data-tone=(composed > 0 ? "busy" : "info") testId="hatched-badge" width=20 height=20 border-radius=10 background-color="#f59e0b"
                        head description="Badge"
                    row gap=4 align-items="center"
                      text ("composed " + composed.toString()) testId="composed"
                      time datetime=(surfaceClock.epochAtZero - 120000) format="relative" testId="live-time" font-size=14
                        text "Two minutes ago"
                      time datetime=surfaceClock.epochAtZero format="timer" testId="live-timer" font-size=14
                      progress start=surfaceClock.epochAtZero end=(surfaceClock.epochAtZero + 120000) aria-label="Timed progress" testId="live-progress" width=24
                    row gap=4
                      time datetime=surfaceClock.epochAtZero format="relative" testId="live-zero" font-size=14
                      time datetime=(surfaceClock.epochAtZero + 9000000) format="relative" testId="live-hours" font-size=14
                    row role="toolbar" toolbarPlacement="window" aria-label="Window" testId="window-toolbar" gap=6
                      button press=compose aria-label="Compose" testId="toolbar-compose" padding=6 background-color="#e5e7eb"
                        image "symbol:compose" width=20 height=20
                    row gap=6 flex-wrap="wrap"
                      button "Popover form" testId="open-native-popover" popovertarget="native-popover"
                      button press=bump testId="bump" padding=6 background-color="#e5e7eb"
                        text "Bump"
                      button press=fire testId="fire" padding=6 background-color="#e5e7eb"
                        text "Fire"
                      button press=toggle testId="toggle" padding=6 background-color="#e5e7eb"
                        text (shown ? "Unmount" : "Mount")
                      button press=reject testId="reject" padding=6 background-color="#e5e7eb"
                        text "Reject"
                      button press=mode testId="mode" padding=6 background-color="#e5e7eb"
                        text "Mode"
                    // An "Open in…" chooser (LLP 1021): the invoker refreshes
                    // what is installed as it opens; a menu on every host,
                    // titled by its aria-label, each row its provider's icon,
                    // the remembered one checked; the same rows as a sheet
                    // when the popover asks for one (role="alertdialog").
                    button press=showOverlay testId="show-overlay" padding=6 background-color="#e5e7eb"
                      text "Overlay"
                    button press=say testId="say" padding=6 background-color="#e5e7eb"
                      text "Toast"
                    row gap=6 flex-wrap="wrap"
                      button press=refreshProviders popovertarget="open-in" testId="open-in" padding=6 background-color="#e5e7eb"
                        text "Open in Maps"
                      button press=refreshProviders popovertarget="open-in-sheet" testId="open-in-sheet" padding=6 background-color="#e5e7eb"
                        text "Open in (sheet)"
                      text ("opened " + opened) testId="opened"
                    column id="open-in" popover="auto" position="absolute" role="menu" aria-label="Open location in" width=220 padding=8 background-color="#ffffff"
                      for p in providerItems key=p.id
                        button press=openIn(p.id) aria-checked=(p.id == remembered) popovertarget="open-in" popovertargetaction="hide" role="menuitemradio" testId=`open-in-${p.id}` height=44 display="flex" flex-direction="row" align-items="center" gap=8
                          image p.icon width=24 height=24
                          text p.name
                      // HTML's separator: a section break in the native menu;
                      // a flex item, so its auto side margins are zeroed.
                      hr testId="open-in-rule" margin-left=0 margin-right=0
                      button popovertarget="open-in" popovertargetaction="hide" testId="open-in-cancel" height=44
                        text "Cancel"
                    column id="open-in-sheet" popover="auto" position="absolute" role="alertdialog" aria-label="Open location in" width=220 padding=8 background-color="#ffffff"
                      for p in providerItems key=p.id
                        button press=openIn(p.id) aria-checked=(p.id == remembered) popovertarget="open-in-sheet" popovertargetaction="hide" testId=`open-in-sheet-${p.id}` height=44
                          text p.name
                      button popovertarget="open-in-sheet" popovertargetaction="hide" testId="open-in-sheet-cancel" height=44
                        text "Cancel"
                    // A context menu (LLP 1021 §5.1): a long press on iOS lifts
                    // the row into UIKit's menu with the preview above it; the
                    // preview's press is the commit, popping into Detail.
                    button press=detail contextmenu=peeked contextPopover="peek" testId="peek" aria-label="Detail, long press to peek" display="flex" flex-direction="row" align-items="center" gap=8 padding=10 border-radius=12 background-color="#eef2ff"
                      text "Peek at Detail" flex=1
                      text ("peeks " + peeks.toString()) testId="peeks" font-size=12 color="#6b7280"
                    column id="peek" popover="auto" position="absolute" role="menu" width=300 padding=8 gap=4 background-color="#ffffff"
                      button contextPreview=true press=detail popovertarget="peek" popovertargetaction="hide" testId="peek-preview" aria-label="Open Detail" display="flex" flex-direction="column" gap=6 width="100%" height=180 padding=16 box-sizing="border-box" border-radius=12 background-color="#e0e7ff"
                        text "Detail" font-weight=700 font-size=20
                        text "A preview of the Detail screen, laid out by the kernel and shown by UIKit." font-size=14 color="#374151"
                      button press=bump popovertarget="peek" popovertargetaction="hide" testId="peek-bump" height=44
                        image "symbol:sf/plus.circle" width=20 height=20 object-fit="contain"
                        text "Bump"
                      hr margin-left=0 margin-right=0
                      button press=askClear destructive=true popovertarget="peek" popovertargetaction="hide" testId="peek-clear" height=44
                        text "Clear"
                    // The platform's alert (LLP 1115 D6): a title (its
                    // aria-label), a message (its text), a destructive action
                    // and Cancel, centred on iOS; opened by its button or by
                    // `showModal` from an action (the context menu's Clear).
                    button commandfor="clear-confirm" command="show-modal" testId="ask-clear" padding=6 background-color="#e5e7eb"
                      text "Clear count…"
                    dialog id="clear-confirm" role="alertdialog" aria-label="Clear the count?" padding=16
                      text "The count goes back to zero."
                      button press=unbump destructive=true commandfor="clear-confirm" command="close" testId="clear-confirm-clear"
                        text "Clear"
                      button commandfor="clear-confirm" command="close" testId="clear-confirm-cancel"
                        text "Cancel"
                    row gap=6
                      button appearance="none" press=grow testId="grow" padding=6
                        text "Grow content"
                      button appearance="none" press=sizing testId="sizing" padding=6
                        text "Toggle intrinsic size"
                    text ("count " + count.toString() + " · loads " + loads.toString()) testId="counts"
                    if shown
                      exact-fixture id="box" testId="box" width=120 height=80 tint="#2266ee" note="quote \" slash \\ tab\t<&>" count=count emit=emit mode=(moded ? some("wide") : none) reject=rejecting load=onLoad press=onPress change=onChange hover=onHover focus=onFocus blur=onBlur key=onKey submit=onSubmit message=onMessage
                    exact-plain id="plain" testId="plain" align-self="flex-start" padding=4 border-width=2 border-style="solid" border-color="#111111" tint="#11aa44" expanded=expanded natural=natural
                    exact-absent testId="absent" width=120 height=40 background-color="#f3f4f6"
                    row gap=4 flex-wrap="wrap"
                      button testId="focus-input" press=focusInput
                        text "Focus input"
                      button testId="blur-input" press=blurInput
                        text "Blur input"
                      button testId="blur-plain" press=blurPlain
                        text "Blur plain"
                      button testId="block-input" press=blockInput
                        text "Disable input"
                      button testId="hide-input" press=hideInput
                        text "Hide input"
                      button testId="inert-input" press=inertInput
                        text "Inert input"
                      button testId="disable-on-blur" press=armDisabled blur=restrictInput
                        text "Disable on blur"
                      button testId="inert-on-blur" press=armInert blur=restrictInput
                        text "Inert on blur"
                      button testId="blur-wrapper" press=blurWrapper retainFocus=true
                        text "Blur wrapper"
                    if shown
                      column inert=inputInert display=(inputHidden ? "none" : "block")
                        button "Before input" testId="before-input"
                        exact-plain id="native-input" testId="native-input" customInput=true width=240 height=48 disabled=blocked change=inputChange focus=inputFocus blur=inputBlur key=inputKey
                        button "Input command" testId="input-command" press=inputCommand aria-keyshortcuts="Meta+Shift+Enter Meta+Plus c"
                    button "Open native dialog" testId="open-native-dialog" commandfor="native-dialog" command="show-modal"
                    dialog id="native-dialog" width=320 padding=16 closedby="any"
                      column gap=8
                        exact-plain id="dialog-input" testId="dialog-input" customInput=true natural=false width=280 height=48 change=dialogChange
                        button "Dialog command" testId="dialog-command" press=dialogCommand aria-keyshortcuts="Meta+Shift+Enter"
                        button "Close" testId="dialog-close" commandfor="native-dialog" command="close"
                    column id="native-popover" testId="native-popover" popover="auto" position="absolute" width=320 padding=16 gap=8 background-color="#ffffff" border-width=1 border-style="solid" border-color="#9ca3af"
                      input testId="popover-search" placeholder="Search" value=popoverSearch input=searchChange autofocus=true width=280 height=32
                      exact-plain id="popover-input" testId="popover-input" customInput=true natural=false width=280 height=48 change=popoverChange
                      button "Close popover" testId="popover-close" popovertarget="native-popover" popovertargetaction="hide"
                if e.name == "rows"
                  HatchedRows(items=rowItems)
                if e.name == "detail"
                  row gap=6 padding=12 flex-shrink=0
                    button press=breakOwnership testId="violate" padding=6 background-color="#e5e7eb"
                      text "Violate"
                    button press=scrollTo(80) testId="scroll-80" padding=6 background-color="#e5e7eb"
                      text "Scroll 80"
                    button press=scrollTo(0) testId="scroll-0" padding=6 background-color="#e5e7eb"
                      text "Scroll 0"
                if e.name == "detail"
                  row gap=6 padding-left=12 padding-right=12 padding-bottom=12 flex-shrink=0 flex-wrap="wrap"
                    input hatch="feed" data-feed=feedWith value=fed input=setFed testId="fed" aria-label="Fed" placeholder="Fed" width=90 padding=6 border-width=1 border-style="solid" border-color="#d1d5db"
                    button press=feed testId="feed" padding=6 background-color="#e5e7eb"
                      text "Feed"
                    button hatch="presser" data-armed=(armed ? "true" : "false") data-loop=(looping && hatchPresses < 4000 ? hatchPresses.toString() : "off") press=hatchPress testId="hatch-press" padding=6 background-color="#e5e7eb"
                      text ("Pressed " + hatchPresses.toString())
                    button press=arm testId="arm" padding=6 background-color="#e5e7eb"
                      text "Arm"
                    button press=loop testId="loop" padding=6 background-color="#e5e7eb"
                      text "Loop"
                    button press=stopLoop testId="stop-loop" padding=6 background-color="#e5e7eb"
                      text "Stop"
                    column hatch="clock" data-frames=frameCount.toString() data-run=(clocking ? "true" : "false") data-presses=clockPresses.toString() press=clockPress testId="hatch-clock" width=24 height=24 background-color="#10b981"
                    button press=startClock testId="clock-start" padding=6 background-color="#e5e7eb"
                      text "Clock"
                    button press=stopClock testId="clock-stop" padding=6 background-color="#e5e7eb"
                      text "Halt"
                if e.name == "detail"
                  row gap=6 padding-left=12 padding-right=12 padding-bottom=12 flex-shrink=0 flex-wrap="wrap" align-items="center"
                    input type="date" hatch="due" data-weekends="off" value=due change=setDue min="2026-01-01" max="2027-12-31" testId="due" aria-label="Due" placeholder="Due"
                    input type="time" hatch="due" value=dueAt change=setDueAt testId="due-at" aria-label="Due at" placeholder="Due at"
                    input type="datetime-local" value=remind change=setRemind testId="remind" aria-label="Remind" placeholder="Remind me" accent-color="#d97706"
                    column hatch="spin" testId="hatch-spin" aria-label="Spinner" width=48 height=48
                if e.name == "detail"
                  row gap=6 padding-left=12 padding-right=12 padding-bottom=12 flex-shrink=0
                    row testId="post-row" press=openPost flex=1 padding-left=40 padding-right=40 padding-top=6 padding-bottom=6 background-color="#f3f4f6"
                      column testId="post-card" press=openCard flex=1 height=24 background-color="#dbeafe"
                    row testId="post-actions" flex=1 padding-left=40 padding-right=40 padding-top=6 padding-bottom=6
                      column testId="post-like" press=like flex=1 height=24 background-color="#fee2e2"
                if e.name == "detail"
                  scroll id="list-detail" hatch="detail-list" data-violate=violate testId="list-detail" flex=1 min-height=0 scrollTop=top
                    column padding=12 gap=8
                      text ("composed " + composed.toString()) testId="composed-detail"
                      column testId="tall" height=1600 background-color="#f3f4f6"
                // An "Open in…" at the foot of a card (LLP 1021 §5): its
                // chooser above it, centred on it (`top span-all`), as a menu
                // and as a sheet. Below the Detail screen's scroll, so it stays at
                // the foot whatever the screen's height.
                if e.name == "detail"
                  row testId="open-above-card" gap=6 padding=12 flex-shrink=0 justify-content="center"
                    button press=refreshProviders popovertarget="open-above" testId="open-above" padding=6 background-color="#e5e7eb"
                      text "Open in (above)"
                    button press=refreshProviders popovertarget="open-above-sheet" testId="open-above-sheet" padding=6 background-color="#e5e7eb"
                      text "Open in (sheet above)"
                    column id="open-above" testId="open-above-menu" popover="auto" position="absolute" position-area="top span-all" margin-bottom=12 role="menu" aria-label="Open location in" width=220 padding=8 background-color="#ffffff"
                      for p in providerItems key=p.id
                        button press=openIn(p.id) aria-checked=(p.id == remembered) popovertarget="open-above" popovertargetaction="hide" role="menuitemradio" testId=`open-above-${p.id}` height=44
                          text p.name
                    column id="open-above-sheet" popover="auto" position="absolute" position-area="top span-all" role="alertdialog" aria-label="Open location in" width=220 padding=8 background-color="#ffffff"
                      for p in providerItems key=p.id
                        button press=openIn(p.id) popovertarget="open-above-sheet" popovertargetaction="hide" testId=`open-above-sheet-${p.id}` height=44
                          text p.name
                      button popovertarget="open-above-sheet" popovertargetaction="hide" testId="open-above-sheet-cancel" height=44
                        text "Cancel"
                if e.name == "chat"
                  scroll id="list-chat" testId="list-chat" flex=1 min-height=0
                    column padding=12 gap=8 min-height="100%" box-sizing="border-box"
                      button press=openPhoto testId="photo" padding=6 background-color="#e5e7eb"
                        text "Photo"
                      button press=toggleSubtitle testId="toggle-subtitle" padding=6 background-color="#e5e7eb"
                        text "Subtitle"
                      button press=toggleMuted testId="toggle-muted" padding=6 background-color="#e5e7eb"
                        text "Muted"
                      button press=toggleShortChat testId="toggle-short-chat" padding=6 background-color="#e5e7eb"
                        text "Short"
                      text ("title presses " + titlePresses.toString()) testId="title-presses"
                      if not shortChat
                        column testId="tall-chat" height=1600 background-color="#f0fdf4"
                      text "End" testId="chat-end" margin-top="auto"
                // Rows that may shrink (CSS's default), measured as asked for.
                if e.name == "menu"
                  column testId="menu-rows" padding=16
                    button press=moreMenu testId="menu-more" height=44
                      text "More"
                    button press=fewerMenu testId="menu-fewer" height=44
                      text "Fewer"
                    for i in menuItems key=i
                      row height=44
                        text `Row ${i}`
                    button id="back" press=back testId="menu-close" height=44
                      text "Close"
                    button press=closeSheets testId="menu-home" height=44
                      text "Close both"
                // A sheet over a sheet: the menu pushed over Sheet presents
                // from Sheet's controller, and closing it returns to Sheet.
                if e.name == "sheet"
                  column testId="sheet-body" padding=16
                    // Two fields in a mounted sheet: focus bubbles out of it
                    // to the document's ancestors (LLP 1123 D2)
                    input id="sheet-a" testId="sheet-field-a" aria-label="Sheet A" height=32
                    input id="sheet-b" testId="sheet-field-b" aria-label="Sheet B" height=32
                    // A field low in a short scroller: revealed once the
                    // sheet's keyboard has settled (LLP 1123 C26)
                    scroll id="sheet-scroll" testId="sheet-scroll" height=60 flex-shrink=0
                      column height=200
                      input id="sheet-c" testId="sheet-field-c" aria-label="Sheet C" height=32
                    button press=openMenu testId="sheet-menu" height=44
                      text "Menu over the sheet"
                    button press=askMenu testId="sheet-ask" height=44
                      text "Menu once asked"
                    // A route pushed in the sheet's own stack: its bar's
                    // Back and the edge swipe pop it back to Sheet.
                    button press=detail testId="sheet-detail" height=44
                      text "Detail in the sheet"
                if e.name == "plain" and focusPlain
                  input testId="plain-first" aria-label="First field" autofocus=true margin=12 height=32
                  input testId="plain-second" aria-label="Second field" autofocus=true margin=12 height=32
                if e.name == "note" and focusNote
                  textarea testId="note-text" aria-label="Note" autofocus=true margin=12 height=120
                if e.name == "photo"
                  column testId="photo-view" flex=1 background-color="#000000" padding=12
                    button id="back" press=back testId="photo-back" aria-label="Close" padding=6 background-color="#e5e7eb" align-self="flex-start"
                      text "Close"
                if e.name == "second" and secondPage == ""
                  scroll id="list-second" testId="list-second" flex=1 min-height=0
                    column padding=12 gap=8
                      input appearance="none" value=draft input=setDraft testId="draft" aria-label="Draft" placeholder="A draft" padding=6 border-width=1 border-style="solid" border-color="#d1d5db"
                      button press=bump testId="bump-second" padding=6 background-color="#e5e7eb"
                        text "Bump"
                      button press=unbump testId="unbump-second" padding=6 background-color="#e5e7eb"
                        text "Clear"
                      exact-screen testId="screen" width="100%" height=96
                      text "Second" testId="second-top"
                      column testId="tall-second" height=1600 background-color="#eef2ff"
                      button press=showSecondPage("taller") testId="second-taller" padding=6 background-color="#e5e7eb"
                        text "Taller"
                if e.name == "second" and secondPage == "taller"
                  scroll id="list-second" testId="list-second-taller" flex=1 min-height=0
                    column padding=12 gap=8
                      text "Taller" testId="second-taller-top"
                      button press=showSecondPage("shorter") testId="second-shorter" padding=6 background-color="#e5e7eb"
                        text "Shorter"
                      column height=2400 background-color="#fef3c7"
                if e.name == "second" and secondPage == "shorter"
                  scroll id="list-second" testId="list-second-shorter" flex=1 min-height=0
                    column padding=12 gap=8
                      text "Shorter" testId="second-shorter-top"
      // Hidden on Chat and Photo, so the tab bar hides for them (§9.10);
      // its accent tints the bar's selected item.
      row role="tablist" aria-label="Tabs" testId="tabs" accent-color="#3838f5" appearance=(tabsAuthored ? "none" : "auto") display=((choosing and top(nav).name == "home") or top(nav).name == "chat" or top(nav).name == "photo" ? "none" : "flex") flex-shrink=0 height=56 border-top-width=1 border-top-style="solid" border-color="#e5e7eb" align-items="stretch"
        button role="tab" aria-controls="panel-home" aria-selected=(nav.tab == "home") press=selectTab("home") testId="tab-home" flex=1 display="flex" flex-direction="column" align-items="center" justify-content="center" gap=2
          image (nav.tab == "home" ? "symbol:home-fill" : "symbol:home") width=22 height=22
          text "Home" font-size=11
          // Not a badge (§9.9): a count box made transparent.
          column position="absolute" top=0 right=0 opacity=0 background-color="#ef4444" testId="faded-home"
            text "9" font-size=8
        button role="tab" aria-controls="panel-second" aria-selected=(nav.tab == "second") press=selectTab("second") testId="tab-second" flex=1 display="flex" flex-direction="column" align-items="center" justify-content="center" gap=2
          image (nav.tab == "second" ? "symbol:person-fill" : "symbol:person") width=22 height=22
          text "Second" font-size=11
          // Not a badge, beside the one below: a filled pill around a text and
          // a dot (a flat leaf). Were it taken, two boxes would make none.
          row position="absolute" top=0 left=0 background-color="#e5e7eb" testId="pill-second"
            text "pill" font-size=8
            box width=4 height=4 background-color="#ef4444"
          // A filled box holding a text: the bar item's badge (LLP 1075.003 §9.9).
          if count > 0
            column testId="badge-second" position="absolute" top=4 right=24 min-width=16 height=16 padding-left=4 padding-right=4 border-radius=8 background-color="#ef4444" align-items="center" justify-content="center"
              text count.toString() font-size=10 color="#ffffff"
      // A root toast after the tablist, positioned with no z-index: it
      // paints and takes touches over the routes, as later positioned
      // siblings do on the web (contract/corpus/tabs.contract; splitter
      // rough 3).
      if toast != ""
        button press=hush testId="root-toast" position="absolute" top=60 left=16 right=16 padding=12 background-color="#111827" border-radius=8
          text toast color="#ffffff"
      if overlayShown
        column testId="root-overlay" role="dialog" aria-label="Overlay" position="absolute" top=0 right=0 bottom=0 left=0 z-index=10 background-color="#000000cc" align-items="center" justify-content="center"
          button press=hideOverlay testId="hide-overlay" padding=12 background-color="#ffffff"
            text "Close"

component HatchedRows
  props
    items: Row[]
  state reuse = false
  action toggleReuse
    reuse = not reuse
  view
    column flex=1 min-height=0
      button press=toggleReuse testId="reuse" padding=6 margin=12 background-color="#e5e7eb"
        text (reuse ? "Rows reused" : "Rows not reused")
      // Each row's context menu (LLP 1021 §5.1): a row that names one still
      // parks in the node pool and is lent to the next (NodePoolIOS).
      column id="row-menu" popover="auto" position="absolute" role="menu" width=200 padding=8 background-color="#ffffff"
        button popovertarget="row-menu" popovertargetaction="hide" testId="row-menu-close" height=44
          text "Close"
      list virtualized=true hatch="feed" width="100%" flex=1 min-height=0 overflow-x="hidden" estimated-item-height=40 testId="hatched-list"
        for r in items key=r.n
          row contextPopover="row-menu" height=40 align-items="center" gap=8 padding-left=12 testId=`row-${r.n}`
            column hatch="dot" data-reuse=(reuse ? "true" : "false") width=12 height=12 border-radius=6 background-color="#6366f1"
            text ("Row " + r.n.toString())
            button press=toggleReuse testId=`row-button-${r.n}`
              text "Toggle"
