{
  "$schema": "../../scripts/app.schema.json",
  "name": "Native Fixture",
  "short_name": "Native Fixture",
  "id": "com.exact.nativefixture",
  "start_url": "/",
  "display": "standalone",
  "theme_color": "#ffffff",
  "background_color": "#ffffff",
  "app": {
    "id": "com.exact.nativefixture",
    "name": "Native Fixture"
  },
  "modules": ["exact-fixture", "exact-plain", "exact-absent", "exact-screen"],
  "data": ["armed", "feed", "frames", "loop", "menu", "presses", "reuse", "run", "screen", "tone", "transition", "violate"],
  "hatches": { "badge": ["ios", "macos", "web", "linux"], "detail-list": ["ios", "linux"], "dot": ["ios", "macos", "web", "linux"], "feed": ["ios", "macos", "web", "linux"], "presser": ["ios", "macos", "web", "linux"], "clock": ["ios", "macos", "web", "linux"] },
  "host": {
    "ios": {
      "minimumOS": "17.0",
      "deviceFamily": ["iphone", "ipad"]
    },
    "macos": {
      "minimumOS": "14.0",
      "window": { "width": 402, "height": 700, "minWidth": 320, "minHeight": 420 }
    },
    "web": {}
  },
  "deploy": {
    "store": { "web": "0", "macos": "0", "ios": "0", "linux": "0" }
  }
}
