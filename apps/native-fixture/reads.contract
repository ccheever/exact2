// data: native-fixture
// Action-only structural reads: point hits cross an overlay, data-word hits
// stay in tree order and skip display:none and inert descendants. The probe
// answers overlay,target,back and back,target; presses stays zero.
component StructuralReads
  state point = ""
  state marked = ""
  state presses = 0
  action probe
    point = elementsFromPoint(10, 10).join(",")
    marked = querySelectorAll("[data-tone~=\"accent\"]").join(",")
  action hit
    presses = presses + 1
  view
    main testId="root" width=250 height=220 position="relative"
      column id="back" width=100 height=100 data-tone="accent"
        button id="target" width=50 height=50 data-tone="accent" press=hit
          text "Save"
      column id="overlay" testId="overlay" position="absolute" left=0 top=0 width=60 height=60 pointermove=probe pointerdown=probe
      column id="hidden" display="none" data-tone="accent"
      column inert=true
        column id="inert" data-tone="accent"
      text `${point} / ${marked} / ${presses}` testId="out" margin-top=100
      button testId="read" press=probe position="absolute" left=100 top=60
        text "Read"
