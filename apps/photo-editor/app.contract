// Photo Editor — the first consumer of native modules (LLP 1024). The main
// surface is `<photo-editor>`, a native module in the app's own module crate
// (`modules/`): UIKit gestures on iOS, AppKit on macOS, Pointer Events on
// the web. The edit lives in the module; it reports its state when a gesture
// ends, and the Contract shows it. The two buttons are the way to edit
// without gestures: they change the module's props, never its internals.
//
// Take Photo opens the camera (LLP 1133.008 §10): the standard packages'
// viewfinder in a sheet over the editor, whose shutter's photo becomes the
// one edited. A sheet dismissed by a swipe hides the viewfinder, which lets
// the camera go; Take Photo shows the same track again.
//
// Save to Photos and Recents are @exact/photos's (LLP 1133.019 §11). The
// editor reports its edit in the photo's terms (`edit {"rotate", "crop"}`),
// which app.ts's `savePhoto` applies with `transformImage` and adds to the
// library. The strip of recent photos is read only once the person shows it
// or the read is granted; a photo opened from it is a copy in app:/tmp, and
// its picture stays in the header for as long as the app may read it.
//
// Order a Print is @exact/payments's (LLP 1133.034 §10): shown while the
// wallet can pay, a sheet of sizes over the editor whose payment button opens
// the wallet's sheet. app.ts's `tools` answer the sheet while it is up;
// leaving the print sheet lets the payment go. Orders is the lab's record.
use getUserMedia, applyConstraints, stopTrack, mediaStreamTrack, enumerateDevices, cameraStatus, MediaStream, MediaStreamTrack, MediaDeviceList, CameraStatus, MediaTrackConstraints from "@exact/media-capture"
use takePhoto, Photo from "@exact/camera"
use showPaymentRequest, paymentRequestStatus, PaymentResult, PaymentRequestStatus, PaymentMethodData, PaymentDetailsInit, PaymentOptions from "@exact/payments"
use photoLibraryStatus, copyPhotoAsset, managePhotoSelection, PhotoLibraryStatus, PhotoAssetList, PhotoCopy from "@exact/photos"

shape Saved
  saved: bool
  asset: string
  error: string
  message: string
  // What the saved file kept of the photo's metadata (`transformImage`'s report).
  metadata: string

// A print's checkout at the lab, with what the wallet's sheet is shown.
shape PrintCheckout
  id: string
  size: string
  price: string
  methodData: PaymentMethodData[]
  details: PaymentDetailsInit
  options: PaymentOptions
  // The checkout as JSON text, for the payment button.
  button: string
  error: string

shape PrintOrder
  id: string
  size: string
  price: string
  shipping: string
  state: string
  orderId: string

shape PrintOrders
  orders: PrintOrder[]
  error: string

routes nav
  editor "/"
    camera "/camera"
    print "/print"

component PhotoEditor
  state turns = 0
  state resets = 0
  state edit = "scale 1.00× · rotation 0.0° · pan x 0.00 y 0.00 · crop x 0.00 y 0.00 w 1.00 h 1.00"
  state edits = 0
  state ready = false
  state photo = "assets/sample.jpg"
  state track = ""
  state facing = "environment"
  // The edit in the photo's terms, as the editor last reported it.
  state photoEdit = "{}"
  state showRecents = false
  // The picture of the photo opened from the strip, and whether it was taken back.
  state openedPicture = ""
  state pictureGone = false
  state saveLine = ""
  state printing = false
  state printSize = "5x7"
  state printLine = ""
  state ordersRead = 0
  resource camera = cameraStatus() as shape CameraStatus else empty()
  resource devices = enumerateDevices() as shape MediaDeviceList else empty()
  resource live = mediaStreamTrack(track=track) as shape MediaStreamTrack else empty()
  resource library = photoLibraryStatus() as shape PhotoLibraryStatus else empty()
  resource recent = recents(showRecents || library.state == "granted") as shape PhotoAssetList else empty()
  mutation opened as shape MediaStream then show
  mutation shot as shape Photo then taken
  mutation adjusted as shape MediaStreamTrack
  mutation stopped as shape MediaStreamTrack
  mutation saved as shape Saved then wasSaved
  mutation copied as shape PhotoCopy then openCopy
  mutation managed as shape PhotoLibraryStatus
  resource checkout = printCheckout(printing, printSize) as shape PrintCheckout else empty()
  resource wallet = paymentRequestStatus(methodData=checkout.methodData) as shape PaymentRequestStatus else empty()
  resource orders = printOrders(ordersRead) as shape PrintOrders else empty()
  mutation ordered as shape PaymentResult then paid
  // A track the app holds that has not ended: Take Photo shows it again rather than asking for another.
  derive holding = track != "" && live.readyState == "live"
  derive canFlip = devices.devices.map(d => d.facingMode == some("user")).includes(true) && devices.devices.map(d => d.facingMode == some("environment")).includes(true)
  derive hasTorch = match live.capabilities { case some(c) => c.torch == some(true), case none => false }
  derive torchOn = live.settings.torch == some(true)
  // The camera that faces `facing`; every other constraint the platform's (LLP 1133.008 D2).
  derive facingOnly = MediaTrackConstraints(deviceId=none, groupId=none, facingMode=some(facing), width=none, height=none, aspectRatio=none, frameRate=none, resizeMode=none, zoom=none, torch=none, sampleRate=none, sampleSize=none, channelCount=none, echoCancellation=none, autoGainControl=none, noiseSuppression=none, latency=none)
  derive shotError = match failure(shot) { case some(f) => f.code, case none => "" }
  // A failed send runs no `then`, so its failure is read here; a cancel is no failure to the person.
  derive payFailure = match failure(ordered) { case some(f) => (f.code == "AbortError" ? "" : "Couldn’t pay (" + f.code + ")."), case none => "" }
  // A photo of the app's own (the camera's or a copy) can be transformed; the bundled sample cannot.
  derive canSave = library.available && library.addState != "denied" && photo.slice(0, 5) == "app:/"
  action rotate
    turns = turns + 1
  action reset
    turns = 0
    resets = resets + 1
  action changed(value: string)
    edit = value
  action told(message: string)
    if message == "edited"
      edits = edits + 1
    if message.slice(0, 5) == "edit "
      photoEdit = message.slice(5)
      saveLine = ""
  action loaded
    ready = true
  action takePicture
    if ! holding
      send opened = getUserMedia(video=true, videoConstraints=facingOnly)
    nav = push(nav, "/camera")
  action show
    match opened
      case some(s)
        track = match s.tracks.at(0) { case some(t) => t.id, case none => "" }
      case none
        track = track
  action flip
    send adjusted = applyConstraints(track=track, facingMode=(facing == "environment" ? "user" : "environment"))
    facing = facing == "environment" ? "user" : "environment"
  action torch
    send adjusted = applyConstraints(track=track, torch=! torchOn)
  action shutter
    send shot = takePhoto(track=track)
  action taken
    match shot
      case some(p)
        photo = p.path
        turns = 0
        resets = resets + 1
        openedPicture = ""
        photoEdit = "{}"
        send stopped = stopTrack(track=track)
        nav = back(nav)
      case none
        photo = photo
  action cancel
    send stopped = stopTrack(track=track)
    nav = back(nav)
  // Leaving the print sheet lets its payment go (`ordered = none`).
  action back
    if printing
      ordered = none
      printing = false
    nav = back(nav)
  action orderPrint
    printing = true
    printLine = ""
    ordersRead = ordersRead + 1
    nav = push(nav, "/print")
  action chooseSize(size: string)
    printSize = size
    printLine = ""
  action pay
    printLine = ""
    send ordered = showPaymentRequest(methodData=checkout.methodData, details=checkout.details, options=checkout.options, onmerchantvalidation="validateMerchant", onshippingaddresschange="quoteShipping", onshippingoptionchange="quoteShipping", onpaymentauthorized="placeOrder")
  action paid
    ordersRead = ordersRead + 1
    match ordered
      case some(r)
        printLine = r.result == "success" ? "Ordered. Your print is on its way." : (r.result == "unknown" ? "Your payment is being checked. Orders shows how it went." : "The payment didn’t go through.")
      case none
        printLine = ""
  action follow(url: string)
    nav = go(nav, url)
  action openSettings
    openURL("app-settings:")
  action save
    saveLine = ""
    send saved = savePhoto(photo, photoEdit)
  action wasSaved
    match saved
      case some(s)
        saveLine = s.message
      case none
        saveLine = match failure(saved) { case some(f) => "Couldn’t save to Photos (" + f.code + ").", case none => "" }
  action showPhotos
    showRecents = true
  action openRecent(id: string, picture: string)
    openedPicture = picture
    pictureGone = false
    send copied = copyPhotoAsset(asset=id)
  action openCopy
    match copied
      case some(c)
        photo = c.path
        turns = 0
        resets = resets + 1
        photoEdit = "{}"
      case none
        photo = photo
  action lostPicture(message: string)
    pictureGone = true
  action manage
    send managed = managePhotoSelection()
  view
    main navigationKey=`${top(nav).id}` navigationBack="back" navigate=follow color-scheme="dark" accent-color="light-dark(#245b9e, #bed6ff)" width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "editor"
          column navigationKey=`${e.id}` testId="photo-editor-app" position="absolute" inset=0 display="flex" flex-direction="column" background-color="-exact-background" color="-exact-label" font-family="system-ui"
            row flex-shrink=0 align-items="center" gap=12 padding-left=16 padding-right=16 padding-top=12 padding-bottom=12
              if openedPicture != ""
                image openedPicture testId="opened-picture" width=32 height=32 object-fit="cover" border-radius=6 alt="The photo being edited" error=lostPicture
              text "Photo Editor" flex=1 font-size=19 font-weight=600
              text (ready ? "Ready" : "Loading…") testId="status" font-size=13 color="-exact-secondary-label"
            photo-editor testId="editor" flex=1 min-height=0 width="100%" photo=photo turns=turns reset=resets aria-label="Photo. Pinch to zoom, turn two fingers to rotate, drag to move, drag the crop corners or edges, double-tap to reset; the buttons below do the same without gestures" load=loaded change=changed message=told
            column flex-shrink=0 gap=10 padding=16 background-color="-exact-secondary-background"
              text "Edit" font-size=12 font-weight=600 color="-exact-secondary-label"
              text edit testId="edit" aria-live="polite" font-size=15 font-variant-numeric="tabular-nums"
              text ("Edited " + edits.toString() + (edits == 1 ? " time" : " times")) testId="edits" font-size=13 color="-exact-secondary-label"
              if camera.state == "denied"
                row align-items="center" gap=12 flex-wrap="wrap" testId="camera-denied"
                  text "The camera is off for Photo Editor. Turn it on in Settings." font-size=13 color="-exact-secondary-label" flex=1
                  button press=openSettings testId="open-settings" aria-label="Open Settings"
                    text "Open Settings"
              row gap=10 flex-wrap="wrap"
                // Apple's AccentColorText stays white on this pale dark-scheme accent.
                button press=rotate testId="rotate" aria-label="Rotate the photo 90 degrees clockwise" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="AccentColor" color="light-dark(#ffffff, #000000)"
                  text "Rotate 90°" font-size=15 font-weight=600
                button press=reset testId="reset" aria-label="Reset zoom, rotation, position and crop" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="-exact-fill" color="-exact-label"
                  text "Reset" font-size=15 font-weight=600
                if camera.available && camera.state != "denied"
                  button press=takePicture testId="take-photo" aria-label="Take a photo to edit" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="-exact-fill" color="-exact-label"
                    text "Take Photo" font-size=15 font-weight=600
                if wallet.canMakePayment
                  button press=orderPrint testId="order-print" aria-label="Order a print of this photo" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="-exact-fill" color="-exact-label"
                    text "Order a Print" font-size=15 font-weight=600
                if canSave
                  button press=save testId="save" aria-label="Save the edited photo to Photos" disabled=pending(saved) padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="-exact-fill" color="-exact-label"
                    text "Save to Photos" font-size=15 font-weight=600
              if saveLine != ""
                text saveLine testId="save-line" aria-live="polite" font-size=13 color="-exact-secondary-label"
              if library.available && library.addState == "denied"
                row align-items="center" gap=12 flex-wrap="wrap" testId="save-denied"
                  text "Photo Editor can’t add to your photos. Turn it on in Settings." font-size=13 color="-exact-secondary-label" flex=1
                  button press=openSettings testId="open-photo-settings" aria-label="Open Settings"
                    text "Open Settings"
              if library.available
                column gap=8 testId="recents"
                  text "Recent photos" role="heading" aria-level=2 font-size=12 font-weight=600 color="-exact-secondary-label"
                  if library.state == "denied"
                    row align-items="center" gap=12 flex-wrap="wrap" testId="recents-denied"
                      text "Photo Editor can’t see your photos. Turn it on in Settings." font-size=13 color="-exact-secondary-label" flex=1
                      button press=openSettings testId="open-recents-settings" aria-label="Open Settings"
                        text "Open Settings"
                  if library.state == "prompt" && ! showRecents
                    button press=showPhotos testId="show-recents" aria-label="Show your recent photos" align-self="flex-start" padding-left=16 padding-right=16 padding-top=10 padding-bottom=10 border-radius=8 background-color="-exact-fill" color="-exact-label"
                      text "Show" font-size=15 font-weight=600
                  if library.state != "denied" && recent.assets.length > 0
                    row gap=6 overflow-x="auto" testId="recent-strip"
                      for a, i in recent.assets key=a.id
                        button press=openRecent(a.id, a.picture) testId=`recent-${i + 1}` aria-label=`Edit photo ${i + 1}` flex-shrink=0 padding=0 border-radius=6 overflow="hidden"
                          image a.picture width=64 height=64 object-fit="cover" alt=`Photo ${i + 1}`
                  if library.access == "limited"
                    row align-items="center" gap=12 flex-wrap="wrap" testId="limited"
                      text "The photos you chose" font-size=13 color="-exact-secondary-label" flex=1
                      button press=manage testId="manage" aria-label="Choose which photos Photo Editor can see"
                        text "Manage"
        if e.name == "camera"
          column navigationKey=`${e.id}` navigationPresentation="modal" testId="camera" position="absolute" inset=0 display="flex" flex-direction="column" background-color="#000000" color="#ffffff"
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              button press=cancel testId="cancel" aria-label="Cancel"
                text "Cancel"
              text "Camera" role="heading" aria-level=2
              if hasTorch
                button press=torch testId="torch" aria-label=(torchOn ? "Turn the torch off" : "Turn the torch on")
                  text (torchOn ? "Torch Off" : "Torch On")
            exact-camera srcObject=track testId="viewfinder" flex=1 min-height=0 width="100%" aria-label="Viewfinder"
            if shotError != ""
              text shotError testId="shot-error" font-size=13 text-align="center" padding=8
            row flex-shrink=0 align-items="center" justify-content="center" gap=40 padding=20
              if canFlip
                button press=flip testId="flip" aria-label="Switch camera" appearance="none" color="#ffffff" padding=12
                  text "Flip"
              button press=shutter testId="shutter" aria-label="Take Photo" width=72 height=72 border-radius="50%" background-color="#ffffff" border="4px solid #8a8a8a"
        if e.name == "print"
          column navigationKey=`${e.id}` navigationPresentation="modal" testId="print" position="absolute" inset=0 display="flex" flex-direction="column" background-color="-exact-background" color="-exact-label"
            header display="flex" align-items="center" justify-content="space-between" padding="8px 16px"
              button press=back testId="close-print" aria-label="Close"
                text "Close"
              text "Order a Print" role="heading" aria-level=2
            column flex=1 min-height=0 overflow-y="auto" gap=12 padding=16
              row gap=8 role="radiogroup" aria-label="Print size"
                for size in ["4x6", "5x7", "8x10"] key=size
                  button press=chooseSize(size) testId=`size-${size}` role="radio" aria-checked=(printSize == size) padding-left=14 padding-right=14 padding-top=8 padding-bottom=8 border-radius=8 background-color=(printSize == size ? "AccentColor" : "-exact-fill") color=(printSize == size ? "light-dark(#ffffff, #000000)" : "-exact-label")
                    text size.replaceAll("x", "×") font-size=15 font-weight=600
              if checkout.error != ""
                text checkout.error testId="print-error" font-size=13 color="-exact-secondary-label"
              if checkout.id != ""
                text `${checkout.size.replaceAll("x", "×")} print: $${checkout.price}, plus shipping` testId="print-price" font-size=15 font-variant-numeric="tabular-nums"
                if wallet.canMakePayment
                  exact-payment-button buttonType="order" checkout=checkout.button press=pay testId="pay" disabled=pending(ordered) height=44
              if printLine != ""
                text printLine testId="print-line" aria-live="polite" font-size=13 color="-exact-secondary-label"
              if payFailure != ""
                text payFailure testId="print-failure" aria-live="polite" font-size=13 color="-exact-secondary-label"
              if orders.orders.length > 0
                column gap=6 testId="orders"
                  text "Orders" role="heading" aria-level=3 font-size=12 font-weight=600 color="-exact-secondary-label"
                  for o in orders.orders key=o.id
                    row gap=8 testId=`order-${o.id}`
                      text `${o.size.replaceAll("x", "×")} print` flex=1 font-size=13
                      text (o.state == "paid" ? `Paid · ${o.orderId}` : o.state) font-size=13 color="-exact-secondary-label" font-variant-numeric="tabular-nums"
