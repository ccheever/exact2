// Duo Lab (LLP 1078 D8): the first consumer of `device-posture` and the
// viewport segments, and the iPhone Duo's stress fixture — what
// `bun scripts/smoke.mjs duo` drives fully open, partially folded and closed.
//
// Fold reads the three fields `exactViewport` gained and lays two panes on its route's segments
// (`var(--exact-viewport-segment-*)`, LLP 1123 D9), the fold band empty between them. Images is a virtualized list of a few
// hundred image rows over four bundled PNGs (the raster budget's stress).
// Reflow is one long Markdown document and a dense feed (the text caches'
// stress from 951 to 466 points and back). Combinations pushes a route with
// an absolutely positioned sheet holding a textarea, so keyboard + sheet +
// pushed screen + fold is one sequence of taps. Keyboard adds physical-device
// checks with an app-local geometry recorder and a native share sheet.

routes nav
  tab fold "/"
  tab images "/images"
  tab reflow "/reflow"
  tab combos "/combos"
    note "/combos/note"
  tab keyboard "/keyboard"
    keyboard-editor "/keyboard/editor"
    keyboard-form "/keyboard/form"
    keyboard-search "/keyboard/search"

// The web's vocabulary, exactly (LLP 1078 D1, D2): two postures, two counts.
shape Viewport
  width: number
  height: number
  devicePosture: string
  horizontalViewportSegments: number
  verticalViewportSegments: number
shape Item
  id: number
  title: string
  summary: string
  body: string
shape ImageRow
  id: number
  asset: string
  caption: string
shape Document
  body: string
shape FeedRow
  id: number
  who: string
  body: string
shape KeyboardRow
  id: number

style Screen
  position="absolute"
  top=0
  left=0
  right=0
  bottom=0
  display="flex"
  flex-direction="column"
// Add only the readable region beyond the list's existing native margins
style ReadableList
  margin-left="max(0px, calc(var(--exact-readable-content-corners-inset-left) - var(--exact-layout-margins-corners-inset-left)))"
  margin-right="max(0px, calc(var(--exact-readable-content-corners-inset-right) - var(--exact-layout-margins-corners-inset-right)))"
// The safe area kept clear of the panel's rounded corners (LLP 1123 D10)
style Safe
  box-sizing="border-box"
  padding-top="var(--exact-safe-area-corners-inset-top)"
  padding-right="var(--exact-safe-area-corners-inset-right)"
  padding-bottom="var(--exact-safe-area-corners-inset-bottom)"
  padding-left="var(--exact-safe-area-corners-inset-left)"
// A header as the agent and the web paint it, clear of the corners; on iOS
// it is UIKit's navigation bar
style Head
  padding-top="calc(var(--exact-safe-area-corners-inset-top) + 8px)"
  padding-right="calc(var(--exact-safe-area-corners-inset-right) + 16px)"
  padding-bottom=8
  padding-left="calc(var(--exact-safe-area-corners-inset-left) + 16px)"
style Note
  font-size=13
  color="-exact-secondary-label"
  padding-left=16
  padding-right=16
style Fact
  font-size=15
  font-weight=600
  font-family="monospace"
style Card
  background-color="-exact-secondary-background"
  border-radius=12
  padding=12
  box-sizing="border-box"

// A sheet snaps between a peek and a reading height from where it was let go.
fn sheetStop(projected: number): number = projected < 300 ? 200 : 400

component DuoLab
  resource viewport = exactViewport() as shape Viewport
  resource items = items() as shape Item[]
  resource rows = imageRows() as shape ImageRow[]
  resource doc = document() as shape Document
  resource feed = feed() as shape FeedRow[]
  resource keyboardRows = keyboardRows() as shape KeyboardRow[]
  // Shared across the Fold screen's two layouts: a fold mid-reading keeps the item.
  state selected = 1
  state title = ""
  state draft = ""
  state noteFocused = false
  state sheetPx = 400
  state checkText = ""
  state checkUsername = ""
  state checkPassword = ""
  state checkEditor = ""
  state checkFirst = ""
  state checkLast = ""
  state checkQuery = ""
  state checkCommitted = ""
  state checkBlurs = 0
  state returnFocus = false
  derive current = top(nav)
  derive twoAcross = viewport.horizontalViewportSegments == 2
  derive twoDown = viewport.verticalViewportSegments == 2
  // Combinations and the note screen are each a pane of controls, not content read down a
  // page, so a fold moves it (docs/recipes/foldables.md); Combinations scrolls only where its
  // controls do not fit. On a book fold (two segments across) it takes
  // the trailing segment, as Apple's talk moves an alert there, near the outer display as
  // the device closes. On one segment it is a column at most 480 points wide, about one
  // panel, so a fold hardly resizes it; it is centred in its route's content root, beside
  // the side strip the route clears (LLP 1123 D3), as a view centred on its controller's
  // safe area is. Its padding keeps only the part of an inset that its margin does not
  // clear.
  // The tablist's tabs, where it is a bar along the bottom, keep to the trailing segment too.
  derive gutter = "max(0px, calc((100% - 480px) / 2))"
  derive paneLeft = twoAcross ? "var(--exact-viewport-segment-left-1-0, 0px)" : gutter
  derive paneRight = twoAcross ? "0px" : gutter
  derive panePadLeft = `max(0px, calc(var(--exact-readable-content-corners-inset-left) - 16px - ${paneLeft}))`
  derive panePadRight = twoAcross ? "var(--exact-safe-area-corners-inset-right)" : `max(0px, calc(var(--exact-readable-content-corners-inset-right) - 16px - ${gutter}))`
  // Combinations' content keeps to the layout margins, the title's: on a book fold from the
  // band, where UIKit's detail column keeps its 20-point margin (LLP 1127 §1).
  derive comboPadLeft = `max(${twoAcross ? "20px" : "0px"}, calc(var(--exact-layout-margins-corners-inset-left) - ${paneLeft}))`
  derive comboPadRight = `max(0px, calc(var(--exact-layout-margins-corners-inset-right) - ${paneRight}))`
  action choose(id: number)
    selected = id
  action selectTab(name: string)
    nav = select(nav, name)
  action openNote
    nav = push(nav, path("note"))
  action navigate(location: string)
    nav = open(nav, location)
  action writeTitle(value: string)
    title = value
  action write(value: string)
    draft = value
  action focusIn
    noteFocused = true
  action focusOut
    noteFocused = false
  action snapSheet(height: number, velocity: number)
    sheetPx = sheetStop(height + velocity * 0.15)
  action dismiss
    blur()
  action checkOpenEditor(claim: bool)
    returnFocus = claim
    nav = push(nav, path("keyboard-editor"))
  action checkOpen(name: string)
    returnFocus = false
    nav = push(nav, name)
  action checkDismissBack
    returnFocus = false
    blur()
    nav = back(nav)
  action checkFocusFirst
    focus("keyboard-first")
  action checkFocusLast
    focus("keyboard-last")
  action checkWrite(v: string)
    checkText = v
  action checkWriteUsername(v: string)
    checkUsername = v
  action checkWritePassword(v: string)
    checkPassword = v
  action checkWriteEditor(v: string)
    checkEditor = v
  action checkWriteFirst(v: string)
    checkFirst = v
  action checkWriteLast(v: string)
    checkLast = v
  action checkWriteQuery(v: string)
    checkQuery = v
  action checkCommit(v: string)
    checkCommitted = v
  action checkSearchBlur
    checkBlurs = checkBlurs + 1
  view
    main testId="root" navigationKey=`${current.id}` navigationBack="back" navigate=navigate viewport-fit="cover" interactive-widget="resizes-content" width="100%" height="100%" display="flex" flex-direction="column" overflow="hidden" font-family="system-ui"
      column flex=1 min-height=0 position="relative"
        for t in nav.tabs key=t.name
          column role="tabpanel" id=`panel-${t.name}` position="absolute" inset=0
            for entry in t.stack key=entry.id
              if t.name == "keyboard"
                column navigationKey=`${entry.id}` navigationScroll=`keyboard-scroll-${entry.id}` id=`keyboard-route-${entry.id}` hatch="keyboard-route" data-keyboard-screen=entry.name data-focus-on-show=(entry.name == "keyboard-editor" ? "keyboard-editor" : entry.name == "keyboard" and returnFocus ? "keyboard-return" : "") class=Screen background-color=((entry.name == "keyboard" or entry.name == "keyboard-form") ? "-exact-grouped-background" : "Canvas") testId=`screen-${entry.name}`
                  header class=Head display="flex" align-items="center" gap=8
                    text (entry.name == "keyboard" ? "Keyboard Check" : entry.name == "keyboard-form" ? "Far Focus" : entry.name == "keyboard-search" ? "Search" : "Editor") role="heading" aria-level=2
                    if entry.name == "keyboard-form"
                      button press=checkFocusFirst retainFocus=true testId="keyboard-focus-first"
                        text "First"
                    if entry.name == "keyboard-search"
                      input type="search" value=checkQuery input=checkWriteQuery change=checkCommit blur=checkSearchBlur autofocus=true placeholder="Type sample text" aria-label="Search" testId="keyboard-search-field"
                  if entry.name == "keyboard"
                    list id=`keyboard-scroll-${entry.id}` flex=1 min-height=0 appearance="auto" listStyle="inset-grouped" class=ReadableList testId="keyboard-checks"
                      section
                        header
                          text "Start here"
                        row
                          text "Tap Record in the bar. Run one check, then tap Share to send diagnostics. Use sample text, not a real password."
                      section
                        header
                          text "Back and keyboard"
                        button press=checkOpenEditor(false) testId="keyboard-open-editor"
                          text "Open editor"
                        row
                          text "Type, swipe Back halfway and cancel, then complete a swipe. Repeat with the Back button. The returning screen should fill the window."
                        button press=checkOpen("/keyboard/search") testId="keyboard-open-search"
                          text "Open header search"
                        row
                          text `Last committed search: ${checkCommitted == "" ? "(empty)" : checkCommitted}. Blurs: ${checkBlurs}.`
                      section
                        header
                          text "Native returning focus"
                        row
                          input id="keyboard-return" hatch="keyboard-field" value=checkText input=checkWrite placeholder="Returning field" aria-label="Returning field" testId="keyboard-return" flex=1
                        button press=checkOpenEditor(true) retainFocus=true testId="keyboard-open-handoff"
                          text "Open editor; return focus here"
                        row
                          text "A native UIKit focus claim during Back should keep the keyboard up. This case uses the hatched native field, not the queued focus() action. A cancelled swipe should restore focus to the editor without lowering the keyboard."
                      section
                        header
                          text "Text and password"
                        row
                          input id="keyboard-username" hatch="keyboard-field" value=checkUsername input=checkWriteUsername autocomplete="username" placeholder="Sample username" aria-label="Sample username" testId="keyboard-username" flex=1
                        row
                          input id="keyboard-password" hatch="keyboard-field" type="password" value=checkPassword input=checkWritePassword autocomplete="current-password" placeholder="Sample password" aria-label="Sample password" testId="keyboard-password" flex=1
                        row
                          text "Switch fields several times. Share a screen recording too if the form or keyboard jumps."
                      section
                        header
                          text "Offscreen focus"
                        button press=checkOpen("/keyboard/form") testId="keyboard-open-form"
                          text "Open the long form"
                        row
                          text "Tap the first field, then Focus last. The last field and Done should appear above the keyboard. Use First to jump back, and repeat."
                  if entry.name == "keyboard-editor"
                    scroll id=`keyboard-scroll-${entry.id}` flex=1 min-height=0 padding-top=16 padding-bottom=16 padding-left="var(--exact-readable-content-corners-inset-left)" padding-right="var(--exact-readable-content-corners-inset-right)" testId="keyboard-editor-scroll"
                      column gap=16
                        text "Type sample text. Try a cancelled swipe, a completed swipe, and the native Back button."
                        input id="keyboard-editor" hatch="keyboard-field" value=checkEditor input=checkWriteEditor placeholder="Type here" aria-label="Editor" testId="keyboard-editor" width="100%"
                        button press=checkDismissBack testId="keyboard-dismiss-back"
                          text "Dismiss keyboard and go Back"
                        text "If a blank band appears, tap Share immediately. The file keeps the recent geometry from before the share sheet."
                  if entry.name == "keyboard-form"
                    list id=`keyboard-scroll-${entry.id}` flex=1 min-height=0 appearance="auto" listStyle="inset-grouped" class=ReadableList testId="keyboard-long-form"
                      section
                        row
                          input id="keyboard-first" hatch="keyboard-field" value=checkFirst input=checkWriteFirst placeholder="First field" aria-label="First field" testId="keyboard-first" flex=1
                        button press=checkFocusLast retainFocus=true testId="keyboard-focus-last"
                          text "Focus last"
                      section
                        for r in keyboardRows key=r.id
                          row
                            text `Row ${r.id + 1}`
                      section
                        row
                          input id="keyboard-last" hatch="keyboard-field" value=checkLast input=checkWriteLast placeholder="Last field" aria-label="Last field" testId="keyboard-last" flex=1
                        button press=dismiss testId="keyboard-form-done"
                          text "Done"
                  if entry.name == "keyboard-search"
                    scroll id=`keyboard-scroll-${entry.id}` flex=1 min-height=0 padding-top=16 padding-bottom=16 padding-left="var(--exact-readable-content-corners-inset-left)" padding-right="var(--exact-readable-content-corners-inset-right)"
                      text "Type sample text in the header, then use Back. The previous screen should show the final committed text and one blur. Repeat with a swipe. Check the committed text after Back, then Share from that screen; recording continues through Back."
              // Every screen's header is the platform's: on iOS, UIKit's navigation bar.
              // Reflow and Images scroll the whole width under it, and UIKit takes the
              // large title away as the scroller immediately following the header moves.
              if entry.name == "images"
                column navigationKey=`${entry.id}` navigationScroll="image-list" class=Screen testId="screen-images"
                  header class=Head
                    text "Images" role="heading" aria-level=1 testId="images-title"
                    text `${rows.length} ${rows.length == 1 ? "row" : "rows"} over four pictures; fold mid-scroll.`
                  list id="image-list" appearance="none" virtualized=true estimated-item-height=236 flex=1 min-height=0 width="100%" box-sizing="border-box" padding-left="var(--exact-readable-content-corners-inset-left)" padding-right="var(--exact-readable-content-corners-inset-right)" overflow-x="hidden" testId="image-list"
                    for row in rows key=row.id
                      column width="100%" box-sizing="border-box" padding-top=12 testId=`image-row-${row.id}`
                        image row.asset aria-label=row.caption width="100%" height=190 border-radius=12 object-fit="cover" background-color="-exact-secondary-background"
                        text row.caption font-size=13 padding-top=6 color="-exact-secondary-label"
              if entry.name == "reflow"
                column navigationKey=`${entry.id}` navigationScroll="reflow-scroll" class=Screen testId="screen-reflow"
                  header class=Head
                    text "Reflow" role="heading" aria-level=1 testId="reflow-title"
                  scroll id="reflow-scroll" flex=1 min-height=0 width="100%" box-sizing="border-box" padding-left="var(--exact-readable-content-corners-inset-left)" padding-right="var(--exact-readable-content-corners-inset-right)" testId="reflow-scroll"
                    column width="100%" box-sizing="border-box" padding-top=16 padding-bottom=16 gap=16
                      text doc.body markup="markdown" testId="document" width="100%" font-size=17 line-height="26px"
                      text "Feed" font-size=22 font-weight=700 testId="feed-title"
                      for post in feed key=post.id
                        row gap=10 class=Card testId=`feed-${post.id}`
                          text post.who font-size=14 font-weight=600 flex-shrink=0 width=72
                          text post.body font-size=14 flex=1 min-width=0
              // The note screen takes its bottom edge (LLP 1123 D4): its sheet's surface reaches
              // the display's bottom, as a sheet's does, and pads its controls by the route's inset there.
              if entry.name != "images" and entry.name != "reflow" and t.name != "keyboard"
                column navigationKey=`${entry.id}` -exact-safe-area=(entry.name == "note" ? "bottom" : "auto") class=Screen testId=`screen-${entry.name}`
                  header class=Head
                    text (entry.name == "fold" ? "Fold" : entry.name == "combos" ? "Combinations" : "Note") role="heading" aria-level=(entry.name == "note" ? 2 : 1) testId=`${entry.name}-title`
                  if entry.name == "fold"
                    // Two segments across: the list on the first, the detail on the
                    // second, each inset on its own side by the safe area kept clear
                    // of the panel's corners (LLP 1123 D10); two down
                    // (the Duo's inner panel upright): the list on the upper, the
                    // detail on the lower. The route's own segments place them (LLP
                    // 1123 D9), with flex rather than from the route's top, so a
                    // header the page draws (the agent's chrome, the web) only takes
                    // room from the list: the band between them is a spacer, and the
                    // detail is the rest from the second segment's start. A pane
                    // reaching the bottom ends where the route does. The band belongs
                    // to neither (LLP 1078 D1, D3); one segment stacks the panes. The
                    // branch reads the window's count, so each length falls back to
                    // halves where the route holds one segment of the two.
                    if twoAcross
                      row flex=1 min-height=0
                        column testId="pane-list" flex-shrink=0 margin-left="var(--exact-viewport-segment-left-0-0, 0px)" width="var(--exact-viewport-segment-width-0-0, 50%)" box-sizing="border-box" padding-top="var(--exact-safe-area-corners-inset-top)" padding-bottom="var(--exact-safe-area-corners-inset-bottom)" padding-left="var(--exact-safe-area-corners-inset-left)"
                          Facts(viewport=viewport)
                          ItemList(items=items, selected=selected, choose=choose)
                        column testId="pane-detail" flex=1 min-width=0 margin-left="calc(var(--exact-viewport-segment-left-1-0, 50%) - var(--exact-viewport-segment-left-0-0, 0px) - var(--exact-viewport-segment-width-0-0, 50%))" box-sizing="border-box" padding-top="var(--exact-safe-area-corners-inset-top)" padding-right="var(--exact-safe-area-corners-inset-right)" padding-bottom="var(--exact-safe-area-corners-inset-bottom)" background-color="-exact-secondary-background"
                          Detail(items=items, selected=selected)
                    else
                      if twoDown
                        column testId="pane-list" flex=1 min-height=0 width="100%" box-sizing="border-box" padding-top="var(--exact-safe-area-corners-inset-top)" padding-right="var(--exact-safe-area-corners-inset-right)" padding-left="var(--exact-safe-area-corners-inset-left)"
                          Facts(viewport=viewport)
                          ItemList(items=items, selected=selected, choose=choose)
                        column testId="pane-detail" flex-shrink=0 margin-top="calc(var(--exact-viewport-segment-top-0-1, 50%) - var(--exact-viewport-segment-top-0-0, 0px) - var(--exact-viewport-segment-height-0-0, 50%))" height="calc(100% - var(--exact-viewport-segment-top-0-1, 50%))" width="100%" box-sizing="border-box" padding-right="var(--exact-safe-area-corners-inset-right)" padding-bottom="var(--exact-safe-area-corners-inset-bottom)" padding-left="var(--exact-safe-area-corners-inset-left)" background-color="-exact-secondary-background"
                          Detail(items=items, selected=selected)
                      else
                        column testId="pane-list" flex=1 min-height=0 width="100%" box-sizing="border-box" padding-top="var(--exact-safe-area-corners-inset-top)" padding-right="var(--exact-safe-area-corners-inset-right)" padding-left="var(--exact-safe-area-corners-inset-left)"
                          Facts(viewport=viewport)
                          ItemList(items=items, selected=selected, choose=choose)
                        column testId="pane-detail" flex=1 min-height=0 width="100%" box-sizing="border-box" padding-right="var(--exact-safe-area-corners-inset-right)" padding-bottom="var(--exact-safe-area-corners-inset-bottom)" padding-left="var(--exact-safe-area-corners-inset-left)" background-color="-exact-secondary-background"
                          Detail(items=items, selected=selected)
                  if entry.name == "combos"
                    // The bar's scroller, as a screen of controls is in UIKit: it reaches
                    // every control at any text size and on the outer display.
                    scroll flex=1 min-height=0 testId="combos-scroll"
                      // UIKit insets the scroller for the bars; the column has only its own room.
                      column margin-left=paneLeft margin-right=paneRight box-sizing="border-box" padding-top=16 padding-bottom=16 padding-left=comboPadLeft padding-right=comboPadRight testId="combos-content"
                        text "Push a screen, open its sheet, raise the keyboard, then fold." class=Note padding-left=0 padding-right=0
                        column padding-top=16 gap=12
                          button press=openNote testId="open-note" padding=14 border-radius=10 background-color="AccentColor"
                            text "Push the note screen" font-size=16 font-weight=600 color="AccentColorText"
                          text `Draft so far: ${title == "" and draft == "" ? "(nothing)" : title + " / " + draft}` testId="draft-echo" font-size=14 color="-exact-secondary-label"
                  if entry.name == "note"
                    // One box below the header holds the note and its sheet: the route's content root,
                    // whose height the sheet's `100%` and the route's segments are measured from (LLP 1123 D9).
                    column flex=1 min-height=0 position="relative" testId="note-body"
                      column flex=1 min-height=0 margin-left=paneLeft margin-right=paneRight class=Safe padding-left=panePadLeft padding-right=panePadRight
                        text "A pushed route. The sheet below holds a textarea; its keyboard shortens the route (resizes-content)." class=Note padding-top=8
                      // Partially folded like a laptop, the sheet keeps to the lower segment, where Apple's
                      // talk puts controls, and below the bar. The route's lower segment exists only while
                      // its content root reaches it, so once the keyboard ends the route above the band the
                      // fallback lifts that cap and the sheet rides the keyboard in the room below the bar.
                      column id="note-sheet" testId="note-sheet" position="absolute" bottom=0 left=paneLeft right=paneRight height=sheetPx max-height="min(calc(100% - var(--exact-safe-area-corners-inset-top)), calc(100% - var(--exact-viewport-segment-top-0-1, 0px)))" box-sizing="border-box" padding=16 padding-right=`calc(max(0px, var(--exact-safe-area-corners-inset-right) - ${paneRight}) + 16px)` padding-bottom="calc(var(--exact-safe-area-corners-inset-bottom) + 16px)" padding-left=`calc(max(0px, var(--exact-safe-area-corners-inset-left) - ${paneLeft}) + 16px)` gap=12 background-color="-exact-secondary-background" border-top-left-radius=20 border-top-right-radius=20 transition="height -exact-spring(300, 30, 1)"
                        column heightDragFor="note-sheet" heightrelease=snapSheet touch-action="none" testId="sheet-handle" aria-label="Resize the note sheet" gap=3
                          text "Note" font-size=18 font-weight=600
                          text "Drag to resize" font-size=11 color="-exact-secondary-label"
                        row gap=12 align-items="center"
                          button press=dismiss testId="note-dismiss" padding=10 border-radius=8 background-color="-exact-tertiary-fill"
                            text "Dismiss the keyboard" font-size=14 font-weight=600
                          text (noteFocused ? "editing" : "idle") testId="note-state" font-size=13 color="-exact-secondary-label"
                        input appearance="none" value=title input=writeTitle focus=focusIn blur=focusOut placeholder="Title" testId="note-title-input" aria-label="Title" width="100%" box-sizing="border-box" padding=10 border-width=1 border-style="solid" border-color="-exact-separator" border-radius=10 font-size=16
                        textarea appearance="none" value=draft input=write focus=focusIn blur=focusOut placeholder="Write, then fold" testId="note-textarea" aria-label="Note" width="100%" min-height=96 box-sizing="border-box" padding=12 border-width=1 border-style="solid" border-color="-exact-separator" border-radius=10 font-size=16 line-height="22px"
      // Hidden on the note screen, an editor, as the guide hides a route's tab bar
      // (docs/contract-for-agents.md, "Hide the tab bar on a route"). On a book
      // fold its tabs keep to the trailing segment with the panes, by a padding the web's
      // sidebar (900px and wider) overrides.
      row role="tablist" testId="tab-bar" display=(current.name == "note" ? "none" : "flex") padding-left=(twoAcross ? "env(viewport-segment-left 1 0)" : "0px")
        button role="tab" aria-controls="panel-fold" aria-selected=(nav.tab == "fold") press=selectTab("fold") testId="tab-fold" flex=1
          image "symbol:book"
          text "Fold"
        button role="tab" aria-controls="panel-images" aria-selected=(nav.tab == "images") press=selectTab("images") testId="tab-images" flex=1
          image "symbol:photo"
          text "Images"
        button role="tab" aria-controls="panel-reflow" aria-selected=(nav.tab == "reflow") press=selectTab("reflow") testId="tab-reflow" flex=1
          image "symbol:document"
          text "Reflow"
        button role="tab" aria-controls="panel-combos" aria-selected=(nav.tab == "combos") press=selectTab("combos") testId="tab-combos" flex=1
          image "symbol:layers"
          text "Combos"
        button role="tab" aria-controls="panel-keyboard" aria-selected=(nav.tab == "keyboard") press=selectTab("keyboard") testId="tab-keyboard" flex=1
          image "symbol:sf/keyboard"
          text "Keyboard"

// The three facts and the viewport, printed so a screenshot is its own evidence.
component Facts
  props
    viewport: Viewport
  view
    column padding-left=16 padding-right=16 padding-top=12 gap=2
      row gap=8 align-items="baseline"
        text "device-posture" class=Note padding=0
        text viewport.devicePosture class=Fact testId="fact-posture"
      row gap=8 align-items="baseline"
        text "horizontal-viewport-segments" class=Note padding=0
        text `${viewport.horizontalViewportSegments}` class=Fact testId="fact-h"
      row gap=8 align-items="baseline"
        text "vertical-viewport-segments" class=Note padding=0
        text `${viewport.verticalViewportSegments}` class=Fact testId="fact-v"
      row gap=8 align-items="baseline"
        text "viewport" class=Note padding=0
        text `${viewport.width}×${viewport.height}` class=Fact testId="fact-size"

component ItemList
  props
    items: Item[]
    selected: number
    choose: action
  view
    scroll flex=1 min-height=0 width="100%" testId="item-list"
      column padding=12 gap=8
        for item in items key=item.id
          button press=choose(item.id) testId=`item-${item.id}` class=Card display="flex" flex-direction="column" gap=3 align-items="flex-start" background-color=(item.id == selected ? "AccentColor" : "-exact-secondary-background") text-align="start"
            text item.title font-size=16 font-weight=600 color=(item.id == selected ? "AccentColorText" : "-exact-label")
            text item.summary font-size=13 color=(item.id == selected ? "AccentColorText" : "-exact-secondary-label")

component Detail
  props
    items: Item[]
    selected: number
  view
    scroll flex=1 min-height=0 width="100%" testId="detail-scroll"
      column padding=16 gap=10
        for item in items key=item.id
          if item.id == selected
            text item.title font-size=24 font-weight=700 testId="detail-title"
            text item.summary font-size=15 color="-exact-secondary-label"
            text item.body font-size=16 line-height="24px" testId="detail-body"
