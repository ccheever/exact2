{
  "version": "2025.10",
  "sets": {
    "base": {
      "sources": [
        {
          "color": {
            "$type": "color",
            "ink": { "$value": { "colorSpace": "srgb", "components": [0.1, 0.1, 0.1], "hex": "#1a1a1a" } },
            "paper": { "$value": "#ffffff" }
          }
        }
      ]
    }
  },
  "modifiers": {
    "mode": {
      "default": "light",
      "contexts": {
        "light": [{ "color": { "$type": "color", "surface": { "$value": "{color.paper}" } } }],
        "dark": [{ "color": { "$type": "color", "surface": { "$value": { "colorSpace": "oklch", "components": [0.2, 0.01, 250] } } } }]
      }
    },
    "brand": {
      "default": "calm",
      "contexts": {
        "calm": [{ "color": { "$type": "color", "accent": { "$value": "#3366ff" } } }],
        "loud": [{ "color": { "$type": "color", "accent": { "$value": "#ff3366" } } }]
      }
    }
  },
  "resolutionOrder": [{ "$ref": "#/sets/base" }, { "$ref": "#/modifiers/mode" }, { "$ref": "#/modifiers/brand" }]
}
