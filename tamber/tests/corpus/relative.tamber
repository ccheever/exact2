tamber relative

dials
  lift: number = 0.1  in 0..0.5  step=0.01 label="Lift \"up\""

theme
  brand = #1083fe
  rgb.same = rgb(from brand r g b)
  rgb.half = rgb(from brand r g b / 50%)
  rgb.calc = rgb(from brand calc(r / 2) g calc((b + 10) * 0.5))
  oklch.lighter = oklch(from brand calc(l + lift) c h)
  oklch.turned = oklch(from brand l c calc(h + 180))
  oklch.angle = oklch(from brand l c 0.5turn)
  srgb.literal = color(from #ff0000 srgb 1 0 0)
  srgb.percent = color(from #ff0000 srgb 100% 0% 0%)
  srgb.calc = color(from #ffff00 srgb r g calc(b + 0.5))
  srgb.alpha = color(from color(srgb 0 0 0 / 0.6) srgb alpha 0.6 0.6 / 0.9)
  rgb.unquantised = rgb(from rgb(0.5 0 0) r g b)
  rgb.percent-product = rgb(from #000 calc(r * 10%) calc(25% * 2) b)
  legacy.calc.hsl = hsl(0, calc(100%), 50%)
  legacy.calc.rgb = rgb(calc(50%), 0%, 0%)
  chain.up = oklch(from oklch(0.8 0.1 20) calc(l + 0.5) c h)
  chain.down = oklch(from chain.up calc(l - 0.5) c h)
  achromatic = oklch(from white 0.5 0.2 120)
  absolute.calc = rgb(calc(50%) 0 0)
  absolute.dial = oklch(calc(0.5 + lift) 0.1 200)
  upper = rgb(FROM brand R G B)
  hsl.darker = hsl(from brand h s calc(l - 20))
  p3 = color(from brand display-p3 r g b)
  pair = oklch(from light-dark(#ffffff, #000000) l 0.1 250)
  on.brand = contrast-color(brand)
  on.pale = contrast-color(#f1f3f5)
  on.pair = contrast-color(light-dark(#ffffff, #000000))
  negative.chroma = oklch(from red 0.6 -0.1 20)
