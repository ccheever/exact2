tamber kinds

theme
  type.body = -exact-body/1.35 "InterVariable"
  family.body: family = "InterVariable", system-ui
  shadow.card: box-shadow = 0 1px 2px #000
  glow: text-shadow = 0 0 2px #fff
  motion.fast: duration = 150ms
  motion.ease: easing = ease-in
  odd: wobbly = #000
  not.colour = rgb(1 2)
  two = #000 #fff
