component X59
  state collapsed = false
  action toggle
    collapsed = not collapsed
  view
    column testId="root" width="100%" height="100%" box-sizing="border-box" padding=24 gap=12 background-color="light-dark(#ffffff, #111111)" color="light-dark(#111111, #eeeeee)" font-size=14 line-height="20px"
      button press=toggle testId="t" width=120 padding=6 border-width=1 border-style="solid" border-color="#cccccc"
        text "toggle"
      column width=300 min-height=20 border-width=1 border-style="solid" border-color="#cccccc"
        text "A long value that keeps going past the width so the line has to be cut with an ellipsis" line-clamp=1 testId="at-launch"
      column width=300 min-height=20 border-width=1 border-style="solid" border-color="#cccccc"
        when collapsed
          text "A long value that keeps going past the width so the line has to be cut with an ellipsis" line-clamp=1 testId="swapped"
        else
          text "A long value that keeps going past the width so the line has to be cut with an ellipsis" testId="swapped"
      column width=300 min-height=20 border-width=1 border-style="solid" border-color="#cccccc"
        when collapsed
          text "A long value that keeps going past the width so the line has to be cut with an ellipsis" line-clamp=1 testId="mounted"
      column width=300 min-height=20 border-width=1 border-style="solid" border-color="#cccccc"
        when collapsed
          text "A long value that keeps going past the width so the line has to be cut with an ellipsis, and then some more" line-clamp=2 testId="mounted-2"
      column width=300 min-height=20 border-width=1 border-style="solid" border-color="#cccccc"
        when collapsed
          text "A long value that keeps going past the width so the line has to be cut with an ellipsis" white-space="nowrap" overflow="hidden" text-overflow="ellipsis" testId="mounted-nowrap"
